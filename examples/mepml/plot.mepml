\tab(Java,
Run as a single-file program, which finds the binding through the shell's `CLASSPATH`:

```{java, nix-shell="git+file:../..#report-java", cmd="java {file}", file="figures/plot_java.svg"}
import java.math.BigInteger;
import js.datamunge.jdatamunge.BSplineRegression;
import js.datamunge.jdatamunge.DVector;
import js.datamunge.jdatamunge.RGB;
import js.datamunge.jdatamunge.RPlot;
import js.datamunge.jdatamunge.datamunge;

public class DopplerPlot {
  static DVector doppler(DVector x) {
    return new DVector(x.stream().map(v -> Math.sin(20 / (v + 0.25))).toList());
  }

  public static void main(String[] args) {
    datamunge.set_seed(BigInteger.valueOf(42));
    DVector x = datamunge.runif(0, 1, 1000);
    DVector noise = datamunge.rnorm(0, 1, 1000);
    DVector f = doppler(x);
    DVector y = new DVector(f);
    for (int i = 0; i < y.size(); i++) y.set(i, f.get(i) + noise.get(i));
    DVector xseq = datamunge.seql(0, 1, 1000);
    DVector yseq = doppler(xseq);
    DVector yfit = new BSplineRegression(x, y, 100).predict(xseq);

    new java.io.File("build").mkdirs();
    RPlot.create().title("Doppler data")
        .points(x, y, "Samples", new RGB("#edc78799"))
        .lines(xseq, yseq, "True Mean", new RGB("#c80a2c"), 3.0)
        .lines(xseq, yfit, "Estimated Mean", new RGB("#2c0ac8"), 3.0)
        .x_label("X").y_label("doppler(X)").size(1000, 600)
        .save("build/plot_java.svg");
  }
}
```
