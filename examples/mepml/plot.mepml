\tab(Octave,
Vectors come back as cell arrays; numeric arrays are copied into a `DVector` to pass them in:

```{octave, nix-shell="git+file:../..#report-octave", file="figures/plot_octave.svg"}
1;
datamunge;

% Octave arrays don't convert to the library's vectors by themselves: copy into a DVector.
function v = dvector(a)
  datamunge;  % functions have their own workspace
  v = DVector();
  for ai = a(:).'
    v.push_back(ai);
  end
end

function y = doppler(x)
  y = sin(20 ./ (x + 0.25));
end

set_seed(42);
x = cell2mat(runif(0, 1, 1000));
y = doppler(x) + cell2mat(rnorm(0, 1, 1000));
xseq = cell2mat(seql(0, 1, 1000));
yseq = doppler(xseq);
bsr = BSplineRegression(dvector(x), dvector(y), 100);
yfit = cell2mat(bsr.predict(dvector(xseq)));
mkdir("build");
plot = RPlot.create();
plot.title("Doppler data");
plot.points(dvector(x), dvector(y), "Samples", RGB(237, 199, 135, 0.6), 4.0);
plot.lines(dvector(xseq), dvector(yseq), "True Mean", RGB(200, 10, 44), 3.0);
plot.lines(dvector(xseq), dvector(yfit), "Estimated Mean", RGB(44, 10, 200), 3.0);
plot.xlab("X");
plot.ylab("doppler(X)");
plot.save("build/plot_octave.svg");
```
