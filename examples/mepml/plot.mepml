\tab(D,
Compiled with ldc2; `-i` pulls in the generated binding module, which the report shell points to with `$DATAMUNGED_SOURCE`:

```{d, nix-shell="git+file:../..#report-d", cmd="ldc2 -i -I$DATAMUNGED_SOURCE {file} -of={bin} && {bin}", file="figures/plot_d.svg"}
import std.algorithm : map;
import std.array : array;
import std.file : mkdirRecurse;
import std.math : sin;
import std.range : zip;
import datamunge;

DVector doppler(DVector x) {
  return new DVector(x[].map!(xi => sin(20 / (xi + 0.25))).array);
}

void main() {
  set_seed(42);
  auto x = runif(0, 1, 1000);
  auto y = new DVector(zip(doppler(x)[], rnorm(0, 1, 1000)[]).map!(p => p[0] + p[1]).array);
  auto xseq = seql(0, 1, 1000);
  auto yseq = doppler(xseq);
  auto yfit = new BSplineRegression(x, y, 100).predict(xseq);
  mkdirRecurse("build");
  RPlot.create()
      .title("Doppler data")
      .points(x, y, "Samples", new RGB(237, 199, 135, 0.6), 4.0)
      .lines(xseq, yseq, "True Mean", new RGB(200, 10, 44), 3.0)
      .lines(xseq, yfit, "Estimated Mean", new RGB(44, 10, 200), 3.0)
      .xlab("X")
      .ylab("doppler(X)")
      .save("build/plot_d.svg");
}
```
