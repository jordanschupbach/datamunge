
> Plot Example

A simple plotting example: noisy samples of the Doppler function, the true mean, and a B-spline fit -- the same program in C++ and in each language binding: C#, D, Go, Guile, Java, JavaScript, Lua, OCaml, Octave, Perl, PHP, Python, R, Ruby and Tcl.

\tabs(
\tab(C++,
```{cpp, results="output", exports="both", flags="-std=c++17 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <iostream>
#include <datamunge/datamunge.hpp>
namespace dm = datamunge;
dm::Vector doppler(dm::Vector x) {
  return dm::sin(20/(x + 0.25));
}
int main(void) {
  dm::Vector x = dm::unif(0, 1, 1000);
  dm::Vector y = doppler(x) + dm::rnorm(0, 1, 1000);
  dm::Vector xseq = dm::seql(0, 1, 1000);
  dm::Vector yseq = doppler(xseq);
  dm::BSR bsr = dm::BSR(x, y, 100);
  dm::Vector yfit = bsr.predict(xseq);
  dm::Plot plot = dm::Plot()
    .points(x, y, "samples", dm::RGBA{237, 199, 135, 0.6}, 6.0)
    .lines(xseq, yseq, "True Mean", dm::RGB{200, 10, 44}, 6.0)
    .lines(xseq, yfit, "Estimated Mean", dm::RGB{44, 10, 200}, 6.0)
    .title("Doppler data")
    .xlab("X")
    .ylab("doppler(X)");
  std::cout <<  plot.to_svg() << std::endl;
  return 0;
}
```
)
\tab(Python,

```{python, results="output", exports="both"}
import numpy as np
from pydatamunge import datamunge as dm
def doppler(x):
    return np.sin(20 / (np.asarray(x) + 0.25))

x = np.array(dm.unif(0, 1, 1000))
y = doppler(x) + np.array(dm.rnorm(0, 1, 1000))
xseq = np.array(dm.seql(0, 1, 1000))
yseq = doppler(xseq)
bsr = dm.BSR(x, y, 100)
yfit = bsr.predict(xseq)
plot = (
    dm.RPlot.create()
    .points(x, y, "samples", dm.RGBA(237, 199, 135, 0.6), 6.0)
    .lines(xseq, yseq, "True Mean", dm.RGB(200, 10, 44), 6.0)
    .lines(xseq, yfit, "Estimated Mean", dm.RGB(44, 10, 200), 6.0)
    .title("Doppler data")
    .xlab("X")
    .ylab("doppler(X)")
)
print(plot.to_svg())
```
)
\tab(R,
With base R for the random data and vector math:

```{R, results="output", exports="both"}
suppressPackageStartupMessages(library(datamunger))
doppler <- function(x) sin(20 / (x + 0.25))
x <- runif(1000)
y <- doppler(x) + rnorm(1000)
xseq <- seq(0, 1, length.out = 1000)
yseq <- doppler(xseq)
bsr <- BSR(x, y, 100)
yfit <- bsr$predict(xseq)
plot <- RPlot_create()
plot$points(x, y, "samples", RGBA(237, 199, 135, 0.6), 6.0)$
  lines(xseq, yseq, "True Mean", RGB(200, 10, 44), 6.0)$
  lines(xseq, yfit, "Estimated Mean", RGB(44, 10, 200), 6.0)$
  title("Doppler data")$
  xlab("X")$
  ylab("doppler(X)")
cat(plot$to_svg())
```
)
\tab(C#,
The binding project is referenced with a `#:project` directive, resolved against this document's directory:

```{csharp, results="output", exports="both"}
#:project ../../src/datamungedotnet
static DVector Doppler(IEnumerable<double> x) => new(x.Select(xi => Math.Sin(20 / (xi + 0.25))));
var x = datamunge.unif(0, 1, 1000);
var y = new DVector(Doppler(x).Zip(datamunge.rnorm(0, 1, 1000), (f, e) => f + e));
var xseq = datamunge.seql(0, 1, 1000);
var yseq = Doppler(xseq);
var bsr = new BSplineRegression(x, y, 100);
var yfit = bsr.predict(xseq);
var plot = RPlot.create();
plot.points(x, y, "samples", new RGB(237, 199, 135, 0.6), 6.0)
    .lines(xseq, yseq, "True Mean", new RGB(200, 10, 44), 6.0)
    .lines(xseq, yfit, "Estimated Mean", new RGB(44, 10, 200), 6.0)
    .title("Doppler data")
    .xlab("X")
    .ylab("doppler(X)");
Console.WriteLine(plot.to_svg());
```
)
\tab(D,
Compiled with ldc2; `-i` pulls in the generated binding modules:

```{d, results="output", exports="both", flags="-i -I../../src/datamunged/source"}
import std.algorithm : map;
import std.array : array;
import std.math : sin;
import std.range : zip;
import std.stdio : writeln;
import datamunge;
DVector doppler(DVector x) {
  return new DVector(x[].map!(xi => sin(20 / (xi + 0.25))).array);
}
void main() {
  auto x = unif(0, 1, 1000);
  auto y = new DVector(zip(doppler(x)[], rnorm(0, 1, 1000)[]).map!(p => p[0] + p[1]).array); // y = f(x) + epsilon
  auto xseq = seql(0, 1, 1000);
  auto yseq = doppler(xseq);
  auto bsr = new BSplineRegression(x, y, 100);
  auto yfit = bsr.predict(xseq);
  auto plot = RPlot.create();
  plot.points(x, y, "samples", new RGB(237, 199, 135, 0.6), 6.0)
      .lines(xseq, yseq, "True Mean", new RGB(200, 10, 44), 6.0)
      .lines(xseq, yfit, "Estimated Mean", new RGB(44, 10, 200), 6.0)
      .title("Doppler data")
      .xlab("X")
      .ylab("doppler(X)");
  writeln(plot.to_svg());
}
```
)
\tab(Go,
```{go, results="output", exports="both"}
package main
import (
	"datamunge"
	"fmt"
	"math"
)
func doppler(x datamunge.DVector) datamunge.DVector {
	 y := datamunge.NewDVector(x.Size())
	 for i := 0; i < int(x.Size()); i++ {
	 	 y.Set(i, math.Sin(20/(x.Get(i)+0.25)))
	 }
	 return y
}

func main() {
	 x := datamunge.Unif(0, 1, 1000)
	 y := doppler(x)
	 eps := datamunge.Rnorm(0, 1, 1000)
	 for i := 0; i < int(1000); i++ {
	 	y.Set(i, y.Get(i)+eps.Get(i))
	 }
	 xseq := datamunge.Seql(0, 1, 1000)
	 yseq := doppler(xseq)
	 bsr := datamunge.NewBSplineRegression(x, y, 100)
	 yfit := bsr.Predict(xseq)
	 plot := datamunge.RPlotCreate()
	 plot.Points(x, y, "samples", datamunge.NewRGB(237, 199, 135, 0.6), 6.0)
	 plot.Lines(xseq, yseq, "True Mean", datamunge.NewRGB(200, 10, 44), 6.0)
	 plot.Lines(xseq, yfit, "Estimated Mean", datamunge.NewRGB(44, 10, 200), 6.0)
	 plot.Title("Doppler data")
	 plot.Xlab("X")
	 plot.Ylab("doppler(X)")
	 fmt.Println(plot.To_svg())
}
```
)
\tab(Guile,
Vectors come back as Scheme vectors:

```{scheme, results="output", exports="both"}
(use-modules (datamunge) ((rnrs base) #:select (vector-map)))

(define (doppler x) (vector-map (lambda (xi) (sin (/ 20 (+ xi 0.25)))) x))

(define n 1000)
(define nk 100) ; Number of basis functions
(define x (unif 0 1 n))
(define y (vector-map + (doppler x) (rnorm 0 1 n))) ; y = f(x) + epsilon
(define xseq (seql 0 1 n))
(define yseq (doppler xseq))
(define bsr (new-BSplineRegression x y nk))
(define yfit (BSplineRegression-predict bsr xseq))
(define plot (RPlot-create))
(RPlot-points plot x y "samples" (new-RGB 237 199 135 0.6) 6.0)
(RPlot-lines plot xseq yseq "True Mean" (new-RGB 200 10 44) 6.0)
(RPlot-lines plot xseq yfit "Estimated Mean" (new-RGB 44 10 200) 6.0)
(RPlot-title plot "Doppler data")
(RPlot-xlab plot "X")
(RPlot-ylab plot "doppler(X)")
(display (Plot-to-svg plot)) ; to-svg is inherited from Plot
(newline)
```
