\tab(Guile,
Vectors come back as Scheme vectors:

```{scheme, nix-shell="git+file:../..#report-guile", file="figures/plot_guile.svg"}
(use-modules (datamunge) ((rnrs base) #:select (vector-map)))

(define (doppler x) (vector-map (lambda (xi) (sin (/ 20 (+ xi 0.25)))) x))

(set-seed 42)
(define x (runif 0 1 1000))
(define y (vector-map + (doppler x) (rnorm 0 1 1000)))
(define xseq (seql 0 1 1000))
(define yseq (doppler xseq))
(define yfit (BSplineRegression-predict (new-BSplineRegression x y 100) xseq))
(unless (file-exists? "build") (mkdir "build"))
(define plot (RPlot-create))
(RPlot-title plot "Doppler data")
(RPlot-points plot x y "Samples" (new-RGB 237 199 135 0.6) 4.0)
(RPlot-lines plot xseq yseq "True Mean" (new-RGB 200 10 44) 3.0)
(RPlot-lines plot xseq yfit "Estimated Mean" (new-RGB 44 10 200) 3.0)
(RPlot-xlab plot "X")
(RPlot-ylab plot "doppler(X)")
(Plot-save plot "build/plot_guile.svg") ; save is inherited from Plot
