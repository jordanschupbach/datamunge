\tab(Lua,
```{lua, results="output", exports="both"}
local dm = require("datamunge")

-- Element-wise doppler(x) over a DVector, into a new DVector.
local function doppler(x)
  local y = dm.DVector(x:size())
  for i = 0, x:size() - 1 do
    y[i] = math.sin(20 / (x[i] + 0.25))
  end
  return y
end

local n = 1000
local nk = 100 -- Number of basis functions
local x = dm.unif(0, 1, n)
local eps = dm.rnorm(0, 1, n)
local y = doppler(x)
for i = 0, n - 1 do y[i] = y[i] + eps[i] end -- y = f(x) + epsilon
local xseq = dm.seql(0, 1, n)
local yseq = doppler(xseq)
local bsr = dm.BSplineRegression(x, y, nk)
local yfit = bsr:predict(xseq)
local plot = dm.RPlot.create()
plot:points(x, y, "samples", dm.RGB(237, 199, 135, 0.6), 6.0)
plot:lines(xseq, yseq, "True Mean", dm.RGB(200, 10, 44), 6.0)
plot:lines(xseq, yfit, "Estimated Mean", dm.RGB(44, 10, 200), 6.0)
plot:title("Doppler data")
plot:xlab("X")
plot:ylab("doppler(X)")
print(plot:to_svg())
```
