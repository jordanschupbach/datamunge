\tab(Lua,
```{lua, nix-shell="git+file:../..#report-lua", file="figures/plot_lua.svg"}
local dm = require("datamunge")

-- Element-wise doppler(x) over a DVector, into a new DVector.
local function doppler(x)
  local y = dm.DVector(x:size())
  for i = 0, x:size() - 1 do y[i] = math.sin(20 / (x[i] + 0.25)) end
  return y
end

dm.set_seed(42)
local x = dm.runif(0, 1, 1000)
local y = doppler(x)
local eps = dm.rnorm(0, 1, 1000)
for i = 0, y:size() - 1 do y[i] = y[i] + eps[i] end
local xseq = dm.seql(0, 1, 1000)
local yseq = doppler(xseq)
local yfit = dm.BSplineRegression(x, y, 100):predict(xseq)
os.execute("mkdir -p build")
dm.RPlot.create()
  :title("Doppler data")
  :points(x, y, "Samples", dm.RGB(237, 199, 135, 0.6), 4.0)
  :lines(xseq, yseq, "True Mean", dm.RGB(200, 10, 44), 3.0)
  :lines(xseq, yfit, "Estimated Mean", dm.RGB(44, 10, 200), 3.0)
  :xlab("X")
  :ylab("doppler(X)")
  :save("build/plot_lua.svg")
