\tab(Tcl,
Vectors come back as Tcl lists:

```{tcl, nix-shell="git+file:../..#report-tcl", file="figures/plot_tcl.svg"}
package require Datamunge
namespace path ::datamunge

proc doppler {x} { lmap xi $x { expr {sin(20 / ($xi + 0.25))} } }

set_seed 42
set x [runif 0 1 1000]
set y [lmap fx [doppler $x] e [rnorm 0 1 1000] { expr {$fx + $e} }]
set xseq [seql 0 1 1000]
set yseq [doppler $xseq]
set yfit [BSplineRegression_predict [new_BSplineRegression $x $y 100] $xseq]
file mkdir build
set plot [RPlot_create]
RPlot_title $plot "Doppler data"
RPlot_points $plot $x $y "Samples" [new_RGB 237 199 135 0.6] 4.0
RPlot_lines $plot $xseq $yseq "True Mean" [new_RGB 200 10 44] 3.0
RPlot_lines $plot $xseq $yfit "Estimated Mean" [new_RGB 44 10 200] 3.0
RPlot_xlab $plot "X"
RPlot_ylab $plot "doppler(X)"
Plot_save $plot "build/plot_tcl.svg" ;# save is inherited from Plot
