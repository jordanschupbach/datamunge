\tab(Perl,
Vectors come back as array references:

```{perl, results="output", exports="both"}
use strict;
use warnings;
use Datamunge;

sub doppler { return [ map { sin(20 / ($_ + 0.25)) } @{ $_[0] } ]; }

my $n  = 1000;
my $nk = 100;    # Number of basis functions
my $x  = Datamunge::unif(0, 1, $n);
my $eps = Datamunge::rnorm(0, 1, $n);
my $f  = doppler($x);
my $y  = [ map { $f->[$_] + $eps->[$_] } 0 .. $n - 1 ];    # y = f(x) + epsilon
my $xseq = Datamunge::seql(0, 1, $n);
my $yseq = doppler($xseq);
my $bsr  = Datamunge::BSplineRegression->new($x, $y, $nk);
my $yfit = $bsr->predict($xseq);
my $plot = Datamunge::RPlot::create();
$plot->points($x, $y, "samples", Datamunge::RGB->new(237, 199, 135, 0.6), 6.0);
$plot->lines($xseq, $yseq, "True Mean", Datamunge::RGB->new(200, 10, 44), 6.0);
$plot->lines($xseq, $yfit, "Estimated Mean", Datamunge::RGB->new(44, 10, 200), 6.0);
$plot->title("Doppler data");
$plot->xlab("X");
$plot->ylab("doppler(X)");
print $plot->to_svg(), "\n";
```
