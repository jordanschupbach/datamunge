\tab(Go,
```{go, nix-shell="git+file:../..#report-go", file="figures/plot_go.svg"}
package main

import (
	"datamunge"
	"math"
	"os"
)

func doppler(x datamunge.DVector) datamunge.DVector {
	y := datamunge.NewDVector(x.Size())
	for i := 0; i < int(x.Size()); i++ {
		y.Set(i, math.Sin(20/(x.Get(i)+0.25)))
	}
	return y
}

func main() {
	datamunge.Set_seed(42)
	x := datamunge.Runif(0, 1, 1000)
	y := doppler(x)
	eps := datamunge.Rnorm(0, 1, 1000)
	for i := 0; i < int(y.Size()); i++ {
		y.Set(i, y.Get(i)+eps.Get(i)) // y = doppler(x) + noise
	}
	xseq := datamunge.Seql(0, 1, 1000)
	yseq := doppler(xseq)
	yfit := datamunge.NewBSplineRegression(x, y, int64(100)).Predict(xseq)
	os.MkdirAll("build", 0o755)
	datamunge.RPlotCreate().
		Title("Doppler data").
		Points(x, y, "Samples", datamunge.NewRGB("#edc78799")).
		Lines(xseq, yseq, "True Mean", datamunge.NewRGB("#c80a2c"), 3.0).
		Lines(xseq, yfit, "Estimated Mean", datamunge.NewRGB("#2c0ac8"), 3.0).
		X_label("X").
		Y_label("doppler(X)").
		Size(1000, 600).
		Save("build/plot_go.svg")
}
```
