\tab(PHP,
The `<?php` tag is added when the block runs:

```{php, nix-shell="git+file:../..#report-php", file="figures/plot_php.svg"}
set_seed(42);
function doppler($x) {
    $y = new DVector($x->size());
    for ($i = 0; $i < $x->size(); $i++) $y->set($i, sin(20 / ($x->get($i) + 0.25)));
    return $y;
}
$n = 1000;
$x = runif(0, 1, $n);
$f = doppler($x);
$eps = rnorm(0, 1, $n);
$y = new DVector($n);
for ($i = 0; $i < $n; $i++) $y->set($i, $f->get($i) + $eps->get($i));
$xseq = seql(0, 1, $n);
$yseq = doppler($xseq);
$bsr = new BSplineRegression($x, $y, 100);
$yfit = $bsr->predict($xseq);
@mkdir("build");
RPlot::create()->title("Doppler data")
    ->points($x, $y, "Samples", new RGB("#edc78799"))
    ->lines($xseq, $yseq, "True Mean", new RGB("#c80a2c"), 3.0)
    ->lines($xseq, $yfit, "Estimated Mean", new RGB("#2c0ac8"), 3.0)
    ->x_label("X")->y_label("doppler(X)")->size(1000, 600)
    ->save("build/plot_php.svg");
