```{R, nix-shell="git+file:../..#report-r", file="figures/plot_r.svg"}
suppressPackageStartupMessages(library(datamunger))
doppler <- function(x) sin(20 / (x + 0.25))
set.seed(42)
x <- runif(1000)
y <- doppler(x) + rnorm(1000)
xseq <- seq(0, 1, length.out = 1000)
yseq <- doppler(xseq)
yfit <- BSplineRegression(x, y, 100)$predict(xseq)
dir.create("build", showWarnings = FALSE)
invisible(RPlot_create()$
  title("Doppler data")$
  points(x, y, "Samples", RGB(237, 199, 135, 0.6), 4.0)$
  lines(xseq, yseq, "True Mean", RGB(200, 10, 44), 3.0)$
  lines(xseq, yfit, "Estimated Mean", RGB(44, 10, 200), 3.0)$
  xlab("X")$
  ylab("doppler(X)")$
  save("build/plot_r.svg"))
