\tab(JavaScript,
```{js, nix-shell="git+file:../..#report-javascript", file="figures/plot_javascript.svg"}
const fs = require("fs");
const dm = require("@datamunge/datamungejs");

// Element-wise doppler(x) over a DVector, into a new DVector.
function doppler(x) {
  const y = new dm.DVector(x.size());
  for (let i = 0; i < x.size(); i++) y.set(i, Math.sin(20 / (x.get(i) + 0.25)));
  return y;
}

dm.set_seed(42);
const x = dm.unif(0, 1, 1000);
const y = doppler(x);
const eps = dm.rnorm(0, 1, 1000);
for (let i = 0; i < y.size(); i++) y.set(i, y.get(i) + eps.get(i));
const xseq = dm.seql(0, 1, 1000);
const yseq = doppler(xseq);
const yfit = new dm.BSplineRegression(x, y, 100).predict(xseq);
fs.mkdirSync("build", { recursive: true });
dm.RPlot.create()
  .title("Doppler data")
  .points(x, y, "Samples", new dm.RGB(237, 199, 135, 0.6), 4.0)
  .lines(xseq, yseq, "True Mean", new dm.RGB(200, 10, 44), 3.0)
  .lines(xseq, yfit, "Estimated Mean", new dm.RGB(44, 10, 200), 3.0)
  .xlab("X")
  .ylab("doppler(X)")
  .save("build/plot_javascript.svg");
```
