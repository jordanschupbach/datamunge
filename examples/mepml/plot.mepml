\tab(OCaml,
Run in the toplevel, loading the binding with findlib:

```{ocaml, results="output", exports="both"}
#use "topfind";;
#require "datamungeocaml";;
open Swig

(* DVector <-> float array *)
let to_floats v =
  Array.init (get_int (invoke v "size" C_void)) (fun i -> get_float (invoke v "[]" (C_int i)))
let of_floats a =
  let v = Datamunge.new_DVector C_void in
  Array.iter (fun f -> ignore (invoke v "push_back" (C_double f))) a;
  v

let doppler x = Array.map (fun xi -> sin (20. /. (xi +. 0.25))) x
let rgb ?(alpha = 1.0) r g b = Datamunge.new_RGB (C_list [C_int r; C_int g; C_int b; C_double alpha])

let () =
  let n = 1000 in
  let nk = 100 in (* Number of basis functions *)
  let x = to_floats (Datamunge._unif (C_list [C_double 0.; C_double 1.; C_int n])) in
  let eps = to_floats (Datamunge._rnorm (C_list [C_double 0.; C_double 1.; C_int n])) in
  let y = Array.map2 ( +. ) (doppler x) eps in (* y = f(x) + epsilon *)
  let xseq = to_floats (Datamunge._seql (C_list [C_double 0.; C_double 1.; C_int n])) in
  let yseq = doppler xseq in
  let x, y, xseq, yseq = of_floats x, of_floats y, of_floats xseq, of_floats yseq in
  let bsr = Datamunge.new_BSplineRegression (C_list [x; y; C_int nk]) in
  let yfit = invoke bsr "predict" xseq in
  let plot = Datamunge._RPlot_create C_void in
  let call m args = ignore (invoke plot m (C_list args)) in
  call "points" [x; y; C_string "samples"; rgb ~alpha:0.6 237 199 135; C_double 6.0];
  call "lines" [xseq; yseq; C_string "True Mean"; rgb 200 10 44; C_double 6.0];
  call "lines" [xseq; yfit; C_string "Estimated Mean"; rgb 44 10 200; C_double 6.0];
  call "title" [C_string "Doppler data"];
  call "xlab" [C_string "X"];
  call "ylab" [C_string "doppler(X)"];
  print_endline (get_string (invoke plot "to_svg" C_void))
```
