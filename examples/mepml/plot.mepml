\tab(Perl,
Vectors come back as array references:

```{perl, nix-shell="git+file:../..#report-perl", file="figures/plot_perl.svg"}
use strict;
use warnings;
use File::Path qw(make_path);
use Datamunge;

sub doppler { [ map { sin(20 / ($_ + 0.25)) } @{ $_[0] } ] }

Datamunge::set_seed(42);
my $n    = 1000;
my $x    = Datamunge::runif(0, 1, $n);
my $eps  = Datamunge::rnorm(0, 1, $n);
my $f    = doppler($x);
my $y    = [ map { $f->[$_] + $eps->[$_] } 0 .. $n - 1 ];
my $xseq = Datamunge::seql(0, 1, $n);
my $yseq = doppler($xseq);
my $yfit = Datamunge::BSplineRegression->new($x, $y, 100)->predict($xseq);

make_path("build");
Datamunge::RPlot::create()
  ->title("Doppler data")
  ->points($x, $y, "Samples", Datamunge::RGB->new("#edc78799"))
  ->lines($xseq, $yseq, "True Mean", Datamunge::RGB->new("#c80a2c"), 3.0)
  ->lines($xseq, $yfit, "Estimated Mean", Datamunge::RGB->new("#2c0ac8"), 3.0)
  ->x_label("X")
  ->y_label("doppler(X)")
  ->size(1000, 600)
  ->save("build/plot_perl.svg");
```
