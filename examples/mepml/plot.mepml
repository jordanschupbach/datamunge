\tab(C#,
The binding is a NuGet package built by nix (generated by Rosetta), referenced with a `#:package` directive:

```{csharp, nix-shell="git+file:../..#report-csharp", file="figures/plot_csharp.svg"}
#:package Datamunge@0.0.1
using Datamunge;
static List<double> Doppler(IEnumerable<double> x) => x.Select(xi => Math.Sin(20 / (xi + 0.25))).ToList();
Functions.SetSeed(42);
var x = Functions.Runif(0, 1, 1000);
var y = Doppler(x).Zip(Functions.Rnorm(0, 1, 1000), (f, e) => f + e).ToList();
var xseq = Functions.Seql(0, 1, 1000);
var yseq = Doppler(xseq);
var yfit = new BSplineRegression(x, y, 100).Predict(xseq);
Directory.CreateDirectory("build");
RPlot.Create()
    .Title("Doppler data")
    .Points(x, y, "Samples", new RGB("#edc78799"))
    .Lines(xseq, yseq, "True Mean", new RGB("#c80a2c"), 3.0)
    .Lines(xseq, yfit, "Estimated Mean", new RGB("#2c0ac8"), 3.0)
    .XLabel("X").YLabel("doppler(X)")
    .Size(1000, 600)
    .Save("build/plot_csharp.svg");
```
