\tab(OCaml,
Run in the toplevel, loading the binding with findlib:

```{ocaml, nix-shell="git+file:../..#report-ocaml", file="figures/plot_ocaml.svg"}
#use "topfind";;
#require "datamungeocaml";;
open Swig

(* DVector <-> float array *)
let to_floats v =
  Array.init (get_int (invoke v "size" C_void)) (fun i -> get_float (invoke v "[]" (C_int i)))
let of_floats a =
  let v = Datamunge.new_DVector C_void in
  Array.iter (fun f -> ignore (invoke v "push_back" (C_double f))) a;
  v
let draw f args = to_floats (f (C_list args))
let rgb ?(alpha = 1.0) r g b = Datamunge.new_RGB (C_list [C_int r; C_int g; C_int b; C_double alpha])
let doppler x = Array.map (fun xi -> sin (20. /. (xi +. 0.25))) x

let () =
  ignore (Datamunge._set_seed (C_int 42));
  let x = draw Datamunge._runif [C_double 0.; C_double 1.; C_int 1000] in
  let eps = draw Datamunge._rnorm [C_double 0.; C_double 1.; C_int 1000] in
  let y = Array.map2 ( +. ) (doppler x) eps in
  let xseq = draw Datamunge._seql [C_double 0.; C_double 1.; C_int 1000] in
  let yseq = doppler xseq in
  let x, y, xseq, yseq = of_floats x, of_floats y, of_floats xseq, of_floats yseq in
  let bsr = Datamunge.new_BSplineRegression (C_list [x; y; C_int64 100L]) (* a std::size_t takes C_int64 *) in
  let yfit = invoke bsr "predict" xseq in
  if not (Sys.file_exists "build") then Sys.mkdir "build" 0o755;
  let plot = Datamunge._RPlot_create C_void in
  let call m args = ignore (invoke plot m (C_list args)) in
  call "title" [C_string "Doppler data"];
  call "points" [x; y; C_string "Samples"; rgb ~alpha:0.6 237 199 135; C_double 4.0];
  call "lines" [xseq; yseq; C_string "True Mean"; rgb 200 10 44; C_double 3.0];
  call "lines" [xseq; yfit; C_string "Estimated Mean"; rgb 44 10 200; C_double 3.0];
  call "xlab" [C_string "X"];
  call "ylab" [C_string "doppler(X)"];
  call "save" [C_string "build/plot_ocaml.svg"]
```
