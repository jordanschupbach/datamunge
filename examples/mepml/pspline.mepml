\tab(Go,
```{go, results="output", exports="both"}
package main

import (
	"datamunge"
	"fmt"
	"math"
)

// doppler evaluates sin(20 / (x + 0.25)) element-wise.
func doppler(x datamunge.DVector) datamunge.DVector {
	y := datamunge.NewDVector(x.Size())
	for i := 0; i < int(x.Size()); i++ {
		y.Set(i, math.Sin(20/(x.Get(i)+0.25)))
	}
	return y
}

func main() {
	n := int64(1000)
	nk := int64(100) // Number of knots
	lam := 1.0       // Smoothing parameter: larger is smoother
	x := datamunge.Unif(0, 1, n)
	y := doppler(x)
	eps := datamunge.Rnorm(0, 1, n)
	for i := 0; i < int(n); i++ {
		y.Set(i, y.Get(i)+eps.Get(i)) // y = f(x) + epsilon
	}
	xseq := datamunge.Seql(0, 1, n)
	knots := datamunge.Seql(0, 1, nk)
	yseq := doppler(xseq)
	bsr := datamunge.NewBSplineRegression(x, y, knots)
	psr := datamunge.NewPSplineRegression(x, y, knots, lam)
	bfit := bsr.Predict(xseq)
	pfit := psr.Predict(xseq)
	plot := datamunge.RPlotCreate()
	plot.Points(x, y, "samples", datamunge.NewRGB(237, 199, 135, 0.6), 6.0)
	plot.Lines(xseq, yseq, "True Mean", datamunge.NewRGB(200, 10, 44), 6.0)
	plot.Lines(xseq, bfit, "B-spline fit (BSR)", datamunge.NewRGB(46, 160, 67), 6.0)
	plot.Lines(xseq, pfit, "P-spline fit (PSR)", datamunge.NewRGB(44, 10, 200), 6.0)
	plot.Title("Doppler data: B-spline vs P-spline")
	plot.Xlab("X")
	plot.Ylab("doppler(X)")
	fmt.Println(plot.To_svg())
}
```
