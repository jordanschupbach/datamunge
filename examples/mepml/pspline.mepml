\tab(C#,
The binding project is referenced with a `#:project` directive, resolved against this document's directory:

```{csharp, results="output", exports="both"}
#:project ../../src/datamungedotnet

static DVector Doppler(IEnumerable<double> x) => new(x.Select(xi => Math.Sin(20 / (xi + 0.25))));

uint n = 1000;
uint nk = 100; // Number of knots
double lam = 1.0; // Smoothing parameter: larger is smoother
var x = datamunge.unif(0, 1, n);
var y = new DVector(Doppler(x).Zip(datamunge.rnorm(0, 1, n), (f, e) => f + e)); // y = f(x) + epsilon
var xseq = datamunge.seql(0, 1, n);
var knots = datamunge.seql(0, 1, nk);
var yseq = Doppler(xseq);
var bsr = new BSplineRegression(x, y, knots);
var psr = new PSplineRegression(x, y, knots, lam);
var bfit = bsr.predict(xseq);
var pfit = psr.predict(xseq);
var plot = RPlot.create();
plot.points(x, y, "samples", new RGB(237, 199, 135, 0.6), 6.0)
    .lines(xseq, yseq, "True Mean", new RGB(200, 10, 44), 6.0)
    .lines(xseq, bfit, "B-spline fit (BSR)", new RGB(46, 160, 67), 6.0)
    .lines(xseq, pfit, "P-spline fit (PSR)", new RGB(44, 10, 200), 6.0)
    .title("Doppler data: B-spline vs P-spline")
    .xlab("X")
    .ylab("doppler(X)");
Console.WriteLine(plot.to_svg());
```
