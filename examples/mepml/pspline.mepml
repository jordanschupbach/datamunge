\tab(Java,
```{java, results="output", exports="both"}
import js.datamunge.jdatamunge.BSplineRegression;
import js.datamunge.jdatamunge.PSplineRegression;
import js.datamunge.jdatamunge.DVector;
import js.datamunge.jdatamunge.RGB;
import js.datamunge.jdatamunge.RPlot;
import js.datamunge.jdatamunge.datamunge;

public class DopplerPlot {
  static DVector doppler(DVector x) {
    DVector y = new DVector(x.size(), 0.0);
    for (int i = 0; i < x.size(); i++) {
      y.set(i, Math.sin(20 / (x.get(i) + 0.25)));
    }
    return y;
  }

  public static void main(String[] args) {
    int n = 1000;
    int nk = 100; // Number of knots
    double lam = 1.0; // Smoothing parameter: larger is smoother
    DVector x = datamunge.unif(0, 1, n);
    DVector eps = datamunge.rnorm(0, 1, n);
    DVector y = doppler(x);
    for (int i = 0; i < n; i++) {
      y.set(i, y.get(i) + eps.get(i)); // y = f(x) + epsilon
    }
    DVector xseq = datamunge.seql(0, 1, n);
    DVector knots = datamunge.seql(0, 1, nk);
    DVector yseq = doppler(xseq);
    BSplineRegression bsr = new BSplineRegression(x, y, knots);
    PSplineRegression psr = new PSplineRegression(x, y, knots, lam);
    DVector bfit = bsr.predict(xseq);
    DVector pfit = psr.predict(xseq);
    RPlot plot = RPlot.create();
    plot.points(x, y, "samples", new RGB(237, 199, 135, 0.6), 6.0)
        .lines(xseq, yseq, "True Mean", new RGB(200, 10, 44), 6.0)
        .lines(xseq, bfit, "B-spline fit (BSR)", new RGB(46, 160, 67), 6.0)
        .lines(xseq, pfit, "P-spline fit (PSR)", new RGB(44, 10, 200), 6.0)
        .title("Doppler data: B-spline vs P-spline")
        .xlab("X")
        .ylab("doppler(X)");
    System.out.println(plot.to_svg());
  }
}
