)
\tab(Tcl,
Vectors come back as Tcl lists:

```{tcl, results="output", exports="both"}
package require Datamunge
namespace path ::datamunge

proc doppler {x} { lmap xi $x { expr {sin(20 / ($xi + 0.25))} } }

set n 1000
set nk 100 ;# Number of knots
set lam 1.0 ;# Smoothing parameter: larger is smoother
set x [unif 0 1 $n]
set y [lmap fx [doppler $x] e [rnorm 0 1 $n] { expr {$fx + $e} }] ;# y = f(x) + epsilon
set xseq [seql 0 1 $n]
set knots [seql 0 1 $nk]
set yseq [doppler $xseq]
set bsr [new_BSplineRegression $x $y $knots]
set psr [new_PSplineRegression $x $y $knots $lam]
set bfit [BSplineRegression_predict $bsr $xseq]
set pfit [PSplineRegression_predict $psr $xseq]
set plot [RPlot_create]
RPlot_points $plot $x $y "samples" [new_RGB 237 199 135 0.6] 6.0
RPlot_lines $plot $xseq $yseq "True Mean" [new_RGB 200 10 44] 6.0
RPlot_lines $plot $xseq $bfit "B-spline fit (BSR)" [new_RGB 46 160 67] 6.0
RPlot_lines $plot $xseq $pfit "P-spline fit (PSR)" [new_RGB 44 10 200] 6.0
RPlot_title $plot "Doppler data: B-spline vs P-spline"
RPlot_xlab $plot "X"
RPlot_ylab $plot "doppler(X)"
puts [Plot_to_svg $plot] ;# to_svg is inherited from Plot
```
