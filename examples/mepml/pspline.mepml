\tab(Guile,
Vectors come back as Scheme vectors:

```{scheme, results="output", exports="both"}
(use-modules (datamunge) ((rnrs base) #:select (vector-map)))

(define (doppler x) (vector-map (lambda (xi) (sin (/ 20 (+ xi 0.25)))) x))

(define n 1000)
(define nk 100) ; Number of knots
(define lam 1.0) ; Smoothing parameter: larger is smoother
(define x (unif 0 1 n))
(define y (vector-map + (doppler x) (rnorm 0 1 n))) ; y = f(x) + epsilon
(define xseq (seql 0 1 n))
(define knots (seql 0 1 nk))
(define yseq (doppler xseq))
(define bsr (new-BSplineRegression x y knots))
(define psr (new-PSplineRegression x y knots lam))
(define bfit (BSplineRegression-predict bsr xseq))
(define pfit (PSplineRegression-predict psr xseq))
(define plot (RPlot-create))
(RPlot-points plot x y "samples" (new-RGB 237 199 135 0.6) 6.0)
(RPlot-lines plot xseq yseq "True Mean" (new-RGB 200 10 44) 6.0)
(RPlot-lines plot xseq bfit "B-spline fit (BSR)" (new-RGB 46 160 67) 6.0)
(RPlot-lines plot xseq pfit "P-spline fit (PSR)" (new-RGB 44 10 200) 6.0)
(RPlot-title plot "Doppler data: B-spline vs P-spline")
(RPlot-xlab plot "X")
(RPlot-ylab plot "doppler(X)")
(display (Plot-to-svg plot)) ; to-svg is inherited from Plot
(newline)
```
