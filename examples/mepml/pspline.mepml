\tab(Ruby,
```{ruby, results="output", exports="both"}
require "octruby"

dm = Datamunge

def doppler(x)
  x.map { |xi| Math.sin(20 / (xi + 0.25)) }
end

n = 1000
nk = 100 # Number of knots
lam = 1.0 # Smoothing parameter: larger is smoother
x = dm.unif(0, 1, n).to_a
y = doppler(x).zip(dm.rnorm(0, 1, n).to_a).map { |f, e| f + e } # y = f(x) + epsilon
xseq = dm.seql(0, 1, n).to_a
knots = dm.seql(0, 1, nk).to_a
yseq = doppler(xseq)
bsr = dm::BSplineRegression.new(x, y, knots)
psr = dm::PSplineRegression.new(x, y, knots, lam)
bfit = bsr.predict(xseq)
pfit = psr.predict(xseq)
plot = dm::RPlot.create
plot.points(x, y, "samples", dm::RGB.new(237, 199, 135, 0.6), 6.0)
plot.lines(xseq, yseq, "True Mean", dm::RGB.new(200, 10, 44), 6.0)
plot.lines(xseq, bfit, "B-spline fit (BSR)", dm::RGB.new(46, 160, 67), 6.0)
plot.lines(xseq, pfit, "P-spline fit (PSR)", dm::RGB.new(44, 10, 200), 6.0)
plot.title("Doppler data: B-spline vs P-spline")
plot.xlab("X")
plot.ylab("doppler(X)")
puts plot.to_svg
```
