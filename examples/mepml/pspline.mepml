\tab(PHP,
The `<?php` tag is added when the block runs:

```{php, results="output", exports="both"}
// DVector <-> PHP array
function to_array($v) {
    $a = [];
    for ($i = 0; $i < $v->size(); $i++) $a[] = $v->get($i);
    return $a;
}
function to_dvector(array $a) {
    $v = new DVector();
    foreach ($a as $e) $v->push($e);
    return $v;
}
function doppler(array $x) {
    return array_map(fn($xi) => sin(20 / ($xi + 0.25)), $x);
}

$n = 1000;
$nk = 100; // Number of knots
$lam = 1.0; // Smoothing parameter: larger is smoother
$x = to_array(unif(0, 1, $n));
$y = array_map(fn($f, $e) => $f + $e, doppler($x), to_array(rnorm(0, 1, $n))); // y = f(x) + epsilon
$xseq = to_array(seql(0, 1, $n));
$knots = seql(0, 1, $nk);
$yseq = doppler($xseq);
[$x, $y, $xseq, $yseq] = array_map('to_dvector', [$x, $y, $xseq, $yseq]);
$bsr = new BSplineRegression($x, $y, $knots);
$psr = new PSplineRegression($x, $y, $knots, $lam);
$bfit = $bsr->predict($xseq);
$pfit = $psr->predict($xseq);
$plot = RPlot::create();
$plot->points($x, $y, "samples", new RGB(237, 199, 135, 0.6), 6.0);
$plot->lines($xseq, $yseq, "True Mean", new RGB(200, 10, 44), 6.0);
$plot->lines($xseq, $bfit, "B-spline fit (BSR)", new RGB(46, 160, 67), 6.0);
$plot->lines($xseq, $pfit, "P-spline fit (PSR)", new RGB(44, 10, 200), 6.0);
$plot->title("Doppler data: B-spline vs P-spline");
$plot->xlab("X");
$plot->ylab("doppler(X)");
echo $plot->to_svg(), "\n";
```
