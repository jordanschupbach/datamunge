\tab(R,
With base R for the random data and vector math:

```{R, results="output", exports="both"}
suppressPackageStartupMessages(library(datamunger))

doppler <- function(x) sin(20 / (x + 0.25))

n <- 1000
nk <- 100 # Number of knots
lam <- 1.0 # Smoothing parameter: larger is smoother
x <- runif(n)
y <- doppler(x) + rnorm(n) # y = f(x) + epsilon
xseq <- seq(0, 1, length.out = n)
knots <- seq(0, 1, length.out = nk)
yseq <- doppler(xseq)
bsr <- BSR(x, y, knots)
psr <- PSR(x, y, knots, lam)
bfit <- bsr$predict(xseq)
pfit <- psr$predict(xseq)
plot <- RPlot_create()
plot$points(x, y, "samples", RGBA(237, 199, 135, 0.6), 6.0)$
  lines(xseq, yseq, "True Mean", RGB(200, 10, 44), 6.0)$
  lines(xseq, bfit, "B-spline fit (BSR)", RGB(46, 160, 67), 6.0)$
  lines(xseq, pfit, "P-spline fit (PSR)", RGB(44, 10, 200), 6.0)$
  title("Doppler data: B-spline vs P-spline")$
  xlab("X")$
  ylab("doppler(X)")
cat(plot$to_svg())
```
