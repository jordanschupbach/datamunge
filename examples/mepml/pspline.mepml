)
\tab(JavaScript,
```{js, results="output", exports="both"}
const dm = require("@datamunge/datamungejs");

// Element-wise doppler(x) over a DVector, into a new DVector.
function doppler(x) {
  const y = new dm.DVector(x.size());
  for (let i = 0; i < x.size(); i++) y.set(i, Math.sin(20 / (x.get(i) + 0.25)));
  return y;
}

const n = 1000;
const nk = 100; // Number of knots
const lam = 1.0; // Smoothing parameter: larger is smoother
const x = dm.unif(0, 1, n);
const eps = dm.rnorm(0, 1, n);
const y = doppler(x);
for (let i = 0; i < n; i++) y.set(i, y.get(i) + eps.get(i)); // y = f(x) + epsilon
const xseq = dm.seql(0, 1, n);
const knots = dm.seql(0, 1, nk);
const yseq = doppler(xseq);
const bsr = new dm.BSplineRegression(x, y, knots);
const psr = new dm.PSplineRegression(x, y, knots, lam);
const bfit = bsr.predict(xseq);
const pfit = psr.predict(xseq);
const plot = dm.RPlot.create();
plot
  .points(x, y, "samples", new dm.RGB(237, 199, 135, 0.6), 6.0)
  .lines(xseq, yseq, "True Mean", new dm.RGB(200, 10, 44), 6.0)
  .lines(xseq, bfit, "B-spline fit (BSR)", new dm.RGB(46, 160, 67), 6.0)
  .lines(xseq, pfit, "P-spline fit (PSR)", new dm.RGB(44, 10, 200), 6.0)
  .title("Doppler data: B-spline vs P-spline")
  .xlab("X")
  .ylab("doppler(X)");
console.log(plot.to_svg());
```
