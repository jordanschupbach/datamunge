\tab(Python,
With numpy for the vector math:

```{python, results="output", exports="both"}
import numpy as np
from pydatamunge import datamunge as dm


def doppler(x):
    return np.sin(20 / (np.asarray(x) + 0.25))


n = 1000
nk = 100  # Number of knots
lam = 1.0  # Smoothing parameter: larger is smoother
x = np.array(dm.unif(0, 1, n))
y = doppler(x) + np.array(dm.rnorm(0, 1, n))  # y = f(x) + epsilon
xseq = np.array(dm.seql(0, 1, n))
knots = np.array(dm.seql(0, 1, nk))
yseq = doppler(xseq)
bsr = dm.BSR(x, y, knots)
psr = dm.PSR(x, y, knots, lam)
bfit = bsr.predict(xseq)
pfit = psr.predict(xseq)
plot = (
    dm.RPlot.create()
    .points(x, y, "samples", dm.RGBA(237, 199, 135, 0.6), 6.0)
    .lines(xseq, yseq, "True Mean", dm.RGB(200, 10, 44), 6.0)
    .lines(xseq, bfit, "B-spline fit (BSR)", dm.RGB(46, 160, 67), 6.0)
    .lines(xseq, pfit, "P-spline fit (PSR)", dm.RGB(44, 10, 200), 6.0)
    .title("Doppler data: B-spline vs P-spline")
    .xlab("X")
    .ylab("doppler(X)")
)
print(plot.to_svg())
```
