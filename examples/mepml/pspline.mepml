)
\tab(Octave,
Vectors come back as cell arrays; numeric arrays are accepted as input:

```{octave, results="output", exports="both"}
1;
datamunge;

function y = doppler(x)
  y = sin(20 ./ (x + 0.25));
end

n = 1000;
nk = 100; % Number of knots
lam = 1.0; % Smoothing parameter: larger is smoother
x = cell2mat(unif(0, 1, n));
y = doppler(x) + cell2mat(rnorm(0, 1, n)); % y = f(x) + epsilon
xseq = cell2mat(seql(0, 1, n));
knots = cell2mat(seql(0, 1, nk));
yseq = doppler(xseq);
bsr = BSplineRegression(x, y, knots);
psr = PSplineRegression(x, y, knots, lam);
bfit = bsr.predict(xseq);
pfit = psr.predict(xseq);
plot = RPlot.create();
plot.points(x, y, "samples", RGB(237, 199, 135, 0.6), 6.0);
plot.lines(xseq, yseq, "True Mean", RGB(200, 10, 44), 6.0);
plot.lines(xseq, bfit, "B-spline fit (BSR)", RGB(46, 160, 67), 6.0);
plot.lines(xseq, pfit, "P-spline fit (PSR)", RGB(44, 10, 200), 6.0);
plot.title("Doppler data: B-spline vs P-spline");
plot.xlab("X");
plot.ylab("doppler(X)");
disp(plot.to_svg());
```
