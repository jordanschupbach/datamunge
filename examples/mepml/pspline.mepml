\tab(D,
Compiled with ldc2; `-i` pulls in the generated binding modules:

```{d, results="output", exports="both", flags="-i -I../../src/datamunged/source"}
import std.algorithm : map;
import std.array : array;
import std.math : sin;
import std.range : zip;
import std.stdio : writeln;
import datamunge;

DVector doppler(DVector x) {
  return new DVector(x[].map!(xi => sin(20 / (xi + 0.25))).array);
}

void main() {
  size_t n = 1000;
  size_t nk = 100; // Number of knots
  double lam = 1.0; // Smoothing parameter: larger is smoother
  auto x = unif(0, 1, n);
  auto y = new DVector(zip(doppler(x)[], rnorm(0, 1, n)[]).map!(p => p[0] + p[1]).array); // y = f(x) + epsilon
  auto xseq = seql(0, 1, n);
  auto knots = seql(0, 1, nk);
  auto yseq = doppler(xseq);
  auto bsr = new BSplineRegression(x, y, knots);
  auto psr = new PSplineRegression(x, y, knots, lam);
  auto bfit = bsr.predict(xseq);
  auto pfit = psr.predict(xseq);
  auto plot = RPlot.create();
  plot.points(x, y, "samples", new RGB(237, 199, 135, 0.6), 6.0)
      .lines(xseq, yseq, "True Mean", new RGB(200, 10, 44), 6.0)
      .lines(xseq, bfit, "B-spline fit (BSR)", new RGB(46, 160, 67), 6.0)
      .lines(xseq, pfit, "P-spline fit (PSR)", new RGB(44, 10, 200), 6.0)
      .title("Doppler data: B-spline vs P-spline")
      .xlab("X")
      .ylab("doppler(X)");
  writeln(plot.to_svg());
}
