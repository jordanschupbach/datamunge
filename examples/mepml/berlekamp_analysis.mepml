  a=36 -> {6, 1003}  (check 6^2 mod 1009 = 36)
  a=49 -> {7, 1002}  (check 7^2 mod 1009 = 49)
  a=64 -> {8, 1001}  (check 8^2 mod 1009 = 64)
  a=81 -> {9, 1000}  (check 9^2 mod 1009 = 81)
  a=100 -> {10, 999}  (check 10^2 mod 1009 = 100)
