*> Linear discriminant analysis of iris species from all four measurements, with
*> predictions for new flowers and a discriminant plot.
*> CMD: just TARGET=lda_iris_ex run-cobol
IDENTIFICATION DIVISION.
PROGRAM-ID. LDA-IRIS-EX.
DATA DIVISION.
WORKING-STORAGE SECTION.
COPY "datamunge.cpy".

*> Four new flowers, one row per flower.
01 FLOWER-DATA.
   05 FILLER USAGE COMP-2 VALUE 5.1.  05 FILLER USAGE COMP-2 VALUE 3.5.
   05 FILLER USAGE COMP-2 VALUE 1.4.  05 FILLER USAGE COMP-2 VALUE 0.2.
   05 FILLER USAGE COMP-2 VALUE 6.0.  05 FILLER USAGE COMP-2 VALUE 2.7.
   05 FILLER USAGE COMP-2 VALUE 4.5.  05 FILLER USAGE COMP-2 VALUE 1.5.
   05 FILLER USAGE COMP-2 VALUE 6.5.  05 FILLER USAGE COMP-2 VALUE 3.0.
   05 FILLER USAGE COMP-2 VALUE 5.5.  05 FILLER USAGE COMP-2 VALUE 2.0.
   05 FILLER USAGE COMP-2 VALUE 6.2.  05 FILLER USAGE COMP-2 VALUE 2.8.
   05 FILLER USAGE COMP-2 VALUE 4.8.  05 FILLER USAGE COMP-2 VALUE 1.8.
01 FLOWERS REDEFINES FLOWER-DATA.
   05 FLOWER OCCURS 4.
      10 FLOWER-VALUE USAGE COMP-2 OCCURS 4.
01 FEATURE-DATA.
   05 FILLER PIC X(12) VALUE "Sepal.Length".
   05 FILLER PIC X(12) VALUE "Sepal.Width".
   05 FILLER PIC X(12) VALUE "Petal.Length".
   05 FILLER PIC X(12) VALUE "Petal.Width".
01 FEATURES REDEFINES FEATURE-DATA.
   05 FEATURE-NAME PIC X(12) OCCURS 4.

01 IRIS      USAGE BINARY-DOUBLE UNSIGNED.
01 MODEL     USAGE BINARY-DOUBLE UNSIGNED.
01 NEWDATA   USAGE BINARY-DOUBLE UNSIGNED.
01 FRAME     USAGE BINARY-DOUBLE UNSIGNED.
01 F         USAGE BINARY-LONG.
01 I         USAGE BINARY-LONG.
01 NUM-EDIT   PIC Z(8)9.
01 NUM-EDIT-2 PIC Z(8)9.

PROCEDURE DIVISION.
    CALL "dm_data_iris" USING DM-DATA-IRIS DM-STATUS
    PERFORM CHECK
    MOVE DM-DATA-IRIS-RESULT TO IRIS
    MOVE IRIS TO DM-DATA-FRAME-NROWS-SELF
    CALL "dm_data_frame_nrows" USING DM-DATA-FRAME-NROWS DM-STATUS
    PERFORM CHECK
    MOVE IRIS TO DM-DATA-FRAME-NCOLS-SELF
    CALL "dm_data_frame_ncols" USING DM-DATA-FRAME-NCOLS DM-STATUS
    PERFORM CHECK
    MOVE DM-DATA-FRAME-NROWS-RESULT TO NUM-EDIT
    MOVE DM-DATA-FRAME-NCOLS-RESULT TO NUM-EDIT-2
    DISPLAY "iris: " FUNCTION TRIM(NUM-EDIT) " rows x " FUNCTION TRIM(NUM-EDIT-2) " cols"
    DISPLAY " "

    MOVE IRIS TO DM-LDA-NEW-DATA
    MOVE "Species ~ Sepal.Length + Sepal.Width + Petal.Length + Petal.Width"
        TO DM-LDA-NEW-FORMULA
    CALL "dm_lda_new" USING DM-LDA-NEW DM-STATUS
    PERFORM CHECK
    MOVE DM-LDA-NEW-RESULT TO MODEL
    MOVE MODEL TO DM-LDA-PRINT-SUMMARY-SELF
    CALL "dm_lda_print_summary" USING DM-LDA-PRINT-SUMMARY DM-STATUS
    PERFORM CHECK

    DISPLAY " "
    DISPLAY "Confusion matrix (rows = actual, cols = predicted):"
    MOVE MODEL TO DM-LDA-CONFUSION-MATRIX-SELF
    CALL "dm_lda_confusion_matrix" USING DM-LDA-CONFUSION-MATRIX DM-STATUS
    PERFORM CHECK
    MOVE DM-LDA-CONFUSION-MATRIX-RESULT TO FRAME
    PERFORM DISPLAY-FRAME

    *> One numeric column per feature, taken down the FLOWER rows.
    CALL "dm_data_frame_new" USING DM-DATA-FRAME-NEW DM-STATUS
    PERFORM CHECK
    MOVE DM-DATA-FRAME-NEW-RESULT TO NEWDATA
    MOVE 4 TO DM-VECTOR-DOUBLE-TABLE-COUNT
    PERFORM VARYING F FROM 1 BY 1 UNTIL F > 4
        PERFORM VARYING I FROM 1 BY 1 UNTIL I > 4
            MOVE FLOWER-VALUE(I, F) TO DM-VECTOR-DOUBLE-TABLE-ITEM(I)
        END-PERFORM
        CALL "dm_vector_double_from_table" USING DM-VECTOR-DOUBLE-TABLE DM-STATUS
        PERFORM CHECK
        MOVE NEWDATA TO DM-DATA-FRAME-ADD-NUMERIC-COLUMN-SELF
        MOVE FEATURE-NAME(F) TO DM-DATA-FRAME-ADD-NUMERIC-COLUMN-COLUMN-NAME
        MOVE DM-VECTOR-DOUBLE-TABLE-SELF TO DM-DATA-FRAME-ADD-NUMERIC-COLUMN-VALUES
        CALL "dm_data_frame_add_numeric_column" USING DM-DATA-FRAME-ADD-NUMERIC-COLUMN DM-STATUS
        PERFORM CHECK
        MOVE DM-VECTOR-DOUBLE-TABLE-SELF TO DM-HANDLE-SELF
        CALL "dm_close" USING DM-HANDLE DM-STATUS
    END-PERFORM

    DISPLAY " "
    DISPLAY "Predictions for new flowers:"
    MOVE MODEL TO DM-LDA-PREDICT-FRAME-SELF
    MOVE NEWDATA TO DM-LDA-PREDICT-FRAME-NEWDATA
    CALL "dm_lda_predict_frame" USING DM-LDA-PREDICT-FRAME DM-STATUS
    PERFORM CHECK
    MOVE DM-LDA-PREDICT-FRAME-RESULT TO FRAME
    PERFORM DISPLAY-FRAME

    MOVE MODEL TO DM-LDA-SAVE-DISCRIMINANT-PLOT-SELF
    MOVE "lda_iris_discriminants.svg" TO DM-LDA-SAVE-DISCRIMINANT-PLOT-PATH
    CALL "dm_lda_save_discriminant_plot" USING DM-LDA-SAVE-DISCRIMINANT-PLOT DM-STATUS
    PERFORM CHECK
    DISPLAY " "
    DISPLAY "Saved discriminant plot as lda_iris_discriminants.svg"

    MOVE NEWDATA TO DM-HANDLE-SELF
    CALL "dm_close" USING DM-HANDLE DM-STATUS
    MOVE MODEL TO DM-HANDLE-SELF
    CALL "dm_close" USING DM-HANDLE DM-STATUS
    MOVE IRIS TO DM-HANDLE-SELF
    CALL "dm_close" USING DM-HANDLE DM-STATUS
    STOP RUN.

*> Displays the DataFrame FRAME and closes it.
DISPLAY-FRAME.
    MOVE FRAME TO DM-DATA-FRAME-TO-STRING-SELF
    CALL "dm_data_frame_to_string" USING DM-DATA-FRAME-TO-STRING DM-STATUS
    PERFORM CHECK
    DISPLAY DM-DATA-FRAME-TO-STRING-RESULT(1:DM-DATA-FRAME-TO-STRING-RESULT-LENGTH)
    MOVE FRAME TO DM-HANDLE-SELF
    CALL "dm_close" USING DM-HANDLE DM-STATUS.

*> Stops with the error after a failed call.
CHECK.
    IF NOT DM-STATUS-OK
        DISPLAY "datamunge error (" FUNCTION TRIM(DM-STATUS-KIND) "): "
            DM-STATUS-MESSAGE(1:DM-STATUS-LENGTH) UPON SYSERR
        STOP RUN RETURNING 1
    END-IF.
