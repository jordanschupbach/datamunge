*> Time series models: ARIMA and seasonal ARIMA on simulated series, then exponential
*> smoothing (Holt-Winters, simple, and Holt's linear trend).
*> The simulated noise comes from COBOL's FUNCTION RANDOM, so the numbers differ from
*> the Lua example's (Lua's math.random), though the fits behave the same way.
*> Run with `just run-cobol TARGET=timeseries_ex`.
IDENTIFICATION DIVISION.
PROGRAM-ID. TIMESERIES-EX.
DATA DIVISION.
WORKING-STORAGE SECTION.
COPY "datamunge.cpy".

01 SEASONAL-SHAPE-DATA.
   05 FILLER USAGE COMP-2 VALUE 0.8.
   05 FILLER USAGE COMP-2 VALUE 0.75.
   05 FILLER USAGE COMP-2 VALUE 0.9.
   05 FILLER USAGE COMP-2 VALUE 0.95.
   05 FILLER USAGE COMP-2 VALUE 1.0.
   05 FILLER USAGE COMP-2 VALUE 1.05.
   05 FILLER USAGE COMP-2 VALUE 1.1.
   05 FILLER USAGE COMP-2 VALUE 1.05.
   05 FILLER USAGE COMP-2 VALUE 1.0.
   05 FILLER USAGE COMP-2 VALUE 1.1.
   05 FILLER USAGE COMP-2 VALUE 1.3.
   05 FILLER USAGE COMP-2 VALUE 1.6.
01 SEASONAL-SHAPE REDEFINES SEASONAL-SHAPE-DATA.
   05 SEASONAL-FACTOR USAGE COMP-2 OCCURS 12.
01 FLAT-DATA.
   05 FILLER USAGE COMP-2 VALUE 50.2.
   05 FILLER USAGE COMP-2 VALUE 49.8.
   05 FILLER USAGE COMP-2 VALUE 50.5.
   05 FILLER USAGE COMP-2 VALUE 49.6.
   05 FILLER USAGE COMP-2 VALUE 50.1.
   05 FILLER USAGE COMP-2 VALUE 50.3.
   05 FILLER USAGE COMP-2 VALUE 49.9.
   05 FILLER USAGE COMP-2 VALUE 50.0.
   05 FILLER USAGE COMP-2 VALUE 50.4.
   05 FILLER USAGE COMP-2 VALUE 49.7.
01 FLAT REDEFINES FLAT-DATA.
   05 FLAT-ITEM USAGE COMP-2 OCCURS 10.

01 SERIES       USAGE BINARY-DOUBLE UNSIGNED.
01 MODEL-OPTIONS USAGE BINARY-DOUBLE UNSIGNED.
01 MODEL        USAGE BINARY-DOUBLE UNSIGNED.
*> The vector that SHOW-VECTOR prints, and its label.
01 VEC          USAGE BINARY-DOUBLE UNSIGNED.
01 LABEL-TEXT   PIC X(40).
01 I            USAGE BINARY-LONG.
01 SHOCK        USAGE COMP-2.
01 PREV-SHOCK   USAGE COMP-2.
01 LEVEL        USAGE COMP-2.
01 PREV         USAGE COMP-2.
01 GAUSS        USAGE COMP-2.
01 U1           USAGE COMP-2.
01 U2           USAGE COMP-2.
01 SEED-VALUE   USAGE COMP-2.
01 AR-COEF      USAGE COMP-2.

PROCEDURE DIVISION.
    DISPLAY "=================== ARIMA(1,1,1) on a simulated random walk with drift ==================="
    *> Integrated ARMA(0,1) increments with drift.
    COMPUTE SEED-VALUE = FUNCTION RANDOM(42)
    MOVE 100.0 TO LEVEL
    MOVE 0.0 TO PREV-SHOCK
    MOVE 0 TO DM-VECTOR-DOUBLE-TABLE-COUNT
    PERFORM 150 TIMES
        PERFORM NEXT-GAUSS
        MOVE GAUSS TO SHOCK
        COMPUTE LEVEL = LEVEL + 0.3 + 0.4 * PREV-SHOCK + SHOCK
        PERFORM APPEND-ITEM
        MOVE LEVEL TO DM-VECTOR-DOUBLE-TABLE-ITEM(DM-VECTOR-DOUBLE-TABLE-COUNT)
        MOVE SHOCK TO PREV-SHOCK
    END-PERFORM
    CALL "dm_vector_double_from_table" USING DM-VECTOR-DOUBLE-TABLE DM-STATUS
    PERFORM CHECK
    MOVE DM-VECTOR-DOUBLE-TABLE-SELF TO SERIES

    CALL "dm_arima_options_new" USING DM-ARIMA-OPTIONS-NEW DM-STATUS
    PERFORM CHECK
    MOVE DM-ARIMA-OPTIONS-NEW-RESULT TO MODEL-OPTIONS
    MOVE MODEL-OPTIONS TO DM-ARIMA-OPTIONS-P-SELF DM-ARIMA-OPTIONS-D-SELF DM-ARIMA-OPTIONS-Q-SELF
        DM-ARIMA-OPTIONS-DE-POPULATION-SIZE-SELF DM-ARIMA-OPTIONS-DE-MAX-GENERATIONS-SELF
    MOVE 1 TO DM-ARIMA-OPTIONS-P-VALUE
    CALL "dm_arima_options_p_set" USING DM-ARIMA-OPTIONS-P DM-STATUS
    MOVE 1 TO DM-ARIMA-OPTIONS-D-VALUE
    CALL "dm_arima_options_d_set" USING DM-ARIMA-OPTIONS-D DM-STATUS
    MOVE 1 TO DM-ARIMA-OPTIONS-Q-VALUE
    CALL "dm_arima_options_q_set" USING DM-ARIMA-OPTIONS-Q DM-STATUS
    MOVE 80 TO DM-ARIMA-OPTIONS-DE-POPULATION-SIZE-VALUE
    CALL "dm_arima_options_de_population_size_set" USING DM-ARIMA-OPTIONS-DE-POPULATION-SIZE DM-STATUS
    MOVE 400 TO DM-ARIMA-OPTIONS-DE-MAX-GENERATIONS-VALUE
    CALL "dm_arima_options_de_max_generations_set" USING DM-ARIMA-OPTIONS-DE-MAX-GENERATIONS DM-STATUS
    PERFORM CHECK
    PERFORM FIT-ARIMA

    MOVE MODEL TO DM-ARIMA-AR-COEFFICIENTS-SELF
    CALL "dm_arima_ar_coefficients" USING DM-ARIMA-AR-COEFFICIENTS DM-STATUS
    PERFORM CHECK
    MOVE DM-ARIMA-AR-COEFFICIENTS-RESULT TO VEC
    PERFORM FIRST-ITEM
    DISPLAY "AR coefficient: " DM-VECTOR-DOUBLE-VALUE
    MOVE MODEL TO DM-ARIMA-MA-COEFFICIENTS-SELF
    CALL "dm_arima_ma_coefficients" USING DM-ARIMA-MA-COEFFICIENTS DM-STATUS
    PERFORM CHECK
    MOVE DM-ARIMA-MA-COEFFICIENTS-RESULT TO VEC
    PERFORM FIRST-ITEM
    DISPLAY "MA coefficient: " DM-VECTOR-DOUBLE-VALUE
    MOVE MODEL TO DM-ARIMA-SIGMA2-SELF DM-ARIMA-AIC-SELF DM-ARIMA-BIC-SELF
    CALL "dm_arima_sigma2" USING DM-ARIMA-SIGMA2 DM-STATUS
    CALL "dm_arima_aic" USING DM-ARIMA-AIC DM-STATUS
    CALL "dm_arima_bic" USING DM-ARIMA-BIC DM-STATUS
    PERFORM CHECK
    DISPLAY "sigma^2: " DM-ARIMA-SIGMA2-RESULT ", AIC: " DM-ARIMA-AIC-RESULT
        ", BIC: " DM-ARIMA-BIC-RESULT

    *> The pair (forecasts, standard errors) arrives as -RESULT-FIRST and -RESULT-SECOND.
    MOVE MODEL TO DM-ARIMA-FORECAST-WITH-INTERVALS-SELF
    MOVE 6 TO DM-ARIMA-FORECAST-WITH-INTERVALS-HORIZON
    CALL "dm_arima_forecast_with_intervals" USING DM-ARIMA-FORECAST-WITH-INTERVALS DM-STATUS
    PERFORM CHECK
    MOVE "6-step forecast: " TO LABEL-TEXT
    MOVE DM-ARIMA-FORECAST-WITH-INTERVALS-RESULT-FIRST TO VEC
    PERFORM SHOW-VECTOR
    MOVE "forecast std. errors: " TO LABEL-TEXT
    MOVE DM-ARIMA-FORECAST-WITH-INTERVALS-RESULT-SECOND TO VEC
    PERFORM SHOW-VECTOR
    PERFORM CLOSE-MODEL-AND-OPTIONS

    DISPLAY " "
    DISPLAY "=================== SARIMA(1,0,0)(1,1,0)_12 on a seasonal series ==================="
    COMPUTE SEED-VALUE = FUNCTION RANDOM(7)
    MOVE 0.0 TO PREV
    MOVE 0 TO DM-VECTOR-DOUBLE-TABLE-COUNT
    PERFORM VARYING I FROM 0 BY 1 UNTIL I > 119
        PERFORM NEXT-GAUSS
        COMPUTE PREV = 0.5 * PREV + GAUSS
        PERFORM APPEND-ITEM
        COMPUTE DM-VECTOR-DOUBLE-TABLE-ITEM(DM-VECTOR-DOUBLE-TABLE-COUNT) =
            20.0 + 0.2 * I + 5.0 * FUNCTION SIN(2.0 * FUNCTION PI * I / 12.0) + PREV
    END-PERFORM
    CALL "dm_vector_double_from_table" USING DM-VECTOR-DOUBLE-TABLE DM-STATUS
    PERFORM CHECK
    MOVE DM-VECTOR-DOUBLE-TABLE-SELF TO SERIES

    CALL "dm_arima_options_new" USING DM-ARIMA-OPTIONS-NEW DM-STATUS
    PERFORM CHECK
    MOVE DM-ARIMA-OPTIONS-NEW-RESULT TO MODEL-OPTIONS
    MOVE MODEL-OPTIONS TO DM-ARIMA-OPTIONS-P-SELF DM-ARIMA-OPTIONS-SEASONAL-P-SELF
        DM-ARIMA-OPTIONS-SEASONAL-D-SELF DM-ARIMA-OPTIONS-SEASONAL-PERIOD-SELF
        DM-ARIMA-OPTIONS-DE-POPULATION-SIZE-SELF DM-ARIMA-OPTIONS-DE-MAX-GENERATIONS-SELF
    MOVE 1 TO DM-ARIMA-OPTIONS-P-VALUE
    CALL "dm_arima_options_p_set" USING DM-ARIMA-OPTIONS-P DM-STATUS
    MOVE 1 TO DM-ARIMA-OPTIONS-SEASONAL-P-VALUE
    CALL "dm_arima_options_seasonal_p_set" USING DM-ARIMA-OPTIONS-SEASONAL-P DM-STATUS
    MOVE 1 TO DM-ARIMA-OPTIONS-SEASONAL-D-VALUE
    CALL "dm_arima_options_seasonal_d_set" USING DM-ARIMA-OPTIONS-SEASONAL-D DM-STATUS
    MOVE 12 TO DM-ARIMA-OPTIONS-SEASONAL-PERIOD-VALUE
    CALL "dm_arima_options_seasonal_period_set" USING DM-ARIMA-OPTIONS-SEASONAL-PERIOD DM-STATUS
    MOVE 100 TO DM-ARIMA-OPTIONS-DE-POPULATION-SIZE-VALUE
    CALL "dm_arima_options_de_population_size_set" USING DM-ARIMA-OPTIONS-DE-POPULATION-SIZE DM-STATUS
    MOVE 500 TO DM-ARIMA-OPTIONS-DE-MAX-GENERATIONS-VALUE
    CALL "dm_arima_options_de_max_generations_set" USING DM-ARIMA-OPTIONS-DE-MAX-GENERATIONS DM-STATUS
    PERFORM CHECK
    PERFORM FIT-ARIMA

    MOVE MODEL TO DM-ARIMA-AR-COEFFICIENTS-SELF
    CALL "dm_arima_ar_coefficients" USING DM-ARIMA-AR-COEFFICIENTS DM-STATUS
    PERFORM CHECK
    MOVE DM-ARIMA-AR-COEFFICIENTS-RESULT TO VEC
    PERFORM FIRST-ITEM
    MOVE DM-VECTOR-DOUBLE-VALUE TO AR-COEF
    MOVE MODEL TO DM-ARIMA-SEASONAL-AR-COEFFICIENTS-SELF
    CALL "dm_arima_seasonal_ar_coefficients" USING DM-ARIMA-SEASONAL-AR-COEFFICIENTS DM-STATUS
    PERFORM CHECK
    MOVE DM-ARIMA-SEASONAL-AR-COEFFICIENTS-RESULT TO VEC
    PERFORM FIRST-ITEM
    DISPLAY "AR coefficient: " AR-COEF ", seasonal AR coefficient: " DM-VECTOR-DOUBLE-VALUE
    MOVE MODEL TO DM-ARIMA-FORECAST-SELF
    MOVE 12 TO DM-ARIMA-FORECAST-HORIZON
    CALL "dm_arima_forecast" USING DM-ARIMA-FORECAST DM-STATUS
    PERFORM CHECK
    MOVE "12-step forecast: " TO LABEL-TEXT
    MOVE DM-ARIMA-FORECAST-RESULT TO VEC
    PERFORM SHOW-VECTOR
    PERFORM CLOSE-MODEL-AND-OPTIONS

    DISPLAY " "
    DISPLAY "=================== Exponential smoothing: Holt-Winters on retail-style seasonal data ==================="
    COMPUTE SEED-VALUE = FUNCTION RANDOM(11)
    MOVE 0 TO DM-VECTOR-DOUBLE-TABLE-COUNT
    PERFORM VARYING I FROM 0 BY 1 UNTIL I > 47
        PERFORM NEXT-GAUSS
        PERFORM APPEND-ITEM
        COMPUTE DM-VECTOR-DOUBLE-TABLE-ITEM(DM-VECTOR-DOUBLE-TABLE-COUNT) =
            (100.0 + 2.0 * I) * SEASONAL-FACTOR(FUNCTION MOD(I, 12) + 1) + GAUSS * 3.0
    END-PERFORM
    CALL "dm_vector_double_from_table" USING DM-VECTOR-DOUBLE-TABLE DM-STATUS
    PERFORM CHECK
    MOVE DM-VECTOR-DOUBLE-TABLE-SELF TO SERIES

    PERFORM NEW-ES-OPTIONS
    MOVE DM-TREND-TYPE-ADDITIVE TO DM-EXPONENTIAL-SMOOTHING-OPTIONS-TREND-VALUE
    CALL "dm_exponential_smoothing_options_trend_set"
        USING DM-EXPONENTIAL-SMOOTHING-OPTIONS-TREND DM-STATUS
    PERFORM CHECK
    MOVE DM-SEASONAL-TYPE-MULTIPLICATIVE TO DM-EXPONENTIAL-SMOOTHING-OPTIONS-SEASONAL-VALUE
    CALL "dm_exponential_smoothing_options_seasonal_set"
        USING DM-EXPONENTIAL-SMOOTHING-OPTIONS-SEASONAL DM-STATUS
    PERFORM CHECK
    MOVE 12 TO DM-EXPONENTIAL-SMOOTHING-OPTIONS-SEASONAL-PERIOD-VALUE
    CALL "dm_exponential_smoothing_options_seasonal_period_set"
        USING DM-EXPONENTIAL-SMOOTHING-OPTIONS-SEASONAL-PERIOD DM-STATUS
    PERFORM CHECK
    MOVE 60 TO DM-EXPNNTL-SMOOTHING-OPTIONS-DE-POPULATION-SIZE-VALUE
    CALL "dm_exponential_smoothing_options_de_population_size_set"
        USING DM-EXPONENTIAL-SMOOTHING-OPTIONS-DE-POPULATION-SIZE DM-STATUS
    PERFORM CHECK
    MOVE 300 TO DM-EXPNNTL-SMOOTHING-OPTIONS-DE-MAX-GENERATIONS-VALUE
    CALL "dm_exponential_smoothing_options_de_max_generations_set"
        USING DM-EXPONENTIAL-SMOOTHING-OPTIONS-DE-MAX-GENERATIONS DM-STATUS
    PERFORM CHECK
    PERFORM FIT-ES
    MOVE MODEL TO DM-EXPONENTIAL-SMOOTHING-ALPHA-SELF DM-EXPONENTIAL-SMOOTHING-BETA-SELF
        DM-EXPONENTIAL-SMOOTHING-GAMMA-SELF DM-EXPONENTIAL-SMOOTHING-SIGMA2-SELF
        DM-EXPONENTIAL-SMOOTHING-AIC-SELF
    CALL "dm_exponential_smoothing_alpha" USING DM-EXPONENTIAL-SMOOTHING-ALPHA DM-STATUS
    CALL "dm_exponential_smoothing_beta" USING DM-EXPONENTIAL-SMOOTHING-BETA DM-STATUS
    CALL "dm_exponential_smoothing_gamma" USING DM-EXPONENTIAL-SMOOTHING-GAMMA DM-STATUS
    CALL "dm_exponential_smoothing_sigma2" USING DM-EXPONENTIAL-SMOOTHING-SIGMA2 DM-STATUS
    CALL "dm_exponential_smoothing_aic" USING DM-EXPONENTIAL-SMOOTHING-AIC DM-STATUS
    PERFORM CHECK
    DISPLAY "alpha=" DM-EXPONENTIAL-SMOOTHING-ALPHA-RESULT
        " beta=" DM-EXPONENTIAL-SMOOTHING-BETA-RESULT
        " gamma=" DM-EXPONENTIAL-SMOOTHING-GAMMA-RESULT
    DISPLAY "sigma^2: " DM-EXPONENTIAL-SMOOTHING-SIGMA2-RESULT
        ", AIC: " DM-EXPONENTIAL-SMOOTHING-AIC-RESULT
    MOVE "12-month forecast: " TO LABEL-TEXT
    MOVE 12 TO DM-EXPONENTIAL-SMOOTHING-FORECAST-HORIZON
    PERFORM SHOW-ES-FORECAST
    PERFORM CLOSE-MODEL-AND-OPTIONS

    DISPLAY " "
    DISPLAY "=================== Simple exponential smoothing vs. Holt's linear trend ==================="
    MOVE 10 TO DM-VECTOR-DOUBLE-TABLE-COUNT
    PERFORM VARYING I FROM 1 BY 1 UNTIL I > 10
        MOVE FLAT-ITEM(I) TO DM-VECTOR-DOUBLE-TABLE-ITEM(I)
    END-PERFORM
    CALL "dm_vector_double_from_table" USING DM-VECTOR-DOUBLE-TABLE DM-STATUS
    PERFORM CHECK
    MOVE DM-VECTOR-DOUBLE-TABLE-SELF TO SERIES

    *> Default options: no trend, no seasonality.
    PERFORM NEW-ES-OPTIONS
    PERFORM FIT-ES
    MOVE MODEL TO DM-EXPONENTIAL-SMOOTHING-ALPHA-SELF
    CALL "dm_exponential_smoothing_alpha" USING DM-EXPONENTIAL-SMOOTHING-ALPHA DM-STATUS
    PERFORM CHECK
    DISPLAY "SES alpha= " DM-EXPONENTIAL-SMOOTHING-ALPHA-RESULT
    MOVE "SES 5-step forecast: " TO LABEL-TEXT
    MOVE 5 TO DM-EXPONENTIAL-SMOOTHING-FORECAST-HORIZON
    PERFORM SHOW-ES-FORECAST
    MOVE MODEL TO DM-HANDLE-SELF
    CALL "dm_close" USING DM-HANDLE DM-STATUS

    *> Same series and options, with an additive trend.
    MOVE DM-TREND-TYPE-ADDITIVE TO DM-EXPONENTIAL-SMOOTHING-OPTIONS-TREND-VALUE
    CALL "dm_exponential_smoothing_options_trend_set"
        USING DM-EXPONENTIAL-SMOOTHING-OPTIONS-TREND DM-STATUS
    PERFORM CHECK
    PERFORM FIT-ES
    MOVE MODEL TO DM-EXPONENTIAL-SMOOTHING-ALPHA-SELF DM-EXPONENTIAL-SMOOTHING-BETA-SELF
    CALL "dm_exponential_smoothing_alpha" USING DM-EXPONENTIAL-SMOOTHING-ALPHA DM-STATUS
    CALL "dm_exponential_smoothing_beta" USING DM-EXPONENTIAL-SMOOTHING-BETA DM-STATUS
    PERFORM CHECK
    DISPLAY "Holt alpha=" DM-EXPONENTIAL-SMOOTHING-ALPHA-RESULT
        " beta=" DM-EXPONENTIAL-SMOOTHING-BETA-RESULT
    MOVE "Holt 5-step forecast: " TO LABEL-TEXT
    PERFORM SHOW-ES-FORECAST
    PERFORM CLOSE-MODEL-AND-OPTIONS
    STOP RUN.

*> Sets GAUSS to a standard normal draw (Box-Muller); 1 - RANDOM keeps the log argument positive.
NEXT-GAUSS.
    COMPUTE U1 = 1.0 - FUNCTION RANDOM
    COMPUTE U2 = FUNCTION RANDOM
    COMPUTE GAUSS = FUNCTION SQRT(-2.0 * FUNCTION LOG(U1)) * FUNCTION COS(2.0 * FUNCTION PI * U2).

*> Makes room for one more VECTOR-DOUBLE-TABLE item.
APPEND-ITEM.
    ADD 1 TO DM-VECTOR-DOUBLE-TABLE-COUNT.

*> Sets MODEL to an ARIMA fit of SERIES with MODEL-OPTIONS.
FIT-ARIMA.
    MOVE SERIES TO DM-ARIMA-NEW-Y
    MOVE 2 TO DM-ARIMA-NEW-GIVEN
    MOVE MODEL-OPTIONS TO DM-ARIMA-NEW-OPTIONS
    CALL "dm_arima_new" USING DM-ARIMA-NEW DM-STATUS
    PERFORM CHECK
    MOVE DM-ARIMA-NEW-RESULT TO MODEL.

*> Sets MODEL-OPTIONS to new default ExponentialSmoothingOptions and points the setters at it.
NEW-ES-OPTIONS.
    CALL "dm_exponential_smoothing_options_new" USING DM-EXPONENTIAL-SMOOTHING-OPTIONS-NEW DM-STATUS
    PERFORM CHECK
    MOVE DM-EXPONENTIAL-SMOOTHING-OPTIONS-NEW-RESULT TO MODEL-OPTIONS
    MOVE MODEL-OPTIONS TO DM-EXPONENTIAL-SMOOTHING-OPTIONS-TREND-SELF
        DM-EXPONENTIAL-SMOOTHING-OPTIONS-SEASONAL-SELF
        DM-EXPONENTIAL-SMOOTHING-OPTIONS-SEASONAL-PERIOD-SELF
        DM-EXPNNTL-SMOOTHING-OPTIONS-DE-POPULATION-SIZE-SELF
        DM-EXPNNTL-SMOOTHING-OPTIONS-DE-MAX-GENERATIONS-SELF.

*> Sets MODEL to an exponential smoothing fit of SERIES with MODEL-OPTIONS.
FIT-ES.
    MOVE SERIES TO DM-EXPONENTIAL-SMOOTHING-NEW-Y
    MOVE 2 TO DM-EXPONENTIAL-SMOOTHING-NEW-GIVEN
    MOVE MODEL-OPTIONS TO DM-EXPONENTIAL-SMOOTHING-NEW-OPTIONS
    CALL "dm_exponential_smoothing_new" USING DM-EXPONENTIAL-SMOOTHING-NEW DM-STATUS
    PERFORM CHECK
    MOVE DM-EXPONENTIAL-SMOOTHING-NEW-RESULT TO MODEL.

*> Prints LABEL-TEXT and MODEL's forecast over DM-EXPONENTIAL-SMOOTHING-FORECAST-HORIZON steps.
SHOW-ES-FORECAST.
    MOVE MODEL TO DM-EXPONENTIAL-SMOOTHING-FORECAST-SELF
    CALL "dm_exponential_smoothing_forecast" USING DM-EXPONENTIAL-SMOOTHING-FORECAST DM-STATUS
    PERFORM CHECK
    MOVE DM-EXPONENTIAL-SMOOTHING-FORECAST-RESULT TO VEC
    PERFORM SHOW-VECTOR.

*> Reads the first element of VEC into DM-VECTOR-DOUBLE-VALUE and closes VEC.
FIRST-ITEM.
    MOVE VEC TO DM-VECTOR-DOUBLE-SELF
    MOVE 1 TO DM-VECTOR-DOUBLE-INDEX
    CALL "dm_vector_double_get" USING DM-VECTOR-DOUBLE DM-STATUS
    PERFORM CHECK
    MOVE VEC TO DM-HANDLE-SELF
    CALL "dm_close" USING DM-HANDLE DM-STATUS.

*> Prints LABEL-TEXT then the elements of VEC separated by commas, and closes VEC.
SHOW-VECTOR.
    MOVE VEC TO DM-VECTOR-DOUBLE-TABLE-SELF
    MOVE 1 TO DM-VECTOR-DOUBLE-TABLE-START
    CALL "dm_vector_double_to_table" USING DM-VECTOR-DOUBLE-TABLE DM-STATUS
    PERFORM CHECK
    DISPLAY FUNCTION TRIM(LABEL-TEXT TRAILING) " " WITH NO ADVANCING
    PERFORM VARYING I FROM 1 BY 1 UNTIL I >= DM-VECTOR-DOUBLE-TABLE-COUNT
        DISPLAY DM-VECTOR-DOUBLE-TABLE-ITEM(I) ", " WITH NO ADVANCING
    END-PERFORM
    DISPLAY DM-VECTOR-DOUBLE-TABLE-ITEM(DM-VECTOR-DOUBLE-TABLE-COUNT)
    MOVE VEC TO DM-HANDLE-SELF
    CALL "dm_close" USING DM-HANDLE DM-STATUS.

*> Closes MODEL, MODEL-OPTIONS and SERIES.
CLOSE-MODEL-AND-OPTIONS.
    MOVE MODEL TO DM-HANDLE-SELF
    CALL "dm_close" USING DM-HANDLE DM-STATUS
    MOVE MODEL-OPTIONS TO DM-HANDLE-SELF
    CALL "dm_close" USING DM-HANDLE DM-STATUS
    MOVE SERIES TO DM-HANDLE-SELF
    CALL "dm_close" USING DM-HANDLE DM-STATUS.

*> Stops with the error after a failed call.
CHECK.
    IF NOT DM-STATUS-OK
        DISPLAY "datamunge error (" FUNCTION TRIM(DM-STATUS-KIND) "): "
            DM-STATUS-MESSAGE(1:DM-STATUS-LENGTH) UPON SYSERR
        STOP RUN RETURNING 1
    END-IF.
