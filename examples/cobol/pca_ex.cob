*> Principal component analysis of the iris measurements, scaled and unscaled.
*> CMD: just TARGET=pca_ex run-cobol
IDENTIFICATION DIVISION.
PROGRAM-ID. PCA-EX.
DATA DIVISION.
WORKING-STORAGE SECTION.
COPY "datamunge.cpy".

01 FEATURE-NAME-DATA.
   05 FILLER PIC X(12) VALUE "Sepal.Length".
   05 FILLER PIC X(12) VALUE "Sepal.Width".
   05 FILLER PIC X(12) VALUE "Petal.Length".
   05 FILLER PIC X(12) VALUE "Petal.Width".
01 FEATURE-NAMES REDEFINES FEATURE-NAME-DATA.
   05 FEATURE-NAME PIC X(12) OCCURS 4.

01 IRIS          USAGE BINARY-DOUBLE UNSIGNED.
01 FEATURES      USAGE BINARY-DOUBLE UNSIGNED.
01 SPECIES       USAGE BINARY-DOUBLE UNSIGNED.
01 PCA           USAGE BINARY-DOUBLE UNSIGNED.
01 UNSCALED      USAGE BINARY-DOUBLE UNSIGNED.
01 PLOT          USAGE BINARY-DOUBLE UNSIGNED.
01 FRAME         USAGE BINARY-DOUBLE UNSIGNED.
01 NROWS         USAGE BINARY-LONG.
01 ROW           USAGE BINARY-LONG.
01 I             USAGE BINARY-LONG.
01 SCALED-PC1    USAGE COMP-2.
01 UNSCALED-PC1  USAGE COMP-2.
01 LOADING-TEXT  PIC -9.9999.
01 PERCENT-TEXT  PIC ZZ9.99.
01 PERCENT-TEXT-2 PIC ZZ9.99.

PROCEDURE DIVISION.
    CALL "dm_data_iris" USING DM-DATA-IRIS DM-STATUS
    PERFORM CHECK
    MOVE DM-DATA-IRIS-RESULT TO IRIS
    MOVE 4 TO DM-VECTOR-STRING-TABLE-COUNT
    PERFORM VARYING I FROM 1 BY 1 UNTIL I > 4
        MOVE FEATURE-NAME(I) TO DM-VECTOR-STRING-TABLE-ITEM(I)
    END-PERFORM
    CALL "dm_vector_string_from_table" USING DM-VECTOR-STRING-TABLE DM-STATUS
    PERFORM CHECK
    MOVE DM-VECTOR-STRING-TABLE-SELF TO FEATURES

    *> Species labels, for the grouped (colored-by-species) scores plot.
    MOVE IRIS TO DM-DATA-FRAME-NROWS-SELF
    CALL "dm_data_frame_nrows" USING DM-DATA-FRAME-NROWS DM-STATUS
    MOVE DM-DATA-FRAME-NROWS-RESULT TO NROWS
    CALL "dm_vector_string_new" USING DM-VECTOR-STRING DM-STATUS
    PERFORM CHECK
    MOVE DM-VECTOR-STRING-SELF TO SPECIES
    MOVE IRIS TO DM-DATA-FRAME-STRING-AT-SELF
    MOVE "Species" TO DM-DATA-FRAME-STRING-AT-COLUMN-NAME
    PERFORM VARYING ROW FROM 0 BY 1 UNTIL ROW >= NROWS
        MOVE ROW TO DM-DATA-FRAME-STRING-AT-ROW-INDEX
        CALL "dm_data_frame_string_at" USING DM-DATA-FRAME-STRING-AT DM-STATUS
        PERFORM CHECK
        MOVE DM-DATA-FRAME-STRING-AT-RESULT(1:DM-DATA-FRAME-STRING-AT-RESULT-LENGTH)
            TO DM-VECTOR-STRING-VALUE
        CALL "dm_vector_string_push" USING DM-VECTOR-STRING DM-STATUS
        PERFORM CHECK
    END-PERFORM

    DISPLAY "=================== PCA on iris (scaled) ==================="
    MOVE IRIS TO DM-PCA-NEW-DATA
    MOVE FEATURES TO DM-PCA-NEW-FEATURE-COLUMNS
    MOVE 4 TO DM-PCA-NEW-GIVEN
    MOVE 1 TO DM-PCA-NEW-CENTER DM-PCA-NEW-SCALE
    CALL "dm_pca_new" USING DM-PCA-NEW DM-STATUS
    PERFORM CHECK
    MOVE DM-PCA-NEW-RESULT TO PCA
    MOVE PCA TO DM-PCA-PRINT-SUMMARY-SELF
    CALL "dm_pca_print_summary" USING DM-PCA-PRINT-SUMMARY DM-STATUS
    PERFORM CHECK

    DISPLAY " "
    DISPLAY "PC1 loadings (which original features drive it):"
    MOVE PCA TO DM-PCA-FEATURE-NAMES-SELF
    CALL "dm_pca_feature_names" USING DM-PCA-FEATURE-NAMES DM-STATUS
    PERFORM CHECK
    MOVE DM-PCA-FEATURE-NAMES-RESULT TO DM-VECTOR-STRING-TABLE-SELF
    CALL "dm_vector_string_to_table" USING DM-VECTOR-STRING-TABLE DM-STATUS
    PERFORM CHECK
    MOVE PCA TO DM-PCA-COMPONENT-LOADINGS-SELF
    MOVE 0 TO DM-PCA-COMPONENT-LOADINGS-COMPONENT-INDEX
    CALL "dm_pca_component_loadings" USING DM-PCA-COMPONENT-LOADINGS DM-STATUS
    PERFORM CHECK
    MOVE DM-PCA-COMPONENT-LOADINGS-RESULT TO DM-VECTOR-DOUBLE-TABLE-SELF
    CALL "dm_vector_double_to_table" USING DM-VECTOR-DOUBLE-TABLE DM-STATUS
    PERFORM CHECK
    PERFORM VARYING I FROM 1 BY 1 UNTIL I > DM-VECTOR-STRING-TABLE-COUNT
        COMPUTE LOADING-TEXT ROUNDED = DM-VECTOR-DOUBLE-TABLE-ITEM(I)
        DISPLAY "  " FUNCTION TRIM(DM-VECTOR-STRING-TABLE-ITEM(I)) ": "
            FUNCTION TRIM(LOADING-TEXT)
    END-PERFORM
    MOVE DM-VECTOR-STRING-TABLE-SELF TO DM-HANDLE-SELF
    CALL "dm_close" USING DM-HANDLE DM-STATUS
    MOVE DM-VECTOR-DOUBLE-TABLE-SELF TO DM-HANDLE-SELF
    CALL "dm_close" USING DM-HANDLE DM-STATUS

    DISPLAY " "
    DISPLAY "Training scores as a DataFrame:"
    MOVE PCA TO DM-PCA-SCORES-FRAME-SELF
    CALL "dm_pca_scores_frame" USING DM-PCA-SCORES-FRAME DM-STATUS
    PERFORM CHECK
    MOVE DM-PCA-SCORES-FRAME-RESULT TO FRAME
    PERFORM DISPLAY-FRAME

    MOVE PCA TO DM-PCA-PLOT-SCORES-GROUPED-SELF
    MOVE SPECIES TO DM-PCA-PLOT-SCORES-GROUPED-GROUP-LABELS
    CALL "dm_pca_plot_scores_grouped" USING DM-PCA-PLOT-SCORES-GROUPED DM-STATUS
    PERFORM CHECK
    MOVE DM-PCA-PLOT-SCORES-GROUPED-RESULT TO PLOT
    MOVE "pca_iris_scores.svg" TO DM-PLOT-SAVE-SVG-PATH
    PERFORM SAVE-PLOT
    DISPLAY " "
    DISPLAY "Scores scatter (colored by species) saved as pca_iris_scores.svg"

    MOVE PCA TO DM-PCA-PLOT-SCREE-SELF
    CALL "dm_pca_plot_scree" USING DM-PCA-PLOT-SCREE DM-STATUS
    PERFORM CHECK
    MOVE DM-PCA-PLOT-SCREE-RESULT TO PLOT
    MOVE "pca_iris_scree.svg" TO DM-PLOT-SAVE-SVG-PATH
    PERFORM SAVE-PLOT
    DISPLAY "Scree plot saved as pca_iris_scree.svg"

    DISPLAY " "
    DISPLAY "=================== PCA on iris (unscaled) ==================="
    MOVE 0 TO DM-PCA-NEW-SCALE
    CALL "dm_pca_new" USING DM-PCA-NEW DM-STATUS
    PERFORM CHECK
    MOVE DM-PCA-NEW-RESULT TO UNSCALED
    MOVE PCA TO DM-PCA-EXPLAINED-VARIANCE-RATIO-SELF
    PERFORM FIRST-RATIO
    MOVE DM-VECTOR-DOUBLE-VALUE TO SCALED-PC1
    MOVE UNSCALED TO DM-PCA-EXPLAINED-VARIANCE-RATIO-SELF
    PERFORM FIRST-RATIO
    MOVE DM-VECTOR-DOUBLE-VALUE TO UNSCALED-PC1
    COMPUTE PERCENT-TEXT ROUNDED = UNSCALED-PC1 * 100
    COMPUTE PERCENT-TEXT-2 ROUNDED = SCALED-PC1 * 100
    DISPLAY "PC1 explains " FUNCTION TRIM(PERCENT-TEXT) "% of variance (vs. "
        FUNCTION TRIM(PERCENT-TEXT-2) "% scaled) -- Sepal.Length's larger raw variance "
        "dominates the unscaled covariance matrix."
    STOP RUN.

*> Reads the first explained-variance ratio of the PCA in -SELF into DM-VECTOR-DOUBLE-VALUE.
FIRST-RATIO.
    CALL "dm_pca_explained_variance_ratio" USING DM-PCA-EXPLAINED-VARIANCE-RATIO DM-STATUS
    PERFORM CHECK
    MOVE DM-PCA-EXPLAINED-VARIANCE-RATIO-RESULT TO DM-VECTOR-DOUBLE-SELF
    MOVE 1 TO DM-VECTOR-DOUBLE-INDEX
    CALL "dm_vector_double_get" USING DM-VECTOR-DOUBLE DM-STATUS
    PERFORM CHECK
    MOVE DM-VECTOR-DOUBLE-SELF TO DM-HANDLE-SELF
    CALL "dm_close" USING DM-HANDLE DM-STATUS.

*> Saves PLOT as SVG to DM-PLOT-SAVE-SVG-PATH and closes it.
SAVE-PLOT.
    MOVE PLOT TO DM-PLOT-SAVE-SVG-SELF
    CALL "dm_plot_save_svg" USING DM-PLOT-SAVE-SVG DM-STATUS
    PERFORM CHECK
    MOVE PLOT TO DM-HANDLE-SELF
    CALL "dm_close" USING DM-HANDLE DM-STATUS.

*> Displays the DataFrame FRAME and closes it.
DISPLAY-FRAME.
    MOVE FRAME TO DM-DATA-FRAME-TO-STRING-SELF
    CALL "dm_data_frame_to_string" USING DM-DATA-FRAME-TO-STRING DM-STATUS
    PERFORM CHECK
    DISPLAY DM-DATA-FRAME-TO-STRING-RESULT(1:DM-DATA-FRAME-TO-STRING-RESULT-LENGTH)
    MOVE FRAME TO DM-HANDLE-SELF
    CALL "dm_close" USING DM-HANDLE DM-STATUS.

*> Stops with the error after a failed call.
CHECK.
    IF NOT DM-STATUS-OK
        DISPLAY "datamunge error (" FUNCTION TRIM(DM-STATUS-KIND) "): "
            DM-STATUS-MESSAGE(1:DM-STATUS-LENGTH) UPON SYSERR
        STOP RUN RETURNING 1
    END-IF.
