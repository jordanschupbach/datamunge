*> Support vector machine on iris: RBF and linear kernels, confusion matrix and predictions.
*> CMD: just TARGET=svm_iris_ex run-cobol
IDENTIFICATION DIVISION.
PROGRAM-ID. SVM-IRIS-EX.
DATA DIVISION.
WORKING-STORAGE SECTION.
COPY "datamunge.cpy".

*> Four new flowers, one row per flower: sepal length/width, petal length/width.
01 NEW-FLOWER-DATA.
   05 FILLER USAGE COMP-2 VALUE 5.1.
   05 FILLER USAGE COMP-2 VALUE 3.5.
   05 FILLER USAGE COMP-2 VALUE 1.4.
   05 FILLER USAGE COMP-2 VALUE 0.2.
   05 FILLER USAGE COMP-2 VALUE 6.0.
   05 FILLER USAGE COMP-2 VALUE 2.7.
   05 FILLER USAGE COMP-2 VALUE 4.5.
   05 FILLER USAGE COMP-2 VALUE 1.5.
   05 FILLER USAGE COMP-2 VALUE 6.5.
   05 FILLER USAGE COMP-2 VALUE 3.0.
   05 FILLER USAGE COMP-2 VALUE 5.5.
   05 FILLER USAGE COMP-2 VALUE 2.0.
   05 FILLER USAGE COMP-2 VALUE 6.2.
   05 FILLER USAGE COMP-2 VALUE 2.8.
   05 FILLER USAGE COMP-2 VALUE 4.8.
   05 FILLER USAGE COMP-2 VALUE 1.8.
01 NEW-FLOWERS REDEFINES NEW-FLOWER-DATA.
   05 NEW-FLOWER OCCURS 4.
      10 NEW-FEATURE USAGE COMP-2 OCCURS 4.
01 FEATURE-NAME-DATA.
   05 FILLER PIC X(12) VALUE "Sepal.Length".
   05 FILLER PIC X(12) VALUE "Sepal.Width".
   05 FILLER PIC X(12) VALUE "Petal.Length".
   05 FILLER PIC X(12) VALUE "Petal.Width".
01 FEATURE-NAMES REDEFINES FEATURE-NAME-DATA.
   05 FEATURE-NAME PIC X(12) OCCURS 4.

01 IRIS-FORMULA PIC X(80)
   VALUE "Species ~ Sepal.Length + Sepal.Width + Petal.Length + Petal.Width".
01 IRIS         USAGE BINARY-DOUBLE UNSIGNED.
01 RBF-MODEL    USAGE BINARY-DOUBLE UNSIGNED.
01 LINEAR-MODEL USAGE BINARY-DOUBLE UNSIGNED.
01 NEWDATA      USAGE BINARY-DOUBLE UNSIGNED.
01 FRAME        USAGE BINARY-DOUBLE UNSIGNED.
01 ROWS-TEXT    PIC Z(9)9.
01 COLS-TEXT    PIC Z(9)9.
01 COUNT-TEXT   PIC Z(9)9.
01 PERCENT      USAGE COMP-2.
01 I            USAGE BINARY-LONG.
01 J            USAGE BINARY-LONG.

PROCEDURE DIVISION.
    CALL "dm_data_iris" USING DM-DATA-IRIS DM-STATUS
    PERFORM CHECK
    MOVE DM-DATA-IRIS-RESULT TO IRIS
    MOVE IRIS TO DM-DATA-FRAME-NROWS-SELF DM-DATA-FRAME-NCOLS-SELF
    CALL "dm_data_frame_nrows" USING DM-DATA-FRAME-NROWS DM-STATUS
    CALL "dm_data_frame_ncols" USING DM-DATA-FRAME-NCOLS DM-STATUS
    MOVE DM-DATA-FRAME-NROWS-RESULT TO ROWS-TEXT
    MOVE DM-DATA-FRAME-NCOLS-RESULT TO COLS-TEXT
    DISPLAY "iris: " FUNCTION TRIM(ROWS-TEXT) " rows x " FUNCTION TRIM(COLS-TEXT) " cols"
    DISPLAY " "

    DISPLAY "=== RBF kernel (default) ==="
    MOVE IRIS TO DM-SVM-NEW-DATA
    MOVE IRIS-FORMULA TO DM-SVM-NEW-FORMULA
    CALL "dm_svm_new" USING DM-SVM-NEW DM-STATUS
    PERFORM CHECK
    MOVE DM-SVM-NEW-RESULT TO RBF-MODEL
    MOVE RBF-MODEL TO DM-SVM-PRINT-SUMMARY-SELF
    CALL "dm_svm_print_summary" USING DM-SVM-PRINT-SUMMARY DM-STATUS
    PERFORM CHECK
    DISPLAY " "
    DISPLAY "Confusion matrix (rows = actual, cols = predicted):"
    MOVE RBF-MODEL TO DM-SVM-CONFUSION-MATRIX-SELF
    CALL "dm_svm_confusion_matrix" USING DM-SVM-CONFUSION-MATRIX DM-STATUS
    PERFORM CHECK
    MOVE DM-SVM-CONFUSION-MATRIX-RESULT TO FRAME
    PERFORM DISPLAY-FRAME

    DISPLAY " "
    DISPLAY "=== Linear kernel, for comparison ==="
    MOVE 3 TO DM-SVM-NEW-GIVEN
    MOVE "linear" TO DM-SVM-NEW-KERNEL
    CALL "dm_svm_new" USING DM-SVM-NEW DM-STATUS
    PERFORM CHECK
    MOVE DM-SVM-NEW-RESULT TO LINEAR-MODEL
    MOVE LINEAR-MODEL TO DM-SVM-TRAINING-ACCURACY-SELF DM-SVM-NUM-SUPPORT-VECTORS-SELF
    CALL "dm_svm_training_accuracy" USING DM-SVM-TRAINING-ACCURACY DM-STATUS
    PERFORM CHECK
    COMPUTE PERCENT = DM-SVM-TRAINING-ACCURACY-RESULT * 100.0
    DISPLAY "Training accuracy: " PERCENT "%"
    CALL "dm_svm_num_support_vectors" USING DM-SVM-NUM-SUPPORT-VECTORS DM-STATUS
    PERFORM CHECK
    MOVE DM-SVM-NUM-SUPPORT-VECTORS-RESULT TO COUNT-TEXT
    DISPLAY "Support vectors: " FUNCTION TRIM(COUNT-TEXT)

    *> New flowers to classify, one numeric column per feature.
    CALL "dm_data_frame_new" USING DM-DATA-FRAME-NEW DM-STATUS
    PERFORM CHECK
    MOVE DM-DATA-FRAME-NEW-RESULT TO NEWDATA
    MOVE 4 TO DM-VECTOR-DOUBLE-TABLE-COUNT
    PERFORM VARYING J FROM 1 BY 1 UNTIL J > 4
        PERFORM VARYING I FROM 1 BY 1 UNTIL I > 4
            MOVE NEW-FEATURE(I, J) TO DM-VECTOR-DOUBLE-TABLE-ITEM(I)
        END-PERFORM
        MOVE FEATURE-NAME(J) TO DM-DATA-FRAME-ADD-NUMERIC-COLUMN-COLUMN-NAME
        PERFORM ADD-NUMERIC-COLUMN
    END-PERFORM

    DISPLAY " "
    DISPLAY "RBF predictions for new flowers (votes out of 3 one-vs-one pairs):"
    MOVE RBF-MODEL TO DM-SVM-PREDICT-FRAME-SELF
    MOVE NEWDATA TO DM-SVM-PREDICT-FRAME-NEWDATA
    CALL "dm_svm_predict_frame" USING DM-SVM-PREDICT-FRAME DM-STATUS
    PERFORM CHECK
    MOVE DM-SVM-PREDICT-FRAME-RESULT TO FRAME
    PERFORM DISPLAY-FRAME
    STOP RUN.

*> Adds the VECTOR-DOUBLE-TABLE items as a column of NEWDATA.
ADD-NUMERIC-COLUMN.
    CALL "dm_vector_double_from_table" USING DM-VECTOR-DOUBLE-TABLE DM-STATUS
    PERFORM CHECK
    MOVE NEWDATA TO DM-DATA-FRAME-ADD-NUMERIC-COLUMN-SELF
    MOVE DM-VECTOR-DOUBLE-TABLE-SELF TO DM-DATA-FRAME-ADD-NUMERIC-COLUMN-VALUES
    CALL "dm_data_frame_add_numeric_column" USING DM-DATA-FRAME-ADD-NUMERIC-COLUMN DM-STATUS
    PERFORM CHECK
    MOVE DM-VECTOR-DOUBLE-TABLE-SELF TO DM-HANDLE-SELF
    CALL "dm_close" USING DM-HANDLE DM-STATUS.

*> Displays the DataFrame FRAME and closes it.
DISPLAY-FRAME.
    MOVE FRAME TO DM-DATA-FRAME-TO-STRING-SELF
    CALL "dm_data_frame_to_string" USING DM-DATA-FRAME-TO-STRING DM-STATUS
    PERFORM CHECK
    DISPLAY DM-DATA-FRAME-TO-STRING-RESULT(1:DM-DATA-FRAME-TO-STRING-RESULT-LENGTH)
    MOVE FRAME TO DM-HANDLE-SELF
    CALL "dm_close" USING DM-HANDLE DM-STATUS.

*> Stops with the error after a failed call.
CHECK.
    IF NOT DM-STATUS-OK
        DISPLAY "datamunge error (" FUNCTION TRIM(DM-STATUS-KIND) "): "
            DM-STATUS-MESSAGE(1:DM-STATUS-LENGTH) UPON SYSERR
        STOP RUN RETURNING 1
    END-IF.
