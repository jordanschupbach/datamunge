*> Linear regression: mpg ~ hp + wt + transmission, with ANOVA and predictions.
*> Run with `just run-cobol TARGET=lm_ex`.
IDENTIFICATION DIVISION.
PROGRAM-ID. LM-EX.
DATA DIVISION.
WORKING-STORAGE SECTION.
COPY "datamunge.cpy".

01 HP-DATA.
   05 FILLER USAGE COMP-2 VALUE 110.0.
   05 FILLER USAGE COMP-2 VALUE 110.0.
   05 FILLER USAGE COMP-2 VALUE 93.0.
   05 FILLER USAGE COMP-2 VALUE 110.0.
   05 FILLER USAGE COMP-2 VALUE 175.0.
   05 FILLER USAGE COMP-2 VALUE 105.0.
   05 FILLER USAGE COMP-2 VALUE 245.0.
   05 FILLER USAGE COMP-2 VALUE 62.0.
   05 FILLER USAGE COMP-2 VALUE 95.0.
   05 FILLER USAGE COMP-2 VALUE 123.0.
01 HP REDEFINES HP-DATA.
   05 HP-ITEM USAGE COMP-2 OCCURS 10.
01 WT-DATA.
   05 FILLER USAGE COMP-2 VALUE 2.62.
   05 FILLER USAGE COMP-2 VALUE 2.875.
   05 FILLER USAGE COMP-2 VALUE 2.32.
   05 FILLER USAGE COMP-2 VALUE 3.215.
   05 FILLER USAGE COMP-2 VALUE 3.44.
   05 FILLER USAGE COMP-2 VALUE 3.46.
   05 FILLER USAGE COMP-2 VALUE 3.57.
   05 FILLER USAGE COMP-2 VALUE 3.19.
   05 FILLER USAGE COMP-2 VALUE 3.15.
   05 FILLER USAGE COMP-2 VALUE 3.44.
01 WT REDEFINES WT-DATA.
   05 WT-ITEM USAGE COMP-2 OCCURS 10.
01 MPG-DATA.
   05 FILLER USAGE COMP-2 VALUE 21.0.
   05 FILLER USAGE COMP-2 VALUE 21.0.
   05 FILLER USAGE COMP-2 VALUE 22.8.
   05 FILLER USAGE COMP-2 VALUE 21.4.
   05 FILLER USAGE COMP-2 VALUE 18.7.
   05 FILLER USAGE COMP-2 VALUE 18.1.
   05 FILLER USAGE COMP-2 VALUE 14.3.
   05 FILLER USAGE COMP-2 VALUE 24.4.
   05 FILLER USAGE COMP-2 VALUE 22.8.
   05 FILLER USAGE COMP-2 VALUE 19.2.
01 MPG REDEFINES MPG-DATA.
   05 MPG-ITEM USAGE COMP-2 OCCURS 10.

01 CARS      USAGE BINARY-DOUBLE UNSIGNED.
01 NEWCARS   USAGE BINARY-DOUBLE UNSIGNED.
01 MODEL     USAGE BINARY-DOUBLE UNSIGNED.
01 FRAME     USAGE BINARY-DOUBLE UNSIGNED.
01 I         USAGE BINARY-LONG.

PROCEDURE DIVISION.
    CALL "dm_data_frame_new" USING DM-DATA-FRAME-NEW DM-STATUS
    PERFORM CHECK
    MOVE DM-DATA-FRAME-NEW-RESULT TO CARS

    *> Numeric columns: copy each COBOL table into a VECTOR-DOUBLE.
    MOVE 10 TO DM-VECTOR-DOUBLE-TABLE-COUNT
    PERFORM VARYING I FROM 1 BY 1 UNTIL I > 10
        MOVE HP-ITEM(I) TO DM-VECTOR-DOUBLE-TABLE-ITEM(I)
    END-PERFORM
    MOVE "hp" TO DM-DATA-FRAME-ADD-NUMERIC-COLUMN-COLUMN-NAME
    PERFORM ADD-NUMERIC-COLUMN
    PERFORM VARYING I FROM 1 BY 1 UNTIL I > 10
        MOVE WT-ITEM(I) TO DM-VECTOR-DOUBLE-TABLE-ITEM(I)
    END-PERFORM
    MOVE "wt" TO DM-DATA-FRAME-ADD-NUMERIC-COLUMN-COLUMN-NAME
    PERFORM ADD-NUMERIC-COLUMN

    *> A string column: three manual cars, then seven automatic.
    MOVE 10 TO DM-VECTOR-STRING-TABLE-COUNT
    PERFORM VARYING I FROM 1 BY 1 UNTIL I > 10
        IF I <= 3
            MOVE "manual" TO DM-VECTOR-STRING-TABLE-ITEM(I)
        ELSE
            MOVE "automatic" TO DM-VECTOR-STRING-TABLE-ITEM(I)
        END-IF
        MOVE -1 TO DM-VECTOR-STRING-TABLE-ITEM-LENGTH(I)
    END-PERFORM
    CALL "dm_vector_string_from_table" USING DM-VECTOR-STRING-TABLE DM-STATUS
    PERFORM CHECK
    MOVE CARS TO DM-DATA-FRAME-ADD-STRING-COLUMN-SELF
    MOVE "transmission" TO DM-DATA-FRAME-ADD-STRING-COLUMN-COLUMN-NAME
    MOVE DM-VECTOR-STRING-TABLE-SELF TO DM-DATA-FRAME-ADD-STRING-COLUMN-VALUES
    CALL "dm_data_frame_add_string_column" USING DM-DATA-FRAME-ADD-STRING-COLUMN DM-STATUS
    PERFORM CHECK
    MOVE DM-VECTOR-STRING-TABLE-SELF TO DM-HANDLE-SELF
    CALL "dm_close" USING DM-HANDLE DM-STATUS

    PERFORM VARYING I FROM 1 BY 1 UNTIL I > 10
        MOVE MPG-ITEM(I) TO DM-VECTOR-DOUBLE-TABLE-ITEM(I)
    END-PERFORM
    MOVE "mpg" TO DM-DATA-FRAME-ADD-NUMERIC-COLUMN-COLUMN-NAME
    PERFORM ADD-NUMERIC-COLUMN

    DISPLAY "Fitting: mpg ~ hp + wt + transmission"
    DISPLAY " "
    MOVE CARS TO DM-LM-NEW-DATA
    MOVE "mpg ~ hp + wt + transmission" TO DM-LM-NEW-FORMULA
    CALL "dm_lm_new" USING DM-LM-NEW DM-STATUS
    PERFORM CHECK
    MOVE DM-LM-NEW-RESULT TO MODEL
    MOVE MODEL TO DM-LM-PRINT-SUMMARY-SELF
    CALL "dm_lm_print_summary" USING DM-LM-PRINT-SUMMARY DM-STATUS
    PERFORM CHECK

    DISPLAY " "
    DISPLAY "Sequential ANOVA:"
    MOVE MODEL TO DM-LM-ANOVA-SELF
    CALL "dm_lm_anova" USING DM-LM-ANOVA DM-STATUS
    PERFORM CHECK
    MOVE DM-LM-ANOVA-RESULT TO FRAME
    PERFORM DISPLAY-FRAME

    *> New data to predict: two cars.
    CALL "dm_data_frame_new" USING DM-DATA-FRAME-NEW DM-STATUS
    PERFORM CHECK
    MOVE DM-DATA-FRAME-NEW-RESULT TO NEWCARS
    MOVE 2 TO DM-VECTOR-DOUBLE-TABLE-COUNT
    MOVE 150.0 TO DM-VECTOR-DOUBLE-TABLE-ITEM(1)
    MOVE 90.0 TO DM-VECTOR-DOUBLE-TABLE-ITEM(2)
    MOVE "hp" TO DM-DATA-FRAME-ADD-NUMERIC-COLUMN-COLUMN-NAME
    MOVE NEWCARS TO DM-DATA-FRAME-ADD-NUMERIC-COLUMN-SELF
    PERFORM ADD-COLUMN-TO
    MOVE 3.0 TO DM-VECTOR-DOUBLE-TABLE-ITEM(1)
    MOVE 2.5 TO DM-VECTOR-DOUBLE-TABLE-ITEM(2)
    MOVE "wt" TO DM-DATA-FRAME-ADD-NUMERIC-COLUMN-COLUMN-NAME
    PERFORM ADD-COLUMN-TO
    MOVE 2 TO DM-VECTOR-STRING-TABLE-COUNT
    MOVE "manual" TO DM-VECTOR-STRING-TABLE-ITEM(1)
    MOVE "automatic" TO DM-VECTOR-STRING-TABLE-ITEM(2)
    CALL "dm_vector_string_from_table" USING DM-VECTOR-STRING-TABLE DM-STATUS
    PERFORM CHECK
    MOVE NEWCARS TO DM-DATA-FRAME-ADD-STRING-COLUMN-SELF
    MOVE DM-VECTOR-STRING-TABLE-SELF TO DM-DATA-FRAME-ADD-STRING-COLUMN-VALUES
    CALL "dm_data_frame_add_string_column" USING DM-DATA-FRAME-ADD-STRING-COLUMN DM-STATUS
    PERFORM CHECK

    MOVE MODEL TO DM-LM-PREDICT-FRAME-SELF
    MOVE NEWCARS TO DM-LM-PREDICT-FRAME-NEWDATA
    MOVE 2 TO DM-LM-PREDICT-FRAME-GIVEN
    MOVE "confidence" TO DM-LM-PREDICT-FRAME-INTERVAL-KIND
    CALL "dm_lm_predict_frame" USING DM-LM-PREDICT-FRAME DM-STATUS
    PERFORM CHECK
    DISPLAY " "
    DISPLAY "Predictions with 95% confidence intervals:"
    MOVE DM-LM-PREDICT-FRAME-RESULT TO FRAME
    PERFORM DISPLAY-FRAME

    MOVE MODEL TO DM-LM-SAVE-DIAGNOSTIC-PLOTS-SELF
    MOVE "lm_ex_diagnostics" TO DM-LM-SAVE-DIAGNOSTIC-PLOTS-PATH-PREFIX
    CALL "dm_lm_save_diagnostic_plots" USING DM-LM-SAVE-DIAGNOSTIC-PLOTS DM-STATUS
    PERFORM CHECK
    DISPLAY " "
    DISPLAY "Saved diagnostic plots as lm_ex_diagnostics_*.svg"
    STOP RUN.

*> Adds the VECTOR-DOUBLE-TABLE items as a column of CARS.
ADD-NUMERIC-COLUMN.
    MOVE CARS TO DM-DATA-FRAME-ADD-NUMERIC-COLUMN-SELF
    PERFORM ADD-COLUMN-TO.

*> Adds the VECTOR-DOUBLE-TABLE items as a column of DM-DATA-FRAME-ADD-NUMERIC-COLUMN-SELF.
ADD-COLUMN-TO.
    CALL "dm_vector_double_from_table" USING DM-VECTOR-DOUBLE-TABLE DM-STATUS
    PERFORM CHECK
    MOVE DM-VECTOR-DOUBLE-TABLE-SELF TO DM-DATA-FRAME-ADD-NUMERIC-COLUMN-VALUES
    CALL "dm_data_frame_add_numeric_column" USING DM-DATA-FRAME-ADD-NUMERIC-COLUMN DM-STATUS
    PERFORM CHECK
    MOVE DM-VECTOR-DOUBLE-TABLE-SELF TO DM-HANDLE-SELF
    CALL "dm_close" USING DM-HANDLE DM-STATUS.

*> Displays the DataFrame FRAME and closes it.
DISPLAY-FRAME.
    MOVE FRAME TO DM-DATA-FRAME-TO-STRING-SELF
    CALL "dm_data_frame_to_string" USING DM-DATA-FRAME-TO-STRING DM-STATUS
    PERFORM CHECK
    DISPLAY DM-DATA-FRAME-TO-STRING-RESULT(1:DM-DATA-FRAME-TO-STRING-RESULT-LENGTH)
    MOVE FRAME TO DM-HANDLE-SELF
    CALL "dm_close" USING DM-HANDLE DM-STATUS.

*> Stops with the error after a failed call.
CHECK.
    IF NOT DM-STATUS-OK
        DISPLAY "datamunge error (" FUNCTION TRIM(DM-STATUS-KIND) "): "
            DM-STATUS-MESSAGE(1:DM-STATUS-LENGTH) UPON SYSERR
        STOP RUN RETURNING 1
    END-IF.
