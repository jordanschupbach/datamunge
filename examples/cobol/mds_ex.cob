*> Classical multidimensional scaling of the iris measurements into two dimensions,
*> with euclidean and manhattan distances.
*> CMD: just TARGET=mds_ex run-cobol
IDENTIFICATION DIVISION.
PROGRAM-ID. MDS-EX.
DATA DIVISION.
WORKING-STORAGE SECTION.
COPY "datamunge.cpy".

01 FEATURE-DATA.
   05 FILLER PIC X(12) VALUE "Sepal.Length".
   05 FILLER PIC X(12) VALUE "Sepal.Width".
   05 FILLER PIC X(12) VALUE "Petal.Length".
   05 FILLER PIC X(12) VALUE "Petal.Width".
01 FEATURE-NAMES REDEFINES FEATURE-DATA.
   05 FEATURE-NAME PIC X(12) OCCURS 4.

01 IRIS          USAGE BINARY-DOUBLE UNSIGNED.
01 FEATURES      USAGE BINARY-DOUBLE UNSIGNED.
01 SPECIES       USAGE BINARY-DOUBLE UNSIGNED.
01 MDS           USAGE BINARY-DOUBLE UNSIGNED.
01 MANHATTAN-MDS USAGE BINARY-DOUBLE UNSIGNED.
01 FRAME         USAGE BINARY-DOUBLE UNSIGNED.
01 SCATTER       USAGE BINARY-DOUBLE UNSIGNED.
01 NROWS         USAGE BINARY-DOUBLE UNSIGNED.
01 ROW           USAGE BINARY-DOUBLE UNSIGNED.
01 I             USAGE BINARY-LONG.
01 FIT-EDIT      PIC -9.9999.
01 FIT-EDIT-2    PIC -9.9999.

PROCEDURE DIVISION.
    CALL "dm_data_iris" USING DM-DATA-IRIS DM-STATUS
    PERFORM CHECK
    MOVE DM-DATA-IRIS-RESULT TO IRIS
    MOVE 4 TO DM-VECTOR-STRING-TABLE-COUNT
    PERFORM VARYING I FROM 1 BY 1 UNTIL I > 4
        MOVE FEATURE-NAME(I) TO DM-VECTOR-STRING-TABLE-ITEM(I)
        MOVE -1 TO DM-VECTOR-STRING-TABLE-ITEM-LENGTH(I)
    END-PERFORM
    CALL "dm_vector_string_from_table" USING DM-VECTOR-STRING-TABLE DM-STATUS
    PERFORM CHECK
    MOVE DM-VECTOR-STRING-TABLE-SELF TO FEATURES

    *> The species of every row, to color the embedding by.
    MOVE IRIS TO DM-DATA-FRAME-NROWS-SELF
    CALL "dm_data_frame_nrows" USING DM-DATA-FRAME-NROWS DM-STATUS
    PERFORM CHECK
    MOVE DM-DATA-FRAME-NROWS-RESULT TO NROWS
    MOVE NROWS TO DM-VECTOR-STRING-TABLE-COUNT
    PERFORM VARYING ROW FROM 0 BY 1 UNTIL ROW >= NROWS
        MOVE IRIS TO DM-DATA-FRAME-STRING-AT-SELF
        MOVE "Species" TO DM-DATA-FRAME-STRING-AT-COLUMN-NAME
        MOVE ROW TO DM-DATA-FRAME-STRING-AT-ROW-INDEX
        CALL "dm_data_frame_string_at" USING DM-DATA-FRAME-STRING-AT DM-STATUS
        PERFORM CHECK
        MOVE DM-DATA-FRAME-STRING-AT-RESULT TO DM-VECTOR-STRING-TABLE-ITEM(ROW + 1)
        MOVE DM-DATA-FRAME-STRING-AT-RESULT-LENGTH TO DM-VECTOR-STRING-TABLE-ITEM-LENGTH(ROW + 1)
    END-PERFORM
    CALL "dm_vector_string_from_table" USING DM-VECTOR-STRING-TABLE DM-STATUS
    PERFORM CHECK
    MOVE DM-VECTOR-STRING-TABLE-SELF TO SPECIES

    DISPLAY "=================== Classical MDS on iris (euclidean) ==================="
    MOVE IRIS TO DM-MDS-NEW-DATA
    MOVE FEATURES TO DM-MDS-NEW-FEATURE-COLUMNS
    MOVE 4 TO DM-MDS-NEW-GIVEN
    MOVE 2 TO DM-MDS-NEW-N-COMPONENTS
    MOVE "euclidean" TO DM-MDS-NEW-METRIC
    CALL "dm_mds_new" USING DM-MDS-NEW DM-STATUS
    PERFORM CHECK
    MOVE DM-MDS-NEW-RESULT TO MDS
    MOVE MDS TO DM-MDS-PRINT-SUMMARY-SELF
    CALL "dm_mds_print_summary" USING DM-MDS-PRINT-SUMMARY DM-STATUS
    PERFORM CHECK

    DISPLAY " "
    DISPLAY "Embedding as a DataFrame:"
    MOVE MDS TO DM-MDS-EMBEDDING-FRAME-SELF
    CALL "dm_mds_embedding_frame" USING DM-MDS-EMBEDDING-FRAME DM-STATUS
    PERFORM CHECK
    MOVE DM-MDS-EMBEDDING-FRAME-RESULT TO FRAME
    MOVE FRAME TO DM-DATA-FRAME-TO-STRING-SELF
    CALL "dm_data_frame_to_string" USING DM-DATA-FRAME-TO-STRING DM-STATUS
    PERFORM CHECK
    DISPLAY DM-DATA-FRAME-TO-STRING-RESULT(1:DM-DATA-FRAME-TO-STRING-RESULT-LENGTH)
    MOVE FRAME TO DM-HANDLE-SELF
    CALL "dm_close" USING DM-HANDLE DM-STATUS

    MOVE MDS TO DM-MDS-PLOT-EMBEDDING-GROUPED-SELF
    MOVE SPECIES TO DM-MDS-PLOT-EMBEDDING-GROUPED-GROUP-LABELS
    CALL "dm_mds_plot_embedding_grouped" USING DM-MDS-PLOT-EMBEDDING-GROUPED DM-STATUS
    PERFORM CHECK
    MOVE DM-MDS-PLOT-EMBEDDING-GROUPED-RESULT TO SCATTER
    MOVE SCATTER TO DM-PLOT-SAVE-SVG-SELF
    MOVE "mds_iris_embedding.svg" TO DM-PLOT-SAVE-SVG-PATH
    CALL "dm_plot_save_svg" USING DM-PLOT-SAVE-SVG DM-STATUS
    PERFORM CHECK
    MOVE SCATTER TO DM-HANDLE-SELF
    CALL "dm_close" USING DM-HANDLE DM-STATUS
    DISPLAY " "
    DISPLAY "Embedding scatter (colored by species) saved as mds_iris_embedding.svg"

    DISPLAY " "
    DISPLAY "=================== Classical MDS on iris (manhattan) ==================="
    MOVE "manhattan" TO DM-MDS-NEW-METRIC
    CALL "dm_mds_new" USING DM-MDS-NEW DM-STATUS
    PERFORM CHECK
    MOVE DM-MDS-NEW-RESULT TO MANHATTAN-MDS
    MOVE MDS TO DM-MDS-GOODNESS-OF-FIT-SELF
    CALL "dm_mds_goodness_of_fit" USING DM-MDS-GOODNESS-OF-FIT DM-STATUS
    PERFORM CHECK
    COMPUTE FIT-EDIT ROUNDED = DM-MDS-GOODNESS-OF-FIT-RESULT
    MOVE MANHATTAN-MDS TO DM-MDS-GOODNESS-OF-FIT-SELF
    CALL "dm_mds_goodness_of_fit" USING DM-MDS-GOODNESS-OF-FIT DM-STATUS
    PERFORM CHECK
    COMPUTE FIT-EDIT-2 ROUNDED = DM-MDS-GOODNESS-OF-FIT-RESULT
    DISPLAY "Goodness of fit: euclidean=" FUNCTION TRIM(FIT-EDIT)
        ", manhattan=" FUNCTION TRIM(FIT-EDIT-2)

    MOVE MANHATTAN-MDS TO DM-HANDLE-SELF
    CALL "dm_close" USING DM-HANDLE DM-STATUS
    MOVE MDS TO DM-HANDLE-SELF
    CALL "dm_close" USING DM-HANDLE DM-STATUS
    MOVE SPECIES TO DM-HANDLE-SELF
    CALL "dm_close" USING DM-HANDLE DM-STATUS
    MOVE FEATURES TO DM-HANDLE-SELF
    CALL "dm_close" USING DM-HANDLE DM-STATUS
    MOVE IRIS TO DM-HANDLE-SELF
    CALL "dm_close" USING DM-HANDLE DM-STATUS
    STOP RUN.

*> Stops with the error after a failed call.
CHECK.
    IF NOT DM-STATUS-OK
        DISPLAY "datamunge error (" FUNCTION TRIM(DM-STATUS-KIND) "): "
            DM-STATUS-MESSAGE(1:DM-STATUS-LENGTH) UPON SYSERR
        STOP RUN RETURNING 1
    END-IF.
