*> N-dimensional tensors: construction, shape ops, broadcasting, reductions, linear algebra,
*> masks, and the iris measurements as a 150 x 4 tensor.
*> CMD: just TARGET=tensor_ex run-cobol
IDENTIFICATION DIVISION.
PROGRAM-ID. TENSOR-EX.
DATA DIVISION.
WORKING-STORAGE SECTION.
COPY "datamunge.cpy".

01 FEATURE-NAME-DATA.
   05 FILLER PIC X(12) VALUE "Sepal.Length".
   05 FILLER PIC X(12) VALUE "Sepal.Width".
   05 FILLER PIC X(12) VALUE "Petal.Length".
   05 FILLER PIC X(12) VALUE "Petal.Width".
01 FEATURE-NAMES REDEFINES FEATURE-NAME-DATA.
   05 FEATURE-NAME PIC X(12) OCCURS 4.

*> The shape for MAKE-SHAPE: RANK dimensions DIM(1), DIM(2).
01 RANK         USAGE BINARY-LONG.
01 DIMS.
   05 DIM       USAGE BINARY-DOUBLE UNSIGNED OCCURS 2.
01 SHAPE        USAGE BINARY-DOUBLE UNSIGNED VALUE 0.
*> The tensor that TENSOR-TEXT and SHOW-SHAPE describe.
01 T            USAGE BINARY-DOUBLE UNSIGNED.

01 R            USAGE BINARY-DOUBLE UNSIGNED.
01 COL-T        USAGE BINARY-DOUBLE UNSIGNED.
01 ROW-T        USAGE BINARY-DOUBLE UNSIGNED.
01 A            USAGE BINARY-DOUBLE UNSIGNED.
01 B            USAGE BINARY-DOUBLE UNSIGNED.
01 V1           USAGE BINARY-DOUBLE UNSIGNED.
01 V2           USAGE BINARY-DOUBLE UNSIGNED.
01 MASK         USAGE BINARY-DOUBLE UNSIGNED.
01 X            USAGE BINARY-DOUBLE UNSIGNED.
01 FEATURE-MEANS USAGE BINARY-DOUBLE UNSIGNED.
01 CENTERED     USAGE BINARY-DOUBLE UNSIGNED.
01 SPECIES-T    USAGE BINARY-DOUBLE UNSIGNED.
01 IRIS         USAGE BINARY-DOUBLE UNSIGNED.
01 NROWS        USAGE BINARY-LONG.
01 ROW-INDEX    USAGE BINARY-LONG.
01 I            USAGE BINARY-LONG.
01 J            USAGE BINARY-LONG.
01 INT-TEXT     PIC Z(9)9.
01 SHAPE-TEXT   PIC X(40).
01 SHAPE-POS    USAGE BINARY-LONG.

PROCEDURE DIVISION.
    DISPLAY "=================== Construction ==================="
    MOVE 2 TO RANK MOVE 2 TO DIM(1) MOVE 3 TO DIM(2)
    PERFORM MAKE-SHAPE
    MOVE SHAPE TO DM-TENSOR-ZEROS-SHAPE
    CALL "dm_tensor_zeros" USING DM-TENSOR-ZEROS DM-STATUS
    PERFORM CHECK
    MOVE DM-TENSOR-ZEROS-RESULT TO T
    PERFORM TENSOR-TEXT
    DISPLAY "zeros([2,3]): " DM-TENSOR-TO-STRING-RESULT(1:DM-TENSOR-TO-STRING-RESULT-LENGTH)
    PERFORM CLOSE-T

    MOVE 3 TO DM-TENSOR-EYE-N
    CALL "dm_tensor_eye" USING DM-TENSOR-EYE DM-STATUS
    PERFORM CHECK
    MOVE DM-TENSOR-EYE-RESULT TO T
    PERFORM TENSOR-TEXT
    DISPLAY "eye(3): " DM-TENSOR-TO-STRING-RESULT(1:DM-TENSOR-TO-STRING-RESULT-LENGTH)
    PERFORM CLOSE-T

    MOVE 3 TO DM-TENSOR-ARANGE-GIVEN
    MOVE 0.0 TO DM-TENSOR-ARANGE-START
    MOVE 12.0 TO DM-TENSOR-ARANGE-STOP
    MOVE 1.0 TO DM-TENSOR-ARANGE-STEP
    CALL "dm_tensor_arange" USING DM-TENSOR-ARANGE DM-STATUS
    PERFORM CHECK
    MOVE 2 TO RANK MOVE 3 TO DIM(1) MOVE 4 TO DIM(2)
    PERFORM MAKE-SHAPE
    MOVE DM-TENSOR-ARANGE-RESULT TO DM-TENSOR-RESHAPE-SELF T
    MOVE SHAPE TO DM-TENSOR-RESHAPE-NEW-SHAPE
    CALL "dm_tensor_reshape" USING DM-TENSOR-RESHAPE DM-STATUS
    PERFORM CHECK
    PERFORM CLOSE-T
    MOVE DM-TENSOR-RESHAPE-RESULT TO R T
    PERFORM TENSOR-TEXT
    DISPLAY "arange(0,12).reshape([3,4]): "
        DM-TENSOR-TO-STRING-RESULT(1:DM-TENSOR-TO-STRING-RESULT-LENGTH)

    DISPLAY " "
    DISPLAY "=================== Shape ops ==================="
    MOVE R TO DM-TENSOR-TRANSPOSE-SELF
    CALL "dm_tensor_transpose" USING DM-TENSOR-TRANSPOSE DM-STATUS
    PERFORM CHECK
    MOVE DM-TENSOR-TRANSPOSE-RESULT TO T
    PERFORM SHOW-SHAPE
    DISPLAY "transpose -> shape " FUNCTION TRIM(SHAPE-TEXT)
    PERFORM CLOSE-T
    MOVE R TO DM-TENSOR-SLICE-SELF
    MOVE 1 TO DM-TENSOR-SLICE-AXIS
    MOVE 1 TO DM-TENSOR-SLICE-START
    MOVE 3 TO DM-TENSOR-SLICE-STOP
    CALL "dm_tensor_slice" USING DM-TENSOR-SLICE DM-STATUS
    PERFORM CHECK
    MOVE DM-TENSOR-SLICE-RESULT TO T
    PERFORM TENSOR-TEXT
    DISPLAY "slice(axis=1, start=1, stop=3): "
        DM-TENSOR-TO-STRING-RESULT(1:DM-TENSOR-TO-STRING-RESULT-LENGTH)
    PERFORM CLOSE-T

    DISPLAY " "
    DISPLAY "=================== Broadcasting arithmetic ==================="
    MOVE 2 TO RANK MOVE 3 TO DIM(1) MOVE 1 TO DIM(2)
    MOVE 3 TO DM-VECTOR-DOUBLE-TABLE-COUNT
    MOVE 1 TO DM-VECTOR-DOUBLE-TABLE-ITEM(1)
    MOVE 2 TO DM-VECTOR-DOUBLE-TABLE-ITEM(2)
    MOVE 3 TO DM-VECTOR-DOUBLE-TABLE-ITEM(3)
    PERFORM FROM-VALUES
    MOVE T TO COL-T
    MOVE 2 TO RANK MOVE 1 TO DIM(1) MOVE 4 TO DIM(2)
    MOVE 4 TO DM-VECTOR-DOUBLE-TABLE-COUNT
    PERFORM VARYING I FROM 1 BY 1 UNTIL I > 4
        COMPUTE DM-VECTOR-DOUBLE-TABLE-ITEM(I) = 10 * I
    END-PERFORM
    PERFORM FROM-VALUES
    MOVE T TO ROW-T
    MOVE COL-T TO DM-TENSOR-ADD-SELF
    MOVE ROW-T TO DM-TENSOR-ADD-OTHER
    CALL "dm_tensor_add" USING DM-TENSOR-ADD DM-STATUS
    PERFORM CHECK
    MOVE DM-TENSOR-ADD-RESULT TO T
    PERFORM TENSOR-TEXT
    DISPLAY "(3,1) + (1,4) -> " DM-TENSOR-TO-STRING-RESULT(1:DM-TENSOR-TO-STRING-RESULT-LENGTH)
    PERFORM CLOSE-T

    DISPLAY " "
    DISPLAY "=================== Reductions ==================="
    MOVE R TO DM-TENSOR-SUM-SELF DM-TENSOR-MEAN-SELF
    CALL "dm_tensor_sum" USING DM-TENSOR-SUM DM-STATUS
    PERFORM CHECK
    CALL "dm_tensor_mean" USING DM-TENSOR-MEAN DM-STATUS
    PERFORM CHECK
    DISPLAY "r.sum() = " DM-TENSOR-SUM-RESULT ", r.mean() = " DM-TENSOR-MEAN-RESULT
    MOVE R TO DM-TENSOR-MEAN-AXIS-SELF
    MOVE 0 TO DM-TENSOR-MEAN-AXIS-AXIS
    CALL "dm_tensor_mean_axis" USING DM-TENSOR-MEAN-AXIS DM-STATUS
    PERFORM CHECK
    MOVE DM-TENSOR-MEAN-AXIS-RESULT TO T
    PERFORM TENSOR-TEXT
    DISPLAY "column means (axis=0): " DM-TENSOR-TO-STRING-RESULT(1:DM-TENSOR-TO-STRING-RESULT-LENGTH)
    PERFORM CLOSE-T

    DISPLAY " "
    DISPLAY "=================== Linear algebra ==================="
    MOVE 6 TO DM-VECTOR-DOUBLE-TABLE-COUNT
    PERFORM VARYING I FROM 1 BY 1 UNTIL I > 6
        MOVE I TO DM-VECTOR-DOUBLE-TABLE-ITEM(I)
    END-PERFORM
    MOVE 2 TO RANK MOVE 2 TO DIM(1) MOVE 3 TO DIM(2)
    PERFORM FROM-VALUES
    MOVE T TO A
    PERFORM VARYING I FROM 1 BY 1 UNTIL I > 6
        COMPUTE DM-VECTOR-DOUBLE-TABLE-ITEM(I) = I + 6
    END-PERFORM
    MOVE 3 TO DIM(1) MOVE 2 TO DIM(2)
    PERFORM FROM-VALUES
    MOVE T TO B
    MOVE A TO DM-TENSOR-MATMUL-SELF
    MOVE B TO DM-TENSOR-MATMUL-OTHER
    CALL "dm_tensor_matmul" USING DM-TENSOR-MATMUL DM-STATUS
    PERFORM CHECK
    MOVE DM-TENSOR-MATMUL-RESULT TO T
    PERFORM TENSOR-TEXT
    DISPLAY "matmul(2x3, 3x2) -> " DM-TENSOR-TO-STRING-RESULT(1:DM-TENSOR-TO-STRING-RESULT-LENGTH)
    PERFORM CLOSE-T

    MOVE 1 TO RANK MOVE 3 TO DIM(1)
    MOVE 3 TO DM-VECTOR-DOUBLE-TABLE-COUNT
    PERFORM VARYING I FROM 1 BY 1 UNTIL I > 3
        MOVE I TO DM-VECTOR-DOUBLE-TABLE-ITEM(I)
    END-PERFORM
    PERFORM FROM-VALUES
    MOVE T TO V1
    PERFORM VARYING I FROM 1 BY 1 UNTIL I > 3
        COMPUTE DM-VECTOR-DOUBLE-TABLE-ITEM(I) = I + 3
    END-PERFORM
    PERFORM FROM-VALUES
    MOVE T TO V2
    MOVE V1 TO DM-TENSOR-DOT-SELF DM-TENSOR-OUTER-SELF
    MOVE V2 TO DM-TENSOR-DOT-OTHER DM-TENSOR-OUTER-OTHER
    CALL "dm_tensor_dot" USING DM-TENSOR-DOT DM-STATUS
    PERFORM CHECK
    DISPLAY "dot([1,2,3], [4,5,6]) = " DM-TENSOR-DOT-RESULT
    CALL "dm_tensor_outer" USING DM-TENSOR-OUTER DM-STATUS
    PERFORM CHECK
    MOVE DM-TENSOR-OUTER-RESULT TO T
    PERFORM TENSOR-TEXT
    DISPLAY "outer(v1, v2) -> " DM-TENSOR-TO-STRING-RESULT(1:DM-TENSOR-TO-STRING-RESULT-LENGTH)
    PERFORM CLOSE-T

    DISPLAY " "
    DISPLAY "=================== Comparisons & masks ==================="
    MOVE 2 TO RANK MOVE 3 TO DIM(1) MOVE 4 TO DIM(2)
    PERFORM MAKE-SHAPE
    MOVE SHAPE TO DM-TENSOR-FULL-SHAPE
    MOVE 6.0 TO DM-TENSOR-FULL-VALUE
    CALL "dm_tensor_full" USING DM-TENSOR-FULL DM-STATUS
    PERFORM CHECK
    MOVE R TO DM-TENSOR-GREATER-EQUAL-SELF
    MOVE DM-TENSOR-FULL-RESULT TO DM-TENSOR-GREATER-EQUAL-OTHER T
    CALL "dm_tensor_greater_equal" USING DM-TENSOR-GREATER-EQUAL DM-STATUS
    PERFORM CHECK
    PERFORM CLOSE-T
    MOVE DM-TENSOR-GREATER-EQUAL-RESULT TO MASK T
    PERFORM TENSOR-TEXT
    DISPLAY "r >= 6 -> " DM-TENSOR-TO-STRING-RESULT(1:DM-TENSOR-TO-STRING-RESULT-LENGTH)
    MOVE MASK TO DM-TENSOR-SUM-SELF
    CALL "dm_tensor_sum" USING DM-TENSOR-SUM DM-STATUS
    PERFORM CHECK
    DISPLAY "count(r >= 6) = " DM-TENSOR-SUM-RESULT

    DISPLAY " "
    DISPLAY "=================== A real dataset as a Tensor ==================="
    CALL "dm_data_iris" USING DM-DATA-IRIS DM-STATUS
    PERFORM CHECK
    MOVE DM-DATA-IRIS-RESULT TO IRIS
    MOVE IRIS TO DM-DATA-FRAME-NROWS-SELF
    CALL "dm_data_frame_nrows" USING DM-DATA-FRAME-NROWS DM-STATUS
    MOVE DM-DATA-FRAME-NROWS-RESULT TO NROWS
    *> Row-major values: the four measurements of each flower in turn.
    COMPUTE DM-VECTOR-DOUBLE-TABLE-COUNT = NROWS * 4
    MOVE IRIS TO DM-DATA-FRAME-NUMERIC-AT-SELF
    PERFORM VARYING ROW-INDEX FROM 0 BY 1 UNTIL ROW-INDEX >= NROWS
        MOVE ROW-INDEX TO DM-DATA-FRAME-NUMERIC-AT-ROW-INDEX
        PERFORM VARYING J FROM 1 BY 1 UNTIL J > 4
            MOVE FEATURE-NAME(J) TO DM-DATA-FRAME-NUMERIC-AT-COLUMN-NAME
            CALL "dm_data_frame_numeric_at" USING DM-DATA-FRAME-NUMERIC-AT DM-STATUS
            PERFORM CHECK
            MOVE DM-DATA-FRAME-NUMERIC-AT-RESULT TO DM-VECTOR-DOUBLE-TABLE-ITEM(ROW-INDEX * 4 + J)
        END-PERFORM
    END-PERFORM
    MOVE 2 TO RANK MOVE NROWS TO DIM(1) MOVE 4 TO DIM(2)
    PERFORM FROM-VALUES
    MOVE T TO X
    PERFORM SHOW-SHAPE
    DISPLAY "iris feature tensor shape: " FUNCTION TRIM(SHAPE-TEXT)

    MOVE X TO DM-TENSOR-MEAN-AXIS-SELF
    MOVE 0 TO DM-TENSOR-MEAN-AXIS-AXIS
    CALL "dm_tensor_mean_axis" USING DM-TENSOR-MEAN-AXIS DM-STATUS
    PERFORM CHECK
    MOVE DM-TENSOR-MEAN-AXIS-RESULT TO FEATURE-MEANS
    MOVE 2 TO RANK MOVE 1 TO DIM(1) MOVE 4 TO DIM(2)
    PERFORM MAKE-SHAPE
    MOVE FEATURE-MEANS TO DM-TENSOR-RESHAPE-SELF
    MOVE SHAPE TO DM-TENSOR-RESHAPE-NEW-SHAPE
    CALL "dm_tensor_reshape" USING DM-TENSOR-RESHAPE DM-STATUS
    PERFORM CHECK
    MOVE X TO DM-TENSOR-SUBTRACT-SELF
    MOVE DM-TENSOR-RESHAPE-RESULT TO DM-TENSOR-SUBTRACT-OTHER T
    CALL "dm_tensor_subtract" USING DM-TENSOR-SUBTRACT DM-STATUS
    PERFORM CHECK
    PERFORM CLOSE-T
    MOVE DM-TENSOR-SUBTRACT-RESULT TO CENTERED
    *> The 4x4 scatter matrix (X-mean)^T (X-mean).
    MOVE CENTERED TO DM-TENSOR-TRANSPOSE-SELF
    CALL "dm_tensor_transpose" USING DM-TENSOR-TRANSPOSE DM-STATUS
    PERFORM CHECK
    MOVE DM-TENSOR-TRANSPOSE-RESULT TO DM-TENSOR-MATMUL-SELF
    MOVE CENTERED TO DM-TENSOR-MATMUL-OTHER
    CALL "dm_tensor_matmul" USING DM-TENSOR-MATMUL DM-STATUS
    PERFORM CHECK
    MOVE FEATURE-MEANS TO T
    PERFORM TENSOR-TEXT
    DISPLAY "feature means (Sepal.Length, Sepal.Width, Petal.Length, Petal.Width): "
        DM-TENSOR-TO-STRING-RESULT(1:DM-TENSOR-TO-STRING-RESULT-LENGTH)
    MOVE DM-TENSOR-MATMUL-RESULT TO T
    MOVE 1 TO DM-TENSOR-TO-STRING-GIVEN
    MOVE 16 TO DM-TENSOR-TO-STRING-MAX-ELEMENTS
    PERFORM TENSOR-TEXT
    MOVE 0 TO DM-TENSOR-TO-STRING-GIVEN
    DISPLAY "(X-mean)^T (X-mean) [4x4 scatter matrix]: "
        DM-TENSOR-TO-STRING-RESULT(1:DM-TENSOR-TO-STRING-RESULT-LENGTH)

    *> Species as a string tensor, compared against a one-element "setosa" tensor.
    MOVE NROWS TO DM-VECTOR-STRING-TABLE-COUNT
    MOVE IRIS TO DM-DATA-FRAME-STRING-AT-SELF
    MOVE "Species" TO DM-DATA-FRAME-STRING-AT-COLUMN-NAME
    PERFORM VARYING ROW-INDEX FROM 0 BY 1 UNTIL ROW-INDEX >= NROWS
        MOVE ROW-INDEX TO DM-DATA-FRAME-STRING-AT-ROW-INDEX
        CALL "dm_data_frame_string_at" USING DM-DATA-FRAME-STRING-AT DM-STATUS
        PERFORM CHECK
        MOVE DM-DATA-FRAME-STRING-AT-RESULT(1:DM-DATA-FRAME-STRING-AT-RESULT-LENGTH)
            TO DM-VECTOR-STRING-TABLE-ITEM(ROW-INDEX + 1)
    END-PERFORM
    MOVE 1 TO RANK MOVE NROWS TO DIM(1)
    PERFORM FROM-STRING-VALUES
    MOVE T TO SPECIES-T
    MOVE 1 TO DM-VECTOR-STRING-TABLE-COUNT
    MOVE "setosa" TO DM-VECTOR-STRING-TABLE-ITEM(1)
    MOVE 1 TO DIM(1)
    PERFORM FROM-STRING-VALUES
    MOVE SPECIES-T TO DM-TENSOR-EQUAL-SELF
    MOVE T TO DM-TENSOR-EQUAL-OTHER
    CALL "dm_tensor_equal" USING DM-TENSOR-EQUAL DM-STATUS
    PERFORM CHECK
    MOVE DM-TENSOR-EQUAL-RESULT TO DM-TENSOR-SUM-SELF
    CALL "dm_tensor_sum" USING DM-TENSOR-SUM DM-STATUS
    PERFORM CHECK
    MOVE NROWS TO INT-TEXT
    DISPLAY "setosa count = " DM-TENSOR-SUM-RESULT " (of " FUNCTION TRIM(INT-TEXT) " rows)"
    STOP RUN.

*> Sets SHAPE to a new VECTOR-ULONG of the RANK dimensions in DIM (closing the old one).
MAKE-SHAPE.
    MOVE SHAPE TO DM-HANDLE-SELF
    CALL "dm_close" USING DM-HANDLE DM-STATUS
    MOVE RANK TO DM-VECTOR-ULONG-TABLE-COUNT
    PERFORM VARYING I FROM 1 BY 1 UNTIL I > RANK
        MOVE DIM(I) TO DM-VECTOR-ULONG-TABLE-ITEM(I)
    END-PERFORM
    CALL "dm_vector_ulong_from_table" USING DM-VECTOR-ULONG-TABLE DM-STATUS
    PERFORM CHECK
    MOVE DM-VECTOR-ULONG-TABLE-SELF TO SHAPE.

*> Sets T to a new tensor of shape RANK/DIM holding the VECTOR-DOUBLE-TABLE items.
FROM-VALUES.
    PERFORM MAKE-SHAPE
    CALL "dm_vector_double_from_table" USING DM-VECTOR-DOUBLE-TABLE DM-STATUS
    PERFORM CHECK
    MOVE SHAPE TO DM-TENSOR-FROM-VALUES-SHAPE
    MOVE DM-VECTOR-DOUBLE-TABLE-SELF TO DM-TENSOR-FROM-VALUES-VALUES
    CALL "dm_tensor_from_values" USING DM-TENSOR-FROM-VALUES DM-STATUS
    PERFORM CHECK
    MOVE DM-TENSOR-FROM-VALUES-RESULT TO T
    MOVE DM-VECTOR-DOUBLE-TABLE-SELF TO DM-HANDLE-SELF
    CALL "dm_close" USING DM-HANDLE DM-STATUS.

*> Sets T to a new string tensor of shape RANK/DIM holding the VECTOR-STRING-TABLE items.
FROM-STRING-VALUES.
    PERFORM MAKE-SHAPE
    CALL "dm_vector_string_from_table" USING DM-VECTOR-STRING-TABLE DM-STATUS
    PERFORM CHECK
    MOVE SHAPE TO DM-TENSOR-FROM-STRING-VALUES-SHAPE
    MOVE DM-VECTOR-STRING-TABLE-SELF TO DM-TENSOR-FROM-STRING-VALUES-VALUES
    CALL "dm_tensor_from_string_values" USING DM-TENSOR-FROM-STRING-VALUES DM-STATUS
    PERFORM CHECK
    MOVE DM-TENSOR-FROM-STRING-VALUES-RESULT TO T
    MOVE DM-VECTOR-STRING-TABLE-SELF TO DM-HANDLE-SELF
    CALL "dm_close" USING DM-HANDLE DM-STATUS.

*> Renders T with to_string into DM-TENSOR-TO-STRING-RESULT.
TENSOR-TEXT.
    MOVE T TO DM-TENSOR-TO-STRING-SELF
    CALL "dm_tensor_to_string" USING DM-TENSOR-TO-STRING DM-STATUS
    PERFORM CHECK.

*> Writes the shape of T as "[d1, d2, ...]" into SHAPE-TEXT.
SHOW-SHAPE.
    MOVE T TO DM-TENSOR-SHAPE-SELF
    CALL "dm_tensor_shape" USING DM-TENSOR-SHAPE DM-STATUS
    PERFORM CHECK
    MOVE DM-TENSOR-SHAPE-RESULT TO DM-VECTOR-ULONG-TABLE-SELF
    CALL "dm_vector_ulong_to_table" USING DM-VECTOR-ULONG-TABLE DM-STATUS
    PERFORM CHECK
    MOVE SPACES TO SHAPE-TEXT
    MOVE 1 TO SHAPE-POS
    STRING "[" DELIMITED BY SIZE INTO SHAPE-TEXT WITH POINTER SHAPE-POS
    PERFORM VARYING I FROM 1 BY 1 UNTIL I > DM-VECTOR-ULONG-TABLE-COUNT
        IF I > 1
            STRING ", " DELIMITED BY SIZE INTO SHAPE-TEXT WITH POINTER SHAPE-POS
        END-IF
        MOVE DM-VECTOR-ULONG-TABLE-ITEM(I) TO INT-TEXT
        STRING FUNCTION TRIM(INT-TEXT) DELIMITED BY SIZE INTO SHAPE-TEXT WITH POINTER SHAPE-POS
    END-PERFORM
    STRING "]" DELIMITED BY SIZE INTO SHAPE-TEXT WITH POINTER SHAPE-POS
    MOVE DM-VECTOR-ULONG-TABLE-SELF TO DM-HANDLE-SELF
    CALL "dm_close" USING DM-HANDLE DM-STATUS.

*> Closes the tensor T.
CLOSE-T.
    MOVE T TO DM-HANDLE-SELF
    CALL "dm_close" USING DM-HANDLE DM-STATUS.

*> Stops with the error after a failed call.
CHECK.
    IF NOT DM-STATUS-OK
        DISPLAY "datamunge error (" FUNCTION TRIM(DM-STATUS-KIND) "): "
            DM-STATUS-MESSAGE(1:DM-STATUS-LENGTH) UPON SYSERR
        STOP RUN RETURNING 1
    END-IF.
