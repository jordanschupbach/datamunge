*> DataFrame basics: null masks, drop_duplicates, fill_null, select, sort, group, join.
*> Run with `just run-cobol TARGET=dataframe_ex`.
IDENTIFICATION DIVISION.
PROGRAM-ID. DATAFRAME-EX.
DATA DIVISION.
WORKING-STORAGE SECTION.
COPY "datamunge.cpy".

01 SALES     USAGE BINARY-DOUBLE UNSIGNED.
01 CLEANED   USAGE BINARY-DOUBLE UNSIGNED.
01 SELECTED  USAGE BINARY-DOUBLE UNSIGNED.
01 GROUPED   USAGE BINARY-DOUBLE UNSIGNED.
01 TARGETS   USAGE BINARY-DOUBLE UNSIGNED.
01 FRAME     USAGE BINARY-DOUBLE UNSIGNED.
01 KEYS-VEC  USAGE BINARY-DOUBLE UNSIGNED.

*> LIST-TO-STRINGS, LIST-TO-DOUBLES and LIST-TO-INTS turn the comma-separated
*> LIST-TEXT into a new vector handle in LIST-VEC.
01 LIST-TEXT  PIC X(256).
01 LIST-VEC   USAGE BINARY-DOUBLE UNSIGNED.
01 MASK-VEC   USAGE BINARY-DOUBLE UNSIGNED.
01 LIST-COUNT USAGE BINARY-LONG.
01 LIST-PTR   USAGE BINARY-LONG.
01 LIST-ITEM  PIC X(64).
01 I          USAGE BINARY-LONG.

01 INT-1     PIC -(9)9.
01 INT-2     PIC -(9)9.
01 NUM       USAGE COMP-2.
01 NUM-EDIT  PIC -(12)9.9(10).
01 NUM-TEXT  PIC X(32).
01 NUM-LEN   USAGE BINARY-LONG.

PROCEDURE DIVISION.
    CALL "dm_data_frame_new" USING DM-DATA-FRAME-NEW DM-STATUS
    PERFORM CHECK
    MOVE DM-DATA-FRAME-NEW-RESULT TO SALES

    MOVE SALES TO DM-DATA-FRAME-ADD-STRING-COLUMN-SELF
    MOVE "region" TO DM-DATA-FRAME-ADD-STRING-COLUMN-COLUMN-NAME
    MOVE "west,west,east,south,south,south" TO LIST-TEXT
    PERFORM ADD-STRING-COLUMN
    MOVE "product" TO DM-DATA-FRAME-ADD-STRING-COLUMN-COLUMN-NAME
    MOVE "widget,widget,widget,gizmo,gizmo,gizmo" TO LIST-TEXT
    PERFORM ADD-STRING-COLUMN

    *> A valid_mask marks nulls with 0; raise -GIVEN to send it.
    MOVE "1,1,1,1,0,1" TO LIST-TEXT
    PERFORM LIST-TO-INTS
    MOVE LIST-VEC TO MASK-VEC
    MOVE "10,10,14,8,0,11" TO LIST-TEXT
    PERFORM LIST-TO-DOUBLES
    MOVE SALES TO DM-DATA-FRAME-ADD-NUMERIC-COLUMN-SELF
    MOVE 3 TO DM-DATA-FRAME-ADD-NUMERIC-COLUMN-GIVEN
    MOVE "sales" TO DM-DATA-FRAME-ADD-NUMERIC-COLUMN-COLUMN-NAME
    MOVE LIST-VEC TO DM-DATA-FRAME-ADD-NUMERIC-COLUMN-VALUES
    MOVE MASK-VEC TO DM-DATA-FRAME-ADD-NUMERIC-COLUMN-VALID-MASK
    CALL "dm_data_frame_add_numeric_column" USING DM-DATA-FRAME-ADD-NUMERIC-COLUMN DM-STATUS
    PERFORM CHECK
    PERFORM CLOSE-LIST-AND-MASK

    MOVE "1,1,1,1,1,0" TO LIST-TEXT
    PERFORM LIST-TO-INTS
    MOVE LIST-VEC TO MASK-VEC
    MOVE "Q1,Q1,Q1,Q2,Q2," TO LIST-TEXT
    PERFORM LIST-TO-STRINGS
    MOVE 3 TO DM-DATA-FRAME-ADD-STRING-COLUMN-GIVEN
    MOVE "quarter" TO DM-DATA-FRAME-ADD-STRING-COLUMN-COLUMN-NAME
    MOVE LIST-VEC TO DM-DATA-FRAME-ADD-STRING-COLUMN-VALUES
    MOVE MASK-VEC TO DM-DATA-FRAME-ADD-STRING-COLUMN-VALID-MASK
    CALL "dm_data_frame_add_string_column" USING DM-DATA-FRAME-ADD-STRING-COLUMN DM-STATUS
    PERFORM CHECK
    PERFORM CLOSE-LIST-AND-MASK
    MOVE 2 TO DM-DATA-FRAME-ADD-STRING-COLUMN-GIVEN

    DISPLAY "raw data"
    MOVE SALES TO FRAME
    PERFORM DISPLAY-FRAME
    DISPLAY " "

    MOVE "region,product,sales,quarter" TO LIST-TEXT
    PERFORM LIST-TO-STRINGS
    MOVE SALES TO DM-DATA-FRAME-DROP-DUPLICATES-SELF
    MOVE 1 TO DM-DATA-FRAME-DROP-DUPLICATES-GIVEN
    MOVE LIST-VEC TO DM-DATA-FRAME-DROP-DUPLICATES-SUBSET
    CALL "dm_data_frame_drop_duplicates" USING DM-DATA-FRAME-DROP-DUPLICATES DM-STATUS
    PERFORM CHECK
    MOVE DM-DATA-FRAME-DROP-DUPLICATES-RESULT TO CLEANED
    PERFORM CLOSE-LIST
    MOVE CLEANED TO DM-DATA-FRAME-FILL-NULL-STRING-SELF
    MOVE "quarter" TO DM-DATA-FRAME-FILL-NULL-STRING-COLUMN-NAME
    MOVE "unknown" TO DM-DATA-FRAME-FILL-NULL-STRING-VALUE
    CALL "dm_data_frame_fill_null_string" USING DM-DATA-FRAME-FILL-NULL-STRING DM-STATUS
    PERFORM CHECK
    MOVE CLEANED TO DM-DATA-FRAME-FILL-NULL-NUMERIC-SELF
    MOVE "sales" TO DM-DATA-FRAME-FILL-NULL-NUMERIC-COLUMN-NAME
    MOVE 0.0 TO DM-DATA-FRAME-FILL-NULL-NUMERIC-VALUE
    CALL "dm_data_frame_fill_null_numeric" USING DM-DATA-FRAME-FILL-NULL-NUMERIC DM-STATUS
    PERFORM CHECK
    DISPLAY "after drop_duplicates + fill_null"
    MOVE CLEANED TO FRAME
    PERFORM DISPLAY-FRAME
    DISPLAY " "

    MOVE "region,sales,quarter" TO LIST-TEXT
    PERFORM LIST-TO-STRINGS
    MOVE CLEANED TO DM-DATA-FRAME-SELECT-SELF
    MOVE LIST-VEC TO DM-DATA-FRAME-SELECT-SELECTED-COLUMNS
    CALL "dm_data_frame_select" USING DM-DATA-FRAME-SELECT DM-STATUS
    PERFORM CHECK
    PERFORM CLOSE-LIST
    MOVE DM-DATA-FRAME-SELECT-RESULT TO FRAME
    PERFORM SORT-BY-SALES-DESC
    MOVE FRAME TO SELECTED
    DISPLAY "selected + sorted"
    PERFORM DISPLAY-FRAME
    DISPLAY " "

    MOVE "region" TO LIST-TEXT
    PERFORM LIST-TO-STRINGS
    MOVE LIST-VEC TO KEYS-VEC
    MOVE "sales" TO LIST-TEXT
    PERFORM LIST-TO-STRINGS
    MOVE CLEANED TO DM-DATA-FRAME-GROUP-BY-SUM-SELF
    MOVE KEYS-VEC TO DM-DATA-FRAME-GROUP-BY-SUM-KEY-COLUMNS
    MOVE LIST-VEC TO DM-DATA-FRAME-GROUP-BY-SUM-VALUE-COLUMNS
    CALL "dm_data_frame_group_by_sum" USING DM-DATA-FRAME-GROUP-BY-SUM DM-STATUS
    PERFORM CHECK
    PERFORM CLOSE-LIST
    MOVE KEYS-VEC TO DM-HANDLE-SELF
    CALL "dm_close" USING DM-HANDLE DM-STATUS
    MOVE DM-DATA-FRAME-GROUP-BY-SUM-RESULT TO FRAME
    PERFORM SORT-BY-SALES-DESC
    MOVE FRAME TO GROUPED
    DISPLAY "group_by_sum(region)"
    PERFORM DISPLAY-FRAME
    DISPLAY " "

    CALL "dm_data_frame_new" USING DM-DATA-FRAME-NEW DM-STATUS
    PERFORM CHECK
    MOVE DM-DATA-FRAME-NEW-RESULT TO TARGETS
    MOVE TARGETS TO DM-DATA-FRAME-ADD-STRING-COLUMN-SELF
    MOVE "region" TO DM-DATA-FRAME-ADD-STRING-COLUMN-COLUMN-NAME
    MOVE "west,east,south" TO LIST-TEXT
    PERFORM ADD-STRING-COLUMN
    MOVE "18,12,25" TO LIST-TEXT
    PERFORM LIST-TO-DOUBLES
    MOVE TARGETS TO DM-DATA-FRAME-ADD-NUMERIC-COLUMN-SELF
    MOVE 2 TO DM-DATA-FRAME-ADD-NUMERIC-COLUMN-GIVEN
    MOVE "target" TO DM-DATA-FRAME-ADD-NUMERIC-COLUMN-COLUMN-NAME
    MOVE LIST-VEC TO DM-DATA-FRAME-ADD-NUMERIC-COLUMN-VALUES
    CALL "dm_data_frame_add_numeric_column" USING DM-DATA-FRAME-ADD-NUMERIC-COLUMN DM-STATUS
    PERFORM CHECK
    PERFORM CLOSE-LIST

    MOVE GROUPED TO DM-DATA-FRAME-JOIN-SELF
    MOVE TARGETS TO DM-DATA-FRAME-JOIN-RIGHT
    MOVE "region" TO DM-DATA-FRAME-JOIN-LEFT-KEY
    MOVE "region" TO DM-DATA-FRAME-JOIN-RIGHT-KEY
    MOVE 4 TO DM-DATA-FRAME-JOIN-GIVEN
    MOVE "left" TO DM-DATA-FRAME-JOIN-JOIN-TYPE
    CALL "dm_data_frame_join" USING DM-DATA-FRAME-JOIN DM-STATUS
    PERFORM CHECK
    DISPLAY "joined with targets"
    MOVE DM-DATA-FRAME-JOIN-RESULT TO FRAME
    PERFORM DISPLAY-FRAME
    MOVE FRAME TO DM-HANDLE-SELF
    CALL "dm_close" USING DM-HANDLE DM-STATUS
    DISPLAY " "

    *> shape() is a std::vector<std::size_t>: (rows, columns).
    MOVE CLEANED TO DM-DATA-FRAME-SHAPE-SELF
    CALL "dm_data_frame_shape" USING DM-DATA-FRAME-SHAPE DM-STATUS
    PERFORM CHECK
    MOVE DM-DATA-FRAME-SHAPE-RESULT TO DM-VECTOR-ULONG-TABLE-SELF
    CALL "dm_vector_ulong_to_table" USING DM-VECTOR-ULONG-TABLE DM-STATUS
    PERFORM CHECK
    MOVE DM-VECTOR-ULONG-TABLE-ITEM(1) TO INT-1
    MOVE DM-VECTOR-ULONG-TABLE-ITEM(2) TO INT-2
    DISPLAY "shape = (" FUNCTION TRIM(INT-1) ", " FUNCTION TRIM(INT-2) ")"
    MOVE DM-DATA-FRAME-SHAPE-RESULT TO DM-HANDLE-SELF
    CALL "dm_close" USING DM-HANDLE DM-STATUS

    MOVE CLEANED TO DM-DATA-FRAME-NUMERIC-COUNT-SELF
    MOVE "sales" TO DM-DATA-FRAME-NUMERIC-COUNT-COLUMN-NAME
    CALL "dm_data_frame_numeric_count" USING DM-DATA-FRAME-NUMERIC-COUNT DM-STATUS
    PERFORM CHECK
    MOVE DM-DATA-FRAME-NUMERIC-COUNT-RESULT TO INT-1
    DISPLAY "sales count = " FUNCTION TRIM(INT-1)
    MOVE CLEANED TO DM-DATA-FRAME-NUMERIC-NULL-COUNT-SELF
    MOVE "sales" TO DM-DATA-FRAME-NUMERIC-NULL-COUNT-COLUMN-NAME
    CALL "dm_data_frame_numeric_null_count" USING DM-DATA-FRAME-NUMERIC-NULL-COUNT DM-STATUS
    PERFORM CHECK
    MOVE DM-DATA-FRAME-NUMERIC-NULL-COUNT-RESULT TO INT-1
    DISPLAY "sales nulls = " FUNCTION TRIM(INT-1)
    MOVE CLEANED TO DM-DATA-FRAME-NUMERIC-SUM-SELF
    MOVE "sales" TO DM-DATA-FRAME-NUMERIC-SUM-COLUMN-NAME
    CALL "dm_data_frame_numeric_sum" USING DM-DATA-FRAME-NUMERIC-SUM DM-STATUS
    PERFORM CHECK
    MOVE DM-DATA-FRAME-NUMERIC-SUM-RESULT TO NUM
    PERFORM FORMAT-NUMBER
    DISPLAY "sales sum = " NUM-TEXT(1:NUM-LEN)
    MOVE CLEANED TO DM-DATA-FRAME-NUMERIC-MEAN-SELF
    MOVE "sales" TO DM-DATA-FRAME-NUMERIC-MEAN-COLUMN-NAME
    CALL "dm_data_frame_numeric_mean" USING DM-DATA-FRAME-NUMERIC-MEAN DM-STATUS
    PERFORM CHECK
    MOVE DM-DATA-FRAME-NUMERIC-MEAN-RESULT TO NUM
    PERFORM FORMAT-NUMBER
    DISPLAY "sales mean = " NUM-TEXT(1:NUM-LEN)

    MOVE TARGETS TO DM-HANDLE-SELF
    CALL "dm_close" USING DM-HANDLE DM-STATUS
    MOVE GROUPED TO DM-HANDLE-SELF
    CALL "dm_close" USING DM-HANDLE DM-STATUS
    MOVE SELECTED TO DM-HANDLE-SELF
    CALL "dm_close" USING DM-HANDLE DM-STATUS
    MOVE CLEANED TO DM-HANDLE-SELF
    CALL "dm_close" USING DM-HANDLE DM-STATUS
    MOVE SALES TO DM-HANDLE-SELF
    CALL "dm_close" USING DM-HANDLE DM-STATUS
    STOP RUN.

*> Adds LIST-TEXT as a string column of DM-DATA-FRAME-ADD-STRING-COLUMN-SELF.
ADD-STRING-COLUMN.
    PERFORM LIST-TO-STRINGS
    MOVE LIST-VEC TO DM-DATA-FRAME-ADD-STRING-COLUMN-VALUES
    CALL "dm_data_frame_add_string_column" USING DM-DATA-FRAME-ADD-STRING-COLUMN DM-STATUS
    PERFORM CHECK
    PERFORM CLOSE-LIST.

*> Replaces FRAME by FRAME sorted by sales, largest first.
SORT-BY-SALES-DESC.
    MOVE FRAME TO DM-DATA-FRAME-SORT-BY-SELF
    MOVE "sales" TO DM-DATA-FRAME-SORT-BY-COLUMN-NAME
    MOVE 2 TO DM-DATA-FRAME-SORT-BY-GIVEN
    MOVE 0 TO DM-DATA-FRAME-SORT-BY-ASCENDING
    CALL "dm_data_frame_sort_by" USING DM-DATA-FRAME-SORT-BY DM-STATUS
    PERFORM CHECK
    MOVE FRAME TO DM-HANDLE-SELF
    CALL "dm_close" USING DM-HANDLE DM-STATUS
    MOVE DM-DATA-FRAME-SORT-BY-RESULT TO FRAME.

DISPLAY-FRAME.
    MOVE FRAME TO DM-DATA-FRAME-TO-STRING-SELF
    CALL "dm_data_frame_to_string" USING DM-DATA-FRAME-TO-STRING DM-STATUS
    PERFORM CHECK
    DISPLAY DM-DATA-FRAME-TO-STRING-RESULT(1:DM-DATA-FRAME-TO-STRING-RESULT-LENGTH).

*> Splits LIST-TEXT at commas into LIST-COUNT items (empty items allowed).
SPLIT-LIST.
    MOVE 0 TO LIST-COUNT
    INSPECT LIST-TEXT TALLYING LIST-COUNT FOR ALL ","
    ADD 1 TO LIST-COUNT
    MOVE 1 TO LIST-PTR.

*> Reads the next item of LIST-TEXT into LIST-ITEM.
NEXT-ITEM.
    MOVE SPACES TO LIST-ITEM
    UNSTRING LIST-TEXT DELIMITED BY "," OR SPACE INTO LIST-ITEM WITH POINTER LIST-PTR.

LIST-TO-STRINGS.
    PERFORM SPLIT-LIST
    MOVE LIST-COUNT TO DM-VECTOR-STRING-TABLE-COUNT
    PERFORM VARYING I FROM 1 BY 1 UNTIL I > LIST-COUNT
        PERFORM NEXT-ITEM
        MOVE LIST-ITEM TO DM-VECTOR-STRING-TABLE-ITEM(I)
        MOVE -1 TO DM-VECTOR-STRING-TABLE-ITEM-LENGTH(I)
    END-PERFORM
    CALL "dm_vector_string_from_table" USING DM-VECTOR-STRING-TABLE DM-STATUS
    PERFORM CHECK
    MOVE DM-VECTOR-STRING-TABLE-SELF TO LIST-VEC.

LIST-TO-DOUBLES.
    PERFORM SPLIT-LIST
    MOVE LIST-COUNT TO DM-VECTOR-DOUBLE-TABLE-COUNT
    PERFORM VARYING I FROM 1 BY 1 UNTIL I > LIST-COUNT
        PERFORM NEXT-ITEM
        COMPUTE DM-VECTOR-DOUBLE-TABLE-ITEM(I) = FUNCTION NUMVAL(LIST-ITEM)
    END-PERFORM
    CALL "dm_vector_double_from_table" USING DM-VECTOR-DOUBLE-TABLE DM-STATUS
    PERFORM CHECK
    MOVE DM-VECTOR-DOUBLE-TABLE-SELF TO LIST-VEC.

LIST-TO-INTS.
    PERFORM SPLIT-LIST
    MOVE LIST-COUNT TO DM-VECTOR-INT-TABLE-COUNT
    PERFORM VARYING I FROM 1 BY 1 UNTIL I > LIST-COUNT
        PERFORM NEXT-ITEM
        COMPUTE DM-VECTOR-INT-TABLE-ITEM(I) = FUNCTION NUMVAL(LIST-ITEM)
    END-PERFORM
    CALL "dm_vector_int_from_table" USING DM-VECTOR-INT-TABLE DM-STATUS
    PERFORM CHECK
    MOVE DM-VECTOR-INT-TABLE-SELF TO LIST-VEC.

CLOSE-LIST.
    MOVE LIST-VEC TO DM-HANDLE-SELF
    CALL "dm_close" USING DM-HANDLE DM-STATUS.

CLOSE-LIST-AND-MASK.
    PERFORM CLOSE-LIST
    MOVE MASK-VEC TO DM-HANDLE-SELF
    CALL "dm_close" USING DM-HANDLE DM-STATUS.

*> Formats NUM without trailing zeros into NUM-TEXT(1:NUM-LEN).
FORMAT-NUMBER.
    COMPUTE NUM-EDIT ROUNDED = NUM
    MOVE FUNCTION TRIM(NUM-EDIT) TO NUM-TEXT
    COMPUTE NUM-LEN = FUNCTION LENGTH(FUNCTION TRIM(NUM-TEXT))
    PERFORM UNTIL NUM-TEXT(NUM-LEN:1) NOT = "0"
        SUBTRACT 1 FROM NUM-LEN
    END-PERFORM
    IF NUM-TEXT(NUM-LEN:1) = "."
        SUBTRACT 1 FROM NUM-LEN
    END-IF.

*> Stops with the error after a failed call.
CHECK.
    IF NOT DM-STATUS-OK
        DISPLAY "datamunge error (" FUNCTION TRIM(DM-STATUS-KIND) "): "
            DM-STATUS-MESSAGE(1:DM-STATUS-LENGTH) UPON SYSERR
        STOP RUN RETURNING 1
    END-IF.
