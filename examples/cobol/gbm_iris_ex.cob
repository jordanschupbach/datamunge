*> Gradient-boosted classification of iris species from petal length and width.
*> CMD: just TARGET=gbm_iris_ex run-cobol
IDENTIFICATION DIVISION.
PROGRAM-ID. GBM-IRIS-EX.
DATA DIVISION.
WORKING-STORAGE SECTION.
COPY "datamunge.cpy".

01 FORMULA-TEXT PIC X(40) VALUE "Species ~ Petal.Length + Petal.Width".

01 IRIS       USAGE BINARY-DOUBLE UNSIGNED.
01 MODEL      USAGE BINARY-DOUBLE UNSIGNED.
01 FEW        USAGE BINARY-DOUBLE UNSIGNED.
01 ENSEMBLE   USAGE BINARY-DOUBLE UNSIGNED.
01 FRAME      USAGE BINARY-DOUBLE UNSIGNED.
01 PLOT       USAGE BINARY-DOUBLE UNSIGNED.
01 N-ROWS     USAGE BINARY-LONG.
01 I          USAGE BINARY-LONG.
01 MISCLASSIFIED USAGE BINARY-LONG VALUE 0.
01 ACTUAL     PIC X(32).

01 INT-1      PIC -(9)9.
01 INT-2      PIC -(9)9.
01 NUM        USAGE COMP-2.
01 NUM-EDIT   PIC -(12)9.9(10).
01 NUM-TEXT   PIC X(32).
01 NUM-LEN    USAGE BINARY-LONG.
01 NUM-TEXT-2 PIC X(32).
01 NUM-LEN-2  USAGE BINARY-LONG.

PROCEDURE DIVISION.
    CALL "dm_data_iris" USING DM-DATA-IRIS DM-STATUS
    PERFORM CHECK
    MOVE DM-DATA-IRIS-RESULT TO IRIS
    MOVE IRIS TO DM-DATA-FRAME-NROWS-SELF
    CALL "dm_data_frame_nrows" USING DM-DATA-FRAME-NROWS DM-STATUS
    PERFORM CHECK
    MOVE DM-DATA-FRAME-NROWS-RESULT TO N-ROWS INT-1
    MOVE IRIS TO DM-DATA-FRAME-NCOLS-SELF
    CALL "dm_data_frame_ncols" USING DM-DATA-FRAME-NCOLS DM-STATUS
    PERFORM CHECK
    MOVE DM-DATA-FRAME-NCOLS-RESULT TO INT-2
    DISPLAY "iris: " FUNCTION TRIM(INT-1) " rows x " FUNCTION TRIM(INT-2) " cols"
    DISPLAY " "

    MOVE IRIS TO DM-GBM-CLASSIFIER-NEW-DATA
    MOVE FORMULA-TEXT TO DM-GBM-CLASSIFIER-NEW-FORMULA
    CALL "dm_gbm_classifier_new" USING DM-GBM-CLASSIFIER-NEW DM-STATUS
    PERFORM CHECK
    MOVE DM-GBM-CLASSIFIER-NEW-RESULT TO MODEL
    MOVE MODEL TO DM-GBM-CLASSIFIER-PRINT-SUMMARY-SELF
    CALL "dm_gbm_classifier_print_summary" USING DM-GBM-CLASSIFIER-PRINT-SUMMARY DM-STATUS
    PERFORM CHECK

    DISPLAY " "
    DISPLAY "Confusion matrix (rows = actual, cols = predicted):"
    MOVE MODEL TO DM-GBM-CLASSIFIER-CONFUSION-MATRIX-SELF
    CALL "dm_gbm_classifier_confusion_matrix" USING DM-GBM-CLASSIFIER-CONFUSION-MATRIX DM-STATUS
    PERFORM CHECK
    MOVE DM-GBM-CLASSIFIER-CONFUSION-MATRIX-RESULT TO FRAME
    PERFORM DISPLAY-FRAME

    DISPLAY " "
    DISPLAY "Misclassified rows:"
    MOVE MODEL TO DM-GBM-CLASSIFIER-PREDICT-SELF
    MOVE IRIS TO DM-GBM-CLASSIFIER-PREDICT-NEWDATA
    CALL "dm_gbm_classifier_predict" USING DM-GBM-CLASSIFIER-PREDICT DM-STATUS
    PERFORM CHECK
    *> The predicted species, one per row, land in DM-VECTOR-STRING-TABLE-ITEM.
    MOVE DM-GBM-CLASSIFIER-PREDICT-RESULT TO DM-VECTOR-STRING-TABLE-SELF
    CALL "dm_vector_string_to_table" USING DM-VECTOR-STRING-TABLE DM-STATUS
    PERFORM CHECK
    PERFORM REPORT-MISCLASSIFIED
    MOVE DM-GBM-CLASSIFIER-PREDICT-RESULT TO DM-HANDLE-SELF
    CALL "dm_close" USING DM-HANDLE DM-STATUS

    MOVE MODEL TO DM-GBM-CLASSIFIER-PLOT-TRAINING-DEVIANCE-SELF
    CALL "dm_gbm_classifier_plot_training_deviance" USING
        DM-GBM-CLASSIFIER-PLOT-TRAINING-DEVIANCE DM-STATUS
    PERFORM CHECK
    MOVE DM-GBM-CLASSIFIER-PLOT-TRAINING-DEVIANCE-RESULT TO PLOT
    MOVE "gbm_iris_training_deviance.svg" TO DM-PLOT-SAVE-PATH
    PERFORM SAVE-PLOT
    MOVE MODEL TO ENSEMBLE
    MOVE "gbm_iris_decision_regions.svg" TO DM-PLOT-SAVE-PATH
    PERFORM SAVE-DECISION-REGIONS
    DISPLAY " "
    DISPLAY "Saved gbm_iris_training_deviance.svg and gbm_iris_decision_regions.svg"

    *> A handful of boosting rounds vs a well-boosted ensemble: each round chips away
    *> at the training loss, sharpening the decision boundary.
    *> GBMClassifier(data, formula, n_trees, learning_rate, max_depth,
    *>   min_samples_split, min_samples_leaf, subsample, seed)
    MOVE 3 TO DM-GBM-CLASSIFIER-NEW-GIVEN
    MOVE 5 TO DM-GBM-CLASSIFIER-NEW-N-TREES
    CALL "dm_gbm_classifier_new" USING DM-GBM-CLASSIFIER-NEW DM-STATUS
    PERFORM CHECK
    MOVE DM-GBM-CLASSIFIER-NEW-RESULT TO FEW
    DISPLAY " "
    MOVE FEW TO ENSEMBLE
    PERFORM FORMAT-ACCURACY-AND-DEVIANCE
    DISPLAY "5-round ensemble:   training accuracy=" NUM-TEXT(1:NUM-LEN)
        "%  deviance=" NUM-TEXT-2(1:NUM-LEN-2)
    MOVE MODEL TO ENSEMBLE
    PERFORM FORMAT-ACCURACY-AND-DEVIANCE
    DISPLAY "100-round ensemble: training accuracy=" NUM-TEXT(1:NUM-LEN)
        "%  deviance=" NUM-TEXT-2(1:NUM-LEN-2)
    MOVE FEW TO ENSEMBLE
    MOVE "gbm_iris_decision_regions_5rounds.svg" TO DM-PLOT-SAVE-PATH
    PERFORM SAVE-DECISION-REGIONS
    DISPLAY "Saved gbm_iris_decision_regions_5rounds.svg"

    MOVE FEW TO DM-HANDLE-SELF
    CALL "dm_close" USING DM-HANDLE DM-STATUS
    MOVE MODEL TO DM-HANDLE-SELF
    CALL "dm_close" USING DM-HANDLE DM-STATUS
    MOVE IRIS TO DM-HANDLE-SELF
    CALL "dm_close" USING DM-HANDLE DM-STATUS
    STOP RUN.

*> Lists rows whose prediction (DM-VECTOR-STRING-TABLE-ITEM) differs from Species.
REPORT-MISCLASSIFIED.
    PERFORM VARYING I FROM 1 BY 1 UNTIL I > N-ROWS
        MOVE IRIS TO DM-DATA-FRAME-STRING-AT-SELF
        MOVE "Species" TO DM-DATA-FRAME-STRING-AT-COLUMN-NAME
        COMPUTE DM-DATA-FRAME-STRING-AT-ROW-INDEX = I - 1
        CALL "dm_data_frame_string_at" USING DM-DATA-FRAME-STRING-AT DM-STATUS
        PERFORM CHECK
        MOVE DM-DATA-FRAME-STRING-AT-RESULT(1:DM-DATA-FRAME-STRING-AT-RESULT-LENGTH) TO ACTUAL
        IF DM-VECTOR-STRING-TABLE-ITEM(I) NOT = ACTUAL
            ADD 1 TO MISCLASSIFIED
            MOVE IRIS TO DM-DATA-FRAME-NUMERIC-AT-SELF
            COMPUTE DM-DATA-FRAME-NUMERIC-AT-ROW-INDEX = I - 1
            MOVE "Petal.Length" TO DM-DATA-FRAME-NUMERIC-AT-COLUMN-NAME
            CALL "dm_data_frame_numeric_at" USING DM-DATA-FRAME-NUMERIC-AT DM-STATUS
            PERFORM CHECK
            MOVE DM-DATA-FRAME-NUMERIC-AT-RESULT TO NUM
            PERFORM FORMAT-NUMBER
            MOVE NUM-TEXT TO NUM-TEXT-2
            MOVE NUM-LEN TO NUM-LEN-2
            MOVE "Petal.Width" TO DM-DATA-FRAME-NUMERIC-AT-COLUMN-NAME
            CALL "dm_data_frame_numeric_at" USING DM-DATA-FRAME-NUMERIC-AT DM-STATUS
            PERFORM CHECK
            MOVE DM-DATA-FRAME-NUMERIC-AT-RESULT TO NUM
            PERFORM FORMAT-NUMBER
            COMPUTE INT-1 = I - 1
            DISPLAY "  row " FUNCTION TRIM(INT-1) ": Petal.Length=" NUM-TEXT-2(1:NUM-LEN-2)
                " Petal.Width=" NUM-TEXT(1:NUM-LEN)
                "  actual=" FUNCTION TRIM(ACTUAL)
                "  predicted=" FUNCTION TRIM(DM-VECTOR-STRING-TABLE-ITEM(I))
        END-IF
    END-PERFORM
    MOVE MISCLASSIFIED TO INT-1
    MOVE N-ROWS TO INT-2
    COMPUTE NUM = 100.0 * MISCLASSIFIED / N-ROWS
    PERFORM FORMAT-NUMBER
    DISPLAY FUNCTION TRIM(INT-1) " of " FUNCTION TRIM(INT-2) " misclassified ("
        NUM-TEXT(1:NUM-LEN) "%)".

*> Formats ENSEMBLE's training accuracy (percent) into NUM-TEXT and its final
*> training deviance into NUM-TEXT-2.
FORMAT-ACCURACY-AND-DEVIANCE.
    MOVE ENSEMBLE TO DM-GBM-CLASSIFIER-TRAINING-DEVIANCE-SELF
    CALL "dm_gbm_classifier_training_deviance" USING
        DM-GBM-CLASSIFIER-TRAINING-DEVIANCE DM-STATUS
    PERFORM CHECK
    *> The last element of the per-round deviance vector.
    MOVE DM-GBM-CLASSIFIER-TRAINING-DEVIANCE-RESULT TO DM-VECTOR-DOUBLE-SELF
    CALL "dm_vector_double_size" USING DM-VECTOR-DOUBLE DM-STATUS
    PERFORM CHECK
    MOVE DM-VECTOR-DOUBLE-SIZE TO DM-VECTOR-DOUBLE-INDEX
    CALL "dm_vector_double_get" USING DM-VECTOR-DOUBLE DM-STATUS
    PERFORM CHECK
    MOVE DM-VECTOR-DOUBLE-VALUE TO NUM
    PERFORM FORMAT-NUMBER
    MOVE NUM-TEXT TO NUM-TEXT-2
    MOVE NUM-LEN TO NUM-LEN-2
    MOVE DM-VECTOR-DOUBLE-SELF TO DM-HANDLE-SELF
    CALL "dm_close" USING DM-HANDLE DM-STATUS
    MOVE ENSEMBLE TO DM-GBM-CLASSIFIER-TRAINING-ACCURACY-SELF
    CALL "dm_gbm_classifier_training_accuracy" USING
        DM-GBM-CLASSIFIER-TRAINING-ACCURACY DM-STATUS
    PERFORM CHECK
    COMPUTE NUM = DM-GBM-CLASSIFIER-TRAINING-ACCURACY-RESULT * 100.0
    PERFORM FORMAT-NUMBER.

*> Saves ENSEMBLE's Petal.Length x Petal.Width decision regions to DM-PLOT-SAVE-PATH.
SAVE-DECISION-REGIONS.
    MOVE ENSEMBLE TO DM-GBM-CLASSIFIER-PLOT-DECISION-REGIONS-SELF
    MOVE "Petal.Length" TO DM-GBM-CLASSIFIER-PLOT-DECISION-REGIONS-X-FEATURE
    MOVE "Petal.Width" TO DM-GBM-CLASSIFIER-PLOT-DECISION-REGIONS-Y-FEATURE
    CALL "dm_gbm_classifier_plot_decision_regions" USING
        DM-GBM-CLASSIFIER-PLOT-DECISION-REGIONS DM-STATUS
    PERFORM CHECK
    MOVE DM-GBM-CLASSIFIER-PLOT-DECISION-REGIONS-RESULT TO PLOT
    PERFORM SAVE-PLOT.

*> Saves PLOT to DM-PLOT-SAVE-PATH and closes it.
SAVE-PLOT.
    MOVE PLOT TO DM-PLOT-SAVE-SELF
    CALL "dm_plot_save" USING DM-PLOT-SAVE DM-STATUS
    PERFORM CHECK
    MOVE PLOT TO DM-HANDLE-SELF
    CALL "dm_close" USING DM-HANDLE DM-STATUS.

*> Displays the DataFrame FRAME and closes it.
DISPLAY-FRAME.
    MOVE FRAME TO DM-DATA-FRAME-TO-STRING-SELF
    CALL "dm_data_frame_to_string" USING DM-DATA-FRAME-TO-STRING DM-STATUS
    PERFORM CHECK
    DISPLAY DM-DATA-FRAME-TO-STRING-RESULT(1:DM-DATA-FRAME-TO-STRING-RESULT-LENGTH)
    MOVE FRAME TO DM-HANDLE-SELF
    CALL "dm_close" USING DM-HANDLE DM-STATUS.

*> Formats NUM without trailing zeros into NUM-TEXT(1:NUM-LEN).
FORMAT-NUMBER.
    COMPUTE NUM-EDIT ROUNDED = NUM
    MOVE FUNCTION TRIM(NUM-EDIT) TO NUM-TEXT
    COMPUTE NUM-LEN = FUNCTION LENGTH(FUNCTION TRIM(NUM-TEXT))
    PERFORM UNTIL NUM-TEXT(NUM-LEN:1) NOT = "0"
        SUBTRACT 1 FROM NUM-LEN
    END-PERFORM
    IF NUM-TEXT(NUM-LEN:1) = "."
        SUBTRACT 1 FROM NUM-LEN
    END-IF.

*> Stops with the error after a failed call.
CHECK.
    IF NOT DM-STATUS-OK
        DISPLAY "datamunge error (" FUNCTION TRIM(DM-STATUS-KIND) "): "
            DM-STATUS-MESSAGE(1:DM-STATUS-LENGTH) UPON SYSERR
        STOP RUN RETURNING 1
    END-IF.
