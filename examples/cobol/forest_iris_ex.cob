*> Random forest classification of iris species from petal length and width.
*> CMD: just TARGET=forest_iris_ex run-cobol
IDENTIFICATION DIVISION.
PROGRAM-ID. FOREST-IRIS-EX.
DATA DIVISION.
WORKING-STORAGE SECTION.
COPY "datamunge.cpy".

01 FORMULA-TEXT PIC X(40) VALUE "Species ~ Petal.Length + Petal.Width".

01 IRIS       USAGE BINARY-DOUBLE UNSIGNED.
01 MODEL      USAGE BINARY-DOUBLE UNSIGNED.
01 SMALL-FOREST USAGE BINARY-DOUBLE UNSIGNED.
01 FOREST     USAGE BINARY-DOUBLE UNSIGNED.
01 FRAME      USAGE BINARY-DOUBLE UNSIGNED.
01 PLOT       USAGE BINARY-DOUBLE UNSIGNED.
01 N-ROWS     USAGE BINARY-LONG.
01 I          USAGE BINARY-LONG.
01 MISCLASSIFIED USAGE BINARY-LONG VALUE 0.
01 ACTUAL     PIC X(32).

01 INT-1      PIC -(9)9.
01 INT-2      PIC -(9)9.
01 NUM        USAGE COMP-2.
01 NUM-EDIT   PIC -(12)9.9(10).
01 NUM-TEXT   PIC X(32).
01 NUM-LEN    USAGE BINARY-LONG.
01 NUM-TEXT-2 PIC X(32).
01 NUM-LEN-2  USAGE BINARY-LONG.

PROCEDURE DIVISION.
    CALL "dm_data_iris" USING DM-DATA-IRIS DM-STATUS
    PERFORM CHECK
    MOVE DM-DATA-IRIS-RESULT TO IRIS
    MOVE IRIS TO DM-DATA-FRAME-NROWS-SELF
    CALL "dm_data_frame_nrows" USING DM-DATA-FRAME-NROWS DM-STATUS
    PERFORM CHECK
    MOVE DM-DATA-FRAME-NROWS-RESULT TO N-ROWS INT-1
    MOVE IRIS TO DM-DATA-FRAME-NCOLS-SELF
    CALL "dm_data_frame_ncols" USING DM-DATA-FRAME-NCOLS DM-STATUS
    PERFORM CHECK
    MOVE DM-DATA-FRAME-NCOLS-RESULT TO INT-2
    DISPLAY "iris: " FUNCTION TRIM(INT-1) " rows x " FUNCTION TRIM(INT-2) " cols"
    DISPLAY " "

    MOVE IRIS TO DM-RANDOM-FOREST-CLASSIFIER-NEW-DATA
    MOVE FORMULA-TEXT TO DM-RANDOM-FOREST-CLASSIFIER-NEW-FORMULA
    CALL "dm_random_forest_classifier_new" USING DM-RANDOM-FOREST-CLASSIFIER-NEW DM-STATUS
    PERFORM CHECK
    MOVE DM-RANDOM-FOREST-CLASSIFIER-NEW-RESULT TO MODEL
    MOVE MODEL TO DM-RANDOM-FOREST-CLASSIFIER-PRINT-SUMMARY-SELF
    CALL "dm_random_forest_classifier_print_summary" USING
        DM-RANDOM-FOREST-CLASSIFIER-PRINT-SUMMARY DM-STATUS
    PERFORM CHECK

    DISPLAY " "
    DISPLAY "Confusion matrix (rows = actual, cols = predicted):"
    MOVE MODEL TO DM-RANDOM-FOREST-CLASSIFIER-CONFUSION-MATRIX-SELF
    CALL "dm_random_forest_classifier_confusion_matrix" USING
        DM-RANDOM-FOREST-CLASSIFIER-CONFUSION-MATRIX DM-STATUS
    PERFORM CHECK
    MOVE DM-RANDOM-FOREST-CLASSIFIER-CONFUSION-MATRIX-RESULT TO FRAME
    PERFORM DISPLAY-FRAME

    DISPLAY " "
    DISPLAY "Misclassified rows:"
    MOVE MODEL TO DM-RANDOM-FOREST-CLASSIFIER-PREDICT-SELF
    MOVE IRIS TO DM-RANDOM-FOREST-CLASSIFIER-PREDICT-NEWDATA
    CALL "dm_random_forest_classifier_predict" USING DM-RANDOM-FOREST-CLASSIFIER-PREDICT DM-STATUS
    PERFORM CHECK
    *> The predicted species, one per row, land in DM-VECTOR-STRING-TABLE-ITEM.
    MOVE DM-RANDOM-FOREST-CLASSIFIER-PREDICT-RESULT TO DM-VECTOR-STRING-TABLE-SELF
    CALL "dm_vector_string_to_table" USING DM-VECTOR-STRING-TABLE DM-STATUS
    PERFORM CHECK
    PERFORM REPORT-MISCLASSIFIED
    MOVE DM-RANDOM-FOREST-CLASSIFIER-PREDICT-RESULT TO DM-HANDLE-SELF
    CALL "dm_close" USING DM-HANDLE DM-STATUS

    MOVE MODEL TO DM-RANDOM-FOREST-CLASSIFIER-PLOT-CLASSIFICATION-SELF
    MOVE IRIS TO DM-RANDOM-FOREST-CLASSIFIER-PLOT-CLASSIFICATION-DATA
    MOVE "Petal.Length" TO DM-RNDM-FOREST-CLASSIFIER-PLOT-CLASSIFICATION-X-FEATURE
    MOVE "Petal.Width" TO DM-RNDM-FOREST-CLASSIFIER-PLOT-CLASSIFICATION-Y-FEATURE
    CALL "dm_random_forest_classifier_plot_classification" USING
        DM-RANDOM-FOREST-CLASSIFIER-PLOT-CLASSIFICATION DM-STATUS
    PERFORM CHECK
    MOVE DM-RANDOM-FOREST-CLASSIFIER-PLOT-CLASSIFICATION-RESULT TO PLOT
    MOVE "forest_iris_classification.svg" TO DM-PLOT-SAVE-PATH
    PERFORM SAVE-PLOT
    MOVE MODEL TO FOREST
    MOVE "forest_iris_decision_regions.svg" TO DM-PLOT-SAVE-PATH
    PERFORM SAVE-DECISION-REGIONS
    DISPLAY " "
    DISPLAY "Saved forest_iris_classification.svg and forest_iris_decision_regions.svg"

    *> A 5-tree forest shows how out-of-bag accuracy stabilizes as trees are added.
    *> RandomForestClassifier(data, formula, n_trees, max_depth, min_samples_split,
    *>   min_samples_leaf, max_features, criterion, bootstrap, sample_fraction, seed)
    MOVE 3 TO DM-RANDOM-FOREST-CLASSIFIER-NEW-GIVEN
    MOVE 5 TO DM-RANDOM-FOREST-CLASSIFIER-NEW-N-TREES
    CALL "dm_random_forest_classifier_new" USING DM-RANDOM-FOREST-CLASSIFIER-NEW DM-STATUS
    PERFORM CHECK
    MOVE DM-RANDOM-FOREST-CLASSIFIER-NEW-RESULT TO SMALL-FOREST
    DISPLAY " "
    MOVE SMALL-FOREST TO FOREST
    PERFORM FORMAT-ACCURACIES
    DISPLAY "5-tree forest:   training accuracy=" NUM-TEXT(1:NUM-LEN)
        "%  OOB accuracy=" NUM-TEXT-2(1:NUM-LEN-2) "%"
    MOVE MODEL TO FOREST
    PERFORM FORMAT-ACCURACIES
    DISPLAY "100-tree forest: training accuracy=" NUM-TEXT(1:NUM-LEN)
        "%  OOB accuracy=" NUM-TEXT-2(1:NUM-LEN-2) "%"
    MOVE SMALL-FOREST TO FOREST
    MOVE "forest_iris_decision_regions_5trees.svg" TO DM-PLOT-SAVE-PATH
    PERFORM SAVE-DECISION-REGIONS
    DISPLAY "Saved forest_iris_decision_regions_5trees.svg"

    MOVE SMALL-FOREST TO DM-HANDLE-SELF
    CALL "dm_close" USING DM-HANDLE DM-STATUS
    MOVE MODEL TO DM-HANDLE-SELF
    CALL "dm_close" USING DM-HANDLE DM-STATUS
    MOVE IRIS TO DM-HANDLE-SELF
    CALL "dm_close" USING DM-HANDLE DM-STATUS
    STOP RUN.

*> Lists rows whose prediction (DM-VECTOR-STRING-TABLE-ITEM) differs from Species.
REPORT-MISCLASSIFIED.
    PERFORM VARYING I FROM 1 BY 1 UNTIL I > N-ROWS
        MOVE IRIS TO DM-DATA-FRAME-STRING-AT-SELF
        MOVE "Species" TO DM-DATA-FRAME-STRING-AT-COLUMN-NAME
        COMPUTE DM-DATA-FRAME-STRING-AT-ROW-INDEX = I - 1
        CALL "dm_data_frame_string_at" USING DM-DATA-FRAME-STRING-AT DM-STATUS
        PERFORM CHECK
        MOVE DM-DATA-FRAME-STRING-AT-RESULT(1:DM-DATA-FRAME-STRING-AT-RESULT-LENGTH) TO ACTUAL
        IF DM-VECTOR-STRING-TABLE-ITEM(I) NOT = ACTUAL
            ADD 1 TO MISCLASSIFIED
            MOVE IRIS TO DM-DATA-FRAME-NUMERIC-AT-SELF
            COMPUTE DM-DATA-FRAME-NUMERIC-AT-ROW-INDEX = I - 1
            MOVE "Petal.Length" TO DM-DATA-FRAME-NUMERIC-AT-COLUMN-NAME
            CALL "dm_data_frame_numeric_at" USING DM-DATA-FRAME-NUMERIC-AT DM-STATUS
            PERFORM CHECK
            MOVE DM-DATA-FRAME-NUMERIC-AT-RESULT TO NUM
            PERFORM FORMAT-NUMBER
            MOVE NUM-TEXT TO NUM-TEXT-2
            MOVE NUM-LEN TO NUM-LEN-2
            MOVE "Petal.Width" TO DM-DATA-FRAME-NUMERIC-AT-COLUMN-NAME
            CALL "dm_data_frame_numeric_at" USING DM-DATA-FRAME-NUMERIC-AT DM-STATUS
            PERFORM CHECK
            MOVE DM-DATA-FRAME-NUMERIC-AT-RESULT TO NUM
            PERFORM FORMAT-NUMBER
            COMPUTE INT-1 = I - 1
            DISPLAY "  row " FUNCTION TRIM(INT-1) ": Petal.Length=" NUM-TEXT-2(1:NUM-LEN-2)
                " Petal.Width=" NUM-TEXT(1:NUM-LEN)
                "  actual=" FUNCTION TRIM(ACTUAL)
                "  predicted=" FUNCTION TRIM(DM-VECTOR-STRING-TABLE-ITEM(I))
        END-IF
    END-PERFORM
    MOVE MISCLASSIFIED TO INT-1
    MOVE N-ROWS TO INT-2
    COMPUTE NUM = 100.0 * MISCLASSIFIED / N-ROWS
    PERFORM FORMAT-NUMBER
    DISPLAY FUNCTION TRIM(INT-1) " of " FUNCTION TRIM(INT-2) " misclassified ("
        NUM-TEXT(1:NUM-LEN) "%)".

*> Formats FOREST's training and OOB accuracy, in percent, into NUM-TEXT and NUM-TEXT-2.
FORMAT-ACCURACIES.
    MOVE FOREST TO DM-RANDOM-FOREST-CLASSIFIER-OOB-ACCURACY-SELF
    CALL "dm_random_forest_classifier_oob_accuracy" USING
        DM-RANDOM-FOREST-CLASSIFIER-OOB-ACCURACY DM-STATUS
    PERFORM CHECK
    COMPUTE NUM = DM-RANDOM-FOREST-CLASSIFIER-OOB-ACCURACY-RESULT * 100.0
    PERFORM FORMAT-NUMBER
    MOVE NUM-TEXT TO NUM-TEXT-2
    MOVE NUM-LEN TO NUM-LEN-2
    MOVE FOREST TO DM-RANDOM-FOREST-CLASSIFIER-TRAINING-ACCURACY-SELF
    CALL "dm_random_forest_classifier_training_accuracy" USING
        DM-RANDOM-FOREST-CLASSIFIER-TRAINING-ACCURACY DM-STATUS
    PERFORM CHECK
    COMPUTE NUM = DM-RANDOM-FOREST-CLASSIFIER-TRAINING-ACCURACY-RESULT * 100.0
    PERFORM FORMAT-NUMBER.

*> Saves FOREST's Petal.Length x Petal.Width decision regions to DM-PLOT-SAVE-PATH.
SAVE-DECISION-REGIONS.
    MOVE FOREST TO DM-RANDOM-FOREST-CLASSIFIER-PLOT-DECISION-REGIONS-SELF
    MOVE "Petal.Length" TO DM-RNDM-FRST-CLASSIFIER-PLOT-DECISION-REGIONS-X-FEATURE
    MOVE "Petal.Width" TO DM-RNDM-FRST-CLASSIFIER-PLOT-DECISION-REGIONS-Y-FEATURE
    CALL "dm_random_forest_classifier_plot_decision_regions" USING
        DM-RANDOM-FOREST-CLASSIFIER-PLOT-DECISION-REGIONS DM-STATUS
    PERFORM CHECK
    MOVE DM-RNDM-FOREST-CLASSIFIER-PLOT-DECISION-REGIONS-RESULT TO PLOT
    PERFORM SAVE-PLOT.

*> Saves PLOT to DM-PLOT-SAVE-PATH and closes it.
SAVE-PLOT.
    MOVE PLOT TO DM-PLOT-SAVE-SELF
    CALL "dm_plot_save" USING DM-PLOT-SAVE DM-STATUS
    PERFORM CHECK
    MOVE PLOT TO DM-HANDLE-SELF
    CALL "dm_close" USING DM-HANDLE DM-STATUS.

*> Displays the DataFrame FRAME and closes it.
DISPLAY-FRAME.
    MOVE FRAME TO DM-DATA-FRAME-TO-STRING-SELF
    CALL "dm_data_frame_to_string" USING DM-DATA-FRAME-TO-STRING DM-STATUS
    PERFORM CHECK
    DISPLAY DM-DATA-FRAME-TO-STRING-RESULT(1:DM-DATA-FRAME-TO-STRING-RESULT-LENGTH)
    MOVE FRAME TO DM-HANDLE-SELF
    CALL "dm_close" USING DM-HANDLE DM-STATUS.

*> Formats NUM without trailing zeros into NUM-TEXT(1:NUM-LEN).
FORMAT-NUMBER.
    COMPUTE NUM-EDIT ROUNDED = NUM
    MOVE FUNCTION TRIM(NUM-EDIT) TO NUM-TEXT
    COMPUTE NUM-LEN = FUNCTION LENGTH(FUNCTION TRIM(NUM-TEXT))
    PERFORM UNTIL NUM-TEXT(NUM-LEN:1) NOT = "0"
        SUBTRACT 1 FROM NUM-LEN
    END-PERFORM
    IF NUM-TEXT(NUM-LEN:1) = "."
        SUBTRACT 1 FROM NUM-LEN
    END-IF.

*> Stops with the error after a failed call.
CHECK.
    IF NOT DM-STATUS-OK
        DISPLAY "datamunge error (" FUNCTION TRIM(DM-STATUS-KIND) "): "
            DM-STATUS-MESSAGE(1:DM-STATUS-LENGTH) UPON SYSERR
        STOP RUN RETURNING 1
    END-IF.
