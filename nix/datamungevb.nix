{
  pkgs ? import <nixpkgs> { },
  dotnetSdk ? pkgs.dotnetCorePackages.sdk_10_0-bin,
}:

# The Visual Basic binding Datamunge (generated by Rosetta from src/datamungevb/rosetta):
# $out/share/dotnet/DatamungeVB holds the project (Datamunge.vbproj, Datamunge.vb), the native
# library lib/datamunge_vb.so and the built bin/Datamunge.{dll,xml}. Reference the project (or the
# dll) and set DATAMUNGE_VB_LIBRARY to the native library. It needs no NuGet packages to build.
let
  datamunge = import ./datamunge.nix { inherit pkgs; };
in
pkgs.stdenv.mkDerivation {
  pname = "datamungevb";
  version = "0.0.1";

  src = import ./source.nix { lib = pkgs.lib; };

  nativeBuildInputs = [
    pkgs.cmake
    pkgs.pkg-config
    dotnetSdk
  ];

  buildInputs = [
    datamunge
    pkgs.arrow-cpp
  ];

  env = {
    DOTNET_CLI_TELEMETRY_OPTOUT = "1";
    DOTNET_NOLOGO = "1";
    DOTNET_SKIP_FIRST_TIME_EXPERIENCE = "1";
    DOTNET_SYSTEM_GLOBALIZATION_INVARIANT = "1";
  };

  configurePhase = ''
    export CMAKE_PREFIX_PATH="${datamunge}:${pkgs.arrow-cpp}''${CMAKE_PREFIX_PATH:+:$CMAKE_PREFIX_PATH}"
    cmake -S src/datamungevb -B build/datamungevb \
      -DCMAKE_BUILD_TYPE=Release \
      -DCMAKE_INSTALL_RPATH_USE_LINK_PATH=ON \
      -DCMAKE_PREFIX_PATH="$CMAKE_PREFIX_PATH"
  '';

  buildPhase = ''
    runHook preBuild
    cmake --build build/datamungevb -j $NIX_BUILD_CORES
    export HOME="$TMPDIR" DOTNET_CLI_HOME="$TMPDIR" NUGET_PACKAGES="$TMPDIR/nuget-packages"
    mkdir -p "$TMPDIR/no-sources"
    dotnet build src/datamungevb/Datamunge.vbproj -c Release -nologo -o "$TMPDIR/vb-bin" -p:RestoreSources="$TMPDIR/no-sources"
    runHook postBuild
  '';

  installPhase = ''
    runHook preInstall
    cmake --install build/datamungevb --prefix "$out"
    install -Dm644 -t "$out/share/dotnet/DatamungeVB/bin" "$TMPDIR"/vb-bin/Datamunge.{dll,xml}
    runHook postInstall
  '';

  meta = with pkgs.lib; {
    description = "Visual Basic bindings for the datamunge library (generated by Rosetta).";
    license = licenses.unlicense;
    platforms = platforms.unix;
  };
}
