{
  pkgs ? import <nixpkgs> { },
}:

# The Objective-C binding (generated by Rosetta from src/datamungeobjc/rosetta): $out/lib/libdatamunge_objc.so
# (the C ABI library), the classes $out/lib/libDM.so and their header $out/include/DM/DM.h (GNUstep Base and
# libobjc2). Compile programs with clang -fobjc-arc -fobjc-runtime=gnustep-2.0 -fblocks -I$out/include/DM
# -L$out/lib -lDM -lgnustep-base -lobjc (the justfile's OBJCC).
let
  datamunge = import ./datamunge.nix { inherit pkgs; };
in
pkgs.stdenv.mkDerivation {
  pname = "datamungeobjc";
  version = "0.0.1";

  src = import ./source.nix { lib = pkgs.lib; };

  nativeBuildInputs = [
    pkgs.cmake
    pkgs.pkg-config
  ];

  buildInputs = [
    datamunge
    pkgs.arrow-cpp
  ];

  configurePhase = ''
    export CMAKE_PREFIX_PATH="${datamunge}:${pkgs.arrow-cpp}''${CMAKE_PREFIX_PATH:+:$CMAKE_PREFIX_PATH}"
    cmake -S src/datamungeobjc -B build/datamungeobjc \
      -DCMAKE_BUILD_TYPE=Release \
      -DCMAKE_INSTALL_LIBDIR=lib \
      -DCMAKE_INSTALL_RPATH_USE_LINK_PATH=ON \
      -DDATAMUNGE_OBJC_CC=${pkgs.clang}/bin/clang \
      -Dgnustep_base_root=${pkgs.gnustep-base.dev} \
      -Dgnustep_base_lib=${pkgs.gnustep-base.lib} \
      -Dlibobjc_root=${pkgs.gnustep-libobjc} \
      -DCMAKE_PREFIX_PATH="$CMAKE_PREFIX_PATH"
  '';

  buildPhase = ''
    runHook preBuild
    cmake --build build/datamungeobjc -j $NIX_BUILD_CORES
    runHook postBuild
  '';

  installPhase = ''
    runHook preInstall
    cmake --install build/datamungeobjc --prefix "$out"
    runHook postInstall
  '';

  meta = with pkgs.lib; {
    description = "Objective-C bindings for the datamunge library (generated by Rosetta).";
    license = licenses.unlicense;
    platforms = platforms.unix;
  };
}
