{
  pkgs ? import <nixpkgs> { },
}:

# The datamunge COBOL bindings (generated by Rosetta): the native library libdatamungecobol in
# $out/lib and the copybooks datamunge.cpy and datamunge-callbacks.cpy in $out/share/cobol/copy.
# Compile programs with GnuCOBOL: COBCPY=$out/share/cobol/copy cobc -x -free -fstatic-call
#   prog.cob -L$out/lib -ldatamungecobol -Q -Wl,-rpath,$out/lib
let
  datamunge = import ./datamunge.nix { inherit pkgs; };
in
pkgs.stdenv.mkDerivation {
  pname = "datamungecobol";
  version = "0.0.1";

  src = import ./source.nix { lib = pkgs.lib; };

  nativeBuildInputs = [
    pkgs.cmake
    pkgs.pkg-config
  ];

  buildInputs = [
    datamunge
    pkgs.arrow-cpp
  ];

  configurePhase = ''
    export CMAKE_PREFIX_PATH="${datamunge}:${pkgs.arrow-cpp}''${CMAKE_PREFIX_PATH:+:$CMAKE_PREFIX_PATH}"
    cmake -S src/datamungecobol -B build/datamungecobol \
      -DCMAKE_BUILD_TYPE=Release \
      -DCMAKE_INSTALL_RPATH_USE_LINK_PATH=ON \
      -DCMAKE_PREFIX_PATH="$CMAKE_PREFIX_PATH"
  '';

  buildPhase = ''
    cmake --build build/datamungecobol -j $NIX_BUILD_CORES
  '';

  installPhase = ''
    cmake --install build/datamungecobol --prefix "$out"
  '';

  meta = with pkgs.lib; {
    description = "COBOL (GnuCOBOL) bindings for the datamunge library (generated by Rosetta).";
    license = licenses.unlicense;
    platforms = platforms.unix;
  };
}
