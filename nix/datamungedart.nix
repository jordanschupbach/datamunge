{
  pkgs ? import <nixpkgs> { },
}:

# The Dart binding (generated by Rosetta from src/datamungedart/rosetta): $out/lib/libdatamunge_dart.so (the
# C ABI library) and the package $out/share/dart/datamunge. Depend on it with
# `datamunge: {path: $out/share/dart/datamunge}` and run with DATAMUNGE_DART_LIBRARY=$out/lib/libdatamunge_dart.so.
let
  datamunge = import ./datamunge.nix { inherit pkgs; };
in
pkgs.stdenv.mkDerivation {
  pname = "datamungedart";
  version = "0.0.1";

  src = import ./source.nix { lib = pkgs.lib; };

  nativeBuildInputs = [
    pkgs.cmake
    pkgs.pkg-config
  ];

  buildInputs = [
    datamunge
    pkgs.arrow-cpp
  ];

  configurePhase = ''
    export CMAKE_PREFIX_PATH="${datamunge}:${pkgs.arrow-cpp}''${CMAKE_PREFIX_PATH:+:$CMAKE_PREFIX_PATH}"
    cmake -S src/datamungedart -B build/datamungedart \
      -DCMAKE_BUILD_TYPE=Release \
      -DCMAKE_INSTALL_LIBDIR=lib \
      -DCMAKE_INSTALL_RPATH_USE_LINK_PATH=ON \
      -DCMAKE_PREFIX_PATH="$CMAKE_PREFIX_PATH"
  '';

  buildPhase = ''
    runHook preBuild
    cmake --build build/datamungedart -j $NIX_BUILD_CORES
    runHook postBuild
  '';

  installPhase = ''
    runHook preInstall
    cmake --install build/datamungedart --prefix "$out"
    runHook postInstall
  '';

  meta = with pkgs.lib; {
    description = "Dart bindings for the datamunge library (generated by Rosetta).";
    license = licenses.unlicense;
    platforms = platforms.unix;
  };
}
