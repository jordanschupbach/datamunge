{
  pkgs ? import <nixpkgs> { },
}:

# The Rust binding (generated by Rosetta from src/datamungerust/rosetta): $out/lib/libdatamunge_rust.so
# (the C ABI library the crate links) and the Cargo crate $out/share/cargo/datamunge (Cargo.toml,
# build.rs, src/lib.rs with the rustdoc documentation, src/rosetta.rs). Depend on it with
# `datamunge = { path = "$out/share/cargo/datamunge" }` and build with DATAMUNGE_RUST_LIB_DIR=$out/lib
# (plus an rpath, or LD_LIBRARY_PATH, for running). The crate has no dependencies.
let
  datamunge = import ./datamunge.nix { inherit pkgs; };
in
pkgs.stdenv.mkDerivation {
  pname = "datamungerust";
  version = "0.0.1";

  src = import ./source.nix { lib = pkgs.lib; };

  nativeBuildInputs = [
    pkgs.cmake
    pkgs.pkg-config
  ];

  buildInputs = [
    datamunge
    pkgs.arrow-cpp
  ];

  configurePhase = ''
    export CMAKE_PREFIX_PATH="${datamunge}:${pkgs.arrow-cpp}''${CMAKE_PREFIX_PATH:+:$CMAKE_PREFIX_PATH}"
    cmake -S src/datamungerust -B build/datamungerust \
      -DCMAKE_BUILD_TYPE=Release \
      -DCMAKE_INSTALL_LIBDIR=lib \
      -DCMAKE_INSTALL_RPATH_USE_LINK_PATH=ON \
      -DCMAKE_PREFIX_PATH="$CMAKE_PREFIX_PATH"
  '';

  buildPhase = ''
    runHook preBuild
    cmake --build build/datamungerust -j $NIX_BUILD_CORES
    runHook postBuild
  '';

  installPhase = ''
    runHook preInstall
    cmake --install build/datamungerust --prefix "$out"
    runHook postInstall
  '';

  meta = with pkgs.lib; {
    description = "Rust bindings for the datamunge library (generated by Rosetta).";
    license = licenses.unlicense;
    platforms = platforms.unix;
  };
}
