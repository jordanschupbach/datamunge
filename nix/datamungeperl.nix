# The Perl binding (generated by Rosetta from src/datamungeperl/rosetta), installed as a standard
# Perl module:
#   $out/lib/perl5/Datamunge.pm (the package Datamunge, documented in POD)
#   $out/lib/perl5/auto/Datamunge/libdatamunge_perl.so (the C ABI library with its XS glue)
# Put "$out/lib/perl5" on PERL5LIB (nix/report/perl.nix does).
{
  pkgs ? import <nixpkgs> { },
  datamunge ? import ./datamunge.nix { inherit pkgs; },
  perl ? pkgs.perl,
  ...
}:
pkgs.stdenv.mkDerivation {
  pname = "datamungeperl";
  version = "0.0.1";

  src = import ./source.nix { lib = pkgs.lib; };

  nativeBuildInputs = [
    pkgs.cmake
    pkgs.pkg-config
    perl
  ];

  buildInputs = [
    datamunge
    pkgs.arrow-cpp
  ];

  configurePhase = ''
    export CMAKE_PREFIX_PATH="${datamunge}:${pkgs.arrow-cpp}''${CMAKE_PREFIX_PATH:+:$CMAKE_PREFIX_PATH}"
    cmake -S src/datamungeperl -B build/datamungeperl \
      -DCMAKE_BUILD_TYPE=Release \
      -DCMAKE_INSTALL_RPATH_USE_LINK_PATH=ON \
      -DPERL_EXECUTABLE=${perl}/bin/perl \
      -DCMAKE_PREFIX_PATH="$CMAKE_PREFIX_PATH"
  '';

  buildPhase = ''
    runHook preBuild
    cmake --build build/datamungeperl -j $NIX_BUILD_CORES
    runHook postBuild
  '';

  installPhase = ''
    runHook preInstall
    cmake --install build/datamungeperl --prefix "$out"
    runHook postInstall
  '';

  meta = with pkgs.lib; {
    description = "Perl bindings for the datamunge library (generated by Rosetta).";
    license = licenses.unlicense;
    platforms = platforms.unix;
  };
}
