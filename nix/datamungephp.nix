# The PHP binding (generated by Rosetta from src/datamungephp/rosetta): the namespace Datamunge in
# $out/share/php/datamunge/datamunge.php, over PHP's FFI extension, and the C ABI library it loads,
# $out/lib/libdatamunge_php.so (also linked beside datamunge.php, where the loader looks first).
# $out/etc/php/conf.d/datamunge.ini puts the directory on include_path, so a shell only needs
#   PHP_INI_SCAN_DIR=":${datamungephp}/etc/php/conf.d"
# (the leading ':' keeps PHP's own scan dir) for `require 'datamunge.php';`.
{
  pkgs,
  datamunge,
  ...
}:
pkgs.stdenv.mkDerivation {
  pname = "datamungephp";
  version = "0.0.1";

  src = import ./source.nix { lib = pkgs.lib; };

  nativeBuildInputs = [
    pkgs.cmake
    pkgs.pkg-config
  ];

  buildInputs = [
    datamunge
    pkgs.arrow-cpp
  ];

  configurePhase = ''
    export CMAKE_PREFIX_PATH="${datamunge}:${pkgs.arrow-cpp}''${CMAKE_PREFIX_PATH:+:$CMAKE_PREFIX_PATH}"
    cmake -S src/datamungephp -B build/datamungephp \
      -DCMAKE_BUILD_TYPE=Release \
      -DCMAKE_INSTALL_LIBDIR=lib \
      -DCMAKE_INSTALL_RPATH_USE_LINK_PATH=ON \
      -DCMAKE_PREFIX_PATH="$CMAKE_PREFIX_PATH"
  '';

  buildPhase = ''
    runHook preBuild
    cmake --build build/datamungephp -j $NIX_BUILD_CORES
    runHook postBuild
  '';

  installPhase = ''
    runHook preInstall
    cmake --install build/datamungephp --prefix "$out"
    lib=libdatamunge_php${pkgs.stdenv.hostPlatform.extensions.sharedLibrary}
    ln -s "$out/lib/$lib" "$out/share/php/datamunge/$lib"
    mkdir -p "$out/etc/php/conf.d"
    printf 'include_path = ".:%s"\n' "$out/share/php/datamunge" > "$out/etc/php/conf.d/datamunge.ini"
    runHook postInstall
  '';

  meta = with pkgs.lib; {
    description = "PHP bindings for the datamunge library (generated by Rosetta).";
    license = licenses.unlicense;
    platforms = platforms.unix;
  };
}
