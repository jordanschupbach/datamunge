{
  pkgs ? import <nixpkgs> { },
  ocamlPackages ? pkgs.ocamlPackages,
}:

# The OCaml binding (generated by Rosetta from src/datamungeocaml/rosetta): the findlib package
# datamunge, whose classes are submodules over phantom-typed native objects (Datamunge.DataFrame).
#
# - $out/lib/datamunge/META, datamunge.{cmi,cmti,cma,cmxa,a,...}: the library, compiled from the
#   committed src/datamungeocaml/ocaml/datamunge/datamunge.{ml,mli} (the .mli carries the
#   documentation as odoc comments, read by odoc and mep's OCaml server).
# - $out/lib/datamunge/dlldatamunge_stubs.so: the C++ stubs for bytecode and the toplevel
#   (datamunge.cma -dllib); libdatamunge_stubs.a: the same for native programs, which also link
#   libdatamunge (datamunge.cmxa records -ldatamunge with an rpath).
#
# Use with OCAMLPATH=$out/lib: `ocamlfind ocamlopt -package datamunge -linkpkg`, dune
# `(libraries datamunge)`, or `#require "datamunge"` in the toplevel (CAML_LD_LIBRARY_PATH=$out/lib/datamunge).
let
  datamunge = import ./datamunge.nix { inherit pkgs; };
in
pkgs.stdenv.mkDerivation {
  pname = "datamungeocaml";
  version = "0.0.1";

  src = import ./source.nix { lib = pkgs.lib; };

  nativeBuildInputs = [
    pkgs.cmake
    pkgs.pkg-config
    ocamlPackages.ocaml
  ];

  buildInputs = [
    datamunge
    pkgs.arrow-cpp
  ];

  configurePhase = ''
    export CMAKE_PREFIX_PATH="${datamunge}:${pkgs.arrow-cpp}''${CMAKE_PREFIX_PATH:+:$CMAKE_PREFIX_PATH}"
    cmake -S src/datamungeocaml -B build/datamungeocaml \
      -DCMAKE_BUILD_TYPE=Release \
      -DCMAKE_INSTALL_LIBDIR=lib \
      -DCMAKE_INSTALL_RPATH_USE_LINK_PATH=ON \
      -DCMAKE_PREFIX_PATH="$CMAKE_PREFIX_PATH"
  '';

  buildPhase = ''
    cmake --build build/datamungeocaml -j $NIX_BUILD_CORES
  '';

  installPhase = ''
    cmake --install build/datamungeocaml --prefix "$out"
  '';

  meta = with pkgs.lib; {
    description = "OCaml bindings for the datamunge library (generated by Rosetta).";
    license = licenses.unlicense;
    platforms = platforms.unix;
  };
}
