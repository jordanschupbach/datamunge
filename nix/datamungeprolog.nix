{
  pkgs ? import <nixpkgs> { },
}:

# The SWI-Prolog binding (generated by Rosetta from src/datamungeprolog/rosetta): the foreign library
# $out/lib/libdatamunge_prolog.so and the module $out/prolog/datamunge.pl, which finds it through ../lib.
# Load it with swipl -p library=$out/prolog and :- use_module(library(datamunge)).
let
  datamunge = import ./datamunge.nix { inherit pkgs; };
in
pkgs.stdenv.mkDerivation {
  pname = "datamungeprolog";
  version = "0.0.1";

  src = import ./source.nix { lib = pkgs.lib; };

  nativeBuildInputs = [
    pkgs.cmake
    pkgs.pkg-config
  ];

  buildInputs = [
    datamunge
    pkgs.arrow-cpp
  ];

  configurePhase = ''
    export CMAKE_PREFIX_PATH="${datamunge}:${pkgs.arrow-cpp}''${CMAKE_PREFIX_PATH:+:$CMAKE_PREFIX_PATH}"
    cmake -S src/datamungeprolog -B build/datamungeprolog \
      -DCMAKE_BUILD_TYPE=Release \
      -DCMAKE_INSTALL_LIBDIR=lib \
      -DCMAKE_INSTALL_RPATH_USE_LINK_PATH=ON \
      -DDATAMUNGE_SWIPL=${pkgs.swi-prolog}/bin/swipl \
      -DCMAKE_PREFIX_PATH="$CMAKE_PREFIX_PATH"
  '';

  buildPhase = ''
    runHook preBuild
    cmake --build build/datamungeprolog -j $NIX_BUILD_CORES
    runHook postBuild
  '';

  installPhase = ''
    runHook preInstall
    cmake --install build/datamungeprolog --prefix "$out"
    runHook postInstall
  '';

  meta = with pkgs.lib; {
    description = "SWI-Prolog bindings for the datamunge library (generated by Rosetta).";
    license = licenses.unlicense;
    platforms = platforms.unix;
  };
}
