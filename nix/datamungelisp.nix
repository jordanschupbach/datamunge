{
  pkgs ? import <nixpkgs> { },
}:

# The `datamunge` Common Lisp system (generated by Rosetta): datamunge.asd, datamunge.lisp and
# the native datamunge.so they load, in $out/share/common-lisp/source/datamunge. Put
# $out/share/common-lisp/source// on CL_SOURCE_REGISTRY, with cffi and trivial-garbage.
let
  datamunge = import ./datamunge.nix { inherit pkgs; };
in
pkgs.stdenv.mkDerivation {
  pname = "datamungelisp";
  version = "0.0.1";

  src = import ./source.nix { lib = pkgs.lib; };

  nativeBuildInputs = [
    pkgs.cmake
    pkgs.pkg-config
  ];

  buildInputs = [
    datamunge
    pkgs.arrow-cpp
  ];

  configurePhase = ''
    export CMAKE_PREFIX_PATH="${datamunge}:${pkgs.arrow-cpp}''${CMAKE_PREFIX_PATH:+:$CMAKE_PREFIX_PATH}"
    cmake -S src/datamungelisp -B build/datamungelisp \
      -DCMAKE_BUILD_TYPE=Release \
      -DCMAKE_INSTALL_RPATH_USE_LINK_PATH=ON \
      -DCMAKE_PREFIX_PATH="$CMAKE_PREFIX_PATH"
  '';

  buildPhase = ''
    cmake --build build/datamungelisp -j $NIX_BUILD_CORES
  '';

  installPhase = ''
    cmake --install build/datamungelisp --prefix "$out"
  '';

  meta = with pkgs.lib; {
    description = "Common Lisp bindings for the datamunge library (generated by Rosetta).";
    license = licenses.unlicense;
    platforms = platforms.unix;
  };
}
