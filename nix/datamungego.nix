{
  pkgs ? import <nixpkgs> { },
}:

# The Go binding (generated by Rosetta from src/datamungego/rosetta): module datamunge, cgo over the
# shared C ABI library libdatamunge_go.
#
# - $out/lib/libdatamunge_go.so: the library the module's cgo preamble links (-ldatamunge_go;
#   .dylib on macOS).
# - $out/share/go/datamunge: the committed module src/datamungego/go/datamunge (go.mod,
#   datamunge.go, data/, internal/rosetta), documented with godoc comments.
# - $out/share/go-cache: a Go build cache holding the compiled packages datamunge and
#   datamunge/data (compiling the 54k-line datamunge.go takes a while), which nix/report/go.nix
#   copies into a writable GOCACHE. Cache keys depend on go, the C compiler, the module's store
#   path and CGO_LDFLAGS, so a consumer must use the same pkgs.go and stdenv and passthru.cgoLdflags.
#
# Use with `require datamunge v0.0.0` and `replace datamunge => $out/share/go/datamunge` in go.mod
# (or a go.work that uses it) and CGO_LDFLAGS="-L$out/lib -Wl,-rpath,$out/lib".
let
  datamunge = import ./datamunge.nix { inherit pkgs; };
  self = pkgs.stdenv.mkDerivation {
    pname = "datamungego";
    version = "0.0.1";

    src = import ./source.nix { lib = pkgs.lib; };

    nativeBuildInputs = [
      pkgs.cmake
      pkgs.pkg-config
      pkgs.go
    ];

    buildInputs = [
      datamunge
      pkgs.arrow-cpp
    ];

    configurePhase = ''
      export CMAKE_PREFIX_PATH="${datamunge}:${pkgs.arrow-cpp}''${CMAKE_PREFIX_PATH:+:$CMAKE_PREFIX_PATH}"
      cmake -S src/datamungego -B build/datamungego \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_LIBDIR=lib \
        -DCMAKE_INSTALL_RPATH_USE_LINK_PATH=ON \
        -DCMAKE_PREFIX_PATH="$CMAKE_PREFIX_PATH"
    '';

    buildPhase = ''
      cmake --build build/datamungego -j $NIX_BUILD_CORES
    '';

    installPhase = ''
      cmake --install build/datamungego --prefix "$out"

      # Warm a build cache with the packages, built from the installed module as consumers see it.
      export HOME="$TMPDIR" GOTOOLCHAIN=local GOPROXY=off GOFLAGS= GOCACHE="$out/share/go-cache"
      export CGO_ENABLED=1 CGO_LDFLAGS="-L$out/lib -Wl,-rpath,$out/lib"
      mkdir -p warm
      printf 'go 1.24\n\nuse %s\n' "$out/share/go/datamunge" > warm/go.work
      printf 'package main\n\nimport (\n\t"datamunge"\n\t"datamunge/data"\n\t"fmt"\n)\n\nfunc main() {\n\tfmt.Println(datamunge.Must(datamunge.Seql(0, 1, 3)), datamunge.Must(data.Iris()))\n}\n' > warm/main.go
      (cd warm && GOWORK="$PWD/go.work" go build -o warm main.go && ./warm > /dev/null)
      rm -f "$GOCACHE/testexpire.txt"
    '';

    passthru = {
      module = "${self}/share/go/datamunge";
      libdir = "${self}/lib";
      cgoLdflags = "-L${self}/lib -Wl,-rpath,${self}/lib";
    };

    meta = with pkgs.lib; {
      description = "Go bindings for the datamunge library (generated by Rosetta).";
      license = licenses.unlicense;
      platforms = platforms.unix;
    };
  };
in
self
