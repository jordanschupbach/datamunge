{
  pkgs ? import <nixpkgs> { },
}:

# The Tcl binding (generated by Rosetta from src/datamungetcl/rosetta): package datamunge, a
# stubs-enabled Tcl extension with TclOO classes in namespace ::datamunge.
#
# - $out/lib/datamunge/pkgIndex.tcl: `package require datamunge` finds it through auto_path.
# - $out/lib/datamunge/datamunge.tcl: loads the extension beside it and holds the documentation
#   (commented proc/oo::class stubs under `if {0}`, read by mep's Tcl LSP).
# - $out/lib/datamunge/datamunge.so: the extension (.dylib on macOS); it links only Tcl's stub
#   library, so it loads into Tcl 8.6 and 9.
#
# Use with TCLLIBPATH=$out/lib or `lappend auto_path $out/lib`.
let
  datamunge = import ./datamunge.nix { inherit pkgs; };
in
pkgs.stdenv.mkDerivation {
  pname = "datamungetcl";
  version = "0.0.1";

  src = import ./source.nix { lib = pkgs.lib; };

  nativeBuildInputs = [
    pkgs.cmake
    pkgs.pkg-config
    pkgs.tcl
  ];

  buildInputs = [
    datamunge
    pkgs.arrow-cpp
    pkgs.tcl
  ];

  configurePhase = ''
    export CMAKE_PREFIX_PATH="${datamunge}:${pkgs.arrow-cpp}''${CMAKE_PREFIX_PATH:+:$CMAKE_PREFIX_PATH}"
    cmake -S src/datamungetcl -B build/datamungetcl \
      -DCMAKE_BUILD_TYPE=Release \
      -DCMAKE_INSTALL_LIBDIR=lib \
      -DCMAKE_INSTALL_RPATH_USE_LINK_PATH=ON \
      -DDATAMUNGE_TCLSH_EXECUTABLE=${pkgs.tcl}/bin/tclsh \
      -DCMAKE_PREFIX_PATH="$CMAKE_PREFIX_PATH"
  '';

  buildPhase = ''
    cmake --build build/datamungetcl -j $NIX_BUILD_CORES
  '';

  installPhase = ''
    cmake --install build/datamungetcl --prefix "$out"
  '';

  meta = with pkgs.lib; {
    description = "Tcl bindings for the datamunge library (generated by Rosetta).";
    license = licenses.unlicense;
    platforms = platforms.unix;
  };
}
