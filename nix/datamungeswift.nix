{
  pkgs ? import <nixpkgs> { },
  swift ? pkgs.swift,
}:

# The Swift binding (generated by Rosetta from src/datamungeswift/rosetta): $out/lib/libdatamunge_swift.so
# (the C ABI library), the Swift module $out/lib/libDatamunge.so with
# $out/lib/swift/Datamunge.swiftmodule, and the C module $out/share/swift/CDatamunge. Compile programs
# with -I $out/lib/swift -I $out/share/swift/CDatamunge -L $out/lib -lDatamunge (the justfile's SWIFTC).
let
  datamunge = import ./datamunge.nix { inherit pkgs; };
in
pkgs.stdenv.mkDerivation {
  pname = "datamungeswift";
  version = "0.0.1";

  src = import ./source.nix { lib = pkgs.lib; };

  nativeBuildInputs = [
    pkgs.cmake
    pkgs.pkg-config
  ];

  buildInputs = [
    datamunge
    pkgs.arrow-cpp
  ];

  configurePhase = ''
    export CMAKE_PREFIX_PATH="${datamunge}:${pkgs.arrow-cpp}''${CMAKE_PREFIX_PATH:+:$CMAKE_PREFIX_PATH}"
    cmake -S src/datamungeswift -B build/datamungeswift \
      -DCMAKE_BUILD_TYPE=Release \
      -DCMAKE_INSTALL_LIBDIR=lib \
      -DCMAKE_INSTALL_RPATH_USE_LINK_PATH=ON \
      -DDATAMUNGE_SWIFTC=${swift}/bin/swiftc \
      -DCMAKE_PREFIX_PATH="$CMAKE_PREFIX_PATH"
  '';

  buildPhase = ''
    runHook preBuild
    cmake --build build/datamungeswift -j $NIX_BUILD_CORES
    runHook postBuild
  '';

  installPhase = ''
    runHook preInstall
    cmake --install build/datamungeswift --prefix "$out"
    runHook postInstall
  '';

  meta = with pkgs.lib; {
    description = "Swift bindings for the datamunge library (generated by Rosetta).";
    license = licenses.unlicense;
    platforms = platforms.unix;
  };
}
