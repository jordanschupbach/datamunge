{
  pkgs ? import <nixpkgs> { },
}:

# The Fortran binding (generated by Rosetta from src/datamungefortran/rosetta): the Fortran 2018
# modules datamunge, datamunge_rosetta and datamunge_data over a C ABI native library.
#
# - $out/lib: libdatamunge_fortran.so (the native library) and libdatamunge_fortran_mod.a (the
#   compiled modules).
# - $out/include/datamunge/fortran: the .mod files and datamunge.f90 (FORD `!>` documentation).
#
# Compile with `gfortran -I$out/include/datamunge/fortran prog.f90 -L$out/lib
# -ldatamunge_fortran_mod -ldatamunge_fortran -Wl,-rpath,$out/lib` (the .mod files are specific to
# this gfortran's version).
let
  datamunge = import ./datamunge.nix { inherit pkgs; };
in
pkgs.stdenv.mkDerivation {
  pname = "datamungefortran";
  version = "0.0.1";

  src = import ./source.nix { lib = pkgs.lib; };

  nativeBuildInputs = [
    pkgs.cmake
    pkgs.pkg-config
    pkgs.gfortran
  ];

  buildInputs = [
    datamunge
    pkgs.arrow-cpp
  ];

  configurePhase = ''
    export CMAKE_PREFIX_PATH="${datamunge}:${pkgs.arrow-cpp}''${CMAKE_PREFIX_PATH:+:$CMAKE_PREFIX_PATH}"
    cmake -S src/datamungefortran -B build/datamungefortran \
      -DCMAKE_BUILD_TYPE=Release \
      -DCMAKE_INSTALL_LIBDIR=lib \
      -DCMAKE_INSTALL_RPATH_USE_LINK_PATH=ON \
      -DCMAKE_PREFIX_PATH="$CMAKE_PREFIX_PATH"
  '';

  buildPhase = ''
    cmake --build build/datamungefortran -j $NIX_BUILD_CORES
  '';

  installPhase = ''
    cmake --install build/datamungefortran --prefix "$out"
  '';

  meta = with pkgs.lib; {
    description = "Fortran bindings for the datamunge library (generated by Rosetta).";
    license = licenses.unlicense;
    platforms = platforms.unix;
  };
}
