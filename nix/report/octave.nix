{ pkgs, datamungeoctave, ... }:
let
  # The nix-built binding (generated by Rosetta): __datamunge__.oct and the package +datamunge. A site
  # init file adds it to the load path after silencing Octave:shadowed-function, which Octave raises
  # for the package functions datamunge.resize and datamunge.Data.load (they shadow nothing).
  siteInit = pkgs.writeText "datamunge-octaverc" ''
    warning ("off", "Octave:shadowed-function");
    addpath ("${datamungeoctave}/share/octave/site/m");
  '';
in
pkgs.mkShell {
  packages = [ pkgs.octave ];
  shellHook = ''export OCTAVE_SITE_INITFILE="${siteInit}"'';
}
