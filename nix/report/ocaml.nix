{
  pkgs,
  datamungeocaml,
  ...
}:
pkgs.mkShell {
  packages = [
    pkgs.ocamlPackages.ocaml
    pkgs.ocamlPackages.findlib
  ];
  # The findlib package datamunge (generated by Rosetta): `ocamlfind ocamlopt -package datamunge
  # -linkpkg`, or `#use "topfind";; #require "datamunge";;` in the toplevel, which loads
  # dlldatamunge_stubs.so from the package directory.
  shellHook = ''
    export OCAMLPATH="${datamungeocaml}/lib"
    export OCAMLTOP_INCLUDE_PATH="$(dirname "$(ocamlfind query findlib)")"
    export CAML_LD_LIBRARY_PATH="${datamungeocaml}/lib/datamunge''${CAML_LD_LIBRARY_PATH:+:$CAML_LD_LIBRARY_PATH}"
  '';
}
