{ pkgs, datamungeapl, ... }:
pkgs.mkShell {
  packages = [ pkgs.gnuapl ];
  # The GNU APL binding (generated by Rosetta). mep has no APL babel runner, so APL blocks say how to
  # run: cmd="apl --script --noSV --silent -f $DATAMUNGE_APL_SCRIPT -f {file}".
  shellHook = ''
    export DATAMUNGE_APL_LIBRARY="${datamungeapl.library}"
    export DATAMUNGE_APL_SCRIPT="${datamungeapl.script}"
  '';
}
