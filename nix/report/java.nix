{ pkgs, datamungejava, ... }:
pkgs.mkShell {
  packages = [ pkgs.jdk ];
  # The datamunge package (generated by Rosetta): javac and java read CLASSPATH (share/java/datamunge.jar),
  # and the classes load the JNI library named by DATAMUNGE_JAVA_LIBRARY (lib/libdatamunge_java.so).
  shellHook = ''
    export CLASSPATH="${datamungejava.jar}"
    export DATAMUNGE_JAVA_LIBRARY="${datamungejava.library}"
  '';
}
