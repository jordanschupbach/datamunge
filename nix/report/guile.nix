{ pkgs, datamungeguile, ... }:
pkgs.mkShell {
  packages = [ pkgs.guile ];
  # (use-modules (datamunge)) (generated by Rosetta): datamunge.scm, datamunge/ and
  # libdatamunge_guile.so in one site directory.
  shellHook = ''export GUILE_LOAD_PATH="${datamungeguile}/share/guile/site/${pkgs.guile.effectiveVersion or "3.0"}"'';
}
