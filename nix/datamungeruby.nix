{
  pkgs ? import <nixpkgs> { },
}:

# The Ruby binding (generated by Rosetta from src/datamungeruby/rosetta): module Datamunge, an MRI
# native extension and the Ruby file that loads it.
#
# - $out/lib/datamunge.rb: `require 'datamunge'`; it require_relative's the extension and holds the
#   YARD documentation (stubs under `if nil`, read by yard and editors).
# - $out/lib/datamunge/datamunge.so: the extension (.bundle on macOS).
#
# Use with `ruby -I $out/lib` or RUBYLIB=$out/lib (the extension is specific to this Ruby's ABI).
let
  datamunge = import ./datamunge.nix { inherit pkgs; };
in
pkgs.stdenv.mkDerivation {
  pname = "datamungeruby";
  version = "0.0.1";

  src = import ./source.nix { lib = pkgs.lib; };

  nativeBuildInputs = [
    pkgs.cmake
    pkgs.pkg-config
    pkgs.ruby
  ];

  buildInputs = [
    datamunge
    pkgs.arrow-cpp
    pkgs.ruby
  ];

  configurePhase = ''
    export CMAKE_PREFIX_PATH="${datamunge}:${pkgs.arrow-cpp}''${CMAKE_PREFIX_PATH:+:$CMAKE_PREFIX_PATH}"
    cmake -S src/datamungeruby -B build/datamungeruby \
      -DCMAKE_BUILD_TYPE=Release \
      -DCMAKE_INSTALL_LIBDIR=lib \
      -DCMAKE_INSTALL_RPATH_USE_LINK_PATH=ON \
      -DRuby_EXECUTABLE=${pkgs.ruby}/bin/ruby \
      -DCMAKE_PREFIX_PATH="$CMAKE_PREFIX_PATH"
  '';

  buildPhase = ''
    cmake --build build/datamungeruby -j $NIX_BUILD_CORES
  '';

  installPhase = ''
    cmake --install build/datamungeruby --prefix "$out"
  '';

  meta = with pkgs.lib; {
    description = "Ruby bindings for the datamunge library (generated by Rosetta).";
    license = licenses.unlicense;
    platforms = platforms.unix;
  };
}
