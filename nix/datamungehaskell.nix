{
  pkgs ? import <nixpkgs> { },
}:

# The Haskell binding (generated by Rosetta from src/datamungehaskell/rosetta): $out/lib/libdatamunge_haskell.so
# (the C ABI library) and the GHC package datamunge, registered in $out/lib/haskell/package.db. Compile programs
# with ghc -threaded -package-db $out/lib/haskell/package.db -package datamunge (the justfile's GHC).
let
  datamunge = import ./datamunge.nix { inherit pkgs; };
in
pkgs.stdenv.mkDerivation {
  pname = "datamungehaskell";
  version = "0.0.1";

  src = import ./source.nix { lib = pkgs.lib; };

  nativeBuildInputs = [
    pkgs.cmake
    pkgs.pkg-config
  ];

  buildInputs = [
    datamunge
    pkgs.arrow-cpp
  ];

  configurePhase = ''
    export CMAKE_PREFIX_PATH="${datamunge}:${pkgs.arrow-cpp}''${CMAKE_PREFIX_PATH:+:$CMAKE_PREFIX_PATH}"
    cmake -S src/datamungehaskell -B build/datamungehaskell \
      -DCMAKE_BUILD_TYPE=Release \
      -DCMAKE_INSTALL_LIBDIR=lib \
      -DCMAKE_INSTALL_RPATH_USE_LINK_PATH=ON \
      -DDATAMUNGE_GHC=${pkgs.ghc}/bin/ghc \
      -DCMAKE_PREFIX_PATH="$CMAKE_PREFIX_PATH"
  '';

  buildPhase = ''
    runHook preBuild
    cmake --build build/datamungehaskell -j $NIX_BUILD_CORES
    runHook postBuild
  '';

  installPhase = ''
    runHook preInstall
    cmake --install build/datamungehaskell --prefix "$out"
    runHook postInstall
  '';

  meta = with pkgs.lib; {
    description = "Haskell bindings for the datamunge library (generated by Rosetta).";
    license = licenses.unlicense;
    platforms = platforms.unix;
  };
}
