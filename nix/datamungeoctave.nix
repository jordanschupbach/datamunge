{
  pkgs ? import <nixpkgs> { },
}:

# The Octave binding (generated by Rosetta from src/datamungeoctave/rosetta): the oct-file
# __datamunge__.oct and the package +datamunge, one classdef or function .m file per class, enum,
# function and constant, whose help text carries the C++ documentation.
#
# - $out/share/octave/site/m: __datamunge__.oct and +datamunge/.
#
# Use with `addpath ("$out/share/octave/site/m")` (or OCTAVE_PATH), then `datamunge.DataFrame ()`,
# `datamunge.seql (0, 1, 5)` and `help datamunge.DataFrame.filter`. The oct-file is specific to this
# Octave's API version.
let
  datamunge = import ./datamunge.nix { inherit pkgs; };
in
pkgs.stdenv.mkDerivation {
  pname = "datamungeoctave";
  version = "0.0.1";

  src = import ./source.nix { lib = pkgs.lib; };

  nativeBuildInputs = [
    pkgs.cmake
    pkgs.pkg-config
  ];

  buildInputs = [
    datamunge
    # mkoctfile reports the include and library directories; liboctinterp and liboctave are linked.
    pkgs.octave
    pkgs.arrow-cpp
  ];

  configurePhase = ''
    export CMAKE_PREFIX_PATH="${datamunge}:${pkgs.arrow-cpp}''${CMAKE_PREFIX_PATH:+:$CMAKE_PREFIX_PATH}"
    cmake -S src/datamungeoctave -B build/datamungeoctave \
      -DCMAKE_BUILD_TYPE=Release \
      -DCMAKE_INSTALL_RPATH_USE_LINK_PATH=ON \
      -DCMAKE_PREFIX_PATH="$CMAKE_PREFIX_PATH"
  '';

  buildPhase = ''
    cmake --build build/datamungeoctave -j $NIX_BUILD_CORES
  '';

  installPhase = ''
    cmake --install build/datamungeoctave --prefix "$out"
  '';

  meta = with pkgs.lib; {
    description = "Octave bindings for the datamunge library (generated by Rosetta).";
    license = licenses.unlicense;
    platforms = platforms.unix;
  };
}
