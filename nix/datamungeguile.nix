{
  pkgs ? import <nixpkgs> { },
}:

# The Guile binding (generated by Rosetta from src/datamungeguile/rosetta): the module (datamunge),
# a libguile extension and the Scheme files that load it.
#
# - $out/share/guile/site/<version>/datamunge.scm: the module; it load-extension's
#   libdatamunge_guile.so from its own directory and defines the GOOPS classes and generics, whose
#   docstrings carry the C++ documentation (procedure-documentation, mep's Scheme LSP).
# - $out/share/guile/site/<version>/datamunge/data.scm: the submodule (datamunge data).
# - $out/share/guile/site/<version>/libdatamunge_guile.so: the extension.
# - $out/lib/guile/<version>/site-ccache/datamunge.go and datamunge/data.go: the modules,
#   precompiled by guild at build time (loading the source would take ~40 s to auto-compile).
#
# Use with GUILE_LOAD_PATH=$out/share/guile/site/<version> and
# GUILE_LOAD_COMPILED_PATH=$out/lib/guile/<version>/site-ccache, then (use-modules (datamunge)).
let
  datamunge = import ./datamunge.nix { inherit pkgs; };
in
pkgs.stdenv.mkDerivation {
  pname = "datamungeguile";
  version = "0.0.1";

  src = import ./source.nix { lib = pkgs.lib; };

  nativeBuildInputs = [
    pkgs.cmake
    pkgs.pkg-config
    # guild compiles the modules to .go at build time
    pkgs.guile
  ];

  buildInputs = [
    datamunge
    pkgs.guile
    pkgs.arrow-cpp
  ];

  configurePhase = ''
    export CMAKE_PREFIX_PATH="${datamunge}:${pkgs.arrow-cpp}''${CMAKE_PREFIX_PATH:+:$CMAKE_PREFIX_PATH}"
    cmake -S src/datamungeguile -B build/datamungeguile \
      -DCMAKE_BUILD_TYPE=Release \
      -DCMAKE_INSTALL_RPATH_USE_LINK_PATH=ON \
      -DCMAKE_PREFIX_PATH="$CMAKE_PREFIX_PATH"
  '';

  buildPhase = ''
    cmake --build build/datamungeguile -j $NIX_BUILD_CORES
  '';

  installPhase = ''
    cmake --install build/datamungeguile --prefix "$out"
  '';

  meta = with pkgs.lib; {
    description = "Guile bindings for the datamunge library (generated by Rosetta).";
    license = licenses.unlicense;
    platforms = platforms.unix;
  };
}
