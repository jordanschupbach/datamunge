{
  pkgs ? import <nixpkgs> { },
}:

# The Ada binding (generated by Rosetta from src/datamungeada/rosetta): $out/lib/libdatamunge_ada.so (the C
# ABI library) and the compiled package $out/lib/ada/datamunge (datamunge.ads, .adb, .gpr, .ali, .o).
# Build programs with gnatmake -gnat2022 -aI$out/lib/ada/datamunge -aO$out/lib/ada/datamunge ... -largs -L$out/lib.
let
  datamunge = import ./datamunge.nix { inherit pkgs; };
in
pkgs.stdenv.mkDerivation {
  pname = "datamungeada";
  version = "0.0.1";

  src = import ./source.nix { lib = pkgs.lib; };

  nativeBuildInputs = [
    pkgs.cmake
    pkgs.pkg-config
  ];

  buildInputs = [
    datamunge
    pkgs.arrow-cpp
  ];

  configurePhase = ''
    export CMAKE_PREFIX_PATH="${datamunge}:${pkgs.arrow-cpp}''${CMAKE_PREFIX_PATH:+:$CMAKE_PREFIX_PATH}"
    cmake -S src/datamungeada -B build/datamungeada \
      -DCMAKE_BUILD_TYPE=Release \
      -DCMAKE_INSTALL_LIBDIR=lib \
      -DCMAKE_INSTALL_RPATH_USE_LINK_PATH=ON \
      -DDATAMUNGE_GNATMAKE=${pkgs.gnat}/bin/gnatmake \
      -DCMAKE_PREFIX_PATH="$CMAKE_PREFIX_PATH"
  '';

  buildPhase = ''
    runHook preBuild
    cmake --build build/datamungeada -j $NIX_BUILD_CORES
    runHook postBuild
  '';

  installPhase = ''
    runHook preInstall
    cmake --install build/datamungeada --prefix "$out"
    runHook postInstall
  '';

  meta = with pkgs.lib; {
    description = "Ada bindings for the datamunge library (generated by Rosetta).";
    license = licenses.unlicense;
    platforms = platforms.unix;
  };
}
