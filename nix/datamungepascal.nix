{
  pkgs ? import <nixpkgs> { },
}:

# The Free Pascal binding (generated by Rosetta from src/datamungepascal/rosetta): $out/lib/libdatamunge_pascal.so
# (the C ABI library) and the compiled unit $out/lib/fpc/datamunge (datamunge.ppu, .o and the documented
# .pas). Compile programs with -Fu$out/lib/fpc/datamunge -Fl$out/lib (the justfile's FPC).
let
  datamunge = import ./datamunge.nix { inherit pkgs; };
in
pkgs.stdenv.mkDerivation {
  pname = "datamungepascal";
  version = "0.0.1";

  src = import ./source.nix { lib = pkgs.lib; };

  nativeBuildInputs = [
    pkgs.cmake
    pkgs.pkg-config
  ];

  buildInputs = [
    datamunge
    pkgs.arrow-cpp
  ];

  configurePhase = ''
    export CMAKE_PREFIX_PATH="${datamunge}:${pkgs.arrow-cpp}''${CMAKE_PREFIX_PATH:+:$CMAKE_PREFIX_PATH}"
    cmake -S src/datamungepascal -B build/datamungepascal \
      -DCMAKE_BUILD_TYPE=Release \
      -DCMAKE_INSTALL_LIBDIR=lib \
      -DCMAKE_INSTALL_RPATH_USE_LINK_PATH=ON \
      -DDATAMUNGE_FPC=${pkgs.fpc}/bin/fpc \
      -DCMAKE_PREFIX_PATH="$CMAKE_PREFIX_PATH"
  '';

  buildPhase = ''
    runHook preBuild
    cmake --build build/datamungepascal -j $NIX_BUILD_CORES
    runHook postBuild
  '';

  installPhase = ''
    runHook preInstall
    cmake --install build/datamungepascal --prefix "$out"
    runHook postInstall
  '';

  meta = with pkgs.lib; {
    description = "Free Pascal bindings for the datamunge library (generated by Rosetta).";
    license = licenses.unlicense;
    platforms = platforms.unix;
  };
}
