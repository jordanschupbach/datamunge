{
  pkgs ? import <nixpkgs> { },
  dotnetSdk ? pkgs.dotnetCorePackages.sdk_10_0-bin,
}:

# The C# binding Datamunge (generated by Rosetta from src/datamungecsharp/rosetta):
#
# - $out/share/dotnet/Datamunge: the project (Datamunge.csproj, Datamunge.cs), the native library
#   lib/datamunge_csharp.so and the built bin/Datamunge.{dll,xml}. Reference the project (or
#   `#:project` it) and set DATAMUNGE_CSHARP_LIBRARY to the native library, or `#r` the dll.
# - $out/share/nuget: the same as the NuGet package Datamunge.<version>.nupkg, with the native
#   library under runtimes/<rid>/native/ where the .NET host finds it (see nix/report/csharp.nix).
#
# Neither needs NuGet packages to build.
let
  datamunge = import ./datamunge.nix { inherit pkgs; };
  inherit (pkgs.stdenv.hostPlatform) isDarwin isAarch64;
  rid = (if isDarwin then "osx" else "linux") + (if isAarch64 then "-arm64" else "-x64");
  libName = "datamunge_csharp${pkgs.stdenv.hostPlatform.extensions.sharedLibrary}";
in
pkgs.stdenv.mkDerivation rec {
  pname = "datamungecsharp";
  version = "0.0.1";

  src = import ./source.nix { lib = pkgs.lib; };

  nativeBuildInputs = [
    pkgs.cmake
    pkgs.pkg-config
    dotnetSdk
  ];

  buildInputs = [
    datamunge
    pkgs.arrow-cpp
  ];

  env = {
    DOTNET_CLI_TELEMETRY_OPTOUT = "1";
    DOTNET_NOLOGO = "1";
    DOTNET_SKIP_FIRST_TIME_EXPERIENCE = "1";
    DOTNET_SYSTEM_GLOBALIZATION_INVARIANT = "1";
  };

  configurePhase = ''
    export CMAKE_PREFIX_PATH="${datamunge}:${pkgs.arrow-cpp}''${CMAKE_PREFIX_PATH:+:$CMAKE_PREFIX_PATH}"
    cmake -S src/datamungecsharp -B build/datamungecsharp \
      -DCMAKE_BUILD_TYPE=Release \
      -DCMAKE_INSTALL_RPATH_USE_LINK_PATH=ON \
      -DCMAKE_PREFIX_PATH="$CMAKE_PREFIX_PATH"
  '';

  buildPhase = ''
    runHook preBuild
    cmake --build build/datamungecsharp -j $NIX_BUILD_CORES

    # The NuGet package: the generated source, with the native library as a runtime asset.
    gen="$TMPDIR/Datamunge"
    mkdir -p "$gen/native"
    cp src/datamungecsharp/Datamunge.cs "$gen/"
    cp build/datamungecsharp/${libName} "$gen/native/"
    cat > "$gen/Datamunge.csproj" <<'EOF'
    <Project Sdk="Microsoft.NET.Sdk">
      <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <AssemblyName>Datamunge</AssemblyName>
        <PackageId>Datamunge</PackageId>
        <Version>${version}</Version>
        <Description>C# bindings for the datamunge library (generated by Rosetta).</Description>
        <Nullable>enable</Nullable>
        <ImplicitUsings>disable</ImplicitUsings>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
      </PropertyGroup>
      <ItemGroup>
        <None Include="native/${libName}" Pack="true" PackagePath="runtimes/${rid}/native/" />
      </ItemGroup>
    </Project>
    EOF
    export HOME="$TMPDIR" NUGET_PACKAGES="$TMPDIR/nuget-packages"
    mkdir -p "$TMPDIR/no-sources"
    dotnet pack "$gen/Datamunge.csproj" -c Release -o "$gen/nupkg" -p:RestoreSources="$TMPDIR/no-sources"
    runHook postBuild
  '';

  installPhase = ''
    runHook preInstall
    cmake --install build/datamungecsharp --prefix "$out"
    install -Dm644 -t "$out/share/dotnet/Datamunge/bin" "$gen"/bin/Release/net10.0/Datamunge.{dll,xml}
    install -Dm644 -t "$out/share/nuget" "$gen"/nupkg/*.nupkg
    runHook postInstall
  '';

  meta = with pkgs.lib; {
    description = "C# bindings for the datamunge library (generated by Rosetta).";
    license = licenses.unlicense;
    platforms = platforms.unix;
  };
}
