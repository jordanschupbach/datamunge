{
  pkgs ? import <nixpkgs> { },
}:

# The Julia package Datamunge (generated by Rosetta): Project.toml, src/Datamunge.jl and
# lib/datamunge.so, in $out/share/julia/Datamunge. Put $out/share/julia on JULIA_LOAD_PATH
# for `using Datamunge` (it needs only Libdl, from the standard library).
let
  datamunge = import ./datamunge.nix { inherit pkgs; };
in
pkgs.stdenv.mkDerivation {
  pname = "datamungejulia";
  version = "0.0.1";

  src = import ./source.nix { lib = pkgs.lib; };

  nativeBuildInputs = [
    pkgs.cmake
    pkgs.pkg-config
  ];

  buildInputs = [
    datamunge
    pkgs.arrow-cpp
  ];

  configurePhase = ''
    export CMAKE_PREFIX_PATH="${datamunge}:${pkgs.arrow-cpp}''${CMAKE_PREFIX_PATH:+:$CMAKE_PREFIX_PATH}"
    cmake -S src/datamungejulia -B build/datamungejulia \
      -DCMAKE_BUILD_TYPE=Release \
      -DCMAKE_INSTALL_RPATH_USE_LINK_PATH=ON \
      -DCMAKE_PREFIX_PATH="$CMAKE_PREFIX_PATH"
  '';

  buildPhase = ''
    cmake --build build/datamungejulia -j $NIX_BUILD_CORES
  '';

  installPhase = ''
    cmake --install build/datamungejulia --prefix "$out"
  '';

  meta = with pkgs.lib; {
    description = "Julia bindings for the datamunge library (generated by Rosetta).";
    license = licenses.unlicense;
    platforms = platforms.unix;
  };
}
