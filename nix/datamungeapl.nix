{
  pkgs ? import <nixpkgs> { },
}:

# The GNU APL binding (generated by Rosetta from src/datamungeapl/rosetta): the native function
# library libdatamunge_gnu_apl.so and the GNU APL script datamunge.apl, which ⎕FX's it and defines
# the dm∆ functions (dm∆seql, dm∆DataFrame∆new, dm∆DataFrame∆nrows, ...), documented with ⍝ comments.
#
# - $out/lib/libdatamunge_gnu_apl.so: compiled against GNU APL's configured headers
#   (passthru.gnuAplHeaders, nixpkgs' GNU APL source configured as nixpkgs builds it).
# - $out/share/apl/datamunge.apl: the committed script src/datamungeapl/apl/datamunge.apl.
#
# Use with `DATAMUNGE_APL_LIBRARY=$out/lib/libdatamunge_gnu_apl.so apl --script -f
# $out/share/apl/datamunge.apl -f program.apl` (passthru.library, passthru.script).
let
  datamunge = import ./datamunge.nix { inherit pkgs; };
  # GNU APL native functions compile against the interpreter's own headers: nixpkgs' GNU APL
  # source, configured as nixpkgs builds it (as Rosetta's flake does for ROSETTA_GNU_APL_SOURCE_DIR).
  gnuAplHeaders = pkgs.runCommandCC "gnu-apl-${pkgs.gnuapl.version}-headers" {
    inherit (pkgs.gnuapl) buildInputs;
  } ''
    tar xzf ${pkgs.gnuapl.src}
    cd apl-${pkgs.gnuapl.version}
    ./configure > /dev/null
    mkdir -p $out/src
    cp config.h $out/
    cp src/*.hh src/*.icc src/*.def $out/src/
  '';
  self = pkgs.stdenv.mkDerivation {
    pname = "datamungeapl";
    version = "0.0.1";

    src = import ./source.nix { lib = pkgs.lib; };

    nativeBuildInputs = [
      pkgs.cmake
      pkgs.pkg-config
    ];

    buildInputs = [
      datamunge
      pkgs.arrow-cpp
    ];

    configurePhase = ''
      export CMAKE_PREFIX_PATH="${datamunge}:${pkgs.arrow-cpp}''${CMAKE_PREFIX_PATH:+:$CMAKE_PREFIX_PATH}"
      cmake -S src/datamungeapl -B build/datamungeapl \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_LIBDIR=lib \
        -DCMAKE_INSTALL_RPATH_USE_LINK_PATH=ON \
        -DROSETTA_GNU_APL_SOURCE_DIR=${gnuAplHeaders} \
        -DCMAKE_PREFIX_PATH="$CMAKE_PREFIX_PATH"
    '';

    buildPhase = ''
      cmake --build build/datamungeapl -j $NIX_BUILD_CORES
    '';

    installPhase = ''
      cmake --install build/datamungeapl --prefix "$out"
    '';

    passthru = {
      inherit gnuAplHeaders;
      library = "${self}/lib/libdatamunge_gnu_apl.so";
      script = "${self}/share/apl/datamunge.apl";
    };

    meta = with pkgs.lib; {
      description = "GNU APL bindings for the datamunge library (generated by Rosetta).";
      license = licenses.unlicense;
      platforms = platforms.linux;
    };
  };
in
self
