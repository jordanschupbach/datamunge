{
  pkgs ? import <nixpkgs> { },
  jdk ? pkgs.jdk,
}:

# The Java binding (generated by Rosetta from src/datamungejava/rosetta): package datamunge, JNI.
#
# - $out/share/java/datamunge.jar: the classes (javac --release 17) of the committed sources
#   src/datamungejava/java (datamunge.*, datamunge.data.Data).
# - $out/lib/libdatamunge_java.so: the JNI library (.dylib on macOS). The classes load it from
#   -Ddatamunge.library=<file>, else $DATAMUNGE_JAVA_LIBRARY, else System.loadLibrary("datamunge_java")
#   (java.library.path).
#
# Use with `java -cp $out/share/java/datamunge.jar` and
# DATAMUNGE_JAVA_LIBRARY=$out/lib/libdatamunge_java.so (passthru.jar and passthru.library).
let
  datamunge = import ./datamunge.nix { inherit pkgs; };
  self = pkgs.stdenv.mkDerivation {
    pname = "datamungejava";
    version = "0.0.1";

    src = import ./source.nix { lib = pkgs.lib; };

    nativeBuildInputs = [
      pkgs.cmake
      pkgs.pkg-config
      jdk
    ];

    buildInputs = [
      datamunge
      pkgs.arrow-cpp
    ];

    configurePhase = ''
      export CMAKE_PREFIX_PATH="${datamunge}:${pkgs.arrow-cpp}''${CMAKE_PREFIX_PATH:+:$CMAKE_PREFIX_PATH}"
      cmake -S src/datamungejava -B build/datamungejava \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_LIBDIR=lib \
        -DCMAKE_INSTALL_RPATH_USE_LINK_PATH=ON \
        -DJava_JAVAC_EXECUTABLE=${jdk}/bin/javac \
        -DCMAKE_PREFIX_PATH="$CMAKE_PREFIX_PATH"
    '';

    buildPhase = ''
      cmake --build build/datamungejava -j $NIX_BUILD_CORES
    '';

    installPhase = ''
      cmake --install build/datamungejava --prefix "$out"
    '';

    passthru = {
      jar = "${self}/share/java/datamunge.jar";
      library = "${self}/lib/libdatamunge_java${pkgs.stdenv.hostPlatform.extensions.sharedLibrary}";
    };

    meta = with pkgs.lib; {
      description = "Java bindings for the datamunge library (generated by Rosetta).";
      license = licenses.unlicense;
      platforms = platforms.unix;
    };
  };
in
self
