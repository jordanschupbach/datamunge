# shellcheck shell=bash
if ! has nix_direnv_version || ! nix_direnv_version 3.1.0; then
  source_url 'https://raw.githubusercontent.com/nix-community/nix-direnv/3.1.0/direnvrc' 'sha256-yMJ2OVMzrFaDPn7q8nCBZFRYpL/f0RcHzhmw/i6btJM='
fi

# Per-checkout overrides (gitignored). Lets you pick a lighter dev shell without editing this file,
# e.g. `echo 'DATAMUNGE_DEVSHELL=cpp' > .envrc.local` to load only the core library + C++ tooling
# instead of every language binding. Any `devShells.<name>` in flake.nix works.
watch_file .envrc.local
source_env_if_exists .envrc.local

watch_file flake.nix
watch_file flake.lock
watch_file nix/*.nix

# `.` (git+file) rather than `path:.`: a path flake copies the whole working tree, including the
# multi-GB build/ dir, into the store on every re-evaluation. The git flake only sees tracked (or
# staged) files, so `git add` new source files before reloading.
#
# To build against a local checkout of the swig fork instead of the github:jordanschupbach/swig
# revision pinned in flake.lock, put `export DATAMUNGE_SWIG_SRC=$HOME/projects/swig` in .envrc.local
# (exported, so the justfile's own `nix develop` calls pick it up too). Edits to the checkout's
# sources need a `direnv reload`; only its flake.nix is watched.
swig_override=()
if [[ -n "${DATAMUNGE_SWIG_SRC:-}" ]]; then
  watch_file "${DATAMUNGE_SWIG_SRC}/flake.nix"
  swig_override=(--override-input swig "git+file://${DATAMUNGE_SWIG_SRC}")
fi
use flake ".#${DATAMUNGE_DEVSHELL:-default}" "${swig_override[@]}"
