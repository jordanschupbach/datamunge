#version 450
layout(local_size_x=64) in;
layout(set=0,binding=0,std430) readonly buffer X {float x[];};
layout(set=0,binding=1,std430) buffer Y {float y[];};
layout(push_constant) uniform Params {float a;uint n;} params;
void main(){uint i=gl_GlobalInvocationID.x;if(i<params.n)y[i]=params.a*x[i]+y[i];}
