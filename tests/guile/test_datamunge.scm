;;; Smoke tests of the datamunge Guile binding generated by Rosetta (just test-guile): run with the
;;; directory holding datamunge.scm, datamunge/ and libdatamunge_guile.so on GUILE_LOAD_PATH. The
;;; optional argument is the committed src/datamungeguile/scheme/datamunge.scm, whose docstrings are
;;; compared with procedure-documentation (mep's Scheme LSP reads that file).
(use-modules (oop goops)
             (datamunge)
             ((datamunge data) #:select (iris)))

(define checks 0)
(define (check ok what)
  (set! checks (+ checks 1))
  (unless ok
    (format (current-error-port) "check failed: ~a~%" what)
    (exit 1)))

;; The key and arguments of the exception thunk raises, or #f when it returns normally.
(define (raised thunk)
  (catch #t
    (lambda () (thunk) #f)
    (lambda (key . args) (cons key args))))

;; Smoke test: call into the extension (hello prints through C++ std::cout).
(hello)
(check (procedure? hello) "the extension is loaded")

;; std::vector<double> and std::pair<double, double> round trips.
(define v (make-dvector 1.0 2.0 3.0))
(check (equal? v '(1.0 2.0 3.0)) "std::vector<double> is a list")
(check (and (= (sum-dvector v) 6.0) (= (sum-dvector #(0.5 1.5)) 2.0)) "sum-dvector takes lists and vectors")
(define p (make-dpair 1.25 2.75))
(check (and (pair? p) (= (car p) 1.25) (= (cdr p) 2.75)) "std::pair is a pair")
(check (= (sum-dpair p) 4.0) "sum-dpair")

;; The C++ Callback class, and a GOOPS subclass overriding its virtual call() (a director).
(define cb (make <callback>))
(check (= (call-with-callback 3.0 cb) 3.0) "native Callback")
(check (equal? (map-dvector-with-callback '(1.0 2.0 3.0) cb) '(1.0 2.0 3.0)) "native map")
(define-class <doubler> (<callback>))
(define-method (call (self <doubler>) x) (* 2 x))
(define twice (make <doubler>))
(check (and (is-a? twice <callback>) (= (call-with-callback 3.0 twice) 6.0)) "the Scheme override runs")
(check (= (sum-dvector (map-dvector-with-callback '(1.0 2.0 3.0) twice)) 12.0) "override from C++ loops")

;; An error raised by an override reaches the caller unchanged.
(define-class <failing> (<callback>))
(define-method (call (self <failing>) x) (throw 'failing-call "from Scheme"))
(let ((caught (raised (lambda () (call-with-callback 1.0 (make <failing>))))))
  (check (and caught (eq? (car caught) 'failing-call) (equal? (cdr caught) '("from Scheme")))
         "the Scheme exception propagates"))

;; C++ exceptions are thrown to datamunge-<kind> keys.
(let ((caught (raised (lambda () (runif 1.0 0.0 3)))))
  (check (and caught (eq? (car caught) 'datamunge-invalid-argument))
         "C++ exceptions throw datamunge-invalid-argument"))

;; Classes and generics.
(define frame (make <data-frame>))
(add-numeric-column frame "x" '(1.0 2.0 3.0))
(check (and (= (nrows frame) 3) (is-a? frame <native-object>)) "DataFrame")
(check (equal? (columns frame) '("x")) "std::vector<std::string> is a list of strings")
(define flowers (iris))
(check (and (= (nrows flowers) 150) (member "Species" (columns flowers)))
       "the policy module Data is the submodule (datamunge data)")
(close! frame)
(check (closed? frame) "close! frees an object")

;; Docstrings carry the C++ documentation, also in the committed module file.
(define doc (procedure-documentation seql))
(check (and (string? doc) (string-contains doc "evenly spaced") (string-contains doc "C++: std::vector<double>"))
       "procedure-documentation")
(let ((args (command-line)))
  (when (> (length args) 1)
    (let ((committed
           (call-with-input-file (cadr args)
             (lambda (port)
               (let loop ()
                 (let ((form (read port)))
                   (cond ((eof-object? form) #f)
                         ((and (pair? form) (eq? (car form) 'define) (pair? (cadr form))
                               (eq? (caadr form) 'seql) (string? (caddr form)))
                          (caddr form))
                         (else (loop)))))))))
      (check (equal? committed doc) "the committed module file has the same docstring"))))

(format #t "test_datamunge.scm: all ~a checks passed~%" checks)
