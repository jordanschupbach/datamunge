> Binding examples

These blocks replicate the per-language examples under `examples/`.

>> C/C\+\+ (`examples/cpp/source/datamunge_ex.cpp`)

```{cpp, results="output", exports="both", flags="$(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <datamunge/datamunge.hpp>

int main(void) {
  datamunge::hello();
  return 0;
}
```
// result_begin:
// Hello datamunge
// result_end

>> C# (`examples/csharp/stl_ex.cs`)

```{csharp, results="output", exports="both"}
using System;
using System.Diagnostics;
using System.Collections.Generic;

// NOTE: if using repl, uncomment the following line to load the datamungedotnet.dll
// and then recomment it back when compiling as a standalone program
// #r "src/datamungedotnet/bin/Debug/net10.0/datamungedotnet.dll"

class stl_ex {
  static void Main() {
    Console.WriteLine("Hello, World!");

    var v = new DVector();
    for(uint i=0; i<10; i++) {
      v.Add(((double)i)*1.1);
    }
    for(uint i=0; i<v.Count; i++) {
      Console.WriteLine(v[(int)i]);
    }

    var v2 = new IVector();
    for(uint i=0; i<10; i++) {
      v2.Add((int)(i*2));
    }
    for(uint i=0; i<v2.Count; i++) {
      Console.WriteLine(v2[(int)i]);
    }

    var p = new DPair(3.14, 2.71);
    Console.WriteLine(p.first);
    Console.WriteLine(p.second);

    var p2 = new IPair(42, 7);
    Console.WriteLine(p2.first);

  }
}
```

>> D (`examples/d/source/app.d`)

```d
module app;

import std.stdio : writeln;
import datamunge;

class TimesTwo : Callback {
  override double call(double x) {
    return x * 2.0;
  }
}

void main() {
  hello();

  auto vec = make_dvector(1.0, 2.0, 3.0);
  writeln("sum_dvector(1,2,3) = ", sum_dvector(vec));

  auto pair = make_dpair(4.0, 5.0);
  writeln("sum_dpair(4,5) = ", sum_dpair(pair));

  auto cb = new TimesTwo();
  writeln("call_with_callback(3.0) = ", call_with_callback(3.0, cb));
  auto vec2 = map_dvector_with_callback(vec, cb);
  writeln("sum_dvector(map_dvector_with_callback(1,2,3)) = ", sum_dvector(vec2));
}
```

>> Go (`examples/go/datamunge_ex.go`)

```{go, results="output", exports="both"}
package main

import (
	"fmt"
	"datamunge"
)

func main() {
	datamunge.Hello()

	dp := datamunge.NewDPair(1.0, 2.0)
	fmt.Printf("DPair: First=%v, Second=%v\n", dp.GetFirst(), dp.GetSecond())

	s := datamunge.NewSVector(int64(3))
	s.Set(0, "1")
	s.Set(1, "2")
	s.Set(2, "3")
	fmt.Printf("SVector: [0]=%v, [1]=%v, [2]=%v\n", s.Get(0), s.Get(1), s.Get(2))

	// Clean up
	datamunge.DeleteDPair(dp)
	datamunge.DeleteSVector(s)
}
```
// result_begin:
// result_end

