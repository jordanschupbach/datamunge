>> C# (`examples/csharp/stl_ex.cs`)

A .NET 10 file-based app: `#:project` references the generated project, so
`dotnet run examples/csharp/stl_ex.cs` (or `just TARGET=stl_ex run-csharp`) runs it.

```{csharp, eval=false}
// CMD: just TARGET=stl_ex run-csharp
#:project ../../src/datamungecsharp/Datamunge.csproj
// C++ std::vector and std::pair values in C#: vectors are List<T>, pairs are tuples.
using Datamunge;

const int n = 100;
var v = Enumerable.Range(0, n).Select(i => i * 1.5).ToList();
v.ForEach(Console.WriteLine);
var v2 = Enumerable.Range(0, n).Select(i => (int)Math.Floor(i * 1.5)).ToList();
v2.ForEach(Console.WriteLine);

var p = (3, 4);
Console.WriteLine($"p: ({p.Item1}, {p.Item2})");

var p2 = (10, 20);
Console.WriteLine($"p2: ({p2.Item1}, {p2.Item2})");

// A C++ std::pair<double,double> comes back as a tuple.
var p3 = Functions.MakeDpair(1.25, 2.75);
Console.WriteLine($"make_dpair(1.25, 2.75): {p3}, sum_dpair = {Functions.SumDpair(p3)}");
```

>> D (`examples/d/source/app.d`)

```d
module app;

import std.stdio : writeln;
import datamunge;

class TimesTwo : Callback {
  override double call(double x) {
    return x * 2.0;
  }
}

void main() {
  hello();

  auto vec = make_dvector(1.0, 2.0, 3.0);
  writeln("sum_dvector(1,2,3) = ", sum_dvector(vec));

  auto pair = make_dpair(4.0, 5.0);
  writeln("sum_dpair(4,5) = ", sum_dpair(pair));

  auto cb = new TimesTwo();
  writeln("call_with_callback(3.0) = ", call_with_callback(3.0, cb));
  auto vec2 = map_dvector_with_callback(vec, cb);
  writeln("sum_dvector(map_dvector_with_callback(1,2,3)) = ", sum_dvector(vec2));
}
```

>> Go (`examples/go/datamunge_ex.go`)

```{go, results="output", exports="both"}
package main

import (
	"datamunge"
	"fmt"
)

func main() {
	if err := datamunge.Hello(); err != nil {
		panic(err)
	}

	v := datamunge.Must(datamunge.MakeDvector(1.0, 2.0, 3.0))
	fmt.Printf("sum_dvector:\t%v\n", datamunge.Must(datamunge.SumDvector(v)))

	p := datamunge.Must(datamunge.MakeDpair(1.25, 2.75))
	fmt.Printf("sum_dpair:\t%v\n", datamunge.Must(datamunge.SumDpair(p)))

	cb := datamunge.Must(datamunge.NewCallback())
	defer cb.Close()
	fmt.Printf("call_with_callback(3.0):\t%v\n", datamunge.Must(datamunge.CallWithCallback(3.0, cb)))
}
```
