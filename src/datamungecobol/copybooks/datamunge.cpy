      *> ----------------------------------------------------------------
      *>   UMAP

      *>> datamunge::UMAP::UMAP(const DataFrame & data, const
      *>>   std::vector<std::string> & feature_columns, std::size_t
      *>>   n_components = 2, std::size_t n_neighbors = 15, double
      *>>   min_dist = 0.10000000000000001, std::size_t max_iterations =
      *>>   500, double learning_rate = 1.0, double negative_sample_rate
      *>>   = 5.0, const std::string & metric = "euclidean",
      *>>   std::uint64_t seed = 42) -> UMAP handle
      *>> CALL "dm_umap_new" USING DM-UMAP-NEW DM-STATUS
      *>>
      *>> C++ class datamunge::UMAP. Close the handle with CALL
      *>>   "dm_close".
      *>>
      *>> SWIG-friendly facade for datamunge::stats::UMAP — builds a
      *>>   fuzzy simplicial set (a
      *>> smoothly-calibrated, fuzzy-union-symmetrized
      *>>   k-nearest-neighbor graph) and optimizes a
      *>> low-dimensional embedding via cross-entropy minimization
      *>>   (attractive + negative-sampled
      *>> repulsive forces). A deliberately simplified but honest
      *>>   implementation -- see the real
      *>> class's own documentation for the two named simplifications.
       01 DM-UMAP-NEW.
      *>> Arguments to send: 2 to 10 (C++ defaults fill the rest);
      *>>   initially 2.
          05 DM-UMAP-NEW-GIVEN USAGE BINARY-LONG SIGNED VALUE 2.
      *>> data (const DataFrame &): DATA-FRAME handle.
          05 DM-UMAP-NEW-DATA USAGE BINARY-DOUBLE UNSIGNED.
      *>> feature_columns (const std::vector<std::string> &):
      *>>   VECTOR-STRING handle.
          05 DM-UMAP-NEW-FEATURE-COLUMNS USAGE BINARY-DOUBLE UNSIGNED.
      *>> n_components (std::size_t = 2): unsigned long.
          05 DM-UMAP-NEW-N-COMPONENTS USAGE BINARY-DOUBLE UNSIGNED.
      *>> n_neighbors (std::size_t = 15): unsigned long.
          05 DM-UMAP-NEW-N-NEIGHBORS USAGE BINARY-DOUBLE UNSIGNED.
      *>> min_dist (double = 0.10000000000000001): double.
          05 DM-UMAP-NEW-MIN-DIST USAGE COMP-2.
      *>> max_iterations (std::size_t = 500): unsigned long.
          05 DM-UMAP-NEW-MAX-ITERATIONS USAGE BINARY-DOUBLE UNSIGNED.
      *>> learning_rate (double = 1.0): double.
          05 DM-UMAP-NEW-LEARNING-RATE USAGE COMP-2.
      *>> negative_sample_rate (double = 5.0): double.
          05 DM-UMAP-NEW-NEGATIVE-SAMPLE-RATE USAGE COMP-2.
      *>> metric (const std::string & = "euclidean"): text in PIC
      *>>   X(256); -LENGTH -1 trims trailing spaces. One of "euclidean"
      *>>   (default) or "manhattan".
          05 DM-UMAP-NEW-METRIC PIC X(256).
          05 DM-UMAP-NEW-METRIC-LENGTH USAGE BINARY-LONG SIGNED VALUE
              -1.
      *>> seed (std::uint64_t = 42): unsigned long.
          05 DM-UMAP-NEW-SEED USAGE BINARY-DOUBLE UNSIGNED.
      *>> Result: UMAP handle (new; close it).
          05 DM-UMAP-NEW-RESULT USAGE BINARY-DOUBLE UNSIGNED.

      *>> datamunge::UMAP::UMAP(const DataFrame & data, const
      *>>   std::string & encoded_feature_columns, std::size_t
      *>>   n_components = 2, std::size_t n_neighbors = 15, double
      *>>   min_dist = 0.10000000000000001, std::size_t max_iterations =
      *>>   500, double learning_rate = 1.0, double negative_sample_rate
      *>>   = 5.0, const std::string & metric = "euclidean",
      *>>   std::uint64_t seed = 42) -> UMAP handle
      *>> CALL "dm_ump_new_dat_frm_str_uln_uln_dbl_uln_dbl_dbl_str_ulng"
      *>>   USING
      *>>   DM-UMP-NEW-DAT-FRM-STR-ULN-ULN-DBL-ULN-DBL-DBL-STR-ULNG
      *>>   DM-STATUS
      *>>
      *>> C++ class datamunge::UMAP. Close the handle with CALL
      *>>   "dm_close".
      *>>
      *>> SWIG-friendly facade for datamunge::stats::UMAP — builds a
      *>>   fuzzy simplicial set (a
      *>> smoothly-calibrated, fuzzy-union-symmetrized
      *>>   k-nearest-neighbor graph) and optimizes a
      *>> low-dimensional embedding via cross-entropy minimization
      *>>   (attractive + negative-sampled
      *>> repulsive forces). A deliberately simplified but honest
      *>>   implementation -- see the real
      *>> class's own documentation for the two named simplifications.
      *>>
      *>> Same as the vector<string> constructor, but feature_columns is
      *>>   a single "<count>
      *>> col1..."-encoded string -- see KMeans's encoded constructor
      *>>   for why.
       01 DM-UMP-NEW-DAT-FRM-STR-ULN-ULN-DBL-ULN-DBL-DBL-STR-ULNG.
      *>> Arguments to send: 2 to 10 (C++ defaults fill the rest);
      *>>   initially 2.
          05 DM-UMP-NEW-DAT-FRM-STR-ULN-ULN-DBL-ULN-DBL-DBL-ST-SIR0U
              USAGE BINARY-LONG SIGNED VALUE 2.
      *>> data (const DataFrame &): DATA-FRAME handle.
          05 DM-UMP-NEW-DAT-FRM-STR-ULN-ULN-DBL-ULN-DBL-DBL-ST-R7VUJ
              USAGE BINARY-DOUBLE UNSIGNED.
      *>> encoded_feature_columns (const std::string &): text in PIC
      *>>   X(256); -LENGTH -1 trims trailing spaces.
          05 DM-UMP-NEW-DAT-FRM-STR-ULN-ULN-DBL-ULN-DBL-DBL-ST-ABOM9 PIC
              X(256).
          05 DM-UMP-NEW-DAT-FRM-STR-ULN-ULN-DBL-ULN-DBL-DBL-ST-FGHSP
              USAGE BINARY-LONG SIGNED VALUE -1.
      *>> n_components (std::size_t = 2): unsigned long.
          05 DM-UMP-NEW-DAT-FRM-STR-ULN-ULN-DBL-ULN-DBL-DBL-ST-Q3VFF
              USAGE BINARY-DOUBLE UNSIGNED.
      *>> n_neighbors (std::size_t = 15): unsigned long.
          05 DM-UMP-NEW-DAT-FRM-STR-ULN-ULN-DBL-ULN-DBL-DBL-ST-L1BFC
              USAGE BINARY-DOUBLE UNSIGNED.
      *>> min_dist (double = 0.10000000000000001): double.
          05 DM-UMP-NEW-DAT-FRM-STR-ULN-ULN-DBL-ULN-DBL-DBL-ST-OEP9L
              USAGE COMP-2.
      *>> max_iterations (std::size_t = 500): unsigned long.
          05 DM-UMP-NEW-DAT-FRM-STR-ULN-ULN-DBL-ULN-DBL-DBL-ST-MAI08
              USAGE BINARY-DOUBLE UNSIGNED.
      *>> learning_rate (double = 1.0): double.
          05 DM-UMP-NEW-DAT-FRM-STR-ULN-ULN-DBL-ULN-DBL-DBL-ST-EUGVJ
              USAGE COMP-2.
      *>> negative_sample_rate (double = 5.0): double.
          05 DM-UMP-NEW-DAT-FRM-STR-ULN-ULN-DBL-ULN-DBL-DBL-ST-EJP6B
              USAGE COMP-2.
      *>> metric (const std::string & = "euclidean"): text in PIC
      *>>   X(256); -LENGTH -1 trims trailing spaces.
          05 DM-UMP-NEW-DAT-FRM-STR-ULN-ULN-DBL-ULN-DBL-DBL-ST-VGPIO PIC
              X(256).
          05 DM-UMP-NEW-DAT-FRM-STR-ULN-ULN-DBL-ULN-DBL-DBL-ST-2T8ST
              USAGE BINARY-LONG SIGNED VALUE -1.
      *>> seed (std::uint64_t = 42): unsigned long.
          05 DM-UMP-NEW-DAT-FRM-STR-ULN-ULN-DBL-ULN-DBL-DBL-ST-U71J7
              USAGE BINARY-DOUBLE UNSIGNED.
      *>> Result: UMAP handle (new; close it).
          05 DM-UMP-NEW-DAT-FRM-STR-ULN-ULN-DBL-ULN-DBL-DBL-ST-QOPJU
              USAGE BINARY-DOUBLE UNSIGNED.

