              USAGE BINARY-LONG SIGNED VALUE -1.
      *>> n_components (std::size_t = 2): unsigned long.
          05 DM-DFF-MPS-NEW-DAT-FRM-STRNG-ULNG-DBL-DBL-DBL-N-CMPNNTS
              USAGE BINARY-DOUBLE UNSIGNED.
      *>> heat_kernel_epsilon (double = 1.0): double.
