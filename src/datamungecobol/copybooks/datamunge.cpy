      *>> datamunge::GaussianProcessRegression::predict_frame(const
      *>>   DataFrame & newdata, const std::string & interval_kind =
      *>>   "none", double level = 0.94999999999999996) const ->
      *>>   DataFrame *
      *>> CALL "dm_gaussian_process_regression_predict_frame" USING
      *>>   DM-GAUSSIAN-PROCESS-REGRESSION-PREDICT-FRAME DM-STATUS
       01 DM-GAUSSIAN-PROCESS-REGRESSION-PREDICT-FRAME.
