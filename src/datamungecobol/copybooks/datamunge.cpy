      *>> datamunge::KNNClassifier::plot_classification(const DataFrame
      *>>   & data, const std::string & x_feature, const std::string &
      *>>   y_feature) const -> datamunge::graphics::RPlot
      *>> CALL "dm_knn_classifier_plot_classification" USING
      *>>   DM-KNN-CLASSIFIER-PLOT-CLASSIFICATION DM-STATUS
      *>>
      *>> Scatter of `data` in the (x_feature, y_feature) plane, colored
      *>>   by true class, with misclassified
      *>> points overlaid in a distinct marker.
