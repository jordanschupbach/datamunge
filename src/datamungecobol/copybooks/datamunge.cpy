      *>> datamunge::graphics::RPlot::abline_v(double x_value, RGBA
      *>>   color = ..., double stroke_width = 1.0) -> RPlot &
      *>> CALL "dm_r_plot_abline_v" USING DM-R-PLOT-ABLINE-V DM-STATUS
      *>>
