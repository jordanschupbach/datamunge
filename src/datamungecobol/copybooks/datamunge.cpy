      *> ----------------------------------------------------------------
      *>   XG-BOOST-CLASSIFIER

      *>> datamunge::XGBoostClassifier::XGBoostClassifier(const
      *>>   DataFrame & data, const std::string & formula, std::size_t
      *>>   n_trees = 100, double learning_rate = 0.29999999999999999,
      *>>   std::size_t max_depth = 6, double lambda = 1.0, double alpha
      *>>   = 0.0, double gamma = 0.0, double min_child_weight = 1.0,
      *>>   std::size_t min_samples_leaf = 1, double subsample = 1.0,
      *>>   double colsample_bytree = 1.0, std::uint64_t seed = 42) ->
      *>>   XG-BOOST-CLASSIFIER handle
      *>> CALL "dm_xg_boost_classifier_new" USING
      *>>   DM-XG-BOOST-CLASSIFIER-NEW DM-STATUS
      *>>
      *>> C++ class datamunge::XGBoostClassifier. Close the handle with
      *>>   CALL "dm_close".
      *>>
      *>> SWIG-friendly facade for datamunge::stats::XGBoostClassifier
      *>>   — regularized, second-order (gradient +
      *>> Hessian) multiclass gradient boosting, using the same
      *>>   regularized-gain tree-growing objective as the
