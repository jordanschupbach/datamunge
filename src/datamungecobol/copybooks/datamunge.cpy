              UNSIGNED.
      *>> next (const image::Image &): IMAGE handle.
          05 DM-LUCAS-KANADE-OPTICAL-FLOW-NEXT USAGE BINARY-DOUBLE
              UNSIGNED.
      *>> points (const std::vector<std::pair<int, int>> &):
      *>>   VECTOR-PAIR-INT-INT handle.
          05 DM-LUCAS-KANADE-OPTICAL-FLOW-POINTS USAGE BINARY-DOUBLE
              UNSIGNED.
      *>> window_radius (int = 7): int.
          05 DM-LUCAS-KANADE-OPTICAL-FLOW-WINDOW-RADIUS USAGE
              BINARY-LONG SIGNED.
      *>> Result (std::vector<FlowVector>): VECTOR-FLOW-VECTOR handle
      *>>   (new; close it).
          05 DM-LUCAS-KANADE-OPTICAL-FLOW-RESULT USAGE BINARY-DOUBLE
              UNSIGNED.

