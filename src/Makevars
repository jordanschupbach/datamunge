

# TODO: fix this to remove empty lines and comments from lib_sources.txt
SOURCES = $(shell sed 's|^|../src/|; s|$$|.cpp|' ../lib_sources.txt) datamunge_r_wrap.cpp 
# SOURCES = $(wildcard $(shell find ../src/datamunge -name '*.cpp')) datamunge_r_wrap.cpp 
OBJECTS = $(SOURCES:%.cpp=%.o)
HEADERS = $(shell find ../include -type f \( -name '*.hpp' -o -name '*.h' \))


$(SHLIB):
  @echo "SOURCES: $(SOURCES)"
  @echo "OBJECTS: $(OBJECTS)"
	R CMD SHLIB $(SOURCES)
	R CMD SHLIB -o datamunger.so $(OBJECTS)

$(OBJECTS): $(HEADERS)

#  datamunge/datamunge.cpp datamunge/datamunge.cpp

# The datamunge C++ sources require C++23 (e.g. std::popcount and other <bit>/ranges
# features); the CMake build uses -std=gnu++23, so match that here since R defaults to C++17.
CXX_STD = CXX23

# R builds this binding directly with R CMD SHLIB rather than through CMake, so carry over
# the X11 support that CMake normally detects for Plot::show().
PKG_CPPFLAGS += -I$(CURDIR)/../include -DDATAMUNGE_HAVE_X11=1
PKG_LIBS += -lX11

clean:
	rm -f ./*.o ./datamunge_r_wrap.o ./datamunger.so ./datamunge/*.o ./datamunge/*.so
