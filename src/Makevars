# R's normal build rules compile only the selected core and SWIG objects.
CXX_STD = CXX23
ifeq ($(DATAMUNGE_USE_SYSTEM_LIB),1)
SOURCES = datamunge_r_wrap.cpp
PKG_CPPFLAGS = $(shell pkg-config --cflags datamunge)
PKG_LIBS = $(shell pkg-config --libs datamunge) -Wl,-rpath,$(shell pkg-config --variable=libdir datamunge)
else
SOURCES = $(addsuffix .cpp,$(shell sed -e '/^[[:space:]]*\#/d' -e '/^[[:space:]]*$$/d' ../lib_sources.txt)) datamunge_r_wrap.cpp
PKG_CPPFLAGS = -I../include
PKG_LIBS = -pthread
ifeq ($(shell uname -s),Darwin)
PKG_CPPFLAGS += -DDATAMUNGE_HAVE_CBLAS=1 -DDATAMUNGE_HAVE_LAPACK=1 -DACCELERATE_NEW_LAPACK=1
PKG_LIBS += -framework Accelerate
endif
endif
OBJECTS = $(SOURCES:.cpp=.o)
all: $(SHLIB)

# Headers can affect every translation unit, including the generated wrapper.
HEADERS := $(shell find ../include datamunge -type f \( -name '*.hpp' -o -name '*.h' \))
$(OBJECTS): $(HEADERS)
