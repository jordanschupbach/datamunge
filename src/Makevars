# R's normal build rules compile the core library and the generated rosetta wrapper parts.
CXX_STD = CXX23
ifeq ($(DATAMUNGE_USE_SYSTEM_LIB),1)
SOURCES = $(wildcard datamunge_r_wrap*.cpp)
PKG_CPPFLAGS = $(shell pkg-config --cflags datamunge)
PKG_LIBS = $(shell pkg-config --libs datamunge) -Wl,-rpath,$(shell pkg-config --variable=libdir datamunge)
else
# Same core source set as the Python extension (every file under src/datamunge).
SOURCES = $(sort $(shell find datamunge -name '*.cpp')) $(wildcard datamunge_r_wrap*.cpp)
PKG_CPPFLAGS = -I../include
PKG_LIBS = -pthread
ifeq ($(shell uname -s),Darwin)
PKG_CPPFLAGS += -DDATAMUNGE_HAVE_CBLAS=1 -DDATAMUNGE_HAVE_LAPACK=1 -DACCELERATE_NEW_LAPACK=1
PKG_LIBS += -framework Accelerate
endif
endif
OBJECTS = $(SOURCES:.cpp=.o)
# Keep the source-built R kernel's predicate arithmetic identical to CMake.
$(filter datamunge/cad/%.o,$(OBJECTS)): PKG_CXXFLAGS += -ffp-contract=off
all: $(SHLIB)

# Headers can affect every translation unit, including the generated wrapper.
HEADERS := $(shell find ../include datamunge -type f \( -name '*.hpp' -o -name '*.h' \))
$(OBJECTS): $(HEADERS)
