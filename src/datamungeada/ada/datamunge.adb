         use System.Storage_Elements;
      begin
         if R.Raw_Reals > 0 or else R.Raw_Bytes > 0 then
            return False;
         end if;
         Need (R, 1);
         declare
            V : Interfaces.Unsigned_8 with Import, Address => R.Memory.Data + Storage_Offset (R.Pos);
         begin
            if V = 0 then
               R.Pos := R.Pos + 1;
               return True;
            end if;
            return False;
         end;
      end Take_Nil;

      function Kind_Name (Tag : Interfaces.Unsigned_8) return String is
        (case Tag is
            when 0 => "null",
            when 1 | 19 => "a Boolean",
            when 2 | 3 | 200 => "an integer",
            when 4 => "a real",
            when 5 | 14 => "a string",
            when 6 | 7 | 8 | 16 => "a list",
            when 9 => "a map",
            when 10 | 11 | 17 => "an object",
            when 12 => "a function",
            when 15 => "bytes",
            when 18 => "a complex",
            when others => "a value");

