      begin
         if R.Raw_Reals > 0 then
            R.Raw_Reals := R.Raw_Reals - 1;
            return 4;
         elsif R.Raw_Bytes > 0 then
            R.Raw_Bytes := R.Raw_Bytes - 1;
            return 200;
         end if;
         return U8 (R);
      end Next_Tag;

