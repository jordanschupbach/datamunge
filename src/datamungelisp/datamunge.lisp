  insertions  integer  Actual non-seed distinct sites inserted.
  incircle-tests  integer  Finite live faces tested against an inserted site.
  hull-side-tests  integer  Symbolic boundary faces tested by orientation.
  removed-faces  integer  All conflicting real/ghost faces removed.
  boundary-edges  integer  Actual directed cavity edges retained once.
