(** OCaml bindings to the C++ module [datamunge] (generated by Rosetta).

    Each C++ class is a submodule ({!Expr}) whose [type t] is a native object, created by [create] and freed when collected (or by [close]); its functions take the object as their first positional argument ([M.f x a]; [x |> M.f] for functions of the object alone). Object types are phantom types listing the class and its C++ bases: a function on [[> `Shape ] obj] accepts every class deriving from [Shape], and [(x :> shape)] upcasts.

    {ul
    {- Overloads are separate functions named after their parameter types ([pick], [pick_float]); C++ default arguments are optional labelled arguments ([?b]), given before the positional ones.}
    {- Mutable C++ reference parameters ([T&]) are ['a ref] cells, updated after the call.}
    {- Integers are [int] (range-checked both ways), [std::vector<double>] is [float array], [std::vector<unsigned char>] is [bytes], other sequences are lists, maps are association lists, [std::optional] is [option], [std::complex] is [Complex.t], [std::function] a closure.}
    {- A null object result raises [Not_found]. C++ exceptions raise [Invalid_argument] ([std::invalid_argument]), [Failure] (other [std::exception]s), [Out_of_memory], or {!Error} with a kind; an exception raised in an OCaml callback or override comes back unchanged.}
    {- Classes with virtual methods have [extend]: an OCaml subclass instance whose optional closures override them, also when C++ calls them; [Base] runs the C++ implementation.}} *)

(** A native object; the type parameter lists its class and C++ bases (as polymorphic variant tags). *)
type -'a obj

(** The kinds of {!Error}. *)
type error_kind = [ `Binding | `Out_of_range | `Domain_error | `Length_error | `Arithmetic | `Native ]

(** A C++ exception ([`Out_of_range]: [std::out_of_range], [`Domain_error], [`Length_error], [`Arithmetic]: overflow, underflow and range errors, [`Native]: others), or an error of the binding itself ([`Binding]: a closed object, a pure virtual method without override, a value out of range). *)
exception Error of error_kind * string

(** Monomial orderings supported for multivariate polynomial leading-term selection. Lex: pure
    lexicographic (variable 0 dominates). Grlex: total degree first, then lexicographic to break
    ties. Grevlex: total degree first, then REVERSE lexicographic (smallest trailing-variable
    exponent wins) to break ties -- the usual default for Groebner basis computations since it
    tends to keep intermediate polynomials smaller than Grlex.

    Values cross to C++ by enumerator name; [to_int] and [of_int] give the C++ values. *)
module MonomialOrder : sig
  type t =
    | Lex  (** C++ [Lex] (0). *)
    | Grlex  (** C++ [Grlex] (1). *)
    | Grevlex  (** C++ [Grevlex] (2). *)

  (** The C++ value of an enumerator. *)
  val to_int : t -> int

  (** The enumerator with C++ value [v] (the first, for aliases).
      @raise Invalid_argument if no enumerator has it. *)
  val of_int : int -> t

  (** The C++ name of an enumerator. *)
  val to_string : t -> string

  (** The enumerator with C++ name [s].
      @raise Invalid_argument if there is none. *)
  val of_string : string -> t

  (** Every enumerator, in declaration order. *)
  val all : t list
end

