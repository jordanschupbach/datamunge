  (** A native [datamunge::Splom]: freed when collected, or by {!close}. *)
  type t = splom

  (** Builds the matrix from a facade DataFrame (the overload SWIG bindings use).

      C++:
      [datamunge::Splom::Splom(const DataFrame & data, const std::vector<std::string> & columns = {})]

      @param data Source frame; its values are copied.
      @param columns Columns to include in order; empty selects every numeric column plus every
        string column with at most graphics::Splom::max_default_levels distinct values. (optional;
        C++ default [{}])
      @raise Invalid_argument For a missing column, or fewer than two variables. (C++
        [std::invalid_argument])
      @see "Splom(const dstruct::DataFrame&" C++ [Splom(const dstruct::DataFrame&]
      @see "const std::vector<std::string>&)" C++ [const std::vector<std::string>&)] *)
  val create : ?columns:string list -> [> `DataFrame ] obj -> t

  (** Sets one color for every scatter point; same as color().

      {b Example:}

      {@cpp[
      auto pairs = dm::Splom(dm::datasets::iris()).set_col(dm::RGBA{220, 38, 38, 0.5});
      ]}

      C++: [Splom & datamunge::Splom::set_col(datamunge::graphics::RGB color)]

      @param color Point color, alpha included; also used for bars without grouping.
      @return This matrix, for chaining. *)
  val set_col : [> `Splom ] obj -> [> `RGB ] obj -> splom

  (** Same as title(), matching the [set_*] style of dm::Plot.

      {b Example:}

      {@cpp[
      auto pairs = dm::Splom(dm::datasets::iris()).set_title("Iris Pairs");
      ]}

      C++: [Splom & datamunge::Splom::set_title(const std::string & value)]

      @param value Figure heading; empty removes the heading band.
      @return This matrix, for chaining. *)
  val set_title : [> `Splom ] obj -> string -> splom

  (** Sets the heading above the grid; "" removes it.

      A nonempty title reserves a band above the panels (none by default). show() also uses it as
      the window title when no hint is passed.

      C++: [Splom & datamunge::Splom::title(const std::string & value)]

      @param value Figure heading.
      @return This matrix, for chaining.
      @see "set_title()" C++ [set_title()] *)
  val title : [> `Splom ] obj -> string -> splom

  (** Sets the figure size in pixels (default 960 by 960); panels share it equally.

      {b Example:}

      {@cpp[
      auto pairs = dm::Splom(dm::datasets::iris()).size(600, 600);
      pairs.save("small_pairs.png");
      ]}

      C++: [Splom & datamunge::Splom::size(std::size_t width, std::size_t height)]

      @param width Figure width in pixels.
      @param height Figure height in pixels.
      @return This matrix, for chaining.
      @raise Invalid_argument If either dimension is zero. (C++ [std::invalid_argument]) *)
  val size : [> `Splom ] obj -> int -> int -> splom

