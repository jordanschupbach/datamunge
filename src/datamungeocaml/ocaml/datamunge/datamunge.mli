(** Normal-approximation Wilcoxon signed-rank test with tie/continuity corrections.

    Tests symmetry of x-mu about zero under independent observations, not an
    arbitrary-population mean or median null. For paired data pass aligned differences.
    Exact-zero differences are removed; absolute differences receive average ranks. Always uses
    a normal approximation, even for small tie-free samples; no exact option or CI. O(n log n)
    work/O(n) storage; input unchanged, no shared state.

    {b Example:}

    {@cpp[
    const auto w=dm::stats::wilcoxon_signed_rank_test({1,2,3,4});
    std::print("{:.0f}\n",w.statistic); // 10
    ]}

    {b References:}

    {ul
    {- https://stat.ethz.ch/R-manual/R-devel/library/stats/html/wilcox.test.html}}

    C++:
    [HypothesisTestResult datamunge::stats::wilcoxon_signed_rank_test(const std::vector<double> & x, double mu = 0.0, Alternative alternative = TwoSided)]

    @param x Finite values; at least one nonzero difference from mu must remain.
    @param mu Finite symmetry centre, default zero. (optional; C++ default [0.0])
    @param alternative TwoSided (default), Less or Greater for the signed location shift.
      (optional; C++ default [TwoSided])
    @return statistic=positive rank sum V, estimate1=mu (not an estimated pseudomedian),
      approximate p_value; no CI.
    @raise Invalid_argument Nonfinite input/mu, invalid alternative, no nonzero differences or
      zero rank variance. (C++ [std::invalid_argument])
    @see "HypothesisTestResult" C++ [HypothesisTestResult] *)
val wilcoxon_signed_rank_test : ?mu:float -> ?alternative:Alternative.t -> float array -> hypothesis_test_result

(** Tie/continuity-corrected Mann-Whitney U test using a normal approximation.

    Pools ranks, giving average ranks to ties, and reports U for the first sample. Its
    identical- distribution null requires independent exchangeable samples. A common-shape shift
    model supports a location interpretation; equal medians alone is insufficient. U/(n_x*n_y)
    estimates P(X>Y)+P(X=Y)/2, not a mean difference. Approximation is used at every size. O(N
    log N) work/O(N) storage, inputs unchanged, no shared state.

    {b Example:}

    {@cpp[
    const auto w=dm::stats::wilcoxon_rank_sum_test({1,2,3},{4,5,6});
    std::print("{:.0f}\n",w.statistic); // 0
    ]}

    {b References:}

    {ul
    {- https://stat.ethz.ch/R-manual/R-devel/library/stats/html/wilcox.test.html}}

    C++:
    [HypothesisTestResult datamunge::stats::wilcoxon_rank_sum_test(const std::vector<double> & x, const std::vector<double> & y, Alternative alternative = TwoSided)]

    @param x Nonempty finite first sample.
    @param y Nonempty finite independent second sample.
    @param alternative TwoSided (default), Less or Greater for first-versus-second stochastic
      location. (optional; C++ default [TwoSided])
    @return statistic=U=rank_sum(x)-n_x(n_x+1)/2 and approximate p_value; no CI or location
      estimate.
    @raise Invalid_argument Empty/nonfinite samples, invalid alternative or zero rank variance
      (all pooled observations tied). (C++ [std::invalid_argument])
    @see "HypothesisTestResult" C++ [HypothesisTestResult] *)
val wilcoxon_rank_sum_test : ?alternative:Alternative.t -> float array -> float array -> hypothesis_test_result

