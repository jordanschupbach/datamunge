val extract_local_maxima : float array -> int -> int -> float -> int -> corner list

(** Harris corner detection: response = det(M) - k*trace(M)^2 of the structure tensor M at every
    pixel, thresholded at [threshold_ratio] * (the response map's own max, so callers don't have
    to guess an absolute scale) and non-max-suppressed within a (2*nms_radius+1)^2 window. [k]
    is the classical Harris free parameter (0.04-0.06).

    C++:
    [std::vector<Corner> datamunge::cv::harris_corners(const image::Image & img, double k = 0.040000000000000001, double sigma = 1.0, double threshold_ratio = 0.01, int nms_radius = 3)]

    @param img the C++ argument [img]
    @param k the C++ argument [k] (optional; C++ default [0.040000000000000001])
    @param sigma the C++ argument [sigma] (optional; C++ default [1.0])
    @param threshold_ratio the C++ argument [threshold_ratio] (optional; C++ default [0.01])
    @param nms_radius the C++ argument [nms_radius] (optional; C++ default [3]) *)
val harris_corners : ?k:float -> ?sigma:float -> ?threshold_ratio:float -> ?nms_radius:int -> [> `Image ] obj -> corner list

(** Shi-Tomasi ("good features to track") corner detection: response = the structure tensor's
    SMALLER eigenvalue at every pixel (a corner needs strong gradient variation in BOTH
    directions, so the weaker direction is the limiting factor) -- otherwise identical
    thresholding/NMS pipeline to harris_corners().

    C++:
    [std::vector<Corner> datamunge::cv::shi_tomasi_corners(const image::Image & img, double sigma = 1.0, double threshold_ratio = 0.01, int nms_radius = 3)]

    @param img the C++ argument [img]
    @param sigma the C++ argument [sigma] (optional; C++ default [1.0])
    @param threshold_ratio the C++ argument [threshold_ratio] (optional; C++ default [0.01])
    @param nms_radius the C++ argument [nms_radius] (optional; C++ default [3]) *)
val shi_tomasi_corners : ?sigma:float -> ?threshold_ratio:float -> ?nms_radius:int -> [> `Image ] obj -> corner list

(** FAST corner detection: a pixel is a corner if [min_contiguous] (out of 16) pixels on the
    Bresenham circle of radius 3 around it are ALL brighter than center+ [threshold] or ALL
    darker than center- [threshold]. This is the direct O(16) full-circle test (no accelerated
    high-speed pre-rejection on pixels 1/5/9/13) -- simpler to verify correct, at the cost of
    the constant-factor speed FAST is normally chosen for. Response is the found arc's mean
    absolute deviation from the center intensity.

    C++:
    [std::vector<Corner> datamunge::cv::fast_corners(const image::Image & img, int threshold = 20, int min_contiguous = 9)]

    @param img the C++ argument [img]
    @param threshold the C++ argument [threshold] (optional; C++ default [20])
    @param min_contiguous the C++ argument [min_contiguous] (optional; C++ default [9]) *)
val fast_corners : ?threshold:int -> ?min_contiguous:int -> [> `Image ] obj -> corner list

(** The two points where the infinite line [line] crosses the border of a [image_width] x
    [image_height] image, for drawing/visualization. Returns false (and leaves the output points
    unchanged) if the line doesn't intersect the image rectangle at all (only possible for a
    line entirely outside it).

    C++:
    [bool datamunge::cv::line_endpoints(const HoughLine & line, int image_width, int image_height, std::pair<int, int> & p1, std::pair<int, int> & p2)]

    @param line the C++ argument [line]
    @param image_width the C++ argument [image_width]
    @param image_height the C++ argument [image_height]
    @param p1 the C++ argument [p1]
    @param p2 the C++ argument [p2] *)
val line_endpoints : [> `HoughLine ] obj -> int -> int -> (int * int) ref -> (int * int) ref -> bool

(** Standard Hough line transform: every pixel of [img] whose grayscale luma is >=
    [edge_threshold] votes, in a rho-theta accumulator (theta stepped every degree over
    \[0, pi), rho stepped every pixel over the image's diagonal range), for every line that could pass through it. Returns every accumulator cell with at least [min_votes], non-max-suppressed within a (2*nms_radius+1) rho-theta cell window so a single real line doesn't produce a cluster of near-duplicate near-identical results. Intended input is an edge map (e.g. image::sobel_edges()'s output), not a raw photo.

    C++:
    [std::vector<HoughLine> datamunge::cv::hough_lines(const image::Image & img, int edge_threshold = 128, int min_votes = 50, int nms_radius = 5)]

    @param img the C++ argument [img]
    @param edge_threshold the C++ argument [edge_threshold] (optional; C++ default [128])
    @param min_votes the C++ argument [min_votes] (optional; C++ default [50])
    @param nms_radius the C++ argument [nms_radius] (optional; C++ default [5]) *)
val hough_lines : ?edge_threshold:int -> ?min_votes:int -> ?nms_radius:int -> [> `Image ] obj -> hough_line list

(** Gradient-direction-guided Hough circle transform: for every edge pixel (Sobel gradient
    magnitude >= [gradient_threshold] on [img's] grayscale conversion), and for every candidate
    radius in \[[min_radius], [max_radius]\], votes for the two candidate centers at that
    distance along the pixel's gradient line (handles both bright-disk-on-dark and
    dark-disk-on-bright edge polarity). Each radius gets an independent 2D (cx, cy) accumulator
    and non-max suppression pass -- simpler to reason about than a combined 3D (cx, cy, r)
    accumulator, at the cost of not suppressing near-duplicate detections across adjacent radii.

    C++:
    [std::vector<HoughCircle> datamunge::cv::hough_circles(const image::Image & img, int min_radius, int max_radius, double gradient_threshold = 50.0, int min_votes = 20, int nms_radius = 10)]

    @param img the C++ argument [img]
    @param min_radius the C++ argument [min_radius]
    @param max_radius the C++ argument [max_radius]
    @param gradient_threshold the C++ argument [gradient_threshold] (optional; C++ default
      [50.0])
    @param min_votes the C++ argument [min_votes] (optional; C++ default [20])
    @param nms_radius the C++ argument [nms_radius] (optional; C++ default [10]) *)
val hough_circles : ?gradient_threshold:float -> ?min_votes:int -> ?nms_radius:int -> [> `Image ] obj -> int -> int -> hough_circle list

(** C++ [datamunge::cv::detail::in_structuring_element].

    C++:
    [bool datamunge::cv::detail::in_structuring_element(StructuringElement se, int dx, int dy, int radius)]

    @param se the C++ argument [se]
    @param dx the C++ argument [dx]
    @param dy the C++ argument [dy]
    @param radius the C++ argument [radius] *)
val in_structuring_element : StructuringElement.t -> int -> int -> int -> bool

(** C++ [datamunge::cv::detail::is_foreground].

    C++: [bool datamunge::cv::detail::is_foreground(const image::Image & img, int x, int y)]

    @param img the C++ argument [img]
    @param x the C++ argument [x]
    @param y the C++ argument [y] *)
val is_foreground : [> `Image ] obj -> int -> int -> bool

(** Binary erosion: a pixel stays foreground (luma >= 128, matching image::threshold()'s
    convention) only if EVERY pixel within the structuring element centered on it is also
    foreground -- shrinks foreground regions and removes thin protrusions. Returns a Grayscale
    image with 0/255 values. Pixels outside the image count as background.

    C++:
    [image::Image datamunge::cv::erode(const image::Image & img, StructuringElement se = Square, int radius = 1)]

    @param img the C++ argument [img]
    @param se the C++ argument [se] (optional; C++ default [Square])
    @param radius the C++ argument [radius] (optional; C++ default [1]) *)
val erode : ?se:StructuringElement.t -> ?radius:int -> [> `Image ] obj -> image

(** Binary dilation: a pixel becomes foreground if ANY pixel within the structuring element
    centered on it is foreground -- grows foreground regions and fills small gaps. Returns a
    Grayscale image with 0/255 values.

    C++:
    [image::Image datamunge::cv::dilate(const image::Image & img, StructuringElement se = Square, int radius = 1)]

    @param img the C++ argument [img]
    @param se the C++ argument [se] (optional; C++ default [Square])
    @param radius the C++ argument [radius] (optional; C++ default [1]) *)
val dilate : ?se:StructuringElement.t -> ?radius:int -> [> `Image ] obj -> image

(** Morphological opening (erode then dilate): removes small foreground specks and thin
    protrusions while leaving the size of larger regions roughly unchanged.

    C++:
    [image::Image datamunge::cv::morphological_open(const image::Image & img, StructuringElement se = Square, int radius = 1)]

    @param img the C++ argument [img]
    @param se the C++ argument [se] (optional; C++ default [Square])
    @param radius the C++ argument [radius] (optional; C++ default [1]) *)
val morphological_open : ?se:StructuringElement.t -> ?radius:int -> [> `Image ] obj -> image

(** Morphological closing (dilate then erode): fills small holes and gaps in foreground regions
    while leaving their overall size roughly unchanged.

    C++:
    [image::Image datamunge::cv::morphological_close(const image::Image & img, StructuringElement se = Square, int radius = 1)]

    @param img the C++ argument [img]
    @param se the C++ argument [se] (optional; C++ default [Square])
    @param radius the C++ argument [radius] (optional; C++ default [1]) *)
val morphological_close : ?se:StructuringElement.t -> ?radius:int -> [> `Image ] obj -> image

(** Sparse Lucas-Kanade optical flow: for each of [points], solves the classical 2x2 windowed
    least-squares system (built from Sobel spatial gradients Ix/Iy on [prev] and the temporal
    gradient It = next - prev, both accumulated over a (2*window_radius+1)^2 window) for the
    local translation (dx, dy) that best explains the window's brightness change under the
    standard optical-flow brightness-constancy assumption. Single-level (not the pyramidal
    coarse-to-fine extension real implementations use for large motions) -- correctly handles
    motions up to roughly [window_radius] pixels, which is this module's documented scope
    tradeoff; use gaussian_pyramid() externally and call this once per level if larger motions
    matter.

    C++:
    [std::vector<FlowVector> datamunge::cv::lucas_kanade_optical_flow(const image::Image & prev, const image::Image & next, const std::vector<std::pair<int, int>> & points, int window_radius = 7)]

    @param prev the C++ argument [prev]
    @param next the C++ argument [next]
    @param points the C++ argument [points]
    @param window_radius the C++ argument [window_radius] (optional; C++ default [7]) *)
val lucas_kanade_optical_flow : ?window_radius:int -> [> `Image ] obj -> [> `Image ] obj -> (int * int) list -> flow_vector list

