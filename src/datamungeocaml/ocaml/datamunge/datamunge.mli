(** A symbolic expression tree over +, -, *, /, ^ (power) and sin/cos/exp/log, supporting
    symbolic differentiation, basic algebraic simplification, and numeric evaluation. Value type
    wrapping a shared, immutable node tree -- copies are cheap and structural sharing across
    copies is always safe since nodes are never mutated after construction.

    C++ class [datamunge::algebra::Expr]. *)
module Expr : sig
  (** A native [datamunge::algebra::Expr]: freed when collected, or by {!close}. *)
  type t = expr

  (** A new [Expr] (C++ constructor).

      C++: [datamunge::algebra::Expr::Expr()] *)
  val create : unit -> t

  (** Construct a symbolic constant from a C++ numeric value, including implicit conversion.

      Numeric arguments convert to double, matching constant(); integers larger than double's
      exact integer range may round. Infinity and NaN are accepted. The new immutable node owns
      its value. Enables literals on either side of expression operators and assignment such as
      Expr f = 1. Does not add a conversion from Expr back to a number; use evaluate().

      {b Example:}

      {@cpp[
      dm::algebra::Expr value = 2.5;
      std::print("{}\n", value.evaluate({}, {})); // 2.5
      ]}

      C++: [datamunge::algebra::Expr::Expr(double value)]

      @param value Numeric constant, stored as a double without evaluation or simplification.
      @raise Out_of_memory If the constant node cannot be allocated. (C++ [std::bad_alloc])
      @see "constant()" C++ [constant()]
      @see "evaluate()" C++ [evaluate()] *)
  val create_float : float -> t

  (** C++ [datamunge::algebra::Expr::constant].

      C++: [Expr datamunge::algebra::Expr::constant(double value)]

      @param value the C++ argument [value] *)
