    @param height the C++ argument [height] *)
val crop : [> `Image ] obj -> int -> int -> int -> int -> image

(** A new image with every row reversed left-to-right (mirror image).

    C++: [Image datamunge::image::flip_horizontal(const Image & src)]

    @param src the C++ argument [src] *)
val flip_horizontal : [> `Image ] obj -> image

