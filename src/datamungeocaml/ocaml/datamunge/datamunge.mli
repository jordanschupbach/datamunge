    C++: [Kernel datamunge::image::box_kernel(int size)]

    @param size the C++ argument [size] *)
val box_kernel : int -> float array

(** A normalized 2D Gaussian kernel with standard deviation [sigma]; the kernel radius is chosen
    as ceil(3{i sigma) (covers >99.7% of the distribution's mass), size = 2}radius+1.

    C++: [Kernel datamunge::image::gaussian_kernel(double sigma)]

    @param sigma the C++ argument [sigma] *)
val gaussian_kernel : float -> float array

(** Applies a square convolution [kernel] to every channel of [src] (alpha included), clamping
    accesses at the border (edge-replicate padding, avoiding any darkening artifact a
    zero-padded border would introduce). [kernel's] side length must be odd.

    C++: [Image datamunge::image::convolve(const Image & src, const Kernel & kernel)]

    @param src the C++ argument [src]
    @param kernel the C++ argument [kernel] *)
val convolve : [> `Image ] obj -> float array -> image

(** C++ [datamunge::image::box_blur].

    C++: [Image datamunge::image::box_blur(const Image & src, int radius)]

    @param src the C++ argument [src]
    @param radius the C++ argument [radius] *)
val box_blur : [> `Image ] obj -> int -> image

(** C++ [datamunge::image::gaussian_blur].

    C++: [Image datamunge::image::gaussian_blur(const Image & src, double sigma)]

    @param src the C++ argument [src]
    @param sigma the C++ argument [sigma] *)
val gaussian_blur : [> `Image ] obj -> float -> image

(** Sharpens [src] via an unsharp-mask kernel: the center weight grows (and the neighbor
    weights, already negative, grow more negative) as [amount] increases past its neutral value
    of 0 (0 = no change).

    C++: [Image datamunge::image::sharpen(const Image & src, double amount = 1.0)]

    @param src the C++ argument [src]
    @param amount the C++ argument [amount] (optional; C++ default [1.0]) *)
val sharpen : ?amount:float -> [> `Image ] obj -> image

(** Sobel gradient-magnitude edge detection: converts to grayscale first, then computes the
    horizontal and vertical Sobel gradients at every pixel and returns their Euclidean magnitude
    (clamped to \[0, 255\]) as a new Grayscale image.

    C++: [Image datamunge::image::sobel_edges(const Image & src)]

    @param src the C++ argument [src] *)
val sobel_edges : [> `Image ] obj -> image

(** Adds [delta] to every color channel (alpha untouched), clamped to \[0, 255\]. Negative
    [delta] darkens, positive brightens.

