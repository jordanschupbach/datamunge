(** Linear-system method used by the spline least-squares fits.

    Every fit forms symmetric normal equations (B^T B + P) c = B^T y. Cholesky is exact but
    costs O(K^3) for K unknowns; conjugate gradient on the sparse system costs roughly O(nnz)
    per iteration and suits large, well-conditioned (usually penalized) systems.

    {b Example:}

    {@cpp[
    dm::fda::SplineSolveOptions options{dm::fda::SplineSolver::ConjugateGradient};
    ]}

    Values cross to C++ by enumerator name; [to_int] and [of_int] give the C++ values.

    @see "SplineSolveOptions" C++ [SplineSolveOptions] *)
module SplineSolver : sig
  type t =
    | Automatic  (** C++ [Automatic] (0). *)
    | Cholesky  (** C++ [Cholesky] (1). *)
    | ConjugateGradient  (** C++ [ConjugateGradient] (2). *)

  (** The C++ value of an enumerator. *)
  val to_int : t -> int

  (** The enumerator with C++ value [v] (the first, for aliases).
      @raise Invalid_argument if no enumerator has it. *)
  val of_int : int -> t

  (** The C++ name of an enumerator. *)
  val to_string : t -> string

  (** The enumerator with C++ name [s].
      @raise Invalid_argument if there is none. *)
  val of_string : string -> t

  (** Every enumerator, in declaration order. *)
  val all : t list
end

