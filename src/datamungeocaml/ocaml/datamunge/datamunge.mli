    C++:
    [std::uint8_t datamunge::image::detail::lerp_byte(std::uint8_t a, std::uint8_t b, double t)]

    @param a the C++ argument [a]
    @param b the C++ argument [b]
    @param t the C++ argument [t] *)
val lerp_byte : int -> int -> float -> int

