    C++: [Image datamunge::image::flip_vertical(const Image & src)]

    @param src the C++ argument [src] *)
val flip_vertical : [> `Image ] obj -> image

(** A new image rotated clockwise by exactly 90, 180, or 270 degrees (any other value throws
    std::invalid_argument -- use rotate() for arbitrary angles). 90/270 swap width and height;
    180 keeps them.

    C++: [Image datamunge::image::rotate90(const Image & src, int degrees)]

    @param src the C++ argument [src]
    @param degrees the C++ argument [degrees] *)
val rotate90 : [> `Image ] obj -> int -> image

(** A new image rotated clockwise by an arbitrary angle (in degrees) about its center, via
    inverse-mapping + bilinear resampling. The output canvas is exactly large enough to contain
    the fully-rotated source (like Pillow's expand=True), and pixels sourced from outside the
    original image are filled with [fill_color].

    C++:
    [Image datamunge::image::rotate(const Image & src, double degrees, const Pixel & fill_color = {})]

    @param src the C++ argument [src]
    @param degrees the C++ argument [degrees]
    @param fill_color the C++ argument [fill_color] (optional; C++ default [{}]) *)
val rotate : ?fill_color:[> `Pixel ] obj -> [> `Image ] obj -> float -> image

(** The classical Gaussian pyramid: level 0 is [img] itself; each subsequent level is the
    previous level Gaussian-blurred (sigma = [sigma]) then downsampled by 2x (bilinear resize) --
    a coarse-to-fine multi-resolution representation used throughout this module (e.g. as the
    natural foundation for a pyramidal optical-flow extension, though
    lucas_kanade_optical_flow() itself stays single-level). Stops early (producing fewer than
    [levels] images) if a level's dimensions would shrink below 1x1. Throws
    std::invalid_argument for levels < 1.

    C++:
    [std::vector<image::Image> datamunge::cv::gaussian_pyramid(const image::Image & img, int levels, double sigma = 1.0)]

    @param img the C++ argument [img]
    @param levels the C++ argument [levels]
    @param sigma the C++ argument [sigma] (optional; C++ default [1.0]) *)
val gaussian_pyramid : ?sigma:float -> [> `Image ] obj -> int -> image list

(** Per-channel signed difference (cur - upsampled), re-centered at 128 and clamped to
    \[0, 255\] so it stores in an ordinary Image -- the standard way to make a Laplacian pyramid
    level (which is naturally signed) visualizable/storable without introducing a separate
    signed-pixel image type just for this.

    C++:
    [image::Image datamunge::cv::detail::signed_difference_image(const image::Image & cur, const image::Image & upsampled)]

    @param cur the C++ argument [cur]
    @param upsampled the C++ argument [upsampled] *)
val signed_difference_image : [> `Image ] obj -> [> `Image ] obj -> image

(** The Laplacian pyramid: for every level except the last, level_i = (Gaussian level i) minus
    (Gaussian level i+1 upsampled back to level i's size) -- the detail lost by
    blurring+downsampling at that scale, re-centered at 128 (see
    detail::signed_difference_image()) so it stores as an ordinary image; the final level is the
    smallest Gaussian level kept as-is (the residual low-frequency image the whole pyramid was
    built from). Reconstructing the original from a Laplacian pyramid is the classical use
    (progressively add each un-recentered level back onto the upsampled reconstruction-so-far)
    but isn't implemented here -- this module only needed the decomposition direction.

    C++:
    [std::vector<image::Image> datamunge::cv::laplacian_pyramid(const image::Image & img, int levels, double sigma = 1.0)]

    @param img the C++ argument [img]
    @param levels the C++ argument [levels]
    @param sigma the C++ argument [sigma] (optional; C++ default [1.0]) *)
val laplacian_pyramid : ?sigma:float -> [> `Image ] obj -> int -> image list

(** Labels every foreground (luma >= 128) connected region of [img] with a distinct positive
    integer via flood fill (simple breadth-first flood fill per unvisited foreground pixel,
    rather than the classical two-pass union-find labeling algorithm -- same asymptotic
    complexity, much easier to verify correct, matching this module's established
    simplicity-over-cleverness bias). [eight_connected] selects 8- neighborhood (diagonals
    count) vs. 4-neighborhood (orthogonal only) connectivity.

    C++:
    [LabelMap datamunge::cv::connected_components(const image::Image & img, bool eight_connected = true)]

    @param img the C++ argument [img]
    @param eight_connected the C++ argument [eight_connected] (optional; C++ default [true]) *)
val connected_components : ?eight_connected:bool -> [> `Image ] obj -> label_map

(** Otsu's method: the grayscale threshold (0-255) that maximizes the between-class variance of
    the pixels it would split into "below" and "at-or-above" groups -- the standard automatic
    threshold selection when a fixed threshold isn't known in advance. Pairs directly with
    image::threshold(img, otsu_threshold(img)).

    C++: [int datamunge::cv::otsu_threshold(const image::Image & img)]

    @param img the C++ argument [img] *)
val otsu_threshold : [> `Image ] obj -> int

(** K-means color segmentation: clusters every pixel of [img] by its RGB value into [k] clusters
    (Lloyd's algorithm, deterministic fixed-seed initialization by sampling k distinct pixels)
    and returns a new RGB image where every pixel is replaced by its assigned cluster's mean
    color. Throws std::invalid_argument if [k] exceeds the number of distinct pixels available
    to seed from.

    C++:
    [image::Image datamunge::cv::kmeans_segment(const image::Image & img, int k, int max_iterations = 20, unsigned int seed = 42)]

    @param img the C++ argument [img]
    @param k the C++ argument [k]
    @param max_iterations the C++ argument [max_iterations] (optional; C++ default [20])
    @param seed the C++ argument [seed] (optional; C++ default [42]) *)
val kmeans_segment : ?max_iterations:int -> ?seed:int -> [> `Image ] obj -> int -> image

(** The cache root where downloaded datasets are stored.

    The first of: [$DATAMUNGE_DATA_DIR]; [$XDG_CACHE_HOME/datamunge/datasets];
    [$HOME/.cache/datamunge/datasets]; on Windows [%LOCALAPPDATA%/datamunge/datasets]; otherwise
    [build/datasets] relative to the working directory. Nothing is created.

    {b Example:}

    {@cpp[
    std::print("{}\n", dm::datasets::data_home());   // e.g. /home/me/.cache/datamunge/datasets
    ]}

    C++: [std::string datamunge::datasets::data_home()]

    @return The directory path (it may not exist yet).
    @see "fetch()" C++ [fetch()] *)
val data_home : unit -> string

(** The names fetch() accepts, sorted: "california_housing", "cifar10", "cifar100", "diamonds",
    "fashion_mnist", "karate_club", "mnist", "rebot_devarm", "sudoku".

    {b Example:}

    {@cpp[
    for (const auto& name : dm::datasets::downloadable()) std::print("{}\n", name);
    ]}

    C++: [std::vector<std::string> datamunge::datasets::downloadable()] *)
val downloadable : unit -> string list

(** Makes sure a downloadable dataset is on disk and returns where it is.

    For the tabular datasets ("diamonds", "california_housing") this is the CSV file. For the
    image datasets it is a directory: "mnist" and "fashion_mnist" hold the four uncompressed IDX
    files ([train-images-idx3-ubyte], ...); "cifar10" holds [data_batch_1..5.bin] and
    [test_batch.bin]; "cifar100" holds [train.bin] and [test.bin] (the binary versions);
    "sudoku" holds Norvig's [easy50.txt], [top95.txt] and [hardest.txt]. "karate_club" holds
    the970-byte original ZIP, GML topology and source README; every cached archive/member is
    checksum-verified. karate_club() reads34nodes/78edges. "rebot_devarm" holds 38 pinned Seeed
    DevArm CAD/URDF/STL files and the CERN-OHL-W-2.0 source license in their upstream relative
    directory layout. DevArm verifies the size and SHA-256 of every cached file on every call;
    changed files throw without replacement. Missing files are staged and verified before
    publication. It uses the same offline/mirror/cache controls, and works without the optional
    native data-preparation dependencies. Hashing uses memory proportional to the largest source
    file (about 35 MB). Approximate download sizes: diamonds 2.7 MB, california_housing 1.4 MB,
    MNIST 11 MB, Fashion-MNIST 30 MB, CIFAR-10 163 MB, CIFAR-100 161 MB, sudoku 14 KB, DevArm 56
    MB.

    {b Example:}

    {@cpp[
    const auto housing = dm::datasets::read_csv(dm::datasets::fetch("california_housing"));
    ]}

    For a complete CAD asset tree, use [dm::datasets::fetch("rebot_devarm")].

    {b References:}

    {ul
    {- Seeed reBot-DevArm source: https://github.com/Seeed-Projects/reBot-DevArm}}

    C++:
    [std::string datamunge::datasets::fetch(const std::string & name, const std::string & directory = "")]

    @param name One of downloadable().
    @param directory Where the files live; empty means [data_home() + "/" + name]. Files already
      present there are used as they are, except DevArm and karate_club's verified files.
      (optional; C++ default [""])
    @return The local path of the CSV file or the dataset directory.
    @raise Invalid_argument for an unknown name. (C++ [std::invalid_argument])
    @raise Failure if files are missing and downloading is disabled or fails, or a download does
      not match its checksum. (C++ [std::runtime_error])
    @see "data_home()" C++ [data_home()]
    @see "downloadable()" C++ [downloadable()]
    @see "download_file()" C++ [download_file()]
    @see "karate_club()" C++ [karate_club()] *)
val fetch : ?directory:string -> string -> string

(** Downloads [url] to [destination] with curl, unless the destination already exists.

    The file is downloaded into a temporary directory next to [destination], checked, and only
    then renamed into place. Parent directories are created as needed. [DATAMUNGE_DATA_OFFLINE]
    is honored; [DATAMUNGE_DATA_MIRROR] is not (fetch() applies it).

    {b Example:}

    {@cpp[
    dm::datasets::download_file("https://example.org/data.csv", "/tmp/data.csv");
    ]}

    C++:
    [void datamunge::datasets::download_file(const std::string & url, const std::string & destination, const std::string & md5 = "")]

    @param url An [https://], [http://] or [file://] URL.
    @param destination The final file path.
    @param md5 Expected lowercase hex MD5 of the downloaded bytes; empty skips the check.
      (optional; C++ default [""])
    @raise Failure if downloading is disabled or fails, or the checksum differs. (C++
      [std::runtime_error]) *)
val download_file : ?md5:string -> string -> string -> unit

(** Builds a uniform mesh of [num_elements] equal-length elements on \[a, b\]. Throws
    std::invalid_argument if num_elements is 0 or b <= a.

    C++:
    [Mesh1D datamunge::fem::make_uniform_mesh1d(double a, double b, std::size_t num_elements)]

    @param a the C++ argument [a]
    @param b the C++ argument [b]
    @param num_elements the C++ argument [num_elements] *)
val make_uniform_mesh1d : float -> float -> int -> mesh1_d

(** Evaluate squared Euclidean distance using the original double arithmetic. No finite/range
    validation. Differences, products and sum can overflow, underflow or lose low bits; NaNs
    propagate according to floating arithmetic.

    {b Example:}

    {@cpp[
    std::cout << dm::geometry::squared_distance({0,0},{3,4}); // 25
    ]}

    C++: [double datamunge::geometry::squared_distance(const Point2D & a, const Point2D & b)]

    @param a First point.
    @param b Second point.
    @return Rounded squared distance, possibly infinity/NaN or underflowed zero.
    @see "distance()" C++ [distance()] *)
val squared_distance : [> `Point2D ] obj -> [> `Point2D ] obj -> float

(** Return sqrt(squared_distance(a,b)) with its original range limitations. A finite
    mathematical distance may overflow through the squared intermediate; this convenience
    primitive performs no checked hypot or input validation.

    {b Example:}

    {@cpp[
    std::cout << dm::geometry::distance({0,0},{3,4}); // 5
    ]}

    C++: [double datamunge::geometry::distance(const Point2D & a, const Point2D & b)]

    @param a First point.
    @param b Second point.
    @return Rounded square root of the double-valued squared distance.
    @see "squared_distance()" C++ [squared_distance()] *)
val distance : [> `Point2D ] obj -> [> `Point2D ] obj -> float

(** Evaluate the original double determinant (b-a) cross (c-a). A positive exact determinant
    means counterclockwise, but this approximation can cancel, overflow or underflow and its
    returned sign is not certified. No tolerance or finite validation is applied.
    orientation_sign() supplies an exact sign for finite stored binary64 points; this primitive
    remains unchanged.

    {b Example:}

    {@cpp[
    std::cout << dm::geometry::cross({0,0},{1,0},{0,1}); // 1
    ]}

    C++:
    [double datamunge::geometry::cross(const Point2D & a, const Point2D & b, const Point2D & c)]

    @param a First point.
    @param b Second point.
    @param c Third point.
    @return Rounded double determinant, possibly infinity/NaN or a misleading zero.
    @see "orientation_sign()" C++ [orientation_sign()] *)
val cross : [> `Point2D ] obj -> [> `Point2D ] obj -> [> `Point2D ] obj -> float

(** Construct a complete unconstrained Delaunay triangulation with exact signs. Retains the
    original one-vector signature and Triangle layout. Finite coordinate validation precedes
    even trivial results. Duplicates coalesce to earliest ids; collinear/fewer-than-three
    distinct sites return no faces. Uses Bowyer-Watson cavity replacement with symbolic hull
    ghosts, avoiding any finite super-triangle whose proximity could remove valid narrow faces.
    All orientation/incircle signs are exact for finite stored binary64, including
    subnormals/extreme scales. Cocircular ties retain existing faces under the ordering in
    DelaunayTrace. Faces are strictly CCW, contain no ghosts and reference original ids. Finite
    output order is canonical as documented on DelaunayTrace. No boundary constraints, holes,
    Steiner refinement or minimum-angle guarantee is supplied. Input unchanged; O(n log(n+1)+u^2
    log(u+1)) worst-case work for n records/u distinct sites with ordered cavity maps and full
    live scans; O(n+u) working/output storage, no shared state or optional resource caps.
    Exact-predicate cost is bounded per binary64 query.

    {b Example:}

    {@cpp[
    std::print("{}\n",dm::geometry::delaunay_triangulation({{0,0},{1,0},{.5,.000001}}).size()); // 1
    ]}

    {b References:}

    {ul
    {- A. Bowyer (1981), Computing Dirichlet tessellations, Computer Journal 24(2),162–166, doi:10.1093/comjnl/24.2.162.}
    {- D. F. Watson (1981), Computing the n-dimensional Delaunay tessellation with application to Voronoi polytopes, Computer Journal 24(2),167–172, doi:10.1093/comjnl/24.2.167. This variant uses symbolic boundary faces, exact decoded-dyadic signs, earliest duplicate identities and ordered cavity edges.}}

    C++:
    [std::vector<Triangle> datamunge::geometry::delaunay_triangulation(const std::vector<Point2D> & points)]

    @param points Borrowed finite planar sites, possibly empty/duplicate/collinear.
    @return Owned complete finite mesh of the distinct sites' convex hull, or no faces for
      collinearity.
    @raise Invalid_argument Any nonfinite coordinate, even on short input. (C++
      [std::invalid_argument])
    @raise Error [(`Length_error, _)] Counter arithmetic or container capacity exceeded. (C++
      [std::length_error])
    @raise Failure Internal cavity topology invariant fails; no partial mesh returned. (C++
      [std::logic_error])
    @raise Out_of_memory Allocation fails. (C++ [std::bad_alloc])
    @see "delaunay_trace()" C++ [delaunay_trace()]
    @see "incircle_sign()" C++ [incircle_sign()] *)
val delaunay_triangulation : [> `Point2D ] obj list -> triangle list

(** Capture actual symbolic-boundary cavity transitions from the same solver. No replay. Full
    finite validation precedes the original-record cap and all allocation. max_tests bounds
    cumulative incircle plus hull-side calls, checked before each complete live-face scan. Trace
    entries charge one per insertion plus removed faces, boundary edges and added faces,
    including ghosts, checked before retaining the event. Points/maps/final output and temporary
    cavities are excluded from that entry count; caps do not bound bytes or wall time. Zero
    disables only an optional cap. O(sum cavity/event sizes) additional history, at worst
    O(u^2), beyond the ordinary solver. Failure returns no partial result.

    {b Example:}

    {@cpp[
    const auto t=dm::geometry::delaunay_trace({{0,0},{4,0},{4,4},{0,4},{2,2}},5,10);
    std::print("{} {}\n",t.triangles.size(),t.work.incircle_tests+t.work.hull_side_tests); // 4 10
    ]}

    {b References:}

    {ul
    {- Bowyer (1981), doi:10.1093/comjnl/24.2.162; Watson (1981), doi:10.1093/comjnl/24.2.167; records the symbolic-boundary variant rather than a geometric replay.}}

    C++:
    [DelaunayTrace datamunge::geometry::delaunay_trace(const std::vector<Point2D> & points, std::size_t max_points = 1000000, std::size_t max_tests = 10000000, std::size_t max_entries = 1000000)]

    @param points Finite original coordinates, unchanged.
    @param max_points Complete original-record cap, default 1000000; zero disables. (optional;
      C++ default [1000000])
    @param max_tests Cumulative complete-scan conflict cap, default 10000000; zero disables.
      (optional; C++ default [10000000])
    @param max_entries Cumulative event-entry cap, default 1000000; zero disables. (optional;
      C++ default [1000000])
    @return Owned points, original-id maps, finite mesh, actual events and work.
    @raise Invalid_argument Any nonfinite coordinate. (C++ [std::invalid_argument])
    @raise Error [(`Length_error, _)] Optional cap, count arithmetic or container capacity
      exceeded. (C++ [std::length_error])
    @raise Failure Internal cavity invariant fails. (C++ [std::logic_error])
    @raise Out_of_memory Allocation fails. (C++ [std::bad_alloc])
    @see "DelaunayTrace" C++ [DelaunayTrace]
    @see "delaunay_triangulation()" C++ [delaunay_triangulation()] *)
val delaunay_trace : ?max_points:int -> ?max_tests:int -> ?max_entries:int -> [> `Point2D ] obj list -> delaunay_trace

(** Measure a supplied mesh and test every nonvertex site against every circle. Performs the
    structural checks on DelaunayAnalysis first. The complete prospective circle count
    faces*(unique_sites-3) is checked before circle queries; zero cap disables only that limit.
    O(n log(n+1)+f log(f+1)+fu) work and O(n+f) storage; minimum angles are floating diagnostics
    and are not certified bounds. This is a local property analysis, not a global
    embedding/coverage certificate.

    {b Example:}

    {@cpp[
    const std::vector<dm::geometry::Point2D> p{{0,0},{1,0},{1,1},{0,1}};
    const auto a=dm::geometry::delaunay_analyze(p,dm::geometry::delaunay_triangulation(p));
    std::print("{} {} {}\n",a.edges,a.boundary_edges,a.circle_tests); // 5 4 2
    ]}

    C++:
    [DelaunayAnalysis datamunge::geometry::delaunay_analyze(const std::vector<Point2D> & points, const std::vector<Triangle> & triangles, std::size_t max_tests = 1000000)]

    @param points Finite original sites, unchanged.
    @param triangles Finite CCW faces with valid original indices, unchanged.
    @param max_tests Complete exact-circle query cap, default 1000000; zero disables. (optional;
      C++ default [1000000])
    @return Owned scalar topology, actual query/violation counts and approximate angle.
    @raise Invalid_argument Nonfinite coordinates, bad/degenerate/non-CCW/duplicate faces or
      nonmanifold edges. (C++ [std::invalid_argument])
    @raise Error [(`Length_error, _)] Circle-count arithmetic or optional cap exceeded. (C++
      [std::length_error])
    @raise Out_of_memory Allocation fails. (C++ [std::bad_alloc])
    @see "DelaunayAnalysis" C++ [DelaunayAnalysis]
    @see "delaunay_triangulation()" C++ [delaunay_triangulation()] *)
val delaunay_analyze : ?max_tests:int -> [> `Point2D ] obj list -> [> `Triangle ] obj list -> delaunay_analysis

(** Generate the report's seeded uniform square-cloud control in the core. Uses mt19937(seed)
    and uniform_real_distribution<double>(0,extent), x then y for each point. Same-library runs
    reproduce the original report's seed20250728 and 30-site square when defaults are used.
    Standard distribution algorithms need not match across C++ libraries, so the seed is not a
    universal byte fixture. Coincident draws are allowed and later triangulation deduplicates
    them. O(count) work/storage, owned output, no global RNG or shared mutation.

    {b Example:}

    {@cpp[
    std::print("{}\n",dm::geometry::delaunay_uniform_cloud(30).size()); // 30
    ]}

    C++:
    [std::vector<Point2D> datamunge::geometry::delaunay_uniform_cloud(std::size_t count, std::uint32_t seed = 20250728, double extent = 10.0, std::size_t max_points = 1000000)]

    @param count Number of original generated records, zero allowed.
    @param seed mt19937 seed, default 20250728. (optional; C++ default [20250728])
    @param extent Positive finite square extent, default 10; checked even for count zero.
      (optional; C++ default [10.0])
    @param max_points Optional complete output-record cap, default 1000000; zero disables.
      (optional; C++ default [1000000])
    @return Owned generated points in \[0,extent) on each axis.
    @raise Invalid_argument Nonpositive or nonfinite extent. (C++ [std::invalid_argument])
    @raise Error [(`Length_error, _)] Optional count cap or container capacity exceeded before
      allocation. (C++ [std::length_error])
    @raise Out_of_memory Allocation fails. (C++ [std::bad_alloc])
    @see "delaunay_trace()" C++ [delaunay_trace()] *)
val delaunay_uniform_cloud : ?seed:int -> ?extent:float -> ?max_points:int -> int -> point2_d list

(** Builds a structured rectangular mesh on \[x0, x1\] x \[y0, y1\]: nx * ny grid cells, each
    split into two counterclockwise triangles, for a total of nx{i ny}2 triangles and
    (nx+1)*(ny+1) nodes, ordered row-major (x fastest, then y). Throws std::invalid_argument if
    nx or ny is 0, or if x1 <= x0 or y1 <= y0.

    C++:
    [Mesh2D datamunge::fem::make_rectangular_mesh2d(double x0, double y0, double x1, double y1, std::size_t nx, std::size_t ny)]

    @param x0 the C++ argument [x0]
    @param y0 the C++ argument [y0]
    @param x1 the C++ argument [x1]
    @param y1 the C++ argument [y1]
    @param nx the C++ argument [nx]
    @param ny the C++ argument [ny] *)
val make_rectangular_mesh2d : float -> float -> float -> float -> int -> int -> mesh2_d

(** Builds a mesh over the convex hull of an arbitrary point cloud via Delaunay triangulation
    (datamunge::geometry::delaunay_triangulation) -- useful for unstructured domains a
    structured grid does not fit.

    C++:
    [Mesh2D datamunge::fem::make_mesh2d_from_points(const std::vector<datamunge::geometry::Point2D> & points)]

    @param points the C++ argument [points] *)
val make_mesh2d_from_points : [> `Point2D ] obj list -> mesh2_d

(** Node indices lying on the mesh's outer boundary: every node incident to a boundary edge (an
    edge belonging to exactly one triangle). Works generically for both a structured rectangular
    mesh (the domain's four sides) and an unstructured Delaunay mesh (the convex hull), returned
    in ascending order with no duplicates.

    C++: [std::vector<int> datamunge::fem::boundary_nodes(const Mesh2D & mesh)]

    @param mesh the C++ argument [mesh] *)
val boundary_nodes : [> `Mesh2D ] obj -> int list

(** The axis-aligned bounding box of [points]. Throws std::invalid_argument for an empty point
    set.

    C++: [BoundingBox datamunge::geometry::bounding_box(const std::vector<Point2D> & points)]

    @param points the C++ argument [points] *)
val bounding_box : [> `Point2D ] obj list -> bounding_box

(** Return the closest point copies and finite-double distance using the checked all-pairs
    kernel. Validates at least two finite points, visits every original i<j pair and compares
    widened hypot distances. Equal rounded distances keep the lexicographically first index
    pair. Duplicates are valid distinct records and can yield zero. No early stop, sorting or
    spatial pruning; O(n^2) work and O(1) auxiliary storage. No input mutation/shared state.
    Widened comparison can change former false zero/infinite results and last-bit ties; it is
    not an exact-real predicate. The old call/result layout remains; indexed/traced variants
    retain input ids.

    {b Example:}

    {@cpp[
    const auto r=dm::geometry::closest_pair({{0,0},{3,4},{0,1}});
    std::print("{}\n",r.distance); // 1
    ]}

    C++:
    [ClosestPairResult datamunge::geometry::closest_pair(const std::vector<Point2D> & points)]

    @param points Borrowed original finite planar coordinates, length at least two.
    @return Owned selected point copies and checked finite-double measured distance.
    @raise Invalid_argument If point count is too small or any coordinate is nonfinite. (C++
      [std::invalid_argument])
    @raise Error [(`Length_error, _)] If complete pair count cannot fit size_t. (C++
      [std::length_error])
    @raise Error [(`Arithmetic, _)] If arithmetic/counters or the selected legacy distance
      cannot fit. (C++ [std::overflow_error])
    @see "closest_pair_indexed()" C++ [closest_pair_indexed()]
    @see "closest_pair_trace()" C++ [closest_pair_trace()] *)
val closest_pair : [> `Point2D ] obj list -> closest_pair_result

(** Compute Andrew's strict monotone-chain hull using exact binary64 orientation signs.
    Validates all coordinates before internal indexed copies or sorting; the original by-value
    argument copy occurs at the call boundary. Exact coordinate equality removes duplicates
    (including signed zero); the earliest matching original record supplies its representation.
    Returns lexicographic-minimum first, counterclockwise, no repeated endpoint and no collinear
    edge interiors. Empty/singleton/two-point/collinear outputs follow ConvexHullAnalysis. O(n
    log n) comparisons plus O(n) bounded exact-sign tests, O(n) scratch/output, no global state.
    The legacy by-value signature is retained and has no optional caps. Other geometry routines
    that use cross() retain their own floating contracts.

    {b Example:}

    {@cpp[
    const auto h=dm::geometry::convex_hull({{0,0},{2,0},{2,2},{0,2},{1,1}});
    std::cout << h.size(); // 4
    ]}

    {b References:}

    {ul
    {- A. M. Andrew (1979), Another efficient algorithm for convex hulls in two dimensions, https://doi.org/10.1016/0020-0190(79)90072-3 .}}

    C++: [std::vector<Point2D> datamunge::geometry::convex_hull(std::vector<Point2D> points)]

    @param points Finite planar records, copied by value as in the original API.
    @return Owned strict hull of the represented coordinates.
    @raise Invalid_argument Any nonfinite coordinate. (C++ [std::invalid_argument])
    @raise Error [(`Length_error, _)] Work/container size exhaustion. (C++ [std::length_error])
    @see "convex_hull_analyze()" C++ [convex_hull_analyze()]
    @see "convex_hull_trace()" C++ [convex_hull_trace()]
    @see "orientation_sign()" C++ [orientation_sign()] *)
val convex_hull : [> `Point2D ] obj list -> point2_d list

(** Execute the same exact-sign hull kernel with identities and actual work. Same ordering,
    degeneracy and complexity contract as convex_hull(). Full finite validation precedes the
    complete max_points cap and scratch allocation. No events or completed-chain snapshots are
    retained; event cap is ignored.

    {b Example:}

    {@cpp[
    const auto a=dm::geometry::convex_hull_analyze({{0,0},{1,0},{2,0}});
    std::cout << a.hull.size() << ' ' << a.work.distinct_points; // 2 3
    ]}

    {b References:}

    {ul
    {- Andrew (1979), https://doi.org/10.1016/0020-0190(79)90072-3 .}}

    C++:
    [ConvexHullAnalysis datamunge::geometry::convex_hull_analyze(const std::vector<Point2D> & points, ConvexHullOptions options = {})]

    @param points Finite original records; not mutated.
    @param options Complete original-record cap, zero unlimited; defaults one million.
      (optional; C++ default [{}])
    @return Owned hull, earliest original indices and actual counters.
    @raise Invalid_argument Nonfinite coordinate. (C++ [std::invalid_argument])
    @raise Error [(`Length_error, _)] Complete point cap or work/container exhaustion. (C++
      [std::length_error])
    @see "convex_hull()" C++ [convex_hull()]
    @see "ConvexHullOptions" C++ [ConvexHullOptions] *)
val convex_hull_analyze : ?options:[> `ConvexHullOptions ] obj -> [> `Point2D ] obj list -> convex_hull_analysis

(** Capture the hull kernel's actual stack events without replay or quadratic snapshots. Same
    computation/work as analyze, plus O(n) owned sorted records, compact test/pop/push edits and
    completed lower/upper chains. Positive max_events is checked online on actual records,
    including pushes; zero disables the cap.

    {b Example:}

    {@cpp[
    const auto t=dm::geometry::convex_hull_trace({{0,0},{1,0}});
    std::cout << t.events.size(); // 4
    ]}

    {b References:}

    {ul
    {- Andrew (1979), https://doi.org/10.1016/0020-0190(79)90072-3 .}}

    C++:
    [ConvexHullTrace datamunge::geometry::convex_hull_trace(const std::vector<Point2D> & points, ConvexHullOptions options = {})]

    @param points Finite original records; not mutated.
    @param options Complete point and actual event caps. (optional; C++ default [{}])
    @return Owned actual sorted coordinates, identities, work and scan edits.
    @raise Invalid_argument Nonfinite coordinate. (C++ [std::invalid_argument])
    @raise Error [(`Length_error, _)] Point/event cap or work/container exhaustion. (C++
      [std::length_error])
    @see "convex_hull_analyze()" C++ [convex_hull_analyze()]
    @see "HullEvent" C++ [HullEvent] *)
val convex_hull_trace : ?options:[> `ConvexHullOptions ] obj -> [> `Point2D ] obj list -> convex_hull_trace

