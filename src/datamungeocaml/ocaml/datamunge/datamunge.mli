      @raise Error [(`Out_of_range, _)] when no rows remain. (C++ [std::out_of_range]) *)
  val next : [> `CsvReader ] obj -> data_frame

  (** Rewinds to the first data row.

      C++: [void datamunge::CsvReader::reset()] *)
  val reset : [> `CsvReader ] obj -> unit

  (** Rows per chunk.

      C++: [int datamunge::CsvReader::batch_size() const] *)
  val batch_size : [> `CsvReader ] obj -> int

  (** Changes the rows per chunk.

      C++: [void datamunge::CsvReader::set_batch_size(int rows)]

      @param rows the C++ argument [rows]
      @raise Invalid_argument if [rows] is not positive. (C++ [std::invalid_argument]) *)
  val set_batch_size : [> `CsvReader ] obj -> int -> unit

