      ]}

      C++: [Splom & datamunge::Splom::span(double value)]

      @param value Span in (0, 1\]; smaller values follow the data more closely.
      @return This matrix, for chaining.
      @raise Invalid_argument If [value] is not in (0, 1\]. (C++ [std::invalid_argument]) *)
  val span : [> `Splom ] obj -> float -> splom

  (** Sets the coverage of the prediction bands above the diagonal (default 0.95).

      C++: [Splom & datamunge::Splom::prediction_level(double value)]

      @param value Coverage in (0, 1).
      @return This matrix, for chaining.
      @raise Invalid_argument If [value] is not in (0, 1). (C++ [std::invalid_argument])
