(** Inserts knots into a clamped B-spline basis (Oslo algorithm).

    Builds the refined knot vector (old knots merged with [inserted_knots]) and the sparse
    discrete-B-spline operator that re-expresses every coarse spline on it exactly. Each row has
    at most degree + 1 nonzeros and the work is O(m p^2) for m refined functions.

    {b Example:}

    {@cpp[
    auto coarse = dm::fda::BSplineBasis::open_uniform(1, 2);   // knots 0 0 1 1
    auto r = dm::fda::refine_basis(coarse, {0.25});
    std::print("{}\n", r.apply({0.0, 4.0}));                   // [0, 1, 4]
    ]}

    {b References:}

    {ul
    {- E. Cohen, T. Lyche and R. Riesenfeld (1980). Discrete B-splines and subdivision techniques in computer-aided geometric design and computer graphics. Computer Graphics and Image Processing 14(2), 87-111. https://doi.org/10.1016/0146-664X(80)90040-4}
    {- W. Boehm (1980). Inserting new knots into B-spline curves. Computer-Aided Design 12(4), 199-201. https://doi.org/10.1016/0010-4485(80)90154-2}}

    C++:
    [BSplineRefinement datamunge::fda::refine_basis(const BSplineBasis & basis, const std::vector<double> & inserted_knots)]

    @param basis Basis to refine; its knot vector must be clamped (first and last knots repeated
      degree + 1 times, as produced by BSplineBasis::open_uniform()).
    @param inserted_knots Knots to add, strictly inside the domain, in any order. Repeats are
      allowed while every knot multiplicity stays <= degree + 1.
    @return The refined basis and its refinement operator.
    @raise Invalid_argument If the basis is not clamped, a knot is outside the open domain or
      non-finite, or a multiplicity would exceed degree + 1. (C++ [std::invalid_argument])
    @see "dyadic_refine()" C++ [dyadic_refine()] *)
val refine_basis : [> `BSplineBasis ] obj -> float array -> b_spline_refinement

(** Halves every knot span of a clamped basis (inserts each positive span's midpoint).

    This is the nested-space step between consecutive levels of HB/THB splines: the refined
    space contains the coarse one, and the operator maps coefficients exactly.

    {b Example:}

    {@cpp[
    auto r = dm::fda::dyadic_refine(dm::fda::BSplineBasis::open_uniform(3, 5));
    std::print("{} -> {}\n", 5, r.basis.basis_size()); // 5 -> 7
    ]}

    {b References:}

    {ul
    {- E. Cohen, T. Lyche and R. Riesenfeld (1980). Discrete B-splines and subdivision techniques in computer-aided geometric design and computer graphics. https://doi.org/10.1016/0146-664X(80)90040-4}}

    C++: [BSplineRefinement datamunge::fda::dyadic_refine(const BSplineBasis & basis)]

    @param basis Clamped basis to refine.
    @return The refined basis and its refinement operator.
    @raise Invalid_argument If the basis is not clamped. (C++ [std::invalid_argument])
    @see "refine_basis()" C++ [refine_basis()]
    @see "TensorBSpline::dyadic_refine()" C++ [TensorBSpline::dyadic_refine()] *)
val dyadic_refine : [> `BSplineBasis ] obj -> b_spline_refinement

(** Fits a tensor-product B-spline to scattered data by ordinary least squares.

    Builds the sparse design B (each row has at most prod(degree_k + 1) nonzeros), then solves
    (B^T B) c = B^T y. Coordinates outside a basis domain are clamped to it.

    {b Example:}

    {@cpp[
    auto b = dm::fda::BSplineBasis::open_uniform(1, 2);
    auto f = dm::fda::fit_tensor_bspline({b}, {{0.0}, {0.5}, {1.0}}, {1.0, 2.0, 3.0});
    std::print("{:.3f}\n", f.evaluate(0.25)); // 1.500
    ]}

    {b References:}

    {ul
    {- C. de Boor (2001). A Practical Guide to Splines, revised edition. Springer.}}

    C++:
    [TensorBSpline datamunge::fda::fit_tensor_bspline(std::vector<BSplineBasis> bases, const std::vector<std::vector<double>> & points, const std::vector<double> & values, const SplineSolveOptions & options = {})]

    @param bases One basis per dimension.
    @param points Sample locations, each of length bases.size().
    @param values One response per point.
    @param options Solver settings (default: automatic). (optional; C++ default [{}])
    @return The fitted spline.
    @raise Invalid_argument On empty or mismatched inputs, or non-finite data. (C++
      [std::invalid_argument])
    @raise Failure If the normal equations are singular (some basis function has too little
      data; use a penalized fit or fewer functions). (C++ [std::runtime_error])
    @see "fit_tensor_pspline()" C++ [fit_tensor_pspline()] *)
val fit_tensor_bspline : ?options:[> `SplineSolveOptions ] obj -> [> `BSplineBasis ] obj list -> float array list -> float array -> tensor_b_spline

(** Fits a tensor-product P-spline: least squares plus an anisotropic difference penalty,
    solving (B^T B + P) c = B^T y with P from tensor_difference_penalty().

    All-zero lambdas reproduce fit_tensor_bspline(). Positive lambdas keep the system well-posed
    even with fewer points than coefficients (for order 0, or once the data determine the
    order-q polynomial null space).

    {b Example:}

    {@cpp[
    auto b = dm::fda::BSplineBasis::open_uniform(3, 8);
    auto f = dm::fda::fit_tensor_pspline({b}, {{0.0}, {1.0}}, {0.0, 1.0}, {1e3});
    std::print("{:.3f}\n", f.evaluate(0.5)); // 0.500
    ]}

    {b References:}

    {ul
    {- P. H. C. Eilers and B. D. Marx (1996). Flexible smoothing with B-splines and penalties. https://doi.org/10.1214/ss/1038425655}
    {- P. H. C. Eilers, I. D. Currie and M. Durban (2006). Fast and compact smoothing on large multidimensional grids. https://doi.org/10.1016/j.csda.2004.07.008}}

    C++:
    [TensorBSpline datamunge::fda::fit_tensor_pspline(std::vector<BSplineBasis> bases, const std::vector<std::vector<double>> & points, const std::vector<double> & values, const std::vector<double> & lambdas, int order = 2, const SplineSolveOptions & options = {})]

    @param bases One basis per dimension.
    @param points Sample locations, each of length bases.size().
    @param values One response per point.
    @param lambdas Nonnegative per-axis smoothing weights, one per basis.
    @param order Difference order (default 2, the conventional curvature penalty). (optional;
      C++ default [2])
    @param options Solver settings (default: automatic). (optional; C++ default [{}])
    @return The fitted spline.
    @raise Invalid_argument On empty/mismatched inputs, invalid lambdas, or an axis with no more
      functions than [order]. (C++ [std::invalid_argument])
    @raise Failure If the penalized normal equations are singular. (C++ [std::runtime_error])
    @see "fit_tensor_bspline()" C++ [fit_tensor_bspline()]
    @see "fit_pspline()" C++ [fit_pspline()] *)
val fit_tensor_pspline : ?order:int -> ?options:[> `SplineSolveOptions ] obj -> [> `BSplineBasis ] obj list -> float array list -> float array -> float array -> tensor_b_spline

