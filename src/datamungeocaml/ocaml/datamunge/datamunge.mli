(** Expected improvement of a Gaussian prediction below an incumbent (minimisation).

    For [Y\sim N(\mu,\sigma^2)] and target [t=\text{incumbent}-\xi],
    [\operatorname{E}\max(t-Y,0)=(t-\mu)\Phi(u)+\sigma\varphi(u)] with [u=(t-\mu)/\sigma].

    [\mu].

    [\sigma\ge0]; 0 gives [\max(t-\mu,0)].

    [\xi\ge0] an improvement must exceed.

    {b Example:}

    {@cpp[
    std::print("{:.4f}\n", dm::optim::expected_improvement(0.0, 1.0, 0.0));  // 0.3989 = phi(0)
    ]}

    C++:
    [double datamunge::optim::expected_improvement(double mean, double sd, double incumbent, double exploration = 0.0)]

    @param mean Predicted mean
    @param sd Predicted standard deviation
    @param incumbent Smallest value observed so far.
    @param exploration Margin (optional; C++ default [0.0])
    @return The expected improvement (never negative). *)
val expected_improvement : ?exploration:float -> float -> float -> float -> float

(** Probability that a Gaussian prediction falls below incumbent − exploration.

    [\mu].

    [\xi\ge0].

    [\Phi\big((\text{incumbent}-\xi-\mu)/\sigma\big)].

    {b Example:}

    {@cpp[
    std::print("{:.4f}\n", dm::optim::probability_of_improvement(1.0, 1.0, 0.0));  // 0.1587
    ]}

    C++:
    [double datamunge::optim::probability_of_improvement(double mean, double sd, double incumbent, double exploration = 0.0)]

    @param mean Predicted mean
    @param sd Predicted standard deviation; 0 gives 0 or 1.
    @param incumbent Smallest value observed so far.
    @param exploration Margin (optional; C++ default [0.0]) *)
