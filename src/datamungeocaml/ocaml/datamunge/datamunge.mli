    std::print("{} {} {}\n", cols[0].r, cols[1].r, cols[2].r);  // 68 35 253
    ]}

    C++:
    [std::vector<RGBA> datamunge::graphics::value_colors(const std::vector<double> & values, std::vector<RGBA> palette = {}, double z_min = ..., double z_max = ...)]

    @param values Values to colour.
    @param palette Colours from low to high (default viridis_colors(256)). (optional; C++
      default [{}])
    @param z_min Value of the first colour; NaN (the default) uses the smallest value.
      (optional: C++ default)
    @param z_max Value of the last colour; NaN (the default) uses the largest value. (optional:
      C++ default)
    @return One colour per value.
