    [HypothesisTestResult datamunge::stats::f_test_variance(const std::vector<double> & x, const std::vector<double> & y, Alternative alternative = TwoSided, double conf_level = 0.94999999999999996)]

    @param x At least two finite first-sample values with positive finite sample variance.
    @param y At least two finite independent second-sample values with positive finite sample
      variance.
