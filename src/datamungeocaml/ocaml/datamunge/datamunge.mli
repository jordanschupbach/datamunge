      @param path The CSV file.
      @param batch_size Rows per chunk; must be positive. (optional; C++ default [1000])
      @param delimiter The field separator. (optional; C++ default [','])
      @raise Invalid_argument if batch_size is not positive. (C++ [std::invalid_argument])
      @raise Failure if the file cannot be opened or is malformed. (C++ [std::runtime_error]) *)
  val create : ?batch_size:int -> ?delimiter:char -> string -> t

