(** A Box-Jenkins seasonal ARIMA(p, d, q)(P, D, Q)_s model, fit to a single numeric series by
    conditional sum of squares (CSS): the series is differenced (regular d times, then seasonal
    D times with period s) to stationarity, the combined AR/MA polynomials (regular composed
    with seasonal, via polynomial multiplication) are estimated by minimizing the conditional
    residual sum of squares with DifferentialEvolution, and forecasts are produced by recursing
    the fitted difference equation forward and re-integrating through the differencing steps.

    Setting seasonal_period == 0 (the default) reduces this to a plain, non-seasonal ARIMA(p, d,
    q) model -- i.e. SARIMA is the general case, ARIMA the special case, exactly as in R's
    arima()/statsmodels' SARIMAX().

    Note: CSS estimation approximates the exact Gaussian likelihood by conditioning on the first
    max(p + P{i s, q + Q}s) observations rather than filtering the full series (e.g. via a
    Kalman filter); it is a standard, textbook ARIMA fitting method (R's arima(method = "CSS"))
    but will differ slightly from exact-ML fits.

    C++ class [datamunge::stats::ARIMA]. *)
module ARIMA : sig
  (** A native [datamunge::stats::ARIMA]: freed when collected, or by {!close}. *)
  type t = arima

  (** Fit the model to a series.

      C++:
      [datamunge::stats::ARIMA::ARIMA(const std::vector<double> & y, ARIMAOptions options = {})]

      @param y The observed series, in time order.
      @param options Model orders and optimizer settings. (optional; C++ default [{}])
      @raise Invalid_argument If a seasonal order is set while seasonal_period is zero, or if the
        series is too short for the requested differencing or AR order. (C++
        [std::invalid_argument]) *)
  val create : ?options:[> `ARIMAOptions ] obj -> float array -> t

  (** The options the model was fit with.

      C++: [const ARIMAOptions & datamunge::stats::ARIMA::options() const]

      @return The stored ARIMAOptions. *)
  val options : [> `ARIMA ] obj -> arima_options

  (** Fitted non-seasonal AR coefficients

      [\phi_1,\dots,\phi_p].

      [1-\sum_i\phi_i B^i].

      C++: [const std::vector<double> & datamunge::stats::ARIMA::ar_coefficients() const]

      @return A vector of length p; the AR polynomial is *)
  val ar_coefficients : [> `ARIMA ] obj -> float array

  (** Fitted non-seasonal MA coefficients

      [\theta_1,\dots,\theta_q].

      [1+\sum_j\theta_j B^j].

      C++: [const std::vector<double> & datamunge::stats::ARIMA::ma_coefficients() const]

      @return A vector of length q; the MA polynomial is *)
  val ma_coefficients : [> `ARIMA ] obj -> float array

  (** Fitted seasonal AR coefficients

      [\Phi_1,\dots,\Phi_P].

      [1-\sum_i\Phi_i B^{is}].

      C++: [const std::vector<double> & datamunge::stats::ARIMA::seasonal_ar_coefficients() const]

      @return A vector of length P; the polynomial is *)
  val seasonal_ar_coefficients : [> `ARIMA ] obj -> float array

  (** Fitted seasonal MA coefficients

      [\Theta_1,\dots,\Theta_Q].

      [1+\sum_j\Theta_j B^{js}].

      C++: [const std::vector<double> & datamunge::stats::ARIMA::seasonal_ma_coefficients() const]

      @return A vector of length Q; the polynomial is *)
  val seasonal_ma_coefficients : [> `ARIMA ] obj -> float array

  (** Fitted mean of the differenced series.

      C++: [double datamunge::stats::ARIMA::mean() const]

      @return The mean, or 0 when no mean term was fit (include_mean is false, or d or D is
        nonzero). *)
  val mean : [> `ARIMA ] obj -> float

  (** Length of the input series.

      C++: [std::size_t datamunge::stats::ARIMA::observations() const]

      @return The number of observations passed to the constructor. *)
  val observations : [> `ARIMA ] obj -> int

  (** Number of residuals that enter the sum of squares.

      [p+sP] (the conditioned-on presample).

      C++: [std::size_t datamunge::stats::ARIMA::n_used() const]

      @return The differenced series length minus *)
  val n_used : [> `ARIMA ] obj -> int

  (** Innovation variance estimate.

      C++: [double datamunge::stats::ARIMA::sigma2() const]

      @return The CSS residual sum of squares divided by n_used(). *)
  val sigma2 : [> `ARIMA ] obj -> float

  (** Gaussian log-likelihood at the CSS estimate, over n_used() residuals.

      [-\tfrac{n}{2}(\log 2\pi + \log\sigma^2 + 1)] with [n] = n_used().

      C++: [double datamunge::stats::ARIMA::log_likelihood() const] *)
  val log_likelihood : [> `ARIMA ] obj -> float

  (** Akaike information criterion.

      [-2\ell + 2k], where [k] counts the coefficients, the mean (if fit) and [\sigma^2].

      C++: [double datamunge::stats::ARIMA::aic() const] *)
  val aic : [> `ARIMA ] obj -> float

  (** Bayesian information criterion.

      [-2\ell + k\log n], with [k] as in aic() and [n] = n_used().

      C++: [double datamunge::stats::ARIMA::bic() const] *)
  val bic : [> `ARIMA ] obj -> float

  (** One-step-ahead fitted values on the original scale, aligned to the input series (the first
      [observations() - n_used()] entries -- the presample points conditioned on by CSS -- are
      copies of the observed value, matching a residual of exactly zero there rather than an
      undefined value).

      C++: [const std::vector<double> & datamunge::stats::ARIMA::fitted_values() const] *)
  val fitted_values : [> `ARIMA ] obj -> float array

  (** One-step-ahead residuals on the original scale (zero for the presample points).

      C++: [const std::vector<double> & datamunge::stats::ARIMA::residuals() const] *)
  val residuals : [> `ARIMA ] obj -> float array

  (** Point forecasts for the next [horizon] periods, on the original scale.

      C++: [std::vector<double> datamunge::stats::ARIMA::forecast(std::size_t horizon) const]

      @param horizon Number of steps ahead to forecast.
      @return A vector of length [horizon] (empty when [horizon] is 0). *)
  val forecast : [> `ARIMA ] obj -> int -> float array

  (** AR coefficients of the stationary (differenced) model after multiplying the regular and
      seasonal polynomials,

      [w_t=\sum_i a_i w_{t-i}+\varepsilon_t+\sum_j b_j\varepsilon_{t-j}].

      [a_i], [i=1,\dots,p+sP] (zeros where no lag enters).

      C++: [const std::vector<double> & datamunge::stats::ARIMA::expanded_ar_coefficients() const]

      @return The *)
  val expanded_ar_coefficients : [> `ARIMA ] obj -> float array

  (** MA coefficients

      [b_j] of the stationary model, after multiplying the regular and seasonal MA polynomials;
      for the airline model [(\theta,0,\dots,0,\Theta,\theta\Theta)].

      [b_j], [j=1,\dots,q+sQ].

      C++: [const std::vector<double> & datamunge::stats::ARIMA::expanded_ma_coefficients() const]

      @return The *)
  val expanded_ma_coefficients : [> `ARIMA ] obj -> float array

  (** The first [count]

      [\psi]-weights of the full model, differencing included:
      [y_t=\sum_{j\ge0}\psi_j\varepsilon_{t-j}] formally, with [\psi_0=1].

      The h-step forecast error is [\sum_{j<h}\psi_j\varepsilon_{t+h-j}], so its variance is
      [\sigma^2\sum_{j<h}\psi_j^2]; forecast_with_intervals() uses exactly these weights.

      [\psi_0,\dots,\psi_{count-1}].

      C++: [std::vector<double> datamunge::stats::ARIMA::psi_weights(std::size_t count) const]

      @param count Number of weights. *)
  val psi_weights : [> `ARIMA ] obj -> int -> float array

  (** Point forecasts and their standard errors (from the psi-weight / MA(infinity) expansion of
      the full, non-stationary AR/MA representation of y), on the original scale.

      C++:
      [std::pair<std::vector<double>, std::vector<double>> datamunge::stats::ARIMA::forecast_with_intervals(std::size_t horizon) const]

      @param horizon Number of steps ahead to forecast.
      @return A pair (point forecasts, standard errors), each of length [horizon]. *)
  val forecast_with_intervals : [> `ARIMA ] obj -> int -> (float array * float array)

  (** [Some x] when the object is (in C++) a [datamunge::stats::ARIMA] or derives from it, [None] otherwise. *)
  val cast : 'a obj -> t option

  (** The object as a [ARIMA] (an upcast: no check is needed). *)
  val upcast : [> `ARIMA ] obj -> t

  (** Frees the native object now (when OCaml owns it). Later calls on it raise
      [Error (`Binding, _)]; closing twice does nothing. *)
  val close : [> `ARIMA ] obj -> unit

  (** Whether {!close} was called on the object. *)
  val is_closed : [> `ARIMA ] obj -> bool
end

