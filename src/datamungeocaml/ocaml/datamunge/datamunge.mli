(** Exact expected Metropolis acceptance of one HMC proposal (fixed step size and number of
    leapfrog steps, unit mass) on a one-dimensional

    [N(m,s^2)] target, started in equilibrium.

    In scaled coordinates [x=((q-m)/s,\,p)] each leapfrog step is the linear map
    [M=\begin{pmatrix}1&0\\-h/2&1\end{pmatrix}\begin{pmatrix}1&h\\0&1\end{pmatrix}\begin{pmatrix}1&0\\-h/2&1\end{pmatrix}]
    with [h=\varepsilon/s], [\det M=1] and [\operatorname{tr}M=2-h^2], so it is stable exactly
    when [\varepsilon<2s]. Writing [x_0=r(\cos\phi,\sin\phi)] the energy error is
    [\Delta H=r^2f(\phi)] with [f=\tfrac12(|M^L(\cos\phi,\sin\phi)|^2-1)], and because
    [r^2/2\sim\text{Exp}(1)] the radial average of [\min(1,e^{-\Delta H})] is [1/(1+2f)] for
    [f>0] and 1 otherwise. The angle is integrated numerically.

    [\varepsilon>0].

    [L\geq1].

    [s>0].

    C++:
    [double datamunge::bayes::leapfrog_gaussian_acceptance(double step_size, std::size_t num_steps, double sd, std::size_t angles = 4096)]

    @param step_size Leapfrog step size
    @param num_steps Number of leapfrog steps
    @param sd Target standard deviation
    @param angles Number of quadrature angles (at least 8). (optional; C++ default [4096])
    @return The expected acceptance probability.
    @raise Invalid_argument for non-positive arguments. (C++ [std::invalid_argument]) *)
val leapfrog_gaussian_acceptance : ?angles:int -> float -> int -> float -> float

(** Asymptotic effective-sample-size fraction

