      @param palette Group colors in sorted-group order; empty uses the default. (optional; C++
        default [{}])
      @return This matrix, for chaining.
      @raise Invalid_argument If [column] is not a string column of the source frame. (C++
        [std::invalid_argument])
      @see "groups()" C++ [groups()]
      @see "set_col()" C++ [set_col()] *)
  val group_by : ?palette:[> `RGB ] obj list -> [> `Splom ] obj -> string -> splom

  (** Sets one color per data row for the points (recycled); clears group_by().

      Same as set_col(const Vector<RGB>&) for callers holding a std::vector; an empty vector
      restores the single color().

      {b Example:}

      {@cpp[
      auto pairs = dm::Splom(dm::datasets::iris())
                       .point_colors({dm::RGB{0, 0, 0}, dm::RGB{255, 0, 0}});  // alternate rows
      ]}

      C++:
      [Splom & datamunge::Splom::point_colors(const std::vector<datamunge::graphics::RGB> & colors)]

      @param colors Per-row colors, recycled when shorter than the frame.
      @return This matrix, for chaining. *)
  val point_colors : [> `Splom ] obj -> [> `RGB ] obj list -> splom

  (** Sets the fills cycled over categorical levels in violins and stacked bars.

      An empty vector restores the default palette. group_by() and the factor form of set_col()
      override it for their own column. Scatter points are unaffected.

      C++:
      [Splom & datamunge::Splom::level_palette(const std::vector<datamunge::graphics::RGB> & colors)]

      @param colors Fill colors in sorted-level order, recycled.
      @return This matrix, for chaining. *)
  val level_palette : [> `Splom ] obj -> [> `RGB ] obj list -> splom

  (** Sets the point radius in pixels (default 2.5).

      C++: [Splom & datamunge::Splom::marker_size(double value)]

      @param value Positive marker radius.
      @return This matrix, for chaining.
      @raise Invalid_argument If [value] is not positive. (C++ [std::invalid_argument]) *)
  val marker_size : [> `Splom ] obj -> float -> splom

  (** Shows only the variable names on the diagonal, like R's [pairs()].

      C++: [Splom & datamunge::Splom::diagonal_names()]

      @return This matrix, for chaining.
      @see "diagonal_density()" C++ [diagonal_density()]
      @see "diagonal_histogram()" C++ [diagonal_histogram()] *)
  val diagonal_names : [> `Splom ] obj -> splom

  (** Shows kernel densities, one per group (numeric), or a stacked bar (string) on the diagonal
      (the default).

      C++: [Splom & datamunge::Splom::diagonal_density()]

      @return This matrix, for chaining.
      @see "diagonal_histogram()" C++ [diagonal_histogram()]
      @see "diagonal_names()" C++ [diagonal_names()] *)
  val diagonal_density : [> `Splom ] obj -> splom

  (** Shows a histogram (numeric) or stacked bar (string) on the diagonal.

      C++: [Splom & datamunge::Splom::diagonal_histogram()]

      @return This matrix, for chaining.
      @see "diagonal_density()" C++ [diagonal_density()]
      @see "bins()" C++ [bins()] *)
  val diagonal_histogram : [> `Splom ] obj -> splom

  (** Sets the fraction of each group's points used in each local fit of the smooths above the
