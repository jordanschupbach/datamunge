opam-version: "2.0"
synopsis: "OCaml (SWIG) bindings for the datamunge library"
description: """
OCaml bindings for the datamunge C++ library generated with SWIG.
"""
maintainer: "datamunge"
authors: "datamunge"
license: "Unlicense"
depends: [
  "ocaml"
  "dune" {>= "3.11"}
]
build: [
  ["dune" "build" "-p" name "-j" jobs]
]
