    ''' polynomials v of degree &lt; n with
    ''' </summary>
    ''' <remarks>
    ''' <para><c>v^p\equiv v \pmod f</c>, as the null space of
    ''' <c>Q-I</c>, where row i of Q holds the coefficients of <c>x^{ip}\bmod f</c>. For square-free
    ''' f its dimension is the number of irreducible factors. The first vector is the constant 1.</para>
    ''' </remarks>
    ''' <param name="f"></param>
    ''' <param name="p"></param>
    Public Shared Function BerlekampNullSpace(f As IEnumerable(Of Long), p As Long) As List(Of List(Of Long))
