    ''' <summary>
    ''' Classify exact closed-segment contact and construct its unique point or overlap bounds.
    ''' Evaluates four canonical exact orientation signs. Opposite nonzero signs on both baselines identify a proper crossing; zero signs use closed coordinate bounds. Collinear endpoint/point-segment cases return Point; nonzero interval overlaps return Overlap with lexicographically ordered endpoint bounds. Proper crossing coordinates use a widened quotient of exactly accumulated determinants, then convex interpolation and final double narrowing. The contact decision is exact for represented finite coordinates; a constructed interior point is approximate, not a correctly rounded rational certificate. Trace and run use the same fixed-size producing record, with no replay or dynamic history. Constant bounded work/storage, no shared state; borrowed inputs unchanged.
    ''' </summary>
    ''' <remarks>
    ''' <para><b>Example</b></para>
    ''' <code>
    ''' auto t=dm::geometry::segment_intersection_run({0,0},{2,2},{0,2},{2,0});
    ''' std::print("{} {} {}\n",int(t.contact),t.first.x,t.first.y); // 1 1 1
    ''' </code>
    ''' <para><b>References</b></para>
    ''' <para>- Exact determinant motivation: Shewchuk (1997), https://www.cs.cmu.edu/~quake/robust.html ; standard closed-segment orientation and collinear bounding-box test.</para>
    ''' <para>See also: <c>segments_intersect()</c>, <c>cross_difference_ratio()</c>.</para>
    ''' </remarks>
    ''' <param name="p">First segment start.</param>
    ''' <param name="q">First segment end.</param>
    ''' <param name="r">Second segment start.</param>
    ''' <param name="s">Second segment end.</param>
    ''' <returns>Owned exact contact, actual predicates, and approximate point/exact overlap endpoint coordinates.</returns>
    ''' <exception cref="NativeException">C++ <c>std::invalid_argument</c>: Nonfinite coordinate.</exception>
    ''' <exception cref="NativeException">C++ <c>std::overflow_error</c>: A nonzero construction quotient or final point is outside the finite represented range.</exception>
    Public Shared Function SegmentIntersectionRun(p As Point2D, q As Point2D, r As Point2D, s As Point2D) As SegmentIntersectionRun
        Return Rosetta.Cast(Of SegmentIntersectionRun)(Rosetta.Run(153, p, q, r, s))
    End Function

