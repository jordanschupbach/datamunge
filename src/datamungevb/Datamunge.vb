    End Function

    ''' <summary>
    ''' Compute unrestricted absolute-loss DTW and actual logical work without cost history.
    ''' Owns the result; borrows finite inputs without mutation. No band, slope bound,
    ''' step weighting, length normalization or fitted parameters. Finite ties choose
    ''' diagonal, then advance_a, then advance_b. O(n*m) recurrence time, O(n*m+n+m)
    ''' scratch/output, with only two double cost rows and n*m predecessor bytes.
    ''' Complete input/geometry validation precedes allocation. Positive overflowing
    ''' off-path costs remain infinity; only a nonfinite final optimum is rejected.
    ''' Under ordinary double arithmetic the returned witness sums to the returned
    ''' distance in forward order. Concurrent independent calls share no mutable state.
    ''' </summary>
    ''' <remarks>
    ''' <para><b>Example</b></para>
    ''' <para>See DTWWork and DTWComputation for executed work examples.</para>
    ''' <para><b>References</b></para>
    ''' <para>- H. Sakoe and S. Chiba (1978), Dynamic programming algorithm optimization for
    '''   spoken word recognition, IEEE TASSP26(1):43-49. doi:10.1109/TASSP.1978.1163055.
    '''   This is the unrestricted scalar absolute-loss variant, without the paper's window/slope rules.</para>
    ''' <para>See also: <c>dynamic_time_warping()</c>, <c>dynamic_time_warping_trace()</c>.</para>
    ''' </remarks>
    ''' <param name="a">Nonempty finite scalar sequence, length at most INT_MAX.</param>
    ''' <param name="b">Nonempty finite scalar sequence, length at most INT_MAX.</param>
    ''' <returns>Independent optimal result and counts, with no retained input/cost history.</returns>
    ''' <exception cref="NativeException">C++ <c>std::invalid_argument</c>: For empty or nonfinite input.</exception>
    ''' <exception cref="NativeException">C++ <c>std::length_error</c>: For geometry/index/container bounds.</exception>
    ''' <exception cref="NativeException">C++ <c>std::overflow_error</c>: If the final minimum is not finite double.</exception>
    ''' <exception cref="NativeException">C++ <c>std::bad_alloc</c>: If scratch or result storage cannot be allocated.</exception>
    Public Shared Function DynamicTimeWarpingWork(a As IEnumerable(Of Double), b As IEnumerable(Of Double)) As DTWComputation
        Return Rosetta.Cast(Of DTWComputation)(Rosetta.Run(135, a, b))
    End Function

    ''' <summary>
    ''' Preserve the original two-argument unrestricted absolute-loss DTW entry point.
    ''' Same validation, ownership, deterministic ties, numerical limits and complexity
    ''' as dynamic_time_warping_work(); discards only its work counters. This distance
    ''' is not a metric: unequal stretched sequences can have zero cost and the triangle
    ''' inequality can fail. Equal-length diagonal alignment bounds it by rigid L1 loss.
    ''' </summary>
    ''' <remarks>
    ''' <para><b>Example</b></para>
    ''' <para>See DTWResult for the executed original stretched-sequence example.</para>
    ''' <para><b>References</b></para>
    ''' <para>- H. Sakoe and S. Chiba (1978), IEEE TASSP26(1):43-49, doi:10.1109/TASSP.1978.1163055.</para>
    ''' <para>See also: <c>dynamic_time_warping_work()</c>, <c>dtw_path_cost()</c>.</para>
    ''' </remarks>
    ''' <param name="a">Nonempty finite first sequence, length at most INT_MAX.</param>
    ''' <param name="b">Nonempty finite second sequence, length at most INT_MAX.</param>
    ''' <returns>Owned optimal distance and inclusive zero-based parallel int paths.</returns>
    ''' <exception cref="NativeException">C++ <c>std::invalid_argument</c>: For empty or nonfinite input.</exception>
    ''' <exception cref="NativeException">C++ <c>std::length_error</c>: For geometry/index/container bounds.</exception>
    ''' <exception cref="NativeException">C++ <c>std::overflow_error</c>: If the final optimum is not finite double.</exception>
    ''' <exception cref="NativeException">C++ <c>std::bad_alloc</c>: If scratch or result storage cannot be allocated.</exception>
    Public Shared Function DynamicTimeWarping(a As IEnumerable(Of Double), b As IEnumerable(Of Double)) As DTWResult
        Return Rosetta.Cast(Of DTWResult)(Rosetta.Run(136, a, b))
    End Function

