    End Function

    ''' <summary>
    ''' Binding-friendly wrapper around berlekamp_factor() using doubles (exact up to 2^53)
    ''' for both the input polynomial and the prime, matching this module's
    ''' std::size_t/fixed-width-integer-avoidance convention for SWIG-facing signatures
    ''' (<c>std::vector&lt;long long&gt;</c> has no proven binding template in this codebase, while
    ''' <c>std::vector&lt;double&gt;</c> already does). See berlekamp_factor() for the algorithm and
    ''' preconditions.
    ''' </summary>
    ''' <param name="poly"></param>
    ''' <param name="prime"></param>
    Public Shared Function BerlekampFactorMod(poly As IEnumerable(Of Double), prime As Double) As List(Of List(Of Double))
