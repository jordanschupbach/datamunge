    Public Shared Function ComplexRoots(p As Polynomial, maxIterations As ULong) As List(Of Complex)
        Return Rosetta.Cast(Of List(Of Complex))(Rosetta.Run(27, p, maxIterations))
    End Function

    ''' <summary>
