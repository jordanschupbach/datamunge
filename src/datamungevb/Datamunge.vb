    End Function

    ''' <summary>
    ''' Asymptotic effective-sample-size fraction
    ''' </summary>
    ''' <remarks>
    ''' <para><c>N_{\text{eff}}/N</c> of importance sampling
    ''' a <c>d</c>-dimensional Gaussian target with a Gaussian proposal of the same mean and
    ''' covariance scaled by <c>k^2</c>.</para>
    ''' <para><c>N_{\text{eff}}/N\to1/E_q[w^2]</c> for weights <c>w=p/q</c> normalised to mean 1. In one
    ''' dimension <c>E_q[w^2]=\int p^2/q=k^2/\sqrt{2k^2-1}</c>, finite only for <c>k^2&gt;1/2</c>, and the
    ''' dimensions multiply, giving <c>\bigl(\sqrt{2k^2-1}/k^2\bigr)^d</c>. It is 1 at <c>k=1</c> and
    ''' 0 (infinite weight variance) for <c>k\le1/\sqrt2</c>.</para>
    ''' <para><c>k&gt;0</c>.</para>
    ''' <para><c>d\ge1</c>.</para>
    ''' </remarks>
    ''' <param name="scale">Proposal scale factor</param>
    ''' <param name="dimension">Dimension</param>
    ''' <returns>The efficiency in [0, 1].</returns>
    ''' <exception cref="NativeException">C++ <c>std::invalid_argument</c>: for non-positive <c>scale</c> or <c>dimension</c>.</exception>
    Public Shared Function GaussianImportanceEfficiency(scale As Double, dimension As Integer) As Double
        Return Rosetta.Cast(Of Double)(Rosetta.Run(64, scale, dimension))
    End Function

