    Inherits NativeObject
    Friend Sub New(raw As NativeRaw)
        MyBase.New(raw)
    End Sub

    ''' <summary>
    ''' C++ <c>datamunge::fem::FEM1D::FEM1D</c>.
    ''' </summary>
    Public Sub New()
        MyBase.New(New NativeRaw())
        Rosetta.Construct(Me, GetType(FEM1D), False, 921)
    End Sub

    ''' <summary>
    ''' Solve the steady P1 system for -(p*u')'+q*u=f with endpoint boundary data.
    ''' Follows FEM1D's mesh/coefficient/finite-arithmetic/nonsingular-pivot preconditions.
    ''' Uses three-point Gauss-Legendre quadrature of f times each local basis, natural
    ''' boundary terms and symmetric Dirichlet elimination, then Thomas elimination.
    ''' O(N) work/storage for N nodes; invokes the source three times per element.
    ''' No callback pointer is retained. Independent calls share no mutable state.
    ''' </summary>
    ''' <remarks>
    ''' <para><b>Example</b></para>
    ''' <code>
    ''' struct Unit final:dm::fem::ScalarField1D{double evaluate(double) override{return 1;}} source;
    ''' const auto r=dm::fem::FEM1D::solve(dm::fem::make_uniform_mesh1d(0,1,2),{1},{0},source,{},{});
    ''' std::print("{}\n",r.value_at(1)); // 0.125
    ''' </code>
    ''' <para><b>References</b></para>
    ''' <para>- https://mfem.org/fem_weak_form/ ; native interval P1 and quadrature choices as FEM1D.</para>
    ''' <para>See also: <c>solve_builtin()</c>, <c>solve_transient()</c>.</para>
    ''' </remarks>
    ''' <param name="mesh">Borrowed mesh with at least two finite strictly increasing nodes.</param>
    ''' <param name="p">Borrowed diffusion coefficient: length1 or one per element.</param>
    ''' <param name="q">Borrowed reaction coefficient: length1 or one per element.</param>
    ''' <param name="f">Borrowed spatial source; evaluate() may have caller-owned side effects.</param>
    ''' <param name="left">Left endpoint condition, with outward normal -1.</param>
    ''' <param name="right">Right endpoint condition, with outward normal +1.</param>
    ''' <returns>Owned original nodes and computed nodal values.</returns>
    ''' <exception cref="NativeException">C++ <c>std::invalid_argument</c>: If p/q are empty or have the wrong lengths.</exception>
    ''' <exception cref="NativeException">C++ <c>std::bad_alloc</c>: If assembly/result storage cannot be allocated; callback exceptions propagate.</exception>
    Public Shared Function Solve(mesh As Mesh1D, p As IEnumerable(Of Double), q As IEnumerable(Of Double), f As ScalarField1D, left As BoundaryCondition1D, right As BoundaryCondition1D) As FEM1DResult
        Return Rosetta.Cast(Of FEM1DResult)(Rosetta.Run(917, mesh, p, q, f, left, right))
    End Function

    ''' <summary>
    ''' Solve the steady system using an owned named spatial source, without a director callback.
    ''' Shares the live-source solver and its mathematical/precondition/storage contracts.
    ''' Sources: zero=0 (params unused); constant=c ({1}); linear=m*x+c ({1,0});
    ''' polynomial=sum(params[i]*x^i) (empty gives0); sine=A*sin(w*x+phase) ({1,1,0}).
    ''' Missing trailing parameters use those defaults; extra parameters are ignored
    ''' except polynomial, which uses all entries. Name matching is exact/case-sensitive.
    ''' </summary>
    ''' <remarks>
    ''' <para><b>Example</b></para>
    ''' <code>
    ''' const auto r=dm::fem::FEM1D::solve_builtin(dm::fem::make_uniform_mesh1d(0,1,2),{1},{0},"constant",{}, {},{});
    ''' std::print("{}\n",r.value_at(1)); // 0.125
    ''' </code>
    ''' <para><b>References</b></para>
    ''' <para>- https://mfem.org/fem_weak_form/ ; source definitions are native convenience choices.</para>
    ''' <para>See also: <c>solve()</c>, <c>solve_transient_builtin()</c>.</para>
    ''' </remarks>
    ''' <param name="mesh">Borrowed valid finite interval mesh; unchanged.</param>
    ''' <param name="p">Borrowed scalar/per-element diffusion coefficient.</param>
    ''' <param name="q">Borrowed scalar/per-element reaction coefficient.</param>
    ''' <param name="source">Exact name zero, constant, linear, polynomial or sine.</param>
    ''' <param name="sourceParams">Borrowed positional source parameters, with defaults described above.</param>
    ''' <param name="left">Left endpoint data using outward normal -1.</param>
    ''' <param name="right">Right endpoint data using outward normal +1.</param>
    ''' <returns>Owned computed nodal result, retaining no source or input reference.</returns>
    ''' <exception cref="NativeException">C++ <c>std::invalid_argument</c>: For an unknown source or malformed p/q lengths.</exception>
    ''' <exception cref="NativeException">C++ <c>std::bad_alloc</c>: If owned parameter/assembly/result storage cannot be allocated.</exception>
    Public Shared Function SolveBuiltin(mesh As Mesh1D, p As IEnumerable(Of Double), q As IEnumerable(Of Double), source As String, sourceParams As IEnumerable(Of Double), left As BoundaryCondition1D, right As BoundaryCondition1D) As FEM1DResult
        Return Rosetta.Cast(Of FEM1DResult)(Rosetta.Run(918, mesh, p, q, source, sourceParams, left, right))
    End Function

    ''' <summary>
    ''' Integrate u_t-(p*u')'+q*u=f with P1 space and actual backward-Euler time intervals.
    ''' Shares FEM1D's spatial/finite-arithmetic/nonzero-pivot preconditions. Source
    ''' and boundary data represent a time-independent model; the live callback is
    ''' actually reevaluated three times per element at every time advance, not cached.
    ''' Stores initial u0 as supplied, then imposes boundary data at later solves.
    ''' Nominal step dt is shortened at t_end; actual positive time differences enter
    ''' the mass term. Stops once t_end is reached, avoiding a duplicate rounded last
    ''' time even when ceil(t_end/dt) overestimates the number of advances.
    ''' O(S*N) work/output storage for S advances/N nodes, O(N) assembly temporaries;
    ''' no optional trace or quota. Backward Euler is unconditionally stable for the
    ''' coercive semidiscrete model, not a guarantee of arbitrary-step accuracy or
    ''' finite arithmetic for arbitrary parameters. Input arrays remain unchanged;
    ''' callback exceptions/side effects/concurrent safety belong to caller.
    ''' </summary>
    ''' <remarks>
    ''' <para><b>Example</b></para>
    ''' <code>
    ''' struct Zero final:dm::fem::ScalarField1D{double evaluate(double) override{return 0;}} source;
