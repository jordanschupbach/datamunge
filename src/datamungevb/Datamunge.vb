    ''' <summary>
    ''' Splits every numeric panel by the groups of string column <c>column</c> (GGally's
    ''' <c>ggpairs(aes(colour = group))</c>); an empty palette uses the default level palette.
    ''' </summary>
    ''' <remarks>
    ''' <para>The column need not be a panel variable but must be a string column of the source
    ''' frame. Groups are its sorted distinct non-missing values, and group k takes
    ''' <c>palette[k % palette.size()]</c>. Each group gets its own points, diagonal density, smooth
    ''' and prediction band, and density contours; rows with a missing group are left out of
    ''' those panels. When the column is also a panel variable its rainclouds, bars, and mosaic axis
    ''' share the colors. Pass "" to clear the grouping. Clears point_colors().</para>
    ''' <para><b>Example</b></para>
    ''' <code>
    ''' auto pairs = dm::Splom(dm::datasets::iris()).group_by("Species");
    ''' std::print("{}\n", pairs.groups());  // ["setosa", "versicolor", "virginica"]
    ''' </code>
    ''' <para>See also: <c>groups()</c>, <c>set_col()</c>.</para>
    ''' <para>Uses the C++ default for <c>palette = Nothing</c>.</para>
    ''' </remarks>
    ''' <param name="column">String column to group by, or "" to clear.</param>
    ''' <returns>This matrix, for chaining.</returns>
    ''' <exception cref="NativeException">C++ <c>std::invalid_argument</c>: If <c>column</c> is not a string column of the source frame.</exception>
    Public Function GroupBy(column As String) As Splom
        Return Rosetta.Cast(Of Splom)(Rosetta.Run(2496, Me, column))
    End Function

    ''' <summary>
    ''' Splits every numeric panel by the groups of string column <c>column</c> (GGally's
    ''' <c>ggpairs(aes(colour = group))</c>); an empty palette uses the default level palette.
