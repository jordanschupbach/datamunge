    ''' <summary>
    ''' All rational roots of p, via the Rational Root Theorem: every rational root a/b in
    ''' lowest terms has a dividing the constant term and b dividing the leading coefficient,
    ''' so trying every such ratio (after first dividing out any factors of x, i.e. any
    ''' roots at exactly 0) finds every rational root exactly -- a finite, exact search, in
    ''' contrast to real_roots()'s numeric bisection or complex_roots()'s general iteration.
    ''' </summary>
    ''' <remarks>
    ''' <para>Uses the C++ default for <c>tolerance = 1e-09</c>.</para>
    ''' </remarks>
    ''' <param name="p"></param>
    ''' <exception cref="NativeException">C++ <c>std::invalid_argument</c>: if p's coefficients are not within <c>tolerance</c> of integers.</exception>
    Public Shared Function RationalRoots(p As Polynomial) As List(Of Double)
        Return Rosetta.Cast(Of List(Of Double))(Rosetta.Run(28, p))
    End Function

    ''' <summary>
    ''' All rational roots of p, via the Rational Root Theorem: every rational root a/b in
    ''' lowest terms has a dividing the constant term and b dividing the leading coefficient,
    ''' so trying every such ratio (after first dividing out any factors of x, i.e. any
    ''' roots at exactly 0) finds every rational root exactly -- a finite, exact search, in
    ''' contrast to real_roots()'s numeric bisection or complex_roots()'s general iteration.
    ''' </summary>
    ''' <param name="p"></param>
    ''' <param name="tolerance">Used both to verify p's coefficients are within <c>tolerance</c> of integers (required for the theorem to apply) and to test each candidate ratio's residual.</param>
    ''' <exception cref="NativeException">C++ <c>std::invalid_argument</c>: if p's coefficients are not within <c>tolerance</c> of integers.</exception>
    Public Shared Function RationalRoots(p As Polynomial, tolerance As Double) As List(Of Double)
        Return Rosetta.Cast(Of List(Of Double))(Rosetta.Run(28, p, tolerance))
    End Function

    ''' <summary>
    ''' Yun's algorithm: factors p (char-0 coefficients, doubles here) into square-free
    ''' pieces, each paired with its multiplicity, such that p equals the product of
    ''' <c>factor_i ^ multiplicity_i</c> up to an overall constant. Each returned <c>factor</c> is
    ''' itself square-free (no repeated roots) and the <c>multiplicity</c>-i factors are pairwise
    ''' coprime.
    ''' </summary>
    ''' <param name="p"></param>
    Public Shared Function SquareFreeFactorization(p As Polynomial) As List(Of SquareFreeFactor)
        Return Rosetta.Cast(Of List(Of SquareFreeFactor))(Rosetta.Run(29, p))
    End Function

    ''' <summary>
    ''' Factors p over the reals: splits it into square-free pieces via
    ''' square_free_factorization() (each with its own multiplicity), then finds every root
    ''' of each piece via complex_roots() -- safe here since a square-free piece has, by
    ''' construction, only distinct roots, exactly the case complex_roots() converges best
    ''' on -- and pairs up complex-conjugate roots into real quadratic factors, leaving real
    ''' roots as linear factors. This is the numeric analog of "factor()" in an exact CAS:
    ''' for a floating-point polynomial with no assumed rational structure, linear and
    ''' quadratic real factors are as far as factoring over R can go (see rational_roots()
    ''' for an exact search restricted to genuinely rational roots instead).
    ''' </summary>
    ''' <remarks>
    ''' <para>Uses the C++ default for <c>conjugateTolerance = 1e-06</c>.</para>
    ''' </remarks>
    ''' <param name="p"></param>
    Public Shared Function FactorOverReals(p As Polynomial) As RealFactorization
        Return Rosetta.Cast(Of RealFactorization)(Rosetta.Run(30, p))
    End Function

    ''' <summary>
    ''' Factors p over the reals: splits it into square-free pieces via
