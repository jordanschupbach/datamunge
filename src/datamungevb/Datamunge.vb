    ''' <exception cref="NativeException">C++ <c>std::invalid_argument</c>: If input is empty or nonfinite.</exception>
    ''' <exception cref="NativeException">C++ <c>std::overflow_error</c>: If rebuilt center/radius is unrepresentable.</exception>
    Public Shared Function MinEnclosingCircle(points As IEnumerable(Of Point2D)) As Circle
        Return Rosetta.Cast(Of Circle)(Rosetta.Run(141, points))
    End Function

