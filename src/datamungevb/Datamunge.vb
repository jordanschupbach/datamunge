    ''' <summary>
    ''' Adjust a vector of p-values for multiple comparisons, matching R's p.adjust().
    ''' </summary>
    ''' <remarks>
    ''' <para>- Bonferroni: p[i] * n, capped at 1 -- simplest and most conservative FWER control.
    ''' - Holm: step-down Bonferroni (Holm-Bonferroni) -- uniformly more powerful than
    '''   plain Bonferroni while still controlling FWER, no extra assumptions.
    ''' - Hochberg: step-up FWER control -- more powerful than Holm, but assumes the test
    '''   statistics are independent (or positively dependent).
    ''' - Hommel: step-up FWER control, uniformly more powerful than Hochberg under the
    '''   same independence assumption; the most expensive to compute (O(n^2)). For n == 2
    '''   this degenerates to (and is computed as) Hochberg, matching R.
    ''' - BH (Benjamini-Hochberg, aka "fdr" in R): controls the false discovery rate under
    '''   independence or positive regression dependence -- the standard choice for large-
    '''   scale testing (e.g. genomics, many simultaneous hypothesis tests).
    ''' - BY (Benjamini-Yekutieli): controls the FDR under arbitrary dependence; more
    '''   conservative than BH.
    ''' - None: returns the input p-values unchanged.</para>
    ''' <para>As in R, a single p-value (n &lt;= 1) is always returned unchanged regardless of
    ''' <c>method</c>.</para>
    ''' <para>Uses the C++ default for <c>method = PAdjustMethod.BH</c>.</para>
    ''' </remarks>
    ''' <param name="p"></param>
    Public Shared Function PAdjust(p As IEnumerable(Of Double)) As List(Of Double)
        Return Rosetta.Cast(Of List(Of Double))(Rosetta.Run(190, p))
    End Function

    ''' <summary>
    ''' Adjust a vector of p-values for multiple comparisons, matching R's p.adjust().
    ''' </summary>
    ''' <remarks>
    ''' <para>- Bonferroni: p[i] * n, capped at 1 -- simplest and most conservative FWER control.
    ''' - Holm: step-down Bonferroni (Holm-Bonferroni) -- uniformly more powerful than
    '''   plain Bonferroni while still controlling FWER, no extra assumptions.
    ''' - Hochberg: step-up FWER control -- more powerful than Holm, but assumes the test
    '''   statistics are independent (or positively dependent).
    ''' - Hommel: step-up FWER control, uniformly more powerful than Hochberg under the
    '''   same independence assumption; the most expensive to compute (O(n^2)). For n == 2
    '''   this degenerates to (and is computed as) Hochberg, matching R.
    ''' - BH (Benjamini-Hochberg, aka "fdr" in R): controls the false discovery rate under
    '''   independence or positive regression dependence -- the standard choice for large-
    '''   scale testing (e.g. genomics, many simultaneous hypothesis tests).
    ''' - BY (Benjamini-Yekutieli): controls the FDR under arbitrary dependence; more
    '''   conservative than BH.
    ''' - None: returns the input p-values unchanged.</para>
    ''' <para>As in R, a single p-value (n &lt;= 1) is always returned unchanged regardless of
    ''' <c>method</c>.</para>
    ''' </remarks>
    ''' <param name="p"></param>
    ''' <param name="method"></param>
    Public Shared Function PAdjust(p As IEnumerable(Of Double), method As PAdjustMethod) As List(Of Double)
        Return Rosetta.Cast(Of List(Of Double))(Rosetta.Run(190, p, method))
    End Function

    ''' <summary>
    ''' p_adjust() with the method given by name, like R's <c>p.adjust(p, method = "holm")</c>.
    ''' </summary>
    ''' <remarks>
    ''' <para>Equivalent to <c>p_adjust(p, p_adjust_method(method))</c>; see p_adjust_method() for the accepted
    ''' names. The input is unchanged and the result keeps its order.</para>
    ''' <para><b>Example</b></para>
    ''' <code>
    ''' const auto adj = dm::stats::p_adjust({0.01, 0.02, 0.04}, "bonferroni");
    ''' std::print("{:.2f} {:.2f} {:.2f}\n", adj[0], adj[1], adj[2]);   // 0.03 0.06 0.12
    ''' </code>
    ''' <para><b>References</b></para>
    ''' <para>- https://stat.ethz.ch/R-manual/R-devel/library/stats/html/p.adjust.html</para>
    ''' <para>See also: <c>p_adjust(const std::vector&lt;double&gt;&amp;</c>, <c>PAdjustMethod)</c>, <c>p_adjust_method()</c>.</para>
    ''' </remarks>
    ''' <param name="p">p-values in [0, 1].</param>
    ''' <param name="method">Method name, e.g. "bonferroni", "holm", "BH".</param>
    ''' <returns>The adjusted p-values, in input order.</returns>
    ''' <exception cref="NativeException">C++ <c>std::invalid_argument</c>: An unknown method name.</exception>
    Public Shared Function PAdjust(p As IEnumerable(Of Double), method As String) As List(Of Double)
        Return Rosetta.Cast(Of List(Of Double))(Rosetta.Run(190, p, method))
    End Function

    ''' <summary>
    ''' Parses an adjustment method name, like R's p.adjust.methods.
    ''' </summary>
    ''' <remarks>
    ''' <para>Case-insensitive. Accepts R's names "holm", "hochberg", "hommel", "bonferroni", "BH", "BY",
    ''' "fdr" (an alias of BH, as in R) and "none". Tukey's HSD is not a p-value adjustment (it
    ''' needs the group means, sizes and pooled variance), so it is not accepted here.</para>
    ''' <para><b>Example</b></para>
    ''' <code>
    ''' const bool holm = dm::stats::p_adjust_method("Holm") == dm::stats::PAdjustMethod::Holm;
    ''' std::print("{}\n", holm);   // true
    ''' </code>
    ''' <para><b>References</b></para>
    ''' <para>- https://stat.ethz.ch/R-manual/R-devel/library/stats/html/p.adjust.html</para>
    ''' <para>See also: <c>p_adjust()</c>.</para>
    ''' </remarks>
    ''' <param name="name">Method name.</param>
    ''' <returns>The matching PAdjustMethod.</returns>
    ''' <exception cref="NativeException">C++ <c>std::invalid_argument</c>: An unknown name; the message lists the accepted names.</exception>
    Public Shared Function PAdjustMethod(name As String) As PAdjustMethod
        Return Rosetta.Cast(Of PAdjustMethod)(Rosetta.Run(191, name))
    End Function

    ''' <summary>
    ''' Westfall-Young single-step minP adjustment (Westfall &amp; Young, 1993) -- a resampling-
    ''' based FWER correction that accounts for the actual dependence structure between
    ''' tests (unlike the analytic methods above, which either assume independence or make
    ''' no assumption at all).
    ''' </summary>
    ''' <remarks>
    ''' <para><c>resampled_p</c> is a B x m matrix: row b holds the m p-values recomputed on the
    ''' b-th permutation or bootstrap resample (generated by the caller -- this function is
    ''' purely the combinatorial engine, not the resampling scheme itself). <c>sorted_p</c> is
    ''' the m original p-values sorted ascending, and column k of every row in <c>resampled_p</c>
    ''' must correspond to the same hypothesis as sorted_p[k] (i.e. the caller sorts once and
    ''' reorders both consistently before calling).</para>
    ''' <para>Single-step: every hypothesis is compared against the same reference distribution --
    ''' the per-resample minimum p-value taken over *all* m hypotheses -- so adjusted p[k] =
    ''' (fraction of resamples whose overall minimum p-value &lt;= sorted_p[k]). This is
    ''' automatically monotonic in sorted_p and valid under subset pivotality, but less
    ''' powerful than the step-down refinement below since it never narrows the comparison
    ''' set as hypotheses are resolved.</para>
    ''' <para>Returned in the same (ascending sorted_p) order as the input; the caller is
    ''' responsible for mapping back to original hypothesis order if needed.</para>
    ''' </remarks>
    ''' <param name="resampledP"></param>
    ''' <param name="sortedP"></param>
    Public Shared Function WestfallYoungAdjust(resampledP As IEnumerable(Of IEnumerable(Of Double)), sortedP As IEnumerable(Of Double)) As List(Of Double)
        Return Rosetta.Cast(Of List(Of Double))(Rosetta.Run(192, resampledP, sortedP))
    End Function

    ''' <summary>
    ''' Romano-Wolf step-down resampling adjustment (Romano &amp; Wolf, 2005) -- like
    ''' westfall_young_adjust, but more powerful: at each step k (in ascending sorted_p
    ''' order), the reference distribution is the per-resample minimum p-value taken only
    ''' over the *remaining* hypotheses k..m-1, narrowing by one hypothesis at each step
    ''' rather than always using all m. This is the step-down generalization that controls
    ''' FWER without requiring subset pivotality. Monotonicity (adjusted p[k] &gt;= adjusted
    ''' p[k-1]) is enforced explicitly, since narrowing the comparison set at each step means
    ''' it isn't automatic the way it is for the single-step procedure above.
    ''' </summary>
    ''' <remarks>
    ''' <para>Same input/output conventions as westfall_young_adjust: <c>resampled_p</c> is a B x m
    ''' matrix with column k aligned to sorted_p[k], and the result is returned in the same
    ''' sorted order.</para>
    ''' </remarks>
    ''' <param name="resampledP"></param>
    ''' <param name="sortedP"></param>
    Public Shared Function RomanoWolfAdjust(resampledP As IEnumerable(Of IEnumerable(Of Double)), sortedP As IEnumerable(Of Double)) As List(Of Double)
        Return Rosetta.Cast(Of List(Of Double))(Rosetta.Run(193, resampledP, sortedP))
    End Function

    ''' <summary>
    ''' Classical equal-variance one-way ANOVA, like R oneway.test(var.equal=TRUE).
    ''' </summary>
    ''' <remarks>
    ''' <para>Tests equality of group means with between/within mean-square ratio. Independent normal
    ''' observations and a common within-group population variance give the exact F reference. This is
    ''' not Welch ANOVA. O(N) work, O(1) auxiliary storage; input unchanged, no omission or shared
    ''' mutable state.</para>
    ''' <para><b>Example</b></para>
    ''' <code>
    ''' const auto a=dm::stats::one_way_anova({1,2,3,4,5,6,7,8,9},{3,3,3});
    ''' std::print("{:.0f}\n",a.statistic); // 27
    ''' </code>
    ''' <para><b>References</b></para>
    ''' <para>- https://stat.ethz.ch/R-manual/R-devel/library/stats/html/oneway.test.html</para>
    ''' <para>See also: <c>HypothesisTestResult</c>.</para>
    ''' </remarks>
    ''' <param name="values">Finite observations concatenated group by group.</param>
    ''' <param name="groupSizes">At least two positive sizes summing exactly to values.size(); N must exceed the group count.</param>
    ''' <returns>statistic=F, parameter1=k-1, parameter2=N-k and upper-tail p_value; no CI or group estimates.</returns>
    ''' <exception cref="NativeException">C++ <c>std::invalid_argument</c>: Invalid grouping/nonfinite input, no residual df, zero within- group variation or arithmetic overflow.</exception>
    Public Shared Function OneWayAnova(values As IEnumerable(Of Double), groupSizes As IEnumerable(Of ULong)) As HypothesisTestResult
        Return Rosetta.Cast(Of HypothesisTestResult)(Rosetta.Run(194, values, groupSizes))
    End Function

    ''' <summary>
    ''' Welch's one-way test of equal means in independent normal groups with unequal variances.
    ''' </summary>
    ''' <remarks>
    ''' <para>Weights means by inverse estimated sampling variances and uses an approximate F reference.
    ''' Inputs are unchanged. Work is linear in observations with O(k) storage for k groups.</para>
    ''' <para><b>Example</b></para>
    ''' <code>
    ''' const auto fit = dm::stats::welch_anova({1, 2, 4, 3, 6, 9, 12, 15, 3, 4, 5, 5}, {3, 5, 4});
    ''' std::print("{:.4f}\n", fit.statistic); // 4.1238
    ''' </code>
    ''' <para><b>References</b></para>
    ''' <para>- Welch (1951), On the Comparison of Several Mean Values, doi:10.2307/2332579.</para>
    ''' <para>See also: <c>one_way_anova()</c>, <c>games_howell()</c>.</para>
    ''' </remarks>
    ''' <param name="values">Finite observations concatenated by group.</param>
    ''' <param name="groupSizes">At least two groups of size two or larger, each with positive variance.</param>
    ''' <returns>F statistic, numerator and denominator degrees of freedom, and upper-tail p-value.</returns>
    ''' <exception cref="NativeException">C++ <c>std::invalid_argument</c>: Invalid sizes, nonfinite observations, zero variance or overflow.</exception>
    Public Shared Function WelchAnova(values As IEnumerable(Of Double), groupSizes As IEnumerable(Of ULong)) As HypothesisTestResult
