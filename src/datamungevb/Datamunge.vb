    ''' applies Bartlett's finite-sample correction. Inputs are unchanged.</para>
    ''' <para><b>Example</b></para>
    ''' <code>
    ''' const auto fit = dm::stats::bartlett_test({1, 2, 4, 3, 6, 9, 12, 15, 3, 4, 5, 5}, {3, 5, 4});
