    ''' <c>\operatorname{E}\max(t-Y,0)=(t-\mu)\Phi(u)+\sigma\varphi(u)</c> with <c>u=(t-\mu)/\sigma</c>.</para>
    ''' <para><c>\mu</c>.</para>
    ''' <para><c>\sigma\ge0</c>; 0 gives <c>\max(t-\mu,0)</c>.</para>
    ''' <para><c>\xi\ge0</c> an improvement must exceed.</para>
    ''' <para><b>Example</b></para>
    ''' <code>
    ''' std::print("{:.4f}\n", dm::optim::expected_improvement(0.0, 1.0, 0.0));  // 0.3989 = phi(0)
    ''' </code>
    ''' </remarks>
    ''' <param name="mean">Predicted mean</param>
