    ''' </remarks>
    ''' <param name="a">Top-left nonnegative integer count.</param>
    ''' <param name="b">Top-right count.</param>
    ''' <param name="c">Bottom-left count.</param>
    ''' <param name="d">Bottom-right count; total must fit size_t.</param>
    ''' <returns>statistic=a, p_value and estimate1=sample odds ratio a*d/(b*c), not R conditional MLE; denominator zero gives infinity for positive numerator or NaN for 0/0. No confidence interval.</returns>
    ''' <exception cref="NativeException">C++ <c>std::invalid_argument</c>: Count-total overflow or invalid alternative.</exception>
    Public Shared Function FisherExactTest2x2(a As ULong, b As ULong, c As ULong, d As ULong) As HypothesisTestResult
        Return Rosetta.Cast(Of HypothesisTestResult)(Rosetta.Run(208, a, b, c, d))
    End Function

