        Rosetta.Construct(Me, GetType(GibbsSampler), False, 680, options)
    End Sub

    ''' <summary>
    ''' Runs warmup sweeps (adapting each coordinate's step), then num_samples sweeps.
    ''' </summary>
    ''' <param name="logPosterior">Log density up to a constant; only evaluate() is used.</param>
    ''' <param name="initialParams">Starting point.</param>
    ''' <returns>Draws, per-coordinate acceptance rates and step sizes.</returns>
    Public Function Sample(logPosterior As ArbitraryFunction, initialParams As IEnumerable(Of Double)) As GibbsResult
        Return Rosetta.Cast(Of GibbsResult)(Rosetta.Run(678, Me, logPosterior, initialParams))
    End Function

