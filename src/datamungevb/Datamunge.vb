    ''' state.</para>
    ''' <para><b>Example</b></para>
    ''' <code>
    ''' const auto q=dm::stats::chi_squared_test_independence({10,10,10,10},2,2);
    ''' std::print("{:.0f}\n",q.statistic); // 0
    ''' </code>
    ''' <para><b>References</b></para>
    ''' <para>- https://stat.ethz.ch/R-manual/R-devel/library/stats/html/chisq.test.html</para>
    ''' <para>See also: <c>HypothesisTestResult</c>.</para>
    ''' <para>Uses the C++ default for <c>correct = True</c>.</para>
