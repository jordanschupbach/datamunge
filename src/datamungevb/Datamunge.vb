    ''' </remarks>
    ''' <param name="observed">At least two finite nonnegative counts with positive finite total.</param>
    ''' <returns>statistic=X-squared, parameter1=k-1 and approximate upper-tail p_value; no CI.</returns>
    ''' <exception cref="NativeException">C++ <c>std::invalid_argument</c>: Invalid counts/probabilities, sizes or zero/nonfinite total.</exception>
    Public Shared Function ChiSquaredGoodnessOfFit(observed As IEnumerable(Of Double)) As HypothesisTestResult
        Return Rosetta.Cast(Of HypothesisTestResult)(Rosetta.Run(202, observed))
    End Function

