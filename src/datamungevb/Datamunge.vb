    ''' <summary>
    ''' Expected improvement of a Gaussian prediction below an incumbent (minimisation).
    ''' </summary>
    ''' <remarks>
    ''' <para>For <c>Y\sim N(\mu,\sigma^2)</c> and target <c>t=\text{incumbent}-\xi</c>,
    ''' <c>\operatorname{E}\max(t-Y,0)=(t-\mu)\Phi(u)+\sigma\varphi(u)</c> with <c>u=(t-\mu)/\sigma</c>.</para>
    ''' <para><c>\mu</c>.</para>
    ''' <para><c>\sigma\ge0</c>; 0 gives <c>\max(t-\mu,0)</c>.</para>
    ''' <para><c>\xi\ge0</c> an improvement must exceed.</para>
    ''' <para><b>Example</b></para>
    ''' <code>
    ''' std::print("{:.4f}\n", dm::optim::expected_improvement(0.0, 1.0, 0.0));  // 0.3989 = phi(0)
    ''' </code>
    ''' <para>Uses the C++ default for <c>exploration = 0.0</c>.</para>
    ''' </remarks>
    ''' <param name="mean">Predicted mean</param>
    ''' <param name="sd">Predicted standard deviation</param>
    ''' <param name="incumbent">Smallest value observed so far.</param>
    ''' <returns>The expected improvement (never negative).</returns>
    Public Shared Function ExpectedImprovement(mean As Double, sd As Double, incumbent As Double) As Double
        Return Rosetta.Cast(Of Double)(Rosetta.Run(188, mean, sd, incumbent))
    End Function

    ''' <summary>
    ''' Expected improvement of a Gaussian prediction below an incumbent (minimisation).
