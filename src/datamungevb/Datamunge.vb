    ''' <summary>
    ''' Gradient-direction-guided Hough circle transform: for every edge pixel (Sobel
    ''' gradient magnitude &gt;= <c>gradient_threshold</c> on <c>img's</c> grayscale conversion), and
    ''' for every candidate radius in [<c>min_radius</c>, <c>max_radius</c>], votes for the two
    ''' candidate centers at that distance along the pixel's gradient line (handles both
    ''' bright-disk-on-dark and dark-disk-on-bright edge polarity). Each radius gets an
    ''' independent 2D (cx, cy) accumulator and non-max suppression pass -- simpler to
    ''' reason about than a combined 3D (cx, cy, r) accumulator, at the cost of not
    ''' suppressing near-duplicate detections across adjacent radii.
    ''' </summary>
    ''' <remarks>
    ''' <para>Uses the C++ default for <c>gradientThreshold = 5e+01</c>, <c>minVotes = 20</c>, <c>nmsRadius = 10</c>.</para>
    ''' </remarks>
    ''' <param name="img"></param>
    ''' <param name="minRadius"></param>
    ''' <param name="maxRadius"></param>
    Public Shared Function HoughCircles(img As Image, minRadius As Integer, maxRadius As Integer) As List(Of HoughCircle)
        Return Rosetta.Cast(Of List(Of HoughCircle))(Rosetta.Run(81, img, minRadius, maxRadius))
    End Function

    ''' <summary>
    ''' Gradient-direction-guided Hough circle transform: for every edge pixel (Sobel
    ''' gradient magnitude &gt;= <c>gradient_threshold</c> on <c>img's</c> grayscale conversion), and
