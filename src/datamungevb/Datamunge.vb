    ''' <summary>
    ''' Inserts knots into a clamped B-spline basis (Oslo algorithm).
    ''' </summary>
    ''' <remarks>
    ''' <para>Builds the refined knot vector (old knots merged with <c>inserted_knots</c>) and the sparse
    ''' discrete-B-spline operator that re-expresses every coarse spline on it exactly. Each
    ''' row has at most degree + 1 nonzeros and the work is O(m p^2) for m refined functions.</para>
    ''' <para><b>Example</b></para>
    ''' <code>
    ''' auto coarse = dm::fda::BSplineBasis::open_uniform(1, 2);   // knots 0 0 1 1
    ''' auto r = dm::fda::refine_basis(coarse, {0.25});
    ''' std::print("{}\n", r.apply({0.0, 4.0}));                   // [0, 1, 4]
    ''' </code>
    ''' <para><b>References</b></para>
    ''' <para>- E. Cohen, T. Lyche and R. Riesenfeld (1980). Discrete B-splines and subdivision
    '''   techniques in computer-aided geometric design and computer graphics. Computer Graphics
    '''   and Image Processing 14(2), 87-111. https://doi.org/10.1016/0146-664X(80)90040-4
    ''' - W. Boehm (1980). Inserting new knots into B-spline curves. Computer-Aided Design
    '''   12(4), 199-201. https://doi.org/10.1016/0010-4485(80)90154-2</para>
    ''' <para>See also: <c>dyadic_refine()</c>.</para>
    ''' </remarks>
    ''' <param name="basis">Basis to refine; its knot vector must be clamped (first and last knots repeated degree + 1 times, as produced by BSplineBasis::open_uniform()).</param>
    ''' <param name="insertedKnots">Knots to add, strictly inside the domain, in any order. Repeats are allowed while every knot multiplicity stays &lt;= degree + 1.</param>
    ''' <returns>The refined basis and its refinement operator.</returns>
    ''' <exception cref="NativeException">C++ <c>std::invalid_argument</c>: If the basis is not clamped, a knot is outside the open domain or non-finite, or a multiplicity would exceed degree + 1.</exception>
    Public Shared Function RefineBasis(basis As BSplineBasis, insertedKnots As IEnumerable(Of Double)) As BSplineRefinement
        Return Rosetta.Cast(Of BSplineRefinement)(Rosetta.Run(255, basis, insertedKnots))
    End Function

    ''' <summary>
    ''' Halves every knot span of a clamped basis (inserts each positive span's midpoint).
    ''' </summary>
    ''' <remarks>
    ''' <para>This is the nested-space step between consecutive levels of HB/THB splines: the refined
    ''' space contains the coarse one, and the operator maps coefficients exactly.</para>
    ''' <para><b>Example</b></para>
    ''' <code>
    ''' auto r = dm::fda::dyadic_refine(dm::fda::BSplineBasis::open_uniform(3, 5));
    ''' std::print("{} -&gt; {}\n", 5, r.basis.basis_size()); // 5 -&gt; 7
    ''' </code>
    ''' <para><b>References</b></para>
    ''' <para>- E. Cohen, T. Lyche and R. Riesenfeld (1980). Discrete B-splines and subdivision
    '''   techniques in computer-aided geometric design and computer graphics.
    '''   https://doi.org/10.1016/0146-664X(80)90040-4</para>
    ''' <para>See also: <c>refine_basis()</c>, <c>TensorBSpline::dyadic_refine()</c>.</para>
    ''' </remarks>
    ''' <param name="basis">Clamped basis to refine.</param>
    ''' <returns>The refined basis and its refinement operator.</returns>
    ''' <exception cref="NativeException">C++ <c>std::invalid_argument</c>: If the basis is not clamped.</exception>
    Public Shared Function DyadicRefine(basis As BSplineBasis) As BSplineRefinement
        Return Rosetta.Cast(Of BSplineRefinement)(Rosetta.Run(256, basis))
    End Function

    ''' <summary>
    ''' Fits a tensor-product B-spline to scattered data by ordinary least squares.
    ''' </summary>
    ''' <remarks>
    ''' <para>Builds the sparse design B (each row has at most prod(degree_k + 1) nonzeros), then
    ''' solves (B^T B) c = B^T y. Coordinates outside a basis domain are clamped to it.</para>
    ''' <para><b>Example</b></para>
    ''' <code>
    ''' auto b = dm::fda::BSplineBasis::open_uniform(1, 2);
    ''' auto f = dm::fda::fit_tensor_bspline({b}, {{0.0}, {0.5}, {1.0}}, {1.0, 2.0, 3.0});
    ''' std::print("{:.3f}\n", f.evaluate(0.25)); // 1.500
    ''' </code>
    ''' <para><b>References</b></para>
    ''' <para>- C. de Boor (2001). A Practical Guide to Splines, revised edition. Springer.</para>
    ''' <para>See also: <c>fit_tensor_pspline()</c>.</para>
    ''' <para>Uses the C++ default for <c>options = Nothing</c>.</para>
    ''' </remarks>
    ''' <param name="bases">One basis per dimension.</param>
    ''' <param name="points">Sample locations, each of length bases.size().</param>
    ''' <param name="values">One response per point.</param>
    ''' <returns>The fitted spline.</returns>
    ''' <exception cref="NativeException">C++ <c>std::invalid_argument</c>: On empty or mismatched inputs, or non-finite data.</exception>
    ''' <exception cref="NativeException">C++ <c>std::runtime_error</c>: If the normal equations are singular (some basis function has too little data; use a penalized fit or fewer functions).</exception>
    Public Shared Function FitTensorBspline(bases As IEnumerable(Of BSplineBasis), points As IEnumerable(Of IEnumerable(Of Double)), values As IEnumerable(Of Double)) As TensorBSpline
        Return Rosetta.Cast(Of TensorBSpline)(Rosetta.Run(257, bases, points, values))
    End Function

    ''' <summary>
    ''' Fits a tensor-product B-spline to scattered data by ordinary least squares.
    ''' </summary>
    ''' <remarks>
    ''' <para>Builds the sparse design B (each row has at most prod(degree_k + 1) nonzeros), then
    ''' solves (B^T B) c = B^T y. Coordinates outside a basis domain are clamped to it.</para>
    ''' <para><b>Example</b></para>
    ''' <code>
