    ''' <summary>
    ''' Tests group scale with Levene's mean or Brown–Forsythe's median centering.
    ''' </summary>
    ''' <remarks>
    ''' <para>Runs one-way ANOVA on absolute within-group deviations. Independent observations
    ''' and comparable group distribution shapes support interpreting the result as a scale test.</para>
    ''' <para><b>Example</b></para>
    ''' <code>
    ''' const auto fit = dm::stats::levene_test({1, 2, 4, 3, 6, 9, 12, 15, 3, 4, 5, 5}, {3, 5, 4});
    ''' std::print("{:.3f}\n", fit.statistic); // 3.550
    ''' </code>
    ''' <para><b>References</b></para>
    ''' <para>- Brown and Forsythe (1974), Robust Tests for the Equality of Variances,
    '''   doi:10.1080/01621459.1974.10482955.
    ''' - https://docs.scipy.org/doc/scipy/reference/generated/scipy.stats.levene.html</para>
    ''' <para>See also: <c>bartlett_test()</c>, <c>fligner_killeen_test()</c>.</para>
    ''' <para>Uses the C++ default for <c>medianCenter = True</c>.</para>
    ''' </remarks>
    ''' <param name="values">Finite observations concatenated by group.</param>
    ''' <param name="groupSizes">At least two groups of size two or larger partitioning values.</param>
    ''' <returns>F statistic, two degrees of freedom and an approximate upper-tail p-value.</returns>
    ''' <exception cref="NativeException">C++ <c>std::invalid_argument</c>: Invalid inputs, zero residual deviation variance or overflow.</exception>
    Public Shared Function LeveneTest(values As IEnumerable(Of Double), groupSizes As IEnumerable(Of ULong)) As HypothesisTestResult
        Return Rosetta.Cast(Of HypothesisTestResult)(Rosetta.Run(197, values, groupSizes))
    End Function

