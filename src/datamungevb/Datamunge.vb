    ''' <summary>
    ''' Integrate one HMC proposal with fixed step size and caller-provided momentum.
    ''' The mass matrix is the identity. The caller can apply the Metropolis
    ''' correction by accepting when log(uniform) is less than -energy_change.
    ''' </summary>
    ''' <remarks>
    ''' <code>
    ''' dm::bayes::AutodiffModel density([](auto&amp;, const auto&amp; q) { return -.5 * q[0] * q[0]; });
    ''' auto proposal = dm::bayes::hmc_proposal(density, {1.0}, {0.0}, .1, 10);
    ''' </code>
    ''' <para>See also: <c>HMC</c>, <c>leapfrog_gaussian_acceptance()</c>.</para>
    ''' </remarks>
    ''' <param name="logPosterior">Differentiable log density, up to an additive constant.</param>
    ''' <param name="position">Finite initial position on the unconstrained scale.</param>
    ''' <param name="momentum">Finite initial momentum with the same dimension.</param>
    ''' <param name="stepSize">Positive finite leapfrog step size.</param>
    ''' <param name="numSteps">Positive number of leapfrog steps.</param>
    ''' <returns>Proposed position and momentum and their signed energy change. Nonfinite proposed energy is reported as computed for divergence diagnostics.</returns>
    ''' <exception cref="NativeException">C++ <c>std::invalid_argument</c>: Invalid dimensions, inputs or step size.</exception>
    Public Shared Function HmcProposal(logPosterior As DifferentiableFunction, position As IEnumerable(Of Double), momentum As IEnumerable(Of Double), stepSize As Double, numSteps As ULong) As HMCProposal
        Return Rosetta.Cast(Of HMCProposal)(Rosetta.Run(62, logPosterior, position, momentum, stepSize, numSteps))
    End Function

    ''' <summary>
    ''' Exact expected Metropolis acceptance of one HMC proposal (fixed step size and
    ''' number of leapfrog steps, unit mass) on a one-dimensional
    ''' </summary>
    ''' <remarks>
    ''' <para><c>N(m,s^2)</c> target, started
    ''' in equilibrium.</para>
    ''' <para>In scaled coordinates <c>x=((q-m)/s,\,p)</c> each leapfrog step is the linear map
    ''' <c>M=\begin{pmatrix}1&amp;0\\-h/2&amp;1\end{pmatrix}\begin{pmatrix}1&amp;h\\0&amp;1\end{pmatrix}\begin{pmatrix}1&amp;0\\-h/2&amp;1\end{pmatrix}</c>
    ''' with <c>h=\varepsilon/s</c>, <c>\det M=1</c> and <c>\operatorname{tr}M=2-h^2</c>, so it is stable
    ''' exactly when <c>\varepsilon&lt;2s</c>. Writing <c>x_0=r(\cos\phi,\sin\phi)</c> the energy error is
    ''' <c>\Delta H=r^2f(\phi)</c> with <c>f=\tfrac12(|M^L(\cos\phi,\sin\phi)|^2-1)</c>, and because
    ''' <c>r^2/2\sim\text{Exp}(1)</c> the radial average of <c>\min(1,e^{-\Delta H})</c> is
    ''' <c>1/(1+2f)</c> for <c>f&gt;0</c> and 1 otherwise. The angle is integrated numerically.</para>
    ''' <para><c>\varepsilon&gt;0</c>.</para>
    ''' <para><c>L\geq1</c>.</para>
    ''' <para><c>s&gt;0</c>.</para>
    ''' <para>Uses the C++ default for <c>angles = 4096</c>.</para>
    ''' </remarks>
    ''' <param name="stepSize">Leapfrog step size</param>
    ''' <param name="numSteps">Number of leapfrog steps</param>
    ''' <param name="sd">Target standard deviation</param>
    ''' <returns>The expected acceptance probability.</returns>
    ''' <exception cref="NativeException">C++ <c>std::invalid_argument</c>: for non-positive arguments.</exception>
    Public Shared Function LeapfrogGaussianAcceptance(stepSize As Double, numSteps As ULong, sd As Double) As Double
        Return Rosetta.Cast(Of Double)(Rosetta.Run(63, stepSize, numSteps, sd))
    End Function

    ''' <summary>
    ''' Exact expected Metropolis acceptance of one HMC proposal (fixed step size and
    ''' number of leapfrog steps, unit mass) on a one-dimensional
    ''' </summary>
    ''' <remarks>
    ''' <para><c>N(m,s^2)</c> target, started
    ''' in equilibrium.</para>
    ''' <para>In scaled coordinates <c>x=((q-m)/s,\,p)</c> each leapfrog step is the linear map
    ''' <c>M=\begin{pmatrix}1&amp;0\\-h/2&amp;1\end{pmatrix}\begin{pmatrix}1&amp;h\\0&amp;1\end{pmatrix}\begin{pmatrix}1&amp;0\\-h/2&amp;1\end{pmatrix}</c>
    ''' with <c>h=\varepsilon/s</c>, <c>\det M=1</c> and <c>\operatorname{tr}M=2-h^2</c>, so it is stable
    ''' exactly when <c>\varepsilon&lt;2s</c>. Writing <c>x_0=r(\cos\phi,\sin\phi)</c> the energy error is
    ''' <c>\Delta H=r^2f(\phi)</c> with <c>f=\tfrac12(|M^L(\cos\phi,\sin\phi)|^2-1)</c>, and because
    ''' <c>r^2/2\sim\text{Exp}(1)</c> the radial average of <c>\min(1,e^{-\Delta H})</c> is
    ''' <c>1/(1+2f)</c> for <c>f&gt;0</c> and 1 otherwise. The angle is integrated numerically.</para>
    ''' <para><c>\varepsilon&gt;0</c>.</para>
    ''' <para><c>L\geq1</c>.</para>
    ''' <para><c>s&gt;0</c>.</para>
    ''' </remarks>
    ''' <param name="stepSize">Leapfrog step size</param>
    ''' <param name="numSteps">Number of leapfrog steps</param>
