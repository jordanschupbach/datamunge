    End Function

    ''' <summary>
    ''' Number of irreducible factors of a monic square-free polynomial over GF(p), by
    ''' Berlekamp's theorem: the dimension of the null space of
    ''' </summary>
    ''' <remarks>
    ''' <para><c>(Q-I)^{\mathsf T}</c>, that is
    ''' <c>n-\operatorname{rank}(Q-I)</c>. A square-free polynomial is irreducible exactly when it is 1.</para>
    ''' </remarks>
    ''' <param name="poly">ascending coefficients (made monic and reduced mod p first).</param>
    ''' <param name="p">a prime.</param>
    ''' <returns>the number of distinct irreducible factors (for square-free input).</returns>
    ''' <exception cref="NativeException">C++ <c>std::invalid_argument</c>: if poly is constant.</exception>
    Public Shared Function BerlekampFactorCount(poly As IEnumerable(Of Long), p As Long) As Integer
        Return Rosetta.Cast(Of Integer)(Rosetta.Run(50, poly, p))
    End Function

    ''' <summary>
    ''' Complete factorization of a polynomial over GF(p): leading coefficient times monic
    ''' irreducible factors with multiplicities. The square-free decomposition separates
    ''' repeated factors (taking p-th roots where the derivative vanishes), and Berlekamp's
    ''' algorithm splits each square-free part.
    ''' </summary>
    ''' <param name="poly">ascending coefficients; reduced mod p first.</param>
    ''' <param name="p">a prime.</param>
    ''' <returns>the leading coefficient, the factors and their multiplicities.</returns>
    ''' <exception cref="NativeException">C++ <c>std::invalid_argument</c>: for the zero polynomial.</exception>
