    ''' <para><b>Example</b></para>
    ''' <code>
    ''' const auto h=dm::geometry::convex_hull({{0,0},{2,0},{2,2},{0,2},{1,1}});
    ''' std::cout &lt;&lt; h.size(); // 4
    ''' </code>
    ''' <para><b>References</b></para>
    ''' <para>- A. M. Andrew (1979), Another efficient algorithm for convex hulls in two
    '''   dimensions, https://doi.org/10.1016/0020-0190(79)90072-3 .</para>
    ''' <para>See also: <c>convex_hull_analyze()</c>, <c>convex_hull_trace()</c>, <c>orientation_sign()</c>.</para>
    ''' </remarks>
    ''' <param name="points">Finite planar records, copied by value as in the original API.</param>
    ''' <returns>Owned strict hull of the represented coordinates.</returns>
    ''' <exception cref="NativeException">C++ <c>std::invalid_argument</c>: Any nonfinite coordinate.</exception>
    ''' <exception cref="NativeException">C++ <c>std::length_error</c>: Work/container size exhaustion.</exception>
    Public Shared Function ConvexHull(points As IEnumerable(Of Point2D)) As List(Of Point2D)
        Return Rosetta.Cast(Of List(Of Point2D))(Rosetta.Run(130, points))
    End Function

