''' <summary>
''' An owned B-rep solid with value-returning modelling and export operations.
''' Geometry uses doubles in caller-selected consistent units. Copies own topology;
''' immutable surfaces may be shared. Operations return new solids, preserving inputs.
''' Unsupported kernel operations throw std::runtime_error with the kernel diagnostic.
''' Concurrent const access is safe; do not mutate a shared object concurrently.
''' </summary>
''' <remarks>
''' <para><b>Example</b></para>
''' <code>
''' auto block = dm::cad::Solid::box(4, 3, 2);
''' auto hole = dm::cad::Solid::cylinder(.4, 4).translated(2, 1.5, -1);
''' auto part = block.subtracted(hole);
''' part.save("part.step");
''' </code>
''' <para>See also: <c>Model</c>, <c>FeatureTree</c>, <c>load_scene()</c>.</para>
''' </remarks>
Partial Public Class CadSolid
    Inherits NativeObject
    Friend Sub New(raw As NativeRaw)
        MyBase.New(raw)
    End Sub

    ''' <summary>
    ''' Construct an axis-aligned box with minimum corner at the origin.
    ''' </summary>
    ''' <remarks>
    ''' <para><b>Example</b></para>
    ''' <para>See the class example.</para>
    ''' </remarks>
    ''' <param name="width">Positive finite X extent.</param>
    ''' <param name="depth">Positive finite Y extent.</param>
    ''' <param name="height">Positive finite Z extent.</param>
    ''' <returns>Owned solid.</returns>
    ''' <exception cref="NativeException">C++ <c>std::invalid_argument</c>: Nonpositive/nonfinite size.</exception>
    Public Shared Function Box(width As Double, depth As Double, height As Double) As CadSolid
        Return Rosetta.Cast(Of CadSolid)(Rosetta.Run(3279, width, depth, height))
    End Function

    ''' <summary>
    ''' Construct a cylinder with base at the origin and axis +Z.
    ''' </summary>
    ''' <remarks>
    ''' <para><b>Example</b></para>
    ''' <para>See the class example.</para>
    ''' </remarks>
    ''' <param name="radius">Positive finite radius.</param>
    ''' <param name="height">Positive finite height.</param>
    ''' <returns>Owned solid.</returns>
    ''' <exception cref="NativeException">C++ <c>std::invalid_argument</c>: Invalid dimensions.</exception>
    Public Shared Function Cylinder(radius As Double, height As Double) As CadSolid
        Return Rosetta.Cast(Of CadSolid)(Rosetta.Run(3280, radius, height))
    End Function

    ''' <summary>
    ''' Construct a sphere centred at the origin.
    ''' </summary>
    ''' <remarks>
    ''' <para><b>Example</b></para>
    ''' <code>
    ''' auto ball = dm::cad::Solid::sphere(2).translated(0, 0, 2);
    ''' </code>
    ''' </remarks>
    ''' <param name="radius">Positive finite radius.</param>
    ''' <returns>Owned solid.</returns>
    ''' <exception cref="NativeException">C++ <c>std::invalid_argument</c>: Invalid radius.</exception>
    Public Shared Function Sphere(radius As Double) As CadSolid
        Return Rosetta.Cast(Of CadSolid)(Rosetta.Run(3281, radius))
    End Function

    ''' <summary>
    ''' Construct a ring torus centred at the origin around +Z.
    ''' </summary>
    ''' <remarks>
    ''' <para><b>Example</b></para>
    ''' <code>
    ''' auto ring = dm::cad::Solid::torus(3, 1);
    ''' </code>
    ''' </remarks>
    ''' <param name="majorRadius">Positive finite distance from axis to tube centre.</param>
    ''' <param name="minorRadius">Positive finite tube radius smaller than major_radius.</param>
    ''' <returns>Owned solid.</returns>
    ''' <exception cref="NativeException">C++ <c>std::invalid_argument</c>: Invalid radii.</exception>
    Public Shared Function Torus(majorRadius As Double, minorRadius As Double) As CadSolid
        Return Rosetta.Cast(Of CadSolid)(Rosetta.Run(3282, majorRadius, minorRadius))
    End Function

    ''' <summary>
    ''' Return the union with another solid.
    ''' </summary>
    ''' <remarks>
    ''' <para><b>Example</b></para>
    ''' <code>
    ''' auto a = dm::cad::Solid::box(2, 2, 2);
    ''' auto b = a.translated(.5, .5, .5);
    ''' auto joined = a.united(b);
    ''' </code>
    ''' </remarks>
    ''' <param name="other">Borrowed operand, in the same units/frame.</param>
    ''' <returns>New solid; inputs unchanged.</returns>
    ''' <exception cref="NativeException">C++ <c>std::runtime_error</c>: Kernel failure.</exception>
    Public Function United(other As CadSolid) As CadSolid
        Return Rosetta.Cast(Of CadSolid)(Rosetta.Run(3283, Me, other))
    End Function

    ''' <summary>
