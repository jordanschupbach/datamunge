    ''' <summary>
    ''' The two points where the infinite line <c>line</c> crosses the border of a <c>image_width</c>
    ''' x <c>image_height</c> image, for drawing/visualization. Returns false (and
    ''' leaves the output points unchanged) if the line doesn't intersect the image
    ''' rectangle at all (only possible for a line entirely outside it).
    ''' </summary>
    ''' <param name="line"></param>
    ''' <param name="imageWidth"></param>
    ''' <param name="imageHeight"></param>
    ''' <param name="p1"></param>
    ''' <param name="p2"></param>
    Public Shared Function LineEndpoints(line As HoughLine, imageWidth As Integer, imageHeight As Integer, ByRef p1 As (Integer, Integer), ByRef p2 As (Integer, Integer)) As Boolean
        Dim _slot3 As New Rosetta.Slot(p1)
        Dim _slot4 As New Rosetta.Slot(p2)
        Dim _result = Rosetta.Cast(Of Boolean)(Rosetta.Run(79, line, imageWidth, imageHeight, _slot3, _slot4))
        p1 = Rosetta.Cast(Of (Integer, Integer))(_slot3.Value)
        p2 = Rosetta.Cast(Of (Integer, Integer))(_slot4.Value)
        Return _result
    End Function

    ''' <summary>
    ''' Standard Hough line transform: every pixel of <c>img</c> whose grayscale luma is &gt;= <c>edge_threshold</c>
    ''' votes, in a rho-theta accumulator (theta stepped every degree over
    ''' [0, pi), rho stepped every pixel over the image's diagonal range), for every line
    ''' that could pass through it. Returns every accumulator cell with at least <c>min_votes</c>,
    ''' non-max-suppressed within a (2*nms_radius+1) rho-theta cell window so a
    ''' single real line doesn't produce a cluster of near-duplicate near-identical results.
    ''' Intended input is an edge map (e.g. image::sobel_edges()'s output), not a raw photo.
    ''' </summary>
    ''' <remarks>
    ''' <para>Uses the C++ default for <c>edgeThreshold = 128</c>, <c>minVotes = 50</c>, <c>nmsRadius = 5</c>.</para>
    ''' </remarks>
    ''' <param name="img"></param>
    Public Shared Function HoughLines(img As Image) As List(Of HoughLine)
        Return Rosetta.Cast(Of List(Of HoughLine))(Rosetta.Run(80, img))
    End Function

