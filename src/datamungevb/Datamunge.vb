    ''' <summary>
    ''' Chinese Remainder Theorem: the unique x in [0, product(moduli)) such that
    ''' <c>x == remainders[i] (mod moduli[i])</c> for every i, given pairwise-coprime positive
    ''' moduli.
    ''' </summary>
    ''' <param name="remainders"></param>
    ''' <param name="moduli"></param>
    ''' <exception cref="NativeException">C++ <c>std::invalid_argument</c>: if sizes disagree, are empty, a modulus is non-positive, the moduli aren't pairwise coprime, or the combined modulus would exceed 2^53 (past the point a double can represent every integer exactly).</exception>
    Public Shared Function Crt(remainders As IEnumerable(Of Double), moduli As IEnumerable(Of Double)) As Double
