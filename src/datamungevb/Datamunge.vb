    End Function

    ''' <summary>
    ''' Tie-corrected Kruskal-Wallis rank test, like R kruskal.test().
    ''' </summary>
    ''' <remarks>
    ''' <para>Ranks the pooled observations with average ties and uses the chi-square(k-1) approximation.
    ''' The usual exchangeability null is identical independent group distributions; a common-shape
    ''' shift model permits a location interpretation. It is not an omnibus test for every possible
    ''' distributional difference. Small groups can invalidate the approximation. O(N log N) work/O(N)
    ''' space, no mutation, omission or shared state.</para>
    ''' <para><b>Example</b></para>
    ''' <code>
    ''' const auto h=dm::stats::kruskal_wallis_test({1,2,3,4,5,6,7,8,9},{3,3,3});
    ''' std::print("{:.1f}\n",h.statistic); // 7.2
    ''' </code>
    ''' <para><b>References</b></para>
    ''' <para>- https://stat.ethz.ch/R-manual/R-devel/library/stats/html/kruskal.test.html</para>
    ''' <para>See also: <c>HypothesisTestResult</c>.</para>
    ''' </remarks>
    ''' <param name="values">Finite observations concatenated by group.</param>
    ''' <param name="groupSizes">At least two positive group sizes summing to values.size().</param>
    ''' <returns>statistic=H, parameter1=k-1 and upper-tail approximate p_value; no CI.</returns>
    ''' <exception cref="NativeException">C++ <c>std::invalid_argument</c>: Invalid groups, nonfinite input or all observations tied.</exception>
    Public Shared Function KruskalWallisTest(values As IEnumerable(Of Double), groupSizes As IEnumerable(Of ULong)) As HypothesisTestResult
        Return Rosetta.Cast(Of HypothesisTestResult)(Rosetta.Run(200, values, groupSizes))
    End Function

    ''' <summary>
    ''' Performs Dunn pairwise comparisons on ranks pooled across all groups.
    ''' </summary>
    ''' <remarks>
    ''' <para>Tied observations get average ranks, and their reduced pooled rank variance
    ''' enters the normal approximation. The standard interpretation assumes
    ''' independent groups. A location interpretation uses a common-shape shift model.</para>
    ''' <para><b>Example</b></para>
    ''' <code>
    ''' const auto rows = dm::stats::dunn_test({1, 2, 4, 5, 7, 8}, {2, 2, 2});
    ''' std::print("{}\n", rows.size()); // 3
    ''' </code>
    ''' <para><b>References</b></para>
    ''' <para>- Dunn (1964), Multiple Comparisons Using Rank Sums, doi:10.2307/1266041.
    ''' - https://cran.r-project.org/web/packages/dunn.test/index.html</para>
    ''' <para>See also: <c>kruskal_wallis_test()</c>, <c>p_adjust()</c>.</para>
    ''' <para>Uses the C++ default for <c>adjustment = PAdjustMethod.Holm</c>.</para>
    ''' </remarks>
    ''' <param name="values">Finite observations, concatenated by group.</param>
    ''' <param name="groupSizes">At least two positive counts that partition values.</param>
    ''' <returns>Owned comparisons in order (1,0), (2,0), (2,1), and so on.</returns>
    ''' <exception cref="NativeException">C++ <c>std::invalid_argument</c>: Invalid groups or zero pooled rank variation.</exception>
    Public Shared Function DunnTest(values As IEnumerable(Of Double), groupSizes As IEnumerable(Of ULong)) As List(Of DunnComparison)
        Return Rosetta.Cast(Of List(Of DunnComparison))(Rosetta.Run(201, values, groupSizes))
    End Function

