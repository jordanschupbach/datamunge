''' <summary>
''' Minimises an expensive black-box function on a box with few evaluations.
''' </summary>
''' <remarks>
''' <para>The loop is:
''' 1. evaluate <c>initial_samples</c> points drawn uniformly in <c>[lower, upper]</c>;
''' 2. repeat <c>max_iterations</c> times: fit the surrogate to all observations, score <c>candidates</c>
'''   uniform random points with BayesianSurrogate::acquisition() (the incumbent being the
'''   smallest value so far), polish the best one by compass search on the acquisition (steps
'''   of 10% of each side, halved <c>refine_iterations</c> times, clipped to the box), and evaluate
'''   the objective there.</para>
''' <para>Only point evaluations of the objective are used, so it suits expensive simulations,
''' experiments and hyperparameter tuning where each evaluation costs far more than the
''' surrogate fit.</para>
''' <para><b>Example</b></para>
''' <code>
''' struct Bowl : dm::optim::ArbitraryFunction {
'''     double evaluate(const std::vector&lt;double&gt;&amp; x) override { return (x[0] - 1.0) * (x[0] - 1.0); }
''' } bowl;
''' dm::optim::RBFGaussianProcessSurrogate gp({.fit_hyperparameters = true});
''' const auto result = dm::optim::BayesianOptimization({.initial_samples = 4, .max_iterations = 10})
'''                         .run(bowl, {-3.0}, {3.0}, gp);
''' std::print("{:.3f} after {} evaluations\n", result.best_point[0], result.values.size());  // 1.002 after 14 evaluations
''' </code>
''' <para><b>References</b></para>
''' <para>- D. R. Jones, M. Schonlau and W. J. Welch (1998). "Efficient global optimization of expensive
'''   black-box functions". Journal of Global Optimization 13, 455–492.
''' - B. Shahriari et al. (2016). "Taking the human out of the loop: a review of Bayesian
'''   optimization". Proceedings of the IEEE 104(1), 148–175.</para>
''' <para>See also: <c>RBFGaussianProcessSurrogate</c>, <c>expected_improvement()</c>.</para>
''' </remarks>
Partial Public Class BayesianOptimization
    Inherits NativeObject
    Friend Sub New(raw As NativeRaw)
        MyBase.New(raw)
    End Sub

    ''' <summary>
    ''' Creates the optimizer.
    ''' </summary>
    ''' <remarks>
    ''' <para>Uses the C++ default for <c>options = Nothing</c>.</para>
    ''' </remarks>
    Public Sub New()
        MyBase.New(New NativeRaw())
        Rosetta.Construct(Me, GetType(BayesianOptimization), False, 1616)
    End Sub

    ''' <summary>
    ''' Creates the optimizer.
    ''' </summary>
    ''' <param name="options">Design size, iteration count, seed and acquisition search settings.</param>
    Public Sub New(options As BayesianOptimizationOptions)
        MyBase.New(New NativeRaw())
        Rosetta.Construct(Me, GetType(BayesianOptimization), False, 1616, options)
    End Sub

    ''' <summary>
    ''' Runs the loop and records every evaluation.
    ''' </summary>
    ''' <param name="function">Objective to minimise.</param>
    ''' <param name="lower">Lower corner of the box.</param>
    ''' <param name="upper">Upper corner of the box (each entry larger than in <c>lower</c>).</param>
    ''' <param name="surrogate">Surrogate refitted before every proposal.</param>
    ''' <returns>The evaluations and the best point.</returns>
    ''' <exception cref="NativeException">C++ <c>std::invalid_argument</c>: If the bounds are empty, differ in length or are not increasing.</exception>
    Public Function Run([function] As ArbitraryFunction, lower As IEnumerable(Of Double), upper As IEnumerable(Of Double), surrogate As BayesianSurrogate) As BayesianOptimizationResult
        Return Rosetta.Cast(Of BayesianOptimizationResult)(Rosetta.Run(1613, Me, [function], lower, upper, surrogate))
    End Function

    ''' <summary>
    ''' Runs the loop and returns only the best value.
    ''' </summary>
    ''' <param name="function">Objective to minimise.</param>
    ''' <param name="coordinates">Output: the best point (its length must equal the bounds').</param>
    ''' <param name="lower">Lower corner of the box.</param>
    ''' <param name="upper">Upper corner of the box.</param>
    ''' <param name="surrogate">Surrogate refitted before every proposal.</param>
    ''' <returns>The smallest observed value.</returns>
    ''' <exception cref="NativeException">C++ <c>std::invalid_argument</c>: If the bounds do not match <c>coordinates</c> or are not increasing.</exception>
    Public Function Optimize([function] As ArbitraryFunction, ByRef coordinates As List(Of Double), lower As IEnumerable(Of Double), upper As IEnumerable(Of Double), surrogate As BayesianSurrogate) As Double
        Dim _slot1 As New Rosetta.Slot(coordinates)
        Dim _result = Rosetta.Cast(Of Double)(Rosetta.Run(1614, Me, [function], _slot1, lower, upper, surrogate))
        coordinates = Rosetta.Cast(Of List(Of Double))(_slot1.Value)
        Return _result
    End Function

    ''' <summary>
    ''' The options this BayesianOptimization was configured with.
    ''' </summary>
    ''' <returns>The stored options.</returns>
    Public Function Options() As BayesianOptimizationOptions
        Return Rosetta.Cast(Of BayesianOptimizationOptions)(Rosetta.Run(1615, Me))
    End Function
End Class

