    ''' <summary>
    ''' Downloads <c>url</c> to <c>destination</c> with curl, unless the destination already exists.
    ''' </summary>
    ''' <remarks>
    ''' <para>The file is downloaded into a temporary directory next to <c>destination</c>, checked, and only
    ''' then renamed into place. Parent directories are created as needed. <c>DATAMUNGE_DATA_OFFLINE</c>
    ''' is honored; <c>DATAMUNGE_DATA_MIRROR</c> is not (fetch() applies it).</para>
    ''' <para><b>Example</b></para>
    ''' <code>
    ''' dm::datasets::download_file("https://example.org/data.csv", "/tmp/data.csv");
    ''' </code>
    ''' <para>Uses the C++ default for <c>md5 = ""</c>.</para>
    ''' </remarks>
    ''' <param name="url">An <c>https://</c>, <c>http://</c> or <c>file://</c> URL.</param>
    ''' <param name="destination">The final file path.</param>
    ''' <exception cref="NativeException">C++ <c>std::runtime_error</c>: if downloading is disabled or fails, or the checksum differs.</exception>
    Public Shared Sub DownloadFile(url As String, destination As String)
        Rosetta.Run(116, url, destination)
    End Sub

    ''' <summary>
    ''' Downloads <c>url</c> to <c>destination</c> with curl, unless the destination already exists.
    ''' </summary>
    ''' <remarks>
    ''' <para>The file is downloaded into a temporary directory next to <c>destination</c>, checked, and only
    ''' then renamed into place. Parent directories are created as needed. <c>DATAMUNGE_DATA_OFFLINE</c>
    ''' is honored; <c>DATAMUNGE_DATA_MIRROR</c> is not (fetch() applies it).</para>
    ''' <para><b>Example</b></para>
    ''' <code>
    ''' dm::datasets::download_file("https://example.org/data.csv", "/tmp/data.csv");
    ''' </code>
    ''' </remarks>
    ''' <param name="url">An <c>https://</c>, <c>http://</c> or <c>file://</c> URL.</param>
    ''' <param name="destination">The final file path.</param>
    ''' <param name="md5">Expected lowercase hex MD5 of the downloaded bytes; empty skips the check.</param>
    ''' <exception cref="NativeException">C++ <c>std::runtime_error</c>: if downloading is disabled or fails, or the checksum differs.</exception>
    Public Shared Sub DownloadFile(url As String, destination As String, md5 As String)
        Rosetta.Run(116, url, destination, md5)
    End Sub

    ''' <summary>
    ''' Builds a uniform mesh of <c>num_elements</c> equal-length elements on [a, b].
    ''' Throws std::invalid_argument if num_elements is 0 or b &lt;= a.
    ''' </summary>
    ''' <param name="a"></param>
    ''' <param name="b"></param>
    ''' <param name="numElements"></param>
    Public Shared Function MakeUniformMesh1d(a As Double, b As Double, numElements As ULong) As Mesh1D
        Return Rosetta.Cast(Of Mesh1D)(Rosetta.Run(117, a, b, numElements))
    End Function

    ''' <summary>
    ''' Evaluate squared Euclidean distance using the original double arithmetic.
    ''' No finite/range validation. Differences, products and sum can overflow,
    ''' underflow or lose low bits; NaNs propagate according to floating arithmetic.
    ''' </summary>
    ''' <remarks>
    ''' <para><b>Example</b></para>
    ''' <code>
    ''' std::cout &lt;&lt; dm::geometry::squared_distance({0,0},{3,4}); // 25
    ''' </code>
    ''' <para>See also: <c>distance()</c>.</para>
    ''' </remarks>
    ''' <param name="a">First point.</param>
    ''' <param name="b">Second point.</param>
    ''' <returns>Rounded squared distance, possibly infinity/NaN or underflowed zero.</returns>
    Public Shared Function SquaredDistance(a As Point2D, b As Point2D) As Double
        Return Rosetta.Cast(Of Double)(Rosetta.Run(118, a, b))
    End Function

    ''' <summary>
    ''' Return sqrt(squared_distance(a,b)) with its original range limitations.
    ''' A finite mathematical distance may overflow through the squared intermediate;
    ''' this convenience primitive performs no checked hypot or input validation.
    ''' </summary>
    ''' <remarks>
    ''' <para><b>Example</b></para>
    ''' <code>
    ''' std::cout &lt;&lt; dm::geometry::distance({0,0},{3,4}); // 5
    ''' </code>
    ''' <para>See also: <c>squared_distance()</c>.</para>
    ''' </remarks>
    ''' <param name="a">First point.</param>
    ''' <param name="b">Second point.</param>
    ''' <returns>Rounded square root of the double-valued squared distance.</returns>
    Public Shared Function Distance(a As Point2D, b As Point2D) As Double
        Return Rosetta.Cast(Of Double)(Rosetta.Run(119, a, b))
    End Function

    ''' <summary>
    ''' Evaluate the original double determinant (b-a) cross (c-a).
    ''' A positive exact determinant means counterclockwise, but this approximation
    ''' can cancel, overflow or underflow and its returned sign is not certified.
    ''' No tolerance or finite validation is applied. orientation_sign() supplies an
    ''' exact sign for finite stored binary64 points; this primitive remains unchanged.
    ''' </summary>
    ''' <remarks>
    ''' <para><b>Example</b></para>
    ''' <code>
    ''' std::cout &lt;&lt; dm::geometry::cross({0,0},{1,0},{0,1}); // 1
    ''' </code>
    ''' <para>See also: <c>orientation_sign()</c>.</para>
    ''' </remarks>
    ''' <param name="a">First point.</param>
    ''' <param name="b">Second point.</param>
    ''' <param name="c">Third point.</param>
    ''' <returns>Rounded double determinant, possibly infinity/NaN or a misleading zero.</returns>
    Public Shared Function Cross(a As Point2D, b As Point2D, c As Point2D) As Double
        Return Rosetta.Cast(Of Double)(Rosetta.Run(120, a, b, c))
    End Function

    ''' <summary>
    ''' Construct a complete unconstrained Delaunay triangulation with exact signs.
    ''' Retains the original one-vector signature and Triangle layout. Finite coordinate
    ''' validation precedes even trivial results. Duplicates coalesce to earliest ids;
    ''' collinear/fewer-than-three distinct sites return no faces. Uses Bowyer-Watson
    ''' cavity replacement with symbolic hull ghosts, avoiding any finite super-triangle
    ''' whose proximity could remove valid narrow faces. All orientation/incircle signs
    ''' are exact for finite stored binary64, including subnormals/extreme scales.
    ''' Cocircular ties retain existing faces under the ordering in DelaunayTrace.
    ''' Faces are strictly CCW, contain no ghosts and reference original ids. Finite
    ''' output order is canonical as documented on DelaunayTrace. No boundary constraints,
    ''' holes, Steiner refinement or minimum-angle guarantee is supplied. Input unchanged;
    ''' O(n log(n+1)+u^2 log(u+1)) worst-case work for n records/u distinct sites with
    ''' ordered cavity maps and full live scans; O(n+u) working/output storage, no shared
    ''' state or optional resource caps. Exact-predicate cost is bounded per binary64 query.
    ''' </summary>
    ''' <remarks>
    ''' <para><b>Example</b></para>
    ''' <code>
    ''' std::print("{}\n",dm::geometry::delaunay_triangulation({{0,0},{1,0},{.5,.000001}}).size()); // 1
    ''' </code>
    ''' <para><b>References</b></para>
    ''' <para>- A. Bowyer (1981), Computing Dirichlet tessellations, Computer Journal 24(2),162–166, doi:10.1093/comjnl/24.2.162.
    ''' - D. F. Watson (1981), Computing the n-dimensional Delaunay tessellation with application to Voronoi polytopes, Computer Journal 24(2),167–172, doi:10.1093/comjnl/24.2.167. This variant uses symbolic boundary faces, exact decoded-dyadic signs, earliest duplicate identities and ordered cavity edges.</para>
    ''' <para>See also: <c>delaunay_trace()</c>, <c>incircle_sign()</c>.</para>
    ''' </remarks>
    ''' <param name="points">Borrowed finite planar sites, possibly empty/duplicate/collinear.</param>
    ''' <returns>Owned complete finite mesh of the distinct sites' convex hull, or no faces for collinearity.</returns>
    ''' <exception cref="NativeException">C++ <c>std::invalid_argument</c>: Any nonfinite coordinate, even on short input.</exception>
    ''' <exception cref="NativeException">C++ <c>std::length_error</c>: Counter arithmetic or container capacity exceeded.</exception>
    ''' <exception cref="NativeException">C++ <c>std::logic_error</c>: Internal cavity topology invariant fails; no partial mesh returned.</exception>
    ''' <exception cref="NativeException">C++ <c>std::bad_alloc</c>: Allocation fails.</exception>
    Public Shared Function DelaunayTriangulation(points As IEnumerable(Of Point2D)) As List(Of Triangle)
        Return Rosetta.Cast(Of List(Of Triangle))(Rosetta.Run(121, points))
    End Function

    ''' <summary>
    ''' Capture actual symbolic-boundary cavity transitions from the same solver.
    ''' No replay. Full finite validation precedes the original-record cap and all
    ''' allocation. max_tests bounds cumulative incircle plus hull-side calls, checked
    ''' before each complete live-face scan. Trace entries charge one per insertion
    ''' plus removed faces, boundary edges and added faces, including ghosts, checked
    ''' before retaining the event. Points/maps/final output and temporary cavities are
    ''' excluded from that entry count; caps do not bound bytes or wall time. Zero
    ''' disables only an optional cap. O(sum cavity/event sizes) additional history,
    ''' at worst O(u^2), beyond the ordinary solver. Failure returns no partial result.
    ''' </summary>
    ''' <remarks>
    ''' <para><b>Example</b></para>
    ''' <code>
    ''' const auto t=dm::geometry::delaunay_trace({{0,0},{4,0},{4,4},{0,4},{2,2}},5,10);
    ''' std::print("{} {}\n",t.triangles.size(),t.work.incircle_tests+t.work.hull_side_tests); // 4 10
    ''' </code>
    ''' <para><b>References</b></para>
    ''' <para>- Bowyer (1981), doi:10.1093/comjnl/24.2.162; Watson (1981), doi:10.1093/comjnl/24.2.167; records the symbolic-boundary variant rather than a geometric replay.</para>
    ''' <para>See also: <c>DelaunayTrace</c>, <c>delaunay_triangulation()</c>.</para>
    ''' <para>Uses the C++ default for <c>maxPoints = 1000000</c>, <c>maxTests = 10000000</c>, <c>maxEntries = 1000000</c>.</para>
    ''' </remarks>
    ''' <param name="points">Finite original coordinates, unchanged.</param>
    ''' <returns>Owned points, original-id maps, finite mesh, actual events and work.</returns>
    ''' <exception cref="NativeException">C++ <c>std::invalid_argument</c>: Any nonfinite coordinate.</exception>
    ''' <exception cref="NativeException">C++ <c>std::length_error</c>: Optional cap, count arithmetic or container capacity exceeded.</exception>
    ''' <exception cref="NativeException">C++ <c>std::logic_error</c>: Internal cavity invariant fails.</exception>
    ''' <exception cref="NativeException">C++ <c>std::bad_alloc</c>: Allocation fails.</exception>
    Public Shared Function DelaunayTrace(points As IEnumerable(Of Point2D)) As DelaunayTrace
        Return Rosetta.Cast(Of DelaunayTrace)(Rosetta.Run(122, points))
    End Function

    ''' <summary>
    ''' Capture actual symbolic-boundary cavity transitions from the same solver.
    ''' No replay. Full finite validation precedes the original-record cap and all
    ''' allocation. max_tests bounds cumulative incircle plus hull-side calls, checked
    ''' before each complete live-face scan. Trace entries charge one per insertion
    ''' plus removed faces, boundary edges and added faces, including ghosts, checked
    ''' before retaining the event. Points/maps/final output and temporary cavities are
    ''' excluded from that entry count; caps do not bound bytes or wall time. Zero
    ''' disables only an optional cap. O(sum cavity/event sizes) additional history,
    ''' at worst O(u^2), beyond the ordinary solver. Failure returns no partial result.
    ''' </summary>
    ''' <remarks>
    ''' <para><b>Example</b></para>
    ''' <code>
    ''' const auto t=dm::geometry::delaunay_trace({{0,0},{4,0},{4,4},{0,4},{2,2}},5,10);
    ''' std::print("{} {}\n",t.triangles.size(),t.work.incircle_tests+t.work.hull_side_tests); // 4 10
