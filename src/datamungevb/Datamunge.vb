    ''' <summary>
    ''' Sorted canonical names accepted by fetch(), including audited UCI tables.
    ''' </summary>
    ''' <remarks>
    ''' <para>UCI aliases are listed by datasets::uci_catalog().</para>
    ''' <para><b>Example</b></para>
    ''' <code>
    ''' for (const auto&amp; name : dm::datasets::downloadable()) std::print("{}\n", name);
    ''' </code>
    ''' </remarks>
    ''' <returns>An owned list of names, with no network or filesystem access.</returns>
    Public Shared Function Downloadable() As List(Of String)
        Return Rosetta.Cast(Of List(Of String))(Rosetta.Run(114))
    End Function

    ''' <summary>
    ''' Makes sure a downloadable dataset is on disk and returns where it is.
    ''' </summary>
    ''' <remarks>
    ''' <para>For tabular datasets this is the CSV file. UCI names such as "uci_53"
    ''' and "uci_iris" point to the same cache. UCI verifies size and SHA-256 on
    ''' every access and stages complete bytes before publishing them. For the
    ''' image datasets it is a directory: "mnist" and "fashion_mnist" hold the four uncompressed
    ''' IDX files (<c>train-images-idx3-ubyte</c>, ...); "cifar10" holds <c>data_batch_1..5.bin</c> and
    ''' <c>test_batch.bin</c>; "cifar100" holds <c>train.bin</c> and <c>test.bin</c> (the binary versions);
    ''' "sudoku" holds Norvig's <c>easy50.txt</c>, <c>top95.txt</c> and <c>hardest.txt</c>.
    ''' "karate_club" holds the970-byte original ZIP, GML topology and source README;
    ''' every cached archive/member is checksum-verified. karate_club() reads34nodes/78edges.
    ''' "rebot_devarm" holds 38 pinned Seeed DevArm CAD/URDF/STL files and the
    ''' CERN-OHL-W-2.0 source license in their upstream relative directory layout.
    ''' DevArm verifies the size and SHA-256 of every cached file on every call;
    ''' changed files throw without replacement. Missing files are staged and verified
    ''' before publication. It uses the same offline/mirror/cache controls, and works
    ''' without the optional native data-preparation dependencies. Hashing uses memory
    ''' proportional to the largest source file (about 35 MB).
    ''' Approximate download sizes: diamonds 2.7 MB, california_housing 1.4 MB, MNIST 11 MB,
    ''' Fashion-MNIST 30 MB, CIFAR-10 163 MB, CIFAR-100 161 MB, sudoku 14 KB, DevArm 56 MB.</para>
    ''' <para><b>Example</b></para>
    ''' <code>
    ''' const auto housing = dm::datasets::read_csv(dm::datasets::fetch("california_housing"));
    ''' </code>
    ''' <para>For a complete CAD asset tree, use <c>dm::datasets::fetch("rebot_devarm")</c>.</para>
    ''' <para><b>References</b></para>
    ''' <para>- Seeed reBot-DevArm source: https://github.com/Seeed-Projects/reBot-DevArm</para>
    ''' <para>See also: <c>data_home()</c>, <c>downloadable()</c>, <c>download_file()</c>, <c>karate_club()</c>.</para>
    ''' <para>Uses the C++ default for <c>directory = ""</c>.</para>
    ''' </remarks>
    ''' <param name="name">One of downloadable() or a registered UCI alias.</param>
    ''' <returns>The local path of the CSV file or the dataset directory.</returns>
    ''' <exception cref="NativeException">C++ <c>std::invalid_argument</c>: for an unknown name.</exception>
    ''' <exception cref="NativeException">C++ <c>std::runtime_error</c>: if files are missing and downloading is disabled or fails, or a download does not match its checksum.</exception>
    Public Shared Function Fetch(name As String) As String
        Return Rosetta.Cast(Of String)(Rosetta.Run(115, name))
    End Function

    ''' <summary>
    ''' Makes sure a downloadable dataset is on disk and returns where it is.
    ''' </summary>
    ''' <remarks>
    ''' <para>For tabular datasets this is the CSV file. UCI names such as "uci_53"
