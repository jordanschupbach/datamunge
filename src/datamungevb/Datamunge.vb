    ''' <summary>
    ''' The Gaussian-smoothed second-moment (structure) tensor at every pixel: Sobel
    ''' gradients Ix/Iy, their per-pixel outer product Ix^2/Iy^2/IxIy, then smoothed with a
    ''' Gaussian window of the given <c>sigma</c> -- the shared computation behind both Harris
    ''' and Shi-Tomasi corner response, which differ only in how they combine these three
    ''' fields into a single scalar score.
    ''' </summary>
    ''' <param name="img"></param>
    ''' <param name="sigma"></param>
    Public Shared Function StructureTensor(img As Image, sigma As Double) As StructureTensorField
        Return Rosetta.Cast(Of StructureTensorField)(Rosetta.Run(74, img, sigma))
    End Function

    ''' <summary>
    ''' Keeps only the response-field entries that are a strict local maximum within a
    ''' (2*radius+1)^2 window AND exceed <c>threshold</c>, as a sorted-by-descending-response
    ''' Corner list -- the standard non-max-suppression + thresholding pass shared by every
    ''' response-map-based corner detector.
    ''' </summary>
    ''' <param name="response"></param>
    ''' <param name="width"></param>
    ''' <param name="height"></param>
    ''' <param name="threshold"></param>
    ''' <param name="nmsRadius"></param>
    Public Shared Function ExtractLocalMaxima(response As IEnumerable(Of Double), width As Integer, height As Integer, threshold As Double, nmsRadius As Integer) As List(Of Corner)
        Return Rosetta.Cast(Of List(Of Corner))(Rosetta.Run(75, response, width, height, threshold, nmsRadius))
    End Function

    ''' <summary>
