''' <summary>
''' A single R-base-graphics-style plot, spelled <c>dm::Plot</c> in user code.
''' </summary>
''' <remarks>
''' <para>Covers R's high-level plotting calls (<c>plot()</c>, <c>hist()</c>, <c>barplot()</c>, <c>boxplot()</c>, <c>pie()</c>,
''' <c>curve()</c>, <c>qqnorm()</c>, ...) as constructors and static factories, plus the "add to the
''' current plot" verbs R exposes as separate functions (<c>points()</c>, <c>lines()</c>, <c>abline()</c>,
''' <c>legend()</c>, <c>text()</c>, ...) as chainable member functions. A plot is an ordinary value: it
''' owns copies of its data, copies cheaply enough to pass around, and draws nothing until it
''' is rendered with to_svg(), save(), or show().</para>
''' <para>Two composition styles mix freely. Setters such as set_title() and verbs such as points()
''' mutate the plot and return <c>RPlot&amp;</c> for chaining; the pipe <c>plot | dm::points(...)</c> (see
''' compose.hpp) appends a reusable layer to a copy. A fresh plot has the title
''' "datamunge plot", axis labels "x" and "y", a 960x640 canvas, and a light grid.</para>
''' <para><b>Example</b></para>
''' <code>
''' const auto x = dm::seql(-2.0, 2.0, 9);
''' auto plt = dm::Plot(x, x * x)
'''                .set_title("Parabola")
'''                .set_xlab("x")
'''                .set_ylab("x squared");
''' plt.lines(x, x * x, dm::RGB{220, 38, 38}).abline_h(0.0);
''' plt.save("parabola.svg");
''' </code>
''' <para>See also: <c>dm::points()</c>, <c>dm::legend()</c>, <c>dm::Histogram</c>, <c>dm::Splom</c>, <c>RLayout</c>.</para>
''' </remarks>
Partial Public Class RPlot
    Inherits Plot
    Friend Sub New(raw As NativeRaw)
        MyBase.New(raw)
    End Sub

    ''' <summary>
    ''' Constructs an empty plot with default labels and styling, ready for layers.
    ''' </summary>
    ''' <remarks>
    ''' <para><b>Example</b></para>
    ''' <code>
    ''' auto plt = dm::Plot();
    ''' std::print("{} | {} | {}\n", plt.title_text(), plt.x_label_text(), plt.y_label_text());
    ''' // datamunge plot | x | y
    ''' </code>
    ''' </remarks>
    Public Sub New()
        MyBase.New(New NativeRaw())
        Rosetta.Construct(Me, GetType(RPlot), False, 634)
    End Sub

    ''' <summary>
    ''' Constructs a scatter plot of <c>y</c> against <c>x</c>, like R's <c>plot(x, y)</c>.
    ''' </summary>
    ''' <remarks>
    ''' <para>Equivalent to <c>RPlot::plot(x, y)</c>: one unlabeled scatter series drawn in blue
    ''' <c>{37, 99, 235}</c> with 4-pixel markers; axis ranges fit the data. The coordinates are
    ''' copied (or moved from rvalues); <c>dm::Vector&lt;double&gt;</c> converts implicitly. Restyle the
    ''' points afterwards with set_col().</para>
    ''' <para><b>Example</b></para>
    ''' <code>
    ''' const auto iris = dm::datasets::iris();
    ''' auto plt = dm::Plot(iris.get_column("Petal.Length").values(),
    '''                     iris.get_column("Petal.Width").values())
    '''                .set_col("blue");
    ''' plt.save("petals.svg");
    ''' </code>
    ''' <para>See also: <c>points()</c>, <c>set_col()</c>, <c>plot()</c>.</para>
    ''' </remarks>
    ''' <param name="x">Horizontal coordinates, one per point.</param>
    ''' <param name="y">Vertical coordinates, paired with <c>x</c> by position.</param>
    ''' <exception cref="NativeException">C++ <c>std::invalid_argument</c>: If the coordinates are empty or have different lengths.</exception>
    Public Sub New(x As IEnumerable(Of Double), y As IEnumerable(Of Double))
        MyBase.New(New NativeRaw())
        Rosetta.Construct(Me, GetType(RPlot), False, 634, x, y)
    End Sub

