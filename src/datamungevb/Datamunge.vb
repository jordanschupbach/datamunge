            w.Write(c.Imaginary)
        ElseIf TypeOf x Is String Then
            w.Write(CByte(5))
            o.Text(DirectCast(x, String))
        ElseIf TypeOf x Is Char Then
            w.Write(CByte(5))
            o.Text(DirectCast(x, Char).ToString())
