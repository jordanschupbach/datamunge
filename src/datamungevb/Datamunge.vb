    ''' <code>
    ''' const std::vector&lt;double&gt; sample{3.0, 1.0, 2.0, 5.0, 4.0};
    ''' auto plt = dm::Plot::qqnorm(sample).qqline(sample);
    ''' std::print("{:.4f}\n", plt.series()[0].x[0]);  // -1.2816
    ''' </code>
    ''' <para><b>References</b></para>
    ''' <para>- M. B. Wilk, R. Gnanadesikan (1968). "Probability plotting methods for the analysis of
    '''   data". Biometrika 55(1), 1-17. doi:10.1093/biomet/55.1.1
    ''' - R <c>qqnorm()</c>: https://stat.ethz.ch/R-manual/R-devel/library/stats/html/qqnorm.html
    ''' - R <c>ppoints()</c>: https://stat.ethz.ch/R-manual/R-devel/library/stats/html/ppoints.html</para>
    ''' <para>See also: <c>qqline()</c>.</para>
    ''' <para>Uses the C++ default for <c>label = "sample"</c>, <c>color</c>.</para>
    ''' </remarks>
