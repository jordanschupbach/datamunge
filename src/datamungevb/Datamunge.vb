''' <summary>
''' Tiles independently built plots into one multi-panel figure, like R's
''' <c>par(mfrow = c(rows, cols))</c> followed by one plot per panel.
''' </summary>
''' <remarks>
''' <para>Create it with create(rows, cols), then add() up to rows * cols panels; they fill the grid
''' row by row. Each panel is copied (and its SVG rendered) at add() time, so later changes to
''' the original plot do not show and panels need not outlive the layout. Each cell is
''' <c>width / cols</c> by <c>(height - band) / rows</c> pixels, where band is title_band_px when a
''' figure title is set and 0 otherwise; every panel is scaled from its own canvas size into its
''' cell. The figure background is white. Unused cells stay empty.</para>
''' <para><b>Example</b></para>
''' <code>
''' const auto x = dm::seql(0.0, 6.0, 30);
''' auto fig = dm::graphics::RLayout::create(1, 2)
'''                .size(1200, 500)
'''                .title("Two views")
'''                .add(dm::Plot(x, dm::sin(x)).set_title("sin"))
'''                .add(dm::Plot(x, dm::cos(x)).set_title("cos"));
''' std::print("{} panels in {}x{}\n", fig.panel_count(), fig.rows(), fig.cols());
''' // 2 panels in 1x2
''' fig.save("two_views.svg");
''' </code>
''' <para><b>References</b></para>
''' <para>- R <c>par()</c> (<c>mfrow</c>): https://stat.ethz.ch/R-manual/R-devel/library/graphics/html/par.html</para>
''' <para>See also: <c>RPlot</c>, <c>RPlot::margins()</c>, <c>dm::Splom</c>.</para>
''' </remarks>
Partial Public Class RLayout
    Inherits NativeObject
    Friend Sub New(raw As NativeRaw)
        MyBase.New(raw)
    End Sub

    ''' <summary>
    ''' C++ <c>datamunge::graphics::RLayout::RLayout</c>.
    ''' </summary>
    Public Sub New()
        MyBase.New(New NativeRaw())
        Rosetta.Construct(Me, GetType(RLayout), False, 659)
    End Sub

    ''' <summary>
    ''' Creates an empty layout with <c>rows</c> by <c>cols</c> cells, like R's
    ''' <c>par(mfrow = c(rows, cols))</c>.
    ''' </summary>
    ''' <remarks>
    ''' <para>The figure starts at 960 by 640 pixels with no title.</para>
    ''' <para><b>Example</b></para>
    ''' <para>See RLayout.</para>
    ''' <para><b>References</b></para>
    ''' <para>- R <c>par()</c> (<c>mfrow</c>): https://stat.ethz.ch/R-manual/R-devel/library/graphics/html/par.html</para>
    ''' <para>See also: <c>add()</c>.</para>
    ''' </remarks>
    ''' <param name="rows">Number of panel rows; must be positive.</param>
    ''' <param name="cols">Number of panel columns; must be positive.</param>
    ''' <returns>The empty layout.</returns>
    ''' <exception cref="NativeException">C++ <c>std::invalid_argument</c>: If <c>rows</c> or <c>cols</c> is 0.</exception>
    Public Shared Function Create(rows As ULong, cols As ULong) As RLayout
        Return Rosetta.Cast(Of RLayout)(Rosetta.Run(635, rows, cols))
    End Function

    ''' <summary>
    ''' Copies <c>panel</c> into the next free cell, filling rows left to right, top to bottom.
    ''' </summary>
    ''' <remarks>
    ''' <para>The panel's SVG is rendered immediately and stored with the copy, so rendering errors
    ''' surface here and later edits to the original plot have no effect on the layout.</para>
    ''' <para><b>Example</b></para>
    ''' <code>
    ''' auto fig = dm::graphics::RLayout::create(1, 1).add(dm::Plot(dm::c(1.0, 2.0), dm::c(2.0, 1.0)));
    ''' try {
    '''   fig.add(dm::Plot(dm::c(1.0), dm::c(1.0)));
    ''' } catch (const std::invalid_argument&amp; e) {
    '''   std::print("{}\n", e.what());  // RLayout::add: layout is already full
    ''' }
    ''' </code>
    ''' <para>See also: <c>panel()</c>, <c>panel_count()</c>.</para>
    ''' </remarks>
    ''' <param name="panel">The plot to add; any RPlot (or other Plot) converts.</param>
    ''' <returns>This layout, for chaining.</returns>
    ''' <exception cref="NativeException">C++ <c>std::invalid_argument</c>: If all rows * cols cells are already filled.</exception>
    ''' <exception cref="NativeException">C++ <c>std::runtime_error</c>: If <c>panel</c> has no data series or its canvas is smaller than its margins.</exception>
    Public Function Add(panel As Plot) As RLayout
        Return Rosetta.Cast(Of RLayout)(Rosetta.Run(636, Me, panel))
    End Function

    ''' <summary>
    ''' Sets the size of the whole figure in pixels (default 960 by 640).
    ''' </summary>
    ''' <remarks>
    ''' <para>Panels keep their own canvas sizes and are scaled into their cells, so text in a panel
    ''' shrinks or grows with it; give panels a size close to their cell for readable labels.</para>
    ''' <para><b>Example</b></para>
    ''' <para>See RLayout.</para>
    ''' <para>See also: <c>title()</c>.</para>
    ''' </remarks>
    ''' <param name="width">Figure width in pixels.</param>
    ''' <param name="height">Figure height in pixels, including the title band.</param>
    ''' <returns>This layout, for chaining.</returns>
    Public Function Size(width As ULong, height As ULong) As RLayout
        Return Rosetta.Cast(Of RLayout)(Rosetta.Run(637, Me, width, height))
    End Function

    ''' <summary>
    ''' Sets the resolution PNG and PDF output is rasterized at, like R's
    ''' <c>png(res = )</c> and ggsave()'s <c>dpi =</c> (default 96).
    ''' </summary>
    ''' <remarks>
    ''' <para>The layout, text and line widths keep their size relative to the layout; only the pixel
    ''' count changes: a layout of width(units::inch{8}) saves as a 768-pixel-wide PNG at 96 dpi
    ''' and a 2400-pixel-wide one at 300 dpi. A PNG records the resolution (its pHYs chunk) so
