    ''' <para>See also: <c>HypothesisTestResult</c>.</para>
    ''' <para>Uses the C++ default for <c>alternative = Alternative.TwoSided</c>.</para>
    ''' </remarks>
    ''' <param name="x">Nonempty finite first sample.</param>
    ''' <param name="y">Nonempty finite independent second sample.</param>
    ''' <returns>statistic=U=rank_sum(x)-n_x(n_x+1)/2 and approximate p_value; no CI or location estimate.</returns>
    ''' <exception cref="NativeException">C++ <c>std::invalid_argument</c>: Empty/nonfinite samples, invalid alternative or zero rank variance (all pooled observations tied).</exception>
    Public Shared Function WilcoxonRankSumTest(x As IEnumerable(Of Double), y As IEnumerable(Of Double)) As HypothesisTestResult
        Return Rosetta.Cast(Of HypothesisTestResult)(Rosetta.Run(227, x, y))
    End Function

