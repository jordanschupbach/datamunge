                    callbackException = Nothing
                    Decode(r, Nothing)
                    Dim message = TryCast(Decode(r, Nothing), String)
                    If pending IsNot Nothing Then Global.System.Runtime.ExceptionServices.ExceptionDispatchInfo.Capture(pending).Throw()
                    Throw New Global.Datamunge.NativeException("visual_basic", If(message, "error in a Visual Basic callback"))
                Case 1
                    Dim kind = Decode(r, Nothing)
                    Dim message = TryCast(Decode(r, Nothing), String)
                    Throw New Global.Datamunge.NativeException(If(kind Is Nothing, "native", kind.ToString().Replace("-"c, "_"c)), If(message, "native error"))
                Case Else
                    Throw New Global.Datamunge.NativeException("allocation", "out of memory in a native call")
