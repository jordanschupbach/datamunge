    ''' <returns>Owned selected point copies and checked finite-double measured distance.</returns>
    ''' <exception cref="NativeException">C++ <c>std::invalid_argument</c>: If point count is too small or any coordinate is nonfinite.</exception>
    ''' <exception cref="NativeException">C++ <c>std::length_error</c>: If complete pair count cannot fit size_t.</exception>
    ''' <exception cref="NativeException">C++ <c>std::overflow_error</c>: If arithmetic/counters or the selected legacy distance cannot fit.</exception>
    Public Shared Function ClosestPair(points As IEnumerable(Of Point2D)) As ClosestPairResult
