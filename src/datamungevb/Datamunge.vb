    ''' callers don't have to guess an absolute scale) and non-max-suppressed within a
    ''' (2*nms_radius+1)^2 window. <c>k</c> is the classical Harris free parameter (0.04-0.06).
    ''' </summary>
    ''' <remarks>
    ''' <para>Uses the C++ default for <c>k = 0.04</c>, <c>sigma = 1.0</c>, <c>thresholdRatio = 0.01</c>, <c>nmsRadius = 3</c>.</para>
    ''' </remarks>
    ''' <param name="img"></param>
    Public Shared Function HarrisCorners(img As Image) As List(Of Corner)
        Return Rosetta.Cast(Of List(Of Corner))(Rosetta.Run(76, img))
    End Function

