# pyproject.toml

[build-system]
requires = ["setuptools"]
build-backend = "setuptools.build_meta"

[project]
name = "pydatamunge"
version = "0.0.1" # TODO: get from cmake

[options]
package_dir = "pydatamunge/datamunge"

[tool.setuptools]
ext-modules = [
  {name = "pydatamunge._datamunge", sources = [ @QUOTED_C_SOURCES@ @QUOTED_CXX_SOURCES@ "pydatamunge/datamunge/datamunge_wrap.cpp"], include-dirs = ["pydatamunge/"], libraries = [], extra-compile-args = ["-O3", "-std=c++23"]},
]

# "lapack", "cblas", "lapacke"
