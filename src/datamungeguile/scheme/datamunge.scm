       (candidates (core:if source
                        (core:map (lambda (suffix) (core:string-append (core:dirname source) "/" "libdatamunge_guile" suffix))
                                  '(".so" ".dylib" ".dll"))
                        '()))
       (found (core:let loop ((files candidates))
                (core:cond ((core:null? files) "libdatamunge_guile")
