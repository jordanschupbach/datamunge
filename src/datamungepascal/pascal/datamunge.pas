/// <summary>Inserts knots into a clamped B-spline basis (Oslo algorithm).</summary>
/// <remarks>
/// <para>Calls C++ <c>datamunge::fda::refine_basis</c>.</para>
/// <para>Builds the refined knot vector (old knots merged with <c>inserted_knots</c>) and the sparse discrete-B-spline operator that re-expresses every coarse spline on it exactly. Each row has at most degree + 1 nonzeros and the work is O(m p^2) for m refined functions.</para>
/// <para><b>Example</b></para>
/// <code>
/// auto coarse = dm::fda::BSplineBasis::open_uniform(1, 2);   // knots 0 0 1 1
/// auto r = dm::fda::refine_basis(coarse, {0.25});
/// std::print("{}\n", r.apply({0.0, 4.0}));                   // [0, 1, 4]
/// </code>
/// <para><b>References</b></para>
/// <list type="bullet">
/// <item><description>E. Cohen, T. Lyche and R. Riesenfeld (1980). Discrete B-splines and subdivision techniques in computer-aided geometric design and computer graphics. Computer Graphics and Image Processing 14(2), 87-111. https://doi.org/10.1016/0146-664X(80)90040-4</description></item>
/// <item><description>W. Boehm (1980). Inserting new knots into B-spline curves. Computer-Aided Design 12(4), 199-201. https://doi.org/10.1016/0010-4485(80)90154-2</description></item>
/// </list>
/// <para>See also: <c>dyadic_refine()</c>.</para>
/// </remarks>
/// <param name="ABasis">Basis to refine; its knot vector must be clamped (first and last knots repeated degree + 1 times, as produced by BSplineBasis::open_uniform()).</param>
/// <param name="AInsertedKnots">Knots to add, strictly inside the domain, in any order. Repeats are allowed while every knot multiplicity stays &lt;= degree + 1.</param>
/// <returns>The refined basis and its refinement operator.</returns>
/// <exception cref="ENativeError">Kind <c>InvalidArgument</c> (C++ <c>std::invalid_argument</c>): If the basis is not clamped, a knot is outside the open domain or non-finite, or a multiplicity would exceed degree + 1.</exception>
function RefineBasis(ABasis: TBSplineBasis; const AInsertedKnots: TArrayOfDouble): TBSplineRefinement; overload;
/// <summary>Halves every knot span of a clamped basis (inserts each positive span's midpoint).</summary>
/// <remarks>
/// <para>Calls C++ <c>datamunge::fda::dyadic_refine</c>.</para>
/// <para>This is the nested-space step between consecutive levels of HB/THB splines: the refined space contains the coarse one, and the operator maps coefficients exactly.</para>
/// <para><b>Example</b></para>
/// <code>
/// auto r = dm::fda::dyadic_refine(dm::fda::BSplineBasis::open_uniform(3, 5));
/// std::print("{} -&gt; {}\n", 5, r.basis.basis_size()); // 5 -&gt; 7
/// </code>
/// <para><b>References</b></para>
/// <list type="bullet">
/// <item><description>E. Cohen, T. Lyche and R. Riesenfeld (1980). Discrete B-splines and subdivision techniques in computer-aided geometric design and computer graphics. https://doi.org/10.1016/0146-664X(80)90040-4</description></item>
/// </list>
/// <para>See also: <c>refine_basis()</c>, <c>TensorBSpline::dyadic_refine()</c>.</para>
/// </remarks>
/// <param name="ABasis">Clamped basis to refine.</param>
/// <returns>The refined basis and its refinement operator.</returns>
/// <exception cref="ENativeError">Kind <c>InvalidArgument</c> (C++ <c>std::invalid_argument</c>): If the basis is not clamped.</exception>
function DyadicRefine(ABasis: TBSplineBasis): TBSplineRefinement; overload;
/// <summary>Fits a tensor-product B-spline to scattered data by ordinary least squares.</summary>
/// <remarks>
/// <para>Calls C++ <c>datamunge::fda::fit_tensor_bspline</c>.</para>
/// <para>Builds the sparse design B (each row has at most prod(degree_k + 1) nonzeros), then solves (B^T B) c = B^T y. Coordinates outside a basis domain are clamped to it.</para>
/// <para><b>Example</b></para>
/// <code>
/// auto b = dm::fda::BSplineBasis::open_uniform(1, 2);
/// auto f = dm::fda::fit_tensor_bspline({b}, {{0.0}, {0.5}, {1.0}}, {1.0, 2.0, 3.0});
/// std::print("{:.3f}\n", f.evaluate(0.25)); // 1.500
/// </code>
/// <para><b>References</b></para>
/// <list type="bullet">
/// <item><description>C. de Boor (2001). A Practical Guide to Splines, revised edition. Springer.</description></item>
/// </list>
/// <para>See also: <c>fit_tensor_pspline()</c>.</para>
/// <para>Leaves out the C++ default arguments <c>AOptions = C++ default</c> (other overloads pass them).</para>
/// </remarks>
/// <param name="ABases">One basis per dimension.</param>
/// <param name="APoints">Sample locations, each of length bases.size().</param>
/// <param name="AValues">One response per point.</param>
/// <returns>The fitted spline.</returns>
/// <exception cref="ENativeError">Kind <c>InvalidArgument</c> (C++ <c>std::invalid_argument</c>): On empty or mismatched inputs, or non-finite data.</exception>
/// <exception cref="ENativeError">Kind <c>Native</c> (C++ <c>std::runtime_error</c>): If the normal equations are singular (some basis function has too little data; use a penalized fit or fewer functions).</exception>
function FitTensorBspline(const ABases: TArrayOfBSplineBasis; const APoints: TArrayOfArrayOfDouble; const AValues: TArrayOfDouble): TTensorBSpline; overload;
/// <summary>Fits a tensor-product B-spline to scattered data by ordinary least squares.</summary>
/// <remarks>
/// <para>Calls C++ <c>datamunge::fda::fit_tensor_bspline</c>.</para>
/// <para>Builds the sparse design B (each row has at most prod(degree_k + 1) nonzeros), then solves (B^T B) c = B^T y. Coordinates outside a basis domain are clamped to it.</para>
/// <para><b>Example</b></para>
/// <code>
/// auto b = dm::fda::BSplineBasis::open_uniform(1, 2);
/// auto f = dm::fda::fit_tensor_bspline({b}, {{0.0}, {0.5}, {1.0}}, {1.0, 2.0, 3.0});
/// std::print("{:.3f}\n", f.evaluate(0.25)); // 1.500
/// </code>
/// <para><b>References</b></para>
/// <list type="bullet">
/// <item><description>C. de Boor (2001). A Practical Guide to Splines, revised edition. Springer.</description></item>
/// </list>
/// <para>See also: <c>fit_tensor_pspline()</c>.</para>
/// </remarks>
/// <param name="ABases">One basis per dimension.</param>
/// <param name="APoints">Sample locations, each of length bases.size().</param>
/// <param name="AValues">One response per point.</param>
/// <param name="AOptions">Solver settings (default: automatic).</param>
/// <returns>The fitted spline.</returns>
/// <exception cref="ENativeError">Kind <c>InvalidArgument</c> (C++ <c>std::invalid_argument</c>): On empty or mismatched inputs, or non-finite data.</exception>
/// <exception cref="ENativeError">Kind <c>Native</c> (C++ <c>std::runtime_error</c>): If the normal equations are singular (some basis function has too little data; use a penalized fit or fewer functions).</exception>
function FitTensorBspline(const ABases: TArrayOfBSplineBasis; const APoints: TArrayOfArrayOfDouble; const AValues: TArrayOfDouble; AOptions: TSplineSolveOptions): TTensorBSpline; overload;
/// <summary>Fits a tensor-product P-spline: least squares plus an anisotropic difference penalty, solving (B^T B + P) c = B^T y with P from tensor_difference_penalty().</summary>
/// <remarks>
/// <para>Calls C++ <c>datamunge::fda::fit_tensor_pspline</c>.</para>
/// <para>All-zero lambdas reproduce fit_tensor_bspline(). Positive lambdas keep the system well-posed even with fewer points than coefficients (for order 0, or once the data determine the order-q polynomial null space).</para>
/// <para><b>Example</b></para>
/// <code>
/// auto b = dm::fda::BSplineBasis::open_uniform(3, 8);
/// auto f = dm::fda::fit_tensor_pspline({b}, {{0.0}, {1.0}}, {0.0, 1.0}, {1e3});
/// std::print("{:.3f}\n", f.evaluate(0.5)); // 0.500
