function GamesHowell(const AValues: TArrayOfDouble; const AGroupSizes: TArrayOfInt64; AConfidenceLevel: Double): TArrayOfGamesHowellComparison; overload;
/// <summary>Tests group scale with Levene's mean or Brown–Forsythe's median centering.</summary>
/// <remarks>
/// <para>Calls C++ <c>datamunge::stats::levene_test</c>.</para>
/// <para>Runs one-way ANOVA on absolute within-group deviations. Independent observations and comparable group distribution shapes support interpreting the result as a scale test.</para>
/// <para><b>Example</b></para>
/// <code>
/// const auto fit = dm::stats::levene_test({1, 2, 4, 3, 6, 9, 12, 15, 3, 4, 5, 5}, {3, 5, 4});
/// std::print("{:.3f}\n", fit.statistic); // 3.550
/// </code>
/// <para><b>References</b></para>
/// <list type="bullet">
/// <item><description>Brown and Forsythe (1974), Robust Tests for the Equality of Variances, doi:10.1080/01621459.1974.10482955.</description></item>
/// <item><description>https://docs.scipy.org/doc/scipy/reference/generated/scipy.stats.levene.html</description></item>
/// </list>
/// <para>See also: <c>bartlett_test()</c>, <c>fligner_killeen_test()</c>.</para>
/// <para>Leaves out the C++ default arguments <c>AMedianCenter = True</c> (other overloads pass them).</para>
/// </remarks>
/// <param name="AValues">Finite observations concatenated by group.</param>
/// <param name="AGroupSizes">At least two groups of size two or larger partitioning values.</param>
/// <returns>F statistic, two degrees of freedom and an approximate upper-tail p-value.</returns>
