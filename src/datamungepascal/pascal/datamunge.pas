  /// <summary>A scatterplot matrix (R's <c>pairs()</c>, GGally's <c>ggpairs()</c>) over the columns of a data frame, with chainable setters; the SWIG-friendly facade for graphics::Splom.</summary>
  /// <remarks>
  /// <para>Wraps the C++ class <c>datamunge::Splom</c>.</para>
  /// <para>Panel (row i, column j) puts variable j on x and variable i on y. The panel type follows the two variables' kinds (numeric columns are quantitative, string columns categorical):</para>
  /// <list type="bullet">
  /// <item><description>diagonal: kernel density curves, one per group_by() group (numeric), or a stacked bar of level counts (string), titled with the variable name;</description></item>
  /// <item><description>numeric vs numeric above the diagonal: the points with a local linear smooth of the mean and a 95% prediction band, one per group; point colors follow set_col() or group_by();</description></item>
  /// <item><description>numeric vs numeric below the diagonal: bivariate kernel density contours, one set per group;</description></item>
  /// <item><description>string vs numeric: one raincloud per level (half violin, box plot, and jittered points);</description></item>
  /// <item><description>string vs string: a mosaic shaded by chi-squared Pearson residuals, with its p-value.</description></item>
  /// </list>
  /// <para>Values are copied at construction, so the frame need not outlive the matrix. Rows with a missing value in either variable are dropped from that panel only. Setters return <c>Splom&amp;</c> for chaining; nothing is drawn until to_svg(), save(), or show(). The default figure is 960 by 960 pixels with blue <c>{37, 99, 235}</c> points of radius 2.5.</para>
  /// <para><b>Example</b></para>
  /// <code>
  /// const auto iris = dm::datasets::iris();
  /// const auto species = dm::factor(dm::c(iris.get_column&lt;std::string&gt;("Species").values()));
  /// const auto palette = dm::c(dm::RGB{255, 255, 80}, dm::RGB{100, 255, 255},
  ///                            dm::RGB{220, 100, 255});
  /// auto pairs = dm::Splom(iris).set_title("Iris Pairs").set_col(species, palette);
  /// pairs.show();  // or pairs.save("iris_pairs.svg") without a display
  /// </code>
  /// <para>See also: <c>dm::splom()</c>, <c>dm::Plot</c>, <c>graphics::Splom</c>.</para>
  /// </remarks>
  TSplom = class(TNativeObject)
  public
    /// <summary>Builds the matrix from a facade DataFrame (the overload SWIG bindings use).</summary>
    /// <remarks>
    /// <para>Calls the C++ constructor of <c>datamunge::Splom</c>.</para>
