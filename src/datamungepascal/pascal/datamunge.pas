function _ToBytes(const V: TRosettaValue): TBytes;
var
  I: Integer;
begin
  Result := nil;
  if V.Tag in [5, 15] then
  begin
    SetLength(Result, System.Length(V.S));
    if V.S <> '' then Move(V.S[1], Result[0], System.Length(V.S));
    Exit;
  end;
  RosettaItems(V, 'TBytes');
  SetLength(Result, System.Length(V.Items));
  for I := 0 to High(V.Items) do Result[I] := RosettaToUInt8(V.Items[I]);
end;

