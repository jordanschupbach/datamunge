/// <para><b>Example</b></para>
/// <code>
/// const auto rows = dm::stats::games_howell({1, 2, 4, 3, 6, 9, 12, 15, 3, 4, 5, 5}, {3, 5, 4});
/// std::print("{:.5f}\n", rows.front().p_adjusted); // 0.07077
/// </code>
/// <para><b>References</b></para>
/// <list type="bullet">
/// <item><description>Games and Howell (1976), Pairwise Multiple Comparison Procedures with Unequal N's and/or Variances, doi:10.3102/10769986001002113.</description></item>
/// </list>
/// <para>See also: <c>welch_anova()</c>, <c>studentized_range_cdf()</c>.</para>
/// <para>Leaves out the C++ default arguments <c>AConfidenceLevel = 0.95</c> (other overloads pass them).</para>
/// </remarks>
/// <param name="AValues">Finite observations concatenated by group.</param>
/// <param name="AGroupSizes">At least two groups of size two or larger, each with positive variance.</param>
