function LeveneTest(const AValues: TArrayOfDouble; const AGroupSizes: TArrayOfInt64): THypothesisTestResult; overload;
/// <summary>Tests group scale with Levene's mean or Brown–Forsythe's median centering.</summary>
/// <remarks>
/// <para>Calls C++ <c>datamunge::stats::levene_test</c>.</para>
