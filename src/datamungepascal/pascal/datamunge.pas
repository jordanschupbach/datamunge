    /// <para>The window has toolbar and keyboard zoom/pan (it re-renders from data bounds) and closes on q or Escape; the function returns only then. The window title is <c>title_hint</c>, or the plot's title (title_text()) when the hint is empty. Requires a build with X11 support and a reachable <c>DISPLAY</c>; use save() in headless code such as tests and CI.</para>
    /// <para><b>Example</b></para>
    /// <code>
    /// const auto x = dm::runif(0, 1, 1000);
    /// const auto y = dm::sin(20 / (x + 0.25)) + dm::rnorm(0, 0.2, 1000);
    /// dm::Plot(x, y).set_title("Doppler").set_col("blue").show("Doppler signal");
    /// </code>
    /// <para>See also: <c>save()</c>, <c>to_svg()</c>.</para>
    /// <para>Leaves out the C++ default arguments <c>ATitleHint = ''</c> (other overloads pass them).</para>
    /// </remarks>
    /// <exception cref="ENativeError">Kind <c>Native</c> (C++ <c>std::runtime_error</c>): If X11 support was not compiled in, the display cannot be opened, its visual is unsupported, or the plot has no data series.</exception>
    procedure Show; overload;
    /// <summary>Opens the plot in an interactive X11 window and blocks until it is closed (like printing a plot in an interactive R session).</summary>
    /// <remarks>
    /// <para>Calls the C++ method <c>datamunge::graphics::Plot::show</c>.</para>
    /// <para>The window has toolbar and keyboard zoom/pan (it re-renders from data bounds) and closes on q or Escape; the function returns only then. The window title is <c>title_hint</c>, or the plot's title (title_text()) when the hint is empty. Requires a build with X11 support and a reachable <c>DISPLAY</c>; use save() in headless code such as tests and CI.</para>
    /// <para><b>Example</b></para>
    /// <code>
    /// const auto x = dm::runif(0, 1, 1000);
    /// const auto y = dm::sin(20 / (x + 0.25)) + dm::rnorm(0, 0.2, 1000);
    /// dm::Plot(x, y).set_title("Doppler").set_col("blue").show("Doppler signal");
    /// </code>
    /// <para>See also: <c>save()</c>, <c>to_svg()</c>.</para>
    /// </remarks>
    /// <param name="ATitleHint">Window title; empty (the default) uses the plot's title.</param>
    /// <exception cref="ENativeError">Kind <c>Native</c> (C++ <c>std::runtime_error</c>): If X11 support was not compiled in, the display cannot be opened, its visual is unsupported, or the plot has no data series.</exception>
    procedure Show(const ATitleHint: String); overload;
  end;

  /// <summary>A single R-base-graphics-style plot, spelled <c>dm::Plot</c> in user code.</summary>
  /// <remarks>
  /// <para>Wraps the C++ class <c>datamunge::graphics::RPlot</c>.</para>
  /// <para>Covers R's high-level plotting calls (<c>plot()</c>, <c>hist()</c>, <c>barplot()</c>, <c>boxplot()</c>, <c>pie()</c>, <c>curve()</c>, <c>qqnorm()</c>, ...) as constructors and static factories, plus the "add to the current plot" verbs R exposes as separate functions (<c>points()</c>, <c>lines()</c>, <c>abline()</c>, <c>legend()</c>, <c>text()</c>, ...) as chainable member functions. A plot is an ordinary value: it owns copies of its data, copies cheaply enough to pass around, and draws nothing until it is rendered with to_svg(), save(), or show().</para>
  /// <para>Two composition styles mix freely. Setters such as set_title() and verbs such as points() mutate the plot and return <c>RPlot&amp;</c> for chaining; the pipe <c>plot | dm::points(...)</c> (see compose.hpp) appends a reusable layer to a copy. A fresh plot has the title "datamunge plot", axis labels "x" and "y", a 960x640 canvas, and a light grid.</para>
  /// <para><b>Example</b></para>
  /// <code>
  /// const auto x = dm::seql(-2.0, 2.0, 9);
  /// auto plt = dm::Plot(x, x * x)
  ///                .set_title("Parabola")
  ///                .set_xlab("x")
  ///                .set_ylab("x squared");
  /// plt.lines(x, x * x, dm::RGB{220, 38, 38}).abline_h(0.0);
  /// plt.save("parabola.svg");
  /// </code>
  /// <para>See also: <c>dm::points()</c>, <c>dm::legend()</c>, <c>dm::Histogram</c>, <c>dm::Splom</c>, <c>RLayout</c>.</para>
  /// </remarks>
  TRPlot = class(TPlot)
  public
    /// <summary>Constructs an empty plot with default labels and styling, ready for layers.</summary>
    /// <remarks>
    /// <para>Calls the C++ constructor of <c>datamunge::graphics::RPlot</c>.</para>
    /// <para><b>Example</b></para>
    /// <code>
    /// auto plt = dm::Plot();
    /// std::print("{} | {} | {}\n", plt.title_text(), plt.x_label_text(), plt.y_label_text());
    /// // datamunge plot | x | y
    /// </code>
    /// </remarks>
    constructor Create; overload;
    /// <summary>Constructs a scatter plot of <c>y</c> against <c>x</c>, like R's <c>plot(x, y)</c>.</summary>
    /// <remarks>
    /// <para>Calls the C++ constructor of <c>datamunge::graphics::RPlot</c>.</para>
    /// <para>Equivalent to <c>RPlot::plot(x, y)</c>: one unlabeled scatter series drawn in blue <c>{37, 99, 235}</c> with 4-pixel markers; axis ranges fit the data. The coordinates are copied (or moved from rvalues); <c>dm::Vector&lt;double&gt;</c> converts implicitly. Restyle the points afterwards with set_col().</para>
    /// <para><b>Example</b></para>
    /// <code>
    /// const auto iris = dm::datasets::iris();
    /// auto plt = dm::Plot(iris.get_column("Petal.Length").values(),
    ///                     iris.get_column("Petal.Width").values())
    ///                .set_col("blue");
    /// plt.save("petals.svg");
    /// </code>
    /// <para>See also: <c>points()</c>, <c>set_col()</c>, <c>plot()</c>.</para>
    /// </remarks>
    /// <param name="AX">Horizontal coordinates, one per point.</param>
    /// <param name="AY">Vertical coordinates, paired with <c>x</c> by position.</param>
    /// <exception cref="ENativeError">Kind <c>InvalidArgument</c> (C++ <c>std::invalid_argument</c>): If the coordinates are empty or have different lengths.</exception>
    constructor Create(const AX: TArrayOfDouble; const AY: TArrayOfDouble); overload;
    /// <summary>Returns a fresh empty plot; same as the default constructor <c>dm::Plot()</c>.</summary>
    /// <remarks>
    /// <para>Calls the C++ method <c>datamunge::graphics::RPlot::create</c>.</para>
    /// <para>Kept for language bindings, where a named factory reads better than a constructor.</para>
    /// <para><b>Example</b></para>
    /// <code>
    /// auto plt = dm::Plot::create();
    /// std::print("{}\n", plt.series().size());  // 0
    /// </code>
    /// <para>See also: <c>RPlot()</c>.</para>
    /// </remarks>
    /// <returns>An empty plot with default labels and styling.</returns>
    class function Create2: TRPlot; overload; static;
    /// <summary>Sets the canvas size in pixels (default 960 by 640), like the <c>width</c>/<c>height</c> of R's <c>png()</c> or <c>svg()</c> device.</summary>
    /// <remarks>
    /// <para>Calls the C++ method <c>datamunge::graphics::RPlot::size</c>.</para>
    /// <para>Not validated here: rendering throws std::runtime_error when the canvas leaves no room inside the margins (by default the canvas must exceed 114 by 156 pixels).</para>
    /// <para><b>Example</b></para>
    /// <code>
    /// auto plt = dm::Plot(dm::c(1.0, 2.0), dm::c(1.0, 2.0)).size(400, 300);
    /// std::print("{}x{}\n", plt.width(), plt.height());  // 400x300
    /// </code>
    /// <para>See also: <c>margins()</c>.</para>
    /// </remarks>
    /// <param name="AWidth">Canvas width in pixels.</param>
    /// <param name="AHeight">Canvas height in pixels.</param>
    /// <returns>This plot, for chaining.</returns>
    function Size2(AWidth: Int64; AHeight: Int64): TRPlot; overload;
    /// <summary>Sets the resolution PNG and PDF output is rasterized at, like R's <c>png(res = )</c> and ggsave()'s <c>dpi =</c> (default 96).</summary>
    /// <remarks>
    /// <para>Calls the C++ method <c>datamunge::graphics::RPlot::dpi</c>.</para>
    /// <para>The layout, text and line widths keep their size relative to the plot; only the pixel count changes: a plot of width(units::inch{8}) saves as a 768-pixel-wide PNG at 96 dpi and a 2400-pixel-wide one at 300 dpi. A PNG records the resolution (its pHYs chunk) so other programs show it at its physical size; a PDF keeps its page size and gains detail. SVG output is vector and is unaffected.</para>
    /// <para><b>Example</b></para>
    /// <code>
    /// auto plt = dm::Plot(dm::c(1.0, 2.0), dm::c(1.0, 2.0)).width(dm::units::inch{2}).dpi(300);
    /// std::print("{} {}\n", plt.width(), plt.dpi());   // 192 300
    /// </code>
    /// <para><b>References</b></para>
    /// <list type="bullet">
    /// <item><description>R png() <c>res</c> argument: https://stat.ethz.ch/R-manual/R-devel/library/grDevices/html/png.html</description></item>
    /// <item><description>ggplot2 ggsave() <c>dpi</c> argument: https://ggplot2.tidyverse.org/reference/ggsave.html</description></item>
    /// </list>
    /// <para>See also: <c>width(units::Length)</c>, <c>height(units::Length)</c>, <c>save()</c>.</para>
    /// </remarks>
    /// <param name="AValue">Dots per inch; finite and positive.</param>
    /// <returns>This plot, for chaining.</returns>
    /// <exception cref="ENativeError">Kind <c>InvalidArgument</c> (C++ <c>std::invalid_argument</c>): If <c>value</c> is not finite and positive.</exception>
    function Dpi2(AValue: Double): TRPlot; overload;
    /// <summary>Sets the main heading, like R's <c>main =</c>; an empty string removes it.</summary>
    /// <remarks>
    /// <para>Calls the C++ method <c>datamunge::graphics::RPlot::title</c>.</para>
    /// <para>See also: <c>set_title()</c>.</para>
    /// </remarks>
    /// <param name="AValue">Heading text (copied).</param>
    /// <returns>This plot, for chaining.</returns>
    function Title2(const AValue: String): TRPlot; overload;
    /// <summary>Sets the subtitle and returns this plot for chaining RPlot verbs; same as set_subtitle().</summary>
    /// <remarks>
    /// <para>Calls the C++ method <c>datamunge::graphics::RPlot::subtitle</c>.</para>
    /// <para>See also: <c>set_subtitle()</c>.</para>
    /// </remarks>
    /// <param name="AValue">Subtitle text drawn under the title; empty removes it.</param>
    /// <returns>This plot, for chaining.</returns>
    function Subtitle2(const AValue: String): TRPlot; overload;
    /// <summary>Sets the horizontal-axis label; same as xlab() and set_xlab().</summary>
    /// <remarks>
    /// <para>Calls the C++ method <c>datamunge::graphics::RPlot::x_label</c>.</para>
    /// <para>See also: <c>set_xlab()</c>.</para>
    /// </remarks>
    /// <param name="AValue">Label text (copied).</param>
    /// <returns>This plot, for chaining.</returns>
    function XLabel2(const AValue: String): TRPlot; overload;
    /// <summary>Sets the vertical-axis label; same as ylab() and set_ylab().</summary>
    /// <remarks>
    /// <para>Calls the C++ method <c>datamunge::graphics::RPlot::y_label</c>.</para>
    /// <para>See also: <c>set_ylab()</c>.</para>
    /// </remarks>
    /// <param name="AValue">Label text (copied).</param>
    /// <returns>This plot, for chaining.</returns>
    function YLabel2(const AValue: String): TRPlot; overload;
    /// <summary>R-style alias for x_label(), like R's <c>xlab =</c>.</summary>
    /// <remarks>
    /// <para>Calls the C++ method <c>datamunge::graphics::RPlot::xlab</c>.</para>
    /// <para>See also: <c>set_xlab()</c>.</para>
    /// </remarks>
    /// <param name="AValue">Label text (copied).</param>
    /// <returns>This plot, for chaining.</returns>
    function Xlab(const AValue: String): TRPlot; overload;
    /// <summary>R-style alias for y_label(), like R's <c>ylab =</c>.</summary>
    /// <remarks>
    /// <para>Calls the C++ method <c>datamunge::graphics::RPlot::ylab</c>.</para>
    /// <para>See also: <c>set_ylab()</c>.</para>
    /// </remarks>
    /// <param name="AValue">Label text (copied).</param>
    /// <returns>This plot, for chaining.</returns>
    function Ylab(const AValue: String): TRPlot; overload;
    /// <summary>Sets the main heading drawn above the plotting area (R's <c>main =</c>).</summary>
    /// <remarks>
    /// <para>Calls the C++ method <c>datamunge::graphics::RPlot::set_title</c>.</para>
    /// <para>The plot owns a copy of the text. An empty string clears the heading; a fresh plot shows "datamunge plot" until this is called. Same as title().</para>
    /// <para><b>Example</b></para>
    /// <code>
    /// auto plt = dm::Plot(dm::c(1.0, 2.0, 3.0), dm::c(2.0, 4.0, 8.0))
    ///                .set_title("Growth")
    ///                .set_subtitle("Doubling every step")
    ///                .set_xlab("Step")
    ///                .set_ylab("Count");
    /// std::print("{} / {}\n", plt.title_text(), plt.subtitle_text());
    /// // Growth / Doubling every step
    /// </code>
    /// <para>See also: <c>set_subtitle()</c>, <c>set_xlab()</c>, <c>set_ylab()</c>, <c>dm::title()</c>.</para>
    /// </remarks>
    /// <param name="AValue">Heading text.</param>
    /// <returns>This plot, for chaining.</returns>
    function SetTitle(const AValue: String): TRPlot; overload;
    /// <summary>Sets the smaller second heading drawn beneath the title (unlike R's <c>sub =</c>, which sits below the x axis).</summary>
    /// <remarks>
    /// <para>Calls the C++ method <c>datamunge::graphics::RPlot::set_subtitle</c>.</para>
    /// <para>The plot owns a copy of the text. Empty (the default) draws no subtitle and reserves no extra top margin. Same as subtitle().</para>
    /// <para><b>Example</b></para>
    /// <code>
    /// auto plt = dm::Plot().set_title("Iris Dataset").set_subtitle("Sepal Width vs Length");
    /// plt.set_subtitle("");  // remove it again
    /// </code>
    /// <para>See also: <c>set_title()</c>, <c>dm::subtitle()</c>.</para>
    /// </remarks>
    /// <param name="AValue">Subtitle text.</param>
    /// <returns>This plot, for chaining.</returns>
    function SetSubtitle(const AValue: String): TRPlot; overload;
    /// <summary>Sets the horizontal-axis label (R's <c>xlab =</c>).</summary>
    /// <remarks>
    /// <para>Calls the C++ method <c>datamunge::graphics::RPlot::set_xlab</c>.</para>
    /// <para>The plot owns a copy of the text; the default is "x" and an empty string hides the label. Same as xlab() and x_label().</para>
    /// <para><b>Example</b></para>
    /// <code>
    /// auto plt = dm::Plot(dm::c(1.0, 2.0), dm::c(3.0, 4.0)).set_xlab("Sepal Width");
    /// std::print("{}\n", plt.x_label_text());  // Sepal Width
    /// </code>
    /// <para>See also: <c>set_ylab()</c>, <c>dm::xlab()</c>.</para>
    /// </remarks>
    /// <param name="AValue">Axis label text.</param>
    /// <returns>This plot, for chaining.</returns>
    function SetXlab(const AValue: String): TRPlot; overload;
    /// <summary>Sets the vertical-axis label (R's <c>ylab =</c>).</summary>
    /// <remarks>
    /// <para>Calls the C++ method <c>datamunge::graphics::RPlot::set_ylab</c>.</para>
    /// <para>The plot owns a copy of the text; the default is "y" and an empty string hides the label. Same as ylab() and y_label().</para>
    /// <para><b>Example</b></para>
    /// <code>
    /// auto plt = dm::Plot(dm::c(1.0, 2.0), dm::c(3.0, 4.0)).set_ylab("Sepal Length");
    /// std::print("{}\n", plt.y_label_text());  // Sepal Length
    /// </code>
    /// <para>See also: <c>set_xlab()</c>, <c>dm::ylab()</c>.</para>
    /// </remarks>
    /// <param name="AValue">Axis label text.</param>
    /// <returns>This plot, for chaining.</returns>
    function SetYlab(const AValue: String): TRPlot; overload;
    /// <summary>Recolors every data series already on the plot (R's <c>col =</c> applied after the fact).</summary>
    /// <remarks>
    /// <para>Calls the C++ method <c>datamunge::graphics::RPlot::set_col</c>.</para>
    /// <para>Every existing series (points, lines, bars, ...) takes <c>color</c>, and per-point palettes from dm::points(...).set_col() or points_colored() are cleared, so the whole plot becomes one color. Only layers present now are affected: points added later keep their own colors. Reference lines (abline) and manual legend entries keep their explicit colors.</para>
    /// <para><b>Example</b></para>
    /// <code>
    /// auto plt = dm::Plot(dm::c(1.0, 2.0, 3.0), dm::c(3.0, 1.0, 2.0))
    ///                .set_col(dm::RGB{220, 100, 255});
    /// std::print("{}\n", plt.series()[0].color.r);  // 220
    /// </code>
    /// <para>See also: <c>set_col(std::string)</c>, <c>dm::points()</c>.</para>
    /// </remarks>
    /// <param name="AColor">New color, including its alpha.</param>
    /// <returns>This plot, for chaining.</returns>
    function SetCol(AColor: TRgb): TRPlot; overload;
    /// <summary>Same as set_col(RGB) but takes a color name or hex string, like R's <c>col = "blue"</c>.</summary>
    /// <remarks>
    /// <para>Calls the C++ method <c>datamunge::graphics::RPlot::set_col</c>.</para>
    /// <para>Matching is case-insensitive. Names are black, white, red, green, blue, yellow, cyan, magenta, gray/grey, and transparent (a much smaller set than R's <c>colors()</c>). Green is RGB(0,128,0) as in CSS, and transparent is black with zero alpha. Hex strings are <c>#RRGGBB</c> or <c>#RRGGBBAA</c>, where AA is an alpha byte (<c>80</c> is about 0.5).</para>
    /// <para><b>Example</b></para>
    /// <code>
    /// const auto x = dm::runif(0, 1, 100);
    /// auto plt = dm::Plot(x, dm::rnorm(0, 1, 100)).set_col("blue");
    /// plt.set_col("#FF000080");  // half-transparent red
    /// const auto&amp; col = plt.series()[0].color;
    /// std::print("{} {:.2f}\n", col.r, col.alpha);  // 255 0.50
    /// </code>
    /// <para>See also: <c>set_col(RGB)</c>.</para>
    /// </remarks>
    /// <param name="AColor">Color name or hex string.</param>
    /// <returns>This plot, for chaining.</returns>
    /// <exception cref="ENativeError">Kind <c>InvalidArgument</c> (C++ <c>std::invalid_argument</c>): For unknown names or malformed hex; the plot is unchanged.</exception>
    function SetCol(const AColor: String): TRPlot; overload;
    /// <summary>Sets the fill color of the whole canvas, like R's <c>par(bg =)</c>.</summary>
    /// <remarks>
    /// <para>Calls the C++ method <c>datamunge::graphics::RPlot::background</c>.</para>
    /// <para>The default is white <c>{255, 255, 255}</c>. The color fills the margins as well as the plotting area. Its alpha is ignored: the background is always drawn opaque.</para>
    /// <para><b>Example</b></para>
    /// <code>
    /// auto plt = dm::Plot(dm::c(1.0, 2.0), dm::c(1.0, 2.0))
    ///                .background(dm::RGB{17, 24, 39})
    ///                .axis_color(dm::RGB{229, 231, 235})
    ///                .grid_color(dm::RGB{55, 65, 81});  // a dark theme
    /// std::print("{} {}\n", plt.background_color().r, plt.axes_color().r);  // 17 229
    /// </code>
    /// <para><b>References</b></para>
    /// <list type="bullet">
    /// <item><description>R <c>par()</c> (<c>bg</c>): https://stat.ethz.ch/R-manual/R-devel/library/graphics/html/par.html</description></item>
    /// </list>
    /// <para>See also: <c>axis_color()</c>, <c>grid_color()</c>.</para>
    /// </remarks>
    /// <param name="AColor">Canvas fill color.</param>
    /// <returns>This plot, for chaining.</returns>
    function Background2(AColor: TRgb): TRPlot; overload;
    /// <summary>Sets the color of the axis lines and of all plot-level text: tick labels, axis labels, title, and subtitle (R's <c>col.axis</c>, <c>col.lab</c>, and <c>col.main</c> in one).</summary>
    /// <remarks>
    /// <para>Calls the C++ method <c>datamunge::graphics::RPlot::axis_color</c>.</para>
    /// <para>The default is slate gray <c>{55, 65, 81}</c>. Legend text follows it too; text() labels and data layers keep their own colors.</para>
    /// <para><b>Example</b></para>
    /// <para>See background(), which builds a dark theme with all three color setters.</para>
    /// <para><b>References</b></para>
    /// <list type="bullet">
    /// <item><description>R <c>par()</c> (<c>col.axis</c>, <c>col.lab</c>, <c>col.main</c>): https://stat.ethz.ch/R-manual/R-devel/library/graphics/html/par.html</description></item>
    /// </list>
    /// <para>See also: <c>background()</c>, <c>grid_color()</c>.</para>
    /// </remarks>
    /// <param name="AColor">Axis and text color.</param>
    /// <returns>This plot, for chaining.</returns>
    function AxisColor2(AColor: TRgb): TRPlot; overload;
    /// <summary>Sets the color of the background grid lines (default light gray <c>{229, 231, 235}</c>).</summary>
    /// <remarks>
    /// <para>Calls the C++ method <c>datamunge::graphics::RPlot::grid_color</c>.</para>
