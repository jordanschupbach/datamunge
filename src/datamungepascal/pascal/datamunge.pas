    /// <para>Calls the C++ method <c>datamunge::Tape::value_at</c>.</para>
    /// </remarks>
    /// <param name="AIndex">Node index, as returned by Var::index().</param>
    /// <returns>The node's value.</returns>
    /// <exception cref="ENativeError">Kind <c>OutOfRange</c> (C++ <c>std::out_of_range</c>): When <c>index</c> &gt;= size().</exception>
    function ValueAt(AIndex: Int64): Double; overload;
    /// <summary>Reverse sweep from <c>output</c>: d(output)/d(node) for every node on the tape.</summary>
    /// <remarks>
    /// <para>Calls the C++ method <c>datamunge::Tape::backward</c>.</para>
