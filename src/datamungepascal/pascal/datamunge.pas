  /// <para>Wraps the C++ class <c>datamunge::algebra::Expr</c>.</para>
  /// </remarks>
  TExpr = class(TNativeObject)
  public
    /// <summary>Calls the C++ constructor of <c>datamunge::algebra::Expr</c>.</summary>
    constructor Create; overload;
    /// <summary>Construct a symbolic constant from a C++ numeric value, including implicit conversion.</summary>
    /// <remarks>
    /// <para>Calls the C++ constructor of <c>datamunge::algebra::Expr</c>.</para>
    /// <para>Numeric arguments convert to double, matching constant(); integers larger than double's exact integer range may round. Infinity and NaN are accepted. The new immutable node owns its value. Enables literals on either side of expression operators and assignment such as Expr f = 1. Does not add a conversion from Expr back to a number; use evaluate().</para>
    /// <para><b>Example</b></para>
    /// <code>
    /// dm::algebra::Expr value = 2.5;
    /// std::print("{}\n", value.evaluate({}, {})); // 2.5
    /// </code>
    /// <para>See also: <c>constant()</c>, <c>evaluate()</c>.</para>
    /// </remarks>
    /// <param name="AValue">Numeric constant, stored as a double without evaluation or simplification.</param>
    /// <exception cref="ENativeError">Kind <c>Allocation</c> (C++ <c>std::bad_alloc</c>): If the constant node cannot be allocated.</exception>
