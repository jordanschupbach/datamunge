    /// <summary>Opens <c>path</c> and infers its column types.</summary>
    /// <remarks>
    /// <para>Calls the C++ constructor of <c>datamunge::CsvReader</c>.</para>
    /// </remarks>
    /// <param name="APath">The CSV file.</param>
    /// <param name="ABatchSize">Rows per chunk; must be positive.</param>
    /// <param name="ADelimiter">The field separator.</param>
