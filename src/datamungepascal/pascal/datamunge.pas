/// <para>Leaves out the C++ default arguments <c>AExploration = 0.0</c> (other overloads pass them).</para>
/// </remarks>
/// <param name="AMean">Predicted mean</param>
/// <param name="ASd">Predicted standard deviation</param>
/// <param name="AIncumbent">Smallest value observed so far.</param>
/// <returns>The expected improvement (never negative).</returns>
