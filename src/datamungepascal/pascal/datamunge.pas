function GamesHowell(const AValues: TArrayOfDouble; const AGroupSizes: TArrayOfInt64): TArrayOfGamesHowellComparison; overload;
/// <summary>Compares all independent normal group means using Games–Howell intervals and p-values.</summary>
/// <remarks>
