    /// <para><b>Example</b></para>
    /// <para>See background(), which builds a dark theme with all three color setters.</para>
    /// <para>See also: <c>show_grid()</c>, <c>background()</c>.</para>
    /// </remarks>
    /// <param name="AColor">Grid-line color.</param>
    /// <returns>This plot, for chaining.</returns>
    function GridColor2(AColor: TRgb): TRPlot; overload;
    /// <summary>Turns the light background grid on or off (on by default), like adding or omitting R's <c>grid()</c>.</summary>
    /// <remarks>
    /// <para>Calls the C++ method <c>datamunge::graphics::RPlot::show_grid</c>.</para>
    /// <para>One vertical line per x tick and one horizontal line per y tick, so the grid always lines up with the tick labels (round values, evenly spaced ticks, or custom tick positions). Hidden axes hide the grid too.</para>
    /// <para><b>Example</b></para>
    /// <code>
    /// auto plt = dm::Plot(dm::c(1.0, 2.0), dm::c(1.0, 2.0)).show_grid(false);
    /// std::print("{}\n", plt.grid_visible());  // false
    /// </code>
    /// <para><b>References</b></para>
    /// <list type="bullet">
    /// <item><description>R <c>grid()</c>: https://stat.ethz.ch/R-manual/R-devel/library/graphics/html/grid.html</description></item>
    /// </list>
    /// <para>See also: <c>grid_color()</c>, <c>hide_axes()</c>.</para>
    /// <para>Leaves out the C++ default arguments <c>AEnabled = True</c> (other overloads pass them).</para>
    /// </remarks>
    /// <returns>This plot, for chaining.</returns>
    function ShowGrid2: TRPlot; overload;
    /// <summary>Turns the light background grid on or off (on by default), like adding or omitting R's <c>grid()</c>.</summary>
    /// <remarks>
    /// <para>Calls the C++ method <c>datamunge::graphics::RPlot::show_grid</c>.</para>
    /// <para>One vertical line per x tick and one horizontal line per y tick, so the grid always lines up with the tick labels (round values, evenly spaced ticks, or custom tick positions). Hidden axes hide the grid too.</para>
    /// <para><b>Example</b></para>
    /// <code>
    /// auto plt = dm::Plot(dm::c(1.0, 2.0), dm::c(1.0, 2.0)).show_grid(false);
    /// std::print("{}\n", plt.grid_visible());  // false
    /// </code>
    /// <para><b>References</b></para>
    /// <list type="bullet">
