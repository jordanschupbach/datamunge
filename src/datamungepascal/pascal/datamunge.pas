    /// <code>
    /// auto pairs = dm::Splom(dm::datasets::iris()).set_col(dm::RGBA{220, 38, 38, 0.5});
    /// </code>
    /// </remarks>
    /// <param name="AColor">Point color, alpha included; also used for bars without grouping.</param>
    /// <returns>This matrix, for chaining.</returns>
    function SetCol(AColor: TRgb): TSplom; overload;
    /// <summary>Same as title(), matching the <c>set_*</c> style of dm::Plot.</summary>
    /// <remarks>
    /// <para>Calls the C++ method <c>datamunge::Splom::set_title</c>.</para>
