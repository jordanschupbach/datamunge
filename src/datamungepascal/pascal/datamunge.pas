    /// <remarks>
    /// <para>Calls the C++ method <c>datamunge::algebra::Expr::differentiate</c>.</para>
    /// </remarks>
    /// <param name="AVar">A <c>String</c>.</param>
    /// <exception cref="ENativeError">Kind <c>InvalidArgument</c> (C++ <c>std::invalid_argument</c>): if the expression contains <c>base ^ exponent</c> where <c>exponent</c> is not a constant (only the constant-exponent power rule is supported).</exception>
