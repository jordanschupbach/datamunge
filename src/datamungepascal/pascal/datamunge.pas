    /// std::print("{} {}\n", grad[a.index()], grad[b.index()]);  // 3 2
    /// </code>
    /// </remarks>
    /// <param name="AOutput">A Var recorded on this tape (usually the final expression).</param>
    /// <returns>One adjoint per node, indexed by Var::index() (0-based; add 1 in R and Lua).</returns>
