  public
    /// <summary>Calls the C++ constructor of <c>datamunge::fem::BoundaryCondition1D</c>.</summary>
    constructor Create; overload;
  private
    function _Get900: TBcType;
    procedure _Set901(const AValue: TBcType);
  public
    /// <summary>Supported condition kind; defaults to Dirichlet..</summary>
    property &Type: TBcType read _Get900 write _Set901;
  private
    function _Get902: Double;
    procedure _Set903(const AValue: Double);
  public
    /// <summary>Prescribed value, conormal or Robin reference, as selected by type..</summary>
    property Value: Double read _Get902 write _Set903;
  private
    function _Get904: Double;
    procedure _Set905(const AValue: Double);
  public
    /// <summary>Robin alpha; ignored for other kinds..</summary>
    property RobinCoefficient: Double read _Get904 write _Set905;
  end;

