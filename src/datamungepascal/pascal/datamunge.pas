function BartlettTest(const AValues: TArrayOfDouble; const AGroupSizes: TArrayOfInt64): THypothesisTestResult; overload;
/// <summary>Fligner–Killeen scale test using normal scores of median-centered absolute deviations.</summary>
/// <remarks>
/// <para>Calls C++ <c>datamunge::stats::fligner_killeen_test</c>.</para>
/// <para>Ranks the pooled deviations with midranks for ties. The chi-square reference assumes independent groups and is asymptotic.</para>
/// <para><b>Example</b></para>
/// <code>
/// const auto fit = dm::stats::fligner_killeen_test({1, 2, 4, 3, 6, 9, 12, 15, 3, 4, 5, 5}, {3, 5, 4});
/// std::print("{:.3f}\n", fit.statistic); // 4.128
/// </code>
/// <para><b>References</b></para>
/// <list type="bullet">
/// <item><description>https://stat.ethz.ch/R-manual/R-devel/library/stats/html/fligner.test.html</description></item>
/// </list>
/// <para>See also: <c>levene_test()</c>, <c>bartlett_test()</c>.</para>
/// </remarks>
/// <param name="AValues">Finite observations concatenated by group.</param>
/// <param name="AGroupSizes">At least two groups of size two or larger partitioning values.</param>
/// <returns>Chi-square statistic, k-1 degrees of freedom and the approximate upper-tail p-value.</returns>
