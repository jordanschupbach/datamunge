/// <para><b>Example</b></para>
/// <code>
/// const auto w=dm::stats::wilcoxon_rank_sum_test({1,2,3},{4,5,6});
/// std::print("{:.0f}\n",w.statistic); // 0
/// </code>
/// <para><b>References</b></para>
/// <list type="bullet">
/// <item><description>https://stat.ethz.ch/R-manual/R-devel/library/stats/html/wilcox.test.html</description></item>
/// </list>
/// <para>See also: <c>HypothesisTestResult</c>.</para>
/// <para>Leaves out the C++ default arguments <c>AAlternative = TAlternative.TwoSided</c> (other overloads pass them).</para>
/// </remarks>
/// <param name="AX">Nonempty finite first sample.</param>
/// <param name="AY">Nonempty finite independent second sample.</param>
/// <returns>statistic=U=rank_sum(x)-n_x(n_x+1)/2 and approximate p_value; no CI or location estimate.</returns>
/// <exception cref="ENativeError">Kind <c>InvalidArgument</c> (C++ <c>std::invalid_argument</c>): Empty/nonfinite samples, invalid alternative or zero rank variance (all pooled observations tied).</exception>
function WilcoxonRankSumTest(const AX: TArrayOfDouble; const AY: TArrayOfDouble): THypothesisTestResult; overload;
