    /// <exception cref="ENativeError">Kind <c>InvalidArgument</c> (C++ <c>std::invalid_argument</c>): If point.size() != dimensions().</exception>
    function Locate(const APoint: TArrayOfDouble): Int32; overload;
    /// <summary>Creates (if needed) the child of <c>cell</c> at <c>slot</c>, materializing the next level when first reached. The represented function is unchanged.</summary>
    /// <remarks>
    /// <para>Calls the C++ method <c>datamunge::fda::TruncatedHierarchicalBSpline::refine</c>.</para>
    /// <para><b>Example</b></para>
    /// <code>
    /// auto b = dm::fda::BSplineBasis::open_uniform(1, 2);
    /// dm::fda::TruncatedHierarchicalBSpline thb(dm::fda::TensorBSpline(b, {0.0, 1.0}));
    /// thb.refine(thb.root(), 0);
    /// std::print("{} {}\n", thb.level_count(), thb.evaluate({0.25})); // 2 0.25
    /// </code>
    /// </remarks>
    /// <param name="ACell">Cell id.</param>
    /// <param name="ASlot">Child slot.</param>
    /// <returns>Child id.</returns>
