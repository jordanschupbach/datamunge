  /// <summary>Tiles independently built plots into one multi-panel figure, like R's <c>par(mfrow = c(rows, cols))</c> followed by one plot per panel.</summary>
  /// <remarks>
  /// <para>Wraps the C++ class <c>datamunge::graphics::RLayout</c>.</para>
  /// <para>Create it with create(rows, cols), then add() up to rows * cols panels; they fill the grid row by row. Each panel is copied (and its SVG rendered) at add() time, so later changes to the original plot do not show and panels need not outlive the layout. Each cell is <c>width / cols</c> by <c>(height - band) / rows</c> pixels, where band is title_band_px when a figure title is set and 0 otherwise; every panel is scaled from its own canvas size into its cell. The figure background is white. Unused cells stay empty.</para>
  /// <para><b>Example</b></para>
  /// <code>
  /// const auto x = dm::seql(0.0, 6.0, 30);
  /// auto fig = dm::graphics::RLayout::create(1, 2)
  ///                .size(1200, 500)
  ///                .title("Two views")
  ///                .add(dm::Plot(x, dm::sin(x)).set_title("sin"))
  ///                .add(dm::Plot(x, dm::cos(x)).set_title("cos"));
  /// std::print("{} panels in {}x{}\n", fig.panel_count(), fig.rows(), fig.cols());
  /// // 2 panels in 1x2
  /// fig.save("two_views.svg");
  /// </code>
  /// <para><b>References</b></para>
  /// <list type="bullet">
  /// <item><description>R <c>par()</c> (<c>mfrow</c>): https://stat.ethz.ch/R-manual/R-devel/library/graphics/html/par.html</description></item>
  /// </list>
  /// <para>See also: <c>RPlot</c>, <c>RPlot::margins()</c>, <c>dm::Splom</c>.</para>
  /// </remarks>
  TRLayout = class sealed(TNativeObject)
  public
    /// <summary>Calls the C++ constructor of <c>datamunge::graphics::RLayout</c>.</summary>
    constructor Create; overload;
    /// <summary>Creates an empty layout with <c>rows</c> by <c>cols</c> cells, like R's <c>par(mfrow = c(rows, cols))</c>.</summary>
    /// <remarks>
    /// <para>Calls the C++ method <c>datamunge::graphics::RLayout::create</c>.</para>
    /// <para>The figure starts at 960 by 640 pixels with no title.</para>
    /// <para><b>Example</b></para>
    /// <para>See RLayout.</para>
    /// <para><b>References</b></para>
    /// <list type="bullet">
    /// <item><description>R <c>par()</c> (<c>mfrow</c>): https://stat.ethz.ch/R-manual/R-devel/library/graphics/html/par.html</description></item>
    /// </list>
    /// <para>See also: <c>add()</c>.</para>
    /// </remarks>
    /// <param name="ARows">Number of panel rows; must be positive.</param>
    /// <param name="ACols">Number of panel columns; must be positive.</param>
    /// <returns>The empty layout.</returns>
    /// <exception cref="ENativeError">Kind <c>InvalidArgument</c> (C++ <c>std::invalid_argument</c>): If <c>rows</c> or <c>cols</c> is 0.</exception>
    class function Create2(ARows: Int64; ACols: Int64): TRLayout; overload; static;
    /// <summary>Copies <c>panel</c> into the next free cell, filling rows left to right, top to bottom.</summary>
    /// <remarks>
    /// <para>Calls the C++ method <c>datamunge::graphics::RLayout::add</c>.</para>
    /// <para>The panel's SVG is rendered immediately and stored with the copy, so rendering errors surface here and later edits to the original plot have no effect on the layout.</para>
    /// <para><b>Example</b></para>
    /// <code>
    /// auto fig = dm::graphics::RLayout::create(1, 1).add(dm::Plot(dm::c(1.0, 2.0), dm::c(2.0, 1.0)));
    /// try {
    ///   fig.add(dm::Plot(dm::c(1.0), dm::c(1.0)));
    /// } catch (const std::invalid_argument&amp; e) {
    ///   std::print("{}\n", e.what());  // RLayout::add: layout is already full
    /// }
    /// </code>
    /// <para>See also: <c>panel()</c>, <c>panel_count()</c>.</para>
    /// </remarks>
    /// <param name="APanel">The plot to add; any RPlot (or other Plot) converts.</param>
    /// <returns>This layout, for chaining.</returns>
    /// <exception cref="ENativeError">Kind <c>InvalidArgument</c> (C++ <c>std::invalid_argument</c>): If all rows * cols cells are already filled.</exception>
    /// <exception cref="ENativeError">Kind <c>Native</c> (C++ <c>std::runtime_error</c>): If <c>panel</c> has no data series or its canvas is smaller than its margins.</exception>
    function Add(APanel: TPlot): TRLayout; overload;
    /// <summary>Sets the size of the whole figure in pixels (default 960 by 640).</summary>
    /// <remarks>
    /// <para>Calls the C++ method <c>datamunge::graphics::RLayout::size</c>.</para>
    /// <para>Panels keep their own canvas sizes and are scaled into their cells, so text in a panel shrinks or grows with it; give panels a size close to their cell for readable labels.</para>
    /// <para><b>Example</b></para>
    /// <para>See RLayout.</para>
    /// <para>See also: <c>title()</c>.</para>
    /// </remarks>
    /// <param name="AWidth">Figure width in pixels.</param>
    /// <param name="AHeight">Figure height in pixels, including the title band.</param>
    /// <returns>This layout, for chaining.</returns>
    function Size(AWidth: Int64; AHeight: Int64): TRLayout; overload;
    /// <summary>Sets the resolution PNG and PDF output is rasterized at, like R's <c>png(res = )</c> and ggsave()'s <c>dpi =</c> (default 96).</summary>
    /// <remarks>
    /// <para>Calls the C++ method <c>datamunge::graphics::RLayout::dpi</c>.</para>
    /// <para>The layout, text and line widths keep their size relative to the layout; only the pixel count changes: a layout of width(units::inch{8}) saves as a 768-pixel-wide PNG at 96 dpi and a 2400-pixel-wide one at 300 dpi. A PNG records the resolution (its pHYs chunk) so other programs show it at its physical size; a PDF keeps its page size and gains detail. SVG output is vector and is unaffected.</para>
    /// <para><b>Example</b></para>
    /// <code>
    /// auto grid = dm::graphics::RLayout::create(1, 2).width(dm::units::inch{6}).dpi(300);
    /// std::print("{} {}\n", grid.width(), grid.dpi());   // 576 300
    /// </code>
    /// <para><b>References</b></para>
    /// <list type="bullet">
    /// <item><description>R png() <c>res</c> argument: https://stat.ethz.ch/R-manual/R-devel/library/grDevices/html/png.html</description></item>
    /// <item><description>ggplot2 ggsave() <c>dpi</c> argument: https://ggplot2.tidyverse.org/reference/ggsave.html</description></item>
    /// </list>
    /// <para>See also: <c>width(units::Length)</c>, <c>height(units::Length)</c>, <c>save()</c>.</para>
    /// </remarks>
    /// <param name="AValue">Dots per inch; finite and positive.</param>
    /// <returns>This layout, for chaining.</returns>
    /// <exception cref="ENativeError">Kind <c>InvalidArgument</c> (C++ <c>std::invalid_argument</c>): If <c>value</c> is not finite and positive.</exception>
    function Dpi(AValue: Double): TRLayout; overload;
    /// <summary>The resolution PNG and PDF output is rasterized at (default 96).</summary>
    /// <remarks>
    /// <para>Calls the C++ method <c>datamunge::graphics::RLayout::dpi</c>.</para>
    /// </remarks>
    /// <returns>Dots per inch.</returns>
    function Dpi: Double; overload;
    /// <summary>Sets an optional figure-level heading drawn in a band above the panels, like R's <c>mtext(main, outer = TRUE)</c>; an empty string (the default) reserves no band.</summary>
    /// <remarks>
    /// <para>Calls the C++ method <c>datamunge::graphics::RLayout::title</c>.</para>
    /// <para><b>Example</b></para>
    /// <para>See RLayout.</para>
    /// <para><b>References</b></para>
    /// <list type="bullet">
    /// <item><description>R <c>mtext()</c>: https://stat.ethz.ch/R-manual/R-devel/library/graphics/html/mtext.html</description></item>
    /// </list>
    /// <para>See also: <c>title_text()</c>.</para>
    /// </remarks>
    /// <param name="AValue">Heading text; the band is title_band_px pixels tall.</param>
    /// <returns>This layout, for chaining.</returns>
    function Title(const AValue: String): TRLayout; overload;
    /// <summary>Returns the number of panel rows given to create().</summary>
    /// <remarks>
    /// <para>Calls the C++ method <c>datamunge::graphics::RLayout::rows</c>.</para>
    /// </remarks>
    /// <returns>Row count (at least 1).</returns>
    function Rows: Int64; overload;
    /// <summary>Returns the number of panel columns given to create().</summary>
    /// <remarks>
    /// <para>Calls the C++ method <c>datamunge::graphics::RLayout::cols</c>.</para>
    /// </remarks>
    /// <returns>Column count (at least 1).</returns>
    function Cols: Int64; overload;
    /// <summary>Returns the figure width in pixels.</summary>
    /// <remarks>
    /// <para>Calls the C++ method <c>datamunge::graphics::RLayout::width</c>.</para>
    /// </remarks>
    /// <returns>Width set by size() (default 960).</returns>
    function Width: Int64; overload;
    /// <summary>Returns the figure height in pixels.</summary>
    /// <remarks>
    /// <para>Calls the C++ method <c>datamunge::graphics::RLayout::height</c>.</para>
    /// </remarks>
    /// <returns>Height set by size() (default 640).</returns>
    function Height: Int64; overload;
    /// <summary>Returns how many panels have been added.</summary>
    /// <remarks>
    /// <para>Calls the C++ method <c>datamunge::graphics::RLayout::panel_count</c>.</para>
    /// </remarks>
    /// <returns>Panel count, at most rows() * cols().</returns>
    function PanelCount: Int64; overload;
    /// <summary>Borrows the figure-level heading for the lifetime of this layout.</summary>
    /// <remarks>
    /// <para>Calls the C++ method <c>datamunge::graphics::RLayout::title_text</c>.</para>
    /// </remarks>
    /// <returns>The title; empty (the default) when none is drawn.</returns>
    function TitleText: String; overload;
    /// <summary>Borrows the copy of the <c>index-th</c> added panel.</summary>
    /// <remarks>
    /// <para>Calls the C++ method <c>datamunge::graphics::RLayout::panel</c>.</para>
    /// <para><b>Example</b></para>
    /// <code>
    /// auto fig = dm::graphics::RLayout::create(1, 2).add(dm::Plot(dm::c(1.0), dm::c(1.0)).set_title("A"));
    /// std::print("{}\n", fig.panel(0).title_text());  // A
    /// </code>
    /// </remarks>
    /// <param name="AIndex">Zero-based panel index, in the order panels were added.</param>
    /// <returns>The stored copy, valid until the next add() or the layout's destruction.</returns>
    /// <exception cref="ENativeError">Kind <c>OutOfRange</c> (C++ <c>std::out_of_range</c>): If <c>index</c> is not below panel_count().</exception>
    function Panel(AIndex: Int64): TPlot; overload;
    /// <summary>Renders the multi-panel figure as a standalone SVG document and returns it as a string.</summary>
    /// <remarks>
    /// <para>Calls the C++ method <c>datamunge::graphics::RLayout::to_svg</c>.</para>
    /// <para>Each panel becomes a nested <c>&lt;svg&gt;</c> scaled into its cell. A layout with no panels renders as an empty white figure. The layout is not modified.</para>
    /// <para><b>Example</b></para>
    /// <code>
    /// auto fig = dm::graphics::RLayout::create(2, 1).add(dm::Plot(dm::c(1.0, 2.0), dm::c(1.0, 2.0)));
    /// std::print("{}\n", fig.to_svg().starts_with("&lt;?xml"));  // true
    /// </code>
    /// <para>See also: <c>save()</c>.</para>
    /// </remarks>
    /// <returns>The complete SVG text.</returns>
    function ToSvg: String; overload;
    /// <summary>Saves the figure, choosing the format from the extension: <c>.svg</c> (or none) writes SVG, <c>.png</c> / <c>.pdf</c> write the same tiled raster the X11 viewer shows.</summary>
    /// <remarks>
    /// <para>Calls the C++ method <c>datamunge::graphics::RLayout::save</c>.</para>
    /// <para>The extension is case-sensitive and an existing file is overwritten. Raster panels are re-rendered from the stored copies and scaled into their cells.</para>
    /// <para><b>Example</b></para>
    /// <para>See RLayout.</para>
    /// <para>See also: <c>save_svg()</c>, <c>to_svg()</c>, <c>show()</c>.</para>
    /// </remarks>
    /// <param name="APath">Destination file.</param>
    /// <exception cref="ENativeError">Kind <c>InvalidArgument</c> (C++ <c>std::invalid_argument</c>): For any other extension.</exception>
    /// <exception cref="ENativeError">Kind <c>Native</c> (C++ <c>std::runtime_error</c>): If the file cannot be written.</exception>
    procedure Save(const APath: String); overload;
    /// <summary>Writes to_svg() to <c>path</c> regardless of its extension.</summary>
    /// <remarks>
    /// <para>Calls the C++ method <c>datamunge::graphics::RLayout::save_svg</c>.</para>
    /// <para>See also: <c>save()</c>.</para>
    /// </remarks>
    /// <param name="APath">Destination file; an existing file is overwritten.</param>
    /// <exception cref="ENativeError">Kind <c>Native</c> (C++ <c>std::runtime_error</c>): If the file cannot be opened for writing.</exception>
    procedure SaveSvg(const APath: String); overload;
    /// <summary>Renders the tiled figure as PNG image bytes (the raster save() writes for <c>.png</c>).</summary>
    /// <remarks>
    /// <para>Calls the C++ method <c>datamunge::graphics::RLayout::to_png</c>.</para>
    /// <para>See also: <c>save_png()</c>, <c>to_svg()</c>.</para>
    /// </remarks>
    /// <returns>The complete PNG file contents.</returns>
    /// <exception cref="ENativeError">Kind <c>Native</c> (C++ <c>std::runtime_error</c>): If a panel cannot be rendered.</exception>
    function ToPng: TBytes; overload;
    /// <summary>Renders the tiled figure as a one-page PDF holding the raster image.</summary>
    /// <remarks>
    /// <para>Calls the C++ method <c>datamunge::graphics::RLayout::to_pdf</c>.</para>
    /// <para>See also: <c>save_pdf()</c>, <c>to_png()</c>.</para>
    /// </remarks>
    /// <returns>The complete PDF file contents.</returns>
    /// <exception cref="ENativeError">Kind <c>Native</c> (C++ <c>std::runtime_error</c>): If a panel cannot be rendered.</exception>
    function ToPdf: TBytes; overload;
    /// <summary>Writes to_png() to <c>path</c> regardless of its extension.</summary>
    /// <remarks>
    /// <para>Calls the C++ method <c>datamunge::graphics::RLayout::save_png</c>.</para>
    /// </remarks>
    /// <param name="APath">Destination file; an existing file is overwritten.</param>
    /// <exception cref="ENativeError">Kind <c>Native</c> (C++ <c>std::runtime_error</c>): If the file cannot be written or a panel cannot be rendered.</exception>
    procedure SavePng(const APath: String); overload;
    /// <summary>Writes to_pdf() to <c>path</c> regardless of its extension.</summary>
    /// <remarks>
    /// <para>Calls the C++ method <c>datamunge::graphics::RLayout::save_pdf</c>.</para>
    /// </remarks>
    /// <param name="APath">Destination file; an existing file is overwritten.</param>
    /// <exception cref="ENativeError">Kind <c>Native</c> (C++ <c>std::runtime_error</c>): If the file cannot be written or a panel cannot be rendered.</exception>
    procedure SavePdf(const APath: String); overload;
    /// <summary>Resizes every stored panel's canvas to its cell, so text keeps its pixel size instead of being scaled with the panel.</summary>
    /// <remarks>
    /// <para>Calls the C++ method <c>datamunge::graphics::RLayout::fit_panels</c>.</para>
    /// <para>Call it after size() and title() (the title band changes the cell height). Panels added later keep their own size until fit_panels() is called again. A cell whose shorter side is under min_panel_px gets a canvas scaled up to that side (same aspect ratio), so its text is drawn proportionally smaller instead of the margins overflowing the panel.</para>
    /// <para><b>Example</b></para>
    /// <code>
    /// auto fig = dm::graphics::RLayout::create(1, 2)
    ///                .add(dm::Plot(dm::c(1.0, 2.0), dm::c(2.0, 1.0)))
    ///                .add(dm::Plot(dm::c(1.0, 2.0), dm::c(1.0, 2.0)))
    ///                .size(1000, 400)
    ///                .fit_panels();
    /// std::print("{}x{}\n", fig.panel(0).width(), fig.panel(0).height());  // 500x400
    /// </code>
    /// <para>See also: <c>size()</c>.</para>
    /// </remarks>
    /// <returns>This layout, for chaining.</returns>
    function FitPanels: TRLayout; overload;
    /// <summary>Opens the tiled figure in the interactive X11 viewer; the toolbar zoom/pan buttons act on every panel's data bounds at once, keyboard zoom/pan scales the whole image.</summary>
    /// <remarks>
    /// <para>Calls the C++ method <c>datamunge::graphics::RLayout::show</c>.</para>
