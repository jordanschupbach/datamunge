    /// <param name="APath">The CSV file.</param>
    /// <param name="ABatchSize">Rows per chunk; must be positive.</param>
    /// <exception cref="ENativeError">Kind <c>InvalidArgument</c> (C++ <c>std::invalid_argument</c>): if batch_size is not positive.</exception>
