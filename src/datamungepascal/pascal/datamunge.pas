    /// <returns>d.</returns>
    function Dimensions: Int64; overload;
    /// <summary>Number of materialized levels (1 + deepest cell depth).</summary>
    /// <remarks>
    /// <para>Calls the C++ method <c>datamunge::fda::TruncatedHierarchicalBSpline::level_count</c>.</para>
    /// </remarks>
    /// <returns>Level count.</returns>
    function LevelCount: Int32; overload;
    /// <summary>The level- <c>l</c> spline on the whole domain; it equals the hierarchy wherever Omega^l but not Omega^(l+1) applies.</summary>
    /// <remarks>
    /// <para>Calls the C++ method <c>datamunge::fda::TruncatedHierarchicalBSpline::level</c>.</para>
    /// </remarks>
    /// <param name="ALevel">Level in [0, level_count()).</param>
    /// <returns>Reference valid until the next refinement or coefficient edit.</returns>
    /// <exception cref="ENativeError">Kind <c>OutOfRange</c> (C++ <c>std::out_of_range</c>): For an invalid level.</exception>
    function Level(ALevel: Int32): TTensorBSpline; overload;
