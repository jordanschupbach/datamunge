  public
    /// <summary>Refined basis (same degree and domain).; the object belongs to this one.</summary>
    property Basis: TBSplineBasis read _Get3325 write _Set3326;
  end;

  /// <summary>A scalar tensor-product B-spline f(x) = sum_j c_j B_j(x) with owned coefficients.</summary>
  /// <remarks>
  /// <para>Wraps the C++ class <c>datamunge::fda::TensorBSpline</c>.</para>
