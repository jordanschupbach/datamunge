    /// <returns>d coordinates.</returns>
    /// <exception cref="ENativeError">Kind <c>OutOfRange</c> (C++ <c>std::out_of_range</c>): For an invalid id.</exception>
    function CellMax(ACell: Int32): TArrayOfDouble; overload;
    /// <summary>Deepest cell containing <c>point</c> (its depth is the finest level there).</summary>
    /// <remarks>
    /// <para>Calls the C++ method <c>datamunge::fda::TruncatedHierarchicalBSpline::locate</c>.</para>
