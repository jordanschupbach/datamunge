/// <para>See also: <c>levene_test()</c>, <c>fligner_killeen_test()</c>.</para>
/// </remarks>
/// <param name="AValues">Finite observations concatenated by group.</param>
/// <param name="AGroupSizes">At least two groups of size two or larger, each with positive variance.</param>
/// <returns>K-squared statistic, k-1 degrees of freedom and approximate chi-square upper tail.</returns>
