    /// <para>Calls the C++ method <c>datamunge::fda::BSplineRefinement::apply</c>.</para>
    /// <para><b>Example</b></para>
    /// <code>
    /// auto r = dm::fda::dyadic_refine(dm::fda::BSplineBasis::open_uniform(1, 2));
    /// std::print("{}\n", r.apply({0.0, 2.0})); // [0, 1, 2]
    /// </code>
    /// </remarks>
    /// <param name="ACoefficients">One coefficient per coarse basis function.</param>
    /// <returns>One coefficient per refined basis function, representing the same spline.</returns>
    /// <exception cref="ENativeError">Kind <c>InvalidArgument</c> (C++ <c>std::invalid_argument</c>): If <c>coefficients</c> does not match the coarse basis size.</exception>
