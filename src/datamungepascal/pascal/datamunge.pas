    function Choropleth(const AX: TArrayOfArrayOfDouble; const AY: TArrayOfArrayOfDouble; const AValues: TArrayOfDouble): TRPlot; overload;
    /// <summary>Colors region polygons on one shared numeric scale.</summary>
    /// <remarks>
    /// <para>Calls the C++ method <c>datamunge::graphics::RPlot::choropleth</c>.</para>
