cabal-version:      2.4
-- The GHC package of the Rosetta-generated Haskell binding (just build-haskell builds and registers it in
-- <prefix>/lib/haskell/package.db). The modules are generated (scripts/prebuild_bindings.py haskell).
name:               datamunge
version:            0.0.1
synopsis:           Haskell bindings to the C++ library datamunge (generated by Rosetta)
license:            NONE
build-type:         Simple

library
  exposed-modules:  Datamunge
                    Datamunge.Rosetta
  hs-source-dirs:   haskell
  build-depends:    base >=4.14 && <5, containers, bytestring
  default-language: Haskell2010
  -- The binding is a thin FFI layer: optimizing its 60k lines costs minutes and gains nothing.
  ghc-options:      -O0
  -- The C ABI library (libdatamunge_haskell); configure with --extra-lib-dirs=<its directory>.
  extra-libraries:  datamunge_haskell
