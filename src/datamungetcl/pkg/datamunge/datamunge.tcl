        #     datamunge::PSplineRegression new x:list of double y:list of double knots:list of double
        #     datamunge::PSplineRegression new x:list of double y:list of double knots:list of double lambda:double ?degree:unsigned int? ?penalty_order:unsigned int?
        #   errors:
        #     {DATAMUNGE invalid_argument} For invalid data or basis size.
        #     {DATAMUNGE runtime_error} If all candidate systems fail numerically.
