        #         .add(dm::Plot(x, dm::cos(x)))
        #         .show("Trig");
        #
        method show {{title_hint {}}} {}
        # view -- Same as show(); kept as an alias for older code.
        #
        #   usage: $obj view ?title_hint?
        #   args:
        #     title_hint - string, default {}: Window title; empty (the default) uses title_text().
        #   errors:
        #     {DATAMUNGE runtime_error} As for show().
        #     {DATAMUNGE invalid_argument} If no panel was added.
        #   see: show()
        #
        method view {{title_hint {}}} {}
    }
    # create_ -- Creates an empty layout with `rows` by `cols` cells, like R's `par(mfrow = c(rows, cols))`.
    #
    #   The figure starts at 960 by 640 pixels with no title.
    #
    #   See RLayout.
