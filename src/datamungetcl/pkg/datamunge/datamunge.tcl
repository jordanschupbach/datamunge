    #   destroys the C++ object.
    #   fields (`$obj cget -name`, `$obj configure -name value`):
    #     -cells - unsigned int: Exactly a.size()*b.size() recurrence evaluations.
    #     -predecessor_reads - unsigned int: Three slots per recurrence cell, including borders.
    #     -traceback_steps - unsigned int: Number of actual output index pairs, including origin.
    #
    oo::class create DTWWork {
        superclass ::datamunge::NativeObject
        # constructor -- Creates the C++ object (datamunge::geometry::DTWWork::DTWWork).
        #
        #   usage: datamunge::DTWWork new
        #
        constructor {} {}
        # cells -- Exactly a.size()*b.size() recurrence evaluations.
        #
        #   usage: $obj cells ?value?
        #   result: unsigned int (nothing when setting)
        #
        method cells {{value {}}} {}
        # predecessor_reads -- Three slots per recurrence cell, including borders.
        #
        #   usage: $obj predecessor_reads ?value?
        #   result: unsigned int (nothing when setting)
        #
        method predecessor_reads {{value {}}} {}
        # traceback_steps -- Number of actual output index pairs, including origin.
        #
        #   usage: $obj traceback_steps ?value?
