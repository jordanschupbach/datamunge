    #
    proc circle_contains {circle p} {}

    # min_enclosing_circle -- The smallest circle enclosing every point in `points` (Welzl's algorithm, the classical "incremental with boundary point sets" formulation: a point violating the current circle must lie on the boundary of the true minimal circle, so it's fixed in place and the problem re-solved for the remaining points). Points are shuffled first (fixed seed, for determinism) since the algorithm's expected running time depends on processing order; this implementation skips the further "move-to-front" optimization real Welzl uses for guaranteed expected-linear time; O(n^3) worst case here is still polynomial and far simpler to get right, matching this module's usual complexity/simplicity tradeoff. Throws std::invalid_argument for an empty input.
    #
    #   usage: datamunge::min_enclosing_circle points
    #   args:
    #     points - list of Point2D
    #   result: Circle
    #
    proc min_enclosing_circle {points} {}

    # point_in_polygon -- True if `point` lies strictly inside the simple polygon `vertices` (given in either winding order), via the standard even-odd ray-casting rule (Franklin's PNPOLY). Behavior for a point exactly on an edge is unspecified (as it is for every ray-casting implementation) -- it may be reported as inside or outside depending on which edge and floating-point rounding.
    #
    #   usage: datamunge::point_in_polygon point vertices
    #   args:
    #     point - Point2D
    #     vertices - list of Point2D
    #   result: bool
    #
    proc point_in_polygon {point vertices} {}

    # signed_polygon_area -- The polygon's signed area via the shoelace formula: positive for counterclockwise-ordered vertices, negative for clockwise.
    #
    #   usage: datamunge::signed_polygon_area vertices
    #   args:
    #     vertices - list of Point2D
    #   result: double
    #
    proc signed_polygon_area {vertices} {}

    # polygon_area -- The polygon's (unsigned) area, regardless of vertex winding order.
    #
    #   usage: datamunge::polygon_area vertices
    #   args:
    #     vertices - list of Point2D
    #   result: double
    #
    proc polygon_area {vertices} {}

    # polygon_centroid -- The centroid (center of mass, assuming uniform density) of the polygon's ENCLOSED AREA -- not the average of its vertex coordinates, which is a different point for any non-regular polygon. Throws std::invalid_argument for a degenerate (zero-area, e.g. collinear or fewer-than-3-vertex) polygon, since the formula divides by the signed area.
    #
    #   usage: datamunge::polygon_centroid vertices
    #   args:
    #     vertices - list of Point2D
    #   result: Point2D
    #
    proc polygon_centroid {vertices} {}

    # is_convex_polygon -- True if `vertices` form a convex polygon: every triple of consecutive vertices turns the same way (all left turns or all right turns), with no reflex vertices. Fewer than 3 vertices is never convex.
    #
    #   usage: datamunge::is_convex_polygon vertices
    #   args:
    #     vertices - list of Point2D
    #   result: bool
    #
    proc is_convex_polygon {vertices} {}

    # orientation -- Calls C++ datamunge::geometry::orientation.
    #
    #   usage: datamunge::orientation a b c
    #   args:
    #     a - Point2D
    #     b - Point2D
    #     c - Point2D
    #   result: Orientation
    #
    proc orientation {a b c} {}

    # on_segment -- Calls C++ datamunge::geometry::detail::on_segment.
    #
    #   usage: datamunge::on_segment p q r
    #   args:
    #     p - Point2D
    #     q - Point2D
    #     r - Point2D
    #   result: bool
    #
    proc on_segment {p q r} {}

    # segments_intersect -- True if segments p1-q1 and p2-q2 intersect (including touching at an endpoint, or overlapping collinear segments) -- the standard CLRS-style orientation-based test.
    #
    #   usage: datamunge::segments_intersect p1 q1 p2 q2
    #   args:
    #     p1 - Point2D
    #     q1 - Point2D
    #     p2 - Point2D
    #     q2 - Point2D
    #   result: bool
    #
    proc segments_intersect {p1 q1 p2 q2} {}

    # line_intersection_point -- The intersection point of INFINITE lines through (p1, p2) and through (p3, p4), if one exists (writes it to `out` and returns true) -- false for parallel or (exactly) coincident lines. Unlike segments_intersect(), this treats both inputs as unbounded lines, not segments.
    #
    #   usage: datamunge::line_intersection_point p1 p2 p3 p4 out
    #   args:
    #     p1 - Point2D
    #     p2 - Point2D
    #     p3 - Point2D
    #     p4 - Point2D
    #     out - Point2D
    #   result: bool
    #
    proc line_intersection_point {p1 p2 p3 p4 out} {}

    # segment_intersection_point -- The (single) intersection point of segments p1-q1 and p2-q2, if one exists (writes it to `out` and returns true). Returns false whenever segments_intersect() would (non-intersecting segments) AND for the collinear-overlapping case that segments_intersect() reports as true -- there, infinitely many points satisfy the intersection, so no single Point2D can represent it.
    #
    #   usage: datamunge::segment_intersection_point p1 q1 p2 q2 out
    #   args:
    #     p1 - Point2D
    #     q1 - Point2D
    #     p2 - Point2D
    #     q2 - Point2D
    #     out - Point2D
    #   result: bool
    #
    proc segment_intersection_point {p1 q1 p2 q2 out} {}

    # inside_clip_edge -- Calls C++ datamunge::geometry::detail::inside_clip_edge.
    #
    #   usage: datamunge::inside_clip_edge p edge_a edge_b
    #   args:
    #     p - Point2D
    #     edge_a - Point2D
    #     edge_b - Point2D
    #   result: bool
    #
    proc inside_clip_edge {p edge_a edge_b} {}

    # clip_polygon -- Clips `subject` (any simple polygon, convex or not) against `clip` (Sutherland- Hodgman) and returns their intersection as a new polygon. `clip` MUST be convex AND counterclockwise-ordered (exactly what convex_hull() produces) -- the algorithm processes it one directed edge at a time, keeping only the subject-polygon portion to the left of every edge, so a clockwise or non-convex clip polygon silently produces a wrong (or empty) result rather than an error. Returns an empty polygon if the two don't overlap at all.
    #
    #   usage: datamunge::clip_polygon subject clip
    #   args:
    #     subject - list of Point2D
    #     clip - list of Point2D
    #   result: list of Point2D
    #
    proc clip_polygon {subject clip} {}

    # point_in_triangle -- Calls C++ datamunge::geometry::detail::point_in_triangle.
    #
    #   usage: datamunge::point_in_triangle p a b c
    #   args:
    #     p - Point2D
    #     a - Point2D
    #     b - Point2D
    #     c - Point2D
    #   result: bool
    #
    proc point_in_triangle {p a b c} {}

    # triangulate_polygon -- Triangulates a SIMPLE polygon (convex or not, but not self-intersecting) by ear clipping: repeatedly finds a "ear" -- a convex vertex whose neighbor-triangle contains no other polygon vertex -- clips it off as one output triangle, and repeats on the remaining (n-1)-vertex polygon. O(n^3) worst case (each of the O(n) clipped ears requires an O(n) scan to verify, each vertex check O(1)) -- unlike delaunay_triangulation() (which only sees an unordered point SET), this respects the polygon's actual boundary, so it correctly handles concave (non-convex) shapes. Every triangle's vertices are indices into `polygon`. Works for any winding order (detects and internally corrects clockwise input). Returns empty for fewer than 3 vertices; a triangle input returns itself unchanged.
    #
    #   usage: datamunge::triangulate_polygon polygon
    #   args:
    #     polygon - list of Point2D
    #   result: list of Triangle
    #
    proc triangulate_polygon {polygon} {}

    # polygon_diameter -- The diameter of a point set: the farthest pair of points, by Euclidean distance. The farthest pair is always a pair of convex hull vertices, so this computes the hull first (convex_hull()) and then searches only among its (typically far fewer) vertices -- brute-force O(h^2) over the hull rather than the classical O(h) two-pointer rotating-calipers walk, the same "correct and simple over asymptotically optimal" tradeoff this module already makes for closest_pair(). Throws std::invalid_argument for fewer than 2 distinct points.
    #
    #   usage: datamunge::polygon_diameter points
    #   args:
    #     points - list of Point2D
    #   result: DiameterResult
    #
    proc polygon_diameter {points} {}

    # minimum_bounding_rectangle -- The minimum-AREA bounding rectangle of a point set (not necessarily axis-aligned). By a classical theorem, the optimal rectangle always has one side collinear with a convex hull edge -- so this computes the hull, then for each hull edge, measures the bounding rectangle aligned with that edge's direction (projecting every hull point onto the edge direction and its perpendicular), keeping the smallest-area result. O(h^2) (h = hull size): the classical rotating-calipers formulation does this in O(h) via incrementally-advanced support points, but re-projecting from scratch for every edge is far simpler to get right and, again, this module's established complexity/simplicity tradeoff. Throws std::invalid_argument if the hull has fewer than 3 vertices (no well-defined minimum-area rectangle for a degenerate point set).
    #
    #   usage: datamunge::minimum_bounding_rectangle points
    #   args:
    #     points - list of Point2D
    #   result: MinimumBoundingRectangle
    #
    proc minimum_bounding_rectangle {points} {}

    # point_to_line_distance -- Calls C++ datamunge::geometry::detail::point_to_line_distance.
    #
    #   usage: datamunge::point_to_line_distance p a b
    #   args:
    #     p - Point2D
    #     a - Point2D
    #     b - Point2D
    #   result: double
    #
    proc point_to_line_distance {p a b} {}

    # simplify_polyline -- Simplifies a polyline (Douglas-Peucker): recursively keeps only the point(s) farthest from the current baseline segment whenever that distance exceeds `epsilon`, discarding everything closer. Fewer than 3 points are returned unchanged (nothing to simplify).
    #
    #   usage: datamunge::simplify_polyline points epsilon
    #   args:
    #     points - list of Point2D
    #     epsilon - double
    #   result: list of Point2D
    #
    proc simplify_polyline {points epsilon} {}

    # circumcenter -- Calls C++ datamunge::geometry::detail::circumcenter.
    #
    #   usage: datamunge::circumcenter a b c
    #   args:
    #     a - Point2D
    #     b - Point2D
    #     c - Point2D
    #   result: Point2D
    #
    proc circumcenter {a b c} {}

    # voronoi_diagram -- The Voronoi diagram of `points`, computed as the dual of their Delaunay triangulation (delaunay_triangulation()) -- see VoronoiDiagram's cells field for the important caveat about unbounded cells at the convex hull boundary. Fewer than 3 points produce an empty diagram (matching delaunay_triangulation()).
    #
    #   usage: datamunge::voronoi_diagram points
    #   args:
    #     points - list of Point2D
    #   result: VoronoiDiagram
    #
    proc voronoi_diagram {points} {}

    # read_bmp -- Reads an uncompressed (BI_RGB) Windows BMP file as an RGB image. Accepts 24-bit (BGR), 32-bit (BGRx -- the 4th byte is ignored, never treated as alpha, since plain BITMAPINFOHEADER 32-bit files don't reliably agree on what that byte means), and 8-bit palette (indexed-color) files; any other bit depth or a compressed (non-BI_RGB) file throws std::runtime_error.
    #
    #   usage: datamunge::read_bmp path
    #   args:
    #     path - string
    #   result: Image
    #
    proc read_bmp {path} {}

    # write_bmp -- Writes `img` as an uncompressed 24-bit BGR Windows BMP (BITMAPINFOHEADER, BI_RGB), converting to RGB first if it isn't already (see to_rgb()) -- any alpha channel is dropped, matching write_ppm()'s same RGB-only-on-disk tradeoff.
    #
    #   usage: datamunge::write_bmp img path
    #   args:
    #     img - Image
    #     path - string
    #
    proc write_bmp {img path} {}

    # set_pixel_clipped -- Calls C++ datamunge::image::detail::set_pixel_clipped.
    #
    #   usage: datamunge::set_pixel_clipped img x y color
    #   args:
    #     img - Image
    #     x - int
    #     y - int
    #     color - Pixel
    #
    proc set_pixel_clipped {img x y color} {}

    # stamp -- Calls C++ datamunge::image::detail::stamp.
    #
    #   usage: datamunge::stamp img cx cy color thickness
    #   args:
    #     img - Image
    #     cx - int
    #     cy - int
    #     color - Pixel
    #     thickness - int
    #
    proc stamp {img cx cy color thickness} {}

    # draw_line -- Draws a straight line from (x0,y0) to (x1,y1) directly onto `img` (Bresenham's integer algorithm). `thickness` > 1 stamps a (thickness x thickness) square at every line pixel -- simple, not a true round/mitered stroke, but sufficient for this module's scope. Points (and any square stamps) outside `img's` bounds are silently clipped rather than throwing, matching typical drawing-library behavior for partially-offscreen shapes.
    #
    #   usage: datamunge::draw_line img x0 y0 x1 y1 color ?thickness?
    #   args:
    #     img - Image
    #     x0 - int
    #     y0 - int
    #     x1 - int
    #     y1 - int
    #     color - Pixel
    #     thickness - int, default 1
    #
    proc draw_line {img x0 y0 x1 y1 color {thickness 1}} {}

    # draw_rectangle -- Draws the rectangle with corners (x0,y0) and (x1,y1) (either diagonal order works) onto `img`, either as a one-pixel-wide outline or filled solid.
    #
    #   usage: datamunge::draw_rectangle img x0 y0 x1 y1 color ?filled?
    #   args:
    #     img - Image
    #     x0 - int
    #     y0 - int
    #     x1 - int
    #     y1 - int
    #     color - Pixel
    #     filled - bool, default false
    #
    proc draw_rectangle {img x0 y0 x1 y1 color {filled false}} {}

    # draw_circle -- Draws a circle of the given `radius` centered at (cx,cy) onto `img`, either as a one-pixel-wide outline (the midpoint circle algorithm) or filled solid (bounding-box scan with a squared-distance test).
    #
    #   usage: datamunge::draw_circle img cx cy radius color ?filled?
    #   args:
    #     img - Image
    #     cx - int
    #     cy - int
    #     radius - int
    #     color - Pixel
    #     filled - bool, default false
    #
    proc draw_circle {img cx cy radius color {filled false}} {}

    # draw_polygon -- Draws the polygon defined by `points` (in order, implicitly closed back to the first point) onto `img`. Outline mode connects consecutive vertices with draw_line(); filled mode uses a standard even-odd scanline fill. Fewer than 3 points draws nothing.
    #
    #   usage: datamunge::draw_polygon img points color ?filled?
    #   args:
    #     img - Image
    #     points - list of list {int int}
    #     color - Pixel
    #     filled - bool, default false
    #
    proc draw_polygon {img points color {filled false}} {}

    # read_ppm -- Reads a binary (P6) Netpbm color image. Only 8-bit-per-channel (maxval <= 255) files are supported. Throws std::runtime_error on a malformed file or I/O failure.
    #
    #   usage: datamunge::read_ppm path
    #   args:
    #     path - string
    #   result: Image
    #
    proc read_ppm {path} {}

    # write_ppm -- Writes `img` as a binary (P6) Netpbm color image, converting to RGB first if it isn't already (see to_rgb()).
    #
    #   usage: datamunge::write_ppm img path
    #   args:
    #     img - Image
    #     path - string
    #
    proc write_ppm {img path} {}

    # read_pgm -- Reads a binary (P5) Netpbm grayscale image. Only 8-bit (maxval <= 255) files are supported. Throws std::runtime_error on a malformed file or I/O failure.
    #
    #   usage: datamunge::read_pgm path
    #   args:
    #     path - string
    #   result: Image
    #
    proc read_pgm {path} {}

    # write_pgm -- Writes `img` as a binary (P5) Netpbm grayscale image, converting to Grayscale first if it isn't already (see to_grayscale()).
    #
    #   usage: datamunge::write_pgm img path
    #   args:
    #     img - Image
    #     path - string
    #
    proc write_pgm {img path} {}

    # read_pbm -- Reads a binary (P4) Netpbm bitmap image (1 bit per pixel: set bits are black) as a Grayscale image (0 = black, 255 = white). Throws std::runtime_error on a malformed file or I/O failure.
    #
    #   usage: datamunge::read_pbm path
    #   args:
    #     path - string
    #   result: Image
    #
    proc read_pbm {path} {}

    # write_pbm -- Writes `img` as a binary (P4) Netpbm bitmap, converting to grayscale first and then thresholding: pixels with luma strictly below `threshold` become set (black) bits.
    #
    #   usage: datamunge::write_pbm img path ?threshold?
    #   args:
    #     img - Image
    #     path - string
    #     threshold - unsigned int, default 128
    #
    proc write_pbm {img path {threshold 128}} {}

    # read_png -- Reads a PNG file as an Image (mode matches the file's color type: Grayscale, GrayscaleAlpha, RGB, or RGBA). Only 8-bit-depth, non-interlaced, non-palette PNGs are supported (the overwhelming majority of real-world PNGs); indexed-color (palette), 16-bit-depth, and Adam7-interlaced files throw std::runtime_error, as does a corrupt file (bad signature, chunk CRC mismatch, or truncated/invalid zlib stream).
    #
    #   usage: datamunge::read_png path
    #   args:
    #     path - string
    #   result: Image
    #
    proc read_png {path} {}

    # write_png -- Writes `img` as an 8-bit-depth, non-interlaced PNG, using its ImageMode directly as the PNG color type (Grayscale/GrayscaleAlpha/RGB/RGBA all have a direct PNG equivalent, so no conversion is ever needed). Every scanline is written with filter type 0 (None) -- simpler and always correct, at the cost of a somewhat larger file than a filter-optimizing encoder would produce; any standard PNG decoder still reads the result correctly.
    #
    #   usage: datamunge::write_png img path
    #   args:
    #     img - Image
    #     path - string
    #
    proc write_png {img path} {}

    # expected_improvement -- Expected improvement of a Gaussian prediction below an incumbent (minimisation).
    #
    #   For `Y\sim N(\mu,\sigma^2)` and target `t=\text{incumbent}-\xi`,
    #   `\operatorname{E}\max(t-Y,0)=(t-\mu)\Phi(u)+\sigma\varphi(u)` with `u=(t-\mu)/\sigma`.
    #
    #   `\mu`.
    #
    #   `\sigma\ge0`; 0 gives `\max(t-\mu,0)`.
    #
    #   `\xi\ge0` an improvement must exceed.
    #
    #   usage: datamunge::expected_improvement mean sd incumbent ?exploration?
    #   args:
    #     mean - double: Predicted mean
    #     sd - double: Predicted standard deviation
    #     incumbent - double: Smallest value observed so far.
    #     exploration - double, default 0.0: Margin
    #   result: double - The expected improvement (never negative).
    #   example:
    #     std::print("{:.4f}\n", dm::optim::expected_improvement(0.0, 1.0, 0.0));  // 0.3989 = phi(0)
    #
    proc expected_improvement {mean sd incumbent {exploration 0.0}} {}

    # probability_of_improvement -- Probability that a Gaussian prediction falls below incumbent − exploration.
    #
    #   `\mu`.
    #
    #   `\xi\ge0`.
    #
    #   `\Phi\big((\text{incumbent}-\xi-\mu)/\sigma\big)`.
    #
    #   usage: datamunge::probability_of_improvement mean sd incumbent ?exploration?
    #   args:
    #     mean - double: Predicted mean
    #     sd - double: Predicted standard deviation; 0 gives 0 or 1.
    #     incumbent - double: Smallest value observed so far.
    #     exploration - double, default 0.0: Margin
    #   result: double
    #   example:
    #     std::print("{:.4f}\n", dm::optim::probability_of_improvement(1.0, 1.0, 0.0));  // 0.1587
    #
    proc probability_of_improvement {mean sd incumbent {exploration 0.0}} {}

    # one_way_anova -- Classical equal-variance one-way ANOVA, like R oneway.test(var.equal=TRUE).
    #
    #   Tests equality of group means with between/within mean-square ratio. Independent normal
    #   observations and a common within-group population variance give the exact F reference. This is
    #   not Welch ANOVA. O(N) work, O(1) auxiliary storage; input unchanged, no omission or shared
    #   mutable state.
    #
    #   References:
    #   - https://stat.ethz.ch/R-manual/R-devel/library/stats/html/oneway.test.html
    #
    #   usage: datamunge::one_way_anova values group_sizes
    #   args:
    #     values - list of double: Finite observations concatenated group by group.
    #     group_sizes - list of unsigned int: At least two positive sizes summing exactly to values.size(); N must exceed the group count.
    #   result: HypothesisTestResult - statistic=F, parameter1=k-1, parameter2=N-k and upper-tail p_value; no CI or group estimates.
    #   errors:
    #     {DATAMUNGE invalid_argument} Invalid grouping/nonfinite input, no residual df, zero within- group variation or arithmetic overflow.
    #   see: HypothesisTestResult
    #   example:
    #     const auto a=dm::stats::one_way_anova({1,2,3,4,5,6,7,8,9},{3,3,3});
    #     std::print("{:.0f}\n",a.statistic); // 27
    #
    proc one_way_anova {values group_sizes} {}

    # kruskal_wallis_test -- Tie-corrected Kruskal-Wallis rank test, like R kruskal.test().
    #
    #   Ranks the pooled observations with average ties and uses the chi-square(k-1) approximation.
    #   The usual exchangeability null is identical independent group distributions; a common-shape
    #   shift model permits a location interpretation. It is not an omnibus test for every possible
    #   distributional difference. Small groups can invalidate the approximation. O(N log N) work/O(N)
    #   space, no mutation, omission or shared state.
    #
    #   References:
    #   - https://stat.ethz.ch/R-manual/R-devel/library/stats/html/kruskal.test.html
    #
    #   usage: datamunge::kruskal_wallis_test values group_sizes
    #   args:
    #     values - list of double: Finite observations concatenated by group.
    #     group_sizes - list of unsigned int: At least two positive group sizes summing to values.size().
    #   result: HypothesisTestResult - statistic=H, parameter1=k-1 and upper-tail approximate p_value; no CI.
    #   errors:
    #     {DATAMUNGE invalid_argument} Invalid groups, nonfinite input or all observations tied.
    #   see: HypothesisTestResult
    #   example:
    #     const auto h=dm::stats::kruskal_wallis_test({1,2,3,4,5,6,7,8,9},{3,3,3});
    #     std::print("{:.1f}\n",h.statistic); // 7.2
    #
    proc kruskal_wallis_test {values group_sizes} {}

    # chi_squared_goodness_of_fit -- Pearson chi-square test of specified category probabilities, like R chisq.test().
    #
    #   Uses sum((observed-expected)^2/expected) and chi-square(k-1); the probabilities are fixed, not
    #   estimated here. Expected counts must be sufficiently large for the approximation. Nonnegative
    #   fractional counts are accepted algebraically but do not automatically define a sampling model.
    #   O(k) work/storage, inputs unchanged, no shared state or omission.
    #
    #   References:
    #   - https://stat.ethz.ch/R-manual/R-devel/library/stats/html/chisq.test.html
    #
    #   usage: datamunge::chi_squared_goodness_of_fit observed ?expected_probabilities?
    #   args:
    #     observed - list of double: At least two finite nonnegative counts with positive finite total.
    #     expected_probabilities - list of double, optional (C++ default value): Empty (default) means uniform; otherwise positive finite probabilities matching counts and summing to one within 1e-10.
    #   result: HypothesisTestResult - statistic=X-squared, parameter1=k-1 and approximate upper-tail p_value; no CI.
    #   errors:
    #     {DATAMUNGE invalid_argument} Invalid counts/probabilities, sizes or zero/nonfinite total.
    #   see: HypothesisTestResult
    #   example:
    #     const auto q=dm::stats::chi_squared_goodness_of_fit({10,10});
    #     std::print("{:.0f}\n",q.statistic); // 0
    #
    proc chi_squared_goodness_of_fit {observed {expected_probabilities {}}} {}

    # chi_squared_test_independence -- Pearson chi-square test for a contingency table, like R chisq.test().
    #
    #   Expected counts are row_sum*column_sum/total; df=(rows-1)(columns-1). The asymptotic reference
    #   assumes independent multinomial/product-multinomial observations and adequately populated
    #   expected cells. O(rows*columns) work and O(rows+columns) space; inputs unchanged, no shared
    #   state.
    #
    #   References:
    #   - https://stat.ethz.ch/R-manual/R-devel/library/stats/html/chisq.test.html
    #
    #   usage: datamunge::chi_squared_test_independence table nrows ncols ?correct?
    #   args:
    #     table - list of double: Finite nonnegative row-major counts with strictly positive margins; integer counts are the usual sampling model.
    #     nrows - unsigned int: At least two rows.
    #     ncols - unsigned int: At least two columns; table length must equal nrows*ncols.
    #     correct - bool, default true: True (default) subtracts min(.5,abs(O-E)) from each absolute residual only for 2x2 tables.
    #   result: HypothesisTestResult - statistic=X-squared, parameter1=df, approximate upper-tail p_value; no CI.
    #   errors:
    #     {DATAMUNGE invalid_argument} Invalid shape, counts/margins or nonfinite total.
    #   see: HypothesisTestResult
    #   example:
    #     const auto q=dm::stats::chi_squared_test_independence({10,10,10,10},2,2);
    #     std::print("{:.0f}\n",q.statistic); // 0
    #
    proc chi_squared_test_independence {table nrows ncols {correct true}} {}

    # pearson_correlation_test -- Pearson product-moment correlation test with Fisher-z confidence bounds.
    #
    #   Uses t=r*sqrt((n-2)/(1-r^2)). The exact zero-correlation null reference requires independent
    #   bivariate-normal pairs; Fisher-z intervals are approximate. At n=3 no confidence interval is
    #   reported; n>=4 gets one. Perfect correlations use infinite-statistic limits. O(n) work, no
    #   input mutation/omission or shared state.
    #
    #   References:
    #   - https://stat.ethz.ch/R-manual/R-devel/library/stats/html/cor.test.html
    #
    #   usage: datamunge::pearson_correlation_test x y ?alternative? ?conf_level?
    #   args:
    #     x - list of double: At least three finite nonconstant first measurements.
    #     y - list of double: Same-length finite nonconstant second measurements, paired by index.
    #     alternative - Alternative, default TwoSided; one of TwoSided, Less, Greater: TwoSided (default), Less or Greater for population correlation.
    #     conf_level - double, default 0.94999999999999996: Finite confidence level in (0,1), default .95.
    #   result: HypothesisTestResult - statistic=t, parameter1=n-2, estimate1=r and p_value; has_conf_int only for n>=4.
    #   errors:
    #     {DATAMUNGE invalid_argument} Invalid lengths, nonfinite/constant samples or invalid controls.
    #   see: HypothesisTestResult
    #   example:
    #     const auto r=dm::stats::pearson_correlation_test({1,2,3,4},{2,4,6,8});
    #     std::print("{:.1f}\n",r.estimate1); // 1.0
    #
    proc pearson_correlation_test {x y {alternative TwoSided} {conf_level 0.94999999999999996}} {}

    # spearman_correlation_test -- Spearman correlation with average ranks and a t-approximation p-value.
    #
    #   Computes Pearson correlation on ranks. The reference is always t(n-2), not a small-sample
    #   exact permutation distribution; ties receive average ranks. Tests zero rank correlation under
    #   the approximation, not arbitrary independence. O(n log n) work/O(n) storage, no
    #   mutation/omission or shared state.
    #
    #   References:
    #   - https://stat.ethz.ch/R-manual/R-devel/library/stats/html/cor.test.html
    #
    #   usage: datamunge::spearman_correlation_test x y ?alternative?
    #   args:
    #     x - list of double: At least three finite nonconstant first measurements.
    #     y - list of double: Same-length finite nonconstant paired second measurements.
    #     alternative - Alternative, default TwoSided; one of TwoSided, Less, Greater: TwoSided (default), Less or Greater for population rank correlation.
    #   result: HypothesisTestResult - statistic=rank-correlation t, parameter1=n-2, estimate1=rho, approximate p_value; no CI.
    #   errors:
    #     {DATAMUNGE invalid_argument} Invalid lengths, nonfinite/constant samples or alternative.
    #   see: HypothesisTestResult
    #   example:
    #     const auto r=dm::stats::spearman_correlation_test({1,2,3,4},{10,20,30,40});
    #     std::print("{:.1f}\n",r.estimate1); // 1.0
    #
    proc spearman_correlation_test {x y {alternative TwoSided}} {}

    # kendall_tau -- Kendall rank coefficients by Knight inversion counting.
    #
    #   Sorts paired values and counts concordant, discordant and tied pairs in O(n log n) work/O(n)
    #   storage. Inputs are unchanged and calls share no mutable state. This is a coefficient
    #   calculation, not a hypothesis test; tau_b is zero when its denominator vanishes.
    #
    #   References:
    #   - https://stat.ethz.ch/R-manual/R-devel/library/stats/html/cor.html
    #
    #   usage: datamunge::kendall_tau x y
    #   args:
    #     x - list of double: At least two finite first coordinates.
    #     y - list of double: Equal-length finite second coordinates, paired by index.
    #   result: KendallTau - Owned pair counts, tau_a and tie-adjusted tau_b.
    #   errors:
    #     {DATAMUNGE invalid_argument} Lengths differ, fewer than two values, or nonfinite observations.
    #   see: HypothesisTestResult
    #   example:
    #     const auto k=dm::stats::kendall_tau({1,2,3,4},{1,2,3,4});
    #     std::print("{}\n",k.concordant); // 6
    #
    proc kendall_tau {x y} {}

    # fisher_exact_test_2x2 -- Conditional Fisher exact test of a 2x2 table with fixed margins.
    #
    #   Conditions on row/column totals and tests odds ratio one. Two-sided p-values sum probabilities
    #   no larger than the observed table (relative ordering tolerance 1e-7); they are not generally
    #   twice the smaller tail. Direct tail summation avoids 1-CDF cancellation. Empty margins give
    #   p=1. O(s) work/O(1) auxiliary storage for feasible support s; inputs unchanged, no shared
    #   state.
    #
    #   References:
    #   - https://stat.ethz.ch/R-manual/R-devel/library/stats/html/fisher.test.html
    #
    #   usage: datamunge::fisher_exact_test_2x2 a b c d ?alternative?
    #   args:
    #     a - unsigned int: Top-left nonnegative integer count.
    #     b - unsigned int: Top-right count.
    #     c - unsigned int: Bottom-left count.
    #     d - unsigned int: Bottom-right count; total must fit size_t.
    #     alternative - Alternative, default TwoSided; one of TwoSided, Less, Greater: TwoSided (default), Less or Greater for the odds ratio relative to one.
    #   result: HypothesisTestResult - statistic=a, p_value and estimate1=sample odds ratio a*d/(b*c), not R conditional MLE; denominator zero gives infinity for positive numerator or NaN for 0/0. No confidence interval.
    #   errors:
    #     {DATAMUNGE invalid_argument} Count-total overflow or invalid alternative.
    #   see: HypothesisTestResult
    #   example:
    #     const auto f=dm::stats::fisher_exact_test_2x2(0,3,3,0);
    #     std::print("{:.1f}\n",f.p_value); // 0.1
    #
    proc fisher_exact_test_2x2 {a b c d {alternative TwoSided}} {}

    # ks_test_one_sample_normal -- One-sample KS test against a fully specified continuous normal CDF.
    #
    #   Two-sided p-values use the Stephens corrected asymptotic Kolmogorov reference; one-sided
    #   values use exp(-2*n*D^2). Mean and sd must be fixed independently of this sample: fitting them
    #   here invalidates the stated calibration. This is not a Lilliefors test. Ties are accepted, but
    #   continuous-null calibration is affected by rounding. O(n log n) work/O(n) storage, input
    #   unchanged, no omission/shared state.
    #
    #   References:
    #   - https://stat.ethz.ch/R-manual/R-devel/library/stats/html/ks.test.html
    #
    #   usage: datamunge::ks_test_one_sample_normal x ?mean? ?sd? ?alternative?
    #   args:
    #     x - list of double: At least two finite observations.
    #     mean - double, default 0.0: Finite prespecified normal mean, default zero.
    #     sd - double, default 1.0: Positive finite prespecified normal SD, default one.
    #     alternative - Alternative, default TwoSided; one of TwoSided, Less, Greater: TwoSided (default); Greater tests empirical CDF above reference, Less below (opposite to a location alternative).
    #   result: HypothesisTestResult - statistic=D or D+/D-, parameter1=n and approximate p_value; no CI.
    #   errors:
    #     {DATAMUNGE invalid_argument} Too few/nonfinite values, invalid mean/sd or alternative.
    #   see: HypothesisTestResult
    #   example:
    #     const auto k=dm::stats::ks_test_one_sample_normal({-1,0,1});
    #     std::print("{:.0f}\n",k.parameter1); // 3
    #
    proc ks_test_one_sample_normal {x {mean 0.0} {sd 1.0} {alternative TwoSided}} {}

    # ks_test_one_sample_uniform -- One-sample KS test against a specified continuous uniform CDF.
    #
    #   Same asymptotic p-value and tie caveats as ks_test_one_sample_normal(); limits must be
    #   prespecified rather than estimated from x. O(n log n) work/O(n) storage; no mutation, omission
    #   or shared state.
    #
    #   References:
    #   - https://stat.ethz.ch/R-manual/R-devel/library/stats/html/ks.test.html
    #
    #   usage: datamunge::ks_test_one_sample_uniform x ?lower? ?upper? ?alternative?
    #   args:
    #     x - list of double: At least two finite observations.
    #     lower - double, default 0.0: Finite prespecified lower bound, default zero.
    #     upper - double, default 1.0: Finite upper bound greater than lower, default one.
    #     alternative - Alternative, default TwoSided; one of TwoSided, Less, Greater: TwoSided (default), Greater for empirical CDF above reference or Less below.
    #   result: HypothesisTestResult - statistic=D or D+/D-, parameter1=n, approximate p_value; no CI.
    #   errors:
    #     {DATAMUNGE invalid_argument} Invalid sample, limits or alternative.
    #   see: HypothesisTestResult
    #   example:
    #     const auto k=dm::stats::ks_test_one_sample_uniform({.2,.4,.6,.8});
    #     std::print("{:.1f}\n",k.statistic); // 0.2
    #
    proc ks_test_one_sample_uniform {x {lower 0.0} {upper 1.0} {alternative TwoSided}} {}

    # ks_test_two_sample -- Two-sample KS comparison of empirical CDFs with asymptotic p-values.
    #
    #   Uses effective n=n_x*n_y/(n_x+n_y) in the asymptotic reference. This is not an exact finite-
    #   sample calculation; ties/rounding and very small groups affect calibration. O(N log N)
    #   work/O(N) storage; inputs unchanged, no omission/shared state.
    #
    #   References:
    #   - https://stat.ethz.ch/R-manual/R-devel/library/stats/html/ks.test.html
    #
    #   usage: datamunge::ks_test_two_sample x y ?alternative?
    #   args:
    #     x - list of double: Nonempty finite first sample.
    #     y - list of double: Nonempty finite independent second sample.
    #     alternative - Alternative, default TwoSided; one of TwoSided, Less, Greater: TwoSided (default); Greater tests F_x above F_y, Less below, so Greater corresponds to stochastically smaller x.
    #   result: HypothesisTestResult - statistic=D or D+/D-, parameter1=n_x, parameter2=n_y and approximate p_value; no CI.
    #   errors:
    #     {DATAMUNGE invalid_argument} Empty/nonfinite samples or invalid alternative.
    #   see: HypothesisTestResult
    #   example:
    #     const auto k=dm::stats::ks_test_two_sample({1,2,3},{1,2,3});
    #     std::print("{:.0f}\n",k.statistic); // 0
    #
    proc ks_test_two_sample {x y {alternative TwoSided}} {}

    # shapiro_francia_test -- Shapiro-Francia composite normality test, like R nortest::sf.test().
    #
    #   Squared correlation of sorted observations with Blom normal scores, using Royston (1993) log-
    #   normal p-value approximation. Tests some normal distribution; a large p-value does not prove
    #   normality. Rounding/ties affect calibration. O(n log n) work/O(n) storage; input unchanged, no
    #   omission/shared state.
    #
    #   References:
    #   - https://search.r-project.org/CRAN/refmans/nortest/html/sf.test.html
    #
    #   usage: datamunge::shapiro_francia_test x
    #   args:
    #     x - list of double: Between 5 and 5000 finite, nonconstant observations.
    #   result: HypothesisTestResult - statistic=estimate1=W-prime and approximate p_value; no CI.
    #   errors:
    #     {DATAMUNGE invalid_argument} Invalid sample size, nonfinite input or constant sample.
    #   see: HypothesisTestResult
    #   example:
    #     const auto s=dm::stats::shapiro_francia_test({1,2,3,4,5});
    #     std::print("{}\n",s.has_conf_int); // false
    #
    proc shapiro_francia_test {x} {}

    # p_adjust -- Adjust a vector of p-values for multiple comparisons, matching R's p.adjust().
    #
    #   - Bonferroni: p[i] * n, capped at 1 -- simplest and most conservative FWER control.
    #   - Holm: step-down Bonferroni (Holm-Bonferroni) -- uniformly more powerful than
    #     plain Bonferroni while still controlling FWER, no extra assumptions.
    #   - Hochberg: step-up FWER control -- more powerful than Holm, but assumes the test
    #     statistics are independent (or positively dependent).
    #   - Hommel: step-up FWER control, uniformly more powerful than Hochberg under the
    #     same independence assumption; the most expensive to compute (O(n^2)). For n == 2
    #     this degenerates to (and is computed as) Hochberg, matching R.
    #   - BH (Benjamini-Hochberg, aka "fdr" in R): controls the false discovery rate under
    #     independence or positive regression dependence -- the standard choice for large-
    #     scale testing (e.g. genomics, many simultaneous hypothesis tests).
    #   - BY (Benjamini-Yekutieli): controls the FDR under arbitrary dependence; more
    #     conservative than BH.
    #   - None: returns the input p-values unchanged.
    #
    #   As in R, a single p-value (n <= 1) is always returned unchanged regardless of
    #   `method`.
    #
    #   usage: datamunge::p_adjust p ?method?
    #   args:
    #     p - list of double
    #     method - PAdjustMethod, default BH; one of Bonferroni, Holm, Hochberg, Hommel, BH, BY, None
    #   result: list of double
    #
    proc p_adjust {p {method BH}} {}

    # westfall_young_adjust -- Westfall-Young single-step minP adjustment (Westfall & Young, 1993) -- a resampling- based FWER correction that accounts for the actual dependence structure between tests (unlike the analytic methods above, which either assume independence or make no assumption at all).
    #
    #   `resampled_p` is a B x m matrix: row b holds the m p-values recomputed on the
    #   b-th permutation or bootstrap resample (generated by the caller -- this function is
    #   purely the combinatorial engine, not the resampling scheme itself). `sorted_p` is
    #   the m original p-values sorted ascending, and column k of every row in `resampled_p`
    #   must correspond to the same hypothesis as sorted_p[k] (i.e. the caller sorts once and
    #   reorders both consistently before calling).
    #
    #   Single-step: every hypothesis is compared against the same reference distribution --
    #   the per-resample minimum p-value taken over *all* m hypotheses -- so adjusted p[k] =
    #   (fraction of resamples whose overall minimum p-value <= sorted_p[k]). This is
    #   automatically monotonic in sorted_p and valid under subset pivotality, but less
    #   powerful than the step-down refinement below since it never narrows the comparison
    #   set as hypotheses are resolved.
    #
    #   Returned in the same (ascending sorted_p) order as the input; the caller is
    #   responsible for mapping back to original hypothesis order if needed.
    #
    #   usage: datamunge::westfall_young_adjust resampled_p sorted_p
    #   args:
    #     resampled_p - list of list of double
    #     sorted_p - list of double
    #   result: list of double
    #
    proc westfall_young_adjust {resampled_p sorted_p} {}

    # romano_wolf_adjust -- Romano-Wolf step-down resampling adjustment (Romano & Wolf, 2005) -- like westfall_young_adjust, but more powerful: at each step k (in ascending sorted_p order), the reference distribution is the per-resample minimum p-value taken only over the *remaining* hypotheses k..m-1, narrowing by one hypothesis at each step rather than always using all m. This is the step-down generalization that controls FWER without requiring subset pivotality. Monotonicity (adjusted p[k] >= adjusted p[k-1]) is enforced explicitly, since narrowing the comparison set at each step means it isn't automatic the way it is for the single-step procedure above.
    #
    #   Same input/output conventions as westfall_young_adjust: `resampled_p` is a B x m
    #   matrix with column k aligned to sorted_p[k], and the result is returned in the same
    #   sorted order.
    #
    #   usage: datamunge::romano_wolf_adjust resampled_p sorted_p
    #   args:
    #     resampled_p - list of list of double
    #     sorted_p - list of double
    #   result: list of double
    #
    proc romano_wolf_adjust {resampled_p sorted_p} {}

    # proportion_test_one_sample -- One-proportion score test with an uncorrected Wilson confidence interval.
    #
    #   Tests a fixed Bernoulli success probability using the signed null-standard-error z statistic;
    #   statistic stores z^2 but the chosen tail uses its sign. The optional continuity correction
    #   affects the test only: its Wilson interval is uncorrected and need not invert that test.
    #   Approximation requires sufficiently populated success/failure counts. O(1) work/storage, no
    #   shared state.
    #
    #   References:
    #   - https://stat.ethz.ch/R-manual/R-devel/library/stats/html/prop.test.html
    #
    #   usage: datamunge::proportion_test_one_sample successes n ?p? ?alternative? ?correct? ?conf_level?
    #   args:
    #     successes - unsigned int: Integer successes in [0,n].
    #     n - unsigned int: Positive independent-trial count.
    #     p - double, default 0.5: Finite null probability strictly in (0,1), default .5.
    #     alternative - Alternative, default TwoSided; one of TwoSided, Less, Greater: TwoSided (default), Less or Greater for true probability relative to p.
    #     correct - bool, default true: True (default) applies the capped half-count correction to z.
    #     conf_level - double, default 0.94999999999999996: Finite confidence level in (0,1), default .95.
    #   result: HypothesisTestResult - statistic=z^2, parameter1=1, estimate1=successes/n, p_value and uncorrected Wilson confidence bounds.
    #   errors:
    #     {DATAMUNGE invalid_argument} Invalid counts, null probability, alternative or confidence level.
    #   see: HypothesisTestResult
    #   example:
    #     const auto p=dm::stats::proportion_test_one_sample(45,100);
    #     std::print("{:.2f}\n",p.estimate1); // 0.45
    #
    proc proportion_test_one_sample {successes n {p 0.5} {alternative TwoSided} {correct true} {conf_level 0.94999999999999996}} {}

    # proportion_test_two_sample -- Pooled score test for two proportions, with an unpooled difference interval.
    #
    #   Tests equality using the pooled null SE and optionally a capped continuity correction. The
    #   difference CI uses an unpooled Wald SE and an uncapped half-count width correction when
    #   requested; it is approximate and is not a Wilson/Newcombe interval. All-zero/all-one pooled
    #   samples return z=0,p=1. O(1) work/storage, no shared state.
    #
    #   References:
    #   - https://stat.ethz.ch/R-manual/R-devel/library/stats/html/prop.test.html
    #
    #   usage: datamunge::proportion_test_two_sample successes1 n1 successes2 n2 ?alternative? ?correct? ?conf_level?
    #   args:
    #     successes1 - unsigned int: First success count in [0,n1].
    #     n1 - unsigned int: Positive first independent-trial count.
    #     successes2 - unsigned int: Second success count in [0,n2].
    #     n2 - unsigned int: Positive independent second-trial count.
    #     alternative - Alternative, default TwoSided; one of TwoSided, Less, Greater: TwoSided (default), Less or Greater for p1-p2.
    #     correct - bool, default true: True (default) corrects the score test and adds a half-count CI width.
    #     conf_level - double, default 0.94999999999999996: Finite confidence level in (0,1), default .95.
    #   result: HypothesisTestResult - statistic=z^2, parameter1=1, estimates=sample proportions, p_value and confidence bounds for p1-p2, clamped to [-1,1].
    #   errors:
    #     {DATAMUNGE invalid_argument} Invalid counts, alternative or confidence level.
    #   see: HypothesisTestResult
    #   example:
    #     const auto p=dm::stats::proportion_test_two_sample(2,10,3,10);
    #     std::print("{:.1f}\n",p.estimate1); // 0.2
    #
    proc proportion_test_two_sample {successes1 n1 successes2 n2 {alternative TwoSided} {correct true} {conf_level 0.94999999999999996}} {}

    # binomial_test -- Exact binomial test with Clopper-Pearson confidence bounds, like R binom.test().
    #
    #   One-sided p-values are inclusive tails. Two-sided p-values sum PMFs no larger than the
    #   observed PMF, using relative comparison tolerance 1e-7. The equal-tailed Clopper-Pearson
    #   interval has at-least-nominal coverage but need not invert the probability-ordered two-sided
    #   test. Null endpoints zero/one are supported. Two-sided enumeration costs O(n), intervals use
    #   bounded beta-CDF bisection; O(1) auxiliary storage, no shared state.
    #
    #   References:
    #   - https://stat.ethz.ch/R-manual/R-devel/library/stats/html/binom.test.html
    #
    #   usage: datamunge::binomial_test successes n ?p? ?alternative? ?conf_level?
    #   args:
    #     successes - unsigned int: Integer observed successes in [0,n].
    #     n - unsigned int: Positive independent Bernoulli trial count.
    #     p - double, default 0.5: Finite null probability in [0,1], default .5.
    #     alternative - Alternative, default TwoSided; one of TwoSided, Less, Greater: TwoSided (default), Less or Greater for true success probability.
    #     conf_level - double, default 0.94999999999999996: Finite confidence level in (0,1), default .95.
    #   result: HypothesisTestResult - statistic=successes, parameter1=n, estimate1=successes/n, p_value and Clopper-Pearson interval; one-sided intervals end at zero/one.
    #   errors:
    #     {DATAMUNGE invalid_argument} Invalid counts, probability, alternative or confidence level.
    #   see: HypothesisTestResult
    #   example:
    #     const auto b=dm::stats::binomial_test(9,10);
    #     std::print("{:.6f}\n",b.p_value); // 0.021484
    #
    proc binomial_test {successes n {p 0.5} {alternative TwoSided} {conf_level 0.94999999999999996}} {}

    # t_test_one_sample -- One-sample Student t-test of a population mean, like R t.test().
    #
    #   Independent normal observations give t=(mean-mu)/SE with n-1 df. The CI estimates the
    #   population mean, not mean-mu. Inputs are copied only for paired differences; all routines
    #   leave inputs unchanged and use no shared mutable state. O(n) work; no null/nonfinite omission.
    #
    #   References:
    #   - https://stat.ethz.ch/R-manual/R-devel/library/stats/html/t.test.html
    #
    #   usage: datamunge::t_test_one_sample x ?mu? ?alternative? ?conf_level?
    #   args:
    #     x - list of double: At least two finite observations with positive representable sample variance.
    #     mu - double, default 0.0: Finite null mean, default zero, in observation units.
    #     alternative - Alternative, default TwoSided; one of TwoSided, Less, Greater: TwoSided (default), Less or Greater, relative to mu.
    #     conf_level - double, default 0.94999999999999996: Finite confidence level strictly in (0,1), default .95.
    #   result: HypothesisTestResult - statistic=t, parameter1=df, estimate1=sample mean, p_value and mean confidence bounds; remaining scalars retain defaults. One-sided intervals have one infinite endpoint.
    #   errors:
    #     {DATAMUNGE invalid_argument} Too few/nonfinite values, invalid mu/alternative/confidence or zero/nonfinite standard error.
    #   see: HypothesisTestResult
    #   example:
    #     const auto t=dm::stats::t_test_one_sample({1,2,3,4});
    #     std::print("{:.0f}\n",t.parameter1); // 3
    #
    proc t_test_one_sample {x {mu 0.0} {alternative TwoSided} {conf_level 0.94999999999999996}} {}

    # t_test_two_sample -- Independent two-sample Welch or pooled Student mean test, like R t.test().
    #
    #   Welch uses unequal sample variances and Satterthwaite approximate df; normality alone does not
    #   make its reference exact. Pooled Student requires equal population variances and independent
    #   normal observations for its exact reference. CI estimates mean(x)-mean(y). O(n_x+n_y) work,
    #   inputs unchanged, no shared mutable state or omission.
    #
    #   References:
    #   - https://stat.ethz.ch/R-manual/R-devel/library/stats/html/t.test.html
    #
    #   usage: datamunge::t_test_two_sample x y ?equal_variance? ?alternative? ?conf_level?
    #   args:
    #     x - list of double: At least two finite observations in the first group.
    #     y - list of double: At least two finite independent observations in the second group.
    #     equal_variance - bool, default false: False (default) uses Welch; true uses pooled variance.
    #     alternative - Alternative, default TwoSided; one of TwoSided, Less, Greater: TwoSided (default), Less or Greater for mean(x)-mean(y).
    #     conf_level - double, default 0.94999999999999996: Finite confidence level in (0,1), default .95.
    #   result: HypothesisTestResult - statistic=t, parameter1=df, estimate1/2=group means, p_value and confidence bounds for their difference. One-sided bounds can be infinite.
    #   errors:
    #     {DATAMUNGE invalid_argument} Invalid sample sizes/values, alternative/confidence, unrepresentable mean difference or zero/nonfinite combined standard error.
    #   see: HypothesisTestResult
    #   example:
    #     const auto t=dm::stats::t_test_two_sample({1,2,3},{4,5,6});
    #     std::print("{:.0f}\n",t.estimate1); // 2
    #
    proc t_test_two_sample {x y {equal_variance false} {alternative TwoSided} {conf_level 0.94999999999999996}} {}

    # t_test_paired -- Paired Student t-test on aligned differences, like R t.test(paired=TRUE).
    #
    #   Runs the one-sample test on x[i]-y[i]. Differences, rather than the two marginal samples, need
    #   independent normal sampling for the exact t reference. Row order defines pairing; no values
    #   are omitted. O(n) work/storage; inputs unchanged, no shared mutable state.
    #
    #   References:
    #   - https://stat.ethz.ch/R-manual/R-devel/library/stats/html/t.test.html
    #
    #   usage: datamunge::t_test_paired x y ?alternative? ?conf_level?
    #   args:
    #     x - list of double: At least two finite first measurements.
    #     y - list of double: Equal-length finite second measurements paired by index.
    #     alternative - Alternative, default TwoSided; one of TwoSided, Less, Greater: TwoSided (default), Less or Greater for the population mean difference.
    #     conf_level - double, default 0.94999999999999996: Finite confidence level in (0,1), default .95.
    #   result: HypothesisTestResult - One-sample difference result with method Paired t-test; estimate1 is mean difference, CI targets the same difference.
    #   errors:
    #     {DATAMUNGE invalid_argument} Length mismatch, nonfinite data/differences, invalid controls or zero/nonfinite difference standard error.
    #   see: HypothesisTestResult
    #   example:
    #     const auto t=dm::stats::t_test_paired({2,4,7},{1,2,4});
    #     std::print("{:.0f}\n",t.parameter1); // 2
    #
    proc t_test_paired {x y {alternative TwoSided} {conf_level 0.94999999999999996}} {}

    # f_test_variance -- F-test and interval for a ratio of variances, like R var.test().
    #
    #   Uses sample variance(x)/sample variance(y). Independent normal populations give the
    #   F(df_x,df_y) reference; it is sensitive to nonnormality and is not a gatekeeper for choosing
    #   Welch versus pooled t tests. O(n_x+n_y) work/O(1) auxiliary storage; inputs unchanged, no
    #   omission/shared state.
    #
    #   References:
    #   - https://stat.ethz.ch/R-manual/R-devel/library/stats/html/var.test.html
    #
    #   usage: datamunge::f_test_variance x y ?alternative? ?conf_level?
    #   args:
    #     x - list of double: At least two finite first-sample values with positive finite sample variance.
    #     y - list of double: At least two finite independent second-sample values with positive finite sample variance.
    #     alternative - Alternative, default TwoSided; one of TwoSided, Less, Greater: TwoSided (default), Less or Greater for population variance ratio relative to one.
    #     conf_level - double, default 0.94999999999999996: Finite confidence level in (0,1), default .95.
    #   result: HypothesisTestResult - statistic=estimate1=variance ratio, parameter1/2=sample sizes minus one, p_value and ratio confidence bounds; one-sided interval ends at zero or infinity.
    #   errors:
    #     {DATAMUNGE invalid_argument} Too few/nonfinite observations, nonpositive/nonfinite variances or invalid controls.
    #   see: HypothesisTestResult
    #   example:
    #     const auto f=dm::stats::f_test_variance({1,2,3},{2,4,6});
    #     std::print("{:.2f}\n",f.estimate1); // 0.25
    #
    proc f_test_variance {x y {alternative TwoSided} {conf_level 0.94999999999999996}} {}

    # wilcoxon_signed_rank_test -- Normal-approximation Wilcoxon signed-rank test with tie/continuity corrections.
    #
    #   Tests symmetry of x-mu about zero under independent observations, not an arbitrary-population
    #   mean or median null. For paired data pass aligned differences. Exact-zero differences are
    #   removed; absolute differences receive average ranks. Always uses a normal approximation, even
    #   for small tie-free samples; no exact option or CI. O(n log n) work/O(n) storage; input
    #   unchanged, no shared state.
    #
    #   References:
    #   - https://stat.ethz.ch/R-manual/R-devel/library/stats/html/wilcox.test.html
    #
    #   usage: datamunge::wilcoxon_signed_rank_test x ?mu? ?alternative?
    #   args:
    #     x - list of double: Finite values; at least one nonzero difference from mu must remain.
    #     mu - double, default 0.0: Finite symmetry centre, default zero.
    #     alternative - Alternative, default TwoSided; one of TwoSided, Less, Greater: TwoSided (default), Less or Greater for the signed location shift.
    #   result: HypothesisTestResult - statistic=positive rank sum V, estimate1=mu (not an estimated pseudomedian), approximate p_value; no CI.
    #   errors:
    #     {DATAMUNGE invalid_argument} Nonfinite input/mu, invalid alternative, no nonzero differences or zero rank variance.
    #   see: HypothesisTestResult
    #   example:
    #     const auto w=dm::stats::wilcoxon_signed_rank_test({1,2,3,4});
    #     std::print("{:.0f}\n",w.statistic); // 10
    #
    proc wilcoxon_signed_rank_test {x {mu 0.0} {alternative TwoSided}} {}

    # wilcoxon_rank_sum_test -- Tie/continuity-corrected Mann-Whitney U test using a normal approximation.
    #
    #   Pools ranks, giving average ranks to ties, and reports U for the first sample. Its identical-
    #   distribution null requires independent exchangeable samples. A common-shape shift model
    #   supports a location interpretation; equal medians alone is insufficient. U/(n_x*n_y) estimates
    #   P(X>Y)+P(X=Y)/2, not a mean difference. Approximation is used at every size. O(N log N)
    #   work/O(N) storage, inputs unchanged, no shared state.
    #
    #   References:
    #   - https://stat.ethz.ch/R-manual/R-devel/library/stats/html/wilcox.test.html
    #
    #   usage: datamunge::wilcoxon_rank_sum_test x y ?alternative?
    #   args:
    #     x - list of double: Nonempty finite first sample.
    #     y - list of double: Nonempty finite independent second sample.
    #     alternative - Alternative, default TwoSided; one of TwoSided, Less, Greater: TwoSided (default), Less or Greater for first-versus-second stochastic location.
    #   result: HypothesisTestResult - statistic=U=rank_sum(x)-n_x(n_x+1)/2 and approximate p_value; no CI or location estimate.
    #   errors:
    #     {DATAMUNGE invalid_argument} Empty/nonfinite samples, invalid alternative or zero rank variance (all pooled observations tied).
    #   see: HypothesisTestResult
    #   example:
    #     const auto w=dm::stats::wilcoxon_rank_sum_test({1,2,3},{4,5,6});
    #     std::print("{:.0f}\n",w.statistic); // 0
    #
    proc wilcoxon_rank_sum_test {x y {alternative TwoSided}} {}

    # bs -- Construct an owned B-spline basis for repeated evaluation with eval(). Free-function spelling of Bspline: construction fixes the knots and boundaries without evaluating a design matrix or fitting a model. The returned value owns its basis; the input knot vector may be modified or destroyed after this call.
    #
    #   usage: datamunge::bs lower upper knots ?degree? ?intercept?
    #   args:
    #     lower - double: Finite left boundary, strictly below upper.
    #     upper - double: Finite right boundary.
    #     knots - list of double: Finite, strictly increasing breakpoints in [lower, upper]. Boundary entries are optional; an empty vector creates a basis without interior knots.
    #     degree - unsigned int, default 3: Polynomial degree, default 3 (cubic).
    #     intercept - bool, default false: Keep the first basis column, default false. Leave false with an intercept formula such as `y ~ .`; use a no-intercept formula when true.
    #   result: Bspline - Owned Bspline with the same degree, intercept policy and validation as its constructor. Call eval() on training and prediction coordinates.
    #   errors:
    #     {DATAMUNGE invalid_argument} For invalid boundaries, knots or overflowing degree.
    #   see: Bspline, Bspline::eval()
    #   example:
    #     const auto basis = dm::bs(0, 1, dm::seql(0, 1, 3));
    #     const auto design = basis.eval(dm::c(0, 0.5, 1));
    #     std::print("{} {}\n", design.rows(), design.cols()); // 3 4
    #
    proc bs {lower upper knots {degree 3} {intercept false}} {}

    # mkdir -- Create a directory and any missing parent directories. Accepts native filesystem paths, strings and string literals. An existing directory is a successful no-op; an existing file at the target or along its parents is an error. Relative paths use the current working directory, which this function does not change. Permissions follow the native filesystem and process defaults. A failed recursive operation may leave created parents. This C++ convenience forwards to std::filesystem::create_directories().
    #
    #   usage: datamunge::mkdir path
    #   args:
    #     path - path: Directory to create, including any missing parents; must not be empty.
    #   result: bool - True if the target directory was created, false if it already existed.
    #   errors:
    #     {DATAMUNGE filesystem_error} For an empty path, a conflicting file, insufficient permissions or other operating-system filesystem errors.
    #   see: std::filesystem::create_directories()
    #   example:
    #     dm::mkdir("build/figs");
    #     std::print("{}\n", std::filesystem::is_directory("build/figs")); // true
    #
    proc mkdir {path} {}

