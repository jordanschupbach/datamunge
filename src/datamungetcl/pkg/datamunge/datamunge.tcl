        #   errors:
        #     {DATAMUNGE out_of_range} For invalid ids/slots.
        #
        method child {cell slot} {}
        # depth -- Depth of `cell` (root 0).
        #
        #   usage: $obj depth cell
        #   args:
        #     cell - int: Cell id.
        #   result: int - Depth.
        #   errors:
        #     {DATAMUNGE out_of_range} For an invalid id.
        #
        method depth {cell} {}
        # cell_min -- Lower corner of `cell`.
        #
        #   usage: $obj cell_min cell
        #   args:
        #     cell - int: Cell id.
        #   result: list of double - d coordinates.
        #   errors:
        #     {DATAMUNGE out_of_range} For an invalid id.
        #
        method cell_min {cell} {}
        # cell_max -- Upper corner of `cell`.
        #
        #   usage: $obj cell_max cell
        #   args:
        #     cell - int: Cell id.
        #   result: list of double - d coordinates.
        #   errors:
        #     {DATAMUNGE out_of_range} For an invalid id.
        #
        method cell_max {cell} {}
        # locate -- Deepest existing cell containing `point`.
        #
        #   usage: $obj locate point
        #   args:
        #     point - list of double: d coordinates.
        #   result: int - Cell id, or -1 if `point` is outside the domain.
        #   errors:
        #     {DATAMUNGE invalid_argument} If point.size() != dimensions().
        #   example:
        #     dm::fda::HierarchicalBSpline h({0.0}, {1.0});
        #     int c = h.refine(h.root(), 1);
        #     std::print("{} {}\n", h.locate({0.9}) == c, h.locate({2.0})); // true -1
        #
        method locate {point} {}
        # has_spline -- Whether `cell` carries a patch.
        #
        #   usage: $obj has_spline cell
        #   args:
        #     cell - int: Cell id.
