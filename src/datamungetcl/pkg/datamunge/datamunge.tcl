        #
        #   usage: $obj covariance
        #   result: list of list of double
        #
        method covariance {} {}
        # filter -- Runs predict() then update(z) for every z in `measurements`, in order, mutating this filter's running state -- the ordinary causal (online) filtered estimate at every timestep.
        #
        #   usage: $obj filter measurements
        #   args:
        #     measurements - list of list of double
        #   result: list of KalmanState
        #
        method filter {measurements} {}
