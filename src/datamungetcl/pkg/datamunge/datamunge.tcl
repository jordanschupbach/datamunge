        superclass ::datamunge::NativeObject
        # constructor -- One-dimensional spline curve on `basis`.
        #
        #   Tensor-product spline over one basis per axis.
        #
        #   usage:
        #     datamunge::TensorBSpline new basis:BSplineBasis coefficients:list of double
        #     datamunge::TensorBSpline new bases:list of BSplineBasis coefficients:list of double
        #   errors:
        #     {DATAMUNGE invalid_argument} If the coefficient count differs from basis.basis_size().
        #     {DATAMUNGE invalid_argument} If `bases` is empty or the net size does not match.
        #   example:
        #     dm::fda::TensorBSpline f(dm::fda::BSplineBasis::open_uniform(1, 2), {1.0, 3.0});
        #     std::print("{}\n", f.evaluate(0.5)); // 2
        #   example:
        #     auto b = dm::fda::BSplineBasis::open_uniform(0, 2);  // piecewise constant
        #     dm::fda::TensorBSpline f({b, b}, {1, 2, 3, 4});
        #     std::print("{}\n", f.evaluate({0.75, 0.25}));        // 3
        #
        constructor args {}
        # dimensions -- Number of parameter dimensions d.
        #
        #   usage: $obj dimensions
        #   result: unsigned int - bases().size().
        #
        method dimensions {} {}
        # bases -- The per-axis bases.
        #
        #   usage: $obj bases
        #   result: list of BSplineBasis - Reference valid for the lifetime of this object.
        #
        method bases {} {}
        # shape -- Per-axis basis sizes, i.e. the shape of the coefficient net.
        #
        #   usage: $obj shape
        #   result: list of int - d sizes in axis order.
        #
        method shape {} {}
        # coefficient_count -- Total number of coefficients (product of shape()).
        #
        #   usage: $obj coefficient_count
        #   result: unsigned int - Coefficient count.
        #
        method coefficient_count {} {}
        # coefficients -- The row-major coefficient net.
        #
        #   usage: $obj coefficients
        #   result: list of double - Reference valid until the next mutation of this object.
        #
        method coefficients {} {}
        # domain_min -- Lower corner of the parameter domain (each basis's first clamped knot).
        #
        #   usage: $obj domain_min
        #   result: list of double - d coordinates.
        #
        method domain_min {} {}
        # domain_max -- Upper corner of the parameter domain.
        #
        #   usage: $obj domain_max
        #   result: list of double - d coordinates.
        #
        method domain_max {} {}
        # coefficient -- Reads one coefficient by per-axis basis index.
        #
        #   usage: $obj coefficient index
        #   args:
        #     index - list of int: d indices, each in [0, shape()[k]).
        #   result: double - The coefficient.
        #   errors:
        #     {DATAMUNGE invalid_argument} If index.size() != dimensions().
        #     {DATAMUNGE out_of_range} If a component is out of range.
        #   example:
        #     auto b = dm::fda::BSplineBasis::open_uniform(1, 2);
        #     dm::fda::TensorBSpline f({b, b}, {0, 1, 2, 3});
        #     std::print("{}\n", f.coefficient({1, 0})); // 2
        #
        method coefficient {index} {}
        # set_coefficient -- Overwrites one coefficient by per-axis basis index.
        #
        #   usage: $obj set_coefficient index value
        #   args:
        #     index - list of int: d indices, each in [0, shape()[k]).
        #     value - double: New coefficient.
        #   errors:
        #     {DATAMUNGE invalid_argument} If index.size() != dimensions().
        #     {DATAMUNGE out_of_range} If a component is out of range.
        #   example:
        #     dm::fda::TensorBSpline f(dm::fda::BSplineBasis::open_uniform(1, 2), {0, 0});
        #     f.set_coefficient({1}, 5.0);
        #     std::print("{}\n", f.evaluate(1.0)); // 5
        #
        method set_coefficient {index value} {}
        # evaluate -- Evaluates a one-dimensional spline at `x` (clamped into the domain).
        #
        #   Evaluates at one d-dimensional point (each coordinate clamped into the domain).
        #
        #   usage:
        #     $obj evaluate x:double -> double
        #     $obj evaluate point:list of double -> double
        #   errors:
        #     {DATAMUNGE invalid_argument} If dimensions() != 1 or `x` is not finite.
        #     {DATAMUNGE invalid_argument} If point.size() != dimensions() or a coordinate is not finite.
        #   example:
        #     dm::fda::TensorBSpline f(dm::fda::BSplineBasis::open_uniform(1, 2), {1.0, 3.0});
        #     std::print("{}\n", f.evaluate(2.0)); // 3  (clamped to x = 1)
        #   example:
        #     auto b = dm::fda::BSplineBasis::open_uniform(1, 2);
        #     dm::fda::TensorBSpline f({b, b}, {0, 1, 1, 2});
        #     std::print("{}\n", f.evaluate({1.0, 1.0})); // 2
        #
        method evaluate args {}
        # evaluate_points -- Evaluates at many points.
        #
        #   usage: $obj evaluate_points points
        #   args:
        #     points - list of list of double: Points, each of length d.
        #   result: list of double - One value per point, in input order.
        #   errors:
        #     {DATAMUNGE invalid_argument} As for evaluate(const std::vector<double>&).
        #   example:
        #     dm::fda::TensorBSpline f(dm::fda::BSplineBasis::open_uniform(1, 2), {0.0, 1.0});
        #     std::print("{}\n", f.evaluate_points({{0.0}, {0.5}})); // [0, 0.5]
        #
        method evaluate_points {points} {}
        # evaluate_grid -- Evaluates on the Cartesian product of per-axis sample values.
        #
        #   usage: $obj evaluate_grid axes
        #   args:
        #     axes - list of list of double: d non-empty coordinate lists.
        #   result: list of double - Row-major grid of values (axis 0 slowest, last axis fastest).
        #   errors:
        #     {DATAMUNGE invalid_argument} If axes.size() != dimensions() or an axis is empty.
        #   example:
        #     auto b = dm::fda::BSplineBasis::open_uniform(1, 2);
        #     dm::fda::TensorBSpline f({b, b}, {0, 1, 1, 2});
        #     std::print("{}\n", f.evaluate_grid({{0, 1}, {0, 1}})); // [0, 1, 1, 2]
        #
        method evaluate_grid {axes} {}
        # dyadic_refine -- Dyadically refines every axis and maps the coefficients, giving an identical function on the finer, nested tensor basis.
        #
        #   usage: $obj dyadic_refine
        #   result: TensorBSpline - The refined spline.
        #   errors:
        #     {DATAMUNGE invalid_argument} If some axis basis is not clamped.
        #   see: dyadic_refine(const BSplineBasis&)
        #   example:
        #     dm::fda::TensorBSpline f(dm::fda::BSplineBasis::open_uniform(2, 4), {0, 1, 3, 2});
        #     auto g = f.dyadic_refine();
        #     std::print("{} {:.6f}\n", g.coefficient_count(), g.evaluate(0.3) - f.evaluate(0.3)); // 6 0.000000
        #
        method dyadic_refine {} {}
    }

