    #       const auto result = dm::optim::BayesianOptimization({.initial_samples = 4, .max_iterations = 10})
    #                               .run(bowl, {-3.0}, {3.0}, gp);
    #       std::print("{:.3f} after {} evaluations\n", result.best_point[0], result.values.size());  // 1.002 after 14 evaluations
