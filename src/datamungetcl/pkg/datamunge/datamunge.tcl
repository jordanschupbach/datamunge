        #   result: list of double - A vector of length p; the AR polynomial is
        #
        method ar_coefficients {} {}
        # ma_coefficients -- Fitted non-seasonal MA coefficients
        #
        #   `\theta_1,\dots,\theta_q`.
        #
        #   `1+\sum_j\theta_j B^j`.
