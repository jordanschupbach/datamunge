    #
    proc total_degree {exponents} {}

    # compare_monomials -- Returns -1, 0, or 1 as monomial `a` is smaller, equal to, or larger than `b` under `order`. `a` and `b` must have the same length.
    #
    #   usage: datamunge::compare_monomials a b order
    #   args:
    #     a - list of int
    #     b - list of int
    #     order - MonomialOrder; one of Lex, Grlex, Grevlex
    #   result: int
    #
    proc compare_monomials {a b order} {}

    # lcm_exponent -- Calls C++ datamunge::algebra::detail::lcm_exponent.
    #
    #   usage: datamunge::lcm_exponent a b
    #   args:
    #     a - list of int
    #     b - list of int
    #   result: list of int
    #
    proc lcm_exponent {a b} {}

    # monomial_divides -- Calls C++ datamunge::algebra::detail::monomial_divides.
    #
    #   usage: datamunge::monomial_divides divisor dividend
    #   args:
    #     divisor - list of int
    #     dividend - list of int
    #   result: bool
    #
    proc monomial_divides {divisor dividend} {}

    # s_polynomial -- S-polynomial of f and g: the combination that cancels their leading terms via the LCM of their leading monomials -- Buchberger's algorithm's basic building block.
    #
    #   usage: datamunge::s_polynomial f g order
    #   args:
    #     f - MultivariatePolynomial
    #     g - MultivariatePolynomial
    #     order - MonomialOrder; one of Lex, Grlex, Grevlex
    #   result: MultivariatePolynomial
    #
    proc s_polynomial {f g order} {}

    # reduce -- Reduces p modulo `basis` (repeated division: subtract a multiple of whichever basis element's leading term divides p's current leading term, moving undivided leading terms into the remainder) until nothing is left, returning the remainder.
    #
    #   usage: datamunge::reduce p basis order
    #   args:
    #     p - MultivariatePolynomial
    #     basis - list of MultivariatePolynomial
    #     order - MonomialOrder; one of Lex, Grlex, Grevlex
    #   result: MultivariatePolynomial
    #
    proc reduce {p basis order} {}

    # multivariate_reduce -- Reduces p modulo `basis` under `order`, returning the remainder (the "normal form" of p with respect to basis). Zero if and only if p lies in the ideal generated by a Groebner basis `basis`.
    #
    #   usage: datamunge::multivariate_reduce p basis order
    #   args:
    #     p - MultivariatePolynomial
    #     basis - list of MultivariatePolynomial
    #     order - MonomialOrder; one of Lex, Grlex, Grevlex
    #   result: MultivariatePolynomial
    #
    proc multivariate_reduce {p basis order} {}

    # groebner_basis -- Buchberger's algorithm: computes a Groebner basis of the ideal generated by `generators` under `order`. Basic textbook form (no Buchberger-criterion pair-skipping optimizations, matching this module's "simple, correct" scoping elsewhere) -- reduces every S-polynomial against the CURRENT basis and appends any nonzero remainder until no pair produces one.
    #
    #   usage: datamunge::groebner_basis generators order
    #   args:
    #     generators - list of MultivariatePolynomial
    #     order - MonomialOrder; one of Lex, Grlex, Grevlex
    #   result: list of MultivariatePolynomial
    #
    proc groebner_basis {generators order} {}

    # lagrange_interpolate -- The unique polynomial of degree < n through the n points (xs[i], ys[i]), built via Lagrange's basis-polynomial formula (O(n^2)).
    #
    #   usage: datamunge::lagrange_interpolate xs ys
    #   args:
    #     xs - list of double
    #     ys - list of double
    #   result: Polynomial
    #   errors:
    #     {DATAMUNGE invalid_argument} if xs/ys sizes disagree, are empty, or xs has a duplicate.
    #
    proc lagrange_interpolate {xs ys} {}

    # newton_interpolate -- The same unique interpolating polynomial as lagrange_interpolate(), built instead via Newton's divided differences (an O(n^2) triangular table, then expanded into standard-basis coefficients). Included as the classical alternative construction: useful when points are added incrementally, since the divided-difference table extends by one row per new point rather than being rebuilt from scratch.
    #
    #   usage: datamunge::newton_interpolate xs ys
    #   args:
    #     xs - list of double
    #     ys - list of double
    #   result: Polynomial
    #   errors:
    #     {DATAMUNGE invalid_argument} if xs/ys sizes disagree, are empty, or xs has a duplicate.
    #
    proc newton_interpolate {xs ys} {}

    # to_integer -- Calls C++ datamunge::algebra::detail::to_integer.
    #
    #   usage: datamunge::to_integer v
    #   args:
    #     v - double
    #   result: int
    #
    proc to_integer {v} {}

    # mod_pow -- (base^exponent) mod modulus via binary exponentiation. All three arguments and the result are doubles holding exact integer values -- this module avoids std::size_t and other unsigned fixed-width types in binding-facing signatures, so plain `double` (exact up to 2^53) is used for modular-integer arithmetic throughout.
    #
    #   usage: datamunge::mod_pow base exponent modulus
    #   args:
    #     base - double
    #     exponent - double
    #     modulus - double
    #   result: double
    #   errors:
    #     {DATAMUNGE invalid_argument} if modulus <= 0 or exponent < 0.
    #
    proc mod_pow {base exponent modulus} {}

    # mod_inverse -- Modular multiplicative inverse of a mod m, via the extended Euclidean algorithm.
    #
    #   usage: datamunge::mod_inverse a m
    #   args:
    #     a - double
    #     m - double
    #   result: double
    #   errors:
    #     {DATAMUNGE invalid_argument} if gcd(a, m) != 1 (no inverse exists) or m <= 0.
    #
    proc mod_inverse {a m} {}

    # crt -- Chinese Remainder Theorem: the unique x in [0, product(moduli)) such that `x == remainders[i] (mod moduli[i])` for every i, given pairwise-coprime positive moduli.
    #
    #   usage: datamunge::crt remainders moduli
    #   args:
    #     remainders - list of double
    #     moduli - list of double
    #   result: double
    #   errors:
    #     {DATAMUNGE invalid_argument} if sizes disagree, are empty, a modulus is non-positive, the moduli aren't pairwise coprime, or the combined modulus would exceed 2^53 (past the point a double can represent every integer exactly).
    #
    proc crt {remainders moduli} {}

    # gf_mul -- Product of two polynomials over GF(p).
    #
    #   usage: datamunge::gf_mul a b p
    #   args:
    #     a - list of int
    #     b - list of int
    #     p - int
    #   result: list of int
    #
    proc gf_mul {a b p} {}

    # gf_derivative -- Formal derivative over GF(p); it vanishes for p-th powers
    #
    #   `g(x^p)`.
    #
    #   usage: datamunge::gf_derivative a p
    #   args:
    #     a - list of int
    #     p - int
    #   result: list of int
    #
    proc gf_derivative {a p} {}

    # gf_square_free -- Square-free decomposition of a monic polynomial over GF(p) (Yun's algorithm, with the p-th-root step needed in characteristic p): pairs (g, m) with f = prod g^m, every g monic and square-free and the g pairwise coprime.
    #
    #   usage: datamunge::gf_square_free f p
    #   args:
    #     f - list of int
    #     p - int
    #   result: list of list {list of int int}
    #
    proc gf_square_free {f p} {}

    # berlekamp_null_space -- Basis of the Berlekamp subalgebra of a monic polynomial `f` of degree n >= 1: the polynomials v of degree < n with
    #
    #   `v^p\equiv v \pmod f`, as the null space of
    #   `Q-I`, where row i of Q holds the coefficients of `x^{ip}\bmod f`. For square-free
    #   f its dimension is the number of irreducible factors. The first vector is the constant 1.
    #
    #   usage: datamunge::berlekamp_null_space f p
    #   args:
    #     f - list of int
    #     p - int
    #   result: list of list of int
    #
    proc berlekamp_null_space {f p} {}

    # berlekamp_factor_mod -- Binding-friendly wrapper around berlekamp_factor() using doubles (exact up to 2^53) for both the input polynomial and the prime, matching this module's std::size_t/fixed-width-integer-avoidance convention for SWIG-facing signatures (`std::vector<long long>` has no proven binding template in this codebase, while `std::vector<double>` already does). See berlekamp_factor() for the algorithm and preconditions.
    #
    #   usage: datamunge::berlekamp_factor_mod poly prime
    #   args:
    #     poly - list of double
    #     prime - double
    #   result: list of list of double
    #
    proc berlekamp_factor_mod {poly prime} {}

    # berlekamp_factor_count -- Number of irreducible factors of a monic square-free polynomial over GF(p), by Berlekamp's theorem: the dimension of the null space of
    #
    #   `(Q-I)^{\mathsf T}`, that is
    #   `n-\operatorname{rank}(Q-I)`. A square-free polynomial is irreducible exactly when it is 1.
    #
    #   usage: datamunge::berlekamp_factor_count poly p
    #   args:
    #     poly - list of int: ascending coefficients (made monic and reduced mod p first).
    #     p - int: a prime.
    #   result: int - the number of distinct irreducible factors (for square-free input).
    #   errors:
    #     {DATAMUNGE invalid_argument} if poly is constant.
    #
    proc berlekamp_factor_count {poly p} {}

    # factor_gf_p -- Complete factorization of a polynomial over GF(p): leading coefficient times monic irreducible factors with multiplicities. The square-free decomposition separates repeated factors (taking p-th roots where the derivative vanishes), and Berlekamp's algorithm splits each square-free part.
    #
    #   usage: datamunge::factor_gf_p poly p
    #   args:
    #     poly - list of int: ascending coefficients; reduced mod p first.
    #     p - int: a prime.
    #   result: GfFactorization - the leading coefficient, the factors and their multiplicities.
    #   errors:
    #     {DATAMUNGE invalid_argument} for the zero polynomial.
    #
    proc factor_gf_p {poly p} {}

    # count_monic_irreducibles -- Number of monic irreducible polynomials of degree `d` over GF(p), by Gauss's formula
    #
    #   `I_d=\frac1d\sum_{e\mid d}\mu(d/e)\,p^{e}`, as a double (exact while below 2^53).
    #
    #   `I_d`.
    #
    #   usage: datamunge::count_monic_irreducibles p d
    #   args:
    #     p - int: a prime.
    #     d - int: degree, at least 1.
    #   result: double
    #
    proc count_monic_irreducibles {p d} {}

    # expected_distinct_irreducible_factors -- Expected number of distinct monic irreducible factors of a uniformly random monic polynomial of degree `n` over GF(p): each irreducible g of degree d <= n divides it with probability
    #
    #   `p^{-d}`, so the expectation is `\sum_{d=1}^{n}I_d\,p^{-d}\approx H_n`.
    #
    #   usage: datamunge::expected_distinct_irreducible_factors p n
    #   args:
    #     p - int: a prime.
    #     n - int: degree, at least 1.
    #   result: double - the expected count.
    #
    proc expected_distinct_irreducible_factors {p n} {}

    # sylvester_matrix -- Calls C++ datamunge::algebra::detail::sylvester_matrix.
    #
    #   usage: datamunge::sylvester_matrix a b
    #   args:
    #     a - Polynomial
    #     b - Polynomial
    #   result: list of list of double
    #
    proc sylvester_matrix {a b} {}

    # determinant -- Calls C++ datamunge::algebra::detail::determinant.
    #
    #   usage: datamunge::determinant mat
    #   args:
    #     mat - list of list of double
    #   result: double
    #
    proc determinant {mat} {}

    # resultant -- The resultant of a and b: the determinant of their Sylvester matrix. Zero if and only if a and b share a common root (equivalently, a nonconstant common factor).
    #
    #   usage: datamunge::resultant a b
    #   args:
    #     a - Polynomial
    #     b - Polynomial
    #   result: double
    #
    proc resultant {a b} {}

    # discriminant -- The discriminant of p: `(-1)^(n(n-1)/2) * resultant(p, p') / lc(p)`, where n = degree(p). Zero if and only if p has a repeated root.
    #
    #   usage: datamunge::discriminant p
    #   args:
    #     p - Polynomial
    #   result: double
    #
    proc discriminant {p} {}

    # leapfrog_gaussian_acceptance -- Exact expected Metropolis acceptance of one HMC proposal (fixed step size and number of leapfrog steps, unit mass) on a one-dimensional
    #
    #   `N(m,s^2)` target, started
    #   in equilibrium.
    #
    #   In scaled coordinates `x=((q-m)/s,\,p)` each leapfrog step is the linear map
    #   `M=\begin{pmatrix}1&0\\-h/2&1\end{pmatrix}\begin{pmatrix}1&h\\0&1\end{pmatrix}\begin{pmatrix}1&0\\-h/2&1\end{pmatrix}`
    #   with `h=\varepsilon/s`, `\det M=1` and `\operatorname{tr}M=2-h^2`, so it is stable
    #   exactly when `\varepsilon<2s`. Writing `x_0=r(\cos\phi,\sin\phi)` the energy error is
    #   `\Delta H=r^2f(\phi)` with `f=\tfrac12(|M^L(\cos\phi,\sin\phi)|^2-1)`, and because
    #   `r^2/2\sim\text{Exp}(1)` the radial average of `\min(1,e^{-\Delta H})` is
    #   `1/(1+2f)` for `f>0` and 1 otherwise. The angle is integrated numerically.
    #
    #   `\varepsilon>0`.
    #
    #   `L\geq1`.
    #
    #   `s>0`.
    #
    #   usage: datamunge::leapfrog_gaussian_acceptance step_size num_steps sd ?angles?
    #   args:
    #     step_size - double: Leapfrog step size
    #     num_steps - unsigned int: Number of leapfrog steps
    #     sd - double: Target standard deviation
    #     angles - unsigned int, default 4096: Number of quadrature angles (at least 8).
    #   result: double - The expected acceptance probability.
    #   errors:
    #     {DATAMUNGE invalid_argument} for non-positive arguments.
    #
    proc leapfrog_gaussian_acceptance {step_size num_steps sd {angles 4096}} {}

    # gaussian_importance_efficiency -- Asymptotic effective-sample-size fraction
    #
    #   `N_{\text{eff}}/N` of importance sampling
    #   a `d`-dimensional Gaussian target with a Gaussian proposal of the same mean and
    #   covariance scaled by `k^2`.
    #
    #   `N_{\text{eff}}/N\to1/E_q[w^2]` for weights `w=p/q` normalised to mean 1. In one
    #   dimension `E_q[w^2]=\int p^2/q=k^2/\sqrt{2k^2-1}`, finite only for `k^2>1/2`, and the
    #   dimensions multiply, giving `\bigl(\sqrt{2k^2-1}/k^2\bigr)^d`. It is 1 at `k=1` and
    #   0 (infinite weight variance) for `k\le1/\sqrt2`.
    #
    #   `k>0`.
    #
    #   `d\ge1`.
    #
    #   usage: datamunge::gaussian_importance_efficiency scale dimension
    #   args:
    #     scale - double: Proposal scale factor
    #     dimension - int: Dimension
    #   result: double - The efficiency in [0, 1].
    #   errors:
    #     {DATAMUNGE invalid_argument} for non-positive `scale` or `dimension`.
    #
    proc gaussian_importance_efficiency {scale dimension} {}

    # rgb_to_gray -- The standard luma-weighted RGB -> grayscale conversion (ITU-R BT.601 coefficients, the same weights Pillow's "L" conversion and most other libraries use).
    #
    #   usage: datamunge::rgb_to_gray r g b
    #   args:
    #     r - unsigned int
    #     g - unsigned int
    #     b - unsigned int
    #   result: unsigned int
    #
    proc rgb_to_gray {r g b} {}

    # rgb_to_hsv -- Calls C++ datamunge::image::rgb_to_hsv.
    #
    #   usage: datamunge::rgb_to_hsv r8 g8 b8
    #   args:
    #     r8 - unsigned int
    #     g8 - unsigned int
    #     b8 - unsigned int
    #   result: HSV
    #
    proc rgb_to_hsv {r8 g8 b8} {}

    # hsv_to_rgb -- Calls C++ datamunge::image::hsv_to_rgb.
    #
    #   usage: datamunge::hsv_to_rgb hsv
    #   args:
    #     hsv - HSV
    #   result: Pixel
    #
    proc hsv_to_rgb {hsv} {}

    # to_grayscale -- A new image converted to Grayscale mode. Any existing alpha channel is dropped.
    #
    #   usage: datamunge::to_grayscale src
    #   args:
    #     src - Image
    #   result: Image
    #
    proc to_grayscale {src} {}

    # to_rgb -- A new image converted to RGB mode. Grayscale sources are expanded (r=g=b); any existing alpha channel is dropped.
    #
    #   usage: datamunge::to_rgb src
    #   args:
    #     src - Image
    #   result: Image
    #
    proc to_rgb {src} {}

    # to_rgba -- A new RGBA image with the same colors as `src` and every pixel's alpha set to `src's` existing alpha (255 for modes with no alpha channel).
    #
    #   usage: datamunge::to_rgba src
    #   args:
    #     src - Image
    #   result: Image
    #
    proc to_rgba {src} {}

    # split_channels -- Splits `src` into one Grayscale-mode Image per channel, in the source's own channel order (so RGB -> {R, G, B}, RGBA -> {R, G, B, A}, etc.).
    #
    #   usage: datamunge::split_channels src
    #   args:
    #     src - Image
    #   result: list of Image
    #
    proc split_channels {src} {}

    # merge_channels -- The inverse of split_channels(): combines Grayscale-mode `planes` (same width and height, one plane per output channel, in channel order) into a single image of the matching mode. Throws std::invalid_argument if the plane count isn't 1-4 or the planes' dimensions disagree.
    #
    #   usage: datamunge::merge_channels planes
    #   args:
    #     planes - list of Image
    #   result: Image
    #
    proc merge_channels {planes} {}

    # dog_blobs -- Difference-of-Gaussians blob detection (the detector SIFT keypoints are built on, without the orientation/descriptor stages): builds `num_scales` + 1 Gaussian- blurred copies of `img` at geometrically-spaced sigma_i = `sigma0` * 2^(i / num_scales), subtracts consecutive pairs to get `num_scales` DoG images, then keeps every point that is a strict extremum (min or max) among its 26 neighbors in the resulting (x, y, scale) volume -- 8 in its own DoG layer plus 9 in each adjacent layer -- and whose |response| exceeds `threshold`. A single octave only (no image-halving between octaves like full SIFT) -- simpler, and sufficient for detecting blobs across a single order-of-magnitude size range.
    #
    #   usage: datamunge::dog_blobs img ?num_scales? ?sigma0? ?threshold?
    #   args:
    #     img - Image
    #     num_scales - int, default 4
    #     sigma0 - double, default 1.6000000000000001
    #     threshold - double, default 3.0
    #   result: list of KeyPoint
    #
    proc dog_blobs {img {num_scales 4} {sigma0 1.6000000000000001} {threshold 3.0}} {}

    # structure_tensor -- The Gaussian-smoothed second-moment (structure) tensor at every pixel: Sobel gradients Ix/Iy, their per-pixel outer product Ix^2/Iy^2/IxIy, then smoothed with a Gaussian window of the given `sigma` -- the shared computation behind both Harris and Shi-Tomasi corner response, which differ only in how they combine these three fields into a single scalar score.
    #
    #   usage: datamunge::structure_tensor img sigma
    #   args:
    #     img - Image
    #     sigma - double
    #   result: StructureTensorField
    #
    proc structure_tensor {img sigma} {}

    # extract_local_maxima -- Keeps only the response-field entries that are a strict local maximum within a (2*radius+1)^2 window AND exceed `threshold`, as a sorted-by-descending-response Corner list -- the standard non-max-suppression + thresholding pass shared by every response-map-based corner detector.
    #
    #   usage: datamunge::extract_local_maxima response width height threshold nms_radius
    #   args:
    #     response - list of double
    #     width - int
    #     height - int
    #     threshold - double
    #     nms_radius - int
    #   result: list of Corner
    #
    proc extract_local_maxima {response width height threshold nms_radius} {}

    # harris_corners -- Harris corner detection: response = det(M) - k*trace(M)^2 of the structure tensor M at every pixel, thresholded at `threshold_ratio` * (the response map's own max, so callers don't have to guess an absolute scale) and non-max-suppressed within a (2*nms_radius+1)^2 window. `k` is the classical Harris free parameter (0.04-0.06).
    #
    #   usage: datamunge::harris_corners img ?k? ?sigma? ?threshold_ratio? ?nms_radius?
    #   args:
    #     img - Image
    #     k - double, default 0.040000000000000001
    #     sigma - double, default 1.0
    #     threshold_ratio - double, default 0.01
    #     nms_radius - int, default 3
    #   result: list of Corner
    #
    proc harris_corners {img {k 0.040000000000000001} {sigma 1.0} {threshold_ratio 0.01} {nms_radius 3}} {}

    # shi_tomasi_corners -- Shi-Tomasi ("good features to track") corner detection: response = the structure tensor's SMALLER eigenvalue at every pixel (a corner needs strong gradient variation in BOTH directions, so the weaker direction is the limiting factor) -- otherwise identical thresholding/NMS pipeline to harris_corners().
    #
    #   usage: datamunge::shi_tomasi_corners img ?sigma? ?threshold_ratio? ?nms_radius?
    #   args:
    #     img - Image
    #     sigma - double, default 1.0
    #     threshold_ratio - double, default 0.01
    #     nms_radius - int, default 3
    #   result: list of Corner
    #
    proc shi_tomasi_corners {img {sigma 1.0} {threshold_ratio 0.01} {nms_radius 3}} {}

    # fast_corners -- FAST corner detection: a pixel is a corner if `min_contiguous` (out of 16) pixels on the Bresenham circle of radius 3 around it are ALL brighter than center+ `threshold` or ALL darker than center- `threshold`. This is the direct O(16) full-circle test (no accelerated high-speed pre-rejection on pixels 1/5/9/13) -- simpler to verify correct, at the cost of the constant-factor speed FAST is normally chosen for. Response is the found arc's mean absolute deviation from the center intensity.
    #
    #   usage: datamunge::fast_corners img ?threshold? ?min_contiguous?
    #   args:
    #     img - Image
    #     threshold - int, default 20
    #     min_contiguous - int, default 9
    #   result: list of Corner
    #
    proc fast_corners {img {threshold 20} {min_contiguous 9}} {}

    # line_endpoints -- The two points where the infinite line `line` crosses the border of a `image_width` x `image_height` image, for drawing/visualization. Returns false (and leaves the output points unchanged) if the line doesn't intersect the image rectangle at all (only possible for a line entirely outside it).
    #
    #   usage: datamunge::line_endpoints line image_width image_height p1 p2
    #   args:
    #     line - HoughLine
    #     image_width - int
    #     image_height - int
    #     p1 - varName of list {int int}
    #     p2 - varName of list {int int}
    #   result: bool
    #
    proc line_endpoints {line image_width image_height p1 p2} {}

    # hough_lines -- Standard Hough line transform: every pixel of `img` whose grayscale luma is >= `edge_threshold` votes, in a rho-theta accumulator (theta stepped every degree over [0, pi), rho stepped every pixel over the image's diagonal range), for every line that could pass through it. Returns every accumulator cell with at least `min_votes`, non-max-suppressed within a (2*nms_radius+1) rho-theta cell window so a single real line doesn't produce a cluster of near-duplicate near-identical results. Intended input is an edge map (e.g. image::sobel_edges()'s output), not a raw photo.
    #
    #   usage: datamunge::hough_lines img ?edge_threshold? ?min_votes? ?nms_radius?
    #   args:
    #     img - Image
    #     edge_threshold - int, default 128
    #     min_votes - int, default 50
    #     nms_radius - int, default 5
    #   result: list of HoughLine
    #
    proc hough_lines {img {edge_threshold 128} {min_votes 50} {nms_radius 5}} {}

    # hough_circles -- Gradient-direction-guided Hough circle transform: for every edge pixel (Sobel gradient magnitude >= `gradient_threshold` on `img's` grayscale conversion), and for every candidate radius in [`min_radius`, `max_radius`], votes for the two candidate centers at that distance along the pixel's gradient line (handles both bright-disk-on-dark and dark-disk-on-bright edge polarity). Each radius gets an independent 2D (cx, cy) accumulator and non-max suppression pass -- simpler to reason about than a combined 3D (cx, cy, r) accumulator, at the cost of not suppressing near-duplicate detections across adjacent radii.
    #
    #   usage: datamunge::hough_circles img min_radius max_radius ?gradient_threshold? ?min_votes? ?nms_radius?
    #   args:
    #     img - Image
    #     min_radius - int
    #     max_radius - int
    #     gradient_threshold - double, default 50.0
    #     min_votes - int, default 20
    #     nms_radius - int, default 10
    #   result: list of HoughCircle
    #
    proc hough_circles {img min_radius max_radius {gradient_threshold 50.0} {min_votes 20} {nms_radius 10}} {}

    # in_structuring_element -- Calls C++ datamunge::cv::detail::in_structuring_element.
    #
    #   usage: datamunge::in_structuring_element se dx dy radius
    #   args:
    #     se - StructuringElement; one of Square, Cross
    #     dx - int
    #     dy - int
    #     radius - int
    #   result: bool
    #
    proc in_structuring_element {se dx dy radius} {}

    # is_foreground -- Calls C++ datamunge::cv::detail::is_foreground.
    #
    #   usage: datamunge::is_foreground img x y
    #   args:
    #     img - Image
    #     x - int
    #     y - int
    #   result: bool
    #
    proc is_foreground {img x y} {}

    # erode -- Binary erosion: a pixel stays foreground (luma >= 128, matching image::threshold()'s convention) only if EVERY pixel within the structuring element centered on it is also foreground -- shrinks foreground regions and removes thin protrusions. Returns a Grayscale image with 0/255 values. Pixels outside the image count as background.
    #
    #   usage: datamunge::erode img ?se? ?radius?
    #   args:
    #     img - Image
    #     se - StructuringElement, default Square; one of Square, Cross
    #     radius - int, default 1
    #   result: Image
    #
    proc erode {img {se Square} {radius 1}} {}

    # dilate -- Binary dilation: a pixel becomes foreground if ANY pixel within the structuring element centered on it is foreground -- grows foreground regions and fills small gaps. Returns a Grayscale image with 0/255 values.
    #
    #   usage: datamunge::dilate img ?se? ?radius?
    #   args:
    #     img - Image
    #     se - StructuringElement, default Square; one of Square, Cross
    #     radius - int, default 1
    #   result: Image
    #
    proc dilate {img {se Square} {radius 1}} {}

    # morphological_open -- Morphological opening (erode then dilate): removes small foreground specks and thin protrusions while leaving the size of larger regions roughly unchanged.
    #
    #   usage: datamunge::morphological_open img ?se? ?radius?
    #   args:
    #     img - Image
    #     se - StructuringElement, default Square; one of Square, Cross
    #     radius - int, default 1
    #   result: Image
    #
    proc morphological_open {img {se Square} {radius 1}} {}

    # morphological_close -- Morphological closing (dilate then erode): fills small holes and gaps in foreground regions while leaving their overall size roughly unchanged.
    #
    #   usage: datamunge::morphological_close img ?se? ?radius?
    #   args:
    #     img - Image
    #     se - StructuringElement, default Square; one of Square, Cross
    #     radius - int, default 1
    #   result: Image
    #
    proc morphological_close {img {se Square} {radius 1}} {}

    # lucas_kanade_optical_flow -- Sparse Lucas-Kanade optical flow: for each of `points`, solves the classical 2x2 windowed least-squares system (built from Sobel spatial gradients Ix/Iy on `prev` and the temporal gradient It = next - prev, both accumulated over a (2*window_radius+1)^2 window) for the local translation (dx, dy) that best explains the window's brightness change under the standard optical-flow brightness-constancy assumption. Single-level (not the pyramidal coarse-to-fine extension real implementations use for large motions) -- correctly handles motions up to roughly `window_radius` pixels, which is this module's documented scope tradeoff; use gaussian_pyramid() externally and call this once per level if larger motions matter.
    #
    #   usage: datamunge::lucas_kanade_optical_flow prev next points ?window_radius?
    #   args:
    #     prev - Image
    #     next - Image
    #     points - list of list {int int}
    #     window_radius - int, default 7
    #   result: list of FlowVector
    #
    proc lucas_kanade_optical_flow {prev next points {window_radius 7}} {}

    # box_kernel -- A normalized (sums to 1) box blur kernel of the given odd size.
    #
    #   usage: datamunge::box_kernel size
    #   args:
    #     size - int
    #   result: list of double
    #
    proc box_kernel {size} {}

    # gaussian_kernel -- A normalized 2D Gaussian kernel with standard deviation `sigma`; the kernel radius is chosen as ceil(3*sigma) (covers >99.7% of the distribution's mass), size = 2*radius+1.
    #
    #   usage: datamunge::gaussian_kernel sigma
    #   args:
    #     sigma - double
    #   result: list of double
    #
    proc gaussian_kernel {sigma} {}

    # convolve -- Applies a square convolution `kernel` to every channel of `src` (alpha included), clamping accesses at the border (edge-replicate padding, avoiding any darkening artifact a zero-padded border would introduce). `kernel's` side length must be odd.
    #
    #   usage: datamunge::convolve src kernel
    #   args:
    #     src - Image
    #     kernel - list of double
    #   result: Image
    #
    proc convolve {src kernel} {}

    # box_blur -- Calls C++ datamunge::image::box_blur.
    #
    #   usage: datamunge::box_blur src radius
    #   args:
    #     src - Image
    #     radius - int
    #   result: Image
    #
    proc box_blur {src radius} {}

    # gaussian_blur -- Calls C++ datamunge::image::gaussian_blur.
    #
    #   usage: datamunge::gaussian_blur src sigma
    #   args:
    #     src - Image
    #     sigma - double
    #   result: Image
    #
    proc gaussian_blur {src sigma} {}

    # sharpen -- Sharpens `src` via an unsharp-mask kernel: the center weight grows (and the neighbor weights, already negative, grow more negative) as `amount` increases past its neutral value of 0 (0 = no change).
    #
    #   usage: datamunge::sharpen src ?amount?
    #   args:
    #     src - Image
    #     amount - double, default 1.0
    #   result: Image
    #
    proc sharpen {src {amount 1.0}} {}

    # sobel_edges -- Sobel gradient-magnitude edge detection: converts to grayscale first, then computes the horizontal and vertical Sobel gradients at every pixel and returns their Euclidean magnitude (clamped to [0, 255]) as a new Grayscale image.
    #
    #   usage: datamunge::sobel_edges src
    #   args:
    #     src - Image
    #   result: Image
    #
    proc sobel_edges {src} {}

    # adjust_brightness -- Adds `delta` to every color channel (alpha untouched), clamped to [0, 255]. Negative `delta` darkens, positive brightens.
    #
    #   usage: datamunge::adjust_brightness src delta
    #   args:
    #     src - Image
    #     delta - int
    #   result: Image
    #
    proc adjust_brightness {src delta} {}

    # adjust_contrast -- Scales every color channel's distance from mid-gray (128) by `factor` (alpha untouched), clamped to [0, 255]. factor=1 is a no-op; factor=0 collapses to solid gray; factor>1 increases contrast.
    #
    #   usage: datamunge::adjust_contrast src factor
    #   args:
    #     src - Image
    #     factor - double
    #   result: Image
    #
    proc adjust_contrast {src factor} {}

    # threshold -- A binary (black/white) Grayscale image: pixels whose luma (rgb_to_gray) is >= `level` become 255 (white), everything else becomes 0 (black).
    #
    #   usage: datamunge::threshold src level
    #   args:
    #     src - Image
    #     level - unsigned int
    #   result: Image
    #
    proc threshold {src level} {}

    # lerp_byte -- Calls C++ datamunge::image::detail::lerp_byte.
    #
    #   usage: datamunge::lerp_byte a b t
    #   args:
    #     a - unsigned int
    #     b - unsigned int
    #     t - double
    #   result: unsigned int
    #
    proc lerp_byte {a b t} {}

    # bilinear_sample -- Calls C++ datamunge::image::detail::bilinear_sample.
    #
    #   usage: datamunge::bilinear_sample src x y
    #   args:
    #     src - Image
    #     x - double
    #     y - double
    #   result: Pixel
    #
    proc bilinear_sample {src x y} {}

    # resize -- A new image of size `new_width` x `new_height`, resampled from `src`. Nearest maps each destination pixel to its closest source pixel (blocky, but exact for integer scale factors); Bilinear interpolates the four surrounding source pixels (smoother, the usual default for photographic content).
    #
    #   usage: datamunge::resize src new_width new_height ?filter?
    #   args:
    #     src - Image
    #     new_width - int
    #     new_height - int
    #     filter - ResampleFilter, default Bilinear; one of Nearest, Bilinear
    #   result: Image
    #
    proc resize {src new_width new_height {filter Bilinear}} {}

    # crop -- The sub-image [x, x+width) x [y, y+height) of `src`. Throws std::out_of_range if the requested rectangle isn't fully contained in `src`.
    #
    #   usage: datamunge::crop src x y width height
    #   args:
    #     src - Image
    #     x - int
    #     y - int
    #     width - int
    #     height - int
    #   result: Image
    #
    proc crop {src x y width height} {}

    # flip_horizontal -- A new image with every row reversed left-to-right (mirror image).
    #
    #   usage: datamunge::flip_horizontal src
    #   args:
    #     src - Image
    #   result: Image
    #
    proc flip_horizontal {src} {}

    # flip_vertical -- A new image with every column reversed top-to-bottom (upside down).
    #
    #   usage: datamunge::flip_vertical src
    #   args:
    #     src - Image
    #   result: Image
    #
    proc flip_vertical {src} {}

    # rotate90 -- A new image rotated clockwise by exactly 90, 180, or 270 degrees (any other value throws std::invalid_argument -- use rotate() for arbitrary angles). 90/270 swap width and height; 180 keeps them.
    #
    #   usage: datamunge::rotate90 src degrees
    #   args:
    #     src - Image
    #     degrees - int
    #   result: Image
    #
    proc rotate90 {src degrees} {}

    # rotate -- A new image rotated clockwise by an arbitrary angle (in degrees) about its center, via inverse-mapping + bilinear resampling. The output canvas is exactly large enough to contain the fully-rotated source (like Pillow's expand=True), and pixels sourced from outside the original image are filled with `fill_color`.
    #
    #   usage: datamunge::rotate src degrees ?fill_color?
    #   args:
    #     src - Image
    #     degrees - double
    #     fill_color - Pixel, optional (C++ default value)
    #   result: Image
    #
    proc rotate {src degrees {fill_color {}}} {}

    # gaussian_pyramid -- The classical Gaussian pyramid: level 0 is `img` itself; each subsequent level is the previous level Gaussian-blurred (sigma = `sigma`) then downsampled by 2x (bilinear resize) -- a coarse-to-fine multi-resolution representation used throughout this module (e.g. as the natural foundation for a pyramidal optical-flow extension, though lucas_kanade_optical_flow() itself stays single-level). Stops early (producing fewer than `levels` images) if a level's dimensions would shrink below 1x1. Throws std::invalid_argument for levels < 1.
    #
    #   usage: datamunge::gaussian_pyramid img levels ?sigma?
    #   args:
    #     img - Image
    #     levels - int
    #     sigma - double, default 1.0
    #   result: list of Image
    #
    proc gaussian_pyramid {img levels {sigma 1.0}} {}

    # signed_difference_image -- Per-channel signed difference (cur - upsampled), re-centered at 128 and clamped to [0, 255] so it stores in an ordinary Image -- the standard way to make a Laplacian pyramid level (which is naturally signed) visualizable/storable without introducing a separate signed-pixel image type just for this.
    #
    #   usage: datamunge::signed_difference_image cur upsampled
    #   args:
    #     cur - Image
    #     upsampled - Image
    #   result: Image
    #
    proc signed_difference_image {cur upsampled} {}

    # laplacian_pyramid -- The Laplacian pyramid: for every level except the last, level_i = (Gaussian level i) minus (Gaussian level i+1 upsampled back to level i's size) -- the detail lost by blurring+downsampling at that scale, re-centered at 128 (see detail::signed_difference_image()) so it stores as an ordinary image; the final level is the smallest Gaussian level kept as-is (the residual low-frequency image the whole pyramid was built from). Reconstructing the original from a Laplacian pyramid is the classical use (progressively add each un-recentered level back onto the upsampled reconstruction-so-far) but isn't implemented here -- this module only needed the decomposition direction.
    #
    #   usage: datamunge::laplacian_pyramid img levels ?sigma?
    #   args:
    #     img - Image
    #     levels - int
    #     sigma - double, default 1.0
    #   result: list of Image
    #
    proc laplacian_pyramid {img levels {sigma 1.0}} {}

    # connected_components -- Labels every foreground (luma >= 128) connected region of `img` with a distinct positive integer via flood fill (simple breadth-first flood fill per unvisited foreground pixel, rather than the classical two-pass union-find labeling algorithm -- same asymptotic complexity, much easier to verify correct, matching this module's established simplicity-over-cleverness bias). `eight_connected` selects 8- neighborhood (diagonals count) vs. 4-neighborhood (orthogonal only) connectivity.
    #
    #   usage: datamunge::connected_components img ?eight_connected?
    #   args:
    #     img - Image
    #     eight_connected - bool, default true
    #   result: LabelMap
    #
    proc connected_components {img {eight_connected true}} {}

    # otsu_threshold -- Otsu's method: the grayscale threshold (0-255) that maximizes the between-class variance of the pixels it would split into "below" and "at-or-above" groups -- the standard automatic threshold selection when a fixed threshold isn't known in advance. Pairs directly with image::threshold(img, otsu_threshold(img)).
    #
    #   usage: datamunge::otsu_threshold img
    #   args:
    #     img - Image
    #   result: int
    #
    proc otsu_threshold {img} {}

    # kmeans_segment -- K-means color segmentation: clusters every pixel of `img` by its RGB value into `k` clusters (Lloyd's algorithm, deterministic fixed-seed initialization by sampling k distinct pixels) and returns a new RGB image where every pixel is replaced by its assigned cluster's mean color. Throws std::invalid_argument if `k` exceeds the number of distinct pixels available to seed from.
    #
    #   usage: datamunge::kmeans_segment img k ?max_iterations? ?seed?
    #   args:
    #     img - Image
    #     k - int
    #     max_iterations - int, default 20
    #     seed - unsigned int, default 42
    #   result: Image
    #
    proc kmeans_segment {img k {max_iterations 20} {seed 42}} {}

    # data_home -- The cache root where downloaded datasets are stored.
    #
    #   The first of: `$DATAMUNGE_DATA_DIR`; `$XDG_CACHE_HOME/datamunge/datasets`;
    #   `$HOME/.cache/datamunge/datasets`; on Windows `%LOCALAPPDATA%/datamunge/datasets`;
    #   otherwise `build/datasets` relative to the working directory. Nothing is created.
    #
    #   usage: datamunge::data_home
    #   result: string - The directory path (it may not exist yet).
    #   see: fetch()
    #   example:
    #     std::print("{}\n", dm::datasets::data_home());   // e.g. /home/me/.cache/datamunge/datasets
    #
    proc data_home {} {}

    # downloadable -- The names fetch() accepts, sorted: "california_housing", "cifar10", "cifar100", "diamonds", "fashion_mnist", "karate_club", "mnist", "rebot_devarm", "sudoku".
    #
    #   usage: datamunge::downloadable
    #   result: list of string
    #   example:
    #     for (const auto& name : dm::datasets::downloadable()) std::print("{}\n", name);
    #
    proc downloadable {} {}

    # fetch -- Makes sure a downloadable dataset is on disk and returns where it is.
    #
    #   For the tabular datasets ("diamonds", "california_housing") this is the CSV file. For the
    #   image datasets it is a directory: "mnist" and "fashion_mnist" hold the four uncompressed
    #   IDX files (`train-images-idx3-ubyte`, ...); "cifar10" holds `data_batch_1..5.bin` and
    #   `test_batch.bin`; "cifar100" holds `train.bin` and `test.bin` (the binary versions);
    #   "sudoku" holds Norvig's `easy50.txt`, `top95.txt` and `hardest.txt`.
    #   "karate_club" holds the970-byte original ZIP, GML topology and source README;
    #   every cached archive/member is checksum-verified. karate_club() reads34nodes/78edges.
    #   "rebot_devarm" holds 38 pinned Seeed DevArm CAD/URDF/STL files and the
    #   CERN-OHL-W-2.0 source license in their upstream relative directory layout.
    #   DevArm verifies the size and SHA-256 of every cached file on every call;
    #   changed files throw without replacement. Missing files are staged and verified
    #   before publication. It uses the same offline/mirror/cache controls, and works
    #   without the optional native data-preparation dependencies. Hashing uses memory
    #   proportional to the largest source file (about 35 MB).
    #   Approximate download sizes: diamonds 2.7 MB, california_housing 1.4 MB, MNIST 11 MB,
    #   Fashion-MNIST 30 MB, CIFAR-10 163 MB, CIFAR-100 161 MB, sudoku 14 KB, DevArm 56 MB.
    #
    #   For a complete CAD asset tree, use `dm::datasets::fetch("rebot_devarm")`.
    #
    #   References:
    #   - Seeed reBot-DevArm source: https://github.com/Seeed-Projects/reBot-DevArm
    #
    #   usage: datamunge::fetch name ?directory?
    #   args:
    #     name - string: One of downloadable().
    #     directory - string, default {}: Where the files live; empty means `data_home() + "/" + name`. Files already present there are used as they are, except DevArm and karate_club's verified files.
    #   result: string - The local path of the CSV file or the dataset directory.
    #   errors:
    #     {DATAMUNGE invalid_argument} for an unknown name.
    #     {DATAMUNGE runtime_error} if files are missing and downloading is disabled or fails, or a download does not match its checksum.
    #   see: data_home(), downloadable(), download_file(), karate_club()
    #   example:
    #     const auto housing = dm::datasets::read_csv(dm::datasets::fetch("california_housing"));
    #
    proc fetch {name {directory {}}} {}

    # download_file -- Downloads `url` to `destination` with curl, unless the destination already exists.
    #
    #   The file is downloaded into a temporary directory next to `destination`, checked, and only
    #   then renamed into place. Parent directories are created as needed. `DATAMUNGE_DATA_OFFLINE`
    #   is honored; `DATAMUNGE_DATA_MIRROR` is not (fetch() applies it).
    #
    #   usage: datamunge::download_file url destination ?md5?
    #   args:
    #     url - string: An `https://`, `http://` or `file://` URL.
    #     destination - string: The final file path.
    #     md5 - string, default {}: Expected lowercase hex MD5 of the downloaded bytes; empty skips the check.
    #   errors:
    #     {DATAMUNGE runtime_error} if downloading is disabled or fails, or the checksum differs.
    #   example:
    #     dm::datasets::download_file("https://example.org/data.csv", "/tmp/data.csv");
    #
    proc download_file {url destination {md5 {}}} {}

    # make_uniform_mesh1d -- Builds a uniform mesh of `num_elements` equal-length elements on [a, b]. Throws std::invalid_argument if num_elements is 0 or b <= a.
    #
    #   usage: datamunge::make_uniform_mesh1d a b num_elements
    #   args:
    #     a - double
    #     b - double
    #     num_elements - unsigned int
    #   result: Mesh1D
    #
    proc make_uniform_mesh1d {a b num_elements} {}

    # squared_distance -- Evaluate squared Euclidean distance using the original double arithmetic. No finite/range validation. Differences, products and sum can overflow, underflow or lose low bits; NaNs propagate according to floating arithmetic.
    #
    #   usage: datamunge::squared_distance a b
    #   args:
    #     a - Point2D: First point.
    #     b - Point2D: Second point.
    #   result: double - Rounded squared distance, possibly infinity/NaN or underflowed zero.
    #   see: distance()
    #   example:
    #     std::cout << dm::geometry::squared_distance({0,0},{3,4}); // 25
    #
    proc squared_distance {a b} {}

    # distance -- Return sqrt(squared_distance(a,b)) with its original range limitations. A finite mathematical distance may overflow through the squared intermediate; this convenience primitive performs no checked hypot or input validation.
    #
    #   usage: datamunge::distance a b
    #   args:
    #     a - Point2D: First point.
    #     b - Point2D: Second point.
    #   result: double - Rounded square root of the double-valued squared distance.
    #   see: squared_distance()
    #   example:
    #     std::cout << dm::geometry::distance({0,0},{3,4}); // 5
    #
    proc distance {a b} {}

    # cross -- Evaluate the original double determinant (b-a) cross (c-a). A positive exact determinant means counterclockwise, but this approximation can cancel, overflow or underflow and its returned sign is not certified. No tolerance or finite validation is applied. orientation_sign() supplies an exact sign for finite stored binary64 points; this primitive remains unchanged.
    #
    #   usage: datamunge::cross a b c
    #   args:
    #     a - Point2D: First point.
    #     b - Point2D: Second point.
    #     c - Point2D: Third point.
    #   result: double - Rounded double determinant, possibly infinity/NaN or a misleading zero.
    #   see: orientation_sign()
    #   example:
    #     std::cout << dm::geometry::cross({0,0},{1,0},{0,1}); // 1
    #
    proc cross {a b c} {}

    # delaunay_triangulation -- Construct a complete unconstrained Delaunay triangulation with exact signs. Retains the original one-vector signature and Triangle layout. Finite coordinate validation precedes even trivial results. Duplicates coalesce to earliest ids; collinear/fewer-than-three distinct sites return no faces. Uses Bowyer-Watson cavity replacement with symbolic hull ghosts, avoiding any finite super-triangle whose proximity could remove valid narrow faces. All orientation/incircle signs are exact for finite stored binary64, including subnormals/extreme scales. Cocircular ties retain existing faces under the ordering in DelaunayTrace. Faces are strictly CCW, contain no ghosts and reference original ids. Finite output order is canonical as documented on DelaunayTrace. No boundary constraints, holes, Steiner refinement or minimum-angle guarantee is supplied. Input unchanged; O(n log(n+1)+u^2 log(u+1)) worst-case work for n records/u distinct sites with ordered cavity maps and full live scans; O(n+u) working/output storage, no shared state or optional resource caps. Exact-predicate cost is bounded per binary64 query.
    #
    #   References:
    #   - A. Bowyer (1981), Computing Dirichlet tessellations, Computer Journal 24(2),162–166, doi:10.1093/comjnl/24.2.162.
    #   - D. F. Watson (1981), Computing the n-dimensional Delaunay tessellation with application to Voronoi polytopes, Computer Journal 24(2),167–172, doi:10.1093/comjnl/24.2.167. This variant uses symbolic boundary faces, exact decoded-dyadic signs, earliest duplicate identities and ordered cavity edges.
    #
    #   usage: datamunge::delaunay_triangulation points
    #   args:
    #     points - list of Point2D: Borrowed finite planar sites, possibly empty/duplicate/collinear.
    #   result: list of Triangle - Owned complete finite mesh of the distinct sites' convex hull, or no faces for collinearity.
    #   errors:
    #     {DATAMUNGE invalid_argument} Any nonfinite coordinate, even on short input.
    #     {DATAMUNGE length_error} Counter arithmetic or container capacity exceeded.
    #     {DATAMUNGE logic_error} Internal cavity topology invariant fails; no partial mesh returned.
    #     {DATAMUNGE bad_alloc} Allocation fails.
    #   see: delaunay_trace(), incircle_sign()
    #   example:
    #     std::print("{}\n",dm::geometry::delaunay_triangulation({{0,0},{1,0},{.5,.000001}}).size()); // 1
    #
    proc delaunay_triangulation {points} {}

    # delaunay_trace -- Capture actual symbolic-boundary cavity transitions from the same solver. No replay. Full finite validation precedes the original-record cap and all allocation. max_tests bounds cumulative incircle plus hull-side calls, checked before each complete live-face scan. Trace entries charge one per insertion plus removed faces, boundary edges and added faces, including ghosts, checked before retaining the event. Points/maps/final output and temporary cavities are excluded from that entry count; caps do not bound bytes or wall time. Zero disables only an optional cap. O(sum cavity/event sizes) additional history, at worst O(u^2), beyond the ordinary solver. Failure returns no partial result.
    #
    #   References:
    #   - Bowyer (1981), doi:10.1093/comjnl/24.2.162; Watson (1981), doi:10.1093/comjnl/24.2.167; records the symbolic-boundary variant rather than a geometric replay.
    #
    #   usage: datamunge::delaunay_trace points ?max_points? ?max_tests? ?max_entries?
    #   args:
    #     points - list of Point2D: Finite original coordinates, unchanged.
    #     max_points - unsigned int, default 1000000: Complete original-record cap, default 1000000; zero disables.
    #     max_tests - unsigned int, default 10000000: Cumulative complete-scan conflict cap, default 10000000; zero disables.
    #     max_entries - unsigned int, default 1000000: Cumulative event-entry cap, default 1000000; zero disables.
    #   result: DelaunayTrace - Owned points, original-id maps, finite mesh, actual events and work.
    #   errors:
    #     {DATAMUNGE invalid_argument} Any nonfinite coordinate.
    #     {DATAMUNGE length_error} Optional cap, count arithmetic or container capacity exceeded.
    #     {DATAMUNGE logic_error} Internal cavity invariant fails.
    #     {DATAMUNGE bad_alloc} Allocation fails.
    #   see: DelaunayTrace, delaunay_triangulation()
    #   example:
    #     const auto t=dm::geometry::delaunay_trace({{0,0},{4,0},{4,4},{0,4},{2,2}},5,10);
    #     std::print("{} {}\n",t.triangles.size(),t.work.incircle_tests+t.work.hull_side_tests); // 4 10
    #
    proc delaunay_trace {points {max_points 1000000} {max_tests 10000000} {max_entries 1000000}} {}

    # delaunay_analyze -- Measure a supplied mesh and test every nonvertex site against every circle. Performs the structural checks on DelaunayAnalysis first. The complete prospective circle count faces*(unique_sites-3) is checked before circle queries; zero cap disables only that limit. O(n log(n+1)+f log(f+1)+fu) work and O(n+f) storage; minimum angles are floating diagnostics and are not certified bounds. This is a local property analysis, not a global embedding/coverage certificate.
    #
    #   usage: datamunge::delaunay_analyze points triangles ?max_tests?
    #   args:
    #     points - list of Point2D: Finite original sites, unchanged.
    #     triangles - list of Triangle: Finite CCW faces with valid original indices, unchanged.
    #     max_tests - unsigned int, default 1000000: Complete exact-circle query cap, default 1000000; zero disables.
    #   result: DelaunayAnalysis - Owned scalar topology, actual query/violation counts and approximate angle.
    #   errors:
    #     {DATAMUNGE invalid_argument} Nonfinite coordinates, bad/degenerate/non-CCW/duplicate faces or nonmanifold edges.
    #     {DATAMUNGE length_error} Circle-count arithmetic or optional cap exceeded.
    #     {DATAMUNGE bad_alloc} Allocation fails.
    #   see: DelaunayAnalysis, delaunay_triangulation()
    #   example:
    #     const std::vector<dm::geometry::Point2D> p{{0,0},{1,0},{1,1},{0,1}};
    #     const auto a=dm::geometry::delaunay_analyze(p,dm::geometry::delaunay_triangulation(p));
    #     std::print("{} {} {}\n",a.edges,a.boundary_edges,a.circle_tests); // 5 4 2
    #
    proc delaunay_analyze {points triangles {max_tests 1000000}} {}

    # delaunay_uniform_cloud -- Generate the report's seeded uniform square-cloud control in the core. Uses mt19937(seed) and uniform_real_distribution<double>(0,extent), x then y for each point. Same-library runs reproduce the original report's seed20250728 and 30-site square when defaults are used. Standard distribution algorithms need not match across C++ libraries, so the seed is not a universal byte fixture. Coincident draws are allowed and later triangulation deduplicates them. O(count) work/storage, owned output, no global RNG or shared mutation.
    #
    #   usage: datamunge::delaunay_uniform_cloud count ?seed? ?extent? ?max_points?
    #   args:
    #     count - unsigned int: Number of original generated records, zero allowed.
    #     seed - unsigned int, default 20250728: mt19937 seed, default 20250728.
    #     extent - double, default 10.0: Positive finite square extent, default 10; checked even for count zero.
    #     max_points - unsigned int, default 1000000: Optional complete output-record cap, default 1000000; zero disables.
    #   result: list of Point2D - Owned generated points in [0,extent) on each axis.
    #   errors:
    #     {DATAMUNGE invalid_argument} Nonpositive or nonfinite extent.
    #     {DATAMUNGE length_error} Optional count cap or container capacity exceeded before allocation.
    #     {DATAMUNGE bad_alloc} Allocation fails.
    #   see: delaunay_trace()
    #   example:
    #     std::print("{}\n",dm::geometry::delaunay_uniform_cloud(30).size()); // 30
    #
    proc delaunay_uniform_cloud {count {seed 20250728} {extent 10.0} {max_points 1000000}} {}

    # make_rectangular_mesh2d -- Builds a structured rectangular mesh on [x0, x1] x [y0, y1]: nx * ny grid cells, each split into two counterclockwise triangles, for a total of nx*ny*2 triangles and (nx+1)*(ny+1) nodes, ordered row-major (x fastest, then y). Throws std::invalid_argument if nx or ny is 0, or if x1 <= x0 or y1 <= y0.
    #
    #   usage: datamunge::make_rectangular_mesh2d x0 y0 x1 y1 nx ny
    #   args:
    #     x0 - double
    #     y0 - double
    #     x1 - double
    #     y1 - double
    #     nx - unsigned int
    #     ny - unsigned int
    #   result: Mesh2D
    #
    proc make_rectangular_mesh2d {x0 y0 x1 y1 nx ny} {}

    # make_mesh2d_from_points -- Builds a mesh over the convex hull of an arbitrary point cloud via Delaunay triangulation (datamunge::geometry::delaunay_triangulation) -- useful for unstructured domains a structured grid does not fit.
    #
    #   usage: datamunge::make_mesh2d_from_points points
    #   args:
    #     points - list of Point2D
    #   result: Mesh2D
    #
    proc make_mesh2d_from_points {points} {}

    # boundary_nodes -- Node indices lying on the mesh's outer boundary: every node incident to a boundary edge (an edge belonging to exactly one triangle). Works generically for both a structured rectangular mesh (the domain's four sides) and an unstructured Delaunay mesh (the convex hull), returned in ascending order with no duplicates.
    #
    #   usage: datamunge::boundary_nodes mesh
    #   args:
    #     mesh - Mesh2D
    #   result: list of int
    #
    proc boundary_nodes {mesh} {}

    # bounding_box -- The axis-aligned bounding box of `points`. Throws std::invalid_argument for an empty point set.
    #
    #   usage: datamunge::bounding_box points
    #   args:
    #     points - list of Point2D
    #   result: BoundingBox
    #
    proc bounding_box {points} {}

    # closest_pair -- Return the closest point copies and finite-double distance using the checked all-pairs kernel. Validates at least two finite points, visits every original i<j pair and compares widened hypot distances. Equal rounded distances keep the lexicographically first index pair. Duplicates are valid distinct records and can yield zero. No early stop, sorting or spatial pruning; O(n^2) work and O(1) auxiliary storage. No input mutation/shared state. Widened comparison can change former false zero/infinite results and last-bit ties; it is not an exact-real predicate. The old call/result layout remains; indexed/traced variants retain input ids.
    #
    #   usage: datamunge::closest_pair points
    #   args:
    #     points - list of Point2D: Borrowed original finite planar coordinates, length at least two.
    #   result: ClosestPairResult - Owned selected point copies and checked finite-double measured distance.
    #   errors:
    #     {DATAMUNGE invalid_argument} If point count is too small or any coordinate is nonfinite.
    #     {DATAMUNGE length_error} If complete pair count cannot fit size_t.
    #     {DATAMUNGE overflow_error} If arithmetic/counters or the selected legacy distance cannot fit.
    #   see: closest_pair_indexed(), closest_pair_trace()
    #   example:
    #     const auto r=dm::geometry::closest_pair({{0,0},{3,4},{0,1}});
    #     std::print("{}\n",r.distance); // 1
    #
    proc closest_pair {points} {}

    # convex_hull -- Compute Andrew's strict monotone-chain hull using exact binary64 orientation signs. Validates all coordinates before internal indexed copies or sorting; the original by-value argument copy occurs at the call boundary. Exact coordinate equality removes duplicates (including signed zero); the earliest matching original record supplies its representation. Returns lexicographic-minimum first, counterclockwise, no repeated endpoint and no collinear edge interiors. Empty/singleton/two-point/collinear outputs follow ConvexHullAnalysis. O(n log n) comparisons plus O(n) bounded exact-sign tests, O(n) scratch/output, no global state. The legacy by-value signature is retained and has no optional caps. Other geometry routines that use cross() retain their own floating contracts.
    #
    #   References:
    #   - A. M. Andrew (1979), Another efficient algorithm for convex hulls in two
    #     dimensions, https://doi.org/10.1016/0020-0190(79)90072-3 .
    #
    #   usage: datamunge::convex_hull points
    #   args:
    #     points - list of Point2D: Finite planar records, copied by value as in the original API.
    #   result: list of Point2D - Owned strict hull of the represented coordinates.
    #   errors:
    #     {DATAMUNGE invalid_argument} Any nonfinite coordinate.
    #     {DATAMUNGE length_error} Work/container size exhaustion.
    #   see: convex_hull_analyze(), convex_hull_trace(), orientation_sign()
    #   example:
    #     const auto h=dm::geometry::convex_hull({{0,0},{2,0},{2,2},{0,2},{1,1}});
    #     std::cout << h.size(); // 4
    #
    proc convex_hull {points} {}

    # convex_hull_analyze -- Execute the same exact-sign hull kernel with identities and actual work. Same ordering, degeneracy and complexity contract as convex_hull(). Full finite validation precedes the complete max_points cap and scratch allocation. No events or completed-chain snapshots are retained; event cap is ignored.
    #
    #   References:
    #   - Andrew (1979), https://doi.org/10.1016/0020-0190(79)90072-3 .
    #
    #   usage: datamunge::convex_hull_analyze points ?options?
    #   args:
    #     points - list of Point2D: Finite original records; not mutated.
    #     options - ConvexHullOptions, optional (C++ default value): Complete original-record cap, zero unlimited; defaults one million.
    #   result: ConvexHullAnalysis - Owned hull, earliest original indices and actual counters.
    #   errors:
    #     {DATAMUNGE invalid_argument} Nonfinite coordinate.
    #     {DATAMUNGE length_error} Complete point cap or work/container exhaustion.
    #   see: convex_hull(), ConvexHullOptions
    #   example:
    #     const auto a=dm::geometry::convex_hull_analyze({{0,0},{1,0},{2,0}});
    #     std::cout << a.hull.size() << ' ' << a.work.distinct_points; // 2 3
    #
    proc convex_hull_analyze {points {options {}}} {}

    # convex_hull_trace -- Capture the hull kernel's actual stack events without replay or quadratic snapshots. Same computation/work as analyze, plus O(n) owned sorted records, compact test/pop/push edits and completed lower/upper chains. Positive max_events is checked online on actual records, including pushes; zero disables the cap.
    #
    #   References:
    #   - Andrew (1979), https://doi.org/10.1016/0020-0190(79)90072-3 .
    #
    #   usage: datamunge::convex_hull_trace points ?options?
    #   args:
    #     points - list of Point2D: Finite original records; not mutated.
    #     options - ConvexHullOptions, optional (C++ default value): Complete point and actual event caps.
    #   result: ConvexHullTrace - Owned actual sorted coordinates, identities, work and scan edits.
    #   errors:
    #     {DATAMUNGE invalid_argument} Nonfinite coordinate.
    #     {DATAMUNGE length_error} Point/event cap or work/container exhaustion.
    #   see: convex_hull_analyze(), HullEvent
    #   example:
    #     const auto t=dm::geometry::convex_hull_trace({{0,0},{1,0}});
    #     std::cout << t.events.size(); // 4
    #
    proc convex_hull_trace {points {options {}}} {}

    # sample_gaussian_points -- Draw unsnapped independent standard-normal x,y pairs with a local 32-bit MT stream. Reproduces the original hull report's mt19937/normal_distribution call order, including its cached normal variate. Distribution mappings can differ between standard libraries; a seed alone does not promise portable coordinate bits. Complete count cap precedes allocation. Empty count is valid. O(count) expected work/storage; no global RNG or mutation. Finite draws are checked before return.
    #
    #   References:
    #   - C++ normal_distribution specification: https://eel.is/c++draft/rand.dist.norm.normal .
    #
    #   usage: datamunge::sample_gaussian_points ?count? ?seed? ?max_points?
    #   args:
    #     count - unsigned int, default 40: Number of points, default forty.
    #     seed - unsigned int, default 20240728: Local mt19937 seed, default 20240728.
    #     max_points - unsigned int, default 1000000: Complete draw cap, default one million; zero unlimited.
    #   result: list of Point2D - Owned unsnapped normal point cloud.
    #   errors:
    #     {DATAMUNGE length_error} Complete draw cap/container exhaustion.
    #     {DATAMUNGE overflow_error} A generated coordinate is nonfinite.
    #   see: convex_hull(), random_point_cloud()
    #   example:
    #     std::cout << dm::geometry::sample_gaussian_points(40,20240728).size(); // 40
    #
    proc sample_gaussian_points {{count 40} {seed 20240728} {max_points 1000000}} {}

    # terrain_colors -- `n` colours from green through yellow and brown to near-white, as R's `terrain.colors(n)`.
    #
    #   usage: datamunge::terrain_colors n
    #   args:
    #     n - unsigned int: Number of colours (at least 1).
    #   result: list of RGB - The palette, low to high.
    #   errors:
    #     {DATAMUNGE invalid_argument} If `n` is 0.
    #
    proc terrain_colors {n} {}

    # diverging_colors -- `n` colours from dark blue through white to dark red, a diverging palette for signed values such as correlations (ColorBrewer's RdBu, reversed so that low is blue).
    #
    #   Interpolates linearly between the seven RdBu anchor colours; an odd `n` puts pure
    #   near-white (247, 247, 247) in the middle, so with `z_min = -z_max` in RPlot::image() zero
    #   maps to white.
    #
    #   References:
    #   - C. Brewer, ColorBrewer 2.0 (RdBu scheme): https://colorbrewer2.org
    #
    #   usage: datamunge::diverging_colors n
    #   args:
    #     n - unsigned int: Number of colours (at least 1; 1 gives the white midpoint).
    #   result: list of RGB - The palette, low (blue) to high (red).
    #   errors:
    #     {DATAMUNGE invalid_argument} If `n` is 0.
    #   see: terrain_colors(), RPlot::image()
    #   example:
    #     const auto pal = dm::graphics::diverging_colors(3);
    #     std::print("{} {} {}\n", pal[0].r, pal[1].g, pal[2].r);  // 33 247 178
    #
    proc diverging_colors {n} {}

    # viridis_colors -- `n` colours of the viridis scale, from dark purple through blue and green to yellow, matching R's `viridisLite::viridis(n)` at n = 10.
    #
    #   Viridis is perceptually uniform, so equal steps in value look like equal steps in colour,
    #   and it stays readable in greyscale and for the common forms of colour blindness. Colours are
    #   interpolated linearly between viridis(10)'s ten anchors.
    #
    #   References:
    #   - S. van der Walt and N. Smith (2015). "mpl colourmaps" (viridis): https://bids.github.io/colormap/
    #   - viridisLite: https://sjmgarnier.github.io/viridisLite/
    #
    #   usage: datamunge::viridis_colors n
    #   args:
    #     n - unsigned int: Number of colours (at least 1).
    #   result: list of RGB - The palette, low (purple) to high (yellow).
    #   errors:
    #     {DATAMUNGE invalid_argument} If `n` is 0.
    #   see: value_colors(), terrain_colors()
    #   example:
    #     const auto pal = dm::graphics::viridis_colors(10);
    #     std::print("{} {} {}\n", pal[0].r, pal[5].g, pal[9].b);  // 68 158 37
    #
    proc viridis_colors {n} {}

    # value_colors -- One colour per value on a continuous scale, for colouring scatter points by a numeric variable (ggplot2's `scale_colour_viridis_c()`).
    #
    #   Each value is mapped linearly from [`z_min`, `z_max`] to the palette and rounded to the
    #   nearest entry; values outside are clamped, NaN values get grey (190, 190, 190), and a zero
    #   range maps everything to the middle colour. Pass the result to RPlot::points_colored().
    #
    #   usage: datamunge::value_colors values ?palette? ?z_min? ?z_max?
    #   args:
    #     values - list of double: Values to colour.
    #     palette - list of RGB, optional (C++ default value): Colours from low to high (default viridis_colors(256)).
    #     z_min - double, optional (C++ default value): Value of the first colour; NaN (the default) uses the smallest value.
    #     z_max - double, optional (C++ default value): Value of the last colour; NaN (the default) uses the largest value.
    #   result: list of RGB - One colour per value.
    #   see: viridis_colors(), RPlot::points_colored()
    #   example:
    #     const auto cols = dm::graphics::value_colors({0.0, 0.5, 1.0}, dm::graphics::viridis_colors(3));
    #     std::print("{} {} {}\n", cols[0].r, cols[1].r, cols[2].r);  // 68 35 253
    #
    proc value_colors {values {palette {}} {z_min {}} {z_max {}}} {}

    # dtw_trace_entries -- Compute the complete logical capture size without allocating a DTW matrix. Checks positive lengths, int path-index representability and size_t geometry. A representable count does not promise that the corresponding buffers fit memory.
    #
    #   usage: datamunge::dtw_trace_entries n m
    #   args:
    #     n - unsigned int: Positive first length, at most INT_MAX.
    #     m - unsigned int: Positive second length, at most INT_MAX.
    #   result: unsigned int - n+m+2*n*m logical entries, excluding result paths and scratch rows.
    #   errors:
    #     {DATAMUNGE invalid_argument} For either zero length.
    #     {DATAMUNGE length_error} For index, product or capture-count overflow.
    #   see: dynamic_time_warping_trace()
    #   example:
    #     std::print("{}\n",dm::geometry::dtw_trace_entries(3,4)); // 31
    #
    proc dtw_trace_entries {n m} {}

    # dynamic_time_warping_work -- Compute unrestricted absolute-loss DTW and actual logical work without cost history. Owns the result; borrows finite inputs without mutation. No band, slope bound, step weighting, length normalization or fitted parameters. Finite ties choose diagonal, then advance_a, then advance_b. O(n*m) recurrence time, O(n*m+n+m) scratch/output, with only two double cost rows and n*m predecessor bytes. Complete input/geometry validation precedes allocation. Positive overflowing off-path costs remain infinity; only a nonfinite final optimum is rejected. Under ordinary double arithmetic the returned witness sums to the returned distance in forward order. Concurrent independent calls share no mutable state.
    #
    #   See DTWWork and DTWComputation for executed work examples.
    #
    #   References:
    #   - H. Sakoe and S. Chiba (1978), Dynamic programming algorithm optimization for
    #     spoken word recognition, IEEE TASSP26(1):43-49. doi:10.1109/TASSP.1978.1163055.
    #     This is the unrestricted scalar absolute-loss variant, without the paper's window/slope rules.
    #
    #   usage: datamunge::dynamic_time_warping_work a b
    #   args:
    #     a - list of double: Nonempty finite scalar sequence, length at most INT_MAX.
    #     b - list of double: Nonempty finite scalar sequence, length at most INT_MAX.
    #   result: DTWComputation - Independent optimal result and counts, with no retained input/cost history.
    #   errors:
    #     {DATAMUNGE invalid_argument} For empty or nonfinite input.
    #     {DATAMUNGE length_error} For geometry/index/container bounds.
    #     {DATAMUNGE overflow_error} If the final minimum is not finite double.
    #     {DATAMUNGE bad_alloc} If scratch or result storage cannot be allocated.
    #   see: dynamic_time_warping(), dynamic_time_warping_trace()
    #
    proc dynamic_time_warping_work {a b} {}

    # dynamic_time_warping -- Preserve the original two-argument unrestricted absolute-loss DTW entry point. Same validation, ownership, deterministic ties, numerical limits and complexity as dynamic_time_warping_work(); discards only its work counters. This distance is not a metric: unequal stretched sequences can have zero cost and the triangle inequality can fail. Equal-length diagonal alignment bounds it by rigid L1 loss.
    #
    #   See DTWResult for the executed original stretched-sequence example.
    #
    #   References:
    #   - H. Sakoe and S. Chiba (1978), IEEE TASSP26(1):43-49, doi:10.1109/TASSP.1978.1163055.
    #
    #   usage: datamunge::dynamic_time_warping a b
    #   args:
    #     a - list of double: Nonempty finite first sequence, length at most INT_MAX.
    #     b - list of double: Nonempty finite second sequence, length at most INT_MAX.
    #   result: DTWResult - Owned optimal distance and inclusive zero-based parallel int paths.
    #   errors:
    #     {DATAMUNGE invalid_argument} For empty or nonfinite input.
    #     {DATAMUNGE length_error} For geometry/index/container bounds.
    #     {DATAMUNGE overflow_error} If the final optimum is not finite double.
    #     {DATAMUNGE bad_alloc} If scratch or result storage cannot be allocated.
    #   see: dynamic_time_warping_work(), dtw_path_cost()
    #
    proc dynamic_time_warping {a b} {}

    # dynamic_time_warping_trace -- Capture actual positive-cell costs and predecessor choices from the shared DTW kernel. Validates complete finite inputs/geometry before checking the optional complete capture budget, then copies inputs and runs once. Owns every snapshot. No partial trace/result escapes on failure. Same variant/ties/numerical rules as ordinary DTW.
    #
    #   See DTWTrace and DTWPredecessor for executed capture examples.
    #
    #   References:
    #   - H. Sakoe and S. Chiba (1978), IEEE TASSP26(1):43-49, doi:10.1109/TASSP.1978.1163055.
    #
    #   usage: datamunge::dynamic_time_warping_trace a b ?max_entries?
    #   args:
    #     a - list of double: Nonempty finite first input, length at most INT_MAX.
    #     b - list of double: Nonempty finite second input, length at most INT_MAX.
    #     max_entries - unsigned int, default 1000000: Complete logical entry cap, default 1000000; zero disables only cap.
    #   result: DTWTrace - Independent input, costs, directions, optimal result, counts and capture cost.
    #   errors:
    #     {DATAMUNGE invalid_argument} For empty or nonfinite input, before budget checks.
    #     {DATAMUNGE length_error} For geometry/index/container/capture limits.
    #     {DATAMUNGE overflow_error} If the final optimum is not finite double.
    #     {DATAMUNGE bad_alloc} If owned or working storage cannot be allocated.
    #   see: dtw_trace_entries(), dynamic_time_warping_work()
    #
    proc dynamic_time_warping_trace {a b {max_entries 1000000}} {}

    # dtw_path_cost -- Validate a complete monotone witness and sum its unshifted absolute losses. Checks all finite input and path geometry before numerical accumulation: equal nonempty path lengths, in-bounds indices, exact endpoints and unit advances (1,0), (0,1), (1,1). This certifies feasibility/cost, not optimality. O(n+m+L) validation/sum, no allocations, input unchanged; no shared mutable state.
    #
    #   usage: datamunge::dtw_path_cost a b path_a path_b
    #   args:
    #     a - list of double: Nonempty finite first sequence.
    #     b - list of double: Nonempty finite second sequence.
    #     path_a - list of int: Borrowed signed first indices, zero through a.size()-1.
    #     path_b - list of int: Borrowed parallel signed second indices, zero through b.size()-1.
    #   result: double - Finite forward-order sum of absolute differences on the supplied witness.
    #   errors:
    #     {DATAMUNGE invalid_argument} For invalid finite inputs or path shape/indices/steps/endpoints.
    #     {DATAMUNGE length_error} For input index/geometry bounds.
    #     {DATAMUNGE overflow_error} If the supplied path's accumulated cost is not finite double.
    #   see: DTWResult, plot_dtw_alignment()
    #   example:
    #     const auto r=dm::geometry::dynamic_time_warping({1,2},{1,2});
    #     std::print("{}\n",dm::geometry::dtw_path_cost({1,2},{1,2},r.path_a,r.path_b)); // 0
    #
    proc dtw_path_cost {a b path_a path_b} {}

    # plot_dtw_alignment -- Draw two scalar series and their validated DTW correspondence segments natively. Costs use unshifted inputs; only drawing adds offset to a and subtracts it from b. Requires result.distance to equal the validated forward witness sum exactly; it does not independently prove optimality. Validates complete inputs/witness, finite plotted coordinates and optional path-pair cap before drawing allocation. Owns all series; no file I/O or model mutation. Concurrent calls share no state.
    #
    #   usage: datamunge::plot_dtw_alignment a b result ?offset? ?max_pairs?
    #   args:
    #     a - list of double: Nonempty finite first sequence.
    #     b - list of double: Nonempty finite second sequence.
    #     result - DTWResult: Borrowed complete feasible result with exact finite witness cost.
    #     offset - double, default 1.6000000000000001: Finite nonnegative vertical display separation per series, default 1.6.
    #     max_pairs - unsigned int, default 4096: Optional complete correspondence cap, default 4096; zero disables only cap.
    #   result: RPlot - Editable owned RPlot with two lines and gray correspondence segments.
    #   errors:
    #     {DATAMUNGE invalid_argument} For invalid inputs/witness/distance/offset.
    #     {DATAMUNGE length_error} For input geometry/index limits or exceeded nonzero pair cap.
    #     {DATAMUNGE overflow_error} For witness cost or shifted drawing-coordinate overflow.
    #     {DATAMUNGE bad_alloc} If owned plot storage cannot be allocated.
    #   see: dtw_path_cost(), graphics::RPlot
    #   example:
    #     const auto r=dm::geometry::dynamic_time_warping({1,2},{1,2});
    #     const auto p=dm::geometry::plot_dtw_alignment({1,2},{1,2},r);
    #     std::print("{}\n",p.series().size()); // 3
    #
    proc plot_dtw_alignment {a b result {offset 1.6000000000000001} {max_pairs 4096}} {}

    # discrete_frechet_distance -- The discrete Fréchet distance between two point sequences ("curves") p and q (Eiter & Mannila, 1994): the minimum, over every monotone coupling between the two curves, of the MAXIMUM pairwise distance along that coupling -- informally, the shortest leash length needed for a person walking along p and a dog walking along q (both only moving forward, never backward) to stay connected the whole way. Computed via the standard O(n*m) dynamic program (bottom-up, not the naive exponential recursion). Differs from DTW in exactly one respect: DTW sums (cumulative cost) where Fréchet takes a max (bottleneck cost) -- Fréchet cares about the worst single moment of divergence, DTW about total accumulated divergence.
    #
    #   usage: datamunge::discrete_frechet_distance p q
    #   args:
    #     p - list of Point2D
    #     q - list of Point2D
    #   result: double
    #
    proc discrete_frechet_distance {p q} {}

