        #     domain_max - list of double: Upper corner, with domain_min[k] < domain_max[k].
        #   errors:
        #     {DATAMUNGE invalid_argument} On empty, mismatched or non-finite bounds, min >= max, or more than 20 dimensions.
        #   example:
        #     dm::fda::HierarchicalBSpline h({0.0, 0.0}, {1.0, 2.0});
        #     std::print("{} {}\n", h.dimensions(), h.cell_count()); // 2 1
        #
        constructor {domain_min domain_max} {}
        # dimensions -- Number of dimensions d.
        #
        #   usage: $obj dimensions
        #   result: unsigned int - d.
        #
        method dimensions {} {}
        # cell_count -- Number of cells created so far.
        #
        #   usage: $obj cell_count
        #   result: int - Cell count.
        #
        method cell_count {} {}
        # root -- Root cell id.
        #
        #   usage: $obj root
        #   result: int - Always 0.
        #
        method root {} {}
        # parent -- Parent id.
        #
        #   usage: $obj parent cell
        #   args:
        #     cell - int: Cell id.
        #   result: int - Parent id, -1 for the root.
        #   errors:
        #     {DATAMUNGE out_of_range} For an invalid id.
        #
        method parent {cell} {}
        # child -- Child id at `slot`.
        #
        #   usage: $obj child cell slot
        #   args:
        #     cell - int: Cell id.
        #     slot - int: Child slot in [0, 2^d).
