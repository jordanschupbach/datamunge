    # DTWWork -- Logical work of the shared DTW recurrence and actual traceback. These are counts, not time. Validation, allocation, copies, comparisons and rendering are excluded. Each positive cell reads three predecessor slots, including infinite boundary slots. Every returned pair counts one traceback step.
    #
    #       const auto r=dm::geometry::dynamic_time_warping_work({2},{5});
    #       std::print("{} {} {}\n",r.work.cells,r.work.predecessor_reads,r.work.traceback_steps); // 1 3 1
    #
