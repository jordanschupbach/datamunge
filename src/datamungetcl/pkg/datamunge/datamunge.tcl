        #   See RLayout.
        #
        #   usage: $obj save path
        #   args:
        #     path - string: Destination file.
        #   errors:
        #     {DATAMUNGE invalid_argument} For any other extension.
        #     {DATAMUNGE runtime_error} If the file cannot be written.
        #   see: save_svg(), to_svg(), show()
        #
        method save {path} {}
        # save_svg -- Writes to_svg() to `path` regardless of its extension.
        #
        #   usage: $obj save_svg path
        #   args:
        #     path - string: Destination file; an existing file is overwritten.
        #   errors:
        #     {DATAMUNGE runtime_error} If the file cannot be opened for writing.
        #   see: save()
        #
        method save_svg {path} {}
        # to_png -- Renders the tiled figure as PNG image bytes (the raster save() writes for `.png`).
        #
        #   usage: $obj to_png
        #   result: list of unsigned int - The complete PNG file contents.
        #   errors:
        #     {DATAMUNGE runtime_error} If a panel cannot be rendered.
        #   see: save_png(), to_svg()
        #
        method to_png {} {}
        # to_pdf -- Renders the tiled figure as a one-page PDF holding the raster image.
        #
        #   usage: $obj to_pdf
        #   result: list of unsigned int - The complete PDF file contents.
        #   errors:
        #     {DATAMUNGE runtime_error} If a panel cannot be rendered.
        #   see: save_pdf(), to_png()
        #
        method to_pdf {} {}
        # save_png -- Writes to_png() to `path` regardless of its extension.
        #
        #   usage: $obj save_png path
        #   args:
        #     path - string: Destination file; an existing file is overwritten.
        #   errors:
        #     {DATAMUNGE runtime_error} If the file cannot be written or a panel cannot be rendered.
        #
        method save_png {path} {}
        # save_pdf -- Writes to_pdf() to `path` regardless of its extension.
        #
        #   usage: $obj save_pdf path
        #   args:
        #     path - string: Destination file; an existing file is overwritten.
        #   errors:
        #     {DATAMUNGE runtime_error} If the file cannot be written or a panel cannot be rendered.
        #
        method save_pdf {path} {}
        # fit_panels -- Resizes every stored panel's canvas to its cell, so text keeps its pixel size instead of being scaled with the panel.
        #
        #   Call it after size() and title() (the title band changes the cell height). Panels added
        #   later keep their own size until fit_panels() is called again. A cell whose shorter side is
        #   under min_panel_px gets a canvas scaled up to that side (same aspect ratio), so its text is
