# Generated plot output (reports, examples, benchmarks) is never committed.
*.svg
*.dll
# LaTeX intermediates that `org-latex-export-to-pdf` writes next to the .org
# source it compiled (same directory as the input file).
*.aux
*.out
*.toc
examples/org/*.tex
examples/org/*.log
examples/org/*.pdf
docs/org/pages/*.tex
docs/org/pages/*.log
docs/org/pages/*.pdf
*.o
*.a
.direnv
.envrc.local
.cache
*.so
node_modules
build
**/__pycache__
compile_commands.json
.dub
**/.dub
datamungedotnet/bin
datamungedotnet/obj
datamungedotnet.tests/bin
datamungedotnet.tests/obj
./buildSrc/.gradle/
.gradle
dist
src/pydatamunge.egg-info
result
_build
.merlin
bindings_tests/rust/target
bindings/rust/target
rustdatamunge/target
datamunged/libdatamunged.a
**/.null-ls*

src/rustdatamunge/target
src/datamungedotnet/bin
src/datamungedotnet/obj

src/datamungedotnet.tests/bin
src/datamungedotnet.tests/obj
tests/rust/target
target
src/octruby/ext/octruby/Makefile
src/octruby/ext/octruby/mkmf.log

# editor/OS noise
*~
\#*\#
.\#*
.DS_Store

examples/ocaml/datamunge_ex.cmi
examples/ocaml/datamunge_ex.cmx
tmp/

# figures mep copies into place for mepml blocks with file= (scripts/org_to_mepml.py)
examples/mepml/figures/
# what the docs' mepml report programs write before mep copies it to file= (docs/mepml/examples/figures/ is kept)
docs/mepml/examples/build/
docs/mepml/examples/**/build/
plans/
/output/

# Large raw benchmark archives; compact history summaries remain versionable.
/benchmarks/history/runs/

# R source packages and temporary SWIG staging directories.
/datamunger_*.tar.gz
/src/.swig-*/


# Lossless tensor-generated dataset contact sheets are report assets.
!docs/mepml/examples/figures/*.png
!docs/mepml/examples/**/figures/*.png

# Native CAD simulation clips embedded by the executable playground.
!docs/mepml/examples/figures/fruit_sorting_arrival.mp4
!docs/mepml/examples/figures/fruit_sorting_rl_*
!docs/mepml/examples/figures/fruit_vision_*
!docs/mepml/examples/figures/fruit_stream_*

# Large binary outputs: videos, trained weights/arrays, archives, native binaries.
# (Small hand-made test fixtures under tests/ are still tracked explicitly.)
*.mp4
*.mov
*.m4v
*.mkv
*.avi
*.webm
*.npz
*.npy
*.pt
*.pth
*.ckpt
*.onnx
*.safetensors
*.h5
*.hdf5
*.pkl
*.pickle
*.zip
*.7z
*.rar
*.tar
*.tgz
*.tar.xz
*.tar.bz2
*.whl
*.exe
*.dylib
*.lib
*.pdb
*.iso
*.dmg

# Files the C++ CAD tests write into the working directory.
/cad-api-artifacts/
/cad-format-artifacts/

# Keep generated SVG plots out even where a wildcard exception above re-includes a folder.
*.svg
