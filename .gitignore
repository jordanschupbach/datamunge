# Generated plot output (reports, examples, benchmarks) is never committed.
*.svg
*.dll
# LaTeX intermediates that `org-latex-export-to-pdf` writes next to the .org
# source it compiled (same directory as the input file).
*.aux
*.out
*.toc
examples/org/*.tex
examples/org/*.log
examples/org/*.pdf
docs/org/pages/*.tex
docs/org/pages/*.log
docs/org/pages/*.pdf
*.o
*.a
.direnv
.envrc.local
.cache
*.so
node_modules
build
**/__pycache__
compile_commands.json
.dub
**/.dub
.gradle
dist
src/pydatamunge.egg-info
result
_build
.merlin
bindings_tests/rust/target
bindings/rust/target
rustdatamunge/target
datamunged/libdatamunged.a
**/.null-ls*

src/rustdatamunge/target
src/datamungecsharp/bin
src/datamungecsharp/obj
tests/rust/target
target

# editor/OS noise
*~
\#*\#
.\#*
.DS_Store

examples/ocaml/*.cm[iotx]
examples/ocaml/*.cmti
examples/ocaml/*.o
tmp/

# figures mep copies into place for mepml blocks with file= (scripts/org_to_mepml.py)
examples/mepml/figures/
# what the docs' mepml report programs write before mep copies it to file= (figures/ images are ignored too)
docs/mepml/build/
docs/mepml/**/build/
plans/
/output/

# Large raw benchmark archives; compact history summaries remain versionable.
/benchmarks/history/runs/

# R source packages and temporary SWIG staging directories.
/datamunger_*.tar.gz
/src/.swig-*/


# Small run records the robot-fruit reports link to (CSV/JSON/TXT) stay versioned.
!docs/mepml/figures/fruit_sorting_rl_*
!docs/mepml/figures/fruit_vision_*
!docs/mepml/figures/fruit_stream_*

# Generated report media is exported to gh-pages. Small tabular records and
# deliberately tracked fixtures can still live next to their reports.
docs/mepml/**/figures/**/*.png
docs/mepml/**/figures/**/*.jpg
docs/mepml/**/figures/**/*.jpeg
docs/mepml/**/figures/**/*.gif
docs/mepml/**/figures/**/*.svg
docs/mepml/**/figures/**/*.webp
docs/mepml/**/figures/**/*.mp4
docs/mepml/**/figures/**/*.webm
docs/mepml/**/figures/**/*.wav
docs/mepml/**/figures/**/*.mp3

# Compiled binding/test binaries (Ruby/Perl bundles, Perl blib, D and root test executables).
*.bundle
/src/perldatamunge/blib/
/examples/d/datamunged-example
/tests/d/datamunged-tests
/ggplot_tests
/plot_compose_tests
/plot_tests
/splom_tests

# Large binary outputs: videos, trained weights/arrays, archives, native binaries.
# (Small hand-made test fixtures under tests/ are still tracked explicitly.)
*.mp4
*.mov
*.m4v
*.mkv
*.avi
*.webm
*.npz
*.npy
*.pt
*.pth
*.ckpt
*.onnx
*.safetensors
*.h5
*.hdf5
*.pkl
*.pickle
*.zip
*.7z
*.rar
*.tar
*.tgz
*.tar.xz
*.tar.bz2
*.whl
*.exe
*.dylib
*.lib
*.pdb
*.iso
*.dmg

# Files the C++ CAD tests write into the working directory.
/cad-api-artifacts/
/cad-format-artifacts/

# Keep generated SVG plots out even where a wildcard exception above re-includes a folder.
*.svg

# Benchmark JSON (raw results and history summaries) is local output, never committed.
/benchmarks/results/**/*.json
/benchmarks/history/**/*.json

# Shapefiles the GIS examples (gis_ex) write into the working directory.
/datamunge_gis_ex_counties_*

# Editor discovery links written by `just build-python` / `just build-r`.
.venv
.Renviron
