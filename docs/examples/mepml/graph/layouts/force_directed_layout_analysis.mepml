//? Title: Force-directed layout: actual forces, cooling and drawing units
//? Subtitle: Preserve the original seeded path; inspect raw motion before final centering and scaling
//? Exports: both
//? Lang: en-GB

\abstract(
Edges attract and every unordered pair repels in datamunge's direct
Fruchterman–Reingold variant. A tiny two-vertex example makes the force balance
and movement cap visible. The original four-vertex path retains its actual seeded
coordinates. Native owned traces then expose raw motion, cooling and a diagnostic
potential without replay. Coincidence, edge multiplicity and small-graph controls
show the method's limits; actual visit counts explain its quadratic repulsion work.
)

\toc

> Start with two vertices and one edge

Place two vertices at x=−0.25 and x=0.25, both with y=0. The library uses unit area
only to set k=1/sqrt(n), so k is approximately0.7071 here. At separation0.5 the
repulsion magnitude is k²/d=1, while attraction is d²/k≈0.3536. Vertex0 therefore
has net x-displacement about−0.6464. Its first movement is limited to0.1; it reaches
x=−0.35. The second and final sweep has temperature0.05, rather than zero.
All vertices read the same positions during force accumulation and move afterward.

```{cpp, results="markdown", file="figures/force_directed_tiny.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <datamunge/algorithms/force_directed_layout.hpp>
#include <datamunge/plot/diagram.hpp>
#include <print>
#include <iostream>
#include <limits>
namespace dm=datamunge;
int main(){
  std::filesystem::create_directories("build");
  const std::vector<dm::algorithms::Point2D> initial{{-.25,0},{.25,0}};const std::vector<std::pair<std::size_t,std::size_t>> edges{{0,1}};
  const auto t=dm::algorithms::force_directed_layout_trace_from(initial,edges,2);
  std::print("| sweep | temperature | vertex0 repulsion x | net x | new raw x0 | raw potential |\n| ---: | ---: | ---: | ---: | ---: | ---: |\n");
  for(const auto&f:t.frames)std::print("| {} | {:.2f} | {:.6f} | {:.6f} | {:.6f} | {:.6f} |\n",f.iteration,f.temperature,f.repulsion[0].x,f.displacement[0].x,f.positions[0].x,dm::algorithms::force_directed_layout_metrics(f.positions,edges).potential);
  std::print("\nInitial raw potential {:.6f}; final raw separation {:.6f}; normalized separation {:.6f}.\n",dm::algorithms::force_directed_layout_metrics(initial,edges).potential,t.raw_final[1].x-t.raw_final[0].x,t.positions[1].x-t.positions[0].x);
  dm::graphics::Diagram d(58,1100);dm::graphics::DiagramNodeStyle node;node.circle=true;node.width=1.1;node.height=1.1;node.font_size=23;
  dm::graphics::DiagramStroke link,arrow;link.color={148,163,184};arrow.arrow=true;arrow.width=3;arrow.color={220,38,38};
  d.path({{-2,0},{2,0}},link).path({{-2,-.8},{-3,-.8}},arrow).path({{2,-.8},{3,-.8}},arrow)
   .node("0",{-2,0},"0",node).node("1",{2,0},"1",node)
   .text({0,2},"Two raw points: x = -0.25 and +0.25",25)
   .text({0,1},"Separation0.5; repulsion1; attraction0.353553",23)
   .text({0,-2},std::format("First sweep: net x0={:.6f}; capped movement=-{:.1f}",t.frames[0].displacement[0].x,t.frames[0].temperature),23)
   .text({0,-3.1},"Compute all forces, then move all vertices",23).save_svg("build/force_directed_tiny.svg");
  if(!(dm::algorithms::force_directed_layout_metrics(t.raw_final,edges).potential>dm::algorithms::force_directed_layout_metrics(t.frames[0].positions,edges).potential))throw std::runtime_error("non-descent control");
}
