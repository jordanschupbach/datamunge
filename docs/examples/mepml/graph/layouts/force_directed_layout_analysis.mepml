> Coincidence, repeated edges and small-graph semantics

At identical coordinates Delta is zero, so the floor avoids division by zero but
cannot separate points. A two-vertex coincident layout stays coincident even with
an edge. Repeated and reversed edge records apply repeated attraction; they are not
deduplicated. A self loop has a validated endpoint but contributes no force. The
following one-sweep controls read actual accumulators, rather than inferring forces
from the capped motion. Three attractive records can reverse the net direction.

```{cpp, results="markdown", file="figures/force_directed_controls.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <datamunge/algorithms/force_directed_layout.hpp>
#include <datamunge/plot/diagram.hpp>
#include <print>
#include <iostream>
#include <limits>
namespace dm=datamunge;
int main(){
  std::filesystem::create_directories("build");
  using Points=std::vector<dm::algorithms::Point2D>;using Edges=std::vector<std::pair<std::size_t,std::size_t>>;const Points initial{{-.25,0},{.25,0}};
  const std::vector<Edges> graphs{{},{{0,1}},{{0,1},{1,0},{0,1}},{{0,0},{0,1},{1,1}}};const std::vector<std::string> labels{"No edge","One edge","Three records","Edge plus loops"};std::vector<double> net;
  std::print("| control | pair visits | edge visits | active attraction | net x0 |\n| --- | ---: | ---: | ---: | ---: |\n");
  for(std::size_t i=0;i<graphs.size();++i){const auto t=dm::algorithms::force_directed_layout_trace_from(initial,graphs[i],1);net.push_back(t.frames[0].displacement[0].x);std::print("| {} | {} | {} | {} | {:.6f} |\n",labels[i],t.work.pair_visits,t.work.edge_visits,t.work.attraction_visits,net.back());}
  const auto coincident=dm::algorithms::force_directed_layout_trace_from({{1,1},{1,1}},{{0,1}},10);const auto singleton=dm::algorithms::force_directed_layout_work_from({{3,4}},{{0,0}},std::numeric_limits<std::size_t>::max());const auto zero=dm::algorithms::force_directed_layout_work_from({{3,4},{5,4}},{{0,1}},0);
  std::print("\nCoincident control: raw point0 ({:.0f}, {:.0f}); output point0 ({:.0f}, {:.0f}); {} sweeps without separation.\n",coincident.raw_final[0].x,coincident.raw_final[0].y,coincident.positions[0].x,coincident.positions[0].y,coincident.work.completed_iterations);
  std::print("Singleton: ({:.0f}, {:.0f}); normalized {}; sweeps {}. Zero iterations with two vertices: x coordinates {:.0f}, {:.0f}; normalized {}.\n",singleton.positions[0].x,singleton.positions[0].y,singleton.work.normalized,singleton.work.completed_iterations,zero.positions[0].x,zero.positions[1].x,zero.work.normalized);
  auto plot=dm::graphics::RPlot::barplot(net,labels);plot.title("Actual first-sweep net x displacement of vertex0").xlab("Same raw starting positions; input records differ").ylab("Net force accumulator x; before movement cap").size(1000,520).save_svg("build/force_directed_controls.svg");
  if(net[2]<=0||coincident.raw_final[0].x!=1||singleton.work.normalized||!zero.work.normalized)throw std::runtime_error("degenerate and multiplicity controls");
}
