> Work caps, malformed inputs and a returned overlap

Dense adjacency uses O(V²) memory, including for sparse graphs. Ordinary work is
O(E+V²+TV²), with actual T=0 for empty or singleton inputs. A trace adds
O(FV) owned snapshot storage and O(FV²) measurements for F recorded frames.
Snapshots include the initial state, every positive stride, and the final state
without duplicating a stride boundary. Neither a zero step nor numerical
stagnation skips requested sweeps when V≥2.

The positive pair cap covers relaxation pair inspections only, while the
positive snapshot cap covers tracing only. Zero caps mean unlimited. Complete
pair, update and snapshot forecasts are checked before dense allocation, after
the entire endpoint input and option values have been validated. Failed caps,
range checks and allocations expose no partial result. Numeric updates that
cannot fit finite coordinates throw, rather than exporting infinities or NaNs.

```{cpp, results="markdown", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
  dm::algorithms::CirclePackingOptions options;
  options.iterations=4;options.snapshot_stride=2;options.max_pair_visits=12;options.max_snapshots=3;
  const auto trace=dm::algorithms::circle_packing_trace(3,{{0,1},{1,2},{2,0}},options);
  std::print("Actual snapshot iterations:");for(const auto& frame:trace.frames)std::print(" {}",frame.iteration);
  std::print(".\nRelaxation pairs {}; position commits {}; raw diagnostic pairs {}; output diagnostic pairs {}.\n\n",trace.work.pair_visits,trace.work.position_updates,trace.work.frame_pair_visits,trace.work.output_pair_visits);
  bool pair_rejected=false,snapshots_rejected=false,invalid_first=false,huge_rejected=false;
  options.max_pair_visits=11;
  try { (void)dm::algorithms::circle_packing_trace(3,{{0,1},{1,2},{2,0}},options); }
  catch(const std::length_error&) { pair_rejected=true; }
  options.max_pair_visits=12;options.max_snapshots=2;
  try { (void)dm::algorithms::circle_packing_trace(3,{{0,1}},options); }
  catch(const std::length_error&) { snapshots_rejected=true; }
  options.max_pair_visits=1;
  try { (void)dm::algorithms::circle_packing_trace(3,{{0,1},{0,3}},options); }
  catch(const std::invalid_argument&) { invalid_first=true; }
  try { (void)dm::algorithms::circle_packing_trace(1'000'000'000,{},options); }
  catch(const std::length_error&) { huge_rejected=true; }
  std::print("| preflight check | expected rejection observed |\n| :--- | :--- |\n| pair cap one below exact | {} |\n| frame cap one below exact | {} |\n| invalid trailing endpoint before cap | {} |\n| huge pair work before allocation | {} |\n",pair_rejected,snapshots_rejected,invalid_first,huge_rejected);
  options={};options.iterations=std::numeric_limits<std::size_t>::max();options.max_pair_visits=1;options.max_snapshots=1;
  const auto empty=dm::algorithms::circle_packing_trace(0,{},options);
  const auto single=dm::algorithms::circle_packing_trace(1,{},options);
  std::print("\nEmpty/singleton completed sweeps: {}/{}; singleton returned radius {:.2f}.\n",empty.work.completed_iterations,single.work.completed_iterations,single.circles[0].radius);
  std::vector<std::pair<std::size_t,std::size_t>> cycle;
  for(std::size_t i=0;i<8;++i)cycle.emplace_back(i,(i+1)%8);
  const auto disks=dm::algorithms::circle_packing_layout(8,cycle);
  const auto measured=dm::algorithms::circle_packing_metrics(disks,cycle);
  std::print("Eight-cycle returned overlaps: {}; edge contacts: {}; minimum gap: {:.9f}.\n",measured.overlapping_pairs,measured.edge_contacts,measured.min_gap);
  if(!pair_rejected || !snapshots_rejected || !invalid_first || !huge_rejected || measured.overlapping_pairs!=8)return 1;
}
