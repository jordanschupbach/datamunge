> Measure the amortized traversal work

Actual primitive snapshots occur after N enters, E edge examinations, N boundary
pops in total, N vertex assignments and N frame finishes. Their count is exactly

$$
S=E+4N.
$$
\alttext(The primitive transition count is the number of adjacency entries plus four times the number of vertices.)

Boundary pops include both open-edge collapses and component-root closures.
For N>0, N+E<=S<=4(N+E). This count excludes graph validation, allocation,
history copies and summary/rendering work. It is an operation count, not elapsed
timing or a cross-library performance ranking.

The next inputs reuse native rooted-tree and complete-directed-edge generators.
They compare chains, cycles, complete digraphs without loops and complete forward
DAGs. Dense families have quadratic E in N; that does not make a linear-in-input
SCC traversal quadratic in the number of stored adjacency entries.

```{cpp, results="markdown", file="figures/gabow_work.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <datamunge/algorithms/gabow_scc.hpp>
#include <datamunge/algorithms/graph_connectivity.hpp>
#include <datamunge/algorithms/depth_first_search.hpp>
#include <datamunge/algorithms/brute_force_search.hpp>
#include <datamunge/plot/diagram.hpp>
#include <algorithm>
#include <array>
#include <cmath>
#include <limits>
#include <print>
namespace dm=datamunge;
int main(){
  std::filesystem::create_directories("build");
  std::array<std::vector<double>,4> input,work;
  const std::array<std::string,4> names{"Chain","Cycle","Complete","Forward DAG"};
  std::print("| N | family | E | root pops | collapses | components | actual transitions |\n| ---: | --- | ---: | ---: | ---: | ---: | ---: |\n");
  for(int n:std::array<int,6>{4,8,16,32,64,128}){
    dm::algorithms::SccAdjacency chain(n),dense(n),dag(n);
    for(auto [u,v]:dm::algorithms::rooted_tree_edges(std::size_t(n),1))chain[u].push_back(int(v));
    auto cycle=chain;cycle.back().push_back(0);
    for(auto [u,v]:dm::algorithms::complete_directed_graph_edges(std::size_t(n))){dense[u].push_back(int(v));if(u<v)dag[u].push_back(int(v));}
    const std::array<dm::algorithms::SccAdjacency,4> graphs{chain,cycle,dense,dag};
    for(std::size_t k=0;k<graphs.size();++k){
      const auto r=dm::algorithms::gabow_scc_work(n,graphs[k]);const auto& w=r.work;
      std::print("| {} | {} | {} | {} | {} | {} | {} |\n",n,names[k],w.edges_examined,w.root_pops,w.root_collapses,w.component_closures,w.event_count);
      input[k].push_back(std::log2(double(n)+double(w.edges_examined)));work[k].push_back(std::log2(double(w.event_count)));
      if(w.event_count!=w.edges_examined+4*std::size_t(n)||w.root_pops!=std::size_t(n))throw std::runtime_error("amortized work identity");
    }
  }
  const auto cycle=dm::algorithms::gabow_scc_trace(8,{{1},{2},{3},{4},{5},{6},{7},{0}});
  const auto cascade=std::count_if(cycle.events.begin(),cycle.events.end(),[](const auto& e){return e.kind=="collapse"&&e.u==7&&e.v==0;});
  std::print("\nOne edge 7 -> 0 causes {} consecutive boundary pops; total root pops {}; examined edges {}.\n",cascade,cycle.work.root_pops,cycle.work.edges_examined);
  auto plot=dm::graphics::RPlot::create();
  const std::array<dm::graphics::RGB,4> colors{{{37,99,235},{220,38,38},{22,163,74},{147,51,234}}};
  for(std::size_t k=0;k<4;++k)plot.lines(input[k],work[k],names[k],colors[k],2).points(input[k],work[k],"",colors[k],3);
  plot.legend({"Chain","Cycle","Complete","Forward DAG"},{{37,99,235},{220,38,38},{22,163,74},{147,51,234}})
    .title("Measured traversal transitions S=E+4N").xlab("log2 input entries N+E").ylab("log2 actual primitive transitions").y_limits(3,18).size(1050,520).save_svg("build/gabow_work.svg");
}
```
