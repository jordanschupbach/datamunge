> Exact logical work and complete-call limits

For m customers there are C=m(m−1)/2 savings pairs. This implementation scans
all m original route slots for every pair, even after routes are absorbed, so
endpoint_slot_visits=Cm=m²(m−1)/2 exactly. Savings storage is O(m²); sorting
costs O(m² log m), and slot lookup costs O(m³). Reversals and concatenations
add at most O(m²) work over m−1 accepted merges. Recording every decision and
only accepted merged sequences adds O(m²) owned storage, not a full partition
copy at every pair. Counter values are not elapsed time or a complete CPU cost.

The distance-evaluation count is m+C+(m+k), where k is the final vehicle count:
cached depot distances, pair distances, then final closed-route edges. Sorting
comparisons are counted as executed and may depend on the standard library.
Complete pair and endpoint forecasts are checked after full input validation
and before candidate allocation. A positive decision cap limits tracing only;
zero caps mean unlimited. No partial result escapes a cap, range or allocation
failure. These safeguards do not accelerate cubic lookup.

```{cpp, results="markdown", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
  const std::vector<std::pair<double,double>> points{{0,0},{1,0},{2,0},{3,0},{4,0}};
  const std::vector<double> demand{0,1,1,1,1};
  dm::algorithms::ClarkeWrightOptions options;options.max_savings_pairs=6;options.max_endpoint_visits=24;options.max_decisions=6;
  const auto trace=dm::algorithms::clarke_wright_trace(points,demand,4,0,options);
  std::print("Actual pairs {}; endpoint-slot visits {}; final edges {}; distance evaluations {}; sorting comparisons {}.\n\n",trace.work.savings_pairs,trace.work.endpoint_slot_visits,trace.work.output_edges,trace.work.distance_evaluations,trace.work.sort_comparisons);
  bool pair=false,lookup=false,records=false,validation=false;
  options.max_savings_pairs=5;
  try { (void)dm::algorithms::clarke_wright_trace(points,demand,4,0,options); }catch(const std::length_error&) { pair=true; }
  options.max_savings_pairs=6;options.max_endpoint_visits=23;
  try { (void)dm::algorithms::clarke_wright_trace(points,demand,4,0,options); }catch(const std::length_error&) { lookup=true; }
  options.max_endpoint_visits=24;options.max_decisions=5;
  try { (void)dm::algorithms::clarke_wright_trace(points,demand,4,0,options); }catch(const std::length_error&) { records=true; }
  options.max_savings_pairs=1;
  try { (void)dm::algorithms::clarke_wright_trace(points,{0,1,1,1,-1},4,0,options); }catch(const std::invalid_argument&) { validation=true; }
  std::print("| preflight case | expected rejection observed |\n| :--- | :--- |\n| pair cap one below exact | {} |\n| lookup cap one below exact | {} |\n| trace cap one below exact | {} |\n| malformed final demand before cap | {} |\n",pair,lookup,records,validation);
  const auto boundary=dm::algorithms::clarke_wright_trace({{0,0},{1,0},{2,0}},{0,0.1,0.2},0.3);
  std::print("\nLiteral 0.1+0.2 against literal capacity 0.3: {} returned vehicles.\n",boundary.result.routes.size());
  const auto blocked=dm::algorithms::clarke_wright_trace({{0,0},{1,0},{2,0},{10,0}},{0,1,1,1},2);
  std::size_t capacity_rejections=0;for(const auto& step:blocked.steps)capacity_rejections+=step.decision==dm::algorithms::ClarkeWrightDecision::CapacityExceeded;
  std::print("Three unit customers at capacity two: {} actual capacity rejections; {} vehicles.\n",capacity_rejections,blocked.result.routes.size());
  const double x=0.4*std::numeric_limits<double>::max();
  const auto wide=dm::algorithms::clarke_wright_trace({{0,0},{x,0},{x,0}},{0,1,1},2);
  std::print("Initial star exceeds double maximum: {}; merged final distance is finite: {}.\n",wide.initial_star_distance>std::numeric_limits<double>::max(),std::isfinite(wide.result.total_distance));
  if(!pair || !lookup || !records || !validation)return 1;
}
