> A complete query census measures logical work

For each length n below, construct[0,2,...,2(n−1)]. Query every present
even value and each of its n+1 missing gaps, represented by−1 and the
n positive odd values. This is an exact census of these query classes,
not a timing benchmark or a probability distribution over arbitrary keys.
The success and missing means use their own denominators. Each query calls
the native ordinary search APIs; the report only summarizes their counts.

The plot compares mean successful reads for Fibonacci and binary search,
plus their worst reads across the complete census. Read counts omit initial
Fibonacci schedule additions and primitive comparison differences, which
are separately available through the work API. Array construction/sorting
and any cache behavior are outside these read counts. A lower count on a
selected family does not imply a universal runtime advantage.

```{cpp, results="markdown", file="figures/fibonacci_search_census.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <datamunge/algorithms/sorted_search.hpp>
#include <datamunge/plot/diagram.hpp>
#include <algorithm>
#include <cmath>
#include <cstdint>
#include <filesystem>
#include <format>
#include <limits>
#include <numeric>
#include <print>
#include <set>
#include <stdexcept>
#include <string>
#include <vector>
namespace dm=datamunge;
int main(){
  std::filesystem::create_directories("build");
  std::print("| n | Fibonacci mean present | binary mean present | Fibonacci mean missing | binary mean missing | Fibonacci worst reads | binary worst reads | initial additions | conservative bound |\n| ---: | ---: | ---: | ---: | ---: | ---: | ---: | ---: | ---: |\n");std::vector<double>x,fmean,bmean,fworst,bworst;for(std::size_t n:{1,2,3,5,8,10,13,21,34,55,89,144,233,377,610,987,1597,2584,4096}){std::vector<int>a(n);for(std::size_t i=0;i<n;++i)a[i]=2*i;std::size_t fp=0,bp=0,fm=0,bm=0,fx=0,bx=0;for(std::size_t i=0;i<n;++i){const auto f=dm::algorithms::fibonacci_search(a,2*i),b=dm::algorithms::binary_search(a,2*i);fp+=f.probes;bp+=b.probes;fx=std::max(fx,f.probes);bx=std::max(bx,b.probes);if(!f.found||!b.found)throw std::runtime_error("present census failed");}for(std::size_t i=0;i<=n;++i){const int key=i==0?-1:int(2*i-1);const auto f=dm::algorithms::fibonacci_search(a,key),b=dm::algorithms::binary_search(a,key);fm+=f.probes;bm+=b.probes;fx=std::max(fx,f.probes);bx=std::max(bx,b.probes);if(f.found||b.found)throw std::runtime_error("missing census failed");}const auto schedule=dm::algorithms::fibonacci_search_schedule(n);const auto bound=schedule.growth_steps+2;std::print("| {} | {:.6f} | {:.6f} | {:.6f} | {:.6f} | {} | {} | {} | {} |\n",n,double(fp)/n,double(bp)/n,double(fm)/(n+1),double(bm)/(n+1),fx,bx,schedule.growth_steps,bound);if(fx>bound)throw std::runtime_error("rank bound failed");x.push_back(std::log2(double(n)));fmean.push_back(double(fp)/n);bmean.push_back(double(bp)/n);fworst.push_back(fx);bworst.push_back(bx);}
  auto plot=dm::graphics::RPlot::create();plot.line(x,fmean,"Fibonacci mean",{37,99,235},2).points(x,fmean,"",{37,99,235},4).line(x,bmean,"Binary mean",{22,163,74},2).line(x,fworst,"Fibonacci worst",{220,38,38},2).line(x,bworst,"Binary worst",{124,58,237},2).title("Complete native query census on equally spaced arrays").x_label("log2(n), display coordinate").y_label("Actual element reads").size(1100,580).save_svg("build/fibonacci_search_census.svg");
}
