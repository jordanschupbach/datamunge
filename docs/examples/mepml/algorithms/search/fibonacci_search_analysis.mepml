  dm::graphics::Diagram g(58,1100);dm::graphics::DiagramNodeStyle box;box.width=1.6;box.height=1.4;box.font_size=23;for(std::size_t i=0;i<a.size();++i){box.fill=visited.contains(i)?dm::graphics::RGB{191,219,254}:dm::graphics::RGB{226,232,240};if(std::ptrdiff_t(i)==o.result.index)box.fill={187,247,208};g.node(std::format("a{}",i),{2.2*i,0},std::format("{}\ni={}",a[i],i),box);}box.width=5.5;box.height=1.8;for(std::size_t j=0;j<t.probes.size();++j){const auto&r=t.probes[j];box.fill=r.decision==0?dm::graphics::RGB{187,247,208}:dm::graphics::RGB{219,234,254};const auto id=std::format("r{}",j);g.node(id,{2.8+7*j,-3.8},std::format("Read {}: index {}\n({},{},{}) → ({},{},{})",j+1,r.index,r.small_before,r.middle_before,r.large_before,r.small_after,r.middle_after,r.large_after),box);if(j)g.edge("r0",id,"next");}g.text({6.6,2.5},"Seven sorted values; actual lookup of nine",27).text({6.6,-6.2},"2 reads, 3 key comparisons, 1 schedule transition",25).save_svg("build/fibonacci_search_tiny.svg");if(!o.result.found||o.result.index!=4||o.result.probes!=2||o.comparisons!=3)throw std::runtime_error("tiny lookup failed");
