> Known maxima reveal what a width check can and cannot establish

All four objectives below have known mathematical maxima: the two quadratics
and the cusp peak at 0.9, while x peaks at the right endpoint. Adding one to a
quadratic changes no mathematical maximizer, but it changes the resolution of
its computed values. The table keeps every requested tolerance and prints whether
the known peak lies inside the returned bracket. The two panels compare location
error and half-width at tolerance 1e−10, with the same scale. The conditional
half-width argument cannot be used for rows whose containment check is false.

```{cpp, results="markdown", file="figures/golden_accuracy.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <datamunge/algorithms/golden_section_search.hpp>
#include <datamunge/plot/diagram.hpp>
#include <algorithm>
#include <cmath>
#include <filesystem>
#include <limits>
#include <print>
#include <stdexcept>
namespace dm=datamunge;
int main(){
 std::filesystem::create_directories("build");

 const std::vector<std::string> label{"Zero","Offset","Cusp","Edge"};std::vector<double> errors,halfwidths;
 std::print("| objective | tolerance | updates | absolute location error | final half-width | true peak inside | stop |\n| --- | ---: | ---: | ---: | ---: | --- | --- |\n");
 for(int kind=0;kind<4;++kind)for(double tol:{1e-4,1e-8,1e-10,1e-14}){
  auto f=[&](double x){if(kind==0)return -(x-.9)*(x-.9);if(kind==1)return 1-(x-.9)*(x-.9);if(kind==2)return -std::abs(x-.9);return x;};
  const auto r=dm::algorithms::golden_section_run(f,0,1,tol);const double truth=kind==3?1:.9,err=std::abs(r.result.argmax-truth),half=(r.final_state.b-r.final_state.a)/2;
  std::print("| {} | {:.0e} | {} | {:.12e} | {:.12e} | {} | {} |\n",label[kind],tol,r.result.iterations,err,half,r.final_state.a<=truth&&truth<=r.final_state.b,dm::algorithms::golden_stop_name(r.stop));
  if(tol==1e-10){errors.push_back(1e9*err);halfwidths.push_back(1e9*half);}
 }
 auto a=dm::graphics::RPlot::barplot(errors,label),b=dm::graphics::RPlot::barplot(halfwidths,label);
 a.title("Location error at tolerance 1e-10").xlab("").ylab("Error × 1e9").y_limits(0,10);
 b.title("Actual half-width at tolerance 1e-10").xlab("").ylab("Half-width × 1e9").y_limits(0,10);
 dm::graphics::RLayout::create(1,2).add(a).add(b).size(1100,500).title("A rounded offset changes comparison resolution").fit_panels().save_svg("build/golden_accuracy.svg");

}
