> Streaming, composition and bounded owned evidence

The update API accepts only canonical packed states whose two lanes are below 255.
An empty update returns that validated state. If L and R are separately initialised
messages and m is the length of R, concatenation satisfies

$$
A_{LR}=A_L+A_R\pmod{255},\qquad
B_{LR}=B_L+B_R+mA_L\pmod{255}.
$$
\alttext(To concatenate independently initialised checksums, add the A residues and add both B residues plus the right-hand length times the left A residue, reducing modulo two hundred and fifty-five.)

The combine operation reduces m before multiplication and supports every uint64 length
without reading the messages. The caller supplies the correct right-message length.
For a virtual all-zero suffix, its raw tag is zero at every length. In particular,
2^64−1 is divisible by 255, so appending that virtual zero suffix leaves this tag
unchanged. This is an algebraic operation, not a huge allocation or an invalid byte view.

Byte traces check their complete event cap before allocation/folding. Bit scans check
n(8n+1) whole byte folds; one-position replacement scans check 257n. Zero disables only
the optional cap, while arithmetic/container limits still apply. Records own their
values, no input view is retained, and no partial census is returned on failure.

```{cpp, results="markdown", file="figures/fletcher_controls.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <datamunge/plot/diagram.hpp>
#include <limits>
#include <print>
namespace dm=datamunge;
int main(){
  std::filesystem::create_directories("build");
const auto left=dm::algorithms::fletcher16("ab"),right=dm::algorithms::fletcher16("cde");
  const auto combined=dm::algorithms::fletcher16_combine(left,right,3),updated=dm::algorithms::fletcher16_update(left,"cde");
  std::print("Chunks: ab 0x{:04X}; cde 0x{:04X}; combined 0x{:04X}; continued 0x{:04X}; whole 0x{:04X}.\n",left,right,combined,updated,dm::algorithms::fletcher16("abcde"));
  const auto virtual_zero_suffix=dm::algorithms::fletcher16_combine(combined,0,std::numeric_limits<std::uint64_t>::max());
  std::print("Virtual uint64-max zero suffix: 0x{:04X}; unchanged {}.\n",virtual_zero_suffix,virtual_zero_suffix==combined);
  bool bad_state=false,trace_under=false,scan_under=false,replacement_under=false;
  try{(void)dm::algorithms::fletcher16_update(0x00FF,{});}catch(const std::invalid_argument&){bad_state=true;}
  try{(void)dm::algorithms::fletcher16_trace("abcde",4);}catch(const std::length_error&){trace_under=true;}
  try{(void)dm::algorithms::fletcher16_flip_scan("abracadabra",978);}catch(const std::length_error&){scan_under=true;}
  try{(void)dm::algorithms::fletcher16_replacement_scan(std::string(1,'\0'),0,256);}catch(const std::length_error&){replacement_under=true;}
  const auto t=dm::algorithms::fletcher16_trace("abcde",5);auto edited=t;edited.steps[0].after_a=99;
  std::print("Checked controls: lane255 rejects {}; whole trace cap4 rejects {}; bit-fold cap978 rejects {}; replacement-fold cap256 rejects {}.\n",bad_state,trace_under,scan_under,replacement_under);
  std::print("Owned trace: first original A {}; edited copy A {}; retained final tag 0x{:04X}.\n",t.steps[0].after_a,edited.steps[0].after_a,t.checksum);
  const auto empty=dm::algorithms::fletcher16_flip_scan({});std::print("Empty scan: tag {}; events {}; byte folds {}.\n",empty.checksum,empty.flips.size(),empty.bytes_processed);
  dm::graphics::Diagram g(60,1100);dm::graphics::DiagramNodeStyle b;b.width=3.8;b.height=1.8;b.font_size=24;
  g.node("left",{0,1.7},std::format("Chunk ab\nRaw tag {:04X}",left),b).node("right",{0,-1.7},std::format("Chunk cde\nRaw tag {:04X}\nLength 3",right),b).node("combine",{5.7,0},"Combine raw states\nA1 + A2\nB1 + B2 + 3A1",b).node("result",{11.4,0},std::format("Whole abcde\nRaw tag {:04X}",combined),b).edge("left","combine").edge("right","combine").edge("combine","result").text({5.7,-4.2},"Length is supplied explicitly; source bytes need not be retained",24).save_svg("build/fletcher_controls.svg");
  if(combined!=0xC8F0||updated!=combined||!bad_state||!trace_under||!scan_under||!replacement_under)throw std::runtime_error("Fletcher composition or quotas");
}
