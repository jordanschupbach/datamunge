> Preserve the original reference and corruption examples

For n bytes x_i indexed from zero, expanding the recurrence gives

$$
A=\sum_{i=0}^{n-1}x_i\pmod{255},\qquad
B=\sum_{i=0}^{n-1}(n-i)x_i\pmod{255}.
$$
\alttext(A is the byte sum modulo two hundred and fifty-five. B is a weighted sum in which the first byte has weight n and the last has weight one.)

Keep the original abcde reference, all 88 independent one-bit changes to abracadabra,
and the ABCD versus ABDC transposition. The complete bit scan recomputes the ordinary
checksum for every candidate, using one toggled/restored scratch message. Its budget
is n(8n+1) byte folds including the baseline; it neither samples nor truncates candidates.
The modular deltas in the second panel are residues, not security scores or collision
probabilities. The numerical magnitude of a packed tag is not a measure of strength.

```{cpp, results="markdown", file="figures/fletcher_original.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <datamunge/plot/diagram.hpp>
#include <limits>
#include <print>
namespace dm=datamunge;
int main(){
  std::filesystem::create_directories("build");
const auto t=dm::algorithms::fletcher16_trace("abcde");const auto flips=dm::algorithms::fletcher16_flip_scan("abracadabra");
  std::print("| byte position | unsigned byte | A after | B after |\n| ---: | ---: | ---: | ---: |\n");std::vector<double>x,a,b;
  for(const auto&s:t.steps){std::print("| {} | {} | {} | {} |\n",s.index,static_cast<unsigned>(s.byte),s.after_a,s.after_b);x.push_back(s.index+1);a.push_back(s.after_a);b.push_back(s.after_b);}
  std::print("\nOriginal reference: fletcher16(abcde) = 0x{:04X}; A {}; B {}.\n",t.checksum,t.sum1,t.sum2);
  std::print("Original abracadabra scan: detected {} / {}; complete byte folds {}.\n",flips.detected,flips.flips.size(),flips.bytes_processed);
  const std::string original="ABCD",swapped=dm::algorithms::checksum_swap_bytes(original,2,3);
  std::print("Original transposition: plain sums {} / {}; raw Fletcher tags {} / {}; detected {}.\n",dm::algorithms::byte_sum32(original),dm::algorithms::byte_sum32(swapped),dm::algorithms::fletcher16(original),dm::algorithms::fletcher16(swapped),dm::algorithms::fletcher16(original)!=dm::algorithms::fletcher16(swapped));
  std::vector<double>bit,delta;for(const auto&r:flips.flips){bit.push_back(r.bit);delta.push_back(r.delta_b);}
  auto states=dm::graphics::RPlot::create();states.line(x,a,"A",{37,99,235},2).points(x,a,"",{37,99,235},5).line(x,b,"B",{22,163,74},2).points(x,b,"",{22,163,74},5).title("Actual abcde residues").x_label("Bytes consumed").y_label("Canonical residue").y_limits(0,300).legend({"A","B"},{{37,99,235},{22,163,74}});
  auto changes=dm::graphics::RPlot::create();changes.points(bit,delta,"Delta B",{124,58,237},3).title("All 88 independent input-bit changes").x_label("Input bit, byte-major LSB first").y_label("Delta B modulo 255").y_limits(0,270);
  dm::graphics::RLayout::create(1,2).add(states).add(changes).size(1100,540).title("Original values from actual folds and complete candidate scans").fit_panels().save_svg("build/fletcher_original.svg");
  if(t.checksum!=0xC8F0||flips.detected!=88||dm::algorithms::fletcher16(original)!=38411||dm::algorithms::fletcher16(swapped)!=38667)throw std::runtime_error("original controls");
}
