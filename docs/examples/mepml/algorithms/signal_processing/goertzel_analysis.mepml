\image(figures/goertzel_work.svg)
// result_end
\caption(All 36 sample-count/target-count combinations satisfy the predicted MN updates. Validation reads, trigonometric setup and terminal arithmetic are excluded from this selected counter, so it is not a total cost or timing measurement.)
\alttext(Four positive log2 count curves show one, two, four and eight target evaluations over nine sample counts. Each printed actual update count equals sample count times target count, with no artificial zero floor.)

> Finite arithmetic still has numerical limits

The exact squared magnitude is nonnegative, but its ordered terminal expression
subtracts large nearby quantities. The following two stored samples have an exact
DC sum of 2^-52, so their exact DC power is 2^-104. The retained raw expression
returns −2^-51. The core exposes that finite result instead of silently clamping it.
Constant signals provide another independent answer: N ones have exact DC power N².

The large-bin example also distinguishes ideal integer DFT periodicity from
floating evaluation of an unreduced angle. The size_t maximum is congruent to
bin 3 modulo four; [1,2,3,4] has ideal power 8 there. Converting that large integer
to double and evaluating its huge angle can give a different raw result. The old
unsigned-bin semantics remain explicit rather than silently reducing the index.

```{cpp, results="markdown", file="figures/goertzel_numeric.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <datamunge/algorithms/goertzel.hpp>
#include <datamunge/plot/diagram.hpp>
#include <algorithm>
#include <cmath>
#include <filesystem>
#include <limits>
#include <numbers>
#include <print>
#include <stdexcept>
namespace dm=datamunge;
int main(){
 std::filesystem::create_directories("build");

 const std::vector<double> pair{0x1.59497b6052b08p+0,-0x1.59497b6052b07p+0};
 const double raw=dm::algorithms::goertzel_power_bin(pair,0),exact=(pair[0]+pair[1])*(pair[0]+pair[1]);
 std::print("Near-cancelling pair: raw {:.17e}; exact DC power {:.17e}; exact sum {:.17e}.\n",raw,exact,pair[0]+pair[1]);
 std::vector<double> sizes,errors;
 std::print("\n| DC samples N | returned raw power | exact N squared | signed relative error percent |\n| ---: | ---: | ---: | ---: |\n");
 for(std::size_t n:{4u,16u,64u,256u,1024u,4096u,16384u,65536u,100000u,1000000u}){
  const auto r=dm::algorithms::goertzel_bin_run(std::vector<double>(n,1),0);const double truth=double(n)*double(n),error=100*(r.power/truth-1);
  std::print("| {} | {:.0f} | {:.0f} | {:.12f} |\n",n,r.power,truth,error);sizes.push_back(std::log10(double(n)));errors.push_back(10000*error);
 }
 const auto large=dm::algorithms::goertzel_bin_run({1,2,3,4},std::numeric_limits<std::size_t>::max());
 std::print("\nUnreduced bin {}; ideal four-sample alias {}; raw power {:.12f}; ideal alias power 8.\n",large.bin,large.bin%4,large.power);
 auto a=dm::graphics::RPlot::create();
 a.line(sizes,errors,"error",{37,99,235},2).points(sizes,errors,"error",{37,99,235},4)
  .legend({"Signed relative error"},{{37,99,235}}).title("Constant input: known DC power N²")
  .xlab("log10(samples N)").ylab("Relative error (parts per million)").x_limits(.6,6).y_limits(-14,2);
 auto b=dm::graphics::RPlot::barplot({raw/std::ldexp(1.,-51),exact/std::ldexp(1.,-51)},{"Raw","Exact"});
 b.title("Cancellation can produce a negative value").xlab("").ylab("Power divided by 2^-51").y_limits(-1.2,.3);
 dm::graphics::RLayout::create(1,2).add(a).add(b).size(1100,520).title("Finite output is not an exact nonnegative power certificate").fit_panels().save_svg("build/goertzel_numeric.svg");
 if(raw!=-0x1p-51||exact!=0x1p-104)throw std::runtime_error("finite cancellation witness");

}
