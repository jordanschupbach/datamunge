//? Title: Exp-Golomb: Length Prefixes, Orders and Exact Bit Boundaries
//? Subtitle: Full-range unsigned coding, actual word spans and safe bounded-prefix parsing in native C++
//? Exports: both
//? Lang: en-GB

\abstract(
A sequence of nonnegative integers needs recoverable word boundaries without
assigning every value the width of the largest one. Exp-Golomb uses a short
length prefix and a binary payload, favouring small values while still allowing
large ones. We begin with the five-bit order-two encoding of ten, preserve the
original codewords and mixed-sequence round trip, and measure how order and
magnitude affect payload size. Actual emission/parsing spans expose the boundary;
checked native arithmetic supports all uint64 values, including a 129-bit word.
The caller supplies the order and message framing.
)

\toc

> Start with ten at order two

Order k splits n into a quotient q=floor(n/2^k) and its k low bits.
For n=10 and k=2, q=2 and the low bits are 10. Encode q+1=3 as binary
11 with one leading zero, then append 10. The actual word is 01110.
Its three fields have lengths one, two and two. The diagram reads captured
indices from the same kernel that emitted the bits; decoding records them too.

```{cpp, results="markdown", file="figures/exp_golomb_tiny.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main(){
  std::filesystem::create_directories("build");
  const auto e=dm::algorithms::exp_golomb_encode_trace({10},2);
  const auto d=dm::algorithms::exp_golomb_decode_trace(e.bits,1,2);
  const auto& w=e.words.at(0);const auto& v=d.words.at(0);
  if(d.values!=e.values||v.begin!=w.begin||v.payload_begin!=w.payload_begin||v.suffix_begin!=w.suffix_begin||v.end!=w.end)throw std::runtime_error("actual span mismatch");
  std::print("Tiny: n {}; order {}; code {}; zeros [{},{}); quotient [{},{}); low bits [{},{}).\n\n",w.value,e.order,dm::algorithms::exp_golomb_bit_string(e.bits),w.begin,w.payload_begin,w.payload_begin,w.suffix_begin,w.suffix_begin,w.end);
  std::print("| actual run | values | zeros | quotient bits | low bits | bit visits | captured entries |\n| :--- | ---: | ---: | ---: | ---: | ---: | ---: |\n");
  for(const auto& [name,t]:std::vector<std::pair<std::string,dm::algorithms::ExpGolombTrace>>{{"encode",e},{"decode",d}})
    std::print("| {} | {} | {} | {} | {} | {} | {} |\n",name,t.work.values,t.work.zero_prefix_bits,t.work.quotient_bits,t.work.suffix_bits,t.work.bit_visits,t.captured_entries);
  dm::graphics::Diagram g(64,1100);dm::graphics::DiagramNodeStyle box;box.width=1.15;box.height=1;box.font_size=30;
  for(std::size_t i=w.begin;i<w.end;++i){box.fill=i<w.payload_begin?dm::graphics::RGB{191,219,254}:i<w.suffix_begin?dm::graphics::RGB{187,247,208}:dm::graphics::RGB{254,215,170};
    g.node(std::to_string(i),{1.8*double(i),0},e.bits[i]?"1":"0",box).text({1.8*double(i),-1.1},std::to_string(i),18);}
  g.text({0,1.5},"one zero",21).text({2.7,1.5},"q+1 = 11",21).text({6.3,1.5},"low bits = 10",21)
   .text({3.6,3.1},"Ten at order two: actual word 01110",27).save_svg("build/exp_golomb_tiny.svg");
}
