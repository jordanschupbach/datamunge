> Full range, framing and invalid attempted words

At UINT64_MAX and order zero, q+1 is mathematically 2^64.
Its binary representation is a one followed by 64 zeros: a real
65-bit payload. The entire word has 64 prefix zeros and 129 bits.
The implementation emits that representation without wrapping n+1.
The saved old implementation instead encoded UINT64_MAX as the single
bit zero, and sanitizer probes exposed shifts by 64, negative shifts
and truncated-stream reads beyond the bit vector. Those cases now have
specified results or errors.

The decoder's count is a nonnegative upper limit, preserving the legacy
bounded-prefix contract. It returns fewer values when the input ends at
a complete-word boundary, and reads nothing for count zero. Once the
limit is met it leaves any tail unread and unvalidated. Every attempted
word must be complete, however: a partial zero run, quotient or suffix
throws invalid_argument. An overwide prefix or value beyond uint64
throws overflow_error. Invalid order or negative count is rejected even
on empty input. Exact-count/full-frame callers must additionally check
values.size()==requested_count and consumed_bits==bits.size().

Appending one word preserves any existing bit prefix without parsing it.
It validates/reserves complete append geometry before writing. Trace
results own their input/output, values and word records independently.
The next program exercises prefix framing, append mutation, native limits
and exact/one-short capture quotas.

```{cpp, results="markdown", file="figures/exp_golomb_limits.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main(){
  std::filesystem::create_directories("build");const auto max=std::numeric_limits<std::uint64_t>::max();
  const auto e=dm::algorithms::exp_golomb_encode_trace({max});const auto d=dm::algorithms::exp_golomb_decode_trace(e.bits,1);const auto& w=e.words.at(0);
  if(d.values!=e.values||e.bits.size()!=129||std::count(e.bits.begin(),e.bits.end(),true)!=1)throw std::runtime_error("maximum word failed");
  std::print("Maximum: {} bits; prefix [{},{}); quotient [{},{}); low bits [{},{}); true bits {}; capture {}; round trip {}.\n",e.bits.size(),w.begin,w.payload_begin,w.payload_begin,w.suffix_begin,w.suffix_begin,w.end,std::count(e.bits.begin(),e.bits.end(),true),e.captured_entries,d.values==e.values);
  std::print("Order 63: zero length {}; maximum length {}.\n",dm::algorithms::exp_golomb_code_length(0,63),dm::algorithms::exp_golomb_code_length(max,63));
  const std::vector<bool> frame{true,false};const auto prefix=dm::algorithms::exp_golomb_decode_trace(frame,1,0,4);const auto none=dm::algorithms::exp_golomb_decode_trace(frame,0,0,2);
  std::print("Prefix limit 1: value {}; consumed {}; input bits {}; capture {}. Limit 0: values {}; consumed {}; capture {}.\n",prefix.values.at(0),prefix.consumed_bits,prefix.bits.size(),prefix.captured_entries,none.values.size(),none.consumed_bits,none.captured_entries);
  std::print("Complete one-bit frame with limit 2: {} values. Empty frame with positive limit: {} values.\n",dm::algorithms::exp_golomb_decode({true},2).size(),dm::algorithms::exp_golomb_decode({},2).size());
  int malformed=0;for(const auto& [b,k]:std::vector<std::pair<std::vector<bool>,int>>{{{false},0},{{false,true},0},{{true,false},2}})try{(void)dm::algorithms::exp_golomb_decode(b,1,k);}catch(const std::invalid_argument&){++malformed;}
  try{(void)dm::algorithms::exp_golomb_decode(frame,2);}catch(const std::invalid_argument&){++malformed;}
  int invalid=0;for(int k:{-1,64})try{(void)dm::algorithms::exp_golomb_encode({},k);}catch(const std::invalid_argument&){++invalid;}
  try{(void)dm::algorithms::exp_golomb_decode({},-1);}catch(const std::invalid_argument&){++invalid;}
  int wide=0;try{(void)dm::algorithms::exp_golomb_decode(std::vector<bool>(65,false),1);}catch(const std::overflow_error&){++wide;}
  std::print("Incomplete attempted-word rejections {}/4; invalid-parameter rejections {}/3; overwide-prefix rejections {}/1.\n",malformed,invalid,wide);
  std::vector<bool> out{true,false};const auto appended=dm::algorithms::exp_golomb_append_work(10,out,2);
  std::print("Append: {}; new values {}; new bit visits {}.\n",dm::algorithms::exp_golomb_bit_string(out),appended.values,appended.bit_visits);
  const auto tiny=dm::algorithms::exp_golomb_encode_trace({10},2,7);int caps=0;
  try{(void)dm::algorithms::exp_golomb_encode_trace({10},2,6);}catch(const std::length_error&){++caps;}
  for(std::size_t cap:{4,6})try{(void)dm::algorithms::exp_golomb_decode_trace(tiny.bits,1,2,cap);}catch(const std::length_error&){++caps;}
  std::print("Tiny exact encode/decode entries {}/{}; base/one-short rejections {}/3; disabled-quota entries {}.\n",tiny.captured_entries,dm::algorithms::exp_golomb_decode_trace(tiny.bits,1,2,7).captured_entries,caps,dm::algorithms::exp_golomb_encode_trace({10},2,0).captured_entries);
  if(malformed!=4||invalid!=3||wide!=1||caps!=3)throw std::runtime_error("boundary rejection check failed");
  dm::graphics::Diagram g(64,1100);dm::graphics::DiagramNodeStyle box;box.width=4.5;box.height=1.8;box.font_size=23;box.fill={191,219,254};
  g.node("prefix",{0,0},std::format("{} prefix zeros\n[{},{})",w.payload_begin-w.begin,w.begin,w.payload_begin),box);box.fill={187,247,208};
  g.node("quotient",{6,0},std::format("1 then 64 zeros\n[{},{})",w.payload_begin,w.suffix_begin),box);box.fill={254,215,170};
  g.node("boundary",{12,0},std::format("k = 0: no low bits\nend {}\ncapture {}",w.end,e.captured_entries),box).edge("prefix","quotient").edge("quotient","boundary")
    .text({6,2.8},"UINT64_MAX: a real 65-bit quotient payload",27).save_svg("build/exp_golomb_limits.svg");
}
