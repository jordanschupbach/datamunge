> Check exact work and the effect of value magnitudes

For N copies of 13, each codeword contributes three prefix and four
payload bits. Thus emission and parsing each visit 7N coded bits;
the trace retains 7N+2N=9N logical entries. Counts exclude preflight,
the parser's separate full alphabet-validation pass, copies, allocation
and machine instructions. In general encoding costs O(N+B), parsing
O(B) including validation, with B coded characters and N values.
Ordinary output requires O(B) encoded characters or O(N) decoded values;
the kernels otherwise use O(1) extra storage. Optional trace buffers add
the documented retained entries.

Bit savings depend on source magnitudes. The next fixtures each contain
1,024 values: mostly ones with one 1,024; consecutive integers one
through 1,024; and the constant 2^63. A rare large value makes a common
fixed width expensive. When every value is large, gamma pays its length
prefix every time. These deterministic fixtures test a controlled claim;
they are not a sample from an assumed natural source distribution.

```{cpp, results="markdown", file="figures/elias_gamma_work.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main(){
  std::filesystem::create_directories("build");std::vector<double>x,bits,capture,ratios;
  std::print("| copies of 13 | prefix bits | payload bits | emitted bits | parsed bits | retained entries |\n| ---: | ---: | ---: | ---: | ---: | ---: |\n");
  for(std::size_t n:{1,2,4,8,16,32,64}){const auto e=dm::algorithms::elias_gamma_encode_trace(std::vector<std::uint64_t>(n,13));const auto d=dm::algorithms::elias_gamma_decode_trace(e.bits);
    if(e.work.zero_prefix_bits!=3*n||e.work.payload_bits!=4*n||e.work.bit_visits!=7*n||d.work.bit_visits!=7*n||e.captured_entries!=9*n||d.values!=e.values)throw std::runtime_error("linear count identity failed");
    std::print("| {} | {} | {} | {} | {} | {} |\n",n,e.work.zero_prefix_bits,e.work.payload_bits,e.work.bit_visits,d.work.bit_visits,e.captured_entries);x.push_back(n);bits.push_back(e.work.bit_visits);capture.push_back(e.captured_entries);}
  std::vector<std::uint64_t> rare(1024,1),consecutive(1024),high(1024,std::uint64_t{1}<<63);rare.back()=1024;std::iota(consecutive.begin(),consecutive.end(),1);
  const std::vector<std::string> names{"rare large","1..1024","all high"};const std::vector<std::vector<std::uint64_t>> fixtures{rare,consecutive,high};
  const std::array<std::size_t,3> expected_gamma{1044,17432,130048},expected_fixed{11264,11264,65536};
  std::print("\n| 1024-value fixture | gamma bits | fixed width | fixed bits | ASCII bit characters | gamma/fixed bits | round trip |\n| :--- | ---: | ---: | ---: | ---: | ---: | :--- |\n");
  for(std::size_t i=0;i<fixtures.size();++i){const auto s=dm::algorithms::elias_gamma_size_summary(fixtures[i]);const auto e=dm::algorithms::elias_gamma_encode_work(fixtures[i]);const auto d=dm::algorithms::elias_gamma_decode_work(e.bits);const bool ok=d.values==fixtures[i];
    if(!ok||s.gamma_bits!=expected_gamma[i]||s.fixed_bits!=expected_fixed[i]||e.bits.size()!=s.gamma_bits)throw std::runtime_error("fixture size identity failed");const double ratio=double(s.gamma_bits)/s.fixed_bits;ratios.push_back(ratio);
    std::print("| {} | {} | {} | {} | {} | {:.6f} | {} |\n",names[i],s.gamma_bits,s.fixed_width,s.fixed_bits,e.bits.size(),ratio,ok);}
  auto a=dm::graphics::RPlot::create();a.line(x,bits,"bits",{37,99,235}).points(x,bits,"",{37,99,235},5).line(x,capture,"capture",{124,58,237}).points(x,capture,"",{124,58,237},5).title("Repeated 13: exact bit and history counts").x_label("Number of values N").y_label("Logical bits or entries").y_limits(0,720);
  auto b=dm::graphics::RPlot::barplot(ratios,names,"",{22,163,74});b.line({-.4,2.4},{1,1},"equal bits",{71,85,105}).title("Gamma bits / minimal fixed-width bits").x_label("Controlled value fixture").y_label("Payload-bit ratio").y_limits(0,2.5);
  dm::graphics::RLayout::create(1,2).add(a).add(b).size(1100,520).title("Linear codec counts and a distribution-dependent payload comparison").fit_panels().save_svg("build/elias_gamma_work.svg");
}
