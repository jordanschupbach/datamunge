  dm::graphics::Diagram g(58,1100);dm::graphics::DiagramNodeStyle box;box.width=3.8;box.height=1.8;box.font_size=22;
  for(int panel=0;panel<2;++panel){const auto& p=t.steps[panel?2:0];const double y=panel?-8:0;box.fill={191,219,254};g.node(std::format("a{}",panel),{0,y},std::format("a = {:.6f}\ntrue f(a) = {:.6f}\nweight = {:.6f}",p.a,p.f_a,p.weight_a),box);box.fill=panel?dm::graphics::RGB{254,215,170}:dm::graphics::RGB{191,219,254};g.node(std::format("b{}",panel),{10,y},std::format("b = {:.6f}\ntrue f(b) = {:.6f}\nweight = {:.6f}",p.b,p.f_b,p.weight_b),box);box.fill={187,247,208};g.node(std::format("c{}",panel),{5,y-3},std::format("trial = {:.6f}\nactual f = {:.6f}",p.estimate,p.f_estimate),box).edge(std::format("a{}",panel),std::format("c{}",panel),"weighted secant").edge(std::format("b{}",panel),std::format("c{}",panel));}
