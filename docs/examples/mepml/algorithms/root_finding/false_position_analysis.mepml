  std::filesystem::create_directories("build");
  auto error=dm::graphics::RPlot::create(),radius=dm::graphics::RPlot::create();std::vector<double>x;std::vector<std::vector<double>>errors(3),radii(3);const double truth=std::sqrt(2.);
  std::print("| scale exponent | request | root | absolute coordinate error | actual residual | rounded radius | trials | stop |\n| ---: | :--- | ---: | ---: | ---: | ---: | ---: | :--- |\n");for(int exponent:{-30,0,30}){const double scale=std::pow(10.,exponent);x.push_back(exponent);for(int mode=0;mode<3;++mode){dm::algorithms::FalsePositionOptions o;if(mode==1)o.residual_tolerance=scale*1e-10;if(mode==2){o.residual_tolerance=0;o.x_tolerance=1e-10;}const auto r=dm::algorithms::false_position_work([=](double z){return scale*(z*z-2);},1,2,o);const double e=std::abs(r.result.root-truth);const std::string name=mode==0?"fixed residual":mode==1?"scaled residual":"coordinate radius";std::print("| {} | {} | {:.12f} | {:.8g} | {:.8g} | {:.8g} | {} | {} |\n",exponent,name,r.result.root,e,r.result.residual,r.radius,r.result.iterations,dm::algorithms::false_position_stop_name(r.stop));errors[mode].push_back(std::log10(std::max(e,1e-16)));radii[mode].push_back(std::log10(std::max(r.radius,1e-16)));if(exponent==-30&&mode==0&&e<.01)throw std::runtime_error("small-residual control failed");}}
  const std::vector<std::string>names{"Fixed residual","Scaled residual","Coordinate radius"};const std::vector<dm::graphics::RGB>colours{{220,38,38},{37,99,235},{22,163,74}};for(int mode=0;mode<3;++mode){error.line(x,errors[mode],names[mode],colours[mode],2).points(x,errors[mode],"",colours[mode],4);radius.line(x,radii[mode],names[mode],colours[mode],2).points(x,radii[mode],"",colours[mode],4);}error.title("Actual coordinate error").x_label("log10 function scale").y_label("log10 max(error, 1e-16)");radius.title("Actual rounded endpoint radius").x_label("log10 function scale").y_label("log10 max(radius, 1e-16)");dm::graphics::RLayout::create(1,2).add(error).add(radius).size(1100,540).title("Residual units, root error and bracket radius").fit_panels().save_svg("build/false_position_units.svg");
}
