  std::print("| trial | a | b | true f(b) | weight for b | estimate | actual f(estimate) | halved after trial |\n| ---: | ---: | ---: | ---: | ---: | ---: | ---: | :--- |\n");for(std::size_t i=0;i<t.steps.size();++i){const auto& p=t.steps[i];std::print("| {} | {:.9f} | {:.9f} | {:.9f} | {:.9f} | {:.9f} | {:.9f} | {} |\n",i+1,p.a,p.b,p.f_b,p.weight_b,p.estimate,p.f_estimate,p.damped);}
