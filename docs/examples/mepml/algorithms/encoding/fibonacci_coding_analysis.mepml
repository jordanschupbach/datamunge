  const std::vector<std::uint64_t>values{1,2,10};const auto e=dm::algorithms::fibonacci_encode_trace(values,17),d=dm::algorithms::fibonacci_decode_trace(e.bits,17);std::print("| actual word | value | begin | overlapping delimiter begin | end | emitted length | parsed length |\n| ---: | ---: | ---: | ---: | ---: | ---: | ---: |\n");for(std::size_t i=0;i<e.words.size();++i){const auto&w=e.words[i];const auto&v=d.words[i];std::print("| {} | {} | {} | {} | {} | {} | {} |\n",i,w.value,w.begin,w.delimiter_begin,w.end,w.end-w.begin,v.end-v.begin);}
  std::print("\nSame-pass work: values {}; payload {}; terminators {}; bit visits {}; captured B+2N {}.\n",e.work.values,e.work.payload_bits,e.work.terminator_bits,e.work.bit_visits,e.captured_entries);
  bool enc=false,dec=false;try{(void)dm::algorithms::fibonacci_encode_trace({1,2},8);}catch(const std::length_error&){enc=true;}try{(void)dm::algorithms::fibonacci_decode_trace(dm::algorithms::fibonacci_encode({1,2}),8);}catch(const std::length_error&){dec=true;}const auto off=dm::algorithms::fibonacci_encode_trace({1,2},0);auto edited=e;const auto owned=edited;edited.bits[0]=false;edited.values[0]=99;std::print("Quota controls: C=9 over cap8 rejects encode {}; decode {}; disabled quota actual C {}.\n",enc,dec,off.captured_entries);std::print("Owned copy: first bit {}; first value {}; edited first bit {}; edited first value {}.\n",owned.bits[0],owned.values[0],edited.bits[0],edited.values[0]);
  const std::vector<std::vector<std::uint64_t>>families{{},{1},{1,2,10},{1,2,3,4,7,10,50,100,1000,100000},{UINT64_MAX}};std::vector<double>x,y;std::print("| input values N | actual bits B | actual capture C | formula B+2N |\n| ---: | ---: | ---: | ---: |\n");for(const auto&v:families){const auto t=dm::algorithms::fibonacci_encode_trace(v);std::print("| {} | {} | {} | {} |\n",v.size(),t.bits.size(),t.captured_entries,t.bits.size()+2*v.size());x.push_back(t.bits.size()+2*v.size());y.push_back(t.captured_entries);}auto plot=dm::graphics::RPlot::create();plot.points(x,y,"Actual captures",{37,99,235},7).line({0,130},{0,130},"C = B + 2N",{100,116,139},1).title("Logical retained entries in actual Fibonacci traces").x_label("B + 2N, excluding metadata and capacity").y_label("Actual admitted entries C").size(1100,560).save_svg("build/fibonacci_capture.svg");if(!enc||!dec||d.values!=values||owned.values.front()!=1)throw std::runtime_error("capture controls failed");
}
