// result_end
\caption(A zero auxiliary repairs the small-prime bug; a complementary root preserves the signed legacy result over full-range unsigned primes.)

Every scalar product widens its two operands to unsigned 128 bits before
reduction. Extension coefficients combine already reduced products, so their
sums stay below 2p; the code never adds two unreduced 128-bit products.
Candidate subtraction uses a difference of canonical residues instead of
forming a²+p−n in uint64. The exponent is computed as p/2+1, avoiding a
potentially overflowing p+1 expression. Prime validation occurs before n%p,
so p=0 cannot trigger division by zero, and composite zero inputs cannot
silently take the zero shortcut.

> Caps, final checks and operation accounting

CipollaOptions uses zero for an unlimited cap. Positive limits bound actual
candidate visits and actual extension pair operations for the whole call.
The latter counts the closing square. Cap exhaustion throws std::length_error
and returns no partial root or trace, even if an intermediate accumulator
already contains a root. Prime validation, scalar Euler tests and final
verification are separate from the extension-product cap. Nonresidues and
valid zero/binary shortcuts do not consume unused candidate or extension work.

```{cpp, results="markdown", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
  dm::algorithms::CipollaOptions exact;exact.max_candidates=2;exact.max_extension_products=6;
  const auto t=dm::algorithms::cipolla_sqrt_trace(10,13,exact);
  auto low=exact;low.max_candidates=1;bool candidate_cap=false;
  try{(void)dm::algorithms::cipolla_sqrt_result(10,13,low);}catch(const std::length_error&){candidate_cap=true;}
  low=exact;low.max_extension_products=5;bool product_cap=false;
  try{(void)dm::algorithms::cipolla_sqrt_trace(10,13,low);}catch(const std::length_error&){product_cap=true;}
  int invalid=0;
  const std::array<std::uint64_t,6> bad{{0,1,4,9,561,std::numeric_limits<std::uint64_t>::max()}};
  for(const auto p:bad)try{(void)dm::algorithms::cipolla_sqrt_result(0,p,low);}catch(const std::invalid_argument&){++invalid;}
  if(!candidate_cap || !product_cap || invalid!=6)return 1;
  const auto& w=t.work;
  std::print("| actual named category | count |\n| :--- | ---: |\n| primality-validator calls (internal products excluded) | {} |\n| input Euler modular products | {} |\n| candidate square products | {} |\n| candidate Euler products | {} |\n| extension result pair products | {} |\n| extension base pair squares | {} |\n| scalar products inside extension pairs | {} |\n| final root-square verification | {} |\n",w.primality_checks,w.residue_power_products,w.candidate_squares,w.candidate_power_products,w.extension_result_products,w.extension_base_squares,w.extension_scalar_products,w.verification_products);
  const auto named_scalar=w.residue_power_products+w.candidate_squares+w.candidate_power_products+w.extension_scalar_products+w.verification_products;
  std::print("\nNamed modular scalar products outside prime validation: {}.\n",named_scalar);
  std::print("One-below caps reject: candidates {}, pair products {}. Invalid zero/composite moduli reject before zero shortcuts: {} of 6.\n",candidate_cap,product_cap,invalid);
  const auto none=dm::algorithms::cipolla_sqrt_trace(11,1009,low);
  std::print("Nonresidue 11 mod 1009: exists {}, actual candidate visits {}.\n",none.result.exists,none.work.candidate_tests);
  auto copy=t;copy.steps[0].result_after.x=0;
  std::print("Mutating a copied record leaves the original first result coefficient {}.\n",t.steps[0].result_after.x);
}
