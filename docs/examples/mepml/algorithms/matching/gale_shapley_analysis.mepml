int main(){
  std::filesystem::create_directories("build");
  const auto f=dm::algorithms::stable_matching_example_preferences();
  const auto residents=dm::algorithms::gale_shapley_work(f.proposer_preferences,f.reviewer_preferences);
  const auto hospital_run=dm::algorithms::gale_shapley_work(f.reviewer_preferences,f.proposer_preferences);
  const auto hospitals=dm::algorithms::reverse_stable_matching(hospital_run.result);
  const auto a=dm::algorithms::stable_matching_ranks(residents.result,f.proposer_preferences,f.reviewer_preferences);
  const auto b=dm::algorithms::stable_matching_ranks(hospitals,f.proposer_preferences,f.reviewer_preferences);
  std::print("| agent ID | resident preference row | hospital preference row |\n| ---: | --- | --- |\n");
  for(std::size_t i=0;i<f.proposer_preferences.size();++i)std::print("| {} | {} | {} |\n",i,f.proposer_preferences[i],f.reviewer_preferences[i]);
  std::print("\n| resident | hospital when residents propose | resident rank | hospital when hospitals propose | resident rank |\n| ---: | ---: | ---: | ---: | ---: |\n");
  for(std::size_t i=0;i<a.proposer_ranks.size();++i)std::print("| {} | {} | {} | {} | {} |\n",i,residents.result.proposer_match[i],a.proposer_ranks[i],hospitals.proposer_match[i],b.proposer_ranks[i]);
  std::print("\nResident-proposing: proposals {}; mean resident rank {:.2f}; resident first choices {}; mean hospital rank {:.2f}; stable {}.\n",residents.result.proposals,a.proposer_mean,a.proposer_first_choices,a.reviewer_mean,dm::algorithms::is_stable(residents.result,f.proposer_preferences,f.reviewer_preferences));
  std::print("Hospital-proposing: proposals {}; mean resident rank {:.2f}; resident first choices {}; mean hospital rank {:.2f}; stable {}.\n",hospitals.proposals,b.proposer_mean,b.proposer_first_choices,b.reviewer_mean,dm::algorithms::is_stable(hospitals,f.proposer_preferences,f.reviewer_preferences));
  std::vector<double>x0,x1,y0,y1;
  for(std::size_t i=0;i<a.proposer_ranks.size();++i){x0.push_back(double(i)-.08);x1.push_back(double(i)+.08);y0.push_back(a.proposer_ranks[i]);y1.push_back(b.proposer_ranks[i]);if(a.proposer_ranks[i]>b.proposer_ranks[i])throw std::runtime_error("proposer-optimal direction");}
  auto plot=dm::graphics::RPlot::create();
  plot.points(x0,y0,"Residents",{37,99,235},5).points(x1,y1,"Hospitals",{220,38,38},5)
    .legend({"Residents","Hospitals"},{{37,99,235},{220,38,38}})
    .title("Original generated rows: assigned hospital rank for each resident")
    .xlab("Resident ID; small blue/red offsets distinguish proposing side")
    .ylab("One-based resident rank; lower is preferred").y_limits(.5,6.5).size(1100,540).save_svg("build/gale_original.svg");
  if(!dm::algorithms::is_stable(residents.result,f.proposer_preferences,f.reviewer_preferences)||!dm::algorithms::is_stable(hospitals,f.proposer_preferences,f.reviewer_preferences))throw std::runtime_error("both orientations stable");
}
