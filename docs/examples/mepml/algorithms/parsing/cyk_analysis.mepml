> Inspect every cell of aabb, then recover one complete parse

A four-byte input has ten nonempty contiguous spans. The next program retains
every cell, including empty ones. In particular T(1,2) contains S for ab,
T(1,3) contains C for abb, and T(0,4) contains S for aabb. Its stored root
witness uses S→AC, then the right child uses C→SB. Empty cells for aa, bb and
aab explain why other splits fail. Chart membership is richer than a single
parse; the reconstructed tree follows only the stored first successful choices.

```{cpp, results="markdown", file="figures/cyk_triangle.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
  std::filesystem::create_directories("build");
  dm::algorithms::CNFGrammar g;g.unary['a']={1};g.unary['b']={2};g.binary={{0,1,2},{0,1,3},{3,0,2}};
  const auto a=dm::algorithms::cyk_analyze(g,"aabb");const auto parse=dm::algorithms::cyk_first_parse(a);
  if(!a.accepted || a.cells.size()!=10 || parse.size()!=7 || a.work.binary_rule_tests!=18 || a.work.new_states!=7) return 1;
  const std::vector<std::string> names{"S","A","B","C"};dm::graphics::Diagram d(75,1050);dm::graphics::DiagramNodeStyle box;box.width=2;box.height=1.15;box.font_size=18;
  std::print("| begin | length | substring | deriving ids |\n| ---: | ---: | :--- | :--- |\n");
  for(const auto& cell:a.cells) {
    std::vector<int> ids;std::string symbols;
    for(const auto& e:cell.entries) {ids.push_back(e.nonterminal);if(!symbols.empty()) symbols+=", ";symbols+=names[e.nonterminal];}
    const std::string label=symbols.empty()?"empty":symbols;
    std::print("| {} | {} | {} | {} |\n",cell.begin,cell.length,a.input.substr(cell.begin,cell.length),ids);
    box.fill=cell.entries.empty()?dm::graphics::RGB{241,245,249}:dm::graphics::RGB{219,234,254};if(cell.length==a.input.size()) box.fill={220,252,231};
    d.node(std::format("{},{}",cell.begin,cell.length),{2.8*cell.begin+1.4*(cell.length-1),2.2*(cell.length-1)},std::format("[{},{}): {}",cell.begin,cell.begin+cell.length,label),box);
  }
  for(std::size_t i=0;i<a.input.size();++i) d.text({2.8*i,-1.4},std::format("byte {}: {}",i,a.input[i]),18);
  d.text({4.2,8.5},"Complete CYK triangle for aabb; every cell is retained",22)
   .text({4.2,-2.7},std::format("{} split points; {} empty-child skips; {} rule tests; {} memberships",a.work.split_points,a.work.skipped_empty_splits,a.work.binary_rule_tests,a.work.new_states),19)
   .save_svg("build/cyk_triangle.svg");
  std::print("\n| preorder node | nonterminal | byte span | left child | right child |\n| ---: | :--- | :--- | :--- | :--- |\n");
  for(std::size_t i=0;i<parse.size();++i) {
    const auto& node=parse[i];const bool leaf=node.length==1;
    std::print("| {} | {} | [{},{}) | {} | {} |\n",i,names[node.nonterminal],node.begin,node.begin+node.length,leaf?"leaf":std::to_string(node.left_child),leaf?"leaf":std::to_string(node.right_child));
  }
  std::print("\nAccepted {}; first parse nodes {}; reconstructed without another CYK run.\n",a.accepted,parse.size());
}
