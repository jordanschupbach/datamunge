//? Title: Earley Recognition: Actual Dotted Items, Nullable Closure and Measured Joins
//? Subtitle: Preserve the original grammar examples while making empty rules, provenance and work explicit
//? Exports: both
//? Lang: en-GB

\abstract(
Given a context-free grammar and a word of atomic tokens, we want to decide
whether the start symbol can derive the whole word. Left recursion,
ambiguity and empty productions make a simple recursive search difficult
to terminate correctly. Earley recognition instead closes finite sets of
dotted production items. We begin with one token and four actual items,
retain the original balanced-word and expression examples, and inspect a
nullable completion that a later waiter must reuse. Owned first-insertion
reasons, exact family work counts and checked capture controls make the
recognizer's result reproducible without claiming to enumerate parse trees.
)

\toc

> Four actual items for one token

Use S→A and A→a, with the one-token input [a]. Boundary zero seeds
S→.A, predicts A→.a, then scanning a creates A→a. at boundary one.
Completion combines that finished A with the original waiting S item to
produce S→A. spanning the whole input. The printed table and native
diagram come from those actual inserted items and their first parents.
The dotted text quotes atomic symbol names and prints the origin in parentheses.

```{cpp, results="markdown", file="figures/earley_tiny.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main(){
  std::filesystem::create_directories("build");
  dm::algorithms::ContextFreeGrammar g{{{"S",{"A"}},{"A",{"a"}}},"S"};
  const auto t=dm::algorithms::earley_trace(g,{"a"});
  const std::array<const char*,4> names{"seed","predict","scan","complete"};
  const auto ref=[](dm::algorithms::EarleyLocation r){return r.column==dm::algorithms::earley_no_item?std::string("none"):std::format("({},{})",r.column,r.index);};
  std::print("Tiny word: accepted {}; items {}; completion joins {}; capture entries {}.\n\n",t.accepted,t.work.unique_items,t.work.completion_joins,t.captured_entries);
  std::print("| location | actual item | first cause | first parent | second parent |\n| :--- | :--- | :--- | :--- | :--- |\n");
  std::vector<dm::algorithms::EarleyLocation> order;std::map<std::pair<std::size_t,std::size_t>,std::size_t> position;
  for(std::size_t k=0;k<t.chart.size();++k)for(std::size_t i=0;i<t.chart[k].size();++i){const auto r=t.reasons[k][i];
    std::print("| ({},{}) | {} | {} | {} | {} |\n",k,i,dm::algorithms::earley_item_text(t,{k,i}),names.at(static_cast<std::size_t>(r.action)),ref(r.first),ref(r.second));
    position[{k,i}]=order.size();order.push_back({k,i});
  }
  dm::graphics::Diagram d(64,1100);dm::graphics::DiagramNodeStyle box;box.width=4.2;box.height=1.4;box.font_size=22;
  for(std::size_t i=0;i<order.size();++i){const auto at=order[i];d.node(std::to_string(i),{5.4*i,0},std::format("({},{})\n{}",at.column,at.index,dm::algorithms::earley_item_text(t,at)),box);
    if(i){const auto r=t.reasons[at.column][at.index];const auto parent=r.action==dm::algorithms::EarleyAction::complete?r.second:r.first;
      d.edge(std::to_string(position.at({parent.column,parent.index})),std::to_string(i),names.at(static_cast<std::size_t>(r.action)));}}
  const auto waiter=t.reasons[1][1].first;const double x=5.4*position.at({waiter.column,waiter.index});
  dm::graphics::DiagramStroke waiting;waiting.arrow=true;waiting.dashed=true;
  d.path({{x,.7},{x,2.6},{16.2,2.6},{16.2,.7}},waiting).text({8.1,3.1},"completion also uses waiting parent (0,0)",20)
   .text({8.1,4.3},"One actual prediction, scan and completion",26).save_svg("build/earley_tiny.svg");
}
