> Matching residues do not authenticate a peer

An active intermediary can replace each public message and establish two
separate arithmetic sessions. In this control Alice keeps a=6 and Bob b=15.
The intermediary sends 5^13=21 to Alice and 5^7=17 to Bob, all modulo23.
Alice agrees on 18 with the intermediary; Bob agrees on 15 with the same
intermediary. Both local agreement checks pass, while Alice and Bob have
different values. The arithmetic alone never established whom they reached.

```{cpp, results="markdown", file="figures/dh_unauthenticated.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
  std::filesystem::create_directories("build");
  const auto left=dm::algorithms::dh_exchange(5,6,13,23),right=dm::algorithms::dh_exchange(5,7,15,23);
  if(left.alice_shared!=left.bob_shared || right.alice_shared!=right.bob_shared || left.alice_shared==right.bob_shared)return 1;
  dm::graphics::Diagram d(70,1100);dm::graphics::DiagramNodeStyle box;box.width=3.3;box.height=1.7;box.font_size=22;
  d.node("alice",{0,0},std::format("Alice\nRaw shared = {}",left.alice_shared),box);
  box.fill={254,226,226};d.node("middle",{5.5,0},std::format("Intermediary knows\nleft {}; right {}",left.bob_shared,right.alice_shared),box);
  box.fill={239,246,255};d.node("bob",{11,0},std::format("Bob\nRaw shared = {}",right.bob_shared),box)
   .edge("alice","middle","session1").edge("middle","bob","session2")
   .text({5.5,2.2},"Unauthenticated messages permit two separate agreements",24)
   .text({5.5,-2.2},std::format("Substituted public values: {} to Alice; {} to Bob",left.bob_public,right.alice_public),23)
   .save_svg("build/dh_unauthenticated.svg");
  std::print("| participant/session | published value | received value | raw shared |\n| :--- | ---: | ---: | ---: |\n");
  std::print("| Alice / left | {} | {} | {} |\n| intermediary / left | {} | {} | {} |\n",left.alice_public,left.bob_public,left.alice_shared,left.bob_public,left.alice_public,left.bob_shared);
  std::print("| intermediary / right | {} | {} | {} |\n| Bob / right | {} | {} | {} |\n\n",right.alice_public,right.bob_public,right.alice_shared,right.bob_public,right.alice_public,right.bob_shared);
  std::print("| unvalidated received value | secret6 result | secret15 result |\n| ---: | ---: | ---: |\n");
  for(std::uint64_t peer:{0,1,22})std::print("| {} | {} | {} |\n",peer,dm::algorithms::dh_shared_secret(peer,6,23),dm::algorithms::dh_shared_secret(peer,15,23));
  std::print("\nThe legacy wrappers accept these bases and perform arithmetic; they do not authenticate or validate peers.\n");
}
