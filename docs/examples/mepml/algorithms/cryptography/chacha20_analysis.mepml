> The complete ciphertext vector and actual block use

For RFC 8439 Section 2.4.2 the nonce differs from the preceding block test:
its first four bytes are zero. The same key bytes 00 through 1f and counter
one encrypt the original 114-byte sunscreen message. We compare the full
ciphertext, not just its first sixteen bytes. The second block uses fifty
bytes and discards fourteen unused bytes in this one-shot API.

```{cpp, results="markdown", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
  std::array<std::uint8_t,32> key{};std::iota(key.begin(),key.end(),std::uint8_t{0});
  const std::array<std::uint8_t,12> nonce{0,0,0,0,0,0,0,0x4a,0,0,0,0};
  const std::string plain="Ladies and Gentlemen of the class of '99: If I could offer you only "
      "one tip for the future, sunscreen would be it.";
  const auto trace=dm::algorithms::chacha20_encrypt_trace(key,1,nonce,plain);
  const auto hex=dm::algorithms::to_hex(std::string_view(trace.output));
  const std::string expected="6e2e359a2568f98041ba0728dd0d6981e97e7aec1d4360c20a27afccfd9fae0b"
      "f91b65c5524733ab8f593dabcd62b3571639d624e65152ab8f530c359f0861d8"
      "07ca0dbf500d6a6156a38e088a22b65e52bc514d16ccf806818ce91ab7793736"
      "5af90bbf74a35be6b40b8eedf2785e42874d";
  const auto decrypted=dm::algorithms::chacha20_encrypt(key,1,nonce,trace.output);
  if(hex!=expected || decrypted!=plain || plain.size()!=114) return 1;
  std::print("| actual counter | input offset | bytes XORed | unused block bytes |\n| ---: | ---: | ---: | ---: |\n");
  for(const auto& block:trace.blocks) std::print("| {} | {} | {} | {} |\n",block.counter,block.offset,block.bytes,64-block.bytes);
  std::print("\nComplete 114-byte RFC ciphertext matches: {}. Decryption round-trips: {}.\n",hex==expected,decrypted==plain);
  for(std::size_t offset=0;offset<hex.size();offset+=32) std::print("{}\n",hex.substr(offset,32));
}
```
