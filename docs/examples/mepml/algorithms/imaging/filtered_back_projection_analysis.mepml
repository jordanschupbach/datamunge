> The original 96 × 96 disk,120 views and144 detectors

The disk has radius 22 pixel units and value one. disk_phantom and
parallel_projection_angles replace the report-local setup loops. The
original forward and filtered-backprojection signatures remain available.
This program exposes the same actual pipeline as forward splat, native
finite filter and paired gather, then verifies equality with the wrapper.
The original central row profile is retained alongside truth, sinogram and
reconstruction images.

Pearson correlation uses the existing native OnlineCovariance accumulator.
RMSE and maximum absolute error are ordinary reductions of actual pixel
residuals. Correlation measures shape agreement under centering/scaling;
it does not certify gain, offset or pointwise accuracy. The original
rounded correlation 0.9941 and center 0.9860 remain, while additional error
metrics make their limits visible. The truth and reconstruction images
use equal row/column scales and share a displayed [0,1.1] color scale; negative values are still present in
the numeric metrics and profile even when clipped by that display scale.

The image palette uses column and row indices as coordinates. Plot grids
are arranged z[column][row] for RPlot::image; that presentation transpose
does not change the native row-major image. The sinogram's axes are centered
detector coordinate and actual angle in degrees.

```{cpp, results="markdown", file="figures/fbp_original.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <datamunge/algorithms/filtered_back_projection.hpp>
#include <datamunge/algorithms/online_statistics.hpp>
#include <datamunge/plot/diagram.hpp>
#include <algorithm>
#include <climits>
#include <cmath>
#include <filesystem>
#include <format>
#include <limits>
#include <numbers>
#include <numeric>
#include <print>
#include <stdexcept>
#include <string>
#include <vector>
namespace dm=datamunge;
int main(){
  std::filesystem::create_directories("build");
  constexpr int N=96,D=144;const auto image=dm::algorithms::disk_phantom(N,22),angles=dm::algorithms::parallel_projection_angles(120);const auto sino=dm::algorithms::radon_transform(image,N,angles,D),filtered=dm::algorithms::ram_lak_filter(sino);const auto rec=dm::algorithms::back_projection(filtered,N,angles,D);const bool same=rec==dm::algorithms::filtered_back_projection(sino,N,angles,D);dm::algorithms::OnlineCovariance covariance;double squared=0,maximum=0;for(std::size_t i=0;i<image.size();++i){covariance.add(image[i],rec[i]);const double error=rec[i]-image[i];squared+=error*error;maximum=std::max(maximum,std::abs(error));}std::print("Original phantom {}x{}; views {}; detectors {}; correlation {:.4f}; center truth {:.1f}; center reconstruction {:.4f}.\n",N,N,angles.size(),D,covariance.correlation(),image[(N/2)*N+N/2],rec[(N/2)*N+N/2]);std::print("Actual residuals: RMSE {:.9f}; maximum absolute {:.9f}; explicit pipeline equals legacy-signature wrapper {}.\n",std::sqrt(squared/image.size()),maximum,same);
  std::vector<double>xy(N),detectors(D),degrees(angles.size()),truth_profile,rec_profile;std::iota(xy.begin(),xy.end(),0);for(int d=0;d<D;++d)detectors[d]=d-(D-1)/2.;for(std::size_t v=0;v<angles.size();++v)degrees[v]=angles[v]*180/std::numbers::pi;std::vector<std::vector<double>>truth_grid(N,std::vector<double>(N)),rec_grid=truth_grid,sino_grid(D,std::vector<double>(angles.size()));for(int r=0;r<N;++r)for(int c=0;c<N;++c){truth_grid[c][r]=image[r*N+c];rec_grid[c][r]=rec[r*N+c];}double sino_max=0;for(std::size_t v=0;v<sino.size();++v)for(int d=0;d<D;++d){sino_grid[d][v]=sino[v][d];sino_max=std::max(sino_max,sino[v][d]);}for(int c=0;c<N;++c){truth_profile.push_back(image[(N/2)*N+c]);rec_profile.push_back(rec[(N/2)*N+c]);}std::print("Sinogram display range [0,{:.6f}]; shared truth/reconstruction display range [0,1.1].\n",sino_max);
  const auto palette=dm::graphics::viridis_colors(64);auto truth=dm::graphics::RPlot::create(),reconstruction=dm::graphics::RPlot::create(),views=dm::graphics::RPlot::create(),profile=dm::graphics::RPlot::create();truth.image(xy,xy,truth_grid,palette,0,1.1).title("Truth, shared scale [0,1.1]").x_label("Column").y_label("Row").size(590,460).margins(125,125,45,75).x_limits(-.5,N-.5).y_limits(-.5,N-.5);reconstruction.image(xy,xy,rec_grid,palette,0,1.1).title("FBP, shared scale [0,1.1]").x_label("Column").y_label("Row").size(590,460).margins(125,125,45,75).x_limits(-.5,N-.5).y_limits(-.5,N-.5);views.image(detectors,degrees,sino_grid,palette,0,sino_max).title("Actual sinogram").x_label("Centered detector coordinate").y_label("Angle in degrees") .size(590,460);profile.line(xy,truth_profile,"Truth",{30,30,30},2.5).line(xy,rec_profile,"FBP",{37,99,235},1.8).title("Original central row profile").x_label("Column").y_label("Pixel value") .size(590,460);dm::graphics::RLayout::create(2,2) .size(1180,970).title("Original 96 × 96 disk; 120 views; 144 detectors").add(truth).add(views).add(reconstruction).add(profile).save_svg("build/fbp_original.svg");if(!same||covariance.correlation()<.99)throw std::runtime_error("original reconstruction check failed");
}
