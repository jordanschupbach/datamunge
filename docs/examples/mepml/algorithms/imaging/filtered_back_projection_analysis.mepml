  std::vector<double>impulse(9);impulse[4]=1;const auto response=dm::algorithms::ram_lak_filter({impulse}),constant=dm::algorithms::ram_lak_filter({std::vector<double>(9,1)});std::vector<double>lag,x;std::print("| actual lag from impulse | filtered impulse | filtered finite constant |\n| ---: | ---: | ---: |\n");for(int d=0;d<9;++d){lag.push_back(d-4);x.push_back(d);std::print("| {} | {:.12f} | {:.12f} |\n",d-4,response[0][d],constant[0][d]);}std::print("\nFinite constant: edge {:.12f}; center {:.12f}; center is nonzero {}.\n",constant[0].front(),constant[0][4],constant[0][4]!=0);
