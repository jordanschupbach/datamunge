> Sampling changes measured error; correlation can hide gain error

The next controlled experiment uses the64 × 64, radius 14 disk from the
native test. First vary only the number of uniform half-turn views while
keeping96 detectors. Then keep120 views and vary the detector range. Finite
detector support can truncate projection mass; it also limits the filtered
projection coordinates available during gather. Capturing all nonzero
forward mass is therefore not by itself a certificate of identical full
reconstructions. Every displayed reconstruction calls the native FBP API.

These errors describe a particular synthetic image, unit detector spacing,
finite interpolation/filter and angular rectangle rule. They are neither
an exact inverse theorem nor a generic monotone error bound. The fixed
pi/M gather weight assumes the ordinary full-half-turn uniform grid.
Arbitrary finite caller angles are accepted by the API but receive those
same weights; no adaptive quadrature is inferred.

Finally compare r with2r+0.3 on the original 96 × 96 problem. Positive
affine transformation leaves Pearson correlation unchanged while RMSE
changes substantially. This is an executed control for interpreting the
original correlation claim.

```{cpp, results="markdown", file="figures/fbp_sampling.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <datamunge/algorithms/filtered_back_projection.hpp>
#include <datamunge/algorithms/online_statistics.hpp>
#include <datamunge/plot/diagram.hpp>
#include <algorithm>
#include <climits>
#include <cmath>
#include <filesystem>
#include <format>
#include <limits>
#include <numbers>
#include <numeric>
#include <print>
#include <stdexcept>
#include <string>
#include <vector>
namespace dm=datamunge;
int main(){
  std::filesystem::create_directories("build");
  constexpr int N=64;const auto image=dm::algorithms::disk_phantom(N,14);const double mass=std::accumulate(image.begin(),image.end(),0.);std::vector<double>views_x,views_error,detector_x,detector_error;std::print("| views M, D=96 | actual correlation | actual RMSE | maximum pixel error |\n| ---: | ---: | ---: | ---: |\n");for(std::size_t M:{1,3,6,12,30,60,120}){const auto angles=dm::algorithms::parallel_projection_angles(M);const auto sino=dm::algorithms::radon_transform(image,N,angles,96);const auto r=dm::algorithms::filtered_back_projection(sino,N,angles,96);dm::algorithms::OnlineCovariance cov;double sum=0,maximum=0;for(std::size_t i=0;i<r.size();++i){cov.add(image[i],r[i]);const double e=r[i]-image[i];sum+=e*e;maximum=std::max(maximum,std::abs(e));}const double rmse=std::sqrt(sum/r.size());std::print("| {} | {:.9f} | {:.9f} | {:.9f} |\n",M,cov.correlation(),rmse,maximum);views_x.push_back(M);views_error.push_back(rmse);}
  std::print("\n| detectors D, M=120 | mean retained projection mass / truth mass | actual correlation | actual RMSE |\n| ---: | ---: | ---: | ---: |\n");for(int D:{16,32,64,96}){const auto angles=dm::algorithms::parallel_projection_angles(120);const auto s=dm::algorithms::radon_transform(image,N,angles,D);const auto r=dm::algorithms::filtered_back_projection(s,N,angles,D);dm::algorithms::OnlineCovariance cov;double total=0,squared=0;for(const auto&row:s)total+=std::accumulate(row.begin(),row.end(),0.);for(std::size_t i=0;i<r.size();++i){cov.add(image[i],r[i]);const double e=r[i]-image[i];squared+=e*e;}const double rmse=std::sqrt(squared/r.size());std::print("| {} | {:.9f} | {:.9f} | {:.9f} |\n",D,total/(angles.size()*mass),cov.correlation(),rmse);detector_x.push_back(D);detector_error.push_back(rmse);}
  const auto truth=dm::algorithms::disk_phantom(96,22),angles=dm::algorithms::parallel_projection_angles(120);const auto r=dm::algorithms::filtered_back_projection(dm::algorithms::radon_transform(truth,96,angles,144),96,angles,144);dm::algorithms::OnlineCovariance raw,affine;double raw2=0,affine2=0;for(std::size_t i=0;i<r.size();++i){const double changed=2*r[i]+.3;raw.add(truth[i],r[i]);affine.add(truth[i],changed);raw2+=(r[i]-truth[i])*(r[i]-truth[i]);affine2+=(changed-truth[i])*(changed-truth[i]);}std::print("\nGain/offset control: raw correlation {:.9f}; transformed correlation {:.9f}; raw RMSE {:.9f}; transformed RMSE {:.9f}.\n",raw.correlation(),affine.correlation(),std::sqrt(raw2/r.size()),std::sqrt(affine2/r.size()));
  auto a=dm::graphics::RPlot::create(),b=dm::graphics::RPlot::create();a.line(views_x,views_error,"Measured RMSE",{37,99,235},2).points(views_x,views_error,"",{37,99,235},5).title("Views vary; D=96").x_label("Uniform half-turn views M").y_label("Actual pixel RMSE").size(550,430);b.line(detector_x,detector_error,"Measured RMSE",{220,38,38},2).points(detector_x,detector_error,"",{220,38,38},5).title("Detector range varies; M=120").x_label("Unit-spaced detector bins D").y_label("Actual pixel RMSE").size(550,430);dm::graphics::RLayout::create(1,2).size(1100,460).add(a).add(b).save_svg("build/fbp_sampling.svg");if(std::abs(raw.correlation()-affine.correlation())>1e-12||affine2<=raw2)throw std::runtime_error("correlation scale control failed");
}
