  std::filesystem::create_directories("build");
  std::vector<double>image(9);image[5]=1;const auto angles=dm::algorithms::parallel_projection_angles(4);const auto sino=dm::algorithms::radon_transform(image,3,angles,3);std::print("| actual angle degrees | detector 0 | detector 1 | detector 2 | row sum |\n| ---: | ---: | ---: | ---: | ---: |\n");double lhs=0;for(std::size_t v=0;v<sino.size();++v){const auto&row=sino[v];std::print("| {:.1f} | {:.9f} | {:.9f} | {:.9f} | {:.9f} |\n",angles[v]*180/std::numbers::pi,row[0],row[1],row[2],std::accumulate(row.begin(),row.end(),0.));lhs+=std::inner_product(row.begin(),row.end(),row.begin(),0.);}const auto back=dm::algorithms::back_projection(sino,3,angles,3);const double rhs=(angles.size()/std::numbers::pi)*std::inner_product(image.begin(),image.end(),back.begin(),0.);std::print("\nScaled-adjoint check: dot(Ax,Ax) {:.12f}; (M/pi)*dot(x,B(Ax)) {:.12f}; absolute gap {:.3e}.\n",lhs,rhs,std::abs(lhs-rhs));
  dm::graphics::Diagram g(58,1100);dm::graphics::DiagramNodeStyle box;box.width=1.35;box.height=1.2;box.font_size=22;for(int r=0;r<3;++r)for(int c=0;c<3;++c){box.fill=image[r*3+c]?dm::graphics::RGB{187,247,208}:dm::graphics::RGB{226,232,240};g.node(std::format("p{}{}",r,c),{1.8*c,-1.8*r},std::format("{}\n({}, {})",int(image[r*3+c]),r,c),box);}box.width=3.4;box.height=1.6;box.fill={219,234,254};g.node("d1",{9,.1},std::format("Detector 1\n{:.6f}",sino[1][1]),box).node("d2",{9,-3.3},std::format("Detector 2\n{:.6f}",sino[1][2]),box).edge("p12","d1","1 - fraction").edge("p12","d2","fraction").text({4.9,2.6},"Actual unit-pixel splat at angle pi/4",27).text({4.9,-6},"Two native deposits sum to one; gather uses the same weights",24).save_svg("build/fbp_tiny.svg");if(std::abs(lhs-rhs)>1e-12||std::abs(sino[1][1]+sino[1][2]-1)>1e-15)throw std::runtime_error("tiny geometry check failed");
