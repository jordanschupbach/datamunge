  std::filesystem::create_directories("build");
  std::print("| original n | actual factor | cofactor | actual tests | increments |\n| ---: | ---: | ---: | ---: | ---: |\n");for(std::uint64_t n:{5959ULL,100000007ULL*100000037ULL}){const auto o=dm::algorithms::fermat_factor_work(n);std::print("| {} | {} | {} | {} | {} |\n",n,o.returned_factor,o.cofactor,o.trials,o.increments);if(!o.proper_split||static_cast<unsigned __int128>(o.returned_factor)*o.cofactor!=n)throw std::runtime_error("original split failed");}
  const std::uint64_t p=10007;bool primes=dm::algorithms::trial_division_factorize(p)==std::vector<std::uint64_t>{p};std::vector<double>gaps,tests,increments,surplus;std::print("\n| p | q | gap | n | actual increments D | actual tests T | integer formula D | continuous excess |\n| ---: | ---: | ---: | ---: | ---: | ---: | ---: | ---: |\n");
  for(std::uint64_t q:{10009,10037,10091,10259,10501,11003,12007}){primes=primes&&(dm::algorithms::trial_division_factorize(q)==std::vector<std::uint64_t>{q});const auto n=p*q;const auto o=dm::algorithms::fermat_factor_work(n);const auto a=(o.returned_factor+o.cofactor)/2;const auto predicted=a-(dm::algorithms::integer_sqrt_u64(n-1)+1);const double gap=q-p,den=std::sqrt(double(q))+std::sqrt(double(p)),continuous=gap*gap/(2*den*den);std::print("| {} | {} | {} | {} | {} | {} | {} | {:.6f} |\n",p,q,q-p,n,o.increments,o.trials,predicted,continuous);gaps.push_back(gap);tests.push_back(o.trials);increments.push_back(o.increments);surplus.push_back(continuous);if(o.returned_factor!=p||o.cofactor!=q||predicted!=o.increments)throw std::runtime_error("original gap check failed");}
  std::print("\nOriginal small prime fixtures verified: {}.\n",primes);if(!primes)throw std::runtime_error("prime fixtures failed");auto plot=dm::graphics::RPlot::create();plot.line(gaps,tests,"Actual tests",{37,99,235},2).points(gaps,tests,"",{37,99,235},5).line(gaps,increments,"Increments",{220,38,38},2).points(gaps,increments,"",{220,38,38},5).line(gaps,surplus,"Continuous excess",{22,163,74},2).title("Original gap cases: tests include the successful trial").x_label("Factor gap q - p").y_label("Count or continuous excess").size(1100,580).save_svg("build/fermat_gaps.svg");
}
