  const auto hard=dm::algorithms::fermat_factor_work(3000000021ULL);std::print("\nCapped composite: divisible by 3 {}; legacy return {}; outcome {}.\n",3000000021ULL%3==0,dm::algorithms::fermat_factor(3000000021ULL),dm::algorithms::fermat_stop_name(hard.stop));
