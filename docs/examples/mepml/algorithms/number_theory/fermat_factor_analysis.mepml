int main(){
  std::filesystem::create_directories("build");
  const auto t=dm::algorithms::fermat_factor_trace(5959,3,3);const auto& o=t.outcome;
  std::print("| actual test | a | a squared minus n | floor root b | square hit |\n| ---: | ---: | ---: | ---: | :--- |\n");for(std::size_t i=0;i<t.rows.size();++i){const auto& r=t.rows[i];std::print("| {} | {} | {} | {} | {} |\n",i+1,r.a,dm::algorithms::uint128_text(r.difference),r.b,r.square);}
  std::print("\nTiny split: {} = {} x {}; actual tests {}; increments {}; stop {}.\n",o.n,o.returned_factor,o.cofactor,o.trials,o.increments,dm::algorithms::fermat_stop_name(o.stop));
  const auto product=static_cast<unsigned __int128>(o.returned_factor)*o.cofactor;std::print("Exact factor-product certificate: {}.\n",product==o.n);
  const double scale=.06,a=o.last_a*scale,b=o.last_b*scale;dm::graphics::Diagram g(62,1100);dm::graphics::DiagramStroke stroke;stroke.width=2;
  g.polygon({{0,0},{a,0},{a,a-b},{a-b,a-b},{a-b,a},{0,a}},{191,219,254},stroke).polygon({{a-b,a-b},{a,a-b},{a,a},{a-b,a}},{254,226,226},stroke);
  const double x=8.4,y=.6,w=o.cofactor*scale,h=o.returned_factor*scale;g.polygon({{x,y},{x+w,y},{x+w,y+h},{x,y+h}},{187,247,208},stroke);
  g.text({a/2,a+1},std::format("{}² minus {}²",o.last_a,o.last_b),26).text({a-b/2,a-b/2},std::format("{}²",o.last_b),20).text({a/2,-.8},"Remaining area = 5959",23);
  g.text({x+w/2,y+h+1},std::format("{} × {}",o.returned_factor,o.cofactor),26).text({x+w/2,-.8},"Equal-area factor rectangle",23);
  dm::graphics::DiagramNodeStyle box;box.width=3.7;box.height=1.5;box.font_size=22;
  for(std::size_t i=0;i<t.rows.size();++i){const auto& r=t.rows[i];box.fill=r.square?dm::graphics::RGB{187,247,208}:dm::graphics::RGB{226,232,240};const auto id=std::to_string(i);g.node(id,{2+5.1*i,-3.6},std::format("a={}  b={}\nd={}{}",r.a,r.b,dm::algorithms::uint128_text(r.difference),r.square?"  hit":""),box);if(i)g.edge(std::to_string(i-1),id,"increment");}
  g.text({7.1,-5.6},std::format("{} actual tests, {} increments",o.trials,o.increments),25).save_svg("build/fermat_tiny.svg");if(!o.proper_split||product!=o.n||o.trials!=3)throw std::runtime_error("tiny certificate failed");
}
