  const auto floating=static_cast<std::uint64_t>(std::ceil(std::sqrt(static_cast<double>(near))));const auto exact=dm::algorithms::integer_sqrt_u64(near-1)+1;std::print("\nNear-square start: diagnostic double ceiling {}; exact ceiling {}; floating candidate squared below n {}.\n",floating,exact,static_cast<unsigned __int128>(floating)*floating<near);
