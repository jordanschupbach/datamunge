> Inspect actual seeded rounds and early termination

The ordinary bool API, work API and trace API share one kernel. The
positive-round base stream is unchanged: each actual round draws a base,
computes gcd and the exact canonical modular power, and stops on failure.
Adding the gcd makes the diagnostic factor visible without replacing the
congruence with a different primality test. Small/even filters draw no bases.
Zero and one are not prime, but are not composite either.

The next program retains the original default decisions for 97,91,561
and prints every actual default-561 row. It also finds the first seed in
0..63 for which one round passes 561 and then examines that same seed's
20-round run. Passing one round remains inconclusive. Records are the
actual executed prefix, including a failing final row when one occurs.
The diagram uses at most the first four captured rows, explicitly labelled.

```{cpp, results="markdown", file="figures/fermat_primality_rounds.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <datamunge/algorithms/primality.hpp>
#include <datamunge/algorithms/modular_exponentiation.hpp>
#include <datamunge/algorithms/number_theory_extra.hpp>
#include <datamunge/algorithms/miller_rabin.hpp>
#include <datamunge/plot/diagram.hpp>
#include <algorithm>
#include <cmath>
#include <cstdint>
#include <filesystem>
#include <format>
#include <limits>
#include <print>
#include <stdexcept>
#include <string>
#include <vector>
namespace dm=datamunge;
int main(){
  std::filesystem::create_directories("build");
  constexpr auto default_seed=0x9E3779B97F4A7C15ULL;const auto original=dm::algorithms::fermat_probable_prime_trace(561);std::print("| default-561 actual round | base | gcd | residue | passes |\n| ---: | ---: | ---: | ---: | :--- |\n");for(std::size_t i=0;i<original.rows.size();++i){const auto&r=original.rows[i];std::print("| {} | {} | {} | {} | {} |\n",i+1,r.base,r.common_divisor,r.residue,r.passes);}
  std::uint64_t selected=0;while(selected<64&&!dm::algorithms::fermat_probable_prime(561,1,selected))++selected;if(selected==64)throw std::runtime_error("no one-round pass seed found");const auto short_run=dm::algorithms::fermat_probable_prime_work(561,1,selected);const auto t=dm::algorithms::fermat_probable_prime_trace(561,20,selected);std::print("\nSelected seed {}: one-round result {}; twenty-round result {}; actual rounds {}; stop {}.\n",selected,short_run.probable_prime,t.outcome.probable_prime,t.outcome.completed_rounds,dm::algorithms::fermat_primality_stop_name(t.outcome.stop));
  std::print("| filter input | actual rounds | result | stop |\n| ---: | ---: | :--- | :--- |\n");for(std::uint64_t n:{0,1,2,3,4,6}){const auto o=dm::algorithms::fermat_probable_prime_work(n);std::print("| {} | {} | {} | {} |\n",n,o.completed_rounds,o.probable_prime,dm::algorithms::fermat_primality_stop_name(o.stop));}
  const auto wide=dm::algorithms::fermat_base_test(UINT64_MAX,UINT64_MAX-1);std::print("\nFull-width explicit base: n {}; base {}; gcd {}; residue {}; passes {}.\n",wide.n,wide.base,wide.common_divisor,wide.residue,wide.passes);
  dm::graphics::Diagram g(55,1100);dm::graphics::DiagramNodeStyle box;box.width=3.9;box.height=1.7;box.font_size=23;const auto shown=std::min<std::size_t>(4,t.rows.size());for(std::size_t i=0;i<shown;++i){const auto&r=t.rows[i];const double x=5.4*i;box.fill=r.passes?dm::graphics::RGB{254,243,199}:dm::graphics::RGB{254,226,226};const auto id=std::to_string(i);g.node(id,{x,0},std::format("Round {}: a={}\ngcd={}  r={}",i+1,r.base,r.common_divisor,r.residue),box);if(i)g.edge(std::to_string(i-1),id,"next draw");}const double center=2.7*(shown-1);g.text({center,2.5},std::format("Actual seed {}: first {} of {} executed rounds",selected,shown,t.rows.size()),25).text({center,-2.5},std::format("One-round pass: {}; full outcome: {}",short_run.probable_prime,dm::algorithms::fermat_primality_stop_name(t.outcome.stop)),24).save_svg("build/fermat_primality_rounds.svg");if(original.outcome.probable_prime||original.outcome.seed!=default_seed||!short_run.probable_prime)throw std::runtime_error("seeded controls failed");
}
