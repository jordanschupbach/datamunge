  std::filesystem::create_directories("build");
  std::print("| n | base a | actual gcd | a^(n-1) mod n | passes | conclusion |\n| ---: | ---: | ---: | ---: | :--- | :--- |\n");dm::graphics::Diagram g(56,1100);dm::graphics::DiagramNodeStyle box;box.width=3.8;box.height=1.6;box.font_size=24;int i=0;
  for(std::uint64_t a:{2,4,10,11}){const auto r=dm::algorithms::fermat_base_test(15,a);std::print("| {} | {} | {} | {} | {} | {} |\n",r.n,r.base,r.common_divisor,r.residue,r.passes,r.passes?"inconclusive":"composite witness");const double y=-2.8*i++;box.fill={219,234,254};const auto id=std::to_string(a);g.node(id+"a",{0,y},std::format("n={}  a={}\ngcd={}",r.n,r.base,r.common_divisor),box);box.fill=r.passes?dm::graphics::RGB{254,243,199}:dm::graphics::RGB{254,226,226};g.node(id+"b",{6,y},std::format("residue={}\n{}",r.residue,r.passes?"passes":"fails"),box).edge(id+"a",id+"b","exact power");g.text({11.7,y},r.passes?"No primality proof":r.common_divisor>1?"Factor five found":"Composite; gcd is one",22);}
  const auto c=dm::algorithms::fermat_base_census(15,1,15);std::print("\nFull 15 census: bases {}; coprime {}; passes {}; failing bases {}.\n",c.total,c.coprime,c.passes,c.total-c.passes);g.text({5.8,2.3},"One failed congruence is an exact compositeness certificate",25).save_svg("build/fermat_primality_tiny.svg");if(c.total!=14||c.coprime!=8||c.passes!=4)throw std::runtime_error("tiny census failed");
}
