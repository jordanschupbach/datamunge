\image(figures/doomsday_cycle.svg)
// result_end
\caption(A complete 146,097-date check has zero mismatches. Annual Doomsday frequencies are not uniform, and entering a leap century advances the anchor by two rather than one.)
\alttext(Two bar panels show seven annual-anchor counts over 400 years and one/two-day advances entering 1900,2000,2100 and 2400.)

> Annotate a real monthly dataset without inventing daily observations

The built-in AirPassengers dataset holds 144 monthly international
airline totals from 1949 through 1960, in thousands of passengers.
Calendar month lengths and starting weekdays are useful annotations
for these dated rows. They do not reveal which weekdays passengers
actually flew, or establish a causal weekday effect from monthly totals.

Reuse the existing Gregorian monthly-feature API for validated month
lengths and Zeller weekday codes. Add the Doomsday name computed from
each row's actual year/month, and check agreement for all 144 records.
The first twelve rows below retain the original passenger totals; the
calendar matrix names every month-start weekday for all twelve years.

```{cpp, results="markdown", file="figures/doomsday_airline.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
  std::filesystem::create_directories("build");
  auto calendar=dm::algorithms::gregorian_month_features(dm::datasets::air_passengers());
  std::vector<std::string> starts;
  std::vector<std::vector<double>> z(12,std::vector<double>(12));
  int agree=0;
  for(std::size_t i=0;i<calendar.nrows();++i) {
    const int y=static_cast<int>(calendar.double_at("year",i));
    const int m=static_cast<int>(calendar.double_at("month",i));
    const int w=dm::algorithms::doomsday_weekday(y,m,1);
    agree+=w==(static_cast<int>(calendar.double_at("start_weekday_code",i))+6)%7;
    starts.push_back(dm::algorithms::doomsday_day_name(w));
    z[m-1][1960-y]=w;
  }
  calendar.add_column("doomsday_start",starts);
  std::print("AirPassengers: {} monthly records; Doomsday/Zeller agreement {}/{}.\n\n",calendar.nrows(),agree,calendar.nrows());
  if(agree!=144) throw std::runtime_error("dataset calendar mismatch");
  std::print("{}\n",calendar.select({"year","month","passengers","calendar_days","doomsday_start"}).head(12).to_md());
  const std::vector<dm::graphics::RGBA> colors{{254,202,202},{254,215,170},{254,240,138},{187,247,208},{186,230,253},{221,214,254},{226,232,240}};
  std::vector<double> months,years;
  std::vector<std::string> year_names;
  for(int m=1;m<=12;++m) months.push_back(m);
  for(int y=1960;y>=1949;--y) {years.push_back(-y);year_names.push_back(std::to_string(y));}
  auto p=dm::graphics::RPlot::create();
  p.image(months,years,z,colors,0,6);
  for(int m=1;m<=12;++m) for(int y=1949;y<=1960;++y)
    p.text(m,-y,dm::algorithms::doomsday_day_name(static_cast<int>(z[m-1][1960-y])).substr(0,3),{17,24,39},14);
  p.x_ticks(months,{"Jan","Feb","Mar","Apr","May","Jun","Jul","Aug","Sep","Oct","Nov","Dec"})
   .y_ticks(years,year_names).title("AirPassengers dates: weekday of the first day in each month")
   .x_label("month of the observed total").y_label("year").size(1100,650)
   .save_svg("build/doomsday_airline.svg");
}
```
