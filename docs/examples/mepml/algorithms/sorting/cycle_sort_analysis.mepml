> Retain the original example and sweep, measuring the executing core

The original input (5,3,8,1,9,2,7) has no matching target positions, so it
needs seven value-cell writes. The actual cycles have starts 0, 1 and 4,
and lengths 2, 3 and 2. Its original count of 39 comparisons counted only
strict less-than rank tests, excluding duplicate equality tests; the new
work API exposes those separately. The original seed-three experiment below
still generates every size from 5 to 200 in steps of 5, consuming the same
std::mt19937 outputs modulo 100000. This engine sequence and reduction are
explicit; no platform-specific shuffle or real data preparation is involved.

```{cpp, results="markdown", file="figures/cycle_sort.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <random>
int main() {
  std::filesystem::create_directories("build");
  const auto first=dm::algorithms::cycle_sort_trace({5,3,8,1,9,2,7});
  std::print("Original sorted values {}; writes {}; rank comparisons {}; equality comparisons {}; cycles {}.\n\n",first.work.output,first.work.array_writes,first.work.rank_comparisons,first.work.equality_comparisons,first.work.cycle_count);
  std::print("| size | value-cell writes | independent minimum | rank comparisons | equality comparisons | cycles |\n| ---: | ---: | ---: | ---: | ---: | ---: |\n");
  std::mt19937 rng(3);std::vector<double> sizes,writes,ranks,equalities,minima;dm::algorithms::CycleSortWork last;
  for(int n=5;n<=200;n+=5) {
    std::vector<int> a(n);for(int& v:a) v=static_cast<int>(rng()%100000);
    const auto w=dm::algorithms::cycle_sort_work(a);const auto minimum=dm::algorithms::cycle_sort_write_lower_bound(a);
    if(w.array_writes!=minimum || w.array_writes>static_cast<std::size_t>(n)) return 1;
    std::print("| {} | {} | {} | {} | {} | {} |\n",n,w.array_writes,minimum,w.rank_comparisons,w.equality_comparisons,w.cycle_count);
    sizes.push_back(n);writes.push_back(w.array_writes);minima.push_back(minimum);ranks.push_back(w.rank_comparisons);equalities.push_back(w.equality_comparisons);last=w;
  }
  if(last.array_writes!=199 || last.rank_comparisons!=57301) return 1;
  auto write_plot=dm::graphics::RPlot::create();
  write_plot.line(sizes,writes,"actual writes",{37,99,235},2)
            .points(sizes,minima,"independent minimum",{31,41,55},3)
            .legend({"actual writes","minimum"},{{37,99,235},{31,41,55}})
            .title("Value-cell writes attain the lower bound").x_label("size n").y_label("writes")
            .x_limits(0,210).y_limits(0,250).size(550,490);
  auto rank_plot=dm::graphics::RPlot::create();
  rank_plot.line(sizes,ranks,"rank less-than tests",{220,38,38},2)
           .line(sizes,equalities,"equality tests",{234,88,12},2)
           .legend({"rank tests","equality tests"},{{220,38,38},{234,88,12}})
           .title("Repeated scans dominate key tests").x_label("size n").y_label("key tests")
           .x_limits(0,210).y_limits(0,75000).size(550,490);
  dm::graphics::RLayout::create(1,2).add(write_plot).add(rank_plot).size(1150,550)
    .title("Original forty-size experiment: separate scales preserve the write curve")
    .save_svg("build/cycle_sort.svg");
  std::print("\nOriginal endpoint retained: n=200, writes={}, rank comparisons={}.\n",last.array_writes,last.rank_comparisons);
}
