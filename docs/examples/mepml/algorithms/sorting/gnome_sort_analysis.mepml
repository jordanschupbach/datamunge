> Control the inversions and predict the work

The native `adjacent_sort_inputs()` generator returns four owned arrays containing
0 through n−1. Ascending input has I0=0; descending input has I0=n(n−1)/2. One
middle adjacent inversion has I0=1 for n≥2. Moving the minimum to the last slot
has I0=n−1. Consequently their visit counts are n, n², n+2 and 3n−2, respectively,
with the stated empty/singleton exceptions.

The following program checks every predicted count against actual kernel work.
The log2 axes contain only positive n and positive visit counts; no zero is
replaced by an artificial floor. These are selected operation counts, not timings,
FLOPs or the complete cost of copying, identity initialization and allocation.

```{cpp, results="markdown", file="figures/gnome_families.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <datamunge/algorithms/gnome_sort.hpp>
#include <datamunge/plot/diagram.hpp>
#include <algorithm>
#include <filesystem>
#include <print>
#include <stdexcept>
namespace dm=datamunge;
int main(){
 std::filesystem::create_directories("build");

 std::vector<double> x,ascending,descending,adjacent,last;
 std::print("| n | family | known strict inversions | predicted visits | actual visits | key comparisons | boundary visits |\n| ---: | --- | ---: | ---: | ---: | ---: | ---: |\n");
 for(std::size_t n:{1u,2u,4u,8u,16u,32u,64u,128u,256u}){
  const auto f=dm::algorithms::adjacent_sort_inputs(n);
  const std::vector<std::string> names{"Ascending","Descending","Adjacent inversion","Last minimum"};
  const std::vector<const std::vector<int>*> inputs{&f.ascending,&f.descending,&f.adjacent_inversion,&f.last_minimum};
  const std::vector<std::size_t> inv{0,n*(n-1)/2,n>=2?1u:0u,n-1};
  std::vector<double> visits;
  for(std::size_t k=0;k<inputs.size();++k){
   const auto r=dm::algorithms::gnome_sort_run(*inputs[k]);const auto predicted=n+2*inv[k];
   std::print("| {} | {} | {} | {} | {} | {} | {} |\n",n,names[k],inv[k],predicted,r.work.visits,r.work.key_comparisons,r.work.boundary_visits);
   if(r.work.visits!=predicted||r.work.swaps!=inv[k])throw std::runtime_error("inversion prediction");
   visits.push_back(std::log2(double(r.work.visits)));
  }
  x.push_back(std::log2(double(n)));ascending.push_back(visits[0]);descending.push_back(visits[1]);adjacent.push_back(visits[2]);last.push_back(visits[3]);
 }
 auto p=dm::graphics::RPlot::create();
 p.line(x,ascending,"ascending",{5,150,105},2).points(x,ascending,"ascending",{5,150,105},3)
  .line(x,descending,"descending",{220,38,38},2).points(x,descending,"descending",{220,38,38},3)
  .line(x,adjacent,"adjacent",{37,99,235},2).points(x,adjacent,"adjacent",{37,99,235},3)
  .line(x,last,"last minimum",{217,119,6},2).points(x,last,"last minimum",{217,119,6},3)
  .legend({"Ascending","Descending","One adjacent inversion","Last minimum"},{{5,150,105},{220,38,38},{37,99,235},{217,119,6}})
  .title("Actual visits match n + 2 × strict inversions").xlab("log2(values per input)").ylab("log2(actual loop visits)")
  .x_limits(0,8).y_limits(0,18.5).save_svg("build/gnome_families.svg");

}
```
