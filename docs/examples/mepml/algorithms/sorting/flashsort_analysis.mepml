> Equal occupancies, different insertion costs

Construct [0,1,…,q,M] and [0,q,…,1,M], with M=(q+2)(q+1). Both have n=q+2 values and
place their q+1 low values in class zero, with the outlying maximum in another class.
The native carry order produces [1,2,…,q,0,M] for the ascending low values and
[q,q−1,…,0,M] for the descending ones. Their occupancies and squared-occupancy bounds
are identical. The actual insertion shifts are q and q(q+1)/2, respectively.

This family demonstrates the quadratic tail without conflating many duplicate keys
with many inversions. Alongside it, native uniform and clustered workloads compare
actual occupancy concentration at a common size. Their generation and the measured
work are in the core; report loops only call those APIs and display the results.

```{cpp, results="markdown", file="figures/flash_work.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <datamunge/plot/diagram.hpp>
#include <climits>
#include <limits>
#include <numeric>
#include <print>
namespace dm=datamunge;
int main(){
  std::filesystem::create_directories("build");
std::print("| q | n | shared occupancy-square sum | easy shifts | hard shifts | hard comparisons |\n| ---: | ---: | ---: | ---: | ---: | ---: |\n");
  std::vector<double>ln,le,lh;
  for(std::size_t q:{8,16,32,64,128,256}){
    const auto easy=dm::algorithms::flashsort_trace(dm::algorithms::bucket_sort_collision_input(q,false));const auto hard=dm::algorithms::flashsort_trace(dm::algorithms::bucket_sort_collision_input(q,true));
    std::print("| {} | {} | {} | {} | {} | {} |\n",q,hard.work.n,hard.work.occupancy_square_sum,easy.work.insertion_shifts,hard.work.insertion_shifts,hard.work.insertion_comparisons);
    ln.push_back(std::log10(hard.work.n));le.push_back(std::log10(easy.work.insertion_shifts));lh.push_back(std::log10(hard.work.insertion_shifts));
    if(easy.class_counts!=hard.class_counts||easy.work.insertion_shifts!=q||hard.work.insertion_shifts!=q*(q+1)/2)throw std::runtime_error("matched occupancy family");
  }
  const auto data=dm::algorithms::bucket_sort_workloads(1000,1);const auto uniform=dm::algorithms::flashsort_trace(data.uniform),clustered=dm::algorithms::flashsort_trace(data.clustered);
  std::print("\n| workload | n | classes | largest class | occupancy-square sum | actual insertion shifts |\n| --- | ---: | ---: | ---: | ---: | ---: |\n");
  std::print("| uniform | {} | {} | {} | {} | {} |\n",uniform.work.n,uniform.work.class_count,uniform.work.max_occupancy,uniform.work.occupancy_square_sum,uniform.work.insertion_shifts);
  std::print("| clustered with two outliers | {} | {} | {} | {} | {} |\n",clustered.work.n,clustered.work.class_count,clustered.work.max_occupancy,clustered.work.occupancy_square_sum,clustered.work.insertion_shifts);
  const auto ug=dm::algorithms::flashsort_class_groups(uniform.class_counts,20),cg=dm::algorithms::flashsort_class_groups(clustered.class_counts,20);std::vector<double>x,u,c;for(std::size_t i=0;i<ug.size();++i){x.push_back(i);u.push_back(ug[i].count);c.push_back(cg[i].count);}
  auto costs=dm::graphics::RPlot::create();costs.line(ln,le,"Easy order",{37,99,235},2).points(ln,le,"",{37,99,235},4).line(ln,lh,"Hard order",{220,38,38},2).points(ln,lh,"",{220,38,38},4).title("Same occupancies, different tail work").x_label("log10 input length").y_label("log10 actual insertion shifts").y_limits(.5,5.5).legend({"Easy order","Hard order"},{{37,99,235},{220,38,38}});
  auto occupancy=dm::graphics::RPlot::create();occupancy.line(x,u,"Uniform",{37,99,235},2).points(x,u,"",{37,99,235},3).line(x,c,"Clustered",{124,58,237},2).points(x,c,"",{124,58,237},3).title("Actual native 1000-value class groups").x_label("Consecutive class group").y_label("Total observations").y_limits(0,1200).legend({"Uniform","Clustered + outliers"},{{37,99,235},{124,58,237}});
  dm::graphics::RLayout::create(1,2).add(costs).add(occupancy).size(1100,540).title("Conditional performance: measure order and occupancy separately").fit_panels().save_svg("build/flash_work.svg");
}
