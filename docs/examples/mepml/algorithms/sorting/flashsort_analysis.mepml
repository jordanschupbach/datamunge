#include <print>
namespace dm=datamunge;
int main(){
  std::filesystem::create_directories("build");
const auto t=dm::algorithms::flashsort_trace(std::vector<int>{4,1,3,0,2});
  std::print("| position | input | input class | after carry phase | final output |\n| ---: | ---: | ---: | ---: | ---: |\n");
  std::vector<double>x,input,grouped,output;
  for(std::size_t i=0;i<t.input.size();++i){std::print("| {} | {} | {} | {} | {} |\n",i,t.input[i],t.class_of_input[i],t.classified[i],t.output[i]);x.push_back(i);input.push_back(t.input[i]);grouped.push_back(t.classified[i]);output.push_back(t.output[i]);}
  std::print("\nNative work: carry writes {}; insertion comparisons {}; insertion shifts {}; final key stores {}.\n",t.work.permutation_writes,t.work.insertion_comparisons,t.work.insertion_shifts,t.work.insertion_placements);
  auto p=dm::graphics::RPlot::create();p.line(x,input,"Original",{148,163,184},1.5).points(x,input,"",{148,163,184},5).line(x,grouped,"After carries",{234,88,12},2).points(x,grouped,"",{234,88,12},5).line(x,output,"Sorted",{37,99,235},2).points(x,output,"",{37,99,235},4).abline_v(3.5,{100,116,139},1.5).title("A class range can still contain inversions").x_label("Array position").y_label("Value").y_limits(-.2,5.7).legend({"Original","After carries","Sorted"},{{148,163,184},{234,88,12},{37,99,235}}).size(900,520).save_svg("build/flash_tail.svg");
  if(t.classified!=std::vector<int>{1,3,0,2,4}||t.work.insertion_shifts!=3)throw std::runtime_error("insertion-tail identity");
}
