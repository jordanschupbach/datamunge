| ---: | ---: | ---: | ---: | ---: | ---: |
| 1 | 96 | 1 | 884736 | 18432 | 18432 |
| 2 | 48 | 8 | 884736 | 18432 | 36864 |
| 3 | 32 | 27 | 884736 | 18432 | 55296 |
| 4 | 24 | 64 | 884736 | 18432 | 73728 |
| 6 | 16 | 216 | 884736 | 18432 | 110592 |
| 8 | 12 | 512 | 884736 | 18432 | 147456 |
| 12 | 8 | 1728 | 884736 | 18432 | 221184 |
| 16 | 6 | 4096 | 884736 | 18432 | 294912 |
| 24 | 4 | 13824 | 884736 | 18432 | 442368 |
