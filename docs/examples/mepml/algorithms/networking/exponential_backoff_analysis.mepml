> Distinct clients need suitable random streams

For one retry index k=5, use a common failure epoch and window W=30.
One thousand deterministic full-window clients all choose delay thirty.
One thousand clients given the same default seed all choose the same
jittered delay. Distinct streams need a suitable seeding mechanism; simply
saying "random" does not create independence.

Here the canonical SplitMix64 seeding engine supplies nonzero client
seeds to the backoff generator. Each point is that client's actual sixth
wait, measured relative to the same hypothetical failure instant. It is
a one-window experiment, rather than a simulation of an entire service.
The histogram uses the plotting API's equal bins over the observed
sample range, not the theoretical fixed [0,30] bins in the probability
calculation above. Mean and sample standard deviation are descriptive
statistics of this reproducible finite fixture.

```{cpp, results="markdown", file="figures/backoff_clients.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main(){
  std::filesystem::create_directories("build");dm::random::SplitMix64 seeds(2015);std::vector<double>client,full,same,distinct;
  for(int i=0;i<1000;++i){client.push_back(i);full.push_back(dm::algorithms::exponential_backoff_delay(5,1,30));same.push_back(dm::algorithms::exponential_backoff_seeded(6,1,30).steps.back().delay);const auto seed=seeds.uniform_u64(1,std::numeric_limits<std::uint64_t>::max());distinct.push_back(dm::algorithms::exponential_backoff_seeded(6,1,30,seed).steps.back().delay);}
  std::print("Clients {}; common window {:.0f}; full-window distinct waits {}; repeated-seed distinct waits {}.\n",client.size(),full[0],std::set<double>(full.begin(),full.end()).size(),std::set<double>(same.begin(),same.end()).size());
  const dm::Vector<> values(distinct);std::print("Distinct seeded fixture: mean {:.6f}; sample SD {:.6f}; minimum {:.6f}; maximum {:.6f}; observed distinct waits {}.\n",dm::mean(values),dm::sd(values),*std::min_element(distinct.begin(),distinct.end()),*std::max_element(distinct.begin(),distinct.end()),std::set<double>(distinct.begin(),distinct.end()).size());
  std::print("Ideal independent uniform reference: mean 15; SD {:.6f}; shared-bin probability for 30 fixed bins {:.6f}; expected colliding pairs {:.0f}.\n",30/std::sqrt(12.),1./30,1000.*999/(2*30));
  auto a=dm::graphics::RPlot::create();a.points(full,client,"full windows",{37,99,235},2).title("No jitter").x_limits(0,31).x_label("One wait from common failure epoch").y_label("Client id");
  auto b=dm::graphics::RPlot::create();b.points(same,client,"same seed",{220,38,38},2).title("Jitter with repeated seed").x_limits(0,31).x_label("One wait from common failure epoch").y_label("Client id");
  auto c=dm::graphics::RPlot::create();c.points(distinct,client,"distinct seeds",{22,163,74},2).title("Distinct SplitMix-derived seeds").x_limits(0,31).x_label("One wait from common failure epoch").y_label("Client id");
  auto d=dm::graphics::RPlot::hist(distinct,30,"",{124,58,237});d.title("Observed-range histogram").x_label("Actual sixth wait").y_label("Clients per observed-range bin");
  dm::graphics::RLayout::create(2,2).add(a).add(b).add(c).add(d).size(1100,950).title("One thousand clients: repeated and distinct seed controls").fit_panels().save_svg("build/backoff_clients.svg");
}
