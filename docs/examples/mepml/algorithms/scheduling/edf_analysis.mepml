> Check exact finite work and history counts

For one task of period five and cost two over H=5k, there are k
releases/completions, 2k busy units, 3k idle units and no preemptions.
The capture contains one task, 5k selections and k job records, hence
6k+1 logical entries. These are exact counts, not measured CPU time.

For N zero-work tasks of period four and H=24, all 6N releases complete
at once, the ready queue stays empty, and all 24 units are idle. This
unit-granularity engine still performs 24N release checks; its captured
history contains N+24+6N=7N+24 entries. It does not skip to the next event.

```{cpp, results="markdown", file="figures/edf_work.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main(){
  std::filesystem::create_directories("build");std::vector<double>x,busy,idle,history,nvalues,checks,zero_history;
  std::print("| periods k | H | jobs | busy | idle | preemptions | capture |\n| ---: | ---: | ---: | ---: | ---: | ---: | ---: |\n");
  for(std::size_t k:{1,2,4,8,16,32,64}){const auto t=dm::algorithms::rt_trace({{7,5,2}},int(5*k));
    if(t.work.jobs_released!=k||t.work.jobs_completed!=k||t.work.busy_ticks!=2*k||t.work.idle_ticks!=3*k||t.work.preemptions||t.work.deadline_misses||t.captured_entries!=6*k+1)throw std::runtime_error("period family failed");
    std::print("| {} | {} | {} | {} | {} | {} | {} |\n",k,t.horizon,t.work.jobs_released,t.work.busy_ticks,t.work.idle_ticks,t.work.preemptions,t.captured_entries);
    x.push_back(k);busy.push_back(t.work.busy_ticks);idle.push_back(t.work.idle_ticks);history.push_back(t.captured_entries);}
  std::print("\n| zero-work tasks N | release checks | released and completed jobs | idle units | capture |\n| ---: | ---: | ---: | ---: | ---: |\n");
  for(std::size_t n:{0,1,2,4,8,16}){std::vector<dm::algorithms::RTTask> tasks;for(std::size_t i=0;i<n;++i)tasks.push_back({i,4,0});const auto t=dm::algorithms::rt_trace(tasks,24);
    if(t.work.release_checks!=24*n||t.work.jobs_released!=6*n||t.work.jobs_completed!=6*n||t.work.busy_ticks||t.work.idle_ticks!=24||t.work.peak_ready||t.captured_entries!=7*n+24)throw std::runtime_error("zero-work family failed");
    std::print("| {} | {} | {} | {} | {} |\n",n,t.work.release_checks,t.work.jobs_released,t.work.idle_ticks,t.captured_entries);
    nvalues.push_back(n);checks.push_back(t.work.release_checks);zero_history.push_back(t.captured_entries);}
  auto a=dm::graphics::RPlot::create();a.line(x,busy,"busy",{37,99,235}).line(x,idle,"idle",{22,163,74}).line(x,history,"history",{124,58,237}).title("One task over k complete periods").x_label("Periods k").y_label("Logical units or entries").y_limits(0,470);
  auto b=dm::graphics::RPlot::create();b.line(nvalues,checks,"release checks",{220,38,38}).line(nvalues,zero_history,"history",{124,58,237}).title("Zero work still requires release checks").x_label("Zero-work tasks N").y_label("Logical checks or entries").y_limits(0,470);
  dm::graphics::RLayout::create(1,2).add(a).add(b).size(1100,520).title("Exact counts for this unit-granularity engine").fit_panels().save_svg("build/edf_work.svg");
}
