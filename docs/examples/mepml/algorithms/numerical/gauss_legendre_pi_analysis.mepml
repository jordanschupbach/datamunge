> Reference zero, owned records and bounded control counts

Comparing the nearest double π with itself gives a zero double-reference
error and no available logarithm. A genuinely wider reference still reveals
that this double constant approximates an irrational real value. The helper
reports log availability explicitly; it does not convert zero into a guessed
error floor. ULP offsets below use the local spacing at rounded double π.

Checked analysis/trace counts must lie from 0 through the format's safe used-weight
limit, 1024 for binary64. The final unused p can become infinity at that boundary,
while the estimate stays finite; a later use is forbidden. The old function
returned NaN at 1025. New calls reject that suffix before work. Legacy negative
counts retain their zero-stage behavior; new checked analysis/trace APIs reject
negative counts instead of silently interpreting them as precision requests.

Whole history admission counts one initial-state record plus N complete stage
records before initialization or allocation. These units are records, not scalar
entries or bytes, and exclude ordinary final output, root/work metadata, working
storage and allocator bytes. This is not a peak RAM limit. Default cap is one
million; zero disables only that optional cap. There is no truncation, replay or
partial returned trace. A zero-stage trace still contains its one initial record.

```{cpp, results="markdown", file="figures/legendre_controls.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <datamunge/algorithms/gauss_legendre_pi.hpp>
#include <datamunge/plot/diagram.hpp>
#include <array>
#include <cmath>
#include <limits>
#include <numbers>
#include <print>
namespace dm=datamunge;
int main(){
 std::filesystem::create_directories("build");
 const auto plateau=dm::algorithms::pi_reference_accuracy(dm::algorithms::gauss_legendre_pi(6));const auto rounded=dm::algorithms::pi_reference_accuracy(std::numbers::pi);
 std::print("| candidate | double-reference error | wider-reference error | local-reference ULP offset | rounded log available | wider log available |\n| --- | ---: | ---: | ---: | --- | --- |\n| AGM plateau | {:.6e} | {:.6e} | {:.1f} | {} | {} |\n| Rounded pi constant | {:.6e} | {:.6e} | {:.1f} | {} | {} |\n",plateau.rounded_absolute_error,plateau.wider_absolute_error,plateau.rounded_ulp_offset,plateau.has_rounded_log_error,plateau.has_wider_log_error,rounded.rounded_absolute_error,rounded.wider_absolute_error,rounded.rounded_ulp_offset,rounded.has_rounded_log_error,rounded.has_wider_log_error);
 bool denied=false;try{(void)dm::algorithms::gauss_legendre_pi_trace(6,6);}catch(const std::length_error&){denied=true;}
 auto t=dm::algorithms::gauss_legendre_pi_trace(6,7);t.steps[0].after.a=99;const bool owned=t.run.initial.a==1&&t.steps[1].before.a!=99&&t.run.final.a!=99;
 bool negative=false,large=false,nonfinite=false;try{(void)dm::algorithms::gauss_legendre_pi_trace(-1,1);}catch(const std::invalid_argument&){negative=true;}try{(void)dm::algorithms::gauss_legendre_pi(std::numeric_limits<int>::max());}catch(const std::invalid_argument&){large=true;}try{(void)dm::algorithms::pi_reference_accuracy(std::numeric_limits<double>::infinity());}catch(const std::invalid_argument&){nonfinite=true;}
 const auto zero=dm::algorithms::gauss_legendre_pi_trace(0,1);
 std::print("\nRecords required {}; captured {}; cap 6 rejected {}; cap 7 admitted true; independent owned copies {}.\n",dm::algorithms::gauss_legendre_pi_trace_records(6),t.captured_records,denied,owned);
 std::print("Checks: negative checked count before quota {}; excessive count before work {}; nonfinite reference candidate {}; legacy negative equals zero {}.\n",negative,large,nonfinite,dm::algorithms::gauss_legendre_pi(-1)==dm::algorithms::gauss_legendre_pi(0));
 std::print("Zero-stage trace: events {}; records {}; initial estimate {:.17g}; initial square roots {}.\n",zero.steps.size(),zero.captured_records,zero.run.value,zero.run.work.square_roots);
 auto quota=dm::graphics::RPlot::barplot({7.,double(t.captured_records),6.},{"Required","Captured","Rejected cap"});quota.title("Whole-record admission").xlab("").ylab("Complete records, not bytes").y_limits(0,9);
 auto ulps=dm::graphics::RPlot::barplot({double(plateau.rounded_ulp_offset),double(rounded.rounded_ulp_offset)},{"AGM plateau","Rounded pi"});ulps.title("Offset from double reference").xlab("").ylab("ULPs at the rounded pi reference").y_limits(0,3);
 dm::graphics::RLayout::create(1,2).add(quota).add(ulps).size(1100,500).title("Resource records and reference differences have distinct units").fit_panels().save_svg("build/legendre_controls.svg");
 if(!denied||!owned||!negative||!large||!nonfinite||rounded.has_rounded_log_error)throw std::runtime_error("record and reference controls");
}
