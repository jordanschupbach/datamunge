> Actual time-dependent callbacks and dimension-dependent work

For y'=t, y(0)=0, the exact solution is t^2/2. On [0,1] with
N steps, Euler is the left-endpoint quadrature
h sum(i=0,...,N-1) i h=(N-1)/(2N). For eight steps the endpoint
is 7/16, whereas the exact endpoint is 1/2. The callback below saves
the times and states it actually receives. The trace is checked
against those observations and contains no extra query at the final
time, since no further step begins there.

Each step invokes the vector callback once regardless of dimension d,
and performs d scalar state updates. Intrinsic output has N+1 state
samples. Optional derivative capture has
C=(N+1)(d+1)+N(d+1)=(2N+1)(d+1) logical entries under the slot
convention described below. Constant forcing supplies independently
known endpoints for dimension/work controls; the numerical integration
loop belongs entirely to the core.

```{cpp, results="markdown", file="figures/euler_work.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main(){
  std::filesystem::create_directories("build");std::vector<double> times;std::vector<std::vector<double>> states;
  const auto t=dm::algorithms::euler_method_trace([&](double time,const std::vector<double>& y){times.push_back(time);states.push_back(y);return std::vector<double>{time};},{0},0,1,8);
  bool observed=times.size()==t.derivatives.size();for(std::size_t i=0;i<times.size();++i)observed=observed&&times[i]==t.outcome.solution.t[i]&&states[i]==t.outcome.solution.y[i]&&t.derivatives[i][0]==times[i];
  std::print("Time forcing: endpoint {}; exact {}; callback records {}; last queried time {}; final stored time {}; actual history agrees {}.\n\n",t.outcome.solution.y.back()[0],.5,times.size(),times.back(),t.outcome.solution.t.back(),observed);
  std::print("| dimension d | steps N | actual callbacks | scalar updates | samples | capture C |\n| ---: | ---: | ---: | ---: | ---: | ---: |\n");
  for(std::size_t d:{1,2,4,8}){const auto r=dm::algorithms::euler_method_trace([](double,const std::vector<double>& y){return std::vector<double>(y.size(),1);},std::vector<double>(d,0),0,1,8);if(!std::all_of(r.outcome.solution.y.back().begin(),r.outcome.solution.y.back().end(),[](double value){return value==1;}))throw std::runtime_error("constant forcing endpoint failed");std::print("| {} | 8 | {} | {} | {} | {} |\n",d,r.outcome.work.rhs_calls,r.outcome.work.scalar_updates,r.outcome.solution.t.size(),r.captured_entries);}
  std::vector<double> sizes,calls,updates,capture;
  for(int n:{8,16,32,64,128}){const auto r=dm::algorithms::euler_method_trace([](double,const std::vector<double>& y){return std::vector<double>(y.size(),1);},{0,0,0,0},0,1,n);sizes.push_back(n);calls.push_back(r.outcome.work.rhs_calls);updates.push_back(r.outcome.work.scalar_updates);capture.push_back(r.captured_entries);}
  auto a=dm::graphics::RPlot::create();a.line(sizes,calls,"callbacks N",{37,99,235}).points(sizes,calls,"",{37,99,235},5).line(sizes,updates,"updates 4N",{22,163,74}).title("Four components, one callback per step").x_label("Number of steps N").y_label("Actual calls or scalar updates");
  auto b=dm::graphics::RPlot::create();b.line(sizes,capture,"C=5*(2N+1)",{124,58,237}).points(sizes,capture,"",{124,58,237},5).title("Actual derivative history has known size").x_label("Number of steps N").y_label("Logical captured slots and entries");
  dm::graphics::RLayout::create(1,2).add(a).add(b).size(1100,520).title("Actual callbacks, scalar work and optional history are separate counts").fit_panels().save_svg("build/euler_work.svg");
}
```
