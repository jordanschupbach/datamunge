> Retain the original six-value experiment and measure the current library

Use the original values [1,2,3,4,5,6], seed 42 and consecutive seeds 0 through 59,999.
Before changing the shuffle implementation, the original complete program was executed
against the current canonical sampler and its output frozen. That execution gives
[3,6,4,2,1,5] for seed 42 and the counts below. The source report's stored [5,4,1,3,6,2]
and older tally were stale relative to that pre-conversion execution. The new kernel
preserves the executed baseline, rather than retaining those stale printed results.

The census labels original positions 0 through 5; label v corresponds to original value
v+1. It counts every output position and whole permutations in the core. The displayed
first-position marginal retains the original experiment, while the right plot shows all
720 observed complete orderings in lexicographic order. The reference of 60,000/720 is
an ideal benchmark, not an expectation established by sequential seed enumeration.

```{cpp, results="markdown", file="figures/fy_original.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <datamunge/plot/diagram.hpp>
#include <numeric>
#include <limits>
#include <print>
namespace dm=datamunge;
int main(){
  std::filesystem::create_directories("build");
const std::vector<int> items{1,2,3,4,5,6};const auto a=dm::algorithms::fisher_yates_shuffle(items,42),again=dm::algorithms::fisher_yates_shuffle(items,42);
  std::print("Seed 42: {} {} {} {} {} {}; repeated seed agrees {}.\n\n",a[0],a[1],a[2],a[3],a[4],a[5],a==again);
  const auto c=dm::algorithms::fisher_yates_seed_census(6,0,60000);
  std::print("| original value | first-position count | ideal benchmark | relative deviation |\n| ---: | ---: | ---: | ---: |\n");
  std::vector<double>x,y;for(std::size_t v=0;v<6;++v){const double count=c.by_position[0][v];std::print("| {} | {} | 10000 | {:.2f}% |\n",v+1,c.by_position[0][v],100*(count/10000-1));x.push_back(v+1);y.push_back(count);}
  std::vector<double>rank,frequency;for(const auto&[p,count]:c.permutation_counts){rank.push_back(rank.size()+1);frequency.push_back(count);}
  const auto mm=std::minmax_element(frequency.begin(),frequency.end());
  std::print("\nSeeded census: executions {}; observed whole outputs {}; smallest count {:.0f}; largest count {:.0f}; admitted units {}.\n",c.outcomes,c.permutation_counts.size(),*mm.first,*mm.second,c.work_units);
  auto first=dm::graphics::RPlot::create();first.bars(x,y,"Count",{37,99,235}).abline_h(10000,{220,38,38},1.5).title("Original first-position seed census").x_label("Original value").y_label("Count among 60000 seeds").x_limits(.4,6.6).y_limits(0,12500);
  auto joint=dm::graphics::RPlot::create();joint.line(rank,frequency,"Observed count",{37,99,235},1).abline_h(60000./720,{220,38,38},1.5).title("All 720 observed whole permutations").x_label("Lexicographic ordering rank").y_label("Count among the same seeds").y_limits(0,*mm.second+25);
  dm::graphics::RLayout::create(1,2).add(first).add(joint).size(1100,540).title("Reproducible seed counts, not a proof of an ideal probability law").fit_panels().save_svg("build/fy_original.svg");
  if(c.by_position[0]!=std::vector<std::uint64_t>{10118,9980,9856,10141,9886,10019})throw std::runtime_error("frozen original tally");
}
