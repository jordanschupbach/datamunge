> Exactly flat marginals can still hide a nonuniform joint law

Consider only the three cyclic rotations 123,231,312, each chosen equally often.
Every label appears once at every output position. All nine marginal cells therefore
have exactly the same count. Yet half of the six permutations are impossible. This
is a concrete counterexample to the original claim that flat position bars alone
establish an unbiased shuffle. Even checking every position is insufficient.

The following exact rotation census is a deliberate comparison model, without a
pseudorandom generator. Count probabilities by dividing its multiplicities by three;
the ideal Fisher–Yates multiplicities must instead be divided by six.

```{cpp, results="markdown", file="figures/fy_marginals.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <datamunge/plot/diagram.hpp>
#include <numeric>
#include <limits>
#include <print>
namespace dm=datamunge;
int main(){
  std::filesystem::create_directories("build");
const auto ideal=dm::algorithms::shuffle_choice_census(3);
  const auto cyclic=dm::algorithms::shuffle_choice_census(3,dm::algorithms::ShuffleCensusRule::CyclicShift);
  std::print("| output position | count of value 1 | count of value 2 | count of value 3 |\n| ---: | ---: | ---: | ---: |\n");
  std::vector<std::vector<double>>z(3,std::vector<double>(3));for(std::size_t p=0;p<3;++p){std::print("| {} | {} | {} | {} |\n",p,cyclic.by_position[p][0],cyclic.by_position[p][1],cyclic.by_position[p][2]);for(std::size_t v=0;v<3;++v)z[v][p]=cyclic.by_position[p][v];}
  std::print("\n| ordering | ideal probability | rotation-only probability |\n| --- | ---: | ---: |\n");
  std::vector<double>rank,probability;for(const auto&[p,count]:ideal.permutation_counts){const auto it=cyclic.permutation_counts.find(p);const double probability_here=it==cyclic.permutation_counts.end()?0:double(it->second)/cyclic.outcomes;std::print("| {}{}{} | {:.6f} | {:.6f} |\n",p[0]+1,p[1]+1,p[2]+1,double(count)/ideal.outcomes,probability_here);rank.push_back(rank.size()+1);probability.push_back(probability_here);}
  auto heat=dm::graphics::RPlot::create();heat.image({0,1,2},{0,1,2},z,dm::graphics::viridis_colors(32),0,2).title("All position marginals exactly flat").x_label("Original value minus one").y_label("Output position").x_limits(-.5,2.5).y_limits(-.5,2.5).margins(95,95,65,75);
  heat.segments({.5,1.5,-.5,-.5},{-.5,-.5,.5,1.5},{.5,1.5,2.5,2.5},{2.5,2.5,.5,1.5},{255,255,255},1.5);
  for(std::size_t row=0;row<3;++row)for(std::size_t col=0;col<3;++col)heat.text(col,row,std::to_string(cyclic.by_position[row][col]),{255,255,255},24);
  auto joint=dm::graphics::RPlot::create();joint.bars(rank,probability,"Rotation probability",{220,38,38}).abline_h(1./6,{37,99,235},1.5).title("Only three whole outputs can occur").x_label("Lexicographic ordering rank").y_label("Exact model probability").x_limits(.4,6.6).y_limits(0,.45);
  dm::graphics::RLayout::create(1,2).add(heat).add(joint).size(1100,540).title("Flat position counts do not determine the permutation law").fit_panels().save_svg("build/fy_marginals.svg");
}
