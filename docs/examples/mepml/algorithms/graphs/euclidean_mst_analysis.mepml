//? Title: Euclidean Minimum Spanning Trees: Actual Edges, Cuts and Work
//? Subtitle: Complete planar distances, stable Kruskal decisions and checked native C++ histories
//? Exports: both
//? Lang: en-GB

\abstract(
Given labeled planar points, connect every point with minimum total
straight-line edge length, without adding new junctions. The canonical
C++ implementation measures every unordered pair and runs one shared
stable Kruskal kernel. We begin with the original unit square, then
inspect an actual cycle rejection, coincident vertices, scale and
translation, and exact input-generation work. A checked owned trace
records the decisions made by the same kernel that returns the tree.
)

\toc

> The original unit square: three sides suffice

Four vertices in cyclic order have four unit-length sides and two
sqrt(2) diagonals. A tree needs three edges. Three unit sides connect
the square with total length three, and every edge has length at least
one, so no spanning tree can be shorter. Equal weights are scanned in
the original lexicographic pair order. This chooses a reproducible tree
from several equally good trees; it does not make the minimum unique.

```{cpp, results="markdown", file="figures/euclidean_mst_square.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main(){
  std::filesystem::create_directories("build");
  const auto t=dm::algorithms::euclidean_minimum_spanning_tree_trace({{0,0},{1,0},{1,1},{0,1}});
  const auto& k=t.kruskal;const auto& r=k.outcome.result;
  std::print("Original square: total {}; selected edges {}; connected {}; pair distances {}; actual scans {}; entries {}.\n\n",r.total_weight,r.edges.size(),r.is_connected,t.distance_evaluations,k.steps.size(),t.captured_entries);
  std::print("| actual scan | pair index | u | v | distance | roots before | accepted | components after |\n| ---: | ---: | ---: | ---: | ---: | :--- | :--- | ---: |\n");
  for(std::size_t i=0;i<k.steps.size();++i){const auto& step=k.steps[i];auto [u,v,w]=k.input_edges.at(step.input_index);std::print("| {} | {} | {} | {} | {:.9f} | {},{} | {} | {} |\n",i,step.input_index,u,v,w,step.root_u,step.root_v,step.accepted,step.components_after);}
  dm::graphics::Diagram d(260,1100);dm::graphics::DiagramStroke gray;gray.color={203,213,225};gray.width=2;
  dm::graphics::DiagramStroke selected;selected.color={37,99,235};selected.width=5;
  for(auto [u,v,w]:k.input_edges)d.path({{t.points[u].x,t.points[u].y},{t.points[v].x,t.points[v].y}},gray);
  for(auto [u,v,w]:r.edges)d.path({{t.points[u].x,t.points[u].y},{t.points[v].x,t.points[v].y}},selected);
  dm::graphics::DiagramNodeStyle node;node.circle=true;node.width=.23;node.height=.23;node.font_size=24;node.padding=7;
  for(std::size_t i=0;i<t.points.size();++i)d.node(std::to_string(i),{t.points[i].x,t.points[i].y},std::to_string(i),node);
  d.text({.5,1.55},"Original square: three accepted unit sides",26).text({.5,-.6},"Blue: returned tree; gray: complete candidate graph",22).save_svg("build/euclidean_mst_square.svg");
}
