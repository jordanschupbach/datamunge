#include <cmath>
#include <filesystem>
#include <limits>
#include <print>
namespace dm=datamunge;
int main(){
 std::filesystem::create_directories("build");
 std::vector<double>x,slots,searches;std::print("| clique size | vertices | edges | bridge conventional score | scored batches | source slots | dependency contributions | actual edge-search comparisons |\n| ---: | ---: | ---: | ---: | ---: | ---: | ---: | ---: |\n");
 for(std::size_t size:std::array<std::size_t,6>{2,3,4,6,8,12}){const auto g=dm::algorithms::clique_bridge_graph(size,size);const auto r=dm::algorithms::girvan_newman_run(g.vertex_count,g.edges,2);const auto b=dm::algorithms::edge_betweenness(g.vertex_count,g.edges);const auto found=std::lower_bound(b.edges.begin(),b.edges.end(),std::pair<std::size_t,std::size_t>{size-1,size});const auto i=std::size_t(found-b.edges.begin());std::print("| {} | {} | {} | {:.0f} | {} | {} | {} | {} |\n",size,g.vertex_count,g.edges.size(),b.scores.at(i),r.work.rounds,r.work.source_slots,r.work.dependency_updates,r.work.edge_search_comparisons);x.push_back(g.vertex_count);slots.push_back(std::log2(r.work.source_slots));searches.push_back(std::log2(r.work.edge_search_comparisons));if(b.scores.at(i)!=double(size*size)||r.work.rounds!=1)throw std::runtime_error("clique bridge family");}
 auto plot=dm::graphics::RPlot::create();plot.lines(x,slots,"Source slots",{37,99,235},2).points(x,slots,"",{37,99,235},5).lines(x,searches,"Edge searches",{220,38,38},2).points(x,searches,"",{220,38,38},5).legend({"Source slots","Search comparisons"},{{37,99,235},{220,38,38}}).title("Actual work in one scored batch, with separate units").xlab("Vertices").ylab("log2 positive selected operation count").y_limits(0,17).size(1100,570).save_svg("build/gn_work.svg");
}
