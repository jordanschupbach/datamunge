> Floating path counts need a numeric boundary

A double can represent every nonnegative integer only through 2^53. The native
flag path_counts_integer_guaranteed becomes false once an actual count exceeds
that range. False is conservative: a power of two above the threshold can still
be exactly represented. The guard checks the integer bound before rounding:
an exact count of 2^53+1 can round back to 2^53 and must still clear the guarantee.
True concerns path counts only, not exact dependency
fractions, tie rankings or an error certificate.

Consecutive width-two complete-bipartite layers create exponentially many shortest
paths. Sixty layers produce finite counts beyond the integer guarantee. With 1030
layers, the original unchecked kernel generated nonfinite counts, dependencies and
a maximum, then NaN comparisons deleted all edges. The updated core throws on a
nonfinite update before propagation or deletion. It preserves the original finite
double order and does not silently switch to exact arithmetic or long double.

```{cpp, results="markdown", file="figures/gn_numeric.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <datamunge/algorithms/girvan_newman.hpp>
#include <datamunge/datasets/network_data.hpp>
#include <datamunge/plot/diagram.hpp>
#include <algorithm>
#include <array>
#include <cmath>
#include <filesystem>
#include <limits>
#include <print>
namespace dm=datamunge;
int main(){
 std::filesystem::create_directories("build");
 const auto finite_graph=dm::algorithms::layered_graph(60,2);const auto finite=dm::algorithms::girvan_newman_run(finite_graph.vertex_count,finite_graph.edges,2);const auto large=dm::algorithms::layered_graph(1030,2);const auto original_edges=large.edges;bool rejected=false;
 try{(void)dm::algorithms::girvan_newman_run(large.vertex_count,large.edges,2);}catch(const std::overflow_error&){rejected=true;}
 std::print("| layers | vertices | edges | outcome |\n| ---: | ---: | ---: | --- |\n| 60 | {} | {} | finite result, {} components |\n| 1030 | {} | {} | nonfinite update rejected: {} |\n",finite_graph.vertex_count,finite_graph.edges.size(),finite.groups.size(),large.vertex_count,large.edges.size(),rejected);
 std::print("\nLargest actual finite path count {:.12e}; integer-count guarantee {}; caller edges unchanged {}. No large trace is requested.\n",finite.max_paths,finite.path_counts_integer_guaranteed,large.edges==original_edges);
 dm::graphics::Diagram d(64,1100);dm::graphics::DiagramNodeStyle box;box.width=4.9;box.height=2;box.font_size=22;
 d.node("finite",{0,0},"60 width-two layers\n120 vertices / 236 edges",box).node("flag",{7,0},std::format("Finite path counts\ninteger guarantee: {}",finite.path_counts_integer_guaranteed),box)
 .node("large",{0,-3.4},"1030 width-two layers\n2060 vertices / 4116 edges",box).node("error",{7,-3.4},std::format("Nonfinite update rejected\nno result returned: {}",rejected),box)
 .edge("finite","flag","run").edge("large","error","run").text({3.5,2.3},"Finite arithmetic and exact-integer guarantees are different",24).save_svg("build/gn_numeric.svg");
 if(finite.path_counts_integer_guaranteed||!rejected||large.edges!=original_edges)throw std::runtime_error("numeric guard");
}
