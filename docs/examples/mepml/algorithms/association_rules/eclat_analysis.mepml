//? Title: Eclat: Actual Tidset Intersections and Frequent Itemsets
//? Subtitle: From a two-item intersection to groceries, exact work families and Titanic baskets
//? Exports: both
//? Lang: en-GB

\abstract(
Given baskets of items and a minimum count, we want every nonempty item
combination that occurs in enough baskets. The number of answers can be
exponential, and counting every candidate by another database scan wastes
work. Eclat instead stores the row indices containing each item and
intersects these sorted tidsets while extending frequent prefixes. We
inspect actual conditional intersections, preserve the original grocery
example, check exact dense and disjoint work families, and mine the
canonical Titanic table. Zero support and capture limits are explicit.
)

\toc

> Begin with an intersection you can check

Number the baskets from zero: {bread,milk}, {bread,milk}, {bread}, {milk}.
The bread tidset is {0,1,2}; milk's is {0,1,3}. Their intersection is
{0,1}, so the pair's support is two. At minimum support two, both
singletons and the pair survive. Raising the threshold to three prunes
the pair while retaining both singletons.

The following native diagram uses the actual root and child states of
one mining run. The trace captures intersections during mining, rather
than constructing a second explanation after the result is known.

```{cpp, results="markdown", file="figures/eclat_tiny.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main(){
  std::filesystem::create_directories("build");
  const std::vector<std::vector<std::size_t>> baskets{{0,1},{0,1},{0},{1}};
  const auto t=dm::algorithms::eclat_trace(baskets,2);
  const std::vector<std::string> labels{"bread","milk"};
  std::print("Tiny: {} frequent sets; {} intersection; {} merge steps; {} captured entries.\n\n",t.itemsets.size(),t.work.intersections,t.work.intersection_steps,t.captured_entries);
  std::print("| state | itemset | tids | support | frequent |\n| ---: | :--- | :--- | ---: | :--- |\n");
  dm::graphics::Diagram d(64,1050);dm::graphics::DiagramNodeStyle box;box.width=5;box.height=1.8;box.font_size=23;
  for(std::size_t i=0;i<t.states.size();++i){const auto& s=t.states[i];std::string tids;
    for(auto id:s.tids){if(!tids.empty())tids+=",";tids+=std::to_string(id);}
    std::print("| {} | {} | {} | {} | {} |\n",i,dm::algorithms::itemset_label(s.itemset.items,labels),tids,s.itemset.support,s.frequent);
    const dm::graphics::DiagramPoint at=i==0?dm::graphics::DiagramPoint{0,0}:i==1?dm::graphics::DiagramPoint{7,0}:dm::graphics::DiagramPoint{3.5,-4};
    if(i==2)box.fill={187,247,208};
    d.node(std::to_string(i),at,std::format("state {}: {}\ntids {{{}}}\nsupport {}",i,dm::algorithms::itemset_label(s.itemset.items,labels),tids,s.itemset.support),box);
  }
  const auto& pair=t.states.at(2);
  d.edge(std::to_string(pair.left),"2","left operand").edge(std::to_string(pair.right),"2","right operand")
   .text({3.5,2},"Sorted tidset intersection: keep matching row ids",25).save_svg("build/eclat_tiny.svg");
  const auto stricter=dm::algorithms::eclat_trace(baskets,3);
  std::print("\nThreshold three: {} frequent sets; attempted pair support {}; pair kept {}.\n",stricter.itemsets.size(),stricter.states.at(2).itemset.support,stricter.states.at(2).frequent);
}
