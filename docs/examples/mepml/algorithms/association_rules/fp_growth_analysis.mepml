#include <print>
namespace dm=datamunge;
int main(){
  std::filesystem::create_directories("build");
  const auto encoded=dm::algorithms::encode_transactions(dm::datasets::titanic(),{"Pclass","Sex","Survived"});const auto t=dm::algorithms::fp_growth_trace(encoded.transactions,45);const auto a=dm::algorithms::apriori_frequent_itemsets(encoded.transactions,45),e=dm::algorithms::eclat_frequent_itemsets(encoded.transactions,45);
  const auto equal=[](const auto&x,const auto&y){return x.size()==y.size()&&std::equal(x.begin(),x.end(),y.begin(),[](const auto&l,const auto&r){return l.items==r.items&&l.support==r.support;});};const bool apriori=equal(t.itemsets,a),eclat=equal(t.itemsets,e);
  std::print("Titanic: {} rows; {} incidences; {} observed items; minimum count45; {} frequent sets. Apriori agrees {}; Eclat agrees {}.\n",t.work.transactions,t.work.incidences,encoded.labels.size(),t.itemsets.size(),apriori,eclat);
  std::print("Actual structure: {} initial nonroot nodes; {} builds; {} nonroot creations across builds; {} parent hops; {} peak frames; {} retained history entries.\n",t.trees[0].nodes.size()-1,t.work.trees_built,t.work.nodes_created,t.work.parent_hops,t.work.peak_frames,t.captured_entries);
  std::print("| frequent triple of passenger attributes | support | share of891 |\n| --- | ---: | ---: |\n");std::vector<double> sizes(3),heights;std::vector<std::string>labels;
  for(const auto&f:t.itemsets){sizes.at(f.items.size()-1)++;if(f.items.size()==1){labels.push_back(encoded.labels.at(f.items[0]));heights.push_back(double(f.support));}if(f.items.size()==3)std::print("| {} | {} | {:.4f} |\n",dm::algorithms::itemset_label(f.items,encoded.labels),f.support,double(f.support)/double(t.work.transactions));}
  std::print("\nFrequent set counts by size: one {:.0f}; two {:.0f}; three {:.0f}.\n",sizes[0],sizes[1],sizes[2]);
  auto singles=dm::graphics::RPlot::barplot(heights,labels,"",{37,99,235}).title("Retained passenger attributes").xlab("Observed column=value item").ylab("Absolute support").y_limits(0,700);
  auto cardinality=dm::graphics::RPlot::barplot(sizes,{"1 item","2 items","3 items"},"",{22,163,74}).title("Frequent sets by cardinality").xlab("Itemset size").ylab("Number of frequent sets").y_limits(0,20);
  dm::graphics::RLayout::create(2,1).add(singles).add(cardinality).size(1000,850).title("Titanic: three selected columns, minimum count45").fit_panels().save_svg("build/fp_growth_titanic.svg");
  if(t.work.transactions!=891||t.work.incidences!=2673||t.itemsets.size()!=32||!apriori||!eclat)throw std::runtime_error("canonical passenger evidence");
}
