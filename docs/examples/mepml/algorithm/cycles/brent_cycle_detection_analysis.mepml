| ---: | ---: | ---: | ---: | ---: | :--- | ---: |
| 7 | 49 | 5 | 1 | 1 | true | 19 |
| 19 | 82 | 4 | 1 | 1 | true | 17 |
| 23 | 13 | 3 | 1 | 1 | true | 11 |
| 4 | 16 | 0 | 8 | 4 | false | 23 |
| 116 | 38 | 3 | 8 | 58 | false | 29 |
