> Check work and closed forms on repeated occurrences

Take a=a repeated k times and b=a repeated 3k times, with k≥2. There is only
one distinct bigram key. Its multiplicities are A=k−1 and B=3k−1, so I=k−1,
U=3k−1 and

$$
D_k=\frac{k-1}{2k-1}\longrightarrow\frac12,\qquad
J_k=\frac{k-1}{3k-1}\longrightarrow\frac13.
$$
\alttext(For repeated a strings of lengths k and three k, Dice is k minus one over two k minus one and tends to one half; Jaccard is k minus one over three k minus one and tends to one third.)

The trace's actual occurrence-level operations are k−1 left updates and
3k−1 right lookups, totaling 4k−2. It consumes k−1 occurrences and records
2k misses, even though all right bigrams have the same key. Its event list
has 3k−1 entries; complete A+B caps include both sides. The plot explicitly
transforms its horizontal axis to log2(k), and its work axis to log2(count).
The table keeps untransformed integers. These are dictionary operations at
the occurrence level, excluding hash probes, collisions, rehashing, copying
and trace sorting; they are not elapsed-time measurements.

```{cpp, results="markdown", file="figures/dice_repeat_work.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
  std::filesystem::create_directories("build");
  std::vector<double> log_k,dice,jaccard,actual,theory,events;double residual=0;
  std::print("| k left bytes | right bytes | distinct union keys | shared | Dice | Jaccard | actual updates + lookups | 4k-2 | actual events |\n| ---: | ---: | ---: | ---: | ---: | ---: | ---: | ---: | ---: |\n");
  for(std::size_t k:{2,4,8,16,64,256,1024,4096}) {
    const auto t=dm::algorithms::dice_coefficient_trace(std::string(k,'a'),std::string(3*k,'a'));const auto& s=t.overlap;
    residual=std::max(residual,std::abs(s.coefficient-double(k-1)/double(2*k-1)));
    residual=std::max(residual,std::abs(s.jaccard-double(k-1)/double(3*k-1)));
    const auto work=t.work.left_updates+t.work.right_lookups;
    if(work!=4*k-2 || t.events.size()!=3*k-1 || t.counts.size()!=1)return 1;
    std::print("| {} | {} | {} | {} | {:.6f} | {:.6f} | {} | {} | {} |\n",k,t.right.size(),t.counts.size(),s.shared,s.coefficient,s.jaccard,work,4*k-2,t.events.size());
    log_k.push_back(std::log2(double(k)));dice.push_back(s.coefficient);jaccard.push_back(s.jaccard);
    actual.push_back(std::log2(double(work)));theory.push_back(std::log2(double(4*k-2)));events.push_back(std::log2(double(t.events.size())));
  }
  auto score=dm::graphics::RPlot::create();score.line(log_k,dice,"Dice",{37,99,235},2).line(log_k,jaccard,"Jaccard",{234,88,12},2)
   .abline_h(.5,{148,163,184},1).abline_h(1.0/3,{148,163,184},1)
   .title("One key; different occurrence multiplicities").x_label("log2(left byte length k)").y_label("multiset similarity").y_limits(0,.72);
  auto work=dm::graphics::RPlot::create();work.line(log_k,actual,"actual operations",{37,99,235},2).points(log_k,theory,"4k-2",{31,41,55},4)
   .line(log_k,events,"actual events",{124,58,237},2).title("Count occurrences, not distinct bigrams")
   .x_label("log2(left byte length k)").y_label("log2(actual count)").y_limits(0,17);
  dm::graphics::RLayout::create(1,2).add(score).add(work).size(1100,520).title("Repeated-byte controls: exact counts and closed-form scores").fit_panels().save_svg("build/dice_repeat_work.svg");
  std::print("\nMaximum score residual against the two closed forms: {:.3e}.\n\n",residual);if(residual>1e-14)return 1;
  const auto large=dm::algorithms::dice_overlap_counts(3000000000ULL,1000000000ULL,1000000000ULL);
  std::print("Count-only control, no strings constructed: total {}; union {}; Dice {:.6f}; Jaccard {:.6f}.\n\n",large.total,large.union_count,large.coefficient,large.jaccard);
  int rejected=0;
  try{dm::algorithms::dice_coefficient_trace("aa","aaaa",3);}catch(const std::length_error&){++rejected;}
  try{dm::algorithms::dice_coefficient_trace("night","night",7);}catch(const std::length_error&){++rejected;}
  try{dm::algorithms::dice_overlap_counts(std::numeric_limits<std::size_t>::max(),1,0);}catch(const std::length_error&){++rejected;}
  try{dm::algorithms::dice_overlap_counts(0,0,1);}catch(const std::invalid_argument&){++rejected;}
  const auto exact=dm::algorithms::dice_coefficient_trace("aa","aaaa",4),uncapped=dm::algorithms::dice_coefficient_trace("aa","aaaa",0);
  if(rejected!=4 || exact.overlap.coefficient!=uncapped.overlap.coefficient)return 1;
  std::print("Four expected complete-cap/count rejections: {}. Exact complete cap four and zero-disabled optional cap agree.\n",rejected);
}
