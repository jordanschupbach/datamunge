```{cpp, results="markdown", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
  const auto trace=dm::algorithms::bitonic_sort_trace({3,1,4,2});
  std::print("| stage | first wire | second wire | ascending | before | after | exchanged |\n"
             "| ---: | ---: | ---: | :--- | :--- | :--- | :--- |\n");
  for (const auto& s:trace.steps)
    std::print("| {} | {} | {} | {} | {}, {} | {}, {} | {} |\n",s.comparator.stage+1,
        s.comparator.first,s.comparator.second,s.comparator.ascending,
        s.first_before,s.second_before,s.first_after,s.second_after,s.swapped);
  std::vector<int> original{8,3,11,1,7,14,2,9,5,13,0,6,12,4,10,15,20,17};
  std::print("\nOriginal eighteen-element input: {}.\n",original);
  dm::algorithms::bitonic_sort(original);
  const auto network=dm::algorithms::bitonic_network(original.size());
  std::print("Sorted: {}. Comparators: {}; stages: {}.\n",original,network.comparators.size(),network.stages);
}
