//? Title: Forward–backward: evidence, filtering and smoothed state marginals
//? Subtitle: Sum hidden paths, preserve the original fourteen-step example and expose the limits of scaled arithmetic
//? Exports: both
//? Lang: en-GB

\abstract(
A hidden Markov model assigns a probability to an observation sequence by summing
its hidden state paths. Forward–backward reuses partial sums to compute that evidence
and every time-specific state marginal. A two-time example makes the sum and the
influence of future evidence visible. The original fourteen-symbol illustrative
stream retains its likelihood, smoothed probabilities and Viterbi decode. Actual
scaled tables and work counts then distinguish filtering, smoothing and joint-path
decoding, while impossible sequences and tiny probabilities delimit the numerical contract.
)

\toc

> Four hidden paths explain two observations

Use two hidden states0 and1, each initially equally likely. Staying has probability
0.8 and switching0.2. State0 emits symbol0 with probability0.9 and symbol1 with
probability0.1; state1 reverses those probabilities. Observe symbols0,1.
For each possible state path q_0,q_1, multiply its initial, emission, transition
and emission probabilities. The four joint masses are0.036,0.081,0.001 and0.036,
which sum to evidence0.154. Direct enumeration below is a bounded native reference;
the report does not implement a second inference algorithm.

```{cpp, results="markdown", file="figures/forward_backward_tiny.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <datamunge/algorithms/forward_backward.hpp>
#include <datamunge/plot/diagram.hpp>
#include <algorithm>
#include <print>
#include <limits>
namespace dm=datamunge;
int main(){
  std::filesystem::create_directories("build");
  const dm::algorithms::HiddenMarkovModel h{{.5,.5},{{.8,.2},{.2,.8}},{{.9,.1},{.1,.9}}};const std::vector<std::size_t> obs{0,1};const auto r=dm::algorithms::forward_backward(h,obs);const auto e=dm::algorithms::hmm_enumerate_paths(h,obs);
  std::print("| hidden path | joint mass |\n| --- | ---: |\n");
  for(const std::vector<std::size_t> q:std::vector<std::vector<std::size_t>>{{0,0},{0,1},{1,0},{1,1}})std::print("| {} | {:.3f} |\n",q,dm::algorithms::hmm_path_probability(h,obs,q));
  std::print("\nEvidence: enumeration {:.6f}; scaled recursion {:.6f}; {} paths.\n",e.probability,std::exp(r.log_likelihood),e.paths);
  std::print("| time | filtered P(state1) | smoothed P(state1) | reciprocal scale | sum(alpha*beta) |\n| ---: | ---: | ---: | ---: | ---: |\n");
  for(std::size_t t=0;t<2;++t){double norm=0;for(std::size_t i=0;i<2;++i)norm+=r.alpha[t][i]*r.beta[t][i];std::print("| {} | {:.6f} | {:.6f} | {:.6f} | {:.6f} |\n",t,r.alpha[t][1],r.gamma[t][1],r.scale[t],norm);}
  dm::graphics::Diagram d(62,1100);dm::graphics::DiagramNodeStyle node;node.circle=true;node.width=1;node.height=1;node.font_size=23;
  d.node("a0",{0,3},"0",node).node("a1",{0,0},"1",node).node("b0",{8,3},"0",node).node("b1",{8,0},"1",node);
  dm::graphics::DiagramStroke arrow;arrow.color={37,99,235};arrow.width=2.5;
  d.edge("a0","b0","",arrow).edge("a0","b1","",arrow).edge("a1","b0","",arrow).edge("a1","b1","",arrow);
  d.label({4,3.45},std::format("joint {:.3f}",dm::algorithms::hmm_path_probability(h,obs,{0,0})),21)
   .label({2.65,2.0},std::format("joint {:.3f}",dm::algorithms::hmm_path_probability(h,obs,{0,1})),21)
   .label({5.35,2.0},std::format("joint {:.3f}",dm::algorithms::hmm_path_probability(h,obs,{1,0})),21)
   .label({4,-.45},std::format("joint {:.3f}",dm::algorithms::hmm_path_probability(h,obs,{1,1})),21)
   .text({0,4.8},"time0, symbol0",23).text({8,4.8},"time1, symbol1",23)
   .text({4,-1.7},std::format("Sum all four joint masses: evidence {:.3f}",e.probability),24)
   .text({4,-2.8},std::format("Future symbol changes P(q0=1): {:.2f} → {:.6f}",r.alpha[0][1],r.gamma[0][1]),23).save_svg("build/forward_backward_tiny.svg");
  if(std::abs(e.probability-.154L)>1e-15L||std::abs(r.gamma[0][1]-.037/.154)>1e-14)throw std::runtime_error("tiny path sum");
}
