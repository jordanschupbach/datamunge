> Scaling helps long products but has explicit numeric limits

For one state with transition probability one and two equiprobable symbols,
T repetitions of symbol0 have probability2^(−T). Every forward marginal is one,
every reciprocal scale is two and every backward entry under this convention is two.
The native log-likelihood remains finite when converting it back to an ordinary
double probability underflows to zero. The table separates those two operations.

```{cpp, results="markdown", file="figures/forward_backward_numerics.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <datamunge/algorithms/forward_backward.hpp>
#include <datamunge/plot/diagram.hpp>
#include <algorithm>
#include <print>
#include <limits>
namespace dm=datamunge;
int main(){
  std::filesystem::create_directories("build");
  const dm::algorithms::HiddenMarkovModel h{{1},{{1}},{{.5,.5}}};std::vector<double>x,y;
  std::print("| observations | log evidence | exp(log evidence), double | last scale | last marginal |\n| ---: | ---: | ---: | ---: | ---: |\n");
  for(std::size_t T:{1u,10u,100u,1000u,10000u}){const auto r=dm::algorithms::forward_backward(h,std::vector<std::size_t>(T,0));std::print("| {} | {:.6f} | {:.6g} | {:.0f} | {:.0f} |\n",T,r.log_likelihood,std::exp(r.log_likelihood),r.scale.back(),r.gamma.back()[0]);x.push_back(double(T));y.push_back(-r.log_likelihood);if(std::abs(r.log_likelihood+double(T)*std::log(2.))>1e-8)throw std::runtime_error("long scaled evidence");}
  const auto impossible=dm::algorithms::forward_backward(dm::algorithms::HiddenMarkovModel{{1},{{1}},{{1,0}}},{0,1});bool reciprocal=false,underflow=false;
  try{dm::algorithms::forward_backward(dm::algorithms::HiddenMarkovModel{{1},{{1}},{{1,1e-320}}},{1});}catch(const std::overflow_error&){reciprocal=true;}
  const auto tiny=std::numeric_limits<double>::denorm_min();try{dm::algorithms::forward_backward(dm::algorithms::HiddenMarkovModel{{.5,.5},{{1,0},{0,1}},{{1,tiny},{1,0}}},{0,1});}catch(const std::underflow_error&){underflow=true;}
  std::print("\nImpossible sequence: negative-infinite log evidence {}; gamma placeholders [{:.0f}, {:.0f}]. Tiny reciprocal overflow rejected {}; positive-support underflow rejected {}.\n",std::isinf(impossible.log_likelihood)&&impossible.log_likelihood<0,impossible.gamma[0][0],impossible.gamma[1][0],reciprocal,underflow);
  auto plot=dm::graphics::RPlot::create();plot.lines(x,y,"Native scaled result",{37,99,235},2).points(x,y,"",{37,99,235},5).title("One-state evidence: negative log likelihood grows as T log(2)").xlab("Observation count T; linear scale").ylab("Negative log likelihood; natural-log units").size(1000,520).save_svg("build/forward_backward_numerics.svg");
  if(!reciprocal||!underflow||!std::isinf(impossible.log_likelihood))throw std::runtime_error("numerical boundary controls");
}
```
