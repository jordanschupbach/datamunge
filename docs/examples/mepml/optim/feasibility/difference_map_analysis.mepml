> Small steps, infeasibility, zero budgets and bounded histories

The residual is the Euclidean step norm, so in exact arithmetic

$$
\|x_{k+1}-x_k\|=|\beta|\,\|a_k-b_k\|.
$$
\alttext(The step norm is the absolute value of beta times the gap between the two cross-projections.)

The primary paper monitors the cross-projection gap; this API retains the
repository's older step-norm residual. The legacy strict test step<tol only
implies cross gap<tol/|beta|, subject
to rounding. With A={0}, B={1}, beta=10^−6 and tol=10^−5, it stops after
one update despite the cross gap being one and the intersection empty. The
API preserves that numerical flag's meaning and exposes the gap separately.
A caller must validate the decoded point against its actual constraints.
For beta=1 these disjoint sets instead produce a constant unit displacement;
the driver reaches its iteration limit. No algorithm can return a common
point for an empty intersection.

```{cpp, results="markdown", file="figures/difference_map_stopping.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
  std::filesystem::create_directories("build");
  const auto a=[](const std::vector<double>& x){return dm::algorithms::project_finite_set(x,{{0}});};
  const auto b=[](const std::vector<double>& x){return dm::algorithms::project_finite_set(x,{{1}});};
  const auto small=dm::algorithms::difference_map_trace(a,b,{0},1e-6,10,1e-5),drift=dm::algorithms::difference_map_trace(a,b,{0},1,5,1e-12),zero=dm::algorithms::difference_map_trace(a,b,{0},1,0);
  dm::graphics::Diagram d(75,1100);dm::graphics::DiagramNodeStyle box;box.width=4.3;box.height=1.7;box.font_size=23;
  d.node("step",{0,0},std::format("Step = {:.1e}\nstep < tol: {}",small.result.residual,small.result.converged),box);
  box.fill={254,226,226};d.node("gap",{7,0},std::format("Cross gap = {:.0f}\nA and B are disjoint",small.steps.back().gap_norm),box)
   .edge("step","gap","divide by |beta|")
   .text({3.5,2.3},"A = {0}; B = {1}; beta = 1e-6; tol = 1e-5",24)
   .text({3.5,-2.3},"A numerical stopping flag is not a feasibility certificate",24)
   .save_svg("build/difference_map_stopping.svg");
  std::print("| control | updates | numerical stop | residual | final iterate | returned estimate | observed gap |\n| :--- | ---: | :--- | ---: | :--- | :--- | :--- |\n");
  std::print("| small beta | {} | {} | {:.6e} | {} | {} | {:.6f} |\n",small.result.iterations,small.result.converged,small.result.residual,small.final_iterate,small.result.solution,small.steps.back().gap_norm);
  std::print("| disjoint drift | {} | {} | {:.6e} | {} | {} | {:.6f} |\n",drift.result.iterations,drift.result.converged,drift.result.residual,drift.final_iterate,drift.result.solution,drift.steps.back().gap_norm);
  std::print("| zero budget | {} | {} | {:.6e} | {} | {} | not evaluated |\n\n",zero.result.iterations,zero.result.converged,zero.result.residual,zero.final_iterate,zero.result.solution);
  std::print("Zero budget: A calls {}; B calls {}; retained steps {}. Its zero residual is the historical unevaluated sentinel.\n\n",zero.work.projection_a_calls,zero.work.projection_b_calls,zero.steps.size());
  const auto la=[](const std::vector<double>& x){return dm::algorithms::project_affine_hyperplane(x,{1,-1},0);};
  const auto lb=[](const std::vector<double>& x){return dm::algorithms::project_affine_hyperplane(x,{1,1},4);};
  const auto exact=dm::algorithms::difference_map_trace(la,lb,{7,-3},1,10000,1e-13,34);
  int calls=0;const auto ca=[&](const std::vector<double>& x){++calls;return la(x);};const auto cb=[&](const std::vector<double>& x){++calls;return lb(x);};bool capped=false;
  try{dm::algorithms::difference_map_trace(ca,cb,{7,-3},1,10000,1e-13,33);}catch(const std::length_error&){capped=true;}
  if(!capped || calls!=4 || exact.work.history_entries!=34)return 1;
  std::print("Online history: cost {} per two-dimensional record; exact cap 34 succeeds with {} records; cap 33 throws before a second update, after {} actual calls.\n\n",dm::algorithms::difference_map_history_cost(2),exact.steps.size(),calls);
  std::print("| displacement component scale | stable step norm | finite | numerical stop |\n| ---: | ---: | :--- | :--- |\n");
  for(double scale:{1e200,1e-200}) {
    const auto pa=[scale](const std::vector<double>&){return std::vector<double>{scale,scale};};const auto pb=[](const std::vector<double>&){return std::vector<double>{0,0};};
    const auto t=dm::algorithms::difference_map_trace(pa,pb,{0,0},1,1,1e-250);
    std::print("| {:.1e} | {:.6e} | {} | {} |\n",scale,t.result.residual,std::isfinite(t.result.residual),t.result.converged);
    if(!std::isfinite(t.result.residual) || t.result.residual==0 || t.result.converged)return 1;
  }
}
