> The original notable years and 2000–2040 wander

Retain the original years 2000,2024,2025,2026,2038 and the inclusive chart window
2000–2040. The reusable native summary now owns the extrema and 35 date bins;
equal extrema keep the first ascending year. The displayed coordinate is not a
day-of-year. It deliberately omits January/February and remains on the same
March/April axis across leap and common years.

```{cpp, results="markdown", file="figures/computus.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
  std::filesystem::create_directories("build");
  std::print("| original notable year | Easter month/day |\n| ---: | :--- |\n");
  for(const int year:{2000,2024,2025,2026,2038}) {
    const auto e=dm::algorithms::computus_gregorian(year);
    std::print("| {} | {}/{} |\n",year,e.month,e.day);
  }
  const auto s=dm::algorithms::computus_gregorian_summary(2000,2040);
  if(s.year_count!=41 || s.earliest_year!=2008 || s.latest_year!=2038 || s.spread_days!=33)return 1;
  std::print("\n| measured range summary | year | month/day |\n| :--- | ---: | :--- |\n| earliest | {} | {}/{} |\n| latest | {} | {}/{} |\n",s.earliest_year,s.earliest.month,s.earliest.day,s.latest_year,s.latest.month,s.latest.day);
  std::print("\nYears {}; spread {} days.\n",s.year_count,s.spread_days);
  std::vector<double> years,march_days;
  for(int year=2000;year<=2040;++year) {
    const auto t=dm::algorithms::computus_gregorian_trace(year);
    if(dm::algorithms::zeller_gregorian(year,t.date.month,t.date.day)!=1)return 1;
    years.push_back(year);march_days.push_back(t.march_day);
  }
  auto plot=dm::graphics::RPlot::create();
  plot.line(years,march_days,"Easter",{37,99,235},1.5).points(years,march_days,"",{220,38,38},4)
      .abline_h(22,{148,163,184},1).abline_h(56,{148,163,184},1)
      .legend({"Easter coordinate"},{{37,99,235}})
      .title("Gregorian Easter 2000-2040: a fixed March axis")
      .x_label("rule year").y_label("March 1 = 1; April 1 = 32")
      .y_limits(21,63).size(900,580).save_svg("build/computus.svg");
}
```
