\alttext(Observed false positives increase with load. A separate curve shows the independent-hash model; the observations need not coincide with it.)

> Checking the sizing rule across hash counts

Additional probes initially reduce accidental positives; increased occupancy
eventually dominates. The following reconstructs the filter for each k=1,...,12,
with the same 1,000 inserted and 5,000 absent strings. The model's rounded
choice is six. Finite observed minima can differ, and this shared synthetic probe
set does not measure a universal best setting.

```{cpp, results="markdown", file="figures/bloom_hash_count.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
  std::filesystem::create_directories("build");
  using dm::algorithms::bloom_hash64;
  std::vector<double> hashes,observed,model;
  std::print("| k | false positives / 5000 | observed fraction | model fraction | fill ratio |\n"
             "| ---: | :--- | ---: | ---: | ---: |\n");
  for (int k=1;k<=12;++k) {
    dm::algorithms::BloomFilter filter(8000,k);
    for (int i=0;i<1000;++i) filter.add(bloom_hash64("key"+std::to_string(i)));
    int fp=0;
    for (int i=0;i<5000;++i) fp+=filter.maybe_contains(bloom_hash64("absent"+std::to_string(i)));
    hashes.push_back(k);observed.push_back(fp/5000.);model.push_back(filter.expected_false_positive_rate(1000));
    std::print("| {} | {} / 5000 | {:.6f} | {:.6f} | {:.6f} |\n",k,fp,observed.back(),model.back(),filter.fill_ratio());
  }
  const double ymax=1.6*std::max(*std::max_element(observed.begin(),observed.end()),*std::max_element(model.begin(),model.end()));
  dm::graphics::RPlot::create()
      .points(hashes,observed,"observed",dm::RGB{37,99,235},5)
      .lines(hashes,model,"model",dm::RGB{220,38,38},2)
      .title("Hash-count trade-off at eight logical bits per key")
      .x_label("probe count k").y_label("false-positive fraction")
      .y_limits(0,ymax).size(900,480).save_svg("build/bloom_hash_count.svg");
}
```
