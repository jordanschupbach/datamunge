// result_end
\caption(The lower row is the owned snapshot after freeing zero and before the successful 64-byte allocation. Its 96 free bytes consist of a 64-byte block and a 32-byte block; adjacency still does not permit merging unequal-size blocks.)
\alttext(Two proportional arena rows show live red and free green intervals. In the upper row, separate 32-byte free blocks at offsets 32 and 64 touch but cannot merge. In the lower row, freeing zero creates a 64-byte free block at zero, alongside the separate 32-byte block at 64.)

This is external fragmentation under the buddy alignment rules, distinct from
unused bytes inside a reserved block. Coalescing improves consolidation but
cannot guarantee every request fitting the total free-byte count will succeed.
The [Harvard CS 161 buddy-allocation lecture](https://read.seas.harvard.edu/cs161/2024/lectures/lecture5/)
illustrates the same adjacent-nonbuddy obstruction. The example above uses the
actual datamunge allocator state, not a drawing inferred from total free bytes.

> Measured order work and implementation complexity

For a fully free 2^h-byte arena with a one-byte minimum, allocating one byte
examines h+1 orders and performs h splits. Freeing it probes and merges h
buddies. The exact counts depend on height, not on a scan of all byte offsets.
Even the largest shown logical arena, 2^30 bytes, allocates only host metadata.

```{cpp, results="markdown", file="figures/buddy_allocator_order_work.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <climits>
int main() {
  std::filesystem::create_directories("build");
  std::vector<double> heights,searches,splits;
  std::print("| height h | logical arena bytes | allocation order checks | splits | free buddy probes | merges |\n"
             "| ---: | ---: | ---: | ---: | ---: | ---: |\n");
  for (int h:{0,1,2,4,8,12,16,20,24,30}) {
    dm::algorithms::BuddyAllocator arena(1<<h,1);
    const auto allocation=arena.allocate_trace(1);
    const auto release=arena.free_trace(allocation.offset);
    if (allocation.orders_examined!=static_cast<std::size_t>(h+1) || allocation.splits.size()!=static_cast<std::size_t>(h) ||
        release.probes.size()!=static_cast<std::size_t>(h) || release.merges!=static_cast<std::size_t>(h) ||
        arena.snapshot().largest_free_block!=(1<<h)) return 1;
    std::print("| {} | {} | {} | {} | {} | {} |\n",h,1<<h,allocation.orders_examined,allocation.splits.size(),release.probes.size(),release.merges);
    heights.push_back(h);searches.push_back(allocation.orders_examined);splits.push_back(allocation.splits.size());
  }
  dm::graphics::RPlot::create()
      .lines(heights,searches,"order checks",dm::RGB{217,119,6},2)
      .points(heights,searches,"",dm::RGB{217,119,6},4)
      .lines(heights,splits,"splits / merges",dm::RGB{37,99,235},2)
      .points(heights,splits,"",dm::RGB{37,99,235},4)
      .title("Actual order-level work grows with arena height")
      .x_label("height h = log2(arena bytes / minimum block)")
      .y_label("actual logical event count").size(1100,520)
      .save_svg("build/buddy_allocator_order_work.svg");
  dm::algorithms::BuddyAllocator large(1<<30,1);
  const auto oversized=large.allocate_trace(INT_MAX);
  bool dimensions=false,request=false,order=false;
  try {dm::algorithms::BuddyAllocator invalid(1000,32);}
  catch (const std::invalid_argument&) {dimensions=true;}
  try {(void)large.allocate(0);}
  catch (const std::invalid_argument&) {request=true;}
  try {(void)large.block_size(31);}
  catch (const std::out_of_range&) {order=true;}
  if (!dimensions || !request || !order || oversized.offset!=-1 || oversized.orders_examined!=0) return 1;
  std::print("\nInvalid dimensions, zero request and invalid block order rejected: {}, {}, {}.\n",dimensions,request,order);
  std::print("Positive INT_MAX request: mathematical order {}, offset {}, eligible orders examined {}.\n",
      oversized.desired_order,oversized.offset,oversized.orders_examined);
  const auto ignored=large.free_trace(-1);
  std::print("Unknown free released a block: {}; probes: {}.\n",ignored.released,ignored.probes.size());
}
```
