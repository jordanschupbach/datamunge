  for(std::size_t i=0;i<r.source.size();++i)std::print("| {:.2f} | {:.0f} | {:.0f} | {:.5f} | {:.2e} |\n",r.x[i+1],r.source[i],r.rhs[i],r.u[i+1],r.residual[i]);
