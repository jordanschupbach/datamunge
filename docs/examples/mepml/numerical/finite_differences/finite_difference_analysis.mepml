> Small residual, large discretisation error: change the frequency

The n=19 grid resolves the first sine mode well. For sin(kπx), the discrete eigenvalue
is 4sin²(kπh/2)/h² while the continuous one is (kπ)². For 1≤k≤n the exact discrete
amplitude gain is their ratio. Increasing k at fixed h makes the difference important;
the direct solver can still give a tiny residual. Smoothness alone does not ensure a
small error on a fixed grid: the fourth-derivative bound grows as k⁴.

```{cpp, results="markdown", file="figures/fd_resolution.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <filesystem>
#include <format>
#include <numbers>
#include <print>
#include <climits>
namespace dm=datamunge;
int main(){
  std::filesystem::create_directories("build");
constexpr double pi=std::numbers::pi_v<double>;
  std::print("| frequency k | predicted amplitude gain | maximum nodal error | discrete residual |\n| ---: | ---: | ---: | ---: |\n");
  std::vector<double>ks,errors,residuals;
  auto p=dm::graphics::RPlot::create();
  for(int k:{1,3,9,19}){
    const double w=k*pi;const auto r=dm::algorithms::finite_difference_poisson_solve([w](double x){return w*w*std::sin(w*x);},0,0,19);
    const auto e=dm::algorithms::interpolation_error_scan([&](double t){return dm::algorithms::linear_interpolate(r.x,r.u,t);},[w](double t){return std::sin(w*t);},r.x);
    const double gain=w*w*r.h*r.h/(4*std::pow(std::sin(w*r.h/2),2));
    std::print("| {} | {:.6f} | {:.6f} | {:.3e} |\n",k,gain,e.max_abs_error,r.max_abs_residual);
    ks.push_back(k);errors.push_back(std::log10(e.max_abs_error));residuals.push_back(std::log10(std::max(r.max_abs_residual,1e-16)));
    if(k==9){std::vector<double>x,y;for(int i=0;i<=800;++i){double t=i/800.;x.push_back(t);y.push_back(std::sin(w*t));}p.line(x,y,"Exact k=9",{148,163,184},2).line(r.x,r.u,"Joined numerical nodes",{220,38,38},2).points(r.x,r.u,"",{220,38,38},4);}
  }
  p.title("Under-resolved k=9 on the same grid").x_label("x").y_label("u(x)");
  auto e=dm::graphics::RPlot::create();e.line(ks,errors,"Nodal error",{220,38,38},2).points(ks,errors,"",{220,38,38},5).line(ks,residuals,"Discrete residual",{37,99,235},2).title("Solving a matrix vs resolving a function").x_label("Sine frequency k").y_label("log10 absolute maximum").legend({"Nodal PDE error","Discrete residual"},{{220,38,38},{37,99,235}}).y_limits(-15,3);
  dm::graphics::RLayout::create(1,2).add(p).add(e).size(1100,540).title("A small residual does not remove discretisation error").fit_panels().save_svg("build/fd_resolution.svg");
}
