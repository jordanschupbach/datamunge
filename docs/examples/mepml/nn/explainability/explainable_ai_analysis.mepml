> Train on fitting bars and evaluate held-out predictions

The canonical generator makes 600 images with seed 20240815: 300 of each
orientation, alternating before shuffling. Positions cover 0..10; independent
Gaussian noise has scale 0.08 and values are clipped to [0,1]. Its saved
shuffle order gives 420 fitting and 180 held-out rows. Both models use the
same split; held-out labels never contribute to an update.

Model and minibatch seeds are one. The CNN performs forty SGD epochs and
the dense model two hundred, both with learning rate 0.05 and batch size 16.
The fused mean sparse softmax cross-entropy is the training objective. There
is no early stopping, regularisation or augmented training data. Checkpoints
are written locally for subsequent programs in this report; they are trained
here, rather than loaded from an external example. The plotted loss is the
sample-weighted mean of actual preupdate minibatch losses in each epoch.
Final confusion matrices use actual held-out predictions, true classes in rows.

```{cpp, results="markdown", file="figures/xai_training.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main(){
  namespace n=dm::nn;namespace m=n::models;n::set_num_threads(2);
  std::filesystem::create_directories("build");std::filesystem::create_directories("figures");
  const auto data=n::make_bar_images(300);const std::vector<std::int64_t> fit(data.shuffled_rows.begin(),data.shuffled_rows.begin()+420),test(data.shuffled_rows.begin()+420,data.shuffled_rows.end());
  const auto x=n::take_rows(data.images,fit),y=n::take_rows(data.labels,fit),tx=n::take_rows(data.images,test),ty=n::take_rows(data.labels,test);
  std::print("Data: {} generated; {} fitting; {} held out; image shape {}; horizontal label 0; vertical label 1.\n\n",data.labels.size(0),fit.size(),test.size(),data.images.shape());
  auto plot=dm::graphics::RPlot::create();std::print("| model | epochs | optimizer calls | parameters | fitting accuracy | held-out accuracy | held-out NLL |\n| :--- | ---: | ---: | ---: | ---: | ---: | ---: |\n");
  for(int kind=0;kind<2;++kind){n::ParameterStore p(1);auto forward=[&](const n::Tensor& input){return kind?m::DenseImageBaseline(p,input):m::SmallImageCnn(p,input).logits;};{n::NoGradGuard guard;(void)forward(n::take_rows(x,{0}));}
    n::OptimizerConfig rule;rule.kind=n::OptimizerKind::Sgd;n::Optimizer optimizer(p,.05,rule);n::BatchOrder batches(fit.size(),16,1);const int epochs=kind?200:40;std::size_t calls=0;std::vector<double> epoch,losses;
    for(int e=0;e<epochs;++e){batches.begin_epoch();n::WeightedMean average;for(auto rows=batches.next();!rows.empty();rows=batches.next()){
        const auto logits=forward(n::take_rows(x,rows));const auto loss=n::sparse_softmax_cross_entropy(logits,n::take_rows(y,rows));optimizer.minimize(loss);++calls;average.add(loss.item(),rows.size());}
      epoch.push_back(e+1);losses.push_back(average.value());}
    p.save(kind?"build/xai_mlp.npz":"build/xai_cnn.npz");n::NoGradGuard guard;const auto logits=forward(tx);n::ConfusionMatrix confusion(2);confusion.add(ty,n::argmax(logits,1));n::ConfusionMatrixPlotOptions co;co.labels={"horizontal","vertical"};co.title=kind?"Dense: actual held-out bars":"CNN: actual held-out bars";const auto file=kind?"xai_mlp_confusion.svg":"xai_cnn_confusion.svg";confusion.save_svg(std::string("build/")+file,co);std::filesystem::copy_file(std::string("build/")+file,std::string("figures/")+file,std::filesystem::copy_options::overwrite_existing);
    std::print("| {} | {} | {} | {} | {:.6f} | {:.6f} | {:.9f} |\n",kind?"dense":"CNN",epochs,calls,p.count(),n::accuracy(forward(x),y),confusion.accuracy(),n::sparse_softmax_cross_entropy(logits,ty).item());
    plot.line(epoch,losses,kind?"Dense SGD":"CNN SGD",kind?dm::graphics::RGB{234,88,12}:dm::graphics::RGB{37,99,235},2);}
  plot.title("Actual preupdate minibatch loss").x_label("Completed epoch").y_label("Sample-weighted mean cross-entropy").size(1000,530).save_svg("build/xai_training.svg");
}
