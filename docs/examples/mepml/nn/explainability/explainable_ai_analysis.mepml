> Reuse the same callback contract for the dense model

The explainers receive no network structure. This program loads the dense
checkpoint trained above, selects the horizontal example and explains its
class-zero raw logit with exactly the same grid, baseline and 800-sample
LIME settings. It also evaluates the CNN's class-zero coalition game on that
same image for a fixed-class cross-model comparison. Agreement is measured,
not assumed: independently trained architectures can use different cues.
The area-distributed maps retain signs. Kernel methods and trees can implement
the same callback contract if their scores obey its batching requirements.

```{cpp, results="markdown", file="figures/xai_mlp.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main(){
  namespace n=dm::nn;namespace m=n::models;n::set_num_threads(2);std::filesystem::create_directories("build");
  n::ParameterStore dense(1),cnn(1);{n::NoGradGuard guard;(void)m::DenseImageBaseline(dense,n::zeros({1,12,12,1}));(void)m::SmallImageCnn(cnn,n::zeros({1,12,12,1}));}dense.load("build/xai_mlp.npz");cnn.load("build/xai_cnn.npz");
  n::BarImageOptions b;b.min_position=5;b.max_position=5;const auto x=n::take_rows(n::make_bar_images(1,99,b).images,{0});
  n::ImageScoreBatch predict=[&](const n::Tensor& batch){return n::select(m::DenseImageBaseline(dense,batch),1,0);};n::ImageLimeOptions l;
  const auto shap=n::exact_image_shapley(x,predict);const auto lime=n::lime_image(x,predict,l);const auto other=n::exact_image_shapley(x,[&](const n::Tensor& batch){return n::select(m::SmallImageCnn(cnn,batch).logits,1,0);});
  const auto sp=n::expand_image_attributions(shap.patch_values,12,12),lp=n::expand_image_attributions(lime.patch_values,12,12),cp=n::expand_image_attributions(other.patch_values,12,12);
  std::print("Dense class 0: full {:.6f}; baseline {:.6f}; Shapley sum {:.6f}; residual {:.3g}; LIME weighted R2 {:.6f}; fitted full {:.6f}.\n",shap.full_value,shap.base_value,n::sum(shap.patch_values).item(),shap.efficiency_residual,lime.r_squared,lime.fitted_full);
  std::print("Signed correlations: dense LIME/Shapley {:.6f}; dense/CNN Shapley for fixed class 0 {:.6f}.\n",n::attribution_correlation(lp,sp),n::attribution_correlation(sp,cp));
  std::print("Dense queries: Shapley {} images / {} batches; LIME {} images / {} batches. CNN comparison queries {} images.\n",shap.work.evaluations,shap.work.predict_calls,lime.work.evaluations,lime.work.predict_calls,other.work.evaluations);
  if(std::abs(shap.efficiency_residual)>1e-8)throw std::runtime_error("dense efficiency failed");
  n::diagram_image_maps(n::concat({x,lp,sp,cp},0),2,{"Input intensity","Dense local LIME","Dense exact Shapley","CNN exact Shapley"},{false,true,true,true}).save_svg("build/xai_mlp.svg");
}
