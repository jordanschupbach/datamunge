// result_end
\caption(The same native explainer functions accept dense and convolutional prediction callbacks. Different colour ranges are shown explicitly; the reported cross-model agreement uses raw signed map values.)
\alttext(Four native panels compare the horizontal image, its dense-model LIME and Shapley maps, and the CNN Shapley map for the same class-zero raw target.)

> Baseline, partition and probability change the game

Raw logits are not probabilities. Softmax couples class scores nonlinearly,
so explaining a probability does not amount to rescaling raw-logit credit.
A larger fixed baseline also changes what "removed" means. A coarser grid
changes the players themselves. Exact enumeration and tiny efficiency residuals
can hold for all these choices while yielding different attributions.

We keep class zero fixed, compare raw logit and softmax probability, and use
2×2 and 4×4 grids at baselines zero and one half. The actual full-image score
for a given score definition should agree across these settings because every
full mask restores the same image. Baseline scores, attribution totals and
computational costs can change. The positive-support-only correlation is shown
as a separately labelled transformation alongside signed correlation; it does
not replace the signed diagnostic.

The direct native masker and map-expansion helpers also check malformed grids,
invalid score shapes and nonfinite values. No partial explanation is returned
on failure. Batch predictions must be deterministic and independent between
examples: a batch-dependent score would define different games at different
batch sizes.

```{cpp, results="markdown", file="figures/xai_choices.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main(){
  namespace n=dm::nn;namespace m=n::models;n::set_num_threads(2);std::filesystem::create_directories("build");
  n::ParameterStore p(1);{n::NoGradGuard guard;(void)m::SmallImageCnn(p,n::zeros({1,12,12,1}));}p.load("build/xai_cnn.npz");n::BarImageOptions b;b.min_position=5;b.max_position=5;const auto x=n::take_rows(n::make_bar_images(1,99,b).images,{0});
  std::print("| game ID | score | grid | baseline | queries | actual full | actual empty | signed sum | absolute sum | efficiency residual |\n| ---: | :--- | :--- | ---: | ---: | ---: | ---: | ---: | ---: | ---: |\n");
  std::vector<double> costs,totals;std::vector<std::string> labels;std::vector<n::Tensor> finest;std::array<double,2> fulls{std::numeric_limits<double>::quiet_NaN(),std::numeric_limits<double>::quiet_NaN()};
  for(bool probability:{false,true})for(int grid:{2,4})for(double baseline:{0.,.5}){n::ImagePatchOptions o;o.patch_rows=grid;o.patch_cols=grid;o.baseline=baseline;n::ImageScoreBatch score=[&](const n::Tensor& batch){const auto logits=m::SmallImageCnn(p,batch).logits;return n::select(probability?n::softmax(logits,1):logits,1,0);};
    const auto e=n::exact_image_shapley(x,score,o);const auto sum=n::sum(e.patch_values).item();if(std::isnan(fulls[probability]))fulls[probability]=e.full_value;else if(std::abs(e.full_value-fulls[probability])>1e-5*std::max(1.,std::abs(e.full_value)))throw std::runtime_error("full-mask score changed across reference/grid choices");std::print("| {} | {} | {}x{} | {:.1f} | {} | {:.6f} | {:.6f} | {:.6f} | {:.6f} | {:.3g} |\n",labels.size()+1,probability?"probability":"raw logit",grid,grid,baseline,e.work.evaluations,e.full_value,e.base_value,sum,n::sum(n::abs(e.patch_values)).item(),e.efficiency_residual);
    if(std::abs(e.efficiency_residual)>1e-8)throw std::runtime_error("choice efficiency failed");if(grid==4)finest.push_back(n::expand_image_attributions(e.patch_values,12,12));
    costs.push_back(std::log2(double(e.work.evaluations)));totals.push_back(sum);labels.push_back(std::to_string(labels.size()+1));}
  std::print("\n4x4 baseline 0 versus 0.5 signed correlation: raw {:.6f}; probability {:.6f}.\n",n::attribution_correlation(finest[0],finest[1]),n::attribution_correlation(finest[2],finest[3]));
  std::print("4x4 baseline 0 raw versus probability: signed correlation {:.6f}; positive-support-only correlation {:.6f}.\n",n::attribution_correlation(finest[0],finest[2]),n::attribution_correlation(finest[0],finest[2],true));
  n::ImagePatchOptions cap;cap.max_evaluations=65535;std::size_t calls=0;bool rejected=false;try{(void)n::exact_image_shapley(x,[&](const n::Tensor& batch){++calls;return n::sum(batch,{1,2,3});},cap);}catch(const std::length_error&){rejected=true;}
  std::print("One-short 4x4 evaluation quota rejected {}; model callback calls before rejection {}.\n",rejected,calls);if(!rejected||calls)throw std::runtime_error("quota was not preflighted");
  auto a=dm::graphics::RPlot::barplot(totals,labels,"signed total",{37,99,235});a.title("Totals depend on the chosen score and reference").x_label("Game ID from the result table").y_label("Signed attribution total");
  auto c=dm::graphics::RPlot::barplot(costs,labels,"log2 actual queries",{124,58,237});c.title("Exact query cost is exponential in patch count").x_label("Game ID from the result table").y_label("log2(actual model images)").y_limits(0,18);
  dm::graphics::RLayout::create(2,1).add(a).add(c).size(1100,1000).title("Changing the question changes the explanation").fit_panels().save_svg("build/xai_choices.svg");
}
