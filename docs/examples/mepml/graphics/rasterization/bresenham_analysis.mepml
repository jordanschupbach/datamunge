// result_end
\caption(There are eleven centres for (3,10), eight for (7,7), and one for coincident endpoints. The full-range demonstration computes only the count and exercises preflight rejection; it does not allocate billions of points.)

Endpoint differences and doubled errors are evaluated in widened 64-bit
arithmetic, covering the full range of 32-bit int coordinates. Widening happens
before subtraction, avoiding the signed-int overflow possible in the old
implementation. Output coordinates remain ints and retain their original
ordering. No clipping, antialiasing or intensity calculation is performed.
This output is not a supercover of every cell touched by the ideal segment.

> Quantisation error and output cost

For the original shallow line, compare each chosen height with 6x/14. For the
short tie example, compare it with x/2. The signed residual is in pixel units
along the minor axis, rather than perpendicular distance to the line. Both
obey the half-pixel bound, and the short example attains it. No floating-point
quantity influences which centres the native integer algorithm selects.

```{cpp, results="markdown", file="figures/bresenham_residuals.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
  std::filesystem::create_directories("build");
  auto plot=dm::graphics::RPlot::create();
  plot.lines({0,14},{.5,.5},"half-pixel bounds",dm::RGB{148,163,184},1)
      .lines({0,14},{-.5,-.5},"",dm::RGB{148,163,184},1);
  std::print("| endpoint | centres | maximum absolute minor residual |\n| :--- | ---: | ---: |\n");
  for (const auto& [end,colour]:std::vector<std::pair<dm::algorithms::GridPoint,dm::RGB>>{
      {{14,6},{37,99,235}},{{2,1},{220,38,38}}}) {
    const auto points=dm::algorithms::bresenham_line(0,0,end.first,end.second);
    std::vector<double> index,residual;double max_error=0;
    for (const auto& [x,y]:points) {
      const double error=y-double(end.second)*x/end.first;
      if (std::abs(error)>.5+1e-12) return 1;
      index.push_back(x);residual.push_back(error);max_error=std::max(max_error,std::abs(error));
    }
    plot.points(index,residual,std::format("{}",end),colour,4);
    std::print("| {} | {} | {:.6f} |\n",end,points.size(),max_error);
  }
  plot.title("Minor-coordinate quantisation: original line and a halfway tie")
      .x_label("major-axis step x").y_label("chosen y minus ideal y (pixels)")
      .y_limits(-.65,1).size(900,500).save_svg("build/bresenham_residuals.svg");
  std::print("\n| major extent M | returned centres | actual outgoing decisions |\n| ---: | ---: | ---: |\n");
  for (int major:{0,1,2,4,8,16,32,64,128}) {
    const auto trace=dm::algorithms::bresenham_line_trace(0,0,major,major/3);
    if (trace.steps.size()!=std::size_t(major)+1) return 1;
    std::print("| {} | {} | {} |\n",major,trace.points.size(),trace.steps.size()-1);
  }
}
```
