namespace dm=datamunge;
int main(){
 std::filesystem::create_directories("build");
 const auto t=dm::algorithms::gauss_jordan_trace({{1,1},{2,3}},{3,8},110);
 std::print("| event | column | selected/updated row | pivot/divisor/raw factor | coefficient block | evolving identity block | RHS |\n| --- | ---: | ---: | ---: | --- | --- | --- |\n");
 for(const auto&e:t.events)std::print("| {} | {} | {} | {:.2f} | {} | {} | {} |\n",e.kind,e.column,e.row,e.value,e.matrix,e.transform,e.rhs);
 std::print("\nSolution {}; inverse {}; events {}; swaps {}; normalizations {}; other-row updates {}; retained entries {}.\n",t.run.result.x,t.run.result.inverse,t.events.size(),t.run.work.row_swaps,t.run.work.normalizations,t.run.work.eliminations,t.captured_entries);
 const auto& norm=t.events.at(1);const auto& lower=t.events.at(2);const auto& finish=t.events.back();
 dm::graphics::Diagram d(63,1100);dm::graphics::DiagramNodeStyle box;box.width=4.4;box.height=2.35;box.font_size=21;
 d.node("normalize",{0,0},std::format("Swap, then divide by {:.1f}\nx + {:.1f}y = {:.1f}\nidentity row {}",norm.value,norm.matrix[0][1],norm.rhs[0],norm.transform[0]),box)
  .node("lower",{6,0},std::format("Clear below pivot\n{:.1f}y = {:.1f}\nidentity row {}",lower.matrix[1][1],lower.rhs[1],lower.transform[1]),box)
  .node("above",{12,0},std::format("Normalize and clear above\nx = {:.1f}, y = {:.1f}\nInverse row 0: {}",finish.rhs[0],finish.rhs[1],finish.transform[0]),box)
  .edge("normalize","lower","subtract").edge("lower","above","second pivot")
  .text({6,2.5},"The same row operations act on [A | I | b]",27).save_svg("build/jordan_tiny.svg");
 if(t.run.result.x!=std::vector<double>{1,2}||t.run.result.inverse!=dm::algorithms::GaussianMatrix{{3,-1},{-2,1}}||t.events.size()!=6)throw std::runtime_error("actual tiny inverse");
}
