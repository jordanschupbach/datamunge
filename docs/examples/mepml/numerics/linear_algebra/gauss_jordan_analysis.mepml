 std::print("Actual row swaps {}; accepted pivots {}; normalization rows {}; other-row updates {}; events {}; retained {}; whole bound {}.\n",t.run.work.row_swaps,t.run.accepted_pivots,t.run.work.normalizations,t.run.work.eliminations,t.events.size(),t.captured_entries,dm::algorithms::gauss_jordan_trace_entries(3));
 std::print("Infinity errors: A*V-I {:.6e}; V*A-I {:.6e}; solve residual {:.6e}; normwise solve backward error {:.6e}.\n",d.left_error_inf,d.right_error_inf,r.residual_inf,r.backward_error);
 std::print("Supplied norm product {:.6f}; cumulative row-interchange IDs {}.\n",d.norm_product,t.run.row_order);
 dm::graphics::Diagram diagram(68,1100);
 diagram.text({1.7,1.2},"Computed inverse V",25).text({10.7,1.2},"Unsnapped A*V - I",25);
 for(std::size_t i=0;i<3;++i)for(std::size_t j=0;j<3;++j){diagram.text({1.7*double(j),-double(i)},std::format("{:.3f}",t.run.result.inverse[i][j]),23);diagram.text({9+1.7*double(j),-double(i)},std::format("{:.2e}",d.left_product[i][j]-(i==j?1.L:0.L)),19,{37,99,235});}
 diagram.text({6.2,-3.1},"Small product residuals are computed evidence; labels are rounded.",22).save_svg("build/jordan_original.svg");
 if(!t.run.result.solved||d.left_error_inf>1e-12L||d.right_error_inf>1e-12L||r.residual_inf>1e-12L)throw std::runtime_error("original solve and inverse");
}
