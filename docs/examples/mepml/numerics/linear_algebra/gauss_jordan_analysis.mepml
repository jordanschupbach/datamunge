int main(){
 std::filesystem::create_directories("build");
 const dm::algorithms::GaussianMatrix a{{1,100},{0,1}};const auto t=dm::algorithms::gauss_jordan_trace(a,{101,1});
 std::vector<double>factors;std::vector<std::string>labels;
 std::print("| elimination column | cleared row | raw factor | resulting RHS |\n| ---: | ---: | ---: | --- |\n");
 for(const auto&e:t.events)if(e.kind=="eliminate"){std::print("| {} | {} | {:.1f} | {} |\n",e.column,e.row,e.value,e.rhs);factors.push_back(std::fabs(e.value));labels.push_back(std::format("column {}, row {}",e.column,e.row));}
 const auto correct=dm::algorithms::inverse_residual_summary(a,t.run.result.inverse);const auto wrong=dm::algorithms::inverse_residual_summary(a,{{1,0},{0,1}});
 std::print("\nSolution {}; inverse {}; largest raw clearing factor {:.1f}; swaps {}.\n",t.run.result.x,t.run.result.inverse,t.run.max_clear_factor,t.run.work.row_swaps);
 std::print("| supplied inverse | A*V-I infinity error | V*A-I infinity error | supplied norm product |\n| --- | ---: | ---: | ---: |\n| Native result | {:.1f} | {:.1f} | {:.1f} |\n| Deliberately wrong identity | {:.1f} | {:.1f} | {:.1f} |\n",correct.left_error_inf,correct.right_error_inf,correct.norm_product,wrong.left_error_inf,wrong.right_error_inf,wrong.norm_product);
 auto plot=dm::graphics::RPlot::barplot(factors,labels);plot.title("An actual above-pivot clearing factor can exceed 1").xlab("Actual other-row update").ylab("Absolute raw f used against the normalized pivot row").y_limits(0,115).size(1050,520).save_svg("build/jordan_above.svg");
 if(t.run.max_clear_factor!=100||correct.left_error_inf!=0||correct.right_error_inf!=0||wrong.left_error_inf!=100||wrong.right_error_inf!=100)throw std::runtime_error("above pivot and candidate controls");
