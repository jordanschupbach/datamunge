 const auto f=dm::algorithms::gaussian_elimination_example();const auto t=dm::algorithms::gauss_jordan_trace(f.a,f.b);
 const auto d=dm::algorithms::inverse_residual_summary(f.a,t.run.result.inverse);const auto r=dm::algorithms::gaussian_residual_summary(f.a,f.b,t.run.result.x);
 std::print("| row | computed inverse row | widened A*V row | widened V*A row |\n| ---: | --- | --- | --- |\n");
 for(std::size_t i=0;i<3;++i)std::print("| {} | {} | {} | {} |\n",i,t.run.result.inverse[i],d.left_product[i],d.right_product[i]);
