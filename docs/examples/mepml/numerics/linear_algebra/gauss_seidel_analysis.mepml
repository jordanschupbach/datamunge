 std::filesystem::create_directories("build");
 std::print("| q | exact Jacobi radius | exact Seidel radius | observed first residual ratio | residual after eight sweeps | converged |\n| ---: | ---: | ---: | ---: | ---: | --- |\n");
 auto plot=dm::graphics::RPlot::create();std::vector<std::string>labels;std::vector<dm::graphics::RGB>colors;
 const std::array<double,4>qs{.25,.5,.75,1.25};const std::array<dm::graphics::RGB,4>palette{{{37,99,235},{5,150,105},{147,51,234},{220,38,38}}};
 for(std::size_t i=0;i<qs.size();++i){const double q=qs[i];const auto t=dm::algorithms::gauss_seidel_history({{1,-q},{-q,1}}, {1-q,1-q},8,0,0);const auto label=std::format("q = {:.2f}",q);
  std::vector<double>k,logs;for(const auto&e:t.sweeps)if(e.residual>0){k.push_back(e.number);logs.push_back(std::log10(e.residual));}
  std::print("| {:.2f} | {:.4f} | {:.4f} | {:.4f} | {:.9e} | {} |\n",q,std::abs(q),q*q,t.sweeps[1].residual/t.sweeps[0].residual,t.run.solution.residual,t.run.solution.converged);
  plot.lines(k,logs,label,palette[i],2).points(k,logs,"",palette[i],4);labels.push_back(label);colors.push_back(palette[i]);
 }
 plot.legend(labels,colors).title("Binary 2 by 2 family: three decaying errors and one divergent error").xlab("Completed sweeps").ylab("log10 positive actual residual").y_limits(-11,5).size(1100,560).save_svg("build/seidel_rates.svg");
}
