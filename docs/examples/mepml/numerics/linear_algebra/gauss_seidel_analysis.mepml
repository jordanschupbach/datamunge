//? Title: Gauss–Seidel: use each new coordinate immediately
//? Subtitle: Actual in-place updates, convergence conditions, residual growth and dense work
//? Exports: both
//? Lang: en-GB

\abstract(
Solve a square linear system by improving an approximate solution through repeated
sweeps, avoiding a full factorization. Whether those sweeps converge depends on
the coefficient matrix and its ordering. Gauss–Seidel updates each coordinate
using the latest available values. This report opens with two hand-checkable
assignments, solves the original three-equation example and tests an exactly
analysable family that both converges and diverges. Actual native histories show
that a residual can increase even for a strictly diagonally dominant system.
Counted dense work and explicit history limits distinguish computational cost,
stopping tests and the mathematical convergence guarantee.
)

\toc

> Two equations show what “use the latest value” means

Solve 2x−y=1 and −x+2y=1, whose exact solution is (1,1). Start at (0,0).
The first equation sets x=1/2. The second immediately reads that new x, so
y=(1+1/2)/2=3/4. A simultaneous Jacobi sweep would instead produce (1/2,1/2).
The diagram and table use snapshots captured by the executing C++ solver;
there is no local reimplementation of its recurrence.

```{cpp, results="markdown", file="figures/seidel_first.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <datamunge/algorithms/gauss_seidel.hpp>
#include <datamunge/plot/diagram.hpp>
#include <array>
#include <cmath>
#include <filesystem>
#include <limits>
#include <print>
namespace dm=datamunge;
int main(){
 std::filesystem::create_directories("build");
 const auto t=dm::algorithms::gauss_seidel_history({{2,-1},{-1,2}}, {1,1},1,0,16);
 std::print("| coordinate | numerator used | previous value | assigned value | mixed vector before | vector after |\n| ---: | ---: | ---: | ---: | --- | --- |\n");
 for(const auto&e:t.coordinates)std::print("| {} | {:.3f} | {:.3f} | {:.3f} | ({:.3f}, {:.3f}) | ({:.3f}, {:.3f}) |\n",e.row+1,e.numerator,e.previous,e.value,e.before[0],e.before[1],e.after[0],e.after[1]);
 std::print("\nAfter one sweep: x=({:.3f}, {:.3f}); residual {:.3f}; converged {}; coordinate updates {}; history entries {}.\n",t.run.solution.x[0],t.run.solution.x[1],t.run.solution.residual,t.run.solution.converged,t.run.work.coordinate_updates,t.captured_entries);
 const auto&e=t.coordinates.at(0);const auto&f=t.coordinates.at(1);
 dm::graphics::Diagram d(65,1100);dm::graphics::DiagramNodeStyle box;box.width=4.1;box.height=2.2;box.font_size=22;
 d.node("start",{0,0},std::format("Zero initial vector\nx = {:.2f}\ny = {:.2f}",e.before[0],e.before[1]),box)
  .node("x",{5.7,0},std::format("Solve the first row\nx = {:.2f}\ny still {:.2f}",e.after[0],e.after[1]),box)
  .node("y",{11.4,0},std::format("Read the NEW x\nx = {:.2f}\ny = {:.2f}",f.after[0],f.after[1]),box)
  .edge("start","x","x = (1+y)/2").edge("x","y","y = (1+x)/2")
  .text({5.7,2.4},"One sweep: later rows read earlier assignments immediately",24)
  .save_svg("build/seidel_first.svg");
 if(t.coordinates.size()!=2||f.before[0]!=.5||f.value!=.75)throw std::runtime_error("actual mixed read state");
}
