#include <print>
namespace dm=datamunge;
int main(){
 std::filesystem::create_directories("build");
 const auto f=dm::algorithms::gaussian_elimination_example();
 const auto t=dm::algorithms::gaussian_elimination_trace(f.a,f.b);
 const auto r=dm::algorithms::gaussian_residual_summary(f.a,f.b,t.run.solution.x);
 std::print("| current row | original row | actual U row | transformed RHS |\n| ---: | ---: | --- | ---: |\n");
 for(std::size_t i=0;i<f.a.size();++i)std::print("| {} | {} | {} | {:.17g} |\n",i,t.run.row_order[i],t.run.upper[i],t.run.rhs[i]);
 std::print("\nComputed x at 17 significant digits: [{:.17g}, {:.17g}, {:.17g}].\n",t.run.solution.x[0],t.run.solution.x[1],t.run.solution.x[2]);
 std::print("Swaps {}; accepted pivots {}; coefficient updates {}; events {}; actual retained {}; whole bound {}.\n",t.run.work.row_swaps,t.run.accepted_pivots,t.run.work.coefficient_updates,t.events.size(),t.captured_entries,dm::algorithms::gaussian_elimination_trace_entries(3));
 std::print("Widened residual infinity norm {:.6Le}; normwise infinity backward error {:.6Le}; observed coefficient growth {:.6Lf}.\n",r.residual_inf,r.backward_error,t.run.growth);
 dm::graphics::Diagram d(68,1050);
 for(std::size_t side=0;side<2;++side){const auto& a=side?t.run.upper:f.a;const auto& b=side?t.run.rhs:f.b;const double offset=side?9.:0.;
  d.text({offset+1.8,1.25},side?"Actual [U | c]":"Original [A | b]",25);
  for(std::size_t i=0;i<3;++i){for(std::size_t j=0;j<3;++j)d.text({offset+1.2*double(j),-double(i)},std::format("{:.3f}",a[i][j]),22);d.text({offset+4.3,-double(i)},std::format("{:.3f}",b[i]),22,{37,99,235});}
 }
 d.text({6.3,-3.15},std::format("Original row order after reduction: {}",t.run.row_order),24).save_svg("build/gaussian_original.svg");
 if(!t.run.solution.solved||r.residual_inf>1e-12L||t.run.row_order!=std::vector<std::size_t>{1,2,0})throw std::runtime_error("original fixture");
}
