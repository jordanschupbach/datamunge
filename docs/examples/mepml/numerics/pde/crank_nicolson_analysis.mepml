\image(figures/crank_nicolson_space.svg)
// result_end
\caption(Each refinement doubles nx+1 and halves h. The modal spatial error ratios approach four; the actual solver remains close with the small fixed time step.)
\alttext(Actual maximum PDE error rises nearly linearly with squared spatial spacing across five grid sizes, illustrating second-order spatial behavior.)

For time refinement, fix nx=31 and compare the actual solution with the exact
semidiscrete reference. Comparing only to the continuous PDE would eventually
reach a spatial floor, and the two signed error contributions can also cancel.
The next table reports both errors rather than inferring temporal order from
their sum.

```{cpp, results="markdown", file="figures/crank_nicolson_time.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
  std::filesystem::create_directories("build");
  std::vector<double> squared_step,errors;
  std::print("| steps | tau | actual error against semidiscrete | previous/current temporal error | actual error against continuous PDE |\n| ---: | ---: | ---: | ---: | ---: |\n");
  double previous=0;
  for(const int steps:{10,20,40,80,160}) {
    const double dt=.1/steps;
    const auto m=dm::algorithms::heat_sine_mode(1,1,31,1,dt,steps);
    const auto u=dm::algorithms::crank_nicolson_heat([](double x){return std::sin(std::acos(-1.)*x);},1,1,31,dt,steps);
    const auto time=dm::algorithms::heat_profile_error(u,m.semidiscrete);
    const auto pde=dm::algorithms::heat_profile_error(u,m.continuous);
    const auto ratio=previous?previous/time:0.;
    if(previous && (ratio<3.98 || ratio>4.02)) return 1;
    std::print("| {} | {:.7f} | {:.6e} | {:.6f} | {:.6e} |\n",steps,dt,time,ratio,pde);
    squared_step.push_back(dt*dt);errors.push_back(time);previous=time;
  }
  auto plot=dm::graphics::RPlot::create();
  plot.line(squared_step,errors,"temporal error",{234,88,12},2)
      .points(squared_step,errors,"",{234,88,12},4)
      .title("Time refinement: compare against the semidiscrete solution")
      .x_label("tau squared, fixed nx=31").y_label("maximum absolute temporal error at t=0.1")
      .x_ticks({0,.000025,.00005,.000075,.0001},{"0","2.5e-5","5e-5","7.5e-5","1e-4"})
      .y_ticks({0,.0001,.0002,.0003},{"0","1e-4","2e-4","3e-4"})
      .x_limits(0,.000106).y_limits(0,.00032).size(900,560)
      .save_svg("build/crank_nicolson_time.svg");
  bool capped=false,invalid=false;
  int callbacks=0;
  try { (void)dm::algorithms::crank_nicolson_heat_trace([&](double){++callbacks;return 1.;},1,1,1,1,2,10); }
  catch(const std::length_error&) { capped=true; }
  try { (void)dm::algorithms::crank_nicolson_heat([](double){return 1.;},1,-1,1,.1,1); }
  catch(const std::invalid_argument&) { invalid=true; }
  if(!capped || !invalid || callbacks) return 1;
  std::print("\nComplete trace cap rejects before sampling; negative diffusivity rejects: pass.\n");
}
```
