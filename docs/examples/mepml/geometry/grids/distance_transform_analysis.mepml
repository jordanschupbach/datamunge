> Measure the sweep work at different site densities

Fix a grid of R=n rows and C=2n columns. With one site, exactly one
column has a finite vertical envelope. The column pass considers that
single seed, and every row then has one finite candidate. Therefore
finite_candidates=R+1, intersections=0 and evaluations=N+R.
Most column lines contain no finite candidate, but their input scans
still count toward the total 2N values.

With every cell marked, all line costs are zero. Candidates enter in
order without pops. The exact counts become finite_candidates=2N,
intersections=selection_advances=2N−R−C and evaluations=2N.
The program checks those identities at six sizes. Plotting actual counts
per cell makes the bounded work visible; the horizontal axis uses log2(N)
to show all sizes. These are logical sweep counts, not timing or allocation
benchmarks. Finite samples, hull peaks, inspections and output initialization
are distinct quantities.

```{cpp, results="markdown", file="figures/edt_linear_work.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main(){
  std::filesystem::create_directories("build");
  std::vector<double> x,single_eval,dense_eval,single_cross,dense_cross;
  std::print("| rows | columns | pattern | cells | inputs | finite candidates | intersections | evaluations | peak envelope |\n| ---: | ---: | :--- | ---: | ---: | ---: | ---: | ---: | ---: |\n");
  for(std::size_t rows:{8u,16u,32u,64u,128u,256u}){const std::size_t cols=2*rows,cells=rows*cols;x.push_back(std::log2(cells));
    for(bool dense:{false,true}){const auto grid=dense?std::vector<std::vector<char>>(rows,std::vector<char>(cols,1)):dm::geometry::distance_site_grid(rows,cols,{{rows/2,cols/2}});
      const auto t=dm::geometry::euclidean_distance_transform_trace(grid);const auto& w=t.work;
      if(w.input_values!=2*cells || w.finite_candidates!=(dense?2*cells:rows+1) || w.intersections!=(dense?2*cells-rows-cols:0) || w.evaluations!=(dense?2*cells:cells+rows))return 1;
      std::print("| {} | {} | {} | {} | {} | {} | {} | {} | {} |\n",rows,cols,dense?"all sites":"one site",cells,w.input_values,w.finite_candidates,w.intersections,w.evaluations,w.max_envelope_size);
      (dense?dense_eval:single_eval).push_back(static_cast<double>(w.evaluations)/cells);(dense?dense_cross:single_cross).push_back(static_cast<double>(w.intersections)/cells);
    }
  }
  auto p=dm::graphics::RPlot::create(),q=dm::graphics::RPlot::create();
  p.line(x,single_eval,"one site",{37,99,235}).points(x,single_eval,"",{37,99,235},5).line(x,dense_eval,"all sites",{220,38,38}).points(x,dense_eval,"",{220,38,38},5).title("Finite evaluations per cell").x_label("log2(number of grid cells)").y_label("actual evaluations / cells").y_limits(-.1,2.8);
  q.line(x,single_cross,"one site",{37,99,235}).points(x,single_cross,"",{37,99,235},5).line(x,dense_cross,"all sites",{220,38,38}).points(x,dense_cross,"",{220,38,38},5).title("Envelope comparisons per cell").x_label("log2(number of grid cells)").y_label("actual intersections / cells").y_limits(-.1,2.8);
  dm::graphics::RLayout::create(1,2).add(p).add(q).size(1100,520).title("Measured sweep counts stay bounded per cell at both site densities").fit_panels().save_svg("build/edt_linear_work.svg");
}
