//? Title: Delaunay Triangulation: Exact Circles, Actual Cavities and Unavoidable Thin Triangles
//? Subtitle: The original square and seeded cloud, symbolic hull boundaries, Euler counts and checked work
//? Exports: both
//? Lang: en-GB

\abstract(
Triangulating planar sites means covering their convex hull with noncrossing
triangles whose vertices are the supplied points. Delaunay triangulation
adds the requirement that no other site lie strictly inside any triangle's
circumcircle. We begin with the original square-plus-centre and show the
actual cavity removed when its centre is inserted. The original seeded
30-point cloud follows, with complete topology counts and exact circle
queries. A narrow three-point counterexample corrects both a missing-face
bug in the finite-super-triangle implementation and the report's claim that
Delaunay triangles cannot be thin. The replacement uses a symbolic hull
boundary and exact determinant signs for stored binary64 coordinates.
Measured insertion scans, independent rational controls and explicit
resource limits distinguish logical correctness from floating angle diagnostics.
)

\toc

> Insert the square's centre into the actual cavity

The original sites are (0,0), (4,0), (4,4), (0,4) and (2,2), with input ids
zero through four. Before the centre is inserted, the square has two
triangles. Its four corners lie on (x−2)²+(y−2)²=8, so the centre lies
strictly inside both circumcircles. The native trace records those two
removed faces, their four nonshared boundary edges, and the four new fan
triangles. The left panel draws the actual removed faces and this known
square circle; the right draws the native final mesh. Ghost boundary
records never appear as invented geometric coordinates.

```{cpp, results="markdown", file="figures/delaunay_cavity.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
  std::filesystem::create_directories("build");
  const std::vector<dm::geometry::Point2D> p{{0,0},{4,0},{4,4},{0,4},{2,2}};
  const auto t=dm::geometry::delaunay_trace(p);const auto& e=t.steps.back();const auto a=dm::geometry::delaunay_analyze(p,t.triangles);
  if(e.input_index!=4 || e.removed.size()!=2 || e.boundary.size()!=4 || t.triangles.size()!=4 || a.interior_violations)return 1;
  dm::graphics::Diagram d(85,1100);dm::graphics::DiagramStroke line;line.color={100,116,139};line.width=2;
  dm::graphics::DiagramStroke circle;circle.color={148,163,184};circle.width=2;circle.dashed=true;
  d.ellipse({2,2},std::sqrt(8.),std::sqrt(8.),{255,255,255,0},circle);
  const std::vector<std::vector<dm::geometry::Triangle>> panels{e.removed,t.triangles};
  for(std::size_t k=0;k<panels.size();++k) {
    const double shift=7.*k;
    for(const auto f:panels[k]) {
      if(f.c>=p.size())return 1;
      d.polygon({{p[f.a].x+shift,p[f.a].y},{p[f.b].x+shift,p[f.b].y},{p[f.c].x+shift,p[f.c].y}},k?dm::graphics::RGB{219,234,254}:dm::graphics::RGB{254,226,226},line);
    }
    for(std::size_t i=0;i<p.size();++i) {
      const auto color=i==4?dm::graphics::RGB{220,38,38}:dm::graphics::RGB{37,99,235};
      d.ellipse({p[i].x+shift,p[i].y},.055,.055,color).text({p[i].x+shift,p[i].y+(i<2?-.25:.25)},std::format("{}",i),18);
    }
  }
  d.text({2,5.3},"Before: two actual conflicting faces",21).text({9,5.3},"After: four native fan triangles",21)
   .text({5.5,-1.35},std::format("Insert site {}; remove {} faces; retain {} cavity edges; create {} faces",e.input_index,e.removed.size(),e.boundary.size(),e.added.size()),22)
   .save_svg("build/delaunay_cavity.svg");
  std::print("| original fan face | exact orientation sign | other-site circle queries |\n| :--- | ---: | ---: |\n");
  for(const auto f:t.triangles)std::print("| ({},{},{}) | {} | {} |\n",f.a,f.b,f.c,dm::geometry::orientation_sign(p[f.a],p[f.b],p[f.c]),p.size()-3);
  std::print("\nSquare control: u={}, boundary h={}, edges={}, triangles={}, Euler prediction={}, exact circle tests={}, interior violations={}.\n",a.distinct_points,a.boundary_edges,a.edges,a.triangles,2*a.distinct_points-2-a.boundary_edges,a.circle_tests,a.interior_violations);
  std::print("Centre cavity: input {}, live faces before {}, after {}; removed {}, boundary {}, added {}.\n",e.input_index,e.faces_before,e.faces_after,e.removed.size(),e.boundary.size(),e.added.size());
}
