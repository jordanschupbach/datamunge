> Original examples: seven square points and the unsnapped cloud

The original seven-point example returns (0,0), (4,0), (4,4), (0,4), excluding
its three interior points. Its source identities are 0,1,2,3. For the random
example, sample_gaussian_points preserves the original local mt19937 seed
20240728 and normal_distribution call order, drawing x then y from the same
cached distribution. It does not use the separate PointCloud::Gaussian generator,
which uses a different engine and rounds coordinates to a grid.

```{cpp, results="markdown", file="figures/convex_hull.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
  std::filesystem::create_directories("build");
  const auto square=dm::geometry::convex_hull_analyze({{0,0},{4,0},{4,4},{0,4},{2,2},{1,3},{3,1}});
  std::print("| original square vertex | earliest input index |\n| :--- | ---: |\n");
  for(std::size_t i=0;i<square.hull.size();++i)
    std::print("| ({:.0f},{:.0f}) | {} |\n",square.hull[i].x,square.hull[i].y,square.input_indices[i]);
  const auto cloud=dm::geometry::sample_gaussian_points();
  const auto a=dm::geometry::convex_hull_analyze(cloud);
  std::print("\nOriginal cloud: {} points -> {} hull vertices.\n\n",cloud.size(),a.hull.size());
  std::print("| hull order | input index | x | y |\n| ---: | ---: | ---: | ---: |\n");
  for(std::size_t i=0;i<a.hull.size();++i)
    std::print("| {} | {} | {:.6f} | {:.6f} |\n",i,a.input_indices[i],a.hull[i].x,a.hull[i].y);
  dm::graphics::Diagram d(125,900);
  dm::graphics::DiagramStroke edge;edge.color={37,99,235};edge.width=2;
  std::vector<dm::graphics::DiagramPoint> outline;
  for(const auto& p:a.hull) outline.push_back({p.x,p.y});
  d.polygon(outline,{37,99,235,.05},edge);
  for(const auto& p:cloud) d.ellipse({p.x,p.y},.035,.035,{100,116,139},edge);
  for(const auto& p:a.hull) d.ellipse({p.x,p.y},.055,.055,{220,38,38},edge);
  const auto [low,high]=std::minmax_element(cloud.begin(),cloud.end(),[](auto p,auto q){return p.y<q.y;});
  const auto [left,right]=std::minmax_element(cloud.begin(),cloud.end(),[](auto p,auto q){return p.x<q.x;});
  const double centre=(left->x+right->x)/2;
  d.text({centre,high->y+.8},"Original 40-point normal cloud",22)
   .text({centre,low->y-.65},"Red: hull vertices; grey: original samples",18)
   .save_svg("build/convex_hull.svg");
}
