//? Title: De Casteljau: Actual Bézier Triangles, Subdivision and Conditioning
//? Subtitle: The original cubic, executable subcurves, controlled perturbations and checked quadratic work
//? Exports: both
//? Lang: en-GB

\abstract(
A Bézier curve turns a short sequence of control points into a smooth
parametric path. Evaluating the path and splitting it into smaller pieces
should preserve its geometry, including its endpoints. De Casteljau's
algorithm does both through repeated linear interpolation. We begin with
the original four controls and their complete midpoint triangle, now
captured directly by the native evaluator. Reusable subdivision produces
two control nets whose local parameters map back to the same original
curve. Controlled perturbations explain absolute sensitivity without
promising small relative error near cancellation. Actual blend counts,
complete triangle/output/work caps and independent Bernstein checks make
the report executable beyond its original hand-reconstructed scaffold.
)

\toc

> The original cubic, with every actual midpoint row

The controls are (0,0), (1,2), (3,3) and (4,0). At t=1/2, the first
interpolation row has three points, the second two, and the last one:
B(1/2)=(2,1.875). The complete table below comes from the native evaluator's
actual updates. The report does not reimplement the recurrence to reconstruct
those rows. The curve's 101 display samples also come from the core sampler,
which includes both requested parameter endpoints without repeated step addition.
The native diagram uses equal horizontal and vertical geometric scales.

```{cpp, results="markdown", file="figures/de_casteljau.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
  std::filesystem::create_directories("build");
  const std::vector<dm::algorithms::PlanarPoint> control{{0,0},{1,2},{3,3},{4,0}};
  const auto a=dm::algorithms::de_casteljau_trace(control,.5);const auto curve=dm::algorithms::de_casteljau_sample(control);
  if(a.point.x!=2 || a.point.y!=1.875 || a.point_blends!=6 || curve.size()!=101)return 1;
  dm::graphics::Diagram d(170,1100);const std::vector<dm::graphics::RGB> colors{{37,99,235},{22,163,74},{234,88,12},{202,138,4}};
  std::vector<dm::graphics::DiagramPoint> hull;for(const auto& p:control)hull.push_back({p.x,p.y});
  dm::graphics::DiagramStroke boundary;boundary.color={203,213,225};boundary.width=1;d.polygon(hull,{239,246,255},boundary);
  std::vector<dm::graphics::DiagramPoint> path;for(const auto& p:curve)path.push_back({p.x,p.y});
  dm::graphics::DiagramStroke red;red.color={220,38,38};red.width=3;d.path(path,red);
  std::print("| level r | row index i | actual x | actual y |\n| ---: | ---: | ---: | ---: |\n");
  for(std::size_t r=0;r<a.levels.size();++r) {
    std::vector<dm::graphics::DiagramPoint> points;for(const auto& p:a.levels[r])points.push_back({p.x,p.y});
    dm::graphics::DiagramStroke line;line.color=colors[r];line.width=2;
    if(points.size()>1)d.path(points,line);for(const auto& p:points)d.ellipse(p,r==3?.05:.035,r==3?.05:.035,colors[r],line);
    for(std::size_t i=0;i<a.levels[r].size();++i)std::print("| {} | {} | {} | {} |\n",r,i,a.levels[r][i].x,a.levels[r][i].y);
  }
  d.text({2,3.8},"Original cubic: four controls become three points, two, then B(1/2)",22)
   .text({0,-.2},"P0=(0,0)",18).text({.7,2.2},"P1=(1,2)",18).text({3.2,3.2},"P2=(3,3)",18).text({4,-.2},"P3=(4,0)",18)
   .text({2,.9},std::format("B(1/2)=({},{})",a.point.x,a.point.y),20)
   .text({2,-.75},"Blue controls; green row 1; orange row 2; gold final point; red curve",21)
   .save_svg("build/de_casteljau.svg");
  std::print("\nOriginal endpoints: B(0)={}; B(1)={}. Midpoint {}. Actual point blends {}; stored points {}; curve samples {}.\n",dm::algorithms::de_casteljau(control,0),dm::algorithms::de_casteljau(control,1),a.point,a.point_blends,a.shape.stored_points,curve.size());
}
