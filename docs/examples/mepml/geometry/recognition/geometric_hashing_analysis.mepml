> More votes can select a worse geometric candidate

Keep that exact scene and tolerance, changing only q. With q=0.5 the selected
candidate has eight votes but only two of six inliers, although the correct model
copy is still present. Coarser bins merge unrelated invariant coordinates. A vote
is a bucket-record hit, not an independent matched point or an inlier certificate.
Increasing q does not monotonically improve recognition. found=true here means
that a vote-qualified transform was recovered; callers need their own geometric
acceptance rule. This native variant does not retry lower-vote candidates.

```{cpp, results="markdown", file="figures/gh_quantization.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <datamunge/geometry/geometric_hashing.hpp>
#include <datamunge/plot/diagram.hpp>
#include <algorithm>
#include <array>
#include <cmath>
#include <filesystem>
#include <limits>
#include <numbers>
#include <print>
namespace dm=datamunge;
int main(){
 std::filesystem::create_directories("build");
 const std::vector<dm::geometry::Point2D> model{{0,0},{2,0},{1,1.5},{2.2,1.1},{.5,-.7},{-.4,.9}};auto scene=dm::geometry::geometric_transform(model,1.7,.9,{12,-8});for(auto p:std::vector<dm::geometry::Point2D>{{-30,-20},{-25,-34},{-38,-12},{-20,-28}})scene.push_back(p);
 std::vector<double> qx,votes,inliers;std::print("| q | occupied bins | selected votes | inliers | candidate found | actual vote updates | recovered candidates |\n| ---: | ---: | ---: | ---: | --- | ---: | ---: |\n");
 for(double q:std::array<double,8>{.025,.05,.1,.25,.5,1,2,4}){const auto table=dm::geometry::build_geometric_hash(model,q);const auto r=dm::geometry::recognize_run(table,model,scene,1e-4,2);std::print("| {:.3f} | {} | {} | {} | {} | {} | {} |\n",q,table.bins.size(),r.match.votes,r.match.inliers,r.match.found,r.work.vote_updates,r.work.recoveries);qx.push_back(std::log2(q));votes.push_back(r.match.votes);inliers.push_back(r.match.inliers);}
 const std::vector<dm::geometry::Point2D> repeated{{0,0},{2,0},{0,1},{0,1}},smallscene{{0,0},{2,0},{0,1}};const auto d=dm::geometry::recognize(dm::geometry::build_geometric_hash(repeated,.25),repeated,smallscene,0,1);
 std::print("\nDuplicate-point model: {} model points, {} scene points, {} inliers; candidate found {}. Several model points may use the same scene point.\n",repeated.size(),smallscene.size(),d.inliers,d.found);
 auto v=dm::graphics::RPlot::create();v.lines(qx,votes,"Votes",{37,99,235},2).points(qx,votes,"",{37,99,235},5).title("Selected vote count").xlab("log2 invariant bin width q").ylab("Bucket-record votes").y_limits(0,1.2 * *std::max_element(votes.begin(),votes.end()));
 auto i=dm::graphics::RPlot::create();i.lines(qx,inliers,"Inliers",{220,38,38},2).points(qx,inliers,"",{220,38,38},5).title("Geometric verification").xlab("log2 invariant bin width q").ylab("First-hit model inliers").y_limits(0,7);
 dm::graphics::RLayout::create(1,2).add(v).add(i).size(1100,520).title("Coarser bins can increase votes while losing the correct alignment").fit_panels().save_svg("build/gh_quantization.svg");
 if(inliers[4]!=2||votes[4]!=8||d.inliers!=4)throw std::runtime_error("coarse-bin and many-to-one counterexamples");
}
