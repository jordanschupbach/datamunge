> The retained original experiment

```{cpp, results="markdown", file="figures/todd_coxeter_original.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    struct G {
        std::string name;
        int generators;
        std::vector<std::vector<int>> relations;
        long long expected;
    };
    const std::vector<G> groups{{"C6", 1, {std::vector<int>(6, 1)}, 6},
                                {"S3", 2, {{1, 1}, {2, 2, 2}, {1, 2, 1, 2}}, 6},
                                {"D4", 2, {{1, 1, 1, 1}, {2, 2}, {1, 2, 1, 2}},
                                 8},
                                {"A4", 2,
                                 {{1, 1}, {2, 2, 2}, {1, 2, 1, 2, 1, 2}}, 12},
                                {"S4", 2,
                                 {{1, 1}, {2, 2, 2}, {1, 2, 1, 2, 1, 2, 1, 2}},
                                 24},
                                {"A5", 2,
                                 {{1, 1}, {2, 2, 2},
                                  {1, 2, 1, 2, 1, 2, 1, 2, 1, 2}}, 60}};
    std::vector<double> y;
    std::vector<std::string> labels;
    std::print("| original group | actual closed index | mathematical reference | actual definitions | " "coincidences |\n| --- | ---: | ---: | ---: | ---: |\n");
    for (const auto &g : groups) {
        auto r = a::todd_coxeter_run(g.generators, g.relations, {});
        if (!r.closed)
            throw std::runtime_error(r.stop);
        labels.push_back(g.name);
        y.push_back(r.index);
        std::print("| {} | {} | {} | {} | {} |\n", g.name, r.index, g.expected,
                   r.definitions, r.coincidences);
    }
    auto subgroup =
        a::todd_coxeter_run(1, {std::vector<int>(12, 1)},
                            {std::vector<int>(4, 1)});
    std::print("Original[C12:<a^4>] actual index {}, expected4.\n",
               subgroup.index);
    auto chart =
        g::RPlot::barplot(y, labels, "actual closed group index", {124, 58, 237});
    chart.title("Original finite presentations: actual closed coset counts").x_label("group").y_label("closed index over trivial subgroup");
    chart.save_svg("build/todd_coxeter_original.svg");
}
```
