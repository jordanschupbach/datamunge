> Explicit controls

```{cpp, results="markdown", file="figures/todd_coxeter_controls.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    std::vector<double> x, y;
    std::print("| total definition cap | closed | actual stop | actual index | ever defined |\n| ---: | --- " "| --- | ---: | ---: |\n");
    for (std::size_t cap : {1, 2, 3, 4, 8, 16}) {
        a::ToddOptions o;
        o.max_cosets = cap;
        auto r = a::todd_coxeter_run(1, {{1, 1, 1}}, {}, o);
        x.push_back(cap);
        y.push_back(r.definitions);
        std::print("| {} | {} | {} | {} | {} |\n", cap, r.closed, r.stop,
                   r.index, r.definitions);
    }
    auto plot = g::RPlot::create();
    plot.lines(x, y, "actual native values", {37, 99, 235}).points(
        x, y, {37, 99, 235}, 4).title("Definition caps retain explicit unresolved status").x_label("ever-defined row cap").y_label("actual rows defined");
    plot.save_svg("build/todd_coxeter_controls.svg");
}
```
