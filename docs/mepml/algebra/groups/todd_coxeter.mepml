int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    std::vector<double> x, y;
    std::print("| cyclic order reference | actual closed index | actual word scans | actual symbol " "transitions | selected operations |\n| ---: | ---: | ---: | ---: | ---: |\n");
    for (int n : {2, 3, 4, 6, 8, 12, 16, 24, 32}) {
        auto r = a::todd_coxeter_run(1, {std::vector<int>(n, 1)}, {});
        x.push_back(n);
        y.push_back(r.operations);
        std::print("| {} | {} | {} | {} | {} |\n", n, r.index, r.word_scans,
                   r.symbol_visits, r.operations);
    }
    auto plot = g::RPlot::create();
    plot.lines(x, y, "actual native values", {37, 99, 235}).points(
        x, y, {37, 99, 235}, 4).title("Actual HLT work on controlled cyclic presentations").x_label("cyclic order reference").y_label("actual selected kernel events");
    plot.save_svg("build/todd_coxeter_work.svg");
}
