//? Title: Posterior predictive checks for Poisson counts
//? Exports: both
//? Lang: en-GB

\abstract(
The Gamma-Poisson model predicts a homogeneous rate across 15 unit exposures. Fit the
rate using the observed total. For each replicated dataset, sample one rate from its
posterior and generate 15 counts conditional on that rate. The maximum and the number
of zeros check different features of the replicated distribution. A concentration of
zeros and an extreme observed maximum can both be difficult for a homogeneous Poisson
process to reproduce.
)

> Reproducible analysis

```{cpp, results="markdown", file="figures/poisson_replication.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>


namespace b = datamunge::bayes;
using datamunge::graphics::RPlot;


int main() {
    const std::vector<int> y{0, 0, 0, 1, 0, 2, 0, 1, 0, 11, 0, 1, 0, 3, 0};
    const int total = std::accumulate(y.begin(), y.end(), 0);
    const int observed_zeros = std::count(y.begin(), y.end(), 0);
    const int observed_max = *std::max_element(y.begin(), y.end());
    std::mt19937_64 rng(42);
    std::gamma_distribution<double> posterior_rate(2 + total, 1. / (1 + y.size()));
    constexpr int replications = 5000;
    std::vector<double> zeros, maxima;
    for (int replication = 0; replication < replications; ++replication) {
        std::poisson_distribution<int> count(posterior_rate(rng));
        int maximum = 0, n_zero = 0;
        for (std::size_t i = 0; i < y.size(); ++i) {
            const int value = count(rng);
            maximum = std::max(maximum, value);
            n_zero += value == 0;
        }
        zeros.push_back(n_zero);
        maxima.push_back(maximum);
    }
    const auto upper_tail = [](const auto& replicates, int observed) {
        return std::count_if(replicates.begin(), replicates.end(), [observed](double statistic) {
            return statistic >= observed;
        }) / static_cast<double>(replicates.size());
    };
    std::print("Observed zeros {}. Replicated proportion at least as large {:.3f}.\n\n"
               "Observed maximum {}. Replicated proportion at least as large {:.3f}.\n",
               observed_zeros, upper_tail(zeros, observed_zeros),
               observed_max, upper_tail(maxima, observed_max));
    const auto panel = [](const auto& draws, int observed, const char* label) {
        const int high = std::max(observed, static_cast<int>(*std::max_element(draws.begin(), draws.end())));
        std::vector<double> x(high + 1), mass(high + 1);
        std::iota(x.begin(), x.end(), 0.);
        for (const double value : draws) mass[static_cast<int>(value)] += 1. / draws.size();
        return RPlot::create().segments(x, std::vector<double>(x.size()), x, mass, {36, 105, 172}, 2)
            .lines({double(observed), double(observed)}, {0, *std::max_element(mass.begin(), mass.end())},
                   "observed", {182, 83, 29})
            .title(label).x_label("Statistic").y_label("Replicated probability");
    };
    std::filesystem::create_directories("build");
    const double expected = (2. + total) / (1 + y.size());
    std::vector<double> index(y.size());
    std::iota(index.begin(), index.end(), 1.);
    auto fit = RPlot::create().points(index, {y.begin(), y.end()}, "observed", {70, 70, 70})
        .lines({index.front(), index.back()}, {expected, expected},
               "posterior expected count", {36, 105, 172})
        .title("Homogeneous Poisson fit").x_label("Exposure").y_label("Count");
    datamunge::graphics::RLayout::create(1, 3).size(1200, 400)
        .add(fit)
        .add(panel(zeros, observed_zeros, "Number of zero counts"))
        .add(panel(maxima, observed_max, "Maximum count"))
        .save_svg("build/poisson_replication.svg");
}
```
