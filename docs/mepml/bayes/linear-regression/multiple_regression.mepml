//? Title: Bayesian multiple linear regression
//? Exports: both
//? Lang: en-GB

\abstract(
A Normal observation model with a common residual scale gives the OLS criterion for
the coefficient maximum likelihood estimate. The Bayesian fit adds independent
Normal(0, 5) priors on coefficients and a Normal(0, 1) prior on log residual SD. The
posterior table compares coefficient intervals with the OLS point estimate. The fit
plot compares observed outcomes with posterior expectations for the original rows.
)

> Reproducible analysis

```{cpp, results="markdown", file="figures/multiple_regression.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>


namespace b = datamunge::bayes;
using datamunge::autodiff::Var;
using datamunge::graphics::RPlot;


int main() {
    const std::vector<double> x{-3,-2,-1,0,1,2,3,4,5,6};
    const std::vector<double> z{1,-1,0,1,-1,0,1,-1,0,1};
    const std::vector<double> y{0.5,-0.2,1.3,3.4,2.5,3.1,5.4,4.8,6.3,7.8};
    datamunge::Mat<> design(y.size(), 2);
    for (std::size_t i = 0; i < y.size(); ++i) {
        design(i, 0) = x[i];
        design(i, 1) = z[i];
    }
    const datamunge::stats::LM ols(y, design);
    b::AutodiffModel model([&](auto& tape, const auto& q) {
        auto lp = b::normal_lpdf(q.back(), 0, 1);
        for (std::size_t j = 0; j + 1 < q.size(); ++j)
            lp = lp + b::normal_lpdf(q[j], 0, 5);
        const auto sigma = exp(q.back());
        for (std::size_t i = 0; i < y.size(); ++i)
            lp = lp + b::normal_lpdf(Var(tape, y[i]), q[0] + q[1] * x[i] + q[2] * z[i], sigma);
        return lp;
    });
    const auto chains = b::NUTS({.target_accept_rate = 0.92}).sample_chains(model, {0., 0., 0., 0.}, 4);
    std::vector<double> coefficients;
    std::print("| Coefficient | OLS | Posterior mean | 90% interval | Split R-hat | ESS |\n"
               "| --- | ---: | ---: | ---: | ---: | ---: |\n");
    for (std::size_t j = 0; j < ols.coefficients().size(); ++j) {
        const auto s = b::summarize_draws(b::chains_of(chains, j));
        coefficients.push_back(s.mean);
        std::print("| {} | {:.2f} | {:.2f} | [{:.2f}, {:.2f}] | {:.3f} | {:.0f} |\n",
                   j, ols.coefficients()[j], s.mean, s.q05, s.q95, s.rhat, s.ess);
    }
    std::println("");

    std::size_t divergences = 0;
    for (const auto& chain : chains)
        divergences += std::accumulate(chain.divergent.begin(), chain.divergent.end(), 0);
    std::print("Post-warmup divergences: {}.\n", divergences);

    std::vector<double> fitted;
    for (std::size_t i = 0; i < y.size(); ++i)
        fitted.push_back(coefficients[0] + coefficients[1] * x[i] + coefficients[2] * z[i]);
    const auto [low, high] = std::minmax_element(y.begin(), y.end());
    std::filesystem::create_directories("build");
    RPlot::create().lines({*low, *high}, {*low, *high}, "identity", {140, 140, 140})
        .points(fitted, y, "observations", {36, 105, 172})
        .title("Observed versus fitted response").x_label("Posterior expected response").y_label("Observed response")
        .save_svg("build/multiple_regression.svg");
}
```
