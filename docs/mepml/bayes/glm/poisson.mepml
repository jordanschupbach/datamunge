//? Title: Poisson log-linear regression
//? Exports: both
//? Lang: en-GB

\abstract(
Counts have mean and variance exp(intercept + slope × predictor). Exponentiating the
slope gives the multiplicative change in the expected count per unit of the predictor. The trace plot shows the first 250 retained slope draws from each chain.
)

> Reproducible analysis

```{cpp, results="markdown", file="figures/poisson.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>


namespace b = datamunge::bayes;
using datamunge::graphics::RPlot;

int main() {
    const std::vector<double> x{-2,-2,-2,-1,-1,-1,0,0,0,1,1,1,2,2,2};
    const std::vector<double> y{0,1,1,0,2,1,1,2,3,2,5,4,6,4,7};
    b::AutodiffModel model([&](auto&, const auto& q) {
        auto lp = b::normal_lpdf(q[0], 0, 1.5) + b::normal_lpdf(q[1], 0, 1);

        for (std::size_t i = 0; i < y.size(); ++i) {
            const auto eta = q[0] + q[1] * x[i];
            lp = lp + b::poisson_log_lpmf(y[i], eta);
        }
        return lp;
    });
    const auto chains = b::NUTS({.target_accept_rate = 0.9}).sample_chains(model, {0., 0.}, 4);
    const auto slope = b::summarize_draws(b::chains_of(chains, 1));
    std::print("Slope {:.2f}, 90% interval [{:.2f}, {:.2f}], split R-hat {:.3f}, ESS {:.0f}.\n",
               slope.mean, slope.q05, slope.q95, slope.rhat, slope.ess);

    std::size_t divergences = 0;
    for (const auto& chain : chains)
        divergences += std::accumulate(chain.divergent.begin(), chain.divergent.end(), 0);
    std::print("Post-warmup divergences: {}.\n", divergences);

    std::vector<double> grid, fitted, lo, hi, observed;
    for (std::size_t i = 0; i < y.size(); ++i) observed.push_back(y[i]);
    for (int i = -20; i <= 20; ++i) {
        const double xi = i / 10.0;
        const auto means = b::chains_of(chains, [xi](const auto& q) {
            const double eta = q[0] + q[1] * xi;
            return std::exp(eta);
        });
        const auto interval = b::summarize_draws(means);
        grid.push_back(xi);
        fitted.push_back(interval.mean);
        lo.push_back(interval.q05);
        hi.push_back(interval.q95);
    }
    std::filesystem::create_directories("build");
    auto fit = RPlot::create();
    fit.points(x, observed, "observed", {70, 70, 70})
        .lines(grid, fitted, "posterior mean", {36, 105, 172})
        .lines(grid, lo, "90% interval limits", {114, 166, 216})
        .lines(grid, hi, datamunge::graphics::RGBA{114, 166, 216})
        .title("Response versus predictor").x_label("Predictor").y_label("Response");

    auto trace = RPlot::create();
    const std::vector<datamunge::graphics::RGBA> colours{
        {36, 105, 172}, {182, 83, 29}, {35, 125, 89}, {122, 73, 154}
    };
    auto slopes = b::chains_of(chains, 1);
    std::vector<double> draw(250);
    std::iota(draw.begin(), draw.end(), 1.);
    for (std::size_t j = 0; j < slopes.size(); ++j) {
        slopes[j].resize(draw.size());
        trace.lines(draw, slopes[j], std::format("chain {}", j + 1), colours[j], 1);
    }
    trace.title("Slope trace").x_label("Retained draw").y_label("Log rate slope");
    datamunge::graphics::RLayout::create(1, 2).add(fit).add(trace).save_svg("build/poisson.svg");
}
```
// result_begin: markdown
