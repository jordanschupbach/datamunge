//? Title: Empirical variogram
//? Exports: both
//? Lang: en

> Estimate how dissimilarity grows with separation, by lag and by direction, and see how the estimator responds to outliers and anisotropy

The semivariogram \(\gamma(h)=\tfrac12E[(Z(s+h)-Z(s))^2]\) describes spatial dependence through dissimilarity. It starts near the nugget \(\gamma(0^+)\), which covers measurement error and micro-scale variation, and rises until the values are uncorrelated, where it levels off at the sill, the total variance, at about the range. The empirical variogram estimates it from point pairs grouped into lag bins:

\[
\hat\gamma(h_k)=\frac{1}{2|N(h_k)|}\sum_{(i,j)\in N(h_k)}(z_i-z_j)^2,
\]

where \(N(h_k)\) holds the pairs whose separation falls in bin \(k\). Squared differences are sensitive to outliers, so Cressie and Hawkins proposed a robust alternative based on the mean of \(|z_i-z_j|^{1/2}\). A directional variogram uses only the pairs whose separation vector points within a tolerance of a given azimuth. It reveals anisotropy, where dependence extends further in some directions than in others.

`empirical_variogram` returns, for each bin, the mean pair distance, the semivariance and the pair count. It supports explicit or regular lag boundaries, any set of directions with an angular tolerance, and both estimators. The tests reproduce `gstat::variogram` on the meuse log-zinc data for regular and irregular bins, four directions, narrow tolerances and the Cressie estimator.

The study uses 200 random points in a \(20\times20\) square and a Gaussian field with nugget 0.1, partial sill 1 and exponential correlation \(e^{-h/3}\). The true variogram is therefore \(\gamma(h)=0.1+(1-e^{-h/3})\). Over 300 fields, the table compares the mean and SD of each estimator per lag with the truth, on clean data and with 5% of the values contaminated by \(+4\). The figure uses a geometrically anisotropic field instead, with range 6 along azimuth 45° and 2 along 135°. It shows directional variograms averaged over 100 fields with their true curves.

```{cpp, id=vgm, file="figures/empirical_variogram.svg", results="markdown", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <datamunge/plot/plot.hpp>
#include <datamunge/random/random.hpp>
#include <datamunge/stats/geostatistics.hpp>

#include <cmath>
#include <filesystem>
#include <functional>
#include <numbers>
#include <print>
#include <vector>

namespace dm = datamunge;
using Matrix = dm::linalg::DenseMatrix<double>;
using Correlation = std::function<double(double dx, double dy)>;

// Gaussian field: nugget + partial sill 1 with the given correlation, by Cholesky.
std::vector<double> field(dm::random::SplitMix64& rng, const Matrix& xy,
                          const Correlation& rho, double nugget) {
    const std::size_t n = xy.rows();
    std::vector<double> l(n * n, 0.0), out(n, 0.0), z(n);
    for (std::size_t i = 0; i < n; ++i)
        for (std::size_t j = 0; j <= i; ++j) {
            double s = rho(xy(i, 0) - xy(j, 0), xy(i, 1) - xy(j, 1));
            if (i == j)
                s += 1e-10;
            for (std::size_t k = 0; k < j; ++k)
                s -= l[i * n + k] * l[j * n + k];
            l[i * n + j] = i == j ? std::sqrt(s) : s / l[j * n + j];
        }
    for (double& v : z)
        v = rng.normal();
    for (std::size_t i = 0; i < n; ++i) {
        for (std::size_t k = 0; k <= i; ++k)
            out[i] += l[i * n + k] * z[k];
        out[i] += std::sqrt(nugget) * rng.normal();
    }
    return out;
}

Matrix points(dm::random::SplitMix64& rng, std::size_t n) {
    Matrix xy(n, 2);
    for (std::size_t i = 0; i < n; ++i)
        xy(i, 0) = 20 * rng.uniform01(), xy(i, 1) = 20 * rng.uniform01();
    return xy;
}

int main() {
    dm::random::SplitMix64 rng(31);
    const std::vector<double> bounds{0, 1, 2, 3, 4, 6, 8};
    const Correlation iso = [](double dx, double dy) {
        return std::exp(-std::hypot(dx, dy) / 3);
    };
    const int reps = 300;
    const std::size_t nb = bounds.size() - 1;
    // [estimator x contamination][bin]: sums and squares; also mean distances.
    std::vector<std::vector<double>> sum(4, std::vector<double>(nb)), sq = sum;
    std::vector<double> dist(nb);
    for (int r = 0; r < reps; ++r) {
        const Matrix xy = points(rng, 200);
        auto z = field(rng, xy, iso, 0.1);
        for (const bool dirty : {false, true}) {
            if (dirty)
                for (std::size_t i = 0; i < z.size(); ++i)
                    if (rng.uniform01() < 0.05)
                        z[i] += 4;
            for (const bool cressie : {false, true}) {
                const auto v = dm::stats::empirical_variogram(
                    xy, z, {.boundaries = bounds, .cressie = cressie});
                const int e = 2 * dirty + cressie;
                for (std::size_t k = 0; k < nb; ++k) {
                    sum[e][k] += v[k].gamma / reps;
                    sq[e][k] += v[k].gamma * v[k].gamma / reps;
                    if (e == 0)
                        dist[k] += v[k].distance / reps;
                }
            }
        }
    }
    std::println("| Mean lag | True gamma | Moments, clean | Cressie, clean | "
                 "Moments, 5% outliers | Cressie, 5% outliers |");
    std::println("| ---: | ---: | ---: | ---: | ---: | ---: |");
    for (std::size_t k = 0; k < nb; ++k) {
        const double truth = 0.1 + 1 - std::exp(-dist[k] / 3);
        std::print("| {:.2f} | {:.3f}", dist[k], truth);
        for (int e = 0; e < 4; ++e)
            std::print(" | {:.3f} ({:.3f})", sum[e][k],
                       std::sqrt(sq[e][k] - sum[e][k] * sum[e][k]));
        std::println(" |");
    }

    // Geometric anisotropy: range 6 along azimuth 45 degrees, 2 along 135 degrees.
    const double t = std::numbers::pi / 4;
    const auto aniso_h = [t](double dx, double dy) {
        const double along = dx * std::sin(t) + dy * std::cos(t);
        const double across = dx * std::cos(t) - dy * std::sin(t);
        return std::hypot(along / 6, across / 2);
    };
    const Correlation aniso = [&](double dx, double dy) {
        return std::exp(-aniso_h(dx, dy));
    };
    const std::vector<double> lag_bounds{0, 1, 2, 3, 4, 5, 6, 7, 8};
    std::vector<double> mean45(8), mean135(8), d45(8), d135(8);
    for (int r = 0; r < 100; ++r) {
        const Matrix xy = points(rng, 200);
        const auto z = field(rng, xy, aniso, 0.1);
        const auto v = dm::stats::empirical_variogram(
            xy, z,
            {.boundaries = lag_bounds, .directions = {45, 135}, .angular_tolerance = 22.5});
        for (const auto& b : v) {
            const auto k = static_cast<std::size_t>(b.lower);
            (b.direction == 45 ? mean45 : mean135)[k] += b.gamma / 100;
            (b.direction == 45 ? d45 : d135)[k] += b.distance / 100;
        }
    }
    std::vector<double> grid, true45, true135;
    for (double h = 0.05; h <= 8; h += 0.05) {
        grid.push_back(h);
        true45.push_back(1.1 - std::exp(-h / 6));
        true135.push_back(1.1 - std::exp(-h / 2));
    }
    auto plot = dm::graphics::RPlot::create();
    plot.points(d45, mean45, "", {26, 90, 147}, 6)
        .line(grid, true45, "Azimuth 45 (range 6)", {26, 90, 147}, 1.5)
        .points(d135, mean135, "", {176, 72, 43}, 6)
        .line(grid, true135, "Azimuth 135 (range 2)", {176, 72, 43}, 1.5)
        .y_limits(0, 1.5)
        .title("Directional variograms of an anisotropic field")
        .x_label("Lag distance (points: mean of 100 empirical variograms; lines: truth)")
        .y_label("Semivariance")
        .size(620, 400);
    std::filesystem::create_directories("build");
    plot.save_svg("build/empirical_variogram.svg");
}
```
// result_begin: markdown
