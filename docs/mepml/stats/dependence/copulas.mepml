//? Title: Gaussian and Student t copulas
//? Exports: both
//? Lang: en

> Separate dependence from the marginal distributions, fit Gaussian and t copulas to ranks, and see what the choice means for the probability that several variables are extreme together

By Sklar's theorem, any continuous joint distribution can be written as \(F(x_1,\dots,x_d)=C(F_1(x_1),\dots,F_d(x_d))\): the margins \(F_j\) and a **copula** \(C\), a distribution on \([0,1]^d\) with uniform margins that carries all of the dependence. The **Gaussian copula** with correlation matrix \(R\) has density

\[c(u)=|R|^{-1/2}\exp\bigl(-\tfrac12 z^\top(R^{-1}-I)z\bigr),\qquad z_j=\Phi^{-1}(u_j),\]

and the **t copula** replaces the normal by a multivariate \(t_\nu\), dividing its density by the product of univariate \(t_\nu\) densities at \(x_j=t_\nu^{-1}(u_j)\). Both have Kendall's \(\tau_{jk}=\tfrac2\pi\arcsin R_{jk}\). They differ in the tails. The Gaussian copula is asymptotically independent in the tails, while the t copula has coefficients of joint extremes

\[\lambda=\lim_{q\to0}P(U_2\le q\mid U_1\le q)=2\,t_{\nu+1}\Bigl(-\sqrt{(\nu+1)(1-\rho)/(1+\rho)}\Bigr).\]

Fitting is semiparametric. The margins are replaced by **pseudo-observations** \(\hat u_{ij}=\operatorname{rank}(x_{ij})/(n+1)\), and the copula is fitted by maximum pseudo-likelihood (MPL) or by inverting Kendall's tau (\(R_{jk}=\sin(\pi\hat\tau_{jk}/2)\), with \(\nu\) then by MPL for fixed \(R\)).

`pseudo_observations`, `copula_log_density`, `fit_copula`, `t_copula_tail_dependence` and `simulate_copula` implement this for any dimension. The MPL fit runs L-BFGS over a C-vine partial-correlation parametrization, in which every point is a valid correlation matrix, and over \(\log\nu\). A Kendall matrix that is not positive definite is projected by eigenvalue clipping. The tests reproduce `copula` 1.1.7: `pobs` with ties, `dCopula` log densities to \(10^{-11}\), `lambda`, and the `itau` fit exactly. The `mpl` and `itau.mpl` fits agree with R's optimizer to its precision (\(\nu\) to \(10^{-3}\), log-likelihoods within \(10^{-6}\), and never below R's).

The example simulates 1000 days of three asset returns with t₄ dependence and skewed, heavy-tailed margins, then fits both copulas. It compares their implied tail dependence and the probability that all three assets have a 1-in-20 loss on the same day. The simulation study (100 samples per cell) measures the bias of \(\hat\rho\) and \(\hat\nu\), and how reliably AIC chooses between the two families.

```{cpp, id=cop, file="figures/copulas.svg", results="markdown", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <datamunge/plot/plot.hpp>
#include <datamunge/random/distributions.hpp>
#include <datamunge/random/random.hpp>
#include <datamunge/stats/copula.hpp>

#include <cmath>
#include <filesystem>
#include <format>
#include <print>
#include <vector>

namespace dm = datamunge;
using dm::stats::CopulaFamily;
using dm::stats::CopulaMethod;
using Matrix = dm::linalg::DenseMatrix<double>;

// Among rows with column a at or below q, the fraction with column b at or below q.
double joint_below(const Matrix& u, std::size_t a, std::size_t b, double q) {
    double both = 0, first = 0;
    for (std::size_t i = 0; i < u.rows(); ++i)
        if (u(i, a) <= q) {
            first += 1;
            both += u(i, b) <= q;
        }
    return first > 0 ? both / first : 0.0;
}

double all_below(const Matrix& u, double q) {
    double c = 0;
    for (std::size_t i = 0; i < u.rows(); ++i) {
        bool all = true;
        for (std::size_t j = 0; j < u.cols(); ++j) all = all && u(i, j) <= q;
        c += all;
    }
    return c / static_cast<double>(u.rows());
}

int main() {
    // Three daily returns: t4 copula dependence, skewed heavy-tailed margins.
    const Matrix r_true(3, 3, {1, 0.6, 0.4, 0.6, 1, 0.5, 0.4, 0.5, 1});
    const auto v = dm::stats::simulate_copula(r_true, CopulaFamily::student_t, 4, 1000, 3);
    Matrix returns(1000, 3, 0.0);
    for (std::size_t i = 0; i < 1000; ++i)
        for (std::size_t j = 0; j < 3; ++j) {
            const double t = dm::random::student_t_quantile(v(i, j), 3);
            returns(i, j) = 0.01 * (t - 0.3 * std::abs(t));  // skewed toward losses
        }
    const auto u = dm::stats::pseudo_observations(returns);

    std::println("| Fit (n = 1000) | rho12 | rho13 | rho23 | df | log-lik | AIC | "
                 "lambda12 |");
    std::println("| --- | ---: | ---: | ---: | ---: | ---: | ---: | ---: |");
    const auto show = [](const char* name, const dm::stats::CopulaFit& f) {
        std::println("| {} | {:.3f} | {:.3f} | {:.3f} | {} | {:.2f} | {:.2f} | {:.3f} |",
                     name, f.correlation(0, 1), f.correlation(0, 2), f.correlation(1, 2),
                     std::isinf(f.df) ? std::string("∞") : std::format("{:.2f}", f.df),
                     f.log_likelihood, f.aic, f.tail_dependence(0, 1));
    };
    const auto gauss = dm::stats::fit_copula(u);
    const auto gauss_tau =
        dm::stats::fit_copula(u, {.method = CopulaMethod::kendall_inversion});
    const auto tfit = dm::stats::fit_copula(u, {.family = CopulaFamily::student_t});
    const auto t_tau = dm::stats::fit_copula(
        u, {.family = CopulaFamily::student_t, .method = CopulaMethod::kendall_inversion});
    show("Gaussian, MPL", gauss);
    show("Gaussian, Kendall inversion", gauss_tau);
    show("t, MPL", tfit);
    show("t, Kendall inversion + MPL for df", t_tau);
    std::println("| Generating t copula | 0.600 | 0.400 | 0.500 | 4.00 | | | {:.3f} |\n",
                 dm::stats::t_copula_tail_dependence(0.6, 4));

    // Joint tail probabilities: data versus 400000 draws from each fitted copula.
    const auto sim_g = dm::stats::simulate_copula(gauss.correlation, CopulaFamily::gaussian,
                                                  0, 400000, 11);
    const auto sim_t = dm::stats::simulate_copula(tfit.correlation, CopulaFamily::student_t,
                                                  tfit.df, 400000, 12);
    const auto sim_true =
        dm::stats::simulate_copula(r_true, CopulaFamily::student_t, 4, 400000, 13);
    std::println("| Event | Data | Gaussian fit | t fit | Generating copula |");
    std::println("| --- | ---: | ---: | ---: | ---: |");
    for (const double q : {0.05, 0.01}) {
        std::println("| P(all three below their {:.0f}% quantile) | {:.4f} | {:.4f} | "
                     "{:.4f} | {:.4f} |", 100 * q, all_below(u, q), all_below(sim_g, q),
                     all_below(sim_t, q), all_below(sim_true, q));
        std::println("| P(asset 2 below {:.0f}% q. given asset 1 below) | {:.3f} | "
                     "{:.3f} | {:.3f} | {:.3f} |", 100 * q, joint_below(u, 0, 1, q),
                     joint_below(sim_g, 0, 1, q), joint_below(sim_t, 0, 1, q),
                     joint_below(sim_true, 0, 1, q));
    }

    // Simulation study: estimator bias and family selection, 100 samples per cell.
    std::println("\n| Truth | n | Mean rho12 (MPL) | Mean rho12 (tau) | Mean df (MPL) | "
                 "Median df (MPL) | AIC picks t |");
    std::println("| --- | ---: | ---: | ---: | ---: | ---: | ---: |");
    dm::random::SplitMix64 seeds(77);
    for (const bool truth_t : {false, true})
        for (const std::size_t n : {250uz, 1000uz}) {
            const int reps = 100;
            double r_mpl = 0, r_tau = 0, nu = 0, pick_t = 0;
            std::vector<double> nus;
            for (int r = 0; r < reps; ++r) {
                const auto family =
                    truth_t ? CopulaFamily::student_t : CopulaFamily::gaussian;
                const auto s =
                    dm::stats::simulate_copula(r_true, family, 4, n, seeds.next_u64());
                const auto us = dm::stats::pseudo_observations(s);
                const auto g = dm::stats::fit_copula(us);
                const dm::stats::CopulaOptions mpl{.family = CopulaFamily::student_t};
                const dm::stats::CopulaOptions tau{
                    .family = CopulaFamily::student_t,
                    .method = CopulaMethod::kendall_inversion};
                const auto t = dm::stats::fit_copula(us, mpl);
                const auto ti = dm::stats::fit_copula(us, tau);
                r_mpl += t.correlation(0, 1) / reps, r_tau += ti.correlation(0, 1) / reps;
                nu += t.df / reps;
                nus.push_back(t.df);
                pick_t += (t.aic < g.aic) / double(reps);
            }
            std::ranges::sort(nus);
            std::println("| {} | {} | {:.3f} | {:.3f} | {:.1f} | {:.1f} | {:.3f} |",
                         truth_t ? "t copula, df = 4" : "Gaussian copula", n, r_mpl, r_tau,
                         nu, nus[nus.size() / 2], pick_t);
        }

    // Figure: P(U2 <= q | U1 <= q) as q -> 0.
    std::vector<double> qs, emp, fg, ft;
    for (double lq = -4.5; lq <= -0.69; lq += 0.25) {
        const double q = std::exp(lq);
        qs.push_back(q);
        emp.push_back(joint_below(u, 0, 1, q));
        fg.push_back(joint_below(sim_g, 0, 1, q));
        ft.push_back(joint_below(sim_t, 0, 1, q));
    }
    std::vector<double> qs_emp, emp_pts;
    for (std::size_t i = 0; i < qs.size(); ++i)
        if (qs[i] * 1000 >= 10) qs_emp.push_back(qs[i]), emp_pts.push_back(emp[i]);
    auto fig = dm::graphics::RPlot::create();
    fig.line(qs, fg, "Gaussian copula fit", {176, 72, 43}, 2.5)
        .line(qs, ft, "t copula fit", {26, 90, 147}, 2.5)
        .points(qs_emp, emp_pts, "Data (at least 10 points below q)", {17, 24, 39}, 5)
        .abline_h(tfit.tail_dependence(0, 1), {140, 182, 222})
        .y_limits(0, 1.05)
        .title("Joint extremes: P(asset 2 below q | asset 1 below q)")
        .x_label("Quantile level q")
        .y_label("Conditional probability")
        .size(640, 410);
    std::filesystem::create_directories("build");
    fig.save_svg("build/copulas.svg");
}
```
