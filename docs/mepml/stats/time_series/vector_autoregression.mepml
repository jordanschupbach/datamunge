//? Title: Fit and forecast vector autoregressions
//? Exports: both
//? Lang: en

> Model several series that drive each other

A vector autoregression treats each of \(K\) series as a linear function of \(p\) lags of all of them:
\[y_t=\nu+A_1y_{t-1}+\dots+A_py_{t-p}+u_t,\qquad u_t\sim(0,\Sigma_u).\]
Every equation has the same regressors, so equation-by-equation least squares is efficient. It also equals the conditional Gaussian maximum-likelihood estimate. The model raises three practical questions, and `fit_var`, `select_var_order` and `forecast_var` answer them:

- **Lag order.** Information criteria trade \(\ln|\hat\Sigma|\) against the \(pK^2\) coefficients. AIC penalizes each one by \(2/T\), BIC by \(\ln T/T\), and Hannan–Quinn by \(2\ln\ln T/T\).
- **Stability.** The process is stationary when all eigenvalues of the companion matrix \(\left(\begin{smallmatrix}A_1&\cdots&A_p\\I&&0\end{smallmatrix}\right)\) lie inside the unit circle.
- **Forecast uncertainty.** The \(h\)-step error \(\sum_{i<h}\Phi_iu_{T+h-i}\) has covariance \(\sum_{i<h}\Phi_i\Sigma_u\Phi_i^\top\), where \(\Phi_i\) are the moving-average coefficients.

The example simulates a stable bivariate VAR(2) in which series 1 feeds series 2. It records how often each criterion recovers \(p=2\), and checks the coverage of nominal 95% forecast intervals.

```{cpp, id=var, file="figures/var_forecast.svg", results="markdown", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <datamunge/plot/plot.hpp>
#include <datamunge/stats/var.hpp>

#include <cmath>
#include <filesystem>
#include <print>
#include <random>
#include <vector>

namespace dm = datamunge;
using Matrix = dm::linalg::DenseMatrix<double>;

// y_t = nu + A1 y_{t-1} + A2 y_{t-2} + u_t; error sd 1 and 0.8, correlation 0.5.
Matrix simulate(std::size_t n, std::mt19937_64& random) {
    std::normal_distribution<double> z;
    const double a1[2][2] = {{.5, .1}, {.4, .3}}, a2[2][2] = {{-.2, 0}, {.25, -.15}};
    const double nu[2] = {1, .5};
    Matrix y(n + 100, 2);
    for (std::size_t t = 2; t < n + 100; ++t) {
        const double e1 = z(random), e2 = .8 * (.5 * e1 + std::sqrt(.75) * z(random));
        const double e[2] = {e1, e2};
        for (int i = 0; i < 2; ++i)
            y(t, i) = nu[i] + a1[i][0] * y(t - 1, 0) + a1[i][1] * y(t - 1, 1)
                      + a2[i][0] * y(t - 2, 0) + a2[i][1] * y(t - 2, 1) + e[i];
    }
    Matrix out(n, 2);
    for (std::size_t t = 0; t < n; ++t)
        for (int i = 0; i < 2; ++i)
            out(t, i) = y(t + 100, i);
    return out;
}

int main() {
    std::mt19937_64 random(5);
    const int replicates = 500;
    std::println("| n | AIC = 2 | BIC = 2 | HQ = 2 | AIC mean | BIC mean |");
    std::println("| ---: | ---: | ---: | ---: | ---: | ---: |");
    for (const std::size_t n : {60, 120, 400}) {
        int aic = 0, bic = 0, hq = 0;
        double aic_mean = 0, bic_mean = 0;
        for (int r = 0; r < replicates; ++r) {
            const auto s = dm::stats::select_var_order(simulate(n, random), 8);
            aic += s.aic_order == 2;
            bic += s.bic_order == 2;
            hq += s.hqic_order == 2;
            aic_mean += double(s.aic_order) / replicates;
            bic_mean += double(s.bic_order) / replicates;
        }
        const double rep = replicates;
        std::println("| {} | {:.3f} | {:.3f} | {:.3f} | {:.2f} | {:.2f} |", n, aic / rep,
                     bic / rep, hq / rep, aic_mean, bic_mean);
    }

    // Coverage of 95% intervals for series 2 at horizons 1, 4 and 8 (n = 120, VAR(2) fitted).
    const std::size_t n = 120, horizon = 8;
    int covered[3] = {0, 0, 0};
    const std::size_t check[3] = {1, 4, 8};
    for (int r = 0; r < replicates; ++r) {
        const auto all = simulate(n + horizon, random);
        Matrix sample(n, 2);
        for (std::size_t t = 0; t < n; ++t)
            for (int i = 0; i < 2; ++i)
                sample(t, i) = all(t, i);
        const auto fit = dm::stats::fit_var(sample, {.lags = 2});
        const auto f = dm::stats::forecast_var(fit, horizon);
        for (int c = 0; c < 3; ++c) {
            const std::size_t h = check[c] - 1;
            const double sd = std::sqrt(f.covariance[h](1, 1));
            covered[c] += std::abs(all(n + h, 1) - f.mean(h, 1)) <= 1.959964 * sd;
        }
    }
    const double rep = replicates;
    std::println("\n95% interval coverage for series 2 (n = 120): h = 1: {:.3f}, "
                 "h = 4: {:.3f}, h = 8: {:.3f}.", covered[0] / rep, covered[1] / rep,
                 covered[2] / rep);

    // One fit: coefficients, stability and a forecast fan for series 2.
    const auto y = simulate(n, random);
    const auto m = dm::stats::fit_var(y, {.lags = 2});
    std::println("Estimated A1 = [[{:.2f}, {:.2f}], [{:.2f}, {:.2f}]] "
                 "(true [[0.50, 0.10], [0.40, 0.30]]);",
                 m.lag_coefficients[0](0, 0), m.lag_coefficients[0](0, 1),
                 m.lag_coefficients[0](1, 0), m.lag_coefficients[0](1, 1));
    std::println("largest companion modulus {:.3f}, stable: {}.", m.companion_moduli.front(),
                 m.stable);
    const auto f = dm::stats::forecast_var(m, 16);
    const double last = y(n - 1, 1);
    std::vector<double> t_hist, y_hist, t_fc{double(n - 1)}, mean{last}, lo{last}, hi{last};
    for (std::size_t t = n - 40; t < n; ++t) {
        t_hist.push_back(double(t));
        y_hist.push_back(y(t, 1));
    }
    for (std::size_t h = 0; h < 16; ++h) {
        const double sd = std::sqrt(f.covariance[h](1, 1));
        t_fc.push_back(double(n + h));
        mean.push_back(f.mean(h, 1));
        lo.push_back(f.mean(h, 1) - 1.96 * sd);
        hi.push_back(f.mean(h, 1) + 1.96 * sd);
    }
    auto plot = dm::graphics::RPlot::create();
    plot.line(t_hist, y_hist, "Observed series 2", {60, 60, 60}, 1.4)
        .line(t_fc, mean, "Forecast", {26, 90, 147}, 1.8)
        .line(t_fc, lo, "95% interval", {120, 160, 200}, 1.2)
        .line(t_fc, hi, "", {120, 160, 200}, 1.2)
        .title("VAR(2) forecast of series 2 with 95% intervals")
        .ylim(-1, 6.5)
        .x_label("Time")
        .y_label("Series 2")
        .size(740, 400);
    std::filesystem::create_directories("build");
    plot.save_svg("build/var_forecast.svg");
}
```
// result_begin: markdown
| n | AIC = 2 | BIC = 2 | HQ = 2 | AIC mean | BIC mean |
| ---: | ---: | ---: | ---: | ---: | ---: |
| 60 | 0.622 | 0.366 | 0.604 | 2.29 | 1.36 |
| 120 | 0.840 | 0.718 | 0.888 | 2.20 | 1.72 |
| 400 | 0.876 | 1.000 | 0.988 | 2.18 | 2.00 |

95% interval coverage for series 2 (n = 120): h = 1: 0.950, h = 4: 0.922, h = 8: 0.970.
Estimated A1 = [[0.33, -0.01], [0.21, 0.33]] (true [[0.50, 0.10], [0.40, 0.30]]);
largest companion modulus 0.553, stable: true.
\image(figures/var_forecast.svg)
// result_end
\caption(The last 40 observations of series 2 and its 16-step VAR(2) forecast. The intervals widen as the moving-average terms accumulate and level off at the unconditional variance.)
\alttext(A grey line shows the observed series fluctuating between about 0.5 and 4.5. A blue forecast line starts at the last observation and converges within a few steps to the process mean of about 1.9. Light-blue interval lines fan out over the first few steps and then run parallel.)

The criteria behave as theory predicts. BIC is consistent: its penalty grows with \(\ln T\), so it finds \(p=2\) in every replicate at \(n=400\). In short samples it underfits, often choosing \(p=1\), because the lag-2 coefficients are small next to their sampling error. AIC is not consistent. It keeps choosing too many lags about 12% of the time even at \(n=400\), and its average order stays above 2. In short samples, however, it is more likely than BIC to find the true order. Hannan–Quinn falls in between and does best at \(n=120\). The fitted \(A_1\) from a single sample of 120 shows how imprecise a VAR is at this size. With \(pK^2+K=10\) coefficients, each entry has a standard error near 0.1.

Interval coverage stays within sampling error of 95% (the Monte Carlo standard error is about 0.01). Some shortfall is expected, because the MSE matrix ignores estimation error in the \(A_l\). Lütkepohl's correction adds a term of order \(1/T\), which matters only in small samples or with many lags. Coefficients, standard errors, \(\hat\Sigma_u\), information criteria, companion roots, forecasts and forecast covariances agree with `statsmodels.tsa.api.VAR` to 1e-11 on the macrodata growth rates. This includes the convention that the linear trend counts from the first row of the data.

[Sims (1980)|https://doi.org/10.2307/1912017] · [Lütkepohl (2005)|https://doi.org/10.1007/978-3-540-27752-1] · [Hannan and Quinn (1979)|https://doi.org/10.1111/j.2517-6161.1979.tb01072.x]
