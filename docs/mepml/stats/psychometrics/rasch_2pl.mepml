//? Title: Rasch and two-parameter item-response models
//? Exports: both
//? Lang: en

> Place items and people on one latent scale, estimate how hard and how discriminating each test item is, and check whether a common discrimination (Rasch) is enough

Item-response theory (IRT) models the probability that a person with ability \(\theta\) answers item \(j\) correctly. The two-parameter logistic model (2PL) is

\[P(X_{ij}=1\mid\theta_i)=\frac{1}{1+\exp\{-a_j(\theta_i-b_j)\}},\]

with difficulty \(b_j\) (the ability at which the chance is 50%) and discrimination \(a_j\) (how sharply the item separates people near \(b_j\)). The **Rasch model** constrains all discriminations to be equal. Its sum score is then a sufficient statistic for ability, and items are ordered the same way for everybody. The scale is identified by giving \(\theta\) a standard normal distribution in the population. The Rasch model either fixes \(a=1\), which frees the latent variance, or estimates one common \(a\).

`fit_irt` fits all three variants by marginal maximum likelihood. It integrates \(\theta\) out by Gauss–Hermite quadrature, groups identical response patterns, and maximizes with damped Newton steps on the analytic gradient. It returns difficulties and discriminations with delta-method standard errors, the log-likelihood, AIC and BIC. `irt_scores` gives posterior-mode (MAP) and posterior-mean (EAP) abilities with their uncertainty. `irt_probability` and `irt_test_information` give item characteristic curves and test information. The tests reproduce `ltm::rasch` (fixed and estimated common discrimination) and `ltm::ltm(X ~ z1)`, including standard errors and EB/EAP factor scores, on the LSAT and Abortion data and on a simulated 8-item test.

The example fits the three models to the classic LSAT section 6 data (1000 examinees, 5 items) and compares them by likelihood ratio. The simulation uses an 8-item test with discriminations from 0.6 to 2.0 and difficulties from −1.5 to 1.8. For 2PL data and for Rasch data (all \(a=1.1\)), it examines parameter recovery, interval coverage, the Rasch-versus-2PL test and ability estimation at n = 200 and 1000 (300 samples each).

```{cpp, id=irt, file="figures/rasch_2pl.svg", results="markdown", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <datamunge/plot/plot.hpp>
#include <datamunge/random/distributions.hpp>
#include <datamunge/random/random.hpp>
#include <datamunge/stats/item_response.hpp>

#include <algorithm>
#include <cmath>
#include <filesystem>
#include <format>
#include <print>
#include <string>
#include <vector>

namespace dm = datamunge;
using dm::stats::IrtModel;
using Matrix = dm::linalg::DenseMatrix<double>;

// LSAT section 6 (ltm::LSAT) as response patterns with frequencies.
const std::vector<std::pair<std::string, int>> lsat{
    {"00000", 3}, {"00001", 6}, {"00010", 2}, {"00011", 11}, {"00100", 1},
    {"00101", 1}, {"00110", 3}, {"00111", 4}, {"01000", 1}, {"01001", 8},
    {"01011", 16}, {"01101", 3}, {"01110", 2}, {"01111", 15}, {"10000", 10},
    {"10001", 29}, {"10010", 14}, {"10011", 81}, {"10100", 3}, {"10101", 28},
    {"10110", 15}, {"10111", 80}, {"11000", 16}, {"11001", 56}, {"11010", 21},
    {"11011", 173}, {"11100", 11}, {"11101", 61}, {"11110", 28}, {"11111", 298}};

const std::vector<double> a_true{0.6, 0.9, 1.2, 1.5, 2.0, 0.8, 1.1, 1.4};
const std::vector<double> b_true{-1.5, -0.8, -0.3, 0.0, 0.4, 0.8, 1.2, 1.8};

Matrix simulate(dm::random::SplitMix64& rng, std::size_t n, const std::vector<double>& a,
                std::vector<double>& theta) {
    const std::size_t p = a.size();
    Matrix x(n, p, 0.0);
    theta.assign(n, 0.0);
    for (std::size_t i = 0; i < n; ++i) {
        theta[i] = rng.normal();
        for (std::size_t j = 0; j < p; ++j) {
            const double pr = 1 / (1 + std::exp(-a[j] * (theta[i] - b_true[j])));
            x(i, j) = rng.uniform01() < pr ? 1.0 : 0.0;
        }
    }
    return x;
}

int main() {
    Matrix x(1000, 5, 0.0);
    std::size_t row = 0;
    for (const auto& [pattern, count] : lsat)
        for (int c = 0; c < count; ++c, ++row)
            for (std::size_t j = 0; j < 5; ++j)
                x(row, j) = pattern[j] == '1';
    const auto r1 =
        dm::stats::fit_irt(x, {.model = IrtModel::rasch, .rasch_discrimination = 1});
    const auto r = dm::stats::fit_irt(x, {.model = IrtModel::rasch});
    const auto m = dm::stats::fit_irt(x);
    std::println("| Item | Rasch (a = 1): b | Rasch: b | 2PL: b | 2PL: a (SE) |");
    std::println("| ---: | ---: | ---: | ---: | ---: |");
    for (std::size_t j = 0; j < 5; ++j)
        std::println("| {} | {:.3f} ({:.3f}) | {:.3f} ({:.3f}) | {:.3f} ({:.3f}) | "
                     "{:.3f} ({:.3f}) |", j + 1, r1.items[j].difficulty,
                     r1.items[j].difficulty_se, r.items[j].difficulty,
                     r.items[j].difficulty_se, m.items[j].difficulty,
                     m.items[j].difficulty_se,
                     m.items[j].discrimination, m.items[j].discrimination_se);
    const double lr = 2 * (m.log_likelihood - r.log_likelihood);
    std::println("\nCommon discrimination {:.3f} ({:.3f}). Log-likelihoods {:.2f}, {:.2f}, "
                 "{:.2f}; AIC {:.1f}, {:.1f}, {:.1f}; BIC {:.1f}, {:.1f}, {:.1f}.",
                 r.items[0].discrimination, r.items[0].discrimination_se, r1.log_likelihood,
                 r.log_likelihood, m.log_likelihood, r1.aic, r.aic, m.aic, r1.bic, r.bic,
                 m.bic);
    std::println("LR test of Rasch against 2PL: {:.2f} on 4 df, p = {:.3f}.\n", lr,
                 dm::random::chi_squared_survival(lr, 4));

    // Simulation.
    std::println("| True model | n | LR test rejects Rasch | 2PL: median abs. error a | "
                 "2PL: coverage a | 2PL: median abs. error b | 2PL: coverage b | "
                 "Rasch: median abs. error b | EAP RMSE | Mean EAP SD |");
    std::println("| --- | ---: | ---: | ---: | ---: | ---: | ---: | ---: | ---: | ---: |");
    dm::random::SplitMix64 rng(42);
    const int reps = 300;
    for (const bool rasch_truth : {false, true}) {
        const std::vector<double> a = rasch_truth ? std::vector<double>(8, 1.1) : a_true;
        for (const std::size_t n : {200uz, 1000uz}) {
            double rej = 0, ca = 0, cb = 0, er = 0, esd = 0;
            std::vector<double> ea, eb, erb;  // absolute errors over items and samples
            for (int rep = 0; rep < reps; ++rep) {
                std::vector<double> theta;
                const Matrix s = simulate(rng, n, a, theta);
                const auto f2 = dm::stats::fit_irt(s);
                const auto f1 = dm::stats::fit_irt(s, {.model = IrtModel::rasch});
                const double stat = 2 * (f2.log_likelihood - f1.log_likelihood);
                rej += dm::random::chi_squared_survival(stat, 7) <= 0.05;
                for (std::size_t j = 0; j < 8; ++j) {
                    const auto& it = f2.items[j];
                    ea.push_back(std::abs(it.discrimination - a[j]));
                    eb.push_back(std::abs(it.difficulty - b_true[j]));
                    ca += std::abs(it.discrimination - a[j]) <= 1.96 * it.discrimination_se;
                    cb += std::abs(it.difficulty - b_true[j]) <= 1.96 * it.difficulty_se;
                    erb.push_back(std::abs(f1.items[j].difficulty - b_true[j]));
                }
                const auto sc = dm::stats::irt_scores(f2, s);
                for (std::size_t i = 0; i < n; ++i) {
                    er += std::pow(sc[i].eap - theta[i], 2) / (double(n) * reps);
                    esd += sc[i].eap_sd / (double(n) * reps);
                }
            }
            auto median = [](std::vector<double> v) {
                std::ranges::nth_element(v, v.begin() + v.size() / 2);
                return v[v.size() / 2];
            };
            std::println("| {} | {} | {:.3f} | {:.3f} | {:.3f} | {:.3f} | {:.3f} | "
                         "{:.3f} | {:.3f} | {:.3f} |",
                         rasch_truth ? "Rasch (a = 1.1)" : "2PL", n,
                         rej / reps, median(ea), ca / (8.0 * reps), median(eb),
                         cb / (8.0 * reps), median(erb), std::sqrt(er), esd);
        }
    }

    // Item characteristic curves of the 8-item test and its information.
    dm::stats::IrtFit test;
    for (std::size_t j = 0; j < 8; ++j)
        test.items.push_back({.difficulty = b_true[j], .discrimination = a_true[j]});
    auto plot = dm::graphics::RPlot::create();
    std::vector<double> grid;
    for (double t = -3.5; t <= 3.5001; t += 0.05) grid.push_back(t);
    for (std::size_t j = 0; j < 8; ++j) {
        std::vector<double> pr;
        for (const double t : grid)
            pr.push_back(dm::stats::irt_probability(test.items[j], t));
        const int shade = 40 + 20 * static_cast<int>(j);
        plot.line(grid, pr, j == 0 ? "Item characteristic curves" : "",
                  {26, 90, static_cast<std::uint8_t>(std::min(255, 100 + shade))}, 1.5);
    }
    std::vector<double> info;
    for (const double t : grid)
        info.push_back(dm::stats::irt_test_information(test, t) / 3);
    plot.line(grid, info, "Test information / 3", {176, 72, 43}, 2.5)
        .y_limits(0, 1.2)
        .title("Eight-item 2PL test: item curves and information")
        .x_label("Ability theta")
        .y_label("P(correct)  |  information / 3")
        .size(660, 420);
    std::filesystem::create_directories("build");
    plot.save_svg("build/rasch_2pl.svg");
}
```
