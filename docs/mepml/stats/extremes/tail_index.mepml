//? Title: Hill and Pickands tail-index estimation
//? Exports: both
//? Lang: en

> Estimate how heavy a tail is from the largest order statistics, read the estimate's stability over the number k used, and extrapolate quantiles beyond the data

For a heavy-tailed distribution, \(P(X>x)\approx x^{-1/\xi}L(x)\) with a slowly varying \(L\). The **extreme value index** \(\xi\) (tail index \(\alpha=1/\xi\)) sets how fast very large values become rarer, and with it the existence of moments (\(E X^r<\infty\) only for \(r<1/\xi\)) and the size of extrapolated quantiles. The classical estimators use only the \(k\) largest order statistics \(X_{n:n}\ge X_{n-1:n}\ge\dots\), treating \(X_{n-k:n}\) as a random threshold:

- **Hill** (1975): \(\hat\xi_H=\frac1k\sum_{i=1}^k\log X_{n-i+1:n}-\log X_{n-k:n}\). It is the maximum-likelihood estimator for an exact Pareto tail, asymptotically normal with variance \(\xi^2/k\), but valid only for \(\xi>0\) and not invariant to shifts.
- **Pickands** (1975): \(\hat\xi_P=\log\bigl[(X_{n-k+1}-X_{n-2k+1})/(X_{n-2k+1}-X_{n-4k+1})\bigr]/\log 2\). It is valid for any \(\xi\) and invariant to location and scale, but it uses only three order statistics and has a much larger variance.
- **Moment** (Dekkers, Einmahl and de Haan 1989): \(\hat\xi_M=M_1+1-\tfrac12(1-M_1^2/M_2)^{-1}\), with \(M_j\) the means of \((\log X_{n-i+1}-\log X_{n-k})^j\). It extends Hill to all real \(\xi\), with variance \((1+\xi^2)/k\) for \(\xi\ge0\).

All three face the same trade-off. With small \(k\) the estimate is noisy. With large \(k\), observations from the body of the distribution, where the power law does not hold yet, bias it. The standard diagnostic is the plot of \(\hat\xi\) against \(k\): look for a stable region. The **Weissman** (1978) estimator extrapolates beyond the sample: \(\hat Q(1-p)=X_{n-k:n}\bigl((k+1)/((n+1)p)\bigr)^{\hat\xi_H}\).

`tail_index` gives each estimator at one \(k\) with its asymptotic standard error. `tail_index_path` gives the whole path, and `weissman_quantile` the extrapolated quantile. The tests reproduce `ReIns` 1.0.16 (Hill, Moment and Weissman.q) and the Pickands formula to rounding. They also check the asymptotic variances, the exact \(\xi=-1\) of Pickands on uniform quantiles, and location-scale invariance.

The example uses the Secura Belgian Re automobile claims: 371 claims above €1.2 million (Beirlant et al. 2004), the textbook case for these estimators. It cross-checks the result against a generalized Pareto fit. The simulation compares the estimators' bias, RMSE and interval coverage over \(k\) for an exact Pareto tail, a \(t_3\) tail with second-order bias, and a lognormal, whose \(\xi=0\) Hill cannot see.

```{cpp, id=tail, file="figures/tail_index.svg", results="markdown", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <datamunge/plot/plot.hpp>
#include <datamunge/random/distributions.hpp>
#include <datamunge/random/random.hpp>
#include <datamunge/stats/gpd.hpp>
#include <datamunge/stats/tail_index.hpp>

#include <algorithm>
#include <cmath>
#include <filesystem>
#include <fstream>
#include <functional>
#include <print>
#include <string>
#include <vector>

namespace dm = datamunge;
using dm::stats::TailIndexMethod;

std::vector<double> read_series(const std::string& path) {
    std::ifstream in(path);
    std::vector<double> v;
    for (std::string line; std::getline(in, line);)
        if (!line.empty() && line[0] != '#') v.push_back(std::stod(line));
    return v;
}

std::vector<double> estimates(const std::vector<dm::stats::TailIndexEstimate>& path,
                              double dm::stats::TailIndexEstimate::*field) {
    std::vector<double> out;
    for (const auto& e : path) out.push_back(e.*field);
    return out;
}

int main() {
    const auto claims = read_series("data/secura.txt");
    const std::size_t n = claims.size();
    std::println("{} claims, largest {:.2f} million EUR.\n", n,
                 std::ranges::max(claims) / 1e6);

    std::println("| k | Threshold X(n-k) (million) | Hill [95%] | Moment [95%] | "
                 "Pickands [95%] | Weissman 1-in-1000 claim (million) |");
    std::println("| ---: | ---: | ---: | ---: | ---: | ---: |");
    for (const std::size_t k : {25, 50, 95, 150, 250}) {
        const auto h = dm::stats::tail_index(claims, k, TailIndexMethod::hill);
        const auto m = dm::stats::tail_index(claims, k, TailIndexMethod::moment);
        std::string pick = "–";
        if (4 * k <= n) {
            const auto p = dm::stats::tail_index(claims, k, TailIndexMethod::pickands);
            pick = std::format("{:.3f} [{:.2f}, {:.2f}]", p.estimate, p.lower, p.upper);
        }
        std::println("| {} | {:.3f} | {:.3f} [{:.3f}, {:.3f}] | "
                     "{:.3f} [{:.3f}, {:.3f}] | {} | {:.2f} |", k, h.threshold / 1e6,
                     h.estimate, h.lower, h.upper, m.estimate, m.lower, m.upper, pick,
                     dm::stats::weissman_quantile(claims, k, 1e-3) / 1e6);
    }

    // Cross-check: GPD fit to the excesses over the same random threshold (k = 95).
    const auto h95 = dm::stats::tail_index(claims, 95, TailIndexMethod::hill);
    const auto g = dm::stats::fit_gpd(claims, h95.threshold);
    std::println("\nGPD fit above X(n-95): xi = {:.3f} (SE {:.3f}) from {} exceedances; "
                 "Hill gives {:.3f} (SE {:.3f}).", g.shape, g.shape_se, g.exceedances,
                 h95.estimate, h95.standard_error);

    // Simulation: n = 1000, 300 replicates, three tails.
    struct Tail {
        std::string name;
        double xi;
        std::function<double(double)> quantile;
    };
    const std::vector<Tail> tails{
        {"Pareto, xi = 0.5", 0.5, [](double u) { return std::pow(1 - u, -0.5); }},
        {"abs t3, xi = 1/3", 1.0 / 3,
         [](double u) { return dm::random::student_t_quantile(0.5 + u / 2, 3); }},
        {"lognormal, xi = 0", 0.0,
         [](double u) { return std::exp(dm::random::normal_quantile(u)); }}};
    dm::random::SplitMix64 rng(23);
    const int reps = 300;
    std::println("\n| Tail | k | Hill bias | Hill RMSE | Hill coverage | Moment bias | "
                 "Moment RMSE | Moment coverage | Pickands bias | Pickands RMSE |");
    std::println("| --- | ---: | ---: | ---: | ---: | ---: | ---: | ---: | ---: | ---: |");
    for (const auto& tail : tails) {
        const std::vector<std::size_t> ks{25, 50, 100, 200};
        // [method][k] accumulators: bias, squared error, coverage.
        std::vector<std::vector<double>> bias(3, std::vector<double>(ks.size())),
            se2 = bias, cover = bias;
        for (int r = 0; r < reps; ++r) {
            std::vector<double> x(1000);
            for (auto& v : x) v = tail.quantile(rng.uniform01() * 0.999999 + 5e-7);
            for (std::size_t j = 0; j < ks.size(); ++j) {
                const TailIndexMethod methods[]{TailIndexMethod::hill,
                                                TailIndexMethod::moment,
                                                TailIndexMethod::pickands};
                for (std::size_t m = 0; m < 3; ++m) {
                    const auto e = dm::stats::tail_index(x, ks[j], methods[m]);
                    bias[m][j] += (e.estimate - tail.xi) / reps;
                    se2[m][j] += std::pow(e.estimate - tail.xi, 2) / reps;
                    const bool inside = e.lower <= tail.xi && tail.xi <= e.upper;
                    cover[m][j] += inside / double(reps);
                }
            }
        }
        for (std::size_t j = 0; j < ks.size(); ++j)
            std::println("| {} | {} | {:+.3f} | {:.3f} | {:.2f} | {:+.3f} | {:.3f} | "
                         "{:.2f} | {:+.3f} | {:.3f} |", tail.name, ks[j], bias[0][j],
                         std::sqrt(se2[0][j]), cover[0][j], bias[1][j],
                         std::sqrt(se2[1][j]), cover[1][j], bias[2][j],
                         std::sqrt(se2[2][j]));
    }

    using dm::stats::tail_index_path;
    const auto hill = tail_index_path(claims, TailIndexMethod::hill, 10, 300);
    const auto mom = tail_index_path(claims, TailIndexMethod::moment, 10, 300);
    const auto pick = tail_index_path(claims, TailIndexMethod::pickands, 10, 300);
    using E = dm::stats::TailIndexEstimate;
    const auto k_of = [](const std::vector<E>& p) {
        std::vector<double> k;
        for (const auto& e : p) k.push_back(static_cast<double>(e.k));
        return k;
    };
    auto fig = dm::graphics::RPlot::create();
    fig.line(k_of(pick), estimates(pick, &E::estimate), "Pickands", {150, 150, 150}, 1.5)
        .line(k_of(hill), estimates(hill, &E::upper), "Hill 95% interval", {140, 182, 222},
              1.5)
        .line(k_of(hill), estimates(hill, &E::lower), "", {140, 182, 222}, 1.5)
        .line(k_of(mom), estimates(mom, &E::estimate), "Moment", {178, 74, 38}, 2)
        .line(k_of(hill), estimates(hill, &E::estimate), "Hill", {26, 90, 147}, 2.5)
        .abline_v(95, {170, 170, 170})
        .y_limits(-1.0, 1.6)
        .title("Secura claims: extreme value index against k")
        .x_label("k (number of upper order statistics)")
        .y_label("Estimated xi")
        .size(640, 410);
    std::filesystem::create_directories("build");
    fig.save_svg("build/tail_index.svg");
}
```
