//? Title: Generalized Pareto fitting
//? Exports: both
//? Lang: en

> Model all observations above a high threshold with the generalized Pareto distribution, choose the threshold with diagnostics, and turn the fit into return levels at the rate observations arrive

Block maxima discard everything except one value per block. The **peaks-over-threshold** approach uses every observation above a high threshold \(u\). If maxima are approximately GEV, then excesses \(Y=X-u\) given \(X>u\) are approximately **generalized Pareto** (Pickands 1975; Balkema and de Haan 1974):

\[P(Y\le y\mid X>u)=1-\bigl(1+\xi y/\sigma_u\bigr)_+^{-1/\xi},\]

with the same shape \(\xi\) as the GEV and a scale that depends on the threshold. If the model holds above \(u_0\), it holds above every \(u>u_0\), with \(\sigma_u=\sigma_{u_0}+\xi(u-u_0)\). Two diagnostics follow. The **mean residual life** \(E(X-u\mid X>u)=(\sigma_{u_0}+\xi u)/(1-\xi)\) is linear in \(u\), and both \(\hat\xi(u)\) and the **modified scale** \(\sigma^*=\sigma_u-\xi u\) are constant. With exceedance probability \(\zeta_u=P(X>u)\) and \(n_y\) observations per year, the level exceeded once in \(T\) years on average is (with \(m=Tn_y\))

\[x_m=u+\frac{\sigma}{\xi}\bigl[(m\zeta_u)^\xi-1\bigr].\]

`fit_gpd` fits the excesses by maximum likelihood, or by the exponential model (\(\xi=0\)). `gpd_return_level` gives \(x_m\) for any rate of observations per period, with a delta-method interval that includes the binomial uncertainty in \(\hat\zeta_u\), and a profile-likelihood interval. `threshold_diagnostics` gives the mean residual life and parameter-stability rows over a grid of thresholds. The tests use Coles's (2001) daily rainfall series, 17,531 days from south-west England. They reproduce tight R fits with exact symbolic-Hessian standard errors, the delta-method and root-found profile limits of the 100-year level, the exact exponential estimate (the mean excess), `ismev::gpd.fit` and `extRemes` distribution functions.

The example works through the threshold choice for the rainfall series, fits at \(u=30\) mm, and shows how the 100-year daily rainfall depends on the threshold. The simulation draws 40 years of daily values from a distribution whose tail is only asymptotically generalized Pareto (absolute \(t_3\), \(\xi=1/3\)). It then measures the bias–variance trade-off of the threshold and the coverage of the intervals.

```{cpp, id=gpd, file="figures/gpd.svg", results="markdown", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <datamunge/plot/plot.hpp>
#include <datamunge/random/distributions.hpp>
#include <datamunge/random/random.hpp>
#include <datamunge/stats/gpd.hpp>

#include <algorithm>
#include <cmath>
#include <filesystem>
#include <format>
#include <fstream>
#include <print>
#include <string>
#include <vector>

namespace dm = datamunge;

std::vector<double> read_series(const std::string& path) {
    std::ifstream in(path);
    std::vector<double> v;
    for (std::string line; std::getline(in, line);)
        if (!line.empty() && line[0] != '#') v.push_back(std::stod(line));
    return v;
}

std::string ci(double lo, double hi) { return std::format("[{:.1f}, {:.1f}]", lo, hi); }

int main() {
    const auto rain = read_series("data/rain.txt");
    const double per_year = static_cast<double>(rain.size()) / 48;  // 1914-1962
    std::println("{} daily values, {:.2f} per year; maximum {:.1f} mm.\n", rain.size(),
                 per_year, std::ranges::max(rain));

    std::println("| Threshold u (mm) | Exceedances | Mean excess [95%] | xi [95%] | "
                 "Modified scale sigma* [95%] |");
    std::println("| ---: | ---: | ---: | ---: | ---: |");
    const std::vector<double> grid{10, 15, 20, 25, 30, 35, 40, 50};
    const auto diag = dm::stats::threshold_diagnostics(rain, grid);
    for (const auto& d : diag)
        std::println("| {:.0f} | {} | {:.2f} [{:.2f}, {:.2f}] | {:.3f} [{:.3f}, {:.3f}] | "
                     "{:.2f} [{:.2f}, {:.2f}] |", d.threshold, d.exceedances, d.mean_excess,
                     d.mean_excess_lower, d.mean_excess_upper, d.shape, d.shape_lower,
                     d.shape_upper, d.modified_scale, d.modified_scale_lower,
                     d.modified_scale_upper);

    const auto f = dm::stats::fit_gpd(rain, 30);
    const auto e = dm::stats::fit_gpd(rain, 30, {.exponential = true});
    const double lr = 2 * (f.log_likelihood - e.log_likelihood);
    std::println("\nAt u = 30: sigma = {:.3f} (SE {:.3f}), xi = {:.3f} (SE {:.3f}), "
                 "zeta = {:.5f}; LR test of xi = 0: chi2 = {:.2f}, p = {:.4f}.\n", f.scale,
                 f.scale_se, f.shape, f.shape_se, f.exceedance_rate, lr,
                 dm::random::chi_squared_survival(lr, 1));
    std::println("| Return period (years) | GPD level (mm) | Delta 95% | Profile 95% | "
                 "Exponential level | Exponential profile 95% |");
    std::println("| ---: | ---: | ---: | ---: | ---: | ---: |");
    for (const double period : {10.0, 100.0, 1000.0}) {
        const auto r = dm::stats::gpd_return_level(f, rain, period, per_year);
        const auto x = dm::stats::gpd_return_level(e, rain, period, per_year);
        std::println("| {:.0f} | {:.1f} | {} | {} | {:.1f} | {} |", period, r.level,
                     ci(r.wald_lower, r.wald_upper), ci(r.profile_lower, r.profile_upper),
                     x.level, ci(x.profile_lower, x.profile_upper));
    }

    // Sensitivity of the 100-year level to the threshold.
    std::vector<double> us, lev, lo, hi;
    for (double u = 12; u <= 42; u += 1.5) {
        const auto g = dm::stats::fit_gpd(rain, u);
        const auto r = dm::stats::gpd_return_level(g, rain, 100, per_year);
        us.push_back(u), lev.push_back(r.level);
        lo.push_back(r.profile_lower), hi.push_back(r.profile_upper);
    }

    // Simulation: 40 years of daily |t3| values (xi = 1/3); true 100-year level known.
    dm::random::SplitMix64 rng(19);
    const std::size_t days = 40 * 365;
    const double truth = dm::random::student_t_quantile(1 - 0.5 / (100 * 365.0), 3);
    std::println("\n| Threshold (quantile) | Mean exceedances | Mean xi (truth 0.333) | "
                 "Median 100-yr level (truth {:.1f}) | RMSE of log level | "
                 "Profile coverage |", truth);
    std::println("| ---: | ---: | ---: | ---: | ---: | ---: |");
    for (const double q : {0.90, 0.95, 0.98, 0.995}) {
        const double u = dm::random::student_t_quantile(0.5 + q / 2, 3);  // |t3| quantile
        const int reps = 200;
        double k = 0, xi = 0, mse = 0, cover = 0;
        std::vector<double> levels;
        for (int r = 0; r < reps; ++r) {
            std::vector<double> x(days);
            for (auto& v : x) {
                const double p = rng.uniform01() * 0.999999 + 5e-7;
                v = std::abs(dm::random::student_t_quantile(p, 3));
            }
            const auto g = dm::stats::fit_gpd(x, u);
            const auto rl = dm::stats::gpd_return_level(g, x, 100, 365);
            k += g.exceedances / double(reps), xi += g.shape / reps;
            levels.push_back(rl.level);
            mse += std::pow(std::log(rl.level / truth), 2) / reps;
            const bool inside = rl.profile_lower <= truth && truth <= rl.profile_upper;
            cover += inside / double(reps);
        }
        std::ranges::sort(levels);
        std::println("| {:.3f} | {:.0f} | {:.3f} | {:.1f} | {:.3f} | {:.3f} |", q, k, xi,
                     levels[levels.size() / 2], std::sqrt(mse), cover);
    }

    auto fig = dm::graphics::RPlot::create();
    fig.line(us, hi, "95% profile interval", {140, 182, 222}, 1.5)
        .line(us, lo, "", {140, 182, 222}, 1.5)
        .line(us, lev, "100-year daily rainfall", {26, 90, 147}, 2.5)
        .abline_v(30, {170, 170, 170})
        .y_limits(40, 330)
        .title("Threshold sensitivity of the 100-year daily rainfall")
        .x_label("Threshold u (mm)")
        .y_label("Return level (mm)")
        .size(640, 410);
    std::filesystem::create_directories("build");
    fig.save_svg("build/gpd.svg");
}
```
