> Controls and boundary cases

```{cpp, results="markdown", file="figures/permutation_controls.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
    std::filesystem::create_directories("build");
    std::vector<double> v;
    std::vector<std::string> labels;
    std::print("| B | actual observed | actual p | sampled null SD |\n| ---: | ---: | ---: | ---: |\n");
    for (std::size_t count : {1, 9, 99, 999}) {
        auto r =
            dm::stats::permutation_test_two_sample({1, 2}, {3, 4}, {},
                                                   {count,
                                                    dm::stats::Alternative::TwoSided,
                                                    42});
        labels.push_back(std::to_string(count));
        v.push_back(r.p_value);
        std::print("| {} | {} | {} | {} |\n", count, r.observed, r.p_value,
                   r.null_sd);
    }
    auto p = dm::graphics::RPlot::barplot(v, labels, "actual Monte Carlo p");
    p.title("Finite Monte Carlo budgets on the same six-labeling tiny problem").x_label("sampled labelings B").y_label("actual plus-one p");
    p.save_svg("build/permutation_controls.svg");
}
```
