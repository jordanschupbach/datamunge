> The original fixture, retained

This complete program retains the original inputs, seed and substantive
experiment. Any added display prefix is explicitly separate from the original
random call schedule.

```{cpp, results="markdown", file="figures/permutation_original.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>


using namespace datamunge::stats;
using namespace datamunge::graphics;

static double mean_of(const std::vector<double> &v) {
    return std::accumulate(v.begin(), v.end(), 0.0) / static_cast<double>(
        v.size());
}
static double median_of(std::vector<double> v) {
    std::sort(v.begin(), v.end());
    const std::size_t n = v.size();
    return n % 2 ? v[n / 2] : 0.5 * (v[n / 2 - 1] + v[n / 2]);
}

int main() {
    std::ostringstream original_output;
    auto *original_cout = std::cout.rdbuf(original_output.rdbuf());

    std::filesystem::create_directories("build");
    std::cout << std::fixed << std::setprecision(4);
    const auto iris = datamunge::datasets::iris();
    std::vector<double> setosa, versicolor;
    for (std::size_t i = 0; i < iris.nrows(); ++i) {
        const std::string sp = iris.string_at("Species", i);
        const double v = iris.double_at("Sepal.Length", i);
        if (sp == "setosa")
            setosa.push_back(v);
        else if (sp == "versicolor")
            versicolor.push_back(v);
    }

    std::cout <<
        "=== Two-sample permutation test: setosa vs versicolor Sepal.Length ===\n";
    std::cout << "setosa mean = " << mean_of(setosa) << " (n=" <<
        setosa.size() << "), versicolor mean = " << mean_of(versicolor) <<
        " (n=" << versicolor.size() << ")\n";

    PermutationTestOptions opt{10000, Alternative::TwoSided, 20240915};
    const auto diff_means =
        permutation_test_two_sample(setosa, versicolor, {}, opt);
    std::cout << "\ndifference in MEANS:\n";
    std::cout << "  observed        = " << diff_means.observed << "\n";
    std::cout << "  permutation p   = " << diff_means.p_value << "  (" <<
        opt.num_permutations << " permutations)\n";
    std::cout << "  null mean/sd    = " << diff_means.null_mean << " / " <<
        diff_means.null_sd << "\n";
    const auto tt = t_test_two_sample(setosa, versicolor);
    std::cout << "  Welch t-test p  = " << tt.p_value << "  (for comparison)\n";

    const TwoSampleStatistic diff_median =
        [](const std::vector<double> & a, const std::vector<double> & b) {
        return median_of(a) - median_of(b);
    };
    const auto dm =
        permutation_test_two_sample(setosa, versicolor, diff_median, opt);
    std::cout <<
        "\ndifference in MEDIANS (median statistic under sampled relabeling):\n";
    std::cout << "  observed      = " << dm.observed << "\n";
    std::cout << "  permutation p = " << dm.p_value << "\n";

    auto plot =
        RPlot::hist(diff_means.null_distribution, 40, "permutation null");
    plot.title("Permutation null distribution of the mean difference (setosa vs versicolor)").x_label("mean(setosa) - mean(versicolor) under relabeling").y_label("count").background({250, 250, 252});
    plot.abline_v(diff_means.observed, {220, 38, 38}, 2);
    plot.x_limits(std::min(diff_means.observed,
                           *std::min_element(diff_means.null_distribution.begin(),
                                             diff_means.null_distribution.end())) -
                  .1,
                  *std::max_element(diff_means.null_distribution.begin(),
                                    diff_means.null_distribution.end()) + .1);
    plot.title("Iris mean difference: actual sampled null and observed statistic");
    plot.legend({"sampled null", "observed mean difference"},
                {{37, 99, 235}, {220, 38, 38}});
    plot.save_svg("build/permutation_original.svg");
    std::cout << "\nobserved difference " << diff_means.observed <<
        " compared with the actually sampled null range [" <<
        *std::min_element(diff_means.null_distribution.begin(),
                          diff_means.null_distribution.end()) << ", " <<
        *std::max_element(diff_means.null_distribution.begin(),
                          diff_means.null_distribution.end()) <<
        "]\nwrote permutation_null.svg\n";
    std::cout.rdbuf(original_cout);
    std::print("| Original computed output |\n| --- |\n");
    std::istringstream lines(original_output.str());
    std::string line;
    while (std::getline(lines, line)) {
        while (!line.empty() && line.back() == ' ') line.pop_back();
        if (!line.empty()) std::print("| `{}` |\n", line);
    }

    return 0;
}
```
