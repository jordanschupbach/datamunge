> Producing work and finite observations

```{cpp, results="markdown", file="figures/permutation_work.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
    std::filesystem::create_directories("build");
    auto t =
        dm::stats::permutation_test_trace({1, 2}, {3, 4}, {},
                                          {30, dm::stats::Alternative::TwoSided,
                                           42});
    std::vector<double> x, y;
    std::print("| draw | actual statistic | actual extreme decision |\n| ---: | ---: | --- |\n");
    for (std::size_t i = 0; i < t.draws.size(); ++i) {
        x.push_back(i + 1);
        y.push_back(t.draws[i].statistic);
        std::print("| {} | {} | {} |\n", i + 1, y.back(), t.draws[i].extreme);
    }
    auto p = dm::graphics::RPlot::create();
    p.points(x, y, "actual sampled statistic", {37, 99, 235}, 4).abline_h(
        t.result.observed, {220, 38, 38}, 2).abline_h(-t.result.observed,
                                                      {220, 38, 38}, 2).title(
        "Actual tiny sampled null values and two-sided observed thresholds").x_label("actual draw").y_label("mean difference");
    p.save_svg("build/permutation_work.svg");
}
```
