//? Title: Construct an interval by profiling a nuisance rate
//? Exports: both
//? Lang: en

> Invert the likelihood ratio for a Poisson rate ratio

Two independent counts measured over equal exposure times are 5
and 18. Write their Poisson means as $r\mu$ and $\mu$. The ratio
$r$ is the parameter of interest, and the baseline mean $\mu$ is
a nuisance parameter. At each fixed $r$, refitting the baseline
gives $\widehat\mu(r)=23/(1+r)$.

The profile interval uses the values of $r$ where twice the drop
from the maximum log likelihood crosses the 95th percentile of
chi-square with one degree of freedom.

```{cpp, id=profile-rate-ratio, file="figures/profile_likelihood_ratio.svg", results="markdown", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <datamunge/plot/plot.hpp>
#include <datamunge/stats/profile_likelihood.hpp>
#include <cmath>
#include <filesystem>
#include <limits>
#include <print>

int main() {
    constexpr double count_a = 5, count_b = 18;
    constexpr double estimate = count_a / count_b;
    const auto profile = [](double ratio) {
        if (ratio == 0)
            return -std::numeric_limits<double>::infinity();
        const double baseline = (count_a + count_b) / (1 + ratio);
        return count_a * std::log(baseline * ratio) + count_b * std::log(baseline) - count_a - count_b;
    };
    const auto interval = datamunge::stats::profile_likelihood_interval(
        estimate, profile, {.lower_bound = 0, .initial_step = .05});
    std::println("| Ratio estimate | Lower 95% limit | Upper 95% limit |");
    std::println("| ---: | ---: | ---: |");
    std::println("| {:.4f} | {:.4f} | {:.4f} |", estimate, interval.lower.value, interval.upper.value);

    std::vector<double> ratios, likelihood_ratio;
    for (std::size_t i = 0; i <= 150; ++i) {
        const double ratio = .04 + static_cast<double>(i) * .006;
        ratios.push_back(ratio);
        likelihood_ratio.push_back(2 * (profile(estimate) - profile(ratio)));
    }
    std::filesystem::create_directories("build");
    datamunge::graphics::RPlot::create()
        .line(ratios, likelihood_ratio, "", {29, 78, 216}, 2.5)
        .abline_h(interval.likelihood_ratio_cutoff, {180, 83, 9}, 1.8)
        .abline_v(interval.lower.value, {100, 116, 139}, 1)
        .abline_v(interval.upper.value, {100, 116, 139}, 1)
        .title("Profile likelihood for a Poisson rate ratio")
        .x_label("Rate ratio").y_label("Twice the log likelihood drop")
        .size(740, 420).save_svg("build/profile_likelihood_ratio.svg");
}
```
// result_begin: markdown
| Ratio estimate | Lower 95% limit | Upper 95% limit |
| ---: | ---: | ---: |
| 0.2778 | 0.0917 | 0.6961 |
\image(figures/profile_likelihood_ratio.svg)
// result_end
\caption(The horizontal cutoff intersects the profile at the two reported limits.)
\alttext(A blue profile curve descends steeply to its minimum near 0.28 and rises more slowly to the right. Both intersections with the horizontal cutoff are marked by vertical lines.)

The upper endpoint is further from the estimate than the lower endpoint.
The interval follows the shape of the refitted likelihood in ratio units.

[Venzon and Moolgavkar (1988)|https://doi.org/10.2307/2347496]
