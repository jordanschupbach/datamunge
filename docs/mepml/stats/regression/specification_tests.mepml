> Test added powers of the fitted response

RESET augments the original model with selected powers of its fitted
values. The partial F test compares the original fit with the augmented
fit. The example generates a curved response and first fits a straight line.

```{cpp, id=reset-powers, results="markdown", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <datamunge/stats/lm.hpp>
#include <print>

int main() {
    using namespace datamunge;
    const Mat<> design{{-4}, {-3}, {-2}, {-1}, {0}, {1}, {2}, {3}, {4}};
    std::vector<double> y;
    const std::vector<double> noise{-.2, .3, -.1, .5, -.4, -.1, .2, -.2, .1};
    for (std::size_t i = 0; i < noise.size(); ++i) {
        const double x = design(i, 0);
        y.push_back(1 + x + 0.65 * x * x + noise[i]);
    }
    const stats::LM fit(y, design);
    std::println("| Powers | F | Numerator df | Denominator df | p-value |");
    std::println("| --- | ---: | ---: | ---: | ---: |");
    const auto show = [&](const char* label, const std::vector<unsigned>& powers) {
        const auto test = fit.ramsey_reset(powers);
        std::println("| {} | {:.3f} | {:.0f} | {:.0f} | {:.3g} |",
                     label, test.statistic, test.parameter1, test.parameter2, test.p_value);
    };
    show("2", {2});
    show("2 and 3", {2, 3});
}
```
// result_begin: markdown
| Powers | F | Numerator df | Denominator df | p-value |
| --- | ---: | ---: | ---: | ---: |
