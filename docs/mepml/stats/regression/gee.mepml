//? Title: Fit a marginal mean to unevenly spaced repeated measurements
//? Exports: both
//? Lang: en

> Compare working correlations and sandwich uncertainty

Six instruments are measured on different days. The marginal mean
uses a common intercept and setting coefficient. The working
correlation describes how measurements from the same instrument
are related. With AR(1), a gap of three days uses the cube of the
lag-one correlation.

The cluster sandwich uses one estimating score per instrument.
It accounts for dependence within each instrument even when the
working correlation is an approximation.

```{cpp, id=instrument-correlations, file="figures/gee_working_correlations.svg", results="markdown", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <datamunge/plot/plot.hpp>
#include <datamunge/stats/gee.hpp>
#include <cmath>
#include <filesystem>
#include <print>
#include <stdexcept>

int main() {
    using namespace datamunge;
    const std::vector<std::vector<std::size_t>> days{
        {0,1,4}, {1,3,4}, {0,2,3,7}, {1,2,4}, {0,3,5,6}, {0,2,3,4}};
    const double instrument_effect[]{-.7,.4,1.1,-.9,-.25,.6};
    linalg::DenseMatrix<double> x(21, 2, 1);
    std::vector<double> y;
    std::vector<std::size_t> instruments, visits;
    stats::GEEOptions options;
    for (std::size_t g = 0; g < days.size(); ++g) {
        const auto instrument = g + 1;
        for (const auto day : days[g]) {
            const auto setting = std::cos(instrument + .4*day);
            const auto offset = .15 * std::cos(day);
            x(y.size(), 1) = setting;
            options.offset.push_back(offset);
            y.push_back(2 + .7*setting + instrument_effect[g] + .45*std::sin((instrument+1)*day)
                        + .1*day + offset);
            instruments.push_back(instrument);
            visits.push_back(day);
        }
    }

    using Correlation = stats::GEECorrelation;
    const std::vector<double> lag{1,2,3,4,5,6,7};
    auto plot = graphics::RPlot::create();
    std::println("| Working correlation | Parameter | Setting slope | Model SE | Sandwich SE |");
    std::println("| --- | ---: | ---: | ---: | ---: |");
    for (const auto pattern : {Correlation::Independence, Correlation::Exchangeable, Correlation::AR1}) {
        options.correlation = pattern;
        options.visit = pattern == Correlation::AR1 ? visits : std::vector<std::size_t>{};
        const auto fit = stats::fit_gee(x,y,instruments,options);
        if (fit.status != stats::GEEStatus::Converged)
            throw std::runtime_error("Expected the estimating equations to converge");
        const auto name = pattern == Correlation::Independence ? "Independence" :
                          pattern == Correlation::Exchangeable ? "Exchangeable" : "AR(1)";
        std::println("| {} | {:.3f} | {:.3f} | {:.3f} | {:.3f} |", name, fit.correlation_parameter,
                     fit.coefficients[1], std::sqrt(fit.model_covariance(1,1)),
                     std::sqrt(fit.sandwich_covariance(1,1)));
        std::vector<double> correlation;
        for (const auto gap : lag)
            correlation.push_back(pattern == Correlation::AR1 ? std::pow(fit.correlation_parameter,gap) :
                                  fit.correlation_parameter);
        const auto color = pattern == Correlation::AR1 ? graphics::RGBA{29,78,216} :
            pattern == Correlation::Exchangeable ? graphics::RGBA{180,83,9} : graphics::RGBA{71,85,105};
        plot.line(lag, correlation, name, color, 2.5);
    }
    std::filesystem::create_directories("build");
    plot.title("Working correlation by visit gap").x_label("Gap in days")
        .y_label("Correlation").y_limits(-.07,1.13).size(740,420)
        .save_svg("build/gee_working_correlations.svg");
}
```
// result_begin: markdown
| Working correlation | Parameter | Setting slope | Model SE | Sandwich SE |
| --- | ---: | ---: | ---: | ---: |
| Independence | 0.000 | 0.521 | 0.274 | 0.210 |
| Exchangeable | 0.771 | 0.779 | 0.197 | 0.197 |
| AR(1) | 0.929 | 0.755 | 0.220 | 0.230 |
\image(figures/gee_working_correlations.svg)
// result_end
\caption(Only the fitted AR(1) curve changes with the distance between visits.)
\alttext(Independence stays at zero, exchangeable stays at 0.77, and AR(1) declines from 0.93 at one day to about 0.60 at seven days.)

Exchangeable correlation assigns the same value to every gap. The
AR(1) correlation declines with the gap. The slope and both uncertainty
estimates reflect the working correlation used in each fit.

[Liang and Zeger, Longitudinal Data Analysis Using Generalized Linear Models|https://doi.org/10.1093/biomet/73.1.13]
