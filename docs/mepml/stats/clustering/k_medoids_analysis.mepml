> Original three blobs and two outliers

Retain the original generator: mt19937_64 seed4, independent normal
perturbations with standard deviation0.3 about(0,0),(10,0),(5,8), thirty points
per center, then(20,20) and(−15,12). The fit uses k3, at most100 scans and
initialization seed2. The 92 points are synthetic controls, not an external
dataset. The two outliers enter the objective and can affect the selected
medoids; their mere absorption is no proof of invariance.

```{cpp, results="markdown", file="figures/k_medoids_original.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <datamunge/algorithms/k_medoids.hpp>
#include <datamunge/plot/plot.hpp>
#include <filesystem>
#include <random>
#include <print>
int main() {
    std::filesystem::create_directories("build");
    std::mt19937_64 rng(4);
    std::normal_distribution<double> j(0, .3);
    std::vector<std::vector<double>> data;
    for (const auto &c : std::vector<std::vector<double>>{{0, 0}, {10, 0},
                                                          {5, 8}})
        for (int i = 0; i < 30; ++i)
            data.push_back({c[0] + j(rng), c[1] + j(rng)});
    data.push_back({20, 20});
    data.push_back({-15, 12});
    const auto t = dm::algorithms::k_medoids_trace(data, 3, 100, 2);
    std::vector<std::size_t> sizes(3);
    for (auto c : t.result.assignment)
        ++sizes[c];
    std::print("| cluster slot | medoid identity | medoid x | medoid y | assigned count |\n| ---: | ---: | " "---: | ---: | ---: |\n");
    for (std::size_t c = 0; c < 3; ++c) {
        auto m = t.result.medoids[c];
        std::print("| {} | {} | {:.12f} | {:.12f} | {} |\n", c, m, data[m][0],
                   data[m][1], sizes[c]);
    }
    std::print("\n| accepted state | actual objective |\n| ---: | ---: |\n");
    for (std::size_t i = 0; i < t.states.size(); ++i)
        std::print("| {} | {:.12f} |\n", i, t.states[i].cost);
    std::print("\nActual candidate evaluations {}; assignment passes {}; distance lookups {}; pair " "distances {}; exhausted {}.\n",
               t.work.candidates, t.work.assignment_passes,
               t.work.distance_lookups, t.work.distance_pairs,
               t.stop == dm::algorithms::KMedoidsStop::NoImprovement);
    auto p = dm::graphics::RPlot::create();
    const std::vector<dm::graphics::RGB> cols = {{239, 68, 68}, {59, 130, 246},
                                                 {22, 163, 74}};
    for (std::size_t c = 0; c < 3; ++c) {
        std::vector<double> x, y;
        for (std::size_t i = 0; i < data.size(); ++i)
            if (t.result.assignment[i] == c) {
                x.push_back(data[i][0]);
        y.push_back(data[i][1]);
            }
            p.points(x, y, std::format("group {}", c), cols[c], 3.5);
    }
    std::vector<double> mx, my;
    for (auto m : t.result.medoids) {
        mx.push_back(data[m][0]);
        my.push_back(data[m][1]);
    }
    p.points(mx, my, "medoids", {17, 24, 39}, 9).size(850, 850).margins(95, 35,
                                                                        60, 70).x_limits(-18, 28).y_limits(-18, 28).title("Original 92 points and actual medoids").x_label("x").y_label("y").save_svg("build/k_medoids_original.svg");
}
```
