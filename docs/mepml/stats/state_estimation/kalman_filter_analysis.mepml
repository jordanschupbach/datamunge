> A realized-error counterexample and sigma-parameter controls

For a scalar filter seeing [0,10] while the chosen realized truth is [0,0],
future information can pull the earlier smoothed estimate away from its actual
truth. This does not contradict the model's covariance reduction: conditional
expected error and the realized error of one sequence are different objects. The
program prints both empirical MSEs without asserting that smoothing must win.

The UKF profile then holds the original nonlinear data and model fixed while
changing alpha. It records each complete result or explicit failure. Finite
parameter trials do not isolate approximation error from roundoff or establish a
generally optimal alpha.

```{cpp, results="markdown", file="figures/kalman_controls.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <datamunge/filter/kalman_analysis.hpp>
#include <datamunge/plot/diagram.hpp>
#include <filesystem>
#include <print>
#include <stdexcept>
#include <algorithm>
#include <numeric>
#include <cmath>
int main() {
    std::filesystem::create_directories("build");
    dm::filter::KalmanFilter control({{1}}, {{1}}, {{.1}}, {{1}}, {0}, {{1}});
    const auto c = control.smooth({{0}, {10}});
    std::print("| realized-error control | filtered MSE | smoothed MSE |\n| --- | ---: | ---: |\n| truth " "zero, observations zero and ten | {:.12f} | {:.12f} |\n",
               dm::filter::kalman_position_mse(c.filtered, {0, 0}),
               dm::filter::kalman_position_mse(c.smoothed, {0, 0}));
    const auto d = dm::filter::kalman_demo_data();
    std::print("\n| actual UKF alpha | outcome | final position | realized nonlinear position MSE |\n| ---: " "| --- | ---: | ---: |\n");
    std::vector<double> x, y;
    for (double alpha : {.001, .05, .1, .5, 1.}) {
        try {
            const auto v = dm::filter::kalman_demo_ukf(d, alpha);
            const auto mse =
                dm::filter::kalman_position_mse(v, d.nonlinear_truth);
            std::print("| {:.3f} | complete | {:.12f} | {:.12e} |\n", alpha,
                       v.back().x[0], mse);
            x.push_back(std::log10(alpha));
            y.push_back(mse);
        } catch (const std::runtime_error &) {
            std::print("| {:.3f} | native numerical failure | unavailable | unavailable |\n",
                       alpha);
        }
    }
    if (x.empty())
        throw std::runtime_error("no complete UKF profile run");
    bool cap = false;
    try {
        (void) dm::filter::kalman_family_study(d, {300, 300, .001, 139, 600});
    } catch (const std::length_error &) {
        cap = true;
    }
    if (!cap)
        throw std::runtime_error("complete step admission");
    std::print("\nThe complete140-input-step study rejects a139-step ceiling before running filters.\n");
    const double maximum = *std::max_element(y.begin(), y.end());
    auto p = dm::graphics::RPlot::create();
    p.line(x, y, "actual UKF", {37, 99, 235}, 2).points(x, y, "", {37, 99, 235},
                                                        5).title(
        "Complete original-data UKF parameter trials").x_label("log10(alpha)").y_label("realized position MSE").y_limits(-.05 * maximum, 1.3 * maximum + .01).save_svg("build/kalman_controls.svg");
}
