#include <print>
#include <stdexcept>
#include <algorithm>
#include <numeric>
#include <cmath>
int main() {
    std::filesystem::create_directories("build");
    const auto s =
        dm::filter::kalman_family_study(dm::filter::kalman_demo_data());
    const char *names[] = {"EKF", "UKF", "EnKF", "PF"};
    const std::vector<dm::filter::KalmanState> *states[] = {&s.ekf, &s.ukf,
                                                            &s.ensemble,
                                                            &s.particle};
    std::print("| actual method | complete steps | final position | final velocity | realized position MSE " "|\n| --- | ---: | ---: | ---: | ---: |\n");
    for (int j = 0; j < 4; ++j) {
        const auto &v = *states[j];
        std::print("| {} | {} | {:.12f} | {:.12f} | {:.12e} |\n", names[j],
                   v.size(), v.back().x[0], v.back().x[1],
                   dm::filter::kalman_position_mse(v, s.data.nonlinear_truth));
    }
    std::print("\n| original step | nonlinear observation | true position | actual EKF | actual UKF | " "actual EnKF | actual PF |\n| ---: | ---: | ---: | ---: | ---: | ---: | ---: |\n");
    for (std::size_t i : {0, 1, 2, 9, 24, 49})
        std::print("| {} | {:.12f} | {} | {:.12f} | {:.12f} | {:.12f} | {:.12f} |\n",
                   i + 1, s.data.nonlinear_measurements[i][0],
                   s.data.nonlinear_truth[i], s.ekf[i].x[0], s.ukf[i].x[0],
                   s.ensemble[i].x[0], s.particle[i].x[0]);
    std::vector<double> t(50);
    std::iota(t.begin(), t.end(), 1.);
    auto p = dm::graphics::RPlot::create();
    p.line(t, s.data.nonlinear_truth, "truth", {17, 24, 39}, 2).line(
        t, dm::filter::kalman_state_column(s.ekf), "EKF", {220, 38, 38}, 2).line(t, dm::filter::kalman_state_column(s.ukf), "UKF", {37, 99, 235}, 2).line(t, dm::filter::kalman_state_column(s.ensemble), "EnKF", {5, 150, 105}, 2).line(t, dm::filter::kalman_state_column(s.particle), "PF", {139, 92, 246}, 2).title("Original nonlinear data: all actual estimator paths").x_label("timestep").y_label("position").y_limits(-10, 150).save_svg("build/kalman_nonlinear.svg");
}
