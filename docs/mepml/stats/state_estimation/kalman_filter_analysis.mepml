> Retain both fixed-gain tracker controls

Alpha-beta predicts position plus velocity times dt, then corrects position by
alpha times residual and velocity by beta residual/dt. The original gains are
(.5,.3),dt1 on the position-only observations. Fixed gains are a chosen
approximation, not automatically the steady-state gain of the exact Q/R model
used above.

Alpha-beta-gamma adds acceleration prediction and correction2 gamma
residual/dt². The original (.5,.1,.01),dt1 control begins at rest and receives
forty noiseless positions from true acceleration.5. Its input differs from the
noisy fifty-step constant-velocity experiment, so cross-panel errors are not a
common-data competition.

```{cpp, results="markdown", file="figures/kalman_fixed_gain.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <datamunge/filter/kalman_analysis.hpp>
#include <datamunge/plot/diagram.hpp>
#include <filesystem>
#include <print>
#include <stdexcept>
#include <algorithm>
#include <numeric>
#include <cmath>
int main() {
    std::filesystem::create_directories("build");
    const auto s =
        dm::filter::kalman_family_study(dm::filter::kalman_demo_data());
    std::vector<double> t(s.alpha_beta.size()), ab, ta(s.alpha_beta_gamma.size()), accel, truth_accel(s.alpha_beta_gamma.size(), .5);
    std::iota(t.begin(), t.end(), 1.);
    std::iota(ta.begin(), ta.end(), 1.);
    for (const auto &v : s.alpha_beta)
        ab.push_back(v.position);
    for (const auto &v : s.alpha_beta_gamma)
        accel.push_back(v.acceleration);
    std::print("| original tracker | steps | final position | final velocity | final acceleration |\n| --- " "| ---: | ---: | ---: | --- |\n| alpha-beta | {} | {:.12f} | {:.12f} | not modeled |\n| " "alpha-beta-gamma | {} | {:.12f} | {:.12f} | {:.12f} |\n",
               s.alpha_beta.size(), s.alpha_beta.back().position,
               s.alpha_beta.back().velocity, s.alpha_beta_gamma.size(),
               s.alpha_beta_gamma.back().position,
               s.alpha_beta_gamma.back().velocity,
               s.alpha_beta_gamma.back().acceleration);
    std::print("\n| acceleration step | original measurement | actual acceleration estimate |\n| ---: | " "---: | ---: |\n");
    for (std::size_t i : {0, 1, 2, 9, 19, 39})
        std::print("| {} | {} | {:.12f} |\n", i + 1,
                   s.data.acceleration_measurements[i],
                   s.alpha_beta_gamma[i].acceleration);
    auto p = dm::graphics::RPlot::create();
    p.line(t, s.data.linear_truth, "truth", {17, 24, 39}, 2).line(t, ab, "AB",
                                                                  {220, 38, 38},
                                                                  2).title(
        "Original noisy constant velocity").x_label("step").y_label("position").y_limits(-10, 140);
    auto q = dm::graphics::RPlot::create();
    q.line(ta, truth_accel, "truth", {17, 24, 39}, 2).line(ta, accel, "ABG",
                                                           {37, 99, 235}, 2).title("Original noiseless acceleration").x_label("step").y_label("acceleration").y_limits(-.05, .8);
    auto layout = dm::graphics::RLayout::create(1, 2);
    layout.add(p).add(q).size(1100, 500).title("Actual fixed-gain trackers on their original sequences").fit_panels().save_svg("build/kalman_fixed_gain.svg");
}
