> Checking the theory and controls

```{cpp, results="markdown", file="figures/v_statistic_controls.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    std::vector<double> x, y;
    std::print("| sample | exact V | U if n>=2 |\n|---|---:|---:|\n");
    int i = 0;
    for (auto sample : std::vector<std::vector<double>>{{1}, {1, 1}, {1, 3},
                                                        {1, 2, 4}}) {
        auto v =
            dm::stats::VStatistic(2).run(sample,
                                         dm::stats::empirical_variance_kernel);
        double u =
            sample.size() > 1
            ? dm::stats::UStatistic(2).run(sample,
                                           dm::stats::empirical_variance_kernel).estimate
            : 0;
        std::print("|`{}`|{}|{}|\n", sample, v.estimate, u);
        x.push_back(i++);
        y.push_back(v.estimate);
    }
    auto p = g::RPlot::create();
    p.line(x, y, "actual", {37, 99, 235}, 2);
    p.points(x, y, "", {37, 99, 235}, 5);
    p.title("Singleton, constant and hand-checkable variance controls").x_label(
        "control index").y_label("actual exact V");
    p.save_svg("build/v_statistic_controls.svg");
}
```
// result_begin: markdown
| sample | exact V | U if n>=2 |
|---|---:|---:|
