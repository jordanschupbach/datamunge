> The retained original experiment

```{cpp, results="markdown", file="figures/v_statistic_original.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    auto full = dm::stats::v_statistic_example_sample();
    std::vector<double> nx, uy, vy;
    std::print("| n | actual U | actual V | V-U | (n-1)/n*U |\n|---:|---:|---:|---:|---:|\n");
    for (std::size_t n : {5, 10, 20, 40, 80, 160}) {
        std::vector<double> sample(full.begin(), full.begin() + n);
        auto u =
            dm::stats::UStatistic(2).run(sample,
                                         dm::stats::empirical_variance_kernel).estimate;
        auto v =
            dm::stats::VStatistic(2).run(sample,
                                         dm::stats::empirical_variance_kernel);
        std::print("|{}|{}|{}|{}|{}|\n", n, u, v.estimate, v.estimate - u,
                   double(n - 1) / n * u);
        nx.push_back(n);
        uy.push_back(u);
        vy.push_back(v.estimate);
    }
    auto p = g::RPlot::create();
    p.line(nx, uy, "actual U", {37, 99, 235});
    p.line(nx, vy, "actual V", {220, 38, 38});
    p.abline_h(4, {148, 163, 184});
    p.title("Original normal(0,2) prefixes: variance kernel").x_label(
        "sample size").y_label("variance estimate; reference population4");
    p.save_svg("build/v_statistic_original.svg");
}
```
