> Sensitivity and selected work

```{cpp, results="markdown", file="figures/v_statistic_work.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    auto sample = dm::stats::v_statistic_example_sample(40);
    double exact =
        dm::stats::VStatistic(2).run(sample,
                                     dm::stats::empirical_variance_kernel).estimate;
    std::vector<double> x, y;
    std::print("| requested draws | actual terms | exact mode | estimate | absolute error to complete V " "|\n|---:|---:|---|---:|---:|\n");
    for (std::size_t draws : {10, 100, 1000, 10000, 100000}) {
        auto r =
            dm::stats::VStatistic(2, {draws, 42}).run(sample,
                                                      dm::stats::empirical_variance_kernel);
        std::print("|{}|{}|{}|{}|{}|\n", draws, r.num_terms, r.exact,
                   r.estimate, std::abs(r.estimate - exact));
        x.push_back(std::log10(draws));
        y.push_back(std::abs(r.estimate - exact));
    }
    auto p = g::RPlot::create();
    p.line(x, y, "actual", {37, 99, 235}, 2);
    p.points(x, y, "", {37, 99, 235}, 5);
    p.title("One fixed-seed Monte Carlo path need not improve monotonically").x_label("log10 actual draws").y_label("absolute error to complete empirical V");
    p.save_svg("build/v_statistic_work.svg");
}
```
