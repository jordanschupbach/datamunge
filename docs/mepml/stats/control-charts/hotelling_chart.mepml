//? Title: Hotelling T² for correlated measurements
//? Exports: both
//? Lang: en-GB

\abstract(
Two synthetic sensor residuals are measured on each run. An independent
calibration supplies their in-control mean, variances, and positive covariance.
This example compares aligned and opposing deviations of equal component
size. Opposing deviations are less likely under the calibrated covariance.
)

> Fit, monitor and plot

```{cpp, results="markdown", file="figures/hotelling_chart.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>


namespace spc = datamunge::stats;
using datamunge::graphics::RLayout;

int main() {
    const std::vector<std::vector<double>> readings{
        {-0.6, -0.5}, {0.2, 0.3}, {0.7, 0.5}, {-0.9, -0.6}, {0., 0.1},
        {1.5, 1.5}, {1.5, -1.5}, {-0.4, -0.1}, {1.4, -1.3}
    };
    const datamunge::linalg::DenseMatrix<double> covariance(2, 2, {1., 0.85, 0.85, 1.});
    const auto chart = spc::hotelling_t2_chart(readings, {0., 0.}, covariance);
    std::print("| Run | Sensor 1 | Sensor 2 | T² | Signal |\n"
               "| ---: | ---: | ---: | ---: | :--- |\n");
    for (std::size_t i = 0; i < readings.size(); ++i)
        std::print("| {} | {:.2f} | {:.2f} | {:.2f} | {} |\n",
                   i + 1, readings[i][0], readings[i][1],
                   chart.points[i].value, chart.points[i].outside ? "yes" : "");
    std::filesystem::create_directories("build");
    chart.plot().save_svg("build/hotelling_chart.svg");
}
```
// result_begin: markdown
