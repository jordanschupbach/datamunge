//? Title: Compare quadratic and regularized discriminant models
//? Exports: both
//? Lang: en

> See how covariance regularization changes class probabilities

Three process profiles are identified from two measurements in this
synthetic dataset. Quadratic discriminant analysis fits a separate
covariance to each profile. With only a few training rows per profile,
the regularized fit shares some within-profile scatter and then shrinks
each covariance toward a spherical shape. The two fits use the same
class priors and covariance normalization.

```{cpp, id=regularized-class-probability, file="figures/regularized_class_probability.svg", results="markdown", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <datamunge/plot/plot.hpp>
#include <datamunge/stats/regularized_discriminant.hpp>
#include <filesystem>
#include <print>

int main() {
    using namespace datamunge;
    const linalg::DenseMatrix<double> observations(15,2,{
        -3,0,-2,2,-1,-.4,-1.6,1.3,-2.4,-.6,
        0,2,.6,2.2,2,3,1.8,1.7,
        2,-2,3,-1.6,3.1,-2.5,4.2,-.5,4.1,-2.8,2.7,-2.1});
    const std::vector<std::string> label{"Zeta","Zeta","Zeta","Zeta","Zeta",
        "Alpha","Alpha","Alpha","Alpha","Beta","Beta","Beta","Beta","Beta","Beta"};
    const auto quadratic = stats::fit_quadratic_discriminant(observations,label);
    const auto regularized = stats::fit_regularized_discriminant(observations,label,
        {.pooling=.37,.shrinkage=.22});

    const linalg::DenseMatrix<double> query(1,2,{1.7,.5});
    std::println("| Model | Alpha | Beta | Zeta |");
    std::println("| --- | ---: | ---: | ---: |");
    const auto show = [&](const char* name, const stats::RegularizedDiscriminantFit& fit) {
        const auto probabilities = fit.predict(query).posterior;
        std::println("| {} | {:.3f} | {:.3f} | {:.3f} |",name,
            probabilities(0,0),probabilities(0,1),probabilities(0,2));
    };
    show("Quadratic",quadratic);
    show("Regularized",regularized);

    linalg::DenseMatrix<double> grid(161,2,.5);
    std::vector<double> measurement;
    for (std::size_t i = 0; i < grid.rows(); ++i) {
        grid(i,0) = -3.5+.05*i;
        measurement.push_back(grid(i,0));
    }

    std::filesystem::create_directories("build");
    auto plot = graphics::RPlot::create();
    plot.abline_v(1.7,graphics::RGBA{170,179,188})
        .line(measurement,quadratic.predict(grid).posterior.col(0),"Quadratic",graphics::RGBA{31,85,147},2.7)
        .line(measurement,regularized.predict(grid).posterior.col(0),"Regularized",graphics::RGBA{164,72,39},2.7)
        .title("Probability of the Alpha profile")
        .x_label("Measurement A with B fixed at 0.5").y_label("Posterior probability")
        .y_limits(-.02,1.16).size(740,420).save_svg("build/regularized_class_probability.svg");
}
```
// result_begin: markdown
| Model | Alpha | Beta | Zeta |
| --- | ---: | ---: | ---: |
| Quadratic | 0.721 | 0.276 | 0.003 |
| Regularized | 0.964 | 0.035 | 0.001 |
\image(figures/regularized_class_probability.svg)
// result_end
\caption(The vertical line marks the query at which the table reports all three class probabilities.)
\alttext(The regularized model's Alpha probability curve is wider. At the marked query its probability is 0.964, compared with 0.721 for the quadratic model.)

At the query shown in the table, both models choose Alpha. Pooling and
shrinkage change its probability by changing the Gaussian densities
assigned to each profile. The probability curves follow the same slice
through the two-dimensional predictor space.

[Friedman, Regularized Discriminant Analysis|https://doi.org/10.1080/01621459.1989.10478752]
