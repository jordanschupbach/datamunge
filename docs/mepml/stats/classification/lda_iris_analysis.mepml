> Original new flowers and posterior uncertainty

Retain all four original unlabelled query flowers, including the intermediate
petal measurements4.8 and1.8. Predictor columns alone suffice for inference;
response labels are not required. The native posterior table and score plot show
actual predictions from the original complete-data model. No new training,
hand-entered probabilities or calibration claim is introduced.

```{cpp, results="markdown", file="figures/lda_queries.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <datamunge/datasets/datasets.hpp>
#include <datamunge/stats/lda.hpp>
#include <datamunge/plot/plot.hpp>
#include <filesystem>
#include <print>
int main() {
    std::filesystem::create_directories("build");
    dm::stats::LDA m(dm::datasets::iris(),
                     "Species ~ Sepal.Length + Sepal.Width + Petal.Length + Petal.Width");
    dm::dstruct::DataFrame q;
    q.add_column("Sepal.Length", std::vector<double>{5.1, 6, 6.5, 6.2});
    q.add_column("Sepal.Width", std::vector<double>{3.5, 2.7, 3, 2.8});
    q.add_column("Petal.Length", std::vector<double>{1.4, 4.5, 5.5, 4.8});
    q.add_column("Petal.Width", std::vector<double>{.2, 1.5, 2, 1.8});
    auto p = m.predict_detail(q);
    std::print("Original query predictors:\n{}\n| actual query index | actual prediction | actual P(setosa) " "| actual P(versicolor) | actual P(virginica) |\n| ---: | --- | ---: | ---: | ---: |\n",
               q.to_md());
    for (std::size_t i = 0; i < 4; ++i)
        std::print("| {} | {} | {:.10f} | {:.10f} | {:.10f} |\n", i,
                   p.class_label[i], p.posterior[i][0], p.posterior[i][1],
                   p.posterior[i][2]);
    auto plot = dm::graphics::RPlot::create();
    for (std::size_t c = 0; c < 3; ++c) {
        std::vector<double> x, y;
        for (std::size_t i = 0; i < 4; ++i) {
            x.push_back(i);
            y.push_back(p.posterior[i][c]);
        }
        plot.line(x, y, m.classes()[c],
                  c == 0 ? dm::graphics::RGB{78, 121, 167} : c == 1
                  ? dm::graphics::RGB{242, 142, 43}
                  : dm::graphics::RGB{225, 87, 89}, 2).points(x, y, "",
                                                              {31, 41, 55}, 3);
    }
    plot.y_limits(-.05, 1.35).title("Actual original-model query posteriors").x_label("original query index").y_label("model posterior probability").save_svg("build/lda_queries.svg");
}
```
