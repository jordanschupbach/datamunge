> The retained original experiment

```{cpp, results="markdown", file="figures/random_generation_original.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");

    namespace r = dm::random;
    auto t = r::sample_distributions_run(0xC0FFEEULL, 10000);
    std::print("\n| original stream quantity | actual native value |\n| --- | ---: |\n| final uniform[-2,5) " "| {:.4f} |\n| observed integer minimum | {} |\n| observed integer maximum | {} |\n| " "Bernoulli mean | {:.4f} |\n| normal mean | {:.4f} |\n| exponential mean | {:.4f} |\n| " "actual raw calls | {} |\n",
               t.final_uniform, t.minimum, t.maximum, t.bernoulli_mean,
               t.normal_mean, t.exponential_mean, t.raw_draws);
    std::vector<double> normal;
    for (const auto &s : t.samples)
        normal.push_back(s.normal);
    auto p = g::RPlot::hist(normal, 30);
    p.title("Original interleaved stream: actual normal observations").x_label(
        "actual sampled normal value").y_label("observed sample count");
    p.save_svg("build/random_generation_original.svg");
}
```
