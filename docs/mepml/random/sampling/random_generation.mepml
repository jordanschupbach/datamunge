> Explicit controls

```{cpp, results="markdown", file="figures/random_generation_controls.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");

    namespace r = dm::random;
    std::vector<double> counts;
    std::vector<std::string> labels{"probability zero", "probability one",
                                    "full uint64 interval"};
    std::print("\n| actual control | Bernoulli successes | actual integer min | actual integer max | actual " "raw draws |\n| --- | ---: | ---: | ---: | ---: |\n");
    for (int i = 0; i < 3; ++i) {
        r::SamplingParameters p;
        if (i < 2)
            p.probability = i;
        else {
            p.integer_lower = 0;
            p.integer_upper = std::numeric_limits<std::uint64_t>::max();
        }
        auto t = r::sample_distributions_run(42, 32, p);
        counts.push_back(t.successes);
        std::print("| {} | {} | {} | {} | {} |\n", labels[i], t.successes,
                   t.minimum, t.maximum, t.raw_draws);
    }
    r::SamplingParameters p;
    p.uniform_lower = 1;
    p.uniform_upper = std::nextafter(1., 2.);
    auto adjacent = r::sample_distributions_run(42, 0, p);
    p.uniform_lower = -std::numeric_limits<double>::max();
    p.uniform_upper = std::numeric_limits<double>::max();
    auto extreme = r::sample_distributions_run(42, 0, p);
    std::print("Adjacent-double half-open result equals lower: {}; extreme-span final draw finite: {}; " "zero-tuple raw draws: {}.\n",
               adjacent.final_uniform == 1,
               std::isfinite(extreme.final_uniform), adjacent.raw_draws);
    auto plot =
        g::RPlot::barplot(counts, labels, "actual successes in32 trials");
    plot.title("Distribution boundaries still consume actual raw draws").y_label("actual Bernoulli successes");
    plot.save_svg("build/random_generation_controls.svg");
}
```
