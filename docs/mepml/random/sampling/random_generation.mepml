> Actual selected work and sensitivity

```{cpp, results="markdown", file="figures/random_generation_work.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");

    namespace r = dm::random;
    std::vector<double> x, y, z;
    std::print("\n| tuples | actual Bernoulli mean | absolute target error | nominal sqrt(p(1-p)/n) | " "actual normal mean | actual exponential mean | actual raw draws |\n| ---: | ---: | ---: | " "---: | ---: | ---: | ---: |\n");
    for (std::size_t n : {16, 64, 256, 1024, 4096, 16384}) {
        auto t = r::sample_distributions_run(0xC0FFEEULL, n);
        x.push_back(n);
        y.push_back(std::fabs(t.bernoulli_mean - .3));
        z.push_back(std::sqrt(.3 * .7 / n));
        std::print("| {} | {} | {} | {} | {} | {} | {} |\n", n,
                   t.bernoulli_mean, y.back(), z.back(), t.normal_mean,
                   t.exponential_mean, t.raw_draws);
    }
    auto p = g::RPlot::create();
    p.lines(x, y, "actual fixed-seed absolute mean error", {37, 99, 235}).lines(
        x, z, "nominal Bernoulli standard-error scale", {234, 88, 12}).points(
        x, y, {37, 99, 235}, 5).title("Finite seeded means fluctuate around their target").x_label("interleaved sampled tuples").y_label("absolute error / nominal reference scale");
    p.save_svg("build/random_generation_work.svg");
}
```
