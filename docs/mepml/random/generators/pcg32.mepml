> Controls and boundary cases

```{cpp, results="markdown", file="figures/pcg32_controls.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
    std::filesystem::create_directories("build");
    dm::random::Pcg32 a(42, 54), alias(42, 54ULL + (1ULL << 63)), other(42, 55);
    std::vector<double> x, y, z;
    std::print("| draw | selector54 | top-bit alias | selector55 |\n| ---: | ---: | ---: | ---: |\n");
    for (int i = 0; i < 8; ++i) {
        auto u =
            a.next_u32_trace().output, v =
            alias.next_u32_trace().output, w = other.next_u32_trace().output;
        x.push_back(i);
        y.push_back(u);
        z.push_back(w);
        std::print("| {} | {} | {} | {} |\n", i, u, v, w);
    }
    auto p = dm::graphics::RPlot::create();
    p.points(x, y, "selector54", {37, 99, 235}, 4).points(x, z, "selector55",
                                                          {220, 38, 38}, 4).title("PCG selector controls: top-bit alias, distinct adjacent increment").x_label("actual transition").y_label("actual uint32 output");
    p.y_limits(0, 4294967295.0);
    p.y_ticks({0, 1e9, 2e9, 3e9, 4e9}, {"0", "1e9", "2e9", "3e9", "4e9"});
    p.save_svg("build/pcg32_controls.svg");
}
```
