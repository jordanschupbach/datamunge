> The original fixture, retained

This complete program retains the original inputs, seed and substantive
experiment. Any added display prefix is explicitly separate from the original
random call schedule.

```{cpp, results="markdown", file="figures/pcg32_original.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
    std::ostringstream original_output;
    auto *original_cout = std::cout.rdbuf(original_output.rdbuf());

    std::filesystem::create_directories("build");
    datamunge::random::Pcg32 rng(0xC0FFEEULL);
    std::cout << "raw word = " << rng.next_u64() << "\n" << std::fixed <<
        std::setprecision(6) << "exponential(rate=4) = " <<
        rng.exponential(4.0) << "\n" << "Bernoulli(0.3) = " <<
        rng.bernoulli(0.3) << "\n";
    auto p = dm::graphics::RPlot::create();
    dm::random::Pcg32 sampled(0xC0FFEEULL);
    std::vector<double> x, y;
    for (int i = 0; i < 16; ++i) {
        x.push_back(i);
        y.push_back(sampled.next_u32_trace().output);
    }
    p.points(x, y, "actual 32-bit prefix", {37, 99, 235}, 4).title(
        "Original PCG seed: a separately labelled 32-bit output prefix").x_label("transition").y_label("actual uint32 output");
    p.y_limits(0, 4294967295.0);
    p.y_ticks({0, 1e9, 2e9, 3e9, 4e9}, {"0", "1e9", "2e9", "3e9", "4e9"});
    p.save_svg("build/pcg32_original.svg");
    std::cout.rdbuf(original_cout);
    std::print("| Original computed output |\n| --- |\n");
    std::istringstream lines(original_output.str());
    std::string line;
    while (std::getline(lines, line)) {
        while (!line.empty() && line.back() == ' ') line.pop_back();
        if (!line.empty()) std::print("| `{}` |\n", line);
    }

}
```
