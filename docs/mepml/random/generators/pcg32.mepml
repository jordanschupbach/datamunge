> Producing work and finite observations

```{cpp, results="markdown", file="figures/pcg32_work.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
    std::filesystem::create_directories("build");
    dm::random::Pcg32 r(42, 54);
    std::vector<double> v(16, 0);
    for (int i = 0; i < 4096; ++i)
        ++v[r.next_u32_trace().output >> 28];
    std::vector<std::string> labels;
    for (int i = 0; i < 16; ++i)
        labels.push_back(std::to_string(i));
    std::print("Actual first4096 high-nibble counts: `{}`.\n", v);
    auto p =
        dm::graphics::RPlot::barplot(v, labels, "actual high-nibble count");
    p.title("PCG finite-prefix histogram: descriptive, not an independence test").x_label("high nibble").y_label("actual count");
    p.save_svg("build/pcg32_work.svg");
}
```
