//? Title: Physics-informed networks for four manufactured PDEs
//? Lang: en

> Physics-informed networks for four manufactured PDEs

A coordinate network predicts the field and supplies analytic first
and second derivatives. Interior collocation points penalize a PDE
residual. Initial and boundary points penalize differences from the
prescribed field. The wave example also penalizes nonzero initial
velocity. The Navier–Stokes example fits the two velocity components
and pressure, with boundary pressure fixing its additive constant.

The examples use heat diffusion, the wave equation, forced Burgers,
and the decaying Taylor–Green vortex. Each has a known solution,
so field error and equation residual can be measured independently
on held-out points. A small residual alone does not establish an
accurate solution.

```{cpp, results="markdown", file="figures/pinn_equations.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <numbers>

namespace n=dm::nn;
using E=n::PinnEquation;
constexpr double pi=std::numbers::pi, nu=.1;

std::array<double,3> exact(E equation,double x,double y,double t) {
  switch(equation) {
  case E::Heat: return {std::sin(pi*x)*std::exp(-nu*pi*pi*t),0,0};
  case E::Wave: return {std::sin(pi*x)*std::cos(pi*t),0,0};
  case E::Burgers: return {std::exp(-t)*std::sin(pi*x),0,0};
  case E::NavierStokes:
    const double a=std::exp(-2*nu*pi*pi*t);
    return {a*std::sin(pi*x)*std::cos(pi*y),-a*std::cos(pi*x)*std::sin(pi*y),
        .25*a*a*(std::cos(2*pi*x)+std::cos(2*pi*y))};
  }
  throw std::invalid_argument("unknown equation");
}

double forcing(E equation,double x,double t) {
  return equation==E::Burgers?exact(equation,x,0,t)[0]*
      (-1+nu*pi*pi+pi*std::exp(-t)*std::cos(pi*x)):0.;
}

std::pair<n::Tensor,n::Tensor> data(E equation,int count,unsigned seed,bool fit) {
  std::mt19937 rng(seed);
  std::uniform_real_distribution<double> axis(-1,1),time(0,1);
  std::vector<float> input,target;
  for(int i=0;i<count;++i) {
    float x=axis(rng),y=equation==E::NavierStokes?axis(rng):0.f,t=time(rng);
    const int face=fit?i%4:0;
    if(face==1 || (face==3 && equation!=E::NavierStokes)) t=0;
    if(face==2) x=i%8==2?-1.f:1.f;
    if(face==3 && equation==E::NavierStokes) y=i%8==3?-1.f:1.f;
    input.insert(input.end(),{x,y,t,float(forcing(equation,x,t)),float(face!=0)});
    for(double component:exact(equation,x,y,t))
      target.push_back(fit && face==0?0.:component);
  }
  return {n::from_vector(input,{count,5}),n::from_vector(target,{count,3})};
}

int main() {
  auto layout=dm::graphics::RLayout::create(2,2);
  std::filesystem::create_directories("build");
  std::print("| Equation | Initial objective | Final objective | Field RMSE | PDE RMS |\n|---|---:|---:|---:|---:|\n");
  for (const auto& [equation,name]:std::array{
      std::pair{E::Heat,"heat"},std::pair{E::Wave,"wave"},std::pair{E::Burgers,"burgers"},
      std::pair{E::NavierStokes,"navier_stokes"}}) {
    const int fields=equation==E::NavierStokes?3:1;
    const auto [fit_x,fit_y]=data(equation,768,5192,true);
    const auto [test_x,test_y]=data(equation,256,5193,false);
    n::ParameterStore model(41380);
    const auto apply=[&](const n::Tensor& x) {
      return n::pinn_field(model,n::slice_axis(x,1,0,3),equation,n::slice_axis(x,1,3,4),float(nu));
    };
    const auto loss=[&](const n::Tensor& x,const n::Tensor& y) {
      const auto out=apply(x);
      const auto mask=n::slice_axis(x,1,4,5);
      auto boundary=n::mean(mask*n::square(out.value-n::slice_axis(y,1,0,fields)));
      if(equation==E::Wave)
        boundary=boundary+n::mean(n::square(n::cast(n::equal(n::slice_axis(x,1,2,3),0.),x.dtype())*out.speed));
      return 5.*boundary+n::mean((1.-mask)*n::square(out.residual));
    };
    const auto initial=loss(fit_x,fit_y).item();
    n::Optimizer optimizer(model,.01,{.kind=n::OptimizerKind::Adam});
    n::BatchOrder order(768,32,5194);
    int updates=0;
    for(int epoch=0;epoch<3;++epoch) {
      order.begin_epoch();
      for(auto rows=order.next();!rows.empty();rows=order.next()) {
        optimizer.minimize(loss(n::take_rows(fit_x,rows),n::take_rows(fit_y,rows)));
        ++updates;
      }
    }
    n::NoGradGuard guard;
    const auto result=apply(test_x);
    const auto value=n::slice_axis(test_y,1,0,fields);
    const auto final=loss(fit_x,fit_y).item();
    const auto error=n::sqrt(n::mean(n::square(result.value-value))).item();
    const auto pde=n::sqrt(n::mean(n::square(result.residual))).item();
    if (updates!=72 || !(final<initial && std::isfinite(error) && std::isfinite(pde)))
      throw std::runtime_error("PINN training check failed");
    std::print("| {} | {:.5f} | {:.5f} | {:.5f} | {:.5f} |\n",name,initial,final,error,pde);
    const auto mask=n::slice_axis(test_x,1,4,5);
    const auto speed=n::cast(n::equal(n::slice_axis(test_x,1,2,3),0.),test_x.dtype())*result.speed;
    n::save_npz(std::string("build/pinn_")+name+".npz",{{"input",test_x.reshape({256,5,1})},
        {"exact",test_y},{"prediction",n::concat({result.value,result.residual,mask,speed},1)}});
    const auto x=n::select(value,1,0).to_vector<double>();
    const auto y=n::select(result.value,1,0).to_vector<double>();
    const std::vector<double> diagonal{-1.,1.};
    auto plot=dm::graphics::RPlot::create();
    plot.lines(diagonal,diagonal,"Identity",{100,100,100})
        .points(x,y,"Held-out queries",{37,99,235},3)
        .title(name).x_label("Analytic first field").y_label("Fit");
    layout.add(plot);
  }
  layout.size(1060,820).fit_panels().save_svg("build/pinn_equations.svg");
}
```
