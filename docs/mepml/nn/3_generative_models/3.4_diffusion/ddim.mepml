> Work through the clean endpoint

With previous=-1, previous alpha_bar is one. Both the noise-direction coefficient and transition variance vanish, leaving the clipping-consistent clean estimate. Changing the explicit innovation cannot alter this endpoint.

```{cpp, results="markdown", file="figures/ddim_worked.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <iostream>
namespace n=dm::nn;namespace m=n::models;using T=n::Tensor;
int main(){std::filesystem::create_directories("build");
auto x=n::from_vector(std::vector<float>{-.5f,0,.5f,1.5f},{2,2}),time=n::zeros({2},n::DType::Int32),previous=n::full({2},-1,n::DType::Int32);auto out=m::DdimReverse(x,time,previous,n::zeros({2,2}),n::ones({2,2}),n::scalar(1),m::CosineDiffusionSchedule());T left=x,right=out.value,extra=out.x0_clipped;
 auto av=left.to_vector<double>(),bv=right.to_vector<double>(),cv=extra.to_vector<double>();
 std::cout<<"| Noisy value | DDIM endpoint | Clipped x0 |\n|---:|---:|---:|\n";
 for(std::size_t i=0;i<av.size();++i)std::cout<<"|"<<av[i]<<"|"<<bv[i]<<"|"<<cv[i]<<"|\n";
 n::save_npz("build/ddim_worked.npz",{{"a",left},{"b",right},{"c",extra}});
 dm::graphics::RPlot::create().points(n::arange(0,std::int64_t(bv.size())).to_vector<double>(),bv,"Native worked values",{37,99,235},4).x_label("Coordinate / probe index").y_label("Native computed value").title("Work through the clean endpoint").size(900,500).save_svg("build/ddim_worked.svg");
}
