int main(){std::filesystem::create_directories("build");dm::graphics::Diagram d(28,1150);dm::graphics::DiagramNodeStyle s;s.width=11;s.height=5;s.font_size=30;d.node("input",{-18,0},"Endpoint x + base z\nExplicit time t",s).node("predict",{-5,0},"Straight coupling\nTarget x-z",s).node("step",{8,0},"1250-value MLP\nVelocity field",s).node("loop",{21,0},"Caller Euler / RK4\nDeterministic path",s).edge("input","predict").edge("predict","step").edge("step","loop").save_svg("build/flow_matching_method.svg");}
