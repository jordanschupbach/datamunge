> Verify the boundary condition before distillation

At t=Float32(.01), shift=t-.01f is exactly zero, c_skip=1 and c_out=0. The consistency map must return its input independently of its initialized weights. The target stop-gradient and post-Adam EMA remain visible in the experiment below.

```{cpp, results="markdown", file="figures/consistency_model_worked.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <iostream>
namespace n=dm::nn;namespace m=n::models;using T=n::Tensor;
int main(){std::filesystem::create_directories("build");
n::ParameterStore p(19003);m::InitializeDiffusionMlp(p,10,2);auto x=n::from_vector(std::vector<float>{-.5f,0,.5f,1},{2,2});auto out=m::ConsistencyMap(p,x,n::full({2},double(.01f)));T left=x,right=out.value,extra=out.raw;
 auto av=left.to_vector<double>(),bv=right.to_vector<double>(),cv=extra.to_vector<double>();
 std::cout<<"| Input coordinate | Boundary output | Unused raw prediction |\n|---:|---:|---:|\n";
 for(std::size_t i=0;i<av.size();++i)std::cout<<"|"<<av[i]<<"|"<<bv[i]<<"|"<<cv[i]<<"|\n";
 n::save_npz("build/consistency_model_worked.npz",{{"a",left},{"b",right},{"c",extra}});
 dm::graphics::RPlot::create().points(n::arange(0,std::int64_t(bv.size())).to_vector<double>(),bv,"Native worked values",{37,99,235},4).x_label("Coordinate / probe index").y_label("Native computed value").title("Verify the boundary condition before distillation").size(900,500).save_svg("build/consistency_model_worked.svg");
}
