#include <sstream>
#include <iostream>
int main(){std::filesystem::create_directories("build");std::ifstream input("build/diffusion-models/models/consistency_model/history.tsv");if(!input)throw std::runtime_error("Missing preserved training history");std::string line;std::getline(input,line);std::vector<double> epoch,loss;while(std::getline(input,line)){std::istringstream row(line);double x,y;if(!(row>>x>>y))throw std::runtime_error("Invalid history row");epoch.push_back(x);loss.push_back(y);}if(epoch.size()!=3)throw std::runtime_error("Source three-epoch history");
 dm::graphics::RPlot::create().lines(epoch,loss,"All source validation epochs",{37,99,235}).points(epoch,loss,"Recorded values",{234,88,12},5).x_label("Epoch").y_label("Consistency MSE").y_limits(.00024,.00052).y_ticks({.00025,.00030,.00035,.00040,.00045,.00050},{"0.00025","0.00030","0.00035","0.00040","0.00045","0.00050"}).title("Stopped-target validation objective").size(900,500).save_svg("build/consistency_model_history.svg");std::cout<<"| Epoch | Consistency MSE |\n|---:|---:|\n";for(std::size_t i=0;i<epoch.size();++i)std::cout<<"|"<<epoch[i]<<"|"<<loss[i]<<"|\n";
}
