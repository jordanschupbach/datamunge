int main(){std::filesystem::create_directories("build");dm::graphics::Diagram d(28,1150);dm::graphics::DiagramNodeStyle s;s.width=11;s.height=5;s.font_size=30;d.node("input",{-18,0},"Clean x0 + noise\nExplicit time t",s).node("predict",{-5,0},"5504-value MLP\nPredict epsilon",s).node("step",{8,0},"Clipped posterior\nExplicit innovation",s).node("loop",{21,0},"32 reverse steps\nCaller owns loop",s).edge("input","predict").edge("predict","step").edge("step","loop").save_svg("build/ddpm_method.svg");}
