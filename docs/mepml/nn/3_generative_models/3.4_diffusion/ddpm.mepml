> Start with known clean values and explicit noise

At one schedule level, x_t=sqrt(alpha_bar)*x_0+sqrt(1-alpha_bar)*epsilon. Supplying that exact epsilon recovers x_0 before clipping. The example compares all four clean coordinates against the recovered native values.

```{cpp, results="markdown", file="figures/ddpm_worked.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
namespace n=dm::nn;namespace m=n::models;using T=n::Tensor;
int main(){std::filesystem::create_directories("build");
auto schedule=m::CosineDiffusionSchedule();auto clean=n::from_vector(std::vector<float>{-.5f,0,.5f,1.5f},{2,2}),noise=n::full({2,2},.25);auto time=n::from_vector(std::vector<std::int32_t>{3,12},{2});auto state=m::DiffusionNoised(clean,noise,time,schedule);auto out=m::DdpmReverse(state,time,noise,n::zeros({2,2}),schedule);T left=clean,right=out.x0_raw,extra=out.x0_clipped;
 auto av=left.to_vector<double>(),bv=right.to_vector<double>(),cv=extra.to_vector<double>();
 std::cout<<"| Clean value | Recovered raw x0 | Clipped x0 |\n|---:|---:|---:|\n";
 for(std::size_t i=0;i<av.size();++i)std::cout<<"|"<<av[i]<<"|"<<bv[i]<<"|"<<cv[i]<<"|\n";
 n::save_npz("build/ddpm_worked.npz",{{"a",left},{"b",right},{"c",extra}});
 dm::graphics::RPlot::create().points(n::arange(0,std::int64_t(bv.size())).to_vector<double>(),bv,"Native worked values",{37,99,235},4).x_label("Coordinate / probe index").y_label("Native computed value").title("Start with known clean values and explicit noise").size(900,500).save_svg("build/ddpm_worked.svg");
}
```
