> Classify the held-out noisy observations

The matrix uses all 200 test rows and their declared source noise levels, rather than generated images. Rows are true digit classes and columns are classifier predictions. These levels mix easy and heavily corrupted observations;33% accuracy must be interpreted under that exact query protocol.

```{cpp, results="markdown", file="figures/diffusion_guidance_confusion.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <iostream>
int main(){namespace n=dm::nn;auto load=[](const std::string& file,const std::string& key){for(const auto& [name,value]:n::load_npz(file))if(name==key)return value;throw std::runtime_error("Missing classifier field "+key);};
 auto logits=load("build/diffusion-models/models/diffusion_guidance/classifier/outputs.npz","prediction"),labels=load("build/diffusion-models/models/diffusion_guidance/data.npz","test_labels");
 n::ConfusionMatrix matrix(10);matrix.add(labels,n::argmax(logits,1));matrix.save_svg("build/diffusion_guidance_confusion.svg",{.title="All 200 held-out noisy MNIST queries"});n::save_npz("build/diffusion_guidance_confusion.npz",{{"counts",matrix.to_tensor()}});std::cout<<"| Test rows | Accuracy |\n|---:|---:|\n|"<<labels.numel()<<"|"<<matrix.accuracy()<<"|\n";
}
