> Complete preserved experiment

The following program is the editable experiment, including its held-out checks, source seeds, noise banks, checkpoint comparisons and complete fitting/sampling loops. Canonical C++ dataset preparation supplies MNIST; TensorFlow replay remains optional and is reported as skipped when its recordings are absent. Fixed-final outcomes and baseline shortfalls will be reported from execution.

```{cpp, results="markdown", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
// CMD: just run-nn score_sde
// VE reverse SDE versus probability-flow ODE on a frozen NCSN, with Gaussian
// oracle convergence.
//
// Port of tflow's score_sde (common/{nn,ml}/score_sde.h ->
// examples/nn/common/score_sde.hpp). No training: the 5504 frozen weights of
// noise_conditional_score are restored. ncsn=auto (default) uses our port's run
// (output/nn/models/noise_conditional_score/final.npz) when present, else tflow's
// recorded run (output/models/noise_conditional_score/model_arrays.npz);
// ncsn=ours|tf|DIR selects explicitly. Continuous sigma(t) = .05 20^t, t 1 -> 0,
// g^2 = 2 log 20 sigma^2, network level 15 (1 - t) (continuous sinusoidal
// conditioning interpolates the 16 trained levels). Reverse Euler-Maruyama, 64
// steps: x + h g^2 score + sqrt(h g^2) z; probability-flow ODE drift .5 g^2 score
// with RK4 8/16/32 steps. Initial N(0, 1) is an approximate terminal prior;
// optional final Tweedie correction saved separately. Gaussian oracle score
// (.3 - x) / (.49 + sigma^2) runs through the same integrators (8/16/32/64 steps).
//
// Checks (as tflow): restore bit-exact vs the frozen run's model_arrays.npz;
// continuous score matches the discrete NCSN at all 16 grid levels (< 3e-5); ODE
// ignores ALL innovations bit-exactly; SDE innovations change samples; oracle
// probability flow reproduces the analytic scale (< 8e-6 at 64 steps); weights
// immutable. TF parity: every record is compared with tflow's
// output/models/score_sde (exact when ncsn=tf). Deviations: no
// independent_audit.json. Options: ncsn=auto|ours|tf|DIR out=DIR tf=DIR
// threads=4. Output: output/nn/models/score_sde.
// Report-local workflow adapters: score_sde.hpp
// Port of tflow's common/nn/score_sde.h and common/ml/score_sde.h: the VE reverse
// SDE (Euler-Maruyama) and RK4 probability-flow ODE driven by a frozen NCSN
// epsilon MLP (examples/nn/common/noise_conditional_score.hpp) with continuous
// conditioning, sigma(t) = .05 20^t, g^2 = 2 log 20 sigma^2, network level
// 15 (1 - t); or the Gaussian oracle score (.3 - x) / (.49 + sigma^2).
//
// tflow -> datamunge: graph/session -> eager; the three first-pixel input
// gradients (score, EM next, ODE next) -> nn::grad; SaveV2 restore -> npz.

#include <cmath>
#include <string>
#include <vector>

// Report-local workflow adapters: noise_conditional_score.hpp
// Port of tflow's common/nn/noise_conditional_score.h and
// common/ml/noise_conditional_score.h: noise-conditional score matching for VE
// Gaussian perturbations (16 geometric sigmas 1 -> .05) with the DDPM epsilon MLP
// (examples/nn/common/ddpm.hpp, time features over 15 levels), score =
// -epsilon / sigma, weighted DSM loss .5 mean ||sigma score + eps||^2, and
// annealed Langevin updates alpha = 2e-5 (sigma / .05)^2.
//
// tflow -> datamunge: graph/session -> eager; AddSymbolicGradients -> nn::grad;
// Adam train_op -> nn::Optimizer (Adam .003); SaveV2 "final" -> final.npz.
// Parameter names match tflow's, so TF's npz weights load directly.

#include <cmath>
#include <memory>
#include <string>
#include <vector>

// Report-local workflow adapters: ddpm.hpp
// Shared support for the 3.4 diffusion ports: a port of tflow's common/nn/ddpm.h
// and common/ml/ddpm.h (cosine 32-level DDPM schedule, compact epsilon MLP,
// clipped-x0 ancestral reverse transition, DdpmModel) plus the program helpers
// that tflow repeats in ddpm/ddim/diffusion_guidance/conditional_diffusion
// (8x8 [-1, 1] MNIST pools, tflow's mt19937 Gaussian banks and timestep draws,
// 64x64-tile PNG sheets, trajectory sampling).
//
// tflow -> datamunge: graph/session models become classes over a
// nn::ParameterStore; AddSymbolicGradients -> nn::grad; the Adam train_op ->
// nn::Optimizer (Adam .003); SaveV2 "final" bundles -> final.npz. Parameter
// names match tflow's ("hidden1/W", ...), so TF's initial_arrays.npz /
// model_arrays.npz load directly (init=auto replays TF's run).

#include <algorithm>
#include <array>
#include <cmath>
#include <fstream>
#include <iostream>
#include <memory>
#include <random>
#include <string>
#include <vector>

// Report-local workflow adapters: binary_pixels.hpp
// Shared harness of the binary 8x8 MNIST autoregressive density ports
// (pixel_cnn, gated_pixel_cnn, made_density, pixel_rnn): the program body that
// tflow repeats in each of those .cc files, plus the model-independent part of
// tflow's common/ml/{pixel_cnn,gated_pixel_cnn,made_density,pixel_rnn}.h
// (teacher-forced Bernoulli likelihood, causal logit/input Jacobian, prefix-only
// ancestral sampling with MT19937 uniforms).
//
// Data: the 1000/200/200 MNIST pools of tflow's saliency assets (ae::LoadSaliency),
// half-pixel bilinear 28 -> 8 in double then float32 threshold >= .5, as tflow.
//
// tflow -> datamunge: session graphs -> eager calls, AddSymbolicGradients ->
// nn::grad, Adam train_op -> nn::Optimizer (Adam .003), SaveV2 -> final.npz.
// TF parity: init=auto (default) replays TF's recorded initial_arrays.npz from
// tflow's output/models/<name>[/<variant>] so the whole run follows TF's; every
// record is then compared with TF's and the replayed first-step records must
// match. Independently of the trajectory, TF's FINAL weights (model_arrays.npz)
// are loaded into a fresh model which must reproduce TF's test outputs.

#include <algorithm>
#include <chrono>
#include <cmath>
#include <cstdio>
#include <fstream>
#include <functional>
#include <iostream>
#include <memory>
#include <random>
#include <sstream>
#include <string>
#include <vector>

// Report-local workflow adapters: autoencoder.hpp
// Shared support for the autoencoder ports: a port of the parts of tflow's
// common/ml/{autoencoder,convolutional_autoencoder,variational_autoencoder,
// saliency}.h and common/nn/{convolutional_autoencoder,variational_autoencoder,
// smoothgrad}.h that convolutional_autoencoder and variational_autoencoder use.
//
// Data: the balanced 1000 fit / 200 validation / 200 test MNIST pools of
// $DATAMUNGE_DATA_DIR/saliency/saliency_data.npz (tflow's `just
// autoencoder-assets`). Checkpoints are .npz files of the parameter store
// instead of TF SaveV2 bundles. Parameter initialisation uses datamunge's
// generator, so trajectories match tflow only statistically; batch orders and
// Gaussian noise banks are bit-identical to tflow's.

#include <algorithm>
#include <cmath>
#include <cstdint>
#include <cstring>
#include <datamunge/nn/nn.hpp>
#include <filesystem>
#include <memory>
#include <ostream>
#include <random>
#include <set>
#include <string>
#include <vector>

// Report-local workflow adapters: checks.hpp
// Small runtime checks used by the executable nn examples. They stay on in
// Release builds and make the example exit nonzero on failure, so `just
// run-all-nn` doubles as a regression test against the recorded TF numbers.

#include <cmath>
#include <iostream>
#include <stdexcept>
#include <string>
// Report-local workflow adapters: runtime.hpp
// Bounded demonstrations by default; opt into convergence experiments explicitly.

#include <algorithm>
#include <cstdlib>
#include <iostream>
#include <string>

namespace example_runtime {

inline bool Full() {
  const char* value = std::getenv("DATAMUNGE_EXAMPLES_FULL");
  return value && std::string(value) == "1";
}

template <typename T> T Limit(T requested, T quick_limit) {
  return Full() ? requested : std::min(requested, quick_limit);
}

inline void Describe() {
  if (!Full())
    std::cout << "Quick demonstration: bounded training; convergence metrics require "
                 "DATAMUNGE_EXAMPLES_FULL=1.\n";
}

}  // namespace example_runtime

namespace check {

inline void Require(bool condition, const std::string& message) {
  if (!condition) throw std::runtime_error(message);
}

// A short demonstration checks execution, derivatives and persistence; reaching
// a published accuracy/return requires the separately requested full schedule.
inline void TrainingQuality(bool condition, const std::string& message) {
  if (example_runtime::Full()) Require(condition, message);
  else std::cout << "  full-training quality check deferred: " << message << '\n';
}

inline void Near(double actual, double expected, double tolerance, const std::string& message) {
  if (!std::isfinite(actual) || !std::isfinite(expected) || std::abs(actual - expected) > tolerance)
    throw std::runtime_error(message + ": got " + std::to_string(actual) + ", expected " + std::to_string(expected));
}

/// Expects `f` to throw; returns the message.
template <typename F>
std::string Throws(F&& f, const std::string& message) {
  try {
    f();
  } catch (const std::exception& e) {
    return e.what();
  }
  throw std::runtime_error(message + ": expected an exception");
}

}  // namespace check

inline void Header(const std::string& title) {
  const std::size_t pad = title.size() < 60 ? 60 - title.size() : 0;
  std::cout << "\n== " << title << " " << std::string(pad, '=') << "\n";
}

// Report-local workflow adapters: paths.hpp
// Where the nn example ports read datasets and write their outputs.
//
// Datasets: $DATAMUNGE_DATA_DIR, or the user's cache. Public datasets are
// prepared by the example data loaders when first needed.
// Outputs (checkpoints, histories, fixtures): $DATAMUNGE_OUTPUT_DIR, or
// output/nn relative to the working directory (`just run-nn` runs from the
// repository root). Both are created on demand by the caller.

#include <cstdlib>
#include <filesystem>
#include <string>

// Report-local workflow adapters: dataset_assets.hpp
#include <datamunge/datasets/assets.hpp>
namespace dataset_assets {
inline std::string DataRoot(){return std::filesystem::absolute("build/datasets").string();}
inline void EnsureSaliency(const std::string& directory){dm::datasets::prepare_example_data("mnist-assets",std::filesystem::path(directory).parent_path().string());}
}

namespace paths {

inline std::filesystem::path DataRoot() {
  return dataset_assets::DataRoot();
}

/// DataRoot() / name, e.g. Dataset("mnist").
inline std::filesystem::path Dataset(const std::string& name) { return DataRoot() / name; }

inline std::filesystem::path OutputRoot() {
  if (const char* dir = std::getenv("DATAMUNGE_OUTPUT_DIR"); dir && *dir) return dir;
  return example_runtime::Full() ? "build/diffusion-models" : "build/diffusion-models";
}

/// OutputRoot() / relative, created as a directory.
inline std::filesystem::path OutputDir(const std::string& relative) {
  auto dir = OutputRoot() / relative;
  std::filesystem::create_directories(dir);
  return dir;
}

}  // namespace paths

namespace ae {

namespace nn = datamunge::nn;

// ---- data ----------------------------------------------------------------------------

using SaliencyData=datamunge::nn::models::SaliencyData;

inline SaliencyData Rows(const SaliencyData& d, const std::vector<std::int64_t>& rows) {
  return {nn::take_rows(d.images, rows), nn::take_rows(d.labels, rows), nn::take_rows(d.source, rows)};
}

inline nn::Tensor Find(const nn::NamedTensors& arrays, const std::string& name) {
  for (const auto& [key, value] : arrays)
    if (key == name) return value;
  throw std::runtime_error("missing array " + name);
}

/// The fit, validation and test pools with tflow's integrity checks.
inline std::vector<SaliencyData> LoadSaliency(const std::filesystem::path&root){dataset_assets::EnsureSaliency(root.string());return nn::models::LoadSaliency(root);}

/// Copies tflow's provenance files next to the outputs when they exist.
inline void CopyManifests(const std::filesystem::path& data, const std::filesystem::path& root) {
  const auto opts = std::filesystem::copy_options::overwrite_existing;
  if (std::filesystem::exists(data / "manifest.json"))
    std::filesystem::copy_file(data / "manifest.json", root / "data_manifest.json", opts);
  const auto source = paths::Dataset("autoencoder") / "source_manifest.json";
  if (std::filesystem::exists(source)) std::filesystem::copy_file(source, root / "source_manifest.json", opts);
}

// ---- tensor helpers --------------------------------------------------------------------

/// Raw bytes, for exact-equality checks (tflow's tensor_data() comparisons).
inline std::string Bytes(const nn::Tensor& t) {
  const auto values = t.contiguous().to_vector<float>();
  return std::string(reinterpret_cast<const char*>(values.data()), values.size() * sizeof(float));
}

inline double MaxAbsDiff(const nn::Tensor& a, const nn::Tensor& b, std::int64_t count) {
  const auto x = a.contiguous().to_vector<float>(), y = b.contiguous().to_vector<float>();
  double     out = 0;
  for (std::int64_t i = 0; i < count; ++i) out = std::max(out, std::abs(double(x[i]) - y[i]));
  return out;
}

/// Mean squared error in double precision; the prediction must be finite in [0, 1].
inline double Mse(const nn::Tensor& prediction, const nn::Tensor& original) {
  check::Require(prediction.numel() == original.numel(), "aligned reconstruction pixels");
  const auto p = prediction.contiguous().to_vector<float>(), o = original.contiguous().to_vector<float>();
  double     sum = 0;
  for (std::size_t i = 0; i < p.size(); ++i) {
    const double x = p[i], y = o[i];
    check::Require(std::isfinite(x) && x >= 0 && x <= 1, "finite bounded sigmoid reconstruction");
    sum += (x - y) * (x - y);
  }
  return sum / double(p.size());
}

/// Per-pixel mean [784] of the fit images.
inline nn::Tensor PixelMean(const nn::Tensor& fit) {
  const auto  x = fit.contiguous().to_vector<float>();
  const auto  n = fit.size(0);
  std::vector<float> out(784);
  for (int i = 0; i < 784; ++i) {
    double sum = 0;
    for (std::int64_t b = 0; b < n; ++b) sum += x[b * 784 + i];
    out[i] = float(sum / double(n));
  }
  return nn::from_vector(out, {784});
}

/// `mean` [784] repeated n times as [n, 784].
inline nn::Tensor Constant(const nn::Tensor& mean, std::int64_t n) {
  return nn::tile(nn::reshape(mean, {1, 784}), {n, 1}).contiguous();
}

/// Values of every parameter (deep copies), in creation order.
inline nn::NamedTensors Arrays(const nn::ParameterStore& store) {
  nn::NamedTensors out;
  for (const auto& name : store.names()) out.emplace_back(name, store.at(name).detach().clone());
  return out;
}

inline std::vector<std::string> Snapshot(const nn::ParameterStore& store) {
  std::vector<std::string> out;
  for (const auto& name : store.names()) out.push_back(Bytes(store.at(name)));
  return out;
}

/// Checks every gradient is finite and every tensor gets a nonzero one; returns them named.
inline nn::NamedTensors CheckGradients(const nn::ParameterStore& store, const std::vector<nn::Tensor>& gradients,
                                       const std::string& finite, const std::string& nonzero) {
  nn::NamedTensors out;
  check::Require(gradients.size() == store.size(), "one gradient per parameter");
  for (std::size_t i = 0; i < gradients.size(); ++i) {
    check::Require(gradients[i].defined(), nonzero);
    double norm = 0;
    for (float v : gradients[i].contiguous().to_vector<float>()) {
      check::Require(std::isfinite(v), finite);
      norm += double(v) * v;
    }
    check::Require(norm > 0, nonzero);
    out.emplace_back(store.names()[i], gradients[i]);
  }
  return out;
}

// ---- figures ---------------------------------------------------------------------------

/// One row of 28x28 panels (each [784] or [28, 28, 1] values in [0, 1]) scaled 4x,
/// 4 px apart on gray 220 background, as tflow's digit<k>.png.
inline void PanelRow(const std::filesystem::path& path, const std::vector<nn::Tensor>& panels) {
  std::vector<nn::Tensor> tiles;
  for (const auto& p : panels) tiles.push_back(nn::reshape(p, {28, 28, 1}));
  nn::save_image_grid(nn::stack(tiles, 0), path.string(), std::int64_t(tiles.size()), 0.0, 1.0, 4, 220.0 / 255.0,
                      4);
}

/// The b-th 784-pixel row of [n, 784] / [n, 28, 28, 1] probabilities.
inline nn::Tensor Row(const nn::Tensor& x, std::int64_t b) {
  return nn::reshape(nn::slice_axis(x, 0, b, b + 1), {784});
}

// ---- convolutional autoencoder -------------------------------------------------------

struct ConvAeOutput {
  nn::Tensor conv1, pool1, conv2, code, decoder1, reconstruction;
};

// Compatibility handles for independently maintained Python/R workflows.
// Model arithmetic is canonical in nn/autoencoder_models.hpp.
inline nn::Tensor ConvAeDecode(nn::ParameterStore& p, const nn::Tensor& code, nn::Tensor* decoder1 = nullptr) {
  const auto result = nn::models::ConvolutionalDecoder(p, code);
  if (decoder1) *decoder1 = result.hidden;
  return result.reconstruction;
}

inline ConvAeOutput ConvolutionalAutoencoder(nn::ParameterStore& p, const nn::Tensor& image) {
  const auto result = nn::models::ConvolutionalAutoencoder(p, image);
  return {result.conv1, result.pool1, result.conv2, result.code, result.decoder1, result.reconstruction};
}

class ConvolutionalAutoencoderModel {
 public:
  nn::ParameterStore             parameters{1801};
  std::unique_ptr<nn::Optimizer> optimizer;

  explicit ConvolutionalAutoencoderModel(bool training = true) {
    {
      nn::NoGradGuard guard;
      ConvolutionalAutoencoder(parameters, nn::zeros({1, 28, 28, 1}));
    }
    if (training) {
      nn::OptimizerConfig config;
      config.kind = nn::OptimizerKind::Adam;
      optimizer   = std::make_unique<nn::Optimizer>(parameters, .003, config);
    }
  }
  static nn::Tensor Loss(const nn::Tensor& reconstruction, const nn::Tensor& image) {
    return nn::mean(nn::square(reconstruction - image));
  }
  /// {code, reconstruction, loss}
  std::vector<nn::Tensor> Evaluate(const nn::Tensor& images) {
    nn::NoGradGuard guard;
    auto            net = ConvolutionalAutoencoder(parameters, images);
    return {net.code, net.reconstruction, Loss(net.reconstruction, images)};
  }
  std::vector<nn::Tensor> Activations(const nn::Tensor& images) {
    nn::NoGradGuard guard;
    auto            n = ConvolutionalAutoencoder(parameters, images);
    return {n.conv1, n.pool1, n.conv2, n.code, n.decoder1, n.reconstruction};
  }
  nn::Tensor Decode(const nn::Tensor& codes) {
    nn::NoGradGuard guard;
    return ConvAeDecode(parameters, codes);
  }
};

// ---- variational autoencoder ---------------------------------------------------------

/// @brief Forward explicit diagonal-Gaussian sampling to the canonical core.
/// @param mu Finite nonempty Float32/64 means [B,L].
/// @param log_variance Finite matching log variances [B,L].
/// @param epsilon Finite matching explicit standard-normal noise [B,L].
/// @return Owning differentiable mu+exp(log_variance/2)*epsilon.
/// @throws std::invalid_argument For invalid shape, dtype or values.
/// @par Example
/// @code
/// #include <dm/dm.hpp>
/// namespace n=dm::nn;
/// const auto z=n::models::GaussianReparameterize(n::ones({1,2}),n::zeros({1,2}),n::zeros({1,2}));
/// // Canonical equivalent: z is [1,1], with no posterior RNG draw.
/// @endcode
/// @see datamunge::nn::models::GaussianReparameterize()
inline nn::Tensor VaeReparameterize(const nn::Tensor& mu, const nn::Tensor& log_variance, const nn::Tensor& epsilon) {
  return nn::models::GaussianReparameterize(mu, log_variance, epsilon);
}
/// @brief Forward coordinate-summed standard-normal KL to the canonical core.
/// @param mu Finite nonempty Float32/64 means [B,L].
/// @param log_variance Finite matching log variances [B,L].
/// @return Owning differentiable per-row KL [B], without clipping roundoff.
/// @throws std::invalid_argument For invalid shape, dtype or values.
/// @par Example
/// @code
/// #include <dm/dm.hpp>
/// namespace n=dm::nn;
/// const auto kl=n::models::DiagonalGaussianKl(n::ones({2,3}),n::zeros({2,3}));
/// // Canonical equivalent: each coordinate-summed KL is1.5.
/// @endcode
/// @see datamunge::nn::models::DiagonalGaussianKl()
inline nn::Tensor VaeKl(const nn::Tensor& mu, const nn::Tensor& log_variance) {
  return nn::models::DiagonalGaussianKl(mu, log_variance);
}
/// @brief Forward stable pixel-summed Bernoulli cross-entropy to the canonical core.
/// @param logits Finite nonempty Float32/64 log-odds [B,F].
/// @param target Finite matching unit-range targets [B,F].
/// @return Owning differentiable per-row summed NLL [B], without sigmoid clipping.
/// @throws std::invalid_argument For invalid shape, dtype or values.
/// @par Example
/// @code
/// #include <dm/dm.hpp>
/// namespace n=dm::nn;
/// const auto nll=n::models::BernoulliPixelNll(n::zeros({2,3}),n::zeros({2,3}));
/// // Canonical equivalent: each row is3*log(2), not a pixel mean.
/// @endcode
/// @see datamunge::nn::models::BernoulliPixelNll()
inline nn::Tensor VaePixelNll(const nn::Tensor& logits, const nn::Tensor& target) {
  return nn::models::BernoulliPixelNll(logits, target);
}

struct VaeOutput {
  nn::Tensor mu, log_variance, z, logits, probability, reconstruction_nll, kl, loss;
};

/// @brief Forward the original two-code/ReLU64 decoder to the canonical core.
/// @param p Mutable matching floating parameter store; decoder/output names are retained.
/// @param z Finite nonempty Float32/64 codes [B,2].
/// @return Owning differentiable Bernoulli logits [B,784], without an image input.
/// @throws std::invalid_argument For invalid code/dtype or incompatible leaves.
/// @par Example
/// @code
/// #include <dm/dm.hpp>
/// namespace n=dm::nn;
/// n::ParameterStore p(1951);
/// const auto logits=n::models::GaussianVaeDecode(p,n::zeros({2,2}),784,2,64);
/// // Canonical equivalent: [2,784] logits from four decoder leaves.
/// @endcode
/// @see datamunge::nn::models::GaussianVaeDecode()
inline nn::Tensor VaeDecodeLogits(nn::ParameterStore& p, const nn::Tensor& z) {
  return nn::models::GaussianVaeDecode(p, z, 784, 2, 64);
}

/// @brief Forward the original ReLU64/two-coordinate VAE to native beta=1 inference.
///
/// This compatibility record retains the original eight fields and ten-leaf
/// creation order; canonical GaussianVaeOutput also exposes unweighted_loss.
/// No fitting, posterior noise draws or mode changes are hidden by this adapter.
/// @param p Mutable matching floating parameter store; original names are retained.
/// @param image Finite nonempty unit-range Float32/64 [B,784] pixels.
/// @param epsilon Finite matching explicit Gaussian noise [B,2].
/// @return Owning original eight-field result; loss averages pixel-summed NLL plus latent-summed KL over images.
/// @throws std::invalid_argument For invalid inputs/dtypes or incompatible leaves.
/// @par Example
/// @code
/// #include <dm/dm.hpp>
/// namespace n=dm::nn;
/// n::ParameterStore p(1951);
/// const auto out=n::models::BetaVariationalAutoencoder(p,n::zeros({2,784}),n::zeros({2,2}),1,784,2,64);
/// // Canonical equivalent: beta1, latent2, hidden64, ten leaves/101652 scalars.
/// @endcode
/// @see datamunge::nn::models::BetaVariationalAutoencoder()
inline VaeOutput VariationalAutoencoder(nn::ParameterStore& p, const nn::Tensor& image, const nn::Tensor& epsilon) {
  const auto out = nn::models::BetaVariationalAutoencoder(p, image, epsilon, 1, 784, 2, 64);
  return {out.mu, out.log_variance, out.z, out.logits, out.probability,
          out.reconstruction_nll, out.kl, out.loss};
}

class VariationalAutoencoderModel {
 public:
  nn::ParameterStore             parameters{1951};
  std::unique_ptr<nn::Optimizer> optimizer;

  explicit VariationalAutoencoderModel(bool training = true) {
    {
      nn::NoGradGuard guard;
      VariationalAutoencoder(parameters, nn::zeros({1, 784}), nn::zeros({1, 2}));
    }
    if (training) {
      nn::OptimizerConfig config;
      config.kind = nn::OptimizerKind::Adam;
      optimizer   = std::make_unique<nn::Optimizer>(parameters, .003, config);
    }
  }
  static nn::Tensor Flatten(const nn::Tensor& images) { return nn::reshape(images, {images.size(0), 784}); }
  /// {mu, log_variance, z, probability, reconstruction_nll, kl, loss}, all checked finite.
  std::vector<nn::Tensor> Evaluate(const nn::Tensor& images, const nn::Tensor& noise) {
    nn::NoGradGuard         guard;
    auto                    n = VariationalAutoencoder(parameters, Flatten(images), noise);
    std::vector<nn::Tensor> out{n.mu, n.log_variance, n.z, n.probability, n.reconstruction_nll, n.kl, n.loss};
    for (auto& t : out) {
      t = t.contiguous();
      for (float v : t.to_vector<float>()) check::Require(std::isfinite(v), "ALL posterior/output/objective values finite");
    }
    return out;
  }
  nn::Tensor Decode(const nn::Tensor& codes) {
    nn::NoGradGuard guard;
    return nn::sigmoid(VaeDecodeLogits(parameters, codes));
  }
  std::vector<nn::Tensor> Gradient(const nn::Tensor& images, const nn::Tensor& noise) {
    return nn::grad(VariationalAutoencoder(parameters, Flatten(images), noise).loss, parameters.parameters());
  }
  /// One Adam step; returns the pre-update negative ELBO.
  double Update(const nn::Tensor& images, const nn::Tensor& noise) {
    auto         loss  = VariationalAutoencoder(parameters, Flatten(images), noise).loss;
    const double value = loss.item<float>();
    check::Require(std::isfinite(value) && value >= 0, "finite negativeELBO");
    optimizer->minimize(loss);
    return value;
  }
};

/// tflow's nn::GaussianNoise: Box-Muller pairs from std::mt19937(seed), as
/// float64 [samples, shape...].
inline nn::Tensor GaussianNoise(const nn::Shape& shape, std::int64_t samples, std::uint32_t seed) {
  return nn::models::GaussianNoise(shape, samples, seed);
}

struct VaeNoiseBank {
  nn::Tensor standard, epsilon;  // float64 / float32 [samples, n, 2]
};
inline VaeNoiseBank VaeNoise(std::int64_t n, std::int64_t samples, std::uint32_t seed) {
  auto standard = GaussianNoise({n, 2}, samples, seed);
  return {standard, nn::cast(standard, nn::DType::Float32).contiguous()};
}
inline nn::Tensor VaeNoiseAt(const VaeNoiseBank& bank, std::int64_t k) {
  return nn::select(bank.epsilon, 0, k).contiguous();
}

/// Monte Carlo {reconstruction NLL, KL, negative ELBO} per image over every sample of `bank`.
inline std::vector<double> VaeScore(VariationalAutoencoderModel& model, const nn::Tensor& images,
                                    const VaeNoiseBank& bank) {
  double             reconstruction = 0, kl = 0;
  const std::int64_t n = images.size(0), samples = bank.epsilon.size(0);
  for (std::int64_t k = 0; k < samples; ++k) {
    auto       out = model.Evaluate(images, VaeNoiseAt(bank, k));
    const auto nll = out[4].to_vector<float>(), kls = out[5].to_vector<float>();
    for (std::int64_t b = 0; b < n; ++b) {
      reconstruction += nll[b];
      if (k == 0) kl += kls[b];
    }
  }
  reconstruction /= double(n * samples);
  kl /= double(n);
  return {reconstruction, kl, reconstruction + kl};
}

// ---- dense undercomplete autoencoder (tflow's common/nn/autoencoder.h + ml/autoencoder.h) ----

/// [n, 28, 28, 1] (or any n x 784 values) as [n, 784] original pixels.
inline nn::Tensor Flatten(const nn::Tensor& images) { return nn::reshape(images, {images.size(0), 784}); }

// Preserve the SWIG-visible value type and function while the canonical model
// lives in the library. Existing Python/R examples keep the same interface.
struct DenseAeOutput {
  nn::Tensor code, reconstruction;
};
inline DenseAeOutput UndercompleteAutoencoder(nn::ParameterStore& p, const nn::Tensor& input,
                                              std::int64_t features = 784, std::int64_t latent = 32) {
  const auto result = nn::models::UndercompleteAutoencoder(p, input, features, latent);
  return {result.code, result.reconstruction};
}

/// tflow's ReconstructionMse: mean over every element.
inline nn::Tensor ReconstructionMse(const nn::Tensor& prediction, const nn::Tensor& original) {
  return nn::mean(nn::square(prediction - original));
}

/// Adam(.003), the optimiser of every short autoencoder example.
inline std::unique_ptr<nn::Optimizer> MakeAdam(nn::ParameterStore& store, double learning_rate = .003) {
  nn::OptimizerConfig config;
  config.kind = nn::OptimizerKind::Adam;
  return std::make_unique<nn::Optimizer>(store, learning_rate, config);
}

/// tflow's CorruptForDenoising: clamp(float(x + sigma z), 0, 1) with z one float64 bank [1, shape...].
inline nn::Tensor CorruptForDenoising(const nn::Tensor& clean, const nn::Tensor& standard_noise, float sigma) {
  return nn::models::CorruptForDenoising(clean, standard_noise, sigma);
}

/// tflow's data.npz record: the three pools (+ any extra arrays).
inline void SaveData(const std::filesystem::path& file, const std::vector<SaliencyData>& pools,
                     const nn::NamedTensors& extra = {}) {
  nn::NamedTensors arrays{{"fit_images", pools[0].images},         {"validation_images", pools[1].images},
                          {"test_images", pools[2].images},        {"fit_source_ids", pools[0].source},
                          {"validation_source_ids", pools[1].source}, {"test_source_ids", pools[2].source},
                          {"test_labels", pools[2].labels}};
  arrays.insert(arrays.end(), extra.begin(), extra.end());
  nn::save_npz(file.string(), arrays);
}

/// Index of the first record of `digit` in a label vector (gallery rows).
inline int FirstOfDigit(const nn::Tensor& labels, int digit) {
  const auto l = labels.contiguous().to_vector<int>();
  for (std::size_t b = 0; b < l.size(); ++b)
    if (l[b] == digit) return int(b);
  throw std::runtime_error("no record of digit " + std::to_string(digit));
}

/// Writes digit<k>.png (one panel row per digit: the b-th row of every tensor) and its html sections.
inline void DigitGallery(const std::filesystem::path& root, const SaliencyData& test,
                         const std::vector<nn::Tensor>& panels, std::ostream& html) {
  const auto source = test.source.contiguous().to_vector<int>();
  for (int digit = 0; digit < 10; ++digit) {
    const int               b = FirstOfDigit(test.labels, digit);
    std::vector<nn::Tensor> row;
    for (const auto& t : panels) row.push_back(Row(t, b));
    const std::string file = "digit" + std::to_string(digit) + ".png";
    PanelRow(root / file, row);
    html << "<section><h2>Digit" << digit << ",source" << source[b] << "</h2><img src='" << file << "'></section>";
  }
}

/// Byte-identical parameter stores (matched-initialisation checks).
inline bool SameArrays(const nn::ParameterStore& a, const nn::ParameterStore& b) {
  if (a.names() != b.names()) return false;
  for (const auto& name : a.names())
    if (Bytes(a.at(name)) != Bytes(b.at(name))) return false;
  return true;
}

// ---- 2.3 applications: frozen checkpoints and case figures ------------------------------

/// tflow's ml::UndercompleteModel (784->32 ReLU->784 sigmoid, seed 1471) for the frozen
/// applications; the training port keeps its own copy in undercomplete_autoencoder.cpp.
class UndercompleteModel {
 public:
  nn::ParameterStore             parameters{1471};
  std::unique_ptr<nn::Optimizer> optimizer;

  explicit UndercompleteModel(bool training = true) {
    {
      nn::NoGradGuard guard;
      UndercompleteAutoencoder(parameters, nn::zeros({1, 784}));
    }
    if (training) optimizer = MakeAdam(parameters);
  }
  /// {code, reconstruction, loss}
  std::vector<nn::Tensor> Evaluate(const nn::Tensor& images) {
    nn::NoGradGuard guard;
    auto            x = Flatten(images);
    auto            n = UndercompleteAutoencoder(parameters, x);
    return {n.code, n.reconstruction, ReconstructionMse(n.reconstruction, x)};
  }
  nn::Tensor Decode(const nn::Tensor& codes) {
    nn::NoGradGuard guard;
    return nn::dense(parameters, "decoder", codes, 784, nn::Activation::Sigmoid);
  }
};

/// Restores a frozen checkpoint directory written by a training port (best.npz) or by
/// tflow (model_arrays.npz = its restored best checkpoint); returns the file used.
inline std::filesystem::path LoadFrozen(nn::ParameterStore& store, const std::filesystem::path& directory,
                                        const std::string& what) {
  for (const char* name : {"best.npz", "model_arrays.npz"}) {
    const auto file = directory / name;
    if (std::filesystem::exists(file)) {
      store.load(file.string());
      return file;
    }
  }
  check::Require(false, what + ": no best.npz/model_arrays.npz in " + directory.string() + " (run the training port first)");
  return {};
}

/// One case strip as tflow's case_<k>.png: the b-th 784-pixel row of every tensor, 3x nearest,
/// 4 px apart on gray 220 (84 x (88 n - 4) RGB).
inline void CaseStrip3(const std::filesystem::path& path, const std::vector<nn::Tensor>& panels, std::int64_t b) {
  std::vector<nn::Tensor> tiles;
  for (const auto& p : panels) tiles.push_back(nn::reshape(Row(p, b), {28, 28, 1}));
  nn::save_image_grid(nn::tile(nn::stack(tiles, 0), {1, 1, 1, 3}), path.string(), std::int64_t(tiles.size()), 0.0, 1.0,
                      4, 220.0 / 255.0, 3);
}

/// tflow's latent-application Mosaic: [n, 784] rows, `columns` per row, 3x nearest, 4 px gray 220 gaps.
inline void Mosaic3(const std::filesystem::path& path, const nn::Tensor& values, std::int64_t columns) {
  const auto n = values.size(0);
  nn::save_image_grid(nn::tile(nn::reshape(values, {n, 28, 28, 1}), {1, 1, 1, 3}), path.string(), columns, 0.0, 1.0, 4,
                      220.0 / 255.0, 3);
}

}  // namespace ae

// Report-local workflow adapters: tf_replay.hpp
// Small helpers the 4.2 sequence-task ports share for working with tflow's
// recorded runs: named-array maps (tflow's `std::map<std::string, tf::Tensor>`
// batches), row selection, exact/approximate comparisons, loading TF's
// initial_arrays.npz into a ParameterStore and reading history.tsv columns.
//
// A tflow run directory (tflow's output/models/<name>) holds initial_arrays.npz,
// first_batch.npz, initial_gradients.npz, history.tsv and model_arrays.npz.
// Replaying the run from TF's own initial weights with the same batch order
// (nn::BatchOrder reproduces tflow's) and the same optimizer checks the port
// numerically, independently of the random initialisation.

#include <cstring>
#include <filesystem>
#include <fstream>
#include <map>
#include <sstream>
#include <stdexcept>
#include <string>
#include <vector>

#include <datamunge/nn/nn.hpp>



namespace replay {

namespace nn = datamunge::nn;
using nn::Tensor;
using Map = std::map<std::string, Tensor>;

/// tflow's recorded output directory for an example (its output/models/<name>).
inline std::filesystem::path TfModels(const std::string& name) {
  return paths::DataRoot().parent_path() / "models" / name;
}

inline Tensor Get(const nn::NamedTensors& arrays, const std::string& key) {
  for (const auto& [name, t] : arrays)
    if (name == key) return t;
  throw std::runtime_error("missing array " + key);
}

inline Map ToMap(const nn::NamedTensors& arrays) { return {arrays.begin(), arrays.end()}; }
inline nn::NamedTensors ToNamed(const Map& m) { return {m.begin(), m.end()}; }

/// Rows `rows` (axis 0) of every array.
inline Map Rows(const Map& m, const std::vector<std::int64_t>& rows) {
  Map out;
  for (const auto& [k, v] : m) out[k] = nn::take_rows(v, rows);
  return out;
}

/// {key: arrays["<split>_<key>"]} for each key.
inline Map Split(const nn::NamedTensors& arrays, const std::string& split, const std::vector<std::string>& keys) {
  Map out;
  for (const auto& k : keys) out[k] = Get(arrays, split + "_" + k);
  return out;
}

inline double MaxAbsDiff(const Tensor& a, const Tensor& b) {
  const auto x = a.to_vector<double>(), y = b.to_vector<double>();
  check::Require(x.size() == y.size(), "compared tensors have the same size");
  double m = 0;
  for (std::size_t i = 0; i < x.size(); ++i) m = std::max(m, std::abs(x[i] - y[i]));
  return m;
}

/// Bit-identical values (dtype and shape included).
inline bool SameBits(const Tensor& a, const Tensor& b) {
  if (a.dtype() != b.dtype() || a.shape() != b.shape()) return false;
  auto same = [](const auto& x, const auto& y) {
    return x.size() == y.size() && (x.empty() || std::memcmp(x.data(), y.data(), x.size() * sizeof(x[0])) == 0);
  };
  switch (a.dtype()) {
    case nn::DType::Float32: return same(a.to_vector<float>(), b.to_vector<float>());
    case nn::DType::Float64: return same(a.to_vector<double>(), b.to_vector<double>());
    case nn::DType::Int32: return same(a.to_vector<std::int32_t>(), b.to_vector<std::int32_t>());
    default: return same(a.to_vector<std::int64_t>(), b.to_vector<std::int64_t>());
  }
}

inline bool SameBits(const Map& a, const Map& b) {
  if (a.size() != b.size()) return false;
  for (const auto& [k, v] : a)
    if (!b.count(k) || !SameBits(v, b.at(k))) return false;
  return true;
}

/// Copies of every parameter, by name.
inline Map Arrays(const nn::ParameterStore& p) {
  Map out;
  for (const auto& name : p.names()) out[name] = p.at(name).detach().clone();
  return out;
}

/// Gradients aligned with p.names(), by name.
inline Map Named(const nn::ParameterStore& p, const std::vector<Tensor>& g) {
  Map out;
  for (std::size_t i = 0; i < g.size(); ++i) out[p.names()[i]] = g[i].defined() ? g[i].detach() : nn::zeros_like(p.parameters()[i]).detach();
  return out;
}

/// Overwrites every parameter of `p` from an .npz (e.g. TF's initial_arrays.npz),
/// which must hold exactly p's names.
inline void LoadInto(nn::ParameterStore& p, const std::filesystem::path& file) {
  const auto arrays = nn::load_npz(file.string());
  check::Require(arrays.size() == p.size(), "array file covers exactly the model's parameters: " + file.string());
  for (const auto& [name, value] : arrays) {
    check::Require(p.contains(name), "array " + name + " is a model parameter");
    p.set(name, nn::cast(value, p.at(name).dtype()));
  }
}

/// max |a[k] - b[k]| over the keys of `a` (all must exist in `b`).
inline double MaxDiff(const Map& a, const Map& b) {
  double m = 0;
  for (const auto& [k, v] : a) {
    check::Require(b.count(k) > 0, "reference has array " + k);
    m = std::max(m, MaxAbsDiff(v, b.at(k)));
  }
  return m;
}
inline double MaxDiff(const Map& a, const std::filesystem::path& file) { return MaxDiff(a, ToMap(nn::load_npz(file.string()))); }

/// Column `column` (0-based) of a tab-separated history file with a header line.
inline std::vector<double> History(const std::filesystem::path& file, int column = 1) {
  std::ifstream       in(file);
  std::string         line;
  std::vector<double> out;
  std::getline(in, line);
  while (std::getline(in, line)) {
    std::stringstream ss(line);
    std::string       cell;
    for (int c = 0; c <= column && std::getline(ss, cell, '\t'); ++c)
      if (c == column) out.push_back(std::stod(cell));
  }
  return out;
}

inline nn::OptimizerConfig Adam() {
  nn::OptimizerConfig c;
  c.kind = nn::OptimizerKind::Adam;
  return c;
}

/// Copies `files` from `from` to `to` when present.
inline void CopyAssets(const std::filesystem::path& from, const std::filesystem::path& to,
                       const std::vector<std::string>& files) {
  for (const auto& f : files)
    if (std::filesystem::exists(from / f))
      std::filesystem::copy_file(from / f, to / f, std::filesystem::copy_options::overwrite_existing);
}

}  // namespace replay

namespace bpix {

namespace nn = datamunge::nn;
namespace fs = std::filesystem;
using nn::Tensor;
using Map = replay::Map;

// ---- small helpers -----------------------------------------------------------------------------

inline Tensor Floats(const std::vector<float>& v, const nn::Shape& s) {
  return nn::from_vector(v, s);
}

/// tflow's Png: every 8x8 image as a 64x64 tile (8x nearest), `columns` per row,
/// gray 220 background, floor(v * 255 + .5); `rgb` images use (v + 1) * 127.5
/// with clamping when `signed_range`, else 255 clamp(v, 0, 1).
inline void Png(const fs::path& path, const Tensor& images, int columns, int mode = 0) {
  const auto         n = images.size(0), c = images.size(3);
  const auto         v    = images.contiguous().to_vector<float>();
  const std::int64_t rows = (n + columns - 1) / columns, H = rows * 64, W = columns * 64;
  std::vector<float> out(static_cast<std::size_t>(H * W * 3), 220.f);
  for (std::int64_t b = 0; b < n; ++b)
    for (int y = 0; y < 64; ++y)
      for (int x = 0; x < 64; ++x)
        for (int k = 0; k < 3; ++k) {
          const double value =
              v[static_cast<std::size_t>(((b * 8 + y / 8) * 8 + x / 8) * c + (c == 1 ? 0 : k))];
          double byte = mode == 0   ? std::floor(value * 255 + .5)
                        : mode == 1 ? std::floor(std::clamp((value + 1) * 127.5, 0., 255.) + .5)
                                    : std::floor(255 * std::clamp(value, 0., 1.) + .5);
          out[static_cast<std::size_t>(
              ((b / columns * 64 + y) * W + b % columns * 64 + x) * 3 + k)] = float(byte);
        }
  nn::save_png(Floats(out, {H, W, 3}), path.string(), 0, 255);
}

/// Writes a [H, W, 3] uint8-valued byte image.
inline void
PngBytes(const fs::path& path, const std::vector<float>& bytes, std::int64_t h, std::int64_t w) {
  nn::save_png(Floats(bytes, {h, w, 3}), path.string(), 0, 255);
}

inline void RequireFinite(const Map& m, const std::string& what) {
  for (const auto& [k, v] : m)
    if (v.dtype() == nn::DType::Float32)
      for (float x : v.contiguous().to_vector<float>())
        check::Require(std::isfinite(x), what);
}

inline std::string Bits(const Tensor& t) {
  const auto c = t.contiguous();
  switch (c.dtype()) {
    case nn::DType::Float32: {
      const auto v = c.to_vector<float>();
      return {reinterpret_cast<const char*>(v.data()), v.size() * sizeof(float)};
    }
    case nn::DType::Float64: {
      const auto v = c.to_vector<double>();
      return {reinterpret_cast<const char*>(v.data()), v.size() * sizeof(double)};
    }
    default: {
      const auto v = c.to_vector<std::int32_t>();
      return {reinterpret_cast<const char*>(v.data()), v.size() * sizeof(std::int32_t)};
    }
  }
}

inline bool SameBits(const Map& a, const Map& b) {
  if (a.size() != b.size())
    return false;
  for (const auto& [k, v] : a)
    if (!b.count(k) || Bits(v) != Bits(b.at(k)) || v.shape() != b.at(k).shape())
      return false;
  return true;
}

// ---- options ----------------------------------------------------------------------------------

struct Options {
  int         epochs = 3, threads = 4;
  fs::path    data    = paths::Dataset("saliency"), out, tf;
  std::string init    = "auto";
  bool        verbose = false;
};

/// epochs=N data=DIR out=DIR init=auto|tf|nn|PATH tf=DIR threads=N verbose=0|1
inline Options ParseOptions(int argc, char** argv, const std::string& name, const fs::path& data) {
  Options o;
  o.data = data;
  o.tf   = replay::TfModels(name);
  for (int i = 1; i < argc; ++i) {
    const std::string a = argv[i];
    const auto        e = a.find('=');
    check::Require(
        e != std::string::npos,
        "expected key=value (epochs= data= out= init= tf= threads= verbose=)");
    const std::string k = a.substr(0, e), v = a.substr(e + 1);
    if (k == "epochs")
      o.epochs = std::stoi(v);
    else if (k == "data")
      o.data = v;
    else if (k == "out")
      o.out = v;
    else if (k == "init")
      o.init = v;
    else if (k == "tf")
      o.tf = v;
    else if (k == "threads")
      o.threads = std::stoi(v);
    else if (k == "verbose")
      o.verbose = v != "0";
    else
      throw std::invalid_argument(
          "epochs=N data=PATH out=PATH init=auto|tf|nn|PATH tf=DIR threads=N verbose=0|1");
  }
  check::Require(
      o.epochs > 0 && o.epochs <= 100, "three cheap default epochs or explicit 1..100 override");
  if (o.out.empty())
    o.out = paths::OutputRoot() / "models" / name;
  fs::create_directories(o.out);
  if (o.threads > 0)
    nn::set_num_threads(o.threads);
  return o;
}

/// The initial arrays to replay (empty: nn's generator). `tf` is the TF run directory.
inline fs::path InitFile(const std::string& init, const fs::path& tf) {
  if (init == "nn")
    return {};
  if (init == "auto" || init == "tf") {
    const auto f = tf / "initial_arrays.npz";
    if (init == "tf")
      check::Require(fs::exists(f), "init=tf needs " + f.string());
    return fs::exists(f) ? f : fs::path();
  }
  check::Require(fs::exists(init), "init file " + init + " missing");
  return init;
}

/// Max |ours - TF| over the arrays both records share (-1 when TF's file is missing);
/// `relative`: max |ours - TF| / (1 + |TF|).
inline double Compare(
    const fs::path&    tf,
    const std::string& file,
    const Map&         ours,
    bool               verbose  = false,
    bool               relative = false) {
  if (!fs::exists(tf / file)) {
    std::printf("  vs TF %-28s (no TF record)\n", file.c_str());
    return -1;
  }
  const auto theirs = replay::ToMap(nn::load_npz((tf / file).string()));
  double     m      = 0;
  int        shared = 0;
  for (const auto& [k, v] : ours) {
    if (!theirs.count(k) || theirs.at(k).numel() != v.numel())
      continue;
    const auto x = nn::cast(v, nn::DType::Float64).to_vector<double>(),
               y = nn::cast(theirs.at(k), nn::DType::Float64).to_vector<double>();
    double d     = 0;
    for (std::size_t i = 0; i < x.size(); ++i)
      d = std::max(d, std::abs(x[i] - y[i]) / (relative ? 1 + std::abs(y[i]) : 1.));
    if (verbose)
      std::printf("      %-24s %.3g\n", k.c_str(), d);
    m = std::max(m, d);
    ++shared;
  }
  std::printf(
      "  vs TF %-28s max |ours - TF|%s = %.3g (%d arrays)\n",
      file.c_str(),
      relative ? "/(1+|TF|)" : "",
      m,
      shared);
  return m;
}

/// Fraction of equal elements of `key` in ours vs TF's record.
inline double
Agreement(const fs::path& tf, const std::string& file, const Map& ours, const std::string& key) {
  if (!fs::exists(tf / file))
    return -1;
  const auto theirs = replay::ToMap(nn::load_npz((tf / file).string()));
  if (!theirs.count(key))
    return -1;
  const auto a = nn::cast(ours.at(key), nn::DType::Float64).to_vector<double>();
  const auto b = nn::cast(theirs.at(key), nn::DType::Float64).to_vector<double>();
  if (a.size() != b.size())
    return -1;
  std::size_t same = 0;
  for (std::size_t i = 0; i < a.size(); ++i)
    same += a[i] == b[i];
  return double(same) / double(a.size());
}

// ---- data -------------------------------------------------------------------------------------

/// tflow's half-pixel bilinear 28 -> 8 resize (double accumulation, float result).
inline Tensor Resize8(const Tensor& images) {
return nn::models::BigGanResize8(images);
}

struct BinaryData {
  std::vector<ae::SaliencyData> pools;
  std::vector<Tensor>           gray, binary; // [n, 8, 8, 1] float
  Map                           record;       // tflow's data.npz
};

inline BinaryData LoadBinary(const fs::path& data) {
  BinaryData d;
  d.pools = ae::LoadSaliency(data);
  for (int k = 0; k < 3; ++k) {
    const std::string split = k == 0 ? "fit" : k == 1 ? "validation" : "test";
    auto              gray  = Resize8(d.pools[k].images);
    auto              g     = gray.to_vector<float>();
    for (auto& v : g)
      v = v >= .5f ? 1.f : 0.f;
    auto x = Floats(g, gray.shape());
    d.gray.push_back(gray);
    d.binary.push_back(x);
    d.record[split + "_original"]   = d.pools[k].images;
    d.record[split + "_gray"]       = gray;
    d.record[split + "_images"]     = x;
    d.record[split + "_labels"]     = d.pools[k].labels;
    d.record[split + "_source_ids"] = d.pools[k].source;
  }
  return d;
}

inline Tensor Rows(const Tensor& x, const std::vector<std::int64_t>& rows) {
  return nn::take_rows(x, rows);
}

// ---- model base -------------------------------------------------------------------------------

/// A binary-pixel autoregressive density: Network() returns the model's named
/// fields with the logits [N, 8, 8, 1] first. `order(j)` is the generation
/// ordinal of pixel j (raster, or reversed for MADE's reverse model).
class BinaryModel {
 public:
  nn::ParameterStore             store;
  std::unique_ptr<nn::Optimizer> optimizer;
  bool                           reverse = false, uses_classes = false;

  explicit BinaryModel(std::uint64_t seed) : store(seed) {}
  virtual ~BinaryModel()                     = default;
  BinaryModel(const BinaryModel&)            = delete;
  BinaryModel& operator=(const BinaryModel&) = delete;

  virtual std::vector<std::pair<std::string, Tensor>> Network(
      const Tensor& x,
      const Tensor& classes) = 0;

  /// Builds every parameter once (call from the derived constructor) and Adam(.003) when training.
  void Build(bool training) {
    {
      nn::NoGradGuard guard;
      Network(nn::zeros({1, 8, 8, 1}), nn::zeros({1}, nn::DType::Int32));
    }
    if (training)
      optimizer = std::make_unique<nn::Optimizer>(store, .003, replay::Adam());
  }

  int Order(int j) const { return reverse ? 63 - j : j; }

  void Validate(const Tensor& x, const Tensor& classes) const {
    if (!uses_classes)
      return;
    check::Require(
        classes.defined() && classes.dim() == 1 && classes.size(0) == x.size(0),
        "aligned class conditioning");
    for (int c : nn::cast(classes, nn::DType::Int32).to_vector<int>())
      check::Require(c >= 0 && c < 10, "valid 0..9 class conditions");
  }

  static Tensor PixelNll(const Tensor& logits, const Tensor& x) {
    return nn::sub(nn::softplus(logits), nn::mul(x, logits));
  }

  Map Evaluate(const Tensor& x, const Tensor& classes = {}) {
    Validate(x, classes);
    nn::NoGradGuard guard;
    auto            fields = Network(x, classes);
    const Tensor    logits = fields[0].second, nll = PixelNll(logits, x);
    Map             out;
    out["logits"]      = logits;
    out["probability"] = nn::sigmoid(logits);
    for (std::size_t i = 1; i < fields.size(); ++i)
      out[fields[i].first] = fields[i].second;
    out["per_image_nll"] = nn::sum(nll, {1, 2, 3});
    out["loss"]          = nn::mean(nll);
    for (auto& [k, v] : out)
      v = v.detach().contiguous();
    RequireFinite(out, "finite model fields");
    return out;
  }

  Tensor Probability(const Tensor& x, const Tensor& classes = {}) {
    Validate(x, classes);
    nn::NoGradGuard guard;
    return nn::sigmoid(Network(x, classes)[0].second).contiguous();
  }

  /// d sum_b logits[b, site] / d image.
  Tensor CausalGradient(const Tensor& x, const Tensor& classes, int site) {
    check::Require(site >= 0 && site < 64, "valid pixel index");
    Validate(x, classes);
    Tensor input = x.detach().clone();
    input.requires_grad_(true);
    const Tensor logits = nn::reshape(Network(input, classes)[0].second, {-1, 64});
    return nn::grad(nn::sum(nn::slice_axis(logits, 1, site, site + 1)), {input})[0]
        .detach()
        .contiguous();
  }

  Map Arrays() const { return replay::Arrays(store); }

  /// tflow's Sample: n images drawn pixel by pixel in model order from an
  /// all-zero canvas (the first `prefix_size` ordinals copied from `prefix`),
  /// u = (mt19937() + .5) / 2^32 bank [n, 64] in ordinal order; `common_four`
  /// shares the first four rows' uniforms across groups of four.
  Map Sample(
      int           n,
      std::uint32_t seed,
      const Tensor& classes     = {},
      const Tensor* prefix      = nullptr,
      int           prefix_size = 0,
      bool          common_four = false) {
    check::Require(
        n > 0 && prefix_size >= 0 && prefix_size <= 64, "valid ancestral sample count/prefix");
    std::vector<float> images(static_cast<std::size_t>(n * 64), 0.f),
        conditionals(static_cast<std::size_t>(n * 64), 0.f);
    std::vector<double> uniform(static_cast<std::size_t>(n * 64));
    std::mt19937        rng(seed);
    for (auto& u : uniform)
      u = (double(rng()) + .5) / 4294967296.;
    if (common_four) {
      check::Require(n % 4 == 0, "common-four-noise group");
      for (int b = 4; b < n; ++b)
        for (int j = 0; j < 64; ++j)
          uniform[b * 64 + j] = uniform[(b % 4) * 64 + j];
    }
    if (prefix) {
      check::Require(prefix->shape() == nn::Shape({n, 8, 8, 1}), "aligned prefix batch");
      const auto p = prefix->contiguous().to_vector<float>();
      for (int b = 0; b < n; ++b)
        for (int j = 0; j < prefix_size; ++j)
          images[b * 64 + Order(j)] = p[b * 64 + Order(j)];
    }
    for (int j = prefix_size; j < 64; ++j) {
      const int  pixel = Order(j);
      const auto p     = Probability(Floats(images, {n, 8, 8, 1}), classes).to_vector<float>();
      for (int b = 0; b < n; ++b) {
        const float q            = p[b * 64 + pixel];
        conditionals[b * 64 + j] = q;
        images[b * 64 + pixel]   = uniform[b * 64 + j] < q ? 1.f : 0.f;
      }
    }
    return {
        {"images", Floats(images, {n, 8, 8, 1})},
        {"uniform", nn::from_vector(uniform, {n, 64})},
        {"conditionals", Floats(conditionals, {n, 64})}};
  }
};

// ---- example configuration and class labels ---------------------------------------------------

/// What differs between the binary density examples.
struct Spec {
  std::string   name, variant; // tflow output/models/<name>[/<variant>]
  std::int64_t  parameters = 0, tensors = 0, masked = 0;
  std::uint64_t batch_seed  = 0;
  std::uint32_t sample_seed = 0, completion_seed = 0, epoch_sample_seed = 0;
  std::string   title, html;    // index.html title / body (after the h1)
  std::string   tag;            // console tag, e.g. "maskedCNN"
  std::string   metrics_prefix; // leading JSON members ("\"conditional\":true,")
};

inline Tensor ClassesOf(const BinaryData& d, int split, const std::vector<std::int64_t>& rows) {
  return nn::take_rows(d.pools[split].labels, rows);
}
inline Tensor CycleClasses(int n, bool grouped = false) {
  std::vector<std::int32_t> v(static_cast<std::size_t>(n));
  for (int i = 0; i < n; ++i)
    v[i] = grouped ? i / 4 : i % 10;
  return nn::from_vector(v, {n});
}

} // namespace bpix

namespace diffusion {

namespace nn = datamunge::nn;
namespace fs = std::filesystem;
using nn::Tensor;
using Map = replay::Map;

// ---- random streams and data -----------------------------------------------------------

/// tflow's Gaussian(n, seed[, double]): nn::GaussianNoise({n, 8, 8, 1}, 1, seed).
inline Tensor Gaussian8(std::int64_t n, std::uint32_t seed, bool wide = false) {
  const Tensor raw = nn::reshape(ae::GaussianNoise({n, 8, 8, 1}, 1, seed), {n, 8, 8, 1});
  return wide ? raw : nn::cast(raw, nn::DType::Float32);
}

inline Tensor Ints(const std::vector<std::int32_t>& v) { return nn::from_vector(v, {std::int64_t(v.size())}); }
inline Tensor FullInt(std::int64_t n, int value) { return Ints(std::vector<std::int32_t>(std::size_t(n), value)); }

/// tflow's Times(n, seed, cyclic): i % 32, or int(32 (u + .5) / 2^32) from mt19937(seed).
inline Tensor Times(std::int64_t n, std::uint32_t seed, bool cyclic = false) {
  std::vector<std::int32_t> out(static_cast<std::size_t>(n));
  std::mt19937              rng(seed);
  for (std::int64_t i = 0; i < n; ++i) out[i] = cyclic ? int(i % 32) : int(32 * (double(rng()) + .5) / 4294967296.);
  return Ints(out);
}

/// Rows of axis 0.
inline Tensor Rows(const Tensor& x, const std::vector<std::int64_t>& rows) { return nn::take_rows(x, rows); }

/// [n, 8, 8, 1] images of `x` [n0, 8, 8, 1] repeated so row b is row b % k of `x`.
inline Tensor Cycle(const Tensor& x, std::int64_t n) {
  std::vector<std::int64_t> rows(static_cast<std::size_t>(n));
  for (std::int64_t b = 0; b < n; ++b) rows[b] = b % x.size(0);
  return Rows(x, rows);
}

/// The MNIST pools (ae::LoadSaliency) and tflow's continuous 8x8 images:
/// half-pixel bilinear 28 -> 8, then 2 x - 1 (float32), NO threshold.
struct DigitData {
  std::vector<ae::SaliencyData> pools;
  std::vector<Tensor>           images;  // [n, 8, 8, 1] in [-1, 1]
  Map                           record;  // tflow's data.npz (without the noise/time banks)
};

inline DigitData LoadDigits(const fs::path& data) {
  DigitData d;
  d.pools = ae::LoadSaliency(data);
  for (int k = 0; k < 3; ++k) {
    const std::string split = k == 0 ? "fit" : k == 1 ? "validation" : "test";
    d.images.push_back(nn::sub(nn::mul(bpix::Resize8(d.pools[k].images), 2.0), 1.0));
    d.record[split + "_original"]   = d.pools[k].images;
    d.record[split + "_images"]     = d.images.back();
    d.record[split + "_labels"]     = d.pools[k].labels;
    d.record[split + "_source_ids"] = d.pools[k].source;
  }
  return d;
}

inline void Save(const fs::path& file, const Map& m) { nn::save_npz(file.string(), replay::ToNamed(m)); }
inline Map Load(const fs::path& file) { return replay::ToMap(nn::load_npz(file.string())); }

inline void Finite(const Map& fields) {
  for (const auto& [key, x] : fields)
    if (x.dtype() == nn::DType::Float32)
      for (float v : x.contiguous().to_vector<float>()) check::Require(std::isfinite(v), "finite DDPM field:" + key);
}

/// tflow's Png: every [-1, 1] 8x8 image as a 64x64 tile, `columns` per row, gray 220 background.
inline void Png(const fs::path& path, const Tensor& images, int columns) { bpix::Png(path, images, columns, 1); }

inline std::string Bits(const Tensor& t) { return bpix::Bits(t); }

/// Copies of axis-0 slices stacked: [k, ...] from k tensors of equal shape.
inline Tensor Stack(const std::vector<Tensor>& xs) { return nn::stack(xs, 0); }

/// Rows `rows` of x[k] concatenated in order (gallery assembly helper).
inline double MaxAbs(const Tensor& a, const Tensor& b) { return replay::MaxAbsDiff(a, b); }

// ---- schedule --------------------------------------------------------------------------

/// tflow's DdpmSchedule: 32 cosine levels (s = .008, beta cap .999), float64.
struct Schedule {
  std::map<std::string, std::vector<double>> values;
  const std::vector<double>&                 at(const std::string& key) const { return values.at(key); }
};

inline const Schedule& DdpmSchedule() {
static const Schedule schedule=[] {Schedule out;auto q=nn::models::CosineDiffusionSchedule();
out.values["beta"]=q.beta.to_vector<double>();
out.values["alpha"]=q.alpha.to_vector<double>();
out.values["alpha_bar"]=q.alpha_bar.to_vector<double>();
out.values["alpha_bar_previous"]=q.alpha_bar_previous.to_vector<double>();
out.values["sqrt_alpha_bar"]=q.sqrt_alpha_bar.to_vector<double>();
out.values["sqrt_one_minus_alpha_bar"]=q.sqrt_one_minus_alpha_bar.to_vector<double>();
out.values["posterior_variance"]=q.posterior_variance.to_vector<double>();
out.values["posterior_coefficient1"]=q.posterior_coefficient1.to_vector<double>();
out.values["posterior_coefficient2"]=q.posterior_coefficient2.to_vector<double>();
return out;}();return schedule;
}

inline Map ScheduleArrays() {
  Map out;
  for (const auto& [k, v] : DdpmSchedule().values) out[k] = nn::from_vector(v, {32});
  return out;
}

/// tflow's DdpmExtract: float(schedule[key][time]) as float32 [n, 1, 1, 1].
inline Tensor Extract(const std::string& key, const Tensor& time) {
return nn::models::DiffusionExtract(nn::from_vector(DdpmSchedule().at(key),{32}),time,4);
}

/// q(x_t | x_0) = sqrt(alpha_bar) x0 + sqrt(1 - alpha_bar) eps.
inline Tensor Noised(const Tensor& clean, const Tensor& noise, const Tensor& time) {
return nn::models::DiffusionNoised(clean,noise,time,nn::models::CosineDiffusionSchedule());
}

// ---- epsilon MLP -----------------------------------------------------------------------

/// [sin, cos](time / maximum_time * pi {1, 2, 4, 8}) as [n, 8].
inline Tensor TimeEmbedding(const Tensor& time, float maximum_time = 31.f) {
return nn::models::DiffusionContinuousTimeEmbedding(time,maximum_time);
}

/// Creates tflow's three dense layers in tflow's order (W ~ N(0, .1), b = 0).
inline void CreateMlp(nn::ParameterStore& p, std::int64_t in, std::int64_t out) {
return nn::models::InitializeDiffusionMlp(p,in,out);
}

inline Tensor Dense(const nn::ParameterStore& p, const std::string& name, const Tensor& x, bool silu) {
  const Tensor y = nn::bias_add(nn::matmul(x, p.at(name + "/W")), p.at(name + "/b"));
  return silu ? nn::mul(y, nn::sigmoid(y)) : y;  // TF kSilu: x * sigmoid(x)
}

struct PredictorPath {
  Tensor epsilon, time_embedding, hidden1, hidden2;
};

/// tflow's DdpmPredictor: flat 64 pixels + 8 time features -> 32 SiLU -> 32 SiLU -> 64.
inline PredictorPath DdpmPredictor(const nn::ParameterStore& p, const Tensor& state, const Tensor& time) {
auto path=nn::models::DiffusionImagePrediction(p,state,time);return {path.epsilon,path.time_embedding,path.hidden1,path.hidden2};
}

struct ReversePath {
  Tensor value, mean, variance, x0_raw, x0_clipped;
};

/// tflow's DdpmReverse: x0 from epsilon, clip [-1, 1], posterior mean c1 x0 + c2 x_t,
/// fixed posterior variance, value = mean + sqrt(variance) z.
inline ReversePath DdpmReverse(const Tensor& state, const Tensor& time, const Tensor& epsilon, const Tensor& innovation) {
auto path=nn::models::DdpmReverse(state,time,epsilon,innovation,nn::models::CosineDiffusionSchedule());return {path.value,path.mean,path.variance,path.x0_raw,path.x0_clipped};
}

/// d sum(f(state)[:, first pixel]) / d state.
template <class F>
inline Tensor FirstPixelInputGradient(const Tensor& x, F&& f) {
  Tensor s = x.detach().clone();
  s.requires_grad_();
  const Tensor y = f(s);
  return nn::grad(nn::sum(nn::slice_axis(nn::reshape(y, {y.size(0), -1}), 1, 0, 1)), {s})[0];
}

inline nn::OptimizerConfig Adam() {
  nn::OptimizerConfig c;
  c.kind = nn::OptimizerKind::Adam;
  return c;
}

inline Map Detached(const Map& m) {
  Map out;
  for (const auto& [k, v] : m) out[k] = v.detach();
  return out;
}

/// Gradients of `loss` w.r.t. every parameter of `p`, by name.
inline Map ParameterGradients(const nn::ParameterStore& p, const Tensor& loss) {
  return replay::Named(p, nn::grad(loss, p.parameters()));
}

/// tflow's ml::DdpmModel (seed 11003, 5504 parameters / 6 tensors).
class DdpmModel {
 public:
  nn::ParameterStore             store{11003};


  explicit DdpmModel(bool training = true) {
    CreateMlp(store, 72, 64);

  }
  Tensor Loss(const Tensor& x, const Tensor& e, const Tensor& t, Map* fields = nullptr) {
    const Tensor noised = Noised(x, e, t);
    const auto   path   = DdpmPredictor(store, noised, t);
    const Tensor loss   = nn::mean(nn::square(nn::sub(path.epsilon, e)));
    if (fields)
      *fields = Detached({{"noised", noised}, {"epsilon", path.epsilon}, {"time_embedding", path.time_embedding},
                          {"hidden1", path.hidden1}, {"hidden2", path.hidden2}, {"loss", loss}});
    return loss;
  }
  Map Evaluate(const Tensor& x, const Tensor& e, const Tensor& t) {
    nn::NoGradGuard guard;
    Map             fields;
    Loss(x, e, t, &fields);
    return fields;
  }
  Map  Gradient(const Tensor& x, const Tensor& e, const Tensor& t) { return ParameterGradients(store, Loss(x, e, t)); }
  /// State-only ancestral transition (no labels/targets).
  Map Reverse(const Tensor& x, const Tensor& t, const Tensor& z) {
    Map out;
    {
      nn::NoGradGuard guard;
      const auto      path = DdpmPredictor(store, x, t);
      const auto      r    = DdpmReverse(x, t, path.epsilon, z);
      out = {{"epsilon", path.epsilon}, {"next", r.value},          {"mean", r.mean},
             {"variance", r.variance},  {"x0_raw", r.x0_raw},       {"x0_clipped", r.x0_clipped}};
    }
    out["input_gradient"] = FirstPixelInputGradient(x, [&](const Tensor& s) { return DdpmPredictor(store, s, t).epsilon; });
    return out;
  }
  Map                      Arrays() const { return replay::Arrays(store); }
  std::vector<std::string> Snapshot() const {
    std::vector<std::string> out;
    for (const auto& [k, v] : Arrays()) out.push_back(Bits(v));
    return out;
  }
};

/// Finds a frozen DDPM-family checkpoint in `dir`: final.npz (our ports) or
/// model_arrays.npz (tflow's restored final weights).
inline fs::path FrozenFile(const fs::path& dir) {
  if (fs::exists(dir / "final.npz")) return dir / "final.npz";
  if (fs::exists(dir / "model_arrays.npz")) return dir / "model_arrays.npz";
  return {};
}

/// Resolves a frozen-model option: "ours" (our port's output), "tf" (tflow's
/// recorded run), "auto" (ours when present, else TF) or a directory.
inline fs::path FrozenDir(const std::string& choice, const fs::path& ours, const fs::path& tf) {
  if (choice == "ours") return ours;
  if (choice == "tf") return tf;
  if (choice == "auto") return FrozenFile(ours).empty() ? tf : ours;
  return choice;
}

/// key=value options shared by the diffusion ports.
struct Options {
  int                                epochs = 3, threads = 4;
  fs::path                           data = paths::Dataset("saliency"), out, tf;
  std::string                        init = "nn";
  std::map<std::string, std::string> extra;  // ddpm= / guidance=
};

inline Options ParseOptions(int argc, char** argv, const std::string& name, const std::vector<std::string>& extra_keys,
                            const std::string& usage) {
  Options o;
  o.tf = replay::TfModels(name);
  for (const auto& k : extra_keys) o.extra[k] = "auto";
  for (int i = 1; i < argc; ++i) {
    const std::string a = argv[i];
    const auto        e = a.find('=');
    if (e == std::string::npos) throw std::invalid_argument(usage);
    const std::string k = a.substr(0, e), v = a.substr(e + 1);
    if (k == "epochs") o.epochs = std::stoi(v);
    else if (k == "data") o.data = v;
    else if (k == "out") o.out = v;
    else if (k == "init") o.init = v;
    else if (k == "tf") o.tf = v;
    else if (k == "threads") o.threads = std::stoi(v);
    else if (o.extra.count(k)) o.extra[k] = v;
    else throw std::invalid_argument(usage);
  }
  check::Require(o.epochs > 0 && o.epochs <= 100, "three cheap default epochs or explicit 1..100 override");
  if (o.out.empty()) o.out = paths::OutputRoot() / "models" / name;
  fs::create_directories(o.out);
  if (o.threads > 0) nn::set_num_threads(o.threads);
  return o;
}

/// Gathers per-step outputs: saved[key] grows to [steps, ...].
struct StepStack {
  std::map<std::string, std::vector<Tensor>> parts;
  void add(const Map& m) {
    for (const auto& [k, v] : m) parts[k].push_back(v);
  }
  Map stacked() const {
    Map out;
    for (const auto& [k, v] : parts) out[k] = nn::stack(v, 0);
    return out;
  }
};

/// Gallery: images[b * columns + j] = xs[j] row rows[b] (all [n, 8, 8, 1]).
inline Tensor Gallery(const std::vector<std::vector<Tensor>>& cells) {
  std::vector<Tensor> flat;
  for (const auto& row : cells)
    for (const auto& c : row) flat.push_back(nn::reshape(c, {1, 8, 8, 1}));
  return nn::concat(flat, 0);
}

inline Tensor Row(const Tensor& x, std::int64_t b) { return nn::slice_axis(x, 0, b, b + 1); }
/// Element `s` of a stacked [steps, ...] tensor, without the leading axis.
inline Tensor At(const Tensor& stacked, std::int64_t s) {
  nn::Shape shape(stacked.shape().begin() + 1, stacked.shape().end());
  return nn::reshape(nn::slice_axis(stacked, 0, s, s + 1), shape);
}

}  // namespace diffusion

namespace ncsn {

namespace nn = datamunge::nn;
using nn::Tensor;
using Map = replay::Map;

/// tflow's ScoreSigmas: .05^(i / 15), i = 0..15 (float64).
inline const std::vector<double>& ScoreSigmas() {
  static const std::vector<double> values = [] {
    std::vector<double> v(16);
    for (int i = 0; i < 16; ++i) v[i] = std::pow(.05, i / 15.);
    return v;
  }();
  return values;
}

/// float(sigma[level]) as [n, 1, 1, 1].
inline Tensor ScoreSigma(const Tensor& level) {
return nn::models::NoiseConditionalSigma(level);
}

/// tflow's DdpmPredictor with a configurable time normalisation (maximum_time).
inline diffusion::PredictorPath Predictor(const nn::ParameterStore& p, const Tensor& state, const Tensor& time, float maximum_time) {
auto path=nn::models::DiffusionImagePrediction(p,state,time,maximum_time);return {path.epsilon,path.time_embedding,path.hidden1,path.hidden2};
}

struct ScorePath {
  Tensor score, normalized_score, epsilon, time_embedding, hidden1, hidden2;
};

inline ScorePath NoiseConditionalScore(const nn::ParameterStore& p, const Tensor& state, const Tensor& level) {
auto path=nn::models::NoiseConditionalScore(p,state,level);return {path.score,path.normalized_score,path.epsilon,path.time_embedding,path.hidden1,path.hidden2};
}

struct LangevinPath {
  Tensor value, mean, alpha;
};

/// x + .5 alpha score + sqrt(alpha) z, alpha = 2e-5 (sigma / .05)^2.
inline LangevinPath AnnealedLangevin(const Tensor& state, const Tensor& level, const Tensor& score, const Tensor& innovation) {
auto path=nn::models::AnnealedLangevin(state,level,score,innovation);return {path.value,path.mean,path.alpha};
}

/// tflow's ml::NoiseConditionalScoreModel (seed 12003, 5504 parameters / 6 tensors).
class NoiseConditionalScoreModel {
 public:
  nn::ParameterStore             store{12003};


  explicit NoiseConditionalScoreModel(bool training = true) {
    diffusion::CreateMlp(store, 72, 64);

  }
  Tensor Loss(const Tensor& x, const Tensor& e, const Tensor& t, Map* fields = nullptr) const {
    const Tensor sigma  = ScoreSigma(t);
    const Tensor noised = nn::add(x, nn::mul(sigma, e));
    const auto   path   = NoiseConditionalScore(store, noised, t);
    const Tensor loss   = nn::mul(nn::mean(nn::square(nn::add(nn::mul(sigma, path.score), e))), .5);
    if (fields)
      *fields = diffusion::Detached({{"noised", noised}, {"score", path.score}, {"epsilon", path.epsilon},
                                     {"time_embedding", path.time_embedding}, {"hidden1", path.hidden1}, {"hidden2", path.hidden2},
                                     {"loss", loss}});
    return loss;
  }
  Map Evaluate(const Tensor& x, const Tensor& e, const Tensor& t) const {
    nn::NoGradGuard guard;
    Map             fields;
    Loss(x, e, t, &fields);
    return fields;
  }
  Map  Gradient(const Tensor& x, const Tensor& e, const Tensor& t) { return diffusion::ParameterGradients(store, Loss(x, e, t)); }
  /// State-only annealed Langevin update; input_gradient = d sum(score[:, pixel 0]) / d state.
  Map Reverse(const Tensor& x, const Tensor& t, const Tensor& z) const {
    Map out;
    {
      nn::NoGradGuard guard;
      const auto      path = NoiseConditionalScore(store, x, t);
      const auto      r    = AnnealedLangevin(x, t, path.score, z);
      out = {{"score", path.score}, {"epsilon", path.epsilon}, {"next", r.value}, {"mean", r.mean}, {"alpha", r.alpha}};
    }
    out["input_gradient"] =
        diffusion::FirstPixelInputGradient(x, [&](const Tensor& s) { return NoiseConditionalScore(store, s, t).score; });
    return out;
  }
  Map                      Arrays() const { return replay::Arrays(store); }
  std::vector<std::string> Snapshot() const {
    std::vector<std::string> out;
    for (const auto& [k, v] : Arrays()) out.push_back(diffusion::Bits(v));
    return out;
  }
};

}  // namespace ncsn

namespace scoresde {

namespace nn = datamunge::nn;
using nn::Tensor;
using Map = replay::Map;

struct FieldPath {
  Tensor score, epsilon, sigma, g_squared, reverse_drift, probability_drift;
};

/// tflow's ScoreSdeField; `p` null = Gaussian oracle.
inline FieldPath Field(const nn::ParameterStore* p, const Tensor& state, const Tensor& physical_time) {
auto path=nn::models::ScoreSdeField(p,state,physical_time);return {path.score,path.epsilon,path.sigma,path.g_squared,path.reverse_drift,path.probability_drift};
}

struct StepPath {
  FieldPath           field;
  Tensor              em_mean, em_value, ode_value;
  std::vector<Tensor> ode_stage_states, ode_stage_drifts;
};

/// tflow's ScoreSdeStep: one reverse EM step and one RK4 probability-flow step (time decreasing).
inline StepPath Step(const nn::ParameterStore* p, const Tensor& state, const Tensor& time, const Tensor& h, const Tensor& innovation) {
auto path=nn::models::ScoreSdeStep(p,state,time,h,innovation);auto a=path.field;return {{a.score,a.epsilon,a.sigma,a.g_squared,a.reverse_drift,a.probability_drift},path.em_mean,path.em_value,path.ode_value,path.ode_stage_states,path.ode_stage_drifts};
}

/// tflow's ml::ScoreSdeModel: frozen NCSN weights (no training) or the oracle.
class ScoreSdeModel {
 public:
  nn::ParameterStore store{12003};
  bool               oracle;

  explicit ScoreSdeModel(bool oracle_ = false) : oracle(oracle_) {
    if (!oracle) diffusion::CreateMlp(store, 72, 64);
  }
  const nn::ParameterStore* params() const { return oracle ? nullptr : &store; }

  /// mode 0: EM fields only, 1: ODE fields only, 2: all.
  Map Evaluate(const Tensor& x, float physical_time, float h, const Tensor& z, int mode = 2) const {
    check::Require(physical_time >= 0 && physical_time <= 1 && h >= 0 && h <= physical_time + 1e-7 && x.shape() == z.shape(),
                   "valid reverse score SDE time, step and noise");
    const Tensor t  = nn::full({x.size(0)}, physical_time);
    const Tensor dt = nn::full({}, h);
    Tensor       s  = x.detach().clone();
    s.requires_grad_();
    const auto path = Step(params(), s, t, dt, z);
    Map        out;
    const std::vector<std::pair<std::string, Tensor>> outputs{
        {"score_input_gradient", path.field.score}, {"em_input_gradient", path.em_value}, {"ode_input_gradient", path.ode_value}};
    for (std::size_t i = 0; i < outputs.size(); ++i) {
      if ((mode == 0 && i == 2) || (mode == 1 && i == 1)) continue;
      nn::GradOptions keep;
      keep.retain_graph = true;
      const Tensor first = nn::slice_axis(nn::reshape(outputs[i].second, {x.size(0), 64}), 1, 0, 1);
      out[outputs[i].first] = nn::grad(nn::sum(first), {s}, keep)[0];
    }
    out["score"]             = path.field.score.detach();
    out["epsilon"]           = path.field.epsilon.detach();
    out["sigma"]             = path.field.sigma.detach();
    out["g_squared"]         = path.field.g_squared.detach();
    out["reverse_drift"]     = path.field.reverse_drift.detach();
    out["probability_drift"] = path.field.probability_drift.detach();
    if (mode != 1) {
      out["em_mean"] = path.em_mean.detach();
      out["em_next"] = path.em_value.detach();
    }
    if (mode != 0) {
      out["ode_next"] = path.ode_value.detach();
      for (int i = 0; i < 4; ++i) {
        out["ode_stage_state" + std::to_string(i)] = path.ode_stage_states[i].detach();
        out["ode_stage_drift" + std::to_string(i)] = path.ode_stage_drifts[i].detach();
      }
    }
    return out;
  }
  Map                      Arrays() const { return replay::Arrays(store); }
  std::vector<std::string> Snapshot() const {
    std::vector<std::string> out;
    for (const auto& [k, v] : Arrays()) out.push_back(diffusion::Bits(v));
    return out;
  }
};

}  // namespace scoresde

namespace {

namespace nn = datamunge::nn;
namespace fs = std::filesystem;
using nn::Tensor;
using namespace diffusion;
using scoresde::ScoreSdeModel;

/// tflow's Png: clamp [-1, 1], floor((v + 1) .5 255 + .5).
void Png(const fs::path& path, const Tensor& images, int columns) {
  const auto         n = images.size(0);
  const auto         v = images.contiguous().to_vector<float>();
  const std::int64_t H = (n + columns - 1) / columns * 64, W = columns * 64;
  std::vector<float> out(static_cast<std::size_t>(H * W * 3), 220.f);
  for (std::int64_t b = 0; b < n; ++b)
    for (int y = 0; y < 64; ++y)
      for (int x = 0; x < 64; ++x) {
        const double value = std::clamp(double(v[std::size_t(b * 64 + (y / 8) * 8 + x / 8)]), -1., 1.);
        for (int c = 0; c < 3; ++c) out[std::size_t(((b / columns * 64 + y) * W + b % columns * 64 + x) * 3 + c)] = float(std::floor((value + 1) * .5 * 255 + .5));
      }
  bpix::PngBytes(path, out, H, W);
}

Map Sample(const ScoreSdeModel& model, int steps, bool ode, std::int64_t n = 32, std::uint32_t initial_seed = 13201,
           std::uint32_t innovation_seed = 13202, bool oracle = false) {
  Tensor initial = Gaussian8(n, initial_seed);
  if (oracle) {
    auto v = initial.to_vector<float>();
    for (auto& x : v) x = float(.3 + std::sqrt(double(.49f) + 1) * x);
    initial = nn::from_vector(v, {n, 8, 8, 1});
  }
  const float         h = 1.f / steps;
  Tensor              current = initial;
  std::vector<Tensor> trajectory{initial}, innovations;
  std::vector<float>  times;
  std::vector<double> variance_curve{double(.49f) + 1};
  StepStack           saved;
  for (int step = 0; step < steps; ++step) {
    const float t = 1.f - step * h;
    times.push_back(t);
    const Tensor z = Gaussian8(n, innovation_seed + step);
    innovations.push_back(Gaussian8(n, innovation_seed + step, true));
    const auto out = model.Evaluate(current, t, h, z, ode ? 1 : 0);
    Finite(out);
    saved.add(out);
    current = out.at(ode ? "ode_next" : "em_next");
    trajectory.push_back(current);
    if (oracle) {
      const double a  = out.at(ode ? "ode_input_gradient" : "em_input_gradient").contiguous().to_vector<float>()[0];
      const double g2 = out.at("g_squared").contiguous().to_vector<float>()[0];
      variance_curve.push_back(a * a * variance_curve.back() + (ode ? 0 : double(h) * g2));
    }
  }
  const auto final = model.Evaluate(current, 0, 0, nn::zeros({n, 8, 8, 1}), 0);
  auto       tw = current.to_vector<float>();
  const auto fsc = final.at("score").contiguous().to_vector<float>();
  for (std::size_t i = 0; i < tw.size(); ++i) tw[i] = tw[i] + (.05f * .05f) * fsc[i];
  Map result = saved.stacked();
  result["initial"]        = initial;
  result["images"]         = current;
  result["tweedie_images"] = nn::from_vector(tw, current.shape());
  result["final_score"]    = final.at("score");
  result["trajectory"]     = nn::stack(trajectory, 0);
  result["innovations"]    = nn::stack(innovations, 0);
  result["physical_time"]  = nn::from_vector(times, {std::int64_t(steps)});
  result["h"]              = nn::full({}, h);
  if (oracle) result["oracle_variance_recurrence"] = nn::from_vector(variance_curve, {std::int64_t(steps) + 1});
  return result;
}

struct Args {
  std::string ncsn = "auto";
  fs::path    out, tf = replay::TfModels("score_sde");
  int         threads = 4;
};

void Run(const Args& o) {
  const fs::path root = o.out, tf = o.tf;
  const fs::path trained = FrozenDir(o.ncsn, paths::OutputRoot() / "models" / "noise_conditional_score",
                                     replay::TfModels("noise_conditional_score"));
  const fs::path frozen  = FrozenFile(trained);
  check::Require(!frozen.empty() && fs::exists(trained / "model_arrays.npz") && fs::exists(trained / "data.npz"),
                 "score SDE requires an NCSN run: run noise_conditional_score first, or ncsn=tf|DIR");
  std::cout << "frozen NCSN weights: " << frozen.string() << "\n";
  fs::create_directories(root);
  ScoreSdeModel model;
  replay::LoadInto(model.store, frozen);
  const auto expected = Load(trained / "model_arrays.npz");
  const auto arrays   = model.Arrays();
  check::Require(model.store.count() == 5504 && arrays.size() == 6, "frozen score SDE 5504 weights");
  for (const auto& [key, value] : arrays) check::Require(Bits(value) == Bits(expected.at(key)), "score SDE restore BITEXACT matches NCSN");
  Save(root / "model_arrays.npz", arrays);
  if (fs::exists(trained / "metrics.json")) fs::copy_file(trained / "metrics.json", root / "training_metrics.json", fs::copy_options::overwrite_existing);
  const auto before    = model.Snapshot();
  const auto ncsn_data = Load(trained / "data.npz");
  const Tensor input = Gaussian8(4, 13401), zero = nn::zeros({4, 8, 8, 1});
  ncsn::NoiseConditionalScoreModel discrete(false);
  replay::LoadInto(discrete.store, frozen);
  Map    grid{{"input", input}};
  double grid_error = 0;
  for (int i = 0; i < 16; ++i) {
    const float t          = 1.f - i / 15.f;
    const auto  old        = discrete.Reverse(input, FullInt(4, i), zero);
    const auto  continuous = model.Evaluate(input, t, 0, zero, 0);
    grid["discrete_score" + std::to_string(i)]     = old.at("score");
    grid["continuous_score" + std::to_string(i)]   = continuous.at("score");
    grid["continuous_epsilon" + std::to_string(i)] = continuous.at("epsilon");
    grid_error = std::max(grid_error, MaxAbs(old.at("score"), continuous.at("score")));
  }
  check::Require(grid_error < 3e-5, "continuous score conditioning matches ALL 16 training grid levels");
  Save(root / "conditioning_grid.npz", grid);

  std::vector<std::string> names;
  std::vector<std::vector<Tensor>> comparison(8, std::vector<Tensor>(4));
  double noisy_effect = 0;
  for (int config = 0; config < 4; ++config) {
    const bool        ode   = config > 0;
    const int         steps = ode ? (config == 1 ? 8 : config == 2 ? 16 : 32) : 64;
    const std::string name  = ode ? "ode_rk4_" + std::to_string(steps) : "reverse_sde_em64";
    const auto        sample  = Sample(model, steps, ode);
    const auto        changed = Sample(model, steps, ode, 32, 13201, 14202);
    if (ode) {
      check::Require(Bits(sample.at("trajectory")) == Bits(changed.at("trajectory")), "probability flow ODE ignores ALL innovations BITEXACT");
    } else {
      noisy_effect = MaxAbs(sample.at("images"), changed.at("images"));
      check::Require(noisy_effect > .01, "reverse SDE innovation changes actual samples");
      Save(root / "sde_changed_innovations.npz", changed);
    }
    Save(root / (name + ".npz"), sample);
    Png(root / (name + ".png"), sample.at("images"), 8);
    if (!ode) Png(root / "sde_tweedie.png", sample.at("tweedie_images"), 8);
    std::vector<std::vector<Tensor>> cells(8);
    for (int b = 0; b < 8; ++b) {
      comparison[b][config] = Row(sample.at("images"), b);
      for (int j = 0; j < 5; ++j) cells[b].push_back(Row(At(sample.at("trajectory"), j * steps / 4), b));
    }
    const Tensor gallery = Gallery(cells);
    Save(root / (name + "_gallery.npz"), {{"images", gallery}});
    Png(root / (name + "_trajectory.png"), gallery, 5);
    names.push_back(name);
    std::cout << name << ":integratorScoreEvaluations=" << (ode ? steps * 4 : steps) << std::endl;
  }
  const Tensor comparison_images = Gallery(comparison);
  Save(root / "comparison.npz", {{"images", comparison_images}});
  Png(root / "comparison.png", comparison_images, 4);

  ScoreSdeModel oracle(true);
  std::ofstream convergence(root / "oracle_convergence.tsv");
  convergence.precision(17);
  convergence << "steps\tode_pointwise_max_error\tem_expected_variance\tode_expected_variance\ttarget_variance\n";
  const double variance = double(.49f), target_variance = variance + .05 * .05;
  double       oracle_error64 = 0;
  for (int steps : {8, 16, 32, 64}) {
    const auto em = Sample(oracle, steps, false, 4, 13301, 13302, true), ode = Sample(oracle, steps, true, 4, 13301, 13302, true);
    Save(root / ("oracle_em" + std::to_string(steps) + ".npz"), em);
    Save(root / ("oracle_ode" + std::to_string(steps) + ".npz"), ode);
    const double scale = std::sqrt(target_variance / (variance + 1));
    double       error = 0;
    const auto   init = ode.at("initial").to_vector<float>(), img = ode.at("images").to_vector<float>();
    for (int j = 0; j < 4 * 64; ++j) error = std::max(error, std::abs(.3 + scale * (double(init[j]) - .3) - img[j]));
    const auto ev = em.at("oracle_variance_recurrence").to_vector<double>(), ov = ode.at("oracle_variance_recurrence").to_vector<double>();
    convergence << steps << '\t' << error << '\t' << ev[steps] << '\t' << ov[steps] << '\t' << target_variance << '\n';
    std::printf("oracle %2d steps: ODE max error %.3g, EM variance %.6f, ODE variance %.6f (target %.6f)\n", steps, error, ev[steps],
                ov[steps], target_variance);
    if (steps == 64) {
      oracle_error64 = error;
      check::Require(error < 8e-6, "Gaussian oracle probability flow analytic scale");
    }
  }
  double     prior_bound = 0;
  const auto fit         = ncsn_data.at("fit_images").to_vector<float>();
  for (float x : fit) prior_bound += .5 * std::pow(double(x), 2) / 1000;
  check::Require(before == model.Snapshot(), "ALL score SDE/ODE controls leave 6 weights immutable");
  std::ofstream meta(root / "metrics.json");
  meta.precision(17);
  meta << "{\"parameters_frozen\":5504,\"parameter_tensors\":6,\"additional_training_updates\":0,\"sigma_min\":0.05,\"sigma_max\":1,"
          "\"sde_steps\":64,\"ode_steps\":[8,16,32],\"samples_each\":32,\"continuous_training_grid_score_max_error\":"
       << grid_error << ",\"sde_changed_innovation_max_effect\":" << noisy_effect
       << ",\"ode_innovation_canary_bitexact\":true,\"fit_average_conditional_terminal_prior_kl_bound_per_image\":" << prior_bound
       << ",\"frozen_ncsn\":\"" << frozen.string() << "\"}\n";
  std::ofstream html(root / "index.html");
  html << "<!doctype html><meta charset='utf-8'><title>Score-based SDEs</title><style>body{font:16px system-ui;margin:30px;"
          "max-width:1100px}img{max-width:100%;image-rendering:pixelated}</style><h1>VE reverse SDE and probability-flow ODE</h1><p><a "
          "href='https://arxiv.org/abs/2011.13456'>Score-based SDEs</a>, frozen three-epoch NCSN 5504 weights / 6 tensors, NO additional "
          "training. Continuous sigma(t)=.05*20^t, t 0 to 1, g&sup2;=2 log 20 sigma&sup2;, forward drift 0. Network level 15*(1-t); "
          "continuous sinusoidal conditioning interpolates the 16 trained levels. All 16 grid outputs checked against the discrete "
          "frozen model. Datamunge port of tflow's score_sde.</p><p>Reverse Euler-Maruyama from t 1 to 0: "
          "x_next=x+h*g&sup2;*score+sqrt(h*g&sup2;)*z, 64 steps. Probability-flow ODE drift .5g&sup2;*score, RK4 steps 8/16/32. ODE "
          "ignores ALL innovations bit-exactly; SDE changes with them. Initial standard Gaussian is an APPROXIMATE terminal prior. "
          "Gaussian oracle score=(.3-x)/(.49+sigma&sup2;) runs through the same integrators.</p><h2>Paired first 8 initial latents</h2>"
          "<p>Columns reverse SDE 64, ODE-RK4 steps 8, 16, 32. Raw states clipped ONLY for display.</p><img src='comparison.png'>";
  for (const auto& name : names)
    html << "<h2>" << name << "</h2><img src='" << name << ".png'><p>First 8 trajectories at physical times 1, .75, .5, .25, 0.</p>"
         << "<img src='" << name << "_trajectory.png'>";
  html << "<h2>SDE samples after optional final Tweedie correction</h2><img src='sde_tweedie.png'><p>See metrics.json, "
          "oracle_convergence.tsv. Weak inherited score and prior mismatch limit generation.</p>";
  check::Require(bool(meta) && bool(html) && bool(convergence), "complete score SDE records");
  std::cout << "gridError=" << grid_error << " sdeInnovationEffect=" << noisy_effect << " oracleODE64Error=" << oracle_error64
            << " priorKLBound=" << prior_bound
            << "\ncontinuousGrid/reverseSDE/probabilityRK4/oracleConvergence/noiseControls/frozenRestore/immutable PASS\n";

  // ---- TF parity ----
  if (!fs::exists(tf / "metrics.json")) {
    std::cout << "no TF record at " << tf.string() << "; parity checks skipped\nArtifacts: " << root.string() << "\n";
    return;
  }
  std::cout << "TF parity (" << tf.string() << "):\n";
  double oracle_diff = 0;
  for (int steps : {8, 16, 32, 64})
    for (const std::string kind : {"em", "ode"}) {
      const std::string f = "oracle_" + kind + std::to_string(steps) + ".npz";
      oracle_diff         = std::max(oracle_diff, bpix::Compare(tf, f, Load(root / f)));
    }
  check::Require(oracle_diff < 1e-4, "Gaussian oracle integrators match TF's records");
  const bool tf_weights = bpix::Compare(tf, "model_arrays.npz", arrays) == 0;
  double     learned    = bpix::Compare(tf, "conditioning_grid.npz", grid);
  for (const auto& name : names) learned = std::max(learned, bpix::Compare(tf, name + ".npz", Load(root / (name + ".npz"))));
  if (tf_weights) check::Require(learned < 1e-3, "TF's frozen NCSN reproduces TF's grid, SDE and ODE records");
  std::cout << (tf_weights ? "frozen weights are TF's: learned records checked (< 1e-3)\n"
                           : "frozen weights are our NCSN port's (replayed TF run, not bit-identical): learned records compared only\n")
            << "Artifacts: " << root.string() << "\nAll score_sde checks passed.\n";
}

}  // namespace

int main(int argc, char** argv) {
  try {
    Args o;
    for (int i = 1; i < argc; ++i) {
      const std::string a = argv[i];
      const auto        e = a.find('=');
      if (e == std::string::npos) throw std::invalid_argument("ncsn=auto|ours|tf|PATH out=PATH tf=DIR threads=N");
      const std::string k = a.substr(0, e), v = a.substr(e + 1);
      if (k == "ncsn") o.ncsn = v;
      else if (k == "out") o.out = v;
      else if (k == "tf") o.tf = v;
      else if (k == "threads") o.threads = std::stoi(v);
      else throw std::invalid_argument("ncsn=auto|ours|tf|PATH out=PATH tf=DIR threads=N");
    }
    if (o.out.empty()) o.out = paths::OutputRoot() / "models" / "score_sde";
    if (o.threads > 0) nn::set_num_threads(o.threads);
    Run(o);
    return 0;
  } catch (const std::exception& e) {
    std::cerr << e.what() << '\n';
    return 1;
  }
}

