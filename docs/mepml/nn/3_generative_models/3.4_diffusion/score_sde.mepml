> Inspect a Gaussian field before integration

The oracle score is (.3-x)/(.49+sigma(t)^2). At x=.3 it vanishes. A positive reverse step moves values below .3 upward and values above .3 downward; zero innovation isolates this drift.

```{cpp, results="markdown", file="figures/score_sde_worked.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <iostream>
namespace n=dm::nn;namespace m=n::models;using T=n::Tensor;
int main(){std::filesystem::create_directories("build");
auto x=n::reshape(n::from_vector(std::vector<float>{.1f,.3f,.5f},{3}),{3,1,1,1})*n::ones({3,8,8,1});auto time=n::full({3},.5);auto out=m::ScoreSdeStep(nullptr,x,time,n::scalar(.1),n::zeros(x.shape()));T left=n::select(n::reshape(x,{3,64}),1,0),right=n::select(n::reshape(out.em_mean,{3,64}),1,0),extra=n::select(n::reshape(out.ode_value,{3,64}),1,0);
 auto av=left.to_vector<double>(),bv=right.to_vector<double>(),cv=extra.to_vector<double>();
 std::cout<<"| Initial value | EM mean | RK4 probability flow |\n|---:|---:|---:|\n";
 for(std::size_t i=0;i<av.size();++i)std::cout<<"|"<<av[i]<<"|"<<bv[i]<<"|"<<cv[i]<<"|\n";
 n::save_npz("build/score_sde_worked.npz",{{"a",left},{"b",right},{"c",extra}});
 dm::graphics::RPlot::create().lines(av,(right-left).to_vector<double>(),"EM mean increment",{37,99,235}).points(av,(right-left).to_vector<double>(),"All three EM checks",{37,99,235},5).lines(av,(extra-left).to_vector<double>(),"RK4 probability-flow increment",{234,88,12}).points(av,(extra-left).to_vector<double>(),"All three RK4 checks",{234,88,12},5).x_label("Initial coordinate").y_label("Deterministic increment").title("Gaussian drift points toward mean .3").size(900,500).save_svg("build/score_sde_worked.svg");
}
```
