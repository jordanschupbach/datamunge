```{cpp, results="markdown", file="figures/text_image_diffusion_loss.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <filesystem>

int main() {
  const auto fields = dm::nn::load_npz("build/text_image_diffusion/samples.npz");
  for (const auto& [key, value] : fields) {
    if (key == "loss") {
      const auto loss = value.to_vector<double>();
      std::vector<double> update(loss.size());
      std::iota(update.begin(), update.end(), 1.0);
      const auto output = "build/text_image_diffusion/loss.svg";
      dm::graphics::RPlot::create()
          .lines(update, loss, "Fitting batches", {37, 99, 235})
          .title("Denoiser fitting loss")
          .x_label("Adam update")
          .y_label("Clean-image MSE")
          .save_svg(output);
      std::filesystem::copy_file(output, "figures/text_image_diffusion_loss.svg",
                                 std::filesystem::copy_options::overwrite_existing);
    }
  }
}
