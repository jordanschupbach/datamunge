> Latent-prior validation noise error

All three recorded validation rows are shown. This figure preserves the source budget and does not select an additional checkpoint.

```{cpp, results="markdown", file="figures/latent_diffusion_history.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main(){std::filesystem::create_directories("build");std::ifstream input("build/diffusion-models/models/latent_diffusion/history.tsv");if(!input)throw std::runtime_error("Missing preserved training history");std::string line;std::getline(input,line);std::vector<double> epoch,loss;while(std::getline(input,line)){std::istringstream row(line);double x,y;if(!(row>>x>>y))throw std::runtime_error("Invalid history row");epoch.push_back(x);loss.push_back(y);}if(epoch.size()!=3)throw std::runtime_error("Source three-epoch history");
 dm::graphics::RPlot::create().lines(epoch,loss,"All source validation epochs",{37,99,235}).points(epoch,loss,"Recorded values",{234,88,12},5).x_label("Epoch").y_label("Latent epsilon MSE").title("Latent-prior validation noise error").size(900,500).save_svg("build/latent_diffusion_history.svg");std::cout<<"| Epoch | Latent epsilon MSE |\n|---:|---:|\n";for(std::size_t i=0;i<epoch.size();++i)std::cout<<"|"<<epoch[i]<<"|"<<loss[i]<<"|\n";
}
