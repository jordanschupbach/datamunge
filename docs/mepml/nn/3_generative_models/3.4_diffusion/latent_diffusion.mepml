> Recover a latent value without image clipping

Latent coordinates are standardized learned codes. The posterior must preserve values beyond [-1,1]. This example supplies zero predicted noise at level0 and shows a raw clean estimate above two; image clipping would change the model.

```{cpp, results="markdown", file="figures/latent_diffusion_worked.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
namespace n=dm::nn;namespace m=n::models;using T=n::Tensor;
int main(){std::filesystem::create_directories("build");
auto x=n::from_vector(std::vector<float>{-2,-.5f,.5f,2},{2,2});auto out=m::LatentDiffusionReverse(x,n::zeros({2},n::DType::Int32),n::zeros({2,2}),n::ones({2,2}),m::CosineDiffusionSchedule());T left=x,right=out.x0,extra=out.value;
 auto av=left.to_vector<double>(),bv=right.to_vector<double>(),cv=extra.to_vector<double>();
 std::cout<<"| Noisy latent | Unclipped clean latent | Posterior endpoint |\n|---:|---:|---:|\n";
 for(std::size_t i=0;i<av.size();++i)std::cout<<"|"<<av[i]<<"|"<<bv[i]<<"|"<<cv[i]<<"|\n";
 n::save_npz("build/latent_diffusion_worked.npz",{{"a",left},{"b",right},{"c",extra}});
 dm::graphics::RPlot::create().points(n::arange(0,std::int64_t(bv.size())).to_vector<double>(),bv,"Native worked values",{37,99,235},4).x_label("Coordinate / probe index").y_label("Native computed value").title("Recover a latent value without image clipping").size(900,500).save_svg("build/latent_diffusion_worked.svg");
}
```
