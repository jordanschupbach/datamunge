int main(){namespace n=dm::nn;namespace m=n::models;std::filesystem::create_directories("build");n::ParameterStore p(21003);m::RbmParameters(p,8,4);n::Module model([&](const n::Tensor& x){auto h=m::RbmHidden(p,x);n::model_stage("Hidden conditional:4",x,h);return n::model_stage("Visible conditional:8",h,m::RbmVisible(p,h));},"restricted boltzmann: native operation");n::ModelPlotOptions o;o.detail=n::ModelPlotDetail::Blocks;o.sizing.minimum_extent=2;o.sizing.max_planes=2;model.plot(n::zeros({1,8}),o).save_svg("build/restricted_boltzmann_network.svg");}
