int main(){namespace n=dm::nn;namespace m=n::models;std::filesystem::create_directories("build");auto memories=n::from_vector(std::vector<float>{1,0,0,1},{2,2});n::Module model([&](const n::Tensor& x){auto y=m::ModernHopfield(x,memories,8);n::model_stage("Tied key/value attention",x,y.attention);return n::model_stage("Retrieved state",y.attention,y.next);},"modern hopfield: native operation");n::ModelPlotOptions o;o.detail=n::ModelPlotDetail::Blocks;o.sizing.minimum_extent=2;o.sizing.max_planes=2;model.plot(n::zeros({1,2}),o).save_svg("build/modern_hopfield_network.svg");}
