int main(){namespace n=dm::nn;namespace m=n::models;std::filesystem::create_directories("build");n::ParameterStore p(21003),q(21003);m::RbmParameters(p,8,4);m::RbmParameters(q,4,3);n::Module model([&](const n::Tensor& x){auto y=m::DeepBelief(p,q,x);n::model_stage("Exact16-state posterior",x,y.posterior);return n::model_stage("Visible log probability",y.posterior,y.log_probability);},"deep belief: native operation");n::ModelPlotOptions o;o.detail=n::ModelPlotDetail::Blocks;o.sizing.minimum_extent=2;o.sizing.max_planes=2;model.plot(n::zeros({1,8}),o).save_svg("build/deep_belief_network.svg");}
