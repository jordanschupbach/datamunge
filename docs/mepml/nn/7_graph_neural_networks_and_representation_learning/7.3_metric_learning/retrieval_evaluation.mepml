//? Title: Exact embedding retrieval evaluation
//? Lang: en

> Exact embedding retrieval evaluation

Rank frozen descriptors by squared Euclidean distance. Equal distances use
gallery row order, represented here by ascending source IDs. A query can
retrieve several relevant items of the same category. Hit rate at rank k
asks whether any of the first k items is relevant. Macro item recall at k
averages the fraction of each query's relevant items found in those k
positions. A query with no relevant items has no recall denominator and is
counted separately.

A six-item fixture exercises exact distance ties and a missing category. To
also compare the initial and trained DeepCluster embeddings used by the
TensorFlow example, set `DM_DEEPCLUSTER_EVALUATION` to the
`output/models/deepcluster/evaluation.npz` file generated by that example.
The evaluation only uses its frozen descriptors and category labels.

```{cpp, results="markdown", file="figures/retrieval_evaluation.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

namespace n = dm::nn;
namespace m = n::models;

int main() {
  const std::vector<int> cutoffs{1, 3, 5};
  const std::vector<double> ranks{1, 3, 5};
  auto hits = dm::graphics::RPlot::create();
  hits.title("Any relevant result").x_label("Rank cutoff").y_label("Hit rate").y_limits(0, 1.05);
  auto recalls = dm::graphics::RPlot::create();
  recalls.title("Retrieved share of relevant items").x_label("Rank cutoff")
      .y_label("Macro item recall").y_limits(0, 1.05);

  std::filesystem::create_directories("build");
  std::print("| descriptors | eligible | no positives | k | hit rate | macro item recall |\n"
             "|---|---:|---:|---:|---:|---:|\n");
  const auto evaluate = [&](std::string name, const n::Tensor &gallery, const n::Tensor &queries,
                            const std::vector<int> &gallery_labels,
                            const std::vector<int> &query_labels, dm::graphics::RGBA color) {
    std::vector<std::int64_t> gallery_ids(gallery_labels.size()), query_ids(query_labels.size(), -1);
    std::iota(gallery_ids.begin(), gallery_ids.end(), 0);
    const m::TensorDescriptorIndex index(gallery, gallery_ids);
    const auto result = m::ScoreTensorRetrievalAtCutoffs(
        queries, query_labels, query_ids, index, gallery_labels, cutoffs);
    for (std::size_t i = 0; i < cutoffs.size(); ++i)
      std::print("| {} | {} | {} | {} | {:.6f} | {:.6f} |\n", name, result.eligible,
                 result.without_positive, cutoffs[i], result.hit_rate[i], result.item_recall[i]);
    hits.lines(ranks, result.hit_rate, name, color).points(ranks, result.hit_rate, name, color);
    recalls.lines(ranks, result.item_recall, name, color).points(ranks, result.item_recall, name, color);
    n::save_npz("build/retrieval_evaluation_" + name + ".npz",
                {{"gallery", gallery}, {"queries", queries}, {"gallery_labels", n::from_vector(gallery_labels)},
                 {"query_labels", n::from_vector(query_labels)}, {"hit_rate", n::from_vector(result.hit_rate)},
                 {"item_recall", n::from_vector(result.item_recall)}});
  };

  evaluate("fixture", n::tensor({-1., 1., -2., 2., 3., 4.}, {6, 1}),
           n::tensor({0., 3., 0.}, {3, 1}), {0, 1, 1, 0, 0, 1}, {1, 0, 2}, {100, 116, 139});
  if (const char *archive = std::getenv("DM_DEEPCLUSTER_EVALUATION")) {
    const auto entries = n::load_npz(archive);
    const std::map<std::string, n::Tensor> data(entries.begin(), entries.end());
    const auto gallery_labels = data.at("train_labels").to_vector<int>();
    const auto query_labels = data.at("labels").to_vector<int>();
    evaluate("initial", data.at("initial_training"), data.at("initial_test"), gallery_labels,
             query_labels, {185, 28, 28});
    evaluate("trained", data.at("training"), data.at("held_out"), gallery_labels, query_labels,
             {37, 99, 235});
  }

  auto figure = dm::graphics::RLayout::create(1, 2);
  figure.add(hits).add(recalls).size(1000, 425).fit_panels()
      .save_svg("build/retrieval_evaluation.svg");
}
```
