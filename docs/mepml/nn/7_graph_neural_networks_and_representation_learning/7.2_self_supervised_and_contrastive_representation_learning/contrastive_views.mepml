//? Title: Paired stochastic image views
//? Lang: en

> Paired stochastic image views

Each source is an 8 by 8 grayscale surface drawn from four polynomial
basis functions. Each augmentation selects a 6 by 6 crop and applies
a random gain and offset. The first half of the view matrix holds the
first crops and the second half holds the matching crops in the same
order. Thus row $i$ and row $i+B$ form a positive pair for a batch of
$B$ sources. Use independent random engines for training and evaluation
to keep held-out sources separate.

```{cpp, results="markdown", file="figures/contrastive_views.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

namespace n = dm::nn;

int main() {
  std::mt19937 rng(49803), repeat(49803);
  const auto data = n::synthetic_contrastive_views(rng);
  const auto replay = n::synthetic_contrastive_views(repeat);
  if (n::max(n::abs(data.views - replay.views)).item() != 0.)
    throw std::runtime_error("view generation must be reproducible");

  auto layout = dm::graphics::RLayout::create(1, 3);
  const auto panel = [&](const n::Tensor &pixels, int side, const std::string &title) {
    const auto axis = n::arange(0, side).to_vector<double>();
    auto plot = dm::graphics::RPlot::create();
    const auto matrix = pixels.reshape({side, side});
    std::vector<std::vector<double>> columns;
    for (int x = 0; x < side; ++x)
      columns.push_back(n::select(matrix, 1, x).to_vector<double>());
    plot.image(axis, axis, columns,
               dm::graphics::diverging_colors(33), -.9, .9).title(title)
        .x_label("Column").y_label("Row");
    layout.add(plot);
  };
  panel(n::select(data.images, 0, 0), 8, "Source image");
  panel(n::select(data.views, 0, 0), 6, "First view");
  panel(n::select(data.views, 0, 32), 6, "Second view");
  std::filesystem::create_directories("build");
  layout.size(990, 330).fit_panels().save_svg("build/contrastive_views.svg");
  n::save_npz("build/contrastive_views.npz", {{"images", data.images},
      {"views", data.views}, {"transform", data.transform}});
  std::print("Generated {} crops from {} sources. Replaying the seed reproduced every view.\n",
             data.views.shape()[0], data.images.shape()[0]);
}
```
// result_begin: markdown
Generated 64 crops from 32 sources. Replaying the seed reproduced every view.
