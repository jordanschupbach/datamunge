//? Title: Recurrent message passing on signed graphs
//? Lang: en

> Recurrent message passing on signed graphs

A message-passing network distinguishes clustered from alternating edge
signs on eight-node rings. All nodes have the same feature, and both
classes have four positive and four negative edges. The task requires
the model to use how the signs are arranged.

Two rounds share the same signed message transforms and GRU. Each round
sums separately transformed positive and negative neighbor features,
then updates each node from its old state and that aggregate. A sigmoid
gate sees both the initial and final state. The readout sums gated final
states to produce one prediction per graph.

```{cpp, results="markdown", file="figures/mpnn_fit.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

namespace n = dm::nn;

int main() {
  constexpr int nodes = 8, width = 8;
  const auto simulate = [](int count, std::mt19937 &rng) {
    std::vector<float> edges(count * nodes * nodes);
    std::vector<int> labels;
    for (int graph = 0; graph < count; ++graph) {
      const int label = graph % 2, phase = rng() % nodes;
      std::array<int, nodes> order;
      std::iota(order.begin(), order.end(), 0);
      std::shuffle(order.begin(), order.end(), rng);
      labels.push_back(label);
      for (int j = 0; j < nodes; ++j) {
        const int a = order[j], b = order[(j + 1) % nodes], offset = graph * nodes * nodes;
        const int index = (j + phase) % nodes;
        const bool positive = label == 0 ? index < nodes / 2 : index % 2 == 0;
        edges[offset + a * nodes + b] = edges[offset + b * nodes + a] = positive ? 1.f : -1.f;
      }
    }
    return std::array{n::from_vector(edges, {count, nodes, nodes}), n::ones({count, nodes, 1}),
                      n::from_vector(labels)};
  };
  std::mt19937 fit_rng(48602), test_rng(48603);
  std::vector<std::array<n::Tensor, 3>> fit;
  for (int i = 0; i < 8; ++i)
    fit.push_back(simulate(16, fit_rng));
  const auto [edges, input, labels] = simulate(64, test_rng);

  n::ParameterStore model(48601);
  const auto forward = [&](const n::Tensor &a, const n::Tensor &x) {
    const auto initial = n::dense(model, "input", x, width, n::Activation::Tanh);
    const auto [first, message0] = n::signed_graph_gru_step(model, "message", initial, a);
    const auto [second, message1] = n::signed_graph_gru_step(model, "message", first, a);
    const auto gate = n::sigmoid(n::dense(model, "gate", n::concat({initial, second}, 2), width));
    const auto values = n::dense(model, "readout", second, width, n::Activation::Tanh);
    const auto logits = n::dense(model, "head", n::sum(gate * values, {1}), 2);
    return std::array{message0, message1, first, second, logits};
  };
  const auto correct = [&](const n::Tensor &scores) {
    return n::count_nonzero(n::equal(n::argmax(scores, 1), labels)).item<int>();
  };
  forward(edges, input);
  n::OptimizerConfig config;
  config.kind = n::OptimizerKind::Adam;
  n::Optimizer adam(model, .025, config);
  std::vector<double> epochs, losses, accuracy;
  std::print("| epoch | held-out NLL | correct |\n|---:|---:|---:|\n");
  for (int epoch = 0; epoch <= 3; ++epoch) {
    {
      n::NoGradGuard guard;
      const auto scores = forward(edges, input)[4];
      const auto hits = correct(scores);
      epochs.push_back(epoch);
      losses.push_back(n::sparse_softmax_cross_entropy(scores, labels).item());
      accuracy.push_back(hits / 64.);
      std::print("| {} | {:.6f} | {}/64 |\n", epoch, losses.back(), hits);
    }
    if (epoch < 3)
      for (const auto &[a, x, y] : fit)
        adam.minimize(n::sparse_softmax_cross_entropy(forward(a, x)[4], y));
  }

  n::NoGradGuard guard;
  const auto [message0, message1, first, second, logits] = forward(edges, input);
  const auto unsigned_scores = forward(n::abs(edges), input)[4];
  const auto unsigned_error =
      n::max(n::abs(unsigned_scores - n::slice_axis(unsigned_scores, 0, 0, 1))).item();
  const auto order = n::from_vector(std::vector<int>{6, 1, 5, 3, 0, 4, 7, 2});
  const auto reordered = forward(n::gather(n::gather(edges, order, 1), order, 2),
                                 n::gather(input, order, 1))[4];
  const auto relabel_error = n::max(n::abs(reordered - logits)).item();
  if (std::max(unsigned_error, relabel_error) > 1e-5)
    throw std::runtime_error("MPNN relabeling or unsigned-graph control failed");
  const auto unsigned_hits = correct(unsigned_scores);
  std::print("All-positive edges: {}/64 correct, maximum logit difference across graphs {:.3g}.\n",
             unsigned_hits, unsigned_error);
  std::print("Maximum logit change under node permutation {:.3g}.\n", relabel_error);

  n::NamedTensors evidence{{"edges", edges}, {"input", input}, {"label", labels},
      {"aggregate0", message0}, {"aggregate1", message1}, {"state0", first}, {"state1", second},
      {"logits", logits}, {"unsigned_logits", unsigned_scores}, {"test_nll", n::from_vector(losses)}};
  for (const auto &key : model.names())
    evidence.emplace_back(key, model.at(key));
  std::filesystem::create_directories("build");
  n::save_npz("build/mpnn_fit.npz", evidence);

  auto loss = dm::graphics::RPlot::create();
  loss.lines(epochs, losses, "Held-out loss", {37, 99, 235})
      .title("Signed-ring classification").x_label("Epoch").y_label("Held-out NLL");
  auto score = dm::graphics::RPlot::create();
  score.bars({0., 1.}, {accuracy.back(), unsigned_hits / 64.}, "Held-out accuracy", {22, 120, 97})
      .title("Effect of removing edge signs").x_label("0 signed, 1 all-positive")
      .y_label("Fraction correct").y_limits(0, 1.05);
  dm::graphics::RLayout::create(1, 2).add(loss).add(score).size(1050, 430)
      .fit_panels().save_svg("build/mpnn_fit.svg");
}
```
