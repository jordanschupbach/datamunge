//? Title: Forecast with Informer sparse attention and encoder distillation
//? Exports: both
//? Lang: en

\abstract(
Train a compact Informer to forecast six steps from 24 observed values.
Inspect the active queries at both encoder resolutions.
)
\toc

Each encoder stage samples six keys per query and estimates which
queries have unusually strong matches. The four highest-scoring queries
attend to every key. The other queries use the mean value context.
A learned convolution followed by pairwise max pooling halves the
encoder length. The decoder uses causal self-attention and dense
cross-attention to issue all six predictions in one pass.
[Zhou et al., Informer|https://arxiv.org/abs/2012.07436]

The decoder receives six observed values followed by six zero
placeholders. Scaling uses the fitting prefix, and all forecast targets
remain in their chronological splits. The training run uses three Adam
epochs with the upstream batch order.

```{cpp, results="markdown", file="figures/informer_forecast.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <cmath>
#include <filesystem>
#include <numbers>
#include <numeric>
#include <print>
#include <stdexcept>
#include <string>
#include <vector>

int main() {
  namespace n = dm::nn;
  constexpr int lag = 24, horizon = 6, fit_end = 768, test_begin = 960, end = 1152;
  std::vector<double> samples(end);
  for (int t = 0; t < end; ++t) {
    const auto phase = 2 * std::numbers::pi * t;
    samples[t] = (1 + .12 * std::sin(phase / 192)) * std::sin(phase / 24)
                 + .35 * std::cos(phase / 12) + .2 * std::sin(phase / 73);
  }
  const auto series = n::from_vector(samples);
  const auto prefix = n::slice(series, {0}, {fit_end});
  const auto center = n::mean(prefix).item();
  const auto scale = n::sqrt(n::mean(n::square(prefix - center))).item();
  const auto normalize = [&](const n::Tensor& x) {
    return ((x - center) / scale).to(n::DType::Float32);
  };
  const auto normalized = normalize(series);
  const auto origins = [](int first, int last) {
    std::vector<std::int64_t> indices(last - horizon - first + 1);
    std::iota(indices.begin(), indices.end(), first);
    return indices;
  };
  const auto fit_indices = origins(lag, fit_end);
  const auto test_indices = origins(test_begin, end);
  const auto fit = n::ForecastWindows(normalized, fit_indices, lag, horizon);
  const auto val = n::ForecastWindows(normalized, origins(fit_end, test_begin), lag, horizon);
  const auto test = n::ForecastWindows(normalized, test_indices, lag, horizon);
  const auto first = n::ForecastWindows(normalized, {test_begin}, lag, horizon);
  auto shifted = samples;
  for (int t = test_begin; t < end; ++t) shifted[t] += 100;
  const auto changed = n::ForecastWindows(normalize(n::from_vector(shifted)), {test_begin}, lag, horizon);
  const auto baseline = n::forecast_baselines(series, test_indices, fit_end, 24, horizon, 6, 4);


  n::ParameterStore parameters;
  const auto model = [&](const n::Tensor& history) {
    return n::informer_forecast(parameters, "informer", history, horizon);
  };
  (void)model(first.history);
  parameters.load("fixtures/informer_init.npz", true);
  n::OptimizerConfig config;
  config.kind = n::OptimizerKind::Adam;
  n::Optimizer optimizer(parameters, .01, config);
  n::BatchOrder order(fit_indices.size(), 32, 41381);
  const auto in_units = [&](const n::Tensor& x) { return x.to(n::DType::Float64) * scale + center; };
  const auto rmse = [&](const n::Tensor& output) {
    return n::sqrt(n::mean(n::square(in_units(output) - baseline.actual))).item();
  };
  double initial;
  {
    n::NoGradGuard guard;
    initial = rmse(model(test.history).forecast);
  }
  for (int epoch = 0; epoch < 3; ++epoch) {
    order.begin_epoch();
    for (auto rows = order.next(); !rows.empty(); rows = order.next()) {
      const auto residual = model(n::take_rows(fit.history, rows)).forecast - n::take_rows(fit.target, rows);
      optimizer.step(n::grad(n::mean(n::square(residual)), parameters.parameters()));
    }
  }
  n::NoGradGuard guard;
  if (first.target.to_vector<float>() == changed.target.to_vector<float>() ||
      model(first.history).forecast.to_vector<float>() != model(changed.history).forecast.to_vector<float>())
    throw std::runtime_error("Unexpected fixed-origin perturbation result");
  const auto result = model(test.history);
  const auto val_mse = n::mean(n::square(model(val.history).forecast - val.target)).item() * scale * scale;
  std::println("The final validation MSE was {:.6f}. Test RMSE fell from {:.6f} to {:.6f} across {} origins.",
               val_mse, initial, rmse(result.forecast), test_indices.size());

  const std::string folder = "build/informer_forecast/";
  std::filesystem::create_directories(folder);
  std::filesystem::create_directories("figures");
  n::NamedTensors trace{{"input", test.history}, {"distill_input", result.distill_input},
      {"distilled", result.distilled}, {"seed", result.seed}, {"decoder_weights", result.decoder_weights}};
  const auto save_stage = [&](const std::string& prefix, const n::InformerSparseTrace& stage) {
    trace.emplace_back(prefix + "_q", stage.query);
    trace.emplace_back(prefix + "_k", stage.key);
    trace.emplace_back(prefix + "_v", stage.value);
    trace.emplace_back(prefix + "_sample", stage.sample);
    trace.emplace_back(prefix + "_selected", stage.selected);
    trace.emplace_back(prefix + "_mixed", stage.mixed);
  };
  save_stage("full", result.full);
  save_stage("short", result.compressed);
  n::save_npz(folder + "attention.npz", trace);
  n::save_npz(folder + "forecast.npz", {{"prediction", in_units(result.forecast)}, {"actual", baseline.actual}});

  const auto first_row = [](const n::Tensor& x) { return n::select(x, 0, 0).to_vector<double>(); };
  std::vector<double> leads(horizon);
  std::iota(leads.begin(), leads.end(), 1);
  auto queries = dm::graphics::RPlot::create();
  const auto show_selected = [&](const n::InformerSparseTrace& stage, const std::string& label,
                                 dm::graphics::RGB color, double offset, double stride) {
    auto positions = first_row(stage.selected);
    for (auto& position : positions) position = 1 + stride * position;
    queries.points(positions, std::vector<double>(positions.size(), offset), label, color, 5);
  };
  show_selected(result.full, "Full encoder", {37,99,235}, 1, 1);
  show_selected(result.compressed, "Distilled encoder", {191,88,34}, 2, 2);
  queries.title("Queries receiving full attention at origin 960")
      .x_label("Position on the original history grid").y_label("Encoder stage");
  auto forecast = dm::graphics::RPlot::create();
  forecast.lines(leads, first_row(baseline.actual), "Observed", {30,41,59}, 2)
      .lines(leads, first_row(in_units(result.forecast)), "Informer", {37,99,235})
      .title("Forecast at origin 960").x_label("Lead").y_label("Level");
  auto layout = dm::graphics::RLayout::create(1, 2).size(1050, 410);
  layout.add(queries).add(forecast).save_svg(folder + "forecast.svg");
  std::filesystem::copy_file(folder + "forecast.svg", "figures/informer_forecast.svg",
                             std::filesystem::copy_options::overwrite_existing);
}
```
// result_begin: markdown
The final validation MSE was 0.164012. Test RMSE fell from 2.802178 to 0.407892 across 187 origins.
\image(figures/informer_forecast.svg)
// result_end

The query plot places each distilled token at the first sample of its
pooling pair. The fitted forecast uses the original data scale.

The fitted Datamunge model reached a test RMSE of 0.407892. The
upstream TensorFlow fit reached 0.426594, with different active
queries after training. Seasonal naive scored 0.253051 on these same
origins.
