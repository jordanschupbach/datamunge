The three-epoch budget, parameter seed4603, batch-order seed4621, batch size32
and Adam learning rate0.003 follow the original executable. All199 warm users
appear once per epoch, giving21 updates. This is a bounded teaching experiment,
not an official MovieLens benchmark or a cold-start recommendation system.

> A six-entry calculation before fitting

Only entries0,2,4 are observed. Their squared errors sum to0.18, so the loss is
0.06. Changing every hidden target to1000 leaves the result exactly unchanged;
all three hidden output derivatives are exactly zero. Dividing by all six entries
would halve the objective and silently change the optimization problem.

```{cpp, results="markdown", file="figures/autorec_mask.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
  std::filesystem::create_directories("build");
  namespace n = dm::nn;
  namespace m = n::models;
  auto prediction =
      n::from_vector(std::vector<float>{.2f, .3f, .4f, .5f, .6f, .7f}, {2, 3}).requires_grad_();
  const auto target   = n::from_vector(std::vector<float>{.1f, .9f, .5f, .7f, .2f, .8f}, {2, 3}),
             mask     = n::from_vector(std::vector<float>{1, 0, 1, 0, 1, 0}, {2, 3});
  const auto changed  = n::where(n::equal(mask, 1.), target, 1000.);
  const auto loss     = m::ObservedRatingMse(prediction, target, mask),
             altered  = m::ObservedRatingMse(prediction, changed, mask);
  const auto gradient = n::grad(loss, {prediction})[0];
  if (std::abs(loss.item() - .06) > 2e-8 || loss.item() != altered.item() ||
      n::sum(n::abs(gradient) * (1. - mask)).item() != 0)
    return 1;
  n::save_npz("build/autorec_mask_algebra.npz",{{"prediction",prediction.detach()},{"target",target},{"mask",mask},{"changed_target",changed},{"loss",loss.detach()},{"changed_loss",altered.detach()},{"gradient",gradient}});
  std::print(
      "Observed-only MSE {:.8f}; hidden-target change {:.1f}.\n| entry | observed | gradient "
      "|\n|---:|---:|---:|\n",
      loss.item(),
      altered.item() - loss.item());
  for (int i = 0; i < 6; ++i)
    std::print(
        "| {} | {} | {:.8f} |\n",
        i,
        mask.reshape({6}).to_vector<float>()[i],
        gradient.reshape({6}).to_vector<float>()[i]);
  auto a = dm::graphics::RPlot::create();
  a.bars(
       {0, 1, 2, 3, 4, 5},
       gradient.reshape({6}).to_vector<double>(),
       "observed derivative",
       {37, 99, 235})
      .title("Hidden targets have exactly zero derivative")
      .x_label("entry index")
      .y_label("d observed MSE / d prediction");
  a.save_svg("build/autorec_mask.svg");
}
```
