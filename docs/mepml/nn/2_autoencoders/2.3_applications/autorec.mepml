> Visible three-epoch fitting and fresh deployment

Each minibatch performs native forward inference, observed-only reconstruction,
explicit weight-only L2, gradients and one Adam step. The best raw validation
RMSE selects the checkpoint; test ratings do not choose an epoch. The fresh store
restores model arrays only. Repeated inference, single/batch agreement and parameter
immutability are checked before held-out scoring. Restoring this checkpoint does
not resume the optimizer state.

The complete program below also fits global, user-shrink10 and item-shrink10
references from fitting observations alone. Raw outputs are multiplied by five
for star-valued metrics. Clipping to1..5 is a separate metric-only comparison.
Saved arrays retain unconstrained values and every hidden/observed mask.

```{cpp, results="markdown", file="figures/autorec_training.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
namespace n = dm::nn;
namespace m = n::models;
int main() {
  std::filesystem::create_directories("build");
  n::set_num_threads(2);
  std::filesystem::create_directories("build");
  const auto root = dm::datasets::prepare_example_data("autorec");
  const auto data = m::LoadAutoRec(root);
  n::save_npz(
      "build/autorec_data.npz",
      {{"input", data.input},
       {"ratings", data.ratings},
       {"train_mask", data.train},
       {"validation_mask", data.validation},
       {"test_mask", data.test},
       {"user_ids", data.users},
       {"item_ids", data.items}});
  n::ParameterStore parameters(4603);
  {
    n::NoGradGuard guard;
    m::AutoRec(parameters, n::zeros({1, 256}));
  }
  auto arrays = [&]() {
    n::NamedTensors a;
    for (std::size_t i = 0; i < parameters.size(); ++i)
      a.push_back({parameters.names()[i], parameters.parameters()[i].detach().clone()});
    return a;
  };
  n::save_npz("build/autorec_initial_arrays.npz", arrays());
  n::OptimizerConfig config;
  config.kind = n::OptimizerKind::Adam;
  n::Optimizer        optimizer(parameters, .003, config);
  n::BatchOrder       order(199, 32, 4621);
  int                 steps = 0, selected = 0;
  double              best = INFINITY;
  std::vector<double> epochs, training, validation, validation_mae;
  std::print(
      "| epoch | train raw RMSE | validation raw RMSE | validation raw MAE "
      "|\n|---:|---:|---:|---:|\n");
  for (int epoch = 1; epoch <= 3; ++epoch) {
    order.begin_epoch();
    int seen = 0;
    for (;;) {
      const auto rows = order.next();
      if (rows.empty())
        break;
      seen += int(rows.size());
      const auto x = n::take_rows(data.input, rows), mask = n::take_rows(data.train, rows);
      const auto out         = m::AutoRec(parameters, x);
      const auto observed    = m::ObservedRatingMse(out.prediction, x, mask);
      const auto regularizer = .00005 * (n::sum(n::square(parameters.at("encoder/W"))) +
                                         n::sum(n::square(parameters.at("decoder/W"))));
      const auto objective   = observed + regularizer;
      const auto gradients   = n::grad(objective, parameters.parameters());
      for (const auto& g : gradients)
        if (!n::all(n::is_finite(g)).item<bool>() || n::sum(n::abs(g)).item() == 0)
          return 1;
      if (steps == 0) {
        n::save_npz("build/autorec_first_batch.npz", {{"input", x}, {"mask", mask}});
        n::save_npz(
            "build/autorec_first_forward.npz",
            {{"code", out.code},
             {"prediction", out.prediction},
             {"observed_mse", observed},
             {"regularizer", regularizer},
             {"loss", objective}});
        n::NamedTensors saved;
        for (std::size_t j = 0; j < gradients.size(); ++j)
          saved.push_back({parameters.names()[j], gradients[j]});
        n::save_npz("build/autorec_first_gradients.npz", saved);
      }
      optimizer.step(gradients);
      if (steps == 0)
        n::save_npz("build/autorec_first_update_arrays.npz", arrays());
      ++steps;
    }
    if (seen != 199)
      return 1;
    n::NoGradGuard guard;
    const auto     prediction =
        m::AutoRec(parameters, data.input).prediction.to(n::DType::Float64) * 5.;
    const auto fit    = m::RatingErrors(prediction, data.ratings, data.train),
               val    = m::RatingErrors(prediction, data.ratings, data.validation);
    const double rmse = n::select(val, 0, 0).item();
    epochs.push_back(epoch);
    training.push_back(n::select(fit, 0, 0).item());
    validation.push_back(rmse);
    validation_mae.push_back(n::select(val, 0, 1).item());
    n::save_npz("build/autorec_epoch" + std::to_string(epoch) + "_arrays.npz", arrays());
    if (rmse < best) {
      best     = rmse;
      selected = epoch;
      parameters.save("build/autorec_best.npz");
    }
    std::print(
        "| {} | {:.9f} | {:.9f} | {:.9f} |\n", epoch, training.back(), rmse, validation_mae.back());
  }
  n::ParameterStore deployed(4603);
  {
    n::NoGradGuard guard;
    m::AutoRec(deployed, n::zeros({1, 256}));
  }
  deployed.load("build/autorec_best.npz");
  const auto     before = deployed.flatten();
  n::NoGradGuard guard;
  const auto     out = m::AutoRec(deployed, data.input), repeat = m::AutoRec(deployed, data.input);
  const auto     one = m::AutoRec(deployed, n::take_rows(data.input, {0}));
  if (n::max(n::abs(out.prediction - repeat.prediction)).item() != 0 ||
      before != deployed.flatten() ||
      n::max(n::abs(one.prediction - n::slice_axis(out.prediction, 0, 0, 1))).item() > 2e-6)
    return 1;
  const auto stars = out.prediction.to(n::DType::Float64) * 5.;
  if (std::abs(
          n::select(m::RatingErrors(stars, data.ratings, data.validation), 0, 0).item() - best) >
      1e-9)
    return 1;
  const auto target = data.ratings.to(n::DType::Float64), mask = data.train.to(n::DType::Float64);
  const auto global = n::sum(target * mask) / n::sum(mask);
  const auto user =
      (n::sum(target * mask, {1}, true) + 10. * global) / (n::sum(mask, {1}, true) + 10.);
  const auto item =
      (n::sum(target * mask, {0}, true) + 10. * global) / (n::sum(mask, {0}, true) + 10.);
  const auto global_values = n::ones_like(target) * global,
             user_values = n::ones_like(target) * user, item_values = n::ones_like(target) * item;
  std::vector<double> rmses, maes;
  std::print(
      "Selected epoch{},{} explicit updates; immutable fresh deployment.\n| predictor | test RMSE "
      "| test MAE |\n|---|---:|---:|\n",
      selected,
      steps);
  for (const auto& [name, pred] : std::vector<std::pair<std::string, n::Tensor>>{
           {"raw AutoRec", stars},
           {"clipped AutoRec", n::clip(stars, 1., 5.)},
           {"fit global", global_values},
           {"fit user shrink10", user_values},
           {"fit item shrink10", item_values}}) {
    const auto score  = m::RatingErrors(pred, target, data.test);
    const auto values = score.to_vector<double>();
    rmses.push_back(values[0]);
    maes.push_back(values[1]);
    std::print("| {} | {:.9f} | {:.9f} |\n", name, values[0], values[1]);
  }
  n::save_npz(
      "build/autorec_outputs.npz",
      {{"prediction", out.prediction},
       {"code", out.code},
       {"ratings", data.ratings},
       {"train_mask", data.train},
       {"validation_mask", data.validation},
       {"test_mask", data.test},
       {"global_baseline", global_values},
       {"user_baseline", user_values},
       {"item_baseline", item_values},
       {"test_rmse", n::from_vector(rmses)},
       {"test_mae", n::from_vector(maes)}});
  n::save_npz("build/autorec_model_arrays.npz", [&]() {
    n::NamedTensors a;
    for (std::size_t i = 0; i < deployed.size(); ++i)
      a.push_back({deployed.names()[i], deployed.parameters()[i]});
    return a;
  }());
  auto a = dm::graphics::RPlot::create(), b = dm::graphics::RPlot::create();
  a.lines(epochs, training, "fitting", {37, 99, 235})
      .lines(epochs, validation, "validation", {220, 38, 38})
      .title("Three explicit epochs; validation selects model")
      .x_label("epoch")
      .y_label("raw star RMSE");
  b.bars({0, 1, 2, 3, 4}, rmses, "held-out RMSE", {37, 99, 235})
      .title("Full898 withheld ratings")
      .x_label("0 raw,1 clipped,2 global,3 user,4 item")
      .y_label("RMSE in stars");
  auto layout = dm::graphics::RLayout::create(1, 2);
  layout.add(a).add(b).size(1200, 500).fit_panels().save_svg("build/autorec_training.svg");
  const auto truth = n::slice_axis(target, 0, 0, 24), pred = n::slice_axis(stars, 0, 0, 24);
  auto       heat = n::plot_tensor_map(pred, 1, 5);
  heat.title("Raw predictions; display scale1..5")
      .x_label("original item1..256")
      .y_label("first24 warm users");
  heat.save_svg("build/autorec_predictions.svg");
  std::print(
      "The heatmap display range does not clamp saved predictions or raw metrics.\n| user | item | "
      "held-out stars | raw prediction | item reference |\n|---:|---:|---:|---:|---:|\n");
  const auto heldout = data.test.to_vector<float>(), ratings = data.ratings.to_vector<float>();
  const auto predictions = stars.to_vector<double>(), baseline = item_values.to_vector<double>();
  const auto ids   = data.users.to_vector<int>();
  int        shown = 0;
  for (int u = 0; u < 199 && shown < 16; ++u)
    for (int i = 0; i < 256 && shown < 16; ++i)
      if (heldout[u * 256 + i]) {
        std::print(
            "| {} | {} | {} | {:.9f} | {:.9f} |\n",
            ids[u],
            i + 1,
            ratings[u * 256 + i],
            predictions[u * 256 + i],
            baseline[u * 256 + i]);
        ++shown;
      }
  std::filesystem::copy_file("build/autorec_training.svg","build/export_autorec_training.svg",std::filesystem::copy_options::overwrite_existing);
}
