//? Title: Listen, Attend and Spell on spoken digit pairs
//? Lang: en

> Listen, Attend and Spell

Two bidirectional LSTM layers encode log-mel frames. Stacking adjacent
outputs between the layers halves the time resolution. An additive
attention mechanism uses the decoder state to assign a probability to
each listener frame and form a weighted acoustic context.

The decoder starts with a beginning-of-sequence token and scores two
digits and an end-of-sequence token. Teacher forcing feeds the reference
digits back during training. In free-running inference, each greedy
prediction becomes the next input, so an early error can affect later
steps. The plot shows the attention weights for one held-out recording.

Prepare the spoken-digit fixture with `python3 scripts/prepare_xvector.py`
in the TensorFlow examples checkout. For another checkout location, set
`DATAMUNGE_XVECTOR_DIR` to its prepared dataset directory.

```{cpp, results="markdown", file="figures/listen_attend_spell.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

int main() {
  namespace n = dm::nn;
  constexpr int clip = 3200, length = 6800;
  const auto* configured = std::getenv("DATAMUNGE_XVECTOR_DIR");
  const auto* home = std::getenv("HOME");
  if (!configured && !home) throw std::runtime_error("Set DATAMUNGE_XVECTOR_DIR");
  const auto root = configured ? std::filesystem::path(configured)
      : std::filesystem::path(home)/"projects/tflow_examples/output/datasets/xvector";
  const auto mel = n::linear_to_mel_weight_matrix(24,129,8000,60,3800);
  const auto read = [&](const char* role, int count, int per_digit, int speakers, unsigned seed) {
    const auto arrays = n::load_npz((root/(std::string(role)+".npz")).string());
    const auto entry = std::ranges::find(arrays,"waveform",&n::NamedTensors::value_type::first);
    if (entry == arrays.end() || entry->second.shape() != n::Shape{speakers*10*per_digit,clip})
      throw std::runtime_error("Unexpected spoken-digit fixture shape");
    const auto wave = entry->second.to_vector<float>();
    std::vector<float> joined(count*length);
    std::vector<std::int32_t> labels(count*2);
    std::mt19937 rng(seed);
    for (int row=0; row<count; ++row) {
      const int speaker = rng()%speakers;
      for (int segment=0; segment<2; ++segment) {
        const int digit = rng()%10;
        labels[2*row+segment] = digit;
        const auto source = (speaker*10+digit)*per_digit+rng()%per_digit;
        std::copy_n(wave.begin()+source*clip,clip,joined.begin()+row*length+segment*(length-clip));
      }
    }
    const auto power = n::power_spectrogram(n::stft(n::from_vector(joined,{count,length}),200,240,256));
    return std::pair{n::log_mel_spectrogram(power,mel),n::from_vector(labels,{count,2})};
  };
  const auto [fit,target] = read("fit",768,6,4,61721);
  const auto [test,truth] = read("verify",192,3,2,61722);
  n::ParameterStore model(41380);
  const auto with_end=[](const n::Tensor& digits) {
    return n::concat({digits.to(n::DType::Int64),n::full({digits.size(0),1},10,n::DType::Int64)},1);
  };
  const auto targets=with_end(target), labels=with_end(truth);
  const auto loss=[](const n::Tensor& logits,const n::Tensor& tokens) {
    return n::sparse_softmax_cross_entropy(logits.reshape({-1,11}),tokens.reshape({-1}));
  };
  const auto initial=loss(n::listen_attend_spell(model,test,truth).logits,labels).item();
  n::Optimizer optimizer(model,.01,{.kind=n::OptimizerKind::Adam});
  n::BatchOrder order(768,24,61723);
  for (int epoch=0;epoch<3;++epoch) {
    order.begin_epoch();
    for (auto rows=order.next();!rows.empty();rows=order.next()) {
      const auto out=n::listen_attend_spell(model,n::take_rows(fit,rows),n::take_rows(target,rows));
      optimizer.minimize(loss(out.logits,n::take_rows(targets,rows)));
    }
  }
  n::NoGradGuard guard;
  const auto greedy=n::listen_attend_spell(model,test);
  const auto forced=n::listen_attend_spell(model,test,truth);
  const auto final_loss=loss(forced.logits,labels);
  const auto prediction=n::argmax(greedy.logits).to_vector<int>();
  const auto actual=labels.to_vector<int>(), feedback=greedy.feedback.to_vector<int>();
  int exact=0;
  for (std::int64_t row=0;row<test.size(0);++row) {
    const auto at=3*row;
    if (feedback[at]!=11 || feedback[at+1]!=prediction[at] ||
        feedback[at+2]!=prediction[at+1]) return 1;
    exact+=std::equal(prediction.begin()+at,prediction.begin()+at+3,actual.begin()+at);
  }
  if (!(final_loss.item()<initial) ||
      n::max(n::abs(n::sum(greedy.attention,{2})-1)).item()>1e-5) return 1;
  std::print("Teacher-forced test loss {:.4f} → {:.4f}. Free-running exact transcripts {}/{}.\n",
      initial,final_loss.item(),exact,test.size(0));
  auto plot=dm::graphics::RPlot::create();
  std::vector<double> frames(greedy.attention.size(2));
  std::iota(frames.begin(),frames.end(),0.);
  const std::array<dm::graphics::RGB,3> colors{{{37,99,235},{234,88,12},{22,163,74}}};
  const auto example=n::select(greedy.attention,0,0);
  for (int step=0;step<3;++step)
    plot.lines(frames,n::select(example,0,step).to_vector<double>(),
        std::format("Step {} (token {})",step+1,prediction[step]),colors[step]);
  plot.title("Free-running attention on a held-out utterance").x_label("Listener frame")
      .y_label("Attention probability").y_limits(0,1);
  std::filesystem::create_directories("build");
  plot.size(900,430).save_svg("build/listen_attend_spell.svg");
  n::save_npz("build/listen_attend_spell.npz",{{"target",labels},{"score",greedy.logits},
      {"feedback",greedy.feedback},{"weights",greedy.attention},{"teacher",forced.logits},{"loss",final_loss}});
}
```
// result_begin: markdown
Teacher-forced test loss 2.3946 → 1.0773. Free-running exact transcripts 39/192.
