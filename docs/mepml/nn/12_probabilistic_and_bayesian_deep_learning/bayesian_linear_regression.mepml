\alttext(Noisy observations enter three Gaussian regressions. Their evidences weight the predictive moments.)

> Fit and predict

Generate 32 observations at equally spaced inputs in [-1,1] with Gaussian
noise variance .0324. Compare degrees 1, 2 and 5 under unit prior variance
and equal prior model probabilities. The 61 query points extend to [-1.2,1.2].
The seeded normal generator follows the source example's C++ standard-library
draws. The bands show the mixture mean plus or minus 1.96 mixture standard
deviations. They summarize moments of a Gaussian mixture.

```{cpp, results="markdown", file="figures/bayesian_linear_regression_fit.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

int main() {
  namespace n = dm::nn;
  constexpr double noise_variance = .0324;
  const auto design = [](int rows, int width, double edge) {
    std::vector<double> columns;
    for (int i = 0; i < rows; ++i) {
      const double x = -edge + 2. * edge * i / (rows - 1);
      double power = 1.;
      for (int j = 0; j < width; ++j) {
        columns.push_back(power);
        power *= x;
      }
    }
    return n::from_vector(columns, {rows, width});
  };
  const auto x = n::linspace(-1., 1., 32, n::DType::Float64);
  const auto grid = n::linspace(-1.2, 1.2, 61, n::DType::Float64);
  std::mt19937 generator(120781);
  std::normal_distribution<double> normal(0., std::sqrt(noise_variance));
  std::vector<double> observations;
  for (double t : x.to_vector<double>())
    observations.push_back(.2 + .55 * t - 1.25 * t * t + normal(generator));
  const auto y = n::from_vector(observations, {32, 1});
  std::vector<double> degrees, evidence;
  std::vector<n::Tensor> means, variances;
  n::NamedTensors receipt{{"y", y}};
  for (int width : {2, 3, 6}) {
    const auto train = design(32, width, 1.);
    const auto query = design(61, width, 1.2);
    const auto fit = n::ml::FitBayesianLinear(train, y, noise_variance);
    const auto prediction = n::ml::PredictBayesianLinear(fit, query);
    const std::string tag = std::to_string(width);
    degrees.push_back(width - 1);
    evidence.push_back(fit.log_evidence);
    means.push_back(prediction.mean);
    variances.push_back(prediction.variance);
    receipt.insert(receipt.end(), {{"design_" + tag, train}, {"query_" + tag, query},
        {"weights_" + tag, fit.mean}, {"covariance_" + tag, fit.covariance},
        {"mean_" + tag, prediction.mean.reshape({61, 1})}, {"variance_" + tag, prediction.variance}});
  }

  const auto weights = n::softmax(n::from_vector(evidence));
  const auto w = weights.reshape({3, 1});
  const auto m = n::stack(means, 0);
  const auto average = n::sum(w * m, {0});
  const auto variance = n::sum(w * (n::stack(variances, 0) + n::square(m - average)), {0});
  if (weights.at({1}) < .9 || std::abs(n::sum(weights).item() - 1.) > 1e-12 ||
      n::min(variance).item() < noise_variance)
    throw std::runtime_error("Unexpected evidence or mixture moments");
  receipt.insert(receipt.end(), {{"log_evidence", n::from_vector(evidence)},
      {"model_probability", weights}, {"mixture_mean_variance", n::stack({average, variance}, 1)}});

  const auto grid_values = grid.to_vector<double>();
  const auto margin = 1.96 * n::sqrt(variance);
  auto lower = (average - margin).to_vector<double>(), upper = (average + margin).to_vector<double>();
  auto band_x = grid_values;
  band_x.insert(band_x.end(), grid_values.rbegin(), grid_values.rend());
  lower.insert(lower.end(), upper.rbegin(), upper.rend());
  auto predictions = dm::graphics::RPlot::create();
  predictions.polygon(band_x, lower, dm::RGBA{37, 99, 235, .16})
      .lines(grid_values, means[0].to_vector<double>(), "degree 1", {156, 163, 175})
      .lines(grid_values, means[1].to_vector<double>(), "degree 2", {15, 118, 110})
      .lines(grid_values, means[2].to_vector<double>(), "degree 5", {194, 65, 12})
      .lines(grid_values, average.to_vector<double>(), "model average", {37, 99, 235})
      .points(x.to_vector<double>(), observations, "fitting data", {17, 24, 39})
      .title("Posterior predictive means and the mixture moment band")
      .x_label("x").y_label("response");
  auto probabilities = dm::graphics::RPlot::create();
  probabilities.bars(degrees, weights.to_vector<double>(), "posterior", {15, 118, 110})
      .title("Posterior mass by degree").x_label("degree").y_label("probability")
      .y_limits(0, 1);
  std::filesystem::create_directories("build");
  dm::graphics::RLayout::create(1, 2).add(predictions).add(probabilities).fit_panels()
      .size(1200, 470).save_svg("build/bayesian_linear_regression_fit.svg");
  n::save_npz("build/bayesian_linear_regression_posterior.npz", receipt);

  dm::dstruct::DataFrame comparison;
  comparison.add_column("degree", degrees);
  comparison.add_column("log_evidence", evidence);
  comparison.add_column("posterior_probability", weights.to_vector<double>());
  std::print("{}", comparison.to_md(8));
}
```
