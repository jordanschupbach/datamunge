A position- and row-coded fixture checks that each transformed image is a crop and
optional horizontal flip of its own source row. The selected labels follow the same row order.

```{cpp, results="markdown", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)", id=chunk-05, cache=yes}
#include <dm/dm.hpp>

int main() {
  namespace n = dm::nn;
  constexpr int height = 32, width = 32, channels = 3;
  std::vector<float> pixels;
  for (int row = 0; row < 4; ++row)
    for (int y = 0; y < height; ++y)
      for (int x = 0; x < width; ++x)
        for (int c = 0; c < channels; ++c)
          pixels.push_back(float(1 + 3072 * row + 96 * y + 3 * x + c) / 12288);
  const auto images = n::from_vector(pixels, {4, height, width, channels});
  const auto labels = n::from_vector(std::vector<std::int64_t>{2, 7, 1, 4}, {4});
  const std::vector<std::int64_t> order{1, 3, 0, 2};
  const auto ordered = n::take_rows(images, order);
  n::Generator first(151), repeat(151);
  const auto transformed = n::study::augment_cifar10(ordered, first);
  const auto reproduced = n::study::augment_cifar10(ordered, repeat);
  if (n::max(n::abs(transformed - reproduced)).item() != 0 ||
      n::take_rows(labels, order).to_vector<std::int64_t>() !=
          std::vector<std::int64_t>{7, 4, 2, 1})
    throw std::runtime_error("Augmentation was not reproducible with paired rows");
  const auto normalized = (2 * transformed - 1).to_vector<float>();
  const auto expected = (2 * ordered - 1).to_vector<float>();
  const auto pixel = [](int y, int x, int c) { return (y * width + x) * channels + c; };
  std::set<std::tuple<int, int, bool>> transforms;
  for (int row = 0; row < 4; ++row) {
    int matches = 0;
    for (int dy = -4; dy <= 4; ++dy)
      for (int dx = -4; dx <= 4; ++dx)
        for (bool flip : {false, true}) {
          bool match = true;
          for (int y = 0; y < height && match; ++y)
            for (int x = 0; x < width && match; ++x) {
              const int sy = y + dy;
              const int sx = (flip ? width - 1 - x : x) + dx;
              for (int c = 0; c < channels && match; ++c) {
                const float value = sy < 0 || sy >= height || sx < 0 || sx >= width
                    ? -1.f : expected[row * 3072 + pixel(sy, sx, c)];
                match = normalized[row * 3072 + pixel(y, x, c)] == value;
              }
            }
          if (match) {
            ++matches;
            transforms.emplace(dy, dx, flip);
          }
        }
    if (matches != 1)
      throw std::runtime_error("Image does not match one padded crop and flip of its source row");
  }
  if (transforms.size() < 2 || std::ranges::find(normalized, -1.f) == normalized.end())
    throw std::runtime_error("Expected independent transforms and normalized black padding");
  std::println("Verified {} distinct crop/flip transformations on four paired RGB rows.",
               transforms.size());
}
```
// result_begin: markdown
Verified 4 distinct crop/flip transformations on four paired RGB rows.
// result_end

```{cpp, results="markdown", file="figures/cnn_cifar10_training.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

int main() {
  namespace n = dm::nn;
  n::set_num_threads(2);

  std::filesystem::path cache;
  if (const auto *p = std::getenv("DATAMUNGE_DATA_DIR"))
    cache = p;
  else if (const auto *p = std::getenv("XDG_CACHE_HOME"))
    cache = std::filesystem::path(p) / "datamunge/datasets";
  else
    cache = std::filesystem::path(std::getenv("HOME")) / ".cache/datamunge/datasets";

  dm::datasets::fetch("cifar10", (cache / "cifar10").string());
  const auto data = n::split_image_holdout(
      n::load_cifar10((cache / "cifar10").string(), "train"), 5000, 2026);
  if (data.fit.images.shape() != n::Shape{45000, 32, 32, 3})
    throw std::runtime_error("Expected all CIFAR-10 development rows");

  n::ParameterStore p(17);
  auto logits = [&](const n::Tensor &input) {
    n::ConvLayerOptions options;
    options.activation = n::Activation::Relu;
    const auto first = n::max_pool2d(n::conv2d(p, "conv1", input, 32, 3, options), 2, 2);
    const auto second = n::max_pool2d(n::conv2d(p, "conv2", first, 64, 3, options), 2, 2);
    const auto hidden =
        n::dense(p, "dense", second.reshape({-1, 8 * 8 * 64}), 128, n::Activation::Relu);
    return n::dense(p, "output", hidden, 10);
  };
  {
    n::NoGradGuard guard;
    (void)logits(n::zeros({1, 32, 32, 3}));
  }
  n::OptimizerConfig config;
  config.kind = n::OptimizerKind::Adam;
  n::Optimizer optimizer(p, .001, config);
  n::Generator augmentation(151);
  n::BatchOrder batches(45000, 128, 29);
  std::filesystem::create_directories("build");
  const std::string checkpoint = "build/cnn_cifar10_best.npz";
  double best = std::numeric_limits<double>::infinity();
  std::vector<double> epoch, training_nll, validation_nll;
  auto validation_loss = [&] {
    n::NoGradGuard guard;
    n::WeightedMean mean;
    for (std::int64_t start = 0; start < data.validation.images.size(0); start += 512) {
      const auto end = std::min(start + 512, data.validation.images.size(0));
      const auto values = logits(2 * n::slice_axis(data.validation.images, 0, start, end) - 1);
      const auto labels = n::slice_axis(data.validation.labels, 0, start, end);
      mean.add(n::sparse_softmax_cross_entropy(values, labels).item(), end - start);
    }
    return mean.value();
  };
  for (int e = 0; e < 10; ++e) {
    batches.begin_epoch();
    n::WeightedMean average;
    for (auto rows = batches.next(); !rows.empty(); rows = batches.next()) {
      const auto raw = n::take_rows(data.fit.images, rows);
      const auto input = 2 * n::study::augment_cifar10(raw, augmentation) - 1;
      const auto nll =
          n::sparse_softmax_cross_entropy(logits(input), n::take_rows(data.fit.labels, rows));
      auto loss = nll;
      for (const auto &weight : p.parameters())
        if (weight.dim() >= 2)
          loss = loss + .00005 * n::sum(n::square(weight));
      optimizer.minimize(loss);
      average.add(nll.item(), rows.size());
    }
    if (average.count() != 45000)
      throw std::runtime_error("Incomplete fitting epoch");
    const double val = validation_loss();
    epoch.push_back(e + 1);
    training_nll.push_back(average.value());
    validation_nll.push_back(val);
    if (val < best) {
      best = val;
      p.save(checkpoint);
    }
  }
  p.load(checkpoint);
  n::NoGradGuard guard;
  const double restored = validation_loss();
  if (!std::isfinite(restored) || std::abs(restored - best) > 1e-7)
    throw std::runtime_error("Restored validation loss differs");
  const auto official = n::load_cifar10((cache / "cifar10").string(), "test");
  if (official.images.shape() != n::Shape{10000, 32, 32, 3} || p.count() != 545098)
    throw std::runtime_error("Unexpected CIFAR-10 test size or parameter count");
  std::vector<n::Tensor> test_logits;
  for (int start = 0; start < 10000; start += 512)
    test_logits.push_back(
        logits(2 * n::slice_axis(official.images, 0, start, std::min(start + 512, 10000)) - 1));
  const auto z = n::concat(test_logits, 0), test_y = official.labels;
  n::ConfusionMatrix cm(10);
  cm.add(test_y, n::argmax(z, 1));
  cm.save_svg("build/cnn_cifar10_confusion.svg",
              {.title = "CIFAR-10 CNN on all official CIFAR-10 test images"});
  n::save_npz("build/cnn_cifar10_confusion.npz",
              {{"truth", test_y}, {"logits", z}, {"counts", cm.to_tensor()}});
  const double test_nll = n::sparse_softmax_cross_entropy(z, test_y).item(),
               accuracy = n::accuracy(z, test_y);
  if (!std::isfinite(test_nll) || accuracy < .55 || training_nll.back() >= training_nll.front())
    throw std::runtime_error(
        std::format("CIFAR-10 CNN held-out accuracy {:.5f}, NLL {:.5f}", accuracy, test_nll));
  auto plot = dm::graphics::RPlot::create();
  plot.lines(epoch, training_nll, "training", {37, 99, 235})
      .lines(epoch, validation_nll, "validation", {234, 88, 12})
      .title("Full CIFAR-10 CNN training and validation")
      .x_label("epoch")
      .y_label("mean NLL");
  std::filesystem::create_directories("build");
  plot.size(850, 420).save_svg("build/cnn_cifar10_training.svg");
  std::print(
      "45000 fitted rows; 5000 validation rows; 10000 official-test rows; {} parameters; {} Adam "
      "steps.\n\nSelected validation NLL {:.6f}; test NLL {:.6f}; test accuracy {:.6f}.\n",
      p.count(), optimizer.iterations(), best, test_nll, accuracy);
}
```
