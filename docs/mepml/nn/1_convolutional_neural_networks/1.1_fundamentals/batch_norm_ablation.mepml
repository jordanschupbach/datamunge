```{cpp, results="markdown", file="figures/batch_norm_ablation_pairs.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

int main() {
  namespace n = dm::nn;
  n::set_num_threads(2);

  std::filesystem::path cache;
  if (const auto *p = std::getenv("DATAMUNGE_DATA_DIR"))
    cache = p;
  else if (const auto *p = std::getenv("XDG_CACHE_HOME"))
    cache = std::filesystem::path(p) / "datamunge/datasets";
  else
    cache = std::filesystem::path(std::getenv("HOME")) / ".cache/datamunge/datasets";
  dm::datasets::fetch("mnist", (cache / "mnist").string());

  const auto data = n::load_mnist((cache / "mnist").string(), "train"),
             test = n::load_mnist((cache / "mnist").string(), "test");
  if (data.images.shape() != n::Shape{60000, 28, 28, 1} ||
      test.images.shape() != n::Shape{10000, 28, 28, 1})
    throw std::runtime_error("Expected original MNIST splits");
  std::vector<std::int64_t> order(60000);
  std::iota(order.begin(), order.end(), 0);
  std::mt19937_64 split(2026);
  std::shuffle(order.begin(), order.end(), split);
  const std::vector<std::int64_t> fit(order.begin(), order.begin() + 12000);
  const std::vector<std::int64_t> validation(order.begin() + 12000, order.begin() + 15000);
  const auto tx = n::take_rows(data.images, fit), ty = n::take_rows(data.labels, fit);
  const auto vx = n::take_rows(data.images, validation), vy = n::take_rows(data.labels, validation);
  const auto qx = test.images, qy = test.labels;
  auto logits = [](n::ParameterStore &p, n::ParameterStore &state, const n::Tensor &x, bool bn,
                   bool training) {
    n::BatchNormOptions options;
    options.momentum = .9;
    options.eps = .001;
    auto h = x;
    for (int block = 0; block < 2; ++block) {
      h = n::conv2d(p, "conv" + std::to_string(block + 1), h, block == 0 ? 16 : 32, 3);
      if (bn)
        h = n::batch_norm(p, state, "bn" + std::to_string(block + 1), h, training, options);
      h = n::max_pool2d(n::relu(h), 2, 2);
    }
    h = n::dense(p, "dense", h.reshape({-1, 7 * 7 * 32}), 64, n::Activation::Relu);
    return n::dense(p, "output", h, 10);
  };
  std::filesystem::create_directories("build");
  std::vector<double> seeds, plain_accuracy, bn_accuracy, difference;
  const std::array<dm::graphics::RGBA, 6> colors{
      {{37, 99, 235}, {185, 28, 28}, {15, 118, 110}, {194, 65, 12}, {109, 40, 217}, {161, 98, 7}}};
  auto learning = dm::graphics::RPlot::create();
  std::size_t color = 0;
  for (int seed : {11, 23, 47}) {
    n::ParameterStore plain(seed), bn(seed), plain_state(0), bn_state(0);
    {
      n::NoGradGuard guard;
      logits(plain, plain_state, n::zeros({1, 28, 28, 1}), false, false);
      logits(bn, bn_state, n::zeros({1, 28, 28, 1}), true, false);
      for (const auto &name : plain.names()) {
        bn.at(name).copy_(plain.at(name));
        if (n::max(n::abs(bn.at(name) - plain.at(name))).item() != 0.)
          throw std::runtime_error("Mismatched initial paired weights");
      }
    }
    double scores[2]{};
    for (int variant = 0; variant < 2; ++variant) {
      auto &p = variant ? bn : plain;
      auto &state = variant ? bn_state : plain_state;
      n::OptimizerConfig config;
      config.kind = n::OptimizerKind::Adam;
      n::Optimizer optimizer(p, .001, config);
      n::BatchOrder batches(12000, 128, seed + 1000);
      const std::string prefix =
          "build/bn_pair_" + std::to_string(seed) + "_" + std::to_string(variant);
      double best = std::numeric_limits<double>::infinity();
      auto predict = [&](n::ParameterStore &parameters, n::ParameterStore &statistics,
                         const n::Tensor &input) {
        n::NoGradGuard guard;
        std::vector<n::Tensor> parts;
        for (std::int64_t at = 0; at < input.size(0); at += 256)
          parts.push_back(logits(parameters, statistics,
                                 n::slice_axis(input, 0, at, std::min(at + 256, input.size(0))),
                                 variant, false));
        return n::concat(parts, 0);
      };
      std::vector<double> nll_history;
      for (int epoch = 0; epoch < 6; ++epoch) {
        batches.begin_epoch();
        std::size_t used = 0;
        for (auto rows = batches.next(); !rows.empty(); rows = batches.next()) {
          used += rows.size();
          const auto z = logits(p, state, n::take_rows(tx, rows), variant, true);
          auto loss = n::sparse_softmax_cross_entropy(z, n::take_rows(ty, rows));
          for (const auto &w : p.parameters())
            if (w.dim() >= 2)
              loss = loss + .00005 * n::sum(n::square(w));
          optimizer.minimize(loss);
        }
        if (used != fit.size())
          throw std::runtime_error("Incomplete fitting epoch");
        const double validation_nll =
            n::sparse_softmax_cross_entropy(predict(p, state, vx), vy).item();
        nll_history.push_back(validation_nll);
        if (validation_nll < best) {
          best = validation_nll;
          p.save(prefix + "_params.npz");
          if (variant)
            state.save(prefix + "_state.npz");
        }
      }
      learning.lines({1, 2, 3, 4, 5, 6}, nll_history,
                     std::format("{} {}", seed, variant ? "BN" : "plain"), colors[color++]);
      p.load(prefix + "_params.npz");
      if (variant)
        state.load(prefix + "_state.npz");
      n::NoGradGuard guard;
      const auto snapshot = state.clone();
      const auto restored_nll = n::sparse_softmax_cross_entropy(predict(p, state, vx), vy).item();
      if (!std::isfinite(restored_nll) || std::abs(restored_nll - best) > 1e-6)
        throw std::runtime_error("Restored validation NLL differs");
      const auto z = predict(p, state, qx);
      const std::string confusion_file = "build/batch_norm_ablation_" + std::to_string(seed) +
                                         (variant ? "_bn" : "_plain") + "_confusion";
      n::ConfusionMatrix cm(10);
      cm.add(qy, n::argmax(z, 1));
      cm.save_svg(confusion_file + ".svg", {.title = "Paired MNIST seed " + std::to_string(seed) +
                                                     (variant ? " / BN" : " / plain")});
      n::save_npz(confusion_file + ".npz",
                  {{"truth", qy}, {"logits", z}, {"counts", cm.to_tensor()}});
      scores[variant] = n::accuracy(z, qy);
      const auto alone = logits(p, state, n::take_rows(qx, {0}), variant, false);
      if (n::max(n::abs(alone - n::take_rows(z, {0}))).item() > 2e-5)
        return 1;
      for (const auto &name : state.names())
        if (n::max(n::abs(state.at(name) - snapshot.at(name))).item() != 0)
          return 1;
      n::ParameterStore restored(0), restored_state(0);
      logits(restored, restored_state, n::zeros({1, 28, 28, 1}), variant, false);
      restored.load(prefix + "_params.npz");
      if (variant)
        restored_state.load(prefix + "_state.npz");
      if (n::max(n::abs(z - predict(restored, restored_state, qx))).item() > 1e-6)
        return 1;
    }
    seeds.push_back(seed);
    plain_accuracy.push_back(scores[0]);
    bn_accuracy.push_back(scores[1]);
    difference.push_back(scores[1] - scores[0]);
  }
  learning.title("Validation loss for paired initializations")
      .x_label("epoch")
      .y_label("mean NLL")
      .size(900, 460)
      .save_svg("build/batch_norm_ablation_learning.svg");
  auto plot = dm::graphics::RPlot::create();
  plot.bars({.8, 1.8, 2.8}, plain_accuracy, "plain", {37, 99, 235}, .3)
      .bars({1.2, 2.2, 3.2}, bn_accuracy, "BN", {234, 88, 12}, .3)
      .title("Paired runs on the same original MNIST rows")
      .x_label("seed pair index")
      .y_label("official test accuracy")
      .y_limits(0, 1.2);
  plot.size(850, 420).save_svg("build/batch_norm_ablation_pairs.svg");
  dm::dstruct::DataFrame table;
  table.add_column("seed", seeds);
  table.add_column("plain_accuracy", plain_accuracy);
  table.add_column("BN_accuracy", bn_accuracy);
  table.add_column("paired_difference", difference);
  const double mean = std::accumulate(difference.begin(), difference.end(), 0.) / difference.size();
  double squared = 0.;
  for (double value : difference)
    squared += (value - mean) * (value - mean);
  const double sd = std::sqrt(squared / (difference.size() - 1));
  std::println(
      "{}\nMean paired difference {:.3f} percentage points. Sample SD {:.3f} percentage points.",
      table.to_md(6), 100 * mean, 100 * sd);
}
```
