The optimization loop captures only learnable parameters. Batch moments update the separate state eagerly, and each validation improvement saves both stores.

```{cpp, results="markdown", file="figures/xception_training.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

int main() {
  int rendered_confusions = 0;
  namespace n = dm::nn;
  n::set_num_threads(2);

  std::filesystem::path cache;
  if (const auto *p = std::getenv("DATAMUNGE_DATA_DIR"))
    cache = p;
  else if (const auto *p = std::getenv("XDG_CACHE_HOME"))
    cache = std::filesystem::path(p) / "datamunge/datasets";
  else
    cache = std::filesystem::path(std::getenv("HOME")) / ".cache/datamunge/datasets";
  dm::datasets::fetch("cifar10", (cache / "cifar10").string());

  const auto development = n::load_cifar10((cache / "cifar10").string(), "train");
  if (development.images.shape() != n::Shape{50000, 32, 32, 3})
    throw std::runtime_error("Expected all CIFAR-10 development rows");
  std::vector<std::int64_t> order(50000);
  std::iota(order.begin(), order.end(), 0);
  std::mt19937_64 split(2026);
  std::shuffle(order.begin(), order.end(), split);
  const std::vector<std::int64_t> fitting(order.begin(), order.begin() + 12000);
  const std::vector<std::int64_t> held_out(order.begin() + 45000, order.end());
  const auto tx = n::take_rows(development.images, fitting);
  const auto ty = n::take_rows(development.labels, fitting);
  const auto vx = n::take_rows(development.images, held_out);
  const auto vy = n::take_rows(development.labels, held_out);
  n::models::XceptionConfig cfg;
  cfg.image_size = 71;
  cfg.classes = 10;
  cfg.width_divisor = 4;
  cfg.momentum = .9;
  n::ParameterStore p(17), state(17);
  auto output = [&](const n::Tensor &image, bool training) {
    const auto resized = n::resize_bilinear(image, {cfg.image_size, cfg.image_size});
    return n::models::Xception(p, state, resized, cfg, training);
  };
  const auto predict = [&](const n::Tensor &images) {
    n::NoGradGuard guard;
    std::vector<n::Tensor> result;
    for (std::int64_t at = 0; at < images.size(0); at += 128) {
      const auto rows = n::slice_axis(images, 0, at, std::min(at + 128, images.size(0)));
      result.push_back(output(2 * rows - 1, false).logits);
    }
    return n::concat(result, 0);
  };
  // Materialise every learned leaf before capturing optimizer parameters.
  {
    n::NoGradGuard guard;
    output(n::zeros({1, 32, 32, 3}), false);
  }
  n::OptimizerConfig config;
  config.kind = n::OptimizerKind::Adam;
  n::Optimizer optimizer(p, .001, config);
  n::BatchOrder batches(12000, 128, 29);
  n::Generator augmentation(151);
  std::filesystem::create_directories("build");
  const std::string checkpoint = "build/xception_best.npz";
  double best = std::numeric_limits<double>::infinity();
  int best_epoch = 0;
  std::vector<double> epochs, train, validation;
  for (int epoch = 1; epoch <= 12; ++epoch) {
    batches.begin_epoch();
    n::WeightedMean average;
    for (auto rows = batches.next(); !rows.empty(); rows = batches.next()) {
      const auto batch = n::take_rows(tx, rows), target = n::take_rows(ty, rows);
      const auto net = output(2 * n::study::augment_cifar10(batch, augmentation) - 1, true);
      const auto primary = n::sparse_softmax_cross_entropy(net.logits, target);
      auto objective = primary;

      // L2 coefficient .0001/2, kernels only; coupled penalty is explicit in the objective.
      for (const auto &w : p.parameters())
        if (w.dim() >= 2)
          objective = objective + .00005 * n::sum(n::square(w));
      optimizer.minimize(objective);
      average.add(primary.item(), rows.size());
    }
    if (average.count() != fitting.size())
      throw std::runtime_error("Incomplete fitting epoch");
    const double val = n::sparse_softmax_cross_entropy(predict(vx), vy).item();
    if (!std::isfinite(val))
      return 1;
    epochs.push_back(epoch);
    train.push_back(average.value());
    validation.push_back(val);
    if (val < best) {
      best = val;
      best_epoch = epoch;
      p.save(checkpoint);
      state.save("build/xception_best_state.npz");
    }
  }
  p.load(checkpoint);
  state.load("build/xception_best_state.npz");
  const auto saved_moments = state.flatten();
  n::NoGradGuard guard;
  const double restored = n::sparse_softmax_cross_entropy(predict(vx), vy).item();
  if (!std::isfinite(restored) || std::abs(restored - best) > 1e-6)
    throw std::runtime_error("Restored validation NLL differs");
  const auto official = n::load_cifar10((cache / "cifar10").string(), "test");
  if (official.images.shape() != n::Shape{10000, 32, 32, 3})
    throw std::runtime_error("Expected all official CIFAR-10 test rows");
  const auto test = predict(official.images), qy = official.labels;
  n::ConfusionMatrix native_confusion(10);
  native_confusion.add(qy, n::argmax(test, 1));
  n::save_npz("build/xception_heldout_" + std::to_string(rendered_confusions) + ".npz",
              {{"truth", qy}, {"logits", test}, {"counts", native_confusion.to_tensor()}});
  native_confusion.save_svg("build/xception_confusion_api_" +
                                std::to_string(rendered_confusions++) + ".svg",
                            {.title = "xception / selected-checkpoint test counts"});

  const double train_nll = n::sparse_softmax_cross_entropy(predict(tx), ty).item();
  const double test_nll = n::sparse_softmax_cross_entropy(test, qy).item();
  if (!std::isfinite(test_nll) || n::accuracy(test, qy) < .35)
    return 1;
  if (state.flatten() != saved_moments)
    throw std::runtime_error("Checkpoint inference changed the batch normalization moments");
  auto plot = dm::graphics::RPlot::create();
  plot.lines(epochs, train, "training", {37, 99, 235})
      .lines(epochs, validation, "validation", {234, 88, 12})
      .title("xception: compact CIFAR-10 primary NLL")
      .x_label("epoch")
      .y_label("mean NLL")
      .size(1000, 470)
      .save_svg("build/xception_training.svg");
  std::print("12000 fit / 5000 validation / 10000 official-test rows; {} learned scalars; {} Adam "
             "updates.\nBest validation epoch {}; NLL {:.6f}.\nSelected inference training "
             "NLL {:.6f}; test NLL {:.6f}; test accuracy {:.6f}.\n",
             p.count(), optimizer.iterations(), best_epoch, best, train_nll, test_nll,
             n::accuracy(test, qy));
}
```
