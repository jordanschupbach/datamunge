One original cached training image per class, IDs 0..4 then 5..9.
\image(figures/inception_v2_v3_inputs.svg)
// result_end
\caption(Original cached images, selected by first occurrence of each class; IDs run 0–4 then 5–9.)
\alttext(Original cached images, selected by first occurrence of each class; IDs run 0–4 then 5–9.)

The loop fits each version separately. It constructs auxiliary leaves before the optimizer, then omits auxiliary heads during validation and test inference. The primary NLL trace stays unsmoothed even when the fitted objective is smoothed.

```{cpp, results="markdown", file="figures/inception_v2_v3_training.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

int main() {
  int rendered_confusions = 0;
  namespace n = dm::nn;
  n::set_num_threads(2);

  std::filesystem::path cache;
  if (const auto *p = std::getenv("DATAMUNGE_DATA_DIR"))
    cache = p;
  else if (const auto *p = std::getenv("XDG_CACHE_HOME"))
    cache = std::filesystem::path(p) / "datamunge/datasets";
  else
    cache = std::filesystem::path(std::getenv("HOME")) / ".cache/datamunge/datasets";
  dm::datasets::fetch("cifar10", (cache / "cifar10").string());

  const auto development = n::load_cifar10((cache / "cifar10").string(), "train");
  if (development.images.shape() != n::Shape{50000, 32, 32, 3})
    throw std::runtime_error("Expected all CIFAR-10 development rows");
  std::vector<std::int64_t> order(50000);
  std::iota(order.begin(), order.end(), 0);
  std::mt19937_64 split(2026);
  std::shuffle(order.begin(), order.end(), split);
  const std::vector<std::int64_t> fitting(order.begin(), order.begin() + 12000);
  const std::vector<std::int64_t> held_out(order.begin() + 45000, order.end());
  const auto tx = n::take_rows(development.images, fitting);
  const auto ty = n::take_rows(development.labels, fitting);
  const auto vx = n::take_rows(development.images, held_out);
  const auto vy = n::take_rows(development.labels, held_out);
  std::filesystem::create_directories("build");
  auto layout = dm::graphics::RLayout::create(1, 2);
  dm::dstruct::DataFrame table;
  std::vector<std::string> names;
  std::vector<double> parameters, moments, selected, validation_nll, train_nll, test_nll, accuracy;
  for (int variant : {2, 3}) {
    n::models::Inception23Config cfg;
    cfg.version = variant;
    cfg.image_size = variant == 2 ? 64 : 107;
    cfg.classes = 10;
    cfg.width_divisor = 4;
    cfg.momentum = .9;
    const double smoothing = variant == 3 ? .1 : 0.;
    const std::string model_name = "Inception v" + std::to_string(variant);
    n::ParameterStore p(17), state(17);
    auto output = [&](const n::Tensor &image, bool training) {
      const auto resized = n::resize_bilinear(image, {cfg.image_size, cfg.image_size});
      return n::models::Inception23(p, state, resized, cfg, training, training);
    };
    const auto predict = [&](const n::Tensor &images) {
      n::NoGradGuard guard;
      std::vector<n::Tensor> result;
      for (std::int64_t at = 0; at < images.size(0); at += 128) {
        const auto rows = n::slice_axis(images, 0, at, std::min(at + 128, images.size(0)));
        result.push_back(output(2 * rows - 1, false).logits);
      }
      return n::concat(result, 0);
    };
    // Construct every leaf and auxiliary head before the optimizer captures p.
    {
      n::NoGradGuard guard;
      n::models::Inception23(p, state, n::zeros({1, cfg.image_size, cfg.image_size, 3}), cfg, false,
                             true);
    }
    n::OptimizerConfig config;
    config.kind = n::OptimizerKind::Adam;
    n::Optimizer optimizer(p, .001, config);
    n::BatchOrder batches(12000, 128, 29);
    n::Generator augmentation(151);
    const std::string checkpoint = "build/inception_v2_v3_" + std::to_string(variant);
    double best = std::numeric_limits<double>::infinity();
    int best_epoch = 0;
    std::vector<double> epochs, train, validation;
    for (int epoch = 1; epoch <= 12; ++epoch) {
      batches.begin_epoch();
      n::WeightedMean average;
      for (auto rows = batches.next(); !rows.empty(); rows = batches.next()) {
        const auto batch = n::take_rows(tx, rows), target = n::take_rows(ty, rows);
        const auto net = output(2 * n::study::augment_cifar10(batch, augmentation) - 1, true);
        const auto primary = n::sparse_softmax_cross_entropy(net.logits, target);
        auto objective =
            n::sparse_softmax_cross_entropy(net.logits, target, n::Reduction::Mean, smoothing);
        for (const auto &auxiliary : net.auxiliary)
          objective = objective + .4 * n::sparse_softmax_cross_entropy(
                                           auxiliary, target, n::Reduction::Mean, smoothing);
        for (const auto &w : p.parameters())
          if (w.dim() >= 2)
            objective = objective + .00005 * n::sum(n::square(w));
        optimizer.minimize(objective);
        average.add(primary.item(), rows.size());
      }
      if (average.count() != fitting.size())
        throw std::runtime_error("Incomplete fitting epoch");
      // Selection is unsmoothed main NLL, without auxiliary heads, augmentation or dropout.
      const double val = n::sparse_softmax_cross_entropy(predict(vx), vy).item();
      if (!std::isfinite(val))
        return 1;
      epochs.push_back(epoch);
      train.push_back(average.value());
      validation.push_back(val);
      if (val < best) {
        best = val;
        best_epoch = epoch;
        p.save(checkpoint + "_params.npz");
        state.save(checkpoint + "_state.npz");
      }
    }
    p.load(checkpoint + "_params.npz");
    state.load(checkpoint + "_state.npz");
    n::NoGradGuard guard;
    const auto moments_before = state.flatten();
    const double restored = n::sparse_softmax_cross_entropy(predict(vx), vy).item();
    if (!std::isfinite(restored) || std::abs(restored - best) > 1e-6)
      throw std::runtime_error("Restored validation NLL differs");
    const auto official = n::load_cifar10((cache / "cifar10").string(), "test");
    if (official.images.shape() != n::Shape{10000, 32, 32, 3})
      throw std::runtime_error("Expected all official CIFAR-10 test rows");
    const auto prediction = predict(official.images), qy = official.labels;
    n::ConfusionMatrix native_confusion(10);
    native_confusion.add(qy, n::argmax(prediction, 1));
    n::save_npz("build/inception_v2_v3_heldout_" + std::to_string(rendered_confusions) + ".npz",
                {{"truth", qy}, {"logits", prediction}, {"counts", native_confusion.to_tensor()}});
    native_confusion.save_svg("build/inception_v2_v3_confusion_api_" +
                                  std::to_string(rendered_confusions++) + ".svg",
                              {.title = "inception v2 v3 / selected-checkpoint test counts"});

    const double test_loss = n::sparse_softmax_cross_entropy(prediction, qy).item();
    if (!std::isfinite(test_loss) || n::accuracy(prediction, qy) < .35)
      return 1;
    names.push_back(model_name);
    parameters.push_back(p.count());
    moments.push_back(state.count());
    selected.push_back(best_epoch);
    validation_nll.push_back(best);
    train_nll.push_back(n::sparse_softmax_cross_entropy(predict(tx), ty).item());
    if (state.flatten() != moments_before)
      throw std::runtime_error("Inference changed the restored normalization state");
    test_nll.push_back(test_loss);
    accuracy.push_back(n::accuracy(prediction, qy));
    auto plot = dm::graphics::RPlot::create();
    plot.lines(epochs, train, "training", {37, 99, 235})
        .lines(epochs, validation, "validation", {234, 88, 12})
        .title(model_name)
        .x_label("epoch")
        .y_label("unsmoothed primary NLL");
    layout.add(plot);
    std::print("{}: {} explicit Adam updates.\n", model_name, optimizer.iterations());
  }
  table.add_column("model", names);
  table.add_column("parameters", parameters);
  table.add_column("moving_state", moments);
  table.add_column("best_epoch", selected);
  table.add_column("validation_NLL", validation_nll);
  table.add_column("selected_train_NLL", train_nll);
  table.add_column("test_NLL", test_nll);
  table.add_column("test_accuracy", accuracy);
  std::print(
      "12000 fit / 5000 validation / 10000 official-test rows per variant, twelve epochs.\n\n{}\n",
      table.to_md(6));
  layout.size(1100, 470).fit_panels().save_svg("build/inception_v2_v3_training.svg");
}
```
