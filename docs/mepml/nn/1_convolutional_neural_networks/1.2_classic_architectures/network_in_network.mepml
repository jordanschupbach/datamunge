> Checking the theory

Explicit patch extraction followed by three tensor matrix products must match the spatial/pointwise block in both values and parameter gradients.

```{cpp, results="markdown", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)", id=chunk-04, cache=yes}
#include <dm/dm.hpp>

int main() {
  namespace n = dm::nn;
  const auto type = n::DType::Float64;
  n::Generator rng(31);
  n::ParameterStore p(31, type);
  const auto image = n::normal({2, 5, 4, 3}, 0, .4, rng, type);
  const auto convolution = n::models::MlpConv(p, "mlp", image, 4, 5, 2, 3);
  auto h = n::im2col2d(image, 3, 3);
  const std::array<std::string, 3> names{"spatial", "mix1", "mix2"};
  const std::array<int, 3> in{27, 4, 5}, out{4, 5, 2};
  for (int layer = 0; layer < 3; ++layer) {
    const auto W = p.at("mlp/" + names[layer] + "/W").reshape({in[layer], out[layer]});
    h = n::relu(n::matmul(h, W) + p.at("mlp/" + names[layer] + "/b"));
  }
  const auto a = n::grad(n::mean(n::square(convolution)), p.parameters());
  const auto b = n::grad(n::mean(n::square(h)), p.parameters());
  double error = n::max(n::abs(convolution.reshape(h.shape()) - h)).item();
  for (size_t i = 0; i < a.size(); ++i)
    error = std::max(error, n::max(n::abs(a[i] - b[i])).item());
  if (error > 1e-10)
    return 1;
  n::ParameterStore full(17);
  const auto fixture = n::normal({2, 32, 32, 3}, 0., .2, rng);
  const auto model = n::models::NetworkInNetwork(full, fixture);
  if (full.count() != 966986 || model.blocks[0].shape() != n::Shape{2, 32, 32, 96} ||
      model.blocks[1].shape() != n::Shape{2, 16, 16, 192} ||
      model.blocks[2].shape() != n::Shape{2, 8, 8, 10} || model.logits.shape() != n::Shape{2, 10})
    throw std::runtime_error("Unexpected full NiN architecture");
  const auto gradients = n::grad(n::mean(n::square(model.logits)), full.parameters());
  for (const auto &gradient : gradients) {
    const double magnitude = n::max(n::abs(gradient)).item();
    if (!std::isfinite(magnitude) || magnitude <= 0.)
      throw std::runtime_error("Expected finite nonzero derivatives through all learned tensors");
  }
  std::println("Checked {} canonical parameter tensors.", gradients.size());
  std::print("Maximum patch-MLP value/gradient discrepancy {:.12f}; full parameters {}.\n",
             error, full.count());
}
```
