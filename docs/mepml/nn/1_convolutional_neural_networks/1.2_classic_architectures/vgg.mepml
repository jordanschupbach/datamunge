```{cpp, results="markdown", file="figures/vgg_training.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

int main() {
  int rendered_confusions = 0;
  namespace n = dm::nn;
  n::set_num_threads(2);

  std::filesystem::path cache;
  if (const auto *p = std::getenv("DATAMUNGE_DATA_DIR"))
    cache = p;
  else if (const auto *p = std::getenv("XDG_CACHE_HOME"))
    cache = std::filesystem::path(p) / "datamunge/datasets";
  else
    cache = std::filesystem::path(std::getenv("HOME")) / ".cache/datamunge/datasets";
  dm::datasets::fetch("cifar10", (cache / "cifar10").string());

  const auto development = n::load_cifar10((cache / "cifar10").string(), "train");
  if (development.images.shape() != n::Shape{50000, 32, 32, 3})
    throw std::runtime_error("Expected all CIFAR-10 development rows");
  std::vector<std::int64_t> order(50000);
  std::iota(order.begin(), order.end(), 0);
  std::mt19937_64 split(2026);
  std::shuffle(order.begin(), order.end(), split);
  const std::vector<std::int64_t> fitting(order.begin(), order.begin() + 12000);
  const std::vector<std::int64_t> held_out(order.begin() + 45000, order.end());
  const auto tx = n::take_rows(development.images, fitting);
  const auto ty = n::take_rows(development.labels, fitting);
  const auto vx = n::take_rows(development.images, held_out);
  const auto vy = n::take_rows(development.labels, held_out);
  std::filesystem::create_directories("build");
  auto learning = dm::graphics::RPlot::create();
  std::vector<double> variants, seeds, counts, accuracy, nll, training_nll;
  for (int variant : {11, 16, 19}) {
    n::ParameterStore p(variant == 19 ? 29 : 17);
    n::models::VggConfig cfg;
    cfg.depth = variant;
    cfg.image_size = 32;
    cfg.classes = 10;
    cfg.width_divisor = 4;
    cfg.dense_width = 256;
    cfg.keep_probability = .5;
    auto output = [&](const n::Tensor &x, bool training) {
      return n::models::Vgg(p, x, cfg, training);
    };
    const auto predict = [&](const n::Tensor &images) {
      n::NoGradGuard guard;
      std::vector<n::Tensor> result;
      for (std::int64_t at = 0; at < images.size(0); at += 128) {
        const auto rows = n::slice_axis(images, 0, at, std::min(at + 128, images.size(0)));
        result.push_back(output(2 * rows - 1, false).logits);
      }
      return n::concat(result, 0);
    };
    {
      n::NoGradGuard guard;
      output(n::zeros({1, 32, 32, 3}), false);
    }
    n::OptimizerConfig options;
    options.kind = n::OptimizerKind::Adam;
    n::Optimizer optimizer(p, .0005, options);
    n::BatchOrder batches(12000, 128, 29);
    n::Generator augmentation(151);
    const std::string path = "build/vgg_" + std::to_string(variant) + "_best.npz";
    double best = std::numeric_limits<double>::infinity();
    std::vector<double> epochs, validation;
    for (int epoch = 0; epoch < 10; ++epoch) {
      batches.begin_epoch();
      std::size_t used = 0;
      for (auto rows = batches.next(); !rows.empty(); rows = batches.next()) {
        used += rows.size();
        const auto augmented = n::study::augment_cifar10(n::take_rows(tx, rows), augmentation);
        const auto logits = output(2 * augmented - 1, true).logits;
        auto loss = n::sparse_softmax_cross_entropy(logits, n::take_rows(ty, rows));
        for (const auto &w : p.parameters())
          if (w.dim() >= 2)
            loss = loss + .00005 * n::sum(n::square(w));
        optimizer.minimize(loss);
      }
      if (used != fitting.size())
        throw std::runtime_error("Incomplete fitting epoch");
      const double val = n::sparse_softmax_cross_entropy(predict(vx), vy).item();
      if (!std::isfinite(val))
        return 1;
      epochs.push_back(epoch + 1);
      validation.push_back(val);
      if (val < best) {
        best = val;
        p.save(path);
      }
    }
    p.load(path);
    n::NoGradGuard guard;
    const double restored = n::sparse_softmax_cross_entropy(predict(vx), vy).item();
    if (!std::isfinite(restored) || std::abs(restored - best) > 1e-6)
      throw std::runtime_error("Restored validation NLL differs");
    const auto official = n::load_cifar10((cache / "cifar10").string(), "test");
    if (official.images.shape() != n::Shape{10000, 32, 32, 3})
      throw std::runtime_error("Expected all official CIFAR-10 test rows");
    const auto predicted = predict(official.images), qy = official.labels;
    n::ConfusionMatrix native_confusion(10);
    native_confusion.add(qy, n::argmax(predicted, 1));
    n::save_npz("build/vgg_heldout_" + std::to_string(rendered_confusions) + ".npz",
                {{"truth", qy}, {"logits", predicted}, {"counts", native_confusion.to_tensor()}});
    native_confusion.save_svg("build/vgg_confusion_api_" + std::to_string(rendered_confusions++) +
                                  ".svg",
                              {.title = "vgg / selected-checkpoint test counts"});

    variants.push_back(variant);
    seeds.push_back(variant == 19 ? 29 : 17);
    counts.push_back(p.count());
    const double score = n::accuracy(predicted, qy);
    if (score < .35)
      throw std::runtime_error("Test accuracy below source sanity threshold");
    accuracy.push_back(score);
    training_nll.push_back(n::sparse_softmax_cross_entropy(predict(tx), ty).item());
    nll.push_back(n::sparse_softmax_cross_entropy(predicted, qy).item());
    learning.lines(epochs, validation, "VGG-" + std::to_string(variant),
                   variant == 11   ? dm::graphics::RGB{37, 99, 235}
                   : variant == 16 ? dm::graphics::RGB{234, 88, 12}
                                   : dm::graphics::RGB{22, 163, 74});
  }
  learning.title("Validation NLL from explicit compact-model Adam loops")
      .x_label("epoch")
      .y_label("mean NLL");
  learning.size(850, 420).save_svg("build/vgg_training.svg");
  dm::dstruct::DataFrame table;
  table.add_column("variant", variants);
  table.add_column("initialization_seed", seeds);
  table.add_column("parameters", counts);
  table.add_column("test_accuracy", accuracy);
  table.add_column("test_NLL", nll);
  table.add_column("selected_training_NLL", training_nll);
  std::print(
      "12000 fitted rows, 5000 validation rows, 10000 official-test rows per depth; ten epochs.\n\n{}\n",
      table.to_md(6));
}
```
// result_begin: markdown
12000 fitted rows, 5000 validation rows, 10000 official-test rows per depth; ten epochs.

| variant | initialization_seed | parameters | test_accuracy | test_NLL | selected_training_NLL |
| ---: | ---: | ---: | ---: | ---: | ---: |
| 11 | 17 | 678506 | 0.5273 | 1.319226 | 1.282295 |
| 16 | 17 | 1022170 | 0.4513 | 1.430501 | 1.386833 |
| 19 | 29 | 1354266 | 0.3543 | 1.600033 | 1.580268 |

\image(figures/vgg_training.svg)
// result_end
\caption(Validation NLL over ten epochs for the three compact CIFAR-10 models.)
\alttext(Validation NLL over ten epochs for the three compact CIFAR-10 models.)

The table compares unaugmented inference NLL and test accuracy at each selected checkpoint.

> Native confusion matrices

These matrices use the held-out predictions from the executed program above.
The native `ConfusionMatrix` SVG API labels exact counts with true classes
running from top to bottom and predicted classes from left to right.

\image(figures/vgg_confusion_api_0.svg)
\caption(Held-out classification confusion counts, evaluation 1. Exact cell counts are printed in the image.)
