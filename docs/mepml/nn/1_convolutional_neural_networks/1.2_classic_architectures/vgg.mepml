```{cpp, results="markdown", file="figures/vgg_counts.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

int main() {
  namespace n = dm::nn;
  n::set_num_threads(2);
  n::Generator fixture(23);
  std::vector<double> depth, reference, compact, receptive_field;
  for (int d : {11, 16, 19}) {
    const auto schedule = n::models::VggBlockDepths(d);
    int64_t count = 0, in = 3;
    const std::array<int, 5> widths{64, 128, 256, 512, 512};
    for (int block = 0; block < 5; ++block)
      for (int layer = 0; layer < schedule[block]; ++layer) {
        count += 9 * in * widths[block] + widths[block];
        in = widths[block];
      }
    count += (7 * 7 * 512LL + 1) * 4096 + (4096LL + 1) * 4096 + (4096LL + 1) * 1000;
    int field = 1, jump = 1;
    for (int layers : schedule) {
      field += (2 * layers + 1) * jump;
      jump *= 2;
    }
    const int expected_field = d == 11 ? 150 : d == 16 ? 212 : 268;
    if (field != expected_field || jump != 32)
      throw std::runtime_error("Unexpected final pooling support");
    receptive_field.push_back(field);
    {
      n::models::VggConfig canonical;
      canonical.depth = d;
      n::ParameterStore full(17);
      const auto pixels = n::normal({1, 224, 224, 3}, 0., .2, fixture);
      const auto result = n::models::Vgg(full, pixels, canonical);
      for (std::size_t block = 0; block < widths.size(); ++block) {
        const int side = 224 >> (block + 1);
        if (result.pooling[block].shape() != n::Shape{1, side, side, widths[block]})
          throw std::runtime_error("Unexpected canonical pooling shape");
      }
      const auto gradients = n::grad(n::mean(n::square(result.logits)), full.parameters());
      if (full.count() != count || result.convolution.size() + 3 != std::size_t(d) ||
          result.logits.shape() != n::Shape{1, 1000})
        throw std::runtime_error("Unexpected canonical architecture");
      for (const auto &gradient : gradients) {
        const double magnitude = n::max(n::abs(gradient)).item();
        if (!std::isfinite(magnitude) || magnitude <= 0.)
          throw std::runtime_error("Expected finite nonzero canonical gradients");
      }
      n::NoGradGuard guard;
      const auto scores = n::models::VggConvolutionalHead(full, result.pooling.back(), canonical);
      const double delta = n::max(n::abs(scores.reshape({1, 1000}) - result.logits)).item();
      if (!std::isfinite(delta) || delta > 2e-5)
        throw std::runtime_error("Shared dense and convolutional heads disagree");
      std::println("VGG-{} verifies {} parameter tensors and shared-head max error {:.8f}.", d,
                   gradients.size(), delta);
    }
    n::models::VggConfig cfg;
    cfg.depth = d;
    cfg.image_size = 32;
    cfg.classes = 10;
    cfg.width_divisor = 4;
    cfg.dense_width = 256;
    n::ParameterStore p(17);
    n::NoGradGuard guard;
    const auto output = n::models::Vgg(p, n::zeros({1, 32, 32, 3}), cfg);
    if (output.convolution.size() + 3 != size_t(d) ||
        output.pooling[4].shape() != n::Shape{1, 1, 1, 128})
      return 1;
    depth.push_back(d);
    reference.push_back(count);
    compact.push_back(p.count());
  }
  auto plot = dm::graphics::RPlot::create();
  plot.lines(depth, compact, "instantiated compact", {37, 99, 235})
      .title("Preserve depth while reducing widths and head size")
      .x_label("learned depth")
      .y_label("compact parameters");
  std::filesystem::create_directories("build");
  plot.size(850, 420).save_svg("build/vgg_counts.svg");
  dm::dstruct::DataFrame table;
  table.add_column("depth", depth);
  table.add_column("full_shape_count", reference);
  table.add_column("final_pool_receptive_field", receptive_field);
  table.add_column("instantiated_compact_count", compact);
  std::print("{}\n", table.to_md(0));
}
