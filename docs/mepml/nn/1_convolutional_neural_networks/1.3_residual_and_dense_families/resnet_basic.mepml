```{cpp, results="markdown", file="figures/resnet_basic_training.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

int main() {
  int rendered_confusions = 0;
  namespace n = dm::nn;
  namespace c = dm::compute;
  using clock = std::chrono::steady_clock;
  n::set_num_threads(4);

  // Inference runs on the first CUDA GPU when this datamunge build has CUDA and
  // cuBLAS; otherwise the identical code runs on the CPU. Training stays on CPU.
  const c::Context host;
  c::Context device = host;
  if (c::probe({c::Backend::CUDA, 0}).available) {
    const c::Context gpu({c::Backend::CUDA, 0});
    if (gpu.supports_matmul())
      device = gpu;
  }
  const auto device_name = device.device().backend == c::Backend::CUDA
                               ? "CUDA " + c::probe(device.device()).name
                               : std::string("CPU (no usable CUDA device in this build)");

  std::filesystem::path cache;
  if (const auto *p = std::getenv("DATAMUNGE_DATA_DIR"))
    cache = p;
  else if (const auto *p = std::getenv("XDG_CACHE_HOME"))
    cache = std::filesystem::path(p) / "datamunge/datasets";
  else
    cache = std::filesystem::path(std::getenv("HOME")) / ".cache/datamunge/datasets";
  dm::datasets::fetch("cifar10", (cache / "cifar10").string());

  constexpr std::int64_t fit = 12000, held = 5000, batch = 128, epochs = 12;
  const auto development = n::load_cifar10((cache / "cifar10").string(), "train");
  if (development.images.shape() != n::Shape{50000, 32, 32, 3})
    throw std::runtime_error("Expected all original development rows");
  const auto split = n::split_image_holdout(development, held, 2026, fit);
  const auto &tx = split.fit.images, &ty = split.fit.labels;
  const auto vx = 2 * split.validation.images - 1, vy = split.validation.labels;

  // Batched inference on `device`; logits come back to the host.
  auto infer = [&](const n::ParameterStore &p, const n::ParameterStore &state,
                   const n::models::ResNetConfig &cfg, const n::Tensor &x) {
    n::NoGradGuard guard;
    auto dp = p.to(device), ds = state.to(device);
    std::vector<n::Tensor> logits;
    for (std::int64_t i = 0; i < x.size(0); i += 128) {
      const auto rows = n::slice_axis(x, 0, i, std::min(i + 128, x.size(0)));
      logits.push_back(n::models::ResNet(dp, ds, rows.to(device), cfg, false).logits.to(host));
    }
    return n::concat(logits, 0);
  };

  std::filesystem::create_directories("build");
  auto layout = dm::graphics::RLayout::create(1, 2);
  std::vector<double> depths, counts, moving, selected, train_nll, validation_nll, test_nll,
      accuracy, fit_seconds;
  double inference_seconds = 0;
  for (int depth : {18, 34}) {
    n::models::ResNetConfig cfg;
    cfg.depth = depth;
    cfg.classes = 10;
    cfg.width_divisor = 4;
    cfg.small_stem = true;
    cfg.momentum = .9;
    n::ParameterStore p(17), state(17);
    {
      n::NoGradGuard guard;
      n::models::ResNet(p, state, n::zeros({1, 32, 32, 3}), cfg, false);
    }
    n::OptimizerConfig config;
    config.kind = n::OptimizerKind::Adam;
    n::Optimizer optimizer(p, .001, config);
    n::BatchOrder batches(fit, batch, 29);
    n::Generator augmentation(151);
    const std::string checkpoint = "build/resnet_basic_" + std::to_string(depth);
    double best = std::numeric_limits<double>::infinity(), seconds = 0;
    int best_epoch = 0;
    std::vector<double> epoch_axis, train, validation;
    for (int epoch = 1; epoch <= epochs; ++epoch) {
      const auto start = clock::now();
      batches.begin_epoch();
      n::WeightedMean average;
      for (auto rows = batches.next(); !rows.empty(); rows = batches.next()) {
        const auto x = n::take_rows(tx, rows), target = n::take_rows(ty, rows);
        const auto augmented = n::study::augment_cifar10(x, augmentation);
        const auto logits = n::models::ResNet(p, state, 2 * augmented - 1, cfg, true).logits;
        const auto nll = n::sparse_softmax_cross_entropy(logits, target);
        auto objective = nll;
        for (const auto &w : p.parameters())
          if (w.dim() >= 2)
            objective = objective + .00005 * n::sum(n::square(w));
        optimizer.minimize(objective);
        average.add(nll.item(), rows.size());
      }
      if (average.count() != fit)
        throw std::runtime_error("Incomplete fitting epoch");
      seconds += std::chrono::duration<double>(clock::now() - start).count();
      const auto inferred = clock::now();
      const double val = n::sparse_softmax_cross_entropy(infer(p, state, cfg, vx), vy).item();
      inference_seconds += std::chrono::duration<double>(clock::now() - inferred).count();
      if (!std::isfinite(val))
        return 1;
      epoch_axis.push_back(epoch);
      train.push_back(average.value());
      validation.push_back(val);
      if (val < best) {
        best = val;
        best_epoch = epoch;
        p.save(checkpoint + "_params.npz");
        state.save(checkpoint + "_state.npz");
      }
    }
    p.load(checkpoint + "_params.npz");
    state.load(checkpoint + "_state.npz");
    const double restored = n::sparse_softmax_cross_entropy(infer(p, state, cfg, vx), vy).item();
    if (!std::isfinite(restored) || std::abs(restored - best) > 1e-6)
      throw std::runtime_error("Restored validation loss differs");
    const auto official = n::load_cifar10((cache / "cifar10").string(), "test");
    if (official.images.shape() != n::Shape{10000, 32, 32, 3})
      throw std::runtime_error("Expected all official CIFAR-10 test rows");
    const auto qx = 2 * official.images - 1, qy = official.labels;
    const auto inferred = clock::now();
    const auto prediction = infer(p, state, cfg, qx);
    train_nll.push_back(
        n::sparse_softmax_cross_entropy(infer(p, state, cfg, 2 * tx - 1), ty).item());
    inference_seconds += std::chrono::duration<double>(clock::now() - inferred).count();
    n::NoGradGuard guard;
    n::ConfusionMatrix native_confusion(10);
    native_confusion.add(qy, n::argmax(prediction, 1));
    n::save_npz("build/resnet_basic_heldout_" + std::to_string(rendered_confusions) + ".npz",
                {{"truth", qy}, {"logits", prediction}, {"counts", native_confusion.to_tensor()}});
    native_confusion.save_svg("build/resnet_basic_confusion_api_" +
                                  std::to_string(rendered_confusions++) + ".svg",
                              {.title = "resnet basic / selected-checkpoint test counts"});

    const double test_loss = n::sparse_softmax_cross_entropy(prediction, qy).item();
    if (!std::isfinite(test_loss) || n::accuracy(prediction, qy) < .4)
      return 1;
    depths.push_back(depth);
    counts.push_back(p.count());
    moving.push_back(state.count());
    selected.push_back(best_epoch);
    validation_nll.push_back(best);
    test_nll.push_back(test_loss);
    accuracy.push_back(n::accuracy(prediction, qy));
    fit_seconds.push_back(seconds);
    auto plot = dm::graphics::RPlot::create();
    plot.lines(epoch_axis, train, "training", {37, 99, 235})
        .lines(epoch_axis, validation, "validation", {234, 88, 12})
        .title("ResNet-" + std::to_string(depth) + ", quarter widths")
        .x_label("epoch")
        .y_label("primary NLL");
    layout.add(plot);
    std::print("ResNet-{}: {} Adam updates in {:.0f} s of CPU training.\n", depth,
               optimizer.iterations(), seconds);
  }

  dm::dstruct::DataFrame table;
  table.add_column("depth", depths);
  table.add_column("parameters", counts);
  table.add_column("moving_state", moving);
  table.add_column("best_epoch", selected);
  table.add_column("selected_train_NLL", train_nll);
  table.add_column("validation_NLL", validation_nll);
  table.add_column("test_NLL", test_nll);
  table.add_column("test_accuracy", accuracy);
  std::print("Inference device: {}; all inference took {:.1f} s.\n", device_name,
             inference_seconds);
  std::print("{} fit / {} validation / {} official-test rows per depth.\n\n{}\n", fit, held, 10000,
             table.to_md(4));
  layout.size(1100, 470).fit_panels().save_svg("build/resnet_basic_training.svg");
}
```
