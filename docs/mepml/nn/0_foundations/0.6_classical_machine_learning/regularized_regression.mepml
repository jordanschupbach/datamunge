int main() {
  std::filesystem::create_directories("build");
  dm::graphics::Diagram diagram;
  diagram.node("n0", {0.0, 0}, "Least-squares gradient\nplus ridge term");
  diagram.node("n1", {5.2, 0}, "Gradient step z\nrate within bound");
