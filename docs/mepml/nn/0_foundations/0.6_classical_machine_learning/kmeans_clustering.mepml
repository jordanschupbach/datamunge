> Simple examples

Points -3,-2,-1 and 1,2,3 form two clusters with centres -2 and 2 and inertia 4.

```{cpp, results="markdown", file="figures/kmeans_clustering_six.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

int main() {
  namespace n = dm::nn;
  const auto x = n::tensor({-3, -2, -1, 1, 2, 3}, {6, 1}, n::DType::Float64);
  auto centres = n::tensor({-1, 1}, {2, 1}, n::DType::Float64).requires_grad_();
  n::OptimizerConfig config;
  config.kind = n::OptimizerKind::Sgd;
  n::Optimizer optimizer({centres}, .3, config);
  for (int step = 0; step < 250; ++step) {
    const auto distance = n::sum(n::square(n::expand_dims(x, 1) - centres), {2});
    // argmin assignments are piecewise constant; min routes the active gradient.
    const auto loss = n::mean(n::min(distance, {1}));
    optimizer.minimize(loss);
  }
  n::NoGradGuard guard;
  const auto distance = n::sum(n::square(n::expand_dims(x, 1) - centres), {2});
  const auto assignments = n::argmin(distance, 1);
  const auto assigned = n::gather(centres, assignments);
  const double inertia = n::sum(n::min(distance, {1})).item();
  if (std::abs(inertia - 4) > 1e-10)
    return 1;
  auto p = dm::graphics::RPlot::create();
  p.points(x.to_vector<double>(), assignments.to_vector<double>(), "data", {37, 99, 235}, 5)
      .points(assigned.to_vector<double>(), assignments.to_vector<double>(), "SGD centres",
              {234, 88, 12}, 8)
      .title("Tensor SGD recovers two exact cluster means")
      .x_label("x")
      .y_label("cluster ID")
      .y_limits(-.3, 1.3);
  std::filesystem::create_directories("build");
  p.size(820, 420).save_svg("build/kmeans_clustering_six.svg");
  std::print("Centres {}; inertia {:.9f}; {} SGD steps.\n", centres.to_vector<double>(),
             inertia, optimizer.iterations());
}
```
// result_begin: markdown
Centres [-1.9999999999999998, 1.9999999999999998]; inertia 4.000000000; 250 SGD steps.
\image(figures/kmeans_clustering_six.svg)
// result_end
\caption(The assignment IDs matter only through their associated centroids and distances.)
\alttext(The assignment IDs matter only through their associated centroids and distances.)

> Checking the theory

```{cpp, results="markdown", file="figures/kmeans_clustering_cloud.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

int main() {
  namespace n = dm::nn;
  n::Generator rng(19);
  const auto i = n::linspace(0, 89, 90, n::DType::Float64).reshape({90, 1});
  const auto group = i - 3 * n::floor(i / 3.);
  const auto x = n::concat({2 * group + .7 * n::sin(1.7 * i), .8 * n::cos(2.1 * i)}, 1);
  double first = 0, best = std::numeric_limits<double>::infinity();
  n::Tensor retained;
  for (int restart = 0; restart < 8; ++restart) {
    auto centres = (n::normal({3, 2}, 0, 1, rng, n::DType::Float64) + n::mean(x, {0}, true))
                       .detach()
                       .requires_grad_();
    n::OptimizerConfig config;
    config.kind = n::OptimizerKind::Sgd;
    n::Optimizer optimizer({centres}, .3, config);
    for (int step = 0; step < 600; ++step) {
      const auto distance = n::sum(n::square(n::expand_dims(x, 1) - centres), {2});
      optimizer.minimize(n::mean(n::min(distance, {1})));
    }
    n::NoGradGuard guard;
    const double inertia =
        n::sum(n::min(n::sum(n::square(n::expand_dims(x, 1) - centres), {2}), {1})).item();
    if (restart == 0)
      first = inertia;
    if (inertia < best) {
      best = inertia;
      retained = centres.detach().clone();
    }
  }
  if (best > first + 1e-10)
    return 1;
  auto p = dm::graphics::RPlot::create();
  p.points(n::select(x, 1, 0).to_vector<double>(), n::select(x, 1, 1).to_vector<double>(),
           "all 90 inputs", {37, 99, 235}, 4)
      .points(n::select(retained, 1, 0).to_vector<double>(),
              n::select(retained, 1, 1).to_vector<double>(), "best centres", {234, 88, 12}, 8)
      .title("All input points and the retained tensor-SGD centres")
      .x_label("x")
      .y_label("y");
  std::filesystem::create_directories("build");
  p.size(850, 420).save_svg("build/kmeans_clustering_cloud.svg");
  std::print("First-start inertia {:.9f}; best of eight {:.9f}.\n", first, best);
}
```
// result_begin: markdown
First-start inertia 22.400716390; best of eight 22.400716390.
\image(figures/kmeans_clustering_cloud.svg)
// result_end


> Seeded Lloyd restarts

The upstream four-cloud fixture uses eight seeds per initialization rule.
Compare inertia immediately after initialization and after Lloyd updates.
For the best fit, match each learned center to its nearest generating
center before checking assignments, since cluster IDs can be permuted.

```{cpp, results="markdown", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)", id=chunk-04, cache=yes}
#include <dm/dm.hpp>
int main() {
  namespace n=dm::nn;
  std::mt19937 rng(83);
  std::normal_distribution<float> noise(0,.35f);
  const std::array<std::array<float,2>,4> truth{{{-3,-3},{-3,3},{3,-3},{3,3}}};
  std::vector<float> values;
  for(int i=0;i<600;++i)
    for(int j=0;j<2;++j) values.push_back(truth[i%4][j]+noise(rng));
  const auto x=n::from_vector(values,{600,2});
  n::ml::KMeans model(2);
  std::array<double,2> initial{},best{1e100,1e100};
  n::ml::KMeansStep selected;
  for(bool plus:{false,true}) {
    for(int seed=0;seed<8;++seed) {
      auto fit=model.Step(x,model.Initialize(x,4,seed,plus));
      initial[plus]+=fit.inertia/8.;
      for(int step=0;step<30;++step) {
        const auto next=model.Step(x,fit.centers);
        if(!std::isfinite(next.inertia)||next.inertia>fit.inertia+1e-3)
          throw std::runtime_error("Lloyd inertia increased");
        fit=next;
      }
      if(fit.inertia<best[plus]) {
        best[plus]=fit.inertia;
        if(plus) selected=fit;
      }
    }
  }
  if(!(initial[1]<initial[0])||std::abs(best[1]-best[0])>.001)
    throw std::runtime_error("Initialization comparison differs");
  std::array<int,4> labels{};
  for(int c=0;c<4;++c) {
    double distance=1e100;
    for(int j=0;j<4;++j) {
      const double d=std::hypot(selected.centers.at({c,0})-truth[j][0],
                                selected.centers.at({c,1})-truth[j][1]);
      if(d<distance) { distance=d; labels[c]=j; }
    }
    if(distance>.15||selected.counts.at({c})!=150) throw std::runtime_error("Incorrect center or count");
  }
  const auto ids=selected.labels.to_vector<int>();
  for(int i=0;i<600;++i)
    if(labels.at(ids[i])!=i%4) throw std::runtime_error("Wrong cloud assignment");
  std::print("Mean starting inertia: random {:.2f}, k-means++ {:.2f}. Best inertia {:.2f}; 600 cloud assignments correct.\n",
             initial[0],initial[1],best[1]);
}
```
// result_begin: markdown
Mean starting inertia: random 7139.16, k-means++ 301.79. Best inertia 144.43; 600 cloud assignments correct.
// result_end

> Conclusion

The tiny partition recovers the expected means and squared-distance total. Additional starts
can improve the retained objective, while the optimum remains dependent on metric, K and
initialization. Cluster IDs are not semantic labels or evidence of natural categories.

> References

- [Arthur and Vassilvitskii (2007), k-means++](https://theory.stanford.edu/~sergei/papers/kMeansPP-soda.pdf).

> Lloyd updates with explicit iteration ownership

The legacy common header also provided Lloyd updates and seeded k-means++
initialization. These now live in `dm::nn::ml::KMeans`. Each `Step` assigns
against the supplied centres, then returns their next means. Its inertia describes
the supplied centres, and an empty cluster retains its previous centre. The
caller chooses how many updates to perform; this example deliberately shows one.

```{cpp, results="markdown", file="figures/common_lloyd.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main(){namespace n=dm::nn;n::ml::KMeans model(1);auto x=n::tensor({0,2,9,11},{4,1});auto before=n::tensor({0,9,100},{3,1});auto result=model.Step(x,before);std::print("Old-centre inertia: {}; next centres: 1, 10, 100 (third cluster is empty).\n",result.inertia);if(result.centers.to_vector<float>()!=std::vector<float>{1,10,100})return 1;dm::graphics::RPlot::create().points({0,1,2},before.to_vector<double>(),"before",{37,99,235},6).points({0,1,2},result.centers.to_vector<double>(),"after one Lloyd update",{234,88,12},6).title("An empty cluster retains its centre").x_label("Cluster index").y_label("Centre coordinate").save_svg("build/common_lloyd.svg");}
```
// result_begin: markdown
Old-centre inertia: 8; next centres: 1, 10, 100 (third cluster is empty).
\image(figures/common_lloyd.svg)
// result_end
