> Simple examples

Equal masses, means -1 and 1, and unit variances give component-one probability sigmoid(2x). At x=0 it is exactly one half.

```{cpp, results="markdown", file="figures/gaussian_mixtures_responsibilities.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

int main() {
  namespace n = dm::nn;
  const auto dtype = n::DType::Float64;
  const auto x = n::linspace(-2, 2, 9, dtype).reshape({9, 1});
  const auto means = n::tensor({-1, 1}, {1, 2}, dtype);
  const auto joint =
      -.5 * n::square(x - means) - .5 * std::log(2 * std::numbers::pi) - std::log(2.);
  const auto posterior = n::softmax(joint, 1), exact = n::sigmoid(2 * x);
  const auto probability = n::select(posterior, 1, 1);
  if (n::max(n::abs(probability - n::reshape(exact, {9}))).item() > 1e-12)
    return 1;
  auto p = dm::graphics::RPlot::create();
  p.lines(x.to_vector<double>(), probability.to_vector<double>(), "tensor posterior",
          {37, 99, 235})
      .points(x.to_vector<double>(), exact.to_vector<double>(), "analytic sigmoid",
              {234, 88, 12})
      .title("Soft assignment between two unit Gaussians")
      .x_label("x")
      .y_label("P(component +1)")
      .y_limits(0, 1.1);
  std::filesystem::create_directories("build");
  p.size(850, 420).save_svg("build/gaussian_mixtures_responsibilities.svg");
  std::print("Maximum analytic responsibility error {:.12f}.\n",
             n::max(n::abs(probability - n::reshape(exact, {9}))).item());
}
```
// result_begin: markdown
Maximum analytic responsibility error 0.000000000000.
\image(figures/gaussian_mixtures_responsibilities.svg)
// result_end
\caption(A symmetric Gaussian density ratio reduces exactly to a logistic curve.)
\alttext(A symmetric Gaussian density ratio reduces exactly to a logistic curve.)

> Checking the theory

```{cpp, results="markdown", file="figures/gaussian_mixtures_adam.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

int main() {
  namespace n = dm::nn;
  const auto dtype = n::DType::Float64;
  const auto x = n::tensor({-2.2, -2, -1.8, 1.8, 2, 2.2}, {6, 1}, dtype);
  auto means = n::tensor({-1, 1}, {1, 2}, dtype).requires_grad_();
  auto scale = n::full({1, 2}, .5, dtype).requires_grad_();
  auto mass = n::zeros({1, 2}, dtype).requires_grad_();
  auto log_joint = [&]() {
    const auto variance = .01 + n::softplus(scale);
    return n::log_softmax(mass, 1) -
           .5 * (n::log(2 * std::numbers::pi * variance) + n::square(x - means) / variance);
  };
  n::OptimizerConfig config;
  config.kind = n::OptimizerKind::Adam;
  n::Optimizer optimizer({means, scale, mass}, .03, config);
  std::vector<double> step, nll;
  const double initial = -n::mean(n::logsumexp(log_joint(), {1})).item();
  for (int i = 0; i < 1200; ++i) {
    const auto objective = -n::mean(n::logsumexp(log_joint(), {1}));
    step.push_back(i);
    nll.push_back(objective.item());
    optimizer.minimize(objective);
  }
  n::NoGradGuard guard;
  const auto variance = .01 + n::softplus(scale), posterior = n::softmax(log_joint(), 1);
  const double final = -n::mean(n::logsumexp(log_joint(), {1})).item();
  const double mass_error = n::max(n::abs(n::sum(posterior, {1}) - 1)).item();
  if (final >= initial || mass_error > 1e-12 || n::min(variance).item() < .01)
    return 1;
  auto p = dm::graphics::RPlot::create();
  p.lines(step, nll, "Adam mean NLL", {37, 99, 235})
      .title("Optimise observed-data mixture likelihood")
      .x_label("Adam step")
      .y_label("mean NLL");
  std::filesystem::create_directories("build");
  p.size(850, 420).save_svg("build/gaussian_mixtures_adam.svg");
  std::print("Initial/final mean NLL {:.9f}, {:.9f}; means {}; variances {}; posterior mass "
             "error {:.12f}.\n",
             initial, final, means.to_vector<double>(), variance.to_vector<double>(),
             mass_error);
}
```
// result_begin: markdown
Initial/final mean NLL 2.107752292, 0.299915247; means [-1.9999999999999998, 2]; variances [0.026666666666666665, 0.026666666666666665]; posterior mass error 0.000000000000.
\image(figures/gaussian_mixtures_adam.svg)
// result_end
\caption(The curve records mean observed-data NLL before each Adam update; improvement need not be monotonic.)
\alttext(The curve records mean observed-data NLL before each Adam update; improvement need not be monotonic.)


> Full-covariance EM

The upstream fixture draws three groups with different masses and correlated
coordinates. Initialize with k-means++ centers, then alternate posterior
membership estimates and responsibility-weighted updates. An eigenvalue
floor keeps each fitted covariance positive definite. The likelihood plotted
below is the observed-data likelihood at each accepted state.

```{cpp, results="markdown", file="figures/gaussian_mixtures_em.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
  namespace n=dm::nn;
  namespace m=n::ml;
  constexpr auto type=n::DType::Float64;
  const std::array<std::array<double,2>,3> means{{{-3,-1},{0,3},{3,-1}}};
  const std::array<double,3> masses{.2,.5,.3};
  std::mt19937 rng(89);
  auto sample=[&](int size) {
    std::normal_distribution<double> normal;
    std::vector<double> values;
    for(int i=0;i<size;++i) {
      const int c=i%10<2?0:i%10<7?1:2;
      const double a=normal(rng), b=normal(rng);
      values.push_back(means[c][0]+(.45+.1*c)*a);
      values.push_back(means[c][1]+.2*a+.4*b);
    }
    return n::from_vector(values,{size,2});
  };
  const auto fit=sample(1000), test=sample(500);
  const m::GaussianMixture model(3,2);
  const auto centers=m::KMeans(2).Initialize(fit.to(n::DType::Float32),3,7,true).to(type);
  const auto covariance=n::stack({n::eye(2,type),n::eye(2,type),n::eye(2,type)},0);
  m::GaussianMixtureState state{n::full({3},1./3,type),centers,covariance};
  std::vector<double> iterations, likelihood;
  bool converged=false;
  for(int step=0;step<100;++step) {
    const auto update=model.Step(fit,state);
    const double value=update.log_likelihood;
    if(!std::isfinite(value)||(!likelihood.empty() && value<likelihood.back()-1e-7))
      throw std::runtime_error("EM likelihood decreased or became nonfinite");
    converged=!likelihood.empty() && value-likelihood.back()<1e-7;
    iterations.push_back(step);
    likelihood.push_back(value);
    if(converged) break;
    state=update.next;
  }
  auto near=[](double actual,double expected,double tolerance) {
    if(!(std::abs(actual-expected)<=tolerance)) throw std::runtime_error("Mixture reference check failed");
  };
  if(!converged||likelihood.back()-likelihood.front()<=100)
    throw std::runtime_error("EM failed to converge or improve the initialized mixture");
  std::array<bool,3> seen{};
  for(int c=0;c<3;++c) {
    int label=0;
    auto distance=[&](int j) {
      return std::hypot(state.means.at({c,0})-means[j][0],state.means.at({c,1})-means[j][1]);
    };
    for(int j=1;j<3;++j) if(distance(j)<distance(label)) label=j;
    if(seen[label]||distance(label)>=.15) throw std::runtime_error("Missing component");
    seen[label]=true;
    const double scale=.45+.1*label;
    near(state.weights.at({c}),masses[label],.015);
    near(state.covariances.at({c,0,0}),scale*scale,.07);
    near(state.covariances.at({c,0,1}),.2*scale,.06);
    near(state.covariances.at({c,1,1}),.2,.05);
  }
  const auto held=model.Step(test,state);
  double worst=0.;
  for(int i=0;i<500;++i) {
    std::array<double,3> joint{};
    for(int c=0;c<3;++c) {
      const double a=state.covariances.at({c,0,0}), b=state.covariances.at({c,0,1}),
                   d=state.covariances.at({c,1,1}), determinant=a*d-b*b;
      if(!(determinant>0)) throw std::runtime_error("Covariance is not positive definite");
      const double x=test.at({i,0})-state.means.at({c,0}), y=test.at({i,1})-state.means.at({c,1});
      joint[c]=state.weights.at({c})*std::exp(-.5*(d*x*x-2*b*x*y+a*y*y)/determinant)/
               (2*std::numbers::pi*std::sqrt(determinant));
    }
    const double total=std::accumulate(joint.begin(),joint.end(),0.);
    for(int c=0;c<3;++c) near(held.responsibilities.at({i,c}),joint[c]/total,1e-11);
    worst=std::max(worst,std::abs(held.log_density.at({i})-std::log(total)));
  }
  if(worst>1e-11 || held.log_likelihood/500.<=-3)
    throw std::runtime_error("Held-out density differs from direct calculation");
  const m::GaussianMixture one(1,2);
  const auto repeated=n::ones({5,2},type);
  const auto floor=one.Step(repeated,{n::ones({1},type),n::zeros({1,2},type),
                                      n::eye(2,type).reshape({1,2,2})});
  near(floor.next.covariances.at({0,0,0}),1e-4,1e-12);
  if(!std::isfinite(one.Step(repeated,floor.next).log_likelihood))
    throw std::runtime_error("Covariance floor did not stabilize identical rows");
  dm::graphics::RPlot::create().lines(iterations,likelihood,"EM likelihood",{37,99,235})
      .title("Full-covariance EM improves training likelihood").x_label("Accepted update")
      .y_label("Training log likelihood").size(850,420).save_svg("build/gaussian_mixtures_em.svg");
  std::print("EM accepted {} updates: training likelihood {:.3f} to {:.3f}. Held-out mean log density {:.6f}; direct error {:.2e}.\n",
             iterations.size()-1,likelihood.front(),likelihood.back(),held.log_likelihood/500.,worst);
}
```
// result_begin: markdown
EM accepted 7 updates: training likelihood -5727.651 to -2349.227. Held-out mean log density -2.431879; direct error 3.55e-15.
\image(figures/gaussian_mixtures_em.svg)
// result_end
\caption(Observed-data log likelihood increases as the three components adapt their masses, means and covariances.)
\alttext(The training log likelihood rises from its seeded starting point and levels off as EM converges.)

> Conclusion

The symmetric posterior agrees with its analytic sigmoid. Direct tensor Adam improves the
six-point observed-data likelihood while preserving normalised masses and the variance bound.
On the correlated fixture, full-covariance EM recovers all three groups and agrees with direct held-out density calculations.

> References

- [Dempster, Laird and Rubin (1977), Maximum likelihood from incomplete data via the EM algorithm](https://doi.org/10.1111/j.2517-6161.1977.tb01600.x).
