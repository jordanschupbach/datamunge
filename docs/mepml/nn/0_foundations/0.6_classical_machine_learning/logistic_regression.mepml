>> Multinomial normalization

```{cpp, results="markdown", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)", id=chunk-04, cache=yes}
#include <dm/dm.hpp>
int main() {
  namespace n = dm::nn;
  const auto z = n::tensor({0, std::log(2.), std::log(3.)}, {1, 3}, n::DType::Float64),
             p = n::softmax(z, 1);
  if (std::abs(n::sum(p).item() - 1) > 1e-12)
    return 1;
  std::print("Three-class probabilities: {}.\n", p.to_vector<double>());
}
```
// result_begin: markdown
Three-class probabilities: [0.16666666666666666, 0.3333333333333333, 0.5].
// result_end


> Held-out binary and multinomial fits

Simulated binary outcomes give a known probability for every new row.
Compare fitted probabilities to those probabilities as well as reporting
held-out classification accuracy. In the three-class fit, each query has
one normalized softmax vector and the confusion table counts its prediction.

```{cpp, results="markdown", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)", id=chunk-05, cache=yes}
#include <dm/dm.hpp>
int main() {
  namespace n=dm::nn;
  constexpr auto type=n::DType::Float64;
  std::mt19937 binary_rng(31);
  std::normal_distribution<float> normal;
  std::uniform_real_distribution<float> uniform;
  auto binary=[&](int size) {
    std::vector<double> x,y,probability;
    for(int i=0;i<size;++i) {
      const float a=normal(binary_rng),b=normal(binary_rng);
      const float p=1/(1+std::exp(-(-.4f+1.5f*a-2.f*b)));
      x.insert(x.end(),{1.,a,b});
      y.push_back(uniform(binary_rng)<p);
      probability.push_back(p);
    }
    return std::tuple{n::from_vector(x,{size,3}),n::from_vector(y,{size,1}),
                      n::from_vector(probability,{size,1})};
  };
  {
    const auto [x,y,training_probability]=binary(1200);
    const auto [q,target,known]=binary(600);
    auto w=n::zeros({3,1},type).requires_grad_();
    const auto mask=n::tensor({0,1,1},{3,1},type);
    n::Optimizer adam({w},.04,{.kind=n::OptimizerKind::Adam});
    auto objective=[&] {
      return n::sigmoid_cross_entropy(n::matmul(x,w),y,n::Reduction::Mean)+
             .005*n::sum(mask*n::square(w));
    };
    for(int step=0;step<400;++step) adam.minimize(objective());
    const double gradient=n::max(n::abs(n::grad(objective(),{w}).front())).item();
    const auto logits=n::matmul(q,w),p=n::sigmoid(logits);
    const double loss=n::sigmoid_cross_entropy(logits,target,n::Reduction::Mean).item();
    const double accuracy=n::mean(n::cast(n::equal(n::cast(n::greater_equal(p,.5),type),target),type)).item();
    const double probability_error=n::mean(n::abs(p-known)).item();
    if(gradient>1e-5||loss>=.5||accuracy<=.75||probability_error>=.06)
      throw std::runtime_error("Binary fit failed its held-out reference");
    std::print("Binary held-out NLL {:.5f}, accuracy {:.2f}%, mean probability error {:.5f}.\n\n",
               loss,100*accuracy,probability_error);
  }
  std::mt19937 multi_rng(47);
  std::normal_distribution<float> noise(0,.55f);
  auto multi=[&](int size) {
    std::vector<double> x;
    std::vector<int> y;
    for(int i=0;i<size;++i) {
      const int c=i%3;
      const double angle=2*std::numbers::pi*c/3;
      x.insert(x.end(),{2*std::cos(angle)+noise(multi_rng),2*std::sin(angle)+noise(multi_rng)});
      y.push_back(c);
    }
    return std::pair{n::from_vector(x,{size,2}),n::from_vector(y)};
  };
  const auto [x,y]=multi(450);
  const auto [q,target]=multi(300);
  n::ParameterStore store(19,type);
  auto predict=[&](const n::Tensor& input) { return n::dense(store,"logits",input,3); };
  (void)predict(x);
  const auto w=store.at("logits/W");
  n::Optimizer adam(store,.04,{.kind=n::OptimizerKind::Adam});
  for(int step=0;step<300;++step)
    adam.minimize(n::sparse_softmax_cross_entropy(predict(x),y)+.001*n::sum(n::square(w)));
  const auto logits=predict(q),p=n::softmax(logits,1),ids=n::argmax(p,1);
  const double loss=n::sparse_softmax_cross_entropy(logits,target).item();
  const double accuracy=n::mean(n::cast(n::equal(ids,target),type)).item();
  if(loss>=.1 || accuracy<=.97 || n::max(n::abs(n::sum(p,{1})-1)).item()>1e-12)
    throw std::runtime_error("Multinomial fit failed its held-out reference");
  std::array<std::array<int,3>,3> confusion{};
  for(int i=0;i<300;++i) ++confusion.at(target.at({i})).at(ids.at({i}));
  std::print("Multinomial held-out NLL {:.5f}, accuracy {:.2f}%.\n\n",loss,100*accuracy);
  std::print("| True class | Predicted 0 | Predicted 1 | Predicted 2 |\n| ---: | ---: | ---: | ---: |\n");
  for(int c=0;c<3;++c)
    std::print("| {} | {} | {} | {} |\n",c,confusion[c][0],confusion[c][1],confusion[c][2]);
}
```
// result_begin: markdown
Binary held-out NLL 0.41616, accuracy 80.00%, mean probability error 0.04024.

Multinomial held-out NLL 0.01575, accuracy 100.00%.

| True class | Predicted 0 | Predicted 1 | Predicted 2 |
| ---: | ---: | ---: | ---: |
| 0 | 100 | 0 | 0 |
| 1 | 0 | 100 | 0 |
| 2 | 0 | 0 | 100 |
// result_end

> Conclusion

The fitted grouped frequencies agree with the exact finite optimum, and extreme logits retain
finite losses and correct scores. Probability normalization is necessary but does not establish
calibration or decision utility on new observations.

> References

- [TensorFlow sigmoid cross entropy with logits: stable formulation](https://www.tensorflow.org/api_docs/python/tf/nn/sigmoid_cross_entropy_with_logits).
