> Actual selected work and sensitivity

```{cpp, results="markdown", file="figures/self_organizing_map_work.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
  namespace a = dm::algorithms;
  namespace g = dm::graphics;
  std::filesystem::create_directories("build");
  namespace n = dm::nn;
  n::set_num_threads(2);
  auto                data = a::som_three_blob_example();
  std::vector<double> x, y;
  std::print(
      "| grid side | actual codebook units | explicit completed SGD updates | actual tensor "
      "quantization error |\n| ---: | ---: | ---: | ---: |\n");
  for (std::size_t side : {1, 3, 5}) {
    a::SOMParameters params;
    params.rows = params.cols  = side;
    params.iterations          = 2000;
    params.learning_rate       = .5;
    params.seed                = 1;
    auto               plan    = n::som_tensor_plan(data.inputs, params);
    auto               weights = plan.initial_weights.clone().requires_grad_();
    n::OptimizerConfig config;
    config.kind = n::OptimizerKind::Sgd;
    n::Optimizer optimizer(std::vector<n::Tensor>{weights}, params.learning_rate, config);
    for (std::size_t t = 0; t < plan.sample_indices.size(); ++t) {
      auto id = n::from_vector(
          std::vector<std::int64_t>{static_cast<std::int64_t>(plan.sample_indices[t])});
      auto sample = n::gather(plan.inputs, id, 0).reshape({plan.inputs.size(1)});
      auto step   = n::som_neighborhood_objective(weights, sample, plan.grid, plan.radii[t]);
      optimizer.set_learning_rate(plan.learning_rates[t]);
      optimizer.minimize(step.objective);
    }
    const auto error = n::som_tensor_quantization_error(weights, plan.inputs).item();
    std::print("| {} | {} | {} | {} |\n", side, side * side, plan.sample_indices.size(), error);
    x.push_back(side * side);
    y.push_back(error);
  }
  auto plot = g::RPlot::create();
  plot.lines(x, y, "actual values", {37, 99, 235})
      .points(x, y, {37, 99, 235}, 5)
      .title("Explicit2000-step tensor fits at three map capacities")
      .x_label("actual codebook units")
      .y_label("actual training quantization error");
  plot.save_svg("build/self_organizing_map_work.svg");
}
```
