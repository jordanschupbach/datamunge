> The retained original experiment

```{cpp, results="markdown", file="figures/self_organizing_map_original.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
  namespace a = dm::algorithms;
  namespace g = dm::graphics;
  std::filesystem::create_directories("build");
  namespace n = dm::nn;
  n::set_num_threads(2);
  auto             data = a::som_three_blob_example();
  a::SOMParameters params;
  params.rows = params.cols  = 5;
  params.iterations          = 4000;
  params.learning_rate       = .5;
  params.seed                = 1;
  auto               plan    = n::som_tensor_plan(data.inputs, params);
  auto               weights = plan.initial_weights.clone().requires_grad_();
  n::OptimizerConfig config;
  config.kind = n::OptimizerKind::Sgd;
  n::Optimizer optimizer(std::vector<n::Tensor>{weights}, params.learning_rate, config);
  std::print(
      "| actual completed updates before step | actual sampled row | actual winner | current "
      "frozen-winner objective | scheduled learning rate | scheduled radius | actual tensor "
      "quantization error |\n| ---: | ---: | ---: | ---: | ---: | ---: | ---: |\n");
  for (std::size_t t = 0; t < plan.sample_indices.size(); ++t) {
    auto id = n::from_vector(
        std::vector<std::int64_t>{static_cast<std::int64_t>(plan.sample_indices[t])});
    auto input = n::gather(plan.inputs, id, 0).reshape({plan.inputs.size(1)});
    auto step  = n::som_neighborhood_objective(weights, input, plan.grid, plan.radii[t]);
    optimizer.set_learning_rate(plan.learning_rates[t]);
    if (t % 400 == 0)
      std::print(
          "| {} | {} | {} | {} | {} | {} | {} |\n",
          t,
          plan.sample_indices[t],
          step.winner,
          step.objective.item(),
          plan.learning_rates[t],
          plan.radii[t],
          n::som_tensor_quantization_error(weights, plan.inputs).item());
    optimizer.minimize(step.objective);
  }
  auto centers     = n::from_vector(std::vector<double>{0, 0, 10, 1, 4, 9}, {3, 2});
  auto assignments = n::som_assignments(weights, centers);
  auto reference   = a::som_train_run(data.inputs, params);
  std::print(
      "\nOriginal generating-center actual tensor unit ids `{}`; final tensor quantization error "
      "{}, scalar reference error {}.\n",
      assignments.to_vector<std::int64_t>(),
      n::som_tensor_quantization_error(weights, plan.inputs).item(),
      a::som_quantization_error(reference.model, data.inputs));
  auto plot = n::som_lattice_plot(weights, plan.inputs, 5, 5, data.labels);
  plot.title("Original three blobs: actual4000-step native tensor SOM");
  plot.save_svg("build/self_organizing_map_original.svg");
}
```
