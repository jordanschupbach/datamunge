> Explicit controls

```{cpp, results="markdown", file="figures/self_organizing_map_controls.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
  namespace a = dm::algorithms;
  namespace g = dm::graphics;
  std::filesystem::create_directories("build");
  namespace n                 = dm::nn;
  auto                weights = n::from_vector(std::vector<double>{0, 2}, {2, 1}).requires_grad_();
  auto                sample  = n::from_vector(std::vector<double>{1});
  auto                grid    = n::from_vector(std::vector<double>{0, 0, 0, 1}, {2, 2});
  std::vector<double> x, y;
  std::print(
      "| radius | actual lowest-index winner | actual winner influence | actual neighbor influence "
      "| actual weighted objective |\n| ---: | ---: | ---: | ---: | ---: |\n");
  for (double sigma : {.1, .5, 1., 2., 10.}) {
    auto step      = n::som_neighborhood_objective(weights, sample, grid, sigma);
    auto influence = step.influence.to_vector<double>();
    std::print(
        "| {} | {} | {} | {} | {} |\n",
        sigma,
        step.winner,
        influence[0],
        influence[1],
        step.objective.item());
    x.push_back(sigma);
    y.push_back(influence[1]);
  }
  auto plot = g::RPlot::create();
  plot.lines(x, y, "actual values", {37, 99, 235})
      .points(x, y, {37, 99, 235}, 5)
      .title("Exact winner tie, fixed topology and tensor neighborhood sensitivity")
      .x_label("radius")
      .y_label("actual neighbor influence after cutoff");
  plot.save_svg("build/self_organizing_map_controls.svg");
}
```
