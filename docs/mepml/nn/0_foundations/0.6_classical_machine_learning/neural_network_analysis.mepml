> Preserve the architecture sweep, with an explicit selection caveat

The original five architectures are affine,4,16,16+16 and64+64 hidden units, all using ReLU where hidden layers exist. The same350/150 split and500-epoch SGD schedule are retained. Actual ParameterStore counts accompany the freshly computed held-out accuracy. More parameters enlarge the function class but do not guarantee better optimization or held-out performance. Because this sweep repeatedly inspects the same held-out set, using it to choose an architecture would make that set a validation set; a new test set or nested validation would be required for an unbiased final selected-model assessment.

```{cpp, results="markdown", file="figures/neural_capacity.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <datamunge/nn/nn.hpp>
#include <datamunge/nn/tabular_classification.hpp>
#include <filesystem>
#include <print>
int main() {
  namespace n     = dm::nn;
  namespace study = n::study;
  n::set_num_threads(2);
  std::filesystem::create_directories("build");
  auto data    = study::moon_classification_data();
  auto split   = study::tabular_classification_split(data.features.size(0), .7, 11);
  auto scaling = study::fit_tabular_standardization(n::take_rows(data.features, split.training));
  auto tx = study::transform_tabular_features(n::take_rows(data.features, split.training), scaling),
       vx = study::transform_tabular_features(n::take_rows(data.features, split.heldout), scaling),
       ty = n::take_rows(data.labels, split.training),
       vy = n::take_rows(data.labels, split.heldout);
  std::vector<std::vector<std::int64_t>> architectures{{}, {4}, {16}, {16, 16}, {64, 64}};
  std::vector<std::string>               names{"affine", "4", "16", "16+16", "64+64"};
  std::vector<double>                    scores;
  std::print(
      "| hidden architecture | actual parameters | actual updates | held-out accuracy |\n| --- | "
      "---: | ---: | ---: |\n");
  for (std::size_t a = 0; a < architectures.size(); ++a) {
    n::ParameterStore parameters(5);
    auto              logits = [&](const n::Tensor& x) {
      auto h = n::mlp(parameters, "hidden", x, architectures[a], n::Activation::Relu);
      return n::dense(parameters, "output", h, 2);
    };
    {
      n::NoGradGuard guard;
      logits(n::take_rows(tx, {0}));
    }
    n::OptimizerConfig config;
    config.kind = n::OptimizerKind::Sgd;
    n::Optimizer  optimizer(parameters, .05, config);
    n::BatchOrder batches(tx.size(0), 32, 5);
    for (int e = 0; e < 500; ++e) {
      batches.begin_epoch();
      for (auto rows = batches.next(); !rows.empty(); rows = batches.next()) {
        auto objective =
            n::sparse_softmax_cross_entropy(logits(n::take_rows(tx, rows)), n::take_rows(ty, rows));
        optimizer.minimize(objective);
      }
    }
    n::NoGradGuard guard;
    double         acc = n::accuracy(logits(vx), vy);
    scores.push_back(acc);
    std::print(
        "| {} | {} | {} | {} |\n", names[a], parameters.count(), optimizer.iterations(), acc);
  }
  auto plot = dm::graphics::RPlot::barplot(scores, names, "held-out fraction");
  plot.title("Original moons capacity sweep: fixed training budget")
      .x_label("hidden widths")
      .y_label("held-out accuracy")
      .y_limits(0, 1.05)
      .save_svg("build/neural_capacity.svg");
}
```
