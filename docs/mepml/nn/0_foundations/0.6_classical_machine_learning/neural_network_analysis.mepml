> Iris with exactly two measured predictors

The bundled150-row Iris dataset contributes only Petal.Length and Petal.Width. A seed2024 shuffle retains the original105/45 training/held-out split. Training-only standardization,16 ReLU units, SGD at0.05,600 epochs, batches32, initializer/batch seed42 and no L2 penalty are explicit. Four batches per epoch include the final9 rows, producing2400 updates. The16-unit model has99 scalar parameters:2·16+16+16·3+3.

The decision grid is evaluated in raw petal units through the fitted tensor model and frozen training statistics. Colored points are training observations; the reported NLL and accuracy use only the45 held-out observations. This is one fixed architecture, not Bayesian hyperparameter tuning. The independent README binding demonstration remains a separate study.

```{cpp, results="markdown", file="figures/neural_iris.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <datamunge/nn/nn.hpp>
#include <datamunge/nn/tabular_classification.hpp>
#include <filesystem>
#include <print>
int main() {
  namespace n     = dm::nn;
  namespace study = n::study;
  n::set_num_threads(2);
  std::filesystem::create_directories("build");
  auto data    = study::iris_petal_classification_data();
  auto split   = study::tabular_classification_split(data.features.size(0), .7, 2024);
  auto raw     = n::take_rows(data.features, split.training),
       ty      = n::take_rows(data.labels, split.training),
       vy      = n::take_rows(data.labels, split.heldout);
  auto scaling = study::fit_tabular_standardization(raw);
  auto tx      = study::transform_tabular_features(raw, scaling),
       vx = study::transform_tabular_features(n::take_rows(data.features, split.heldout), scaling);
  n::ParameterStore parameters(42);
  auto              logits = [&](const n::Tensor& input) {
    auto h = n::dense(parameters, "hidden", input, 16, n::Activation::Relu);
    return n::dense(parameters, "output", h, 3);
  };
  {
    n::NoGradGuard guard;
    logits(n::take_rows(tx, {0}));
  }
  n::OptimizerConfig config;
  config.kind = n::OptimizerKind::Sgd;
  n::Optimizer  optimizer(parameters, .05, config);
  n::BatchOrder batches(tx.size(0), 32, 42);
  for (int e = 0; e < 600; ++e) {
    batches.begin_epoch();
    for (auto rows = batches.next(); !rows.empty(); rows = batches.next()) {
      auto objective =
          n::sparse_softmax_cross_entropy(logits(n::take_rows(tx, rows)), n::take_rows(ty, rows));
      optimizer.minimize(objective);
    }
  }
  n::NoGradGuard guard;
  auto           z = logits(vx);
  std::print(
      "Training rows {}, held-out rows {}, features {}, parameters {}, updates {}.\n\nHeld-out "
      "accuracy {}; NLL {}.\n",
      tx.size(0),
      vx.size(0),
      tx.size(1),
      parameters.count(),
      optimizer.iterations(),
      n::accuracy(z, vy),
      n::sparse_softmax_cross_entropy(z, vy).item());
  auto plot = study::tabular_decision_regions(raw, ty, data.classes, [&](const auto& q) {
    return logits(study::transform_tabular_features(q, scaling));
  });
  plot.title("Iris: explicit tensor SGD, two petal predictors")
      .x_label(data.predictors[0])
      .y_label(data.predictors[1])
      .save_svg("build/neural_iris.svg");
}
```
