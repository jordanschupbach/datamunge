> Inspect the actual held-out confusion matrix

The complete program below independently reproduces the same seeded fit and sends its actual held-out truth IDs and argmax logits to ConfusionMatrix. Rows run from true class top to bottom; columns run from predicted class left to right. Cells show raw integer counts, with no normalization or ignored labels. Their total is45. Unlike the original training-only confusion summary, this image directly accompanies the held-out metrics.

```{cpp, results="markdown", file="figures/neural_confusion.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <datamunge/nn/nn.hpp>
#include <datamunge/nn/tabular_classification.hpp>
#include <filesystem>
#include <print>
int main() {
  namespace n     = dm::nn;
  namespace study = n::study;
  n::set_num_threads(2);
  std::filesystem::create_directories("build");
  auto data    = study::iris_petal_classification_data();
  auto split   = study::tabular_classification_split(data.features.size(0), .7, 2024);
  auto raw     = n::take_rows(data.features, split.training),
       ty      = n::take_rows(data.labels, split.training),
       vy      = n::take_rows(data.labels, split.heldout);
  auto scaling = study::fit_tabular_standardization(raw);
  auto tx      = study::transform_tabular_features(raw, scaling),
       vx = study::transform_tabular_features(n::take_rows(data.features, split.heldout), scaling);
  n::ParameterStore parameters(42);
  auto              logits = [&](const n::Tensor& input) {
    auto h = n::dense(parameters, "hidden", input, 16, n::Activation::Relu);
    return n::dense(parameters, "output", h, 3);
  };
  {
    n::NoGradGuard guard;
    logits(n::take_rows(tx, {0}));
  }
  n::OptimizerConfig config;
  config.kind = n::OptimizerKind::Sgd;
  n::Optimizer  optimizer(parameters, .05, config);
  n::BatchOrder batches(tx.size(0), 32, 42);
  for (int e = 0; e < 600; ++e) {
    batches.begin_epoch();
    for (auto rows = batches.next(); !rows.empty(); rows = batches.next()) {
      auto objective =
          n::sparse_softmax_cross_entropy(logits(n::take_rows(tx, rows)), n::take_rows(ty, rows));
      optimizer.minimize(objective);
    }
  }
  n::NoGradGuard guard;
  auto           z = logits(vx);
  std::print(
      "Training rows {}, held-out rows {}, features {}, parameters {}, updates {}.\n\nHeld-out "
      "accuracy {}; NLL {}.\n",
      tx.size(0),
      vx.size(0),
      tx.size(1),
      parameters.count(),
      optimizer.iterations(),
      n::accuracy(z, vy),
      n::sparse_softmax_cross_entropy(z, vy).item());
  n::ConfusionMatrix matrix(3);
  matrix.add(vy, n::argmax(z, 1));
  matrix.save_svg(
      "build/neural_confusion.svg",
      {.title = "Actual held-out Iris predictions: 45 rows", .labels = data.classes});
  std::print(
      "| true class | predicted setosa | predicted versicolor | predicted virginica |\n| --- | "
      "---: | ---: | ---: |\n");
  for (std::size_t c = 0; c < data.classes.size(); ++c)
    std::print(
        "| {} | {} | {} | {} |\n",
        data.classes[c],
        matrix.cells()[c][0],
        matrix.cells()[c][1],
        matrix.cells()[c][2]);
}
```
// result_begin: markdown
