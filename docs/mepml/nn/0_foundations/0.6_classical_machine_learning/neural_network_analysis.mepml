> Retain the two interleaving moons and its held-out split

The native generator preserves250 observations per class, angular endpoints0 andπ, noise SD0.12, MT19937_64 seed3 and the original interleaved draw order. A seed11 row shuffle reserves350 training rows and150 held-out rows, without stratification. Only the350 training rows determine the column means and population SDs. Both subsets use those frozen values.

Compare affine logits with two ReLU layers of16 units. Each model uses SGD at0.05 for500 epochs, shuffled batches of32 with seed5, and no weight penalty. Eleven batches per epoch include the final30 rows, giving5500 updates. Model initialization also uses seed5. The layout contains both actual fitted regions and each actual epoch-end training loss; the held-out labels never enter the objective or a checkpoint decision. A fixed split is one finite generalization assessment, not a calibrated uncertainty interval.

```{cpp, results="markdown", file="figures/neural_moons.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <datamunge/nn/nn.hpp>
#include <datamunge/nn/tabular_classification.hpp>
#include <filesystem>
#include <print>
int main() {
  namespace n     = dm::nn;
  namespace study = n::study;
  n::set_num_threads(2);
  std::filesystem::create_directories("build");
  auto data    = study::moon_classification_data();
  auto split   = study::tabular_classification_split(data.features.size(0), .7, 11);
  auto raw     = n::take_rows(data.features, split.training),
       ty      = n::take_rows(data.labels, split.training),
       vy      = n::take_rows(data.labels, split.heldout);
  auto scaling = study::fit_tabular_standardization(raw);
  auto tx      = study::transform_tabular_features(raw, scaling),
       vx = study::transform_tabular_features(n::take_rows(data.features, split.heldout), scaling);
  auto layout = dm::graphics::RLayout::create(2, 2);
  std::print(
      "| model | parameters | updates | held-out correct fraction | held-out NLL |\n| --- | ---: | "
      "---: | ---: | ---: |\n");
  for (bool hidden : {false, true}) {
    n::ParameterStore parameters(5);
    auto              logits = [&](const n::Tensor& input) {
      auto h = hidden ? n::mlp(parameters, "hidden", input, {16, 16}, n::Activation::Relu) : input;
      return n::dense(parameters, "output", h, 2);
    };
    {
      n::NoGradGuard guard;
      logits(n::take_rows(tx, {0}));
    }
    n::OptimizerConfig config;
    config.kind = n::OptimizerKind::Sgd;
    n::Optimizer        optimizer(parameters, .05, config);
    n::BatchOrder       batches(tx.size(0), 32, 5);
    std::vector<double> epoch, loss;
    for (int e = 0; e < 500; ++e) {
      batches.begin_epoch();
      for (auto rows = batches.next(); !rows.empty(); rows = batches.next()) {
        auto objective =
            n::sparse_softmax_cross_entropy(logits(n::take_rows(tx, rows)), n::take_rows(ty, rows));
        optimizer.minimize(objective);
      }
      n::NoGradGuard guard;
      epoch.push_back(e + 1);
      loss.push_back(n::sparse_softmax_cross_entropy(logits(tx), ty).item());
    }
    n::NoGradGuard guard;
    auto           z    = logits(vx);
    std::string    name = hidden ? "16,16 ReLU" : "affine";
    std::print(
        "| {} | {} | {} | {} | {} |\n",
        name,
        parameters.count(),
        optimizer.iterations(),
        n::accuracy(z, vy),
        n::sparse_softmax_cross_entropy(z, vy).item());
    auto regions = study::tabular_decision_regions(raw, ty, data.classes, [&](const auto& q) {
      return logits(study::transform_tabular_features(q, scaling));
    });
    regions.title("Moons: " + name).x_label("x").y_label("y");
    layout.add(regions);
    auto curve = dm::graphics::RPlot::create();
    curve.lines(epoch, loss, "training NLL", {36, 105, 172})
        .title(name + ": actual training objective")
        .x_label("epoch")
        .y_label("mean NLL");
    layout.add(curve);
  }
  layout.fit_panels().save_svg("build/neural_moons.svg");
}
```
