int main(){auto archive=dm::nn::load_npz("build/bandit_algorithms_source.npz");auto get=[&](const std::string& name){auto it=std::find_if(archive.begin(),archive.end(),[&](const auto& p){return p.first==name;});if(it==archive.end())throw std::runtime_error("missing source series "+name);return it->second.to_vector<double>();};auto plot=dm::graphics::RPlot::create();{auto values=get("regret_0");std::vector<double>x;x.resize(values.size());std::iota(x.begin(),x.end(),1.);plot.lines(x,values,"Gaussian greedy",{37,99,235});}{auto values=get("regret_1");std::vector<double>x;x.resize(values.size());std::iota(x.begin(),x.end(),1.);plot.lines(x,values,"Gaussian eps.01",{234,88,12});}{auto values=get("regret_2");std::vector<double>x;x.resize(values.size());std::iota(x.begin(),x.end(),1.);plot.lines(x,values,"Gaussian eps.1",{22,163,74});}{auto values=get("regret_3");std::vector<double>x;x.resize(values.size());std::iota(x.begin(),x.end(),1.);plot.lines(x,values,"Gaussian optimistic",{147,51,234});}{auto values=get("regret_4");std::vector<double>x;x.resize(values.size());std::iota(x.begin(),x.end(),1.);plot.lines(x,values,"Gaussian UCB2",{220,38,38});}{auto values=get("regret_5");std::vector<double>x;x.resize(values.size());std::iota(x.begin(),x.end(),1.);plot.lines(x,values,"Gaussian Thompson",{8,145,178});}{auto values=get("regret_6");std::vector<double>x;x.resize(values.size());std::iota(x.begin(),x.end(),1.);plot.lines(x,values,"Bernoulli eps.1",{190,24,93});}{auto values=get("regret_7");std::vector<double>x;x.resize(values.size());std::iota(x.begin(),x.end(),1.);plot.lines(x,values,"Bernoulli UCB1",{101,163,13});}{auto values=get("regret_8");std::vector<double>x;x.resize(values.size());std::iota(x.begin(),x.end(),1.);plot.lines(x,values,"Bernoulli Thompson",{71,85,105});}plot.title("bandit algorithms source results").x_label("Pull index (one based)").y_label("Cumulative expected regret").size(1150,650).save_svg("build/bandit_algorithms_results.svg");}
