> Inspect the actual experiment results

The plot averages the original full online reward histories in50-episode bins. The source greedy-evaluation table and1000-run maximization-bias experiment remain above; online return includes exploration costs.

```{cpp, results="markdown", file="figures/q_learning_results.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -lpthread -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main(){auto archive=dm::nn::load_npz("build/q_learning_source.npz");auto get=[&](const std::string& name){auto it=std::find_if(archive.begin(),archive.end(),[&](const auto& p){return p.first==name;});if(it==archive.end())throw std::runtime_error("missing source series "+name);return it->second.to_vector<double>();};auto plot=dm::graphics::RPlot::create();{auto values=get("online_0");std::vector<double>x;std::vector<double>binned;for(size_t start=0;start<values.size();start+=50){size_t end=std::min(values.size(),start+50);binned.push_back(std::accumulate(values.begin()+start,values.begin()+end,0.)/(end-start));x.push_back(end);}values=binned;plot.lines(x,values,"CliffWalking online",{37,99,235});}{auto values=get("online_1");std::vector<double>x;std::vector<double>binned;for(size_t start=0;start<values.size();start+=50){size_t end=std::min(values.size(),start+50);binned.push_back(std::accumulate(values.begin()+start,values.begin()+end,0.)/(end-start));x.push_back(end);}values=binned;plot.lines(x,values,"GridWorld online",{234,88,12});}plot.title("q learning source results").x_label("Training episode (50-episode bins)").y_label("Mean online task return").size(1150,650).save_svg("build/q_learning_results.svg");}
