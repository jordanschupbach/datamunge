> Inspect the actual experiment results

Each source per-episode history already averages20 runs. Further50-episode plotting bins reduce visual noise and use all500 episodes; greedy task returns are reported separately above.

```{cpp, results="markdown", file="figures/sarsa_results.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -lpthread -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main(){auto archive=dm::nn::load_npz("build/sarsa_source.npz");auto get=[&](const std::string& name){auto it=std::find_if(archive.begin(),archive.end(),[&](const auto& p){return p.first==name;});if(it==archive.end())throw std::runtime_error("missing source series "+name);return it->second.to_vector<double>();};auto plot=dm::graphics::RPlot::create();{auto values=get("online_0");std::vector<double>x;std::vector<double>binned;for(size_t start=0;start<values.size();start+=50){size_t end=std::min(values.size(),start+50);binned.push_back(std::accumulate(values.begin()+start,values.begin()+end,0.)/(end-start));x.push_back(end);}values=binned;plot.lines(x,values,"SARSA",{37,99,235});}{auto values=get("online_1");std::vector<double>x;std::vector<double>binned;for(size_t start=0;start<values.size();start+=50){size_t end=std::min(values.size(),start+50);binned.push_back(std::accumulate(values.begin()+start,values.begin()+end,0.)/(end-start));x.push_back(end);}values=binned;plot.lines(x,values,"expected SARSA",{234,88,12});}{auto values=get("online_2");std::vector<double>x;std::vector<double>binned;for(size_t start=0;start<values.size();start+=50){size_t end=std::min(values.size(),start+50);binned.push_back(std::accumulate(values.begin()+start,values.begin()+end,0.)/(end-start));x.push_back(end);}values=binned;plot.lines(x,values,"Q-learning",{22,163,74});}plot.title("sarsa source results").x_label("Training episode (50-episode bins)").y_label("Mean online task return").size(1150,650).save_svg("build/sarsa_results.svg");}
