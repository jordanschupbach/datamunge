> Inspect the actual experiment results

These are50-episode averages of the complete original return histories. Different methods retain their own run lengths and decaying exploration schedule; the greedy evaluation table above measures a separate policy.

```{cpp, results="markdown", file="figures/monte_carlo_control_results.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -lpthread -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main(){auto archive=dm::nn::load_npz("build/monte_carlo_control_source.npz");auto get=[&](const std::string& name){auto it=std::find_if(archive.begin(),archive.end(),[&](const auto& p){return p.first==name;});if(it==archive.end())throw std::runtime_error("missing source series "+name);return it->second.to_vector<double>();};auto plot=dm::graphics::RPlot::create();{auto values=get("return_0");std::vector<double>x;std::vector<double>binned;for(size_t start=0;start<values.size();start+=50){size_t end=std::min(values.size(),start+50);binned.push_back(std::accumulate(values.begin()+start,values.begin()+end,0.)/(end-start));x.push_back(end);}values=binned;plot.lines(x,values,"first-visit grid",{37,99,235});}{auto values=get("return_1");std::vector<double>x;std::vector<double>binned;for(size_t start=0;start<values.size();start+=50){size_t end=std::min(values.size(),start+50);binned.push_back(std::accumulate(values.begin()+start,values.begin()+end,0.)/(end-start));x.push_back(end);}values=binned;plot.lines(x,values,"every-visit grid",{234,88,12});}{auto values=get("return_2");std::vector<double>x;std::vector<double>binned;for(size_t start=0;start<values.size();start+=50){size_t end=std::min(values.size(),start+50);binned.push_back(std::accumulate(values.begin()+start,values.begin()+end,0.)/(end-start));x.push_back(end);}values=binned;plot.lines(x,values,"first-visit cliff",{22,163,74});}plot.title("monte carlo control source results").x_label("Training episode (50-episode bins)").y_label("Mean online task return").size(1150,650).save_svg("build/monte_carlo_control_results.svg");}
