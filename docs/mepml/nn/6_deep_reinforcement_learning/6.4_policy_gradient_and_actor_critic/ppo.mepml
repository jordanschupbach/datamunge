int main(){namespace n=dm::nn;namespace m=n::models;std::filesystem::create_directories("build");n::ParameterStore p(0),critic(1);n::Module network([&](const n::Tensor&x){auto path=m::BuildActorCritic(p,x,2,64);return n::concat({path.probs,n::expand_dims(path.value,1)},1);},"ppo source actor/value");n::ModelPlotOptions options;options.detail=n::ModelPlotDetail::Blocks;options.sizing.minimum_extent=2;options.sizing.max_planes=2;network.plot(n::zeros({1,4}),options).save_svg("build/ppo_network.svg");}
