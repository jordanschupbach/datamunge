int main(){std::filesystem::create_directories("build");dm::graphics::Diagram d(29,1200);dm::graphics::DiagramNodeStyle s;s.width=14;s.height=5;s.font_size=23;d.node("input",{-18,0},"Seeded observations / actions",s).node("targets",{0,0},"Stopped old policy -> Fisher solve -> KL line search",s).node("step",{18,0},"Caller objective / native update",s).edge("input","targets").edge("targets","step").save_svg("build/trpo_method.svg");}
