> Complete source interaction and fitting program

The default source run caps steps at512, warmup at32, minibatch size at8, and uses one evaluation episode at the final log. It retains native128-wide models, source seeds and all comparison variants. Full mode retains the source requested50000-step budget (40000 for Double-DQN/n-step comparisons). Set DATAMUNGE_EXAMPLES_FULL=1 in the mep process environment to opt into that distinct, longer experiment and its convergence assertions. Every loss, gradient/clipping/Adam step, target synchronization and episode loop is visible here.

```{cpp, results="output", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -lpthread -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
namespace report_capture {
inline dm::nn::NamedTensors arrays;inline int monitor_index=0,checkpoint_index=0;
template<class T>void Save(const std::string& name,const std::vector<T>&v){arrays.push_back({name,dm::nn::from_vector(v)});}
struct Checkpoint{dm::nn::ParameterStore& online;dm::nn::ParameterStore& target;~Checkpoint(){auto tag=std::to_string(checkpoint_index++);for(const auto& name:online.names())arrays.push_back({"online_"+tag+"_"+name,online.at(name).detach().clone()});for(const auto& name:target.names())arrays.push_back({"target_"+tag+"_"+name,target.at(name).detach().clone()});}};
struct Flush{~Flush(){if(!arrays.empty()){std::filesystem::create_directories("build");dm::nn::save_npz("build/noisy_networks_source.npz",arrays);}}};inline Flush flush;
}
// CMD: just run-nn noisy_networks
// Noisy networks for exploration.
//
// Port of tflow's noisy_networks. Instead of epsilon-greedy, every linear
// layer gets learnable noise: W = mu + sigma * eps with factorised Gaussian
// eps resampled on each forward pass (Fortunato et al. 2018; nn::noisy_dense).
// The agent acts greedily on its noisy Q-values, so exploration is
// state-dependent and the network can learn to switch it off by shrinking
// sigma. Epsilon is 0 throughout; the noise is disabled (noise_scale = 0)
// only for evaluation. The mean |sigma| is logged to show the noise being
// annealed by gradient descent rather than by a schedule.
//
// In TF the networks, loss and Adam were one graph; here they are eager nn
// ops over two ParameterStores (the target under NoGradGuard). CartPole and
// replay sampling use the same std::mt19937_64 streams as TF; the weights and
// the weight noise come from nn's generators (TF used its RandomNormal op),
// so the results match TF statistically. The vsim video of the best
// evaluation episode is omitted. Options: the rl::DqnConfig keys (steps=,
// lr=, seed=, ...).


// Editable workflow support: checks.hpp
// Small runtime checks used by the executable nn examples. They stay on in
// Release builds and make the example exit nonzero on failure, so `just
// run-all-nn` doubles as a regression test against the recorded TF numbers.

// Editable workflow support: runtime.hpp
// Bounded demonstrations by default; opt into convergence experiments explicitly.


namespace example_runtime {

inline bool Full() {
  const char* value = std::getenv("DATAMUNGE_EXAMPLES_FULL");
  return value && std::string(value) == "1";
}

template <typename T> T Limit(T requested, T quick_limit) {
  return Full() ? requested : std::min(requested, quick_limit);
}

inline void Describe() {
  if (!Full())
    std::cout << "Quick demonstration: bounded training; convergence metrics require "
                 "DATAMUNGE_EXAMPLES_FULL=1.\n";
}

}  // namespace example_runtime

namespace check {

inline void Require(bool condition, const std::string& message) {
  if (!condition) throw std::runtime_error(message);
}

// A short demonstration checks execution, derivatives and persistence; reaching
// a published accuracy/return requires the separately requested full schedule.
inline void TrainingQuality(bool condition, const std::string& message) {
  if (example_runtime::Full()) Require(condition, message);
  else std::cout << "  full-training quality check deferred: " << message << '\n';
}

inline void Near(double actual, double expected, double tolerance, const std::string& message) {
  if (!std::isfinite(actual) || !std::isfinite(expected) || std::abs(actual - expected) > tolerance)
    throw std::runtime_error(message + ": got " + std::to_string(actual) + ", expected " + std::to_string(expected));
}

/// Expects `f` to throw; returns the message.
template <typename F>
std::string Throws(F&& f, const std::string& message) {
  try {
    f();
  } catch (const std::exception& e) {
    return e.what();
  }
  throw std::runtime_error(message + ": expected an exception");
}

}  // namespace check

inline void Header(const std::string& title) {
  const std::size_t pad = title.size() < 60 ? 60 - title.size() : 0;
  std::cout << "\n== " << title << " " << std::string(pad, '=') << "\n";
}

