// Editable workflow support: rl/utils.hpp
// datamunge::nn port: copied from tflow_examples src/common/rl/utils.h (TF-free code, unchanged).
// Small helpers shared by the RL examples: episode statistics, random and
// greedy rollouts, and printing.



namespace rl {

struct EpisodeStats {
  std::vector<float> returns;
  std::vector<int> lengths;
  float mean_return() const {
    return returns.empty() ? 0.f
                           : std::accumulate(returns.begin(), returns.end(), 0.f) / returns.size();
  }
  float mean_length() const {
    return lengths.empty() ? 0.f
                           : std::accumulate(lengths.begin(), lengths.end(), 0.f) / lengths.size();
  }
  float min_return() const { return *std::min_element(returns.begin(), returns.end()); }
  float max_return() const { return *std::max_element(returns.begin(), returns.end()); }
};

// Run `episodes` episodes of `env` choosing actions with `policy(obs)`.

// Uniformly random actions.

inline void PrintStats(const std::string& label, const EpisodeStats& s) {
  std::printf("  %-32s return mean %8.2f  min %8.2f  max %8.2f   length mean %6.1f\n",
              label.c_str(), s.mean_return(), s.min_return(), s.max_return(), s.mean_length());
}

using dm::rl::foundations::ArgMax;using dm::rl::foundations::ArgMaxRandomTie;
inline std::string FormatObs(const Obs& o, int max_elems = 8) {
  std::string s = "[";
  for (size_t i = 0; i < o.size() && static_cast<int>(i) < max_elems; ++i) {
    char buf[32];
    std::snprintf(buf, sizeof buf, "%s%.3f", i ? " " : "", o[i]);
    s += buf;
  }
  if (static_cast<int>(o.size()) > max_elems) s += " ...";
  return s + "]";
}

}  // namespace rl


namespace rl {

namespace nn = datamunge::nn;

struct DqnConfig {
  int steps = 50000;          // environment steps
  int warmup = 1000;          // steps before training starts
  int batch = 64;
  int buffer = 50000;
  float gamma = 0.98f;        // 0.99 is the usual choice; 0.98 bounds Q by 50 and makes CartPole far more stable
  float lr = 5e-4f;
  float clip_norm = 10.f;
  int target_sync = 500;      // hard target update period (steps), used when tau == 1
  float tau = 0.005f;         // target <- tau * online + (1 - tau) * target every step; tau = 1 means a hard copy every target_sync steps
  float eps_start = 1.f, eps_end = 0.05f;
  int eps_decay_steps = 10000;
  int hidden = 128;
  int train_every = 2;
  int log_every = 5000;
  int eval_every = 5000;
  int eval_episodes = 5;
  uint64_t seed = 0;
};

// TF-only options that the ports accept and ignore.
inline bool IsHardwareOption(const std::string& key) {
  return key == "device" || key == "threads" || key == "intra_threads" || key == "inter_threads" || key == "xla";
}

// Overrides from the command line, e.g. `just run-nn dqn steps=50000 lr=5e-4`.
inline void ParseConfig(int argc, char** argv, DqnConfig* c) {
  for (int i = 1; i < argc; ++i) {
    const std::string arg = argv[i];
    const size_t eq = arg.find('=');
    if (eq == std::string::npos) continue;
    const std::string key = arg.substr(0, eq);
    const float v = std::strtof(arg.c_str() + eq + 1, nullptr);
    if (IsHardwareOption(key)) continue;
    if (key == "steps") c->steps = static_cast<int>(v);
    else if (key == "warmup") c->warmup = static_cast<int>(v);
    else if (key == "batch") c->batch = static_cast<int>(v);
    else if (key == "buffer") c->buffer = static_cast<int>(v);
    else if (key == "gamma") c->gamma = v;
    else if (key == "lr") c->lr = v;
    else if (key == "clip_norm") c->clip_norm = v;
    else if (key == "target_sync") c->target_sync = static_cast<int>(v);
    else if (key == "tau") c->tau = v;
    else if (key == "eps_start") c->eps_start = v;
    else if (key == "eps_end") c->eps_end = v;
    else if (key == "eps_decay_steps") c->eps_decay_steps = static_cast<int>(v);
    else if (key == "hidden") c->hidden = static_cast<int>(v);
    else if (key == "train_every") c->train_every = static_cast<int>(v);
    else if (key == "log_every") c->log_every = static_cast<int>(v);
    else if (key == "eval_every") c->eval_every = static_cast<int>(v);
    else if (key == "seed") c->seed = static_cast<uint64_t>(v);
    else if (key != "task" && key != "game") std::fprintf(stderr, "unknown option %s\n", arg.c_str());
  }

  if (!example_runtime::Full()) {
    c->steps = std::min(c->steps, 512);
    c->warmup = std::min(c->warmup, 32);
    c->batch = std::min(c->batch, 8);
    c->log_every = c->eval_every = std::max(1, c->steps);
    c->eval_episodes = 1;
    c->eps_decay_steps = std::min(c->eps_decay_steps, c->steps);
    example_runtime::Describe();
  }
}

inline float Epsilon(const DqnConfig& c, int step) {
  const float frac = std::min(1.f, static_cast<float>(step) / c.eps_decay_steps);
  return c.eps_start + frac * (c.eps_end - c.eps_start);
}

// Greedy evaluation with any action function.
inline float Evaluate(Env& env, const std::function<int(const Obs&)>& act, int episodes, uint64_t seed) {
  double total = 0;
  for (int e = 0; e < episodes; ++e) {
    Obs obs = env.reset(seed + e);
    while (true) {
      StepResult r = env.step(act(obs));
      total += r.reward;
      obs = r.obs;
      if (r.done()) break;
    }
  }
  return static_cast<float>(total / episodes);
}

// Tracks episode returns and losses and prints one line per log period.
class Monitor {
 public:
  explicit Monitor(const DqnConfig& cfg, const char* third_column = "eps") : cfg_(cfg) {
    std::printf("  %8s %8s %12s %7s %10s %10s\n", "step", "episodes", "return(20)", third_column, "loss", "eval");
  }
  void EndEpisode(float ret) { returns_.push_back(ret); }
  ~Monitor(){auto tag=std::to_string(id_);report_capture::Save("return_"+tag,returns_);report_capture::Save("step_"+tag,steps_);report_capture::Save("eval_"+tag,evaluation_);report_capture::Save("loss_"+tag,mean_losses_);}
  void AddLoss(float loss) { losses_.push_back(loss); }
  int episodes() const { return static_cast<int>(returns_.size()); }
  float RecentReturn(int n = 20) const {
    if (returns_.empty()) return 0.f;
    const size_t from = returns_.size() > static_cast<size_t>(n) ? returns_.size() - n : 0;
    return std::accumulate(returns_.begin() + from, returns_.end(), 0.f) / (returns_.size() - from);
  }
  void Log(int step, float eps, float eval_return) {
    const float loss = losses_.empty() ? 0.f : std::accumulate(losses_.begin(), losses_.end(), 0.f) / losses_.size();
    steps_.push_back(step);evaluation_.push_back(eval_return);mean_losses_.push_back(loss);
    losses_.clear();
    char eval[16];
    if (std::isnan(eval_return)) std::snprintf(eval, sizeof eval, "%10s", "");
    else std::snprintf(eval, sizeof eval, "%10.1f", eval_return);
    std::printf("  %8d %8d %12.1f %7.3f %10.4f %s\n", step, episodes(), RecentReturn(), eps, loss, eval);
    std::fflush(stdout);
  }

 private:
  int id_=report_capture::monitor_index++;std::vector<double>steps_,evaluation_,mean_losses_;
  DqnConfig cfg_;
  std::vector<float> returns_, losses_;
};

using dm::nn::models::ProjectDistribution;

// One observation as a [1, obs_dim] tensor.
inline nn::Tensor Row(const Obs& o) { return nn::from_vector(o, {1, static_cast<std::int64_t>(o.size())}); }

}  // namespace rl

// Editable workflow support: rl/replay.hpp
namespace rl {using dm::rl::replay::Experience;using dm::rl::replay::Batch;using dm::rl::replay::ReplayBuffer;using dm::rl::replay::PrioritizedReplay;using dm::rl::replay::NStepBuffer;}


namespace nn = datamunge::nn;
using nn::Tensor;

int main(int argc, char** argv) {
  try {
    rl::DqnConfig cfg;
    cfg.eps_start = cfg.eps_end = 0.f;  // exploration comes from the noise
    rl::ParseConfig(argc, argv, &cfg);
    rl::CartPole env, eval_env;
    const int obs_dim = env.obs_size(), A = env.action_space().n;
    std::printf("== NoisyNet Double DQN on CartPole, %d steps, epsilon 0\n", cfg.steps);

    nn::ParameterStore online(cfg.seed), target(cfg.seed + 1);
    nn::Generator noise(cfg.seed + 12345);  // the factorised weight noise
    auto q_net = [&](nn::ParameterStore& p, const Tensor& x, double noise_scale) {
return nn::models::NoisyQ(p,x,cfg.hidden,A,noise,noise_scale);
};
    {
      nn::NoGradGuard no_grad;
      q_net(online, nn::zeros({1, obs_dim}), 1.0);
      q_net(target, nn::zeros({1, obs_dim}), 1.0);
    }
    nn::Optimizer report_optimizer(online,cfg.lr,{nn::OptimizerKind::Adam});
  auto report_minimize=[&](const Tensor& loss){auto grads=nn::grad(loss,report_optimizer.parameters());if(cfg.clip_norm>0)grads=nn::clip_by_global_norm(grads,cfg.clip_norm).first;report_optimizer.step(grads);};
  report_capture::Checkpoint checkpoint{online,target};
    auto sync = [&] { target.copy_from(online, cfg.tau); };
    sync();
    // Mean |sigma| over all noisy weights, for logging.
    auto mean_sigma = [&] {
      double total = 0;
      int parts = 0;
      for (const std::string& name : online.names())
        if (name.find("sigma") != std::string::npos) {
          total += nn::mean(nn::abs(online.at(name))).item<float>();
          ++parts;
        }
      return static_cast<float>(total / parts);
    };
    const float sigma_start = mean_sigma();

    rl::ReplayBuffer buffer(cfg.buffer, obs_dim);
    rl::Monitor monitor(cfg, "sigma");
    std::mt19937_64 rng(cfg.seed);
    auto act_with = [&](const rl::Obs& o, double noise_scale) {
      nn::NoGradGuard no_grad;
      return rl::ArgMax(q_net(online, rl::Row(o), noise_scale).to_vector<float>());
    };
    auto noisy_greedy = [&](const rl::Obs& o) { return act_with(o, 1.0); };
    auto quiet_greedy = [&](const rl::Obs& o) { return act_with(o, 0.0); };

    std::printf("  (eval uses noise_scale = 0; the 'sigma' column is the mean |sigma| of the noisy weights)\n");
    rl::Obs obs = env.reset(cfg.seed);
    float ret = 0, best_eval = 0;
    for (int step = 1; step <= cfg.steps; ++step) {
      const int act = noisy_greedy(obs);
      rl::StepResult sr = env.step(act);
      buffer.Add({obs, act, sr.reward, sr.obs, sr.terminated ? 1.f : 0.f, {}});
      ret += sr.reward;
      obs = sr.obs;
      if (sr.done()) {
        monitor.EndEpisode(ret);
        ret = 0;
        obs = env.reset();
      }
      if (step >= cfg.warmup) {
        rl::Batch b = buffer.Sample(cfg.batch, rng);
        Tensor y;
        {  // Double DQN target, with noise in both networks as in TF's graph.
          nn::NoGradGuard no_grad;
          const Tensor a_star = nn::argmax(q_net(online, b.s2, 1.0), 1);
          const Tensor next_value = nn::sum(q_net(target, b.s2, 1.0) * nn::one_hot(a_star, A), {1});
          y = b.r + (cfg.gamma * (1.0 - b.done)) * next_value;
        }
        const Tensor q_a = nn::sum(q_net(online, b.s, 1.0) * nn::one_hot(b.a, A), {1});
        const Tensor loss = nn::mean(nn::huber(y - q_a), {0});
        report_minimize(loss);
        const float l = loss.item<float>();
        check::Require(std::isfinite(l), "finite TD loss");
        monitor.AddLoss(l);
      }
      if (cfg.tau < 1.f || step % cfg.target_sync == 0) sync();
      if (step % cfg.log_every == 0) {
        const float ev = step % cfg.eval_every == 0 ? rl::Evaluate(eval_env, quiet_greedy, cfg.eval_episodes, 1000 + step) : NAN;
        if (!std::isnan(ev)) best_eval = std::max(best_eval, ev);
        monitor.Log(step, mean_sigma(), ev);
      }
    }
    const float sigma_end = mean_sigma();
    const float quiet = rl::Evaluate(eval_env, quiet_greedy, 20, 777), noisy = rl::Evaluate(eval_env, noisy_greedy, 20, 777);
    std::printf("  final evaluation over 20 episodes: noise off %.1f, noise on %.1f\n", quiet, noisy);
    std::printf("  mean |sigma|: %.4f at the start, %.4f at the end\n", sigma_start, sigma_end);

    // A random policy averages about 22.
    check::Require(std::isfinite(sigma_end), "finite noise scales");
    check::TrainingQuality(std::max(best_eval, quiet) >= 150, "NoisyNet DQN learned to balance (best greedy evaluation >= 150)");
  } catch (const std::exception& e) {
    std::cerr << "FAILED: " << e.what() << "\n";
    return 1;
  }
  return 0;
}

```
