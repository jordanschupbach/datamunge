//? Title: Adversarial inverse reinforcement learning on a chain
//? Lang: en

> Adversarial inverse reinforcement learning on a chain

AIRL represents the discriminator score as a state-only reward plus
a potential difference between the successor and current state. Its
logit also subtracts the learner's log action probability. This
parameterization distinguishes the learned reward from the shaping term.

On the [five-state imitation chain|imitation_chain.mepml], expert
and learner occupancies are computed exactly. At each training step,
two discriminator updates use fixed occupancies and policy
probabilities. One actor update uses the shaped score as fixed and
differentiates through the learner's occupancy and log probabilities.

The plot shows the probability of reaching the goal in eight moves.
The saved checkpoints expose the reward, potential, score and losses.

[Fu, Luo and Levine (2018)|https://arxiv.org/abs/1710.11248]

```{cpp, results="markdown", file="figures/airl.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

int main() {
  namespace n=dm::nn;
  constexpr int states=5,actions=2,horizon=8;
  std::vector<int> successors;
  std::vector<float> transitions(states*actions*states);
  for (int cell=0;cell<states;++cell) {
    for (int action=0;action<actions;++action) {
      const int next=cell==4?4:std::clamp(cell+(action?1:-1),0,4);
      successors.push_back(next);
      transitions[(cell*actions+action)*states+next]=1;
    }
  }
  const auto dynamics=n::from_vector(transitions,{states*actions,states});
  const auto start=n::from_vector<float>({1,0,0,0,0});
  const auto occupancy=[&](const n::Tensor& policy) {
    return dm::rl::finite_policy_occupancy(policy,dynamics,start,horizon,.95f);
  };
  const auto expert=n::from_vector<float>({0,1,0,1,0,1,0,1,.5f,.5f},{states,actions});
  const auto expert_visits=occupancy(expert).first;
  n::ParameterStore actor,disc;
  const auto logits=actor.get("logits",{4,2},n::init::zeros());
  const auto reward=disc.get("reward",{states},n::init::zeros());
  const auto potential=disc.get("potential",{states},n::init::zeros());
  const auto next=n::from_vector(successors,{states,actions});
  n::Optimizer actor_adam(actor,.06,{.kind=n::OptimizerKind::Adam});
  n::Optimizer disc_adam(disc,.08,{.kind=n::OptimizerKind::Adam});
  const auto evaluate=[&] {
    const auto full=n::concat({logits,n::zeros({1,2})},0);
    const auto policy=n::softmax(full,-1);
    const auto [learner,final]=occupancy(policy);
    const auto losses=dm::rl::airl_occupancy_losses(learner,expert_visits,
        n::log_softmax(full,-1),reward,potential,next,.95f);
    return std::tuple{policy,learner,final,losses};
  };
  std::vector<double> success;
  std::filesystem::create_directories("build/airl");
  std::print("| Phase | Goal probability | Discriminator loss |\n|---:|---:|---:|\n");
  for (int phase=0;phase<=3;++phase) {
    if (phase) {
      for (int step=0;step<24;++step) {
        for (int i=0;i<2;++i) disc_adam.step(n::grad(std::get<3>(evaluate())[0],disc_adam.parameters()));
        actor_adam.step(n::grad(std::get<3>(evaluate())[1],{logits}));
      }
    }
    const n::NoGradGuard guard;
    const auto [policy,learner,final,losses]=evaluate();
    success.push_back(final.to_vector<float>()[4]);
    std::print("| {} | {:.6f} | {:.6f} |\n",phase,success.back(),losses[0].item());
    n::save_npz(std::format("build/airl/phase{}.npz",phase),{{"policy",policy},
        {"learner",learner},{"expert",expert_visits},{"disc_logits",losses[2]},
        {"reward",reward},{"potential",potential},{"score",losses[3]},{"disc_loss",losses[0]},{"actor_loss",losses[1]}});
  }
  auto plot=dm::graphics::RPlot::create();
  plot.lines({0,1,2,3},success,"Learned policy",{37,99,235})
      .title("AIRL on a five-state chain").x_label("Training phase").y_label("Goal probability")
      .ylim(0,1).size(800,460).save_svg("build/airl.svg");
}
```
