// Editable workflow support: rl/replay.hpp
#include <datamunge/rl/replay.hpp>
namespace rl {using dm::rl::replay::Experience;using dm::rl::replay::Batch;using dm::rl::replay::ReplayBuffer;using dm::rl::replay::PrioritizedReplay;using dm::rl::replay::NStepBuffer;using dm::rl::replay::SeqBatch;using dm::rl::replay::SequenceReplay;}

namespace rl {

struct CConfig {
  int steps = 200000;
  int warmup = 1000;       // random actions before training
  int batch = 128;
  int buffer = 100000;
  float gamma = 0.99f;
  float tau = 0.005f;      // Polyak factor for target networks
  float actor_lr = 1e-3f, critic_lr = 1e-3f;
  int hidden = 128;
  float noise = 0.1f;      // exploration noise std (fraction of the action range)
  int log_every = 2000;
  int eval_every = 4000;
  int eval_episodes = 5;
  uint64_t seed = 0;
};

inline void ParseCConfig(int argc, char** argv, CConfig* c) {
  for (int i = 1; i < argc; ++i) {
    const std::string arg = argv[i];
    const size_t eq = arg.find('=');
    if (eq == std::string::npos) continue;
    const std::string key = arg.substr(0, eq);
    const float v = std::strtof(arg.c_str() + eq + 1, nullptr);
    if (key == "threads") {
      datamunge::nn::set_num_threads(static_cast<int>(v));
      continue;
    }
    if (IsHardwareOption(key)) continue;
    if (key == "steps") c->steps = static_cast<int>(v);
    else if (key == "warmup") c->warmup = static_cast<int>(v);
    else if (key == "batch") c->batch = static_cast<int>(v);
    else if (key == "buffer") c->buffer = static_cast<int>(v);
    else if (key == "gamma") c->gamma = v;
    else if (key == "tau") c->tau = v;
    else if (key == "actor_lr") c->actor_lr = v;
    else if (key == "critic_lr") c->critic_lr = v;
    else if (key == "lr") c->actor_lr = c->critic_lr = v;
    else if (key == "hidden") c->hidden = static_cast<int>(v);
    else if (key == "noise") c->noise = v;
    else if (key == "log_every") c->log_every = static_cast<int>(v);
    else if (key == "eval_every") c->eval_every = static_cast<int>(v);
    else if (key == "seed") c->seed = static_cast<uint64_t>(v);
    else if (key != "task" && key != "game") std::fprintf(stderr, "unknown option %s\n", arg.c_str());
  }

  if (!example_runtime::Full()) {
    c->steps = std::min(c->steps, 256);
    c->warmup = std::min(c->warmup, 32);
    c->batch = std::min(c->batch, 8);
    c->log_every = c->eval_every = std::max(1, c->steps);
    c->eval_episodes = 1;
    example_runtime::Describe();
  }
}

inline DqnConfig MonitorConfig(const CConfig& c) {
  DqnConfig d;
  d.log_every = c.log_every;
  d.eval_every = c.eval_every;
  d.eval_episodes = c.eval_episodes;
  return d;
}

// [-1, 1]^dim -> the environment's box.
using dm::rl::continuous::ScaleAction;using dm::rl::continuous::NormalNoise;
using dm::nn::models::DeterministicActor;using dm::nn::models::Gaussian;using dm::nn::models::GaussianActor;
using dm::nn::models::Squashed;using dm::nn::models::SquashedSample;using dm::nn::models::GaussianLogProb;using dm::nn::models::QNetwork;
// Evaluation with a deterministic policy returning actions in [-1, 1].
inline float EvaluateC(Env& env, const std::function<std::vector<float>(const Obs&)>& act, int episodes, uint64_t seed) {
  const ActionSpace space = env.action_space();
  double total = 0;
  for (int e = 0; e < episodes; ++e) {
    Obs obs = env.reset(seed + e);
    while (true) {
      StepResult r = env.step(ScaleAction(act(obs), space));
      total += r.reward;
      obs = r.obs;
      if (r.done()) break;
    }
  }
  report_capture::Trace("eval_call",static_cast<float>(total/episodes));
  return static_cast<float>(total / episodes);
}

}  // namespace rl

// Editable workflow support: rl/dynamics_model.hpp
// Editable ensemble stores and inference wiring; the fitting objective and native optimizers live in main.
#include <cstdint>
#include <datamunge/nn/nn.hpp>
#include <memory>
#include <random>
#include <string>
#include <utility>
#include <vector>



namespace rl {

class DynamicsEnsemble {
 public:
  using TensorStore=datamunge::nn::ParameterStore;
  using Tensor = datamunge::nn::Tensor;

  DynamicsEnsemble(int members, int obs_dim, int act_dim, int hidden, float lr, uint64_t seed)
      : obs_dim_(obs_dim), hidden_(hidden) {
    namespace nn = datamunge::nn;
    for (int m = 0; m < members; ++m) {
      Member mem;
      mem.params = std::make_unique<nn::ParameterStore>(seed + m);
      members_.push_back(std::move(mem));
      {
        nn::NoGradGuard no_grad;
        Forward(m, nn::zeros({1, obs_dim}), nn::zeros({1, act_dim}));
      }

    }
  }

  int members() const { return static_cast<int>(members_.size()); }

  using Output=dm::nn::models::DynamicsGaussian;
  // Member m's Gaussian over (s' - s, r) for states S [N, obs] and actions A [N, act].
  Output Forward(int m, const Tensor& S, const Tensor& A) const {
return dm::nn::models::DynamicsMember(*members_.at(m).params,S,A,hidden_);
}

  TensorStore& Params(int m)const{return *members_.at(m).params;}
  // Predict next states and rewards with member m, sampling from its
  // Gaussian when `sample` is set, else using the mean.
  using Prediction=dm::nn::models::DynamicsPrediction;
  Prediction Predict(int m, const Tensor& S, const Tensor& A, bool sample, std::mt19937_64& rng) const {
namespace nn=dm::nn;nn::NoGradGuard no_grad;const auto o=Forward(m,S,A);Tensor noise;if(sample){std::vector<float> e(size_t(S.size(0))*(obs_dim_+1));std::normal_distribution<float> normal(0,1);for(auto&x:e)x=normal(rng);noise=nn::from_vector(e,{S.size(0),obs_dim_+1});}return nn::models::DynamicsNext(S,o,noise);
}

 private:
  struct Member {
    std::unique_ptr<datamunge::nn::ParameterStore> params;

  };
  int obs_dim_, hidden_;
  std::vector<Member> members_;
};

using TransitionSet=dm::rl::planning::TransitionSet;
} // namespace rl

// Editable workflow support: rl/hud.hpp
// datamunge::nn port of tflow_examples src/common/rl/hud.h: Decision, its helpers and the Hud
// state are copied unchanged; DrawHud (drawing onto a video::Canvas) is dropped, since video
// recording is out of scope for the ports. Policies written for tflow's recorders still compile.
// The overlay on the videos: the move the agent makes and what it expects.
//
// A Decision is one move as the agent explains it: the action, the estimate
// it holds for every candidate action (Q-values, action probabilities, visit
// counts, planned returns, ...), which candidate it took, and the return it
// expects from the current state. The recorders in vsim_studio.h accept
// policies that return a Decision instead of a bare Action and draw it on
// every frame together with the step count, the last reward and the return
// so far (the Hud); a plain policy still gets the move, reward and return
// shown. DrawHud draws onto a video::Canvas, so the videos drawn without the
// 3D renderer (Atari) carry the same overlay.
//
// The helpers cover the usual cases: GreedyQ for value-based agents (the
// argmax, the Q row and max_a Q as the expected return), GreedyPi for a
// policy's probabilities with the critic's V(s), and Explain for an action
// with one estimate attached (a continuous torque with its critic value, a
// planner's first action with the planned return).

#include <algorithm>
#include <cmath>
#include <cstdio>
#include <numeric>
#include <string>
#include <utility>
#include <vector>


namespace rl {

struct Decision {
  Action action;
  std::string label;                // the move in words ("right", "torque +1.3"); from the action space when empty
  std::string kind;                 // what `values` are: "Q(s,a)", "pi(a|s)", "visits", "planned return"
  std::vector<std::string> labels;  // one per candidate; the environment's action names when empty
  std::vector<float> values;        // the agent's estimate per candidate action (empty when it has none)
  int chosen = -1;                  // the candidate taken (-1: the action is not one of them)
  float value = NAN;                // the return the agent expects from here (V(s), max_a Q, root value, ...)
  std::string value_name = "expected return";
  float lo = NAN, hi = NAN;         // the bar scale for `values`; NaN: from the values themselves (and 0)
  int decimals = -1;                // digits after the point for `values` (-1: by magnitude)
  std::string note;                 // one free line, e.g. "CEM over 15 steps" or "epsilon 0.05"

  Decision() = default;
  explicit Decision(Action a) : action(std::move(a)) {}
  // A Decision stands in for its action, so one policy serves both the
  // recorders and the plain episode runners (RunEpisodes, env.step).
  operator const Action&() const { return action; }  // NOLINT: implicit by design
};

// Greedy over Q(s, .): the argmax, the whole row, and max_a Q as the expected return.
inline Decision GreedyQ(const float* q, int n, const std::string& kind = "Q(s,a)") {
  Decision d;
  d.values.assign(q, q + n);
  d.chosen = static_cast<int>(std::max_element(q, q + n) - q);
  d.action = Action(d.chosen);
  d.kind = kind;
  d.value = q[d.chosen];
  return d;
}
inline Decision GreedyQ(const std::vector<float>& q, const std::string& kind = "Q(s,a)") {
  return GreedyQ(q.data(), static_cast<int>(q.size()), kind);
}

// The most probable action of a stochastic policy, with the probabilities and
// (when the agent has a critic) V(s).
inline Decision GreedyPi(const std::vector<float>& probs, float v = NAN, const std::string& kind = "pi(a|s)") {
  Decision d;
  d.values = probs;
  d.chosen = static_cast<int>(std::max_element(probs.begin(), probs.end()) - probs.begin());
  d.action = Action(d.chosen);
  d.kind = kind;
  d.lo = 0.f, d.hi = 1.f;
  d.decimals = 2;
  d.value = v;
  d.value_name = "V(s)";
  return d;
}

// An action with one estimate attached: a torque and its critic value, a
// planner's action and the return of its plan.
inline Decision Explain(Action action, float value, const std::string& value_name = "expected return", const std::string& note = "") {
  Decision d(std::move(action));
  d.value = value;
  d.value_name = value_name;
  d.note = note;
  return d;
}

// An action with a remark for the overlay: what a hand-written rule looked at.
inline Decision Note(Action action, const std::string& note) {
  Decision d(std::move(action));
  d.note = note;
  return d;
}

// A number with as many decimals as its size warrants.
inline std::string HudNum(float v, int decimals = -1) {
  if (std::isnan(v)) return "-";
  char buf[32];
  if (decimals < 0) decimals = std::abs(v) >= 100 ? 0 : std::abs(v) >= 10 ? 1 : 2;
  std::snprintf(buf, sizeof buf, "%.*f", decimals, v);
  return buf;
}
inline std::string HudSigned(float v) {
  if (std::isnan(v)) return "-";
  char buf[32];
  std::snprintf(buf, sizeof buf, "%+.2f", v);
  return buf;
}

// Everything the overlay shows: the episode so far and the current decision.
// The recorders fill it; Complete() derives the labels from the action space.
struct Hud {
  std::string title;  // optional top line
  int step = 0;
  float reward = NAN;  // the last reward (NaN before the first step)
  float ret = 0;       // the return so far
  bool done = false, truncated = false;
  bool has_decision = false;
  Decision decision;
  ActionSpace space;
  std::vector<std::string> names;  // the environment's action names (discrete) or action dimensions (continuous)

  void Reset(const ActionSpace& s, std::vector<std::string> action_names) {
    step = 0, reward = NAN, ret = 0, done = truncated = false, has_decision = false;
    decision = Decision();
    space = s;
    names = std::move(action_names);
  }
  // The move taken; the step that follows reports its reward through Observe().
  void Choose(Decision d) {
    decision = std::move(d);
    has_decision = true;
    Complete();
  }
  void Observe(const StepResult& r) {
    ++step;
    reward = r.reward;
    ret += r.reward;
    done = r.done();
    truncated = r.truncated;
  }
  std::string NameOf(int i, const char* prefix) const {
    if (i >= 0 && i < static_cast<int>(names.size())) return names[i];
    return prefix + std::to_string(i);
  }
  // Fills the action label and the candidate labels the policy left empty.
  void Complete() {
    Decision& d = decision;
    if (d.label.empty()) {
      if (space.kind == ActionSpace::kDiscrete) {
        d.label = NameOf(d.action.discrete, "action ");
      } else {
        for (size_t i = 0; i < d.action.continuous.size(); ++i) {
          if (i) d.label += "  ";
          if (i < names.size()) d.label += names[i] + " ";
          d.label += HudSigned(d.action.continuous[i]);
        }
      }
    }
    if (d.labels.size() != d.values.size()) {
      d.labels.clear();
      const bool per_action = space.kind == ActionSpace::kDiscrete && static_cast<int>(d.values.size()) == space.n;
      for (size_t i = 0; i < d.values.size(); ++i) d.labels.push_back(per_action ? NameOf(static_cast<int>(i), "action ") : std::to_string(i));
    }
  }
};

}  // namespace rl

// Editable workflow support: rl/playback.hpp
// datamunge::nn port helper standing in for tflow's src/common/rl/vsim_studio.h recorders.
//
// tflow films episodes with vsim's renderer and ffmpeg (RecordEpisode); both are out of scope
// for the datamunge ports. PlayEpisode runs exactly the episode RecordEpisode would film (same
// reset seed, the same Decide/Hud bookkeeping, one env step per loop) without a video and prints
// the same summary line, so the steps and return can be compared with tflow's "recorded ..."
// line. tflow's recorder also stops when the film reaches `max_frames`; frames are not steps
// (they depend on the world's frame rate), so PlayEpisode ignores that cap: for every episode
// the 6.1 examples film, the episode ends before the film is full.

#include <cstdint>
#include <cstdio>
#include <string>
#include <type_traits>
#include <utility>



namespace rl {

// The policy's decision for `obs`, as in vsim_studio.h: a Decision passes through, a bare
// action (an int, a vector or an Action) is wrapped.
template <typename PolicyFn>
Decision Decide(PolicyFn& policy, const Obs& obs) {
  if constexpr (std::is_same_v<std::decay_t<decltype(policy(obs))>, Decision>) return policy(obs);
  else return Decision(Action(policy(obs)));
}

struct Playback {
  int steps = 0;
  float ret = 0;
  Hud hud;  // the overlay state after the last step (decision, reward, return)
};

// Plays one episode of `policy` from env.reset(seed); `after_step(env, hud)` is called after
// the reset (step 0) and after every step, e.g. to snapshot frames.
template <typename Env, typename PolicyFn, typename AfterStep>
Playback PlayEpisode(Env& env, PolicyFn&& policy, const std::string& name, uint64_t seed, AfterStep after_step) {
  Playback pb;
  pb.hud.Reset(env.action_space(), env.action_names());
  Obs obs = env.reset(seed);
  after_step(static_cast<const Env&>(env), static_cast<const Hud&>(pb.hud));
  while (true) {
    pb.hud.Choose(Decide(policy, obs));
    const StepResult r = env.step(pb.hud.decision.action);
    pb.hud.Observe(r);
    pb.ret += r.reward;
    ++pb.steps;
    obs = r.obs;
    after_step(static_cast<const Env&>(env), static_cast<const Hud&>(pb.hud));
    if (r.done()) break;
  }
  std::printf("  played %s (video omitted): %d steps, return %.1f\n", name.c_str(), pb.steps, pb.ret);
  return pb;
}

template <typename Env, typename PolicyFn>
Playback PlayEpisode(Env& env, PolicyFn&& policy, const std::string& name, uint64_t seed) {
  return PlayEpisode(env, std::forward<PolicyFn>(policy), name, seed, [](const Env&, const Hud&) {});
}

}  // namespace rl

namespace nn = datamunge::nn;
using nn::Tensor;

namespace {

struct Planner {
  rl::DynamicsEnsemble* model;
  int horizon, candidates, cem_iters, elites;
  int act_dim;
  std::mt19937_64* rng;
  float last_return = 0;  // the model's return of the best sequence of the last Plan()
  // Returns the first action of the best sequence found from `obs`.
  std::vector<float> Plan(const rl::Obs& obs, bool use_cem) {
    const int H = horizon, N = candidates;
    std::vector<float> mean(H * act_dim, 0.f), stdv(H * act_dim, 1.f);
    std::vector<float> best_seq(H * act_dim, 0.f);
    float best_return = -1e30f;
    std::normal_distribution<float> normal(0.f, 1.f);
    for (int it = 0; it < (use_cem ? cem_iters : 1); ++it) {
      // Sample N action sequences (uniform for shooting, Gaussian for CEM).
      std::vector<std::vector<float>> seqs(N, std::vector<float>(H * act_dim));
      for (auto& s : seqs)
        for (int j = 0; j < H * act_dim; ++j)
          s[j] = std::max(-1.f, std::min(1.f, use_cem ? mean[j] + stdv[j] * normal(*rng) : std::uniform_real_distribution<float>(-1, 1)(*rng)));
      // Roll all candidates through the model together.
      const int obs_dim = static_cast<int>(obs.size());
      std::vector<float> s0(static_cast<size_t>(N) * obs_dim);
      for (int i = 0; i < N; ++i)
        for (int j = 0; j < obs_dim; ++j) s0[i * obs_dim + j] = obs[j];
      Tensor S = nn::from_vector(s0, {N, obs_dim});
      std::vector<float> returns(N, 0.f);
      for (int t = 0; t < H; ++t) {
        std::vector<float> a(static_cast<size_t>(N) * act_dim);
        for (int i = 0; i < N; ++i)
          for (int d = 0; d < act_dim; ++d) a[i * act_dim + d] = seqs[i][t * act_dim + d] * 2.f;  // Pendulum torque range
        rl::DynamicsEnsemble::Prediction p = model->Predict(0, S, nn::from_vector(a, {N, act_dim}), false, *rng);
        const std::vector<float> r = p.r.to_vector<float>();
        for (int i = 0; i < N; ++i) returns[i] += r[i];
        S = p.next_s;
      }
      // Elites refit the sampling distribution; remember the best sequence.
      std::vector<int> order(N);
      for (int i = 0; i < N; ++i) order[i] = i;
      std::partial_sort(order.begin(), order.begin() + elites, order.end(), [&](int x, int y) { return returns[x] > returns[y]; });
      if (returns[order[0]] > best_return) best_return = returns[order[0]], best_seq = seqs[order[0]];
      for (int j = 0; j < H * act_dim; ++j) {
        float m = 0, v = 0;
        for (int k = 0; k < elites; ++k) m += seqs[order[k]][j] / elites;
        for (int k = 0; k < elites; ++k) v += (seqs[order[k]][j] - m) * (seqs[order[k]][j] - m) / elites;
        mean[j] = m;
        stdv[j] = std::sqrt(v) + 0.05f;
      }
    }
    last_return = best_return;
    return std::vector<float>(best_seq.begin(), best_seq.begin() + act_dim);
  }
};

}  // namespace

int main(int argc, char** argv) {
  try {
  uint64_t seed = 0;  // model weights and the planner's random stream (TF: 0)
  for (int i = 1; i < argc; ++i) {
    const std::string arg = argv[i];
    if (arg.rfind("threads=", 0) == 0) nn::set_num_threads(std::atoi(arg.c_str() + 8));
    if (arg.rfind("seed=", 0) == 0) seed = std::strtoull(arg.c_str() + 5, nullptr, 10);
  }
  rl::Pendulum env, eval_env;
  const rl::ActionSpace space = env.action_space();
  const int obs_dim = env.obs_size(), act_dim = space.dim;
  const int iterations = example_runtime::Limit(6, 2), model_steps = example_runtime::Limit(400, 8), batch = example_runtime::Limit(128, 8);
  std::printf("== MPC on Pendulum with a learned model: %d rounds of (collect one episode, refit the model)\n", iterations);

  rl::DynamicsEnsemble model(/*members=*/1, obs_dim, act_dim, 128, 1e-3f, seed);
  std::vector<std::unique_ptr<nn::Optimizer>> model_optimizers;
  for(int m=0;m<model.members();++m)model_optimizers.push_back(std::make_unique<nn::Optimizer>(model.Params(m),1e-3,nn::OptimizerConfig{nn::OptimizerKind::Adam}));
  auto fit_model_batch=[&](const Tensor&S,const Tensor&A,const Tensor&S2,const Tensor&R){
    const Tensor target=nn::concat({S2-S,nn::expand_dims(R,1)},1);float nll=0,mse=0;
    for(int m=0;m<model.members();++m){const auto o=model.Forward(m,S,A);const Tensor err=target-o.mean;
      const Tensor loss=nn::mean(nn::sum(nn::square(err)*nn::exp(-o.logvar)+o.logvar,{1}),{0});
      const float mse_m=nn::mean(nn::sum(nn::square(err.detach()),{1}),{0}).item<float>();const float loss_m=loss.item<float>();
      auto gradients=nn::grad(loss,model_optimizers[m]->parameters());model_optimizers[m]->step(gradients);
      nll+=loss_m/model.members();mse+=mse_m/model.members();}return std::pair<float,float>{nll,mse};};

struct EnsembleCheckpoint{rl::DynamicsEnsemble& m;~EnsembleCheckpoint(){for(int i=0;i<m.members();++i){report_capture::Checkpoint c{m.Params(i)};}}} ensemble_checkpoint{model};

  std::mt19937_64 rng(seed);
  rl::TransitionSet data;
  Planner shooting{&model, 15, 500, 1, 50, act_dim, &rng};
  Planner cem{&model, 15, 200, 4, 20, act_dim, &rng};
  // Environment actions are stored in the model's units (the real torque).
  auto run_episode = [&](const std::function<std::vector<float>(const rl::Obs&)>& policy, bool record, uint64_t seed) {
    rl::Obs obs = env.reset(seed);
    float ret = 0;
    while (true) {
      std::vector<float> u = policy(obs);
      rl::Action a = rl::ScaleAction(u, space);
      rl::StepResult sr = env.step(a);
      if (record) data.Add(obs, a.continuous, sr.obs, sr.reward);
      ret += sr.reward;
      obs = sr.obs;
      if (sr.done()) break;
    }
    report_capture::Trace("episode_return",ret);return ret;
  };
  float first_mse = -1;
  auto train_model = [&]() {
    float mse = 0;
    for (int i = 0; i < model_steps; ++i) {
      Tensor S, A, S2, R;
      auto sampled=data.Sample(batch,rng);S=sampled.state;A=sampled.action;S2=sampled.next_state;R=sampled.reward;
      mse = fit_model_batch(S, A, S2, R).second;
      if (first_mse < 0) first_mse = mse;
    }
    report_capture::Trace("model_mse",mse);return mse;
  };

  std::printf("  %5s %10s %12s %16s %12s\n", "round", "data", "model MSE", "random shooting", "CEM");
  auto random_policy = [&](const rl::Obs&) { return std::vector<float>{std::uniform_real_distribution<float>(-1, 1)(rng)}; };
  run_episode(random_policy, true, 1);
  run_episode(random_policy, true, 2);
  float last_mse = 0, best_shoot = -1e30f, best_cem = -1e30f;
  for (int round = 1; round <= iterations; ++round) {
    const float mse = train_model();
    const float r_shoot = run_episode([&](const rl::Obs& o) { return shooting.Plan(o, false); }, /*record=*/true, 100 + round);
    const float r_cem = run_episode([&](const rl::Obs& o) { return cem.Plan(o, true); }, /*record=*/true, 200 + round);
    std::printf("  %5d %10d %12.4f %16.1f %12.1f\n", round, data.size(), mse, r_shoot, r_cem);
    std::fflush(stdout);
    last_mse = mse, best_shoot = std::max(best_shoot, r_shoot), best_cem = std::max(best_cem, r_cem);
  }
  std::printf("  (random policy about -1200; a good controller is above -200)\n");
  // On film in TF: CEM re-plans at every step; the overlay shows the torque and
  // the model's return for the plan it was taken from.
  const rl::Playback pb = rl::PlayEpisode(env, [&](const rl::Obs& o) {
    const std::vector<float> u = cem.Plan(o, true);
    return rl::Explain(rl::ScaleAction(u, space), cem.last_return, "planned return (15 steps)", "CEM: 200 candidates, 4 iterations, learned model");
  }, "mpc_cem_pendulum", 777);

  // Checks added by the port (tflow prints the table only).
  check::Require(std::isfinite(last_mse) && std::isfinite(first_mse), "finite model fitting losses in both runtime profiles");
  check::TrainingQuality(last_mse < first_mse, "the model's error falls as it is refit");
  check::TrainingQuality(best_cem > -400, "CEM with the learned model swings the pendulum up in some round (return > -400)");
  check::TrainingQuality(best_shoot > -600, "random shooting does well in some round (return > -600)");
  check::TrainingQuality(pb.ret > -600, "the CEM episode played at the end does well (return > -600)");
  std::printf("\nchecks passed (vsim video omitted)\n");
  } catch (const std::exception& e) {
    std::fprintf(stderr, "CHECK FAILED: %s\n", e.what());
    return 1;
  }
  return 0;
}

```
