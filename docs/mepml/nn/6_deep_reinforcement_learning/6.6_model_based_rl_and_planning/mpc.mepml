int main(){std::filesystem::create_directories("build");dm::nn::models::DynamicsGaussian p{dm::nn::from_vector(std::vector<float>{.5f,2},{1,2}),dm::nn::zeros({1,2})};auto next=dm::nn::models::DynamicsNext(dm::nn::ones({1,1}),p);std::vector<double>values{next.next_s.item<double>(),next.r.item<double>()};std::print("| coordinate | computed value |\n|---:|---:|\n");for(size_t i=0;i<values.size();++i)std::print("| {} | {:.9f} |\n",i,values[i]);std::vector<double>x(values.size());std::iota(x.begin(),x.end(),0.);double low=std::min(0.,*std::min_element(values.begin(),values.end())),high=std::max(0.,*std::max_element(values.begin(),values.end())),span=std::max(1.,high-low);dm::graphics::RPlot::create().bars(x,values,"computed values",{37,99,235}).ylim(low-.05*span,high+.05*span).title("mpc worked calculation").size(1000,550).save_svg("build/mpc_worked.svg");}
