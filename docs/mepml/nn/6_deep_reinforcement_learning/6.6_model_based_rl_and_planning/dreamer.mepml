int main(){namespace n=dm::nn;namespace m=n::models;std::filesystem::create_directories("build");n::ParameterStore p(0);m::Rssm model(p,{});n::Module network([&](const n::Tensor&x){auto initial=model.Zero(1);auto out=model.Observe(initial,{x,x},{n::zeros({1,1}),n::zeros({1,1})},{n::zeros({1,16}),n::zeros({1,16})});return out.recon[1];},"dreamer source model");n::ModelPlotOptions options;options.detail=n::ModelPlotDetail::Blocks;options.sizing.minimum_extent=2;options.sizing.max_planes=2;network.plot(n::zeros({1,3}),options).save_svg("build/dreamer_network.svg");}
