int main(){auto archive=dm::nn::load_npz("build/mcts_source.npz");auto plot=dm::graphics::RPlot::create();int series=0;for(const auto&[key,t]:archive){if(!key.starts_with("matches_"))continue;auto y=t.to_vector<double>();std::vector<double>x(y.size());std::iota(x.begin(),x.end(),0.);std::vector<std::string>labels{"TicTacToe50/random","TicTacToe400/50","ConnectFour50/random","ConnectFour400/50","Othello50/random","Othello200/50"};plot.lines(x,y,labels.at(series),{37+(series%4)*50,99,235-(series%4)*50});++series;}if(!series)throw std::runtime_error("source diagnostic missing");plot.title("mcts actual source diagnostics").x_label("Outcome coordinate: win / loss / draw").y_label("Game count").size(1100,600).save_svg("build/mcts_diagnostic0.svg");}
