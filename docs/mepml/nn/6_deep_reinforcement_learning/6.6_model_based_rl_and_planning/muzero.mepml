// Editable workflow support: rl/utils.hpp
// datamunge::nn port: copied from tflow_examples src/common/rl/utils.h (TF-free code, unchanged).
// Small helpers shared by the RL examples: episode statistics, random and
// greedy rollouts, and printing.

#include <algorithm>
#include <cmath>
#include <cstdio>
#include <functional>
#include <numeric>
#include <string>
#include <vector>


namespace rl {

struct EpisodeStats {
  std::vector<float> returns;
  std::vector<int> lengths;
  float mean_return() const {
    return returns.empty() ? 0.f
                           : std::accumulate(returns.begin(), returns.end(), 0.f) / returns.size();
  }
  float mean_length() const {
    return lengths.empty() ? 0.f
                           : std::accumulate(lengths.begin(), lengths.end(), 0.f) / lengths.size();
  }
  float min_return() const { return *std::min_element(returns.begin(), returns.end()); }
  float max_return() const { return *std::max_element(returns.begin(), returns.end()); }
};

// Run `episodes` episodes of `env` choosing actions with `policy(obs)`.

// Uniformly random actions.

inline void PrintStats(const std::string& label, const EpisodeStats& s) {
  std::printf("  %-32s return mean %8.2f  min %8.2f  max %8.2f   length mean %6.1f\n",
              label.c_str(), s.mean_return(), s.min_return(), s.max_return(), s.mean_length());
}

using dm::rl::foundations::ArgMax;using dm::rl::foundations::ArgMaxRandomTie;
inline std::string FormatObs(const Obs& o, int max_elems = 8) {
  std::string s = "[";
  for (size_t i = 0; i < o.size() && static_cast<int>(i) < max_elems; ++i) {
    char buf[32];
    std::snprintf(buf, sizeof buf, "%s%.3f", i ? " " : "", o[i]);
    s += buf;
  }
  if (static_cast<int>(o.size()) > max_elems) s += " ...";
  return s + "]";
}

}  // namespace rl


namespace rl {

namespace nn = datamunge::nn;

struct DqnConfig {
  int steps = 50000;          // environment steps
  int warmup = 1000;          // steps before training starts
  int batch = 64;
  int buffer = 50000;
  float gamma = 0.98f;        // 0.99 is the usual choice; 0.98 bounds Q by 50 and makes CartPole far more stable
  float lr = 5e-4f;
  float clip_norm = 10.f;
  int target_sync = 500;      // hard target update period (steps), used when tau == 1
  float tau = 0.005f;         // target <- tau * online + (1 - tau) * target every step; tau = 1 means a hard copy every target_sync steps
  float eps_start = 1.f, eps_end = 0.05f;
  int eps_decay_steps = 10000;
  int hidden = 128;
  int train_every = 2;
  int log_every = 5000;
  int eval_every = 5000;
  int eval_episodes = 5;
  uint64_t seed = 0;
};

// TF-only options that the ports accept and ignore.
inline bool IsHardwareOption(const std::string& key) {
  return key == "device" || key == "threads" || key == "intra_threads" || key == "inter_threads" || key == "xla";
}

// Overrides from the command line, e.g. `just run-nn dqn steps=50000 lr=5e-4`.
inline void ParseConfig(int argc, char** argv, DqnConfig* c) {
  for (int i = 1; i < argc; ++i) {
    const std::string arg = argv[i];
    const size_t eq = arg.find('=');
    if (eq == std::string::npos) continue;
    const std::string key = arg.substr(0, eq);
    const float v = std::strtof(arg.c_str() + eq + 1, nullptr);
    if (IsHardwareOption(key)) continue;
    if (key == "steps") c->steps = static_cast<int>(v);
    else if (key == "warmup") c->warmup = static_cast<int>(v);
    else if (key == "batch") c->batch = static_cast<int>(v);
    else if (key == "buffer") c->buffer = static_cast<int>(v);
    else if (key == "gamma") c->gamma = v;
    else if (key == "lr") c->lr = v;
    else if (key == "clip_norm") c->clip_norm = v;
    else if (key == "target_sync") c->target_sync = static_cast<int>(v);
    else if (key == "tau") c->tau = v;
    else if (key == "eps_start") c->eps_start = v;
    else if (key == "eps_end") c->eps_end = v;
    else if (key == "eps_decay_steps") c->eps_decay_steps = static_cast<int>(v);
    else if (key == "hidden") c->hidden = static_cast<int>(v);
    else if (key == "train_every") c->train_every = static_cast<int>(v);
    else if (key == "log_every") c->log_every = static_cast<int>(v);
    else if (key == "eval_every") c->eval_every = static_cast<int>(v);
    else if (key == "seed") c->seed = static_cast<uint64_t>(v);
    else if (key != "task" && key != "game") std::fprintf(stderr, "unknown option %s\n", arg.c_str());
  }

  if (!example_runtime::Full()) {
    c->steps = std::min(c->steps, 512);
    c->warmup = std::min(c->warmup, 32);
    c->batch = std::min(c->batch, 8);
    c->log_every = c->eval_every = std::max(1, c->steps);
    c->eval_episodes = 1;
    c->eps_decay_steps = std::min(c->eps_decay_steps, c->steps);
    example_runtime::Describe();
  }
}

inline float Epsilon(const DqnConfig& c, int step) {
  const float frac = std::min(1.f, static_cast<float>(step) / c.eps_decay_steps);
  return c.eps_start + frac * (c.eps_end - c.eps_start);
}

// Greedy evaluation with any action function.
inline float Evaluate(Env& env, const std::function<int(const Obs&)>& act, int episodes, uint64_t seed) {
  double total = 0;
  for (int e = 0; e < episodes; ++e) {
    Obs obs = env.reset(seed + e);
    while (true) {
      StepResult r = env.step(act(obs));
      total += r.reward;
      obs = r.obs;
      if (r.done()) break;
    }
  }
  report_capture::Trace("eval_call",static_cast<float>(total/episodes));
  return static_cast<float>(total / episodes);
}

// Tracks episode returns and losses and prints one line per log period.
class Monitor {
 public:
  explicit Monitor(const DqnConfig& cfg, const char* third_column = "eps") : cfg_(cfg) {
    std::printf("  %8s %8s %12s %7s %10s %10s\n", "step", "episodes", "return(20)", third_column, "loss", "eval");
  }
  void EndEpisode(float ret) { returns_.push_back(ret); }
  ~Monitor(){auto tag=std::to_string(id_);report_capture::Save("return_"+tag,returns_);report_capture::Save("step_"+tag,steps_);report_capture::Save("eval_"+tag,evaluation_);report_capture::Save("loss_"+tag,mean_losses_);}
  void AddLoss(float loss) { losses_.push_back(loss); }
  int episodes() const { return static_cast<int>(returns_.size()); }
  float RecentReturn(int n = 20) const {
    if (returns_.empty()) return 0.f;
    const size_t from = returns_.size() > static_cast<size_t>(n) ? returns_.size() - n : 0;
    return std::accumulate(returns_.begin() + from, returns_.end(), 0.f) / (returns_.size() - from);
  }
  void Log(int step, float eps, float eval_return) {
    const float loss = losses_.empty() ? 0.f : std::accumulate(losses_.begin(), losses_.end(), 0.f) / losses_.size();
    steps_.push_back(step);evaluation_.push_back(eval_return);mean_losses_.push_back(loss);
    losses_.clear();
    char eval[16];
    if (std::isnan(eval_return)) std::snprintf(eval, sizeof eval, "%10s", "");
    else std::snprintf(eval, sizeof eval, "%10.1f", eval_return);
    std::printf("  %8d %8d %12.1f %7.3f %10.4f %s\n", step, episodes(), RecentReturn(), eps, loss, eval);
    std::fflush(stdout);
  }

 private:
  int id_=report_capture::monitor_index++;std::vector<double>steps_,evaluation_,mean_losses_;
  DqnConfig cfg_;
  std::vector<float> returns_, losses_;
};

using dm::nn::models::ProjectDistribution;

// One observation as a [1, obs_dim] tensor.
inline nn::Tensor Row(const Obs& o) { return nn::from_vector(o, {1, static_cast<std::int64_t>(o.size())}); }

}  // namespace rl

// Editable workflow support: rl/hud.hpp
// datamunge::nn port of tflow_examples src/common/rl/hud.h: Decision, its helpers and the Hud
// state are copied unchanged; DrawHud (drawing onto a video::Canvas) is dropped, since video
// recording is out of scope for the ports. Policies written for tflow's recorders still compile.
// The overlay on the videos: the move the agent makes and what it expects.
//
// A Decision is one move as the agent explains it: the action, the estimate
// it holds for every candidate action (Q-values, action probabilities, visit
// counts, planned returns, ...), which candidate it took, and the return it
// expects from the current state. The recorders in vsim_studio.h accept
// policies that return a Decision instead of a bare Action and draw it on
// every frame together with the step count, the last reward and the return
// so far (the Hud); a plain policy still gets the move, reward and return
// shown. DrawHud draws onto a video::Canvas, so the videos drawn without the
// 3D renderer (Atari) carry the same overlay.
//
// The helpers cover the usual cases: GreedyQ for value-based agents (the
// argmax, the Q row and max_a Q as the expected return), GreedyPi for a
// policy's probabilities with the critic's V(s), and Explain for an action
// with one estimate attached (a continuous torque with its critic value, a
// planner's first action with the planned return).

#include <algorithm>
#include <cmath>
#include <cstdio>
#include <numeric>
#include <string>
#include <utility>
#include <vector>


namespace rl {

struct Decision {
  Action action;
  std::string label;                // the move in words ("right", "torque +1.3"); from the action space when empty
  std::string kind;                 // what `values` are: "Q(s,a)", "pi(a|s)", "visits", "planned return"
  std::vector<std::string> labels;  // one per candidate; the environment's action names when empty
  std::vector<float> values;        // the agent's estimate per candidate action (empty when it has none)
  int chosen = -1;                  // the candidate taken (-1: the action is not one of them)
  float value = NAN;                // the return the agent expects from here (V(s), max_a Q, root value, ...)
  std::string value_name = "expected return";
  float lo = NAN, hi = NAN;         // the bar scale for `values`; NaN: from the values themselves (and 0)
  int decimals = -1;                // digits after the point for `values` (-1: by magnitude)
  std::string note;                 // one free line, e.g. "CEM over 15 steps" or "epsilon 0.05"

  Decision() = default;
  explicit Decision(Action a) : action(std::move(a)) {}
  // A Decision stands in for its action, so one policy serves both the
  // recorders and the plain episode runners (RunEpisodes, env.step).
  operator const Action&() const { return action; }  // NOLINT: implicit by design
};

// Greedy over Q(s, .): the argmax, the whole row, and max_a Q as the expected return.
inline Decision GreedyQ(const float* q, int n, const std::string& kind = "Q(s,a)") {
  Decision d;
  d.values.assign(q, q + n);
  d.chosen = static_cast<int>(std::max_element(q, q + n) - q);
  d.action = Action(d.chosen);
  d.kind = kind;
  d.value = q[d.chosen];
  return d;
}
inline Decision GreedyQ(const std::vector<float>& q, const std::string& kind = "Q(s,a)") {
  return GreedyQ(q.data(), static_cast<int>(q.size()), kind);
}

// The most probable action of a stochastic policy, with the probabilities and
// (when the agent has a critic) V(s).
inline Decision GreedyPi(const std::vector<float>& probs, float v = NAN, const std::string& kind = "pi(a|s)") {
  Decision d;
  d.values = probs;
  d.chosen = static_cast<int>(std::max_element(probs.begin(), probs.end()) - probs.begin());
  d.action = Action(d.chosen);
  d.kind = kind;
  d.lo = 0.f, d.hi = 1.f;
  d.decimals = 2;
  d.value = v;
  d.value_name = "V(s)";
  return d;
}

// An action with one estimate attached: a torque and its critic value, a
// planner's action and the return of its plan.
inline Decision Explain(Action action, float value, const std::string& value_name = "expected return", const std::string& note = "") {
  Decision d(std::move(action));
  d.value = value;
  d.value_name = value_name;
  d.note = note;
  return d;
}

// An action with a remark for the overlay: what a hand-written rule looked at.
inline Decision Note(Action action, const std::string& note) {
  Decision d(std::move(action));
  d.note = note;
  return d;
}

// A number with as many decimals as its size warrants.
inline std::string HudNum(float v, int decimals = -1) {
  if (std::isnan(v)) return "-";
  char buf[32];
  if (decimals < 0) decimals = std::abs(v) >= 100 ? 0 : std::abs(v) >= 10 ? 1 : 2;
  std::snprintf(buf, sizeof buf, "%.*f", decimals, v);
  return buf;
}
inline std::string HudSigned(float v) {
  if (std::isnan(v)) return "-";
  char buf[32];
  std::snprintf(buf, sizeof buf, "%+.2f", v);
  return buf;
}

// Everything the overlay shows: the episode so far and the current decision.
// The recorders fill it; Complete() derives the labels from the action space.
struct Hud {
  std::string title;  // optional top line
  int step = 0;
  float reward = NAN;  // the last reward (NaN before the first step)
  float ret = 0;       // the return so far
  bool done = false, truncated = false;
  bool has_decision = false;
  Decision decision;
  ActionSpace space;
  std::vector<std::string> names;  // the environment's action names (discrete) or action dimensions (continuous)

  void Reset(const ActionSpace& s, std::vector<std::string> action_names) {
    step = 0, reward = NAN, ret = 0, done = truncated = false, has_decision = false;
    decision = Decision();
    space = s;
    names = std::move(action_names);
  }
  // The move taken; the step that follows reports its reward through Observe().
  void Choose(Decision d) {
    decision = std::move(d);
    has_decision = true;
    Complete();
  }
  void Observe(const StepResult& r) {
    ++step;
    reward = r.reward;
    ret += r.reward;
    done = r.done();
    truncated = r.truncated;
  }
  std::string NameOf(int i, const char* prefix) const {
    if (i >= 0 && i < static_cast<int>(names.size())) return names[i];
    return prefix + std::to_string(i);
  }
  // Fills the action label and the candidate labels the policy left empty.
  void Complete() {
    Decision& d = decision;
    if (d.label.empty()) {
      if (space.kind == ActionSpace::kDiscrete) {
        d.label = NameOf(d.action.discrete, "action ");
      } else {
        for (size_t i = 0; i < d.action.continuous.size(); ++i) {
          if (i) d.label += "  ";
          if (i < names.size()) d.label += names[i] + " ";
          d.label += HudSigned(d.action.continuous[i]);
        }
      }
    }
    if (d.labels.size() != d.values.size()) {
      d.labels.clear();
      const bool per_action = space.kind == ActionSpace::kDiscrete && static_cast<int>(d.values.size()) == space.n;
      for (size_t i = 0; i < d.values.size(); ++i) d.labels.push_back(per_action ? NameOf(static_cast<int>(i), "action ") : std::to_string(i));
    }
  }
};

}  // namespace rl

// Editable workflow support: rl/pg_common.hpp
// datamunge::nn port of tflow_examples src/common/rl/pg_common.h.
// Pieces shared by the policy-gradient and actor-critic examples: config,
// a softmax actor + value critic built from nn layers, action sampling,
// discounted returns and GAE on the host, and batched rollouts from a VecEnv.
// Monitor, Evaluate and Adam are reused from dqn_common.hpp.
//
// Changes from the TF version: BuildActorCritic runs the network on a
// tensor (eager) instead of adding graph nodes, ObsMatrix/IntVector return
// nn::Tensor (actions as int64), and TF hardware options are ignored.

#include <cmath>
#include <cstdint>
#include <cstdio>
#include <cstdlib>
#include <datamunge/nn/nn.hpp>
#include <random>
#include <string>
#include <vector>




// Editable workflow support: rl/vec_env.hpp
#include <datamunge/rl/environments.hpp>
namespace rl {
using datamunge::rl::environments::VecStep;
using datamunge::rl::environments::VecEnv;
}

namespace rl {

struct PgConfig {
  int steps = 100000;        // environment steps in total (all envs)
  float gamma = 0.99f;
  float lam = 0.95f;         // GAE lambda
  float lr = 1e-3f;
  float clip_norm = 0.5f;
  float entropy_coef = 0.01f;
  float value_coef = 0.5f;
  int hidden = 64;
  int n_envs = 8;            // parallel environments for batched rollouts
  int n_steps = 5;           // rollout length per update
  int log_every = 10000;
  int eval_every = 10000;
  int eval_episodes = 5;
  uint64_t seed = 0;
};

// `just run-nn a2c steps=200000 lr=5e-4 n_envs=16`
inline void ParsePgConfig(int argc, char** argv, PgConfig* c) {
  for (int i = 1; i < argc; ++i) {
    const std::string arg = argv[i];
    const size_t eq = arg.find('=');
    if (eq == std::string::npos) continue;
    const std::string key = arg.substr(0, eq);
    const float v = std::strtof(arg.c_str() + eq + 1, nullptr);
    if (IsHardwareOption(key)) continue;
    if (key == "steps") c->steps = static_cast<int>(v);
    else if (key == "gamma") c->gamma = v;
    else if (key == "lam") c->lam = v;
    else if (key == "lr") c->lr = v;
    else if (key == "clip_norm") c->clip_norm = v;
    else if (key == "entropy") c->entropy_coef = v;
    else if (key == "value_coef") c->value_coef = v;
    else if (key == "hidden") c->hidden = static_cast<int>(v);
    else if (key == "n_envs") c->n_envs = static_cast<int>(v);
    else if (key == "n_steps") c->n_steps = static_cast<int>(v);
    else if (key == "log_every") c->log_every = static_cast<int>(v);
    else if (key == "eval_every") c->eval_every = static_cast<int>(v);
    else if (key == "seed") c->seed = static_cast<uint64_t>(v);
    else if (key != "task" && key != "game") std::fprintf(stderr, "unknown option %s\n", arg.c_str());
  }

  if (!example_runtime::Full()) {
    c->steps = std::min(c->steps, 512);
    c->n_envs = std::min(c->n_envs, 4);
    c->log_every = c->eval_every = std::max(1, c->steps);
    c->eval_episodes = 1;
    example_runtime::Describe();
  }
}

// A DqnConfig carrying the logging fields, for the shared Monitor.
inline DqnConfig MonitorConfig(const PgConfig& c) {
  DqnConfig d;
  d.log_every = c.log_every;
  d.eval_every = c.eval_every;
  d.eval_episodes = c.eval_episodes;
  return d;
}

// Softmax policy over discrete actions plus (optionally) a state-value head
// on its own trunk. All outputs are per row of `obs` [B, obs_dim].
using dm::nn::models::ActorCritic;using dm::nn::models::BuildActorCritic;
using dm::rl::returns::DiscountedReturns;using dm::rl::returns::Gae;
inline nn::Tensor LogProbOf(const nn::Tensor& logp,const nn::Tensor& actions,int count){if(logp.size(1)!=count)throw std::invalid_argument("action width");return dm::rl::foundations::CategoricalActionLogProbability(logp,actions);}
inline int SampleAction(const float* probs,int n,std::mt19937_64& rng){return dm::rl::foundations::SampleCategoricalAction(probs,n,rng);}
// Rows of observations as a float [n, obs_dim] tensor.
inline nn::Tensor ObsMatrix(const std::vector<Obs>&rows){return dm::rl::foundations::ObservationMatrix(rows);}
// Actions as an int64 [n] tensor.
inline nn::Tensor IntVector(const std::vector<int>& v) {
  return nn::from_vector(std::vector<std::int64_t>(v.begin(), v.end()), {static_cast<std::int64_t>(v.size())});
}
inline nn::Tensor FloatVector(const std::vector<float>& v) {
  return nn::from_vector(v, {static_cast<std::int64_t>(v.size())});
}

// n_steps x n_envs rollouts from a VecEnv, stored env-major so each
// environment's sub-trajectory is contiguous for GAE.
using dm::rl::returns::Rollout;

// Collects a rollout. `policy(obs_batch, &probs [n_envs * A], &values [n_envs])`
// runs the network; episode returns are reported to the monitor.
class RolloutCollector {
 public:
  RolloutCollector(VecEnv& venv, int n_actions, uint64_t seed)
      : venv_(venv), A_(n_actions), rng_(seed), obs_(venv.reset()), ep_return_(venv.size(), 0.f) {}

  template <typename PolicyFn>
  Rollout Collect(int n_steps, PolicyFn policy, Monitor* monitor) {
    const int n = venv_.size();
    Rollout ro;
    ro.n_envs = n;
    ro.n_steps = n_steps;
    ro.obs.assign(n, {});
    ro.act.assign(n, {});
    ro.rew.assign(n, {});
    ro.done.assign(n, {});
    ro.val.assign(n, {});
    ro.logp.assign(n, {});
    std::vector<float> probs, values;
    std::vector<Action> actions(n);
    for (int t = 0; t < n_steps; ++t) {
      policy(obs_, &probs, &values);
      for (int i = 0; i < n; ++i) {
        const int a = SampleAction(&probs[i * A_], A_, rng_);
        actions[i] = Action(a);
        ro.obs[i].push_back(obs_[i]);
        ro.act[i].push_back(a);
        ro.val[i].push_back(values[i]);
        ro.logp[i].push_back(std::log(std::max(probs[i * A_ + a], 1e-8f)));
      }
      VecStep s = venv_.step(actions);
      for (int i = 0; i < n; ++i) {
        ro.rew[i].push_back(s.reward[i]);
        ro.done[i].push_back(s.terminated[i] ? 1.f : 0.f);  // truncation still bootstraps
        ep_return_[i] += s.reward[i];
        if (s.done(i)) {
          if (monitor) monitor->EndEpisode(ep_return_[i]);
          ep_return_[i] = 0;
        }
        // On truncation the next observation is a fresh episode; bootstrap
        // from the final observation instead would be more exact, but the
        // reset observation is what we have in batch form.
      }
      obs_ = s.obs;
      total_steps_ += n;
    }
    policy(obs_, &probs, &values);
    ro.last_obs = obs_;
    ro.last_val = values;
    return ro;
  }
  long total_steps() const { return total_steps_; }

 private:
  VecEnv& venv_;
  int A_;
  std::mt19937_64 rng_;
  std::vector<Obs> obs_;
  std::vector<float> ep_return_;
  long total_steps_ = 0;
};

}  // namespace rl

// Editable workflow support: rl/play_best.hpp
// datamunge::nn port helper standing in for tflow's vsim_studio.h RecordBest.
//
// RecordBest plays `candidates` seeded episodes (seeds seed .. seed+candidates-1) without
// filming, then films the one with the highest return. PlayBestOfSeeds runs the same candidate
// episodes, prints the same "best of N" line, and replays the best one with PlayEpisode
// (common/rl/playback.hpp), which prints its steps and return instead of writing a video.

#include <cstdint>
#include <cstdio>
#include <limits>
#include <string>
#include <utility>

// Editable workflow support: rl/playback.hpp
// datamunge::nn port helper standing in for tflow's src/common/rl/vsim_studio.h recorders.
//
// tflow films episodes with vsim's renderer and ffmpeg (RecordEpisode); both are out of scope
// for the datamunge ports. PlayEpisode runs exactly the episode RecordEpisode would film (same
// reset seed, the same Decide/Hud bookkeeping, one env step per loop) without a video and prints
// the same summary line, so the steps and return can be compared with tflow's "recorded ..."
// line. tflow's recorder also stops when the film reaches `max_frames`; frames are not steps
// (they depend on the world's frame rate), so PlayEpisode ignores that cap: for every episode
// the 6.1 examples film, the episode ends before the film is full.

#include <cstdint>
#include <cstdio>
#include <string>
#include <type_traits>
#include <utility>



namespace rl {

// The policy's decision for `obs`, as in vsim_studio.h: a Decision passes through, a bare
// action (an int, a vector or an Action) is wrapped.
template <typename PolicyFn>
Decision Decide(PolicyFn& policy, const Obs& obs) {
  if constexpr (std::is_same_v<std::decay_t<decltype(policy(obs))>, Decision>) return policy(obs);
  else return Decision(Action(policy(obs)));
}

struct Playback {
  int steps = 0;
  float ret = 0;
  Hud hud;  // the overlay state after the last step (decision, reward, return)
};

// Plays one episode of `policy` from env.reset(seed); `after_step(env, hud)` is called after
// the reset (step 0) and after every step, e.g. to snapshot frames.
template <typename Env, typename PolicyFn, typename AfterStep>
Playback PlayEpisode(Env& env, PolicyFn&& policy, const std::string& name, uint64_t seed, AfterStep after_step) {
  Playback pb;
  pb.hud.Reset(env.action_space(), env.action_names());
  Obs obs = env.reset(seed);
  after_step(static_cast<const Env&>(env), static_cast<const Hud&>(pb.hud));
  while (true) {
    pb.hud.Choose(Decide(policy, obs));
    const StepResult r = env.step(pb.hud.decision.action);
    pb.hud.Observe(r);
    pb.ret += r.reward;
    ++pb.steps;
    obs = r.obs;
    after_step(static_cast<const Env&>(env), static_cast<const Hud&>(pb.hud));
    if (r.done()) break;
  }
  std::printf("  played %s (video omitted): %d steps, return %.1f\n", name.c_str(), pb.steps, pb.ret);
  return pb;
}

template <typename Env, typename PolicyFn>
Playback PlayEpisode(Env& env, PolicyFn&& policy, const std::string& name, uint64_t seed) {
  return PlayEpisode(env, std::forward<PolicyFn>(policy), name, seed, [](const Env&, const Hud&) {});
}

}  // namespace rl

namespace rl {

template <typename Env, typename PolicyFn>
Playback PlayBestOfSeeds(Env& env, PolicyFn&& policy, const std::string& name, uint64_t seed, int candidates = 5) {
  uint64_t best_seed = seed;
  float    best = -std::numeric_limits<float>::infinity();
  for (int c = 0; c < candidates; ++c) {
    float ret = 0;
    Obs   obs = env.reset(seed + c);
    while (true) {
      const StepResult r = env.step(Decide(policy, obs).action);
      ret += r.reward;
      obs = r.obs;
      if (r.done()) break;
    }
    if (ret > best) best = ret, best_seed = seed + c;
  }
  std::printf("  best of %d episodes (return %.1f):\n", candidates, best);
  return PlayEpisode(env, std::forward<PolicyFn>(policy), name, best_seed);
}

}  // namespace rl

namespace nn = datamunge::nn;
using nn::Tensor;

namespace {

// The paper (appendix F) trains value and reward heads in a transformed space
// h(x) = sign(x)(sqrt(|x| + 1) - 1) + 0.001 x and inverts it in the search. At
// CartPole's scale the identity learned faster in our runs (the transform
// shrinks the targets so much that the value head barely moves), so it is
// off by default; flip kUseValueTransform to try it.
constexpr bool kUseValueTransform = false;
inline float Transform(float x) {
return nn::models::MuZeroValueTransform(x,kUseValueTransform);
}
inline float InverseTransform(float y) {
return nn::models::MuZeroInverseValueTransform(y,kUseValueTransform);
}

struct Step {
  rl::Obs obs;
  int action;
  float reward;
  std::vector<float> search_policy;
  float search_value;
};
struct Episode {
  std::vector<Step> steps;
  bool terminated = false;
};

// Search node in latent space.
struct Node {
  std::vector<float> state;  // hidden state (after expansion)
  float reward = 0.f, prior = 0.f, value_sum = 0.f;
  int visits = 0;
  std::vector<std::unique_ptr<Node>> children;
  bool expanded() const { return !children.empty(); }
  float Q() const { return visits ? value_sum / visits : 0.f; }
};

}  // namespace

int main(int argc, char** argv) {
  try {
  rl::DqnConfig cfg;
  cfg.steps = 20000;
  cfg.warmup = 500;
  cfg.batch = 64;
  cfg.log_every = 2500;
  cfg.eval_every = 5000;
  rl::ParseConfig(argc, argv, &cfg);
  for (int i = 1; i < argc; ++i) {
    const std::string arg = argv[i];
    if (arg.rfind("threads=", 0) == 0) nn::set_num_threads(std::atoi(arg.c_str() + 8));
  }
  const int S = 32, K = 5, n_step = 10, simulations = 25;
  const float gamma = 0.997f, c1 = 1.25f, alpha_dir = 0.25f;
  rl::CartPole env, eval_env;
  const int obs_dim = env.obs_size(), A = env.action_space().n;
  std::printf("== MuZero on CartPole: %d steps, %d simulations per move, unroll K=%d, %d-step value targets\n", cfg.steps, simulations, K, n_step);

  nn::ParameterStore params(cfg.seed);

  report_capture::Checkpoint checkpoint_params{params};

  auto scale = [&](const Tensor& s) {
return nn::models::MuZeroScale(s);
};
  auto represent = [&](const Tensor& o) {
return nn::models::MuZeroRepresentation(params,o,S);
};
  using Dyn=nn::models::MuZeroDynamicsPath;
  auto dynamics = [&](const Tensor& s, const Tensor& a_onehot) {
return nn::models::MuZeroDynamics(params,s,a_onehot,S);
};
  using Pred=nn::models::MuZeroPredictionPath;
  auto predict = [&](const Tensor& s) {
return nn::models::MuZeroPrediction(params,s,A);
};
  auto one_hot_rows = [&](const std::vector<int>& actions) {
    std::vector<float> v(actions.size() * A, 0.f);
    for (size_t i = 0; i < actions.size(); ++i) v[i * A + actions[i]] = 1.f;
    return nn::from_vector(v, {static_cast<std::int64_t>(actions.size()), A});
  };
  {  // build every weight once so Adam sees them
    nn::NoGradGuard no_grad;
    const Tensor s0 = represent(nn::zeros({1, obs_dim}));
    predict(s0);
    dynamics(s0, one_hot_rows({0}));
  }
  nn::Optimizer native_adam(params,1e-3,{nn::OptimizerKind::Adam});
auto native_adam_minimize=[&](const Tensor& loss){auto gradients=nn::grad(loss,native_adam.parameters());double norm;if(5.0>0){auto clipped=nn::clip_by_global_norm(gradients,5.0);gradients=std::move(clipped.first);norm=clipped.second;}else norm=nn::global_norm(gradients);native_adam.step(gradients);return norm;};


  std::mt19937_64 rng(cfg.seed);
  // Inference "graphs" for search: initial (s0, softmax policy, value) and recurrent.
  struct Inference {
    std::vector<float> state, probs;
    float reward = 0, value = 0;
  };
  auto initial_inference = [&](const rl::Obs& obs) {
    nn::NoGradGuard no_grad;
    const Tensor s0 = represent(rl::Row(obs));
    const Pred p = predict(s0);
    return Inference{s0.to_vector<float>(), nn::softmax(p.logits, -1).to_vector<float>(), 0.f, p.value.item<float>()};
  };
  auto recurrent_inference = [&](const std::vector<float>& state, int action) {
    nn::NoGradGuard no_grad;
    const Dyn d = dynamics(nn::from_vector(state, {1, S}), one_hot_rows({action}));
    const Pred p = predict(d.state);
    return Inference{d.state.to_vector<float>(), nn::softmax(p.logits, -1).to_vector<float>(), d.reward.item<float>(), p.value.item<float>()};
  };
  // MCTS in latent space with min-max normalised Q values.
  auto search = [&](const rl::Obs& obs, bool add_noise, std::vector<float>* policy_out) {
    Node tree;
    const Inference init = initial_inference(obs);
    tree.state = init.state;
    std::vector<float> prior = init.probs;
    if (add_noise) {
      std::gamma_distribution<float> gd(alpha_dir, 1.f);
      std::vector<float> n(A);
      float sum = 0;
      for (float& x : n) sum += (x = gd(rng));
      for (int a = 0; a < A; ++a) prior[a] = 0.75f * prior[a] + 0.25f * n[a] / sum;
    }
    for (int a = 0; a < A; ++a) {
      tree.children.push_back(std::make_unique<Node>());
      tree.children.back()->prior = prior[a];
    }
    float q_min = 1e9f, q_max = -1e9f;
    auto norm_q = [&](float q) { return q_max > q_min ? (q - q_min) / (q_max - q_min) : q; };
    for (int sim = 0; sim < simulations; ++sim) {
      Node* node = &tree;
      std::vector<Node*> path{node};
      std::vector<int> actions;
      while (node->expanded()) {
        int best = 0;
        float best_score = -1e9f;
        for (int a = 0; a < A; ++a) {
          const Node* ch = node->children[a].get();
          const float q = ch->visits ? norm_q(ch->reward + gamma * ch->Q()) : 0.f;
          const float score = q + ch->prior * std::sqrt(static_cast<float>(node->visits)) / (1 + ch->visits) * c1;
          if (score > best_score) best_score = score, best = a;
        }
        actions.push_back(best);
        node = node->children[best].get();
        path.push_back(node);
      }
      // Expand with the dynamics + prediction networks.
      Node* parent = path[path.size() - 2];
      const Inference inf = recurrent_inference(parent->state, actions.back());
      node->state = inf.state;
      node->reward = InverseTransform(inf.reward);
      for (int a = 0; a < A; ++a) {
        node->children.push_back(std::make_unique<Node>());
        node->children.back()->prior = inf.probs[a];
      }
      float value = InverseTransform(inf.value);
      for (int d = static_cast<int>(path.size()) - 1; d >= 0; --d) {
        path[d]->value_sum += value;
        path[d]->visits += 1;
        q_min = std::min(q_min, path[d]->reward + gamma * path[d]->Q());
        q_max = std::max(q_max, path[d]->reward + gamma * path[d]->Q());
        value = path[d]->reward + gamma * value;
      }
    }
    policy_out->assign(A, 0.f);
    for (int a = 0; a < A; ++a) (*policy_out)[a] = static_cast<float>(tree.children[a]->visits) / simulations;
    return tree.Q();
  };
  // ---- Training: unroll K steps from the observed position.
  auto train = [&](const std::vector<float>& O, const std::vector<std::vector<int>>& acts, const std::vector<std::vector<float>>& V,
                   const std::vector<std::vector<float>>& R, const std::vector<std::vector<float>>& P, const std::vector<std::vector<float>>& M) {
    const int Bn = cfg.batch;
    Tensor loss;
    Tensor st = represent(nn::from_vector(O, {Bn, obs_dim}));
    for (int k = 0; k <= K; ++k) {
      const Pred p = predict(st);
      const Tensor mask = nn::from_vector(M[k], {Bn});
      const Tensor v_loss = nn::square(nn::from_vector(V[k], {Bn}) - p.value);
      const Tensor p_loss = -nn::sum(nn::from_vector(P[k], {Bn, A}) * nn::log_softmax(p.logits, -1), {1});
      Tensor step_loss = mask * (0.25 * v_loss + p_loss);
      if (k < K) {
        const Dyn d = dynamics(st, one_hot_rows(acts[k]));
        step_loss = step_loss + mask * nn::square(nn::from_vector(R[k], {Bn}) - d.reward);
        // Scale the gradient flowing into the dynamics by 1/K (paper, appendix G).
        st = (1.0 / K) * d.state + (1.0 - 1.0 / K) * d.state.detach();
      }
      const Tensor l = nn::mean(step_loss, {0});
      loss = k ? loss + l : l;
    }
    const float value = loss.item<float>();
    native_adam_minimize(loss);
    return value;
  };

  std::deque<Episode> replay;
  Episode current;
  rl::Monitor monitor(cfg, "root value");
  auto greedy = [&](const rl::Obs& o) {
    std::vector<float> pi;
    search(o, false, &pi);
    return static_cast<int>(std::max_element(pi.begin(), pi.end()) - pi.begin());
  };
  rl::Obs obs = env.reset(cfg.seed);
  float ret = 0, root_value = 0, first_loss = -1;
  std::vector<float> evals;
  for (int step = 1; step <= cfg.steps; ++step) {
    std::vector<float> pi;
    root_value = search(obs, true, &pi);
    // Sample from the visit distribution early in training (temperature 1), argmax later.
    const int act = step < cfg.steps / 2 ? rl::SampleAction(pi.data(), A, rng) : static_cast<int>(std::max_element(pi.begin(), pi.end()) - pi.begin());
    rl::StepResult sr = env.step(act);
    current.steps.push_back({obs, act, sr.reward, pi, root_value});
    ret += sr.reward;
    obs = sr.obs;
    if (sr.done()) {
      current.terminated = sr.terminated;
      replay.push_back(std::move(current));
      current = Episode();
      while (replay.size() > 200) replay.pop_front();
      monitor.EndEpisode(ret);
      ret = 0;
      obs = env.reset();
    }
    if (step >= cfg.warmup && step % 2 == 0 && !replay.empty()) {
      // Build a batch of K-step unrolls with n-step value targets.
      const int Bn = cfg.batch;
      std::vector<float> O(static_cast<size_t>(Bn) * obs_dim);
      std::vector<std::vector<int>> Ac(K, std::vector<int>(Bn));
      std::vector<std::vector<float>> V(K + 1, std::vector<float>(Bn)), R(K, std::vector<float>(Bn)), M(K + 1, std::vector<float>(Bn)),
          P(K + 1, std::vector<float>(static_cast<size_t>(Bn) * A));
      for (int b = 0; b < Bn; ++b) {
        const Episode& ep = replay[rng() % replay.size()];
        const int T = static_cast<int>(ep.steps.size());
        const int pos = static_cast<int>(rng() % T);
        for (int j = 0; j < obs_dim; ++j) O[b * obs_dim + j] = ep.steps[pos].obs[j];
        for (int k = 0; k <= K; ++k) {
          const int t = pos + k;
          const bool inside = t < T;
          M[k][b] = inside ? 1.f : 0.f;
          // n-step return bootstrapped from the stored search value.
          float target = 0;
          if (inside) {
            float disc = 1;
            for (int i = t; i < std::min(T, t + n_step); ++i) target += disc * ep.steps[i].reward, disc *= gamma;
            if (t + n_step < T) target += disc * ep.steps[t + n_step].search_value;
            else if (!ep.terminated) target += disc * ep.steps[T - 1].search_value;  // truncated: bootstrap
          }
          V[k][b] = Transform(target);
          for (int a = 0; a < A; ++a) P[k][b * A + a] = inside ? ep.steps[t].search_policy[a] : 1.f / A;
          if (k < K) {
            Ac[k][b] = inside ? ep.steps[t].action : static_cast<int>(rng() % A);
            R[k][b] = Transform(inside ? ep.steps[t].reward : 0.f);
          }
        }
      }
      const float l = train(O, Ac, V, R, P, M);
      check::Require(std::isfinite(l), "finite MuZero loss");
      if (first_loss < 0) first_loss = l;
      monitor.AddLoss(l);
    }
    if (step % cfg.log_every == 0) {
      const float ev = step % cfg.eval_every == 0 ? rl::Evaluate(eval_env, greedy, cfg.eval_episodes, 1000 + step) : NAN;
      if (!std::isnan(ev)) evals.push_back(ev);
      monitor.Log(step, root_value, ev);
    }
  }
  const float final_eval = rl::Evaluate(eval_env, greedy, 10, 777);
  std::printf("  final evaluation over 10 episodes (search with %d simulations, no noise): %.1f\n", simulations, final_eval);
  // On film in TF: the search's visit share per action and the root value it backed up.
  rl::PlayBestOfSeeds(eval_env, [&](const rl::Obs& o) {
    std::vector<float> pi;
    const float v = search(o, false, &pi);
    rl::Decision d = rl::GreedyPi(pi, v, "visit share");
    d.value_name = "root value";
    d.note = "MCTS, " + std::to_string(simulations) + " simulations in the learned model";
    return d;
  }, "muzero_cartpole", 4242, 2);

  // Checks added by the port (tflow prints the table only).
  // Thresholds from 4 seeds of the port (max periodic eval 347/445/368/158, final 260/388/378/143;
  // TF seed 0: 226 and 234). (The unrolled loss grows with training as the value targets grow with the episodes, so it is not checked.)
  check::Require(first_loss > 0, "MuZero trained");
  if (cfg.steps >= 20000) {
    check::TrainingQuality(*std::max_element(evals.begin(), evals.end()) >= 150, "search in the learned model reaches 150 in some periodic evaluation");
    check::TrainingQuality(final_eval >= 120, "search in the learned model balances the pole (final 10-episode evaluation >= 120)");
  }
  std::printf("\nchecks passed (vsim video omitted)\n");
  } catch (const std::exception& e) {
    std::fprintf(stderr, "CHECK FAILED: %s\n", e.what());
    return 1;
  }
  return 0;
}

