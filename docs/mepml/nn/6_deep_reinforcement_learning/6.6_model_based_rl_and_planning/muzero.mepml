int main(){namespace n=dm::nn;namespace m=n::models;std::filesystem::create_directories("build");n::ParameterStore p(0);n::Module network([&](const n::Tensor&x){auto s=m::MuZeroRepresentation(p,x,32);auto d=m::MuZeroDynamics(p,s,n::from_vector(std::vector<float>{1,0},{1,2}),32);return m::MuZeroPrediction(p,d.state,2).logits;},"muzero source model");n::ModelPlotOptions options;options.detail=n::ModelPlotDetail::Blocks;options.sizing.minimum_extent=2;options.sizing.max_planes=2;network.plot(n::zeros({1,4}),options).save_svg("build/muzero_network.svg");}
