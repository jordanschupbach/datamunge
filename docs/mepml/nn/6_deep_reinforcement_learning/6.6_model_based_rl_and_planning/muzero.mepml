int main(){std::filesystem::create_directories("build");auto s=dm::nn::models::MuZeroScale(dm::nn::from_vector(std::vector<float>{2,4,6},{1,3}));std::vector<double>values=s.to_vector<double>();std::print("| coordinate | computed value |\n|---:|---:|\n");for(size_t i=0;i<values.size();++i)std::print("| {} | {:.9f} |\n",i,values[i]);std::vector<double>x(values.size());std::iota(x.begin(),x.end(),0.);double low=std::min(0.,*std::min_element(values.begin(),values.end())),high=std::max(0.,*std::max_element(values.begin(),values.end())),span=std::max(1.,high-low);dm::graphics::RPlot::create().bars(x,values,"computed values",{37,99,235}).ylim(low-.05*span,high+.05*span).title("muzero worked calculation").size(1000,550).save_svg("build/muzero_worked.svg");}
