int main(){namespace e=dm::rl::environments;std::filesystem::create_directories("build");e::Acrobot env;env.reset(1);double expected=-std::cos(env.theta1())-std::cos(env.theta1()+env.theta2());std::vector<double>values{expected,env.tip_height()};if(std::abs(values[0]-values[1])>2e-7)return 1;std::print("| coordinate | computed value |\n|---:|---:|\n");for(size_t i=0;i<values.size();++i)std::print("| {} | {:.9f} |\n",i,values[i]);dm::nn::save_npz("build/acrobot_worked.npz",{{"values",dm::nn::from_vector(values)}});std::vector<double>x(values.size());std::iota(x.begin(),x.end(),0.);const double low=std::min(0.,*std::min_element(values.begin(),values.end())),high=std::max(0.,*std::max_element(values.begin(),values.end())),span=std::max(1e-9,high-low);dm::graphics::RPlot::create().ylim(low-.05*span,high+.05*span).bars(x,values,"computed values",{37,99,235}).title("Read the tip height from two angles").x_label("Coordinate in displayed calculation").size(1000,550).save_svg("build/acrobot_worked.svg");}
