> Check deterministic Bernoulli endpoints

An arm with success probability0 always pays0, and an arm with probability1 always pays1. These two exact endpoints separate an expected reward from a noisy observation before the source tests sample means.

```{cpp, results="markdown", file="figures/bandits_worked.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -lpthread -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main(){namespace e=dm::rl::environments;std::filesystem::create_directories("build");auto env=e::MultiArmedBandit::Bernoulli({0,1});env.reset(1);auto a=env.step(0);env.reset();auto c=env.step(1);std::vector<double>values{env.mean(0),a.reward,env.mean(1),c.reward};if(a.reward!=0||c.reward!=1)return 1;std::print("| coordinate | computed value |\n|---:|---:|\n");for(size_t i=0;i<values.size();++i)std::print("| {} | {:.9f} |\n",i,values[i]);dm::nn::save_npz("build/bandits_worked.npz",{{"values",dm::nn::from_vector(values)}});std::vector<double>x(values.size());std::iota(x.begin(),x.end(),0.);const double low=std::min(0.,*std::min_element(values.begin(),values.end())),high=std::max(0.,*std::max_element(values.begin(),values.end())),span=std::max(1e-9,high-low);dm::graphics::RPlot::create().ylim(low-.05*span,high+.05*span).bars(x,values,"computed values",{37,99,235}).title("Check deterministic Bernoulli endpoints").x_label("Coordinate in displayed calculation").size(1000,550).save_svg("build/bandits_worked.svg");}
