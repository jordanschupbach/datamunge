> Complete source experiment

The source seeds, episode counts, controls and checks are preserved. Every rollout and policy loop is visible here, using canonical C++ environment objects. These are compact teaching simulations; throughput varies with machine load, and the source visual replay is represented by native figures and a Snake filmstrip rather than an external video recorder.

```{cpp, results="output", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -lpthread -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
// CMD: just run-nn bandits
// Multi-armed bandits.
//
// Port of tflow's bandits. Bandits are one-step environments: no state (or a
// context that does not depend on the action), a reward per pull, and the
// episode ends. This program shows the three variants in
// common/rl/bandit.hpp (copied from tflow) and the notion of regret that
// bandit algorithms (6.2) try to minimise. The vsim video of 15 random and 15
// best-arm pulls is omitted (its pulls are still drawn, so the RNG stream and
// every later number match tflow); the port adds checks on the sample means,
// the regret and the contextual oracle.

#include <cmath>
#include <cstdio>
#include <iostream>
#include <vector>

// Editable workflow support: checks.hpp
// Small runtime checks used by the executable nn examples. They stay on in
// Release builds and make the example exit nonzero on failure, so `just
// run-all-nn` doubles as a regression test against the recorded TF numbers.

#include <cmath>
#include <iostream>
#include <stdexcept>
#include <string>
// Editable workflow support: runtime.hpp
// Bounded demonstrations by default; opt into convergence experiments explicitly.

#include <algorithm>
#include <cstdlib>
#include <iostream>
#include <string>

namespace example_runtime {

inline bool Full() {
  const char* value = std::getenv("DATAMUNGE_EXAMPLES_FULL");
  return value && std::string(value) == "1";
}

template <typename T> T Limit(T requested, T quick_limit) {
  return Full() ? requested : std::min(requested, quick_limit);
}

inline void Describe() {
  if (!Full())
    std::cout << "Quick demonstration: bounded training; convergence metrics require "
                 "DATAMUNGE_EXAMPLES_FULL=1.\n";
}

}  // namespace example_runtime

namespace check {

inline void Require(bool condition, const std::string& message) {
  if (!condition) throw std::runtime_error(message);
}

// A short demonstration checks execution, derivatives and persistence; reaching
// a published accuracy/return requires the separately requested full schedule.
inline void TrainingQuality(bool condition, const std::string& message) {
  if (example_runtime::Full()) Require(condition, message);
  else std::cout << "  full-training quality check deferred: " << message << '\n';
}

inline void Near(double actual, double expected, double tolerance, const std::string& message) {
  if (!std::isfinite(actual) || !std::isfinite(expected) || std::abs(actual - expected) > tolerance)
    throw std::runtime_error(message + ": got " + std::to_string(actual) + ", expected " + std::to_string(expected));
}

/// Expects `f` to throw; returns the message.
template <typename F>
std::string Throws(F&& f, const std::string& message) {
  try {
    f();
  } catch (const std::exception& e) {
    return e.what();
  }
  throw std::runtime_error(message + ": expected an exception");
}

}  // namespace check

inline void Header(const std::string& title) {
  const std::size_t pad = title.size() < 60 ? 60 - title.size() : 0;
  std::cout << "\n== " << title << " " << std::string(pad, '=') << "\n";
}

// Editable workflow support: rl/bandit.hpp
#include <datamunge/rl/environments.hpp>
namespace rl {
using datamunge::rl::environments::ArmNames;
using datamunge::rl::environments::MultiArmedBandit;
using datamunge::rl::environments::ContextualBandit;
}

// Editable workflow support: rl/utils.hpp
// datamunge::nn port: copied from tflow_examples src/common/rl/utils.h (TF-free code, unchanged).
// Small helpers shared by the RL examples: episode statistics, random and
// greedy rollouts, and printing.

#include <algorithm>
#include <cmath>
#include <cstdio>
#include <functional>
#include <numeric>
#include <string>
#include <vector>

// Editable workflow support: rl/env.hpp
#include <datamunge/rl/environments.hpp>
namespace rl {
using datamunge::rl::environments::Obs;
using datamunge::rl::environments::Action;
using datamunge::rl::environments::ActionSpace;
using datamunge::rl::environments::StepResult;
using datamunge::rl::environments::Env;
using datamunge::rl::environments::EnvBase;
using datamunge::rl::environments::Transition;
using datamunge::rl::environments::TabularEnv;
}

namespace rl {

struct EpisodeStats {
  std::vector<float> returns;
  std::vector<int> lengths;
  float mean_return() const {
    return returns.empty() ? 0.f
                           : std::accumulate(returns.begin(), returns.end(), 0.f) / returns.size();
  }
  float mean_length() const {
    return lengths.empty() ? 0.f
                           : std::accumulate(lengths.begin(), lengths.end(), 0.f) / lengths.size();
  }
  float min_return() const { return *std::min_element(returns.begin(), returns.end()); }
  float max_return() const { return *std::max_element(returns.begin(), returns.end()); }
};

// Run `episodes` episodes of `env` choosing actions with `policy(obs)`.

// Uniformly random actions.

inline void PrintStats(const std::string& label, const EpisodeStats& s) {
  std::printf("  %-32s return mean %8.2f  min %8.2f  max %8.2f   length mean %6.1f\n",
              label.c_str(), s.mean_return(), s.min_return(), s.max_return(), s.mean_length());
}

inline int ArgMax(const std::vector<float>& v) {
  return static_cast<int>(std::max_element(v.begin(), v.end()) - v.begin());
}

// Argmax with ties broken uniformly at random.
inline int ArgMaxRandomTie(const float* q, int n, std::mt19937_64& rng) {
  float best = q[0];
  for (int i = 1; i < n; ++i) best = std::max(best, q[i]);
  std::vector<int> ties;
  for (int i = 0; i < n; ++i)
    if (q[i] == best) ties.push_back(i);
  return ties[rng() % ties.size()];
}

inline std::string FormatObs(const Obs& o, int max_elems = 8) {
  std::string s = "[";
  for (size_t i = 0; i < o.size() && static_cast<int>(i) < max_elems; ++i) {
    char buf[32];
    std::snprintf(buf, sizeof buf, "%s%.3f", i ? " " : "", o[i]);
    s += buf;
  }
  if (static_cast<int>(o.size()) > max_elems) s += " ...";
  return s + "]";
}

}  // namespace rl


int main() {
  try {
    std::cout << "== 10-armed Gaussian testbed (Sutton & Barto 2.3)\n";
    rl::MultiArmedBandit testbed = rl::MultiArmedBandit::Testbed(10, /*seed=*/42);
    testbed.Seed(0);
    std::cout << "  " << testbed.name() << "  action_space=" << testbed.action_space().ToString()
              << "  obs_size=" << testbed.obs_size() << "\n";
    std::printf("  %-4s %10s %12s\n", "arm", "true mean", "sample mean");
    for (int a = 0; a < testbed.num_arms(); ++a) {
      double sum = 0;
      for (int i = 0; i < 1000; ++i) {
        testbed.reset();
        sum += testbed.step(a).reward;
      }
      std::printf("  %-4d %10.3f %12.3f%s\n", a, testbed.mean(a), sum / 1000,
                  a == testbed.best_arm() ? "  <- best" : "");
      // Unit-variance rewards: the mean of 1000 pulls is within 4 standard errors.
      check::Near(sum / 1000, testbed.mean(a), 4 / std::sqrt(1000.0), "sample mean of arm " + std::to_string(a));
    }

    std::cout << "\n== Regret: how much a policy loses against always pulling the best arm\n";
    const int T = 2000;
    std::mt19937_64 rng(0);
    double random_reward = 0, best_reward = 0;
    for (int t = 0; t < T; ++t) {
      testbed.reset();
      random_reward += testbed.step(testbed.action_space().Sample(rng)).reward;
      testbed.reset();
      best_reward += testbed.step(testbed.best_arm()).reward;
    }
    float mean_of_means = 0;
    for (int a = 0; a < testbed.num_arms(); ++a) mean_of_means += testbed.mean(a);
    mean_of_means /= testbed.num_arms();
    const double expected_regret = T * (testbed.best_mean() - mean_of_means);
    std::printf("  over %d pulls: random policy %.1f, best arm %.1f, regret %.1f (expected %.1f)\n",
                T, random_reward, best_reward, best_reward - random_reward, expected_regret);
    // Standard deviation of the regret: about sqrt(2T) from the reward noise plus the spread of the means.
    check::Near(best_reward - random_reward, expected_regret, 0.1 * expected_regret + 4 * std::sqrt(4.0 * T),
                "regret of the random policy");

    // tflow films 15 random pulls and 15 pulls of the best arm here; the film
    // is omitted but the pulls are made so the generators stay in step.
    for (int t = 0; t < 30; ++t) {
      const int arm = t < 15 ? static_cast<int>(rng() % testbed.num_arms()) : testbed.best_arm();
      testbed.reset();
      testbed.step(arm);
    }

    std::cout << "\n== Bernoulli arms\n";
    rl::MultiArmedBandit coins = rl::MultiArmedBandit::Bernoulli({0.1f, 0.5f, 0.7f, 0.65f});
    coins.Seed(1);
    for (int a = 0; a < coins.num_arms(); ++a) {
      int wins = 0;
      for (int i = 0; i < 1000; ++i) {
        coins.reset();
        wins += coins.step(a).reward > 0;
      }
      std::printf("  arm %d: p=%.2f  observed %d/1000\n", a, coins.mean(a), wins);
      check::Near(wins / 1000.0, coins.mean(a), 4 * std::sqrt(0.25 / 1000), "win rate of coin " + std::to_string(a));
    }

    std::cout << "\n== Contextual bandit: the best arm depends on the context\n";
    rl::ContextualBandit ctx(/*context_dim=*/4, /*num_arms=*/3, /*seed=*/3);
    ctx.Seed(0);
    for (int round = 0; round < 4; ++round) {
      rl::Obs x = ctx.reset();
      std::printf("  context %s  P(reward|arm) =", rl::FormatObs(x).c_str());
      for (int a = 0; a < ctx.num_arms(); ++a) std::printf(" %.2f", ctx.ExpectedReward(a));
      rl::StepResult r = ctx.step(ctx.BestArm());
      std::printf("  best arm %d -> reward %.0f\n", ctx.BestArm(), r.reward);
    }
    // Average reward of three fixed policies over many rounds.
    const int R = 5000;
    std::vector<double> fixed(ctx.num_arms(), 0.0);
    double oracle = 0, random = 0;
    for (int t = 0; t < R; ++t) {
      ctx.reset();
      for (int a = 0; a < ctx.num_arms(); ++a) fixed[a] += ctx.ExpectedReward(a);
      oracle += ctx.ExpectedReward(ctx.BestArm());
      random += ctx.ExpectedReward(static_cast<int>(rng() % ctx.num_arms()));
    }
    std::printf("  mean reward over %d rounds: random %.3f, always-arm", R, random / R);
    for (int a = 0; a < ctx.num_arms(); ++a) std::printf(" %d=%.3f", a, fixed[a] / R);
    std::printf(", oracle %.3f\n", oracle / R);
    for (int a = 0; a < ctx.num_arms(); ++a)
      check::Require(oracle > fixed[a], "the context-aware oracle should beat always pulling arm " + std::to_string(a));
    check::Require(oracle > random, "the oracle should beat random pulls");
    std::cout << "\nchecks passed (vsim video omitted)\n";
  } catch (const std::exception& e) {
    std::cerr << "FAILED: " << e.what() << "\n";
    return 1;
  }
  return 0;
}

```
