> Interpretation

The source checks report reproducibility and the stated control comparisons. Distinguish the displayed fixed-action diagnostics from the original policies, MDP terminality from time-limit truncation, expected reward from sampled return, and a legal game move from an arbitrary action index. All policies and episode loops remain editable here.

> The four policy replays

The first replay follows the manual policy down the left edge of the
deterministic grid and along the bottom to the goal. On the cliff board,
the risky policy follows the row immediately above the cliff. The safe
policy uses the top row and takes four more moves. In the final replay
the agent first steps onto the cliff, loses 100 reward, and returns to
the start. The episode continues with the safe policy.

```{cpp, results="markdown", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <filesystem>
#include <print>

int main() {
  namespace e = dm::rl::environments;
  std::filesystem::create_directories("build/grid_replays");
  std::filesystem::create_directories("figures");
  e::GridWorld grid;
  e::CliffWalking cliff;
  const auto record = [](e::GridBase& board, std::string_view filename, auto policy,
                         int expected_steps, double expected_return) {
    auto obs = board.reset(0);
    std::vector<int> states{board.state()};
    double total = 0.;
    for (int step = 0; step < board.max_steps(); ++step) {
      const auto [row, col] = board.Coords(int(obs[0]));
      auto result = board.step(policy(step, row, col));
      states.push_back(board.state());
      total += result.reward;
      obs = std::move(result.obs);
      if (result.done()) break;
    }
    if (states.size() != std::size_t(expected_steps + 1) || total != expected_return)
      throw std::runtime_error("unexpected policy replay length or return");
    if (filename == "grid_cliff_fall" && states[3] != states[0])
      throw std::runtime_error("cliff fall did not return to start");
    const auto path = std::string(filename) + ".mp4";
    e::save_grid_replay(board, states, "build/grid_replays/" + path);
    std::filesystem::copy_file("build/grid_replays/" + path, "figures/" + path,
                               std::filesystem::copy_options::overwrite_existing);
    std::println("**{} moves, return {:+g}**\n\n{}video(figures/{})\n",
                 expected_steps, total, '\\', path);
  };
  const auto manual = [](int, int row, int) { return row < 4 ? e::GridBase::kDown : e::GridBase::kRight; };
  const auto risky = [](int, int row, int col) {
    if (row == 3 && col == 0) return e::GridBase::kUp;
    if (row == 2 && col < 11) return e::GridBase::kRight;
    return e::GridBase::kDown;
  };
  const auto safe = [](int, int row, int col) {
    if (col == 0 && row > 0) return e::GridBase::kUp;
    if (row == 0 && col < 11) return e::GridBase::kRight;
    return e::GridBase::kDown;
  };
  record(grid, "grid_manual", manual, 9, -9.);
  record(cliff, "grid_cliff_risky", risky, 13, -13.);
  record(cliff, "grid_cliff_safe", safe, 17, -17.);
  record(cliff, "grid_cliff_fall", [&](int step, int row, int col) {
    constexpr int first[] = {e::GridBase::kUp, e::GridBase::kRight, e::GridBase::kDown};
    return step < 3 ? first[step] : static_cast<int>(safe(step, row, col));
  }, 20, -119.);
}
```
