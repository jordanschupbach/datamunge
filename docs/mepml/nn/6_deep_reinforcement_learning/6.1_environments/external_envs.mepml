> Complete preserved source protocol

The code retains the source seeds, actual default caps and original optional full settings. Every controller, rollout, replay, objective, gradient/clipping/optimizer step and update schedule remains editable. Read-only capture hooks add no random draws or evaluations. In the local ALE-free build, the original synthetic preprocessing/Nature-update checks execute and emulator rollouts are explicitly skipped. Native InvertedPendulum/Hopper use datamunge physics; their smoke results establish execution and finite updates, without convergence or external-simulator parity. Timing rows are machine-dependent and excluded from source stdout equality checks.

```{cpp, results="output", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -lpthread -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
namespace report_capture {
inline dm::nn::NamedTensors arrays;inline std::map<std::string,std::vector<double>> traces;
inline void Trace(const std::string&name,double value){traces[name].push_back(value);}inline int monitor_index=0,checkpoint_index=0;
template<class T>void Save(const std::string& name,const std::vector<T>&v){arrays.push_back({name,dm::nn::from_vector(v)});}
struct Checkpoint{dm::nn::ParameterStore& store;~Checkpoint(){auto tag=std::to_string(checkpoint_index++);for(const auto& name:store.names())arrays.push_back({"parameters_"+tag+"_"+name,store.at(name).detach().clone()});}};
struct Flush{~Flush(){for(const auto&[name,values]:traces)Save(name,values);if(!arrays.empty()){std::filesystem::create_directories("build");dm::nn::save_npz("build/external_envs_source.npz",arrays);}}};inline Flush flush;
}
// CMD: just run-nn external_envs
// Binding to external environments: ALE (Atari 2600) and vsim.
//
// Port of tflow's external_envs. tflow reaches two real simulators through
// their C++ APIs:
//   - the Arcade Learning Environment, wrapped as rl::AtariEnv with DQN-style
//     preprocessing (common/rl/ale_env.hpp);
//   - vsim, the game engine whose scene files and Jolt-based PhysicsWorld the
//     articulated tasks in tflow's common/rl/vsim_env.h are built on.
// Atari ROMs are not redistributable; the free Tetris homebrew ships with ALE
// and other ROMs can be dropped into data/roms/.
//
// Deviations: ALE and vsim are not datamunge dependencies (the plan keeps
// emulators, vsim and video recording out of scope). The Atari demo runs only
// when the example is compiled with ALE on the include path and linked with
// libale (DATAMUNGE_EXAMPLES_HAVE_ALE); `just run-nn` builds without it and
// then only reports where the ROMs are. The vsim demo (a ball knocking over a
// crate stack, stepped at 120 Hz) and both videos are omitted.

#include <cstdio>
#include <filesystem>
#include <iostream>
#include <random>

// Editable workflow support: checks.hpp
// Small runtime checks used by the executable nn examples. They stay on in
// Release builds and make the example exit nonzero on failure, so `just
// run-all-nn` doubles as a regression test against the recorded TF numbers.

#include <cmath>
#include <iostream>
#include <stdexcept>
#include <string>
// Editable workflow support: runtime.hpp
// Bounded demonstrations by default; opt into convergence experiments explicitly.

#include <algorithm>
#include <cstdlib>
#include <iostream>
#include <string>

namespace example_runtime {

inline bool Full() {
  const char* value = std::getenv("DATAMUNGE_EXAMPLES_FULL");
  return value && std::string(value) == "1";
}

template <typename T> T Limit(T requested, T quick_limit) {
  return Full() ? requested : std::min(requested, quick_limit);
}

inline void Describe() {
  if (!Full())
    std::cout << "Quick demonstration: bounded training; convergence metrics require "
                 "DATAMUNGE_EXAMPLES_FULL=1.\n";
}

}  // namespace example_runtime

namespace check {

inline void Require(bool condition, const std::string& message) {
  if (!condition) throw std::runtime_error(message);
}

// A short demonstration checks execution, derivatives and persistence; reaching
// a published accuracy/return requires the separately requested full schedule.
inline void TrainingQuality(bool condition, const std::string& message) {
  if (example_runtime::Full()) Require(condition, message);
  else std::cout << "  full-training quality check deferred: " << message << '\n';
}

inline void Near(double actual, double expected, double tolerance, const std::string& message) {
  if (!std::isfinite(actual) || !std::isfinite(expected) || std::abs(actual - expected) > tolerance)
    throw std::runtime_error(message + ": got " + std::to_string(actual) + ", expected " + std::to_string(expected));
}

/// Expects `f` to throw; returns the message.
template <typename F>
std::string Throws(F&& f, const std::string& message) {
  try {
    f();
  } catch (const std::exception& e) {
    return e.what();
  }
  throw std::runtime_error(message + ": expected an exception");
}

}  // namespace check

inline void Header(const std::string& title) {
  const std::size_t pad = title.size() < 60 ? 60 - title.size() : 0;
  std::cout << "\n== " << title << " " << std::string(pad, '=') << "\n";
}

// Editable workflow support: rl/ale_env.hpp
// datamunge::nn port of tflow_examples src/common/rl/ale_env.h.
//
// ALE is not a datamunge dependency (the plan keeps emulators in the examples
// repo), so this header splits tflow's AtariEnv in two:
//   - AtariFrameStack: the DQN preprocessing (max-pool of the last two frames,
//     box-filter resize to 84x84, a stack of the last 4 frames, scaling to
//     [0, 1]), plain C++ with no emulator; same code as tflow's private helpers.
//   - AtariEnv: the ALE-backed environment, identical to tflow's, compiled only
//     when <ale/ale_interface.hpp> is on the include path (then link libale).
//     DATAMUNGE_EXAMPLES_HAVE_ALE says which.
// FindRom also looks in ~/projects/tflow_examples/data/roms.
//
// Original comment:
// Atari 2600 games through the Arcade Learning Environment, with the
// standard DQN preprocessing (Mnih et al. 2015): frame skip with max-pooling
// over the last two frames, grayscale, resize to 84x84, a stack of the last
// 4 frames, random no-ops at reset, and optional reward clipping. The ROM
// is looked up in data/roms/ and then $ALE_ROM_DIR (the flake points that
// at the free Tetris ROM shipped with ALE).

#if defined(DATAMUNGE_EXAMPLES_DISABLE_ALE)
// Build systems can select the dependency-free preprocessing path even when
// an unrelated development shell exposes ALE headers.
#define DATAMUNGE_EXAMPLES_HAVE_ALE 0
#else
#if __has_include(<ale/ale_interface.hpp>)
#define DATAMUNGE_EXAMPLES_HAVE_ALE 1
#include <ale/ale_interface.hpp>
#include <ale/common/Log.hpp>
#else
#define DATAMUNGE_EXAMPLES_HAVE_ALE 0
#endif
#endif

#include <algorithm>
#include <cstdlib>
#include <deque>
#include <filesystem>
#include <stdexcept>
#include <string>
#include <vector>

// Editable workflow support: rl/env.hpp
#include <datamunge/rl/environments.hpp>
namespace rl {
using datamunge::rl::environments::Obs;
using datamunge::rl::environments::Action;
using datamunge::rl::environments::ActionSpace;
using datamunge::rl::environments::StepResult;
using datamunge::rl::environments::Env;
using datamunge::rl::environments::EnvBase;
using datamunge::rl::environments::Transition;
using datamunge::rl::environments::TabularEnv;
}

namespace rl {

// Directories searched for <game>.bin, in order.
inline std::vector<std::string> RomDirs() {
  std::vector<std::string> dirs = {"data/roms"};
  if (const char* d = std::getenv("TFLOW_DATA_DIR")) dirs.push_back(std::string(d) + "/roms");
  if (const char* d = std::getenv("ALE_ROM_DIR")) dirs.push_back(d);
  if (const char* h = std::getenv("HOME")) dirs.push_back(std::string(h) + "/projects/tflow_examples/data/roms");
  return dirs;
}

inline std::string FindRom(const std::string& game) {
  for (const std::string& dir : RomDirs()) {
    const std::string p = dir + "/" + game + ".bin";
    if (std::filesystem::exists(p)) return p;
  }
  throw std::runtime_error("ROM " + game + ".bin not found in data/roms/ or $ALE_ROM_DIR");
}

struct AtariOptions {
  int frame_skip = 4;
  bool clip_rewards = false;
  int noop_max = 30;
  int max_frames = 27000;  // 108k emulator frames at frame skip 4: Gymnasium's limit
  float repeat_action_probability = 0.25f;  // sticky actions
};

// The DQN frame pipeline over raw grayscale screens of raw_w x raw_h.
using dm::rl::environments::AtariFrameStack;

#if DATAMUNGE_EXAMPLES_HAVE_ALE
class AtariEnv : public Env {
 public:
  static constexpr int kSize = AtariFrameStack::kSize, kStack = AtariFrameStack::kStack;
  using Options = AtariOptions;
  AtariEnv(const std::string& game, Options opt = AtariOptions()) : game_(game), opt_(opt) {
    ale::Logger::setMode(ale::Logger::Error);  // no ROM banner / "Sending Reset..." chatter
    ale_.setInt("random_seed", 0);
    ale_.setFloat("repeat_action_probability", opt.repeat_action_probability);
    ale_.setInt("frame_skip", 1);  // skipping is done here so frames can be max-pooled
    ale_.loadROM(FindRom(game));
    actions_ = ale_.getMinimalActionSet();
    raw_w_ = static_cast<int>(ale_.getScreen().width());
    raw_h_ = static_cast<int>(ale_.getScreen().height());
    frames_ = AtariFrameStack(raw_w_, raw_h_);
  }
  std::string name() const override { return "Atari(" + game_ + ")"; }
  int obs_size() const override { return kStack * kSize * kSize; }
  ActionSpace action_space() const override { return ActionSpace::Discrete(static_cast<int>(actions_.size())); }
  void Seed(uint64_t seed) override {
    rng_.seed(seed);
    ale_.setInt("random_seed", static_cast<int>(seed));
    ale_.loadROM(FindRom(game_));
  }
  int max_steps() const override { return opt_.max_frames; }
  int lives() { return ale_.lives(); }
  std::vector<std::string> action_names() const override {
    static const char* names[] = {"NOOP", "FIRE", "UP", "RIGHT", "LEFT", "DOWN", "UPRIGHT", "UPLEFT", "DOWNRIGHT", "DOWNLEFT",
                                  "UPFIRE", "RIGHTFIRE", "LEFTFIRE", "DOWNFIRE", "UPRIGHTFIRE", "UPLEFTFIRE", "DOWNRIGHTFIRE", "DOWNLEFTFIRE"};
    std::vector<std::string> out;
    for (auto a : actions_) out.push_back(names[static_cast<int>(a)]);
    return out;
  }
  // The current raw RGB screen (raw_w x raw_h), for videos.
  const std::vector<unsigned char>& rgb() {
    ale_.getScreenRGB(rgb_);
    return rgb_;
  }
  int raw_width() const { return raw_w_; }
  int raw_height() const { return raw_h_; }
  // The most recent preprocessed 84x84 frame (0..255), for inspection.
  const std::vector<unsigned char>& last_frame() const { return frames_.last_frame(); }

  StepResult step(const Action& action) override {
    StepResult r;
    float reward = 0;
    std::vector<unsigned char> prev, cur;
    for (int k = 0; k < opt_.frame_skip; ++k) {
      reward += static_cast<float>(ale_.act(actions_[action.discrete]));
      if (k == opt_.frame_skip - 2) ale_.getScreenGrayscale(prev);
      if (ale_.game_over()) break;
    }
    ale_.getScreenGrayscale(cur);
    AtariFrameStack::MaxPool(cur, prev);
    frames_.PushFrame(cur);
    r.obs = frames_.StackedObs();
    r.reward = opt_.clip_rewards ? (reward > 0 ? 1.f : (reward < 0 ? -1.f : 0.f)) : reward;
    raw_reward_ = reward;
    r.terminated = ale_.game_over();
    r.truncated = !r.terminated && ++steps_ >= opt_.max_frames;
    return r;
  }
  float last_raw_reward() const { return raw_reward_; }

 protected:
  Obs Reset() override {
    ale_.reset_game();
    steps_ = 0;
    frames_.Clear();
    const int noops = opt_.noop_max > 0 ? static_cast<int>(rng_() % (opt_.noop_max + 1)) : 0;
    for (int i = 0; i < noops; ++i) ale_.act(actions_[0]);
    std::vector<unsigned char> g;
    ale_.getScreenGrayscale(g);
    for (int i = 0; i < kStack; ++i) frames_.PushFrame(g);
    return frames_.StackedObs();
  }

 private:
  std::string game_;
  Options opt_;
  ale::ALEInterface ale_;
  ale::ActionVect actions_;
  AtariFrameStack frames_;
  std::vector<unsigned char> rgb_;
  std::mt19937_64 rng_{0};
  int raw_w_ = 0, raw_h_ = 0, steps_ = 0;
  float raw_reward_ = 0;
};
#endif  // DATAMUNGE_EXAMPLES_HAVE_ALE

}  // namespace rl


namespace {

void AtariDemo() {report_capture::Trace("ale_enabled",DATAMUNGE_EXAMPLES_HAVE_ALE);
  std::printf("#### ALE\n");
#if DATAMUNGE_EXAMPLES_HAVE_ALE
  rl::AtariEnv env("tetris");
  std::printf("  %s: raw screen %dx%d, %d-frame stack of 84x84 -> obs of %d floats, %s\n", env.name().c_str(), env.raw_width(),
              env.raw_height(), rl::AtariEnv::kStack, env.obs_size(), env.action_space().ToString().c_str());
  std::printf("  minimal action set:");
  for (const std::string& a : env.action_names()) std::printf(" %s", a.c_str());
  std::printf("\n");
  std::mt19937_64 rng(0);
  env.reset(0);
  float ret = 0;
  int steps = 0;
  while (true) {
    rl::StepResult r = env.step(env.action_space().Sample(rng));
    ret += r.reward;
    ++steps;
    if (r.done()) break;
  }
  std::printf("  random agent: %d agent steps (%d emulator frames), score %.0f, game over = %d\n", steps, steps * 4, ret, env.lives() == 0);
  // The preprocessed frame the agent actually sees.
  std::printf("  last 84x84 frame, downsampled 4x for display (. < 64, : < 128, + < 192, # otherwise):\n");
  const auto& f = env.last_frame();
  for (int y = 0; y < 84; y += 4) {
    std::printf("    ");
    for (int x = 0; x < 84; x += 2) {
      const int v = f[y * 84 + x];
      std::printf("%c", v < 64 ? '.' : v < 128 ? ':' : v < 192 ? '+' : '#');
    }
    std::printf("\n");
  }
  check::Require(env.raw_width() == 160 && env.raw_height() == 210, "the Atari screen is 160x210");
  check::Require(steps > 0 && env.obs_size() == 4 * 84 * 84, "a random Tetris game runs to the end");
#else
  std::printf("  ALE is not built in (see the header): the Atari demo is skipped.\n");
  try {
    std::printf("  tetris ROM: %s\n", rl::FindRom("tetris").c_str());
  } catch (const std::exception& e) {
    std::printf("  %s\n", e.what());
  }
#endif
}

void VsimDemo() {
  std::printf("\n#### vsim\n");
  std::printf("  vsim is not available to the datamunge ports (out of scope): the box-stack scene demo is skipped.\n");
}

}  // namespace

int main() {
  try {
    AtariDemo();
    VsimDemo();
    std::printf("\n  no videos are written by the port\n");
  } catch (const std::exception& e) {
    std::cerr << "FAILED: " << e.what() << "\n";
    return 1;
  }
  return 0;
}

