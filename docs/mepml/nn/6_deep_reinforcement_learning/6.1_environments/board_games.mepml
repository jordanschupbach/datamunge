> Five legal moves finish a row

Moves0,3,1,4,2 give player1 the entire top row in tic-tac-toe. The game is terminal with winner1; there are no legal successors. Clone owns a separate board, rather than a view of mutable cells.

```{cpp, results="markdown", file="figures/board_games_worked.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -lpthread -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main(){namespace e=dm::rl::environments;std::filesystem::create_directories("build");e::TicTacToe env;env.Reset();for(int move:{0,3,1,4,2})env.Apply(move);std::vector<double>values{double(env.Terminal()),double(env.Winner()),double(env.LegalActions().size())};if(!env.Terminal()||env.Winner()!=1||!env.LegalActions().empty())return 1;std::print("| coordinate | computed value |\n|---:|---:|\n");for(size_t i=0;i<values.size();++i)std::print("| {} | {:.9f} |\n",i,values[i]);dm::nn::save_npz("build/board_games_worked.npz",{{"values",dm::nn::from_vector(values)}});std::vector<double>x(values.size());std::iota(x.begin(),x.end(),0.);const double low=std::min(0.,*std::min_element(values.begin(),values.end())),high=std::max(0.,*std::max_element(values.begin(),values.end())),span=std::max(1e-9,high-low);dm::graphics::RPlot::create().ylim(low-.05*span,high+.05*span).bars(x,values,"computed values",{37,99,235}).title("Five legal moves finish a row").x_label("Coordinate in displayed calculation").size(1000,550).save_svg("build/board_games_worked.svg");}
