> Complete source experiment

The source seeds, episode counts, controls and checks are preserved. Every rollout and policy loop is visible here, using canonical C++ environment objects. The seeded random CartPole replay is recorded below.

```{cpp, results="output", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -lpthread -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
// CMD: just run-nn env_interface
// Environment interface: reset, step, render, seeding.
//
// Port of tflow's env_interface. All RL examples talk to environments through
// rl::Env (common/rl/env.hpp, copied from tflow), a small Gymnasium-style
// interface:
//   reset()            -> first observation (optionally with a seed)
//   step(action)       -> {obs, reward, terminated, truncated}
//   render()           -> text picture of the state
//   action_space()     -> Discrete(n) or Continuous(low, high)
// This program writes a tiny environment against that interface and then
// drives it and a built-in environment through the same generic loop. The
// report records a seeded CartPole episode and checks the three corridor endings.


// Editable workflow support: checks.hpp
// Small runtime checks used by the executable nn examples. They stay on in
// Release builds and make the example exit nonzero on failure, so `just
// run-all-nn` doubles as a regression test against the recorded TF numbers.

// Editable workflow support: runtime.hpp
// Bounded demonstrations by default; opt into convergence experiments explicitly.


namespace example_runtime {

inline bool Full() {
  const char* value = std::getenv("DATAMUNGE_EXAMPLES_FULL");
  return value && std::string(value) == "1";
}

template <typename T> T Limit(T requested, T quick_limit) {
  return Full() ? requested : std::min(requested, quick_limit);
}

inline void Describe() {
  if (!Full())
    std::cout << "Quick demonstration: bounded training; convergence metrics require "
                 "DATAMUNGE_EXAMPLES_FULL=1.\n";
}

}  // namespace example_runtime

namespace check {

inline void Require(bool condition, const std::string& message) {
  if (!condition) throw std::runtime_error(message);
}

// A short demonstration checks execution, derivatives and persistence; reaching
// a published accuracy/return requires the separately requested full schedule.
inline void TrainingQuality(bool condition, const std::string& message) {
  if (example_runtime::Full()) Require(condition, message);
  else std::cout << "  full-training quality check deferred: " << message << '\n';
}

inline void Near(double actual, double expected, double tolerance, const std::string& message) {
  if (!std::isfinite(actual) || !std::isfinite(expected) || std::abs(actual - expected) > tolerance)
    throw std::runtime_error(message + ": got " + std::to_string(actual) + ", expected " + std::to_string(expected));
}

/// Expects `f` to throw; returns the message.
template <typename F>
std::string Throws(F&& f, const std::string& message) {
  try {
    f();
  } catch (const std::exception& e) {
    return e.what();
  }
  throw std::runtime_error(message + ": expected an exception");
}

}  // namespace check

inline void Header(const std::string& title) {
  const std::size_t pad = title.size() < 60 ? 60 - title.size() : 0;
  std::cout << "\n== " << title << " " << std::string(pad, '=') << "\n";
}

// Editable workflow support: rl/classic_control.hpp
namespace rl {
using datamunge::rl::environments::kPi;
using datamunge::rl::environments::Clamp;
using datamunge::rl::environments::WrapAngle;
using datamunge::rl::environments::CartPole;
using datamunge::rl::environments::MountainCar;
using datamunge::rl::environments::MountainCarContinuous;
using datamunge::rl::environments::Pendulum;
using datamunge::rl::environments::Acrobot;
}

// Editable workflow support: rl/env.hpp
namespace rl {
using datamunge::rl::environments::Obs;
using datamunge::rl::environments::Action;
using datamunge::rl::environments::ActionSpace;
using datamunge::rl::environments::StepResult;
using datamunge::rl::environments::Env;
using datamunge::rl::environments::EnvBase;
using datamunge::rl::environments::Transition;
using datamunge::rl::environments::TabularEnv;
}

// Editable workflow support: rl/utils.hpp
// datamunge::nn port: copied from tflow_examples src/common/rl/utils.h (TF-free code, unchanged).
// Small helpers shared by the RL examples: episode statistics, random and
// greedy rollouts, and printing.



namespace rl {

struct EpisodeStats {
  std::vector<float> returns;
  std::vector<int> lengths;
  float mean_return() const {
    return returns.empty() ? 0.f
                           : std::accumulate(returns.begin(), returns.end(), 0.f) / returns.size();
  }
  float mean_length() const {
    return lengths.empty() ? 0.f
                           : std::accumulate(lengths.begin(), lengths.end(), 0.f) / lengths.size();
  }
  float min_return() const { return *std::min_element(returns.begin(), returns.end()); }
  float max_return() const { return *std::max_element(returns.begin(), returns.end()); }
};

// Run `episodes` episodes of `env` choosing actions with `policy(obs)`.

// Uniformly random actions.

inline void PrintStats(const std::string& label, const EpisodeStats& s) {
  std::printf("  %-32s return mean %8.2f  min %8.2f  max %8.2f   length mean %6.1f\n",
              label.c_str(), s.mean_return(), s.min_return(), s.max_return(), s.mean_length());
}

inline int ArgMax(const std::vector<float>& v) {
  return static_cast<int>(std::max_element(v.begin(), v.end()) - v.begin());
}

// Argmax with ties broken uniformly at random.
inline int ArgMaxRandomTie(const float* q, int n, std::mt19937_64& rng) {
  float best = q[0];
  for (int i = 1; i < n; ++i) best = std::max(best, q[i]);
  std::vector<int> ties;
  for (int i = 0; i < n; ++i)
    if (q[i] == best) ties.push_back(i);
  return ties[rng() % ties.size()];
}

inline std::string FormatObs(const Obs& o, int max_elems = 8) {
  std::string s = "[";
  for (size_t i = 0; i < o.size() && static_cast<int>(i) < max_elems; ++i) {
    char buf[32];
    std::snprintf(buf, sizeof buf, "%s%.3f", i ? " " : "", o[i]);
    s += buf;
  }
  if (static_cast<int>(o.size()) > max_elems) s += " ...";
  return s + "]";
}

}  // namespace rl


// Experiment workflow from examples/nn/common/rl/utils.hpp.
namespace rl {
using namespace ::rl;
inline EpisodeStats RunEpisodes(Env& env, int episodes, uint64_t seed,
                                const std::function<Action(const Obs&)>& policy) {
  EpisodeStats stats;
  for (int e = 0; e < episodes; ++e) {
    Obs obs = env.reset(seed + e);
    float ret = 0;
    int len = 0;
    while (true) {
      StepResult r = env.step(policy(obs));
      ret += r.reward;
      ++len;
      obs = r.obs;
      if (r.done()) break;
    }
    stats.returns.push_back(ret);
    stats.lengths.push_back(len);
  }
  return stats;
}
}  // namespace rl

// Experiment workflow from examples/nn/common/rl/utils.hpp.
namespace rl {
using namespace ::rl;
inline EpisodeStats RunRandom(Env& env, int episodes, uint64_t seed) {
  std::mt19937_64 rng(seed);
  const ActionSpace space = env.action_space();
  return RunEpisodes(env, episodes, seed, [&](const Obs&) { return space.Sample(rng); });
}
}  // namespace rl



namespace {

// A 1-D corridor: the agent starts in the middle of `length` cells and must
// reach the right end (+1) while avoiding the left end (-1). Each step the
// chosen move succeeds with probability 0.8, otherwise the agent slips the
// other way, so the environment needs its RNG and seeding matters.
using Corridor=dm::rl::environments::Corridor;

// One episode through the generic interface, printing every step. Returns the
// sequence of observations and rewards as text (for the seeding check).
std::string Trace(rl::Env& env, uint64_t seed, int max_print, bool show_render = true) {
  std::ostringstream log;
  std::mt19937_64 rng(seed);
  const rl::ActionSpace space = env.action_space();
  rl::Obs obs = env.reset(seed);
  std::cout << "  t=0  obs=" << rl::FormatObs(obs) << "  " << (show_render ? env.render() : "") << "\n";
  log << rl::FormatObs(obs);
  for (int t = 1;; ++t) {
    rl::Action a = space.Sample(rng);
    rl::StepResult r = env.step(a);
    log << " " << a.discrete << ":" << r.reward << ":" << rl::FormatObs(r.obs);
    if (t <= max_print)
      std::printf("  t=%-2d a=%d  r=%+.2f  obs=%s  %s%s%s\n", t, a.discrete, r.reward,
                  rl::FormatObs(r.obs).c_str(), show_render ? env.render().c_str() : "",
                  r.terminated ? "  TERMINATED" : "", r.truncated ? "  TRUNCATED" : "");
    if (r.done()) {
      if (t > max_print) std::printf("  ... episode ended at t=%d\n", t);
      break;
    }
  }
  return log.str();
}

}  // namespace

int main() {
  try {
    Corridor corridor;
    std::cout << "== " << corridor.name() << ": obs_size=" << corridor.obs_size()
              << " action_space=" << corridor.action_space().ToString()
              << " max_steps=" << corridor.max_steps() << "\n";
    std::cout << "\n-- A random episode (seed 1)\n";
    Trace(corridor, 1, 25);

    std::cout << "\n-- Seeding: the same seed reproduces the episode exactly\n";
    const std::string a = Trace(corridor, 7, 4);
    const std::string b = Trace(corridor, 7, 4);
    std::cout << "-- A different seed does not\n";
    const std::string c = Trace(corridor, 8, 4);
    check::Require(a == b, "the same seed should reproduce the episode");
    check::Require(a != c, "a different seed should give a different episode");

    std::cout << "\n-- terminated vs truncated over 1000 random episodes\n";
    {
      std::mt19937_64 rng(0);
      int goal = 0, pit = 0, timeout = 0;
      for (int e = 0; e < 1000; ++e) {
        corridor.reset(100 + e);
        while (true) {
          rl::StepResult r = corridor.step(corridor.action_space().Sample(rng));
          if (r.terminated) (r.reward > 0 ? goal : pit)++;
          if (r.truncated) ++timeout;
          if (r.done()) break;
        }
      }
      std::printf("  reached goal %d, fell in pit %d, hit the %d-step limit %d\n", goal, pit,
                  corridor.max_steps(), timeout);
      check::Require(goal + pit + timeout == 1000, "every episode ends exactly one way");
      check::Require(goal > 300 && pit > 300 && timeout > 0, "a symmetric random walk reaches both ends about equally often");
    }

    std::cout << "\n-- The same loop works on any Env: CartPole through the base class\n";
    std::unique_ptr<rl::Env> env = std::make_unique<rl::CartPole>();
    std::cout << "  " << env->name() << ": obs_size=" << env->obs_size()
              << " action_space=" << env->action_space().ToString() << "\n";
    Trace(*env, 3, 3, /*show_render=*/false);
    rl::PrintStats("random policy, 20 episodes", rl::RunRandom(*env, 20, 0));

    rl::CartPole cartpole;
    std::mt19937_64 video_rng(3);
    auto observation = cartpole.reset(3);
    std::vector<std::array<float,3>> poses{{observation[0], observation[2], 0}};
    std::vector<float> observations = observation, rewards;
    do {
      auto result = cartpole.step(cartpole.action_space().Sample(video_rng));
      observation = result.obs;
      poses.push_back({observation[0], observation[2], 0});
      observations.insert(observations.end(), observation.begin(), observation.end());
      rewards.push_back(result.reward);
      if (result.done()) break;
    } while (true);
    const std::string clip = "env_interface_random_cartpole.mp4";
    std::filesystem::create_directories("build");
    std::filesystem::create_directories("figures");
    dm::rl::environments::save_linkage_replay(
        dm::rl::environments::LinkageReplay::CartPole, poses, "build/" + clip);
    std::filesystem::copy_file("build/" + clip, "figures/" + clip,
                               std::filesystem::copy_options::overwrite_existing);
    dm::nn::save_npz("build/env_interface_replay.npz",
        {{"observations", dm::nn::from_vector(observations, {static_cast<std::int64_t>(poses.size()),4})},
         {"reward", dm::nn::from_vector(rewards)}});

    std::cout << "\n-- Continuous action spaces sample vectors\n";
    rl::Pendulum pendulum;
    std::mt19937_64 rng(0);
    const rl::Action sample = pendulum.action_space().Sample(rng);
    std::cout << "  " << pendulum.name() << " action_space=" << pendulum.action_space().ToString()
              << "  sample=" << rl::FormatObs(sample.continuous) << "\n";
    check::Require(sample.continuous.size() == 1 && sample.continuous[0] >= -2.f && sample.continuous[0] <= 2.f,
                   "a Pendulum action is one torque in [-2, 2]");
    std::cout << "\nchecks passed\n";
  } catch (const std::exception& e) {
    std::cerr << "FAILED: " << e.what() << "\n";
    return 1;
  }
  return 0;
}

