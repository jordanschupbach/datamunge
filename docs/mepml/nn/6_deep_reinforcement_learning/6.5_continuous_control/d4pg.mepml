// Editable workflow support: rl/utils.hpp
// datamunge::nn port: copied from tflow_examples src/common/rl/utils.h (TF-free code, unchanged).
// Small helpers shared by the RL examples: episode statistics, random and
// greedy rollouts, and printing.

#include <algorithm>
#include <cmath>
#include <cstdio>
#include <functional>
#include <numeric>
#include <string>
#include <vector>


namespace rl {

struct EpisodeStats {
  std::vector<float> returns;
  std::vector<int> lengths;
  float mean_return() const {
    return returns.empty() ? 0.f
                           : std::accumulate(returns.begin(), returns.end(), 0.f) / returns.size();
  }
  float mean_length() const {
    return lengths.empty() ? 0.f
                           : std::accumulate(lengths.begin(), lengths.end(), 0.f) / lengths.size();
  }
  float min_return() const { return *std::min_element(returns.begin(), returns.end()); }
  float max_return() const { return *std::max_element(returns.begin(), returns.end()); }
};

// Run `episodes` episodes of `env` choosing actions with `policy(obs)`.

// Uniformly random actions.

inline void PrintStats(const std::string& label, const EpisodeStats& s) {
  std::printf("  %-32s return mean %8.2f  min %8.2f  max %8.2f   length mean %6.1f\n",
              label.c_str(), s.mean_return(), s.min_return(), s.max_return(), s.mean_length());
}

using dm::rl::foundations::ArgMax;using dm::rl::foundations::ArgMaxRandomTie;
inline std::string FormatObs(const Obs& o, int max_elems = 8) {
  std::string s = "[";
  for (size_t i = 0; i < o.size() && static_cast<int>(i) < max_elems; ++i) {
    char buf[32];
    std::snprintf(buf, sizeof buf, "%s%.3f", i ? " " : "", o[i]);
    s += buf;
  }
  if (static_cast<int>(o.size()) > max_elems) s += " ...";
  return s + "]";
}

}  // namespace rl


namespace rl {

namespace nn = datamunge::nn;

struct DqnConfig {
  int steps = 50000;          // environment steps
  int warmup = 1000;          // steps before training starts
  int batch = 64;
  int buffer = 50000;
  float gamma = 0.98f;        // 0.99 is the usual choice; 0.98 bounds Q by 50 and makes CartPole far more stable
  float lr = 5e-4f;
  float clip_norm = 10.f;
  int target_sync = 500;      // hard target update period (steps), used when tau == 1
  float tau = 0.005f;         // target <- tau * online + (1 - tau) * target every step; tau = 1 means a hard copy every target_sync steps
  float eps_start = 1.f, eps_end = 0.05f;
  int eps_decay_steps = 10000;
  int hidden = 128;
  int train_every = 2;
  int log_every = 5000;
  int eval_every = 5000;
  int eval_episodes = 5;
  uint64_t seed = 0;
};

// TF-only options that the ports accept and ignore.
inline bool IsHardwareOption(const std::string& key) {
  return key == "device" || key == "threads" || key == "intra_threads" || key == "inter_threads" || key == "xla";
}

// Overrides from the command line, e.g. `just run-nn dqn steps=50000 lr=5e-4`.
inline void ParseConfig(int argc, char** argv, DqnConfig* c) {
  for (int i = 1; i < argc; ++i) {
    const std::string arg = argv[i];
    const size_t eq = arg.find('=');
    if (eq == std::string::npos) continue;
    const std::string key = arg.substr(0, eq);
    const float v = std::strtof(arg.c_str() + eq + 1, nullptr);
    if (IsHardwareOption(key)) continue;
    if (key == "steps") c->steps = static_cast<int>(v);
    else if (key == "warmup") c->warmup = static_cast<int>(v);
    else if (key == "batch") c->batch = static_cast<int>(v);
    else if (key == "buffer") c->buffer = static_cast<int>(v);
    else if (key == "gamma") c->gamma = v;
    else if (key == "lr") c->lr = v;
    else if (key == "clip_norm") c->clip_norm = v;
    else if (key == "target_sync") c->target_sync = static_cast<int>(v);
    else if (key == "tau") c->tau = v;
    else if (key == "eps_start") c->eps_start = v;
    else if (key == "eps_end") c->eps_end = v;
    else if (key == "eps_decay_steps") c->eps_decay_steps = static_cast<int>(v);
    else if (key == "hidden") c->hidden = static_cast<int>(v);
    else if (key == "train_every") c->train_every = static_cast<int>(v);
    else if (key == "log_every") c->log_every = static_cast<int>(v);
    else if (key == "eval_every") c->eval_every = static_cast<int>(v);
    else if (key == "seed") c->seed = static_cast<uint64_t>(v);
    else if (key != "task" && key != "game") std::fprintf(stderr, "unknown option %s\n", arg.c_str());
  }

  if (!example_runtime::Full()) {
    c->steps = std::min(c->steps, 512);
    c->warmup = std::min(c->warmup, 32);
    c->batch = std::min(c->batch, 8);
    c->log_every = c->eval_every = std::max(1, c->steps);
    c->eval_episodes = 1;
    c->eps_decay_steps = std::min(c->eps_decay_steps, c->steps);
    example_runtime::Describe();
  }
}

inline float Epsilon(const DqnConfig& c, int step) {
  const float frac = std::min(1.f, static_cast<float>(step) / c.eps_decay_steps);
  return c.eps_start + frac * (c.eps_end - c.eps_start);
}

// Greedy evaluation with any action function.
inline float Evaluate(Env& env, const std::function<int(const Obs&)>& act, int episodes, uint64_t seed) {
  double total = 0;
  for (int e = 0; e < episodes; ++e) {
    Obs obs = env.reset(seed + e);
    while (true) {
      StepResult r = env.step(act(obs));
      total += r.reward;
      obs = r.obs;
      if (r.done()) break;
    }
  }
  report_capture::Trace("eval_call",static_cast<float>(total/episodes));
  return static_cast<float>(total / episodes);
}

// Tracks episode returns and losses and prints one line per log period.
class Monitor {
 public:
  explicit Monitor(const DqnConfig& cfg, const char* third_column = "eps") : cfg_(cfg) {
    std::printf("  %8s %8s %12s %7s %10s %10s\n", "step", "episodes", "return(20)", third_column, "loss", "eval");
  }
  void EndEpisode(float ret) { returns_.push_back(ret); }
  ~Monitor(){auto tag=std::to_string(id_);report_capture::Save("return_"+tag,returns_);report_capture::Save("step_"+tag,steps_);report_capture::Save("eval_"+tag,evaluation_);report_capture::Save("loss_"+tag,mean_losses_);}
  void AddLoss(float loss) { losses_.push_back(loss); }
  int episodes() const { return static_cast<int>(returns_.size()); }
  float RecentReturn(int n = 20) const {
    if (returns_.empty()) return 0.f;
    const size_t from = returns_.size() > static_cast<size_t>(n) ? returns_.size() - n : 0;
    return std::accumulate(returns_.begin() + from, returns_.end(), 0.f) / (returns_.size() - from);
  }
  void Log(int step, float eps, float eval_return) {
    const float loss = losses_.empty() ? 0.f : std::accumulate(losses_.begin(), losses_.end(), 0.f) / losses_.size();
    steps_.push_back(step);evaluation_.push_back(eval_return);mean_losses_.push_back(loss);
    losses_.clear();
    char eval[16];
    if (std::isnan(eval_return)) std::snprintf(eval, sizeof eval, "%10s", "");
    else std::snprintf(eval, sizeof eval, "%10.1f", eval_return);
    std::printf("  %8d %8d %12.1f %7.3f %10.4f %s\n", step, episodes(), RecentReturn(), eps, loss, eval);
    std::fflush(stdout);
  }

 private:
  int id_=report_capture::monitor_index++;std::vector<double>steps_,evaluation_,mean_losses_;
  DqnConfig cfg_;
  std::vector<float> returns_, losses_;
};

using dm::nn::models::ProjectDistribution;

// One observation as a [1, obs_dim] tensor.
inline nn::Tensor Row(const Obs& o) { return nn::from_vector(o, {1, static_cast<std::int64_t>(o.size())}); }

}  // namespace rl


// Editable workflow support: rl/replay.hpp
#include <datamunge/rl/replay.hpp>
namespace rl {using dm::rl::replay::Experience;using dm::rl::replay::Batch;using dm::rl::replay::ReplayBuffer;using dm::rl::replay::PrioritizedReplay;using dm::rl::replay::NStepBuffer;using dm::rl::replay::SeqBatch;using dm::rl::replay::SequenceReplay;}

namespace rl {

struct CConfig {
  int steps = 200000;
  int warmup = 1000;       // random actions before training
  int batch = 128;
  int buffer = 100000;
  float gamma = 0.99f;
  float tau = 0.005f;      // Polyak factor for target networks
  float actor_lr = 1e-3f, critic_lr = 1e-3f;
  int hidden = 128;
  float noise = 0.1f;      // exploration noise std (fraction of the action range)
  int log_every = 2000;
  int eval_every = 4000;
  int eval_episodes = 5;
  uint64_t seed = 0;
};

inline void ParseCConfig(int argc, char** argv, CConfig* c) {
  for (int i = 1; i < argc; ++i) {
    const std::string arg = argv[i];
    const size_t eq = arg.find('=');
    if (eq == std::string::npos) continue;
    const std::string key = arg.substr(0, eq);
    const float v = std::strtof(arg.c_str() + eq + 1, nullptr);
    if (key == "threads") {
      datamunge::nn::set_num_threads(static_cast<int>(v));
      continue;
    }
    if (IsHardwareOption(key)) continue;
    if (key == "steps") c->steps = static_cast<int>(v);
    else if (key == "warmup") c->warmup = static_cast<int>(v);
    else if (key == "batch") c->batch = static_cast<int>(v);
    else if (key == "buffer") c->buffer = static_cast<int>(v);
    else if (key == "gamma") c->gamma = v;
    else if (key == "tau") c->tau = v;
    else if (key == "actor_lr") c->actor_lr = v;
    else if (key == "critic_lr") c->critic_lr = v;
    else if (key == "lr") c->actor_lr = c->critic_lr = v;
    else if (key == "hidden") c->hidden = static_cast<int>(v);
    else if (key == "noise") c->noise = v;
    else if (key == "log_every") c->log_every = static_cast<int>(v);
    else if (key == "eval_every") c->eval_every = static_cast<int>(v);
    else if (key == "seed") c->seed = static_cast<uint64_t>(v);
    else if (key != "task" && key != "game") std::fprintf(stderr, "unknown option %s\n", arg.c_str());
  }

  if (!example_runtime::Full()) {
    c->steps = std::min(c->steps, 256);
    c->warmup = std::min(c->warmup, 32);
    c->batch = std::min(c->batch, 8);
    c->log_every = c->eval_every = std::max(1, c->steps);
    c->eval_episodes = 1;
    example_runtime::Describe();
  }
}

inline DqnConfig MonitorConfig(const CConfig& c) {
  DqnConfig d;
  d.log_every = c.log_every;
  d.eval_every = c.eval_every;
  d.eval_episodes = c.eval_episodes;
  return d;
}

// [-1, 1]^dim -> the environment's box.
using dm::rl::continuous::ScaleAction;using dm::rl::continuous::NormalNoise;
using dm::nn::models::DeterministicActor;using dm::nn::models::Gaussian;using dm::nn::models::GaussianActor;
using dm::nn::models::Squashed;using dm::nn::models::SquashedSample;using dm::nn::models::GaussianLogProb;using dm::nn::models::QNetwork;
// Evaluation with a deterministic policy returning actions in [-1, 1].
inline float EvaluateC(Env& env, const std::function<std::vector<float>(const Obs&)>& act, int episodes, uint64_t seed) {
  const ActionSpace space = env.action_space();
  double total = 0;
  for (int e = 0; e < episodes; ++e) {
    Obs obs = env.reset(seed + e);
    while (true) {
      StepResult r = env.step(ScaleAction(act(obs), space));
      total += r.reward;
      obs = r.obs;
      if (r.done()) break;
    }
  }
  report_capture::Trace("eval_call",static_cast<float>(total/episodes));
  return static_cast<float>(total / episodes);
}

}  // namespace rl


// Editable workflow support: rl/play_best.hpp
// datamunge::nn port helper standing in for tflow's vsim_studio.h RecordBest.
//
// RecordBest plays `candidates` seeded episodes (seeds seed .. seed+candidates-1) without
// filming, then films the one with the highest return. PlayBestOfSeeds runs the same candidate
// episodes, prints the same "best of N" line, and replays the best one with PlayEpisode
// (common/rl/playback.hpp), which prints its steps and return instead of writing a video.

#include <cstdint>
#include <cstdio>
#include <limits>
#include <string>
#include <utility>

// Editable workflow support: rl/playback.hpp
// datamunge::nn port helper standing in for tflow's src/common/rl/vsim_studio.h recorders.
//
// tflow films episodes with vsim's renderer and ffmpeg (RecordEpisode); both are out of scope
// for the datamunge ports. PlayEpisode runs exactly the episode RecordEpisode would film (same
// reset seed, the same Decide/Hud bookkeeping, one env step per loop) without a video and prints
// the same summary line, so the steps and return can be compared with tflow's "recorded ..."
// line. tflow's recorder also stops when the film reaches `max_frames`; frames are not steps
// (they depend on the world's frame rate), so PlayEpisode ignores that cap: for every episode
// the 6.1 examples film, the episode ends before the film is full.

#include <cstdint>
#include <cstdio>
#include <string>
#include <type_traits>
#include <utility>


// Editable workflow support: rl/hud.hpp
// datamunge::nn port of tflow_examples src/common/rl/hud.h: Decision, its helpers and the Hud
// state are copied unchanged; DrawHud (drawing onto a video::Canvas) is dropped, since video
// recording is out of scope for the ports. Policies written for tflow's recorders still compile.
// The overlay on the videos: the move the agent makes and what it expects.
//
// A Decision is one move as the agent explains it: the action, the estimate
// it holds for every candidate action (Q-values, action probabilities, visit
// counts, planned returns, ...), which candidate it took, and the return it
// expects from the current state. The recorders in vsim_studio.h accept
// policies that return a Decision instead of a bare Action and draw it on
// every frame together with the step count, the last reward and the return
// so far (the Hud); a plain policy still gets the move, reward and return
// shown. DrawHud draws onto a video::Canvas, so the videos drawn without the
// 3D renderer (Atari) carry the same overlay.
//
// The helpers cover the usual cases: GreedyQ for value-based agents (the
// argmax, the Q row and max_a Q as the expected return), GreedyPi for a
// policy's probabilities with the critic's V(s), and Explain for an action
// with one estimate attached (a continuous torque with its critic value, a
// planner's first action with the planned return).

#include <algorithm>
#include <cmath>
#include <cstdio>
#include <numeric>
#include <string>
#include <utility>
#include <vector>


namespace rl {

struct Decision {
  Action action;
  std::string label;                // the move in words ("right", "torque +1.3"); from the action space when empty
  std::string kind;                 // what `values` are: "Q(s,a)", "pi(a|s)", "visits", "planned return"
  std::vector<std::string> labels;  // one per candidate; the environment's action names when empty
  std::vector<float> values;        // the agent's estimate per candidate action (empty when it has none)
  int chosen = -1;                  // the candidate taken (-1: the action is not one of them)
  float value = NAN;                // the return the agent expects from here (V(s), max_a Q, root value, ...)
  std::string value_name = "expected return";
  float lo = NAN, hi = NAN;         // the bar scale for `values`; NaN: from the values themselves (and 0)
  int decimals = -1;                // digits after the point for `values` (-1: by magnitude)
  std::string note;                 // one free line, e.g. "CEM over 15 steps" or "epsilon 0.05"

  Decision() = default;
  explicit Decision(Action a) : action(std::move(a)) {}
  // A Decision stands in for its action, so one policy serves both the
  // recorders and the plain episode runners (RunEpisodes, env.step).
  operator const Action&() const { return action; }  // NOLINT: implicit by design
};

// Greedy over Q(s, .): the argmax, the whole row, and max_a Q as the expected return.
inline Decision GreedyQ(const float* q, int n, const std::string& kind = "Q(s,a)") {
  Decision d;
  d.values.assign(q, q + n);
  d.chosen = static_cast<int>(std::max_element(q, q + n) - q);
  d.action = Action(d.chosen);
  d.kind = kind;
  d.value = q[d.chosen];
  return d;
}
inline Decision GreedyQ(const std::vector<float>& q, const std::string& kind = "Q(s,a)") {
  return GreedyQ(q.data(), static_cast<int>(q.size()), kind);
}

// The most probable action of a stochastic policy, with the probabilities and
// (when the agent has a critic) V(s).
inline Decision GreedyPi(const std::vector<float>& probs, float v = NAN, const std::string& kind = "pi(a|s)") {
  Decision d;
  d.values = probs;
  d.chosen = static_cast<int>(std::max_element(probs.begin(), probs.end()) - probs.begin());
  d.action = Action(d.chosen);
  d.kind = kind;
  d.lo = 0.f, d.hi = 1.f;
  d.decimals = 2;
  d.value = v;
  d.value_name = "V(s)";
  return d;
}

// An action with one estimate attached: a torque and its critic value, a
// planner's action and the return of its plan.
inline Decision Explain(Action action, float value, const std::string& value_name = "expected return", const std::string& note = "") {
  Decision d(std::move(action));
  d.value = value;
  d.value_name = value_name;
  d.note = note;
  return d;
}

// An action with a remark for the overlay: what a hand-written rule looked at.
inline Decision Note(Action action, const std::string& note) {
  Decision d(std::move(action));
  d.note = note;
  return d;
}

// A number with as many decimals as its size warrants.
inline std::string HudNum(float v, int decimals = -1) {
  if (std::isnan(v)) return "-";
  char buf[32];
  if (decimals < 0) decimals = std::abs(v) >= 100 ? 0 : std::abs(v) >= 10 ? 1 : 2;
  std::snprintf(buf, sizeof buf, "%.*f", decimals, v);
  return buf;
}
inline std::string HudSigned(float v) {
  if (std::isnan(v)) return "-";
  char buf[32];
  std::snprintf(buf, sizeof buf, "%+.2f", v);
  return buf;
}

// Everything the overlay shows: the episode so far and the current decision.
// The recorders fill it; Complete() derives the labels from the action space.
struct Hud {
  std::string title;  // optional top line
  int step = 0;
  float reward = NAN;  // the last reward (NaN before the first step)
  float ret = 0;       // the return so far
  bool done = false, truncated = false;
  bool has_decision = false;
  Decision decision;
  ActionSpace space;
  std::vector<std::string> names;  // the environment's action names (discrete) or action dimensions (continuous)

  void Reset(const ActionSpace& s, std::vector<std::string> action_names) {
    step = 0, reward = NAN, ret = 0, done = truncated = false, has_decision = false;
    decision = Decision();
    space = s;
    names = std::move(action_names);
  }
  // The move taken; the step that follows reports its reward through Observe().
  void Choose(Decision d) {
    decision = std::move(d);
    has_decision = true;
    Complete();
  }
  void Observe(const StepResult& r) {
    ++step;
    reward = r.reward;
    ret += r.reward;
    done = r.done();
    truncated = r.truncated;
  }
  std::string NameOf(int i, const char* prefix) const {
    if (i >= 0 && i < static_cast<int>(names.size())) return names[i];
    return prefix + std::to_string(i);
  }
  // Fills the action label and the candidate labels the policy left empty.
  void Complete() {
    Decision& d = decision;
    if (d.label.empty()) {
      if (space.kind == ActionSpace::kDiscrete) {
        d.label = NameOf(d.action.discrete, "action ");
      } else {
        for (size_t i = 0; i < d.action.continuous.size(); ++i) {
          if (i) d.label += "  ";
          if (i < names.size()) d.label += names[i] + " ";
          d.label += HudSigned(d.action.continuous[i]);
        }
      }
    }
    if (d.labels.size() != d.values.size()) {
      d.labels.clear();
      const bool per_action = space.kind == ActionSpace::kDiscrete && static_cast<int>(d.values.size()) == space.n;
      for (size_t i = 0; i < d.values.size(); ++i) d.labels.push_back(per_action ? NameOf(static_cast<int>(i), "action ") : std::to_string(i));
    }
  }
};

}  // namespace rl

namespace rl {

// The policy's decision for `obs`, as in vsim_studio.h: a Decision passes through, a bare
// action (an int, a vector or an Action) is wrapped.
template <typename PolicyFn>
Decision Decide(PolicyFn& policy, const Obs& obs) {
  if constexpr (std::is_same_v<std::decay_t<decltype(policy(obs))>, Decision>) return policy(obs);
  else return Decision(Action(policy(obs)));
}

struct Playback {
  int steps = 0;
  float ret = 0;
  Hud hud;  // the overlay state after the last step (decision, reward, return)
};

// Plays one episode of `policy` from env.reset(seed); `after_step(env, hud)` is called after
// the reset (step 0) and after every step, e.g. to snapshot frames.
template <typename Env, typename PolicyFn, typename AfterStep>
Playback PlayEpisode(Env& env, PolicyFn&& policy, const std::string& name, uint64_t seed, AfterStep after_step) {
  Playback pb;
  pb.hud.Reset(env.action_space(), env.action_names());
  Obs obs = env.reset(seed);
  after_step(static_cast<const Env&>(env), static_cast<const Hud&>(pb.hud));
  while (true) {
    pb.hud.Choose(Decide(policy, obs));
    const StepResult r = env.step(pb.hud.decision.action);
    pb.hud.Observe(r);
    pb.ret += r.reward;
    ++pb.steps;
    obs = r.obs;
    after_step(static_cast<const Env&>(env), static_cast<const Hud&>(pb.hud));
    if (r.done()) break;
  }
  std::printf("  played %s (video omitted): %d steps, return %.1f\n", name.c_str(), pb.steps, pb.ret);
  return pb;
}

template <typename Env, typename PolicyFn>
Playback PlayEpisode(Env& env, PolicyFn&& policy, const std::string& name, uint64_t seed) {
  return PlayEpisode(env, std::forward<PolicyFn>(policy), name, seed, [](const Env&, const Hud&) {});
}

}  // namespace rl

namespace rl {

template <typename Env, typename PolicyFn>
Playback PlayBestOfSeeds(Env& env, PolicyFn&& policy, const std::string& name, uint64_t seed, int candidates = 5) {
  uint64_t best_seed = seed;
  float    best = -std::numeric_limits<float>::infinity();
  for (int c = 0; c < candidates; ++c) {
    float ret = 0;
    Obs   obs = env.reset(seed + c);
    while (true) {
      const StepResult r = env.step(Decide(policy, obs).action);
      ret += r.reward;
      obs = r.obs;
      if (r.done()) break;
    }
    if (ret > best) best = ret, best_seed = seed + c;
  }
  std::printf("  best of %d episodes (return %.1f):\n", candidates, best);
  return PlayEpisode(env, std::forward<PolicyFn>(policy), name, best_seed);
}

}  // namespace rl


namespace nn = datamunge::nn;
using nn::Tensor;

int main(int argc, char** argv) {
  rl::CConfig cfg;
  rl::ParseCConfig(argc, argv, &cfg);
  const int atoms = 51, n_step = 5;
  const float vmin = -1000.f, vmax = 0.f, alpha_per = 0.6f, beta_start = 0.4f;
  const float gamma_n = std::pow(cfg.gamma, n_step);
  rl::Pendulum env, eval_env;
  const rl::ActionSpace space = env.action_space();
  const int obs_dim = env.obs_size(), act_dim = space.dim;
  std::printf("== D4PG on Pendulum: %d steps, %d atoms on [%.0f, %.0f], %d-step returns, prioritized replay\n", cfg.steps, atoms, vmin, vmax, n_step);

  std::vector<float> support(atoms);
  for (int i = 0; i < atoms; ++i) support[i] = vmin + i * (vmax - vmin) / (atoms - 1);
  const Tensor z = nn::from_vector(support, {atoms});
  nn::ParameterStore actor(cfg.seed), critic(cfg.seed + 1), actor_t(cfg.seed + 2), critic_t(cfg.seed + 3);
  report_capture::Checkpoint checkpoint_actor{actor};
  report_capture::Checkpoint checkpoint_critic{critic};
  report_capture::Checkpoint checkpoint_actor_t{actor_t};
  report_capture::Checkpoint checkpoint_critic_t{critic_t};

  // Distributional critic: logits over the atoms for (s, a).
  using Dist=nn::models::ActionDistributionPath;
  auto dist_critic = [&](nn::ParameterStore& p, const Tensor& s, const Tensor& a) {
return nn::models::DistributionalActionCritic(p,s,a,cfg.hidden,z);
};
  auto pi = [&](nn::ParameterStore& p, const Tensor& s) { return rl::DeterministicActor(p, "pi", s, act_dim, cfg.hidden); };
  {
    nn::NoGradGuard no_grad;
    const Tensor s0 = nn::zeros({1, obs_dim}), a0 = nn::zeros({1, act_dim});
    for (nn::ParameterStore* p : {&actor, &actor_t}) pi(*p, s0);
    for (nn::ParameterStore* p : {&critic, &critic_t}) dist_critic(*p, s0, a0);
  }
  nn::Optimizer native_critic_adam(critic,cfg.critic_lr,{nn::OptimizerKind::Adam});
auto native_critic_adam_minimize=[&](const Tensor& loss){auto gradients=nn::grad(loss,native_critic_adam.parameters());double norm;if(0.>0){auto clipped=nn::clip_by_global_norm(gradients,0.);gradients=std::move(clipped.first);norm=clipped.second;}else norm=nn::global_norm(gradients);native_critic_adam.step(gradients);return norm;};
nn::Optimizer native_actor_adam(actor,cfg.actor_lr,{nn::OptimizerKind::Adam});
auto native_actor_adam_minimize=[&](const Tensor& loss){auto gradients=nn::grad(loss,native_actor_adam.parameters());double norm;if(0.>0){auto clipped=nn::clip_by_global_norm(gradients,0.);gradients=std::move(clipped.first);norm=clipped.second;}else norm=nn::global_norm(gradients);native_actor_adam.step(gradients);return norm;};

  actor_t.copy_from(actor, 1.0);
  critic_t.copy_from(critic, 1.0);

  {  // projection sanity: a terminal transition puts all mass on the atom(s) around r
    std::vector<float> probs(atoms, 1.f / atoms), out(atoms);
    const float r = -510.f, done = 1.f;
    rl::ProjectDistribution(probs.data(), &r, &done, 1, atoms, vmin, vmax, gamma_n, out.data());
    check::Near(out[24] + out[25], 1.0, 1e-5, "terminal projection: all mass on the two atoms around r");
    check::Near(out[24] * support[24] + out[25] * support[25], r, 1e-3, "terminal projection preserves the mean");
  }

  rl::PrioritizedReplay buffer(cfg.buffer, obs_dim, alpha_per);
  rl::NStepBuffer nstep(n_step, cfg.gamma);
  rl::Monitor monitor(rl::MonitorConfig(cfg), "noise");
  std::mt19937_64 rng(cfg.seed);
  std::normal_distribution<float> normal(0.f, 1.f);
  auto act = [&](const rl::Obs& o) {
    nn::NoGradGuard no_grad;
    return pi(actor, rl::Row(o)).to_vector<float>();
  };
  std::vector<float> target_dist(static_cast<std::size_t>(cfg.batch) * atoms);
  rl::Obs obs = env.reset(cfg.seed);
  float ret = 0, best_eval = -1e9f;
  for (int step = 1; step <= cfg.steps; ++step) {
    std::vector<float> u(act_dim);
    if (step <= cfg.warmup) {
      for (float& x : u) x = std::uniform_real_distribution<float>(-1, 1)(rng);
    } else {
      u = act(obs);
      for (float& x : u) x = std::max(-1.f, std::min(1.f, x + cfg.noise * normal(rng)));
    }
    rl::StepResult sr = env.step(rl::ScaleAction(u, space));
    for (rl::Experience& e : nstep.Push({obs, 0, sr.reward, sr.obs, sr.terminated ? 1.f : 0.f, u})) buffer.Add(std::move(e));
    if (sr.truncated)
      for (rl::Experience& e : nstep.Flush()) buffer.Add(std::move(e));
    ret += sr.reward;
    obs = sr.obs;
    if (sr.done()) {
      monitor.EndEpisode(ret);
      ret = 0;
      obs = env.reset();
    }
    if (step > cfg.warmup) {
      const float beta = beta_start + (1 - beta_start) * std::min(1.f, static_cast<float>(step) / cfg.steps);
      const rl::Batch b = buffer.Sample(cfg.batch, beta, rng);
      std::vector<float> next_probs;
      {
        nn::NoGradGuard no_grad;
        next_probs = dist_critic(critic_t, b.s2, pi(actor_t, b.s2)).probs.to_vector<float>();
      }
      const std::vector<float> r = b.r.to_vector<float>(), done = b.done.to_vector<float>();
      rl::ProjectDistribution(next_probs.data(), r.data(), done.data(), cfg.batch, atoms, vmin, vmax, gamma_n, target_dist.data());
      const Tensor m = nn::from_vector(target_dist, {cfg.batch, atoms});
      const Tensor sample_loss = -nn::sum(m * nn::log_softmax(dist_critic(critic, b.s, b.act_c).logits), {1});
      const Tensor critic_loss = nn::mean(b.weights * sample_loss, {0});
      native_critic_adam_minimize(critic_loss);
      const float cl = critic_loss.item<float>();
      check::Require(std::isfinite(cl), "finite critic loss");
      monitor.AddLoss(cl);
      buffer.UpdatePriorities(b.indices, sample_loss.detach().to_vector<float>());
      native_actor_adam_minimize(-nn::mean(dist_critic(critic, b.s, pi(actor, b.s)).q, {0}));
      actor_t.copy_from(actor, cfg.tau);
      critic_t.copy_from(critic, cfg.tau);
    }
    if (step % cfg.log_every == 0) {
      const float ev = step % cfg.eval_every == 0 ? rl::EvaluateC(eval_env, act, cfg.eval_episodes, 1000 + step) : NAN;
      if (!std::isnan(ev)) best_eval = std::max(best_eval, ev);
      monitor.Log(step, cfg.noise, ev);
    }
  }
  const float final_eval = rl::EvaluateC(eval_env, act, 20, 777);
  std::printf("  final deterministic evaluation over 20 episodes: %.1f\n", final_eval);
  // On film in TF: the action and the critic's estimate of the return from here.
  rl::PlayBestOfSeeds(eval_env, [&](const rl::Obs& o) {
    nn::NoGradGuard no_grad;
    const std::vector<float> u = act(o);
    const float v = dist_critic(critic, rl::Row(o), nn::from_vector(u, {1, act_dim})).q.item<float>();
    return rl::Explain(rl::ScaleAction(u, space), v, "Q(s,a) (mean of the critic's distribution)");
  }, "d4pg_pendulum", 4242);
  // The critic's return distribution for the upright state vs. hanging down.
  float q_up = 0, q_down = 0;
  for (auto [label, o] : std::vector<std::pair<const char*, rl::Obs>>{{"upright, still", {1, 0, 0}}, {"hanging down", {-1, 0, 0}}}) {
    nn::NoGradGuard no_grad;
    const std::vector<float> u = act(o);
    const Dist d = dist_critic(critic, rl::Row(o), nn::from_vector(u, {1, act_dim}));
    const std::vector<float> probs = d.probs.to_vector<float>();
    const float qv = d.q.item<float>();
    (o[0] > 0 ? q_up : q_down) = qv;
    std::printf("  %-16s expected return %.1f, mass per 200-wide bin from %.0f:", label, qv, vmin);
    for (int bin = 0; bin < 5; ++bin) {
      float mass = 0;
      for (int i = 0; i < atoms; ++i)
        if (support[i] >= vmin + bin * 200 && (support[i] < vmin + (bin + 1) * 200 || bin == 4)) mass += probs[i];
      std::printf(" %3.0f%%", 100 * mass);
    }
    std::printf("\n");
  }
  // TF seed 0: final -159.8; upright -0.0, hanging down -263.8.
  check::TrainingQuality(q_up > q_down, "the critic values the upright state above hanging down");
  check::TrainingQuality(std::max(best_eval, final_eval) >= -400, "D4PG learned to swing up (best deterministic evaluation >= -400)");
  return 0;
}

```
// result_begin:
// Quick demonstration: bounded training; convergence metrics require DATAMUNGE_EXAMPLES_FULL=1.
// == D4PG on Pendulum: 256 steps, 51 atoms on [-1000, 0], 5-step returns, prioritized replay
//       step episodes   return(20)   noise       loss       eval
//        256        1      -1458.0   0.100     3.8113    -1410.3
//   final deterministic evaluation over 20 episodes: -1701.1
//   best of 5 episodes (return -1594.6):
//   played d4pg_pendulum (video omitted): 200 steps, return -1594.6
//   upright, still   expected return -499.1, mass per 200-wide bin from -1000:  16%  22%  22%  21%  19%
//   hanging down     expected return -531.3, mass per 200-wide bin from -1000:  20%  22%  21%  22%  15%
//   full-training quality check deferred: the critic values the upright state above hanging down
//   full-training quality check deferred: D4PG learned to swing up (best deterministic evaluation >= -400)
// result_end

> Recurrent/prefix boundary conventions

Recurrent replay uses the original zero-start padded windows and masks. N-step rows flushed at a time limit retain their original configured gamma^n bootstrap even when the prefix is shorter; this inherited approximation is visible in the source, not justified by the full-horizon worked calculation. Actual terminals always suppress continuation.

> Actual return diagnostics

These values come from the preserved source run above. Evaluation calls remain in their original order and may include different final policies, such as SAC mean versus sampled actions. One point does not establish a learning trend. The hybrid histogram retains raw source counts; task rewards and intrinsic bonuses are separate quantities.

```{cpp, results="markdown", file="figures/d4pg_return.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -lpthread -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main(){auto archive=dm::nn::load_npz("build/d4pg_source.npz");auto plot=dm::graphics::RPlot::create();for(const auto&[key,t]:archive){if(!key.starts_with("return_"))continue;auto y=t.to_vector<double>();std::vector<double>x(y.size());std::iota(x.begin(),x.end(),1.);plot.lines(x,y,key,{37,99,235}).points(x,y,key+" points",{37,99,235},4);}plot.title("d4pg actual return diagnostics").x_label("Ended training episode").y_label("Task return").size(1100,600).save_svg("build/d4pg_return.svg");}
