int main(){std::filesystem::create_directories("build");std::vector<double>values{dm::nn::models::HybridReachReward(0,.5,1,.5),dm::nn::models::HybridReachReward(0,.5,0,.5)};std::print("| coordinate | computed value |\n|---:|---:|\n");for(size_t i=0;i<values.size();++i)std::print("| {} | {:.9f} |\n",i,values[i]);dm::nn::save_npz("build/action_tricks_worked.npz",{{"values",dm::nn::from_vector(values)}});std::vector<double>x(values.size());std::iota(x.begin(),x.end(),0.);double low=std::min(0.,*std::min_element(values.begin(),values.end())),high=std::max(0.,*std::max_element(values.begin(),values.end())),span=std::max(1.,high-low);dm::graphics::RPlot::create().bars(x,values,"worked values",{37,99,235}).ylim(low-.05*span,high+.05*span).title("action tricks worked calculation").x_label("Displayed coordinate").size(1000,550).save_svg("build/action_tricks_worked.svg");}
