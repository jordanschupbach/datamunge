// Editable workflow support: rl/replay.hpp
#include <datamunge/rl/replay.hpp>
namespace rl {using dm::rl::replay::Experience;using dm::rl::replay::Batch;using dm::rl::replay::ReplayBuffer;using dm::rl::replay::PrioritizedReplay;using dm::rl::replay::NStepBuffer;using dm::rl::replay::SeqBatch;using dm::rl::replay::SequenceReplay;}

namespace rl {

struct CConfig {
  int steps = 200000;
  int warmup = 1000;       // random actions before training
  int batch = 128;
  int buffer = 100000;
  float gamma = 0.99f;
  float tau = 0.005f;      // Polyak factor for target networks
  float actor_lr = 1e-3f, critic_lr = 1e-3f;
  int hidden = 128;
  float noise = 0.1f;      // exploration noise std (fraction of the action range)
  int log_every = 2000;
  int eval_every = 4000;
  int eval_episodes = 5;
  uint64_t seed = 0;
};

inline void ParseCConfig(int argc, char** argv, CConfig* c) {
  for (int i = 1; i < argc; ++i) {
    const std::string arg = argv[i];
    const size_t eq = arg.find('=');
    if (eq == std::string::npos) continue;
    const std::string key = arg.substr(0, eq);
    const float v = std::strtof(arg.c_str() + eq + 1, nullptr);
    if (key == "threads") {
      datamunge::nn::set_num_threads(static_cast<int>(v));
      continue;
    }
    if (IsHardwareOption(key)) continue;
    if (key == "steps") c->steps = static_cast<int>(v);
    else if (key == "warmup") c->warmup = static_cast<int>(v);
    else if (key == "batch") c->batch = static_cast<int>(v);
    else if (key == "buffer") c->buffer = static_cast<int>(v);
    else if (key == "gamma") c->gamma = v;
    else if (key == "tau") c->tau = v;
    else if (key == "actor_lr") c->actor_lr = v;
    else if (key == "critic_lr") c->critic_lr = v;
    else if (key == "lr") c->actor_lr = c->critic_lr = v;
    else if (key == "hidden") c->hidden = static_cast<int>(v);
    else if (key == "noise") c->noise = v;
    else if (key == "log_every") c->log_every = static_cast<int>(v);
    else if (key == "eval_every") c->eval_every = static_cast<int>(v);
    else if (key == "seed") c->seed = static_cast<uint64_t>(v);
    else if (key != "task" && key != "game") std::fprintf(stderr, "unknown option %s\n", arg.c_str());
  }

  if (!example_runtime::Full()) {
    c->steps = std::min(c->steps, 256);
    c->warmup = std::min(c->warmup, 32);
    c->batch = std::min(c->batch, 8);
    c->log_every = c->eval_every = std::max(1, c->steps);
    c->eval_episodes = 1;
    example_runtime::Describe();
  }
}

inline DqnConfig MonitorConfig(const CConfig& c) {
  DqnConfig d;
  d.log_every = c.log_every;
  d.eval_every = c.eval_every;
  d.eval_episodes = c.eval_episodes;
  return d;
}

// [-1, 1]^dim -> the environment's box.
using dm::rl::continuous::ScaleAction;using dm::rl::continuous::NormalNoise;
using dm::nn::models::DeterministicActor;using dm::nn::models::Gaussian;using dm::nn::models::GaussianActor;
using dm::nn::models::Squashed;using dm::nn::models::SquashedSample;using dm::nn::models::GaussianLogProb;using dm::nn::models::QNetwork;
// Evaluation with a deterministic policy returning actions in [-1, 1].
inline float EvaluateC(Env& env, const std::function<std::vector<float>(const Obs&)>& act, int episodes, uint64_t seed) {
  const ActionSpace space = env.action_space();
  double total = 0;
  for (int e = 0; e < episodes; ++e) {
    Obs obs = env.reset(seed + e);
    while (true) {
      StepResult r = env.step(ScaleAction(act(obs), space));
      total += r.reward;
      obs = r.obs;
      if (r.done()) break;
    }
  }
  report_capture::Trace("eval_call",static_cast<float>(total/episodes));
  return static_cast<float>(total / episodes);
}

}  // namespace rl

// Editable workflow support: rl/pg_common.hpp
// datamunge::nn port of tflow_examples src/common/rl/pg_common.h.
// Pieces shared by the policy-gradient and actor-critic examples: config,
// a softmax actor + value critic built from nn layers, action sampling,
// discounted returns and GAE on the host, and batched rollouts from a VecEnv.
// Monitor, Evaluate and Adam are reused from dqn_common.hpp.
//
// Changes from the TF version: BuildActorCritic runs the network on a
// tensor (eager) instead of adding graph nodes, ObsMatrix/IntVector return
// nn::Tensor (actions as int64), and TF hardware options are ignored.

#include <cmath>
#include <cstdint>
#include <cstdio>
#include <cstdlib>
#include <datamunge/nn/nn.hpp>
#include <random>
#include <string>
#include <vector>




// Editable workflow support: rl/vec_env.hpp
#include <datamunge/rl/environments.hpp>
namespace rl {
using datamunge::rl::environments::VecStep;
using datamunge::rl::environments::VecEnv;
}

namespace rl {

struct PgConfig {
  int steps = 100000;        // environment steps in total (all envs)
  float gamma = 0.99f;
  float lam = 0.95f;         // GAE lambda
  float lr = 1e-3f;
  float clip_norm = 0.5f;
  float entropy_coef = 0.01f;
  float value_coef = 0.5f;
  int hidden = 64;
  int n_envs = 8;            // parallel environments for batched rollouts
  int n_steps = 5;           // rollout length per update
  int log_every = 10000;
  int eval_every = 10000;
  int eval_episodes = 5;
  uint64_t seed = 0;
};

// `just run-nn a2c steps=200000 lr=5e-4 n_envs=16`
inline void ParsePgConfig(int argc, char** argv, PgConfig* c) {
  for (int i = 1; i < argc; ++i) {
    const std::string arg = argv[i];
    const size_t eq = arg.find('=');
    if (eq == std::string::npos) continue;
    const std::string key = arg.substr(0, eq);
    const float v = std::strtof(arg.c_str() + eq + 1, nullptr);
    if (IsHardwareOption(key)) continue;
    if (key == "steps") c->steps = static_cast<int>(v);
    else if (key == "gamma") c->gamma = v;
    else if (key == "lam") c->lam = v;
    else if (key == "lr") c->lr = v;
    else if (key == "clip_norm") c->clip_norm = v;
    else if (key == "entropy") c->entropy_coef = v;
    else if (key == "value_coef") c->value_coef = v;
    else if (key == "hidden") c->hidden = static_cast<int>(v);
    else if (key == "n_envs") c->n_envs = static_cast<int>(v);
    else if (key == "n_steps") c->n_steps = static_cast<int>(v);
    else if (key == "log_every") c->log_every = static_cast<int>(v);
    else if (key == "eval_every") c->eval_every = static_cast<int>(v);
    else if (key == "seed") c->seed = static_cast<uint64_t>(v);
    else if (key != "task" && key != "game") std::fprintf(stderr, "unknown option %s\n", arg.c_str());
  }

  if (!example_runtime::Full()) {
    c->steps = std::min(c->steps, 512);
    c->n_envs = std::min(c->n_envs, 4);
    c->log_every = c->eval_every = std::max(1, c->steps);
    c->eval_episodes = 1;
    example_runtime::Describe();
  }
}

// A DqnConfig carrying the logging fields, for the shared Monitor.
inline DqnConfig MonitorConfig(const PgConfig& c) {
  DqnConfig d;
  d.log_every = c.log_every;
  d.eval_every = c.eval_every;
  d.eval_episodes = c.eval_episodes;
  return d;
}

// Softmax policy over discrete actions plus (optionally) a state-value head
// on its own trunk. All outputs are per row of `obs` [B, obs_dim].
using dm::nn::models::ActorCritic;using dm::nn::models::BuildActorCritic;
using dm::rl::returns::DiscountedReturns;using dm::rl::returns::Gae;
inline nn::Tensor LogProbOf(const nn::Tensor& logp,const nn::Tensor& actions,int count){if(logp.size(1)!=count)throw std::invalid_argument("action width");return dm::rl::foundations::CategoricalActionLogProbability(logp,actions);}
inline int SampleAction(const float* probs,int n,std::mt19937_64& rng){return dm::rl::foundations::SampleCategoricalAction(probs,n,rng);}
// Rows of observations as a float [n, obs_dim] tensor.
inline nn::Tensor ObsMatrix(const std::vector<Obs>&rows){return dm::rl::foundations::ObservationMatrix(rows);}
// Actions as an int64 [n] tensor.
inline nn::Tensor IntVector(const std::vector<int>& v) {
  return nn::from_vector(std::vector<std::int64_t>(v.begin(), v.end()), {static_cast<std::int64_t>(v.size())});
}
inline nn::Tensor FloatVector(const std::vector<float>& v) {
  return nn::from_vector(v, {static_cast<std::int64_t>(v.size())});
}

// n_steps x n_envs rollouts from a VecEnv, stored env-major so each
// environment's sub-trajectory is contiguous for GAE.
using dm::rl::returns::Rollout;

// Collects a rollout. `policy(obs_batch, &probs [n_envs * A], &values [n_envs])`
// runs the network; episode returns are reported to the monitor.
class RolloutCollector {
 public:
  RolloutCollector(VecEnv& venv, int n_actions, uint64_t seed)
      : venv_(venv), A_(n_actions), rng_(seed), obs_(venv.reset()), ep_return_(venv.size(), 0.f) {}

  template <typename PolicyFn>
  Rollout Collect(int n_steps, PolicyFn policy, Monitor* monitor) {
    const int n = venv_.size();
    Rollout ro;
    ro.n_envs = n;
    ro.n_steps = n_steps;
    ro.obs.assign(n, {});
    ro.act.assign(n, {});
    ro.rew.assign(n, {});
    ro.done.assign(n, {});
    ro.val.assign(n, {});
    ro.logp.assign(n, {});
    std::vector<float> probs, values;
    std::vector<Action> actions(n);
    for (int t = 0; t < n_steps; ++t) {
      policy(obs_, &probs, &values);
      for (int i = 0; i < n; ++i) {
        const int a = SampleAction(&probs[i * A_], A_, rng_);
        actions[i] = Action(a);
        ro.obs[i].push_back(obs_[i]);
        ro.act[i].push_back(a);
        ro.val[i].push_back(values[i]);
        ro.logp[i].push_back(std::log(std::max(probs[i * A_ + a], 1e-8f)));
      }
      VecStep s = venv_.step(actions);
      for (int i = 0; i < n; ++i) {
        ro.rew[i].push_back(s.reward[i]);
        ro.done[i].push_back(s.terminated[i] ? 1.f : 0.f);  // truncation still bootstraps
        ep_return_[i] += s.reward[i];
        if (s.done(i)) {
          if (monitor) monitor->EndEpisode(ep_return_[i]);
          ep_return_[i] = 0;
        }
        // On truncation the next observation is a fresh episode; bootstrap
        // from the final observation instead would be more exact, but the
        // reset observation is what we have in batch form.
      }
      obs_ = s.obs;
      total_steps_ += n;
    }
    policy(obs_, &probs, &values);
    ro.last_obs = obs_;
    ro.last_val = values;
    return ro;
  }
  long total_steps() const { return total_steps_; }

 private:
  VecEnv& venv_;
  int A_;
  std::mt19937_64 rng_;
  std::vector<Obs> obs_;
  std::vector<float> ep_return_;
  long total_steps_ = 0;
};

}  // namespace rl

namespace nn = datamunge::nn;
using nn::Tensor;

namespace {

void SquashingDemo() {
  std::printf("#### Part 1: tanh squashing\n");
  const float mu = 0.8f, sigma = 0.7f;
  const int samples = 2000000, bins = 40;
  std::mt19937_64 rng(0);
  std::normal_distribution<float> normal(mu, sigma);
  std::vector<double> hist_tanh(bins, 0), hist_clip(bins, 0);
  int clipped = 0;
  for (int i = 0; i < samples; ++i) {
    const float u = normal(rng);
    const float a = std::tanh(u);
    hist_tanh[std::min(bins - 1, static_cast<int>((a + 1) / 2 * bins))] += 1.0;
    const float c = std::max(-1.f, std::min(1.f, u));
    clipped += std::abs(u) > 1;
    hist_clip[std::min(bins - 1, static_cast<int>((c + 1) / 2 * bins))] += 1.0;
  }
  report_capture::Save("hist_tanh",hist_tanh);report_capture::Save("hist_clip",hist_clip);
  // The squashed density from the formula, via the shared SquashedSample.
  nn::NoGradGuard no_grad;
  const rl::Gaussian g{nn::full({1, 1}, mu), nn::full({1, 1}, std::log(sigma))};
  std::printf("  u ~ N(%.1f, %.1f^2), a = tanh(u). Density of a: Monte Carlo vs formula, and the same without the Jacobian term\n", mu, sigma);
  std::printf("  %8s %10s %12s %14s %14s\n", "a", "MC", "with corr.", "w/o corr.", "clipped MC");
  double worst_rel = 0;
  for (int b = 4; b < bins; b += 5) {
    const float a = -1 + (b + 0.5f) * 2.f / bins;
    const float u = std::atanh(a), e = (u - mu) / sigma;
    const Tensor et = nn::full({1, 1}, e);
    const rl::Squashed sq = rl::SquashedSample(g, et);
    const Tensor gauss_only = -0.5 * nn::square(et) - (std::log(sigma) + 0.5f * std::log(2 * 3.14159265f));
    const double mc = hist_tanh[b] / samples * bins / 2, with = std::exp(sq.logp.item<float>());
    std::printf("  %8.3f %10.4f %12.4f %14.4f %14.4f\n", a, mc, with, std::exp(gauss_only.item<float>()), hist_clip[b] / samples * bins / 2);
    if (b < bins - 1) worst_rel = std::max(worst_rel, std::abs(mc - with) / with);
    if (b == 19) check::Near(mc, 0.2845, 1e-4, "MC density at a=-0.025 (TF table: 0.2845)");
  }
  std::printf("  clipping instead: %.1f%% of samples land exactly on a bound (a point mass the Gaussian log-prob ignores)\n", 100.0 * clipped / samples);
  check::Require(worst_rel < 0.02, "corrected density matches the Monte Carlo histogram within 2% away from the bound");
  check::Near(100.0 * clipped / samples, 39.3, 0.05, "clipped fraction (TF: 39.3%)");
}

// Toy task: move from x to a target t in one step. The discrete action is
// the direction (left / right) and its continuous parameter the magnitude
// in [0, 1]; reward = -|x + dir * magnitude - t|. The oracle scores 0.
void HybridDemo() {
  std::printf("\n#### Part 2: parameterized actions on a one-step reaching task\n");
  constexpr int K = 2;
  const int batch = 256, iterations = 1500;
  const float entropy_coef = 0.01f, dirs[K] = {-1.f, 1.f};
  std::mt19937_64 rng(1);
  nn::ParameterStore params(0);
  report_capture::Checkpoint checkpoint_params{params};

  using Out=nn::models::HybridReachPath;
  auto net = [&](const Tensor& obs) {
return nn::models::HybridReachPolicy(params,obs);
};
  {
    nn::NoGradGuard no_grad;
    net(nn::zeros({1, 2}));
  }
  nn::Optimizer native_adam(params,3e-3,{nn::OptimizerKind::Adam});
auto native_adam_minimize=[&](const Tensor& loss){auto gradients=nn::grad(loss,native_adam.parameters());double norm;if(1.0>0){auto clipped=nn::clip_by_global_norm(gradients,1.0);gradients=std::move(clipped.first);norm=clipped.second;}else norm=nn::global_norm(gradients);native_adam.step(gradients);return norm;};


  auto reward = [&](float x, float target, int k, float u) {
return nn::models::HybridReachReward(x,target,k,u);
};
  std::normal_distribution<float> normal(0.f, 1.f);
  std::uniform_real_distribution<float> unif(-1.f, 1.f);
  std::vector<float> ob(batch * 2), uv(batch * K), advs(batch);
  std::vector<int> ks(batch);
  double last_mean = 0;
  std::printf("  %10s %12s %12s\n", "iteration", "mean reward", "sigma");
  for (int it = 1; it <= iterations; ++it) {
    for (int i = 0; i < batch; ++i) ob[i * 2] = unif(rng), ob[i * 2 + 1] = unif(rng);
    const Tensor obs = nn::from_vector(ob, {batch, 2});
    std::vector<float> probs, means, log_std;
    {
      nn::NoGradGuard no_grad;
      const Out o = net(obs);
      probs = o.probs.to_vector<float>(), means = o.means.to_vector<float>(), log_std = o.log_std.to_vector<float>();
    }
    double total = 0;
    for (int i = 0; i < batch; ++i) {
      const int k = rl::SampleAction(probs.data() + i * K, K, rng);
      ks[i] = k;
      for (int j = 0; j < K; ++j) uv[i * K + j] = means[i * K + j] + std::exp(log_std[j]) * normal(rng);
      advs[i] = reward(ob[i * 2], ob[i * 2 + 1], k, uv[i * K + k]);
      total += advs[i];
    }
    const float baseline = static_cast<float>(total / batch);
    for (float& a : advs) a -= baseline;
    const float sigma = std::exp(log_std[0]);
    // Joint log-probability of (k, u_k) and REINFORCE with a small entropy
    // bonus on the discrete head, which keeps both branches alive while their
    // parameters are still being learned.
    const Out o = net(obs);
    const Tensor onehot = nn::one_hot(rl::IntVector(ks), K);
    const Tensor logp_k = nn::sum(o.log_softmax * onehot, {1});
    const Tensor zk = (nn::from_vector(uv, {batch, K}) - o.means) / nn::exp(o.log_std);
    const Tensor logp_u = nn::sum((-0.5 * nn::square(zk) - (o.log_std + 0.5 * std::log(2 * 3.14159265))) * onehot, {1});
    const Tensor logp = logp_k + logp_u;
    const Tensor disc_entropy = nn::mean(-nn::sum(o.probs * o.log_softmax, {1}), {0});
    const Tensor loss = -nn::mean(logp * rl::FloatVector(advs), {0}) - entropy_coef * disc_entropy;
    check::Require(std::isfinite(loss.item<float>()), "finite REINFORCE loss");
    native_adam_minimize(loss);
    last_mean = total / batch;report_capture::Trace("hybrid_reward",last_mean);
    if (it % 250 == 0 || it == 1) std::printf("  %10d %12.3f %12.3f\n", it, total / batch, sigma);
  }
  double random = 0;
  for (int i = 0; i < 10000; ++i) random += reward(unif(rng), unif(rng), rng() % 2, std::abs(unif(rng)));
  std::printf("  oracle mean reward 0.000, random policy %.3f\n", random / 10000);
  std::printf("  learned policy from x = 0 for several targets (P(right), magnitude mean of the chosen direction):\n ");
  int correct = 0;
  for (float d : {-0.9f, -0.3f, 0.3f, 0.9f}) {
    nn::NoGradGuard no_grad;
    const Out o = net(nn::from_vector(std::vector<float>{0.f, d}, {1, 2}));
    const std::vector<float> p = o.probs.to_vector<float>(), m = o.means.to_vector<float>();
    const int k = p[1] > 0.5f ? 1 : 0;
    std::printf("  t=%+.1f: P(right)=%.2f, magnitude=%.2f;", d, p[1], m[k]);
    correct += (k == 1) == (d > 0) && std::abs(m[k] - std::abs(d)) < 0.2f;
  }
  std::printf("\n");
  // TF: final mean reward -0.113 (random -0.802); all four probes pick the right direction.
  check::Require(last_mean > -0.3, "hybrid REINFORCE beats random play by a wide margin (final mean reward > -0.3)");
  check::TrainingQuality(correct >= 3, "learned direction and magnitude for at least 3 of 4 probe targets");
}

}  // namespace

int main() {
  SquashingDemo();
  HybridDemo();
  return 0;
}

