> Complete preserved source experiment

This source has fixed budgets independent of the short-mode helper: two million histogram samples and1500 hybrid-policy updates with256 examples per update. Both are retained, along with the10000-draw random-policy comparison and four final probes. No external-framework parity is asserted. Every policy/actor schedule, replay collection, objective, optimizer/clipping step, target synchronization, temperature/dual update and search is visible below. Instrumentation copies histories/parameters without new draws or updates.

```{cpp, results="output", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -lpthread -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
namespace report_capture {
inline dm::nn::NamedTensors arrays;inline std::map<std::string,std::vector<double>> traces;
inline void Trace(const std::string&name,double value){traces[name].push_back(value);}inline int monitor_index=0,checkpoint_index=0;
template<class T>void Save(const std::string& name,const std::vector<T>&v){arrays.push_back({name,dm::nn::from_vector(v)});}
struct Checkpoint{dm::nn::ParameterStore& store;~Checkpoint(){auto tag=std::to_string(checkpoint_index++);for(const auto& name:store.names())arrays.push_back({"parameters_"+tag+"_"+name,store.at(name).detach().clone()});}};
struct Flush{~Flush(){for(const auto&[name,values]:traces)Save(name,values);if(!arrays.empty()){std::filesystem::create_directories("build");dm::nn::save_npz("build/action_tricks_source.npz",arrays);}}};inline Flush flush;
}
// CMD: just run-nn action_tricks
// Action-space tricks: tanh squashing and parameterized actions.
//
// Port of tflow's action_tricks.
// Part 1. A Gaussian policy produces unbounded actions; environments want
// a box. Squashing with tanh keeps the policy differentiable but changes
// the density: log pi(a) = log N(u) - sum_i log(1 - tanh(u_i)^2). The
// correction is checked against a Monte Carlo histogram, and compared with
// the clipping alternative, which piles probability mass on the bounds.
//
// Part 2. Parameterized (hybrid) actions: a discrete choice with its own
// continuous parameters, log pi(k, u | s) = log pi_d(k|s) + log N(u | mu_k(s), sigma_k).
// A toy reaching task is solved with REINFORCE on that joint log-probability.
//
// Part 1 draws the same std::mt19937_64 samples as TF and evaluates the shared
// SquashedSample (common/rl/continuous.hpp) eagerly, so its table matches TF's
// digit for digit. Part 2's TF graph becomes eager nn ops over a
// ParameterStore; its task draws and samples use the same stream as TF but
// the weights use nn's generator, so the learning curve matches statistically.

#include <algorithm>
#include <cmath>
#include <cstdio>
#include <datamunge/nn/nn.hpp>
#include <random>
#include <vector>

// Editable workflow support: checks.hpp
// Small runtime checks used by the executable nn examples. They stay on in
// Release builds and make the example exit nonzero on failure, so `just
// run-all-nn` doubles as a regression test against the recorded TF numbers.

#include <cmath>
#include <iostream>
#include <stdexcept>
#include <string>
// Editable workflow support: runtime.hpp
// Bounded demonstrations by default; opt into convergence experiments explicitly.

#include <algorithm>
#include <cstdlib>
#include <iostream>
#include <string>

namespace example_runtime {

inline bool Full() {
  const char* value = std::getenv("DATAMUNGE_EXAMPLES_FULL");
  return value && std::string(value) == "1";
}

template <typename T> T Limit(T requested, T quick_limit) {
  return Full() ? requested : std::min(requested, quick_limit);
}

inline void Describe() {
  if (!Full())
    std::cout << "Quick demonstration: bounded training; convergence metrics require "
                 "DATAMUNGE_EXAMPLES_FULL=1.\n";
}

}  // namespace example_runtime

namespace check {

inline void Require(bool condition, const std::string& message) {
  if (!condition) throw std::runtime_error(message);
}

// A short demonstration checks execution, derivatives and persistence; reaching
// a published accuracy/return requires the separately requested full schedule.
inline void TrainingQuality(bool condition, const std::string& message) {
  if (example_runtime::Full()) Require(condition, message);
  else std::cout << "  full-training quality check deferred: " << message << '\n';
}

inline void Near(double actual, double expected, double tolerance, const std::string& message) {
  if (!std::isfinite(actual) || !std::isfinite(expected) || std::abs(actual - expected) > tolerance)
    throw std::runtime_error(message + ": got " + std::to_string(actual) + ", expected " + std::to_string(expected));
}

/// Expects `f` to throw; returns the message.
template <typename F>
std::string Throws(F&& f, const std::string& message) {
  try {
    f();
  } catch (const std::exception& e) {
    return e.what();
  }
  throw std::runtime_error(message + ": expected an exception");
}

}  // namespace check

inline void Header(const std::string& title) {
  const std::size_t pad = title.size() < 60 ? 60 - title.size() : 0;
  std::cout << "\n== " << title << " " << std::string(pad, '=') << "\n";
}

// Editable workflow support: rl/continuous.hpp
// datamunge::nn port of tflow_examples src/common/rl/continuous.h.
// Pieces shared by the continuous-control examples: config, deterministic
// and Gaussian actors, tanh-squashed sampling with its log-density
// correction, state-action critics, and deterministic evaluation. Actions
// inside the networks live in [-1, 1]; the environment's bounds are applied
// at the boundary with ScaleAction.
//
// Changes from the TF version: the networks are eager functions of a
// ParameterStore and a tensor (calling one twice with the same store and
// name shares its weights, as nn::Params did), NormalNoise returns an
// nn::Tensor, and the TF hardware options are accepted and ignored except
// threads=N, which sets nn's thread count.

#include <algorithm>
#include <cmath>
#include <cstdint>
#include <cstdio>
#include <cstdlib>
