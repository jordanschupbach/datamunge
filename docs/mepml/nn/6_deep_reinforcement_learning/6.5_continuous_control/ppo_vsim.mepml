int main(){auto data=dm::nn::load_npz("build/ppo_vsim_source.npz");auto plot=dm::graphics::RPlot::create();int series=0;for(const auto&[key,t]:data){if(!key.starts_with("eval_call"))continue;auto y=t.to_vector<double>();if(y.empty())continue;std::vector<double>x(y.size());std::iota(x.begin(),x.end(),0.);plot.lines(x,y,key,{37+(series%4)*50,99,235-(series%4)*50}).points(x,y,key+" points",{37+(series%4)*50,99,235-(series%4)*50},4);++series;}if(!series)throw std::runtime_error("source diagnostic missing");plot.title("ppo vsim actual source diagnostics").x_label("Existing evaluation call").y_label("Task return").size(1100,600).save_svg("build/ppo_vsim_diagnostic0.svg");}
