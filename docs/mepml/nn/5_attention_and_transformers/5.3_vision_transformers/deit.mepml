namespace paths {

inline std::filesystem::path DataRoot() {
  return dataset_assets::DataRoot();
}

/// DataRoot() / name, e.g. Dataset("mnist").
inline std::filesystem::path Dataset(const std::string& name) { if(name=="cifar10"||name=="character_rnn")return DataRoot()/name;return std::filesystem::path(dm::datasets::prepare_example_data("nn-completion-assets"))/name; }

inline std::filesystem::path OutputRoot(){return std::filesystem::absolute("build/nn-completion");}

/// OutputRoot() / relative, created as a directory.
inline std::filesystem::path OutputDir(const std::string& relative) {
  auto dir = OutputRoot() / relative;
  std::filesystem::create_directories(dir);
  return dir;
}

}  // namespace paths

namespace replay {

namespace nn = datamunge::nn;
using nn::Tensor;
using Map = std::map<std::string, Tensor>;

/// tflow's recorded output directory for an example (its output/models/<name>).
inline std::filesystem::path TfModels(const std::string& name) {
  return paths::DataRoot().parent_path() / "models" / name;
}

inline Tensor Get(const nn::NamedTensors& arrays, const std::string& key) {
  for (const auto& [name, t] : arrays)
    if (name == key) return t;
  throw std::runtime_error("missing array " + key);
}

inline Map ToMap(const nn::NamedTensors& arrays) { return {arrays.begin(), arrays.end()}; }
inline nn::NamedTensors ToNamed(const Map& m) { return {m.begin(), m.end()}; }

/// Rows `rows` (axis 0) of every array.
inline Map Rows(const Map& m, const std::vector<std::int64_t>& rows) {
  Map out;
  for (const auto& [k, v] : m) out[k] = nn::take_rows(v, rows);
  return out;
}

/// {key: arrays["<split>_<key>"]} for each key.
inline Map Split(const nn::NamedTensors& arrays, const std::string& split, const std::vector<std::string>& keys) {
  Map out;
  for (const auto& k : keys) out[k] = Get(arrays, split + "_" + k);
  return out;
}

inline double MaxAbsDiff(const Tensor& a, const Tensor& b) {
  const auto x = a.to_vector<double>(), y = b.to_vector<double>();
  check::Require(x.size() == y.size(), "compared tensors have the same size");
  double m = 0;
  for (std::size_t i = 0; i < x.size(); ++i) m = std::max(m, std::abs(x[i] - y[i]));
  return m;
}

/// Bit-identical values (dtype and shape included).
inline bool SameBits(const Tensor& a, const Tensor& b) {
  if (a.dtype() != b.dtype() || a.shape() != b.shape()) return false;
  auto same = [](const auto& x, const auto& y) {
    return x.size() == y.size() && (x.empty() || std::memcmp(x.data(), y.data(), x.size() * sizeof(x[0])) == 0);
  };
  switch (a.dtype()) {
    case nn::DType::Float32: return same(a.to_vector<float>(), b.to_vector<float>());
    case nn::DType::Float64: return same(a.to_vector<double>(), b.to_vector<double>());
    case nn::DType::Int32: return same(a.to_vector<std::int32_t>(), b.to_vector<std::int32_t>());
    default: return same(a.to_vector<std::int64_t>(), b.to_vector<std::int64_t>());
  }
}

inline bool SameBits(const Map& a, const Map& b) {
  if (a.size() != b.size()) return false;
  for (const auto& [k, v] : a)
    if (!b.count(k) || !SameBits(v, b.at(k))) return false;
  return true;
}

/// Copies of every parameter, by name.
inline Map Arrays(const nn::ParameterStore& p) {
  Map out;
  for (const auto& name : p.names()) out[name] = p.at(name).detach().clone();
  return out;
}

/// Gradients aligned with p.names(), by name.
inline Map Named(const nn::ParameterStore& p, const std::vector<Tensor>& g) {
  Map out;
  for (std::size_t i = 0; i < g.size(); ++i) out[p.names()[i]] = g[i].defined() ? g[i].detach() : nn::zeros_like(p.parameters()[i]).detach();
  return out;
}

/// Overwrites every parameter of `p` from an .npz (e.g. TF's initial_arrays.npz),
/// which must hold exactly p's names.
inline void LoadInto(nn::ParameterStore& p, const std::filesystem::path& file) {
  const auto arrays = nn::load_npz(file.string());
  check::Require(arrays.size() == p.size(), "array file covers exactly the model's parameters: " + file.string());
  for (const auto& [name, value] : arrays) {
    check::Require(p.contains(name), "array " + name + " is a model parameter");
    p.set(name, nn::cast(value, p.at(name).dtype()));
  }
}

/// max |a[k] - b[k]| over the keys of `a` (all must exist in `b`).
inline double MaxDiff(const Map& a, const Map& b) {
  double m = 0;
  for (const auto& [k, v] : a) {
    check::Require(b.count(k) > 0, "reference has array " + k);
    m = std::max(m, MaxAbsDiff(v, b.at(k)));
  }
  return m;
}
inline double MaxDiff(const Map& a, const std::filesystem::path& file) { return MaxDiff(a, ToMap(nn::load_npz(file.string()))); }

/// Column `column` (0-based) of a tab-separated history file with a header line.
inline std::vector<double> History(const std::filesystem::path& file, int column = 1) {
  std::ifstream       in(file);
  std::string         line;
  std::vector<double> out;
  std::getline(in, line);
  while (std::getline(in, line)) {
    std::stringstream ss(line);
    std::string       cell;
    for (int c = 0; c <= column && std::getline(ss, cell, '\t'); ++c)
      if (c == column) out.push_back(std::stod(cell));
  }
  return out;
}

inline nn::OptimizerConfig Adam() {
  nn::OptimizerConfig c;
  c.kind = nn::OptimizerKind::Adam;
  return c;
}

/// Copies `files` from `from` to `to` when present.
inline void CopyAssets(const std::filesystem::path& from, const std::filesystem::path& to,
                       const std::vector<std::string>& files) {
  for (const auto& f : files)
    if (std::filesystem::exists(from / f))
      std::filesystem::copy_file(from / f, to / f, std::filesystem::copy_options::overwrite_existing);
}

}  // namespace replay

namespace vit {using namespace dm::nn::models::vit;
inline Tensor Loss(const Tensor& logits, const Tensor& labels) {
  return -nn::mean(
      nn::sum(
          nn::one_hot(labels, 10, 1, 0, nn::DType::Float32) * nn::log_softmax(logits, -1), {1}));
}
class Model {
 public:
  nn::ParameterStore             parameters{48301};
  std::unique_ptr<nn::Optimizer> optimizer;
  explicit Model(bool training = true) {
    {
      nn::NoGradGuard guard;
      Forward(parameters, nn::zeros({1, 32, 32, 3}));
    }
    if (training) {
      nn::OptimizerConfig c;
      c.kind    = nn::OptimizerKind::Adam;
      optimizer = std::make_unique<nn::Optimizer>(parameters, .003, c);
    }
  }
  static void Validate(const A& b) {
    const auto& x = b.at("images");
    check::Require(
        x.dtype() == nn::DType::Float32 && x.dim() == 4 && x.size(0) > 0 && x.size(1) == 32 &&
            x.size(2) == 32 && x.size(3) == 3,
        "ViT32x32RGB images");
    for (float v : x.to_vector<float>())
      check::Require(std::isfinite(v), "finite ViT pixels");
  }
  A Run(const A& b, bool gradients = false, const A& overrides = {}) {
    Validate(b);
    A saved;
    for (const auto& [k, v] : overrides) {
      saved[k] = parameters.at(k).detach().clone();
      parameters.set(k, v);
    }
    struct Restore {
      nn::ParameterStore& p;
      A&                  saved;
      ~Restore() {
        for (const auto& [k, v] : saved)
          p.set(k, v);
      }
    } restore{parameters, saved};
    auto                x    = b.at("images").detach().requires_grad_();
    auto                path = Forward(parameters, x);
    auto                loss = Loss(path.logits, b.at("labels"));
    std::vector<Tensor> inputs{x};
    if (gradients) {
      auto values = parameters.parameters();
      inputs.insert(inputs.end(), values.begin(), values.end());
    }
    auto g = nn::grad(loss, inputs);
    A    out{
           {"logits", path.logits},
           {"patches", path.patches},
           {"embedded", path.embedded},
           {"hidden", path.hidden},
           {"attention0", path.attention[0]},
           {"attention1", path.attention[1]},
           {"state0", path.states[0]},
           {"state1", path.states[1]},
           {"loss", loss},
           {"input_gradient", g[0]}};
    if (gradients)
      for (std::size_t i = 0; i < parameters.size(); ++i)
        out[parameters.names()[i]] = g[i + 1];
    for (auto& [k, v] : out)
      v = v.detach().clone();
    return out;
  }
  Tensor Predict(const A& b) {
    Validate(b);
    nn::NoGradGuard guard;
    return Forward(parameters, b.at("images")).logits;
  }
  void Update(const A& b) {
    Validate(b);
    auto path = Forward(parameters, b.at("images"));
    optimizer->minimize(Loss(path.logits, b.at("labels")));
  }
  A Arrays() const { return replay::Arrays(parameters); }
};
inline A Pool(const A& data, const std::string& split) {
  A out;
  for (const auto key : {"images", "labels", "source_ids"})
    out[key] = data.at(split + "_" + key);
  return out;
}
inline Tensor Permute(const Tensor& images) {
  const auto n       = images.size(0);
  auto       patches = nn::reshape(
      nn::transpose(nn::reshape(images, {n, 4, 8, 4, 8, 3}), {0, 1, 3, 2, 4, 5}), {n, 16, 8, 8, 3});
  return nn::reshape(
      nn::transpose(nn::reshape(nn::reverse(patches, {1}), {n, 4, 4, 8, 8, 3}), {0, 1, 3, 2, 4, 5}),
      images.shape());
}
} // namespace vit

namespace deit {using namespace dm::nn::models::deit;

class Model {
 public:
  bool                           teacher;
  nn::ParameterStore             parameters;
  std::unique_ptr<nn::Optimizer> optimizer;
  explicit Model(bool cnn = false, bool training = true)
      : teacher(cnn), parameters(cnn ? 48501 : 48503) {
    {
      nn::NoGradGuard guard;
      Fields(nn::zeros({1, 32, 32, 3}));
    }
    if (training) {
      nn::OptimizerConfig c;
      c.kind    = nn::OptimizerKind::Adam;
      optimizer = std::make_unique<nn::Optimizer>(parameters, .003, c);
    }
  }
  A Fields(const Tensor& images) {
    if (teacher) {
      nn::ConvLayerOptions c;
      c.activation = nn::Activation::Relu;
      auto first   = nn::avg_pool2d(
          nn::conv2d(parameters, "conv1", images, 4, 3, c), 2, 2, nn::Padding::Valid);
      auto second =
          nn::avg_pool2d(nn::conv2d(parameters, "conv2", first, 8, 3, c), 2, 2, nn::Padding::Valid);
      auto             features = nn::global_avg_pool2d(second);
      nn::DenseOptions o;
      o.init      = nn::init::normal(.1);
      auto logits = nn::dense(parameters, "head", features, 10, o);
      return {
          {"logits", logits}, {"features0", first}, {"features1", second}, {"features", features}};
    }
    auto p = Forward(parameters, images);
    return {
        {"logits", p.logits},
        {"class_logits", p.class_logits},
        {"distill_logits", p.distill_logits},
        {"patches", p.patches},
        {"embedded", p.embedded},
        {"hidden", p.hidden},
        {"attention0", p.attention[0]},
        {"attention1", p.attention[1]},
        {"state0", p.states[0]},
        {"state1", p.states[1]}};
  }
  Tensor Objective(A& fields, const A& b, double alpha) {
    check::Require(alpha >= 0 && alpha <= 1, "DeiT teacher weight0..1");
    fields["classification_loss"] =
        vit::Loss(fields.at(teacher ? "logits" : "class_logits"), b.at("labels"));
    auto loss = fields.at("classification_loss");
    if (!teacher) {
      fields["distillation_loss"] = vit::Loss(fields.at("distill_logits"), b.at("teacher_labels"));
      loss                        = loss * (1 - alpha) + fields.at("distillation_loss") * alpha;
    }
    fields["loss"] = loss;
    return loss;
  }
  A Run(const A& b, bool gradients = false, double alpha = .5, const A& overrides = {}) {
    vit::Model::Validate(b);
    A saved;
    for (const auto& [k, v] : overrides) {
      saved[k] = parameters.at(k).detach().clone();
      parameters.set(k, v);
    }
    struct Restore {
      nn::ParameterStore& p;
      A&                  a;
      ~Restore() {
        for (const auto& [k, v] : a)
          p.set(k, v);
      }
    } restore{parameters, saved};
    auto                x    = b.at("images").detach().requires_grad_();
    auto                out  = Fields(x);
    auto                loss = Objective(out, b, alpha);
    std::vector<Tensor> inputs{x};
    if (gradients) {
      auto p = parameters.parameters();
      inputs.insert(inputs.end(), p.begin(), p.end());
    }
    auto g                = nn::grad(loss, inputs);
    out["input_gradient"] = g[0];
    if (gradients)
      for (std::size_t i = 0; i < parameters.size(); ++i)
        out[parameters.names()[i]] = g[i + 1];
    for (auto& [k, v] : out)
      v = v.detach().clone();
    return out;
  }
  Tensor Predict(const A& b) {
    vit::Model::Validate(b);
    nn::NoGradGuard guard;
    return Fields(b.at("images")).at("logits");
  }
  Tensor TeacherLabels(const A& b) { return nn::cast(nn::argmax(Predict(b), 1), nn::DType::Int32); }
  void   Update(const A& b) {
    vit::Model::Validate(b);
    auto fields = Fields(b.at("images"));
    optimizer->minimize(Objective(fields, b, .5));
  }
  A Arrays() const { return replay::Arrays(parameters); }
};
} // namespace deit

namespace nn = datamunge::nn;
namespace {
using deit::Model;
using vit::A;
void Save(const std::filesystem::path& path, const A& a) {
  nn::save_npz(path.string(), replay::ToNamed(a));
}
A WithTeacher(Model& teacher, A b) {
  b["teacher_labels"] = teacher.TeacherLabels(b);
  return b;
}
void FiniteDifferences(
    Model&                       model,
    const A&                     batch,
    const A&                     gradients,
    const std::filesystem::path& root) {
  const auto arrays = model.Arrays();
  double     error  = 0;
  int        count  = 0;
  for (const auto& name : model.parameters.names()) {
    const auto v      = arrays.at(name);
    auto       values = v.to_vector<float>();
    for (int c : {0, int(values.size() / 2), int(values.size() - 1)}) {
      float old   = values[c];
      values[c]   = old + .0005f;
      double plus = model.Run(batch, false, .5, {{name, nn::from_vector(values, v.shape())}})
                        .at("loss")
                        .item();
      values[c]    = old - .0005f;
      double minus = model.Run(batch, false, .5, {{name, nn::from_vector(values, v.shape())}})
                         .at("loss")
                         .item();
      values[c] = old;
      error     = std::max(
          error, std::abs((plus - minus) / .001 - gradients.at(name).to_vector<float>()[c]));
      ++count;
    }
  }
  check::Require(error < .004, "DeiT/CNN whole-model finite differences");
  std::ofstream file(root / "finite_differences.json");
  file.precision(17);
  file << "{\"count\":" << count << ",\"error\":" << error << "}\n";
  std::cout << (model.teacher ? "teacher" : "student") << " nativeFD=" << count << " max=" << error
            << std::endl;
}
void Train(
    Model&                       model,
    Model*                       frozen,
    const A&                     data,
    int                          epochs,
    const std::filesystem::path& root) {
  std::filesystem::create_directories(root);
  auto fit = vit::Pool(data, "fit"), validation = vit::Pool(data, "validation"),
       test = vit::Pool(data, "test");
  if (frozen) {
    fit        = WithTeacher(*frozen, fit);
    validation = WithTeacher(*frozen, validation);
    test       = WithTeacher(*frozen, test);
    Save(
        root / "teacher_targets.npz",
        {{"fit", fit.at("teacher_labels")},
         {"validation", validation.at("teacher_labels")},
         {"test", test.at("teacher_labels")}});
  }
  const auto tf        = replay::TfModels("deit") / (model.teacher ? "teacher" : "student");
  const bool replay_tf = std::filesystem::exists(tf / "initial_arrays.npz");
  if (replay_tf)
    replay::LoadInto(model.parameters, tf / "initial_arrays.npz");
  auto compare = [&](const A& out, const std::string& file, double tolerance) {
    if (replay_tf && std::filesystem::exists(tf / file)) {
      auto reference = replay::ToMap(nn::load_npz((tf / file).string()));
      // The hard teacher targets must match before comparing student losses.
      const auto targets = tf / "teacher_targets.npz";
      if (!model.teacher && std::filesystem::exists(targets)) {
        const auto expected = replay::ToMap(nn::load_npz(targets.string()));
        if (!replay::SameBits(expected.at("fit"), fit.at("teacher_labels"))) {
          std::cout << "TF teacher hard targets differ; training comparison is statistical\n";
          return;
        }
      }
      double error = replay::MaxDiff(out, reference);
      // Small CNN activation errors accumulate through 48 Adam updates; check
      // predictions/loss/input partials more tightly than internal feature maps.
      check::Near(
          error, 0, model.teacher ? std::max(tolerance, 2e-4) : tolerance, "TF DeiT " + file);
      if (model.teacher)
        for (const auto key : {"logits", "loss", "input_gradient"})
          check::Near(
              replay::MaxAbsDiff(out.at(key), reference.at(key)),
              0,
              5e-5,
              "TF CNN " + std::string(key));
      std::cout << (model.teacher ? "teacher" : "student") << " TF " << file
                << " difference=" << error << std::endl;
    }
  };
  auto frozen_before = frozen ? frozen->Arrays() : A{};
  Save(root / "initial_arrays.npz", model.Arrays());
  auto initial = model.Run(test);
  Save(root / "initial_outputs.npz", initial);
  compare(initial, "initial_outputs.npz", 5e-5);
  nn::BatchOrder order(128, 8, 48507);
  std::ofstream  batches(root / "batches.tsv"), history(root / "history.tsv");
  batches << "epoch\tstep\trow\tsource_id\n";
  history << "epoch\tvalidation_loss\tclassification_ce\tdistillation_ce\n";
  int updates = 0;
  A   first;
  for (int epoch = 1; epoch <= epochs; ++epoch) {
    order.begin_epoch();
    for (;;) {
      auto rows = order.next();
      if (rows.empty())
        break;
      auto batch = replay::Rows(fit, rows);
      if (frozen)
        check::Require(
            replay::SameBits(frozen->TeacherLabels(batch), batch.at("teacher_labels")),
            "cached hard targets equal frozen image teacher");
      if (!updates) {
        first = batch;
        Save(root / "first_batch.npz", batch);
        auto g = model.Run(batch, true);
        Save(root / "initial_gradients.npz", g);
        compare(g, "initial_gradients.npz", 1e-4);
      }
      model.Update(batch);
      if (frozen)
        check::Require(
            replay::SameBits(frozen_before, frozen->Arrays()),
            "teacher immutable after EVERY student update");
      if (!updates)
        Save(root / "first_after.npz", model.Arrays());
      const auto ids = fit.at("source_ids").to_vector<int>();
      for (auto row : rows)
        batches << epoch << '\t' << updates << '\t' << row << '\t' << ids[row] << '\n';
      ++updates;
    }
    auto out = model.Run(validation);
    history << epoch << '\t' << out.at("loss").item() << '\t'
            << out.at("classification_loss").item() << '\t'
            << (model.teacher ? 0 : out.at("distillation_loss").item()) << '\n';
    const auto prefix = "epoch" + std::to_string(epoch);
    Save(root / (prefix + "_arrays.npz"), model.Arrays());
    Save(root / (prefix + "_validation.npz"), out);
    compare(out, prefix + "_validation.npz", 1e-4);
    std::cout << (model.teacher ? "teacher" : "student") << " epoch=" << epoch
              << " validationLoss=" << out.at("loss").item() << std::endl;
  }
  Save(root / "model_arrays.npz", model.Arrays());
  auto gradients = model.Run(first, true);
  Save(root / "final_gradients.npz", gradients);
  FiniteDifferences(model, first, gradients, root);
  model.parameters.save((root / "final.npz").string());
  Model deployed(model.teacher, false);
  deployed.parameters.load((root / "final.npz").string());
  check::Require(
      replay::SameBits(model.Arrays(), deployed.Arrays()), "teacher/student checkpoints bitexact");
  auto before = deployed.Arrays(), out = deployed.Run(test);
  Save(root / "outputs.npz", out);
  compare(out, "outputs.npz", 1e-4);
  check::Near(
      replay::MaxAbsDiff(deployed.Predict({{"images", test.at("images")}}), out.at("logits")),
      0,
      0,
      "image-only inference requires neither teacher nor gold targets");
  if (!model.teacher) {
    auto cls = model.Run(first, true, 0), dist = model.Run(first, true, 1);
    Save(root / "classification_only.npz", cls);
    Save(root / "distillation_only.npz", dist);
    for (const auto& name : model.parameters.names())
      check::Near(
          replay::MaxAbsDiff(gradients.at(name), (cls.at(name) + dist.at(name)) * .5),
          0,
          2e-6,
          "dual-loss gradient decomposition");
    for (const auto name : {"distill_head/W", "distill_head/b"})
      check::Near(
          nn::max(nn::abs(cls.at(name))).item(),
          0,
          0,
          "classification does not supervise DIST head");
    for (const auto name : {"head/W", "head/b"})
      check::Near(
          nn::max(nn::abs(dist.at(name))).item(), 0, 0, "teacher CE does not supervise CLS head");
    auto changed = first;
    auto targets = first.at("teacher_labels").to_vector<int>();
    for (auto& t : targets)
      t = (t + 1) % 10;
    changed["teacher_labels"] = nn::from_vector(targets, first.at("teacher_labels").shape());
    auto control              = model.Run(changed, true);
    check::Near(
        replay::MaxAbsDiff(control.at("logits"), gradients.at("logits")),
        0,
        0,
        "teacher target cannot leak into prediction");
    check::Near(
        control.at("classification_loss").item(),
        gradients.at("classification_loss").item(),
        0,
        "teacher affects only distillation loss");
    check::Require(
        replay::MaxAbsDiff(control.at("distill_head/W"), gradients.at("distill_head/W")) > .001,
        "teacher supervision trains DIST head");
    Save(root / "changed_teacher_inputs.npz", changed);
    Save(root / "changed_teacher_outputs.npz", control);
    auto ablated = deployed.Run(test, false, .5, {{"distillation_token", nn::zeros({1, 1, 8})}});
    Save(root / "zero_dist_token.npz", ablated);
    check::Require(
        replay::MaxAbsDiff(out.at("logits"), ablated.at("logits")) > 1e-6,
        "trained DIST token affects logits");
    check::Near(
        replay::MaxAbsDiff(
            out.at("logits"), (out.at("class_logits") + out.at("distill_logits")) * .5),
        0,
        0,
        "inference mean of classifier logits");
  }
  for (int row = 0; row < 3; ++row)
    check::Near(
        replay::MaxAbsDiff(
            deployed.Predict(replay::Rows(test, {row})),
            nn::slice(out.at("logits"), {row, 0}, {1, 10})),
        0,
        3e-6,
        "teacher/student batch isolation");
  check::Require(
      replay::SameBits(before, deployed.Arrays()), "teacher/student inference immutable");
  const auto z       = out.at("logits").to_vector<float>();
  const auto labels  = test.at("labels").to_vector<int>();
  int        correct = 0;
  for (int i = 0; i < 32; ++i) {
    int best = 0;
    for (int c = 1; c < 10; ++c)
      if (z[i * 10 + c] > z[i * 10 + best])
        best = c;
    correct += best == labels[i];
  }
  std::ofstream meta(root / "metrics.json");
  meta.precision(17);
  meta << "{\"teacher\":" << (model.teacher ? "true" : "false")
       << ",\"parameters\":" << model.parameters.count()
       << ",\"variables\":" << model.parameters.size() << ",\"epochs\":" << epochs
       << ",\"updates\":" << updates << ",\"test_loss\":" << out.at("loss").item()
       << ",\"test_accuracy\":" << correct / 32. << "}\n";
  std::cout << (model.teacher ? "teacher" : "student") << " testLoss=" << out.at("loss").item()
            << " accuracy=" << correct
            << "/32;restore/teacherFreeze/labelFree/dualHeads/immutable PASS\n";
}
void Run(int epochs) {
  const auto root = paths::OutputDir("models/deit");
  replay::CopyAssets(paths::Dataset("vision_transformer"), root, {"data.npz", "manifest.json"});
  auto  data = replay::ToMap(nn::load_npz((root / "data.npz").string()));
  Model teacher(true);
  check::Require(
      teacher.parameters.count() == 498 && teacher.parameters.size() == 6,
      "actual 498-parameter CNN teacher");
  Train(teacher, nullptr, data, epochs, root / "teacher");
  Model frozen(true, false);
  frozen.parameters.load((root / "teacher/final.npz").string());
  check::Require(
      replay::SameBits(teacher.Arrays(), frozen.Arrays()), "frozen teacher exact transfer");
  const auto before = frozen.Arrays();
  Model      student(false);
  check::Require(
      student.parameters.count() == 3100 && student.parameters.size() == 35,
      "3100 parameters/35 dual-token tensors");
  Train(student, &frozen, data, epochs, root / "student");
  check::Require(
      replay::SameBits(before, frozen.Arrays()),
      "entire student training leaves frozen teacher unchanged");
  Save(root / "frozen_teacher_after.npz", frozen.Arrays());
}
} // namespace
int main(int argc, char** argv) {
  try {
    nn::set_num_threads(2);
    int epochs = 3;
    for (int i = 1; i < argc; ++i) {
      std::string a = argv[i];
      check::Require(a.rfind("epochs=", 0) == 0, "epochs=N");
      epochs = std::stoi(a.substr(7));
    }
    check::Require(epochs > 0 && epochs <= 100, "epochs1..100");
    Run(epochs);
    return 0;
  } catch (const std::exception& e) {
    std::cerr << e.what() << '\n';
    return 1;
  }
}

