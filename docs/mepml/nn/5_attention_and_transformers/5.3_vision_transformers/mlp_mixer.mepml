> Actual held-out confusion

Rows are true classes and columns are saved-model predictions. Counts use actual held-out outputs from the reconstructed recipe. Class labels retain the original source ontology.

```{cpp, results="markdown", file="figures/mlp_mixer_confusion.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -lpthread -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main(){namespace n=dm::nn;auto load=[](const std::string&path){auto a=n::load_npz(path);return std::map<std::string,n::Tensor>(a.begin(),a.end());};auto data=load("build/nn-completion/models/mlp_mixer/data.npz"),out=load("build/nn-completion/models/mlp_mixer/outputs.npz");auto logits=out.at("logits");auto prediction=n::argmax(logits,-1).to_vector<int>(),truth=data.at("test_labels").to_vector<int>();if(prediction.size()!=truth.size())throw std::runtime_error("held-out class geometry differs");std::vector<float>valid(truth.size(),1);n::ConfusionMatrix counts(10);size_t total=0;for(size_t i=0;i<truth.size();++i)if(valid[i]>0){counts.add(truth[i],prediction[i]);++total;}if(!total)throw std::runtime_error("held-out predictions missing");std::print("Counted {} actual held-out decisions.\n",total);n::ConfusionMatrixPlotOptions options;options.title="mlp mixer  held-out counts";options.labels={"airplane","automobile","bird","cat","deer","dog","frog","horse","ship","truck"};counts.save_svg("build/mlp_mixer_confusion.svg",options);}
