> Distinct Values: weights

Rows are queries0..3 of head0, then queries0..3 of head1; columns are keys0..4. Cells show the actual saved values. Empty and singleton rows remain visible. Removal effects are output-vector norms, not attention probabilities.

```{cpp, results="markdown", file="figures/attention_visualization_distinct_values_weights.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -lpthread -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main(){auto archive=dm::nn::load_npz("build/foundational-models/attention_visualization/distinct_values.npz");auto it=std::find_if(archive.begin(),archive.end(),[](const auto& p){return p.first=="weights";});if(it==archive.end())return 1;auto values=it->second.to_vector<double>();dm::graphics::Diagram d(35,1100);dm::graphics::DiagramNodeStyle style;style.width=2.5;style.height=1.3;style.font_size=19;for(int h=0;h<2;++h)for(int t=0;t<4;++t)for(int k=0;k<5;++k){double v=values[(h*4+t)*5+k];d.node(std::to_string((h*4+t)*5+k),{double(k)*4,double(-(h*5+t))*2.3},std::format("{:.3f}",v),style);}d.save_svg("build/attention_visualization_distinct_values_weights.svg");}
