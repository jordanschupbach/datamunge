// Controlled static/dynamic masking and batch-size changes for RoBERTa-style
// MLM.
//
// CMD: just run-nn roberta_tweaks
// Eager port preserving the four controlled comparisons and all source checks.
#include <fstream>

// Editable workflow support: compact_bert.hpp
// Editable workflow support: bert_mlm.hpp
// Editable workflow support: attention.hpp
// Attention helpers for the 5.x example ports (port of the parts of tflow's
// common/nn/attention.h that datamunge/nn/attention.hpp does not already
// provide), plus the small harness the 5.1 attention-fundamentals examples
// share: tflow's random input streams, float32 central differences and the
// comparison against the .npz fixtures the TF examples write.
//
// tflow -> datamunge:
//   nn::ScaledDotProductAttention(s, q, k, v, d, mask, allowed)
//       -> nn::scaled_dot_product_attention(q, k, v, mask) (scale 1/sqrt(q.size(-1)),
//          weights returned; `mask` is either an additive float bias or a bool keep mask)
//   nn::MultiHeadAttention(s, p, name, xq, xkv, d_model, heads, mask, allowed)
//       -> nn::multi_head_attention(store, name, xq, xkv, heads, options)
//   nn::AttentionAllowed(s, key_lengths, query_lengths, queries, keys, causal, offset)
//       -> attn::AttentionAllowed below (the library's causal_keep_mask is aligned
//          bottom-right instead of taking an explicit query offset, and its
//          padding_keep_mask masks keys only).

#include <datamunge/nn/attention.hpp>
#include <datamunge/nn/io.hpp>
#include <datamunge/nn/nn.hpp>

#include <algorithm>
#include <cmath>
#include <cstdio>
#include <cstdlib>
#include <filesystem>
#include <functional>
#include <random>
#include <stdexcept>
#include <string>
#include <vector>

namespace attn {

namespace nn = datamunge::nn;

/// tflow's AttentionAllowed: bool [N, queries, keys], true where query t is
/// valid (t < query_lengths[n]), key j is valid (j < key_lengths[n]) and, when
/// `causal`, j <= t + query_offset (queries sit after `query_offset` cached
/// keys during incremental decoding). Lengths are integer tensors [N]. Add a
/// head axis (expand_dims(.., 1)) for [N, heads, Tq, Tk] scores.
inline nn::Tensor AttentionAllowed(const nn::Tensor& key_lengths, const nn::Tensor& query_lengths, std::int64_t queries,
                                   std::int64_t keys, bool causal = false, std::int64_t query_offset = 0) {
  if (queries < 1 || keys < 1 || query_offset < 0)
    throw std::invalid_argument("positive attention lengths and nonnegative query offset required");
  if (key_lengths.dim() != 1 || query_lengths.dim() != 1 || key_lengths.size(0) != query_lengths.size(0))
    throw std::invalid_argument("AttentionAllowed: key and query lengths must be vectors of the batch size");
  const std::int64_t batch = key_lengths.size(0);
  nn::Tensor         out   = nn::zeros({batch, queries, keys}, nn::DType::Bool);
  bool*              p     = out.data_ptr<bool>();
  for (std::int64_t b = 0; b < batch; ++b) {
    const double kl = key_lengths.at({b}), ql = query_lengths.at({b});
    for (std::int64_t t = 0; t < queries; ++t)
      for (std::int64_t j = 0; j < keys; ++j)
        p[(b * queries + t) * keys + j] = t < ql && j < kl && (!causal || j <= t + query_offset);
  }
  return out;
}

/// tflow's ScaledDotProductAttention(q, k, v, d, mask): scores scaled by
/// 1/sqrt(d), plain (weight-materialising) path, weights returned. `mask` is an
/// additive float bias or a bool keep mask (tflow's `allowed`); rows with no
/// allowed key give zero weights and output.
inline nn::Attended ScaledDotProductAttention(const nn::Tensor& q, const nn::Tensor& k, const nn::Tensor& v,
                                              std::int64_t d, const nn::Tensor& mask = nn::Tensor()) {
  if (d < 1) throw std::invalid_argument("attention key width must be positive");
  nn::AttentionOptions o;
  o.mask         = mask;
  o.scale        = 1.0 / std::sqrt(static_cast<double>(d));
  o.need_weights = true;
  o.impl         = nn::AttentionImpl::Plain;
  return nn::scaled_dot_product_attention(q, k, v, o);
}

/// tflow's MultiHeadAttention(p, name, x_q, x_kv, d_model, heads, mask,
/// allowed): bias-free projections "<name>/Wq|Wk|Wv|Wo" [d_model, d_model]
/// (U(+-sqrt(3/d_model))), weights [N, heads, Tq, Tk] returned. `mask`: keep or
/// additive, broadcastable to [N, heads, Tq, Tk]. d_model is explicit, as in tflow,
/// and checked against the input width.
inline nn::Attended MultiHeadAttention(nn::ParameterStore& store, const std::string& name, const nn::Tensor& x_q,
                                       const nn::Tensor& x_kv, std::int64_t d_model, std::int64_t heads,
                                       const nn::Tensor& mask = nn::Tensor()) {
  if (d_model < 1 || heads < 1 || d_model % heads != 0)
    throw std::invalid_argument("positive model/head counts and divisible head width required");
  if (x_q.dim() != 3 || x_q.size(2) != d_model || x_kv.dim() != 3 || x_kv.size(2) != d_model)
    throw std::invalid_argument("multi-head inputs must be [N, T, d_model]");
  nn::MultiHeadOptions o;
  o.mask         = mask;
  o.need_weights = true;
  o.impl         = nn::AttentionImpl::Plain;
  return nn::multi_head_attention(store, name, x_q, x_kv, heads, o);
}

/// Initializer that returns a fixed array (replays weights saved by TF).
inline nn::Initializer FixedInit(const nn::Tensor& value) {
  return [value](const nn::Shape& shape, nn::DType, nn::Generator&) {
    if (shape != value.shape()) throw std::invalid_argument("saved weight has the wrong shape");
    return value.clone();
  };
}

/// Integer vector tensor.
inline nn::Tensor Ints(const std::vector<int>& values) {
  return nn::from_vector(values, {static_cast<std::int64_t>(values.size())});
}

/// tflow's `random` lambdas: float32 tensors filled with scale * N(0, 1) drawn
/// from one std::mt19937 and ONE std::normal_distribution<float> (it caches
/// the second value of each pair, so a fresh distribution per tensor would
/// diverge after an odd-sized tensor). With the same seed and the same
/// standard library (both builds use libc++ here) the values equal TF's.
struct TfRandom {
  explicit TfRandom(unsigned seed) : rng(seed) {}
  nn::Tensor operator()(const nn::Shape& shape, float scale = 1.f) {
    nn::Tensor t = nn::empty(shape);
    float*     p = t.data_ptr<float>();
    for (std::int64_t i = 0; i < t.numel(); ++i) p[i] = scale * normal(rng);
    return t;
  }
  std::mt19937                    rng;
  std::normal_distribution<float> normal{0, 1};
};

/// Max |a - b| (inf on a shape mismatch).
inline double MaxAbsDiff(const nn::Tensor& a, const nn::Tensor& b) {
  if (a.shape() != b.shape()) return INFINITY;
  const auto x = nn::cast(a, nn::DType::Float64).to_vector<double>();
  const auto y = nn::cast(b, nn::DType::Float64).to_vector<double>();
  double     m = 0;
  for (std::size_t i = 0; i < x.size(); ++i) m = std::max(m, std::abs(x[i] - y[i]));
  return m;
}

/// tflow's native finite-difference probe: for `samples` coordinates spread
/// evenly over `value` (i * (numel - 1) / (samples - 1)), compares the float32
/// central difference (f(x + h) - f(x - h)) / 2h, h = 0.002, with the analytic
/// gradient. `value` is modified in place and restored. Returns the max error.
inline double CentralDifferenceError(nn::Tensor& value, const nn::Tensor& gradient, int samples,
                                     const std::function<float()>& objective, int* count = nullptr) {
  float*     p = value.data_ptr<float>();
  const auto g = gradient.to_vector<float>();
  double     error = 0;
  for (int i = 0; i < samples; ++i) {
    const std::int64_t c   = samples == 1 ? 0 : i * (value.numel() - 1) / (samples - 1);
    const float        old = p[c];
    p[c]                   = old + .002f;
    const float plus       = objective();
    p[c]                   = old - .002f;
    const float minus      = objective();
    p[c]                   = old;
    error                  = std::max(error, std::abs((plus - minus) / .004 - g[c]));
    if (count) ++*count;
  }
  return error;
}

/// Reads one array of an .npz archive (throws when missing).
inline nn::Tensor Named(const nn::NamedTensors& arrays, const std::string& name) {
  for (const auto& [key, value] : arrays)
    if (key == name) return value;
  throw std::runtime_error("npz has no array '" + name + "'");
}

inline bool Has(const nn::NamedTensors& arrays, const std::string& name) {
  for (const auto& [key, value] : arrays)
    if (key == name) return true;
  return false;
}

/// Default location of the TF example's fixtures: tflow's output/models/<name>.
inline std::filesystem::path DefaultTfDir(const std::string& name) {
  const char* home = std::getenv("HOME");
  return std::filesystem::path(home ? home : ".") / "projects" / "tflow_examples" / "output" / "models" / name;
}

/// Compares every array of `ours` that TF also saved (same key) with TF's
/// .npz `tf_file`. Returns the largest difference over the arrays whose names
/// pass `include` (all by default), or -1 when the file is missing. Prints one
/// line per compared array when `verbose`.
inline double CompareWithTf(const std::filesystem::path& tf_file, const nn::NamedTensors& ours, bool verbose = false,
                            const std::function<bool(const std::string&)>& include = {}) {
  if (!std::filesystem::exists(tf_file)) return -1;
  const auto ref   = nn::load_npz(tf_file.string());
  double     worst = 0;
  for (const auto& [name, value] : ours) {
    if (!Has(ref, name) || (include && !include(name))) continue;
    const double d = MaxAbsDiff(value, Named(ref, name));
    if (verbose) std::printf("    %-22s max |ours - TF| = %.2e\n", name.c_str(), d);
    worst = std::max(worst, d);
  }
  return worst;
}

/// Compares `ours` with TF's fixture `file` under `tf_dir`. When the arrays
/// listed in `inputs` are bit-identical to TF's (same random streams), every
/// other shared array except the finite-difference metadata ("metadata",
/// "native_fd") must agree within `tolerance` (a failed check throws). Returns
/// the max difference, or -1 when the fixture is missing or the inputs differ.
inline double CheckAgainstTf(const std::filesystem::path& tf_dir, const std::string& file, const nn::NamedTensors& ours,
                             const std::vector<std::string>& inputs, double tolerance, bool verbose = false) {
  const auto path = tf_dir / file;
  if (!std::filesystem::exists(path)) {
    std::printf("  (TF fixture %s not found: TF comparison skipped)\n", path.string().c_str());
    return -1;
  }
  auto is_input = [&](const std::string& n) { return std::find(inputs.begin(), inputs.end(), n) != inputs.end(); };
  const double din = CompareWithTf(path, ours, false, is_input);
  if (din != 0) {
    std::printf("  (inputs differ from TF's %s by %.2e: different random stream, outputs not compared)\n",
                file.c_str(), din);
    return -1;
  }
  const double d = CompareWithTf(path, ours, verbose, [&](const std::string& n) {
    return !is_input(n) && n != "metadata" && n != "native_fd";
  });
  std::printf("  vs TF %s (identical inputs): max |ours - TF| = %.2e over all outputs and gradients\n", file.c_str(), d);
  if (!(d <= tolerance))
    throw std::runtime_error(file + ": outputs differ from TF's by " + std::to_string(d) + " > " +
                             std::to_string(tolerance));
  return d;
}

/// key=value options shared by the 5.1 examples: out=DIR (default
/// output/nn/<name>), tf=DIR (TF fixtures, default tflow's output/models/<name>),
/// init=auto|tf|nn for examples with learned weights (auto: TF's saved
/// weights when present), verbose=0|1 (per-array TF comparison).
struct Options {
  std::filesystem::path out, tf;
  std::string           init{"auto"};
  bool                  verbose{false};
};

inline Options ParseOptions(int argc, char** argv, const std::string& name,
                            const std::filesystem::path& out_default) {
  Options o;
  o.out = out_default;
  o.tf  = DefaultTfDir(name);
  for (int i = 1; i < argc; ++i) {
    const std::string a = argv[i];
    const auto        e = a.find('=');
    if (e == std::string::npos) throw std::invalid_argument("expected key=value option, got " + a);
    const std::string key = a.substr(0, e), value = a.substr(e + 1);
    if (key == "out") o.out = value;
    else if (key == "tf") o.tf = value;
    else if (key == "init") o.init = value;
    else if (key == "verbose") o.verbose = value != "0";
    else throw std::invalid_argument("unknown option " + key + " (out=, tf=, init=, verbose=)");
  }
  if (o.init != "auto" && o.init != "tf" && o.init != "nn") throw std::invalid_argument("init must be auto, tf or nn");
  std::filesystem::create_directories(o.out);
  return o;
}

}  // namespace attn

// Editable workflow support: checks.hpp
// Small runtime checks used by the executable nn examples. They stay on in
// Release builds and make the example exit nonzero on failure, so `just
// run-all-nn` doubles as a regression test against the recorded TF numbers.

#include <cmath>
#include <iostream>
#include <stdexcept>
#include <string>
// Editable workflow support: runtime.hpp
// Bounded demonstrations by default; opt into convergence experiments explicitly.

#include <algorithm>
#include <cstdlib>
#include <iostream>
#include <string>

namespace example_runtime {

inline bool Full() {
  const char* value = std::getenv("DATAMUNGE_EXAMPLES_FULL");
  return value && std::string(value) == "1";
}

template <typename T> T Limit(T requested, T quick_limit) {
  return Full() ? requested : std::min(requested, quick_limit);
}

inline void Describe() {
  if (!Full())
    std::cout << "Quick demonstration: bounded training; convergence metrics require "
                 "DATAMUNGE_EXAMPLES_FULL=1.\n";
}

}  // namespace example_runtime

namespace check {

inline void Require(bool condition, const std::string& message) {
  if (!condition) throw std::runtime_error(message);
}

// A short demonstration checks execution, derivatives and persistence; reaching
// a published accuracy/return requires the separately requested full schedule.
inline void TrainingQuality(bool condition, const std::string& message) {
  if (example_runtime::Full()) Require(condition, message);
  else std::cout << "  full-training quality check deferred: " << message << '\n';
}

inline void Near(double actual, double expected, double tolerance, const std::string& message) {
  if (!std::isfinite(actual) || !std::isfinite(expected) || std::abs(actual - expected) > tolerance)
    throw std::runtime_error(message + ": got " + std::to_string(actual) + ", expected " + std::to_string(expected));
}

/// Expects `f` to throw; returns the message.
template <typename F>
std::string Throws(F&& f, const std::string& message) {
  try {
    f();
  } catch (const std::exception& e) {
    return e.what();
  }
  throw std::runtime_error(message + ": expected an exception");
}

}  // namespace check

inline void Header(const std::string& title) {
  const std::size_t pad = title.size() < 60 ? 60 - title.size() : 0;
  std::cout << "\n== " << title << " " << std::string(pad, '=') << "\n";
}

namespace bert {using namespace dm::nn::models::bert;

inline Batch Rows(const Batch& b, const std::vector<std::int64_t>& rows) {
  Batch out;
  for (const auto& [k, v] : b) out[k] = nn::take_rows(v, rows);
  return out;
}
class BertMlmModel {
 public:
  nn::ParameterStore             store{46403};
  std::unique_ptr<nn::Optimizer> optimizer;

  explicit BertMlmModel(bool training = true) {
    {
      nn::NoGradGuard guard;
      const Batch     b{{"input", nn::zeros({1, 32}, nn::DType::Int32)},
                        {"segments", nn::zeros({1, 32}, nn::DType::Int32)},
                        {"lengths", nn::full({1}, 32, nn::DType::Int32)}};
      BertMlm(store, Encoded(b), b.at("segments"), b.at("lengths"));
    }
    if (training) Train();
  }
  void Train() {
    nn::OptimizerConfig c;
    c.kind    = nn::OptimizerKind::Adam;
    optimizer = std::make_unique<nn::Optimizer>(store, .003, c);
  }

  static Tensor Encoded(const Batch& b) { return nn::one_hot(b.at("input"), 70); }

  Tensor Loss(const MlmPath& p, const Batch& b) const {
    const Tensor ce       = nn::neg(nn::sum(nn::mul(nn::log_softmax(p.logits, -1), nn::one_hot(b.at("target"), 70)), {2}));
    const Tensor selected = b.at("selected");
    return nn::div(nn::sum(nn::mul(ce, selected)), nn::maximum(nn::sum(selected), nn::scalar_like(1.0, selected)));
  }

  /// Forward fields, loss and d loss / d one-hot input.
  Batch Evaluate(const Batch& b) {
    Tensor encoded = Encoded(b);
    encoded.requires_grad_(true);
    const auto   p    = BertMlm(store, encoded, b.at("segments"), b.at("lengths"));
    const Tensor loss = Loss(p, b);
    const Tensor g    = nn::grad(loss, {encoded})[0];
    return {{"logits", p.logits.detach()},   {"hidden", p.hidden.detach()},
            {"attention", p.attention.detach()}, {"embedded", p.embedded.detach()},
            {"transformed", p.transformed.detach()}, {"loss", loss.detach()},
            {"input_gradient", g.detach()}};
  }

  float LossValue(const Batch& b) {
    nn::NoGradGuard guard;
    return Loss(BertMlm(store, Encoded(b), b.at("segments"), b.at("lengths")), b).item<float>();
  }

  /// Input-only mask predictions (no target/selected needed).
  Tensor Predict(const Batch& b) {
    nn::NoGradGuard guard;
    return BertMlm(store, Encoded(b), b.at("segments"), b.at("lengths")).logits;
  }

  std::vector<Tensor> RawGradients(const Batch& b) {
    const auto      p = BertMlm(store, Encoded(b), b.at("segments"), b.at("lengths"));
    nn::GradOptions go;
    go.allow_unused = true;
    auto       g    = nn::grad(Loss(p, b), store.parameters(), go);
    const auto ps   = store.parameters();
    for (std::size_t i = 0; i < g.size(); ++i) g[i] = g[i].defined() ? g[i].detach() : nn::zeros_like(ps[i]);
    return g;
  }

  /// Parameters (or, with `b`, their loss gradients on that batch), by name.
  nn::NamedTensors Arrays(const Batch* b = nullptr) {
    nn::NamedTensors out;
    if (b) {
      const auto g = RawGradients(*b);
      for (std::size_t i = 0; i < g.size(); ++i) out.emplace_back(store.names()[i], g[i]);
    } else {
      for (const auto& name : store.names()) out.emplace_back(name, store.at(name).detach().clone());
    }
    return out;
  }

  void Update(const Batch& b) { optimizer->step(RawGradients(b)); }
};

}  // namespace bert

// Editable workflow support: tf_replay.hpp
// Small helpers the 4.2 sequence-task ports share for working with tflow's
// recorded runs: named-array maps (tflow's `std::map<std::string, tf::Tensor>`
// batches), row selection, exact/approximate comparisons, loading TF's
// initial_arrays.npz into a ParameterStore and reading history.tsv columns.
//
// A tflow run directory (tflow's output/models/<name>) holds initial_arrays.npz,
// first_batch.npz, initial_gradients.npz, history.tsv and model_arrays.npz.
// Replaying the run from TF's own initial weights with the same batch order
// (nn::BatchOrder reproduces tflow's) and the same optimizer checks the port
// numerically, independently of the random initialisation.

#include <cstring>
#include <filesystem>
#include <fstream>
#include <map>
#include <sstream>
#include <stdexcept>
#include <string>
#include <vector>

#include <datamunge/nn/nn.hpp>


// Editable workflow support: paths.hpp
// Where the nn example ports read datasets and write their outputs.
//
// Datasets: $DATAMUNGE_DATA_DIR, or the user's cache. Public datasets are
// prepared by the example data loaders when first needed.
// Outputs (checkpoints, histories, fixtures): $DATAMUNGE_OUTPUT_DIR, or
// output/nn relative to the working directory (`just run-nn` runs from the
// repository root). Both are created on demand by the caller.

#include <cstdlib>
#include <filesystem>
#include <string>

// Editable workflow support: dataset_assets.hpp
#include <datamunge/datasets/assets.hpp>
namespace dataset_assets{inline std::string DataRoot(){return dm::datasets::data_home();}}

namespace dataset_assets {inline void EnsureSaliency(const std::string& directory){dm::datasets::prepare_example_data("mnist-assets",std::filesystem::path(directory).parent_path().string());}}

namespace dataset_assets {
inline dm::nn::ImageDataset LoadCifar10(const std::string&directory,const std::string&split){dm::datasets::fetch("cifar10",std::filesystem::path(directory).parent_path().string());return dm::nn::load_cifar10(directory,split);}
}

namespace paths {

inline std::filesystem::path DataRoot() {
  return dataset_assets::DataRoot();
}

/// DataRoot() / name, e.g. Dataset("mnist").
inline std::filesystem::path Dataset(const std::string& name) { if(name=="cifar10"||name=="character_rnn")return DataRoot()/name;return std::filesystem::path(dm::datasets::prepare_example_data("nn-completion-assets"))/name; }

inline std::filesystem::path OutputRoot(){return std::filesystem::absolute("build/nn-completion");}

/// OutputRoot() / relative, created as a directory.
inline std::filesystem::path OutputDir(const std::string& relative) {
  auto dir = OutputRoot() / relative;
  std::filesystem::create_directories(dir);
  return dir;
}

}  // namespace paths

namespace replay {

namespace nn = datamunge::nn;
using nn::Tensor;
using Map = std::map<std::string, Tensor>;

/// tflow's recorded output directory for an example (its output/models/<name>).
inline std::filesystem::path TfModels(const std::string& name) {
  return paths::DataRoot().parent_path() / "models" / name;
}

inline Tensor Get(const nn::NamedTensors& arrays, const std::string& key) {
  for (const auto& [name, t] : arrays)
    if (name == key) return t;
  throw std::runtime_error("missing array " + key);
}

inline Map ToMap(const nn::NamedTensors& arrays) { return {arrays.begin(), arrays.end()}; }
inline nn::NamedTensors ToNamed(const Map& m) { return {m.begin(), m.end()}; }

/// Rows `rows` (axis 0) of every array.
inline Map Rows(const Map& m, const std::vector<std::int64_t>& rows) {
  Map out;
  for (const auto& [k, v] : m) out[k] = nn::take_rows(v, rows);
  return out;
}

/// {key: arrays["<split>_<key>"]} for each key.
inline Map Split(const nn::NamedTensors& arrays, const std::string& split, const std::vector<std::string>& keys) {
  Map out;
  for (const auto& k : keys) out[k] = Get(arrays, split + "_" + k);
  return out;
}

inline double MaxAbsDiff(const Tensor& a, const Tensor& b) {
  const auto x = a.to_vector<double>(), y = b.to_vector<double>();
  check::Require(x.size() == y.size(), "compared tensors have the same size");
  double m = 0;
  for (std::size_t i = 0; i < x.size(); ++i) m = std::max(m, std::abs(x[i] - y[i]));
  return m;
}

/// Bit-identical values (dtype and shape included).
inline bool SameBits(const Tensor& a, const Tensor& b) {
  if (a.dtype() != b.dtype() || a.shape() != b.shape()) return false;
  auto same = [](const auto& x, const auto& y) {
    return x.size() == y.size() && (x.empty() || std::memcmp(x.data(), y.data(), x.size() * sizeof(x[0])) == 0);
  };
  switch (a.dtype()) {
    case nn::DType::Float32: return same(a.to_vector<float>(), b.to_vector<float>());
    case nn::DType::Float64: return same(a.to_vector<double>(), b.to_vector<double>());
    case nn::DType::Int32: return same(a.to_vector<std::int32_t>(), b.to_vector<std::int32_t>());
    default: return same(a.to_vector<std::int64_t>(), b.to_vector<std::int64_t>());
  }
}

inline bool SameBits(const Map& a, const Map& b) {
  if (a.size() != b.size()) return false;
  for (const auto& [k, v] : a)
    if (!b.count(k) || !SameBits(v, b.at(k))) return false;
  return true;
}

/// Copies of every parameter, by name.
inline Map Arrays(const nn::ParameterStore& p) {
  Map out;
  for (const auto& name : p.names()) out[name] = p.at(name).detach().clone();
  return out;
}

/// Gradients aligned with p.names(), by name.
inline Map Named(const nn::ParameterStore& p, const std::vector<Tensor>& g) {
  Map out;
  for (std::size_t i = 0; i < g.size(); ++i) out[p.names()[i]] = g[i].defined() ? g[i].detach() : nn::zeros_like(p.parameters()[i]).detach();
  return out;
}

/// Overwrites every parameter of `p` from an .npz (e.g. TF's initial_arrays.npz),
/// which must hold exactly p's names.
inline void LoadInto(nn::ParameterStore& p, const std::filesystem::path& file) {
  const auto arrays = nn::load_npz(file.string());
  check::Require(arrays.size() == p.size(), "array file covers exactly the model's parameters: " + file.string());
  for (const auto& [name, value] : arrays) {
    check::Require(p.contains(name), "array " + name + " is a model parameter");
    p.set(name, nn::cast(value, p.at(name).dtype()));
  }
}

/// max |a[k] - b[k]| over the keys of `a` (all must exist in `b`).
inline double MaxDiff(const Map& a, const Map& b) {
  double m = 0;
  for (const auto& [k, v] : a) {
    check::Require(b.count(k) > 0, "reference has array " + k);
    m = std::max(m, MaxAbsDiff(v, b.at(k)));
  }
  return m;
}
inline double MaxDiff(const Map& a, const std::filesystem::path& file) { return MaxDiff(a, ToMap(nn::load_npz(file.string()))); }

/// Column `column` (0-based) of a tab-separated history file with a header line.
inline std::vector<double> History(const std::filesystem::path& file, int column = 1) {
  std::ifstream       in(file);
  std::string         line;
  std::vector<double> out;
  std::getline(in, line);
  while (std::getline(in, line)) {
    std::stringstream ss(line);
    std::string       cell;
    for (int c = 0; c <= column && std::getline(ss, cell, '\t'); ++c)
      if (c == column) out.push_back(std::stod(cell));
  }
  return out;
}

inline nn::OptimizerConfig Adam() {
  nn::OptimizerConfig c;
  c.kind = nn::OptimizerKind::Adam;
  return c;
}

/// Copies `files` from `from` to `to` when present.
inline void CopyAssets(const std::filesystem::path& from, const std::filesystem::path& to,
                       const std::vector<std::string>& files) {
  for (const auto& f : files)
    if (std::filesystem::exists(from / f))
      std::filesystem::copy_file(from / f, to / f, std::filesystem::copy_options::overwrite_existing);
}

}  // namespace replay

namespace compact_bert {using namespace dm::nn::models::compact_bert;

class Model {
 public:
  Config                         config;
  bool                           distilled;
  nn::ParameterStore             parameters{46603};
  std::unique_ptr<nn::Optimizer> optimizer;
  explicit Model(Config c = {}, bool distill = false, bool training = true)
      : config(c), distilled(distill) {
    {
      nn::NoGradGuard guard;
      Forward(
          parameters,
          nn::zeros({1, 32, 70}),
          nn::zeros({1, 32}, nn::DType::Int32),
          nn::full({1}, 32, nn::DType::Int32),
          config);
    }
    if (training) {
      nn::OptimizerConfig opt;
      opt.kind  = nn::OptimizerKind::Adam;
      optimizer = std::make_unique<nn::Optimizer>(parameters, .003, opt);
    }
  }
  A Losses(const Path& path, const A& b) const {
    auto mean = [&](const Tensor& values, const Tensor& weights) {
      return nn::sum(values * weights) / nn::maximum(nn::sum(weights), nn::scalar(1));
    };
    auto target = nn::one_hot(b.at("target"), 70);
    auto mlm    = mean(-nn::sum(nn::log_softmax(path.logits, -1) * target, {2}), b.at("selected"));
    auto kd = nn::scalar(0), cos = nn::scalar(0);
    if (distilled) {
      auto valid = nn::squeeze(bert::LengthMask(b.at("lengths"), 32), {2});
      auto tlp   = nn::log_softmax(b.at("teacher_logits").detach() / 2., -1),
           slp   = nn::log_softmax(path.logits / 2., -1);
      kd         = mean(nn::sum(nn::exp(tlp) * (tlp - slp), {2}), valid) * 4.;
      auto th    = b.at("teacher_hidden").detach();
      auto dot   = nn::sum(th * path.hidden, {2});
      auto tn    = nn::sqrt(nn::maximum(nn::sum(nn::square(th), {2}), nn::scalar(1e-12))),
           sn    = nn::sqrt(nn::maximum(nn::sum(nn::square(path.hidden), {2}), nn::scalar(1e-12)));
      cos        = mean(1. - dot / (tn * sn), valid);
    }
    return {{"mlm_loss", mlm}, {"kd_loss", kd}, {"cos_loss", cos}, {"loss", mlm + kd + cos}};
  }
  A Run(const A& b, bool gradients = false, const A& overrides = {}) {
    A saved;
    for (const auto& [k, v] : overrides) {
      saved[k] = parameters.at(k).detach().clone();
      parameters.set(k, v);
    }
    struct Restore {
      nn::ParameterStore& p;
      A&                  saved;
      ~Restore() {
        for (const auto& [k, v] : saved)
          p.set(k, v);
      }
    } restore{parameters, saved};
    auto encoded = nn::one_hot(b.at("input"), 70).requires_grad_();
    auto path    = Forward(parameters, encoded, b.at("segments"), b.at("lengths"), config);
    auto out     = Losses(path, b);
    std::vector<Tensor> inputs{encoded};
    if (gradients) {
      auto p = parameters.parameters();
      inputs.insert(inputs.end(), p.begin(), p.end());
    }
    auto g                = nn::grad(out.at("loss"), inputs);
    out["logits"]         = path.logits;
    out["hidden"]         = path.hidden;
    out["input_gradient"] = g[0];
    for (size_t i = 0; i < path.states.size(); ++i)
      out["state" + std::to_string(i)] = path.states[i];
    for (size_t i = 0; i < path.attention.size(); ++i)
      out["attention" + std::to_string(i)] = path.attention[i];
    if (gradients)
      for (size_t i = 0; i < parameters.size(); ++i)
        out[parameters.names()[i]] = g[i + 1];
    for (auto& [k, v] : out)
      v = v.detach().clone();
    return out;
  }
  Tensor Predict(const A& b) {
    nn::NoGradGuard guard;
    return Forward(
               parameters,
               nn::one_hot(b.at("input"), 70),
               b.at("segments"),
               b.at("lengths"),
               config)
        .logits;
  }
  void Update(const A& b) {
    auto path = Forward(
        parameters, nn::one_hot(b.at("input"), 70), b.at("segments"), b.at("lengths"), config);
    optimizer->minimize(Losses(path, b).at("loss"));
  }
  A    Arrays() const { return replay::Arrays(parameters); }
  void Import(const A& a) {
    for (const auto& name : parameters.names()) {
      check::Require(
          parameters.at(name).shape() == a.at(name).shape(), "exact compact initialization shape");
      parameters.set(name, a.at(name));
    }
  }
};
} // namespace compact_bert

namespace nn = datamunge::nn;
namespace {
using A     = compact_bert::A;
using Model = compact_bert::Model;
void Save(const std::filesystem::path& file, const A& a) {
  nn::save_npz(file.string(), replay::ToNamed(a));
}
A Pool(const A& a, const std::string& split, int epoch = 1) {
  A b;
  for (auto k : {"target", "segments", "lengths", "source_start"})
    b[k] = a.at(split + "_" + k);
  for (auto k : {"input", "selected", "actions"})
    b[k] = a.at((split == "fit" ? "epoch" + std::to_string(epoch) : split) + "_" + k);
  return b;
}
void Run(const std::string& name, bool dynamic, int batch, int epochs, const A& data) {
  compact_bert::Config config{8, 2, false, false};
  std::vector<A>       pools{Pool(data, "fit"), Pool(data, "validation"), Pool(data, "test")};
  auto                 root = paths::OutputDir("models/roberta_tweaks/" + name),
       tf                   = replay::TfModels("roberta_tweaks") / name;
  replay::CopyAssets(
      paths::Dataset("bert_mlm"), root, {"data.npz", "manifest.json", "vocabulary.json"});
  bool  distill = false;
  Model model(config);
  int   expected = 2190;
  check::Require(model.parameters.size() == 41, "segment-free two-block MLM41 tensors");
  check::Require(
      model.parameters.count() == expected,
      "actual factorization/sharing/student compression count");
  bool parity = std::filesystem::exists(tf / "initial_arrays.npz");
  if (parity)
    replay::LoadInto(model.parameters, tf / "initial_arrays.npz");
  auto compare = [&](const A& out, const std::string& file) {
    if (parity && std::filesystem::exists(tf / file)) {
      double error = replay::MaxDiff(out, tf / file);
      std::cout << name << " TF " << file << " difference=" << error << std::endl;
      check::Near(error, 0, 2e-4, "compact TF " + file);
    }
  };
  Save(root / "initial_arrays.npz", model.Arrays());
  auto firstout = model.Run(pools[2]);
  Save(root / "initial_outputs.npz", firstout);
  compare(firstout, "initial_outputs.npz");
  if (distill)
    for (int i = 0; i < 3; ++i)
      Save(
          root / (std::string(
                      i == 0   ? "fit"
                      : i == 1 ? "validation"
                               : "test") +
                  "_teacher.npz"),
          {{"logits", pools[i].at("teacher_logits")}, {"hidden", pools[i].at("teacher_hidden")}});
  nn::BatchOrder order(128, batch, 46707);
  std::ofstream  history(root / "history.tsv"), batches(root / "batches.tsv");
  history << "epoch\tvalidation_mlm\tvalidation_kd\tvalidation_cosine\tvalidation_total\n";
  batches << "epoch\tstep\trow\n";
  int steps = 0;
  A   first;
  for (int e = 1; e <= epochs; ++e) {
    pools[0] = Pool(data, "fit", dynamic ? e : 1);
    Save(root / ("epoch" + std::to_string(e) + "_training.npz"), pools[0]);
    order.begin_epoch();
    for (;;) {
      auto rows = order.next();
      if (rows.empty())
        break;
      auto b = bert::Rows(pools[0], rows);
      if (steps % (128 / batch) == 0)
        Save(root / ("epoch" + std::to_string(e) + "_first_batch.npz"), b);
      if (!steps) {
        first = b;
        Save(root / "first_batch.npz", b);
        Save(root / "first_forward.npz", model.Run(b));
        auto out = model.Run(b, true);
        A    g;
        for (auto k : model.parameters.names())
          g[k] = out.at(k);
        Save(root / "initial_gradients.npz", g);
        compare(g, "initial_gradients.npz");
      }
      model.Update(b);
      if (!steps)
        Save(root / "first_after.npz", model.Arrays());
      for (auto r : rows)
        batches << e << '\t' << steps << '\t' << r << '\t' << (dynamic ? e : 1) << '\n';
      ++steps;
    }
    Save(root / ("epoch" + std::to_string(e) + "_arrays.npz"), model.Arrays());
    auto v = model.Run(pools[1]);
    history << e;
    for (auto k : {"mlm_loss", "kd_loss", "cos_loss", "loss"})
      history << '\t' << v.at(k).item();
    history << '\n';
    std::cout << name << " epoch=" << e << " validationMLM=" << v.at("mlm_loss").item()
              << " total=" << v.at("loss").item() << std::endl;
  }
  auto g = model.Run(first, true);
  A    gradients;
  for (auto key : model.parameters.names())
    gradients[key] = g.at(key);
  Save(root / "final_gradients.npz", gradients);
  compare(gradients, "final_gradients.npz");
  model.parameters.save((root / "final.npz").string());
  Model deployed(config, distill, false);
  deployed.parameters.load((root / "final.npz").string());
  auto final = deployed.Arrays();
  check::Require(replay::SameBits(model.Arrays(), final), "compact bitexact restore");
  auto out = deployed.Run(pools[2]);
  Save(root / "model_arrays.npz", final);
  Save(root / "outputs.npz", out);
  compare(out, "outputs.npz");
  auto b              = bert::Rows(pools[2], {0, 1});
  b["lengths"]        = nn::from_vector(std::vector<int>{24, 20}, {2});
  auto selected_short = b.at("selected").to_vector<float>();
  for (int n = 0; n < 2; ++n)
    for (int t = n == 0 ? 24 : 20; t < 32; ++t)
      selected_short[n * 32 + t] = 0;
  b["selected"] = nn::from_vector(selected_short, {2, 32});
  auto base = deployed.Run(b), padded = bert::Rows(b, {0, 1});
  auto lengths = padded.at("lengths").to_vector<int>();
  for (auto key : {"input", "segments"}) {
    auto x = padded.at(key).to_vector<int>();
    for (int n = 0; n < 2; ++n)
      for (int t = lengths[n]; t < 32; ++t)
        x[n * 32 + t] = std::string(key) == "input" ? 17 : 1;
    padded[key] = nn::from_vector(x, {2, 32});
  }
  if (distill)
    for (auto key : {"teacher_logits", "teacher_hidden"}) {
      auto t     = padded.at(key);
      auto x     = t.to_vector<float>();
      int  width = t.size(2);
      for (int n = 0; n < 2; ++n)
        for (int i = lengths[n] * width; i < 32 * width; ++i)
          x[n * 32 * width + i] = width == 70 ? 1000 : -1000;
      padded[key] = nn::from_vector(x, t.shape());
    }
  auto po = deployed.Run(padded);
  for (const auto& [k, v] : base)
    check::Near(
        replay::MaxAbsDiff(v, po.at(k)), 0, 0, "padding cannot affect compact paths/loss/partials");
  Save(root / "padding_inputs.npz", padded);
  Save(root / "padding_outputs.npz", po);
  auto no_gold        = b;
  no_gold["target"]   = nn::full({2, 32}, 69, nn::DType::Int32);
  no_gold["selected"] = nn::zeros({2, 32});
  if (distill) {
    no_gold["teacher_logits"] = nn::full({2, 32, 70}, 1000);
    no_gold["teacher_hidden"] = nn::full({2, 32, 8}, -1000);
  }
  check::Near(
      replay::MaxAbsDiff(deployed.Predict(b), deployed.Predict(no_gold)),
      0,
      0,
      "student inference excludes gold and teacher");
  double fd       = 0;
  int    fd_count = 0;
  for (auto key : model.parameters.names()) {
    auto value = final.at(key);
    auto x     = value.to_vector<float>();
    for (int i : {0, int(x.size() / 2), int(x.size() - 1)}) {
      float old = x[i];
      x[i]      = old + .001f;
      auto plus =
          model.Run(first, false, {{key, nn::from_vector(x, value.shape())}}).at("loss").item();
      x[i] = old - .001f;
      auto minus =
          model.Run(first, false, {{key, nn::from_vector(x, value.shape())}}).at("loss").item();
      x[i] = old;
      fd   = std::max(fd, std::abs((plus - minus) / .002 - g.at(key).to_vector<float>()[i]));
      ++fd_count;
    }
  }
  check::Require(fd < .004, "shared/tied/triple-loss native central differences");
  check::Require(replay::SameBits(final, deployed.Arrays()), "compact inference immutable");
  int  correct = 0, count = 0;
  auto logits   = out.at("logits").to_vector<float>(),
       selected = pools[2].at("selected").to_vector<float>();
  auto target   = pools[2].at("target").to_vector<int>();
  for (int i = 0; i < 32 * 32; ++i)
    if (selected[i]) {
      int best = 0;
      for (int c = 1; c < 70; ++c)
        if (logits[i * 70 + c] > logits[i * 70 + best])
          best = c;
      correct += best == target[i];
      ++count;
    }
  std::ofstream meta(root / "metrics.json");
  meta.precision(17);
  meta << "{\"parameters\":" << expected << ",\"variables\":" << model.parameters.size()
       << ",\"embedding\":" << config.embedding << ",\"layers\":" << config.layers
       << ",\"shared\":" << config.shared << ",\"segments\":" << config.segments
       << ",\"distilled\":" << distill << ",\"epochs\":" << epochs << ",\"updates\":" << steps
       << ",\"test_mlm_ce\":" << out.at("mlm_loss").item()
       << ",\"test_total\":" << out.at("loss").item() << ",\"test_kd\":" << out.at("kd_loss").item()
       << ",\"test_cosine\":" << out.at("cos_loss").item()
       << ",\"selected_accuracy\":" << double(correct) / count
       << ",\"native_fd_count\":" << fd_count << ",\"native_fd_error\":" << fd << "}\n";
  std::cout << name << " params=" << expected << " accuracy=" << correct << '/' << count << " "
            << fd_count << "nativeFD max=" << fd
            << "; padding/teacherFree/restore/immutable PASS\n";
}
} // namespace
int main(int argc, char** argv) {
  try {
    nn::set_num_threads(2);
    int epochs = 3;
    for (int i = 1; i < argc; ++i) {
      std::string a = argv[i];
      check::Require(a.rfind("epochs=", 0) == 0, "epochs=N");
      epochs = std::stoi(a.substr(7));
    }
    check::Require(epochs > 0 && epochs <= 100, "positive bounded epochs");
    auto data =
        replay::ToMap(nn::load_npz((paths::Dataset("roberta_tweaks") / "data.npz").string()));
    check::Require(
        data.count("epoch" + std::to_string(epochs) + "_input"),
        "prepare_roberta_tweaks.py --epochs=N for requested epochs");
    Run("static_b8", false, 8, epochs, data);
    Run("dynamic_b8", true, 8, epochs, data);
    Run("static_b16", false, 16, epochs, data);
    Run("dynamic_b16", true, 16, epochs, data);
    return 0;
  } catch (const std::exception& e) {
    std::cerr << e.what() << '\n';
    return 1;
  }
}

```
// result_begin:
// static_b8 epoch=1 validationMLM=4.00424 total=4.00424
// static_b8 epoch=2 validationMLM=3.72302 total=3.72302
// static_b8 epoch=3 validationMLM=3.53602 total=3.53602
// static_b8 params=2190 accuracy=23/130 123nativeFD max=0.000131512; padding/teacherFree/restore/immutable PASS
// dynamic_b8 epoch=1 validationMLM=4.00424 total=4.00424
// dynamic_b8 epoch=2 validationMLM=3.71778 total=3.71778
// dynamic_b8 epoch=3 validationMLM=3.52943 total=3.52943
