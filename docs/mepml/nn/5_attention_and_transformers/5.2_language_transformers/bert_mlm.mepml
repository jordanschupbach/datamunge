> Publish this native prerequisite checkpoint

Only learned native arrays are shared with dependent reports; no external comparison fixture is manufactured.

```{cpp, results="markdown", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -lpthread -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
namespace recovered_checkpoints {
inline std::filesystem::path Model(const std::string&name){auto p=std::filesystem::path(dm::datasets::data_home())/"nn-completion-checkpoints/models"/name;std::filesystem::create_directories(p);return p;}
}
int main(){auto source=std::filesystem::absolute("build/nn-completion/models/bert_mlm"),cache=recovered_checkpoints::Model("bert_mlm");for(auto file:{"model_arrays.npz","final.npz"})if(std::filesystem::exists(source/file))std::filesystem::copy_file(source/file,cache/file,std::filesystem::copy_options::overwrite_existing);std::ofstream(cache/"provenance.txt")<<"Native trained bert_mlm, reconstructed version-one preparation; not a TF recording.\n";std::ofstream(cache/"recipe.sha256")<<dm::datasets::file_digest((std::filesystem::path(dm::datasets::prepare_example_data("nn-completion-assets"))/"bert_mlm/data.npz").string())<<"\n"<<dm::datasets::file_digest((cache/"model_arrays.npz").string())<<"\n";}
