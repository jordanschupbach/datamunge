int main(){namespace n=dm::nn;double computed=-n::log_softmax(n::zeros({1,70},n::DType::Float64),1).to_vector<double>()[0],analytic=std::log(70.);if(std::abs(computed-analytic)>2e-6)throw std::runtime_error("hand calculation differs from native primitives");std::print("| native calculation | analytic reference |\n|---:|---:|\n| {:.9f} | {:.9f} |\n",computed,analytic);dm::graphics::RPlot::create().bars(std::vector<double>{0,1},std::vector<double>{computed,analytic},"worked reference",{37,99,235}).ylim(0,std::max(.5,std::max(computed,analytic)*1.2)).x_label("0 = native calculation;1 = analytic reference").y_label("Toy objective or diagnostic value").title("bert mlm hand calculation").size(1000,550).save_svg("build/bert_mlm_worked.svg");}
