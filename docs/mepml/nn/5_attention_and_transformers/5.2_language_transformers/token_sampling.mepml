int main(){auto arrays=dm::nn::load_npz("build/recovered-language/models/token_sampling/nucleus.npz");auto get=[&](const std::string&key){return std::find_if(arrays.begin(),arrays.end(),[&](const auto&v){return v.first==key;})->second;};auto errors=get("probability").to_vector<double>();std::vector<double>x(errors.size());std::iota(x.begin(),x.end(),0.);dm::graphics::RPlot::create().lines(x,errors,"filtered probability",{37,99,235}).points(x,errors,"source values",{37,99,235},4).title("token sampling actual source diagnostic").size(1100,600).save_svg("build/token_sampling_validation.svg");}
