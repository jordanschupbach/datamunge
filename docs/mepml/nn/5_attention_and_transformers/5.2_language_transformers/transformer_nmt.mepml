// CMD: just run-nn transformer_nmt
// Scratch post-norm Transformer NMT on pinned real English-French pairs.
//
// Port of tflow's transformer_nmt (common/{nn,ml}/transformer_nmt.h ->
// examples/nn/common/transformer_nmt.hpp). Data: the pinned translation split
// (paths::Dataset("translation")/data.npz: 128 fitting, 32 validation, 32 test
// pairs of 6 byte tokens with BOS 1 / EOS 2, teacher-forced decoder inputs and
// lengths). One encoder and one decoder layer (D 8, 2 heads, FF 16), 5760
// parameters in 33 tensors, Adam .003, batch 8 from nn::BatchOrder(128, 8,
// 46007) (tflow's order), three epochs = 48 updates.
//
// Checks (as tflow): parameter count; bit-exact checkpoint restore;
// deterministic greedy decoding that ignores gold targets/teacher/lengths;
// exact padding invariance of every output and partial; future teacher tokens
// cannot change earlier logits and the prefix gradient to them is 0; an empty
// source leaks nothing through memory, attentions or partials; whole-model
// float32 central differences (99 coordinates) < .003; inference leaves the
// weights unchanged. Reports test token CE, teacher-forced token accuracy and
// greedy exact-sequence accuracy.
//
// Deviations: weights replay TF's saved initial arrays by default (init=auto:
// tflow's output/models/transformer_nmt/initial_arrays.npz when present, then
// every record is compared with TF's; init=nn: nn's generator, statistical
// parity). The checkpoint is final.npz. Options: epochs=3 out=DIR tf=DIR
// init=auto|tf|nn threads=4 verbose=0. Output: output/nn/models/transformer_nmt/.
// Editable workflow support: transformer_lm.hpp
// Causal decoder language model (port of tflow's common/ml/transformer_lm.h)
// plus the small harness the 5.2 language-Transformer ports share: key=value
// options, the character_rnn data, the trained-GPT weights used by kv_cache
// and token_sampling, and the comparison with TF's .npz fixtures.
//
// tflow -> datamunge: the session graph becomes eager calls; AddSymbolicGradients
// -> nn::grad; the Adam train_op -> nn::Optimizer (Adam, lr .003); SaveV2
// checkpoints -> .npz files of the parameter store. Weights initialise from nn's
// generator (seed 9001) unless TF's saved arrays are replayed (LoadArrays).



// Editable workflow support: attention.hpp
// Attention helpers for the 5.x example ports (port of the parts of tflow's
// common/nn/attention.h that datamunge/nn/attention.hpp does not already
// provide), plus the small harness the 5.1 attention-fundamentals examples
// share: tflow's random input streams, float32 central differences and the
// comparison against the .npz fixtures the TF examples write.
//
// tflow -> datamunge:
//   nn::ScaledDotProductAttention(s, q, k, v, d, mask, allowed)
//       -> nn::scaled_dot_product_attention(q, k, v, mask) (scale 1/sqrt(q.size(-1)),
//          weights returned; `mask` is either an additive float bias or a bool keep mask)
//   nn::MultiHeadAttention(s, p, name, xq, xkv, d_model, heads, mask, allowed)
//       -> nn::multi_head_attention(store, name, xq, xkv, heads, options)
//   nn::AttentionAllowed(s, key_lengths, query_lengths, queries, keys, causal, offset)
//       -> attn::AttentionAllowed below (the library's causal_keep_mask is aligned
//          bottom-right instead of taking an explicit query offset, and its
//          padding_keep_mask masks keys only).



namespace attn {

namespace nn = datamunge::nn;

/// tflow's AttentionAllowed: bool [N, queries, keys], true where query t is
/// valid (t < query_lengths[n]), key j is valid (j < key_lengths[n]) and, when
/// `causal`, j <= t + query_offset (queries sit after `query_offset` cached
/// keys during incremental decoding). Lengths are integer tensors [N]. Add a
/// head axis (expand_dims(.., 1)) for [N, heads, Tq, Tk] scores.
inline nn::Tensor AttentionAllowed(const nn::Tensor& key_lengths, const nn::Tensor& query_lengths, std::int64_t queries,
                                   std::int64_t keys, bool causal = false, std::int64_t query_offset = 0) {
  if (queries < 1 || keys < 1 || query_offset < 0)
    throw std::invalid_argument("positive attention lengths and nonnegative query offset required");
  if (key_lengths.dim() != 1 || query_lengths.dim() != 1 || key_lengths.size(0) != query_lengths.size(0))
    throw std::invalid_argument("AttentionAllowed: key and query lengths must be vectors of the batch size");
  const std::int64_t batch = key_lengths.size(0);
  nn::Tensor         out   = nn::zeros({batch, queries, keys}, nn::DType::Bool);
  bool*              p     = out.data_ptr<bool>();
  for (std::int64_t b = 0; b < batch; ++b) {
    const double kl = key_lengths.at({b}), ql = query_lengths.at({b});
    for (std::int64_t t = 0; t < queries; ++t)
      for (std::int64_t j = 0; j < keys; ++j)
        p[(b * queries + t) * keys + j] = t < ql && j < kl && (!causal || j <= t + query_offset);
  }
  return out;
}

/// tflow's ScaledDotProductAttention(q, k, v, d, mask): scores scaled by
/// 1/sqrt(d), plain (weight-materialising) path, weights returned. `mask` is an
/// additive float bias or a bool keep mask (tflow's `allowed`); rows with no
/// allowed key give zero weights and output.
inline nn::Attended ScaledDotProductAttention(const nn::Tensor& q, const nn::Tensor& k, const nn::Tensor& v,
                                              std::int64_t d, const nn::Tensor& mask = nn::Tensor()) {
  if (d < 1) throw std::invalid_argument("attention key width must be positive");
  nn::AttentionOptions o;
  o.mask         = mask;
  o.scale        = 1.0 / std::sqrt(static_cast<double>(d));
  o.need_weights = true;
  o.impl         = nn::AttentionImpl::Plain;
  return nn::scaled_dot_product_attention(q, k, v, o);
}

/// tflow's MultiHeadAttention(p, name, x_q, x_kv, d_model, heads, mask,
/// allowed): bias-free projections "<name>/Wq|Wk|Wv|Wo" [d_model, d_model]
/// (U(+-sqrt(3/d_model))), weights [N, heads, Tq, Tk] returned. `mask`: keep or
/// additive, broadcastable to [N, heads, Tq, Tk]. d_model is explicit, as in tflow,
/// and checked against the input width.
inline nn::Attended MultiHeadAttention(nn::ParameterStore& store, const std::string& name, const nn::Tensor& x_q,
                                       const nn::Tensor& x_kv, std::int64_t d_model, std::int64_t heads,
                                       const nn::Tensor& mask = nn::Tensor()) {
  if (d_model < 1 || heads < 1 || d_model % heads != 0)
    throw std::invalid_argument("positive model/head counts and divisible head width required");
  if (x_q.dim() != 3 || x_q.size(2) != d_model || x_kv.dim() != 3 || x_kv.size(2) != d_model)
    throw std::invalid_argument("multi-head inputs must be [N, T, d_model]");
  nn::MultiHeadOptions o;
  o.mask         = mask;
  o.need_weights = true;
  o.impl         = nn::AttentionImpl::Plain;
  return nn::multi_head_attention(store, name, x_q, x_kv, heads, o);
}

/// Initializer that returns a fixed array (replays weights saved by TF).
inline nn::Initializer FixedInit(const nn::Tensor& value) {
  return [value](const nn::Shape& shape, nn::DType, nn::Generator&) {
    if (shape != value.shape()) throw std::invalid_argument("saved weight has the wrong shape");
    return value.clone();
  };
}

/// Integer vector tensor.
inline nn::Tensor Ints(const std::vector<int>& values) {
  return nn::from_vector(values, {static_cast<std::int64_t>(values.size())});
}

/// tflow's `random` lambdas: float32 tensors filled with scale * N(0, 1) drawn
/// from one std::mt19937 and ONE std::normal_distribution<float> (it caches
/// the second value of each pair, so a fresh distribution per tensor would
/// diverge after an odd-sized tensor). With the same seed and the same
/// standard library (both builds use libc++ here) the values equal TF's.
struct TfRandom {
  explicit TfRandom(unsigned seed) : rng(seed) {}
  nn::Tensor operator()(const nn::Shape& shape, float scale = 1.f) {
    nn::Tensor t = nn::empty(shape);
    float*     p = t.data_ptr<float>();
    for (std::int64_t i = 0; i < t.numel(); ++i) p[i] = scale * normal(rng);
    return t;
  }
  std::mt19937                    rng;
  std::normal_distribution<float> normal{0, 1};
};

/// Max |a - b| (inf on a shape mismatch).
inline double MaxAbsDiff(const nn::Tensor& a, const nn::Tensor& b) {
  if (a.shape() != b.shape()) return INFINITY;
  const auto x = nn::cast(a, nn::DType::Float64).to_vector<double>();
  const auto y = nn::cast(b, nn::DType::Float64).to_vector<double>();
  double     m = 0;
  for (std::size_t i = 0; i < x.size(); ++i) m = std::max(m, std::abs(x[i] - y[i]));
  return m;
}

/// tflow's native finite-difference probe: for `samples` coordinates spread
/// evenly over `value` (i * (numel - 1) / (samples - 1)), compares the float32
/// central difference (f(x + h) - f(x - h)) / 2h, h = 0.002, with the analytic
/// gradient. `value` is modified in place and restored. Returns the max error.
inline double CentralDifferenceError(nn::Tensor& value, const nn::Tensor& gradient, int samples,
                                     const std::function<float()>& objective, int* count = nullptr) {
  float*     p = value.data_ptr<float>();
  const auto g = gradient.to_vector<float>();
  double     error = 0;
  for (int i = 0; i < samples; ++i) {
    const std::int64_t c   = samples == 1 ? 0 : i * (value.numel() - 1) / (samples - 1);
    const float        old = p[c];
    p[c]                   = old + .002f;
    const float plus       = objective();
    p[c]                   = old - .002f;
    const float minus      = objective();
    p[c]                   = old;
    error                  = std::max(error, std::abs((plus - minus) / .004 - g[c]));
    if (count) ++*count;
  }
  return error;
}

/// Reads one array of an .npz archive (throws when missing).
inline nn::Tensor Named(const nn::NamedTensors& arrays, const std::string& name) {
  for (const auto& [key, value] : arrays)
    if (key == name) return value;
  throw std::runtime_error("npz has no array '" + name + "'");
}

inline bool Has(const nn::NamedTensors& arrays, const std::string& name) {
  for (const auto& [key, value] : arrays)
    if (key == name) return true;
  return false;
}

/// Default location of the TF example's fixtures: tflow's output/models/<name>.
inline std::filesystem::path DefaultTfDir(const std::string& name) {
  const char* home = std::getenv("HOME");
  return std::filesystem::path(home ? home : ".") / "projects" / "tflow_examples" / "output" / "models" / name;
}

/// Compares every array of `ours` that TF also saved (same key) with TF's
/// .npz `tf_file`. Returns the largest difference over the arrays whose names
/// pass `include` (all by default), or -1 when the file is missing. Prints one
/// line per compared array when `verbose`.
inline double CompareWithTf(const std::filesystem::path& tf_file, const nn::NamedTensors& ours, bool verbose = false,
                            const std::function<bool(const std::string&)>& include = {}) {
  if (!std::filesystem::exists(tf_file)) return -1;
  const auto ref   = nn::load_npz(tf_file.string());
  double     worst = 0;
  for (const auto& [name, value] : ours) {
    if (!Has(ref, name) || (include && !include(name))) continue;
    const double d = MaxAbsDiff(value, Named(ref, name));
    if (verbose) std::printf("    %-22s max |ours - TF| = %.2e\n", name.c_str(), d);
    worst = std::max(worst, d);
  }
  return worst;
}

/// Compares `ours` with TF's fixture `file` under `tf_dir`. When the arrays
/// listed in `inputs` are bit-identical to TF's (same random streams), every
/// other shared array except the finite-difference metadata ("metadata",
/// "native_fd") must agree within `tolerance` (a failed check throws). Returns
/// the max difference, or -1 when the fixture is missing or the inputs differ.
inline double CheckAgainstTf(const std::filesystem::path& tf_dir, const std::string& file, const nn::NamedTensors& ours,
                             const std::vector<std::string>& inputs, double tolerance, bool verbose = false) {
  const auto path = tf_dir / file;
  if (!std::filesystem::exists(path)) {
    std::printf("  (TF fixture %s not found: TF comparison skipped)\n", path.string().c_str());
    return -1;
  }
  auto is_input = [&](const std::string& n) { return std::find(inputs.begin(), inputs.end(), n) != inputs.end(); };
  const double din = CompareWithTf(path, ours, false, is_input);
  if (din != 0) {
    std::printf("  (inputs differ from TF's %s by %.2e: different random stream, outputs not compared)\n",
                file.c_str(), din);
    return -1;
  }
  const double d = CompareWithTf(path, ours, verbose, [&](const std::string& n) {
    return !is_input(n) && n != "metadata" && n != "native_fd";
  });
  std::printf("  vs TF %s (identical inputs): max |ours - TF| = %.2e over all outputs and gradients\n", file.c_str(), d);
  if (!(d <= tolerance))
    throw std::runtime_error(file + ": outputs differ from TF's by " + std::to_string(d) + " > " +
                             std::to_string(tolerance));
  return d;
}

/// key=value options shared by the 5.1 examples: out=DIR (default
/// output/nn/<name>), tf=DIR (TF fixtures, default tflow's output/models/<name>),
/// init=auto|tf|nn for examples with learned weights (auto: TF's saved
/// weights when present), verbose=0|1 (per-array TF comparison).
struct Options {
  std::filesystem::path out, tf;
  std::string           init{"auto"};
  bool                  verbose{false};
};

inline Options ParseOptions(int argc, char** argv, const std::string& name,
                            const std::filesystem::path& out_default) {
  Options o;
  o.out = out_default;
  o.tf  = DefaultTfDir(name);
  for (int i = 1; i < argc; ++i) {
    const std::string a = argv[i];
    const auto        e = a.find('=');
    if (e == std::string::npos) throw std::invalid_argument("expected key=value option, got " + a);
    const std::string key = a.substr(0, e), value = a.substr(e + 1);
    if (key == "out") o.out = value;
    else if (key == "tf") o.tf = value;
    else if (key == "init") o.init = value;
    else if (key == "verbose") o.verbose = value != "0";
    else throw std::invalid_argument("unknown option " + key + " (out=, tf=, init=, verbose=)");
  }
  if (o.init != "auto" && o.init != "tf" && o.init != "nn") throw std::invalid_argument("init must be auto, tf or nn");
  std::filesystem::create_directories(o.out);
  return o;
}

}  // namespace attn

// Editable workflow support: checks.hpp
// Small runtime checks used by the executable nn examples. They stay on in
// Release builds and make the example exit nonzero on failure, so `just
// run-all-nn` doubles as a regression test against the recorded TF numbers.

// Editable workflow support: runtime.hpp
// Bounded demonstrations by default; opt into convergence experiments explicitly.


namespace example_runtime {

inline bool Full() {
  const char* value = std::getenv("DATAMUNGE_EXAMPLES_FULL");
  return value && std::string(value) == "1";
}

template <typename T> T Limit(T requested, T quick_limit) {
  return Full() ? requested : std::min(requested, quick_limit);
}

inline void Describe() {
  if (!Full())
    std::cout << "Quick demonstration: bounded training; convergence metrics require "
                 "DATAMUNGE_EXAMPLES_FULL=1.\n";
}

}  // namespace example_runtime

namespace check {

inline void Require(bool condition, const std::string& message) {
  if (!condition) throw std::runtime_error(message);
}

// A short demonstration checks execution, derivatives and persistence; reaching
// a published accuracy/return requires the separately requested full schedule.
inline void TrainingQuality(bool condition, const std::string& message) {
  if (example_runtime::Full()) Require(condition, message);
  else std::cout << "  full-training quality check deferred: " << message << '\n';
}

inline void Near(double actual, double expected, double tolerance, const std::string& message) {
  if (!std::isfinite(actual) || !std::isfinite(expected) || std::abs(actual - expected) > tolerance)
    throw std::runtime_error(message + ": got " + std::to_string(actual) + ", expected " + std::to_string(expected));
}

/// Expects `f` to throw; returns the message.
template <typename F>
std::string Throws(F&& f, const std::string& message) {
  try {
    f();
  } catch (const std::exception& e) {
    return e.what();
  }
  throw std::runtime_error(message + ": expected an exception");
}

}  // namespace check

inline void Header(const std::string& title) {
  const std::size_t pad = title.size() < 60 ? 60 - title.size() : 0;
  std::cout << "\n== " << title << " " << std::string(pad, '=') << "\n";
}

// Editable workflow support: decoder_transformer.hpp
namespace lm {namespace nn=datamunge::nn;using nn::Tensor;using dm::nn::models::DecoderConfig;using dm::nn::models::DecoderPath;using dm::nn::models::DecoderTransformer;using dm::nn::models::CachedDecoder;}

// Editable workflow support: paths.hpp
// Where the nn example ports read datasets and write their outputs.
//
// Datasets: $DATAMUNGE_DATA_DIR, or the user's cache. Public datasets are
// prepared by the example data loaders when first needed.
// Outputs (checkpoints, histories, fixtures): $DATAMUNGE_OUTPUT_DIR, or
// output/nn relative to the working directory (`just run-nn` runs from the
// repository root). Both are created on demand by the caller.


// Editable workflow support: dataset_assets.hpp
namespace dataset_assets{inline std::string DataRoot(){return dm::datasets::data_home();}}

namespace dataset_assets {inline void EnsureSaliency(const std::string& directory){dm::datasets::prepare_example_data("mnist-assets",std::filesystem::path(directory).parent_path().string());}}

namespace dataset_assets {
inline dm::nn::ImageDataset LoadCifar10(const std::string&directory,const std::string&split){dm::datasets::fetch("cifar10",std::filesystem::path(directory).parent_path().string());return dm::nn::load_cifar10(directory,split);}
}

namespace paths {

inline std::filesystem::path DataRoot() {
  return dataset_assets::DataRoot();
}

/// DataRoot() / name, e.g. Dataset("mnist").
inline std::filesystem::path Dataset(const std::string& name) { if(name=="cifar10"||name=="character_rnn")return DataRoot()/name;return std::filesystem::path(dm::datasets::prepare_example_data("nn-completion-assets"))/name; }

inline std::filesystem::path OutputRoot(){return std::filesystem::absolute("build/nn-completion");}

/// OutputRoot() / relative, created as a directory.
inline std::filesystem::path OutputDir(const std::string& relative) {
  auto dir = OutputRoot() / relative;
  std::filesystem::create_directories(dir);
  return dir;
}

}  // namespace paths

namespace lm {

namespace fs = std::filesystem;
using Outputs = std::map<std::string, Tensor>;

// ---- small tensor helpers ----------------------------------------------------------------------

inline nn::NamedTensors Named(const Outputs& out) { return {out.begin(), out.end()}; }

inline Tensor Rows(const Tensor& x, const std::vector<std::int64_t>& rows) { return nn::take_rows(x, rows); }

/// Copies of every parameter, by name (creation order).
inline nn::NamedTensors Arrays(const nn::ParameterStore& store) {
  nn::NamedTensors out;
  for (const auto& name : store.names()) out.emplace_back(name, store.at(name).detach().clone());
  return out;
}

/// True when both stores' arrays have the same names and bits.
inline bool SameBits(const nn::NamedTensors& a, const nn::NamedTensors& b) {
  if (a.size() != b.size()) return false;
  for (std::size_t i = 0; i < a.size(); ++i) {
    if (a[i].first != b[i].first || a[i].second.shape() != b[i].second.shape()) return false;
    const auto x = a[i].second.to_vector<float>(), y = b[i].second.to_vector<float>();
    if (std::memcmp(x.data(), y.data(), x.size() * sizeof(float)) != 0) return false;
  }
  return true;
}

/// Overwrites every parameter of `store` from an .npz written by tflow (or by
/// store.save); the archive must cover exactly the store's parameters.
inline void LoadArrays(nn::ParameterStore& store, const fs::path& file) {
  const auto arrays = nn::load_npz(file.string());
  check::Require(arrays.size() == store.size(), "saved arrays cover exactly the model's parameters: " + file.string());
  for (const auto& [name, value] : arrays) {
    check::Require(store.contains(name), "saved array " + name + " is a model parameter");
    store.set(name, nn::cast(value, store.at(name).dtype()));
  }
}

inline void RequireFinite(const Outputs& out, const std::string& what) {
  for (const auto& [k, v] : out)
    if (v.dtype() == nn::DType::Float32)
      for (float x : v.to_vector<float>()) check::Require(std::isfinite(x), what + " (" + k + ")");
}

// ---- options -----------------------------------------------------------------------------------

/// epochs=N (training examples), out=DIR, tf=DIR (TF fixtures), init=auto|tf|nn
/// (auto: replay TF's initial_arrays.npz when present), gpt=auto|ours|tf|PATH
/// (trained GPT for kv_cache/token_sampling), threads=N, verbose=0|1.
struct Options {
  int         epochs{3};
  fs::path    out, tf;
  std::string init{"auto"}, gpt{"auto"};
  int         threads{4};
  bool        verbose{false};
};

inline Options ParseOptions(int argc, char** argv, const std::string& name, bool training) {
  Options o;
  o.tf = attn::DefaultTfDir(name);
  for (int i = 1; i < argc; ++i) {
    const std::string a = argv[i];
    const auto        e = a.find('=');
    check::Require(e != std::string::npos, "expected key=value option, got " + a);
    const std::string key = a.substr(0, e), value = a.substr(e + 1);
    if (key == "epochs" && training) o.epochs = std::stoi(value);
    else if (key == "out") o.out = value;
    else if (key == "tf") o.tf = value;
    else if (key == "init" && training) o.init = value;
    else if (key == "gpt" && !training) o.gpt = value;
    else if (key == "threads") o.threads = std::stoi(value);
    else if (key == "verbose") o.verbose = value != "0";
    else
      throw std::invalid_argument("unknown option " + key + (training ? " (epochs=, out=, tf=, init=, threads=, verbose=)"
                                                                      : " (out=, tf=, gpt=, threads=, verbose=)"));
  }
  check::Require(o.epochs > 0 && o.epochs <= 100, "positive bounded epochs");
  check::Require(o.init == "auto" || o.init == "tf" || o.init == "nn", "init must be auto, tf or nn");
  if (o.out.empty()) o.out = paths::OutputDir("models/" + name);
  fs::create_directories(o.out);
  if (o.threads > 0) nn::set_num_threads(o.threads);
  return o;
}

/// Resolves init=: the TF initial arrays to replay, or empty for nn's generator.
inline fs::path InitArrays(const Options& o) {
  const fs::path file = o.tf / "initial_arrays.npz";
  if (o.init == "nn") return {};
  if (o.init == "tf") check::Require(fs::exists(file), "init=tf needs " + file.string());
  return fs::exists(file) ? file : fs::path();
}

/// Compares our record with TF's fixture of the same name (when present):
/// prints the max difference over the shared arrays and returns it (-1 if
/// the fixture is missing).
inline double CompareRecord(const Options& o, const std::string& file, const nn::NamedTensors& ours,
                            const std::function<bool(const std::string&)>& include = {}) {
  const double d = attn::CompareWithTf(o.tf / file, ours, o.verbose, include);
  if (d < 0) std::printf("  vs TF %-26s (fixture missing)\n", file.c_str());
  else std::printf("  vs TF %-26s max |ours - TF| = %.3g\n", file.c_str(), d);
  return d;
}

// ---- data ------------------------------------------------------------------------------------------

inline std::string ReadText(const fs::path& file) {
  std::ifstream in(file, std::ios::binary);
  check::Require(bool(in), "cannot read " + file.string());
  return {std::istreambuf_iterator<char>(in), {}};
}

inline std::vector<int> Encode(const std::string& vocab, const std::string& text) {
  std::vector<int> codes;
  for (char c : text) {
    const auto at = vocab.find(c);
    check::Require(at != std::string::npos, "prompt character in vocabulary");
    codes.push_back(static_cast<int>(at));
  }
  return codes;
}

// ---- the model ---------------------------------------------------------------------------------------

/// tflow's ml::TransformerLM: one-hot input [N, 64] int32 -> causal decoder;
/// loss = mean next-token cross-entropy over every position.
class TransformerLM {
 public:
  DecoderConfig                  config;
  nn::ParameterStore             store{9001};
  std::unique_ptr<nn::Optimizer> optimizer;

  explicit TransformerLM(bool training = true, DecoderConfig c = {}) : config(c) {
    {
      nn::NoGradGuard guard;
      DecoderTransformer(store, nn::zeros({1, c.context, c.input_classes}), c);
    }
    if (training) Train();
  }
  /// (Re)creates the Adam state (after replaying initial arrays).
  void Train() {
    nn::OptimizerConfig oc;
    oc.kind   = nn::OptimizerKind::Adam;
    optimizer = std::make_unique<nn::Optimizer>(store, .003, oc);
  }

  Tensor Encoded(const Tensor& x) const { return nn::one_hot(x, config.input_classes); }

  Tensor Loss(const DecoderPath& p, const Tensor& y) const {
    const Tensor logp = nn::log_softmax(p.logits, -1);
    return nn::neg(nn::mean(nn::sum(nn::mul(nn::one_hot(y, config.output_classes), logp), {2})));
  }

  Outputs Evaluate(const Tensor& x, const Tensor& y) {
    nn::NoGradGuard guard;
    const auto      p = DecoderTransformer(store, Encoded(x), config);
    Outputs out{{"logits", p.logits}, {"hidden", p.hidden}, {"attention", p.attention}, {"embedded", p.embedded},
                {"loss", Loss(p, y)}};
    RequireFinite(out, "finite Transformer fields");
    return out;
  }

  float LossValue(const Tensor& x, const Tensor& y) {
    nn::NoGradGuard guard;
    return Loss(DecoderTransformer(store, Encoded(x), config), y).item<float>();
  }

  void ValidateTokens(const Tensor& x) const {
    check::Require(x.dim() == 2 && x.size(1) == config.context, "full context token matrix");
    for (auto v : nn::cast(x, nn::DType::Int64).to_vector<std::int64_t>())
      check::Require(v >= 0 && v < config.input_classes, "valid context token IDs");
  }

  /// Context-only inference (no labels).
  Tensor Predict(const Tensor& x) {
    ValidateTokens(x);
    nn::NoGradGuard guard;
    return DecoderTransformer(store, Encoded(x), config).logits;
  }

  /// d sum(logits[:, context/2, 0]) / d one-hot input (tflow slices {0, T/2, 0} size {-1, 1, 1}).
  Tensor InputGradient(const Tensor& x) {
    Tensor encoded = Encoded(x);
    encoded.requires_grad_(true);
    const auto   p         = DecoderTransformer(store, encoded, config);
    const Tensor objective = nn::sum(nn::slice_axis(nn::slice_axis(p.logits, 1, config.context / 2, config.context / 2 + 1), 2, 0, 1));
    return nn::grad(objective, {encoded})[0].detach();
  }

  std::vector<Tensor> RawGradients(const Tensor& x, const Tensor& y) {
    const auto      p = DecoderTransformer(store, Encoded(x), config);
    nn::GradOptions go;
    go.allow_unused = true;
    auto g          = nn::grad(Loss(p, y), store.parameters(), go);
    const auto ps   = store.parameters();
    for (std::size_t i = 0; i < g.size(); ++i) g[i] = g[i].defined() ? g[i].detach() : nn::zeros_like(ps[i]);
    return g;
  }

  nn::NamedTensors Gradient(const Tensor& x, const Tensor& y) {
    const auto       g = RawGradients(x, y);
    nn::NamedTensors out;
    for (std::size_t i = 0; i < g.size(); ++i) out.emplace_back(store.names()[i], g[i]);
    return out;
  }

  void Update(const Tensor& x, const Tensor& y) { optimizer->step(RawGradients(x, y)); }

  nn::NamedTensors Arrays() const { return lm::Arrays(store); }

  /// tflow's Sample: context-cropped (last 64 tokens, left-aligned, zero
  /// padded) full-model predictions, softmax(z / temperature) inverse-CDF draw
  /// with u = (mt19937() + .5) / 2^32.
  Outputs Sample(const std::vector<int>& prompt, int count, std::uint32_t seed, double temperature) {
    check::Require(!prompt.empty() && count > 0 && temperature > 0 && std::isfinite(temperature),
                   "valid Transformer prompt/count/temperature");
    const std::int64_t       V = config.output_classes, T = config.context;
    std::vector<int>         codes(prompt.begin(), prompt.end());
    std::vector<double>      uniform;
    std::vector<float>       logits;
    std::vector<std::int32_t> contexts, lengths;
    for (int p : prompt) check::Require(p >= 0 && p < config.input_classes, "valid prompt token");
    std::mt19937 rng(seed);
    for (int t = 0; t < count; ++t) {
      const int end = static_cast<int>(codes.size()), start = std::max<int>(0, end - static_cast<int>(T)),
                length = end - start;
      std::vector<std::int32_t> context(static_cast<std::size_t>(T), 0);
      for (int j = start; j < end; ++j) context[static_cast<std::size_t>(j - start)] = codes[static_cast<std::size_t>(j)];
      contexts.insert(contexts.end(), context.begin(), context.end());
      lengths.push_back(length);
      const auto scores = Predict(nn::from_vector(context, {1, T})).to_vector<float>();
      double     maximum = -INFINITY, mass = 0;
      for (std::int64_t c = 0; c < V; ++c) {
        const float z = scores[static_cast<std::size_t>((length - 1) * V + c)];
        logits.push_back(z);
        maximum = std::max(maximum, double(z) / temperature);
      }
      const float* z = logits.data() + t * V;
      for (std::int64_t c = 0; c < V; ++c) mass += std::exp(double(z[c]) / temperature - maximum);
      const double u = (double(rng()) + .5) / 4294967296.;
      uniform.push_back(u);
      double sum    = 0;
      int    chosen = static_cast<int>(V) - 1;
      for (std::int64_t c = 0; c < V; ++c) {
        sum += std::exp(double(z[c]) / temperature - maximum) / mass;
        if (u < sum) {
          chosen = static_cast<int>(c);
          break;
        }
      }
      codes.push_back(chosen);
    }
    return {{"codes", nn::from_vector(std::vector<std::int32_t>(codes.begin(), codes.end()),
                                      {static_cast<std::int64_t>(codes.size())})},
            {"uniform", nn::from_vector(uniform, {count})},
            {"logits", nn::from_vector(logits, {count, V})},
            {"contexts", nn::from_vector(contexts, {count, T})},
            {"context_lengths", nn::from_vector(lengths, {count})}};
  }
};

/// The trained GPT (gpt_lm's final weights) used by kv_cache and token_sampling.
/// gpt=auto: TF's output/models/gpt_lm/model_arrays.npz when present (so the
/// decisions can be compared with TF's exactly), else our gpt_lm's final.npz;
/// gpt=tf / gpt=ours force one; anything else is a path.
inline fs::path TrainedGpt(const std::string& choice) {
  const fs::path tf   = attn::DefaultTfDir("gpt_lm") / "model_arrays.npz";
  const fs::path ours = paths::OutputRoot() / "models" / "gpt_lm" / "final.npz";
  fs::path       file = choice == "tf" ? tf : choice == "ours" ? ours : choice == "auto" ? (fs::exists(tf) ? tf : ours) : fs::path(choice);
  check::Require(fs::exists(file), "trained GPT weights not found: " + file.string() + " (run gpt_lm first)");
  return file;
}

inline fs::path GptVocabulary() {
  const fs::path file = paths::Dataset("character_rnn") / "vocabulary.txt";
  check::Require(fs::exists(file), "character_rnn vocabulary not found: " + file.string());
  return file;
}

}  // namespace lm

// Editable workflow support: transformer_nmt.hpp


namespace nmt {using namespace dm::nn::models::nmt;

inline SeqBatch SeqRows(const SeqBatch& b, const std::vector<std::int64_t>& r) {
  return {nn::take_rows(b.input, r),         nn::take_rows(b.target, r),         nn::take_rows(b.teacher, r),
          nn::take_rows(b.input_lengths, r), nn::take_rows(b.output_lengths, r), nn::take_rows(b.source_ids, r)};
}
inline nn::NamedTensors Named(const SeqBatch& b) {
  return {{"input", b.input},
          {"teacher", b.teacher},
          {"target", b.target},
          {"input_lengths", b.input_lengths},
          {"output_lengths", b.output_lengths},
          {"source_ids", b.source_ids}};
}
class TransformerNmtModel {
 public:
  nn::ParameterStore             store{46003};
  std::unique_ptr<nn::Optimizer> optimizer;

  explicit TransformerNmtModel(bool training = true) {
    {
      nn::NoGradGuard guard;
      const Tensor    ids = nn::zeros({1, 6}, nn::DType::Int32), len = nn::full({1}, 6, nn::DType::Int32);
      TransformerNmt(store, nn::one_hot(ids, 256), nn::one_hot(ids, 256), len, len);
    }
    if (training) Train();
  }
  void Train() {
    nn::OptimizerConfig c;
    c.kind    = nn::OptimizerKind::Adam;
    optimizer = std::make_unique<nn::Optimizer>(store, .003, c);
  }

  static Tensor Loss(const TransformerNmtPath& p, const SeqBatch& b) {
    const Tensor mask = nn::squeeze(LengthMask(b.output_lengths, 6), {2});
    const Tensor ce   = nn::neg(nn::sum(nn::mul(nn::log_softmax(p.logits, -1), nn::one_hot(b.target, 256)), {2}));
    return nn::div(nn::sum(nn::mul(ce, mask)), nn::maximum(nn::sum(mask), nn::scalar_like(1.0, mask)));
  }

  TransformerNmtPath Forward(const SeqBatch& b) {
    return TransformerNmt(store, nn::one_hot(b.input, 256), nn::one_hot(b.teacher, 256), b.input_lengths, b.output_lengths);
  }

  Outputs Evaluate(const SeqBatch& b) {
    Tensor source = nn::one_hot(b.input, 256), teacher = nn::one_hot(b.teacher, 256);
    source.requires_grad_(true);
    teacher.requires_grad_(true);
    const auto      p      = TransformerNmt(store, source, teacher, b.input_lengths, b.output_lengths);
    const Tensor    loss   = Loss(p, b);
    const Tensor    prefix = nn::sum(nn::slice(p.logits, {0, 0, 0}, {-1, 2, 7}));
    nn::GradOptions go;
    go.retain_graph = true;
    go.allow_unused = true;
    // nn::grad differentiates with respect to intermediate tensors (the
    // encoder memory) as TF's AddSymbolicGradients does.
    const auto g  = nn::grad(std::vector<Tensor>{loss}, {source, teacher, p.memory}, {}, go);
    const auto pg = nn::grad(std::vector<Tensor>{prefix}, {teacher}, {}, go);
    auto def = [](const Tensor& x, const Tensor& like) { return x.defined() ? x.detach() : nn::zeros_like(like.detach()); };
    return {{"loss", loss.detach()},
            {"logits", p.logits.detach()},
            {"memory", p.memory.detach()},
            {"hidden", p.hidden.detach()},
            {"encoder_attention", p.encoder_attention.detach()},
            {"decoder_attention", p.decoder_attention.detach()},
            {"cross_attention", p.cross_attention.detach()},
            {"source_embedded", p.source_embedded.detach()},
            {"target_embedded", p.target_embedded.detach()},
            {"prefix_gradient", def(pg[0], teacher)},
            {"partial0", def(g[0], source)},
            {"partial1", def(g[1], teacher)},
            {"partial2", def(g[2], p.memory)}};
  }

  float LossValue(const SeqBatch& b) {
    nn::NoGradGuard guard;
    return Loss(Forward(b), b).item<float>();
  }

  std::vector<Tensor> RawGradients(const SeqBatch& b) {
    nn::GradOptions go;
    go.allow_unused = true;
    auto       g    = nn::grad(Loss(Forward(b), b), store.parameters(), go);
    const auto ps   = store.parameters();
    for (std::size_t i = 0; i < g.size(); ++i) g[i] = g[i].defined() ? g[i].detach() : nn::zeros_like(ps[i]);
    return g;
  }

  nn::NamedTensors Arrays(const SeqBatch* b = nullptr) {
    nn::NamedTensors out;
    if (b) {
      const auto g = RawGradients(*b);
      for (std::size_t i = 0; i < g.size(); ++i) out.emplace_back(store.names()[i], g[i]);
    } else {
      for (const auto& name : store.names()) out.emplace_back(name, store.at(name).detach().clone());
    }
    return out;
  }

  void Update(const SeqBatch& b) { optimizer->step(RawGradients(b)); }

  /// Own-previous-token greedy decoding from BOS (1): step t feeds the tokens
  /// so far with output length t + 1 and takes the argmax at position t; a row
  /// stops after EOS (2). `trace` receives the cross-attention row of each step.
  Tensor Greedy(const SeqBatch& b, Tensor* trace = nullptr) {
    nn::NoGradGuard           guard;
    const std::int64_t        n = b.input.size(0);
    std::vector<std::int32_t> tokens(static_cast<std::size_t>(n * 6), 0), generated(static_cast<std::size_t>(n * 6), 0);
    for (std::int64_t j = 0; j < n; ++j) tokens[static_cast<std::size_t>(j * 6)] = 1;
    std::vector<bool>  done(static_cast<std::size_t>(n), false);
    std::vector<float> tr(static_cast<std::size_t>(n * 2 * 6 * 6), 0.f);
    for (int t = 0; t < 6; ++t) {
      const Tensor teacher = nn::from_vector(tokens, {n, 6});
      const auto   p       = TransformerNmt(store, nn::one_hot(b.input, 256), nn::one_hot(teacher, 256), b.input_lengths,
                                            nn::full({n}, t + 1, nn::DType::Int32));
      const auto   z       = p.logits.to_vector<float>();
      const auto   ca      = p.cross_attention.to_vector<float>();
      for (std::int64_t j = 0; j < n; ++j) {
        if (done[static_cast<std::size_t>(j)]) continue;
        const float* row  = z.data() + (j * 6 + t) * 256;
        int          best = 0;
        for (int k = 1; k < 256; ++k)
          if (row[k] > row[best]) best = k;
        generated[static_cast<std::size_t>(j * 6 + t)] = best;
        if (t < 5) tokens[static_cast<std::size_t>(j * 6 + t + 1)] = best;
        for (int h = 0; h < 2; ++h)
          for (int k = 0; k < 6; ++k) {
            const auto i = static_cast<std::size_t>(((j * 2 + h) * 6 + t) * 6 + k);
            tr[i]        = ca[i];
          }
        done[static_cast<std::size_t>(j)] = best == 2;
      }
    }
    if (trace) *trace = nn::from_vector(tr, {n, 2, 6, 6});
    return nn::from_vector(generated, {n, 6});
  }
};

}  // namespace nmt

namespace {

using lm::Tensor;
using nmt::SeqBatch;
namespace nn = datamunge::nn;
namespace fs = std::filesystem;

Tensor Edited(const Tensor& x, const std::function<void(std::vector<std::int32_t>&)>& f) {
  auto v = x.to_vector<std::int32_t>();
  f(v);
  return nn::from_vector(v, x.shape());
}

int Run(const lm::Options& o) {
  const auto     started = std::chrono::steady_clock::now();
  const fs::path root = o.out, assets = paths::Dataset("translation");
  check::Require(fs::exists(assets / "data.npz"), "translation dataset missing: " + assets.string());
  for (auto f : {"data.npz", "manifest.json", "vocabulary.txt", "attribution.tsv", "_about.txt"})
    if (fs::exists(assets / f)) fs::copy_file(assets / f, root / f, fs::copy_options::overwrite_existing);
  const auto            data = nn::load_npz((root / "data.npz").string());
  auto                  at   = [&](const std::string& k) { return attn::Named(data, k); };
  std::vector<SeqBatch> pools;
  for (std::string s : {"fit", "validation", "test"})
    pools.push_back({at(s + "_input"), at(s + "_target"), at(s + "_teacher"), at(s + "_input_lengths"),
                     at(s + "_output_lengths"), at(s + "_source_ids")});
  nmt::TransformerNmtModel m;
  check::Require(m.store.count() == 5760 && m.store.size() == 33,
                 "5760 parameters,33 variables: sharedembedding/threeattention/twoFF/fiveLN/head");
  const fs::path init = lm::InitArrays(o);
  if (!init.empty()) {
    lm::LoadArrays(m.store, init);
    m.Train();
    std::cout << "replaying TF's initial arrays " << init.string() << "\n";
  } else {
    std::cout << "weights from nn's generator (statistical parity with TF only)\n";
  }
  nn::save_npz((root / "initial_arrays.npz").string(), m.Arrays());
  nn::save_npz((root / "initial_outputs.npz").string(), lm::Named(m.Evaluate(pools[2])));
  nn::BatchOrder order(128, 8, 46007);
  std::ofstream  batches(root / "batches.tsv"), history(root / "history.tsv");
  batches << "epoch\tstep\trow\n";
  history << "epoch\tvalidation_token_ce\n";
  int      updates = 0;
  SeqBatch first;
  for (int e = 1; e <= o.epochs; ++e) {
    order.begin_epoch();
    for (;;) {
      const auto rows = order.next();
      if (rows.empty()) break;
      const auto b = nmt::SeqRows(pools[0], rows);
      if (!updates) {
        first = b;
        nn::save_npz((root / "first_batch.npz").string(), nmt::Named(b));
        nn::save_npz((root / "initial_gradients.npz").string(), m.Arrays(&b));
        nn::save_npz((root / "first_forward.npz").string(), lm::Named(m.Evaluate(b)));
      }
      m.Update(b);
      if (!updates) nn::save_npz((root / "first_after.npz").string(), m.Arrays());
      for (auto row : rows) batches << e << '\t' << updates << '\t' << row << '\n';
      ++updates;
    }
    const float ce = m.Evaluate(pools[1]).at("loss").item<float>();
    history << e << '\t' << ce << '\n';
    std::cout << "epoch=" << e << " validationTokenCE=" << ce << std::endl;
  }
  nn::save_npz((root / "final_gradients.npz").string(), m.Arrays(&first));
  m.store.save((root / "final.npz").string());
  nmt::TransformerNmtModel deployed(false);
  deployed.store.load((root / "final.npz").string(), true);
  const auto weights = deployed.Arrays();
  check::Require(lm::SameBits(m.Arrays(), weights), "bit exact model restore");
  const auto out = deployed.Evaluate(pools[2]);
  Tensor     trace;
  const auto greedy = deployed.Greedy(pools[2], &trace);
  check::Require(greedy.to_vector<std::int32_t>() == deployed.Greedy(pools[2]).to_vector<std::int32_t>(),
                 "deterministic greedy");
  const auto b       = nmt::SeqRows(pools[2], {0, 1});
  const auto regular = deployed.Evaluate(b);
  auto       corrupt = b;
  corrupt.teacher        = nn::full({2, 6}, 13, nn::DType::Int32);
  corrupt.target         = nn::full({2, 6}, 13, nn::DType::Int32);
  corrupt.output_lengths = nn::zeros({2}, nn::DType::Int32);
  check::Require(deployed.Greedy(b).to_vector<std::int32_t>() == deployed.Greedy(corrupt).to_vector<std::int32_t>(),
                 "decode independent of gold/teacher/target lengths");
  const auto il = b.input_lengths.to_vector<std::int32_t>(), ol = b.output_lengths.to_vector<std::int32_t>();
  auto       padded = b;
  padded.input      = Edited(padded.input, [&](std::vector<std::int32_t>& v) {
    for (int j = 0; j < 2; ++j)
      for (int t = il[static_cast<std::size_t>(j)]; t < 6; ++t) v[static_cast<std::size_t>(j * 6 + t)] = 13;
  });
  padded.teacher = Edited(padded.teacher, [&](std::vector<std::int32_t>& v) {
    for (int j = 0; j < 2; ++j)
      for (int t = ol[static_cast<std::size_t>(j)]; t < 6; ++t) v[static_cast<std::size_t>(j * 6 + t)] = 13;
  });
  const auto po = deployed.Evaluate(padded);
  for (const auto& [k, v] : regular) {
    const auto x = v.to_vector<float>(), y = po.at(k).to_vector<float>();
    for (std::size_t i = 0; i < x.size(); ++i) check::Near(x[i], y[i], 0, "all path and derivative padding invariance: " + k);
  }
  nn::save_npz((root / "padding_inputs.npz").string(), nmt::Named(padded));
  nn::save_npz((root / "padding_outputs.npz").string(), lm::Named(po));
  auto future    = b;
  future.teacher = Edited(future.teacher, [](std::vector<std::int32_t>& v) {
    for (int j = 0; j < 2; ++j)
      for (int t = 2; t < 6; ++t) v[static_cast<std::size_t>(j * 6 + t)] = 13;
  });
  const auto fo = deployed.Evaluate(future);
  const auto rl = regular.at("logits").to_vector<float>(), fl = fo.at("logits").to_vector<float>();
  const auto pg = regular.at("prefix_gradient").to_vector<float>();
  for (int j = 0; j < 2; ++j)
    for (int t = 0; t < 6; ++t)
      for (int k = 0; k < 256; ++k) {
        const auto i = static_cast<std::size_t>((j * 6 + t) * 256 + k);
        if (t < 2) check::Near(rl[i], fl[i], 0, "future token cannot affect earlier logits");
        else check::Near(pg[i], 0, 0, "prefix derivative to future teacher zero");
      }
  nn::save_npz((root / "future_inputs.npz").string(), nmt::Named(future));
  nn::save_npz((root / "future_outputs.npz").string(), lm::Named(fo));
  auto empty          = b;
  empty.input_lengths = nn::zeros({2}, nn::DType::Int32);
  const auto eo       = deployed.Evaluate(empty);
  for (auto key : {"memory", "encoder_attention", "cross_attention", "partial0", "partial2"})
    for (float x : eo.at(key).to_vector<float>()) check::Near(x, 0, 0, "empty source cannot leak through attention or partials");
  nn::save_npz((root / "empty_inputs.npz").string(), nmt::Named(empty));
  nn::save_npz((root / "empty_outputs.npz").string(), lm::Named(eo));

  double     fd_error = 0;
  int        fd_count = 0;
  const auto grads    = m.Arrays(&first);
  for (std::size_t k = 0; k < m.store.size(); ++k) {
    Tensor             value = m.store.at(m.store.names()[k]);
    float*             p     = value.data_ptr<float>();
    const auto         g     = grads[k].second.to_vector<float>();
    const std::int64_t n     = value.numel();
    for (std::int64_t c : {std::int64_t(0), n / 2, n - 1}) {
      const float old = p[c];
      p[c]            = old + .002f;
      const float plus = m.LossValue(first);
      p[c]             = old - .002f;
      const float minus = m.LossValue(first);
      p[c]              = old;
      fd_error          = std::max(fd_error, std::abs((plus - minus) / .004 - g[static_cast<std::size_t>(c)]));
      ++fd_count;
    }
  }
  check::Require(lm::SameBits(m.Arrays(), weights), "finite-difference probes restore the weights");
  check::Require(fd_error < .003, "native whole-model FD including LN and three attentions");
  nn::save_npz((root / "model_arrays.npz").string(), weights);
  nn::save_npz((root / "outputs.npz").string(), lm::Named(out));
  nn::save_npz((root / "decoded.npz").string(), {{"greedy", greedy}, {"attention", trace}});
  int        tokens = 0, correct = 0, exact = 0;
  const auto gv = greedy.to_vector<std::int32_t>(), tv = pools[2].target.to_vector<std::int32_t>();
  const auto lv = out.at("logits").to_vector<float>();
  const auto tl = pools[2].output_lengths.to_vector<std::int32_t>();
  for (int j = 0; j < 32; ++j) {
    bool match = true;
    for (int t = 0; t < 6; ++t) {
      const auto i = static_cast<std::size_t>(j * 6 + t);
      match &= gv[i] == tv[i];
      if (t < tl[static_cast<std::size_t>(j)]) {
        const float* z    = lv.data() + i * 256;
        int          best = 0;
        for (int k = 1; k < 256; ++k)
          if (z[k] > z[best]) best = k;
        correct += best == tv[i];
        ++tokens;
      }
    }
    exact += match;
  }
  check::Require(lm::SameBits(deployed.Arrays(), weights), "inference immutable");
  const float   ce = out.at("loss").item<float>();
  std::ofstream metrics(root / "metrics.json");
  metrics << "{\"parameters\":5760,\"epochs\":" << o.epochs << ",\"updates\":" << updates << ",\"test_token_ce\":" << ce
          << ",\"teacher_token_accuracy\":" << double(correct) / tokens
          << ",\"encoded_greedy_exact_accuracy\":" << exact / 32.0 << ",\"native_fd_count\":" << fd_count
          << ",\"native_fd_error\":" << fd_error << "}\n";
  std::cout << "testTokenCE=" << ce << " teacherTokenAccuracy=" << double(correct) / tokens << " greedyExact=" << exact
            << "/32; " << fd_count << " nativeFD maxError=" << fd_error
            << " padding/future/empty/restore/labelFree/immutable PASS\n";

  if (!init.empty() && o.epochs == 3) {
    double firsts = 0;
    for (auto f : {"initial_arrays.npz", "initial_outputs.npz", "first_batch.npz", "first_forward.npz",
                   "initial_gradients.npz", "first_after.npz"})
      firsts = std::max(firsts, lm::CompareRecord(o, f, nn::load_npz((root / f).string())));
    check::Require(firsts >= 0 && firsts <= 2e-5, "replayed initial forward/gradients/first update match TF");
    for (auto f : {"model_arrays.npz", "final_gradients.npz", "outputs.npz", "decoded.npz", "padding_outputs.npz",
                   "future_outputs.npz", "empty_outputs.npz"})
      lm::CompareRecord(o, f, nn::load_npz((root / f).string()));
  }
  std::cout << "wall " << std::chrono::duration<double>(std::chrono::steady_clock::now() - started).count() << " s\n";
  return 0;
}

}  // namespace

int main(int argc, char** argv) {
  try {
    return Run(lm::ParseOptions(argc, argv, "transformer_nmt", true));
  } catch (const std::exception& e) {
    std::cerr << e.what() << '\n';
    return 1;
  }
}

