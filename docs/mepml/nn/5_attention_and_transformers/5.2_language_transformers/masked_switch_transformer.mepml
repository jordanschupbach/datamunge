//? Title: Masked character Switch Transformer
//? Lang: en

> Masked character Switch Transformer

The model reads 16-character windows from Tiny Shakespeare with three
characters replaced by a mask token in each window. Bidirectional
attention lets every position use both left and right context. The
character head predicts the original character at each masked position.

A router assigns each token to its highest-scoring expert. Each of four
experts accepts the first 32 tokens assigned to it in the minibatch.
Accepted tokens receive the expert's output scaled by their router
probability. Overflow tokens retain the residual stream with zero expert
contribution. The training objective adds a load-balancing term to the
masked negative log likelihood. This term uses the fraction of tokens
routed to each expert before capacity clipping and the average probability
assigned to that expert by all tokens.

The experiment trains for three epochs and evaluates the same eight
held-out windows after each epoch. Datamunge initializes its own weights.
The small fixed test batch measures this particular fit.

```{cpp, results="markdown", file="figures/masked_switch_transformer.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

int main() {
  namespace n = dm::nn;
  const auto root = std::filesystem::path(dm::datasets::prepare_example_data("character_rnn"));
  const auto arrays = n::load_npz((root / "character_rnn.npz").string());
  const std::map<std::string,n::Tensor> corpus(arrays.begin(), arrays.end());
  const auto fit = n::slice_axis(corpus.at("fit_input"), 1, 0, 16);
  const auto gold = n::slice(corpus.at("test_input"), {0, 0}, {8, 16});
  std::mt19937 eval_rng(41427), train_rng(41428);
  const auto observed = n::mask_character_positions(gold, eval_rng, 3);
  const auto masked_loss = [](const n::Tensor& logits, const n::Tensor& input, const n::Tensor& target) {
    const auto mask = n::cast(n::equal(input.reshape({-1}), 65), logits.dtype());
    const auto nll = n::sparse_softmax_cross_entropy(logits, target.reshape({-1}), n::Reduction::None);
    return n::sum(mask * nll) / n::sum(mask);
  };
  n::ParameterStore parameters(41426);
  constexpr int capacity = 32;
  const auto evaluate = [&] {
    n::NoGradGuard guard;
    const auto output = n::switch_character_model(parameters, observed, capacity);
    return masked_loss(output.logits, observed, gold).item();
  };
  std::vector<double> epoch{0}, history{evaluate()};
  n::Optimizer optimizer(parameters, .003, {.kind=n::OptimizerKind::Adam});
  n::BatchOrder order(fit.size(0), 8, 41429);
  int updates = 0;
  for (int i = 1; i <= 3; ++i) {
    order.begin_epoch();
    for (auto batch = order.next(); !batch.empty(); batch = order.next()) {
      const auto target = n::take_rows(fit, batch);
      const auto input = n::mask_character_positions(target, train_rng, 3);
      const auto output = n::switch_character_model(parameters, input, capacity);
      optimizer.minimize(masked_loss(output.logits, input, target) + .03 * output.routing.balance);
      ++updates;
    }
    epoch.push_back(i);
    history.push_back(evaluate());
  }
  n::NoGradGuard guard;
  const auto output = n::switch_character_model(parameters, observed, capacity);
  const auto route = output.routing.route.to_vector<int>();
  const auto slots = output.routing.slot.to_vector<std::int64_t>();
  const auto contribution = output.routing.contribution.to_vector<float>();
  std::vector<double> experts{1, 2, 3, 4}, counts(4), accepted(4);
  for (std::size_t i = 0; i < route.size(); ++i) {
    if (slots[i] != counts[route[i]]++) throw std::runtime_error("unexpected expert slot");
    if (slots[i] < capacity) {
      ++accepted[route[i]];
    } else {
      for (int j = 0; j < 24; ++j)
        if (contribution[i * 24 + j] != 0) throw std::runtime_error("overflow contributed");
    }
  }
  const auto overflow = static_cast<int>(route.size() - std::accumulate(accepted.begin(), accepted.end(), 0.));
  if (updates != 48 || overflow <= 0 || !std::isfinite(history.back()))
    throw std::runtime_error("unexpected update count, overflow or loss");
  std::print("| Updates | Starting test NLL | Final test NLL | Overflow tokens |\n|---:|---:|---:|---:|\n");
  std::print("| {} | {:.4f} | {:.4f} | {} / {} |\n", updates, history.front(), history.back(), overflow, route.size());
  std::filesystem::create_directories("build");
  n::save_npz("build/masked_switch_transformer.npz",
      {{"input", observed}, {"target", gold}, {"loss", n::scalar(history.back())},
       {"hidden", output.hidden}, {"probability", output.routing.probabilities},
       {"route", output.routing.route}, {"slot", output.routing.slot},
       {"balance", output.routing.balance}, {"contribution", output.routing.contribution},
       {"logits", output.logits}});
  auto fit_plot = dm::graphics::RPlot::create();
  fit_plot.lines(epoch, history, "held-out NLL", {37, 99, 235})
      .points(epoch, history, "", {37, 99, 235}, 4)
      .title("Masked prediction").x_label("Epoch").y_label("Negative log likelihood");
  auto routing_plot = dm::graphics::RPlot::create();
  routing_plot.bars(experts, counts, "Routed", {189, 204, 230})
      .bars(experts, accepted, "Accepted", {37, 99, 235})
      .title("Held-out routing").x_label("Expert").y_label("Tokens");
  dm::graphics::RLayout::create(1, 2).add(fit_plot).add(routing_plot)
      .size(1100, 420).fit_panels().save_svg("build/masked_switch_transformer.svg");
}
```
