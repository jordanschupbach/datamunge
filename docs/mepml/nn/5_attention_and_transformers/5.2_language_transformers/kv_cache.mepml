int main(){auto arrays=dm::nn::load_npz("build/recovered-language/models/kv_cache/generation.npz");auto get=[&](const std::string&key){return std::find_if(arrays.begin(),arrays.end(),[&](const auto&v){return v.first==key;})->second;};auto errors=dm::nn::max(dm::nn::abs(get("logits")-get("uncached_logits")),{1}).to_vector<double>();std::vector<double>x(errors.size());std::iota(x.begin(),x.end(),0.);dm::graphics::RPlot::create().lines(x,errors,"max absolute cache error",{37,99,235}).points(x,errors,"source values",{37,99,235},4).title("kv cache actual source diagnostic").size(1100,600).save_svg("build/kv_cache_validation.svg");}
