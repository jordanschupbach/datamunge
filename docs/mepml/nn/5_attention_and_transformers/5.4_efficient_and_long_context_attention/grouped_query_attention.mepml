//? Title: Grouped-query causal attention and prefix decoding
//? Lang: en

> Grouped-query causal attention and prefix decoding

Four query heads share one, two, or four key/value heads. One group is
multi-query attention, two groups give two queries per key/value head,
and four groups recover ordinary multi-head attention. The stored key and
value count scales with the number of groups. Query head count stays fixed.

The report compares a complete causal pass with one query at a time
over its key/value prefix. It differentiates a weighted output sum with
respect to all three projected tensors, including the shared keys and
values. This is a tensor and gradient experiment with fixed random inputs.

```{cpp, results="markdown", file="figures/grouped_query_attention.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

namespace n=dm::nn;

int main() {
  std::mt19937 rng(42201);
  const auto random=[&](const n::Shape &shape) {
    std::normal_distribution<float> normal(0.f,.6f);
    std::vector<float> values(n::shape_numel(shape));
    for(float &value:values) value=normal(rng);
    return n::from_vector(values,shape);
  };
  auto figure=dm::graphics::RLayout::create(1,3);
  const auto axis=n::arange(0,9).to_vector<double>();
  std::filesystem::create_directories("build");
  std::print("| KV heads | Stored scalars per token | Maximum prefix error |\n|---:|---:|---:|\n");
  for(int groups : {1,2,4}) {
    const auto q=random({2,4,9,5}).requires_grad_(true);
    const auto k=random({2,groups,9,5}).requires_grad_(true);
    const auto v=random(k.shape()).requires_grad_(true);
    const auto upstream=random(q.shape());
    const auto result=n::grouped_query_attention(q,k,v,{.causal=true,.need_weights=true});
    const auto adjoints=n::grad(n::sum(result.output*upstream),{q,k,v});
    n::NoGradGuard guard;
    double error=0.;
    for(int t=0;t<9;++t) {
      const auto decoded=n::grouped_query_attention(n::slice_axis(q,2,t,t+1),
          n::slice_axis(k,2,0,t+1),n::slice_axis(v,2,0,t+1),{.causal=true}).output;
      error=std::max(error,n::max(n::abs(decoded-n::slice_axis(result.output,2,t,t+1))).item());
    }
    if(error>1e-6) throw std::runtime_error("prefix decoding differs");
    std::print("| {} | {} | {:.3g} |\n",groups,2*groups*5,error);
    n::save_npz("build/grouped_query_"+std::to_string(groups)+".npz",
        {{"q",q},{"k",k},{"v",v},{"upstream",upstream},{"output",result.output},
         {"attention",result.weights},{"dq",adjoints[0]},{"dk",adjoints[1]},{"dv",adjoints[2]}});
    const auto weights=n::select(n::select(result.weights,0,0),0,0);
    std::vector<std::vector<double>> columns;
    for(int j=0;j<9;++j) columns.push_back(n::select(weights,1,j).to_vector<double>());
    auto plot=dm::graphics::RPlot::create();
    plot.image(axis,axis,columns,dm::graphics::terrain_colors(32),0.,1.)
        .title(std::to_string(groups)+" KV heads").x_label("Key position").y_label("Query position");
    figure.add(plot);
  }
  figure.size(1160,400).fit_panels().save_svg("build/grouped_query_attention.svg");
}
```
