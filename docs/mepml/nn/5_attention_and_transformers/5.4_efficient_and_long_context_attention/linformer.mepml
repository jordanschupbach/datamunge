}

namespace paths {

inline std::filesystem::path DataRoot() {
  return dataset_assets::DataRoot();
}

/// DataRoot() / name, e.g. Dataset("mnist").
inline std::filesystem::path Dataset(const std::string& name) { if(name=="cifar10"||name=="character_rnn")return DataRoot()/name;return std::filesystem::path(dm::datasets::prepare_example_data("nn-completion-assets"))/name; }

inline std::filesystem::path OutputRoot(){return std::filesystem::absolute("build/nn-completion");}

/// OutputRoot() / relative, created as a directory.
inline std::filesystem::path OutputDir(const std::string& relative) {
  auto dir = OutputRoot() / relative;
  std::filesystem::create_directories(dir);
  return dir;
}

}  // namespace paths

namespace replay {

namespace nn = datamunge::nn;
using nn::Tensor;
using Map = std::map<std::string, Tensor>;

/// tflow's recorded output directory for an example (its output/models/<name>).
inline std::filesystem::path TfModels(const std::string& name) {
  return paths::DataRoot().parent_path() / "models" / name;
}

inline Tensor Get(const nn::NamedTensors& arrays, const std::string& key) {
  for (const auto& [name, t] : arrays)
    if (name == key) return t;
  throw std::runtime_error("missing array " + key);
}

inline Map ToMap(const nn::NamedTensors& arrays) { return {arrays.begin(), arrays.end()}; }
inline nn::NamedTensors ToNamed(const Map& m) { return {m.begin(), m.end()}; }

/// Rows `rows` (axis 0) of every array.
inline Map Rows(const Map& m, const std::vector<std::int64_t>& rows) {
  Map out;
  for (const auto& [k, v] : m) out[k] = nn::take_rows(v, rows);
  return out;
}

/// {key: arrays["<split>_<key>"]} for each key.
inline Map Split(const nn::NamedTensors& arrays, const std::string& split, const std::vector<std::string>& keys) {
  Map out;
  for (const auto& k : keys) out[k] = Get(arrays, split + "_" + k);
  return out;
}

inline double MaxAbsDiff(const Tensor& a, const Tensor& b) {
  const auto x = a.to_vector<double>(), y = b.to_vector<double>();
  check::Require(x.size() == y.size(), "compared tensors have the same size");
  double m = 0;
  for (std::size_t i = 0; i < x.size(); ++i) m = std::max(m, std::abs(x[i] - y[i]));
  return m;
}

/// Bit-identical values (dtype and shape included).
inline bool SameBits(const Tensor& a, const Tensor& b) {
  if (a.dtype() != b.dtype() || a.shape() != b.shape()) return false;
  auto same = [](const auto& x, const auto& y) {
    return x.size() == y.size() && (x.empty() || std::memcmp(x.data(), y.data(), x.size() * sizeof(x[0])) == 0);
  };
  switch (a.dtype()) {
    case nn::DType::Float32: return same(a.to_vector<float>(), b.to_vector<float>());
    case nn::DType::Float64: return same(a.to_vector<double>(), b.to_vector<double>());
    case nn::DType::Int32: return same(a.to_vector<std::int32_t>(), b.to_vector<std::int32_t>());
    default: return same(a.to_vector<std::int64_t>(), b.to_vector<std::int64_t>());
  }
}

inline bool SameBits(const Map& a, const Map& b) {
  if (a.size() != b.size()) return false;
  for (const auto& [k, v] : a)
    if (!b.count(k) || !SameBits(v, b.at(k))) return false;
  return true;
}

/// Copies of every parameter, by name.
inline Map Arrays(const nn::ParameterStore& p) {
  Map out;
  for (const auto& name : p.names()) out[name] = p.at(name).detach().clone();
  return out;
}

/// Gradients aligned with p.names(), by name.
inline Map Named(const nn::ParameterStore& p, const std::vector<Tensor>& g) {
  Map out;
  for (std::size_t i = 0; i < g.size(); ++i) out[p.names()[i]] = g[i].defined() ? g[i].detach() : nn::zeros_like(p.parameters()[i]).detach();
  return out;
}

/// Overwrites every parameter of `p` from an .npz (e.g. TF's initial_arrays.npz),
/// which must hold exactly p's names.
inline void LoadInto(nn::ParameterStore& p, const std::filesystem::path& file) {
  const auto arrays = nn::load_npz(file.string());
  check::Require(arrays.size() == p.size(), "array file covers exactly the model's parameters: " + file.string());
  for (const auto& [name, value] : arrays) {
    check::Require(p.contains(name), "array " + name + " is a model parameter");
    p.set(name, nn::cast(value, p.at(name).dtype()));
  }
}

/// max |a[k] - b[k]| over the keys of `a` (all must exist in `b`).
inline double MaxDiff(const Map& a, const Map& b) {
  double m = 0;
  for (const auto& [k, v] : a) {
    check::Require(b.count(k) > 0, "reference has array " + k);
    m = std::max(m, MaxAbsDiff(v, b.at(k)));
  }
  return m;
}
inline double MaxDiff(const Map& a, const std::filesystem::path& file) { return MaxDiff(a, ToMap(nn::load_npz(file.string()))); }

/// Column `column` (0-based) of a tab-separated history file with a header line.
inline std::vector<double> History(const std::filesystem::path& file, int column = 1) {
  std::ifstream       in(file);
  std::string         line;
  std::vector<double> out;
  std::getline(in, line);
  while (std::getline(in, line)) {
    std::stringstream ss(line);
    std::string       cell;
    for (int c = 0; c <= column && std::getline(ss, cell, '\t'); ++c)
      if (c == column) out.push_back(std::stod(cell));
  }
  return out;
}

inline nn::OptimizerConfig Adam() {
  nn::OptimizerConfig c;
  c.kind = nn::OptimizerKind::Adam;
  return c;
}

/// Copies `files` from `from` to `to` when present.
inline void CopyAssets(const std::filesystem::path& from, const std::filesystem::path& to,
                       const std::vector<std::string>& files) {
  for (const auto& f : files)
    if (std::filesystem::exists(from / f))
      std::filesystem::copy_file(from / f, to / f, std::filesystem::copy_options::overwrite_existing);
}

}  // namespace replay

namespace vit {using namespace dm::nn::models::vit;
inline Tensor Loss(const Tensor& logits, const Tensor& labels) {
  return -nn::mean(
      nn::sum(
          nn::one_hot(labels, 10, 1, 0, nn::DType::Float32) * nn::log_softmax(logits, -1), {1}));
}
class Model {
 public:
  nn::ParameterStore             parameters{48301};
  std::unique_ptr<nn::Optimizer> optimizer;
  explicit Model(bool training = true) {
    {
      nn::NoGradGuard guard;
      Forward(parameters, nn::zeros({1, 32, 32, 3}));
    }
    if (training) {
      nn::OptimizerConfig c;
      c.kind    = nn::OptimizerKind::Adam;
      optimizer = std::make_unique<nn::Optimizer>(parameters, .003, c);
    }
  }
  static void Validate(const A& b) {
    const auto& x = b.at("images");
    check::Require(
        x.dtype() == nn::DType::Float32 && x.dim() == 4 && x.size(0) > 0 && x.size(1) == 32 &&
            x.size(2) == 32 && x.size(3) == 3,
        "ViT32x32RGB images");
    for (float v : x.to_vector<float>())
      check::Require(std::isfinite(v), "finite ViT pixels");
  }
  A Run(const A& b, bool gradients = false, const A& overrides = {}) {
    Validate(b);
    A saved;
    for (const auto& [k, v] : overrides) {
      saved[k] = parameters.at(k).detach().clone();
      parameters.set(k, v);
    }
    struct Restore {
      nn::ParameterStore& p;
      A&                  saved;
      ~Restore() {
        for (const auto& [k, v] : saved)
          p.set(k, v);
      }
    } restore{parameters, saved};
    auto                x    = b.at("images").detach().requires_grad_();
    auto                path = Forward(parameters, x);
    auto                loss = Loss(path.logits, b.at("labels"));
    std::vector<Tensor> inputs{x};
    if (gradients) {
      auto values = parameters.parameters();
      inputs.insert(inputs.end(), values.begin(), values.end());
    }
    auto g = nn::grad(loss, inputs);
    A    out{
           {"logits", path.logits},
           {"patches", path.patches},
           {"embedded", path.embedded},
           {"hidden", path.hidden},
           {"attention0", path.attention[0]},
           {"attention1", path.attention[1]},
           {"state0", path.states[0]},
           {"state1", path.states[1]},
           {"loss", loss},
           {"input_gradient", g[0]}};
    if (gradients)
      for (std::size_t i = 0; i < parameters.size(); ++i)
        out[parameters.names()[i]] = g[i + 1];
    for (auto& [k, v] : out)
      v = v.detach().clone();
    return out;
  }
  Tensor Predict(const A& b) {
    Validate(b);
    nn::NoGradGuard guard;
    return Forward(parameters, b.at("images")).logits;
  }
  void Update(const A& b) {
    Validate(b);
    auto path = Forward(parameters, b.at("images"));
    optimizer->minimize(Loss(path.logits, b.at("labels")));
  }
  A Arrays() const { return replay::Arrays(parameters); }
};
inline A Pool(const A& data, const std::string& split) {
  A out;
  for (const auto key : {"images", "labels", "source_ids"})
    out[key] = data.at(split + "_" + key);
  return out;
}
inline Tensor Permute(const Tensor& images) {
  const auto n       = images.size(0);
  auto       patches = nn::reshape(
      nn::transpose(nn::reshape(images, {n, 4, 8, 4, 8, 3}), {0, 1, 3, 2, 4, 5}), {n, 16, 8, 8, 3});
  return nn::reshape(
      nn::transpose(nn::reshape(nn::reverse(patches, {1}), {n, 4, 4, 8, 8, 3}), {0, 1, 3, 2, 4, 5}),
      images.shape());
}
} // namespace vit

namespace linformer {using namespace dm::nn::models::linformer;using vit::Loss;

class Model {
 public:
  nn::ParameterStore             parameters{50301};
  std::unique_ptr<nn::Optimizer> optimizer;
  explicit Model(bool training = true) {
    {
      nn::NoGradGuard guard;
      Forward(parameters, nn::zeros({1, 32, 32, 3}));
    }
    if (training) {
      nn::OptimizerConfig c;
      c.kind    = nn::OptimizerKind::Adam;
      optimizer = std::make_unique<nn::Optimizer>(parameters, .003, c);
    }
  }
  static void Validate(const A& b) {
    const auto& x = b.at("images");
    check::Require(
        x.dtype() == nn::DType::Float32 && x.dim() == 4 && x.size(0) > 0 && x.size(1) == 32 &&
            x.size(2) == 32 && x.size(3) == 3,
        "ViT32x32RGB images");
    for (float v : x.to_vector<float>())
      check::Require(std::isfinite(v), "finite ViT pixels");
  }
  A Run(const A& b, bool gradients = false, const A& overrides = {}) {
    Validate(b);
    A saved;
    for (const auto& [k, v] : overrides) {
      saved[k] = parameters.at(k).detach().clone();
      parameters.set(k, v);
    }
    struct Restore {
      nn::ParameterStore& p;
      A&                  saved;
      ~Restore() {
        for (const auto& [k, v] : saved)
          p.set(k, v);
      }
    } restore{parameters, saved};
    auto                x    = b.at("images").detach().requires_grad_();
    auto                path = Forward(parameters, x);
    auto                loss = Loss(path.logits, b.at("labels"));
    std::vector<Tensor> inputs{x};
    if (gradients) {
      auto values = parameters.parameters();
      inputs.insert(inputs.end(), values.begin(), values.end());
    }
    auto g = nn::grad(loss, inputs);
    A    out{
           {"logits", path.logits},
           {"patches", path.patches},
           {"embedded", path.embedded},
           {"hidden", path.hidden},
           {"attention0", path.attention[0]},
           {"attention1", path.attention[1]},
           {"state0", path.states[0]},
           {"state1", path.states[1]},
           {"loss", loss},
           {"input_gradient", g[0]}};
    for (int i = 0; i < 2; ++i) {
      auto suffix                 = std::to_string(i);
      out["q" + suffix]           = path.queries[i];
      out["k" + suffix]           = path.keys[i];
      out["v" + suffix]           = path.values[i];
      out["projected_k" + suffix] = path.projected_keys[i];
      out["projected_v" + suffix] = path.projected_values[i];
    }
    if (gradients)
      for (std::size_t i = 0; i < parameters.size(); ++i)
        out[parameters.names()[i]] = g[i + 1];
    for (auto& [k, v] : out)
      v = v.detach().clone();
    return out;
  }
  Tensor Predict(const A& b) {
    Validate(b);
    nn::NoGradGuard guard;
    return Forward(parameters, b.at("images")).logits;
  }
  void Update(const A& b) {
    Validate(b);
    auto path = Forward(parameters, b.at("images"));
    optimizer->minimize(Loss(path.logits, b.at("labels")));
  }
  A Arrays() const { return replay::Arrays(parameters); }
};
} // namespace linformer

namespace nn = datamunge::nn;
namespace {
void Save(const std::filesystem::path& file, const vit::A& values) {
  nn::save_npz(file.string(), replay::ToNamed(values));
}
nn::Tensor Pattern(const nn::Shape& shape, float phase) {
  std::vector<float> values(nn::shape_numel(shape));
  for (std::size_t i = 0; i < values.size(); ++i)
    values[i] = std::sin(float(i + 1) * .37f + phase) * .4f;
  return nn::from_vector(values, shape);
}
vit::A Operator(vit::A b) {
  std::vector<nn::Tensor> inputs;
  for (const auto key : {"q", "k", "v", "E", "F"}) {
    b[key] = b.at(key).detach().clone().requires_grad_();
    inputs.push_back(b.at(key));
  }
  auto path = linformer::Context(b.at("q"), b.at("k"), b.at("v"), b.at("E"), b.at("F"));
  auto g    = nn::grad(nn::sum(path.context * b.at("weight")), inputs);
  return {
      {"context", path.context.detach()},
      {"attention", path.attention.detach()},
      {"dq", g[0]},
      {"dk", g[1]},
      {"dv", g[2]},
      {"dE", g[3]},
      {"dF", g[4]}};
}
void OperatorChecks(const std::filesystem::path& root) {
  vit::A b{
      {"q", Pattern({1, 2, 5, 4}, .1f)},
      {"k", Pattern({1, 2, 5, 4}, .3f)},
      {"v", Pattern({1, 2, 5, 4}, .7f)},
      {"weight", Pattern({1, 2, 5, 4}, .9f)},
      {"E", nn::eye(5)},
      {"F", nn::eye(5)}};
  auto identity = Operator(b);
  auto q = b.at("q").detach().requires_grad_(), k = b.at("k").detach().requires_grad_(),
       v     = b.at("v").detach().requires_grad_();
  auto dense = nn::matmul(nn::softmax(nn::matmul(q, k, false, true) * .5, -1), v);
  auto full  = nn::grad(nn::sum(dense * b.at("weight")), {q, k, v});
  check::Near(
      replay::MaxAbsDiff(identity.at("context"), dense),
      0,
      2e-6,
      "identity E/F recovers full attention");
  for (int i = 0; i < 3; ++i)
    check::Near(
        replay::MaxAbsDiff(
            identity.at(
                i == 0   ? "dq"
                : i == 1 ? "dk"
                         : "dv"),
            full[i]),
        0,
        2e-6,
        "identity Q/K/V derivatives match full attention");
  auto identity_out = identity;
  identity_out.erase("attention");
  identity_out["full_context"] = dense;
  identity_out["full_dq"]      = full[0];
  identity_out["full_dk"]      = full[1];
  identity_out["full_dv"]      = full[2];
  Save(root / "identity_inputs.npz", b);
  Save(root / "identity_outputs.npz", identity_out);
  b["E"]     = Pattern({5, 3}, .4f);
  b["F"]     = Pattern({5, 3}, .8f);
  auto rank3 = Operator(b);
  Save(root / "operator_inputs.npz", b);
  Save(root / "operator_outputs.npz", rank3);
  const auto tf = replay::TfModels("linformer");
  if (std::filesystem::exists(tf / "operator_outputs.npz"))
    check::Near(
        replay::MaxDiff(rank3, tf / "operator_outputs.npz"),
        0,
        2e-6,
        "TF rank3 forward/all operator derivatives");
  b["F"]    = nn::zeros({5, 3});
  auto zero = Operator(b);
  for (const auto key : {"context", "dq", "dk", "dv", "dE"})
    check::Near(
        nn::max(nn::abs(zero.at(key))).item(), 0, 0, "zeroF blocks context/Q/K/V/E derivatives");
  check::Require(
      nn::sum(nn::abs(zero.at("dF"))).item() > 1e-6, "F receives value-path gradient at zero");
  std::ofstream scaling(root / "scaling.tsv");
  scaling << "length\trank\theads\tactual_score_elements\ttheoretical_full_score_elements\n";
  nn::NoGradGuard guard;
  for (int n : {16, 64, 256, 1024}) {
    vit::A a{
        {"q", Pattern({1, 2, n, 4}, .1f)},
        {"k", Pattern({1, 2, n, 4}, .3f)},
        {"v", Pattern({1, 2, n, 4}, .7f)},
        {"weight", Pattern({1, 2, n, 4}, .9f)},
        {"E", Pattern({n, 4}, .4f)},
        {"F", Pattern({n, 4}, .8f)}};
    auto out = linformer::Context(a.at("q"), a.at("k"), a.at("v"), a.at("E"), a.at("F"));
    check::Require(
        out.attention.shape() == nn::Shape({1, 2, n, 4}) &&
            out.context.shape() == nn::Shape({1, 2, n, 4}),
        "linear score/context shapes at rank4");
    scaling << n << "\t4\t2\t" << out.attention.numel() << '\t' << 2 * n * n << '\n';
    Save(root / ("scaling" + std::to_string(n) + "_inputs.npz"), a);
    Save(
        root / ("scaling" + std::to_string(n) + "_outputs.npz"),
        {{"attention", out.attention}, {"context", out.context}});
  }
  std::cout << "identity/full QKV gradients,rank3/zeroF,N16..1024 fixed-rank shapes PASS\n";
}
void Run(int epochs) {
  const auto root   = paths::OutputDir("models/linformer"),
             assets = paths::Dataset("vision_transformer");
  OperatorChecks(root);
  replay::CopyAssets(assets, root, {"data.npz", "manifest.json"});
  auto data = replay::ToMap(nn::load_npz((root / "data.npz").string()));
  auto fit = vit::Pool(data, "fit"), validation = vit::Pool(data, "validation"),
       test = vit::Pool(data, "test");
  linformer::Model model;
  check::Require(
      model.parameters.count() == 3266 && model.parameters.size() == 36,
      "3266 parameters/36 length-projection/attention tensors");
  const auto tf        = replay::TfModels("linformer");
  const bool replay_tf = std::filesystem::exists(tf / "initial_arrays.npz");
  if (replay_tf)
    replay::LoadInto(model.parameters, tf / "initial_arrays.npz");
  auto compare = [&](const vit::A& out, const std::string& file, double tolerance) {
    if (replay_tf && std::filesystem::exists(tf / file)) {
      const double error = replay::MaxDiff(out, tf / file);
      check::Near(error, 0, tolerance, "TF replay " + file);
      std::cout << "TF " << file << " max difference=" << error << std::endl;
    }
  };
  Save(root / "initial_arrays.npz", model.Arrays());
  auto initial = model.Run(test);
  Save(root / "initial_outputs.npz", initial);
  compare(initial, "initial_outputs.npz", 5e-5);
  std::vector<float> ramp(3072);
  for (int i = 0; i < 3072; ++i)
    ramp[i] = i / 3071.f;
  auto image   = nn::from_vector(ramp, {1, 32, 32, 3});
  auto fixture = model.Run({{"images", image}, {"labels", nn::zeros({1}, nn::DType::Int32)}});
  auto patches = fixture.at("patches").to_vector<float>();
  for (int p = 0; p < 16; ++p)
    for (int y = 0; y < 8; ++y)
      for (int x = 0; x < 8; ++x)
        for (int c = 0; c < 3; ++c)
          check::Near(
              patches[p * 192 + (y * 8 + x) * 3 + c],
              ramp[(((p / 4) * 8 + y) * 32 + (p % 4) * 8 + x) * 3 + c],
              0,
              "exact RGB patch indexing");
  Save(root / "patch_fixture.npz", {{"images", image}, {"patches", fixture.at("patches")}});
  nn::BatchOrder order(128, 8, 50307);
  std::ofstream  history(root / "history.tsv"), batches(root / "batches.tsv");
  history << "epoch\tvalidation_ce\n";
  batches << "epoch\tstep\trow\tsource_id\n";
  int    updates = 0;
  vit::A first;
  for (int epoch = 1; epoch <= epochs; ++epoch) {
    order.begin_epoch();
    for (;;) {
      auto rows = order.next();
      if (rows.empty())
        break;
      auto b = replay::Rows(fit, rows);
      if (!updates) {
        first = b;
        Save(root / "first_batch.npz", b);
        auto g = model.Run(b, true);
        Save(root / "initial_gradients.npz", g);
        compare(g, "initial_gradients.npz", 1e-4);
      }
      model.Update(b);
      if (!updates) {
        Save(root / "first_after.npz", model.Arrays());
      }
      auto ids = fit.at("source_ids").to_vector<int>();
      for (auto row : rows)
        batches << epoch << '\t' << updates << '\t' << row << '\t' << ids[row] << '\n';
      ++updates;
    }
    auto out = model.Run(validation);
    history << epoch << '\t' << out.at("loss").item() << '\n';
    const auto prefix = "epoch" + std::to_string(epoch);
    Save(root / (prefix + "_validation.npz"), out);
    Save(root / (prefix + "_arrays.npz"), model.Arrays());
    compare(out, prefix + "_validation.npz", 5e-5);
    std::cout << "epoch=" << epoch << " validationCE=" << out.at("loss").item() << std::endl;
  }
  auto final = model.Arrays(), grad = model.Run(first, true);
  Save(root / "model_arrays.npz", final);
  Save(root / "final_gradients.npz", grad);
  compare(grad, "final_gradients.npz", 1e-4);
  model.parameters.save((root / "final.npz").string());
  linformer::Model deployed(false);
  deployed.parameters.load((root / "final.npz").string());
  check::Require(
      replay::SameBits(model.Arrays(), deployed.Arrays()), "36 tensors restored bitexact");
  auto before = deployed.Arrays(), out = deployed.Run(test);
  Save(root / "outputs.npz", out);
  compare(out, "outputs.npz", 5e-5);
  check::Near(
      replay::MaxAbsDiff(deployed.Predict({{"images", test.at("images")}}), out.at("logits")),
      0,
      0,
      "image-only inference");
  vit::A zero_e, zero_f;
  for (const auto& [name, value] : final)
    if (name.size() > 2 &&
        (name.substr(name.size() - 2) == "/E" || name.substr(name.size() - 2) == "/F"))
      (name.back() == 'E' ? zero_e : zero_f)[name] = nn::zeros(value.shape());
  auto noe = deployed.Run(test, false, zero_e), nof = deployed.Run(test, false, zero_f);
  Save(root / "zero_E_outputs.npz", noe);
  Save(root / "zero_F_outputs.npz", nof);
  const double e_effect = replay::MaxAbsDiff(noe.at("logits"), out.at("logits")),
               f_effect = replay::MaxAbsDiff(nof.at("logits"), out.at("logits"));
  check::Require(
      e_effect > 1e-6 && f_effect > 1e-6, "both learned key/value projections affect predictions");
  for (int layer = 0; layer < 2; ++layer) {
    auto attention = noe.at("attention" + std::to_string(layer));
    check::Require(
        attention.shape() == nn::Shape({32, 2, 17, 4}), "17query by4compressedkey scores");
    for (float value : attention.to_vector<float>())
      check::Near(value, .25, 0, "zeroE makes four basis scores equal");
  }
  const auto nof_logits = nof.at("logits").to_vector<float>();
  for (int row = 1; row < 32; ++row)
    for (int c = 0; c < 10; ++c)
      check::Near(nof_logits[row * 10 + c], nof_logits[c], 0, "zeroF cuts image content from CLS");
  check::Near(
      nn::max(nn::abs(nof.at("input_gradient"))).item(), 0, 0, "zeroF pixel derivative exact zero");
  for (int row = 0; row < 4; ++row)
    check::Near(
        replay::MaxAbsDiff(
            deployed.Predict(replay::Rows(test, {row})),
            nn::slice(out.at("logits"), {row, 0}, {1, 10})),
        0,
        2e-6,
        "Linformer batch isolation");
  double fd    = 0;
  int    count = 0;
  for (const auto& name : model.parameters.names()) {
    const auto value  = final.at(name);
    auto       values = value.to_vector<float>();
    for (int i : {0, int(values.size() / 2), int(values.size() - 1)}) {
      const float old = values[i];
      values[i]       = old + .0005f;
      auto plus       = model.Run(first, false, {{name, nn::from_vector(values, value.shape())}})
                      .at("loss")
                      .item();
      values[i]  = old - .0005f;
      auto minus = model.Run(first, false, {{name, nn::from_vector(values, value.shape())}})
                       .at("loss")
                       .item();
      values[i] = old;
      fd = std::max(fd, std::abs((plus - minus) / .001 - grad.at(name).to_vector<float>()[i]));
      ++count;
    }
  }
  check::Require(fd < .003, "native Linformer all-parameter finite differences");
  check::Require(
      replay::SameBits(before, deployed.Arrays()), "Linformer inference and controls immutable");
  const auto z       = out.at("logits").to_vector<float>();
  const auto labels  = test.at("labels").to_vector<int>();
  int        correct = 0;
  for (int i = 0; i < 32; ++i) {
    int best = 0;
    for (int c = 1; c < 10; ++c)
      if (z[i * 10 + c] > z[i * 10 + best])
        best = c;
    correct += best == labels[i];
  }
  std::ofstream metrics(root / "metrics.json");
  metrics.precision(17);
  metrics << "{\"parameters\":3266,\"variables\":36,\"epochs\":" << epochs
          << ",\"updates\":" << updates << ",\"test_ce\":" << out.at("loss").item()
          << ",\"test_accuracy\":" << correct / 32. << ",\"zero_E_effect\":" << e_effect
          << ",\"zero_F_effect\":" << f_effect << ",\"native_fd_count\":" << count
          << ",\"native_fd_error\":" << fd << "}\n";
  std::cout << "testCE=" << out.at("loss").item() << " accuracy=" << correct << "/32; " << count
            << " FD max=" << fd << ";sequenceProjection/E/F/compression/restore/immutable PASS\n";
}
} // namespace
int main(int argc, char** argv) {
  try {
    nn::set_num_threads(2);
    int epochs = 3;
    for (int i = 1; i < argc; ++i) {
      std::string a = argv[i];
      check::Require(a.rfind("epochs=", 0) == 0, "epochs=N");
      epochs = std::stoi(a.substr(7));
    }
    check::Require(epochs > 0 && epochs <= 100, "epochs1..100");
    Run(epochs);
    return 0;
  } catch (const std::exception& e) {
    std::cerr << e.what() << '\n';
    return 1;
  }
}

