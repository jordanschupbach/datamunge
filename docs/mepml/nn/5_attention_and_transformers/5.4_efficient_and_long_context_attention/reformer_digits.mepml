//? Title: Reformer LSH attention on MNIST
//? Lang: en

> Reformer LSH attention on MNIST

Each attention head shares query and key projections. A fixed Gaussian
rotation hashes the seventeen class and patch tokens into eight buckets.
A stable sort groups tokens by bucket and preserves position within
each bucket. Attention reads the current and previous four-token chunks,
masks connections between different buckets, and downweights self
attention. The output returns to original token order before the residual
update.

The report fits two LSH blocks on MNIST and plots validation loss. Each
saved diagnostic starts with the sorted token index, followed by eight
candidate probabilities. The audit checks the sorting, mask and
attention probabilities against an independent NumPy reconstruction.

```{cpp, results="markdown", file="figures/reformer_digits.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

int main() {
  namespace n=dm::nn;
  const auto root=std::filesystem::path(dm::datasets::prepare_example_data("mnist-assets"))/"mnist";
  const auto train=n::load_mnist(root.string(),"train");
  const auto test=n::load_mnist(root.string(),"test");
  std::vector<int> train_ids(60000),test_ids(10000);
  std::iota(train_ids.begin(),train_ids.end(),0);
  std::iota(test_ids.begin(),test_ids.end(),0);
  std::mt19937 rng(41434);
  std::shuffle(train_ids.begin(),train_ids.end(),rng);
  std::shuffle(test_ids.begin(),test_ids.end(),rng);
  const auto ids=[](const std::vector<int>& order,int from,int count) {
    return n::from_vector(std::vector<int>(order.begin()+from,order.begin()+from+count));
  };
  const auto fit=ids(train_ids,0,1024),valid=ids(train_ids,1024,256),held=ids(test_ids,0,256);
  const auto x=n::gather(train.images,fit),y=n::gather(train.labels,fit);
  const auto vx=n::gather(train.images,valid),vy=n::gather(train.labels,valid);
  const auto tx=n::gather(test.images,held),ty=n::gather(test.labels,held);
  n::ParameterStore params(41433);
  const std::array features{n::models::reformer::Rotation(8,4,42001),
                            n::models::reformer::Rotation(8,4,42002)};
  const auto predict=[&](const n::Tensor& images) { return n::mnist_reformer(params,images,features); };
  (void)predict(n::slice_axis(x,0,0,1));
  n::Optimizer optimizer(params,.003,{.kind=n::OptimizerKind::Adam});
  n::BatchOrder batches(1024,32,41435);
  std::vector<double> curve;
  std::print("| Epoch | Validation NLL |\n|---:|---:|\n");
  for (int epoch=0;epoch<3;++epoch) {
    batches.begin_epoch();
    for (auto rows=batches.next();!rows.empty();rows=batches.next()) {
      const auto batch=n::from_vector(rows);
      const auto logits=predict(n::gather(x,batch)).logits;
      const auto loss=n::sparse_softmax_cross_entropy(logits,n::gather(y,batch));
      optimizer.step(n::grad(loss,optimizer.parameters()));
    }
    const n::NoGradGuard guard;
    curve.push_back(n::sparse_softmax_cross_entropy(predict(vx).logits,vy).item());
    std::print("| {} | {:.6f} |\n",epoch+1,curve.back());
  }
  const n::NoGradGuard guard;
  const auto result=predict(tx);
  const auto nll=n::sparse_softmax_cross_entropy(result.logits,ty);
  const int correct=n::sum(n::equal(n::argmax(result.logits,1),ty).to(n::DType::Int32)).item<int>();
  std::print("\nTest NLL {:.6f}. Correct predictions {}/256.\n",nll.item(),correct);
  const std::filesystem::path out="build/reformer_digits";
  std::filesystem::create_directories(out);
  n::NamedTensors weights;
  for (const auto& key:params.names()) weights.emplace_back(key,params.at(key));
  for (std::size_t i=0;i<features.size();++i)
    weights.emplace_back("block"+std::to_string(i)+"/attention/rotation",features[i]);
  n::save_npz((out/"weights.npz").string(),weights);
  n::save_npz((out/"audit.npz").string(),{{"fit_ids",fit},{"validation_ids",valid},{"test_ids",held},
      {"pixels",tx},{"labels",ty},{"patches",result.patches},{"embedded",result.embedded},
      {"logits",result.logits},{"nll",nll},{"lsh0",result.attention[0]},{"lsh1",result.attention[1]}});
  dm::graphics::RPlot::create().lines({1,2,3},curve,"Validation",{37,99,235})
      .points({1,2,3},curve,"Epochs",{37,99,235},5).title("Reformer on MNIST")
      .x_label("Epoch").y_label("Nats per image").size(800,460).save_svg("build/reformer_digits.svg");
}
```
