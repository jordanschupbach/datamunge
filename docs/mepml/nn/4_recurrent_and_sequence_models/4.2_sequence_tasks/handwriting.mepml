> Complete editable experiment

Historical comments in the preserved source describe the original experiment; the versioned reconstruction manifest above describes the active inputs. Objectives, optimizer ownership, update schedules, sampling and search remain here. Source finite-difference, padding, causal/label-independence, checkpoint and immutability controls remain active. Weak held-out outcomes are retained.

```{cpp, results="output", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -lpthread -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
namespace recovered_checkpoints {
inline std::filesystem::path Model(const std::string&name){auto p=std::filesystem::path(dm::datasets::data_home())/"nn-completion-checkpoints/models"/name;std::filesystem::create_directories(p);return p;}
}
// CMD: just run-nn handwriting
// Text-conditioned stroke synthesis with Graves monotonic windows and mixture density.
//
// Port of tflow's handwriting. Data: tflow's output/datasets/handwriting
// (data.npz: short real pen trajectories of 3-symbol prompts resampled to 33
// offset steps (dx, dy, pen-up), input = previous offset, target = next one;
// 140 fit / 40 validation / 40 test; ATTRIBUTION.txt).
// An 8-unit LSTM reads the previous offset and the previous soft window over
// the prompt; two Gaussian window components with monotonic centres pick the
// characters, and a 3-component bivariate Gaussian mixture plus a Bernoulli
// pen give the next-offset likelihood (1680 parameters). Adam .005, batch 8,
// three epochs (54 updates) on the mean per-step NLL.
// Checks: a mixture-density fixture (loss and its raw/target derivatives,
// compared with TF's density_fixture.npz when present); when tflow's recorded
// run is present, a replay from TF's initial weights (initial outputs with the
// stroke/text partials, first-batch gradients, history, final weights, and the
// seeded sample from the replayed weights); then the own-initialisation run
// audits restore, the streaming one-step cell against the teacher-forced unroll
// (all 33 steps), seeded repeat sampling and immutability. The path figure
// (paths.png) is not reproduced; samples are saved as .npz like TF's.
// Options: epochs=3 data=PATH tf=PATH.
// Output: output/nn/models/handwriting/.


// Editable workflow support: checks.hpp
// Small runtime checks used by the executable nn examples. They stay on in
// Release builds and make the example exit nonzero on failure, so `just
// run-all-nn` doubles as a regression test against the recorded TF numbers.

// Editable workflow support: runtime.hpp
// Bounded demonstrations by default; opt into convergence experiments explicitly.


namespace example_runtime {

inline bool Full() {
  const char* value = std::getenv("DATAMUNGE_EXAMPLES_FULL");
  return value && std::string(value) == "1";
}

template <typename T> T Limit(T requested, T quick_limit) {
  return Full() ? requested : std::min(requested, quick_limit);
}

inline void Describe() {
  if (!Full())
    std::cout << "Quick demonstration: bounded training; convergence metrics require "
                 "DATAMUNGE_EXAMPLES_FULL=1.\n";
}

}  // namespace example_runtime

namespace check {

inline void Require(bool condition, const std::string& message) {
  if (!condition) throw std::runtime_error(message);
}

// A short demonstration checks execution, derivatives and persistence; reaching
// a published accuracy/return requires the separately requested full schedule.
inline void TrainingQuality(bool condition, const std::string& message) {
  if (example_runtime::Full()) Require(condition, message);
  else std::cout << "  full-training quality check deferred: " << message << '\n';
}

inline void Near(double actual, double expected, double tolerance, const std::string& message) {
  if (!std::isfinite(actual) || !std::isfinite(expected) || std::abs(actual - expected) > tolerance)
    throw std::runtime_error(message + ": got " + std::to_string(actual) + ", expected " + std::to_string(expected));
}

/// Expects `f` to throw; returns the message.
template <typename F>
std::string Throws(F&& f, const std::string& message) {
  try {
    f();
  } catch (const std::exception& e) {
    return e.what();
  }
  throw std::runtime_error(message + ": expected an exception");
}

}  // namespace check

inline void Header(const std::string& title) {
  const std::size_t pad = title.size() < 60 ? 60 - title.size() : 0;
  std::cout << "\n== " << title << " " << std::string(pad, '=') << "\n";
}

// Editable workflow support: handwriting.hpp
namespace handwriting {using namespace dm::nn::models::handwriting;
inline Tensor HandwritingNll(const Tensor& raw, const Tensor& target) {
  const Tensor r = nn::reshape(raw, {-1, kRaw}), y = nn::reshape(target, {-1, 3});
  auto         part = [&](std::int64_t begin, std::int64_t n = 3) { return nn::slice_axis(r, 1, begin, begin + n); };
  const Tensor lp   = nn::log_softmax(part(0), -1);
  const Tensor sx = nn::add(nn::exp(part(9)), .001), sy = nn::add(nn::exp(part(12)), .001), rho = nn::mul(nn::tanh(part(15)), .95);
  const Tensor dx = nn::div(nn::sub(nn::slice_axis(y, 1, 0, 1), part(3)), sx);
  const Tensor dy = nn::div(nn::sub(nn::slice_axis(y, 1, 1, 2), part(6)), sy);
  const Tensor one = nn::sub(1.0, nn::square(rho));
  const Tensor z   = nn::sub(nn::add(nn::square(dx), nn::square(dy)), nn::mul(nn::mul(rho, nn::mul(dx, dy)), 2.0));
  const Tensor normalizer = nn::add(nn::add(nn::log(sx), nn::log(sy)), nn::add(nn::mul(nn::log(one), .5), 1.8378770664));
  const Tensor scores     = nn::sub(nn::sub(lp, normalizer), nn::div(z, nn::mul(one, 2.0)));
  const Tensor maximum    = nn::stop_gradient(nn::max(scores, {1}, true));
  const Tensor logdensity = nn::add(maximum, nn::log(nn::sum(nn::exp(nn::sub(scores, maximum)), {1}, true)));
  const Tensor pen        = part(18, 1);
  const Tensor bce        = nn::sub(nn::softplus(pen), nn::mul(nn::slice_axis(y, 1, 2, 3), pen));
  return nn::mean(nn::sub(bce, logdensity));
}
}

