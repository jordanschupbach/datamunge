\image(figures/bilstm_tagging_pos_confusion.svg)
// result_end

> Held-out ner confusion matrix

Counts come from the original deployed predictions ledger, with rows as truth and columns as predictions. Sequence ledgers exclude padding; token accuracy and entity-span F1 answer different questions. Class IDs retain the original preparation ontology recorded in the manifest.

```{cpp, results="markdown", file="figures/bilstm_tagging_ner_confusion.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -lpthread -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main(){std::ifstream in("build/recovered-language/models/bilstm_tagging/predictions.tsv");if(!in)throw std::runtime_error("actual held-out predictions missing");std::string header;std::getline(in,header);dm::nn::ConfusionMatrix matrix(9);size_t count=0;int id,position,word,pos,pred_pos,ner,pred_ner;while(in>>id>>position>>word>>pos>>pred_pos>>ner>>pred_ner){matrix.add(ner,pred_ner);++count;}if(!count)throw std::runtime_error("empty held-out predictions");std::print("Counted {} held-out ner decisions; padded positions excluded by the source ledger.\n",count);dm::nn::ConfusionMatrixPlotOptions options;options.title="bilstm tagging actual held-out ner";matrix.save_svg("build/bilstm_tagging_ner_confusion.svg",options);}
