> Complete editable experiment

Historical comments in the preserved source describe the original experiment; the versioned reconstruction manifest above describes the active inputs. Objectives, optimizer ownership, update schedules, sampling and search remain here. Source finite-difference, padding, causal/label-independence, checkpoint and immutability controls remain active. Weak held-out outcomes are retained.

```{cpp, results="output", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -lpthread -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
namespace recovered_checkpoints {
inline std::filesystem::path Model(const std::string&name){auto p=std::filesystem::path(dm::datasets::data_home())/"nn-completion-checkpoints/models"/name;std::filesystem::create_directories(p);return p;}
}
// CMD: just run-nn bahdanau
// Additive attention encoder-decoder reversal and addition, three epochs per task.
//
// Port of tflow's bahdanau. Data: tflow's output/datasets/seq2seq/{reversal,
// addition} (data.npz: synthetic 14-token tasks, 128 fit / 32 validation / 32
// test pairs of at most 6 tokens with teacher (BOS-shifted) and target (EOS)
// sequences and their lengths; written by tflow's scripts/fetch_datasets.py).
// A shared 8-D embedding, a length-masked 8-unit encoder LSTM, Bahdanau
// additive attention queried by the previous decoder state and an 8-unit
// decoder LSTM fed [embedding, context]; masked mean token CE, Adam .01,
// batch 8, three epochs (48 updates) per task; 1726 parameters.
// For each task: when tflow's recorded run (output/models/bahdanau/<task>) is
// present, the port first replays it from TF's initial weights (initial
// outputs with all seven BPTT partials, first-batch forward and gradients,
// history, final weights and greedy decodes). The own-initialisation run then
// checks restore, the standalone one-step decoder against the teacher-forced
// unroll, deterministic label-free greedy decoding (teacher/target/lengths
// cannot leak), padding invariance of every output and partial, the empty
// source and immutability. The attention figure (attention.png) is not
// reproduced; the greedy attention weights are saved in decoded.npz.
// Options: epochs=3 data=PATH (the seq2seq dataset root) tf=PATH (tflow's output/models/bahdanau).
// Output: output/nn/models/bahdanau/<task>/.

#include <chrono>
#include <cmath>
#include <fstream>
#include <iostream>

// Editable workflow support: bahdanau.hpp
// Editable workflow support: seq2seq.hpp
// Editable workflow support: tf_replay.hpp
// Small helpers the 4.2 sequence-task ports share for working with tflow's
// recorded runs: named-array maps (tflow's `std::map<std::string, tf::Tensor>`
// batches), row selection, exact/approximate comparisons, loading TF's
// initial_arrays.npz into a ParameterStore and reading history.tsv columns.
//
// A tflow run directory (tflow's output/models/<name>) holds initial_arrays.npz,
// first_batch.npz, initial_gradients.npz, history.tsv and model_arrays.npz.
// Replaying the run from TF's own initial weights with the same batch order
// (nn::BatchOrder reproduces tflow's) and the same optimizer checks the port
// numerically, independently of the random initialisation.

#include <cstring>
#include <filesystem>
#include <fstream>
#include <map>
#include <sstream>
#include <stdexcept>
#include <string>
#include <vector>

#include <datamunge/nn/nn.hpp>

// Editable workflow support: checks.hpp
// Small runtime checks used by the executable nn examples. They stay on in
// Release builds and make the example exit nonzero on failure, so `just
// run-all-nn` doubles as a regression test against the recorded TF numbers.

#include <cmath>
#include <iostream>
#include <stdexcept>
#include <string>
// Editable workflow support: runtime.hpp
// Bounded demonstrations by default; opt into convergence experiments explicitly.

#include <algorithm>
#include <cstdlib>
#include <iostream>
#include <string>

namespace example_runtime {

inline bool Full() {
  const char* value = std::getenv("DATAMUNGE_EXAMPLES_FULL");
  return value && std::string(value) == "1";
}

template <typename T> T Limit(T requested, T quick_limit) {
  return Full() ? requested : std::min(requested, quick_limit);
}

inline void Describe() {
  if (!Full())
    std::cout << "Quick demonstration: bounded training; convergence metrics require "
                 "DATAMUNGE_EXAMPLES_FULL=1.\n";
}

}  // namespace example_runtime

namespace check {

inline void Require(bool condition, const std::string& message) {
  if (!condition) throw std::runtime_error(message);
}

// A short demonstration checks execution, derivatives and persistence; reaching
// a published accuracy/return requires the separately requested full schedule.
inline void TrainingQuality(bool condition, const std::string& message) {
  if (example_runtime::Full()) Require(condition, message);
  else std::cout << "  full-training quality check deferred: " << message << '\n';
}

inline void Near(double actual, double expected, double tolerance, const std::string& message) {
  if (!std::isfinite(actual) || !std::isfinite(expected) || std::abs(actual - expected) > tolerance)
    throw std::runtime_error(message + ": got " + std::to_string(actual) + ", expected " + std::to_string(expected));
}

/// Expects `f` to throw; returns the message.
template <typename F>
std::string Throws(F&& f, const std::string& message) {
  try {
    f();
  } catch (const std::exception& e) {
    return e.what();
  }
  throw std::runtime_error(message + ": expected an exception");
}

}  // namespace check

inline void Header(const std::string& title) {
  const std::size_t pad = title.size() < 60 ? 60 - title.size() : 0;
  std::cout << "\n== " << title << " " << std::string(pad, '=') << "\n";
}

// Editable workflow support: paths.hpp
// Where the nn example ports read datasets and write their outputs.
//
// Datasets: $DATAMUNGE_DATA_DIR, or the user's cache. Public datasets are
// prepared by the example data loaders when first needed.
// Outputs (checkpoints, histories, fixtures): $DATAMUNGE_OUTPUT_DIR, or
// output/nn relative to the working directory (`just run-nn` runs from the
// repository root). Both are created on demand by the caller.

#include <cstdlib>
#include <filesystem>
#include <string>

// Editable workflow support: dataset_assets.hpp
#include <datamunge/datasets/assets.hpp>
namespace dataset_assets{inline std::string DataRoot(){return dm::datasets::data_home();}}

namespace dataset_assets {inline void EnsureSaliency(const std::string& directory){dm::datasets::prepare_example_data("mnist-assets",std::filesystem::path(directory).parent_path().string());}}

namespace dataset_assets {
inline dm::nn::ImageDataset LoadCifar10(const std::string&directory,const std::string&split){dm::datasets::fetch("cifar10",std::filesystem::path(directory).parent_path().string());return dm::nn::load_cifar10(directory,split);}
}

namespace paths {

inline std::filesystem::path DataRoot() {
  return dataset_assets::DataRoot();
}

/// DataRoot() / name, e.g. Dataset("mnist").
inline std::filesystem::path Dataset(const std::string& name) { if(name=="cifar10"||name=="character_rnn")return DataRoot()/name;return std::filesystem::path(dm::datasets::prepare_example_data("nn-completion-assets"))/name; }

inline std::filesystem::path OutputRoot(){return std::filesystem::absolute("build/nn-completion");}

/// OutputRoot() / relative, created as a directory.
inline std::filesystem::path OutputDir(const std::string& relative) {
  auto dir = OutputRoot() / relative;
  std::filesystem::create_directories(dir);
  return dir;
}

}  // namespace paths

namespace replay {

namespace nn = datamunge::nn;
using nn::Tensor;
using Map = std::map<std::string, Tensor>;

/// tflow's recorded output directory for an example (its output/models/<name>).
inline std::filesystem::path TfModels(const std::string& name) {
  return paths::DataRoot().parent_path() / "models" / name;
}

inline Tensor Get(const nn::NamedTensors& arrays, const std::string& key) {
  for (const auto& [name, t] : arrays)
    if (name == key) return t;
  throw std::runtime_error("missing array " + key);
}

inline Map ToMap(const nn::NamedTensors& arrays) { return {arrays.begin(), arrays.end()}; }
inline nn::NamedTensors ToNamed(const Map& m) { return {m.begin(), m.end()}; }

/// Rows `rows` (axis 0) of every array.
inline Map Rows(const Map& m, const std::vector<std::int64_t>& rows) {
  Map out;
  for (const auto& [k, v] : m) out[k] = nn::take_rows(v, rows);
  return out;
}

/// {key: arrays["<split>_<key>"]} for each key.
inline Map Split(const nn::NamedTensors& arrays, const std::string& split, const std::vector<std::string>& keys) {
  Map out;
  for (const auto& k : keys) out[k] = Get(arrays, split + "_" + k);
  return out;
}

inline double MaxAbsDiff(const Tensor& a, const Tensor& b) {
  const auto x = a.to_vector<double>(), y = b.to_vector<double>();
  check::Require(x.size() == y.size(), "compared tensors have the same size");
  double m = 0;
  for (std::size_t i = 0; i < x.size(); ++i) m = std::max(m, std::abs(x[i] - y[i]));
  return m;
}

/// Bit-identical values (dtype and shape included).
inline bool SameBits(const Tensor& a, const Tensor& b) {
  if (a.dtype() != b.dtype() || a.shape() != b.shape()) return false;
  auto same = [](const auto& x, const auto& y) {
    return x.size() == y.size() && (x.empty() || std::memcmp(x.data(), y.data(), x.size() * sizeof(x[0])) == 0);
  };
  switch (a.dtype()) {
    case nn::DType::Float32: return same(a.to_vector<float>(), b.to_vector<float>());
    case nn::DType::Float64: return same(a.to_vector<double>(), b.to_vector<double>());
    case nn::DType::Int32: return same(a.to_vector<std::int32_t>(), b.to_vector<std::int32_t>());
    default: return same(a.to_vector<std::int64_t>(), b.to_vector<std::int64_t>());
  }
}

inline bool SameBits(const Map& a, const Map& b) {
  if (a.size() != b.size()) return false;
  for (const auto& [k, v] : a)
    if (!b.count(k) || !SameBits(v, b.at(k))) return false;
  return true;
}

/// Copies of every parameter, by name.
inline Map Arrays(const nn::ParameterStore& p) {
  Map out;
  for (const auto& name : p.names()) out[name] = p.at(name).detach().clone();
  return out;
}

/// Gradients aligned with p.names(), by name.
inline Map Named(const nn::ParameterStore& p, const std::vector<Tensor>& g) {
  Map out;
  for (std::size_t i = 0; i < g.size(); ++i) out[p.names()[i]] = g[i].defined() ? g[i].detach() : nn::zeros_like(p.parameters()[i]).detach();
  return out;
}

/// Overwrites every parameter of `p` from an .npz (e.g. TF's initial_arrays.npz),
/// which must hold exactly p's names.
inline void LoadInto(nn::ParameterStore& p, const std::filesystem::path& file) {
  const auto arrays = nn::load_npz(file.string());
  check::Require(arrays.size() == p.size(), "array file covers exactly the model's parameters: " + file.string());
  for (const auto& [name, value] : arrays) {
    check::Require(p.contains(name), "array " + name + " is a model parameter");
    p.set(name, nn::cast(value, p.at(name).dtype()));
  }
}

/// max |a[k] - b[k]| over the keys of `a` (all must exist in `b`).
inline double MaxDiff(const Map& a, const Map& b) {
  double m = 0;
  for (const auto& [k, v] : a) {
    check::Require(b.count(k) > 0, "reference has array " + k);
    m = std::max(m, MaxAbsDiff(v, b.at(k)));
  }
  return m;
}
inline double MaxDiff(const Map& a, const std::filesystem::path& file) { return MaxDiff(a, ToMap(nn::load_npz(file.string()))); }

/// Column `column` (0-based) of a tab-separated history file with a header line.
inline std::vector<double> History(const std::filesystem::path& file, int column = 1) {
  std::ifstream       in(file);
  std::string         line;
  std::vector<double> out;
  std::getline(in, line);
  while (std::getline(in, line)) {
    std::stringstream ss(line);
    std::string       cell;
    for (int c = 0; c <= column && std::getline(ss, cell, '\t'); ++c)
      if (c == column) out.push_back(std::stod(cell));
  }
  return out;
}

inline nn::OptimizerConfig Adam() {
  nn::OptimizerConfig c;
  c.kind = nn::OptimizerKind::Adam;
  return c;
}

/// Copies `files` from `from` to `to` when present.
inline void CopyAssets(const std::filesystem::path& from, const std::filesystem::path& to,
                       const std::vector<std::string>& files) {
  for (const auto& f : files)
    if (std::filesystem::exists(from / f))
      std::filesystem::copy_file(from / f, to / f, std::filesystem::copy_options::overwrite_existing);
}

}  // namespace replay

namespace seq2seq {using namespace dm::nn::models::seq2seq;
inline const std::vector<std::string>& BatchKeys();
inline std::vector<Map> LoadPools(const std::filesystem::path& file) {
  const auto       all = nn::load_npz(file.string());
  std::vector<Map> pools;
  for (const std::string split : {"fit", "validation", "test"}) pools.push_back(replay::Split(all, split, BatchKeys()));
  return pools;
}
inline const std::vector<std::string>& BatchKeys() {
  static const std::vector<std::string> keys{"input", "target", "teacher", "input_lengths", "output_lengths", "source_ids"};
  return keys;
}
inline Tensor TokenCE(const Tensor& logits, const Tensor& target, const Tensor& out_lengths) {
  const auto   V    = logits.shape().back();
  const Tensor mask = nn::cast(ValidPositions(out_lengths), logits.dtype());
  const Tensor ce   = nn::neg(nn::sum(nn::mul(nn::log_softmax(logits, -1), nn::one_hot(target, V)), {2}));
  return nn::div(nn::sum(nn::mul(mask, ce)), nn::maximum(nn::sum(mask), nn::scalar(1.0, logits.dtype())));
}
inline Tensor Greedy(const StepFn& step, Tensor h, Tensor c, Tensor* trace = nullptr) {
  nn::NoGradGuard           guard;
  const auto                n = h.shape()[0];
  std::vector<std::int32_t> tokens(n, kBos), result(n * kSteps, 0);
  std::vector<float>        attention(n * kSteps * kSteps, 0.f);
  std::vector<char>         done(n, 0);
  for (int t = 0; t < kSteps; ++t) {
    const auto out = step(nn::from_vector(tokens), h, c);
    const auto V   = out.logits.shape().back();
    const auto lg  = out.logits.to_vector<float>();
    auto       hv = h.to_vector<float>(), cv = c.to_vector<float>();
    const auto nh = out.h.to_vector<float>(), nc = out.c.to_vector<float>();
    const auto aw = out.attention.defined() ? out.attention.to_vector<float>() : std::vector<float>();
    for (std::int64_t j = 0; j < n; ++j) {
      if (done[j]) continue;
      if (!aw.empty())
        for (int k = 0; k < kSteps; ++k) attention[(j * kSteps + t) * kSteps + k] = aw[j * kSteps + k];
      int best = 0;
      for (int k = 1; k < V; ++k)
        if (lg[j * V + k] > lg[j * V + best]) best = k;
      result[j * kSteps + t] = best;
      tokens[j]              = best;
      done[j]                = best == kEos;
      for (int k = 0; k < kUnits; ++k) hv[j * kUnits + k] = nh[j * kUnits + k], cv[j * kUnits + k] = nc[j * kUnits + k];
    }
    h = nn::from_vector(hv, {n, kUnits});
    c = nn::from_vector(cv, {n, kUnits});
  }
  if (trace) *trace = nn::from_vector(attention, {n, kSteps, kSteps});
  return nn::from_vector(result, {n, kSteps});
}
inline Tensor GreedyWith(const StepFn& step, Tensor h, Tensor c, Tensor* trace, int bos, int eos, int fill) {
  nn::NoGradGuard           guard;
  const auto                n = h.shape()[0];
  std::vector<std::int32_t> tokens(n, bos), result(n * kSteps, fill);
  std::vector<float>        attention(n * kSteps * kSteps, 0.f);
  std::vector<char>         done(n, 0);
  for (int t = 0; t < kSteps; ++t) {
    const auto out = step(nn::from_vector(tokens), h, c);
    const auto V   = out.logits.shape().back();
    const auto lg  = out.logits.to_vector<float>();
    auto       hv = h.to_vector<float>(), cv = c.to_vector<float>();
    const auto nh = out.h.to_vector<float>(), nc = out.c.to_vector<float>();
    const auto aw = out.attention.defined() ? out.attention.to_vector<float>() : std::vector<float>();
    for (std::int64_t j = 0; j < n; ++j) {
      if (done[j]) continue;
      if (!aw.empty())
        for (int k = 0; k < kSteps; ++k) attention[(j * kSteps + t) * kSteps + k] = aw[j * kSteps + k];
      int best = 0;
      for (int k = 1; k < V; ++k)
        if (lg[j * V + k] > lg[j * V + best]) best = k;
      result[j * kSteps + t] = best;
      tokens[j]              = best;
      done[j]                = best == eos;
      for (int k = 0; k < kUnits; ++k) hv[j * kUnits + k] = nh[j * kUnits + k], cv[j * kUnits + k] = nc[j * kUnits + k];
    }
    h = nn::from_vector(hv, {n, kUnits});
    c = nn::from_vector(cv, {n, kUnits});
  }
  if (trace) *trace = nn::from_vector(attention, {n, kSteps, kSteps});
  return nn::from_vector(result, {n, kSteps});
}
}

namespace bahdanau {using namespace dm::nn::models::bahdanau;

}





namespace nn = datamunge::nn;
using nn::Tensor;
using replay::Map;
using namespace bahdanau;

namespace {

Tensor Zero(std::int64_t n) { return nn::zeros({n, kUnits}); }

struct Model {
  nn::ParameterStore p;
  explicit Model(std::uint64_t seed) : p(seed) {
    nn::NoGradGuard guard;
    const Tensor    one = nn::one_hot(nn::zeros({1, kSteps}, nn::DType::Int32), kVocab), len = nn::ones({1}, nn::DType::Int32);
    Bahdanau(p, one, one, len, len, Zero(1), Zero(1));
    check::Require(p.count() == 1726 && p.size() == 13, "1726SharedEmbeddingIndependentEncoderDecoderAndHead");
  }
  Map Evaluate(const Map& b) {
    const auto n = b.at("input").shape()[0];
    Tensor     x = nn::one_hot(b.at("input"), kVocab), d = nn::one_hot(b.at("teacher"), kVocab), ih = Zero(n), ic = Zero(n);
    for (Tensor* t : {&x, &d, &ih, &ic}) t->requires_grad_(true);
    const Path   path = Bahdanau(p, x, d, b.at("input_lengths"), b.at("output_lengths"), ih, ic);
    const Tensor loss = seq2seq::TokenCE(path.logits, b.at("target"), b.at("output_lengths"));
    nn::GradOptions o;
    o.allow_unused = true;
    const std::vector<Tensor> wrt{x, d, ih, ic, path.bridge_h, path.bridge_c, path.memory};
    const auto g = nn::grad(std::vector<Tensor>{loss}, wrt, {}, o);
    Map        out{{"loss", loss.detach()},         {"logits", path.logits.detach()},       {"encoder_h", path.encoder_h.detach()},
                   {"encoder_c", path.encoder_c.detach()}, {"decoder_h", path.decoder_h.detach()}, {"decoder_c", path.decoder_c.detach()},
                   {"attention", path.attention.detach()}, {"contexts", path.contexts.detach()},   {"memory", path.memory.detach()}};
    for (std::size_t i = 0; i < g.size(); ++i)
      out["partial" + std::to_string(i)] = g[i].defined() ? g[i] : nn::zeros_like(wrt[i]).detach();
    return out;
  }
  std::vector<Tensor> Gradients(const Map& b) {
    const auto n    = b.at("input").shape()[0];
    const Path path = Bahdanau(p, nn::one_hot(b.at("input"), kVocab), nn::one_hot(b.at("teacher"), kVocab), b.at("input_lengths"),
                               b.at("output_lengths"), Zero(n), Zero(n));
    return nn::grad(seq2seq::TokenCE(path.logits, b.at("target"), b.at("output_lengths")), p.parameters());
  }
  /// One decoder step from owned state (tflow's step_* placeholders).
  seq2seq::DecoderStep StepOnce(const Tensor& token, const Tensor& h, const Tensor& c, const Tensor& memory, const Tensor& lengths) {
    nn::NoGradGuard guard;
    const Step      s = BahdanauStep(p, seq2seq::Embedding(p, nn::one_hot(token, kVocab), kVocab), {h, c}, memory, lengths);
    return {s.logits, s.state.h, s.state.c, s.weights};
  }
  /// Label-free greedy decoding: only the source ids and lengths are read.
  Tensor Greedy(const Map& b, Tensor* trace = nullptr) {
    nn::NoGradGuard guard;
    const auto      n   = b.at("input").shape()[0];
    const Tensor    len = b.at("input_lengths");
    const auto      enc = seq2seq::Encode(p, seq2seq::Embedding(p, nn::one_hot(b.at("input"), kVocab), kVocab), len, Zero(n), Zero(n));
    const Tensor    memory = enc.memory;
    return seq2seq::Greedy([&](const Tensor& t, const Tensor& h, const Tensor& c) { return StepOnce(t, h, c, memory, len); },
                           enc.h.back(), enc.c.back(), trace);
  }
};

std::vector<double> Train(Model& m, const Map& fit, const Map& validation, int epochs, std::ofstream* batches,
                          const std::filesystem::path* root) {
  nn::Optimizer       opt(m.p, .01, replay::Adam());
  nn::BatchOrder      order(128, 8, 44107);
  std::vector<double> history;
  int                 updates = 0;
  for (int e = 1; e <= epochs; ++e) {
    order.begin_epoch();
    for (;;) {
      const auto rows = order.next();
      if (rows.empty()) break;
      const auto b = replay::Rows(fit, rows);
      if (!updates && root) {
        nn::save_npz((*root / "first_batch.npz").string(), replay::ToNamed(b));
        nn::save_npz((*root / "initial_gradients.npz").string(), replay::ToNamed(replay::Named(m.p, m.Gradients(b))));
        nn::save_npz((*root / "first_forward.npz").string(), replay::ToNamed(m.Evaluate(b)));
      }
      opt.step(m.Gradients(b));
      if (!updates && root) m.p.save((*root / "first_after.npz").string());
      if (batches)
        for (auto r : rows) *batches << e << '\t' << updates << '\t' << r << '\n';
      ++updates;
    }
    history.push_back(m.Evaluate(validation).at("loss").item<double>());
  }
  return history;
}

void TfParity(const std::string& task, const std::filesystem::path& tf, const std::vector<Map>& pools, int epochs) {
  if (!std::filesystem::exists(tf / "initial_arrays.npz")) {
    std::cout << " (tflow run not found at " << tf << "; TF parity skipped)\n";
    return;
  }
  Model m(0);
  replay::LoadInto(m.p, tf / "initial_arrays.npz");
  const double out = replay::MaxDiff(m.Evaluate(pools[2]), tf / "initial_outputs.npz");
  const auto   fb  = replay::ToMap(nn::load_npz((tf / "first_batch.npz").string()));
  const double fwd = replay::MaxDiff(m.Evaluate(fb), tf / "first_forward.npz");
  const double gd  = replay::MaxDiff(replay::Named(m.p, m.Gradients(fb)), tf / "initial_gradients.npz");
  check::Near(std::max(out, fwd), 0, 2e-6, "initial outputs, attention and all seven BPTT partials match TF");
  check::Near(gd, 0, 2e-6, "first-batch parameter gradients match TF");
  const auto hist = Train(m, pools[0], pools[1], epochs, nullptr, nullptr);
  const auto tfh  = replay::History(tf / "history.tsv");
  double     worst = 0;
  for (std::size_t e = 0; e < hist.size() && e < tfh.size(); ++e) {
    std::cout << "  replay " << task << " epoch=" << e + 1 << " validationTokenCE=" << hist[e] << " (TF " << tfh[e] << ")\n";
    worst = std::max(worst, std::abs(hist[e] - tfh[e]));
  }
  std::cout << " TF parity from TF's initial weights: initial outputs/partials max diff=" << out << ", first-batch forward max diff="
            << fwd << ", gradients max diff=" << gd;
  if (epochs == 3) {
    const double w = replay::MaxDiff(replay::Arrays(m.p), tf / "model_arrays.npz");
    const auto   g = m.Greedy(pools[2]).to_vector<int>(), tg = replay::Get(nn::load_npz((tf / "decoded.npz").string()), "greedy").to_vector<int>();
    int          same = 0;
    for (std::size_t i = 0; i < g.size(); ++i) same += g[i] == tg[i];
    std::cout << ", final weights max diff=" << w << ", greedy tokens identical " << same << "/" << g.size();
    check::Near(worst, 0, 1e-4, "validation history tracks TF's recorded run");
    check::Near(w, 0, 1e-3, "final weights track TF's after 48 Adam updates");
  }
  std::cout << "\n";
}

void Run(const std::string& task, const std::filesystem::path& data, const std::filesystem::path& tf, int epochs) {
  const auto root = paths::OutputDir("models/bahdanau/" + task);
  replay::CopyAssets(data / task, root, {"data.npz", "manifest.json"});
  const auto pools = seq2seq::LoadPools(data / task / "data.npz");
  const Map& test  = pools[2];
  TfParity(task, tf / task, pools, epochs);

  Model m(44203);
  m.p.save((root / "initial_arrays.npz").string());
  nn::save_npz((root / "initial_outputs.npz").string(), replay::ToNamed(m.Evaluate(test)));
  std::ofstream history(root / "history.tsv"), batches(root / "batches.tsv");
  batches << "epoch\tstep\trow\n";
  history << "epoch\tvalidation_token_ce\n";
  const auto hist = Train(m, pools[0], pools[1], epochs, &batches, &root);
  for (std::size_t e = 0; e < hist.size(); ++e) {
    history << e + 1 << '\t' << hist[e] << '\n';
    std::cout << task << " epoch=" << e + 1 << " validationTokenCE=" << hist[e] << std::endl;
  }
  const Map first = replay::ToMap(nn::load_npz((root / "first_batch.npz").string()));
  nn::save_npz((root / "final_gradients.npz").string(), replay::ToNamed(replay::Named(m.p, m.Gradients(first))));
  m.p.save((root / "final.npz").string());
  Model deployed(0);
  deployed.p.load((root / "final.npz").string());
  const Map weights = replay::Arrays(deployed.p);
  check::Require(replay::SameBits(replay::Arrays(m.p), weights), "bahdanauRestoreBitexact");
  const Map out = deployed.Evaluate(test);
  // The standalone one-step decoder reproduces the teacher-forced unroll.
  const auto olen = test.at("output_lengths").to_vector<int>();
  for (int t = 0; t < kSteps; ++t) {
    const auto step = deployed.StepOnce(nn::select(test.at("teacher"), 1, t), nn::select(out.at("decoder_h"), 1, t),
                                        nn::select(out.at("decoder_c"), 1, t), out.at("memory"), test.at("input_lengths"));
    const auto sl = step.logits.to_vector<float>(), sh = step.h.to_vector<float>(), sc = step.c.to_vector<float>();
    const auto ol = nn::select(out.at("logits"), 1, t).to_vector<float>(), oh = nn::select(out.at("decoder_h"), 1, t + 1).to_vector<float>(),
               oc = nn::select(out.at("decoder_c"), 1, t + 1).to_vector<float>();
    for (int b = 0; b < 32; ++b)
      if (t < olen[b]) {
        for (int k = 0; k < kVocab; ++k) check::Near(sl[b * kVocab + k], ol[b * kVocab + k], 2e-6, "nativeStreamingTeacherLogits");
        for (int k = 0; k < kUnits; ++k) {
          check::Near(sh[b * kUnits + k], oh[b * kUnits + k], 2e-6, "nativeStreamingTeacherH");
          check::Near(sc[b * kUnits + k], oc[b * kUnits + k], 2e-6, "nativeStreamingTeacherC");
        }
      }
  }
  Tensor       greedy_attention;
  const Tensor greedy = deployed.Greedy(test, &greedy_attention);
  check::Require(replay::SameBits(greedy, deployed.Greedy(test)), "deterministicGreedy");
  {
    Map corrupt = replay::Rows(test, {0, 1});
    corrupt.at("teacher")        = nn::full_like(corrupt.at("teacher"), 13);
    corrupt.at("target")         = nn::full_like(corrupt.at("target"), 13);
    corrupt.at("output_lengths") = nn::zeros_like(corrupt.at("output_lengths"));
    check::Require(replay::SameBits(deployed.Greedy(replay::Rows(test, {0, 1})), deployed.Greedy(corrupt)),
                   "greedyCannotUseTeacherOrGoldLengthOrTarget");
  }
  Map padded = replay::Rows(test, {0, 1});
  {
    auto       in = padded.at("input").to_vector<std::int32_t>(), te = padded.at("teacher").to_vector<std::int32_t>();
    const auto il = padded.at("input_lengths").to_vector<int>(), ol = padded.at("output_lengths").to_vector<int>();
    for (int b = 0; b < 2; ++b)
      for (int t = 0; t < kSteps; ++t) {
        if (t >= il[b]) in[b * kSteps + t] = 13;
        if (t >= ol[b]) te[b * kSteps + t] = 13;
      }
    padded.at("input")   = nn::from_vector(in, {2, kSteps});
    padded.at("teacher") = nn::from_vector(te, {2, kSteps});
  }
  const Map regular = deployed.Evaluate(replay::Rows(test, {0, 1})), padout = deployed.Evaluate(padded);
  check::Require(replay::SameBits(regular, padout), "allSeqPathsAndLossPartialsPaddingInvariant");
  nn::save_npz((root / "padding_inputs.npz").string(), replay::ToNamed(padded));
  nn::save_npz((root / "padding_outputs.npz").string(), replay::ToNamed(padout));
  Map empty = replay::Rows(test, {0, 1});
  empty.at("input_lengths") = nn::zeros({2}, nn::DType::Int32);
  const Map eo = deployed.Evaluate(empty);
  for (auto k : {"encoder_h", "encoder_c", "partial0"})
    for (float v : eo.at(k).to_vector<float>()) check::Require(v == 0, "emptyEncoderZeroStatesAndPartials");
  check::Require(eo.at("loss").item<double>() > 0, "emptyEncoderStillHasDecoderLoss");
  nn::save_npz((root / "empty_inputs.npz").string(), replay::ToNamed(empty));
  nn::save_npz((root / "empty_outputs.npz").string(), replay::ToNamed(eo));
  nn::save_npz((root / "outputs.npz").string(), replay::ToNamed(out));
  nn::save_npz((root / "model_arrays.npz").string(), replay::ToNamed(weights));
  nn::save_npz((root / "decoded.npz").string(), {{"greedy", greedy}, {"attention", greedy_attention}});
  int        tokens = 0, correct = 0, exact = 0;
  const auto g = greedy.to_vector<int>(), target = test.at("target").to_vector<int>(), input = test.at("input").to_vector<int>(),
             src = test.at("source_ids").to_vector<int>();
  const auto    lg = out.at("logits").to_vector<float>();
  std::ofstream predictions(root / "predictions.tsv");
  predictions << "source_id\tinput_ids\tgold_ids\tgreedy_ids\n";
  for (int b = 0; b < 32; ++b) {
    bool match = true;
    for (int t = 0; t < kSteps; ++t) {
      match &= g[b * kSteps + t] == target[b * kSteps + t];
      if (t < olen[b]) {
        const float* row = lg.data() + (b * kSteps + t) * kVocab;
        correct += std::max_element(row, row + kVocab) - row == target[b * kSteps + t];
        ++tokens;
      }
    }
    exact += match;
    predictions << src[b];
    for (const auto* a : {&input, &target, &g}) {
      predictions << '\t';
      for (int t = 0; t < kSteps; ++t) predictions << (*a)[b * kSteps + t] << ',';
    }
    predictions << '\n';
  }
  const double  ce = out.at("loss").item<double>();
  std::ofstream metrics(root / "metrics.json");
  metrics << "{\"parameters\":1726,\"epochs\":" << epochs << ",\"updates\":" << epochs * 16 << ",\"test_token_ce\":" << ce
          << ",\"teacher_token_accuracy\":" << double(correct) / tokens << ",\"greedy_exact_accuracy\":" << exact / 32.0 << "}\n";
  check::Require(replay::SameBits(replay::Arrays(deployed.p), weights), "bahdanauInferenceImmutable");
  std::cout << task << " testTokenCE=" << ce << " teacherTokenAccuracy=" << double(correct) / tokens << " greedyExact=" << exact
            << "/32; padding/empty/restore/labelFree/immutable PASS\n";
}

}  // namespace

int main(int argc, char** argv) {
  try {
    const auto            start = std::chrono::steady_clock::now();
    int                   epochs = 3;
    std::filesystem::path data = paths::Dataset("seq2seq"), tf = replay::TfModels("bahdanau");
    for (int i = 1; i < argc; ++i) {
      const std::string a = argv[i];
      if (a.rfind("epochs=", 0) == 0) epochs = std::stoi(a.substr(7));
      else if (a.rfind("data=", 0) == 0) data = a.substr(5);
      else if (a.rfind("tf=", 0) == 0) tf = a.substr(3);
      else throw std::invalid_argument("epochs=N data=PATH tf=PATH");
    }
    check::Require(epochs > 0 && epochs <= 100, "positiveEpochs");
    for (const std::string task : {"reversal", "addition"}) Run(task, data, tf, epochs);
    std::cout << "(TF recorded: reversal testTokenCE=2.06084 teacherTokenAccuracy=0.27044 greedyExact=0/32; addition 1.98821 / "
                 "0.40566 / 0)\nwall "
              << std::chrono::duration<double>(std::chrono::steady_clock::now() - start).count() << " s\n";
    return 0;
  } catch (const std::exception& e) {
    std::cerr << e.what() << '\n';
    return 1;
  }
}

