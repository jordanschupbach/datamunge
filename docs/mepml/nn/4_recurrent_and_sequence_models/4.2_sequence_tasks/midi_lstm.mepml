//? Title: Generate monophonic MIDI with an LSTM
//? Lang: en

> Generate monophonic MIDI with an LSTM

A token describes one of twelve pitches or a rest, each with an eighth-note
or quarter-note duration. The seeded corpus follows short transposed motifs
with rhythmic variation, rests, and occasional pitch changes. All 384
phrases are distinct. The split holds out 64 for validation and another
64 for test.

A 16-unit LSTM predicts the next event from a one-hot encoding of the current
event. During fitting it reads the observed prefix and minimizes next-token
negative log likelihood. During generation it starts with middle C and
feeds its own sampled event back into the same recurrent cell. A held-out
phrase checks that an unbroken pass and one-step generation agree when
given the same prefix. The generated track preserves both pitch and timing.

```{cpp, results="markdown", file="figures/midi_lstm_fit.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

namespace n = dm::nn;

int main() {
  constexpr int events = 16, classes = 26, units = 16;
  constexpr int fit = 256, validation = 64, test = 64;
  constexpr std::array motif{0, 2, 4, 7, 4, 2, 0, 5};

  std::mt19937 data_rng(41382);
  std::set<std::array<int, events>> seen;
  std::vector<int> tokens;
  while (seen.size() < fit + validation + test) {
    const int root = data_rng() % 5;
    std::array<int, events> phrase{};
    for (int t = 0; t < events; ++t) {
      const int duration = t % 4 == 3 || data_rng() % 7 == 0;
      int pitch = root + motif[t % motif.size()];
      if (data_rng() % 11 == 0)
        pitch = (pitch + 10) % 12;
      phrase[t] = (t > 0 && data_rng() % 9 == 0) ? 24 + duration : 2 * pitch + duration;
    }
    if (seen.insert(phrase).second)
      tokens.insert(tokens.end(), phrase.begin(), phrase.end());
  }
  const auto corpus = n::from_vector(tokens).reshape({fit + validation + test, events});
  const auto x = [](const n::Tensor &batch) { return n::slice_axis(batch, 1, 0, events - 1); };
  const auto y = [](const n::Tensor &batch) { return n::slice_axis(batch, 1, 1, events); };

  n::ParameterStore parameters(41383);
  const auto zero = [](std::int64_t rows) {
    return n::LstmState{n::zeros({rows, units}), n::zeros({rows, units})};
  };
  const auto step = [&](const n::Tensor &onehot, const n::LstmState &previous) {
    auto state = n::lstm_step(parameters, "music", onehot, previous);
    auto logits = n::dense(parameters, "readout", state.h, classes);
    return std::pair{state, logits};
  };
  const auto forward = [&](const n::Tensor &input) {
    auto state = zero(input.size(0));
    std::vector<n::Tensor> logits;
    for (const auto &onehot : n::time_steps(n::one_hot(input, classes))) {
      auto [next, scores] = step(onehot, state);
      state = next;
      logits.push_back(scores);
    }
    return n::stack(logits, 1);
  };
  const auto loss = [](const n::Tensor &z, const n::Tensor &target) {
    return n::sparse_softmax_cross_entropy(z.reshape({-1, classes}), target.reshape({-1}));
  };

  const auto val = n::slice_axis(corpus, 0, fit, fit + validation);
  const auto heldout = n::slice_axis(corpus, 0, fit + validation, fit + validation + test);
  const auto evaluate = [&](const n::Tensor &batch) {
    n::NoGradGuard guard;
    return loss(forward(x(batch)), y(batch)).item();
  };
  const double initial = evaluate(heldout);
  n::OptimizerConfig config;
  config.kind = n::OptimizerKind::Adam;
  n::Optimizer adam(parameters, .01, config);
  std::vector<std::int64_t> order(fit);
  std::iota(order.begin(), order.end(), 0);
  std::mt19937 training(41384);
  std::vector<double> epochs{0.}, validation_nll{evaluate(val)};
  for (int epoch = 1; epoch <= 3; ++epoch) {
    std::shuffle(order.begin(), order.end(), training);
    for (int offset = 0; offset < fit; offset += 16) {
      const std::vector<std::int64_t> indices(order.begin() + offset, order.begin() + offset + 16);
      const auto batch = n::gather(corpus, n::from_vector(indices));
      adam.minimize(loss(forward(x(batch)), y(batch)));
    }
    epochs.push_back(epoch);
    validation_nll.push_back(evaluate(val));
    std::print("Epoch {} validation NLL {:.6f}\n", epoch, validation_nll.back());
  }

  n::NoGradGuard guard;
  const auto test_logits = forward(x(heldout));
  const auto first = n::slice_axis(x(heldout), 0, 0, 1);
  const auto expected = n::time_steps(n::slice_axis(test_logits, 0, 0, 1));
  auto state = zero(1);
  double error = 0;
  for (std::size_t t = 0; const auto &onehot : n::time_steps(n::one_hot(first, classes))) {
    auto [next, logits] = step(onehot, state);
    error = std::max(error, n::max(n::abs(logits - expected[t++])).item());
    state = next;
  }
  if (error > 2e-6)
    throw std::runtime_error("streaming logits differ from teacher-forced logits");

  std::mt19937 sampling(41385);
  state = zero(1);
  std::vector<int> codes{0};
  std::vector<double> uniforms;
  std::vector<n::Tensor> sample_logits;
  for (int t = 0; t < 64; ++t) {
    auto [next, logits] = step(n::one_hot(n::from_vector(std::vector<int>{codes.back()}), classes), state);
    state = next;
    sample_logits.push_back(logits);
    const auto weights = n::softmax(logits.to(n::DType::Float64), 1).to_vector<double>();
    uniforms.push_back((double(sampling()) + .5) / 4294967296.);
    double mass = uniforms.back();
    int code = 0;
    while (code < classes - 1 && mass >= weights[code])
      mass -= weights[code++];
    codes.push_back(code);
  }

  std::vector<dm::MidiEvent> melody;
  std::vector<double> starts, ends, pitches;
  double tick = 0;
  for (const int code : codes) {
    const dm::MidiEvent event{code < 24 ? 60 + code / 2 : -1, code % 2 ? 480u : 240u};
    melody.push_back(event);
    if (event.pitch >= 0) {
      starts.push_back(tick / 480.);
      ends.push_back((tick + event.ticks) / 480.);
      pitches.push_back(event.pitch);
    }
    tick += event.ticks;
  }
  std::filesystem::create_directories("build");
  const auto notes = dm::write_midi("build/generated.mid", melody);
  n::save_npz("build/midi_lstm_audit.npz",
              {{"corpus", corpus}, {"codes", n::from_vector(codes)},
               {"uniform", n::from_vector(uniforms)}, {"sample_logits", n::concat(sample_logits, 0)},
               {"test_logits", test_logits}, {"validation_nll", n::from_vector(validation_nll)}});
  std::print("Test NLL {:.6f} → {:.6f}. Streaming maximum error {:.3g}.\n",
             initial, loss(test_logits, y(heldout)).item(), error);
  std::print("Wrote {} notes and {} rests, including the prompt, to build/generated.mid.\n",
             notes, codes.size() - notes);

  auto history = dm::graphics::RPlot::create();
  history.lines(epochs, validation_nll, "Validation NLL", {37, 99, 235})
      .title("Next-event loss").x_label("Epoch").y_label("NLL per token");
  auto roll = dm::graphics::RPlot::create();
  roll.segments(starts, pitches, ends, pitches, {22, 120, 97}, 4.)
      .title("Generated MIDI track").x_limits(0, tick / 480.).x_label("Quarter notes since start").y_label("MIDI pitch");
  dm::graphics::RLayout::create(2, 1).add(history).add(roll).size(1050, 650).fit_panels()
      .save_svg("build/midi_lstm_fit.svg");
}
```
