> Complete preserved source experiment

Original epoch/batch budgets, random streams, source guard tests and weak outcomes are preserved. All fitting and generation code is editable. This program uses native C++ data preparation and mathematical components; it does not execute the upstream Python preparers. Saved arrays and source stdout will be compared against a frozen copy of the pre-conversion program on the exact same prepared inputs. No external-framework equivalence is inferred when recordings are absent.

```{cpp, results="output", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -lpthread -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
// CMD: just run-nn bilstm_crf
// End-to-end BiLSTM-CRF NER with exact partition/marginals/Viterbi and
// exhaustive toy proof; three epochs.
//
// Port of tflow's bilstm_crf. Preparation (in ~/projects/tflow_examples):
// the pinned CoNLL subset in output/datasets/bilstm_tagging (bilstm_tagging.npz,
// 128 fit / 32 validation / 32 test sentences, length 2..24, 512-word
// vocabulary, 9 IOB2 NER tags).
// Two independent 8-unit LSTMs give 16-D offline context, a linear head gives
// NER unaries and a linear-chain CRF (9x9 transition[from,to], 9 start/9 end
// scores) gives the conditional sequence likelihood. 5436 parameters in 12
// tensors; Adam .01, batch 8, three epochs (48 updates) on the mean sequence NLL.
// Checks: a 3-tag CRF fixture against all 121 paths for lengths 0..4 (and
// against TF's native values when tflow's fixture is present); when tflow's
// recorded run is present, the forward pass, every loss derivative and the
// whole 48-update training trajectory are replayed from TF's initial weights
// and compared. Then the port trains from its own initialisation and audits
// padding/empty/causality/restore/label-free decoding like the TF version.
// Options: epochs=3 data=PATH out=PATH tf=PATH (tflow's output/models/bilstm_crf).
// Output: output/nn/models/bilstm_crf/.


// Editable workflow support: bilstm_crf.hpp
// End-to-end BiLSTM-CRF conditional sequence likelihood (port of tflow's
// common/ml/bilstm_crf.h and common/nn/bilstm_tagging.h): a 512-word
// embedding (8-D), two independent 8-unit LSTMs (forward and backward, state
// frozen past each sentence's length), a linear NER head on the 16-D
// context and a linear-chain CRF with transition[from, to], start and end
// scores. Sentences are 24 tokens, padded.



namespace bilstm_crf {

namespace nn = datamunge::nn;
using nn::Tensor;

using namespace dm::nn::models::bilstm_crf;
inline TaggingBatch TaggingRows(const TaggingBatch& x, const std::vector<std::int64_t>& rows) {
  return {nn::take_rows(x.input, rows), nn::take_rows(x.lengths, rows), nn::take_rows(x.pos, rows),
          nn::take_rows(x.ner, rows), nn::take_rows(x.source_ids, rows)};
}

inline Tensor Named(const nn::NamedTensors& arrays, const std::string& key) {
  for (const auto& [name, t] : arrays)
    if (name == key) return t;
  throw std::runtime_error("missing array " + key);
}

struct Objective {
  Path   path;
  Tensor log_partition, gold_score, nll, loss;
};

/// Mean conditional sequence NLL of the gold NER tags.
inline Objective Evaluate(nn::ParameterStore& p, const TaggingBatch& x) {
  Objective o;
  o.path        = Encode(p, x.input, x.lengths);
  const Crf crf = CrfParams(p);
  o.log_partition = nn::crf_log_norm(o.path.unaries, x.lengths, crf.transition, crf.start, crf.end);
  o.gold_score    = nn::crf_sequence_score(o.path.unaries, x.ner, x.lengths, crf.transition, crf.start, crf.end);
  o.nll           = nn::sub(o.log_partition, o.gold_score);
  o.loss          = nn::mean(o.nll);
  return o;
}

/// Viterbi decoding from words and lengths only (-1 in padded positions).
inline nn::CrfDecoded Decode(nn::ParameterStore& p, const TaggingBatch& x) {
  nn::NoGradGuard guard;
  const Path      path = Encode(p, x.input, x.lengths);
  const Crf       crf  = CrfParams(p);
  return nn::crf_decode(path.unaries, x.lengths, crf.transition, crf.start, crf.end, -1);
}

/// Creates every parameter (in tflow's order) without running data through.
inline void Build(nn::ParameterStore& p) {
  TaggingBatch dummy{nn::zeros({1, kSteps}, nn::DType::Int32), nn::ones({1}, nn::DType::Int32), {}, {}, {}};
  nn::NoGradGuard guard;
  Encode(p, dummy.input, dummy.lengths);
  CrfParams(p);
}

}  // namespace bilstm_crf

// Editable workflow support: checks.hpp
// Small runtime checks used by the executable nn examples. They stay on in
// Release builds and make the example exit nonzero on failure, so `just
// run-all-nn` doubles as a regression test against the recorded TF numbers.

// Editable workflow support: runtime.hpp
// Bounded demonstrations by default; opt into convergence experiments explicitly.


namespace example_runtime {

inline bool Full() {
  const char* value = std::getenv("DATAMUNGE_EXAMPLES_FULL");
  return value && std::string(value) == "1";
}

template <typename T> T Limit(T requested, T quick_limit) {
  return Full() ? requested : std::min(requested, quick_limit);
}

inline void Describe() {
  if (!Full())
    std::cout << "Quick demonstration: bounded training; convergence metrics require "
                 "DATAMUNGE_EXAMPLES_FULL=1.\n";
}

}  // namespace example_runtime

namespace check {

inline void Require(bool condition, const std::string& message) {
  if (!condition) throw std::runtime_error(message);
}

// A short demonstration checks execution, derivatives and persistence; reaching
// a published accuracy/return requires the separately requested full schedule.
inline void TrainingQuality(bool condition, const std::string& message) {
  if (example_runtime::Full()) Require(condition, message);
  else std::cout << "  full-training quality check deferred: " << message << '\n';
}

inline void Near(double actual, double expected, double tolerance, const std::string& message) {
  if (!std::isfinite(actual) || !std::isfinite(expected) || std::abs(actual - expected) > tolerance)
    throw std::runtime_error(message + ": got " + std::to_string(actual) + ", expected " + std::to_string(expected));
}

/// Expects `f` to throw; returns the message.
template <typename F>
std::string Throws(F&& f, const std::string& message) {
  try {
    f();
  } catch (const std::exception& e) {
    return e.what();
  }
  throw std::runtime_error(message + ": expected an exception");
}

}  // namespace check

inline void Header(const std::string& title) {
  const std::size_t pad = title.size() < 60 ? 60 - title.size() : 0;
  std::cout << "\n== " << title << " " << std::string(pad, '=') << "\n";
}

