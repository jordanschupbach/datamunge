int main(){namespace n=dm::nn;namespace m=n::models;n::ParameterStore p(7);n::Module model([&](const n::Tensor&trace_input){auto x=trace_input,z=n::zeros({1,8}),l=n::full({1},6,n::DType::Int32);auto y=m::pointer_generator::PointerGenerator(p,x,x,l,l,z,z,n::zeros({1,6,20}));return n::model_stage("pointer generator native component",trace_input,y.logits);},"pointer generator native component graph");n::ModelPlotOptions options;options.detail=n::ModelPlotDetail::Blocks;options.sizing.minimum_extent=2;options.sizing.max_planes=2;model.plot(n::zeros({1,6,14}),options).save_svg("build/pointer_generator_network.svg");}
