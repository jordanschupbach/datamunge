// lstm epoch 1 validation MSE 0.072859
// lstm epoch 2 validation MSE 0.044888
// lstm epoch 3 validation MSE 0.037052
// lstm test RMSE, lead 1 0.145328, lead 6 0.238190
// gru epoch 1 validation MSE 0.153782
// gru epoch 2 validation MSE 0.047772
// gru epoch 3 validation MSE 0.035274
// gru test RMSE, lead 1 0.104865, lead 6 0.231304
// result_end

> Compare test forecasts by lead

The first panel shows the first 72 rolling one-step forecasts. The second
uses every test origin to compare RMSE by lead. The seasonal baseline is
strong because the generator has a prominent, fixed period of 24. In
this run both fitted models have lower RMSE than the seasonal baseline
at every lead. At lead one the LSTM gives 0.145 and the GRU gives 0.105,
compared with 0.253 for the seasonal baseline.

```{cpp, results="markdown", file="figures/recurrent_forecast_fits.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <filesystem>
#include <map>

int main() {
  namespace n = dm::nn;
  using dm::graphics::RPlot;
  std::map<std::string, n::Tensor> data;
  for (const auto& entry : n::load_npz("build/recurrent_forecast/predictions.npz"))
    data.emplace(entry);
  const auto origin = n::slice_axis(data.at("origins"), 0, 0, 72).to_vector<double>();
  const auto observed = data.at("actual");
  const auto lead_one = [&](const n::Tensor& x) {
    return n::slice_axis(n::select(x, 1, 0), 0, 0, 72).to_vector<double>();
  };
  const auto lead_error = [&](const n::Tensor& x) {
    return n::sqrt(n::mean(n::square(x - observed), {0})).to_vector<double>();
  };
  const std::vector<double> leads{1, 2, 3, 4, 5, 6};
  auto fits = RPlot::create();
  fits.lines(origin, lead_one(observed), "Observed", {30, 41, 59})
      .lines(origin, lead_one(data.at("lstm")), "LSTM", {37, 99, 235})
      .lines(origin, lead_one(data.at("gru")), "GRU", {234, 88, 12})
      .title("Rolling one-step predictions").x_label("Test origin").y_label("Value");
  auto scores = RPlot::create();
  scores.lines(leads, lead_error(data.at("lstm")), "LSTM", {37, 99, 235})
        .lines(leads, lead_error(data.at("gru")), "GRU", {234, 88, 12})
        .lines(leads, lead_error(data.at("persistence")), "Persistence", {100, 116, 139})
        .lines(leads, lead_error(data.at("seasonal")), "Seasonal naive", {22, 120, 68})
        .title("Held-out error by lead").x_label("Forecast lead").y_label("RMSE");
  const auto file = "build/recurrent_forecast/fits.svg";
  auto layout = dm::graphics::RLayout::create(1, 2);
  layout.add(fits).add(scores).size(1280, 510).fit_panels().save_svg(file);
  std::filesystem::create_directories("figures");
  std::filesystem::copy_file(file, "figures/recurrent_forecast_fits.svg",
                             std::filesystem::copy_options::overwrite_existing);
}
