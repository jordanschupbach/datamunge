// CMD: just run-nn beam_search
// State-owning beam search on the trained real translation decoder and a
// non-greedy exhaustive fixture.
//
// Port of tflow's beam_search. Model: the English->French attention model
// trained by the translation example (common/translation.hpp, 5640
// parameters). TF restores tflow's translation checkpoint; this port loads the
// trained weights from model=PATH, by default the first of
//   output/nn/models/translation/english_french/{final.npz,model_arrays.npz}
//   (this repository's translation port) and
//   tflow's output/models/translation/english_french/model_arrays.npz
//   (the weights TF's beam_search restores, written by tflow's translation run).
// Data: tflow's output/datasets/translation (data.npz: 6-token
// English/French pairs over a 256-token vocabulary; vocabulary.txt,
// attribution.tsv, _about.txt).
// Every test sentence is encoded without labels; beams of width 1 and 3 (cap
// 6 tokens, EOS = 2) expand hypotheses that each own their decoder state and
// the sentence's memory. Checks: width 1 equals actual greedy decoding; on the
// 3-token fixture beam search beats greedy, and the best of all 15 terminated
// or capped paths (exhaustive enumeration) equals the beam's best;
// immutability of all 5640 weights. When the weights are TF's, the beams and
// the expansion ledger are compared with tflow's recorded beam_search output.
// Options: model=PATH data=PATH tf=PATH (tflow's output/models/beam_search).
// Output: output/nn/models/beam_search/.


// Editable workflow support: beam_search.hpp
// Autoregressive beam search with additive log probabilities and terminal EOS
// retention (port of tflow's common/ml/beam_search.h). Each hypothesis owns
// the decoder state before consuming its most recent predicted token; the
// decoder callback turns a parent hypothesis into next-token logits and the
// next state. Ties are broken by the token sequence, so results are
// deterministic.


namespace beam {

struct Hypothesis {
  std::vector<int>   tokens;
  double             score = 0;
  bool               ended = false;
  std::vector<float> h, c;
};

struct Step {
  std::vector<float> logits, h, c;
};

inline std::vector<double> LogSoftmax(const std::vector<float>& logits) {
  if (logits.empty()) throw std::invalid_argument("empty beam vocabulary");
  double maximum = *std::max_element(logits.begin(), logits.end()), sum = 0;
  for (auto v : logits) sum += std::exp(v - maximum);
  const double        logz = maximum + std::log(sum);
  std::vector<double> result;
  for (auto v : logits) result.push_back(v - logz);
  return result;
}

inline bool Better(const Hypothesis& a, const Hypothesis& b) {
  return a.score != b.score ? a.score > b.score : a.tokens < b.tokens;
}

// Adapt the report's LSTM state and audit callback to the shared decoder.
inline std::vector<Hypothesis> BeamSearch(
    const Hypothesis& initial, int width, int cap, int eos,
    const std::function<Step(const Hypothesis&)>& decoder) {
  using State = std::pair<std::vector<float>, std::vector<float>>;
  const auto beams = dm::nn::BeamSearch(
      State{initial.h, initial.c}, dm::nn::models::seq2seq::kBos, eos, width, cap,
      [&](int, const dm::nn::BeamHypothesis<State>& parent) {
        const auto next = decoder({parent.tokens, parent.log_probability, false,
                                   parent.state.first, parent.state.second});
        return std::pair{State{next.h, next.c}, next.logits};
      });
  std::vector<Hypothesis> result;
  for (const auto& path : beams) {
    result.push_back({path.tokens, path.log_probability, path.tokens.back() == eos,
                      path.state.first, path.state.second});
  }
  return result;
}

/// The 3-token fixture where greedy is not optimal: hypothesis states are a
/// hash of the parent's state and last token, so each branch owns its state.
inline Step FixtureStep(const Hypothesis& parent) {
  const int          last = parent.tokens.empty() ? 3 : parent.tokens.back();
  const float        hash = parent.h[0] * 4 + last + 1;
  std::vector<float> probabilities = hash == 4    ? std::vector<float>{.6f, .35f, .05f}
                                     : hash == 17 ? std::vector<float>{.3f, .3f, .4f}
                                     : hash == 18 ? std::vector<float>{.025f, .025f, .95f}
                                                  : std::vector<float>{.05f, .05f, .9f};
  std::vector<float> logits;
  for (float p : probabilities) logits.push_back(std::log(p));
  return {logits, {hash}, {parent.c[0] + hash}};
}

}  // namespace beam

// Editable workflow support: checks.hpp
// Small runtime checks used by the executable nn examples. They stay on in
// Release builds and make the example exit nonzero on failure, so `just
// run-all-nn` doubles as a regression test against the recorded TF numbers.

// Editable workflow support: runtime.hpp
// Bounded demonstrations by default; opt into convergence experiments explicitly.


namespace example_runtime {

inline bool Full() {
  const char* value = std::getenv("DATAMUNGE_EXAMPLES_FULL");
  return value && std::string(value) == "1";
}

template <typename T> T Limit(T requested, T quick_limit) {
  return Full() ? requested : std::min(requested, quick_limit);
}

inline void Describe() {
  if (!Full())
    std::cout << "Quick demonstration: bounded training; convergence metrics require "
                 "DATAMUNGE_EXAMPLES_FULL=1.\n";
}

}  // namespace example_runtime

namespace check {

inline void Require(bool condition, const std::string& message) {
  if (!condition) throw std::runtime_error(message);
}

// A short demonstration checks execution, derivatives and persistence; reaching
// a published accuracy/return requires the separately requested full schedule.
inline void TrainingQuality(bool condition, const std::string& message) {
  if (example_runtime::Full()) Require(condition, message);
  else std::cout << "  full-training quality check deferred: " << message << '\n';
}

inline void Near(double actual, double expected, double tolerance, const std::string& message) {
  if (!std::isfinite(actual) || !std::isfinite(expected) || std::abs(actual - expected) > tolerance)
    throw std::runtime_error(message + ": got " + std::to_string(actual) + ", expected " + std::to_string(expected));
}

/// Expects `f` to throw; returns the message.
template <typename F>
std::string Throws(F&& f, const std::string& message) {
  try {
    f();
  } catch (const std::exception& e) {
    return e.what();
  }
  throw std::runtime_error(message + ": expected an exception");
}

}  // namespace check

inline void Header(const std::string& title) {
  const std::size_t pad = title.size() < 60 ? 60 - title.size() : 0;
  std::cout << "\n== " << title << " " << std::string(pad, '=') << "\n";
}

