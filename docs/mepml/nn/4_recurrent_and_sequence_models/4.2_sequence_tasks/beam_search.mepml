//? Title: Beam Search
//? Exports: both
//? Lang: en-GB

\abstract(
Restored native translation checkpoint -> explicit ranked beam expansion. The complete native C++ experiment preserves model equations, source seeds, update budgets and explicit fitting/generation loops. Missing data recipes are reconstructed and labelled; original TensorFlow recordings are checked only when genuinely present.
)
\toc

> Provenance and scope

The original preparation recipes and most external recordings are absent from the recovered checkout. This report uses `datamunge-nn-reconstruction-v1`, whose native manifest records the exact public sources, row choices, tokenization and limitations. Reconstructed data validation and native checkpoint restoration do not establish parity with the missing original run. Published Small BERT is the real Google checkpoint, authenticated independently.

> Check beam search against exhaustive enumeration

The upstream three-token transition model allows 15 completed or capped
paths in three steps. Width one keeps only the current best prefix, while
width two can retain the competing prefix that ends sooner with higher
joint probability. A wide beam can be compared with every path.

```{cpp, results="output", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)", id=chunk-01, cache=yes}
#include <dm/dm.hpp>
#include <array>
#include <print>

int main() {
  constexpr int eos = 2, bos = 3, cap = 3;
  const std::array<std::array<double, 3>, 4> probabilities{{
      {.34, .33, .33}, {.06, .04, .90}, {.20, .20, .60}, {.55, .35, .10}}};
  const auto expand = [&](int token, const dm::nn::BeamHypothesis<int>& parent) {
    if (token == eos || parent.state >= cap)
      throw std::runtime_error("expanded a terminal path");
    std::vector<double> logits;
    for (const double p : probabilities.at(token))
      logits.push_back(std::log(p) + 1000);
    return std::pair{parent.state + 1, logits};
  };
  using Path = std::pair<std::vector<int>, double>;
  std::vector<Path> truth;
  const auto visit = [&](auto&& self, std::vector<int> path, double probability) -> void {
    const int last = path.empty() ? bos : path.back();
    if (last == eos || path.size() == cap) {
      truth.emplace_back(path, probability);
      return;
    }
    for (int token = 0; token < 3; ++token) {
      auto child = path;
      child.push_back(token);
      self(self, std::move(child), probability * probabilities[last][token]);
    }
  };
  visit(visit, {}, 1.0);
  std::sort(truth.begin(), truth.end(), [](const Path& a, const Path& b) {
    return a.second == b.second ? a.first < b.first : a.second > b.second;
  });
  const auto wide = dm::nn::BeamSearch(0, bos, eos, 32, cap, expand);
  if (wide.size() != truth.size() || wide.size() != 15)
    throw std::runtime_error("wide beam path count");
  for (std::size_t i = 0; i < wide.size(); ++i) {
    if (wide[i].tokens != truth[i].first ||
        std::abs(std::exp(wide[i].log_probability) - truth[i].second) > 1e-12 ||
        wide[i].state != static_cast<int>(wide[i].tokens.size())) {
      throw std::runtime_error("exhaustive path, probability or state mismatch");
    }
  }
  const auto greedy = dm::nn::BeamSearch(0, bos, eos, 1, cap, expand).front();
  const auto narrow = dm::nn::BeamSearch(0, bos, eos, 2, cap, expand).front();
  const auto tied = dm::nn::BeamSearch(0, bos, eos, 2, 1, [](int, const auto&) {
    return std::pair{1, std::vector<double>(3, 0.0)};
  });
  if (greedy.tokens != std::vector<int>{0, 0, 0} ||
      narrow.tokens != std::vector<int>{1, eos} ||
      tied[0].tokens != std::vector<int>{0} || tied[1].tokens != std::vector<int>{1}) {
    throw std::runtime_error("width or tie behavior");
  }
  std::println("{} paths checked. Width one [0,0,0]: {:.6f}. Width two [1,EOS]: {:.6f}.",
               wide.size(), std::exp(greedy.log_probability), std::exp(narrow.log_probability));
}
```
// result_begin:
// 15 paths checked. Width one [0,0,0]: 0.063580. Width two [1,EOS]: 0.315000.
// result_end

