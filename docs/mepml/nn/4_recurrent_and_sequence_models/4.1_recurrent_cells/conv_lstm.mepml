int main() {
  std::filesystem::create_directories("build");
  dm::graphics::Diagram          d(28, 1150);
  dm::graphics::DiagramNodeStyle style;
  style.width     = 12;
  style.height    = 5;
  style.font_size = 29;
  d.node("input", {-21, 0}, "Valid sequence + length\nExplicit initial states", style)
      .node("cell", {-7, 0}, "Spatial3x3 gates\nSeparate hidden / memory", style)
      .node("head", {7, 0}, "Final state and head\nTarget-free inference", style)
      .node("fit", {21, 0}, "Visible Adam + checks\n18 optimizer writes", style)
      .edge("input", "cell")
      .edge("cell", "head")
      .edge("head", "fit")
      .save_svg("build/conv_lstm_method.svg");
}
