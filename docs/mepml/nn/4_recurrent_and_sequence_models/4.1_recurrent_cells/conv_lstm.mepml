#include <dm/dm.hpp>
int main(){namespace n=dm::nn;std::filesystem::create_directories("build");std::map<std::string,n::Tensor> output,data;for(auto& [key,value]:n::load_npz("build/recurrent-models/models/conv_lstm/outputs.npz"))output.emplace(key,value);for(auto& [key,value]:n::load_npz("build/recurrent-models/models/conv_lstm/data.npz"))data.emplace(key,value);n::ConfusionMatrix cm(2);cm.add(n::reshape(n::cast(data.at("test_labels"),n::DType::Int64),{256}),n::reshape(n::cast(n::greater_equal(output.at("probability"),n::scalar(.5f)),n::DType::Int64),{256}));cm.save_svg("build/conv_lstm_confusion.svg",{.title="ConvLSTM: held-out confusion",.labels={"Empty","Occupied"}});n::save_npz("build/conv_lstm_confusion.npz",{{"counts",cm.to_tensor()}});std::cout<<"Truth rows, prediction columns; "<<(n::reshape(n::cast(data.at("test_labels"),n::DType::Int64),{256})).numel()<<" held-out observations\n";for(const auto& row:cm.cells()){for(auto count:row)std::cout<<count<<" ";std::cout<<"\n";}}

