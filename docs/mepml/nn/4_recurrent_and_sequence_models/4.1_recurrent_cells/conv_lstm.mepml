> Retain two distinct spatial state maps

With zero input/recurrent kernels, unit forget bias and one valid frame, each memory pixel changes from.4 to.4*sigmoid(1), and hidden readout from.2 to.5*tanh(c_next). Both maps then hold through three padded frames. The source1x1 head is independent of this worked state calculation.

```{cpp, results="markdown", file="figures/conv_lstm_worked.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
namespace n = dm::nn;
namespace m = n::models;
using T     = n::Tensor;
void Zero(n::ParameterStore& p, const std::string& name) {
  auto value = p.at(name);
  p.set(name, n::zeros(value.shape(), value.dtype()));
}
int main() {
  std::filesystem::create_directories("build");
  n::ParameterStore p(37003, n::DType::Float64);
  auto              x = n::zeros({1, 4, 4, 4, 1}, n::DType::Float64),
       h              = n::full({1, 4, 4, 2}, .2, n::DType::Float64),
       c              = n::full({1, 4, 4, 2}, .4, n::DType::Float64);
  m::MaskedConvLstmSequence(p, x, n::from_vector(std::vector<std::int32_t>{1}), {h, c});
  Zero(p, "cell/Wx");
  Zero(p, "cell/Wh");
  auto y    = m::MaskedConvLstmSequence(p, x, n::from_vector(std::vector<std::int32_t>{1}), {h, c});
  T    left = n::arange(0, 5, 1, n::DType::Float64),
    right   = n::select(n::reshape(y.states, {5, 32}), 1, 0),
    extra   = n::select(n::reshape(y.cell_states, {5, 32}), 1, 0);
  double expected = .4 / (1. + std::exp(-1.));
  if (std::abs(right.to_vector<double>()[1] - .5 * std::tanh(expected)) > 1e-14 ||
      std::abs(extra.to_vector<double>()[1] - expected) > 1e-14)
    throw std::runtime_error("Hand spatial memory");
  auto av = left.to_vector<double>(), bv = right.to_vector<double>(),
       cv = extra.to_vector<double>();
  std::cout.precision(12);
  std::cout << "| State time | Native hidden pixel | Native cell pixel |\n|---:|---:|---:|\n";
  for (std::size_t i = 0; i < av.size(); ++i)
    std::cout << "|" << av[i] << "|" << bv[i] << "|" << cv[i] << "|\n";
  n::save_npz("build/conv_lstm_worked.npz", {{"a", left}, {"b", right}, {"c", extra}});
  dm::graphics::RPlot::create()
      .lines(av, bv, "Native hidden pixel", {37, 99, 235})
      .points(av, bv, "All native checks", {37, 99, 235}, 5)
      .points(av, cv, "Native cell pixel", {234, 88, 12}, 3)
      .x_label("State time")
      .y_label("Endpoint value")
      .title("Retain two distinct spatial state maps")
      .size(950, 520)
      .save_svg("build/conv_lstm_worked.svg");
}
