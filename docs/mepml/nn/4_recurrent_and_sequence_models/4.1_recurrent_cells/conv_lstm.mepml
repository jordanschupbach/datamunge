> Trace the executed source graph

The native trace uses the exact compact source configuration, explicit zero initial states and full valid length. It counts 227 unique parameter values; classification outputs are logits, and the spatial model emits a pixel-logit map. Structural lengths and every initial-state branch are included in the recurrent stage.

```{cpp, results="markdown", file="figures/conv_lstm_network.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
  namespace n = dm::nn;
  namespace m = n::models;
  std::filesystem::create_directories("build");
  n::set_num_threads(2);
  n::ParameterStore      p(37003);
  auto                   length = n::full({1}, 4, n::DType::Int32);
  std::vector<n::Tensor> initial;
  for (int k = 0; k < 2; ++k)
    initial.push_back(n::zeros({1, 4, 4, 2}));
  n::Module model(
      [&](const n::Tensor& input) {
        auto out = m::MaskedConvLstmSequence(p, input, length, {initial[0], initial[1]});
        n::model_stage(
            "Masked source recurrence",
            std::vector<n::Tensor>{input, length, initial[0], initial[1]},
            out.final_state);
        return n::model_stage("Source prediction head", out.final_state, out.logits);
      },
      "conv_lstm:227 source parameter values");
  n::ModelPlotOptions options;
  options.detail                = n::ModelPlotDetail::Blocks;
  options.sizing.minimum_extent = 2;
  options.sizing.max_planes     = 2;
  auto graph                    = model.plot(n::zeros({1, 4, 4, 4, 1}), options);
  if (p.count() != 227 || graph.parameter_count() != 227)
    throw std::runtime_error("Executed source parameter census");
  graph.save_svg("build/conv_lstm_network.svg");
}
