> Separate norm control from coordinate clipping

For raw gradient(3,4), the norm is 5. Global limit.05 multiplies every coordinate by.01, giving(.03,.04). Coordinate limit.01 instead gives(.01,.01), changing direction. The table reports applied norm and the uniform scale field; coordinate mode has no uniform scaling and reports scale1.

```{cpp, results="markdown", file="figures/gradient_clipping_worked.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
namespace n = dm::nn;
namespace m = n::models;
using T     = n::Tensor;
void Zero(n::ParameterStore& p, const std::string& name) {
  auto value = p.at(name);
  p.set(name, n::zeros(value.shape(), value.dtype()));
}
int main() {
  std::filesystem::create_directories("build");
  std::vector<double> norms, scales;
  for (int policy = 0; policy < 3; ++policy) {
    auto y = m::RecurrentGradientControl({n::tensor({3.f, 4.f})}, policy);
    norms.push_back(y.applied_norm.item());
    scales.push_back(y.scale.item());
  }
  T left = n::arange(0, 3, 1, n::DType::Float64), right = n::from_vector(norms),
    extra = n::from_vector(scales);
  auto av = left.to_vector<double>(), bv = right.to_vector<double>(),
       cv = extra.to_vector<double>();
  std::cout.precision(12);
  std::cout
      << "| Policy0 none1 global2 coordinate | Applied norm | Uniform scale |\n|---:|---:|---:|\n";
  for (std::size_t i = 0; i < av.size(); ++i)
    std::cout << "|" << av[i] << "|" << bv[i] << "|" << cv[i] << "|\n";
  n::save_npz("build/gradient_clipping_worked.npz", {{"a", left}, {"b", right}, {"c", extra}});
  dm::graphics::RPlot::create()
      .points(
          av,
          (n::log(right) / std::log(10.)).to_vector<double>(),
          "Native controlled norm",
          {37, 99, 235},
          5)
      .x_ticks({0, 1, 2}, {"None", "Global norm", "Coordinate value"})
      .x_label("Explicit gradient policy")
      .y_label("log10 applied norm")
      .title("Different policies, different applied vectors")
      .size(950, 520)
      .save_svg("build/gradient_clipping_worked.svg");
}
