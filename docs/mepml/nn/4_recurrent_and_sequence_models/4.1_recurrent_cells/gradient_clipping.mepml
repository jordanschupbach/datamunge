> Trace the executed source graph

The native trace uses the exact compact source configuration, explicit zero initial states and full valid length. It counts 206 unique parameter values; classification outputs are logits, and the spatial model emits a pixel-logit map. Structural lengths and every initial-state branch are included in the recurrent stage.

```{cpp, results="markdown", file="figures/gradient_clipping_network.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
  namespace n = dm::nn;
  namespace m = n::models;
  std::filesystem::create_directories("build");
  n::set_num_threads(2);
  n::ParameterStore      p(41003);
  auto                   length = n::full({1}, 12, n::DType::Int32);
  std::vector<n::Tensor> initial;
  for (int k = 0; k < 1; ++k)
    initial.push_back(n::zeros({1, 12}));
  n::Module model(
      [&](const n::Tensor& input) {
        auto out = m::MaskedTanhSequence(p, input, length, {initial[0]});
        n::model_stage(
            "Masked source recurrence",
            std::vector<n::Tensor>{input, length, initial[0]},
            out.final_state);
        return n::model_stage("Source prediction head", out.final_state, out.logits);
      },
      "gradient_clipping:206 source parameter values");
  n::ModelPlotOptions options;
  options.detail                = n::ModelPlotDetail::Blocks;
  options.sizing.minimum_extent = 2;
  options.sizing.max_planes     = 2;
  auto graph                    = model.plot(n::zeros({1, 12, 2}), options);
  if (p.count() != 206 || graph.parameter_count() != 206)
    throw std::runtime_error("Executed source parameter census");
  graph.save_svg("build/gradient_clipping_network.svg");
}
