#include <dm/dm.hpp>
#include <map>
#include <iostream>
int main(){namespace n=dm::nn;std::filesystem::create_directories("build");std::map<std::string,n::Tensor> output,data;for(auto& [key,value]:n::load_npz("build/recurrent-models/models/stacked_rnn/outputs.npz"))output.emplace(key,value);for(auto& [key,value]:n::load_npz("build/recurrent-models/models/stacked_rnn/data.npz"))data.emplace(key,value);auto truth=data.at("test_labels"),pred=n::argmax(output.at("logits"),1); n::ConfusionMatrix cm(2);cm.add(truth,pred);cm.save_svg("build/stacked_rnn_confusion.svg",{.title="Stacked RNN: held-out confusion"});n::save_npz("build/stacked_rnn_confusion.npz",{{"counts",cm.to_tensor()}});std::cout<<"Truth rows, prediction columns; "<<truth.numel()<<" held-out observations\n";for(const auto& row:cm.cells()){for(auto count:row)std::cout<<count<<" ";std::cout<<"\n";}}

