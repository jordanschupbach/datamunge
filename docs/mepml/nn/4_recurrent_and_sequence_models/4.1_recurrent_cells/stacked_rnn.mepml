> Trace the actual source graph

The composite stage contains the native source path; its parameter census is traced from the actual caller store.

```{cpp, results="markdown", file="figures/stacked_rnn_network.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
namespace n = dm::nn;
namespace m = n::models;
int main() {
  std::filesystem::create_directories("build");
  n::ParameterStore p(29003);
  auto x = n::zeros({1, 12, 2}), lengths = n::from_vector(std::vector<std::int32_t>{12});
  auto h0 = n::zeros({1, 12});
  auto h1 = n::zeros({1, 12});
  n::Module model([&](const n::Tensor& observed){ auto result=m::MaskedStackedSequence(p, observed, lengths, {h0, h1}); return n::model_stage("Source component and readout",std::vector<n::Tensor>{observed, lengths, h0, h1},result.logits);},"stacked_rnn source graph");
  n::ModelPlotOptions options;options.detail=n::ModelPlotDetail::Blocks;auto graph=model.plot(x,options);
  if (p.count() != 506 || graph.parameter_count() != 506)
    throw std::runtime_error("Actual source parameter census");
  graph.save_svg("build/stacked_rnn_network.svg");
}
