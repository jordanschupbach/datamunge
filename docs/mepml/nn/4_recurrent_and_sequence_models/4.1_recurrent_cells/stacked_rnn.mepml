> Read the current lower state in the upper layer

Lower bias .2 and zero recurrence give tanh(.2). An identity upper input matrix then gives tanh(tanh(.2)), within the same timestep.

```{cpp, results="markdown", file="figures/stacked_rnn_worked.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <iostream>
namespace n = dm::nn;
namespace m = n::models;
void Zero(n::ParameterStore& p) {
  for (const auto& name : p.names())
    p.set(name, n::zeros(p.at(name).shape(), p.dtype()));
}
int main() {
  std::filesystem::create_directories("build");
  n::ParameterStore p(1, n::DType::Float64);
  auto x = n::zeros({1, 12, 2}, n::DType::Float64), h = n::zeros({1, 12}, n::DType::Float64),
       l = n::from_vector(std::vector<std::int32_t>{1});
  m::MaskedStackedSequence(p, x, l, {h, h});
  Zero(p);
  p.set("lower/b", n::full({12}, .2, n::DType::Float64));
  p.set("upper/Wx", n::eye(12, n::DType::Float64));
  auto y      = m::MaskedStackedSequence(p, x, l, {h, h});
  auto native = n::from_vector(
      std::vector<double>{
          y.final_lower.to_vector<double>()[0], y.final_state.to_vector<double>()[0]});
  auto hand = n::from_vector(std::vector<double>{std::tanh(.2), std::tanh(std::tanh(.2))});
  if (n::max(n::abs(native - hand)).item() > 2e-7)
    throw std::runtime_error("Worked native/reference mismatch");
  auto                a = native.to_vector<double>(), c = hand.to_vector<double>();
  std::vector<double> index(a.size());
  std::iota(index.begin(), index.end(), 0.);
  n::save_npz("build/stacked_rnn_worked.npz", {{"native", native}, {"reference", hand}});
  std::cout << "| Index | Native | Reference |\n|---:|---:|---:|\n";
  for (std::size_t i = 0; i < a.size(); ++i)
    std::cout << "|" << i << "|" << a[i] << "|" << c[i] << "|\n";
  dm::graphics::RPlot::create()
      .lines(index, a, "Native endpoint", {37, 99, 235})
      .points(index, c, "Explicit reference", {234, 88, 12}, 4)
      .x_label("Endpoint index")
      .y_label("Endpoint value").y_limits(.19,.20).y_ticks({.190,.192,.194,.196,.198,.200},{"0.190","0.192","0.194","0.196","0.198","0.200"})
      .title("Read the current lower state in the upper layer")
      .size(950, 520)
      .save_svg("build/stacked_rnn_worked.svg");
}
```
