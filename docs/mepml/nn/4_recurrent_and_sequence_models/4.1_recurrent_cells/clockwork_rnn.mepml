#include <dm/dm.hpp>
int main(){namespace n=dm::nn;std::filesystem::create_directories("build");std::map<std::string,n::Tensor> output,data;for(auto& [key,value]:n::load_npz("build/recurrent-models/models/clockwork_rnn/outputs.npz"))output.emplace(key,value);for(auto& [key,value]:n::load_npz("build/recurrent-models/models/clockwork_rnn/data.npz"))data.emplace(key,value);n::ConfusionMatrix cm(2);cm.add(data.at("test_labels"),n::argmax(output.at("logits"),1));cm.save_svg("build/clockwork_rnn_confusion.svg",{.title="Clockwork RNN: held-out confusion",.labels={"Negative cue","Positive cue"}});n::save_npz("build/clockwork_rnn_confusion.npz",{{"counts",cm.to_tensor()}});std::cout<<"Truth rows, prediction columns; "<<(data.at("test_labels")).numel()<<" held-out observations\n";for(const auto& row:cm.cells()){for(auto count:row)std::cout<<count<<" ";std::cout<<"\n";}}

