> Read the four clocks on one ramp

Let x_t=t/10, input weights one, recurrent weights/bias zero and valid length 4. Period1 last ticks at t=3, period2 at t=2, while periods 4/8 only tick at t=0. Their final states are tanh(.3), tanh(.2),0,0.

```{cpp, results="markdown", file="figures/clockwork_rnn_worked.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
namespace n = dm::nn;
namespace m = n::models;
using T     = n::Tensor;
void Zero(n::ParameterStore& p, const std::string& name) {
  auto value = p.at(name);
  p.set(name, n::zeros(value.shape(), value.dtype()));
}
int main() {
  std::filesystem::create_directories("build");
  n::ParameterStore   p(32003, n::DType::Float64);
  std::vector<double> values(24, 0), weights(24, 0);
  for (int t = 0; t < 12; ++t)
    values[2 * t] = t * .1;
  for (int j = 0; j < 12; ++j)
    weights[j] = 1;
  auto x = n::from_vector(values, {1, 12, 2}), h = n::zeros({1, 12}, n::DType::Float64);
  m::MaskedClockworkSequence(p, x, n::from_vector(std::vector<std::int32_t>{4}), {h});
  p.set("cell/Wx", n::from_vector(weights, {2, 12}));
  Zero(p, "cell/Wh");
  Zero(p, "cell/b");
  auto y    = m::MaskedClockworkSequence(p, x, n::from_vector(std::vector<std::int32_t>{4}), {h});
  auto v    = y.final_state.to_vector<double>();
  T    left = n::from_vector(std::vector<double>{1, 2, 4, 8}),
    right   = n::from_vector(std::vector<double>{v[0], v[3], v[6], v[9]}),
    extra   = n::from_vector(std::vector<double>{std::tanh(.3), std::tanh(.2), 0, 0});
  auto av = left.to_vector<double>(), bv = right.to_vector<double>(),
       cv = extra.to_vector<double>();
  std::cout.precision(12);
  std::cout << "| Module period | Native final state | Hand calculation |\n|---:|---:|---:|\n";
  for (std::size_t i = 0; i < av.size(); ++i)
    std::cout << "|" << av[i] << "|" << bv[i] << "|" << cv[i] << "|\n";
  n::save_npz("build/clockwork_rnn_worked.npz", {{"a", left}, {"b", right}, {"c", extra}});
  dm::graphics::RPlot::create()
      .lines(av, bv, "Native endpoint", {37, 99, 235})
      .points(av, bv, "All native checks", {37, 99, 235}, 5)
      .points(av, cv, "Hand calculation", {234, 88, 12}, 3)
      .x_label("Module period")
      .y_label("Endpoint value")
      .title("Read the four clocks on one ramp")
      .size(950, 520)
      .save_svg("build/clockwork_rnn_worked.svg");
}
```
