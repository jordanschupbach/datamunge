> Read the validation history

These points are validation diagnostics at the original three epoch boundaries; the fixed-final source protocol is retained. They do not imply convergence.

```{cpp, results="markdown", file="figures/dnc_history.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main(){std::ifstream input("build/generative-models/models/dnc/history.tsv");std::string header;std::getline(input,header);std::vector<double>x,y;double a,b;while(input>>a>>b){x.push_back(a);y.push_back(b);}if(x.size()!=3)return 1;std::print("| epoch | validation objective |\n|---:|---:|\n");for(size_t i=0;i<x.size();++i)std::print("| {:.0f} | {:.9f} |\n",x[i],y[i]);dm::graphics::RPlot::create().lines(x,y,"validation",{37,99,235}).x_label("Epoch").y_label("Source validation objective").title("dnc validation").size(1000,550).save_svg("build/dnc_history.svg");}
