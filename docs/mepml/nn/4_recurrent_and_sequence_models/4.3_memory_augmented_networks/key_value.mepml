> Read a zero embedding memory

Zero embeddings and three valid facts give equal1/3 attention at both hops; invalid facts have zero weight and both read vectors are zero.

```{cpp, results="markdown", file="figures/key_value_worked.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <iostream>
namespace n = dm::nn;
namespace m = n::models;
void Zero(n::ParameterStore& p) {
  for (const auto& name : p.names())
    p.set(name, n::zeros(p.at(name).shape(), p.dtype()));
}
int main() {
  std::filesystem::create_directories("build");
  n::ParameterStore p(1);
  auto              f = n::zeros({1, 6, 2, 13}), q = n::zeros({1, 13}),
       l = n::from_vector(std::vector<std::int32_t>{3});
  m::KeyValueMemoryNetwork(p, f, q, l);
  Zero(p);
  auto y      = m::KeyValueMemoryNetwork(p, f, q, l);
  auto native = n::reshape(y.attention, {12});
  auto hand   = n::from_vector(
      std::vector<float>{1.f / 3, 1.f / 3, 1.f / 3, 0, 0, 0, 1.f / 3, 1.f / 3, 1.f / 3, 0, 0, 0});
  if (n::max(n::abs(y.reads)).item() != 0)
    throw std::runtime_error("Zero read");
  if (n::max(n::abs(native - hand)).item() > 2e-7)
    throw std::runtime_error("Worked native/reference mismatch");
  auto                a = native.to_vector<double>(), c = hand.to_vector<double>();
  std::vector<double> index(a.size());
  std::iota(index.begin(), index.end(), 0.);
  n::save_npz("build/key_value_worked.npz", {{"native", native}, {"reference", hand}});
  std::cout << "| Index | Native | Reference |\n|---:|---:|---:|\n";
  for (std::size_t i = 0; i < a.size(); ++i)
    std::cout << "|" << i << "|" << a[i] << "|" << c[i] << "|\n";
  dm::graphics::RPlot::create()
      .lines(index, a, "Native endpoint", {37, 99, 235})
      .points(index, c, "Explicit reference", {234, 88, 12}, 4)
      .x_label("Endpoint index")
      .y_label("Endpoint value")
      .title("Read a zero embedding memory")
      .size(950, 520)
      .save_svg("build/key_value_worked.svg");
}
```
