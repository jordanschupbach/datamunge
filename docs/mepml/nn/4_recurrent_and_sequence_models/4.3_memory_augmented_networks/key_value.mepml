> Trace the actual source graph

The composite stage contains the native source path; its parameter census is traced from the actual caller store.

```{cpp, results="markdown", file="figures/key_value_network.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
namespace n = dm::nn;
namespace m = n::models;
int main() {
  std::filesystem::create_directories("build");
  n::ParameterStore p(45403);
  auto              x = n::zeros({1, 6, 2, 13}), query = n::zeros({1, 13}),
       lengths = n::from_vector(std::vector<std::int32_t>{6});
  n::Module model([&](const n::Tensor& observed){ auto result=m::KeyValueMemoryNetwork(p, observed, query, lengths); return n::model_stage("Source component and readout",std::vector<n::Tensor>{observed, query, lengths},result.logits);},"key_value source graph");
  n::ModelPlotOptions options;options.detail=n::ModelPlotDetail::Blocks;auto graph=model.plot(x,options);
  if (p.count() != 264 || graph.parameter_count() != 264)
    throw std::runtime_error("Actual source parameter census");
  graph.save_svg("build/key_value_network.svg");
}
