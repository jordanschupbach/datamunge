> Explicit differentiable architecture

```{cpp, results="markdown", file="figures/rbf_network_architecture.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <datamunge/plot/plot.hpp>
#include <datamunge/plot/diagram.hpp>
#include <datamunge/algorithms/modular_exponentiation.hpp>
#include <datamunge/algorithms/integer_arithmetic.hpp>
#include <filesystem>
#include <print>
#include <algorithm>
#include <cmath>
#include <limits>
#include <climits>
#include <datamunge/algorithms/number_theory.hpp>
#include <numeric>
#include <numbers>
#include <random>
#include <string>
#include <vector>
#include <map>
#include <set>
#include <array>
#include <tuple>
#include <datamunge/algorithms/prufer.hpp>
#include <datamunge/algorithms/flow_diagram.hpp>
#include <datamunge/geometry/hull_algorithms.hpp>
#include <datamunge/random/sampling_analysis.hpp>
#include <iomanip>
#include <datamunge/algorithms/qr_algorithm.hpp>
#include <datamunge/stats/lm.hpp>
#include <datamunge/algorithms/arithmetic_coding.hpp>
#include <datamunge/nn/rbf.hpp>
#include <datamunge/nn/model_plot.hpp>
#include <bit>
#include <datamunge/nn/rbf.hpp>
int main() {
  namespace a = dm::algorithms;
  namespace g = dm::graphics;
  std::filesystem::create_directories("build");

  namespace n = dm::nn;
  n::set_num_threads(2);
  const auto centers = n::linspace(0, 2 * std::numbers::pi, 15, n::DType::Float64).reshape({15, 1});
  auto       weights = n::zeros({15, 1}, n::DType::Float64).requires_grad_();
  auto       bias    = n::zeros({1}, n::DType::Float64).requires_grad_();
  n::Module  model(
      [&](const n::Tensor& input) {
        auto phi = n::rbf_features(input, centers, .45);
        n::model_stage("15 fixed-center Gaussian units", input, phi);
        auto output = n::matmul(phi, weights) + bias;
        n::model_stage("16 learned readout scalars", phi, output);
        return output;
      },
      "RBF tensor model: fixed centers and visible learned readout");
  n::ModelPlotOptions options;
  options.style  = n::ModelPlotStyle::Flow;
  options.detail = n::ModelPlotDetail::Blocks;
  auto diagram   = model.plot(n::zeros({1, 1}, n::DType::Float64), options);
  diagram.save_svg("build/rbf_network_architecture.svg");
  std::print(
      "\n| actual model quantity | count |\n| --- | ---: |\n| Gaussian units | {} |\n| explicit "
      "learnable readout scalars | {} |\n| reachable diagram parameters | {} |\n",
      centers.size(0),
      weights.numel() + bias.numel(),
      diagram.parameter_count());
}
