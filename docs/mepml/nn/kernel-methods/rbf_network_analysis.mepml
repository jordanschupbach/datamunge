int main() {
  namespace a = dm::algorithms;
  namespace g = dm::graphics;
  std::filesystem::create_directories("build");

  namespace n = dm::nn;
  n::set_num_threads(2);
  auto input   = n::from_vector(std::vector<double>{0, 1, 2}, {3, 1});
  auto centers = n::from_vector(std::vector<double>{0, 2}, {2, 1});
  auto phi     = n::rbf_features(input, centers, 1);
  auto weights = n::from_vector(std::vector<double>{1, -1}, {2, 1});
  auto output  = n::matmul(phi, weights);
  std::print(
      "\n| actual tensor input | actual first Gaussian | actual second Gaussian | actual fixed "
      "readout |\n| ---: | ---: | ---: | ---: |\n");
  for (int i = 0; i < 3; ++i)
    std::print(
        "| {} | {} | {} | {} |\n",
        input.at({i, 0}),
        phi.at({i, 0}),
        phi.at({i, 1}),
        output.at({i, 0}));

  g::Diagram d;
  d.node("n0", {0, 0}, std::format("Actual feature tensor shape\n{}", phi.shape()));
  d.node("n1", {10, 0}, std::format("Actual second response at x=0\n{}", phi.at({0, 1})));
  d.node(
      "n2",
      {20, 0},
      std::format("Actual fixed readout tensor values\n{}", output.to_vector<double>()));
  d.edge("n0", "n1").edge("n1", "n2");
  d.save_svg("build/rbf_network_tiny.svg");
}
