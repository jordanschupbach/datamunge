> Actual selected work and sensitivity

```{cpp, results="markdown", file="figures/rbf_network_work.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <datamunge/plot/plot.hpp>
#include <datamunge/plot/diagram.hpp>
#include <datamunge/algorithms/modular_exponentiation.hpp>
#include <datamunge/algorithms/integer_arithmetic.hpp>
#include <filesystem>
#include <print>
#include <algorithm>
#include <cmath>
#include <limits>
#include <climits>
#include <datamunge/algorithms/number_theory.hpp>
#include <numeric>
#include <numbers>
#include <random>
#include <string>
#include <vector>
#include <map>
#include <set>
#include <array>
#include <tuple>
#include <datamunge/algorithms/prufer.hpp>
#include <datamunge/algorithms/flow_diagram.hpp>
#include <datamunge/geometry/hull_algorithms.hpp>
#include <datamunge/random/sampling_analysis.hpp>
#include <iomanip>
#include <datamunge/algorithms/qr_algorithm.hpp>
#include <datamunge/stats/lm.hpp>
#include <datamunge/algorithms/arithmetic_coding.hpp>
#include <datamunge/nn/rbf.hpp>
#include <datamunge/nn/model_plot.hpp>
#include <bit>
#include <datamunge/nn/rbf.hpp>
int main() {
  namespace a = dm::algorithms;
  namespace g = dm::graphics;
  std::filesystem::create_directories("build");

  namespace n = dm::nn;
  n::set_num_threads(2);
  const auto          data = a::rbf_example_data();
  std::vector<double> flat;
  for (const auto& row : data.input)
    flat.push_back(row[0]);
  const auto input = n::from_vector(flat, {61, 1}), target = n::from_vector(data.target, {61, 1}),
             grid    = n::from_vector(data.grid, {201, 1}),
             truth   = n::from_vector(data.truth, {201, 1});
  const auto centers = n::linspace(0, 2 * std::numbers::pi, 15, n::DType::Float64).reshape({15, 1});
  std::vector<double> x, y;
  std::print(
      "\n| explicit fixed width | actual Adam updates | actual tensor training MSE | "
      "known-function grid RMSE |\n| ---: | ---: | ---: | ---: |\n");
  for (double width : {.2, .45, .9, 1.8}) {
    const auto         phi     = n::rbf_features(input, centers, width);
    auto               weights = n::zeros({15, 1}, n::DType::Float64).requires_grad_();
    auto               bias    = n::zeros({1}, n::DType::Float64).requires_grad_();
    n::OptimizerConfig config;
    config.kind = n::OptimizerKind::Adam;
    n::Optimizer adam(std::vector<n::Tensor>{weights, bias}, .03, config);
    for (int step = 0; step < 2000; ++step) {
      auto prediction = n::matmul(phi, weights) + bias;
      auto objective  = n::mean(n::square(prediction - target)) +
                       (1e-4 / 61.) * (n::sum(n::square(weights)) + n::sum(n::square(bias)));
      adam.minimize(objective);
    }
    const double mse        = n::mean(n::square(n::matmul(phi, weights) + bias - target)).item();
    auto         prediction = n::matmul(n::rbf_features(grid, centers, width), weights) + bias;
    const double error      = n::sqrt(n::mean(n::square(prediction - truth))).item();
    x.push_back(width);
    y.push_back(error);
    std::print("| {} | {} | {} | {} |\n", width, adam.iterations(), mse, error);
  }
  auto p = g::RPlot::create();
  p.lines(x, y, "actual tensor fit known-function RMSE", {16, 122, 87})
      .points(x, y, {16, 122, 87}, 5)
      .title("Visible equal-budget Adam fits at four fixed widths")
      .x_label("explicit fixed Gaussian width")
      .y_label("actual known-function grid RMSE");
  p.save_svg("build/rbf_network_work.svg");
}
