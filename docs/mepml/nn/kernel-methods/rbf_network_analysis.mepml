> Explicit controls

```{cpp, results="markdown", file="figures/rbf_network_controls.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <datamunge/plot/plot.hpp>
#include <datamunge/plot/diagram.hpp>
#include <datamunge/algorithms/modular_exponentiation.hpp>
#include <datamunge/algorithms/integer_arithmetic.hpp>
#include <filesystem>
#include <print>
#include <algorithm>
#include <cmath>
#include <limits>
#include <climits>
#include <datamunge/algorithms/number_theory.hpp>
#include <numeric>
#include <numbers>
#include <random>
#include <string>
#include <vector>
#include <map>
#include <set>
#include <array>
#include <tuple>
#include <datamunge/algorithms/prufer.hpp>
#include <datamunge/algorithms/flow_diagram.hpp>
#include <datamunge/geometry/hull_algorithms.hpp>
#include <datamunge/random/sampling_analysis.hpp>
#include <iomanip>
#include <datamunge/algorithms/qr_algorithm.hpp>
#include <datamunge/stats/lm.hpp>
#include <datamunge/algorithms/arithmetic_coding.hpp>
#include <datamunge/nn/rbf.hpp>
#include <datamunge/nn/model_plot.hpp>
#include <bit>
#include <datamunge/nn/rbf.hpp>
int main() {
  namespace a = dm::algorithms;
  namespace g = dm::graphics;
  std::filesystem::create_directories("build");

  namespace n = dm::nn;
  n::set_num_threads(2);
  const auto input  = n::from_vector(std::vector<double>{-2, -1, 0, 1, 2}, {5, 1});
  const auto center = n::zeros({1, 1}, n::DType::Float64);
  const auto curve_grid=n::linspace(-2,2,201,n::DType::Float64).reshape({201,1});
  auto       p      = g::RPlot::create();
  std::print("\n| explicit width | actual Gaussian tensor values |\n| ---: | --- |\n");
  for (double width : {.5, 1., 2.}) {
    auto phi = n::rbf_features(input, center, width);
    std::print("| {} | `{}` |\n", width, phi.to_vector<double>());
    p.lines(
        curve_grid.to_vector<double>(),
        n::rbf_features(curve_grid, center, width).to_vector<double>(),
        std::format("actual width {}", width),
        width == .5  ? g::RGB{37, 99, 235}
        : width == 1 ? g::RGB{234, 88, 12}
                     : g::RGB{22, 163, 74});
  }
  auto x        = n::from_vector(std::vector<double>{.25}, {1, 1}).requires_grad_();
  auto c        = n::zeros({1, 1}, n::DType::Float64).requires_grad_();
  auto gradient = n::grad(n::sum(n::rbf_features(x, c, 1)), std::vector<n::Tensor>{x, c});
  bool invalid  = false;
  try {
    n::rbf_features(input, center, 0);
  } catch (const std::invalid_argument&) {
    invalid = true;
  }
  std::print(
      "Actual input gradient {}, center gradient {}; invalid zero width rejected {}.\n",
      gradient[0].item(),
      gradient[1].item(),
      invalid);
  p.title("Actual differentiable Gaussian responses at explicit widths")
      .x_label("tensor input coordinate")
      .y_label("actual tensor feature response");
  p.save_svg("build/rbf_network_controls.svg");
  if (!invalid)
    return 1;
}
