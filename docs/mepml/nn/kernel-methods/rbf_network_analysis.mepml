> The retained original experiment

```{cpp, results="markdown", file="figures/rbf_network_original.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <datamunge/plot/plot.hpp>
#include <datamunge/plot/diagram.hpp>
#include <datamunge/algorithms/modular_exponentiation.hpp>
#include <datamunge/algorithms/integer_arithmetic.hpp>
#include <filesystem>
#include <print>
#include <algorithm>
#include <cmath>
#include <limits>
#include <climits>
#include <datamunge/algorithms/number_theory.hpp>
#include <numeric>
#include <numbers>
#include <random>
#include <string>
#include <vector>
#include <map>
#include <set>
#include <array>
#include <tuple>
#include <datamunge/algorithms/prufer.hpp>
#include <datamunge/algorithms/flow_diagram.hpp>
#include <datamunge/geometry/hull_algorithms.hpp>
#include <datamunge/random/sampling_analysis.hpp>
#include <iomanip>
#include <datamunge/algorithms/qr_algorithm.hpp>
#include <datamunge/stats/lm.hpp>
#include <datamunge/algorithms/arithmetic_coding.hpp>
#include <datamunge/nn/rbf.hpp>
#include <datamunge/nn/model_plot.hpp>
#include <bit>
#include <datamunge/nn/rbf.hpp>
int main() {
  namespace a = dm::algorithms;
  namespace g = dm::graphics;
  std::filesystem::create_directories("build");

  namespace n = dm::nn;
  n::set_num_threads(2);
  const auto          data = a::rbf_example_data();
  std::vector<double> flat;
  for (const auto& row : data.input)
    flat.push_back(row[0]);
  const auto input = n::from_vector(flat, {61, 1}), target = n::from_vector(data.target, {61, 1});
  const auto centers = n::linspace(0, 2 * std::numbers::pi, 15, n::DType::Float64).reshape({15, 1});
  const double       width = .45, ridge = 1e-4;
  const auto         phi     = n::rbf_features(input, centers, width);
  auto               weights = n::zeros({15, 1}, n::DType::Float64).requires_grad_();
  auto               bias    = n::zeros({1}, n::DType::Float64).requires_grad_();
  n::OptimizerConfig config;
  config.kind = n::OptimizerKind::Adam;
  n::Optimizer adam(std::vector<n::Tensor>{weights, bias}, .03, config);
  std::print(
      "\n| actual completed Adam updates | actual tensor objective | actual tensor training MSE "
      "|\n| ---: | ---: | ---: |\n");
  for (int step = 0; step <= 2000; ++step) {
    auto prediction = n::matmul(phi, weights) + bias;
    auto mse        = n::mean(n::square(prediction - target));
    auto objective  = mse + (ridge / 61.) * (n::sum(n::square(weights)) + n::sum(n::square(bias)));
    if (step % 200 == 0)
      std::print("| {} | {} | {} |\n", step, objective.item(), mse.item());
    if (step < 2000)
      adam.minimize(objective);
  }
  const auto grid     = n::from_vector(data.grid, {201, 1}),
             truth    = n::from_vector(data.truth, {201, 1});
  const auto   fitted = n::matmul(n::rbf_features(grid, centers, width), weights) + bias;
  const double rmse   = n::sqrt(n::mean(n::square(fitted - truth))).item();
  std::vector<std::vector<double>> fixed_centers;
  for (double x : centers.to_vector<double>())
    fixed_centers.push_back({x});
  const auto   reference = a::rbf_fit_output(data.input, data.target, fixed_centers, width, ridge);
  const auto   ref_weights           = n::from_vector(reference.weights, {15, 1});
  const auto   reference_predictions = n::matmul(phi, ref_weights) + reference.bias;
  const auto   actual_predictions    = n::matmul(phi, weights) + bias;
  const double disagreement =
      n::sqrt(n::mean(n::square(actual_predictions - reference_predictions))).item();
  const auto retained = a::rbf_train_run(data.input, data.target, 15, 1e-4, 0, 40, 1);
  std::print(
      "Actual tensor updates {}, Float64 learned scalars {}, known-function grid RMSE {}, "
      "training-prediction RMS gap to fixed-basis closed-form comparison {}.\n",
      adam.iterations(),
      weights.numel() + bias.numel(),
      rmse,
      disagreement);
  std::print(
      "Separate retained original Lloyd/closed-form comparison: width {}, prediction at the same "
      "grid point near pi/2 {}. Tensor prediction there {}; analytic target {}.\n",
      retained.model.width,
      a::rbf_predict(retained.model, {data.grid[50]}),
      fitted.at({50, 0}),
      truth.at({50, 0}));
  auto p = g::RPlot::create();
  p.points(
       input.to_vector<double>(),
       target.to_vector<double>(),
       "original noisy observations",
       {148, 163, 184},
       4)
      .lines(
          grid.to_vector<double>(),
          truth.to_vector<double>(),
          "known analytic function",
          {22, 163, 74})
      .lines(
          grid.to_vector<double>(),
          fitted.to_vector<double>(),
          "actual Adam-trained tensor model",
          {220, 38, 38})
      .title("Original regression observations: explicit tensor RBF fitting")
      .x_label("x")
      .y_label("target / actual tensor prediction");
  p.save_svg("build/rbf_network_original.svg");
}
```
