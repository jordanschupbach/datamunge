> Checking the theory and controls

```{cpp, results="markdown", file="figures/viterbi_controls.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    auto h = a::forward_backward_example_model();
    std::vector<double> x, y;
    std::print("| observations | actual possible | path | joint log mass |\n|---|---|---|---:|\n");
    int i = 0;
    for (auto obs : std::vector<std::vector<std::size_t>>{{}, {0}, {2},
                                                          {0, 1, 2}}) {
        auto r = a::viterbi(h, obs);
        std::print("|`{}`|{}|`{}`|{}|\n", obs, r.possible, r.states,
                   r.log_probability);
        x.push_back(i++);
        y.push_back(r.states.size());
    }
    h.emission = {{1, 0, 0}, {1, 0, 0}};
    auto impossible = a::viterbi(h, {2});
    std::print("\nImpossible evidence: possible {}; path length {}; log mass {}.\n",
               impossible.possible, impossible.states.size(),
               impossible.log_probability);
    auto p = g::RPlot::create();
    p.line(x, y, "actual", {37, 99, 235}, 2);
    p.points(x, y, "", {37, 99, 235}, 5);
    p.title("Empty and valid streams retain explicit path status").x_label(
        "control index").y_label("actual path length");
    p.save_svg("build/viterbi_controls.svg");
}
```
// result_begin: markdown
| observations | actual possible | path | joint log mass |
|---|---|---|---:|
|`[]`|true|`[]`|0|
|`[0]`|true|`[0]`|-1.203972804325936|
|`[2]`|true|`[1]`|-1.4271163556401456|
|`[0, 1, 2]`|true|`[0, 0, 1]`|-4.19173690823075|

Impossible evidence: possible false; path length 0; log mass -inf.
\image(figures/viterbi_controls.svg)
