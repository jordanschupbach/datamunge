> Sensitivity and selected work

```{cpp, results="markdown", file="figures/viterbi_work.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    auto h = a::forward_backward_example_model();
    std::vector<double> x, y;
    std::print("| observations | actual predecessor candidates | formula(T-1)*4 |\n|---:|---:|---:|\n");
    for (std::size_t n : {1, 2, 4, 8, 16, 32, 64, 128}) {
        auto r = a::viterbi_work(h, std::vector<std::size_t>(n, 0));
        std::print("|{}|{}|{}|\n", n, r.transition_terms, (n - 1) * 4);
        x.push_back(n);
        y.push_back(r.transition_terms);
    }
    auto p = g::RPlot::create();
    p.line(x, y, "actual", {37, 99, 235}, 2);
    p.points(x, y, "", {37, 99, 235}, 5);
    p.title("Actual two-state candidate work grows linearly with time").x_label(
        "observations T").y_label("actual predecessor candidates");
    p.save_svg("build/viterbi_work.svg");
}
```
// result_begin: markdown
| observations | actual predecessor candidates | formula(T-1)*4 |
|---:|---:|---:|
