> The retained original experiment

```{cpp, results="markdown", file="figures/viterbi_original.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    auto h = a::forward_backward_example_model();
    std::vector<std::size_t> obs{0, 0, 1, 2, 2, 2, 1, 0, 1, 2, 2, 1, 0, 0};
    auto r = a::viterbi_work(h, obs);
    std::vector<double> days, symbols, states;
    std::vector<std::string> state_name{"Healthy", "Fever"}, symbol_name{
        "normal", "cold", "dizzy"
    };
    std::print("| day | symbol | actual decoded state |\n|---:|---|---|\n");
    for (std::size_t i = 0; i < obs.size(); ++i) {
        std::print("|{}|{}|{}|\n", i + 1, symbol_name[obs[i]],
                   state_name[r.result.states[i]]);
        days.push_back(i + 1);
        symbols.push_back(obs[i]);
        states.push_back(r.result.states[i]);
    }
    auto p = g::RPlot::create();
    p.line(days, symbols, "observed symbol0..2", {37, 99, 235});
    p.line(days, states, "decoded state0..1", {220, 38, 38});
    p.title("Original14-symbol hidden-path decode").x_label("day").y_label(
        "symbol/state ID, distinct meanings");
    p.save_svg("build/viterbi_original.svg");
    std::print("\nActual joint log mass {}. Model labels are illustrative, not clinical predictions.\n",
               r.result.log_probability);
}
```
