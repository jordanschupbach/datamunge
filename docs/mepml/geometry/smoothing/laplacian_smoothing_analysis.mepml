> Nonincreasing energy can accompany oscillation or collapse

On a single unpinned edge with coordinates0 and2, lambda1 swaps the two endpoint
identities each pass. Energy stays4, so energy descent alone does not prove
convergence. Lambda0.5 instead collapses both positions to1 in one pass, with
energy0; that is not a shape-preservation guarantee. Both controls use complete
actual native trajectories.

```{cpp, results="markdown", file="figures/laplacian_oscillation.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <datamunge/geometry/laplacian_analysis.hpp>
#include <datamunge/plot/plot.hpp>
#include <filesystem>
#include <print>
int main() {
    std::filesystem::create_directories("build");
    const auto t =
        dm::geometry::laplacian_smooth_trace({{0, 0}, {2, 0}}, {{1}, {0}}, {},
                                             1, 4);
    std::vector<double> x, y, e;
    std::print("| actual completed passes | actual vertex0 x | actual vertex1 x | actual energy |\n| ---: | " "---: | ---: | ---: |\n");
    for (std::size_t i = 0; i < t.states.size(); ++i) {
        std::print("| {} | {} | {} | {} |\n", i, t.states[i][0].x,
                   t.states[i][1].x, t.energies[i]);
        x.push_back(i);
        y.push_back(t.states[i][0].x);
        e.push_back(t.energies[i]);
    }
    const auto c =
        dm::geometry::laplacian_smooth_trace({{0, 0}, {2, 0}}, {{1}, {0}}, {},
                                             .5, 1);
    std::print("\nActual lambda0.5 single-pass coordinates {}, {}; actual energy {}.\n",
               c.result[0].x, c.result[1].x, c.energies.back());
    auto p = dm::graphics::RPlot::create(), q = dm::graphics::RPlot::create();
    p.line(x, y, "vertex0", {37, 99, 235}, 2).points(x, y, "", {37, 99, 235}, 5).y_limits(-.25, 3).title("Actual identity0 alternates at lambda1").x_label("actual completed passes").y_label("actual x coordinate");
    q.line(x, e, "energy", {220, 38, 38}, 2).points(x, e, "", {220, 38, 38}, 5).y_limits(0, 6).title("Actual energy stays constant").x_label("actual completed passes").y_label("squared edge-length energy");
    dm::graphics::RLayout::create(2, 1).add(p).add(q).size(900, 800).title(
        "Actual oscillation despite nonincreasing energy").fit_panels().save_svg("build/laplacian_oscillation.svg");
}
```
