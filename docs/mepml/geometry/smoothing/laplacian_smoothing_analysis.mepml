> Original noisy curve with pinned endpoints

Retain41 vertices x=i, base y=8*sin(i/6), mt19937 seed42 and uniform[−3,3)
perturbations only on the39 interior y coordinates. The path connects
consecutive vertices, both endpoints are pinned, lambda is0.5 and the original
output is the actual40-pass state. Standard-library uniform mappings are
implementation-specific; the precise original generator order is preserved. The
noiseless base curve is an added reference for this synthetic experiment, not a
general graph-smoothing target.

The native trace performs one complete40-pass run and captures each real
state/energy. Selected rows below read that actual history rather than rerunning
every prefix. Equal coordinate scales keep the geometric curve honest.

```{cpp, results="markdown", file="figures/laplacian_original.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <datamunge/geometry/laplacian_analysis.hpp>
#include <datamunge/plot/plot.hpp>
#include <filesystem>
#include <print>
int main() {
    std::filesystem::create_directories("build");
    const auto d = dm::geometry::laplacian_demo_curve();
    const auto t =
        dm::geometry::laplacian_smooth_trace(d.vertices, d.neighbors, d.fixed,
                                             .5, 40);
    std::print("| actual completed passes | actual Dirichlet energy | actual mean squared point error to " "noiseless reference | original endpoints unchanged |\n| ---: | ---: | ---: | --- |\n");
    for (std::size_t i : {0, 5, 10, 20, 40})
        std::print("| {} | {:.12f} | {:.12f} | {} |\n", i, t.energies[i],
                   dm::geometry::laplacian_point_mse(t.states[i], d.reference),
                   t.states[i].front() == d.vertices.front() &&
                   t.states[i].back() == d.vertices.back());
    std::print("\nActual sweeps {}; actual free updates {}; neighbor-point reads {}; pinned skips {}; " "additional energy-edge evaluations {}.\n",
               t.work.sweeps, t.work.updated_vertices, t.work.neighbor_reads,
               t.work.pinned_skips, t.work.energy_edges);
    std::vector<double> x, noisy, smoothed, truth;
    for (std::size_t i = 0; i < d.vertices.size(); ++i) {
        x.push_back(d.vertices[i].x);
        noisy.push_back(d.vertices[i].y);
        smoothed.push_back(t.result[i].y);
        truth.push_back(d.reference[i].y);
    }
    auto p = dm::graphics::RPlot::create();
    p.line(x, noisy, "original", {220, 120, 120}, 1.5).points(x, noisy, "",
                                                              {220, 120, 120}, 3).line(x, smoothed, "40 passes", {37, 99, 235}, 2.5).line(x, truth, "reference", {22, 163, 74}, 1.5).size(850, 850).margins(95, 35, 60, 70).x_limits(-3, 43).y_limits(-23, 23).title("Original pinned curve and actual40-pass state").x_label("x").y_label("y").save_svg("build/laplacian_original.svg");
}
```
