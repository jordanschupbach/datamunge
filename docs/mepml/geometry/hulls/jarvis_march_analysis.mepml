> Degeneracy is part of the contract

Exact coordinate equality coalesces duplicates and signed zeros, retaining the
earliest source representation. Empty, singleton and two-distinct inputs use a
sorted shortcut with no wrapping events. Nonfinite coordinates are rejected. The
subnormal line demonstrates a corrected legacy failure: rounded squared
distances underflowed and kept interior vertices; the exact kernel returns just
the endpoints. Extreme finite coordinates are accepted by the hull kernel even
when a padded plotting span cannot be represented. Only the ordinary collinear
control is drawn here.

```{cpp, results="markdown", file="figures/jarvis_controls.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <datamunge/geometry/jarvis_analysis.hpp>
#include <filesystem>
#include <print>
#include <limits>
#include <stdexcept>
#include <cmath>
int main() {
    std::filesystem::create_directories("build");
    using P = dm::geometry::Point2D;
    const double d =
        std::numeric_limits<double>::denorm_min(), m =
        std::numeric_limits<double>::max();
    const std::vector<std::pair<const char *, std::vector<P>> > cases = {
        {"empty", {}}, {"singleton", {{2, 3}}},
        {"two distinct", {{1, 1}, {0, 0}, {1, 1}}},
        {"collinear duplicates",
         {{-3, -3}, {-1, -1}, {0, 0}, {2, 2}, {3, 3}, {3, 3}}},
        {"subnormal triangle", {{0, 0}, {d, 0}, {0, d}}},
        {"subnormal line", {{0, 0}, {d, d}, {2 * d, 2 * d}, {3 * d, 3 * d}}},
        {"finite extremes", {{-m, -m}, {m, -m}, {m, m}, {-m, m}, {0, 0}}}
    };
    std::print("| control | input | distinct | hull | orientations | events |\n| --- | ---: | ---: | ---: | " "---: | ---: |\n");
    for (const auto & [name, p] : cases) {
        const auto t = dm::geometry::jarvis_march_trace(p);
        std::print("| {} | {} | {} | {} | {} | {} |\n", name, p.size(),
                   t.sorted.size(), t.analysis.hull.size(),
                   t.analysis.work.orientation_tests, t.events.size());
    }
    const std::vector<P> tri = {{0, 0}, {2, 0}, {0, 2}};
    bool capped = false, invalid = false, overflow = false;
    long long count = std::numeric_limits<long long>::max();
    try {
        (void) dm::geometry::jarvis_march_trace(tri, {3, 8});
    } catch (const std::length_error &) {
        capped = true;
    }
    try {
        (void) dm::geometry::jarvis_march({{0, 0},
                                           {m,
                                            std::numeric_limits<double>::infinity()}});
    } catch (const std::invalid_argument &) {
        invalid = true;
    }
    try {
        (void) dm::geometry::jarvis_march(tri, count);
    } catch (const std::overflow_error &) {
        overflow = true;
    }
    if (!capped || !invalid || !overflow ||
        count != std::numeric_limits<long long>::max())
        throw std::runtime_error("guards");
    std::print("\nEight events reject the nine-event triangle; nonfinite input rejects; overflowing legacy " "counter stays unchanged.\n");
    const auto &p = cases[3].second;
    dm::geometry::jarvis_hull_plot(p, dm::geometry::jarvis_march_analyze(p)).title("Collinear duplicates: retain only endpoints").save_svg("build/jarvis_controls.svg");
}
```
