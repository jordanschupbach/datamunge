> Explicit controls

```{cpp, results="markdown", file="figures/segment_intersection_controls.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    namespace z = dm::geometry;
    const std::vector<std::array<z::Point2D, 4>> cases{{{{0, 0}, {4, 0}, {2, 0},
                                                         {6, 0}}},
                                                       {{{0, 0}, {2, 0}, {2, 0},
                                                         {3, 0}}},
                                                       {{{1, 0}, {1, 0}, {0, 0},
                                                         {2, 0}}},
                                                       {{{0, 0}, {0, 0}, {1, 1},
                                                         {1, 1}}}};
    std::vector<double> x, y;
    std::print("| control | actual contact enum | first endpoint | second endpoint |\n| ---: | ---: | --- | " "--- |\n");
    for (std::size_t i = 0; i < cases.size(); ++i) {
        const auto &c = cases[i];
        auto r = z::segment_intersection_trace(c[0], c[1], c[2], c[3]);
        std::print("| {} | {} | ({},{}) | ({},{}) |\n", i, int(r.contact),
                   r.first.x, r.first.y, r.second.x, r.second.y);
        x.push_back(i);
        y.push_back(int(r.contact));
    }
    auto plot = g::RPlot::create();
    plot.lines(x, y, "actual values", {37, 99, 235}).points(x, y, {37, 99, 235},
                                                            5).title(
        "Nonzero overlap, endpoint, point-segment and disjoint points").x_label(
        "control").y_label("actual contact enum (0 none,1 point,2 overlap)");
    plot.save_svg("build/segment_intersection_controls.svg");
}
```
