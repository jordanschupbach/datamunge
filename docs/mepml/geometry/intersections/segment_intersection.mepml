> Actual selected work and sensitivity

```{cpp, results="markdown", file="figures/segment_intersection_work.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    namespace z = dm::geometry;
    std::vector<double> x, exact, ordinary;
    std::print("| scale exponent10^e | actual exact sign | ordinary double cross | actual constructed " "parameter |\n| ---: | ---: | ---: | ---: |\n");
    for (int exponent : {-300, -200, -150, -50, 0, 50, 150, 200, 300}) {
        double s = std::pow(10., exponent);
        const z::Point2D p{-s, -s}, q{s, s}, r{-s, s}, t{s, -s};
        auto result = z::segment_intersection_trace(p, q, r, t);
        double rounded = z::cross(p, q, r);
        std::print("| {} | {} | {} | {} |\n", exponent, result.orientations[0],
                   rounded, result.parameter);
        x.push_back(exponent);
        exact.push_back(result.orientations[0] != 0);
        ordinary.push_back(std::isfinite(rounded) && rounded != 0);
    }
    auto plot = g::RPlot::create();
    plot.lines(x, exact, "actual exact predicate nonzero", {37, 99, 235}).lines(
        x, ordinary, "ordinary double cross finite and nonzero", {220, 38, 38}).title("Stored-coordinate signs across underflow and overflow scales").x_label("base10 coordinate scale exponent").y_label("actual criterion0 or1");
    plot.save_svg("build/segment_intersection_work.svg");
}
```
