> The retained original experiment

```{cpp, results="markdown", file="figures/segment_intersection_original.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    namespace z = dm::geometry;
    const z::Point2D p{0, 0}, q{6, 6};
    const std::vector<std::pair<z::Point2D, z::Point2D>> cases{{{0, 6}, {6, 0}},
                                                               {{0, 5}, {2, 6}},
                                                               {{6, 6}, {8, 2}}};
    const std::vector<std::string> names{"crosses", "disjoint", "touches"};
    auto plot = g::RPlot::create();
    plot.lines({p.x, q.x}, {p.y, q.y}, "reference", {15, 23, 42});
    std::print("| original case | actual signs | actual contact enum | point constructed | actual point x | " "actual point y |\n| --- | --- | ---: | --- | ---: | ---: |\n");
    std::vector<double> x, y;
    for (std::size_t i = 0; i < cases.size(); ++i) {
        const auto & [r, s] = cases[i];
        auto result = z::segment_intersection_trace(p, q, r, s);
        std::print("| {} | `{}` | {} | {} | {} | {} |\n", names[i],
                   result.orientations, int(result.contact),
                   result.point_constructed, result.first.x, result.first.y);
        plot.lines({r.x, s.x}, {r.y, s.y}, names[i],
                   i == 0 ? g::RGB{220, 38, 38} : i == 1 ? g::RGB{100, 116, 139}
                   : g::RGB{22, 163, 74});
        if (result.contact == z::SegmentContact::Point) {
            x.push_back(result.first.x);
            y.push_back(result.first.y);
        }
    }
    plot.points(x, y, "actual unique contacts", {147, 51, 234}, 7).size(760, 800).margins(80, 40, 72, 88).x_limits(-1, 9).y_limits(-1, 9).title("Original crossing, disjoint and closed-endpoint pairs").x_label("x").y_label("y");
    plot.save_svg("build/segment_intersection_original.svg");
}
```
