#include <datamunge/geometry/shamos_hoey.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    namespace z = dm::geometry;
    std::vector<double> x, y;
    std::print("| controlled horizontal segments | actual events | actual height tests | actual pair tests " "| actual AVL rotations |\n| ---: | ---: | ---: | ---: | ---: |\n");
    for (std::size_t n : {2, 4, 8, 16, 32, 64, 128, 256, 512}) {
        auto r = z::shamos_hoey_run(z::shamos_horizontal_segments(n));
        std::print("| {} | {} | {} | {} | {} |\n", n, r.events_processed,
                   r.height_tests, r.pair_tests, r.rotations);
        x.push_back(n);
        y.push_back(r.height_tests);
    }
    auto plot = g::RPlot::create();
    plot.lines(x, y, "actual values", {37, 99, 235}).points(x, y, {37, 99, 235},
                                                            5).title(
        "Actual balanced status searches on disjoint common-support segments").x_label("input segment count").y_label("actual exact height comparisons");
    plot.save_svg("build/shamos_hoey_work.svg");
}
