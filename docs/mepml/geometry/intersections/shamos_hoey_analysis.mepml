> The retained original experiment

```{cpp, results="markdown", file="figures/shamos_hoey_original.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <filesystem>
#include <print>
#include <algorithm>
#include <cmath>
#include <limits>
#include <numeric>
#include <numbers>
#include <random>
#include <string>
#include <vector>
#include <map>
#include <set>
#include <array>
#include <tuple>
#include <bit>
#include <datamunge/random/quality.hpp>
#include <datamunge/geometry/shamos_hoey.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    namespace z = dm::geometry;
    const std::vector<std::pair<z::Point2D, z::Point2D>> disjoint{
        {{0, 0}, {5, 0}}, {{0, 2}, {5, 2}}, {{0, 4}, {5, 4}}
    }, crossing{{{0, 0}, {6, 6}}, {{0, 6}, {6, 0}}, {{1, 5}, {5, 1}}}, original{
        {{0, 1}, {8, 5}}, {{1, 6}, {7, 0}}, {{2, 0}, {6, 6}}, {{0, 4}, {8, 3}}
    };
    std::print("Original disjoint decision {}; crossing decision {}.\n",
               z::any_segments_intersect(disjoint),
               z::any_segments_intersect(crossing));
    auto r = z::shamos_hoey_trace(original);
    std::print("Original four-segment actual witness {},{}.\n\n| actual event x | kind (0 start,1 " "vertical,2 end) | original id | actual active after | AVL height after |\n| ---: | ---: | " "---: | ---: | ---: |\n",
               r.first, r.second);
    for (const auto &e : r.events)
        std::print("| {} | {} | {} | {} | {} |\n", e.x, int(e.kind), e.segment,
                   e.active_after, e.tree_height_after);
    auto plot = g::RPlot::create();
    for (std::size_t i = 0; i < original.size(); ++i) {
        auto[p, q] = original[i];
        plot.lines({p.x, q.x}, {p.y, q.y}, std::format("original segment{}", i),
                   i == r.first || i == r.second ? g::RGB{220, 38, 38}
                   : g::RGB{100, 116, 139});
    }
    plot.size(760, 800).margins(80, 40, 72, 88).x_limits(-1, 9).y_limits(
        -2, 8).title("Original four segments: actual first discovered witness").x_label("x").y_label("y");
    plot.save_svg("build/shamos_hoey_original.svg");
}
```
