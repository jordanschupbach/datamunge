> Explicit controls

```{cpp, results="markdown", file="figures/shamos_hoey_controls.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <filesystem>
#include <print>
#include <algorithm>
#include <cmath>
#include <limits>
#include <numeric>
#include <numbers>
#include <random>
#include <string>
#include <vector>
#include <map>
#include <set>
#include <array>
#include <tuple>
#include <bit>
#include <datamunge/random/quality.hpp>
#include <datamunge/geometry/shamos_hoey.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    namespace z = dm::geometry;
    const std::vector<std::vector<std::pair<z::Point2D, z::Point2D>> > cases{
        {{{2, 0}, {2, 4}}, {{0, 2}, {4, 2}}},
        {{{2, 0}, {2, 1}}, {{2, 2}, {2, 3}}},
        {{{2, 0}, {2, 4}}, {{2, 3}, {2, 5}}},
        {{{1, 1}, {1, 1}}, {{0, 1}, {2, 1}}},
        {{{0, 0}, {1, 1}}, {{1, 1}, {2, 0}}}
    };
    std::vector<double> x, y;
    std::print("| degeneracy control | actual found | actual pair tests | actual height tests |\n| ---: | " "--- | ---: | ---: |\n");
    for (std::size_t i = 0; i < cases.size(); ++i) {
        auto r = z::shamos_hoey_trace(cases[i]);
        std::print("| {} | {} | {} | {} |\n", i, r.found, r.pair_tests,
                   r.height_tests);
        x.push_back(i);
        y.push_back(r.found);
    }
    auto plot = g::RPlot::create();
    plot.lines(x, y, "actual values", {37, 99, 235}).points(x, y, {37, 99, 235},
                                                            5).title(
        "Vertical crossing, disjoint verticals, overlap, point and endpoint").x_label("control").y_label("actual exact intersection decision");
    plot.save_svg("build/shamos_hoey_controls.svg");
}
```
