> Explicit controls

```{cpp, results="markdown", file="figures/scanline_fill_controls.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <filesystem>
#include <print>
#include <algorithm>
#include <cmath>
#include <limits>
#include <numeric>
#include <numbers>
#include <random>
#include <string>
#include <vector>
#include <map>
#include <set>
#include <array>
#include <tuple>
#include <bit>
#include <datamunge/algorithms/scanline_fill.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    const std::vector<std::vector<a::Point2D>> v{{{0.2, 0.2}, {2.2, 0.2},
                                                  {2.2, 2.2}, {0.2, 2.2}},
                                                 {{-2, -2}, {2, -2}, {2, 2},
                                                  {-2, 2}}, {{0, 0}, {1, 1}}};
    std::vector<double> x, y;
    std::print("| control | actual pixels | actual rows |\n| ---: | ---: | ---: |\n");
    for (std::size_t i = 0; i < v.size(); ++i) {
        a::ScanlineOptions o;
        if (i == 1) {
            o.min_x = 0;
            o.max_x = 0;
            o.min_y = -1;
            o.max_y = 1;
        }
        auto r = a::scanline_fill_trace(v[i], o);
        std::print("| {} | {} | {} |\n", i, r.pixels.size(), r.scanlines);
        x.push_back(i);
        y.push_back(r.pixels.size());
    }
    bool bad = false;
    try {
        a::scanline_fill({{0, 0}, {1, std::numeric_limits<double>::infinity()},
                          {2, 0}});
    } catch (const std::invalid_argument &) {
        bad = true;
    }
    std::print("Nonfinite vertex rejected {}.\n", bad);
    if (!bad)
        return 1;
    auto plot = g::RPlot::create();
    plot.lines(x, y, "actual values", {37, 99, 235}).points(x, y, {37, 99, 235},
                                                            5).title(
        "Fractional-bottom, clipped and degenerate controls").x_label("control").y_label("actual unique pixels");
    plot.save_svg("build/scanline_fill_controls.svg");
}
```
// result_begin: markdown
| control | actual pixels | actual rows |
| ---: | ---: | ---: |
| 0 | 4 | 2 |
| 1 | 3 | 3 |
| 2 | 0 | 0 |
Nonfinite vertex rejected true.
\image(figures/scanline_fill_controls.svg)
