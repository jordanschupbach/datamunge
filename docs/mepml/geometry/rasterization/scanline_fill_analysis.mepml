> Actual selected work and sensitivity

```{cpp, results="markdown", file="figures/scanline_fill_work.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <filesystem>
#include <print>
#include <algorithm>
#include <cmath>
#include <limits>
#include <numeric>
#include <numbers>
#include <random>
#include <string>
#include <vector>
#include <map>
#include <set>
#include <array>
#include <tuple>
#include <bit>
#include <datamunge/algorithms/scanline_fill.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    std::vector<double> x, y;
    std::print("| square side | actual candidate rows | actual edge tests | actual output pixels |\n| ---: " "| ---: | ---: | ---: |\n");
    for (double n : {2, 4, 8, 16, 32, 64}) {
        auto r = a::scanline_fill_run({{0, 0}, {n, 0}, {n, n}, {0, n}});
        std::print("| {} | {} | {} | {} |\n", n, r.scanlines, r.edge_tests,
                   r.pixels.size());
        x.push_back(n);
        y.push_back(r.edge_tests);
    }
    auto plot = g::RPlot::create();
    plot.lines(x, y, "actual values", {37, 99, 235}).points(x, y, {37, 99, 235},
                                                            5).title(
        "Actual edge testing grows with sampled rows").x_label("square side").y_label("actual edge predicates");
    plot.save_svg("build/scanline_fill_work.svg");
}
