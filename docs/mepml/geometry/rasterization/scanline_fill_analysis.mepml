> The retained original experiment

```{cpp, results="markdown", file="figures/scanline_fill_original.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <filesystem>
#include <print>
#include <algorithm>
#include <cmath>
#include <limits>
#include <numeric>
#include <numbers>
#include <random>
#include <string>
#include <vector>
#include <map>
#include <set>
#include <array>
#include <tuple>
#include <bit>
#include <datamunge/algorithms/scanline_fill.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    const std::vector<std::vector<a::Point2D>> polygons{{{0, 0}, {10, 0},
                                                         {10, 10}, {0, 10}},
                                                        {{0, 0}, {20, 0},
                                                         {0, 20}},
                                                        {{2, 0}, {6, 4}, {2, 8},
                                                         {4, 4}}};
    std::print("| original shape | actual unique pixels | actual tested edges |\n| --- | ---: | ---: |\n");
    const std::vector<std::string> names{"square", "right triangle",
                                         "concave arrow"};
    auto plot = g::RPlot::create();
    for (std::size_t i = 0; i < polygons.size(); ++i) {
        auto r = a::scanline_fill_run(polygons[i]);
        std::print("| {} | {} | {} |\n", names[i], r.pixels.size(), r.edge_tests);
        std::vector<double> x, y;
        for (auto pixel : r.pixels) {
            x.push_back(pixel.x + 0.5 + 24 * i);
            y.push_back(pixel.y + 0.5);
        }
        plot.points(x, y, names[i],
                    i == 0 ? g::RGB{37, 99, 235} : i == 1 ? g::RGB{220, 38, 38}
                    : g::RGB{22, 163, 74}, 3);
    }
    plot.size(1100, 468).margins(80, 40, 72, 88).x_limits(0, 70).y_limits(
        0, 22).title("Original polygon pixel centers; shapes offset horizontally").x_label("center x plus display offset").y_label("center y");
    plot.save_svg("build/scanline_fill_original.svg");
}
```
// result_begin: markdown
| original shape | actual unique pixels | actual tested edges |
| --- | ---: | ---: |
| square | 100 | 40 |
| right triangle | 210 | 60 |
| concave arrow | 12 | 32 |
\image(figures/scanline_fill_original.svg)
// result_end
