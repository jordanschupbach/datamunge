```{cpp, results="markdown", file="figures/quickhull_work.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <datamunge/plot/plot.hpp>
#include <datamunge/plot/diagram.hpp>
#include <datamunge/algorithms/modular_exponentiation.hpp>
#include <datamunge/algorithms/integer_arithmetic.hpp>
#include <filesystem>
#include <print>
#include <algorithm>
#include <cmath>
#include <limits>
#include <climits>
#include <datamunge/algorithms/number_theory.hpp>
#include <numeric>
#include <numbers>
#include <random>
#include <string>
#include <vector>
#include <map>
#include <set>
#include <array>
#include <tuple>
#include <datamunge/algorithms/prufer.hpp>
#include <datamunge/algorithms/flow_diagram.hpp>
#include <datamunge/geometry/hull_algorithms.hpp>
#include <datamunge/random/sampling_analysis.hpp>
#include <iomanip>
#include <bit>
#include <datamunge/geometry/quickhull.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");

    namespace h = dm::geometry;
    std::vector<double> x, y, z;
    std::print("\n| generated points | square hull | square predicates | parabola hull | parabola " "predicates |\n| ---: | ---: | ---: | ---: | ---: |\n");
    for (int n : {16, 32, 64, 128, 256, 512}) {
        auto square =
            h::quickhull_run(h::random_point_cloud(n, h::PointCloud::Square, 42));
        auto parabola =
            h::quickhull_run(h::random_point_cloud(n, h::PointCloud::Parabola,
                                                   42));
        x.push_back(n);
        y.push_back(square.predicates);
        z.push_back(parabola.predicates);
        std::print("| {} | {} | {} | {} | {} |\n", n, square.hull.size(),
                   square.predicates, parabola.hull.size(), parabola.predicates);
    }
    auto p = g::RPlot::create();
    p.lines(x, y, "actual square-cloud predicates", {37, 99, 235}).lines(
        x, z, "actual convex-position predicates", {234, 88, 12}).title(
        "Different hull geometry changes actual Quickhull work").x_label(
        "generated input points").y_label("actual exact predicate calls");
    p.save_svg("build/quickhull_work.svg");
}
```
