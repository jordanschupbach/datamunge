> Explicit controls

```{cpp, results="markdown", file="figures/quickhull_controls.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <datamunge/plot/plot.hpp>
#include <datamunge/plot/diagram.hpp>
#include <datamunge/algorithms/modular_exponentiation.hpp>
#include <datamunge/algorithms/integer_arithmetic.hpp>
#include <filesystem>
#include <print>
#include <algorithm>
#include <cmath>
#include <limits>
#include <climits>
#include <datamunge/algorithms/number_theory.hpp>
#include <numeric>
#include <numbers>
#include <random>
#include <string>
#include <vector>
#include <map>
#include <set>
#include <array>
#include <tuple>
#include <datamunge/algorithms/prufer.hpp>
#include <datamunge/algorithms/flow_diagram.hpp>
#include <datamunge/geometry/hull_algorithms.hpp>
#include <datamunge/random/sampling_analysis.hpp>
#include <iomanip>
#include <bit>
#include <datamunge/geometry/quickhull.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");

    namespace h = dm::geometry;
    const double big =
        std::numeric_limits<double>::max(), tiny =
        std::numeric_limits<double>::denorm_min();
    std::vector<std::vector<h::Point2D>> cases{{}, {{0, 0}, {0, 0}},
                                               {{0, 0}, {1, 0}, {2, 0}},
                                               {{0, 0}, {1, 0}, {0, tiny}},
                                               {{-big, -big}, {big, -big},
                                                {big, big}, {-big, big}, {0, 0}}};
    std::vector<std::string> labels{"empty", "duplicates", "collinear",
                                    "subnormal turn", "full-range corners"};
    std::vector<double> counts;
    std::print("\n| actual control | unique points | actual hull vertices | exact predicates |\n| --- | " "---: | ---: | ---: |\n");
    for (std::size_t i = 0; i < cases.size(); ++i) {
        auto r = h::quickhull_run(cases[i]);
        counts.push_back(r.hull.size());
        std::print("| {} | {} | {} | {} |\n", labels[i], r.points.size(),
                   r.hull.size(), r.predicates);
    }
    auto p = g::RPlot::barplot(counts, labels, "actual strict hull size");
    p.title("Exact represented-coordinate hull controls").y_label(
        "actual hull vertices");
    p.save_svg("build/quickhull_controls.svg");
}
```
