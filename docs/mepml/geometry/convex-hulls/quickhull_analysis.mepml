> The retained original experiment

```{cpp, results="markdown", file="figures/quickhull_original.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <datamunge/plot/plot.hpp>
#include <datamunge/plot/diagram.hpp>
#include <datamunge/algorithms/modular_exponentiation.hpp>
#include <datamunge/algorithms/integer_arithmetic.hpp>
#include <filesystem>
#include <print>
#include <algorithm>
#include <cmath>
#include <limits>
#include <climits>
#include <datamunge/algorithms/number_theory.hpp>
#include <numeric>
#include <numbers>
#include <random>
#include <string>
#include <vector>
#include <map>
#include <set>
#include <array>
#include <tuple>
#include <datamunge/algorithms/prufer.hpp>
#include <datamunge/algorithms/flow_diagram.hpp>
#include <datamunge/geometry/hull_algorithms.hpp>
#include <datamunge/random/sampling_analysis.hpp>
#include <iomanip>
#include <bit>
#include <datamunge/geometry/quickhull.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");

    namespace h = dm::geometry;
    const std::vector<h::Point2D> input{{0, 0}, {10, 0}, {18, 4}, {20, 12},
                                        {15, 20}, {6, 22}, {-2, 15}, {-4, 6},
                                        {5, 5}, {10, 10}, {8, 15}, {3, 10},
                                        {12, 6}, {14, 14}, {2, 18}, {16, 10},
                                        {7, 3}, {11, 17}, {9, 8}, {13, 11}};
    auto t = h::quickhull_trace(input);
    std::vector<double> x, y, hx, hy;
    for (auto p : input) {
        x.push_back(p.x);
        y.push_back(p.y);
    }
    std::print("\n| actual hull position | x | y |\n| ---: | ---: | ---: |\n");
    for (std::size_t i = 0; i < t.hull.size(); ++i) {
        hx.push_back(t.hull[i].x);
        hy.push_back(t.hull[i].y);
        std::print("| {} | {} | {} |\n", i, t.hull[i].x, t.hull[i].y);
    }
    auto p = g::RPlot::create();
    p.size(760, 800).margins(80, 40, 72, 88).x_limits(-5, 23).y_limits(-5, 23).polygon(hx, hy, {254, 226, 226}, true).points(x, y, "original points", {30, 41, 59}, 5).points(hx, hy, "actual strict hull", {234, 88, 12}, 7).title("Original twenty-point cloud: exact native Quickhull").x_label("x, equal coordinate scale").y_label("y, equal coordinate scale");
    p.save_svg("build/quickhull_original.svg");
}
```
