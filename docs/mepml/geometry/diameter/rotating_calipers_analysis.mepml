> Actual selected work and sensitivity

```{cpp, results="markdown", file="figures/rotating_calipers_work.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <filesystem>
#include <print>
#include <algorithm>
#include <cmath>
#include <limits>
#include <numeric>
#include <numbers>
#include <random>
#include <string>
#include <vector>
#include <map>
#include <set>
#include <array>
#include <tuple>
#include <bit>
#include <datamunge/geometry/rotating_calipers.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    namespace z = dm::geometry;
    std::vector<double> x, y;
    std::print("| original seed | actual hull vertices | actual area tests | pair tests | pointer advances " "|\n| ---: | ---: | ---: | ---: | ---: |\n");
    for (unsigned seed : {1, 2, 3, 7, 11, 31337, 42, 99}) {
        auto t = z::polygon_diameter_run(z::diameter_example_cloud(seed));
        std::print("| {} | {} | {} | {} | {} |\n", seed, t.hull.size(),
                   t.area_tests, t.pair_tests, t.pointer_advances);
        x.push_back(t.hull.size());
        y.push_back(t.area_tests + t.pair_tests);
    }
    auto p = g::RPlot::create();
    p.points(x, y, {37, 99, 235}, 6).title("Actual antipode work across fixed-size Gaussian fixtures").x_label("actual canonical hull vertices H").y_label("actual area comparisons plus pair tests");
    p.save_svg("build/rotating_calipers_work.svg");
}
```
