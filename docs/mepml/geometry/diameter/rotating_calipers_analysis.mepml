> Explicit controls

```{cpp, results="markdown", file="figures/rotating_calipers_controls.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <filesystem>
#include <print>
#include <algorithm>
#include <cmath>
#include <limits>
#include <numeric>
#include <numbers>
#include <random>
#include <string>
#include <vector>
#include <map>
#include <set>
#include <array>
#include <tuple>
#include <bit>
#include <datamunge/geometry/rotating_calipers.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    namespace z = dm::geometry;
    const std::vector<std::vector<z::Point2D>> sets{{{0, 0}, {3, 4}},
                                                    {{0, 0}, {1, 0}, {2, 0},
                                                     {1, 0}},
                                                    {{0, 0}, {1, 0}, {1, 1},
                                                     {0, 1}}};
    std::vector<double> x, y;
    std::vector<std::string> labels{"two points", "collinear duplicates",
                                    "equal-area square"};
    std::print("| control | actual hull | diameter | area tests | pair tests |\n| --- | ---: | ---: | ---: " "| ---: |\n");
    for (std::size_t i = 0; i < sets.size(); ++i) {
        auto t = z::polygon_diameter_trace(sets[i]);
        std::print("| {} | {} | {} | {} | {} |\n", labels[i], t.hull.size(),
                   t.result.distance, t.area_tests, t.pair_tests);
        x.push_back(i);
        y.push_back(t.result.distance);
    }
    bool rejected = false;
    try {
        z::polygon_diameter({{1, 1}, {1, 1}});
    } catch (const std::invalid_argument &) {
        rejected = true;
    }
    std::print("Fewer than two distinct points rejected: {}.\n", rejected);
    if (!rejected)
        return 1;
    auto p = g::RPlot::create();
    p.bars(x, y, "actual Euclidean diameter", {22, 163, 74}, .8).x_ticks(
        x, labels).title("Native degenerate-hull and antipodal tie controls").x_label("controlled planar set").y_label("actual farthest distance");
    p.save_svg("build/rotating_calipers_controls.svg");
}
```
