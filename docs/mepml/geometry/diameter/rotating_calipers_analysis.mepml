> The retained original experiment

```{cpp, results="markdown", file="figures/rotating_calipers_original.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <filesystem>
#include <print>
#include <algorithm>
#include <cmath>
#include <limits>
#include <numeric>
#include <numbers>
#include <random>
#include <string>
#include <vector>
#include <map>
#include <set>
#include <array>
#include <tuple>
#include <bit>
#include <datamunge/geometry/rotating_calipers.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    namespace z = dm::geometry;
    const std::vector<z::Point2D> hand{{0, 0}, {10, 0}, {10, 10}, {0, 10},
                                       {5, 5}, {2, 8}};
    auto square = z::polygon_diameter_run(hand);
    const auto cloud = z::diameter_example_cloud();
    auto t = z::polygon_diameter_trace(cloud);
    std::print("Original square-plus-interior diameter {}, mathematical sqrt(200) {}.\nOriginal 50-point " "cloud: actual hull {}, diameter {}, area tests {}, pair tests {}, advances {}.\n\n| actual " "winning endpoint | x | y |\n| --- | ---: | ---: |\n| first | {} | {} |\n| second | {} | {} " "|\n",
               square.result.distance, std::sqrt(200.), t.hull.size(),
               t.result.distance, t.area_tests, t.pair_tests,
               t.pointer_advances, t.result.a.x, t.result.a.y, t.result.b.x,
               t.result.b.y);
    std::vector<double> x, y, hx, hy;
    for (auto p : cloud) {
        x.push_back(p.x);
        y.push_back(p.y);
    }
    for (auto p : t.hull) {
        hx.push_back(p.x);
        hy.push_back(p.y);
    }
    auto p = g::RPlot::create();
    p.polygon(hx, hy, {148, 163, 184}, false).points(x, y,
                                                     "original Gaussian cloud",
                                                     {100, 116, 139}, 4).lines(
        {t.result.a.x, t.result.b.x}, {t.result.a.y, t.result.b.y},
        "actual native farthest pair", {220, 38, 38}, 3).title(
        "Original seed 31337 cloud: actual rotating-calipers diameter").x_label(
        "original x coordinate").y_label("original y coordinate").size(760, 800).margins(80, 40, 72, 88).x_limits(-10, 10).y_limits(-10, 10);
    p.save_svg("build/rotating_calipers_original.svg");
}
```
