> The retained original experiment

```{cpp, results="markdown", file="figures/voronoi_original.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    auto sites = dm::geometry::voronoi_example_sites();
    auto clipped = dm::geometry::clipped_voronoi(sites, {0, 10, 0, 10});
    auto legacy = dm::geometry::voronoi_diagram(sites);
    std::print("| original sites | actual clipped cells | old dual vertices | clipping edge tests " "|\n|---:|---:|---:|---:|\n|{}|{}|{}|{}|\n",
               sites.size(), clipped.cells.size(), legacy.vertices.size(),
               clipped.edge_tests);
    auto p = dm::geometry::clipped_voronoi_plot(clipped);
    p.save_svg("build/voronoi_original.svg");
}
```
