> Checking the theory and controls

```{cpp, results="markdown", file="figures/voronoi_controls.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    std::vector<double> x, y;
    std::print("| collinear sites | actual cells | actual half-planes |\n|---:|---:|---:|\n");
    for (int n : {0, 1, 2, 3, 5, 10}) {
        std::vector<dm::geometry::Point2D> sites;
        for (int i = 0; i < n; ++i)
            sites.push_back({double(i) + .5, .5});
        auto r = dm::geometry::clipped_voronoi(sites, {0, 10, 0, 1});
        std::print("|{}|{}|{}|\n", n, r.cells.size(), r.halfplanes);
        x.push_back(n);
        y.push_back(r.halfplanes);
    }
    auto p = g::RPlot::create();
    p.line(x, y, "actual", {37, 99, 235}, 2);
    p.points(x, y, "", {37, 99, 235}, 5);
    p.title("Empty, singleton and collinear cells do not need triangulation").x_label("sites").y_label("actual competitor half-planes");
    p.save_svg("build/voronoi_controls.svg");
}
```
// result_begin: markdown
| collinear sites | actual cells | actual half-planes |
|---:|---:|---:|
