> Sensitivity and selected work

```{cpp, results="markdown", file="figures/voronoi_work.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    std::vector<double> x, y;
    std::print("| site count | actual half-planes | actual edge tests |\n|---:|---:|---:|\n");
    auto original = dm::geometry::voronoi_example_sites();
    for (std::size_t n : {2, 4, 8, 12, 16, 20, 24}) {
        std::vector<dm::geometry::Point2D> sites(original.begin(),
                                                 original.begin() + n);
        auto r = dm::geometry::clipped_voronoi(sites, {0, 10, 0, 10});
        std::print("|{}|{}|{}|\n", n, r.halfplanes, r.edge_tests);
        x.push_back(n);
        y.push_back(r.edge_tests);
    }
    auto p = g::RPlot::create();
    p.line(x, y, "actual", {37, 99, 235}, 2);
    p.points(x, y, "", {37, 99, 235}, 5);
    p.title("Actual clipping work on prefixes of original24 sites").x_label(
        "site count").y_label("actual polygon-edge decisions");
    p.save_svg("build/voronoi_work.svg");
}
```
