> Actual selected work and sensitivity

```{cpp, results="markdown", file="figures/sutherland_hodgman_work.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <filesystem>
#include <print>
#include <algorithm>
#include <cmath>
#include <limits>
#include <numeric>
#include <numbers>
#include <random>
#include <string>
#include <vector>
#include <map>
#include <set>
#include <array>
#include <tuple>
#include <bit>
#include <datamunge/random/quality.hpp>
#include <datamunge/algorithms/sutherland_hodgman.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    std::vector<double> x, y;
    std::print("| regular subject vertices | actual edge classifications | actual intersections | final " "vertices |\n| ---: | ---: | ---: | ---: |\n");
    for (std::size_t n : {4, 8, 16, 32, 64, 128, 256}) {
        std::vector<a::Point2> poly;
        for (std::size_t i = 0; i < n; ++i) {
            double t = 2 * std::numbers::pi * i / n;
            poly.emplace_back(std::cos(t) * 2, std::sin(t) * 2);
        }
        auto r = a::sutherland_hodgman_run(poly, -1, -1, 1, 1);
        x.push_back(n);
        y.push_back(r.edge_visits);
        std::print("| {} | {} | {} | {} |\n", n, r.edge_visits, r.intersections,
                   r.polygon.size());
    }
    auto plot = g::RPlot::create();
    plot.lines(x, y, "actual native values", {37, 99, 235}).points(
        x, y, {37, 99, 235}, 4).title("Actual four-boundary work on controlled regular subjects").x_label("input vertices").y_label("actual edge classifications");
    plot.save_svg("build/sutherland_hodgman_work.svg");
}
```
