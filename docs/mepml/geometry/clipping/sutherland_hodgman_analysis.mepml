> The retained original experiment

```{cpp, results="markdown", file="figures/sutherland_hodgman_original.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <filesystem>
#include <print>
#include <algorithm>
#include <cmath>
#include <limits>
#include <numeric>
#include <numbers>
#include <random>
#include <string>
#include <vector>
#include <map>
#include <set>
#include <array>
#include <tuple>
#include <bit>
#include <datamunge/random/quality.hpp>
#include <datamunge/algorithms/sutherland_hodgman.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    const std::vector<a::Point2> tri{{-4, 2}, {14, 4}, {5, 16}};
    auto r = a::sutherland_hodgman_trace(tri, 0, 0, 10, 10);
    std::print("Original triangle clipped to[0,10]x[0,10].\n\n| actual processed boundary | actual complete " "output walk |\n| ---: | --- |\n");
    for (const auto &s : r.history)
        std::print("| {} | `{}` |\n", s.boundary, s.after);
    std::vector<double> x, y;
    for (auto[px, py] : r.polygon) {
        x.push_back(px);
        y.push_back(py);
    }
    auto chart = g::RPlot::create();
    chart.polygon({0, 10, 10, 0}, {0, 0, 10, 10}, {226, 232, 240}, true).polygon({-4, 14, 5}, {2, 4, 16}, {37, 99, 235}, false).polygon(x, y, {220, 38, 38}, false).points(x, y, {220, 38, 38}, 5).size(760, 800).margins(80, 40, 72, 88).xlim(-5, 17).ylim(-3, 19).title("Original triangle: actual clipped polygon in red").x_label("x").y_label("y");
    chart.save_svg("build/sutherland_hodgman_original.svg");
}
```
