> Explicit controls

```{cpp, results="markdown", file="figures/sutherland_hodgman_controls.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <filesystem>
#include <print>
#include <algorithm>
#include <cmath>
#include <limits>
#include <numeric>
#include <numbers>
#include <random>
#include <string>
#include <vector>
#include <map>
#include <set>
#include <array>
#include <tuple>
#include <bit>
#include <datamunge/random/quality.hpp>
#include <datamunge/algorithms/sutherland_hodgman.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    std::vector<std::vector<a::Point2>> cases{{},
                                              {{.1, .1}, {.9, .1}, {.1, .9}},
                                              {{2, 2}, {3, 2}, {2, 3}},
                                              {{0, 0}, {1, 0}, {1, 1}, {0, 1}},
                                              {{-1, 0}, {2, 0}, {0, 2}}};
    std::vector<double> x, y;
    std::print("| control | input vertices | actual final vertices | actual intersections |\n| ---: | ---: " "| ---: | ---: |\n");
    for (std::size_t i = 0; i < cases.size(); ++i) {
        auto r = a::sutherland_hodgman_run(cases[i], 0, 0, 1, 1);
        x.push_back(i);
        y.push_back(r.polygon.size());
        std::print("| {} | {} | {} | {} |\n", i, cases[i].size(),
                   r.polygon.size(), r.intersections);
    }
    auto plot = g::RPlot::create();
    plot.lines(x, y, "actual native values", {37, 99, 235}).points(
        x, y, {37, 99, 235}, 4).title("Empty, inside, outside, boundary and crossing controls").x_label("control index").y_label("actual output walk vertices");
    plot.save_svg("build/sutherland_hodgman_controls.svg");
}
```
