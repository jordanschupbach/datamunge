> Sensitivity and selected work

```{cpp, results="markdown", file="figures/vincenty_work.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    std::vector<double> x, y;
    std::print("| tolerance radians | actual distance metres | actual updates |\n|---:|---:|---:|\n");
    for (double tol : {1e-4, 1e-6, 1e-8, 1e-10, 1e-12, 1e-14}) {
        auto r =
            a::vincenty_inverse(51.5074, -.1278, 40.7128, -74.006, 200, tol);
        std::print("|{}|{}|{}|\n", tol, r.distance_m, r.iterations);
        x.push_back(-std::log10(tol));
        y.push_back(r.iterations);
    }
    auto p = g::RPlot::create();
    p.line(x, y, "actual", {37, 99, 235}, 2);
    p.points(x, y, "", {37, 99, 235}, 5);
    p.title("Stricter angular tolerances require actual extra updates").x_label(
        "-log10 angular tolerance").y_label("actual updates");
    p.save_svg("build/vincenty_work.svg");
}
```
// result_begin: markdown
| tolerance radians | actual distance metres | actual updates |
|---:|---:|---:|
