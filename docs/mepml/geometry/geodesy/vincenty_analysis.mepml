> The retained original experiment

```{cpp, results="markdown", file="figures/vincenty_original.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    auto fb =
        a::vincenty_inverse(-37.95103341666667, 144.42486788888889,
                            -37.65282113888889, 143.92649552777778);
    std::print("Flinders Peak to Buninyong: actual {}m; published line54972.271m; converged {}.\n\n",
               fb.distance_m, fb.converged);
    std::vector<std::string> labels;
    std::vector<double> diffs;
    std::print("| route | actual metres | spherical metres | converged |\n|---|---:|---:|---|\n");
    for (auto[name, a0, b0, a1, b1] : std::vector<std::tuple<std::string, double, double, double, double>>{{"London-New York", 51.5074, -.1278, 40.7128, -74.006}, {"Tokyo-Sydney", 35.6762, 139.6503, -33.8688, 151.2093}, {"Cairo-Cape Town", 30.0444, 31.2357, -33.9249, 18.4241}, {"Quito-Singapore", -.1807, -78.4678, 1.3521, 103.8198}}) {
        auto r = a::vincenty_inverse(a0, b0, a1, b1);
        double sphere = a::haversine_distance(a0, b0, a1, b1);
        std::print("|{}|{}|{}|{}|\n", name, r.distance_m, sphere, r.converged);
        if (r.converged) {
            labels.push_back(name);
            diffs.push_back((r.distance_m - sphere) / 1000);
        }
    }
    auto p =
        g::RPlot::barplot(diffs, labels, "ellipsoid minus sphere km",
                          {37, 99, 235});
    p.title("Original routes: converged ellipsoid minus sphere").y_label(
        "kilometres difference");
    p.save_svg("build/vincenty_original.svg");
}
```
