> Checking the theory and controls

```{cpp, results="markdown", file="figures/vincenty_controls.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    std::vector<double> x, y;
    std::print("| longitude separation | actual converged | updates | distance metres " "|\n|---:|---|---:|---:|\n");
    for (double lon : {0., 1., 90., 170., 179., 179.5, 179.9, 180.}) {
        auto r = a::vincenty_inverse(0, 0, 0, lon);
        std::print("|{}|{}|{}|{}|\n", lon, r.converged, r.iterations,
                   r.distance_m);
        x.push_back(lon);
        y.push_back(r.iterations);
    }
    auto p = g::RPlot::create();
    p.line(x, y, "actual", {37, 99, 235}, 2);
    p.points(x, y, "", {37, 99, 235}, 5);
    p.title("Near-antipodal controls expose iteration exhaustion").x_label(
        "longitude separation degrees").y_label("actual updates, capped at200");
    p.save_svg("build/vincenty_controls.svg");
}
```
