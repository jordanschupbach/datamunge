> The retained original experiment

```{cpp, results="markdown", file="figures/point_in_polygon_original.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <datamunge/plot/plot.hpp>
#include <datamunge/plot/diagram.hpp>
#include <datamunge/algorithms/modular_exponentiation.hpp>
#include <datamunge/algorithms/integer_arithmetic.hpp>
#include <filesystem>
#include <print>
#include <algorithm>
#include <cmath>
#include <limits>
#include <climits>
#include <datamunge/algorithms/number_theory.hpp>
#include <numeric>
#include <numbers>
#include <random>
#include <string>
#include <vector>
#include <datamunge/geometry/point_in_polygon.hpp>
int main() {
    std::filesystem::create_directories("build");

    const std::vector<dm::geometry::Point2D> polygon{{0, 0}, {6, 0}, {6, 4},
                                                     {3, 2}, {0, 4}};
    std::print("\n| original query | native semi-open parity | exact boundary |\n| --- | --- | --- |\n");
    for (auto q : std::vector<dm::geometry::Point2D>{{3, 1}, {3, 3}, {1, 2},
                                                     {5, 3.5}, {7, 2}}) {
        auto t = dm::geometry::point_in_polygon_trace(q, polygon);
        std::print("| ({},{}) | {} | {} |\n", q.x, q.y, t.inside,
                   t.location == dm::geometry::PolygonLocation::Boundary);
    }
    std::vector<double> ix, iy, ox, oy, px, py;
    for (double y = -.5; y <= 4.5; y += .2)
        for (double x = -.5; x <= 6.5; x += .2) {
            const bool inside = dm::geometry::point_in_polygon({x, y}, polygon);
    (inside ? ix : ox).push_back(x);
    (inside ? iy : oy).push_back(y);
        }
        for (auto q : polygon) {
            px.push_back(q.x);
            py.push_back(q.y);
        }
        std::print("Original double-increment grid: actual inside count {}, outside count {}.\n",
                   ix.size(), ox.size());
        auto p = dm::graphics::RPlot::create();
        p.points(ox, oy, "semi-open outside", {203, 213, 225}, 3.5).points(
            ix, iy, "semi-open inside", {16, 185, 129}, 4).polygon(
            px, py, {37, 99, 235}, false).title("Original concave chevron: actual exact-predicate parity decisions").x_label("x").y_label("y");
        p.save_svg("build/point_in_polygon_original.svg");
}
```
