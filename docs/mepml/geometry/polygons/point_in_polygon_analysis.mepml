> Stored-coordinate and full-range controls

```{cpp, results="markdown", file="figures/point_in_polygon_work.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <datamunge/plot/plot.hpp>
#include <datamunge/plot/diagram.hpp>
#include <datamunge/algorithms/modular_exponentiation.hpp>
#include <datamunge/algorithms/integer_arithmetic.hpp>
#include <filesystem>
#include <print>
#include <algorithm>
#include <cmath>
#include <limits>
#include <climits>
#include <datamunge/algorithms/number_theory.hpp>
#include <numeric>
#include <numbers>
#include <random>
#include <string>
#include <vector>
#include <datamunge/geometry/point_in_polygon.hpp>
int main() {
    std::filesystem::create_directories("build");

    const std::vector<dm::geometry::Point2D> unit{{0, 0}, {1, 0}, {1, 1}, {0, 1}}, large{{-1e308, -1e308}, {1e308, -1e308}, {1e308, 1e308}, {-1e308, 1e308}};
    std::vector<double> v;
    std::vector<std::string> labels{"inside ulp", "edge", "outside ulp",
                                    "large square"};
    std::vector<dm::geometry::Point2D> q{{std::nextafter(1., 0.), .5}, {1, .5},
                                         {std::nextafter(1., 2.), .5}, {0, 0}};
    std::print("\n| case | actual parity | exact boundary |\n| --- | --- | --- |\n");
    for (std::size_t i = 0; i < q.size(); ++i) {
        auto t =
            dm::geometry::point_in_polygon_trace(q[i], i == 3 ? large : unit);
        v.push_back(t.inside);
        std::print("| {} | {} | {} |\n", labels[i], t.inside,
                   t.location == dm::geometry::PolygonLocation::Boundary);
    }
    auto p = dm::graphics::RPlot::barplot(v, labels, "actual robust parity");
    p.title("Exact ray decisions at adjacent binary64 values and full coordinate range").y_label("actual Boolean parity");
    p.save_svg("build/point_in_polygon_work.svg");
}
```
