> Explicit controls

```{cpp, results="markdown", file="figures/point_in_polygon_controls.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <datamunge/plot/plot.hpp>
#include <datamunge/plot/diagram.hpp>
#include <datamunge/algorithms/modular_exponentiation.hpp>
#include <datamunge/algorithms/integer_arithmetic.hpp>
#include <filesystem>
#include <print>
#include <algorithm>
#include <cmath>
#include <limits>
#include <climits>
#include <datamunge/algorithms/number_theory.hpp>
#include <numeric>
#include <numbers>
#include <random>
#include <string>
#include <vector>
#include <datamunge/geometry/point_in_polygon.hpp>
int main() {
    std::filesystem::create_directories("build");

    const std::vector<dm::geometry::Point2D> polygon{{0, 0}, {2, 0}, {2, 2},
                                                     {0, 2}};
    std::vector<dm::geometry::Point2D> queries{{1, 1}, {0, 1}, {2, 1}, {0, 0},
                                               {3, 1}};
    std::vector<std::string> labels{"interior", "left edge", "right edge",
                                    "vertex", "outside"};
    std::vector<double> v;
    std::print("\n| case | actual semi-open parity | explicit native location |\n| --- | --- | --- |\n");
    for (std::size_t i = 0; i < queries.size(); ++i) {
        auto t = dm::geometry::point_in_polygon_trace(queries[i], polygon);
        const auto location =
            t.location == dm::geometry::PolygonLocation::Boundary ? "boundary"
            : t.location == dm::geometry::PolygonLocation::Inside ? "inside"
            : "outside";
        v.push_back(t.inside);
        std::print("| {} | {} | {} |\n", labels[i], t.inside, location);
    }
    auto p = dm::graphics::RPlot::barplot(v, labels, "actual semi-open parity");
    p.title("Boundary membership and semi-open Boolean ownership are separate").y_label("actual Boolean parity");
    p.save_svg("build/point_in_polygon_controls.svg");
}
```
// result_begin: markdown
| case | actual semi-open parity | explicit native location |
| --- | --- | --- |
| interior | true | inside |
| left edge | true | boundary |
| right edge | false | boundary |
| vertex | true | boundary |
| outside | false | outside |
\image(figures/point_in_polygon_controls.svg)
// result_end
