> Actual selected work and sensitivity

```{cpp, results="markdown", file="figures/shoelace_work.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <filesystem>
#include <print>
#include <algorithm>
#include <cmath>
#include <limits>
#include <numeric>
#include <numbers>
#include <random>
#include <string>
#include <vector>
#include <map>
#include <set>
#include <array>
#include <tuple>
#include <bit>
#include <datamunge/random/quality.hpp>
#include <datamunge/geometry/shoelace.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    std::vector<double> x, y;
    std::print("| regular unit-circle corners | actual area | analytic area | actual edge terms |\n| ---: | " "---: | ---: | ---: |\n");
    for (std::size_t n : {3, 4, 8, 16, 32, 64, 128, 256}) {
        auto r =
            dm::geometry::shoelace_run(dm::geometry::shoelace_regular_polygon(n));
        const double exact = n * std::sin(2 * std::numbers::pi / n) / 2;
        std::print("| {} | {} | {} | {} |\n", n, r.area, exact, r.edge_terms);
        x.push_back(n);
        y.push_back(r.area);
    }
    auto plot = g::RPlot::create();
    plot.lines(x, y, "actual values", {37, 99, 235}).points(x, y, {37, 99, 235},
                                                            4).title(
        "Inscribed regular polygons approach pi").x_label("corners").y_label(
        "computed area");
    plot.save_svg("build/shoelace_work.svg");
}
```
