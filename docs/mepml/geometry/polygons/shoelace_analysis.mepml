> Explicit controls

```{cpp, results="markdown", file="figures/shoelace_controls.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <filesystem>
#include <print>
#include <algorithm>
#include <cmath>
#include <limits>
#include <numeric>
#include <numbers>
#include <random>
#include <string>
#include <vector>
#include <map>
#include <set>
#include <array>
#include <tuple>
#include <bit>
#include <datamunge/random/quality.hpp>
#include <datamunge/geometry/shoelace.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    namespace geo = dm::geometry;
    const std::vector<std::vector<geo::Point2D>> inputs{{}, {{1, 2}},
                                                        {{0, 0}, {1, 1}, {2, 2}},
                                                        {{0, 0}, {2, 2}, {0, 2},
                                                         {2, 0}},
                                                        {{1e15, 1e15},
                                                         {1e15 + 4, 1e15},
                                                         {1e15, 1e15 + 3}}};
    std::vector<double> x, y;
    std::print("| control | signed area | terms |\n| ---: | ---: | ---: |\n");
    for (std::size_t i = 0; i < inputs.size(); ++i) {
        auto r = geo::shoelace_run(inputs[i]);
        std::print("| {} | {} | {} |\n", i, r.signed_area, r.edge_terms);
        x.push_back(i);
        y.push_back(r.signed_area);
    }
    auto plot = g::RPlot::create();
    plot.lines(x, y, "actual values", {37, 99, 235}).points(x, y, {37, 99, 235},
                                                            4).title(
        "Degeneracy, crossing cancellation and translation").x_label(
        "control index").y_label("signed algebraic area");
    plot.save_svg("build/shoelace_controls.svg");
}
```
