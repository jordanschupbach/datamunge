> Actual selected work

```{cpp, results="markdown", file="figures/polygon_triangulation_work.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
    std::filesystem::create_directories("build");

    std::vector<double> x, y;
    std::print("\n| convex vertices | actual candidates | actual other-point containment queries | actual " "orientation calls including validation |\n| ---: | ---: | ---: | ---: |\n");
    for (int n : {4, 8, 16, 32}) {
        std::vector<dm::geometry::Point2D> polygon;
        for (int i = 0; i < n; ++i) {
            const double angle = 2 * std::numbers::pi * i / n;
            polygon.push_back({std::cos(angle), std::sin(angle)});
        }
        auto r = dm::geometry::triangulate_polygon_run(polygon);
        x.push_back(n);
        y.push_back(r.orientations);
        std::print("| {} | {} | {} | {} |\n", n, r.candidates,
                   r.containment_tests, r.orientations);
    }
    auto p = dm::graphics::RPlot::create();
    p.lines(x, y, "actual exact orientation calls", {37, 99, 235}).points(
        x, y, {37, 99, 235}, 4).title("Convex fixture work: actual predicates include complete simplicity validation").x_label("input vertices").y_label("actual exact orientation calls");
    p.save_svg("build/polygon_triangulation_work.svg");
}
```
