> The retained original experiment

```{cpp, results="markdown", file="figures/polygon_triangulation_original.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
    std::filesystem::create_directories("build");

    const std::vector<dm::geometry::Point2D> polygon{{0, 0}, {4, 2}, {8, 0},
                                                     {6, 4}, {8, 8}, {4, 6},
                                                     {0, 8}};
    auto t = dm::geometry::triangulate_polygon_trace(polygon);
    std::print("Original seven-vertex arrow: actual{} triangles, {} inspected candidates and {} exact " "orientation calls (including validation).\n",
               t.run.triangles.size(), t.run.candidates, t.run.orientations);
    std::print("\n| actual output triangle | a | b | c |\n| ---: | ---: | ---: | ---: |\n");
    std::vector<double> x, y;
    for (std::size_t i = 0; i < t.run.triangles.size(); ++i) {
        auto q = t.run.triangles[i];
        std::print("| {} | {} | {} | {} |\n", i, q.a, q.b, q.c);
    }
    for (auto q : polygon) {
        x.push_back(q.x);
        y.push_back(q.y);
    }
    x.push_back(x.front());
    y.push_back(y.front());
    auto p = dm::graphics::RPlot::create();
    for (auto q : t.run.triangles)
        p.polygon({polygon[q.a].x, polygon[q.b].x, polygon[q.c].x},
                  {polygon[q.a].y, polygon[q.b].y, polygon[q.c].y},
                  {16, 122, 87}, false);
    p.lines(x, y, "original polygon boundary", {17, 24, 39}, 2.5).points(
        x, y, "original vertices", {220, 38, 38}, 5).title(
        "Original concave seven-vertex arrow: actual native ear triangulation").x_label("x").y_label("y");
    p.save_svg("build/polygon_triangulation_original.svg");
}
```
