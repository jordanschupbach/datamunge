> Explicit controls

```{cpp, results="markdown", file="figures/polygon_triangulation_controls.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
    std::filesystem::create_directories("build");

    std::vector<std::vector<dm::geometry::Point2D>> polygons{
        {{0, 0}, {2, 0}, {0, 2}}, {{0, 0}, {2, 0}, {2, 2}, {0, 2}},
        {{0, 2}, {2, 2}, {2, 0}, {0, 0}},
        {{0, 0}, {1, 0}, {2, 0}, {2, 2}, {0, 2}}
    };
    std::vector<std::string> labels{"triangle", "CCW square", "CW square",
                                    "collinear boundary"};
    std::vector<double> v;
    std::print("\n| valid fixture | actual triangles | actual ring reversed |\n| --- | ---: | --- |\n");
    for (std::size_t i = 0; i < polygons.size(); ++i) {
        auto r = dm::geometry::triangulate_polygon_run(polygons[i]);
        v.push_back(r.triangles.size());
        std::print("| {} | {} | {} |\n", labels[i], r.triangles.size(),
                   r.reversed);
    }
    bool rejected = false;
    try {
        dm::geometry::triangulate_polygon({{0, 0}, {2, 2}, {0, 2}, {2, 0}});
    } catch (const std::invalid_argument &) {
        rejected = true;
    }
    std::print("Self-crossing bow tie rejected before returning a mesh: {}.\n",
               rejected);
    auto p =
        dm::graphics::RPlot::barplot(v, labels,
                                     "actual complete output triangles");
    p.title("Ear controls: winding, forward collinearity and invalid-boundary rejection").y_label("actual nondegenerate triangles");
    p.save_svg("build/polygon_triangulation_controls.svg");
}
```
