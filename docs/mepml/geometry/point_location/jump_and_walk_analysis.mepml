> Separate boundary, empty and exhausted results

Boundary queries may belong to several faces; returning any containing incident
face is valid. An exterior query stops at a negative-sign boundary edge. Empty
meshes have their own outcome. An exhausted budget proves neither containment
nor exterior location. In the control below, one allowed step crosses the
diagonal, then stops before testing the next face even though q lies inside the
square. Analyze/trace return step_limit with face −1; the legacy locate()
interface throws if its default bound is exhausted, instead of silently
returning an exterior answer.

```{cpp, results="markdown", file="figures/jump_walk_controls.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
    std::filesystem::create_directories("build");
    const std::vector<dm::geometry::Point2D> p = {{0, 0}, {4, 0}, {4, 4}, {0, 4}};
    const std::vector<dm::geometry::Triangle> f = {{0, 1, 2}, {0, 2, 3}};
    const dm::geometry::TriangulationLocator loc(p, f);
    const char *names[] = {"located", "boundary", "empty", "step_limit"};
    std::print("| control | stop | face | samples | steps | tests | crossings |\n| --- | --- | ---: | ---: " "| ---: | ---: | ---: |\n");
    const auto show =
        [&](const char *name, const dm::geometry::LocateAnalysis & a) {
        std::print("| {} | {} | {} | {} | {} | {} | {} |\n", name,
                   names[int(a.stop)], a.triangle, a.work.samples, a.work.steps,
                   a.work.edge_tests, a.work.crossings);
    };
    show("inside", loc.analyze({3, 1}, 1));
    show("shared edge", loc.analyze({2, 2}, 1));
    show("vertex", loc.analyze({0, 0}, 1));
    show("outside", loc.analyze({5, 2}, 1));
    const auto limited = loc.trace({3, 1}, 1, {1, 100});
    show("one step", limited.analysis);
    const std::vector<dm::geometry::Point2D> empty_p;
    const std::vector<dm::geometry::Triangle> empty_f;
    show("empty",
         dm::geometry::TriangulationLocator(empty_p, empty_f).analyze({0, 0}));
    const double d = std::numeric_limits<double>::denorm_min();
    const std::vector<dm::geometry::Point2D> tiny = {{0, 0}, {d, 0}, {0, d}};
    const std::vector<dm::geometry::Triangle> one = {{0, 1, 2}};
    show("subnormal outside",
         dm::geometry::TriangulationLocator(tiny, one).analyze({d, d}, 1));
    bool capped = false, bad = false;
    const auto t = loc.trace({3, 1}, 1);
    const auto records = t.samples.size() + t.steps.size() + t.tests.size();
    try {
        (void) loc.trace({3, 1}, 1, {0, records - 1});
    } catch (const std::length_error &) {
        capped = true;
    }
    try {
        (void) dm::geometry::TriangulationLocator(p, {{0, 2, 1}});
    } catch (const std::invalid_argument &) {
        bad = true;
    }
    if (!capped || !bad ||
        limited.analysis.stop != dm::geometry::LocateStop::StepLimit)
        throw std::runtime_error("control guards");
    std::print("\nOne-short actual-record admission rejects; clockwise faces reject; a one-step limit " "remains distinct from boundary.\n");
    dm::geometry::jump_walk_plot(limited).title("One-step budget: containment remains unresolved").save_svg("build/jump_walk_controls.svg");
}
```
