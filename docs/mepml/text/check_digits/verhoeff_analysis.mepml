> The retained original experiment

```{cpp, results="markdown", file="figures/verhoeff_original.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <filesystem>
#include <print>
#include <algorithm>
#include <cmath>
#include <limits>
#include <numeric>
#include <numbers>
#include <random>
#include <string>
#include <vector>
#include <map>
#include <set>
#include <array>
#include <tuple>
#include <bit>
#include <datamunge/random/quality.hpp>
#include <datamunge/algorithms/verhoeff.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    auto r = a::verhoeff_detection("1230904560907");
    std::print("| actual full number | caught substitutions / tested | caught unequal swaps / tested " "|\n|---|---|---|\n|{}|{} / {}|{} / {}|\n",
               r.full, r.substitutions_caught, r.substitutions,
               r.transpositions_caught, r.transpositions);
    auto p =
        g::RPlot::barplot({100. * r.substitutions_caught / r.substitutions,
                           100. * r.transpositions_caught / r.transpositions},
                          {"single substitution", "unequal adjacent swap"},
                          "actual percent rejected", {22, 163, 74});
    p.title("Original identifier: actual exhaustive error cohort").y_label(
        "percent rejected");
    p.save_svg("build/verhoeff_original.svg");
}
```
