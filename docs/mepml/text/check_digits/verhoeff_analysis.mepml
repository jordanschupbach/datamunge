> Checking the theory and controls

```{cpp, results="markdown", file="figures/verhoeff_controls.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <filesystem>
#include <print>
#include <algorithm>
#include <cmath>
#include <limits>
#include <numeric>
#include <numbers>
#include <random>
#include <string>
#include <vector>
#include <map>
#include <set>
#include <array>
#include <tuple>
#include <bit>
#include <datamunge/random/quality.hpp>
#include <datamunge/algorithms/verhoeff.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    std::vector<double> x, y;
    std::print("| full text | actual validity |\n|---|---|\n");
    int i = 0;
    for (std::string text : {"2363", "2364", "", "12x3", "0", "00"}) {
        bool valid = a::verhoeff_validate(text);
        std::print("|{}|{}|\n", text.empty() ? "(empty)" : text, valid);
        x.push_back(i++);
        y.push_back(valid);
    }
    auto p = g::RPlot::create();
    p.line(x, y, "actual", {37, 99, 235}, 2);
    p.points(x, y, "", {37, 99, 235}, 5);
    p.title("Invalid bytes, empty identifiers and leading zeros").x_label(
        "control index").y_label("actual validity");
    p.save_svg("build/verhoeff_controls.svg");
}
```
// result_begin: markdown
| full text | actual validity |
|---|---|
|2363|true|
|2364|false|
|(empty)|false|
|12x3|false|
|0|true|
|00|false|
\image(figures/verhoeff_controls.svg)
// result_end
