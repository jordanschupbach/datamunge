> Sensitivity and selected work

```{cpp, results="markdown", file="figures/verhoeff_work.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <filesystem>
#include <print>
#include <algorithm>
#include <cmath>
#include <limits>
#include <numeric>
#include <numbers>
#include <random>
#include <string>
#include <vector>
#include <map>
#include <set>
#include <array>
#include <tuple>
#include <bit>
#include <datamunge/random/quality.hpp>
#include <datamunge/algorithms/verhoeff.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    std::vector<double> x, y;
    std::print("| payload | actual substitutions tested | substitutions caught | swaps tested | swaps " "caught |\n|---|---:|---:|---:|---:|\n");
    for (std::string payload : {"0", "09", "236", "1230904560907",
                                "0000000000000000"}) {
        auto r = a::verhoeff_detection(payload);
        std::print("|{}|{}|{}|{}|{}|\n", payload, r.substitutions,
                   r.substitutions_caught, r.transpositions,
                   r.transpositions_caught);
        x.push_back(r.full.size());
        y.push_back(r.substitutions);
    }
    auto p = g::RPlot::create();
    p.line(x, y, "actual", {37, 99, 235}, 2);
    p.points(x, y, "", {37, 99, 235}, 5);
    p.title("Actual substitution cohort has9 mutations per position").x_label(
        "full identifier length").y_label("actual distinct substitutions tested");
    p.save_svg("build/verhoeff_work.svg");
}
```
