> Sensitivity and selected work

```{cpp, results="markdown", file="figures/truncated_binary_work.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    std::vector<double> x, y;
    std::print("| n | actual mean length | entropy |\n|---:|---:|---:|\n");
    for (std::uint64_t n = 1; n <= 32; ++n) {
        double sum = 0;
        for (std::uint64_t v = 0; v < n; ++v)
            sum += a::truncated_binary_encode({v}, n).size();
        std::print("|{}|{}|{}|\n", n, sum / n, std::log2(double(n)));
        x.push_back(n);
        y.push_back(sum / n);
    }
    auto p = g::RPlot::create();
    p.line(x, y, "actual", {37, 99, 235}, 2);
    p.points(x, y, "", {37, 99, 235}, 5);
    p.title("Exhaustive small alphabets verify mean code length").x_label(
        "alphabet size").y_label("actual average bits");
    p.save_svg("build/truncated_binary_work.svg");
}
```
