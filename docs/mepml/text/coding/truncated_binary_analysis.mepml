> The retained original experiment

```{cpp, results="markdown", file="figures/truncated_binary_original.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    std::vector<double> lengths;
    std::vector<std::string> labels;
    std::print("| symbol | actual code | bits |\n|---:|---|---:|\n");
    for (std::uint64_t v = 0; v < 5; ++v) {
        auto b = a::truncated_binary_encode({v}, 5);
        std::string code;
        for (bool bit : b)
            code += bit ? '1' : '0';
        std::print("|{}|{}|{}|\n", v, code, b.size());
        lengths.push_back(b.size());
        labels.push_back(std::to_string(v));
    }
    auto p = g::RPlot::barplot(lengths, labels, "actual bits", {37, 99, 235});
    p.abline_h(std::log2(5.), {22, 163, 74});
    p.title("Original n5 code: lengths2,2,2,3,3").y_label("bits per symbol");
    p.save_svg("build/truncated_binary_original.svg");
    auto b = a::truncated_binary_encode({0, 1, 2, 3, 4, 2, 0, 4}, 5);
    std::print("\nOriginal round trip `{}`.\n",
               a::truncated_binary_decode(b, 5, 8));
}
```
// result_begin: markdown
| symbol | actual code | bits |
|---:|---|---:|
|0|00|2|
|1|01|2|
|2|10|2|
|3|110|3|
|4|111|3|

Original round trip `[0, 1, 2, 3, 4, 2, 0, 4]`.
