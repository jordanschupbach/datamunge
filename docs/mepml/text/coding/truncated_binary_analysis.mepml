> Checking the theory and controls

```{cpp, results="markdown", file="figures/truncated_binary_controls.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    std::vector<double> x, y;
    std::print("| alphabet | largest symbol | actual bits | round trip |\n|---:|---:|---:|---|\n");
    for (std::uint64_t n : std::vector<std::uint64_t>{1, 2, 3, 5,
                                                      UINT64_C(1) << 63,
                                                      UINT64_MAX}) {
        auto b = a::truncated_binary_encode({n - 1}, n);
        auto v = a::truncated_binary_decode(b, n, 1);
        std::print("|{}|{}|{}|{}|\n", n, n - 1, b.size(), v[0] == n - 1);
        x.push_back(std::log2(double(n)));
        y.push_back(b.size());
    }
    auto p = g::RPlot::create();
    p.line(x, y, "actual", {37, 99, 235}, 2);
    p.points(x, y, "", {37, 99, 235}, 5);
    p.title("Singleton and full-width alphabet controls").x_label(
        "log2 alphabet size").y_label("actual largest-symbol bits");
    p.save_svg("build/truncated_binary_controls.svg");
}
```
// result_begin: markdown
