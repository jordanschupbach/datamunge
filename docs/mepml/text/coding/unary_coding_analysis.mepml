> Checking the theory and controls

```{cpp, results="markdown", file="figures/unary_coding_controls.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <filesystem>
#include <print>
#include <algorithm>
#include <cmath>
#include <limits>
#include <numeric>
#include <numbers>
#include <random>
#include <string>
#include <vector>
#include <map>
#include <set>
#include <array>
#include <tuple>
#include <bit>
#include <datamunge/random/quality.hpp>
#include <datamunge/algorithms/unary_coding.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    std::vector<double> x, y;
    std::print("| n | actual code length | decode |\n|---:|---:|---:|\n");
    for (int n = 0; n <= 8; ++n) {
        auto b = a::unary_encode({std::uint64_t(n)});
        auto v = a::unary_decode(b, 1);
        std::print("|{}|{}|{}|\n", n, b.size(), v[0]);
        x.push_back(n);
        y.push_back(b.size());
    }
    try {
        a::unary_decode({true, true}, 1);
    } catch (const std::invalid_argument &) {
        std::print("\nMissing zero delimiter is rejected.\n");
    }
    auto p = g::RPlot::create();
    p.line(x, y, "actual", {37, 99, 235}, 2);
    p.points(x, y, "", {37, 99, 235}, 5);
    p.title("Original0..8 length identity and checked decoding").x_label(
        "n").y_label("actual bits");
    p.save_svg("build/unary_coding_controls.svg");
}
```
