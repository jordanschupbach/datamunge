> Sensitivity and selected work

```{cpp, results="markdown", file="figures/unary_coding_work.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <filesystem>
#include <print>
#include <algorithm>
#include <cmath>
#include <limits>
#include <numeric>
#include <numbers>
#include <random>
#include <string>
#include <vector>
#include <map>
#include <set>
#include <array>
#include <tuple>
#include <bit>
#include <datamunge/random/quality.hpp>
#include <datamunge/algorithms/unary_coding.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    std::vector<double> x, y;
    std::print("| cutoff | partial geometric probability | partial expected bits |\n|---:|---:|---:|\n");
    double mass = 0, mean = 0;
    for (int n = 0; n <= 20; ++n) {
        double probability = std::ldexp(1., -n - 1);
        auto b = a::unary_encode({std::uint64_t(n)});
        mass += probability;
        mean += probability * b.size();
        std::print("|{}|{}|{}|\n", n, mass, mean);
        x.push_back(n);
        y.push_back(mean);
    }
    auto p = g::RPlot::create();
    p.line(x, y, "actual", {37, 99, 235}, 2);
    p.points(x, y, "", {37, 99, 235}, 5);
    p.title("Computed partial expectation approaches2 bits").x_label("cutoff n").y_label("probability-weighted actual bits");
    p.save_svg("build/unary_coding_work.svg");
}
```
