> The retained original experiment

```{cpp, results="markdown", file="figures/unary_coding_original.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <filesystem>
#include <print>
#include <algorithm>
#include <cmath>
#include <limits>
#include <numeric>
#include <numbers>
#include <random>
#include <string>
#include <vector>
#include <map>
#include <set>
#include <array>
#include <tuple>
#include <bit>
#include <datamunge/random/quality.hpp>
#include <datamunge/algorithms/unary_coding.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    std::vector<double> x, y;
    std::print("| n | actual word | actual bits | ideal source information |\n|---:|---|---:|---:|\n");
    for (std::uint64_t n : {0, 1, 2, 3, 5, 8}) {
        auto b = a::unary_encode({n});
        std::string word;
        for (bool bit : b)
            word += bit ? '1' : '0';
        std::print("|{}|{}|{}|{}|\n", n, word, b.size(), n + 1);
        x.push_back(n);
        y.push_back(b.size());
    }
    auto stream = a::unary_encode({0, 1, 2, 3, 5, 8});
    std::print("\nActual round trip `{}`.\n", a::unary_decode(stream, 6));
    auto p = g::RPlot::create();
    p.line(x, y, "actual", {37, 99, 235}, 2);
    p.points(x, y, "", {37, 99, 235}, 5);
    p.title("Original integer cohort: actual unary lengths").x_label("value n").y_label("emitted bits");
    p.save_svg("build/unary_coding_original.svg");
}
```
