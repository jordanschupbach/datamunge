> Sensitivity and selected work

```{cpp, results="markdown", file="figures/trigram_search_work.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    std::vector<double> x, y;
    std::print("| repeated bytes | distinct grams | self similarity |\n|---:|---:|---:|\n");
    for (int n : {0, 1, 2, 3, 8, 32, 128}) {
        std::string q(n, 'a');
        auto grams = a::trigrams(q);
        std::print("|{}|{}|{}|\n", n, grams.size(), a::trigram_similarity(q, q));
        x.push_back(n);
        y.push_back(grams.size());
    }
    auto p = g::RPlot::create();
    p.line(x, y, "actual", {37, 99, 235}, 2);
    p.points(x, y, "", {37, 99, 235}, 5);
    p.title("Repeated-byte inputs saturate distinct set size").x_label(
        "input bytes").y_label("actual distinct grams");
    p.save_svg("build/trigram_search_work.svg");
}
```
// result_begin: markdown
| repeated bytes | distinct grams | self similarity |
|---:|---:|---:|
|0|1|1|
|1|2|1|
|2|3|1|
|3|4|1|
|8|4|1|
|32|4|1|
|128|4|1|
