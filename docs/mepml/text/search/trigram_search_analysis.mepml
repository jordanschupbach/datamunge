> The retained original experiment

```{cpp, results="markdown", file="figures/trigram_search_original.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    std::vector<std::string> dict{"algorithm", "logarithm", "rhythm",
                                  "arithmetic", "altruism", "allegory",
                                  "alignment"};
    auto ranked = a::trigram_search(dict, "algorithim");
    std::vector<double> scores;
    std::vector<std::string> labels;
    std::print("| candidate | actual Jaccard |\n|---|---:|\n");
    for (auto[score, i] : ranked) {
        scores.push_back(score);
        labels.push_back(dict[i]);
        std::print("|{}|{}|\n", dict[i], score);
    }
    auto p = g::RPlot::barplot(scores, labels, "actual Jaccard", {5, 150, 105});
    p.title("Original typo algorithim: actual stable ranking").y_label(
        "set Jaccard");
    p.save_svg("build/trigram_search_original.svg");
}
```
// result_begin: markdown
