> Checking the theory and controls

```{cpp, results="markdown", file="figures/trigram_search_controls.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    std::vector<std::string> candidates{"CAT", "cat", "bat", "", "aaaa", "aaa"};
    auto r = a::trigram_search(candidates, "cat");
    std::vector<double> x, y;
    std::print("| original index | candidate | score |\n|---:|---|---:|\n");
    for (auto[score, i] : r) {
        std::print("|{}|{}|{}|\n", i,
                   candidates[i].empty() ? "(empty)" : candidates[i], score);
        x.push_back(i);
        y.push_back(score);
    }
    auto p = g::RPlot::create();
    p.line(x, y, "actual", {37, 99, 235}, 2);
    p.points(x, y, "", {37, 99, 235}, 5);
    p.title("ASCII folding and stable equal-score ties").x_label(
        "original candidate index").y_label("actual Jaccard");
    p.save_svg("build/trigram_search_controls.svg");
}
```
// result_begin: markdown
| original index | candidate | score |
|---:|---|---:|
|0|CAT|1|
|1|cat|1|
|2|bat|0.14285714285714285|
|3|(empty)|0|
|4|aaaa|0|
|5|aaa|0|
\image(figures/trigram_search_controls.svg)
