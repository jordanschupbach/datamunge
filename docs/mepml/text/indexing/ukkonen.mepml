> The retained original experiment

```{cpp, results="markdown", file="figures/ukkonen_original.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    auto r = a::build_suffix_tree_work("banana");
    std::print("| query | actual membership |\n|---|---|\n");
    for (std::string q : {"ana", "nan", "banana", "ban", "anas", "x"})
        std::print("|{}|{}|\n", q, a::suffix_tree_contains(r.tree, q));
    std::print("\nNodes {}; actual splits {}; distinct substrings {}.\n",
               r.tree.nodes.size(), r.splits,
               a::distinct_substring_count(r.tree));
    auto p = a::suffix_tree_plot(r.tree);
    p.save_svg("build/ukkonen_original.svg");
}
```
