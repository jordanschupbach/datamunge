> Checking the theory and controls

```{cpp, results="markdown", file="figures/ukkonen_controls.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    std::vector<double> x, y;
    std::print("| text | actual nodes | distinct substrings |\n|---|---:|---:|\n");
    int i = 0;
    for (std::string q : {"", "a", "aaaa", "abab", "banana", "$"}) {
        auto r = a::build_suffix_tree_work(q);
        std::print("|{}|{}|{}|\n", q.empty() ? "(empty)" : q,
                   r.tree.nodes.size(), a::distinct_substring_count(r.tree));
        x.push_back(i++);
        y.push_back(r.tree.nodes.size());
    }
    auto p = g::RPlot::create();
    p.line(x, y, "actual", {37, 99, 235}, 2);
    p.points(x, y, "", {37, 99, 235}, 5);
    p.title("Empty, repeated, alternating and literal-dollar controls").x_label(
        "control index").y_label("actual final nodes");
    p.save_svg("build/ukkonen_controls.svg");
}
```
// result_begin: markdown
| text | actual nodes | distinct substrings |
|---|---:|---:|
