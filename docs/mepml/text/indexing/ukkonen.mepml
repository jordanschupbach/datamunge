> Sensitivity and selected work

```{cpp, results="markdown", file="figures/ukkonen_work.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    std::vector<double> x, y;
    std::print("| repeated bytes | phases | active-loop iterations | splits | walk downs " "|\n|---:|---:|---:|---:|---:|\n");
    for (int n : {8, 16, 32, 64, 128, 256, 512, 1024}) {
        auto r = a::build_suffix_tree_work(std::string(n, 'a'));
        std::print("|{}|{}|{}|{}|{}|\n", n, r.phases, r.extensions, r.splits,
                   r.walk_downs);
        x.push_back(n);
        y.push_back(r.extensions);
    }
    auto p = g::RPlot::create();
    p.line(x, y, "actual", {37, 99, 235}, 2);
    p.points(x, y, "", {37, 99, 235}, 5);
    p.title("Actual active-point work on repeated-byte worst-depth trees").x_label("input bytes").y_label("actual active-loop iterations");
    p.save_svg("build/ukkonen_work.svg");
}
```
