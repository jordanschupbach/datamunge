> Actual selected work and sensitivity

```{cpp, results="markdown", file="figures/sfc64_work.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    namespace r = dm::random;
    std::vector<double> x, y;
    std::print("| bit position | actual one fraction in fixed65536-word prefix |\n| ---: | ---: |\n");
    auto sample = r::sfc64_run(0xC0FFEEULL, 65536);
    for (std::size_t bit = 0; bit < 64; ++bit) {
        auto fraction = double(sample.ones[bit]) / sample.outputs.size();
        std::print("| {} | {} |\n", bit, fraction);
        x.push_back(bit);
        y.push_back(fraction);
    }
    std::print("\nDetected low-eight-bit power-of-two prefix periods (0 means none detected): `{}`.\n",
               r::bit_periods_of(sample.outputs, 8));
    auto plot = g::RPlot::create();
    plot.lines(x, y, "actual values", {37, 99, 235}).points(x, y, {37, 99, 235},
                                                            5).title(
        "Finite-prefix one-bit frequencies, not a period proof").x_label(
        "bit position (low first)").y_label("actual one fraction");
    plot.save_svg("build/sfc64_work.svg");
}
```
