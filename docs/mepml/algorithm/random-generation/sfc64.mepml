> Explicit controls

```{cpp, results="markdown", file="figures/sfc64_controls.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    namespace r = dm::random;
    r::Sfc64 engine(std::array<std::uint64_t, 4>{0, 0, 0,
                                                 std::numeric_limits<
                                                 std::uint64_t>::max()});
    std::vector<double> x, y;
    std::print("| actual draw | raw output (exact integer) | actual counter after |\n| ---: | ---: | ---: " "|\n");
    for (std::size_t i = 0; i < 4; ++i) {
        auto s = engine.next_trace();
        std::print("| {} | {} | {} |\n", i, s.value, s.after[3]);
        x.push_back(i);
        y.push_back(s.after[3]);
    }
    auto empty = r::sfc64_trace(7, 0);
    std::print("\nZero draws preserve raw state: {}.\n",
               empty.initial == empty.final);
    auto plot = g::RPlot::create();
    plot.lines(x, y, "actual values", {37, 99, 235}).points(x, y, {37, 99, 235},
                                                            5).title(
        "Defined unsigned counter wrap from an explicit raw state").x_label(
        "actual draw").y_label("actual counter after");
    plot.save_svg("build/sfc64_controls.svg");
}
```
