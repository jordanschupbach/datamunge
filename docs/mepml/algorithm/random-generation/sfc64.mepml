> The retained original experiment

```{cpp, results="markdown", file="figures/sfc64_original.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    namespace r = dm::random;
    r::Sfc64 engine(0xC0FFEEULL);
    const auto raw = engine.next_u64();
    const auto uniform = engine.uniform01();
    const auto normal = engine.normal();
    const auto integer = engine.uniform_u64(0, 99);
    std::print("Original call order: raw {}, uniform {:.6f}, normal {:.6f}, integer {}.\n\n",
               raw, uniform, normal, integer);
    auto sample = r::sfc64_run(0xC0FFEEULL, 10000);
    std::vector<double> x, y;
    std::print("| low byte | actual count in fresh10000-word prefix |\n| ---: | ---: |\n");
    for (std::size_t i = 0; i < 256; ++i) {
        std::print("| {} | {} |\n", i, sample.low_bytes[i]);
        x.push_back(i);
        y.push_back(sample.low_bytes[i]);
    }
    auto plot = g::RPlot::create();
    plot.lines(x, y, "actual values", {37, 99, 235}).points(x, y, {37, 99, 235},
                                                            5).title(
        "Fresh original seed: actual low-byte counts").x_label(
        "unsigned low byte").y_label("actual prefix count");
    plot.save_svg("build/sfc64_original.svg");
}
```
