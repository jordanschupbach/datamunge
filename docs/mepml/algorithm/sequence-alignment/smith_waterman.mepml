> The retained original experiment

```{cpp, results="markdown", file="figures/smith_waterman_original.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    auto r = a::smith_waterman_trace("AAGT", "AGT");
    auto global = a::needleman_wunsch("AAGT", "AGT");
    auto motif = a::smith_waterman_run("TTTGATTACAGGG", "CCGATTACAAA");
    std::print("| retained experiment | actual score | first row | second row |\n| --- | ---: | --- | --- " "|\n| local AAGT/AGT | {} | `{}` | `{}` |\n| global same inputs | {} | `{}` | `{}` |\n| " "embedded motif | {} | `{}` | `{}` |\n",
               r.alignment.score, r.alignment.a_aligned, r.alignment.b_aligned,
               global.score, global.a_aligned, global.b_aligned,
               motif.alignment.score, motif.alignment.a_aligned,
               motif.alignment.b_aligned);
    auto plot = g::RPlot::create();
    for (std::size_t i = 0; i < r.table.size(); ++i)
        for (std::size_t j = 0; j < r.table[i].size(); ++j)
            plot.text(j + .12, -double(i) + .15, std::to_string(r.table[i][j]),
                      {31, 41, 55}, 16);
    std::vector<double> x, y;
    std::print("\n| actual backward row | column | score | move |\n| ---: | ---: | ---: | --- |\n");
    for (const auto &s : r.traceback) {
        std::print("| {} | {} | {} | {} |\n", s.row, s.column, s.score, s.move);
        x.push_back(s.column);
        y.push_back(-double(s.row));
    }
    plot.lines(x, y, "actual selected backward path", {220, 38, 38}, 3).points(
        x, y, {220, 38, 38}, 5).title("Actual producing local DP: AAGT versus AGT").x_label("AGT prefix length").y_label("negative AAGT prefix length").size(760, 800).margins(80, 40, 72, 88).x_limits(-1, 5).y_limits(-5, 1);
    plot.save_svg("build/smith_waterman_original.svg");
}
```
