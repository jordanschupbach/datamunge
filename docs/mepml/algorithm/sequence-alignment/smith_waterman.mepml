> Explicit controls

```{cpp, results="markdown", file="figures/smith_waterman_controls.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    const std::vector<std::pair<std::string, std::string>> cases{
        {"", "A"}, {"A", "T"}, {"AAA", "AAA"}, {"TTACGG", "CCACAA"},
        {"AAGT", "AGT"}
    };
    std::vector<double> x, y;
    std::print("| control | inputs | actual score | first span | second span |\n| ---: | --- | ---: | --- | " "--- |\n");
    for (std::size_t i = 0; i < cases.size(); ++i) {
        auto r = a::smith_waterman_run(cases[i].first, cases[i].second);
        std::print("| {} | `{}` / `{}` | {} | [{},{}) | [{},{}) |\n", i,
                   cases[i].first.empty() ? "(empty)" : cases[i].first,
                   cases[i].second.empty() ? "(empty)" : cases[i].second,
                   r.alignment.score, r.begin_a, r.end_a, r.begin_b, r.end_b);
        x.push_back(i);
        y.push_back(r.alignment.score);
    }
    auto plot = g::RPlot::create();
    plot.lines(x, y, "actual values", {37, 99, 235}).points(x, y, {37, 99, 235},
                                                            4).title(
        "Empty, dissimilar and embedded-substring controls").x_label(
        "control index").y_label("actual optimal local score");
    plot.save_svg("build/smith_waterman_controls.svg");
}
```
