> Actual selected work and sensitivity

```{cpp, results="markdown", file="figures/smith_waterman_work.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    std::vector<double> x, y;
    std::print("| complete repeated-A length | actual score | evaluated cells | traceback steps |\n| ---: | " "---: | ---: | ---: |\n");
    for (std::size_t n : {1, 2, 4, 8, 16, 32, 64}) {
        auto r =
            a::smith_waterman_run(std::string(n, 'A'), std::string(n, 'A'));
        std::print("| {} | {} | {} | {} |\n", n, r.alignment.score,
                   r.evaluated_cells, r.traceback_steps);
        x.push_back(n);
        y.push_back(r.evaluated_cells);
    }
    auto plot = g::RPlot::create();
    plot.lines(x, y, "actual values", {37, 99, 235}).points(x, y, {37, 99, 235},
                                                            4).title(
        "Actual recurrence evaluations grow quadratically").x_label(
        "equal input length").y_label("actual interior DP cells");
    plot.save_svg("build/smith_waterman_work.svg");
}
```
