> The retained original experiment

```{cpp, results="markdown", file="figures/random_restart_hill_climbing_original.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");

    a::HillClimbOptions o;
    o.restarts = 60;
    o.seed = 1;
    auto run = a::hill_climb_run(a::hill_wave_objective, {0}, {15}, o);
    auto reference =
        a::hill_objective_grid(a::hill_wave_objective, 0, 15, .0005);
    auto curve = a::hill_objective_grid(a::hill_wave_objective, 0, 15, .02);
    std::print("\n| retained original experiment | actual x | actual objective |\n| --- | ---: | ---: |\n| " "best of60 native restarts | {} | {} |\n| dense finite grid maximum | {} | {} |\n",
               run.best.x[0], run.best.value, reference.maximum.x[0],
               reference.maximum.value);
    std::print("Actual evaluations {}, proposals {}, accepted moves {}, step shrinks {}. Grid visits {}.\n",
               run.evaluations, run.proposals, run.accepted, run.shrinks,
               reference.x.size());
    auto p = g::RPlot::create();
    p.lines(curve.x, curve.values, "actual sampled objective curve",
            {100, 116, 139}).points({run.best.x[0]}, {run.best.value},
                                    "actual best of60 restarts", {220, 38, 38},
                                    7).points({reference.maximum.x[0]},
                                              {reference.maximum.value},
                                              "actual dense-grid maximum",
                                              {22, 163, 74}, 4).title(
        "Original multimodal objective: actual visited maxima").x_label(
        "x in[0,15]").y_label("sin(x)+sin(2.2x)+0.3x");
    p.save_svg("build/random_restart_hill_climbing_original.svg");
}
```
