> Actual selected work and sensitivity

```{cpp, results="markdown", file="figures/random_restart_hill_climbing_work.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");

    std::vector<double> x, y;
    std::print("\n| same-seed restart prefix | actual best objective | actual objective calls | actual " "accepted proposals |\n| ---: | ---: | ---: | ---: |\n");
    for (std::size_t starts : {1, 2, 5, 10, 20, 60}) {
        a::HillClimbOptions o;
        o.restarts = starts;
        auto r = a::hill_climb_run(a::hill_wave_objective, {0}, {15}, o);
        x.push_back(starts);
        y.push_back(r.best.value);
        std::print("| {} | {} | {} | {} |\n", starts, r.best.value,
                   r.evaluations, r.accepted);
    }
    const auto grid =
        a::hill_objective_grid(a::hill_wave_objective, 0, 15, .0005);
    auto p = g::RPlot::create();
    p.lines(x, y, "actual best visited objective", {37, 99, 235}).points(
        x, y, {37, 99, 235}, 5).abline_h(grid.maximum.value, {22, 163, 74}).title("Same native start-stream prefix: best observed value").x_label("actual configured restarts").y_label("actual best / dense-grid reference");
    p.save_svg("build/random_restart_hill_climbing_work.svg");
}
```
