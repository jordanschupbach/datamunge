> Explicit controls

```{cpp, results="markdown", file="figures/random_restart_hill_climbing_controls.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");

    std::vector<std::string> labels{"zero restarts", "fixed box", "one restart"};
    std::vector<double> counts;
    std::print("\n| actual control | found | actual objective evaluations | actual proposals |\n| --- | --- " "| ---: | ---: |\n");
    for (int i = 0; i < 3; ++i) {
        a::HillClimbOptions o;
        o.restarts = i == 0 ? 0 : i == 1 ? 3 : 1;
        auto r =
            a::hill_climb_run(a::hill_wave_objective,
                              i == 1 ? std::vector<double>{2}
                              : std::vector<double>{0},
                              i == 1 ? std::vector<double>{2}
                              : std::vector<double>{2}, o);
        counts.push_back(r.evaluations);
        std::print("| {} | {} | {} | {} |\n", labels[i], r.found, r.evaluations,
                   r.proposals);
    }
    bool bounds = false, value = false;
    try {
        a::hill_climb_run(a::hill_wave_objective, {2}, {1});
    } catch (const std::invalid_argument &) {
        bounds = true;
    }
    try {
        a::hill_climb_run([](const auto &) {
            return std::numeric_limits<double>::quiet_NaN();
        }, {0}, {1});
    } catch (const std::overflow_error &) {
        value = true;
    }
    std::print("Reversed bounds rejected: {}; nonfinite callback rejected: {}.\n",
               bounds, value);
    auto p = g::RPlot::barplot(counts, labels, "actual objective calls");
    p.title("No-start sentinel and fixed-domain search controls").y_label(
        "actual evaluated points");
    p.save_svg("build/random_restart_hill_climbing_controls.svg");
}
```
// result_begin: markdown
| actual control | found | actual objective evaluations | actual proposals |
| --- | --- | ---: | ---: |
| zero restarts | false | 0 | 0 |
| fixed box | true | 3 | 0 |
| one restart | true | 81 | 80 |
Reversed bounds rejected: true; nonfinite callback rejected: true.
\image(figures/random_restart_hill_climbing_controls.svg)
