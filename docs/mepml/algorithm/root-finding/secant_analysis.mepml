> Actual selected work and sensitivity

```{cpp, results="markdown", file="figures/secant_work.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <filesystem>
#include <print>
#include <algorithm>
#include <cmath>
#include <limits>
#include <numeric>
#include <numbers>
#include <random>
#include <string>
#include <vector>
#include <map>
#include <set>
#include <array>
#include <tuple>
#include <bit>
#include <datamunge/algorithms/secant.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    std::vector<double> x, y;
    std::print("| residual tolerance | actual correction queries | actual absolute residual | converged " "|\n| ---: | ---: | ---: | --- |\n");
    for (double tol : {1e-2, 1e-4, 1e-6, 1e-8, 1e-10, 1e-12}) {
        a::SecantOptions o;
        o.tolerance = tol;
        auto r = a::secant_run([](double x) { return x * x - 2; }, 1, 2, o);
        std::print("| {} | {} | {} | {} |\n", tol, r.result.iterations,
                   std::abs(r.result.residual), r.result.converged);
        x.push_back(-std::log10(tol));
        y.push_back(r.function_evaluations);
    }
    auto plot = g::RPlot::create();
    plot.lines(x, y, "actual values", {37, 99, 235}).points(x, y, {37, 99, 235},
                                                            5).title(
        "Tolerance sensitivity in actual callback work").x_label(
        "minus log10 tolerance").y_label("actual callback calls");
    plot.save_svg("build/secant_work.svg");
}
```
