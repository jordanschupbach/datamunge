> Explicit controls

```{cpp, results="markdown", file="figures/secant_controls.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <filesystem>
#include <print>
#include <algorithm>
#include <cmath>
#include <limits>
#include <numeric>
#include <numbers>
#include <random>
#include <string>
#include <vector>
#include <map>
#include <set>
#include <array>
#include <tuple>
#include <bit>
#include <datamunge/algorithms/secant.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    const auto flat = a::secant_run([](double) { return 1.; }, 0, 1);
    a::SecantOptions zero;
    zero.max_iterations = 0;
    const auto budget = a::secant_run([](double x) {
        return x * x - 2;
    }, 1, 2, zero);
    const auto exact = a::secant_run([](double x) { return x; }, 0, 1);
    std::vector<double> x{0, 1, 2}, y{double(flat.function_evaluations),
                                      double(budget.function_evaluations),
                                      double(exact.function_evaluations)};
    std::print("| case | actual stop enum | converged | callbacks |\n| --- | ---: | --- | ---: |\n");
    std::print("| horizontal | {} | {} | {} |\n| zero budget | {} | {} | {} |\n| initial exact zero | {} | " "{} | {} |\n",
               int(flat.stop), flat.result.converged, flat.function_evaluations,
               int(budget.stop), budget.result.converged,
               budget.function_evaluations, int(exact.stop),
               exact.result.converged, exact.function_evaluations);
    auto plot = g::RPlot::create();
    plot.lines(x, y, "actual values", {37, 99, 235}).points(x, y, {37, 99, 235},
                                                            5).title(
        "Distinct terminal outcomes retain actual queries").x_label("control").y_label("actual callback calls");
    plot.save_svg("build/secant_controls.svg");
}
```
