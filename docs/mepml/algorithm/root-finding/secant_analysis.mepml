> The retained original experiment

```{cpp, results="markdown", file="figures/secant_original.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <filesystem>
#include <print>
#include <algorithm>
#include <cmath>
#include <limits>
#include <numeric>
#include <numbers>
#include <random>
#include <string>
#include <vector>
#include <map>
#include <set>
#include <array>
#include <tuple>
#include <bit>
#include <datamunge/algorithms/secant.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    auto r = a::secant_trace([](double x) { return x * x - 2; }, 1, 2);
    std::vector<double> x, y;
    std::print("Actual root {}, actual residual {}, correction queries {}, callbacks {}.\n\n| actual " "queried x | actual residual |\n| ---: | ---: |\n",
               r.result.root, r.result.residual, r.result.iterations,
               r.function_evaluations);
    for (std::size_t i = 0; i < r.evaluations.size(); ++i) {
        const auto &e = r.evaluations[i];
        std::print("| {} | {} |\n", e.x, e.value);
        x.push_back(i);
        y.push_back(std::abs(e.value));
    }
    auto plot = g::RPlot::create();
    plot.lines(x, y, "actual values", {37, 99, 235}).points(x, y, {37, 99, 235},
                                                            5).title(
        "Original sqrt(2): actual callback residuals").x_label("query index").y_label("absolute residual");
    plot.save_svg("build/secant_original.svg");
}
```
