> Actual selected work and sensitivity

```{cpp, results="markdown", file="figures/ridders_work.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    std::vector<double> x, y;
    std::print("| residual and width tolerance | actual calls | completed steps | actual residual | " "converged |\n| ---: | ---: | ---: | ---: | --- |\n");
    for (double tol : {1e-2, 1e-4, 1e-6, 1e-8, 1e-10, 1e-12}) {
        a::RiddersOptions o;
        o.residual_tolerance = tol;
        o.x_tolerance = tol;
        auto t = a::ridders_run([](double x) { return x * x - 2; }, 1, 2, o);
        std::print("| {} | {} | {} | {} | {} |\n", tol, t.function_evaluations,
                   t.result.iterations, t.result.residual, t.result.converged);
        x.push_back(-std::log10(tol));
        y.push_back(t.function_evaluations);
    }
    auto p = g::RPlot::create();
    p.lines(x, y, "actual native callback invocations", {37, 99, 235}).points(
        x, y, {37, 99, 235}, 5).title("Tolerance controls actual Ridders evaluation work").x_label("negative log10 of the explicit tolerance").y_label("actual function calls");
    p.save_svg("build/ridders_work.svg");
}
```
