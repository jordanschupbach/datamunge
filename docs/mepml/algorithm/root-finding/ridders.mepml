> Explicit controls

```{cpp, results="markdown", file="figures/ridders_controls.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    a::RiddersOptions zero;
    zero.max_iterations = 0;
    auto no = a::ridders_run([](double x) { return x * x + 1; }, 0, 2);
    auto budget = a::ridders_run([](double x) {
        return x * x - 2;
    }, 1, 2, zero);
    auto endpoint = a::ridders_run([](double x) { return x - 1; }, 1, 2);
    auto jump = a::ridders_run([](double x) {
        return x < 0 ? -1. : 1.;
    }, -1, 1);
    std::vector<a::RiddersRun> runs{no, budget, endpoint, jump};
    std::vector<std::string> labels{"no bracket", "zero budget",
                                    "endpoint zero", "discontinuity"};
    std::vector<double> x, y;
    std::print("| control | actual point | residual | converged | stop enum | actual calls |\n| --- | ---: " "| ---: | --- | ---: | ---: |\n");
    for (std::size_t i = 0; i < runs.size(); ++i) {
        const auto &r = runs[i];
        std::print("| {} | {} | {} | {} | {} | {} |\n", labels[i],
                   r.result.root, r.result.residual, r.result.converged,
                   int(r.stop), r.function_evaluations);
        x.push_back(i);
        y.push_back(r.result.residual);
    }
    if (no.bracketed || budget.result.converged || !endpoint.result.converged ||
        jump.stop != a::RiddersStop::Interval)
        return 1;
    auto p = g::RPlot::create();
    p.bars(x, y, "actual returned callback residual", {22, 163, 74}, .8).x_ticks(x, labels).title("Interval resolution alone is not a continuous-root certificate").x_label("controlled callback / budget").y_label("actual absolute callback residual");
    p.save_svg("build/ridders_controls.svg");
}
```
