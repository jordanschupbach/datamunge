> The retained original experiment

```{cpp, results="markdown", file="figures/ridders_original.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    auto f = [](double x) { return x * x - 2; };
    const double reference = std::sqrt(2.);
    auto r = a::ridders_trace(f, 1, 2);
    auto b = a::bisection_trace(f, 1, 2);
    std::print("| method | actual returned point | actual residual | actual calls | actual completed steps " "| distance to rounded sqrt(2) |\n| --- | ---: | ---: | ---: | ---: | ---: |\n| Ridders | {} " "| {} | {} | {} | {} |\n| bisection | {} | {} | {} | {} | {} |\n\n| actual Ridders query | " "point | actual callback value |\n| ---: | ---: | ---: |\n",
               r.result.root, r.result.residual, r.function_evaluations,
               r.result.iterations, std::abs(r.result.root - reference),
               b.result.root, b.result.residual, b.evaluations,
               b.result.iterations, std::abs(b.result.root - reference));
    std::vector<double> rx, ry, bx, by;
    for (std::size_t i = 0; i < r.evaluations.size(); ++i) {
        const auto &e = r.evaluations[i];
        std::print("| {} | {} | {} |\n", i + 1, e.x, e.value);
        rx.push_back(i + 1);
        ry.push_back(std::log10(std::abs(e.x - reference) + 1e-17));
    }
    for (std::size_t i = 0; i < b.steps.size(); ++i) {
        bx.push_back(i + 3);
        by.push_back(std::log10(std::abs(b.steps[i].midpoint - reference) +
                                1e-17));
    }
    auto p = g::RPlot::create();
    p.lines(rx, ry, "actual chronological Ridders queries", {220, 38, 38}).points(rx, ry, {220, 38, 38}, 4).lines(bx, by, "actual native bisection midpoints", {37, 99, 235}).title("Original sqrt(2) bracket: actual error per callback").x_label("actual function evaluations, including endpoints").y_label("log10(distance to rounded sqrt(2) + 1e-17)");
    p.save_svg("build/ridders_original.svg");
}
```
