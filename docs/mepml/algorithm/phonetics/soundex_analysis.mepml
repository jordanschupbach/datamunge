> Explicit controls

```{cpp, results="markdown", file="figures/soundex_controls.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <filesystem>
#include <print>
#include <algorithm>
#include <cmath>
#include <limits>
#include <numeric>
#include <numbers>
#include <random>
#include <string>
#include <vector>
#include <map>
#include <set>
#include <array>
#include <tuple>
#include <bit>
#include <datamunge/random/quality.hpp>
#include <datamunge/algorithms/soundex.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    const std::vector<std::string> names{"", "Robert", "Rupert", "Pfister",
                                         "Ashcraft", "Ashcroft", "Tymczak",
                                         "Honeyman", "BHB", "BAB", "123Bob"};
    std::vector<double> x, y;
    std::print("| control | actual key | scanned bytes | emitted digits | padding |\n| --- | --- | ---: | " "---: | ---: |\n");
    for (std::size_t i = 0; i < names.size(); ++i) {
        auto r = a::soundex_run(names[i]);
        std::print("| `{}` | `{}` | {} | {} | {} |\n",
                   names[i].empty() ? "(empty)" : names[i],
                   r.code.empty() ? "(empty)" : r.code, r.scanned_bytes,
                   r.emitted_digits, r.padding);
        x.push_back(i);
        y.push_back(r.emitted_digits);
    }
    auto plot = g::RPlot::create();
    plot.lines(x, y, "actual values", {37, 99, 235}).points(x, y, {37, 99, 235},
                                                            4).title(
        "Actual first-class suppression and separator rules").x_label(
        "control index").y_label("emitted nonpadding digits");
    plot.save_svg("build/soundex_controls.svg");
}
```
