> The retained original experiment

```{cpp, results="markdown", file="figures/soundex_original.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <filesystem>
#include <print>
#include <algorithm>
#include <cmath>
#include <limits>
#include <numeric>
#include <numbers>
#include <random>
#include <string>
#include <vector>
#include <map>
#include <set>
#include <array>
#include <tuple>
#include <bit>
#include <datamunge/random/quality.hpp>
#include <datamunge/algorithms/soundex.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    auto groups = a::soundex_groups(a::soundex_example_names());
    std::vector<std::string> labels;
    std::vector<double> heights;
    std::print("| actual original key | original names in input order | count |\n| --- | --- | ---: |\n");
    for (const auto & [key, names] : groups) {
        std::print("| {} | `{}` | {} |\n", key, names, names.size());
        labels.push_back(key);
        heights.push_back(names.size());
    }
    auto plot =
        g::RPlot::barplot(heights, labels, "actual names per key", {22, 163, 74});
    plot.title("Original twenty surnames: actual Soundex collisions").x_label(
        "Soundex key").y_label("names");
    plot.save_svg("build/soundex_original.svg");
}
```
