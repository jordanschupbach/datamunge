> Actual selected work and sensitivity

```{cpp, results="markdown", file="figures/soundex_work.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <filesystem>
#include <print>
#include <algorithm>
#include <cmath>
#include <limits>
#include <numeric>
#include <numbers>
#include <random>
#include <string>
#include <vector>
#include <map>
#include <set>
#include <array>
#include <tuple>
#include <bit>
#include <datamunge/random/quality.hpp>
#include <datamunge/algorithms/soundex.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    std::vector<double> x, y;
    std::print("| complete input bytes | actual consumed prefix bytes | actual key |\n| ---: | ---: | --- " "|\n");
    for (std::size_t n : {0, 10, 100, 1000, 10000}) {
        const std::string name = "BRTMN" + std::string(n, 'a');
        auto r = a::soundex_run(name);
        std::print("| {} | {} | {} |\n", name.size(), r.scanned_bytes, r.code);
        x.push_back(name.size());
        y.push_back(r.scanned_bytes);
    }
    auto plot = g::RPlot::create();
    plot.lines(x, y, "actual values", {37, 99, 235}).points(x, y, {37, 99, 235},
                                                            4).title(
        "Processing stops after the actual key is full").x_label(
        "complete supplied bytes").y_label("actual consumed prefix bytes");
    plot.save_svg("build/soundex_work.svg");
}
```
