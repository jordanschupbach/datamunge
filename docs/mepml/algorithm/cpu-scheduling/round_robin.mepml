> Explicit controls

```{cpp, results="markdown", file="figures/round_robin_controls.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    const std::vector<a::SchedProcess> processes{{7, 5, 0}, {91, 10, 2},
                                                 {203, 11, 1}};
    auto t = a::round_robin_trace(processes, 1);
    std::print("| opaque process id | actual arrival | burst | completion | waiting |\n| ---: | ---: | ---: " "| ---: | ---: |\n");
    for (std::size_t i = 0; i < processes.size(); ++i)
        std::print("| {} | {} | {} | {} | {} |\n", processes[i].id,
                   processes[i].arrival, processes[i].burst,
                   t.result.metrics[i].completion, t.result.metrics[i].waiting);
    std::size_t rejected = 0;
    try {
        a::round_robin(processes, 0);
    } catch (const std::invalid_argument &) {
        ++rejected;
    }
    try {
        a::round_robin({{7, 0, 1}, {7, 0, 2}}, 1);
    } catch (const std::invalid_argument &) {
        ++rejected;
    }
    try {
        a::round_robin({{7, -1, 2}}, 1);
    } catch (const std::invalid_argument &) {
        ++rejected;
    }
    std::print("Actual idle jumps {}, busy ticks {}, invalid controls rejected {}.\n",
               t.idle_jumps, t.busy_ticks, rejected);
    if (rejected != 3 || t.result.metrics[0].completion != 5)
        return 1;
    auto p = a::plot_round_robin_schedule(processes, t.result);
    p.title("Actual sparse-id arrivals: zero burst and a real idle gap");
    p.save_svg("build/round_robin_controls.svg");
}
```
