> Actual selected work and sensitivity

```{cpp, results="markdown", file="figures/round_robin_work.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    const std::vector<a::SchedProcess> processes{{0, 0, 5}, {1, 0, 3},
                                                 {2, 0, 1}, {3, 0, 2}};
    std::vector<double> x, y;
    std::print("| actual quantum | actual dispatches | preemptions | busy ticks | mean waiting | mean " "turnaround |\n| ---: | ---: | ---: | ---: | ---: | ---: |\n");
    for (int quantum : {1, 2, 3, 4, 5, 8}) {
        auto t = a::round_robin_run(processes, quantum);
        std::print("| {} | {} | {} | {} | {} | {} |\n", quantum, t.dispatches,
                   t.preemptions, t.busy_ticks, t.result.avg_waiting,
                   t.result.avg_turnaround);
        x.push_back(quantum);
        y.push_back(t.dispatches);
    }
    auto p = g::RPlot::create();
    p.lines(x, y, "actual FIFO dispatches", {37, 99, 235}).points(x, y,
                                                                  {37, 99, 235},
                                                                  5).title(
        "Original workload: actual quantum sensitivity").x_label(
        "explicit time quantum").y_label("actual dispatches, zero switch-cost simulation");
    p.save_svg("build/round_robin_work.svg");
}
```
