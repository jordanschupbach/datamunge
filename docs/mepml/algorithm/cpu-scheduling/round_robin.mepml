> The retained original experiment

```{cpp, results="markdown", file="figures/round_robin_original.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    const std::vector<a::SchedProcess> processes{{0, 0, 5}, {1, 0, 3},
                                                 {2, 0, 1}, {3, 0, 2}};
    auto t = a::round_robin_trace(processes, 2);
    std::print("| original process id | actual completion | turnaround | waiting |\n| ---: | ---: | ---: | " "---: |\n");
    for (const auto &m : t.result.metrics)
        std::print("| {} | {} | {} | {} |\n", m.id, m.completion, m.turnaround,
                   m.waiting);
    std::print("Actual mean waiting {}, turnaround {}, dispatches {}, preemptions {}, busy ticks {}.\n\n| " "actual dispatch input id | start | end | actual remaining after |\n| ---: | ---: | ---: | " "---: |\n",
               t.result.avg_waiting, t.result.avg_turnaround, t.dispatches,
               t.preemptions, t.busy_ticks);
    for (const auto &s : t.steps)
        std::print("| {} | {} | {} | {} |\n", s.process_index, s.start, s.end,
                   s.remaining_after);
    auto p = a::plot_round_robin_schedule(processes, t.result);
    p.save_svg("build/round_robin_original.svg");
}
```
