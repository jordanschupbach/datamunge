> The original fixture, retained

This complete program retains the original inputs, seed and substantive
experiment. Any added display prefix is explicitly separate from the original
random call schedule.

```{cpp, results="markdown", file="figures/petrick_original.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>


using namespace datamunge::algorithms;
using namespace datamunge::graphics;

int main() {
    std::ostringstream original_output;
    auto *original_cout = std::cout.rdbuf(original_output.rdbuf());

    std::filesystem::create_directories("build");
    std::vector<std::uint32_t> minterms = {0, 1, 2, 5, 6, 7};
    auto qm = quine_mccluskey(3, minterms);

    std::cout << "=== Cyclic chart: f(A,B,C) = sum m(0,1,2,5,6,7) ===\n";
    std::cout << "prime implicants (" << qm.prime_implicants.size() << "): ";
    for (const auto &p : qm.prime_implicants)
        std::cout << implicant_to_string(p, 3) << " ";
    std::cout << "\nessential prime implicants: " << qm.essential.size() <<
        " (cyclic -> none)\n";

    // Build the coverage chart and run Petrick directly.
    std::vector<std::vector<int>> chart(minterms.size());
    for (std::size_t mi = 0; mi < minterms.size(); ++mi)
        for (std::size_t pi = 0; pi < qm.prime_implicants.size(); ++pi)
            if (qm.prime_implicants[pi].covers(minterms[mi]))
                chart[mi].push_back((int) pi);

    auto pr = petrick(chart);
    std::cout << "\nminimum covers found by Petrick (" <<
        pr.minimal_covers.size() << ", each " <<
        pr.minimal_covers.front().size() << " implicants):\n";
    for (const auto &cover : pr.minimal_covers) {
        std::cout << "  { ";
        for (int pi : cover)
            std::cout << implicant_to_string(qm.prime_implicants[pi], 3) << " ";
        std::cout << "}\n";
    }

    // Figure: the coverage chart as a grid, with the first minimum cover highlighted.
    RPlot p = RPlot::create();
    std::vector<double> cx, cy, hx, hy;
    const auto &chosen = pr.minimal_covers.front();
    for (std::size_t mi = 0; mi < minterms.size(); ++mi)
        for (int pi : chart[mi]) {
            bool in = false;
    for (int c : chosen)
        if (c == pi)
            in = true;
    if (in) {
        hx.push_back((double) minterms[mi]);
        hy.push_back((double) pi);
    } else {
        cx.push_back((double) minterms[mi]);
        cy.push_back((double) pi);
    }
        }
        p.points(cx, cy, "covers", {150, 150, 150}, 5.0);
        p.points(hx, hy, "chosen cover", {220, 38, 38}, 7.0);
        p.legend({"covers", "chosen cover"}, {{150, 150, 150}, {220, 38, 38}});
        p.title("Original cyclic chart: one actual minimum-cardinality cover").x_label("required minterm").y_label("native prime-implicant id");
        p.save_svg("build/petrick_original.svg");
        std::cout << "\nwrote build/petrick_original.svg\n";
        std::cout.rdbuf(original_cout);
        std::print("| Original computed output |\n| --- |\n");
        std::istringstream lines(original_output.str());
        std::string line;
        while (std::getline(lines, line)) {
            while (!line.empty() && line.back() == ' ') line.pop_back();
            if (!line.empty()) std::print("| `{}` |\n", line);
        }

        return 0;
}
```
