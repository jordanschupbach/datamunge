> Controls and boundary cases

```{cpp, results="markdown", file="figures/petrick_controls.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
    std::filesystem::create_directories("build");
    std::vector<std::vector<std::vector<int>> > charts{{}, {{}}, {{0}, {0, 1}},
                                                       {{0, 1}, {1, 2}, {0, 2}}};
    std::vector<std::string> labels{"identity", "uncoverable", "essential",
                                    "cycle"};
    std::vector<double> v;
    std::print("| chart | actual minimum covers | actual generated candidates |\n| --- | --- | ---: |\n");
    for (std::size_t i = 0; i < charts.size(); ++i) {
        auto t = dm::algorithms::petrick_trace(charts[i]);
        v.push_back(t.generated);
        std::print("| {} | `{}` | {} |\n", labels[i], t.result.minimal_covers,
                   t.generated);
    }
    auto p =
        dm::graphics::RPlot::barplot(v, labels, "actual generated products");
    p.title("Petrick logical identity, false clause and alternative minimum covers").y_label("actual generated products");
    p.save_svg("build/petrick_controls.svg");
}
```
