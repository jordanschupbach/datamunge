> Producing work and finite observations

```{cpp, results="markdown", file="figures/petrick_work.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
    std::filesystem::create_directories("build");
    auto t = dm::algorithms::petrick_trace({{0, 1}, {1, 2}, {2, 3}, {3, 0}});
    std::vector<double> x, y, z;
    std::print("| clause | generated | absorbed | survivors |\n| ---: | ---: | ---: | ---: |\n");
    for (auto &r : t.stages) {
        x.push_back(r.clause + 1);
        y.push_back(r.generated);
        z.push_back(r.terms.size());
        std::print("| {} | {} | {} | {} |\n", r.clause + 1, r.generated,
                   r.absorbed, r.terms.size());
    }
    auto p = dm::graphics::RPlot::create();
    p.lines(x, y, "actual generated candidates", {37, 99, 235}).points(
        x, y, {37, 99, 235}, 4).lines(x, z, "actual retained terms",
                                      {220, 38, 38}).points(x, z, {220, 38, 38},
                                                            4).title(
        "Petrick actual per-clause growth and absorption").x_label(
        "processed clause").y_label("actual count");
    p.save_svg("build/petrick_work.svg");
}
```
