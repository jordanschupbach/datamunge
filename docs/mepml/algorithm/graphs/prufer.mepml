> The retained original experiment

```{cpp, results="markdown", file="figures/prufer_original.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");

    const std::vector<std::pair<std::size_t, std::size_t>> tree{{0, 3}, {1, 3},
                                                                {2, 3}, {3, 4},
                                                                {4, 5}};
    auto encoded = a::tree_to_prufer_trace(6, tree);
    auto decoded = a::prufer_to_tree_trace(encoded.sequence);
    auto recoded = a::tree_to_prufer(6, decoded.edges);
    auto enumeration = a::prufer_enumeration(4);
    std::print("Original tree actual code {}, recoded {}, round-trip {}. Native enumeration: {} codes, {} " "distinct trees, Cayley reference {}.\n",
               encoded.sequence, recoded, recoded == encoded.sequence,
               enumeration.sequences, enumeration.distinct_trees,
               enumeration.cayley_count);
    std::print("\n| actual removed leaf | actual neighbor/code entry | actual next leaves |\n| ---: | ---: " "| --- |\n");
    for (auto &s : encoded.steps)
        std::print("| {} | {} | `{}` |\n", s.leaf, s.neighbor, s.leaves_after);
    std::vector<double> x{0, 0, 0, 2, 4, 6}, y{2, 1, 0, 1, 1, 1};
    auto p = g::RPlot::create();
    for (auto[u, v] : decoded.edges)
        p.lines({x[u], x[v]}, {y[u], y[v]}, "", {37, 99, 235}, 2.5);
    p.points(x, y, {220, 38, 38}, 8);
    for (std::size_t i = 0; i < x.size(); ++i)
        p.text(x[i] + .1, y[i] + .12, std::to_string(i), {17, 24, 39}, 14);
    p.title("Original six-vertex tree: edges actually decoded from code 3,3,3,4").hide_axes(true).x_limits(-.6, 6.7).y_limits(-.5, 2.5);
    p.save_svg("build/prufer_original.svg");
}
```
// result_begin: markdown
Original tree actual code [3, 3, 3, 4], recoded [3, 3, 3, 4], round-trip true. Native enumeration: 16 codes, 16 distinct trees, Cayley reference 16.

| actual removed leaf | actual neighbor/code entry | actual next leaves |
| ---: | ---: | --- |
| 0 | 3 | `[1, 2, 5]` |
| 1 | 3 | `[2, 5]` |
| 2 | 3 | `[3, 5]` |
| 3 | 4 | `[4, 5]` |
\image(figures/prufer_original.svg)
