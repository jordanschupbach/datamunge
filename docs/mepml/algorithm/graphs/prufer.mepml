> Explicit controls

```{cpp, results="markdown", file="figures/prufer_controls.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");

    std::vector<std::vector<std::size_t>> codes{{}, {0, 0, 0, 0}, {1, 2, 3, 4}};
    std::vector<std::string> labels{"two-vertex empty code", "six-vertex star",
                                    "six-vertex path"};
    std::vector<double> v;
    std::print("\n| fixture | actual decoded edges | actual recoded labels |\n| --- | ---: | --- |\n");
    for (std::size_t i = 0; i < codes.size(); ++i) {
        auto t = a::prufer_to_tree_trace(codes[i]);
        auto code = a::tree_to_prufer(codes[i].size() + 2, t.edges);
        v.push_back(t.edges.size());
        std::print("| {} | {} | `{}` |\n", labels[i], t.edges.size(), code);
    }
    bool cycle = false, parallel = false, label = false;
    try {
        a::tree_to_prufer(4, {{0, 1}, {1, 2}, {2, 0}});
    } catch (const std::invalid_argument &) {
        cycle = true;
    }
    try {
        a::tree_to_prufer(3, {{0, 1}, {0, 1}});
    } catch (const std::invalid_argument &) {
        parallel = true;
    }
    try {
        a::prufer_to_tree({3});
    } catch (const std::invalid_argument &) {
        label = true;
    }
    std::print("Disconnected cycle rejected: {}; parallel non-tree rejected: {}; invalid code label " "rejected: {}.\n",
               cycle, parallel, label);
    auto p = g::RPlot::barplot(v, labels, "actual decoded edges");
    p.title("Prüfer controls: valid empty codes and complete malformed-tree guards").y_label("actual edges");
    p.save_svg("build/prufer_controls.svg");
}
```
// result_begin: markdown
| fixture | actual decoded edges | actual recoded labels |
| --- | ---: | --- |
| two-vertex empty code | 1 | `[]` |
| six-vertex star | 5 | `[0, 0, 0, 0]` |
| six-vertex path | 5 | `[1, 2, 3, 4]` |
Disconnected cycle rejected: true; parallel non-tree rejected: true; invalid code label rejected: true.
\image(figures/prufer_controls.svg)
// result_end
\caption(Actual outcomes on controlled native inputs; errors, truncation and unresolved outcomes retain their stated meanings.)
