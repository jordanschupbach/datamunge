> Actual selected work and sensitivity

```{cpp, results="markdown", file="figures/prufer_work.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");

    std::vector<double> x, y;
    std::print("\n| labeled vertices | actual codes decoded | exact distinct edge sets | checked Cayley " "reference |\n| ---: | ---: | ---: | ---: |\n");
    for (std::size_t n : {2, 3, 4, 5, 6, 7}) {
        auto r = a::prufer_enumeration(n);
        x.push_back(n);
        y.push_back(std::log10(1. + r.distinct_trees));
        std::print("| {} | {} | {} | {} |\n", n, r.sequences, r.distinct_trees,
                   r.cayley_count);
    }
    auto p = g::RPlot::create();
    p.lines(x, y, "log10(actual distinct trees+1)", {16, 122, 87}).points(
        x, y, {16, 122, 87}, 5).title("Actual exhaustive native decoding: finite Cayley counts on small sizes").x_label("labeled vertices").y_label("log10(actual distinct trees+1)");
    p.save_svg("build/prufer_work.svg");
}
```
// result_begin: markdown
| labeled vertices | actual codes decoded | exact distinct edge sets | checked Cayley reference |
| ---: | ---: | ---: | ---: |
| 2 | 1 | 1 | 1 |
| 3 | 3 | 3 | 3 |
| 4 | 16 | 16 | 16 |
| 5 | 125 | 125 | 125 |
| 6 | 1296 | 1296 | 1296 |
| 7 | 16807 | 16807 | 16807 |
\image(figures/prufer_work.svg)
