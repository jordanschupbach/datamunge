> Test representation policy and failure boundaries

The next control repeats two existing crown edges. There are no new adjacency
constraints, but the multiplicity degree ordering changes and the palette falls
from three to two. Adding a valid self-loop instead leaves the projected
solution unchanged. This preserves the library's historical behavior while
making its graph model explicit.

```{cpp, results="markdown", file="figures/coloring_controls.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
    std::filesystem::create_directories("build");

    const auto base = dm::algorithms::coloring_crown(3);
    auto duplicate = base;
    duplicate.edges.push_back({0, 3});
    duplicate.edges.push_back({2, 5});
    auto loop = base;
    loop.edges.push_back({0, 0});
    const std::vector<dm::algorithms::ColoringGraph> graphs{base, duplicate,
                                                            loop, {0, {}},
                                                            {3, {}}};
    const std::vector<std::string> names{"base crown", "repeated edges",
                                         "added loop", "empty", "three isolates"};
    std::vector<double> x, colors;
    std::print("| case | edge records | ignored loops | palette | order |\n| --- | ---: | ---: | ---: | --- " "|\n");
    for (std::size_t i = 0; i < graphs.size(); ++i) {
        const auto &g = graphs[i];
        const auto a =
            dm::algorithms::greedy_coloring_analyze(g.vertices, g.edges);
        std::string order;
        for (auto v : a.order) {
            if (!order.empty())
                order += ",";
            order += std::to_string(v);
        }
        std::print("| {}: {} | {} | {} | {} | {} |\n", i + 1, names[i],
                   g.edges.size(), a.work.ignored_loops, a.result.num_colors,
                   order.empty() ? "none" : order);
        x.push_back(i + 1);
        colors.push_back(a.result.num_colors);
    }
    const auto t =
        dm::algorithms::greedy_coloring_trace(base.vertices, base.edges);
    bool quota = false, invalid = false;
    try {
        (void) dm::algorithms::greedy_coloring_trace(base.vertices, base.edges,
                                                     {6, 6, t.events.size() - 1});
    } catch (const std::length_error &) {
        quota = true;
    }
    try {
        (void) dm::algorithms::greedy_coloring_trace(6, {{6, 6}}, {1, 1, 1});
    } catch (const std::invalid_argument &) {
        invalid = true;
    }
    auto copy = t;
    copy.events[0].vertex = 99;
    std::print("\nOne-short actual-event cap rejects: {}; invalid loop endpoint rejected before caps: {}; " "copied events independent: {}; arbitrary gapped labels accepted: {}; loop-deleted singleton " "accepted: {}.\n",
               quota, invalid, t.events[0].vertex != copy.events[0].vertex,
               dm::algorithms::is_proper_coloring(2, {{0, 1}}, {7, 99}),
               dm::algorithms::is_proper_coloring(1, {{0, 0}}, {7}));
    auto plot = dm::graphics::RPlot::create();
    plot.bars(x, colors, "actual palette", {37, 99, 235}).title(
        "Multiplicity affects ordering; loops are deleted").x_label(
        "case: 1 base; 2 repeat; 3 loop; 4 empty; 5 isolates").y_label(
        "greedy colors").y_limits(0, 4).save_svg("build/coloring_controls.svg");
    if (colors != std::vector<double>{3, 2, 3, 0, 1} || !quota || !invalid)
        throw std::runtime_error("representation controls");
}
