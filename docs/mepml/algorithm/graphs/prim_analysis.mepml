//? Title: Prim: actual lazy-frontier choices and stale entries
//? Subtitle: Actual canonical histories, retained original fixtures and explicit controls
//? Exports: both
//? Lang: en-GB

\abstract(
A minimum crossing edge attaches one new vertex to the growing tree. The native
implementation retains its historical lazy min-heap and
lexicographic(weight,from,to) ties, while optional events now show its actual
pushes, pops and stale removals. The original distinct-weight six-site network
remains the substantive example. It is small enough to inspect the complete
selected edge order and total15; no external graph dataset is needed to
establish these cut decisions.
)

\toc

> Mechanism and mathematical scope

$$ T\gets T\cup\{(u,v)\},\quad v\notin V(T),\qquad (u,v)\text{ is the current minimum frontier candidate}. $$

> A tiny actual producing history

The table and native concept diagram read the same producing execution. Every
block below is a complete editable C++ program.

```{cpp, results="markdown", file="figures/prim_tiny.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <datamunge/plot/plot.hpp>
#include <datamunge/plot/diagram.hpp>
#include <datamunge/algorithms/modular_exponentiation.hpp>
#include <datamunge/algorithms/integer_arithmetic.hpp>
#include <filesystem>
#include <print>
#include <algorithm>
#include <cmath>
#include <limits>
#include <climits>
#include <datamunge/algorithms/number_theory.hpp>
#include <numeric>
#include <numbers>
#include <random>
#include <string>
#include <vector>
#include <map>
#include <set>
#include <array>
#include <tuple>
#include <datamunge/algorithms/prufer.hpp>
#include <datamunge/algorithms/flow_diagram.hpp>
#include <datamunge/algorithms/prim.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");

    auto t = a::prim_trace(3, {{0, 1, 1}, {0, 2, 3}, {1, 2, 2}});
    std::vector<a::PrimEvent> accepted;
    std::print("\n| actual event | edge | weight | actual heap size after | accepted | reached after |\n| " "--- | --- | ---: | ---: | --- | ---: |\n");
    for (auto &e : t.events) {
        std::print("| {} | {} to {} | {} | {} | {} | {} |\n",
                   e.push ? "push" : "pop", e.from, e.to, e.weight,
                   e.frontier_after, e.accepted, e.reached_after);
        if (e.accepted)
            accepted.push_back(e);
    }

    g::Diagram d;
    d.node("n0", {0, 0},
           std::format("Actual first accepted edge\n{} to {}, weight {}",
                       accepted[0].from, accepted[0].to, accepted[0].weight));
    d.node("n1", {10, 0},
           std::format("Actual next accepted edge\n{} to {}, weight {}",
                       accepted[1].from, accepted[1].to, accepted[1].weight));
    d.node("n2", {20, 0},
           std::format("Actual tree total / stale pops\n{} / {}",
                       t.run.tree.total_weight, t.run.stale));
    d.edge("n0", "n1").edge("n1", "n2");
    d.save_svg("build/prim_tiny.svg");
}
```
