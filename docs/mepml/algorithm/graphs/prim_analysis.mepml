> Actual selected work and sensitivity

```{cpp, results="markdown", file="figures/prim_work.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <datamunge/plot/plot.hpp>
#include <datamunge/plot/diagram.hpp>
#include <datamunge/algorithms/modular_exponentiation.hpp>
#include <datamunge/algorithms/integer_arithmetic.hpp>
#include <filesystem>
#include <print>
#include <algorithm>
#include <cmath>
#include <limits>
#include <climits>
#include <datamunge/algorithms/number_theory.hpp>
#include <numeric>
#include <numbers>
#include <random>
#include <string>
#include <vector>
#include <map>
#include <set>
#include <array>
#include <tuple>
#include <datamunge/algorithms/prufer.hpp>
#include <datamunge/algorithms/flow_diagram.hpp>
#include <datamunge/algorithms/prim.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");

    std::vector<double> x, y;
    std::print("\n| Prüfer-decoded star vertices | actual heap pushes | actual heap pops | actual adjacency " "reads | selected events |\n| ---: | ---: | ---: | ---: | ---: |\n");
    for (std::size_t n : {4, 8, 16, 32}) {
        auto tree = a::prufer_to_tree(std::vector<std::size_t>(n - 2, 0));
        std::vector<a::WeightedEdge> edges;
        for (auto[u, v] : tree)
            edges.emplace_back(u, v, 1.);
        auto r = a::prim_run(n, edges);
        x.push_back(n);
        y.push_back(r.operations);
        std::print("| {} | {} | {} | {} | {} |\n", n, r.pushes, r.pops,
                   r.adjacency_entries, r.operations);
    }
    auto p = g::RPlot::create();
    p.lines(x, y, "actual selected heap/adjacency events", {16, 122, 87}).points(x, y, {16, 122, 87}, 5).title("Native Prim work on canonical Prüfer-decoded star inputs").x_label("input vertices").y_label("actual selected events");
    p.save_svg("build/prim_work.svg");
}
```
