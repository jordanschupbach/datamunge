> The retained original experiment

```{cpp, results="markdown", file="figures/prim_original.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <datamunge/plot/plot.hpp>
#include <datamunge/plot/diagram.hpp>
#include <datamunge/algorithms/modular_exponentiation.hpp>
#include <datamunge/algorithms/integer_arithmetic.hpp>
#include <filesystem>
#include <print>
#include <algorithm>
#include <cmath>
#include <limits>
#include <climits>
#include <datamunge/algorithms/number_theory.hpp>
#include <numeric>
#include <numbers>
#include <random>
#include <string>
#include <vector>
#include <map>
#include <set>
#include <array>
#include <tuple>
#include <datamunge/algorithms/prufer.hpp>
#include <datamunge/algorithms/flow_diagram.hpp>
#include <datamunge/algorithms/prim.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");

    const std::vector<a::WeightedEdge> edges{{0, 1, 3}, {0, 3, 4}, {1, 2, 5},
                                             {1, 3, 6}, {1, 4, 7}, {2, 4, 2},
                                             {2, 5, 8}, {3, 4, 9}, {4, 5, 1}};
    auto t = a::prim_trace(6, edges, 0);
    std::print("Original graph: actual total {}, reached {}, connected {}.\n",
               t.run.tree.total_weight, t.run.reached, t.run.tree.is_connected);
    std::print("\n| actual attachment order | from | to | weight |\n| ---: | ---: | ---: | ---: |\n");
    for (std::size_t i = 0; i < t.run.tree.edges.size(); ++i) {
        auto[u, v, w] = t.run.tree.edges[i];
        std::print("| {} | {} | {} | {} |\n", i, u, v, w);
    }
    const std::vector<std::pair<double, double>> pos{{0, 2}, {2, 3}, {4, 2},
                                                     {1, 0}, {3, 0}, {5, 1}};
    auto p = g::RPlot::create();
    for (auto[u, v, w] : edges)
        p.lines({pos[u].first, pos[v].first}, {pos[u].second, pos[v].second},
                "", {190, 195, 200}, 1);
    for (auto[u, v, w] : t.run.tree.edges)
        p.lines({pos[u].first, pos[v].first}, {pos[u].second, pos[v].second},
                "", {220, 38, 38}, 3.5);
    std::vector<double> x, y;
    for (std::size_t i = 0; i < pos.size(); ++i) {
        x.push_back(pos[i].first);
        y.push_back(pos[i].second);
        p.text(pos[i].first + .12, pos[i].second + .15, std::to_string(i),
               {17, 24, 39}, 14);
    }
    p.points(x, y, {37, 99, 235}, 8).title(std::format("Original six-site graph: actual Prim tree in red, total {}",
                                                       t.run.tree.total_weight)).hide_axes(true).x_limits(-.6, 5.8).y_limits(-.8, 3.8);
    p.save_svg("build/prim_original.svg");
}
