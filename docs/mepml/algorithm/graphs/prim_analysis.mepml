> Explicit controls

```{cpp, results="markdown", file="figures/prim_controls.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <datamunge/plot/plot.hpp>
#include <datamunge/plot/diagram.hpp>
#include <datamunge/algorithms/modular_exponentiation.hpp>
#include <datamunge/algorithms/integer_arithmetic.hpp>
#include <filesystem>
#include <print>
#include <algorithm>
#include <cmath>
#include <limits>
#include <climits>
#include <datamunge/algorithms/number_theory.hpp>
#include <numeric>
#include <numbers>
#include <random>
#include <string>
#include <vector>
#include <map>
#include <set>
#include <array>
#include <tuple>
#include <datamunge/algorithms/prufer.hpp>
#include <datamunge/algorithms/flow_diagram.hpp>
#include <datamunge/algorithms/prim.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");

    std::vector<std::vector<a::WeightedEdge>> edges{{{0, 1, 2}},
                                                    {{0, 1, -2}, {1, 2, 1}},
                                                    {{0, 0, -9}, {0, 1, 5},
                                                     {0, 1, 1}, {1, 2, 2}}};
    std::vector<std::size_t> n{4, 3, 3};
    std::vector<std::string> labels{"disconnected start component",
                                    "negative finite weights",
                                    "parallel edges and self-loop"};
    std::vector<double> v;
    std::print("\n| fixture | actual total | actual reached | connected | actual stale pops |\n| --- | ---: " "| ---: | --- | ---: |\n");
    for (std::size_t i = 0; i < edges.size(); ++i) {
        auto r = a::prim_run(n[i], edges[i]);
        v.push_back(r.reached);
        std::print("| {} | {} | {} | {} | {} |\n", labels[i],
                   r.tree.total_weight, r.reached, r.tree.is_connected, r.stale);
    }
    bool bad = false;
    try {
        a::prim(2, {{0, 1, std::numeric_limits<double>::quiet_NaN()}});
    } catch (const std::invalid_argument &) {
        bad = true;
    }
    std::print("All nonfinite edge weights rejected before heap work: {}.\n",
               bad);
    auto p = g::RPlot::barplot(v, labels, "actual reached vertices");
    p.title("Prim controls: one start component and finite multigraph inputs").y_label("actual reached vertices");
    p.save_svg("build/prim_controls.svg");
}
```
