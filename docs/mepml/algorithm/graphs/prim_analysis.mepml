| push | 0 to 2 | 3 | 2 | false | 1 |
| pop | 0 to 1 | 1 | 1 | true | 2 |
| push | 1 to 2 | 2 | 2 | false | 2 |
| pop | 1 to 2 | 2 | 1 | true | 3 |
