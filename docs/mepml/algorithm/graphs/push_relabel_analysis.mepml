> Explicit controls

```{cpp, results="markdown", file="figures/push_relabel_controls.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <datamunge/plot/plot.hpp>
#include <datamunge/plot/diagram.hpp>
#include <datamunge/algorithms/modular_exponentiation.hpp>
#include <datamunge/algorithms/integer_arithmetic.hpp>
#include <filesystem>
#include <print>
#include <algorithm>
#include <cmath>
#include <limits>
#include <climits>
#include <datamunge/algorithms/number_theory.hpp>
#include <numeric>
#include <numbers>
#include <random>
#include <string>
#include <vector>
#include <map>
#include <set>
#include <array>
#include <tuple>
#include <datamunge/algorithms/prufer.hpp>
#include <datamunge/algorithms/flow_diagram.hpp>
#include <datamunge/algorithms/push_relabel.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");

    std::vector<a::FlowNetwork> cases{{3, {{0, 1, 1e-15}, {1, 2, 1e-15}}, 0, 2},
                                      {2, {{0, 0, 5}, {0, 1, 3}, {1, 1, 4}}, 0,
                                       1},
                                      {3,
                                       {{0, 1, 3}, {1, 0, 2}, {1, 2, 2},
                                        {0, 2, 1}}, 0, 2},
                                      {2, {{0, 1, 0}}, 0, 1}};
    std::vector<std::string> labels{"tiny positive two-edge path", "self-loops",
                                    "antiparallel edges", "zero capacity"};
    std::vector<double> v;
    std::print("\n| fixture | actual flow | actual positive pushes | actual edge flows |\n| --- | ---: | " "---: | --- |\n");
    for (std::size_t i = 0; i < cases.size(); ++i) {
        auto &n = cases[i];
        auto r = a::push_relabel_run(n.vertex_count, n.edges, n.source, n.sink);
        v.push_back(r.work.pushes);
        std::print("| {} | {} | {} | `{}` |\n", labels[i], r.result.max_flow,
                   r.work.pushes, r.result.edge_flow);
    }
    bool bad = false;
    try {
        a::push_relabel_max_flow(2, {{0, 1, -1}}, 0, 1);
    } catch (const std::invalid_argument &) {
        bad = true;
    }
    std::print("Complete negative-capacity guard: {}.\n", bad);
    auto p = g::RPlot::barplot(v, labels, "actual positive pushes");
    p.title("Native preflow controls: tiny capacities are processed and self-loops stay idle").y_label("actual source/discharge pushes");
    p.save_svg("build/push_relabel_controls.svg");
}
```
