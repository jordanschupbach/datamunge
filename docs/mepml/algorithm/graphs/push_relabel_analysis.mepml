> The retained original experiment

```{cpp, results="markdown", file="figures/push_relabel_original.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <datamunge/plot/plot.hpp>
#include <datamunge/plot/diagram.hpp>
#include <datamunge/algorithms/modular_exponentiation.hpp>
#include <datamunge/algorithms/integer_arithmetic.hpp>
#include <filesystem>
#include <print>
#include <algorithm>
#include <cmath>
#include <limits>
#include <climits>
#include <datamunge/algorithms/number_theory.hpp>
#include <numeric>
#include <numbers>
#include <random>
#include <string>
#include <vector>
#include <map>
#include <set>
#include <array>
#include <tuple>
#include <datamunge/algorithms/prufer.hpp>
#include <datamunge/algorithms/flow_diagram.hpp>
#include <datamunge/algorithms/push_relabel.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");

    auto original = a::push_relabel_run(2, {{0, 1, 9}}, 0, 1);
    a::FlowNetwork network{6,
                           {{0, 1, 16}, {0, 2, 13}, {1, 2, 10}, {2, 1, 4},
                            {1, 3, 12}, {3, 2, 9}, {2, 4, 14}, {4, 3, 7},
                            {3, 5, 20}, {4, 5, 4}}, 0, 5};
    auto t =
        a::push_relabel_trace(network.vertex_count, network.edges,
                              network.source, network.sink);
    auto certificate =
        a::max_flow_certificate(network.vertex_count, network.edges,
                                network.source, network.sink, t.run.result);
    std::print("Original capacity9 example returns {}. CLRS control actual flow {}, cut {}, feasible {}, " "optimal within declared tolerance {}.\n",
               original.result.max_flow, t.run.result.max_flow,
               certificate.cut_capacity, certificate.feasible,
               certificate.optimal_within_tolerance);
    std::print("\n| actual selected quantity | value |\n| --- | ---: |\n| source/preflow and discharge " "pushes | {} |\n| relabels | {} |\n| FIFO discharge pops | {} |\n| residual arc inspections " "| {} |\n",
               t.run.work.pushes, t.run.work.relabels, t.run.work.queue_pops,
               t.run.work.arc_inspections);
    auto d =
        a::plot_max_flow(network, t.run.result,
                         {{0, 0}, {7, 4}, {7, -4}, {14, 4}, {14, -4}, {21, 0}});
    d.save_svg("build/push_relabel_original.svg");
}
```
