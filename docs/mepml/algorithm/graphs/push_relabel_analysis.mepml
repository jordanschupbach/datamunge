//? Title: Push-relabel: actual preflow, excess and height changes
//? Subtitle: Actual canonical histories, retained original fixtures and explicit controls
//? Exports: both
//? Lang: en-GB

\abstract(
A preflow may leave positive excess at intermediate vertices. The FIFO producer
pushes only on admissible residual arcs and relabels a blocked vertex from
actual neighboring heights. Its optional history now records the real
residual-pair, excess and height updates. The original two-vertex capacity9
example remains, followed by the complete six-vertex CLRS control. Small
exact-capacity networks allow independent flow/cut checks; tiny floating
capacities expose the old absolute-epsilon failure.
)

\toc

> Mechanism and mathematical scope

$$ h(u)=h(v)+1\text{ permits a residual push};\qquad h(u)\gets1+\min_{(u,v)\text{ residual}}h(v). $$

> A tiny actual producing history

The table and native concept diagram read the same producing execution. Every
block below is a complete editable C++ program.

```{cpp, results="markdown", file="figures/push_relabel_tiny.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <datamunge/plot/plot.hpp>
#include <datamunge/plot/diagram.hpp>
#include <datamunge/algorithms/modular_exponentiation.hpp>
#include <datamunge/algorithms/integer_arithmetic.hpp>
#include <filesystem>
#include <print>
#include <algorithm>
#include <cmath>
#include <limits>
#include <climits>
#include <datamunge/algorithms/number_theory.hpp>
#include <numeric>
#include <numbers>
#include <random>
#include <string>
#include <vector>
#include <map>
#include <set>
#include <array>
#include <tuple>
#include <datamunge/algorithms/prufer.hpp>
#include <datamunge/algorithms/flow_diagram.hpp>
#include <datamunge/algorithms/push_relabel.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");

    auto t = a::push_relabel_trace(2, {{0, 1, 9}}, 0, 1);
    const auto &e = t.events[0];
    std::print("\n| actual preflow amount | from height | target height | source excess after | sink excess " "after | actual flow |\n| ---: | ---: | ---: | ---: | ---: | ---: |\n");
    std::print("| {} | {} | {} | {} | {} | {} |\n", e.amount, e.height_after,
               e.target_height, e.from_excess_after, e.to_excess_after,
               t.run.result.max_flow);

    g::Diagram d;
    d.node("n0", {0, 0},
           std::format("Actual initialized source height\n{}",
                       t.initial_heights[0]));
    d.node("n1", {10, 0},
           std::format("Actual source saturation\namount {}", e.amount));
    d.node("n2", {20, 0},
           std::format("Actual sink excess / flow\n{} / {}", t.run.excess[1],
                       t.run.result.max_flow));
    d.edge("n0", "n1").edge("n1", "n2");
    d.save_svg("build/push_relabel_tiny.svg");
}
