int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");

    std::vector<double> x, y;
    std::print("\n| native disjoint two-edge paths | actual pushes | actual relabels | actual residual arc " "reads | selected events |\n| ---: | ---: | ---: | ---: | ---: |\n");
    for (std::size_t paths : {1, 2, 4, 8, 16}) {
        auto n = a::dinic_disjoint_paths(paths, 2);
        auto r = a::push_relabel_run(n.vertex_count, n.edges, n.source, n.sink);
        x.push_back(paths);
        y.push_back(r.work.operations);
        std::print("| {} | {} | {} | {} | {} |\n", paths, r.work.pushes,
                   r.work.relabels, r.work.arc_inspections, r.work.operations);
    }
    auto p = g::RPlot::create();
    p.lines(x, y, "actual native selected preflow events", {16, 122, 87}).points(x, y, {16, 122, 87}, 5).title("FIFO preflow work on canonical independent unit-capacity path fixtures").x_label("disjoint source-to-sink paths").y_label("actual selected events");
    p.save_svg("build/push_relabel_work.svg");
}
