| 7 | 7 | 7 | true |
| 6 | 9 | 9 | true |
| 5 | 6 | 6 | true |
| 4 | 7 | 7 | true |
| 3 | 4 | 4 | true |
| 2 | 9 | 9 | true |
| 1 | 9 | 9 | true |
| 0 | 7 | 7 | true |

Actual empty payload digit 0; empty full validity false; leading-zero full validity true; appended check digit 3.
\image(figures/luhn_parity.svg)
// result_end
\caption(Actual payload/full parity agreement at each original index.)
