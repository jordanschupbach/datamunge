> Actual selected work and sensitivity

```{cpp, results="markdown", file="figures/quickselect_work.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");

    auto rows =
        a::quickselect_scaling({50, 100, 150, 200, 250, 300, 350, 400, 450, 500,
                                550, 600, 650, 700, 750, 800, 850, 900, 950,
                                1000}, 60);
    std::vector<double> x, y, z;
    std::print("\n| original n | trials | actual heuristic comparisons | actual BFPRT comparisons | " "heuristic per key | BFPRT per key |\n| ---: | ---: | ---: | ---: | ---: | ---: |\n");
    for (const auto &r : rows) {
        const double keys = double(r.size) * r.trials;
        x.push_back(r.size);
        y.push_back(r.comparisons / keys);
        z.push_back(r.bfprt_comparisons / keys);
        std::print("| {} | {} | {} | {} | {} | {} |\n", r.size, r.trials,
                   r.comparisons, r.bfprt_comparisons, y.back(), z.back());
    }
    auto p = g::RPlot::create();
    p.lines(x, y, "actual heuristic comparisons per key", {37, 99, 235}).lines(
        x, z, "actual BFPRT comparisons per key", {234, 88, 12}).title(
        "Original seeded workload: both real selection producers").x_label(
        "keys per trial").y_label("actual comparisons / generated keys");
    p.save_svg("build/quickselect_work.svg");
}
```
