> Explicit controls

```{cpp, results="markdown", file="figures/quickselect_controls.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");

    std::vector<double> counts;
    std::vector<std::string> labels{"all equal, heuristic", "all equal, BFPRT",
                                    "two key values"};
    std::print("\n| control | actual answer | actual partitions | key comparisons |\n| --- | ---: | ---: | " "---: |\n");
    for (int i = 0; i < 3; ++i) {
        std::vector<std::int64_t> v(64, 7);
        if (i == 2)
            v = {0, 1, 0, 1, 0, 1, 0, 1};
        a::QuickselectOptions o;
        o.median_of_medians = i == 1;
        auto r = a::quickselect_run(v, v.size() / 2, o);
        counts.push_back(r.partitions);
        std::print("| {} | {} | {} | {} |\n", labels[i], r.value, r.partitions,
                   r.comparisons);
    }
    bool empty = false, rank = false;
    try {
        a::quickselect({}, 0);
    } catch (const std::invalid_argument &) {
        empty = true;
    }
    try {
        a::quickselect({1}, 1);
    } catch (const std::invalid_argument &) {
        rank = true;
    }
    std::print("Empty selection rejected: {}; invalid rank rejected: {}.\n",
               empty, rank);
    auto p =
        g::RPlot::barplot(counts, labels,
                          "actual partitions, including BFPRT subsearches");
    p.title("Equal-band stopping and nested pivot work").y_label(
        "actual partition count");
    p.save_svg("build/quickselect_controls.svg");
}
```
