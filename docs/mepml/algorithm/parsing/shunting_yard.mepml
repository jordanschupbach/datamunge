> Actual selected work and sensitivity

```{cpp, results="markdown", file="figures/shunting_yard_work.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    std::vector<double> x, y;
    std::print("| decimal bytes | value | actual tokens | operator pops |\n| ---: | ---: | ---: | ---: |\n");
    for (const std::string text : {"1+2", "10+20", "100+200", "1000+2000",
                                   "10000+20000"}) {
        auto r = a::shunting_yard_run(text);
        std::print("| {} | {} | {} | {} |\n", text.size(), r.value, r.tokens,
                   r.operator_pops);
        x.push_back(text.size());
        y.push_back(r.tokens);
    }
    auto plot = g::RPlot::create();
    plot.lines(x, y, "actual values", {37, 99, 235}).points(x, y, {37, 99, 235},
                                                            4).title(
        "Token counts differ from lexical byte work").x_label("input bytes").y_label("actual tokens");
    plot.save_svg("build/shunting_yard_work.svg");
}
```
