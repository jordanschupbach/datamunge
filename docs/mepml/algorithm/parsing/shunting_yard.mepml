> Explicit controls

```{cpp, results="markdown", file="figures/shunting_yard_controls.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    std::vector<double> x, y;
    const std::vector<std::string> cases{"2^3^2", "(2^3)^2", "1-5", "3+",
                                         "2(3)", "1..2", "(1+2", "2@3", "1/0",
                                         "0^(1-2)"};
    std::print("| control | expression | outcome |\n| ---: | --- | --- |\n");
    for (std::size_t i = 0; i < cases.size(); ++i) {
        x.push_back(i);
        try {
            auto r = a::shunting_yard_run(cases[i]);
            std::print("| {} | `{}` | value {} |\n", i, cases[i], r.value);
            y.push_back(1);
        } catch (const std::exception &e) {
            std::print("| {} | `{}` | rejected: {} |\n", i, cases[i], e.what());
            y.push_back(0);
        }
    }
    auto plot = g::RPlot::create();
    plot.lines(x, y, "actual values", {37, 99, 235}).points(x, y, {37, 99, 235},
                                                            4).title(
        "Grammar and arithmetic controls").x_label("control index").y_label(
        "accepted (1) or rejected (0)");
    plot.save_svg("build/shunting_yard_controls.svg");
}
```
// result_begin: markdown
| control | expression | outcome |
| ---: | --- | --- |
| 0 | `2^3^2` | value 512 |
| 1 | `(2^3)^2` | value 64 |
| 2 | `1-5` | value -4 |
| 3 | `3+` | rejected: parser: incomplete expression |
| 4 | `2(3)` | rejected: parser: implicit product |
| 5 | `1..2` | rejected: parser: decimal token |
| 6 | `(1+2` | rejected: parser: unmatched open |
| 7 | `2@3` | rejected: parser: unknown character |
| 8 | `1/0` | rejected: rpn: zero divisor |
| 9 | `0^(1-2)` | rejected: rpn: nonfinite result |
\image(figures/shunting_yard_controls.svg)
// result_end
