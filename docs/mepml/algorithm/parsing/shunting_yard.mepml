> The retained original experiment

```{cpp, results="markdown", file="figures/shunting_yard_original.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    const std::vector<std::string> expressions{"3 + 4 * 2", "( 3 + 4 ) * 2",
                                               "3 + 4 * 2 / ( 1 - 5 )",
                                               "2 ^ 3 ^ 2", "100 * 2 + 12"};
    std::vector<double> x, y;
    std::print("| original expression | actual postfix | actual value |\n| --- | --- | ---: |\n");
    for (std::size_t i = 0; i < expressions.size(); ++i) {
        auto r = a::shunting_yard_run(expressions[i]);
        std::print("| `{}` | `{}` | {} |\n", expressions[i], r.postfix, r.value);
        x.push_back(i);
        y.push_back(r.value);
    }
    auto plot = g::RPlot::create();
    plot.lines(x, y, "actual values", {37, 99, 235}).points(x, y, {37, 99, 235},
                                                            4).title(
        "Original five arithmetic expressions").x_label("expression index").y_label("computed value");
    plot.save_svg("build/shunting_yard_original.svg");
}
```
// result_begin: markdown
| original expression | actual postfix | actual value |
| --- | --- | ---: |
| `3 + 4 * 2` | `3 4 2 * +` | 11 |
| `( 3 + 4 ) * 2` | `3 4 + 2 *` | 14 |
| `3 + 4 * 2 / ( 1 - 5 )` | `3 4 2 * 1 5 - / +` | 1 |
| `2 ^ 3 ^ 2` | `2 3 2 ^ ^` | 512 |
| `100 * 2 + 12` | `100 2 * 12 +` | 212 |
\image(figures/shunting_yard_original.svg)
// result_end
\caption(Retained original inputs and substantive experiment, with actual native outputs and explicitly labelled mathematical references.)
