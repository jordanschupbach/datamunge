> Actual selected work and sensitivity

```{cpp, results="markdown", file="figures/pratt_work.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");

    std::vector<double> x, y;
    std::print("\n| explicit parenthesis depth | actual recursive maximum | actual binding checks | actual " "selected parser events |\n| ---: | ---: | ---: | ---: |\n");
    for (std::size_t depth : {4, 16, 64, 128}) {
        auto expression =
            std::string(depth, '(') + "1" + std::string(depth, ')');
        auto r = a::pratt_run(expression);
        x.push_back(depth);
        y.push_back(r.maximum_depth);
        std::print("| {} | {} | {} | {} |\n", depth, r.maximum_depth,
                   r.binding_checks, r.operations);
    }
    auto p = g::RPlot::create();
    p.lines(x, y, "actual simultaneous parse frames", {16, 122, 87}).points(
        x, y, {16, 122, 87}, 5).title("Native parser stack work on explicit nested-group inputs").x_label("input nested parenthesis pairs").y_label("actual maximum recursive frames");
    p.save_svg("build/pratt_work.svg");
}
```
// result_begin: markdown
| explicit parenthesis depth | actual recursive maximum | actual binding checks | actual selected parser events |
| ---: | ---: | ---: | ---: |
