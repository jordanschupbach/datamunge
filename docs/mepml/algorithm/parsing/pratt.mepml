> Explicit controls

```{cpp, results="markdown", file="figures/pratt_controls.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");

    std::vector<std::string> expressions{"-2^2", "-(2^2)", "2^3^2", "(2^3)^2"};
    std::vector<double> v;
    std::print("\n| grammar control | actual returned value |\n| --- | ---: |\n");
    for (auto &e : expressions) {
        auto r = a::pratt_run(e);
        v.push_back(r.value);
        std::print("| `{}` | {} |\n", e, r.value);
    }
    bool token = false, nul = false, nonfinite = false;
    try {
        a::pratt_eval("1.2.3");
    } catch (const std::runtime_error &) {
        token = true;
    }
    try {
        a::pratt_eval(std::string("1\0+2", 4));
    } catch (const std::runtime_error &) {
        nul = true;
    }
    try {
        a::pratt_eval("1/0");
    } catch (const std::overflow_error &) {
        nonfinite = true;
    }
    std::print("Partial decimal rejected: {}; embedded NUL rejected: {}; nonfinite arithmetic rejected: " "{}.\n",
               token, nul, nonfinite);
    auto p = g::RPlot::barplot(v, expressions, "actual scalar result");
    p.title("Pratt controls: right powers and historically tight unary signs").y_label("actual finite result");
    p.save_svg("build/pratt_controls.svg");
}
```
// result_begin: markdown
| grammar control | actual returned value |
| --- | ---: |
| `-2^2` | 4 |
| `-(2^2)` | -4 |
| `2^3^2` | 512 |
| `(2^3)^2` | 64 |
Partial decimal rejected: true; embedded NUL rejected: true; nonfinite arithmetic rejected: true.
\image(figures/pratt_controls.svg)
// result_end
