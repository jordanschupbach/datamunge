> The retained original experiment

```{cpp, results="markdown", file="figures/pratt_original.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");

    std::vector<std::string> expressions{"1+2*3", "2*3+4", "(1+2)*3", "2^3+1",
                                         "2+3^2", "2^3^2"};
    std::map<char, int> powers;
    std::print("\n| original expression | actual returned value | actual completed infix operations |\n| " "--- | ---: | ---: |\n");
    for (auto &e : expressions) {
        auto t = a::pratt_trace(e);
        std::print("| `{}` | {} | {} |\n", e, t.run.value,
                   t.run.infix_operations);
        for (auto &event : t.events)
            if (event.kind == a::PrattEventKind::Binding &&
                event.left_binding_power)
                powers[event.op] = event.left_binding_power;
    }
    for (auto &event : a::pratt_trace("8-4/2").events)
        if (event.kind == a::PrattEventKind::Binding && event.left_binding_power)
            powers[event.op] = event.left_binding_power;
    std::vector<double> v;
    std::vector<std::string> labels;
    for (char op : std::string("+-*/^")) {
        v.push_back(powers.at(op));
        labels.push_back(std::string(1, op));
    }
    auto p =
        g::RPlot::barplot(v, labels, "actual observed native left powers",
                          {109, 40, 217});
    p.title("Original Pratt examples: binding powers read from actual parser decisions").x_label("operator observed in actual evaluation").y_label("native left binding power");
    p.save_svg("build/pratt_original.svg");
}
```
// result_begin: markdown
| original expression | actual returned value | actual completed infix operations |
| --- | ---: | ---: |
| `1+2*3` | 7 | 2 |
| `2*3+4` | 10 | 2 |
| `(1+2)*3` | 9 | 2 |
| `2^3+1` | 9 | 2 |
| `2+3^2` | 11 | 2 |
| `2^3^2` | 512 | 2 |
\image(figures/pratt_original.svg)
// result_end
