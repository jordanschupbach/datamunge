#include <datamunge/stats/lm.hpp>
#include <datamunge/algorithms/arithmetic_coding.hpp>
#include <datamunge/nn/rbf.hpp>
#include <datamunge/nn/model_plot.hpp>
#include <bit>
#include <datamunge/algorithms/recursive_descent_parser.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");

    const std::vector<std::string> expressions{"1 + 2 * 3", "(1 + 2) * 3",
                                               "2 * 3 + 4 * 5", "10 - 2 - 3",
                                               "-3 + 5", "2 * (3 + (4 - 1))"};
    std::print("\n| original expression | actual result | actual grammar calls | actual completed nodes " "|\n| --- | ---: | ---: | ---: |\n");
    for (const auto &text : expressions) {
        auto t = a::recursive_descent_trace(text);
        std::print("| {} | {} | {} | {} |\n", text, t.value, t.calls,
                   t.nodes.size());
    }
    auto t = a::recursive_descent_trace(expressions[0]);
    auto diagram = a::recursive_descent_diagram(t);
    diagram.save_svg("build/recursive_descent_original.svg");
}
