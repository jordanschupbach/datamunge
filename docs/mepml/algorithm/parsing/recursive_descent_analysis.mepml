int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");

    std::vector<double> x, y, z;
    std::print("\n| explicit group pairs | actual grammar calls | actual maximum depth | actual retained " "syntax nodes |\n| ---: | ---: | ---: | ---: |\n");
    for (std::size_t n : {1, 4, 16, 64, 128}) {
        const auto text = std::string(n, '(') + "1" + std::string(n, ')');
        auto t = a::recursive_descent_trace(text);
        x.push_back(n);
        y.push_back(t.calls);
        z.push_back(t.max_depth);
        std::print("| {} | {} | {} | {} |\n", n, t.calls, t.max_depth,
                   t.nodes.size());
    }
    auto p = g::RPlot::create();
    p.lines(x, y, "actual grammar entries", {37, 99, 235}).lines(
        x, z, "actual live grammar depth", {234, 88, 12}).points(x, y,
                                                                 {37, 99, 235},
                                                                 5).title(
        "Native nested-group parsing: actual calls and stack depth").x_label(
        "input parenthesis pairs").y_label("actual grammar calls / live depth");
    p.save_svg("build/recursive_descent_work.svg");
}
