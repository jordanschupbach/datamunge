#include <map>
#include <set>
#include <array>
#include <tuple>
#include <datamunge/algorithms/prufer.hpp>
#include <datamunge/algorithms/flow_diagram.hpp>
#include <datamunge/geometry/hull_algorithms.hpp>
#include <datamunge/random/sampling_analysis.hpp>
#include <iomanip>
#include <datamunge/algorithms/qr_algorithm.hpp>
#include <datamunge/stats/lm.hpp>
#include <datamunge/algorithms/arithmetic_coding.hpp>
#include <datamunge/nn/rbf.hpp>
#include <datamunge/nn/model_plot.hpp>
#include <bit>
#include <datamunge/algorithms/recursive_descent_parser.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");

    const std::vector<std::string> valid{"--3", "-.5*2", "8/4/2", "10-2-3"};
    std::vector<double> values;
    std::print("\n| valid control | actual scalar |\n| --- | ---: |\n");
    for (const auto &text : valid) {
        const auto value = a::recursive_descent_eval(text);
        values.push_back(value);
        std::print("| {} | {} |\n", text, value);
    }
    std::size_t rejected = 0;
    for (const auto &text : std::vector<std::string>{"1 + ", "(1 + 2", "1 2",
                                                     "1.2.3", "1/0",
                                                     std::string("1\0+2", 4)}) {
        try {
            a::recursive_descent_eval(text);
        } catch (const std::runtime_error &) {
            ++rejected;
        }
    }
    std::print("Actual complete-source malformed/nonfinite controls rejected: {} of6.\n",
               rejected);
    auto p = g::RPlot::barplot(values, valid, "actual finite grammar value");
    p.title("Prefix signs, decimals and left-associative folds").y_label(
        "actual evaluated scalar");
    p.save_svg("build/recursive_descent_controls.svg");
    if (rejected != 6)
        return 1;
}
