> Original arithmetic grammar and expression controls

Retain E→T E-prime, E-prime→+ T E-prime | epsilon, T→F T-prime, T-prime→* F
T-prime | epsilon, F→( E ) | id, in the original production order. Native
construction reaches conflict-free FIRST/FOLLOW sets and the original
accept/reject outcomes for five token sequences. Actual set sizes are plotted
with a small horizontal offset solely to keep two equal counts visible; every
member is printed from the native sets. These counts are construction results,
not measured parsing speed or language-size estimates.

```{cpp, results="markdown", file="figures/ll1_original.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <datamunge/algorithms/ll1_parser.hpp>
#include <datamunge/plot/plot.hpp>
#include <filesystem>
#include <print>
int main() {
    std::filesystem::create_directories("build");
    const dm::algorithms::LL1Parser p(dm::algorithms::ll1_expression_grammar());
    std::print("Actual original grammar conflict-free: {}.\n\n| original nonterminal | actual FIRST " "members, eps for empty marker | actual FOLLOW members |\n| --- | --- | --- |\n",
               p.is_ll1());
    std::vector<double> x1, x2, first, follow;
    std::vector<std::string> nts{"E", "E'", "T", "T'", "F"};
    for (std::size_t i = 0; i < nts.size(); ++i) {
        std::string a, b;
        for (auto &s : p.first(nts[i]))
            a += (s.empty() ? "eps" : s) + " ";
        for (auto &s : p.follow(nts[i]))
            b += s + " ";
        std::print("| {} | {} | {} |\n", nts[i], a, b);
        x1.push_back(i - .1);
        x2.push_back(i + .1);
        first.push_back(p.first(nts[i]).size());
        follow.push_back(p.follow(nts[i]).size());
    }
    std::print("\n| original token sequence | actual accepted | actual actions | actual tokens consumed " "|\n| --- | --- | ---: | ---: |\n");
    for (auto tokens : std::vector<std::vector<std::string>>{
         {"id", "+", "id", "*", "id"}, {"(", "id", "+", "id", ")", "*", "id"},
         {"id"}, {"id", "+"}, {"id", "id"}
     }) {
        std::string text;
        for (auto &s : tokens)
            text += s + " ";
        auto a = p.analyze(tokens);
        std::print("| {} | {} | {} | {} |\n", text, a.accepted, a.steps,
                   a.consumed);
    }
    auto &w = p.construction_work();
    std::print("\nActual FIRST passes {}; FOLLOW passes {}; FIRST insertions {}; FOLLOW insertions {}; " "table attempts {}; conflicts {}.\n",
               w.first_passes, w.follow_passes, w.first_insertions,
               w.follow_insertions, w.table_attempts, w.conflicts);
    auto plot = dm::graphics::RPlot::create();
    plot.points(x1, first, "actual FIRST size", {37, 99, 235}, 6).points(
        x2, follow, "actual FOLLOW size", {220, 38, 38}, 6).y_limits(0, 6).title("Original arithmetic grammar: actual fixed-point set sizes").x_label("listed nonterminal index0:E,1:E-prime,2:T,3:T-prime,4:F").y_label("actual set member count").save_svg("build/ll1_original.svg");
}
```
