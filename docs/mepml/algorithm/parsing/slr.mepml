> Explicit controls

```{cpp, results="markdown", file="figures/slr_controls.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    a::ContextFreeGrammar grammar{{{"E", {"E", "+", "T"}}, {"E", {"T"}},
                                   {"T", {"T", "*", "F"}}, {"T", {"F"}},
                                   {"F", {"(", "E", ")"}}, {"F", {"id"}}}, "E"};
    a::SLRParser parser(grammar);
    const std::vector<std::vector<std::string>> inputs{{"id", "+", "id", "*",
                                                        "id"},
                                                       {"(", "id", "+", "id",
                                                        ")", "*", "id"}, {"id"},
                                                       {"id", "+"},
                                                       {"id", "id"},
                                                       {"id", "$", "id"}, {}};
    std::vector<double> x, y;
    std::print("| original/control input | accepted | consumed | actual lookups |\n| --- | --- | ---: | " "---: |\n");
    for (std::size_t i = 0; i < inputs.size(); ++i) {
        auto r = parser.parse_run(inputs[i]);
        std::print("| `{}` | {} | {} | {} |\n", inputs[i], r.accepted,
                   r.consumed, r.actions);
        x.push_back(i);
        y.push_back(r.accepted ? 1 : 0);
    }
    auto plot = g::RPlot::create();
    plot.lines(x, y, "actual values", {37, 99, 235}).points(x, y, {37, 99, 235},
                                                            4).title(
        "Complete input recognition and reserved marker").x_label("input index").y_label("accepted1 or rejected0");
    plot.save_svg("build/slr_controls.svg");
}
```
