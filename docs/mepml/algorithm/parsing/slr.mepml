> Actual selected work and sensitivity

```{cpp, results="markdown", file="figures/slr_work.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    a::ContextFreeGrammar grammar{{{"S", {"S", "S"}}, {"S", {"a"}}}, "S"};
    a::SLRParser parser(grammar);
    auto build = parser.inspection();
    std::vector<double> x, y;
    std::print("| actual state | stored items |\n| ---: | ---: |\n");
    for (std::size_t i = 0; i < build.states.size(); ++i) {
        std::print("| {} | {} |\n", i, build.states[i].size());
        x.push_back(i);
        y.push_back(build.states[i].size());
    }
    std::print("\nActual conflicts {}; is_slr {}.\n", build.conflicts,
               parser.is_slr());
    try {
        parser.parse_run({"a", "a"});
    } catch (const std::logic_error &e) {
        std::print("Conflicted parse rejected: {}.\n", e.what());
    }
    auto plot = g::RPlot::create();
    plot.lines(x, y, "actual values", {37, 99, 235}).points(x, y, {37, 99, 235},
                                                            4).title(
        "Actual item sets of a conflicted grammar").x_label("LR state").y_label(
        "actual stored items");
    plot.save_svg("build/slr_work.svg");
}
```
// result_begin: markdown
| actual state | stored items |
| ---: | ---: |
| 0 | 3 |
| 1 | 4 |
| 2 | 1 |
| 3 | 4 |

Actual conflicts 1; is_slr false.
Conflicted parse rejected: SLR: conflicted table.
