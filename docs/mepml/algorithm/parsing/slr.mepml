> The retained original experiment

```{cpp, results="markdown", file="figures/slr_original.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    a::ContextFreeGrammar grammar{{{"E", {"E", "+", "T"}}, {"E", {"T"}},
                                   {"T", {"T", "*", "F"}}, {"T", {"F"}},
                                   {"F", {"(", "E", ")"}}, {"F", {"id"}}}, "E"};
    a::SLRParser parser(grammar);
    auto build = parser.inspection();
    std::print("| nonterminal | actual FIRST | actual FOLLOW |\n| --- | --- | --- |\n");
    for (const std::string symbol : {"E", "T", "F"})
        std::print("| {} | `{}` | `{}` |\n", symbol, build.first.at(symbol),
                   build.follow.at(symbol));
    std::print("\n| LR state | production index | actual dot |\n| ---: | ---: | ---: |\n");
    for (std::size_t i = 0; i < build.states.size(); ++i)
        for (const auto &item : build.states[i])
            std::print("| {} | {} | {} |\n", i, item.production, item.dot);
    auto r = parser.parse_trace({"id", "+", "id", "*", "id"});
    std::vector<double> x, y;
    std::print("\n| actual step | state-stack depth |\n| ---: | ---: |\n");
    for (std::size_t i = 0; i < r.depths.size(); ++i) {
        std::print("| {} | {} |\n", i, r.depths[i]);
        x.push_back(i);
        y.push_back(r.depths[i]);
    }
    auto plot = g::RPlot::create();
    plot.lines(x, y, "actual values", {37, 99, 235}).points(x, y, {37, 99, 235},
                                                            4).title(
        "Original expression grammar: actual stack depth").x_label(
        "executed shift or reduce step").y_label("state-stack depth");
    plot.save_svg("build/slr_original.svg");
}
```
