int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");

    std::vector<double> x, y;
    std::print("\n| dividend degree | actual cancellations | actual coefficient updates | retained steps " "|\n| ---: | ---: | ---: | ---: |\n");
    for (int degree : {8, 16, 32, 64}) {
        a::GFPoly dividend(degree + 1, 1);
        auto t = a::poly_divmod_gf_trace(dividend, {1, 1, 1}, 7);
        x.push_back(degree);
        y.push_back(t.coefficient_updates);
        std::print("| {} | {} | {} | {} |\n", degree, t.steps.size(),
                   t.coefficient_updates, t.steps.size());
    }
    auto p = g::RPlot::create();
    p.lines(x, y, "actual coefficient subtractions", {16, 122, 87}).points(
        x, y, {16, 122, 87}, 5).title("Native long-division work on explicit all-one coefficient fixtures").x_label("input degree").y_label("actual working-coefficient updates");
    p.save_svg("build/polynomial_long_division_work.svg");
}
