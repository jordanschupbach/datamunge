> The retained original experiment

```{cpp, results="markdown", file="figures/polynomial_long_division_original.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <datamunge/plot/plot.hpp>
#include <datamunge/plot/diagram.hpp>
#include <datamunge/algorithms/modular_exponentiation.hpp>
#include <datamunge/algorithms/integer_arithmetic.hpp>
#include <filesystem>
#include <print>
#include <algorithm>
#include <cmath>
#include <limits>
#include <climits>
#include <datamunge/algorithms/number_theory.hpp>
#include <numeric>
#include <numbers>
#include <random>
#include <string>
#include <vector>
#include <map>
#include <set>
#include <array>
#include <tuple>
#include <datamunge/algorithms/prufer.hpp>
#include <datamunge/algorithms/flow_diagram.hpp>
#include <datamunge/algorithms/polynomial_gf.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");

    const a::GFPoly dividend{5, 4, 3, 2, 1}, divisor{1, 1, 1};
    auto t = a::poly_divmod_gf_trace(dividend, divisor, 7);
    std::print("Actual GF(7) result: q={}, r={}.\n", t.result.quotient,
               t.result.remainder);
    std::vector<double> x{0}, y{double(t.dividend.size()) - 1};
    std::print("\n| actual cancellation | working coefficients | actual degree (-1 means zero) |\n| ---: | " "--- | ---: |\n");
    std::print("| 0 | `{}` | {} |\n", t.dividend, int(t.dividend.size()) - 1);
    for (std::size_t i = 0; i < t.steps.size(); ++i) {
        x.push_back(i + 1);
        y.push_back(double(t.steps[i].after.size()) - 1);
        std::print("| {} | `{}` | {} |\n", i + 1, t.steps[i].after,
                   int(t.steps[i].after.size()) - 1);
    }
    auto p = g::RPlot::create();
    p.lines(x, y, "actual working degree", {37, 99, 235}).points(x, y,
                                                                 {37, 99, 235},
                                                                 5).abline_h(
        2, {100, 116, 139}).title("Original GF(7) division: actual degree drops below the divisor").x_label("actual cancellation count").y_label("actual polynomial degree");
    p.save_svg("build/polynomial_long_division_original.svg");
}
```
// result_begin: markdown
Actual GF(7) result: q=[1, 1, 1], r=[4, 2].

| actual cancellation | working coefficients | actual degree (-1 means zero) |
| ---: | --- | ---: |
| 0 | `[5, 4, 3, 2, 1]` | 4 |
| 1 | `[5, 4, 2, 1]` | 3 |
| 2 | `[5, 3, 1]` | 2 |
| 3 | `[4, 2]` | 1 |
\image(figures/polynomial_long_division_original.svg)
// result_end
