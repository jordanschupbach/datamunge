> Explicit controls

```{cpp, results="markdown", file="figures/polynomial_long_division_controls.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <datamunge/plot/plot.hpp>
#include <datamunge/plot/diagram.hpp>
#include <datamunge/algorithms/modular_exponentiation.hpp>
#include <datamunge/algorithms/integer_arithmetic.hpp>
#include <filesystem>
#include <print>
#include <algorithm>
#include <cmath>
#include <limits>
#include <climits>
#include <datamunge/algorithms/number_theory.hpp>
#include <numeric>
#include <numbers>
#include <random>
#include <string>
#include <vector>
#include <map>
#include <set>
#include <array>
#include <tuple>
#include <datamunge/algorithms/prufer.hpp>
#include <datamunge/algorithms/flow_diagram.hpp>
#include <datamunge/algorithms/polynomial_gf.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");

    std::vector<std::pair<a::GFPoly, a::GFPoly>> cases{{{}, {1, 1}},
                                                       {{3}, {1, 1}},
                                                       {{1, 0, 1}, {2, 2}},
                                                       {{-1, -2, 1}, {1, 1}}};
    std::vector<std::string> labels{"zero dividend", "degree below",
                                    "nonmonic divisor", "signed input"};
    std::vector<double> v;
    std::print("\n| fixture | actual quotient | actual remainder | actual steps |\n| --- | --- | --- | ---: " "|\n");
    for (std::size_t i = 0; i < cases.size(); ++i) {
        auto t = a::poly_divmod_gf_trace(cases[i].first, cases[i].second, 7);
        v.push_back(t.steps.size());
        std::print("| {} | `{}` | `{}` | {} |\n", labels[i], t.result.quotient,
                   t.result.remainder, t.steps.size());
    }
    bool zero = false, composite = false;
    try {
        a::poly_divmod_gf_trace({1}, {0}, 7);
    } catch (const std::invalid_argument &) {
        zero = true;
    }
    try {
        a::poly_divmod_gf_trace({1}, {1}, 8);
    } catch (const std::invalid_argument &) {
        composite = true;
    }
    std::print("Zero divisor rejected: {}; composite modulus rejected: {}.\n",
               zero, composite);
    auto p = g::RPlot::barplot(v, labels, "actual cancellations");
    p.title("Prime-field controls: normalization, short dividend and nonmonic inverse").y_label("actual native steps");
    p.save_svg("build/polynomial_long_division_controls.svg");
}
```
// result_begin: markdown
| fixture | actual quotient | actual remainder | actual steps |
| --- | --- | --- | ---: |
| zero dividend | `[]` | `[]` | 0 |
| degree below | `[]` | `[3]` | 0 |
| nonmonic divisor | `[3, 4]` | `[2]` | 2 |
| signed input | `[4, 1]` | `[2]` | 2 |
Zero divisor rejected: true; composite modulus rejected: true.
\image(figures/polynomial_long_division_controls.svg)
// result_end
\caption(Actual outcomes on controlled native inputs; errors, truncation and unresolved outcomes retain their stated meanings.)
