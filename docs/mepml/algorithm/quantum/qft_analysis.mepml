> Explicit controls

```{cpp, results="markdown", file="figures/qft_controls.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");

    auto zero = a::qft_run(a::qft_comb(4, 4, 0), 4);
    auto one = a::qft_run(a::qft_comb(4, 4, 1), 4);
    auto input = a::qft_comb(4, 3, 1);
    auto forward = a::qft_run(input, 4);
    auto reverse = a::qft_run(forward.state, 4, true);
    double maximum = 0;
    for (std::size_t i = 0; i < input.size(); ++i)
        maximum = std::max(maximum, std::abs(input[i] - reverse.state[i]));
    std::print("Actual nondividing-period3 inverse round-trip maximum complex error: {}.\n",
               maximum);
    std::vector<double> v{zero.state[4].real(), one.state[4].real(),
                          one.state[4].imag()};
    std::vector<std::string> labels{"offset 0 real at 4", "offset 1 real at 4",
                                    "offset 1 imaginary at 4"};
    std::print("\n| actual amplitude component | actual value |\n| --- | ---: |\n");
    for (std::size_t i = 0; i < v.size(); ++i)
        std::print("| {} | {} |\n", labels[i], v[i]);
    bool malformed = false;
    try {
        a::qft_run(a::QuantumState(3), 2);
    } catch (const std::invalid_argument &) {
        malformed = true;
    }
    std::print("Complete register-length guard: {}.\n", malformed);
    auto p = g::RPlot::barplot(v, labels, "actual complex component");
    p.title("Comb offsets preserve probabilities while changing actual Fourier phases").y_label("actual amplitude component");
    p.save_svg("build/qft_controls.svg");
}
```
