> The retained original experiment

```{cpp, results="markdown", file="figures/qft_original.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");

    auto input = a::qft_comb(4, 4, 1);
    auto t = a::qft_trace(input, 4);
    auto probabilities = a::probabilities(t.run.state);
    std::vector<std::string> labels;
    std::print("\n| basis frequency | actual final real part | actual final imaginary part | actual " "probability |\n| ---: | ---: | ---: | ---: |\n");
    for (std::size_t k = 0; k < probabilities.size(); ++k) {
        labels.push_back(probabilities[k] > 1e-9 ? std::to_string(k) : "");
        std::print("| {} | {} | {} | {} |\n", k, t.run.state[k].real(),
                   t.run.state[k].imag(), probabilities[k]);
    }
    auto p =
        g::RPlot::barplot(probabilities, labels, "actual squared amplitude",
                          {37, 99, 235});
    p.title("Original N=16 comb at 1,5,9,13: actual native Fourier probabilities").x_label("frequency basis k").y_label("actual probability");
    p.save_svg("build/qft_original.svg");
}
```
