> Actual selected work and sensitivity

```{cpp, results="markdown", file="figures/qft_work.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");

    std::vector<double> x, y;
    std::print("\n| qubits | actual retained output amplitudes | actual Hadamards | controlled phase calls " "| bit swaps |\n| ---: | ---: | ---: | ---: | ---: |\n");
    for (int n : {1, 2, 4, 6, 8, 10}) {
        auto r = a::qft_run(a::qft_comb(n, 2), n);
        x.push_back(n);
        y.push_back(r.state.size());
        std::print("| {} | {} | {} | {} | {} |\n", n, r.state.size(),
                   r.hadamards, r.phase_gates, r.swaps);
    }
    auto p = g::RPlot::create();
    p.lines(x, y, "actual output state amplitudes", {16, 122, 87}).points(
        x, y, {16, 122, 87}, 5).title("Classical native QFT simulation: actual amplitude storage grows exponentially").x_label("counting qubits").y_label("actual stored amplitudes");
    p.save_svg("build/qft_work.svg");
}
```
// result_begin: markdown
| qubits | actual retained output amplitudes | actual Hadamards | controlled phase calls | bit swaps |
| ---: | ---: | ---: | ---: | ---: |
