\alttext(Two curves on a log-two count axis compare oracle calls with the much larger number of classical mean-plus-diffusion amplitude visits as qubit count increases.)

> Degenerate sizes, validation and full-state ownership

Zero qubits represent a one-element state: the only possible answer is already
known, so the first-peak helper returns zero. The legacy schedule still applies
one global-phase iteration. One qubit has constant ideal success one half. Two
qubits expose the default stopping approximation particularly clearly. These
cases prevent deterministic argmax from being mistaken for probabilistic
success.

```{cpp, results="markdown", file="figures/grover_controls.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
    std::filesystem::create_directories("build");

    std::print("| qubits | target | legacy count | legacy argmax | legacy squared amplitude | explicit " "count | explicit argmax | explicit squared amplitude |\n| ---: | ---: | ---: | ---: | ---: " "| ---: | ---: | ---: |\n");
    std::vector<double> x, a, b;
    for (int n : {0, 1, 2, 8}) {
        const auto target = (std::size_t{1} << n) - 1;
        const auto old = dm::algorithms::grover(n, target);
        const int k = dm::algorithms::grover_first_peak_iterations(n);
        const auto r = dm::algorithms::grover_run(n, target, k);
        std::print("| {} | {} | {} | {} | {:.12f} | {} | {} | {:.12f} |\n", n,
                   target, old.iterations, old.measured, old.success_prob, k,
                   r.result.measured, r.result.success_prob);
        x.push_back(x.size() + 1);
        a.push_back(old.success_prob);
        b.push_back(r.result.success_prob);
    }
    bool quota = false, target = false, negative = false;
    try {
        (void) dm::algorithms::grover_trace(2, 3, 1, {4, 12});
    } catch (const std::length_error &) {
        quota = true;
    }
    const auto full = dm::algorithms::grover_trace(2, 3, 1, {4, 13});
    auto copy = full;
    copy.steps[0].after_oracle[0] = 99.;
    try {
        (void) dm::algorithms::grover_run(8, 256, 1, {1, 1});
    } catch (const std::invalid_argument &) {
        target = true;
    }
    try {
        (void) dm::algorithms::grover_success_trace(2, 3, -1);
    } catch (const std::invalid_argument &) {
        negative = true;
    }
    std::print("\nOne-short complete capture rejects: {}; exact cap retains {} complex values; invalid " "target rejected before state cap: {}; negative trace length rejected: {}; snapshots copy " "independently: {}.\n",
               quota, full.captured_entries, target, negative,
               full.steps[0].after_oracle[0].real() !=
               copy.steps[0].after_oracle[0].real());
    std::vector<double> left, right;
    for (double q : x) {
        left.push_back(q - .17);
        right.push_back(q + .17);
    }
    auto p = dm::graphics::RPlot::create();
    p.bars(left, a, "legacy schedule", {37, 99, 235}, .3).bars(
        right, b, "explicit first peak", {220, 38, 38}, .3).title(
        "A deterministic argmax is not a measurement sample").x_label(
        "case: 1 zero qubits; 2 one; 3 two; 4 eight").y_label(
        "actual target squared amplitude").y_limits(0, 1.3).save_svg(
        "build/grover_controls.svg");
    if (!quota || !target || !negative)
        throw std::runtime_error("complete domain/capture controls");
}
```
