> The retained original experiment

```{cpp, results="markdown", file="figures/simon_original.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <filesystem>
#include <print>
#include <algorithm>
#include <cmath>
#include <limits>
#include <numeric>
#include <numbers>
#include <random>
#include <string>
#include <vector>
#include <map>
#include <set>
#include <array>
#include <tuple>
#include <bit>
#include <datamunge/random/quality.hpp>
#include <datamunge/algorithms/simon.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    auto r = a::simon_run(4, 0b1011);
    std::vector<double> x, y;
    std::print("| y (integer) | actual marginal probability |\n| ---: | ---: |\n");
    for (std::size_t i = 0; i < r.probabilities.size(); ++i) {
        std::print("| {} | {} |\n", i, r.probabilities[i]);
        x.push_back(i);
        y.push_back(r.probabilities[i]);
    }
    std::print("\nOriginal hidden1011 recovered {}; nonzero support `{}`; rank {}.\n",
               r.result.recovered_period, r.result.observed_y, r.rank);
    auto plot = g::RPlot::create();
    plot.lines(x, y, "actual values", {37, 99, 235}).points(x, y, {37, 99, 235},
                                                            4).title(
        "Original period1011: actual marginal including zero").x_label(
        "input string as integer").y_label("actual probability");
    plot.save_svg("build/simon_original.svg");
}
```
