> Actual selected work and sensitivity

```{cpp, results="markdown", file="figures/simon_work.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <filesystem>
#include <print>
#include <algorithm>
#include <cmath>
#include <limits>
#include <numeric>
#include <numbers>
#include <random>
#include <string>
#include <vector>
#include <map>
#include <set>
#include <array>
#include <tuple>
#include <bit>
#include <datamunge/random/quality.hpp>
#include <datamunge/algorithms/simon.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    std::vector<double> x, y;
    std::print("| bits | actual amplitudes | H calls | oracle writes | row XORs | rank |\n| ---: | ---: | " "---: | ---: | ---: | ---: |\n");
    for (int n = 1; n <= 7; ++n) {
        auto r = a::simon_run(n, (std::size_t{1} << n) - 1);
        std::print("| {} | {} | {} | {} | {} | {} |\n", n, r.amplitudes,
                   r.hadamard_calls, r.oracle_writes, r.row_xors, r.rank);
        x.push_back(n);
        y.push_back(r.amplitudes);
    }
    auto plot = g::RPlot::create();
    plot.lines(x, y, "actual values", {37, 99, 235}).points(x, y, {37, 99, 235},
                                                            4).title(
        "Classical statevector storage grows as4^n").x_label("input bits").y_label("actual complex amplitudes");
    plot.save_svg("build/simon_work.svg");
}
```
