> Explicit controls

```{cpp, results="markdown", file="figures/simon_controls.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <filesystem>
#include <print>
#include <algorithm>
#include <cmath>
#include <limits>
#include <numeric>
#include <numbers>
#include <random>
#include <string>
#include <vector>
#include <map>
#include <set>
#include <array>
#include <tuple>
#include <bit>
#include <datamunge/random/quality.hpp>
#include <datamunge/algorithms/simon.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    std::vector<double> x, y;
    std::print("| n=3 hidden period | recovered | nonzero support | rank | P(0) |\n| ---: | ---: | --- | " "---: | ---: |\n");
    for (std::size_t period = 1; period < 8; ++period) {
        auto r = a::simon_run(3, period);
        std::print("| {} | {} | `{}` | {} | {} |\n", period,
                   r.result.recovered_period, r.result.observed_y, r.rank,
                   r.probabilities[0]);
        x.push_back(period);
        y.push_back(r.result.recovered_period);
    }
    auto plot = g::RPlot::create();
    plot.lines(x, y, "actual values", {37, 99, 235}).points(x, y, {37, 99, 235},
                                                            4).title(
        "Every nonzero three-bit promised period").x_label("hidden period").y_label("recovered period");
    plot.save_svg("build/simon_controls.svg");
}
```
