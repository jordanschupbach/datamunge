> Actual selected work

```{cpp, results="markdown", file="figures/phase_estimation_work.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <datamunge/plot/plot.hpp>
#include <datamunge/plot/diagram.hpp>
#include <datamunge/algorithms/modular_exponentiation.hpp>
#include <datamunge/algorithms/integer_arithmetic.hpp>
#include <filesystem>
#include <print>
#include <algorithm>
#include <cmath>
#include <limits>
#include <climits>
#include <datamunge/algorithms/number_theory.hpp>
#include <numeric>
#include <numbers>
#include <random>
#include <string>
#include <vector>
#include <datamunge/algorithms/phase_estimation.hpp>
int main() {
    std::filesystem::create_directories("build");

    std::vector<double> counts;
    std::vector<std::string> labels;
    std::print("\n| counting bits | actual retained final amplitudes | actual preparation Hadamards | actual " "kickback phase calls |\n| ---: | ---: | ---: | ---: |\n");
    for (int bits : {1, 2, 4, 6, 8, 10}) {
        auto t = dm::algorithms::phase_estimation_trace(bits, .3);
        counts.push_back(t.after_inverse_qft.size());
        labels.push_back(std::to_string(bits));
        std::print("| {} | {} | {} | {} |\n", bits, t.after_inverse_qft.size(),
                   t.hadamards, t.phase_gates);
    }
    auto p =
        dm::graphics::RPlot::barplot(counts, labels,
                                     "actual final amplitude count");
    p.title("Classical phase simulation: actual state storage grows exponentially").x_label("counting qubits").y_label("actual retained final amplitudes");
    p.save_svg("build/phase_estimation_work.svg");
}
```
