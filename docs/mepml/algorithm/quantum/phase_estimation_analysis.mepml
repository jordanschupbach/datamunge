> The retained original experiment

```{cpp, results="markdown", file="figures/phase_estimation_original.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <datamunge/plot/plot.hpp>
#include <datamunge/plot/diagram.hpp>
#include <datamunge/algorithms/modular_exponentiation.hpp>
#include <datamunge/algorithms/integer_arithmetic.hpp>
#include <filesystem>
#include <print>
#include <algorithm>
#include <cmath>
#include <limits>
#include <climits>
#include <datamunge/algorithms/number_theory.hpp>
#include <numeric>
#include <numbers>
#include <random>
#include <string>
#include <vector>
#include <datamunge/algorithms/phase_estimation.hpp>
int main() {
    std::filesystem::create_directories("build");

    auto exact = dm::algorithms::phase_estimation(3, .375);
    auto t = dm::algorithms::phase_estimation_trace(5, .3);
    std::print("\n| original phase | counting bits | actual modal index | estimate | actual modal probability " "|\n| ---: | ---: | ---: | ---: | ---: |\n| .375 | 3 | {} | {} | {} |\n| .3 | 5 | {} | {} | " "{} |\n",
               exact.measured, exact.estimate, exact.probability,
               t.result.measured, t.result.estimate, t.result.probability);
    std::vector<std::string> labels;
    std::print("\n| basis outcome | actual probability |\n| ---: | ---: |\n");
    for (std::size_t m = 0; m < t.distribution.size(); ++m) {
        labels.push_back(t.distribution[m] > .03 ? std::to_string(m) : "");
        std::print("| {} | {} |\n", m, t.distribution[m]);
    }
    auto p =
        dm::graphics::RPlot::barplot(t.distribution, labels,
                                     "actual final probability", {37, 99, 235});
    p.title("Original phase .3, five counting qubits: actual final distribution").x_label("basis integer m (phase estimate m/32)").y_label("actual squared amplitude");
    p.save_svg("build/phase_estimation_original.svg");
}
```
