> Explicit controls

```{cpp, results="markdown", file="figures/phase_estimation_controls.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <datamunge/plot/plot.hpp>
#include <datamunge/plot/diagram.hpp>
#include <datamunge/algorithms/modular_exponentiation.hpp>
#include <datamunge/algorithms/integer_arithmetic.hpp>
#include <filesystem>
#include <print>
#include <algorithm>
#include <cmath>
#include <limits>
#include <climits>
#include <datamunge/algorithms/number_theory.hpp>
#include <numeric>
#include <numbers>
#include <random>
#include <string>
#include <vector>
#include <datamunge/algorithms/phase_estimation.hpp>
int main() {
    std::filesystem::create_directories("build");

    struct Case {
        int bits;
        double phase;
        const char *name;
    };
    std::vector<Case> cases{{0, .3, "zero bits"}, {3, 0, "phase zero"},
                            {3, .375, "exact3/8"}, {5, .3, "nondyadic.3"},
                            {3, .99, "near wrap"}};
    std::vector<double> prob;
    std::vector<std::string> labels;
    std::print("\n| case | actual modal index | actual estimate | actual modal probability | circular phase " "error |\n| --- | ---: | ---: | ---: | ---: |\n");
    for (auto c : cases) {
        auto r = dm::algorithms::phase_estimation(c.bits, c.phase);
        prob.push_back(r.probability);
        labels.push_back(c.name);
        std::print("| {} | {} | {} | {} | {} |\n", c.name, r.measured,
                   r.estimate, r.probability,
                   std::abs(std::remainder(r.estimate - c.phase, 1.)));
    }
    auto p =
        dm::graphics::RPlot::barplot(prob, labels, "actual modal probability");
    p.title("Phase controls: a modal outcome is not a sampled measurement").y_label("actual modal probability");
    p.save_svg("build/phase_estimation_controls.svg");
}
```
