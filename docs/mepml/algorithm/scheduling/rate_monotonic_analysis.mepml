#include <datamunge/random/sampling_analysis.hpp>
#include <iomanip>
#include <datamunge/algorithms/qr_algorithm.hpp>
#include <datamunge/stats/lm.hpp>
#include <datamunge/algorithms/arithmetic_coding.hpp>
#include <datamunge/nn/rbf.hpp>
#include <datamunge/nn/model_plot.hpp>
#include <bit>
#include <datamunge/algorithms/realtime_scheduling.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");

    const std::vector<std::vector<a::RTTask>> cases{{{0, 2, 1}, {1, 4, 2}},
                                                    {{0, 2, 3}},
                                                    {{0, 3, 0}, {1, 5, 1}}};
    std::vector<std::string> labels{"harmonic U=1", "overload with backlog",
                                    "zero-work jobs"};
    std::vector<double> misses;
    std::print("\n| actual control, horizon12 | sufficient screen | actual releases | actual misses |\n| " "--- | --- | ---: | ---: |\n");
    for (std::size_t i = 0; i < cases.size(); ++i) {
        auto t = a::rt_trace(cases[i], 12, a::RTPolicy::rate_monotonic);
        misses.push_back(t.work.deadline_misses);
        std::print("| {} | {} | {} | {} |\n", labels[i],
                   a::rate_monotonic_schedulable(cases[i]),
                   t.work.jobs_released, t.work.deadline_misses);
    }
    auto p = g::RPlot::barplot(misses, labels, "actual deadline-missed jobs");
    p.title("A sufficient screen and actual deadline evidence differ").y_label(
        "actual missed jobs through12");
    p.save_svg("build/rate_monotonic_controls.svg");
}
```
