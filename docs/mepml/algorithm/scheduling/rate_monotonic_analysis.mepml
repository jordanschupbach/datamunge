#include <bit>
#include <datamunge/algorithms/realtime_scheduling.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");

    const std::vector<a::RTTask> tasks{{0, 4, 1}, {1, 6, 2}, {2, 8, 1}};
    std::vector<double> x, y, z;
    std::print("\n| horizon | actual ticks | actual release checks | actual released jobs | actual " "preemptions |\n| ---: | ---: | ---: | ---: | ---: |\n");
    for (int horizon : {0, 6, 12, 24, 48, 96}) {
        auto t =
            a::rt_simulate_work(tasks, horizon, a::RTPolicy::rate_monotonic);
        x.push_back(horizon);
        y.push_back(t.work.release_checks);
        z.push_back(t.work.jobs_released);
        std::print("| {} | {} | {} | {} | {} |\n", horizon, t.work.ticks,
                   t.work.release_checks, t.work.jobs_released,
                   t.work.preemptions);
    }
    auto p = g::RPlot::create();
    p.lines(x, y, "actual task release checks", {37, 99, 235}).lines(
        x, z, "actual released jobs", {234, 88, 12}).title(
        "Finite native simulation: actual selected scheduling work").x_label(
        "simulation horizon").y_label("actual selected events");
    p.save_svg("build/rate_monotonic_work.svg");
}
