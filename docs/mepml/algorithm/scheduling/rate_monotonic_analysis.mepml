#include <datamunge/algorithms/arithmetic_coding.hpp>
#include <datamunge/nn/rbf.hpp>
#include <datamunge/nn/model_plot.hpp>
#include <bit>
#include <datamunge/algorithms/realtime_scheduling.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");

    const std::vector<a::RTTask> tasks{{0, 4, 1}, {1, 6, 2}, {2, 8, 1}}, heavy{
        {0, 4, 1}, {1, 6, 2}, {2, 8, 2}
    };
    auto t = a::rt_trace(tasks, 24, a::RTPolicy::rate_monotonic);
    auto h = a::rt_trace(heavy, 24, a::RTPolicy::rate_monotonic);
    std::print("\n| original task set | actual utilization | sufficient RMS screen | actual misses " "through24 |\n| --- | ---: | --- | ---: |\n| original | {} | {} | {} |\n| heavier | {} | {} " "| {} |\n",
               a::rt_utilization(tasks), a::rate_monotonic_schedulable(tasks),
               t.work.deadline_misses, a::rt_utilization(heavy),
               a::rate_monotonic_schedulable(heavy), h.work.deadline_misses);
    std::print("Actual priority task ids: {}. Original bound: {}. Heavier EDF finite misses: {}.\n",
               a::rate_monotonic_priorities(tasks),
               a::rate_monotonic_bound(tasks.size()),
               a::rt_trace(heavy, 24, a::RTPolicy::earliest_deadline).work.deadline_misses);
    auto p = a::plot_rt_schedule(tasks, t.schedule);
    p.title("Original three periodic tasks: actual RMS timeline");
    p.save_svg("build/rate_monotonic_original.svg");
}
```
