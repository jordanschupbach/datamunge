> Actual selected work and sensitivity

```{cpp, results="markdown", file="figures/shortest_remaining_time_work.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <filesystem>
#include <print>
#include <algorithm>
#include <cmath>
#include <limits>
#include <numeric>
#include <numbers>
#include <random>
#include <string>
#include <vector>
#include <map>
#include <set>
#include <array>
#include <tuple>
#include <bit>
#include <datamunge/random/quality.hpp>
#include <datamunge/algorithms/shortest_first.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    std::vector<double> x, y;
    std::print("| second arrival | mean wait | dispatches | preemptions | scans |\n| ---: | ---: | ---: | " "---: | ---: |\n");
    for (int arrival : {0, 1, 2, 4, 8, 10}) {
        auto r = a::shortest_remaining_time_run({{0, 0, 10}, {1, arrival, 1}});
        std::print("| {} | {} | {} | {} | {} |\n", arrival,
                   r.schedule.avg_waiting, r.dispatches, r.preemptions, r.scans);
        x.push_back(arrival);
        y.push_back(r.schedule.avg_waiting);
    }
    auto plot = g::RPlot::create();
    plot.lines(x, y, "actual values", {37, 99, 235}).points(x, y, {37, 99, 235},
                                                            4).title(
        "Arrival sensitivity with zero switch cost").x_label("short-job arrival").y_label("mean wait");
    plot.save_svg("build/shortest_remaining_time_work.svg");
}
```
