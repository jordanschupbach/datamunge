> The retained original experiment

```{cpp, results="markdown", file="figures/shortest_remaining_time_original.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <filesystem>
#include <print>
#include <algorithm>
#include <cmath>
#include <limits>
#include <numeric>
#include <numbers>
#include <random>
#include <string>
#include <vector>
#include <map>
#include <set>
#include <array>
#include <tuple>
#include <bit>
#include <datamunge/random/quality.hpp>
#include <datamunge/algorithms/shortest_first.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    auto r =
        a::shortest_remaining_time_trace({{0, 0, 8}, {1, 1, 4}, {2, 2, 9},
                                          {3, 3, 5}});
    std::print("| id | completion | turnaround | wait |\n| ---: | ---: | ---: | ---: |\n");
    for (const auto &m : r.schedule.metrics)
        std::print("| {} | {} | {} | {} |\n", m.id, m.completion, m.turnaround,
                   m.waiting);
    auto plot = g::RPlot::create();
    for (const auto &s : r.schedule.gantt)
        plot.lines({double(s.start), double(s.end)},
                   {double(s.id), double(s.id)}, "ID " + std::to_string(s.id),
                   {37, 99, 235}, 8);
    plot.title("Original SRT workload: actual merged execution").x_label(
        "time").y_label("process ID").y_limits(-1, 4);
    plot.save_svg("build/shortest_remaining_time_original.svg");
}
```
