> Explicit controls

```{cpp, results="markdown", file="figures/shortest_remaining_time_controls.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <filesystem>
#include <print>
#include <algorithm>
#include <cmath>
#include <limits>
#include <numeric>
#include <numbers>
#include <random>
#include <string>
#include <vector>
#include <map>
#include <set>
#include <array>
#include <tuple>
#include <bit>
#include <datamunge/random/quality.hpp>
#include <datamunge/algorithms/shortest_first.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    const std::vector<std::vector<a::SchedProcess>> cases{
        {}, {{99, 1000000, 2}}, {{9, 0, 2}, {4, 0, 2}}, {{0, 0, 10}, {1, 1, 1}},
        {{7, 0, 4}, {8, 1, 1}, {9, 2, 1}}
    };
    std::vector<double> x, y;
    std::print("| control | mean wait | scans | preemptions | first id |\n| ---: | ---: | ---: | ---: | --- " "|\n");
    for (std::size_t i = 0; i < cases.size(); ++i) {
        auto r = a::shortest_remaining_time_run(cases[i]);
        std::print("| {} | {} | {} | {} | {} |\n", i, r.schedule.avg_waiting,
                   r.scans, r.preemptions,
                   r.schedule.gantt.empty() ? "empty"
                   : std::to_string(r.schedule.gantt.front().id));
        x.push_back(i);
        y.push_back(r.schedule.avg_waiting);
    }
    auto plot = g::RPlot::create();
    plot.lines(x, y, "actual values", {37, 99, 235}).points(x, y, {37, 99, 235},
                                                            4).title(
        "Idle jumps, stable ties and staggered arrivals").x_label(
        "control index").y_label("mean wait");
    plot.save_svg("build/shortest_remaining_time_controls.svg");
}
```
