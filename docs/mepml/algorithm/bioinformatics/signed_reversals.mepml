> The retained original experiment

```{cpp, results="markdown", file="figures/signed_reversals_original.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    auto r = a::signed_reversal_trace({3, 1, 2, -5, 4});
    std::vector<double> x, y;
    std::print("| actual path index | selected reversal | actual state | breakpoints |\n| ---: | --- | --- " "| ---: |\n");
    for (std::size_t i = 0; i < r.path.size(); ++i) {
        const auto &s = r.path[i];
        std::print("| {} | [{},{}] | `{}` | {} |\n", i, s.reversal.first,
                   s.reversal.second, s.permutation, s.breakpoints);
        x.push_back(i);
        y.push_back(s.breakpoints);
    }
    std::print("\nExact distance {}; actual states {}; generated edges {}. Root reversal [-1,-1] is a " "marker.\n",
               r.result.distance, r.states, r.generated);
    auto plot = g::RPlot::create();
    plot.lines(x, y, "actual values", {37, 99, 235}).points(x, y, {37, 99, 235},
                                                            4).title(
        "Original five-gene path: actual breakpoints").x_label(
        "selected path index").y_label("framed breakpoints");
    plot.save_svg("build/signed_reversals_original.svg");
}
```
// result_begin: markdown
| actual path index | selected reversal | actual state | breakpoints |
| ---: | --- | --- | ---: |
