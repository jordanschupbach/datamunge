> Actual selected work and sensitivity

```{cpp, results="markdown", file="figures/signed_reversals_work.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    auto r = a::signed_reversal_run({3, 1, 2, -5, 4});
    std::vector<double> x, y;
    std::print("| actual expansion depth | expanded | generated neighbors | newly discovered |\n| ---: | " "---: | ---: | ---: |\n");
    for (const auto &s : r.layers) {
        std::print("| {} | {} | {} | {} |\n", s.depth, s.expanded, s.generated,
                   s.discovered);
        x.push_back(s.depth);
        y.push_back(s.generated);
    }
    auto plot = g::RPlot::create();
    plot.lines(x, y, "actual values", {37, 99, 235}).points(x, y, {37, 99, 235},
                                                            4).title(
        "Original BFS: actual work before first target").x_label(
        "expansion depth").y_label("generated reversal neighbors");
    plot.save_svg("build/signed_reversals_work.svg");
}
```
