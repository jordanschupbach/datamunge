> Explicit controls

```{cpp, results="markdown", file="figures/signed_reversals_controls.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    const std::vector<std::vector<int>> cases{{}, {1, 2, 3}, {-2, -1},
                                              {-1, -2, -3}, {3, 1, 2}};
    std::vector<double> x, y;
    std::print("| control | state | exact distance | ceil(B/2) | visited states |\n| ---: | --- | ---: | " "---: | ---: |\n");
    for (std::size_t i = 0; i < cases.size(); ++i) {
        auto r = a::signed_reversal_run(cases[i]);
        std::print("| {} | `{}` | {} | {} | {} |\n", i, cases[i],
                   r.result.distance, (a::signed_breakpoints(cases[i]) + 1) / 2,
                   r.states);
        x.push_back(i);
        y.push_back(r.result.distance);
    }
    auto plot = g::RPlot::create();
    plot.lines(x, y, "actual values", {37, 99, 235}).points(x, y, {37, 99, 235},
                                                            4).title(
        "Exact identity and orientation controls").x_label("control index").y_label("minimum reversals");
    plot.save_svg("build/signed_reversals_controls.svg");
}
```
