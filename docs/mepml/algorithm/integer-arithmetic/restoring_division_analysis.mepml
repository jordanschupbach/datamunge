> The retained original experiment

```{cpp, results="markdown", file="figures/restoring_division_original.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <datamunge/plot/plot.hpp>
#include <datamunge/plot/diagram.hpp>
#include <datamunge/algorithms/modular_exponentiation.hpp>
#include <datamunge/algorithms/integer_arithmetic.hpp>
#include <filesystem>
#include <print>
#include <algorithm>
#include <cmath>
#include <limits>
#include <climits>
#include <datamunge/algorithms/number_theory.hpp>
#include <numeric>
#include <numbers>
#include <random>
#include <string>
#include <vector>
#include <map>
#include <set>
#include <array>
#include <tuple>
#include <datamunge/algorithms/prufer.hpp>
#include <datamunge/algorithms/flow_diagram.hpp>
#include <datamunge/geometry/hull_algorithms.hpp>
#include <datamunge/random/sampling_analysis.hpp>
#include <iomanip>
#include <datamunge/algorithms/qr_algorithm.hpp>
#include <datamunge/stats/lm.hpp>
#include <datamunge/algorithms/arithmetic_coding.hpp>
#include <datamunge/nn/rbf.hpp>
#include <datamunge/nn/model_plot.hpp>
#include <bit>
#include <datamunge/algorithms/division.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");

    std::print("\n| original dividend | original divisor | actual quotient | actual remainder | actual bit " "steps |\n| ---: | ---: | ---: | ---: | ---: |\n");
    for (auto[n, d] : std::vector<std::pair<std::uint64_t, std::uint64_t>>{
         {217, 13}, {100, 7}, {1000000, 999}
     }) {
        auto t = a::restoring_division_trace(n, d);
        std::print("| {} | {} | {} | {} | {} |\n", n, d,
                   t.analysis.result.quotient, t.analysis.result.remainder,
                   t.analysis.bit_steps);
    }
    auto t = a::restoring_division_trace(217, 13);
    std::vector<double> x, y, z;
    for (std::size_t i = 56; i < t.steps.size(); ++i) {
        x.push_back(t.steps[i].bit);
        y.push_back(t.steps[i].shifted);
        z.push_back(t.steps[i].remainder_after);
    }
    auto p = g::RPlot::create();
    p.lines(x, y, "actual shifted remainder", {234, 88, 12}).lines(
        x, z, "actual retained remainder", {37, 99, 235}).points(x, z,
                                                                 {37, 99, 235},
                                                                 5).title(
        "217 / 13: last eight of 64 actual register steps").x_label(
        "actual original dividend bit (execution runs 7 down to 0)").y_label(
        "actual unsigned remainder register");
    p.save_svg("build/restoring_division_original.svg");
}
