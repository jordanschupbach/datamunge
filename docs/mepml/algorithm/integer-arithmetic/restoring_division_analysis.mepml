#include <tuple>
#include <datamunge/algorithms/prufer.hpp>
#include <datamunge/algorithms/flow_diagram.hpp>
#include <datamunge/geometry/hull_algorithms.hpp>
#include <datamunge/random/sampling_analysis.hpp>
#include <iomanip>
#include <datamunge/algorithms/qr_algorithm.hpp>
#include <datamunge/stats/lm.hpp>
#include <datamunge/algorithms/arithmetic_coding.hpp>
#include <datamunge/nn/rbf.hpp>
#include <datamunge/nn/model_plot.hpp>
#include <bit>
#include <datamunge/algorithms/division.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");

    const auto maximum = std::numeric_limits<std::uint64_t>::max();
    std::vector<std::pair<std::uint64_t, std::uint64_t>> cases{
        {0, 7}, {maximum, 1}, {maximum, maximum}, {217, 0}
    };
    std::vector<std::string> labels{"zero dividend", "full word / 1",
                                    "equal full words", "zero-divisor sentinel"};
    std::vector<double> counts;
    std::print("\n| actual control | valid divisor | quotient | remainder | actual bit steps |\n| --- | --- " "| ---: | ---: | ---: |\n");
    for (std::size_t i = 0; i < cases.size(); ++i) {
        auto r = a::restoring_division_analyze(cases[i].first, cases[i].second);
        counts.push_back(r.bit_steps);
        std::print("| {} | {} | {} | {} | {} |\n", labels[i], r.valid_divisor,
                   r.result.quotient, r.result.remainder, r.bit_steps);
    }
    auto p = g::RPlot::barplot(counts, labels, "actual register steps");
    p.title("Full-width exact arithmetic and explicit invalid-divisor sentinel").y_label("actual bit steps");
    p.save_svg("build/restoring_division_controls.svg");
}
