#include <datamunge/nn/rbf.hpp>
#include <datamunge/nn/model_plot.hpp>
#include <bit>
#include <datamunge/algorithms/division.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");

    auto t = a::restoring_division_trace(217, 13);
    const auto &s = t.steps[t.steps.size() - 5];
    std::print("\n| actual bit | actual remainder before | shifted remainder | actual subtract | actual " "remainder after | actual quotient after |\n| ---: | ---: | ---: | --- | ---: | ---: |\n");
    for (const auto &e : t.steps)
        std::print("| {} | {} | {} | {} | {} | {} |\n", e.bit,
                   e.remainder_before, e.shifted, e.subtracted,
                   e.remainder_after, e.quotient_after);

    g::Diagram d;
    d.node("n0", {0, 0},
           std::format("Actual selected bit / shifted remainder\n{} / {}",
                       s.bit, s.shifted));
    d.node("n1", {10, 0},
           std::format("Actual comparison / subtraction\n{}", s.subtracted));
    d.node("n2", {20, 0},
           std::format("Actual exact quotient / remainder\n{} / {}",
                       t.analysis.result.quotient, t.analysis.result.remainder));
    d.edge("n0", "n1").edge("n1", "n2");
    d.save_svg("build/restoring_division_tiny.svg");
}
