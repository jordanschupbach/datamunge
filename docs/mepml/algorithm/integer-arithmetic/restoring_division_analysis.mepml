int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");

    std::vector<double> x, y, z;
    std::print("\n| divisor for N=217 | actual comparisons | actual subtractions | actual additions | " "hypothetical trial restores |\n| ---: | ---: | ---: | ---: | ---: |\n");
    for (std::uint64_t d : {1, 2, 3, 7, 13, 31, 127, 255}) {
        auto r = a::restoring_division_analyze(217, d);
        x.push_back(d);
        y.push_back(r.subtractions);
        z.push_back(r.additions);
        std::print("| {} | {} | {} | {} | {} |\n", d, r.comparison_tests,
                   r.subtractions, r.additions, r.hypothetical_restores);
    }
    auto p = g::RPlot::create();
    p.lines(x, y, "actual conditional subtractions", {37, 99, 235}).lines(
        x, z, "actual additions (zero)", {234, 88, 12}).points(x, y,
                                                               {37, 99, 235}, 5).title("Comparison-first division executes no restoration additions").x_label("nonzero divisor").y_label("actual selected arithmetic updates");
    p.save_svg("build/restoring_division_work.svg");
}
