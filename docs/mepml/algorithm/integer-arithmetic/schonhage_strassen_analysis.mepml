> The retained original experiment

```{cpp, results="markdown", file="figures/schonhage_strassen_original.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <filesystem>
#include <print>
#include <algorithm>
#include <cmath>
#include <limits>
#include <numeric>
#include <numbers>
#include <random>
#include <string>
#include <vector>
#include <map>
#include <set>
#include <array>
#include <tuple>
#include <bit>
#include <datamunge/algorithms/ntt_multiplication.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    const std::string left =
        "12345678901234567890123456789012345678901234567890", right =
        "98765432109876543210987654321098765432109876543210";
    auto r = a::ntt_multiply_trace(left, right);
    auto repunit = a::ntt_multiply_run("11111111111", "11111111111");
    std::print("Original 50-digit operands product: {}.\n\nOriginal 11-digit repunit squared: {}.\n\nActual " "transform length {}, butterflies {}, modular products {}.\n\n| coefficient position | " "actual recovered coefficient |\n| ---: | ---: |\n",
               r.product, repunit.product, r.transform_size, r.butterflies,
               r.modular_products);
    std::vector<double> x, y;
    for (std::size_t i = 0; i < r.coefficients.size(); ++i) {
        std::print("| {} | {} |\n", i, r.coefficients[i]);
        x.push_back(i);
        y.push_back(r.coefficients[i]);
    }
    auto plot = g::RPlot::create();
    plot.lines(x, y, "actual values", {37, 99, 235}).points(x, y, {37, 99, 235},
                                                            5).title(
        "Original decimal product: actual integer convolution").x_label(
        "little-endian coefficient index").y_label("coefficient");
    plot.save_svg("build/schonhage_strassen_original.svg");
}
```
