> Explicit controls

```{cpp, results="markdown", file="figures/schonhage_strassen_controls.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <filesystem>
#include <print>
#include <algorithm>
#include <cmath>
#include <limits>
#include <numeric>
#include <numbers>
#include <random>
#include <string>
#include <vector>
#include <map>
#include <set>
#include <array>
#include <tuple>
#include <bit>
#include <datamunge/algorithms/ntt_multiplication.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    std::vector<double> x, y;
    std::print("| left | right | actual product | actual butterflies |\n| --- | --- | --- | ---: |\n");
    std::vector<std::pair<std::string, std::string>> controls{{"0", "999"},
                                                              {"00012", "0034"},
                                                              {"9", "9"},
                                                              {"9999", "9999"}};
    for (std::size_t i = 0; i < controls.size(); ++i) {
        const auto & [l, r] = controls[i];
        auto p = a::ntt_multiply_run(l, r);
        std::print("| {} | {} | {} | {} |\n", l, r, p.product, p.butterflies);
        x.push_back(i);
        y.push_back(p.butterflies);
    }
    bool invalid = false, cap = false;
    try {
        a::ntt_mul("0", "bad");
    } catch (const std::invalid_argument &) {
        invalid = true;
    }
    try {
        a::NTTMultiplicationOptions o;
        o.max_transform_size = 2;
        a::ntt_multiply_run("12", "34", o);
    } catch (const std::length_error &) {
        cap = true;
    }
    std::print("Invalid second operand checked before zero shortcut {}; transform policy rejection {}.\n",
               invalid, cap);
    if (!invalid || !cap)
        return 1;
    auto plot = g::RPlot::create();
    plot.lines(x, y, "actual values", {37, 99, 235}).points(x, y, {37, 99, 235},
                                                            5).title(
        "Leading zeros, zero shortcut and carry controls").x_label("control").y_label("actual butterflies");
    plot.save_svg("build/schonhage_strassen_controls.svg");
}
```
