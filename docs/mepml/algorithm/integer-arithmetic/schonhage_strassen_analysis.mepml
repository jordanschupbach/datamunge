```{cpp, results="markdown", file="figures/schonhage_strassen_work.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <filesystem>
#include <print>
#include <algorithm>
#include <cmath>
#include <limits>
#include <numeric>
#include <numbers>
#include <random>
#include <string>
#include <vector>
#include <map>
#include <set>
#include <array>
#include <tuple>
#include <bit>
#include <datamunge/algorithms/ntt_multiplication.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    std::vector<double> x, y;
    std::print("| decimal digits each | actual padded N | actual butterflies | actual modular products | " "actual root products |\n| ---: | ---: | ---: | ---: | ---: |\n");
    for (std::size_t n : {4, 8, 16, 32, 64, 128, 256, 512}) {
        auto r = a::ntt_multiply_run(std::string(n, '9'), std::string(n, '9'));
        std::print("| {} | {} | {} | {} | {} |\n", n, r.transform_size,
                   r.butterflies, r.modular_products, r.root_products);
        x.push_back(n);
        y.push_back(r.butterflies);
    }
    auto plot = g::RPlot::create();
    plot.lines(x, y, "actual values", {37, 99, 235}).points(x, y, {37, 99, 235},
                                                            5).title(
        "Actual finite-field transform work").x_label("decimal digits each").y_label("actual butterflies");
    plot.save_svg("build/schonhage_strassen_work.svg");
}
```
