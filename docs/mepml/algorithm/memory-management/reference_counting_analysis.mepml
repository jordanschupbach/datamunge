> Explicit controls

```{cpp, results="markdown", file="figures/reference_counting_controls.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");

    const std::vector<a::ObjectGraph> cases{{1, {{0}}, {}, {}},
                                            {3, {{1}, {0, 2}, {}}, {}, {}},
                                            {2, {{1}, {0}}, {0}, {}},
                                            {2, {{1, 1}, {}}, {}, {}},
                                            a::reference_count_chain(3)};
    const std::vector<std::string> labels{"unrooted self-cycle",
                                          "cycle-held tail", "rooted cycle",
                                          "duplicate fields", "unrooted chain"};
    std::vector<double> leaks;
    std::print("\n| actual control | actual free order | actual leaked ids | actual decrements |\n| --- | " "--- | --- | ---: |\n");
    for (std::size_t i = 0; i < cases.size(); ++i) {
        auto r = a::reference_counting_run(cases[i]);
        leaks.push_back(r.result.leaked.size());
        std::print("| {} | `{}` | `{}` | {} |\n", labels[i], r.freed_order,
                   r.result.leaked, r.decrements);
    }
    auto p =
        g::RPlot::barplot(leaks, labels,
                          "actual unreachable unreclaimed objects");
    p.title("A cycle can retain noncyclic descendants too").y_label(
        "actual leaked object count");
    p.save_svg("build/reference_counting_controls.svg");
}
```
