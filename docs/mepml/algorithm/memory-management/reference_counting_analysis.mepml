> Actual selected work and sensitivity

```{cpp, results="markdown", file="figures/reference_counting_work.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");

    std::vector<double> x, y, z;
    std::print("\n| chain objects | actual unrooted selected operations | actual rooted selected operations " "| actual unrooted frees |\n| ---: | ---: | ---: | ---: |\n");
    for (std::size_t n : {1, 2, 4, 8, 16, 32, 64}) {
        auto unrooted = a::reference_counting_run(a::reference_count_chain(n));
        auto rooted =
            a::reference_counting_run(a::reference_count_chain(n, true));
        x.push_back(n);
        y.push_back(unrooted.operations);
        z.push_back(rooted.operations);
        std::print("| {} | {} | {} | {} |\n", n, unrooted.operations,
                   rooted.operations, unrooted.freed_order.size());
    }
    auto p = g::RPlot::create();
    p.lines(x, y, "actual unrooted cascade selected work", {37, 99, 235}).lines(
        x, z, "actual rooted selected work", {234, 88, 12}).title(
        "Actual count/cascade work on native reference chains").x_label(
        "objects in the controlled chain").y_label("actual selected events");
    p.save_svg("build/reference_counting_work.svg");
}
```
