> The retained original experiment

```{cpp, results="markdown", file="figures/reference_counting_original.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");

    const a::ObjectGraph graph{8, {{1}, {2}, {}, {4}, {3}, {}, {7}, {}}, {0}, {}};
    auto t = a::reference_counting_trace(graph);
    std::vector<double> live_x, live_y, free_x, free_y, leak_x, leak_y;
    std::print("\n| original object | actual initial count | actual final count | reclaimed | unreachable " "unreclaimed |\n| ---: | ---: | ---: | --- | --- |\n");
    for (int i = 0; i < graph.num_objects; ++i) {
        const bool leaked =
            std::find(t.result.leaked.begin(), t.result.leaked.end(), i) !=
            t.result.leaked.end();
        std::print("| {} | {} | {} | {} | {} |\n", i, t.result.refcount[i],
                   t.final_counts[i], bool(t.result.freed[i]), leaked);
        if (t.result.freed[i]) {
            free_x.push_back(i);
            free_y.push_back(t.result.refcount[i]);
        } else if (leaked) {
            leak_x.push_back(i);
            leak_y.push_back(t.result.refcount[i]);
        } else {
            live_x.push_back(i);
            live_y.push_back(t.result.refcount[i]);
        }
    }
    std::print("Actual reclamation order: {}. Actual leaked ids: {}.\n",
               t.freed_order, t.result.leaked);
    auto p = g::RPlot::create();
    p.points(live_x, live_y, "actual reachable survivors", {22, 163, 74}, 7).points(free_x, free_y, "actual reclaimed objects", {37, 99, 235}, 7).points(leak_x, leak_y, "actual unreachable unreclaimed objects", {220, 38, 38}, 7).title("Original eight-object heap: actual counts and outcomes").x_label("original object id").y_label("actual initial incoming references");
    p.save_svg("build/reference_counting_original.svg");
}
```
