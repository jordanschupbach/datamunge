> Checking the theory and controls

```{cpp, results="markdown", file="figures/union_merge_controls.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    std::vector<double> x, y;
    std::print("| runs | actual union | pops |\n|---|---|---:|\n");
    int i = 0;
    for (auto lists : std::vector<std::vector<std::vector<int>> >{
         {}, {{}}, {{1, 1}, {1}}, {{-2, 0}, {-2, 3}}
     }) {
        auto r = a::k_way_merge_analyze(lists, true);
        std::print("|`{}`|`{}`|{}|\n", lists, r.values, r.work.pops);
        x.push_back(i++);
        y.push_back(r.work.emitted);
    }
    auto p = g::RPlot::create();
    p.line(x, y, "actual", {37, 99, 235}, 2);
    p.points(x, y, "", {37, 99, 235}, 5);
    p.title("Empty runs, duplicates and negative-key controls").x_label(
        "control index").y_label("actual emitted values");
    p.save_svg("build/union_merge_controls.svg");
}
```
// result_begin: markdown
| runs | actual union | pops |
|---|---|---:|
|`[]`|`[]`|0|
|`[[]]`|`[]`|0|
|`[[1, 1], [1]]`|`[1]`|3|
|`[[-2, 0], [-2, 3]]`|`[-2, 0, 3]`|4|
\image(figures/union_merge_controls.svg)
