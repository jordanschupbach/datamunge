> The retained original experiment

```{cpp, results="markdown", file="figures/union_merge_original.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    auto r =
        a::k_way_merge_analyze({{1, 2, 2, 3, 5}, {2, 3, 4, 5}, {3, 5, 5, 6}},
                               true);
    std::print("| input keys | actual union | emitted | duplicates discarded " "|\n|---:|---|---:|---:|\n|{}|`{}`|{}|{}|\n",
               r.work.input_values, r.values, r.work.emitted,
               r.work.discarded_duplicates);
    auto p =
        g::RPlot::barplot({double(r.work.input_values), double(r.work.emitted),
                           double(r.work.discarded_duplicates)},
                          {"input", "emitted", "discarded"}, "actual counts",
                          {5, 150, 105});
    p.title("Original three overlapping lists: actual decisions").y_label(
        "keys");
    p.save_svg("build/union_merge_original.svg");
}
```
