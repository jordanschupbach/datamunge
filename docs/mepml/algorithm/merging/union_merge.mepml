> Sensitivity and selected work

```{cpp, results="markdown", file="figures/union_merge_work.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    std::vector<double> x, y;
    std::print("| range | input | actual distinct | pops | comparator calls " "|\n|---:|---:|---:|---:|---:|\n");
    for (int range = 200; range >= 20; range -= 20) {
        auto lists = a::union_overlap_lists(range);
        auto r = a::k_way_merge_analyze(lists, true);
        std::print("|{}|{}|{}|{}|{}|\n", range, r.work.input_values,
                   r.values.size(), r.work.pops, r.work.node_comparisons);
        x.push_back(range);
        y.push_back(r.values.size());
    }
    auto p = g::RPlot::create();
    p.line(x, y, "actual", {37, 99, 235}, 2);
    p.points(x, y, "", {37, 99, 235}, 5);
    p.title("Original five100-key runs: explicit unsigned LCG arithmetic").x_label("value range").y_label("actual distinct output keys");
    p.save_svg("build/union_merge_work.svg");
}
```
