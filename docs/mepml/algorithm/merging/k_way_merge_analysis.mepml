> Deduplication changes output, not input work

The same runs with duplicates are processed once in ordinary mode and once in
union mode. Both perform N pushes and N pops. Union mode records which actual
pop is discarded, while empty rows never occupy the queue. This is a complete
separate mode experiment rather than replaying a prefix.

```{cpp, results="markdown", file="figures/k_way_merge_union.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <datamunge/algorithms/merge.hpp>
#include <datamunge/plot/plot.hpp>
#include <filesystem>
#include <print>
int main() {
    std::filesystem::create_directories("build");
    const std::vector<std::vector<int>> runs = {{1, 1, 4}, {1, 2}, {}, {2, 4, 4}};
    std::print("| mode | original values | pushes | pops | emitted | discarded duplicates | peak fronts " "|\n| --- | ---: | ---: | ---: | ---: | ---: | ---: |\n");
    std::vector<double> x, y;
    for (bool unique : {false, true}) {
        const auto t = dm::algorithms::k_way_merge_trace(runs, unique);
        std::print("| {} | {} | {} | {} | {} | {} | {} |\n",
                   unique ? "union" : "ordinary", t.work.input_values,
                   t.work.pushes, t.work.pops, t.work.emitted,
                   t.work.discarded_duplicates, t.work.peak_heap);
        if (unique) {
            std::size_t pop = 0;
            for (const auto &e : t.steps)
                if (e.kind == dm::algorithms::MergeHeapKind::Pop) {
                    x.push_back(pop++);
            y.push_back(e.emitted ? 1 : 0);
                }
        }
    }
    std::print("\n| empty outer result size | all-empty result size |\n| ---: | ---: |\n| {} | {} |\n",
               dm::algorithms::k_way_merge({}).size(),
               dm::algorithms::union_merge({{}, {}}).size());
    auto p = dm::graphics::RPlot::create();
    p.points(x, y, "emitted", {37, 99, 235}, 5).y_limits(-.25, 1.5).title(
        "Actual union-pop emission decisions").x_label("actual pop ordinal").y_label("1 emitted, 0 discarded duplicate").save_svg("build/k_way_merge_union.svg");
}
```
