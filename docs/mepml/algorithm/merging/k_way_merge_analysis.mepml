> The original three sorted runs

Retain(1,4,7,10),(2,3,11),(5,6,8,9,12). The native trace identifies every
original source of the twelve output values. The original two-way merge of the
first two runs is also retained, with multiplicity and first-run ties preserved.

```{cpp, results="markdown", file="figures/k_way_merge_original.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <datamunge/algorithms/merge.hpp>
#include <datamunge/plot/plot.hpp>
#include <filesystem>
#include <print>
int main() {
    std::filesystem::create_directories("build");
    const std::vector<std::vector<int>> runs = {{1, 4, 7, 10}, {2, 3, 11},
                                                {5, 6, 8, 9, 12}};
    const auto t = dm::algorithms::k_way_merge_trace(runs);
    std::vector<double> x, y;
    std::print("| actual output ordinal | value | original run | original index |\n| ---: | ---: | ---: | " "---: |\n");
    for (const auto &e : t.steps)
        if (e.kind == dm::algorithms::MergeHeapKind::Pop) {
            std::print("| {} | {} | {} | {} |\n", x.size(), e.value, e.list,
                       e.index);
    x.push_back(x.size());
    y.push_back(e.value);
        }
        std::print("\n| original first-two output ordinal | value |\n| ---: | ---: |\n");
        const auto two = dm::algorithms::simple_merge(runs[0], runs[1]);
        for (std::size_t i = 0; i < two.size(); ++i)
            std::print("| {} | {} |\n", i, two[i]);
        std::print("\nActual pushes {}; pops {}; tuple comparator calls {}; peak fronts {}.\n",
                   t.work.pushes, t.work.pops, t.work.node_comparisons,
                   t.work.peak_heap);
        auto p = dm::graphics::RPlot::create();
        p.line(x, y, "output", {37, 99, 235}, 2).points(x, y, "", {37, 99, 235},
                                                        4).title(
            "Original runs: actual globally sorted output").x_label(
            "actual output ordinal").y_label("original int value").save_svg(
            "build/k_way_merge_original.svg");
}
```
