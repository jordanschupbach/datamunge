> Actual selected work and sensitivity

```{cpp, results="markdown", file="figures/ruzzo_tompa_work.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    std::vector<double> x, y;
    std::print("| positive seeds m | actual input values | actual predecessor comparisons | actual absorbed " "| final intervals |\n| ---: | ---: | ---: | ---: | ---: |\n");
    for (std::size_t m : {1, 4, 16, 64, 256, 1024}) {
        auto t = a::ruzzo_tompa_run(a::ruzzo_alternating_scores(m));
        std::print("| {} | {} | {} | {} | {} |\n", m, t.values, t.comparisons,
                   t.absorbed, t.segments.size());
        x.push_back(m);
        y.push_back(t.comparisons);
    }
    auto p = g::RPlot::create();
    p.lines(x, y, "actual direct predecessor tests", {37, 99, 235}).points(
        x, y, {37, 99, 235}, 5).title("Actual predecessor scan has a quadratic worst-case family").x_label("positive singleton seeds m").y_label("actual m(m-1)/2 comparisons");
    p.save_svg("build/ruzzo_tompa_work.svg");
}
