> The retained original experiment

```{cpp, results="markdown", file="figures/ruzzo_tompa_original.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    const std::vector<double> scores{3, -2, 5, -6, 4, -1, 2, -8, 7};
    auto t = a::ruzzo_tompa_trace(scores);
    std::print("Original scores: {}.\n\n| actual final begin | actual final end | actual score |\n| ---: | " "---: | ---: |\n",
               scores);
    auto p = g::RPlot::create();
    std::vector<double> x;
    for (std::size_t i = 0; i < scores.size(); ++i)
        x.push_back(i);
    p.bars(x, scores, "original per-position scores", {148, 163, 184}, .8);
    bool first_interval = true;
    for (const auto &s : t.segments) {
        std::print("| {} | {} | {} |\n", s.begin, s.end, s.score);
        p.lines({double(s.begin) - .4, double(s.end) - .6}, {9, 9},
                first_interval ? "actual maximal positive intervals" : "",
                {220, 38, 38}, 4);
        first_interval = false;
    }
    std::print("Actual scan comparisons {}, absorbed entries {}, peak candidates {}.\n",
               t.comparisons, t.absorbed, t.peak_candidates);
    p.title("Original nine scores: actual maximal positive intervals").x_label(
        "original score index").y_label("score; retained interval markers at 9");
    p.save_svg("build/ruzzo_tompa_original.svg");
}
```
