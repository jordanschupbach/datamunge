> Explicit controls

```{cpp, results="markdown", file="figures/ruzzo_tompa_controls.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    const std::vector<std::vector<double>> cases{{}, {-3, 0, -1}, {1, 0},
                                                 {1, -1, 1}, {2, -1, 2}};
    std::vector<double> x, y;
    std::vector<std::string> labels{"empty", "nonpositive", "zero extension",
                                    "equal separated peaks",
                                    "strict improvement"};
    std::print("| control | actual intervals | actual positive seeds |\n| --- | ---: | ---: |\n");
    for (std::size_t i = 0; i < cases.size(); ++i) {
        auto t = a::ruzzo_tompa_run(cases[i]);
        std::print("| {} | {} | {} |\n", labels[i], t.segments.size(),
                   t.positive_seeds);
        x.push_back(i);
        y.push_back(t.segments.size());
    }
    bool invalid = false;
    try {
        a::ruzzo_tompa({std::numeric_limits<double>::quiet_NaN()});
    } catch (const std::invalid_argument &) {
        invalid = true;
    }
    std::print("Nonfinite score rejected: {}.\n", invalid);
    if (!invalid)
        return 1;
    auto p = g::RPlot::create();
    p.bars(x, y, "actual final maximal intervals", {22, 163, 74}, .8).x_ticks(
        x, labels).title("Strict scoring maximality excludes zero-score extensions").x_label("controlled scored sequence").y_label("actual positive intervals");
    p.save_svg("build/ruzzo_tompa_controls.svg");
}
```
