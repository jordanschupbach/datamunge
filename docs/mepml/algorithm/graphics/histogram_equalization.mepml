> Constants, clamping and rectangular admission

Clamping happens before counting and again before the actual lookup. A negative
input is treated as 0 and an input above 255 as 255. Constant input 7 stays 7,
rather than being forced to black or stretched into nonexistent variation. Empty
images and rectangular zero-width rows preserve their shapes. The old
implementation could count all elements of a ragged input but index output using
only the first row's width, risking invalid access; ragged shapes now reject
before any output allocation.

```{cpp, results="markdown", file="figures/equalization_controls.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
    std::filesystem::create_directories("build");

    const std::vector<dm::algorithms::EqualizationImage> cases{{}, {{}, {}},
                                                               {{7, 7}},
                                                               {{-1, 256}}};
    std::print("| case | rows | columns | pixels | identity lookup | clamped input locations |\n| ---: | " "---: | ---: | ---: | --- | ---: |\n");
    for (std::size_t k = 0; k < cases.size(); ++k) {
        const auto t = dm::algorithms::histogram_equalize_trace(cases[k]);
        std::print("| {} | {} | {} | {} | {} | {} |\n", k + 1, t.rows,
                   t.columns, t.pixels, t.identity_mapping,
                   t.work.clamped_pixels);
    }
    bool ragged = false, rowcap = false, pixelcap = false;
    try {
        (void) dm::algorithms::histogram_equalize_trace({{}, {1}}, {1, 1});
    } catch (const std::invalid_argument &) {
        ragged = true;
    }
    try {
        (void) dm::algorithms::histogram_equalize_trace({{100, 100}, {101, 102}},
                                                        {1, 4});
    } catch (const std::length_error &) {
        rowcap = true;
    }
    try {
        (void) dm::algorithms::histogram_equalize_trace({{100, 100}, {101, 102}},
                                                        {2, 3});
    } catch (const std::length_error &) {
        pixelcap = true;
    }
    const auto exact =
        dm::algorithms::histogram_equalize_trace({{100, 100}, {101, 102}},
                                                 {2, 4});
    std::print("Ragged shape rejected before caps {}; one-short row cap rejects {}; one-short pixel cap " "rejects {}; exact caps retain {} pixels.\n",
               ragged, rowcap, pixelcap, exact.pixels);
    const auto flat = dm::algorithms::histogram_equalize_trace({{7, 7}});
    std::vector<double> x, y;
    for (int v = 0; v < 256; ++v) {
        x.push_back(v);
        y.push_back(flat.mapping[v]);
    }
    auto plot = dm::graphics::RPlot::create();
    plot.line(x, y, "identity lookup", {37, 99, 235}, 2.).points(
        {7.}, {double(flat.image[0][0])}, "occupied level 7", {220, 38, 38}, 7.).title("A constant image uses an identity lookup, not contrast invention").x_label("input level").y_label("mapped level").y_limits(-10, 340).save_svg("build/equalization_controls.svg");
    if (!ragged || !rowcap || !pixelcap || flat.image[0][0] != 7)
        throw std::runtime_error("boundary controls");
}
```
