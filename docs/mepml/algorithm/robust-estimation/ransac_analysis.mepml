> Explicit controls

```{cpp, results="markdown", file="figures/ransac_controls.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <datamunge/plot/plot.hpp>
#include <datamunge/plot/diagram.hpp>
#include <datamunge/algorithms/modular_exponentiation.hpp>
#include <datamunge/algorithms/integer_arithmetic.hpp>
#include <filesystem>
#include <print>
#include <algorithm>
#include <cmath>
#include <limits>
#include <climits>
#include <datamunge/algorithms/number_theory.hpp>
#include <numeric>
#include <numbers>
#include <random>
#include <string>
#include <vector>
#include <map>
#include <set>
#include <array>
#include <tuple>
#include <datamunge/algorithms/prufer.hpp>
#include <datamunge/algorithms/flow_diagram.hpp>
#include <datamunge/geometry/hull_algorithms.hpp>
#include <datamunge/random/sampling_analysis.hpp>
#include <iomanip>
#include <datamunge/algorithms/qr_algorithm.hpp>
#include <datamunge/stats/lm.hpp>
#include <datamunge/algorithms/arithmetic_coding.hpp>
#include <datamunge/nn/rbf.hpp>
#include <datamunge/nn/model_plot.hpp>
#include <bit>
#include <datamunge/algorithms/ransac.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");

    const std::vector<std::vector<double>> xs{{2, 2, 2, 2}, {1, 1},
                                              {0, 1e-20, 2e-20}, {0, 1, 2}}, ys{
        {0, 1, 2, 3}, {2, 2}, {0, 0, 0}, {1, 3, 5}
    };
    const std::vector<std::string> labels{"vertical line", "coincident points",
                                          "tiny distinct points",
                                          "zero attempts"};
    std::vector<double> counts;
    std::print("\n| actual control | found | actual pre-refit consensus | actual final consensus | actual " "draws |\n| --- | --- | ---: | ---: | ---: |\n");
    for (std::size_t i = 0; i < xs.size(); ++i) {
        auto t =
            a::ransac_line_run(xs[i], ys[i], i == 2 ? 1e-25 : .01,
                               i == 3 ? 0 : 50, 1);
        counts.push_back(t.line.inlier_count);
        std::print("| {} | {} | {} | {} | {} |\n", labels[i], t.found,
                   t.hypothesis.inlier_count, t.line.inlier_count, t.draws);
    }
    bool impossible = false;
    try {
        a::ransac_required_iterations(0, 2);
    } catch (const std::domain_error &) {
        impossible = true;
    }
    std::print("Zero inlier-probability positive-success bound rejects: {}. Exact2-of2 distinct-index " "attempt bound: {}.\n",
               impossible, a::ransac_pair_iterations(2, 2));
    auto p = g::RPlot::barplot(counts, labels, "actual rescored consensus");
    p.title("Geometry, scale and no-model RANSAC controls").y_label(
        "actual threshold inlier count");
    p.save_svg("build/ransac_controls.svg");
}
