> The retained original experiment

```{cpp, results="markdown", file="figures/ransac_original.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <datamunge/plot/plot.hpp>
#include <datamunge/plot/diagram.hpp>
#include <datamunge/algorithms/modular_exponentiation.hpp>
#include <datamunge/algorithms/integer_arithmetic.hpp>
#include <filesystem>
#include <print>
#include <algorithm>
#include <cmath>
#include <limits>
#include <climits>
#include <datamunge/algorithms/number_theory.hpp>
#include <numeric>
#include <numbers>
#include <random>
#include <string>
#include <vector>
#include <map>
#include <set>
#include <array>
#include <tuple>
#include <datamunge/algorithms/prufer.hpp>
#include <datamunge/algorithms/flow_diagram.hpp>
#include <datamunge/geometry/hull_algorithms.hpp>
#include <datamunge/random/sampling_analysis.hpp>
#include <iomanip>
#include <datamunge/algorithms/qr_algorithm.hpp>
#include <datamunge/stats/lm.hpp>
#include <datamunge/algorithms/arithmetic_coding.hpp>
#include <datamunge/nn/rbf.hpp>
#include <datamunge/nn/model_plot.hpp>
#include <bit>
#include <datamunge/algorithms/ransac.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");

    auto data = a::ransac_example_points();
    auto t = a::ransac_line_run(data.x, data.y, .2, 500, 1);
    dm::Mat<> predictors(data.x.size(), 1);
    for (std::size_t i = 0; i < data.x.size(); ++i)
        predictors(i, 0) = data.x[i];
    const dm::stats::LM ols(data.y, predictors, true);
    std::print("\n| original fit | actual slope | actual intercept | actual consensus |\n| --- | ---: | " "---: | ---: |\n| all-point native OLS | {} | {} | not a threshold consensus |\n| winning " "native minimal model | {} | {} | {} |\n| native TLS refit, rescored | {} | {} | {} |\n",
               ols.coefficients()[1], ols.coefficients()[0],
               -t.hypothesis.a / t.hypothesis.b,
               -t.hypothesis.c / t.hypothesis.b, t.hypothesis.inlier_count,
               -t.line.a / t.line.b, -t.line.c / t.line.b, t.line.inlier_count);
    std::print("Actual attempted pairs500, index draws {}, skipped duplicate ids {}, coincident points {}, " "distance tests {}. Ideal w=.67 bound {}; finite80-of120 distinct-pair bound {}.\n",
               t.draws, t.skipped_duplicates, t.skipped_coincident,
               t.distance_tests, a::ransac_required_iterations(.67, 2),
               a::ransac_pair_iterations(80, 120));
    std::vector<double> ix, iy, ox, oy;
    for (std::size_t i = 0; i < data.x.size(); ++i)
        if (t.line.inliers[i]) {
            ix.push_back(data.x[i]);
    iy.push_back(data.y[i]);
        } else {
            ox.push_back(data.x[i]);
            oy.push_back(data.y[i]);
        }
        auto p = g::RPlot::create();
        p.points(ox, oy, "actual final-mask outliers", {148, 163, 184}, 4).points(ix, iy, "actual final-mask inliers", {37, 99, 235}, 4).abline(-t.line.c / t.line.b, -t.line.a / t.line.b, {220, 38, 38}, 2).abline(ols.coefficients()[0], ols.coefficients()[1], {22, 163, 74}, 2).legend({"actual final-mask outliers", "actual final-mask inliers", "actual TLS-refit RANSAC", "actual all-point OLS"}, {{148, 163, 184}, {37, 99, 235}, {220, 38, 38}, {22, 163, 74}}).title("Original 80-plus-40 fixture: actual robust and all-point fits").x_label("original x").y_label("original y");
        p.save_svg("build/ransac_original.svg");
}
