#include <string>
#include <vector>
#include <map>
#include <set>
#include <array>
#include <tuple>
#include <datamunge/algorithms/prufer.hpp>
#include <datamunge/algorithms/flow_diagram.hpp>
#include <datamunge/geometry/hull_algorithms.hpp>
#include <datamunge/random/sampling_analysis.hpp>
#include <iomanip>
#include <datamunge/algorithms/qr_algorithm.hpp>
#include <datamunge/stats/lm.hpp>
#include <datamunge/algorithms/arithmetic_coding.hpp>
#include <datamunge/nn/rbf.hpp>
#include <datamunge/nn/model_plot.hpp>
#include <bit>
#include <datamunge/algorithms/ransac.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");

    auto data = a::ransac_example_points();
    std::vector<double> x, y, z;
    std::print("\n| explicit threshold | actual winning minimal count | actual rescored TLS count | actual " "distance tests |\n| ---: | ---: | ---: | ---: |\n");
    for (double threshold : {.01, .05, .1, .2, .5, 1.}) {
        auto t = a::ransac_line_run(data.x, data.y, threshold, 500, 1);
        x.push_back(threshold);
        y.push_back(t.hypothesis.inlier_count);
        z.push_back(t.line.inlier_count);
        std::print("| {} | {} | {} | {} |\n", threshold,
                   t.hypothesis.inlier_count, t.line.inlier_count,
                   t.distance_tests);
    }
    auto p = g::RPlot::create();
    p.lines(x, y, "actual winning minimal consensus", {37, 99, 235}).lines(
        x, z, "actual rescored TLS consensus", {234, 88, 12}).points(
        x, z, {234, 88, 12}, 5).title("Same native sample stream: threshold and refit decisions").x_label("represented-line distance threshold").y_label("actual consensus cardinality");
    p.save_svg("build/ransac_work.svg");
}
