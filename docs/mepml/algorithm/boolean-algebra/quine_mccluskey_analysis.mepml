> Explicit controls

```{cpp, results="markdown", file="figures/quine_mccluskey_controls.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <datamunge/plot/plot.hpp>
#include <datamunge/plot/diagram.hpp>
#include <datamunge/algorithms/modular_exponentiation.hpp>
#include <datamunge/algorithms/integer_arithmetic.hpp>
#include <filesystem>
#include <print>
#include <algorithm>
#include <cmath>
#include <limits>
#include <climits>
#include <datamunge/algorithms/number_theory.hpp>
#include <numeric>
#include <numbers>
#include <random>
#include <string>
#include <vector>
#include <map>
#include <set>
#include <array>
#include <tuple>
#include <datamunge/algorithms/prufer.hpp>
#include <datamunge/algorithms/flow_diagram.hpp>
#include <datamunge/geometry/hull_algorithms.hpp>
#include <datamunge/random/sampling_analysis.hpp>
#include <iomanip>
#include <bit>
#include <datamunge/algorithms/quine_mccluskey.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");

    std::vector<double> counts;
    std::vector<std::string> labels{"no required ones", "zero-variable true",
                                    "duplicate minterms", "all two-bit ones"};
    std::vector<a::QuineMcCluskeyRun> cases{a::quine_mccluskey_run(2, {}),
                                            a::quine_mccluskey_run(0, {0}),
                                            a::quine_mccluskey_run(2,
                                                                   {0, 0, 1, 1}),
                                            a::quine_mccluskey_run(2,
                                                                   {0, 1, 2, 3})};
    std::print("\n| actual control | normalized required terms | actual minimum cover size |\n| --- | ---: " "| ---: |\n");
    for (std::size_t i = 0; i < cases.size(); ++i) {
        counts.push_back(cases[i].result.minimal_cover.size());
        std::print("| {} | {} | {} |\n", labels[i], cases[i].minterms.size(),
                   cases[i].result.minimal_cover.size());
    }
    bool n = false, domain = false;
    try {
        a::quine_mccluskey(-1, {});
    } catch (const std::invalid_argument &) {
        n = true;
    }
    try {
        a::quine_mccluskey(2, {4});
    } catch (const std::invalid_argument &) {
        domain = true;
    }
    std::print("Invalid variable count rejected: {}; out-of-domain minterm rejected: {}.\n",
               n, domain);
    auto p = g::RPlot::barplot(counts, labels, "actual minimum product count");
    p.title("Boolean domain boundaries and normalized duplicate inputs").y_label("actual cover terms");
    p.save_svg("build/quine_mccluskey_controls.svg");
}
```
