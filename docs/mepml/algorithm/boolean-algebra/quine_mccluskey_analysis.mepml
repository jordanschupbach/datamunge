#include <datamunge/algorithms/flow_diagram.hpp>
#include <datamunge/geometry/hull_algorithms.hpp>
#include <datamunge/random/sampling_analysis.hpp>
#include <iomanip>
#include <bit>
#include <datamunge/algorithms/quine_mccluskey.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");

    auto t = a::quine_mccluskey_trace(2, {0, 1});
    const auto &s = t.rounds[0];
    std::print("\n| actual round | input terms | actual next terms | actual new primes |\n| ---: | ---: | " "---: | ---: |\n");
    for (std::size_t i = 0; i < t.rounds.size(); ++i)
        std::print("| {} | {} | {} | {} |\n", i, t.rounds[i].terms.size(),
                   t.rounds[i].next.size(), t.rounds[i].primes.size());

    g::Diagram d;
    d.node("n0", {0, 0},
           std::format("Actual initial product terms\n{}", s.terms.size()));
    d.node("n1", {10, 0},
           std::format("Actual next merged cube\n{}",
                       a::implicant_to_string(s.next[0], 2)));
    d.node("n2", {20, 0},
           std::format("Actual selected minimum cover\n{}",
                       a::implicant_to_string(t.result.minimal_cover[0], 2)));
    d.edge("n0", "n1").edge("n1", "n2");
    d.save_svg("build/quine_mccluskey_tiny.svg");
}
