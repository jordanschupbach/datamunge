> The retained original experiment

```{cpp, results="markdown", file="figures/quine_mccluskey_original.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <datamunge/plot/plot.hpp>
#include <datamunge/plot/diagram.hpp>
#include <datamunge/algorithms/modular_exponentiation.hpp>
#include <datamunge/algorithms/integer_arithmetic.hpp>
#include <filesystem>
#include <print>
#include <algorithm>
#include <cmath>
#include <limits>
#include <climits>
#include <datamunge/algorithms/number_theory.hpp>
#include <numeric>
#include <numbers>
#include <random>
#include <string>
#include <vector>
#include <map>
#include <set>
#include <array>
#include <tuple>
#include <datamunge/algorithms/prufer.hpp>
#include <datamunge/algorithms/flow_diagram.hpp>
#include <datamunge/geometry/hull_algorithms.hpp>
#include <datamunge/random/sampling_analysis.hpp>
#include <iomanip>
#include <bit>
#include <datamunge/algorithms/quine_mccluskey.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");

    auto t = a::quine_mccluskey_trace(4, {4, 8, 10, 11, 12, 15}, {9, 14});
    std::print("\n| actual prime id | actual cube | essential | selected minimum cover |\n| ---: | --- | " "--- | --- |\n");
    for (std::size_t i = 0; i < t.result.prime_implicants.size(); ++i) {
        auto p = t.result.prime_implicants[i];
        std::print("| {} | {} | {} | {} |\n", i, a::implicant_to_string(p, 4),
                   std::find(t.result.essential.begin(),
                             t.result.essential.end(), p) !=
                   t.result.essential.end(),
                   std::find(t.result.minimal_cover.begin(),
                             t.result.minimal_cover.end(), p) !=
                   t.result.minimal_cover.end());
    }
    std::print("\n| actual required minterm | actual covering prime ids |\n| ---: | --- |\n");
    for (std::size_t i = 0; i < t.minterms.size(); ++i)
        std::print("| {} | `{}` |\n", t.minterms[i], t.chart[i]);
    auto p =
        g::RPlot::barplot({double(t.minterms.size()),
                           double(t.result.prime_implicants.size()),
                           double(t.result.minimal_cover.size())},
                          {"original minterms", "actual primes",
                           "actual minimum cover"}, "actual product-term counts");
    p.title("Original four-variable function: exact native reduction").y_label(
        "actual product terms");
    p.save_svg("build/quine_mccluskey_original.svg");
}
