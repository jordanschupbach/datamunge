#include <datamunge/algorithms/prufer.hpp>
#include <datamunge/algorithms/flow_diagram.hpp>
#include <datamunge/geometry/hull_algorithms.hpp>
#include <datamunge/random/sampling_analysis.hpp>
#include <iomanip>
#include <bit>
#include <datamunge/algorithms/quine_mccluskey.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");

    std::vector<double> x, y, z;
    auto t = a::quine_mccluskey_trace(4, {4, 8, 10, 11, 12, 15}, {9, 14});
    std::print("\n| actual round | actual terms before | actual terms next | actual newly prime |\n| ---: | " "---: | ---: | ---: |\n");
    for (std::size_t i = 0; i < t.rounds.size(); ++i) {
        x.push_back(i);
        y.push_back(t.rounds[i].terms.size());
        z.push_back(t.rounds[i].next.size());
        std::print("| {} | {} | {} | {} |\n", i, t.rounds[i].terms.size(),
                   t.rounds[i].next.size(), t.rounds[i].primes.size());
    }
    std::print("Actual pair tests: {}; successful pair merges including duplicates: {}; residual Petrick " "generated products: {}.\n",
               t.pair_tests, t.merges, t.covering.generated);
    auto p = g::RPlot::create();
    p.lines(x, y, "actual current cubes", {37, 99, 235}).lines(
        x, z, "actual deduplicated next cubes", {234, 88, 12}).points(
        x, y, {37, 99, 235}, 5).title("Actual prime-generation rounds on the original function").x_label("actual merge round").y_label("actual cube count");
    p.save_svg("build/quine_mccluskey_work.svg");
}
