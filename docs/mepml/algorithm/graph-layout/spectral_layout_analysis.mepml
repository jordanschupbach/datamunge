> The retained original experiment

```{cpp, results="markdown", file="figures/spectral_layout_original.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <filesystem>
#include <print>
#include <algorithm>
#include <cmath>
#include <limits>
#include <numeric>
#include <numbers>
#include <random>
#include <string>
#include <vector>
#include <map>
#include <set>
#include <array>
#include <tuple>
#include <bit>
#include <datamunge/random/quality.hpp>
#include <datamunge/algorithms/spectral_layout.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    auto edges = a::spectral_path_edges(4);
    auto r = a::spectral_layout_run(4, edges);
    std::print("| original vertex | actual x | actual y |\n| ---: | ---: | ---: |\n");
    std::vector<double> x, y;
    for (std::size_t i = 0; i < r.positions.size(); ++i) {
        const auto &p = r.positions[i];
        std::print("| {} | {} | {} |\n", i, p.x, p.y);
        x.push_back(p.x);
        y.push_back(p.y);
    }
    std::print("\nActual eigenvalues `{}`; rotations {}; scans {}; converged {}.\n",
               r.eigenvalues, r.rotations, r.scan_visits, r.converged);
    auto plot = g::RPlot::create();
    for (const auto & [u, v] : edges)
        plot.lines({r.positions[u].x, r.positions[v].x},
                   {r.positions[u].y, r.positions[v].y}, "actual path edge",
                   {37, 99, 235}, 3);
    plot.points(x, y, {220, 38, 38}, 7);
    for (std::size_t i = 0; i < x.size(); ++i)
        plot.text(x[i], y[i] + .12, std::to_string(i), {31, 41, 55}, 16);
    plot.title("Original four-vertex path in actual low modes").x_label(
        "centered scaled second mode").y_label("centered scaled third mode").size(760, 800).margins(80, 40, 72, 88).x_limits(-1.3, 1.3).y_limits(-1.3, 1.3);
    plot.save_svg("build/spectral_layout_original.svg");
}
```
