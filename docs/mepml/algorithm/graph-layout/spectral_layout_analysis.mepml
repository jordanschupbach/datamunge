> Actual selected work and sensitivity

```{cpp, results="markdown", file="figures/spectral_layout_work.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <filesystem>
#include <print>
#include <algorithm>
#include <cmath>
#include <limits>
#include <numeric>
#include <numbers>
#include <random>
#include <string>
#include <vector>
#include <map>
#include <set>
#include <array>
#include <tuple>
#include <bit>
#include <datamunge/random/quality.hpp>
#include <datamunge/algorithms/spectral_layout.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    std::vector<double> x, y;
    std::print("| complete path order | actual rotations | actual upper-triangle scan visits | remaining " "off-diagonal | converged |\n| ---: | ---: | ---: | ---: | --- |\n");
    for (std::size_t n : {2, 3, 4, 6, 8, 12, 16, 24}) {
        auto r = a::spectral_layout_run(n, a::spectral_path_edges(n));
        std::print("| {} | {} | {} | {} | {} |\n", n, r.rotations,
                   r.scan_visits, r.remaining_off_diagonal, r.converged);
        x.push_back(n);
        y.push_back(r.scan_visits);
    }
    auto plot = g::RPlot::create();
    plot.lines(x, y, "actual values", {37, 99, 235}).points(x, y, {37, 99, 235},
                                                            4).title(
        "Actual largest-pivot scan work on paths").x_label("vertices").y_label(
        "upper-triangle entries inspected");
    plot.save_svg("build/spectral_layout_work.svg");
}
