> Explicit controls

```{cpp, results="markdown", file="figures/spectral_layout_controls.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <filesystem>
#include <print>
#include <algorithm>
#include <cmath>
#include <limits>
#include <numeric>
#include <numbers>
#include <random>
#include <string>
#include <vector>
#include <map>
#include <set>
#include <array>
#include <tuple>
#include <bit>
#include <datamunge/random/quality.hpp>
#include <datamunge/algorithms/spectral_layout.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    const std::vector<std::vector<std::pair<std::size_t, std::size_t>> > cases{
        {}, {{0, 1}}, {{0, 1}, {2, 3}}, {{0, 1}, {1, 2}, {2, 3}},
        {{0, 1}, {0, 1}, {1, 2}, {2, 3}, {0, 0}}
    };
    std::vector<double> x, y;
    std::print("| four-vertex control | actual sorted eigenvalues | converged | rotations |\n| ---: | --- | " "--- | ---: |\n");
    for (std::size_t i = 0; i < cases.size(); ++i) {
        auto r = a::spectral_layout_run(4, cases[i]);
        std::print("| {} | `{}` | {} | {} |\n", i, r.eigenvalues, r.converged,
                   r.rotations);
        x.push_back(i);
        y.push_back(r.rotations);
    }
    auto plot = g::RPlot::create();
    plot.lines(x, y, "actual values", {37, 99, 235}).points(x, y, {37, 99, 235},
                                                            4).title(
        "Disconnected, repeated-edge and ignored-loop controls").x_label(
        "control index").y_label("actual Jacobi rotations");
    plot.save_svg("build/spectral_layout_controls.svg");
}
