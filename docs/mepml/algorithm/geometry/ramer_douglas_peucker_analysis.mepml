#include <datamunge/algorithms/flow_diagram.hpp>
#include <datamunge/geometry/hull_algorithms.hpp>
#include <datamunge/random/sampling_analysis.hpp>
#include <iomanip>
#include <bit>
#include <datamunge/algorithms/ramer_douglas_peucker.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");

    auto t = a::ramer_douglas_peucker_trace({{0, 0}, {1, 1}, {2, 0}}, .5);
    const auto &s = t.steps[0];
    std::print("\n| actual endpoints | actual farthest id | actual finite-segment distance | split |\n| --- " "| ---: | ---: | --- |\n");
    for (const auto &e : t.steps)
        std::print("| {} to {} | {} | {} | {} |\n", e.lo, e.hi, e.farthest,
                   e.distance, e.split);

    g::Diagram d;
    d.node("n0", {0, 0},
           std::format("Actual input chord ids\n{} to {}", s.lo, s.hi));
    d.node("n1", {10, 0},
           std::format("Actual farthest distance / split\n{} / {}", s.distance,
                       s.split));
    d.node("n2", {20, 0},
           std::format("Actual retained original indices\n{}", t.indices));
    d.edge("n0", "n1").edge("n1", "n2");
    d.save_svg("build/ramer_douglas_peucker_tiny.svg");
}
