> Explicit controls

```{cpp, results="markdown", file="figures/ramer_douglas_peucker_controls.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <datamunge/plot/plot.hpp>
#include <datamunge/plot/diagram.hpp>
#include <datamunge/algorithms/modular_exponentiation.hpp>
#include <datamunge/algorithms/integer_arithmetic.hpp>
#include <filesystem>
#include <print>
#include <algorithm>
#include <cmath>
#include <limits>
#include <climits>
#include <datamunge/algorithms/number_theory.hpp>
#include <numeric>
#include <numbers>
#include <random>
#include <string>
#include <vector>
#include <map>
#include <set>
#include <array>
#include <tuple>
#include <datamunge/algorithms/prufer.hpp>
#include <datamunge/algorithms/flow_diagram.hpp>
#include <datamunge/geometry/hull_algorithms.hpp>
#include <datamunge/random/sampling_analysis.hpp>
#include <iomanip>
#include <bit>
#include <datamunge/algorithms/ramer_douglas_peucker.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");

    std::vector<std::vector<a::RDPPoint>> cases{{}, {{1, 1}},
                                                {{0, 0}, {1, 0}, {2, 0}},
                                                {{0, 0}, {2, 0}, {1, 0}},
                                                {{0, 0}, {1, 0}, {0, 0}}};
    std::vector<std::string> labels{"empty", "singleton",
                                    "collinear in segment",
                                    "collinear overshoot",
                                    "coincident endpoints"};
    std::vector<double> counts;
    std::print("\n| actual control, epsilon0.5 | retained original indices | actual maximum assigned error " "|\n| --- | --- | ---: |\n");
    for (std::size_t i = 0; i < cases.size(); ++i) {
        auto r = a::ramer_douglas_peucker_run(cases[i], .5);
        counts.push_back(r.points.size());
        std::print("| {} | `{}` | {} |\n", labels[i], r.indices,
                   r.max_segment_error);
    }
    bool bad = false;
    try {
        a::ramer_douglas_peucker({}, -1);
    } catch (const std::invalid_argument &) {
        bad = true;
    }
    std::print("Negative epsilon rejected even for empty input: {}.\n", bad);
    auto p = g::RPlot::barplot(counts, labels, "actual retained vertices");
    p.title("Finite-segment and degenerate-polyline controls").y_label(
        "actual retained vertices");
    p.save_svg("build/ramer_douglas_peucker_controls.svg");
}
```
