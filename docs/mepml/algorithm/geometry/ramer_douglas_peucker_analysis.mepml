    for (double e : {0., .001, .01, .05, .1, .2, .3, .5}) {
        auto r = a::ramer_douglas_peucker_run(curve, e);
        x.push_back(e);
        y.push_back(r.max_segment_error);
        z.push_back(e);
        std::print("| {} | {} | {} | {} |\n", e, r.max_segment_error,
                   r.points.size(), r.distance_tests);
    }
    auto p = g::RPlot::create();
    p.lines(x, y, "actual maximum assigned-chord distance", {16, 122, 87}).lines(x, z, "explicit tolerance reference", {234, 88, 12}).points(x, y, {16, 122, 87}, 5).title("Actual accepted-chord errors remain within tolerance").x_label("distance tolerance epsilon").y_label("actual distance / tolerance reference");
    p.save_svg("build/ramer_douglas_peucker_work.svg");
}
