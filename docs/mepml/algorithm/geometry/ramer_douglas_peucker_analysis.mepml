> The retained original experiment

```{cpp, results="markdown", file="figures/ramer_douglas_peucker_original.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <datamunge/plot/plot.hpp>
#include <datamunge/plot/diagram.hpp>
#include <datamunge/algorithms/modular_exponentiation.hpp>
#include <datamunge/algorithms/integer_arithmetic.hpp>
#include <filesystem>
#include <print>
#include <algorithm>
#include <cmath>
#include <limits>
#include <climits>
#include <datamunge/algorithms/number_theory.hpp>
#include <numeric>
#include <numbers>
#include <random>
#include <string>
#include <vector>
#include <map>
#include <set>
#include <array>
#include <tuple>
#include <datamunge/algorithms/prufer.hpp>
#include <datamunge/algorithms/flow_diagram.hpp>
#include <datamunge/geometry/hull_algorithms.hpp>
#include <datamunge/random/sampling_analysis.hpp>
#include <iomanip>
#include <bit>
#include <datamunge/algorithms/ramer_douglas_peucker.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");

    auto curve = a::rdp_waveform();
    auto t = a::ramer_douglas_peucker_trace(curve, .2);
    std::vector<double> x, y, sx, sy;
    for (auto p : curve) {
        x.push_back(p.first);
        y.push_back(p.second);
    }
    for (auto p : t.points) {
        sx.push_back(p.first);
        sy.push_back(p.second);
    }
    std::print("\n| original tolerance | actual retained points | actual distance tests | actual " "assigned-chord max error |\n| ---: | ---: | ---: | ---: |\n");
    for (double e : {.001, .01, .05, .2, .5}) {
        auto r = a::ramer_douglas_peucker_run(curve, e);
        std::print("| {} | {} | {} | {} |\n", e, r.points.size(),
                   r.distance_tests, r.max_segment_error);
    }
    std::print("Actual epsilon0.2 retained original indices: {}.\n", t.indices);
    auto p = g::RPlot::create();
    p.lines(x, y, "original 201-point curve", {100, 116, 139}).lines(
        sx, sy, "actual retained chords, epsilon0.2", {234, 88, 12}).points(
        sx, sy, {234, 88, 12}, 5).title("Original waveform: actual finite-segment simplification").x_label("x").y_label("sin(x) + 0.3 sin(3.1x)");
    p.save_svg("build/ramer_douglas_peucker_original.svg");
}
```
