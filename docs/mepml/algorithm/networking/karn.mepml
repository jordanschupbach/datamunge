\alttext(Blue mean and red timeout values are actual committed states after each of the nine original events.)

> Reject invalid updates before committing any state

Initial timeout must be finite and positive. A clean RTT must be finite and
nonnegative; a zero clean sample is allowed and can produce a zero RTO because
no minimum/granularity is modeled. Invalid clean samples and produced overflow
throw without changing any field. An ignored NaN sample remains ignored and
leaves the full state unchanged. These are input/transition contracts rather
than simulated packet-loss outcomes.

```{cpp, results="markdown", file="figures/karn_controls.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
    std::filesystem::create_directories("build");
    dm::algorithms::KarnEstimator k;
    const auto ignored = k.ack(std::numeric_limits<double>::quiet_NaN(), true);
    bool bad = false, overflow = false;
    try {
        (void) k.ack(-1);
    } catch (const std::invalid_argument &) {
        bad = true;
    }
    try {
        (void) k.ack(std::numeric_limits<double>::max() / 2);
    } catch (const std::overflow_error &) {
        overflow = true;
    }
    std::print("| control | initialized | actual SRTT | actual RTO |\n| --- | --- | ---: | ---: |\n| " "ignored NaN | {} | {} | {} |\n| invalid/overflow unchanged | {} | {} | {} |\n",
               ignored.after.initialized, ignored.after.srtt, ignored.after.rto,
               k.initialized(), k.srtt(), k.rto());
    if (!bad || !overflow || k.initialized() || k.rto() != 1)
        throw std::runtime_error("atomic update guards");
    dm::algorithms::KarnEstimator backed(1);
    std::vector<double> x, y;
    std::print("\n| timeout count | actual RTO |\n| ---: | ---: |\n");
    for (int i = 0; i <= 8; ++i) {
        if (i)
            (void) backed.timeout();
        std::print("| {} | {} |\n", i, backed.rto());
        x.push_back(i);
        y.push_back(std::log2(backed.rto()));
    }
    auto p = dm::graphics::RPlot::create();
    p.line(x, y, "", {220, 38, 38}, 2).points(x, y, "", {220, 38, 38}, 4).title(
        "Actual timeout doubling with no RTT update").x_label(
        "completed timeout events").y_label("log2(RTO in seconds)").y_limits(
        -.5, 9).save_svg("build/karn_controls.svg");
}
```
