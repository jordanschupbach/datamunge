> Explicit controls

```{cpp, results="markdown", file="figures/schreier_sims_controls.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <filesystem>
#include <print>
#include <algorithm>
#include <cmath>
#include <limits>
#include <numeric>
#include <numbers>
#include <random>
#include <string>
#include <vector>
#include <map>
#include <set>
#include <array>
#include <tuple>
#include <bit>
#include <datamunge/algorithms/schreier_sims.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    auto cyclic = a::schreier_sims(4, {{1, 2, 3, 0}});
    auto identity = a::schreier_sims(4, {});
    std::vector<double> x{0, 1, 2}, y;
    std::print("| candidate | actual cyclic membership |\n| --- | --- |\n");
    for (const auto &p : std::vector<std::vector<int>>{{0, 1, 2, 3},
                                                       {2, 3, 0, 1},
                                                       {1, 0, 2, 3}}) {
        bool member = a::bsgs_contains(cyclic, p);
        y.push_back(member);
        std::print("| `{}` | {} |\n", p, member);
    }
    bool bad = false;
    try {
        a::schreier_sims(3, {{0, 0, 2}});
    } catch (const std::invalid_argument &) {
        bad = true;
    }
    std::print("\nIdentity-group order {}; malformed generator rejected {}.\n",
               identity.order, bad);
    if (!bad)
        return 1;
    auto plot = g::RPlot::create();
    plot.lines(x, y, "actual values", {37, 99, 235}).points(x, y, {37, 99, 235},
                                                            5).title(
        "Cyclic C4 membership: rotation versus transposition").x_label(
        "candidate").y_label("actual membership");
    plot.save_svg("build/schreier_sims_controls.svg");
}
```
// result_begin: markdown
| candidate | actual cyclic membership |
| --- | --- |
| `[0, 1, 2, 3]` | true |
| `[2, 3, 0, 1]` | true |
| `[1, 0, 2, 3]` | false |

Identity-group order 1; malformed generator rejected true.
