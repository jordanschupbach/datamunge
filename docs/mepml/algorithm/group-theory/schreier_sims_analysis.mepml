> The retained original experiment

```{cpp, results="markdown", file="figures/schreier_sims_original.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <filesystem>
#include <print>
#include <algorithm>
#include <cmath>
#include <limits>
#include <numeric>
#include <numbers>
#include <random>
#include <string>
#include <vector>
#include <map>
#include <set>
#include <array>
#include <tuple>
#include <bit>
#include <datamunge/algorithms/schreier_sims.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    auto s5 = a::schreier_sims(5, a::symmetric_group_generators(5));
    auto d4 = a::schreier_sims(4, {{1, 2, 3, 0}, {1, 0, 3, 2}});
    auto a4 = a::schreier_sims(4, {{1, 2, 0, 3}, {0, 2, 3, 1}});
    auto s6 = a::schreier_sims_trace(6, a::symmetric_group_generators(6));
    std::print("Actual orders: S5={}, D4={}, A4={}, S6={}.\n\n| S6 level | actual orbit |\n| ---: | ---: " "|\n",
               s5.order, d4.order, a4.order, s6.group.order);
    std::vector<double> x, y;
    for (std::size_t i = 0; i < s6.group.base.size(); ++i) {
        auto size = s6.group.transversal[i].size();
        std::print("| {} | {} |\n", i, size);
        x.push_back(i);
        y.push_back(size);
    }
    auto plot = g::RPlot::create();
    plot.lines(x, y, "actual values", {37, 99, 235}).points(x, y, {37, 99, 235},
                                                            5).title(
        "Original S6 stabilizer chain: orbit product 720").x_label("level").y_label("actual orbit size");
    plot.save_svg("build/schreier_sims_original.svg");
}
```
