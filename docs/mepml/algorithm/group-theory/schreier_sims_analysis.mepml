> Actual selected work and sensitivity

```{cpp, results="markdown", file="figures/schreier_sims_work.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <filesystem>
#include <print>
#include <algorithm>
#include <cmath>
#include <limits>
#include <numeric>
#include <numbers>
#include <random>
#include <string>
#include <vector>
#include <map>
#include <set>
#include <array>
#include <tuple>
#include <bit>
#include <datamunge/algorithms/schreier_sims.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    std::vector<double> x, y;
    std::print("| degree | actual order | actual point operations | actual sifts | actual Schreier " "generators |\n| ---: | ---: | ---: | ---: | ---: |\n");
    for (int n = 2; n <= 9; ++n) {
        auto r = a::schreier_sims_run(n, a::symmetric_group_generators(n));
        std::print("| {} | {} | {} | {} | {} |\n", n, r.group.order,
                   r.point_operations, r.sifts, r.schreier_generators);
        x.push_back(n);
        y.push_back(r.point_operations);
    }
    auto plot = g::RPlot::create();
    plot.lines(x, y, "actual values", {37, 99, 235}).points(x, y, {37, 99, 235},
                                                            5).title(
        "Actual stabilizer closure work for S_n").x_label("degree n").y_label(
        "actual permutation-loop point operations");
    plot.save_svg("build/schreier_sims_work.svg");
}
```
