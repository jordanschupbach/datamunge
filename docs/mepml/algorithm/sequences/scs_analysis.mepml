> Actual selected work and sensitivity

```{cpp, results="markdown", file="figures/scs_work.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <filesystem>
#include <print>
#include <algorithm>
#include <cmath>
#include <limits>
#include <numeric>
#include <numbers>
#include <random>
#include <string>
#include <vector>
#include <map>
#include <set>
#include <array>
#include <tuple>
#include <bit>
#include <datamunge/algorithms/shortest_common_supersequence.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    std::vector<double> x, y;
    std::print("| input length each | actual equality tests | actual score comparisons | actual output " "length |\n| ---: | ---: | ---: | ---: |\n");
    for (int n : {2, 4, 8, 16, 32, 64}) {
        std::vector<int> a1(n, 1), b(n, 2);
        auto r = a::shortest_common_supersequence_run(a1, b);
        std::print("| {} | {} | {} | {} |\n", n, r.equality_tests,
                   r.score_comparisons, r.sequence.size());
        x.push_back(n);
        y.push_back(r.equality_tests);
    }
    auto plot = g::RPlot::create();
    plot.lines(x, y, "actual values", {37, 99, 235}).points(x, y, {37, 99, 235},
                                                            5).title(
        "Actual table and backtrack equality work").x_label("length each").y_label("actual equality tests");
    plot.save_svg("build/scs_work.svg");
}
```
