> Explicit controls

```{cpp, results="markdown", file="figures/scs_controls.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <filesystem>
#include <print>
#include <algorithm>
#include <cmath>
#include <limits>
#include <numeric>
#include <numbers>
#include <random>
#include <string>
#include <vector>
#include <map>
#include <set>
#include <array>
#include <tuple>
#include <bit>
#include <datamunge/algorithms/shortest_common_supersequence.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    const std::vector<std::vector<int>> first{{}, {1, 2}, {1, 2}, {1, 1, 1}};
    const std::vector<std::vector<int>> second{{}, {}, {3, 4}, {1, 1}};
    std::vector<double> x, y;
    std::print("| case | actual output | LCS |\n| ---: | --- | ---: |\n");
    for (std::size_t i = 0; i < first.size(); ++i) {
        auto r = a::shortest_common_supersequence_trace(first[i], second[i]);
        std::print("| {} | `{}` | {} |\n", i, r.sequence, r.lcs_length);
        x.push_back(i);
        y.push_back(r.sequence.size());
    }
    bool rejected = false;
    try {
        a::SCSOptions o;
        o.max_cells = 3;
        a::shortest_common_supersequence_run({1}, {2}, o);
    } catch (const std::length_error &) {
        rejected = true;
    }
    std::print("Complete table cap rejected: {}.\n", rejected);
    if (!rejected)
        return 1;
    auto plot = g::RPlot::create();
    plot.lines(x, y, "actual values", {37, 99, 235}).points(x, y, {37, 99, 235},
                                                            5).title(
        "Empty, disjoint and duplicate controls").x_label("control").y_label(
        "actual length");
    plot.save_svg("build/scs_controls.svg");
}
```
