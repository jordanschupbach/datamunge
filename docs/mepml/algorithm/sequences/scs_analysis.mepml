> The retained original experiment

```{cpp, results="markdown", file="figures/scs_original.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <filesystem>
#include <print>
#include <algorithm>
#include <cmath>
#include <limits>
#include <numeric>
#include <numbers>
#include <random>
#include <string>
#include <vector>
#include <map>
#include <set>
#include <array>
#include <tuple>
#include <bit>
#include <datamunge/algorithms/shortest_common_supersequence.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    const std::string first = "AGGTAB", second = "GXTXAYB";
    auto r =
        a::shortest_common_supersequence_trace(std::vector<int>(first.begin(),
                                                                first.end()),
                                               std::vector<int>(second.begin(),
                                                                second.end()));
    std::string output(r.sequence.begin(), r.sequence.end());
    std::print("Original inputs {} and {}, actual SCS {}, actual LCS length {}.\n\n| actual DP row | actual " "row cells |\n| ---: | --- |\n",
               first, second, output, r.lcs_length);
    std::vector<double> x, y;
    for (std::size_t i = 0; i < r.table.size(); ++i) {
        std::print("| {} | `{}` |\n", i, r.table[i]);
        x.push_back(i);
        y.push_back(r.table[i].back());
    }
    auto plot = g::RPlot::create();
    plot.lines(x, y, "actual values", {37, 99, 235}).points(x, y, {37, 99, 235},
                                                            5).title(
        "Original AGGTAB and GXTXAYB: actual DP border").x_label(
        "first prefix length").y_label("actual LCS with complete second input");
    plot.save_svg("build/scs_original.svg");
}
```
// result_begin: markdown
