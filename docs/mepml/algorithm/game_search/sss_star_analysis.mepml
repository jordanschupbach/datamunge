    auto plot = g::RPlot::create();
    plot.lines(x, y, "actual executed values", {37, 99, 235}).points(
        x, y, {37, 99, 235}, 4).title("Actual entries include transposition-table hits").x_label("tree depth").y_label("actual recursive search entries");
    plot.save_svg("build/sss_star_work.svg");
}
