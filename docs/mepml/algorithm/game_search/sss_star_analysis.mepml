> The retained original experiment

```{cpp, results="markdown", file="figures/sss_star_original.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <filesystem>
#include <print>
#include <algorithm>
#include <cmath>
#include <limits>
#include <numeric>
#include <numbers>
#include <random>
#include <string>
#include <vector>
#include <map>
#include <set>
#include <array>
#include <tuple>
#include <bit>
#include <datamunge/random/quality.hpp>
#include <datamunge/algorithms/sss_star.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    std::vector<double> x, y, z, p;
    std::print("| original depth | last minimax / SSS values | mean minimax leaves | mean SSS search leaves " "| mean preflight leaves | mean alpha-beta leaves |\n| ---: | --- | ---: | ---: | ---: | " "---: |\n");
    for (int depth = 2; depth <= 7; ++depth) {
        double mm = 0, ss = 0, pre = 0, ab = 0, vmm = 0, vss = 0;
        for (int rep = 0; rep < 40; ++rep) {
            auto tree = a::sss_example_tree(depth, 1000 + depth * 97 + rep);
            auto m = a::minimax(tree, true);
            auto s = a::sss_star_run(tree, true);
            auto b = a::alpha_beta(tree, true);
            if (!s.converged || m.value != s.result.value || m.value != b.value)
                throw std::runtime_error("minimax disagreement");
            mm += m.leaves_evaluated;
            ss += s.result.leaves_evaluated;
            pre += s.preflight_leaf_reads;
            ab += b.leaves_evaluated;
            vmm = m.value;
            vss = s.result.value;
        }
        x.push_back(depth);
        y.push_back(ss / 40);
        z.push_back(mm / 40);
        p.push_back((ss + pre) / 40);
        std::print("| {} | {} / {} | {:.9g} | {:.9g} | {:.9g} | {:.9g} |\n",
                   depth, vmm, vss, mm / 40, ss / 40, pre / 40, ab / 40);
    }
    auto chart = g::RPlot::create();
    chart.lines(x, y, "actual SSS search leaf reads", {37, 99, 235}).lines(
        x, z, "actual minimax leaves", {220, 38, 38}).lines(
        x, p, "SSS preflight plus search reads", {124, 58, 237}).title(
        "Original40 trees per depth: query work versus total leaf reads").x_label("tree depth").y_label("mean actual leaf reads");
    chart.save_svg("build/sss_star_original.svg");
}
```
