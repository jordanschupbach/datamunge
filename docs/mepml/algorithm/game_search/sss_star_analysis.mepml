int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    std::vector<double> x, y;
    std::print("| depth | validated nodes | actual search visits | actual table hits | root probes |\n| " "---: | ---: | ---: | ---: | ---: |\n");
    for (int d = 0; d <= 7; ++d) {
        auto tree = a::sss_example_tree(d, 71);
        auto r = a::sss_star_run(tree, true);
