> Explicit controls

```{cpp, results="markdown", file="figures/sss_star_controls.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <filesystem>
#include <print>
#include <algorithm>
#include <cmath>
#include <limits>
#include <numeric>
#include <numbers>
#include <random>
#include <string>
#include <vector>
#include <map>
#include <set>
#include <array>
#include <tuple>
#include <bit>
#include <datamunge/random/quality.hpp>
#include <datamunge/algorithms/sss_star.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    auto tree = a::sss_example_tree(3, 29);
    std::vector<double> x, y;
    std::print("| probe cap | actual probes | converged | lower | upper | search leaf reads |\n| ---: | " "---: | --- | ---: | ---: | ---: |\n");
    for (std::size_t cap : {0, 1, 2, 4, 8, 32}) {
        a::SSSOptions o;
        o.max_probes = cap;
        auto r = a::sss_star_run(tree, true, 1, o);
        x.push_back(cap);
        y.push_back(r.result.leaves_evaluated);
        std::print("| {} | {} | {} | {} | {} | {} |\n", cap, r.probes,
                   r.converged, r.lower, r.upper, r.result.leaves_evaluated);
    }
    auto plot = g::RPlot::create();
    plot.lines(x, y, "actual executed values", {37, 99, 235}).points(
        x, y, {37, 99, 235}, 4).title("Probe exhaustion is an explicit unresolved interval").x_label("probe cap").y_label("actual search leaf reads");
    plot.save_svg("build/sss_star_controls.svg");
}
```
