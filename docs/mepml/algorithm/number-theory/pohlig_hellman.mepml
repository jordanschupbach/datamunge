> The retained original experiment

```{cpp, results="markdown", file="figures/pohlig_hellman_original.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
    std::filesystem::create_directories("build");

    const std::uint64_t prime =
        1009, base =
        11, order =
        1008, secret =
        777, target = dm::algorithms::mod_pow(base, secret, prime);
    auto t = dm::algorithms::pohlig_hellman_trace(base, target, prime, order);
    std::print("Original11^x={} modulo1009, exact order1008: actual returned exponent{}, found{}.\n",
               target, t.run.exponent, t.run.found);
    std::vector<double> tests, theory;
    std::vector<std::string> labels;
    std::print("\n| prime | digit | actual reduced target | picked digit | actual candidate comparisons | " "residue after |\n| ---: | ---: | ---: | ---: | ---: | ---: |\n");
    for (auto &d : t.digits)
        std::print("| {} | {} | {} | {} | {} | {} |\n", d.prime, d.index,
                   d.target, d.digit, d.candidate_tests, d.after);
    for (const auto &f : t.factors) {
        std::size_t count = 0;
        for (auto &d : t.digits)
            if (d.prime == f.prime)
                count += d.candidate_tests;
        tests.push_back(count);
        theory.push_back(std::sqrt(static_cast<double>(f.power)));
        labels.push_back(std::format("{}^{}", f.prime, f.exponent));
    }
    std::print("\n| factor | actual digit comparisons | original sqrt(q^e) reference |\n| --- | ---: | ---: " "|\n");
    for (std::size_t i = 0; i < labels.size(); ++i)
        std::print("| {} | {} | {} |\n", labels[i], tests[i], theory[i]);
    std::print("Original whole-order square-root reference: {}. This is not a measured operation count.\n",
               std::sqrt(static_cast<double>(order)));
    auto p =
        dm::graphics::RPlot::barplot(tests, labels,
                                     "actual linear-search comparisons",
                                     {37, 99, 235});
    p.title("Original smooth order1008: actual native digit candidate comparisons").x_label("prime-power component").y_label("actual equality comparisons");
    p.save_svg("build/pohlig_hellman_original.svg");
}
```
