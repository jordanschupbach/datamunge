> Actual selected work

```{cpp, results="markdown", file="figures/pohlig_hellman_work.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
    std::filesystem::create_directories("build");

    struct Case {
        std::uint64_t p, g, order, secret;
    };
    std::vector<double> v;
    std::vector<std::string> labels;
    std::print("\n| prime | exact order | target exponent | actual trial divisors | actual linear digit tests " "| actual external power calls |\n| ---: | ---: | ---: | ---: | ---: | ---: |\n");
    for (auto c : std::vector<Case>{{13, 2, 12, 3}, {1009, 11, 1008, 777},
                                    {1019, 2, 1018, 777}}) {
        auto r =
            dm::algorithms::pohlig_hellman_run(c.g,
                                               dm::algorithms::mod_pow(c.g,
                                                                       c.secret,
                                                                       c.p),
                                               c.p, c.order);
        labels.push_back(std::format("p={}", c.p));
        v.push_back(r.work.small_log_tests);
        std::print("| {} | {} | {} | {} | {} | {} |\n", c.p, c.order, c.secret,
                   r.work.factor_trials, r.work.small_log_tests,
                   r.work.power_calls);
    }
    auto p =
        dm::graphics::RPlot::barplot(v, labels,
                                     "actual linear digit comparisons");
    p.title("Native Pohlig digit work depends on subgroup primes and target digits").x_label("explicit finite-field fixture").y_label("actual candidate equality tests");
    p.save_svg("build/pohlig_hellman_work.svg");
}
```
