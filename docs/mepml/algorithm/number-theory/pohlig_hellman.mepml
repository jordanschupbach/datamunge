> Explicit controls

```{cpp, results="markdown", file="figures/pohlig_hellman_controls.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
    std::filesystem::create_directories("build");

    std::vector<double> values;
    std::vector<std::string> labels;
    std::print("\n| exact-order case | actual returned exponent | verified |\n| --- | ---: | --- |\n");
    for (std::uint64_t secret : {0ULL, 1ULL, 3ULL, 11ULL}) {
        const auto target = dm::algorithms::mod_pow(2, secret, 13);
        auto r = dm::algorithms::pohlig_hellman_run(2, target, 13, 12);
        labels.push_back(std::to_string(secret));
        values.push_back(r.exponent);
        std::print("| secret{} | {} | {} |\n", secret, r.exponent,
                   r.found &&
                   dm::algorithms::mod_pow(2,
                                           static_cast<std::uint64_t>(r.exponent),
                                           13) == target);
    }
    bool rejected = false;
    try {
        dm::algorithms::pohlig_hellman_run(4, 4, 13, 12);
    } catch (const std::invalid_argument &) {
        rejected = true;
    }
    std::print("Declared12 rejected for base4, whose exact order is6: {}.\n",
               rejected);
    auto p =
        dm::graphics::RPlot::barplot(values, labels, "actual verified logarithm");
    p.title("Pohlig controls: exact base order and full-range digit representatives").x_label("constructed exponent").y_label("actual verified exponent");
    p.save_svg("build/pohlig_hellman_controls.svg");
}
```
