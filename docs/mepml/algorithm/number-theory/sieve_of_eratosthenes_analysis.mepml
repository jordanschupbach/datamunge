> Explicit controls

```{cpp, results="markdown", file="figures/sieve_of_eratosthenes_controls.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <filesystem>
#include <print>
#include <algorithm>
#include <cmath>
#include <limits>
#include <numeric>
#include <numbers>
#include <random>
#include <string>
#include <vector>
#include <map>
#include <set>
#include <array>
#include <tuple>
#include <bit>
#include <datamunge/random/quality.hpp>
#include <datamunge/algorithms/sieve_of_eratosthenes.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    std::vector<double> x, y;
    std::print("| inclusive n | mask bits | actual primes | strikes |\n| ---: | ---: | --- | ---: |\n");
    for (std::uint64_t n : {0, 1, 2, 3, 4, 9, 25}) {
        auto r = a::prime_sieve_run(n);
        std::print("| {} | {} | `{}` | {} |\n", n, r.mask.size(), r.primes,
                   r.strikes);
        x.push_back(n);
        y.push_back(r.strikes);
    }
    auto plot = g::RPlot::create();
    plot.lines(x, y, "actual values", {37, 99, 235}).points(x, y, {37, 99, 235},
                                                            4).title(
        "Inclusive bounds and prime squares").x_label("inclusive bound").y_label("actual strikes");
    plot.save_svg("build/sieve_of_eratosthenes_controls.svg");
}
```
