> Actual selected work and sensitivity

```{cpp, results="markdown", file="figures/sieve_of_eratosthenes_work.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <filesystem>
#include <print>
#include <algorithm>
#include <cmath>
#include <limits>
#include <numeric>
#include <numbers>
#include <random>
#include <string>
#include <vector>
#include <map>
#include <set>
#include <array>
#include <tuple>
#include <bit>
#include <datamunge/random/quality.hpp>
#include <datamunge/algorithms/sieve_of_eratosthenes.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    std::vector<double> x, y, z;
    std::print("| original n | pi(n) | n/log(n) reference | ratio | actual strikes |\n| ---: | ---: | ---: " "| ---: | ---: |\n");
    for (std::uint64_t n : {10, 100, 1000, 10000}) {
        auto r = a::prime_sieve_run(n);
        const double reference = n / std::log(double(n));
        std::print("| {} | {} | {} | {} | {} |\n", n, r.primes.size(),
                   reference, r.primes.size() / reference, r.strikes);
        x.push_back(n);
        y.push_back(r.primes.size());
        z.push_back(reference);
    }
    auto plot = g::RPlot::create();
    plot.lines(x, y, "actual prime counts", {37, 99, 235}).lines(
        x, z, "n/log(n) reference", {220, 38, 38}).title(
        "Original prime-counting comparisons").x_label("inclusive n").y_label(
        "prime count or reference");
    plot.save_svg("build/sieve_of_eratosthenes_work.svg");
}
```
