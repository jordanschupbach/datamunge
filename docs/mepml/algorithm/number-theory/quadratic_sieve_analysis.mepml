> The retained original experiment

```{cpp, results="markdown", file="figures/quadratic_sieve_original.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <datamunge/plot/plot.hpp>
#include <datamunge/plot/diagram.hpp>
#include <datamunge/algorithms/modular_exponentiation.hpp>
#include <datamunge/algorithms/integer_arithmetic.hpp>
#include <filesystem>
#include <print>
#include <algorithm>
#include <cmath>
#include <limits>
#include <climits>
#include <datamunge/algorithms/number_theory.hpp>
#include <numeric>
#include <numbers>
#include <random>
#include <string>
#include <vector>
#include <map>
#include <set>
#include <array>
#include <tuple>
#include <datamunge/algorithms/prufer.hpp>
#include <datamunge/algorithms/flow_diagram.hpp>
#include <datamunge/geometry/hull_algorithms.hpp>
#include <datamunge/random/sampling_analysis.hpp>
#include <iomanip>
#include <bit>
#include <datamunge/algorithms/quadratic_sieve.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");

    const std::vector<std::uint64_t> inputs{1000003ULL * 1000033ULL,
                                            15485863ULL * 15485867ULL,
                                            4000037ULL * 7999993ULL,
                                            32452843ULL * 49979687ULL};
    std::vector<double> values;
    std::vector<std::string> labels;
    std::print("\n| original semiprime | actual factor | complementary factor | found | smooth relations | " "actual windows | actual sieved values |\n| ---: | ---: | ---: | --- | ---: | ---: | ---: " "|\n");
    for (auto n : inputs) {
        auto r = a::quadratic_sieve_run(n);
        values.push_back(r.sieve_values);
        labels.push_back(std::to_string(n));
        std::print("| {} | {} | {} | {} | {} | {} | {} |\n", n, r.factor,
                   n / r.factor, r.found, r.smooth_relations, r.windows,
                   r.sieve_values);
    }
    auto p =
        g::RPlot::barplot(values, labels, "actual allocated/sieved Q values");
    p.title("Original four semiprimes: actual native sieve work").x_label(
        "original uint64 semiprime").y_label("actual Q values");
    p.save_svg("build/quadratic_sieve_original.svg");
}
