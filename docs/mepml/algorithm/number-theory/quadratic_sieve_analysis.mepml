> Actual selected work and sensitivity

```{cpp, results="markdown", file="figures/quadratic_sieve_work.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <datamunge/plot/plot.hpp>
#include <datamunge/plot/diagram.hpp>
#include <datamunge/algorithms/modular_exponentiation.hpp>
#include <datamunge/algorithms/integer_arithmetic.hpp>
#include <filesystem>
#include <print>
#include <algorithm>
#include <cmath>
#include <limits>
#include <climits>
#include <datamunge/algorithms/number_theory.hpp>
#include <numeric>
#include <numbers>
#include <random>
#include <string>
#include <vector>
#include <map>
#include <set>
#include <array>
#include <tuple>
#include <datamunge/algorithms/prufer.hpp>
#include <datamunge/algorithms/flow_diagram.hpp>
#include <datamunge/geometry/hull_algorithms.hpp>
#include <datamunge/random/sampling_analysis.hpp>
#include <iomanip>
#include <bit>
#include <datamunge/algorithms/quadratic_sieve.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");

    std::vector<double> x, y;
    std::print("\n| explicit base bound | actual base size | actual windows | actual smooth relations | " "actual divisions | factor found |\n| ---: | ---: | ---: | ---: | ---: | --- |\n");
    for (unsigned bound : {60, 120, 240, 480}) {
        a::QuadraticSieveOptions o;
        o.factor_base_bound = bound;
        auto r = a::quadratic_sieve_run(1000003ULL * 1000033ULL, o);
        x.push_back(bound);
        y.push_back(r.divisions);
        std::print("| {} | {} | {} | {} | {} | {} |\n", bound,
                   r.factor_base.size(), r.windows, r.smooth_relations,
                   r.divisions, r.found);
    }
    auto p = g::RPlot::create();
    p.lines(x, y, "actual prime division updates", {16, 122, 87}).points(
        x, y, {16, 122, 87}, 5).title("Fixed semiprime: factor-base policy changes real work").x_label("explicit factor-base bound").y_label("actual exact prime divisions");
    p.save_svg("build/quadratic_sieve_work.svg");
}
