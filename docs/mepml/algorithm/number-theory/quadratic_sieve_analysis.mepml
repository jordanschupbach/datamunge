> Explicit controls

```{cpp, results="markdown", file="figures/quadratic_sieve_controls.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <datamunge/plot/plot.hpp>
#include <datamunge/plot/diagram.hpp>
#include <datamunge/algorithms/modular_exponentiation.hpp>
#include <datamunge/algorithms/integer_arithmetic.hpp>
#include <filesystem>
#include <print>
#include <algorithm>
#include <cmath>
#include <limits>
#include <climits>
#include <datamunge/algorithms/number_theory.hpp>
#include <numeric>
#include <numbers>
#include <random>
#include <string>
#include <vector>
#include <map>
#include <set>
#include <array>
#include <tuple>
#include <datamunge/algorithms/prufer.hpp>
#include <datamunge/algorithms/flow_diagram.hpp>
#include <datamunge/geometry/hull_algorithms.hpp>
#include <datamunge/random/sampling_analysis.hpp>
#include <iomanip>
#include <bit>
#include <datamunge/algorithms/quadratic_sieve.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");

    a::QuadraticSieveOptions o;
    o.factor_base_bound = 3;
    o.max_windows = 0;
    std::vector<std::uint64_t> inputs{2, 3, 49, 77, 101};
    std::vector<double> values;
    std::vector<std::string> labels;
    std::print("\n| input | actual attempted factor | found | zero-window budget |\n| ---: | ---: | --- | " "---: |\n");
    for (auto n : inputs) {
        auto r = a::quadratic_sieve_run(n, o);
        values.push_back(r.found ? 1 : 0);
        labels.push_back(std::to_string(n));
        std::print("| {} | {} | {} | {} |\n", n, r.factor, r.found, r.windows);
    }
    bool bad = false;
    try {
        a::quadratic_sieve(1);
    } catch (const std::invalid_argument &) {
        bad = true;
    }
    std::print("n=1 rejected before logarithmic/sieve arithmetic: {}.\n", bad);
    auto p =
        g::RPlot::barplot(values, labels, "actual nontrivial factor found");
    p.title("Shortcuts and zero search budget have distinct meanings").y_label(
        "found flag (0 or 1)").y_limits(0, 1.2);
    p.save_svg("build/quadratic_sieve_controls.svg");
}
```
