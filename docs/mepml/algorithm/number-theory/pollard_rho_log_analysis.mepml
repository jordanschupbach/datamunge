> The retained original experiment

```{cpp, results="markdown", file="figures/pollard_rho_log_original.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <datamunge/plot/plot.hpp>
#include <datamunge/plot/diagram.hpp>
#include <datamunge/algorithms/modular_exponentiation.hpp>
#include <datamunge/algorithms/integer_arithmetic.hpp>
#include <filesystem>
#include <print>
#include <algorithm>
#include <cmath>
#include <limits>
#include <climits>
#include <datamunge/algorithms/number_theory.hpp>
#include <numeric>
#include <numbers>
#include <random>
#include <string>
#include <vector>
#include <datamunge/algorithms/discrete_log.hpp>
int main() {
    std::filesystem::create_directories("build");

    const std::uint64_t prime =
        104729, base =
        6, secret =
        31337, target = dm::algorithms::mod_pow(base, secret, prime);
    auto result =
        dm::algorithms::pollard_rho_log_run(base, target, prime, prime - 1);
    std::print("Original6^x={} mod104729: actual returned exponent{}, found{}. The declared104728 is an " "annihilating multiple, not the exact base order.\n",
               target, result.exponent, result.found);
    std::vector<double> x, y;
    std::print("\n| original prime | actual completed starts | actual mean Floyd iterations | original " "zero-based index mean |\n| ---: | ---: | ---: | ---: |\n");
    for (const auto &r : dm::algorithms::pollard_rho_log_collision_study()) {
        x.push_back(std::sqrt(static_cast<double>(r.declared_order)));
        y.push_back(r.mean_iterations);
        std::print("| {} | {} | {} | {} |\n", r.prime, r.collided,
                   r.mean_iterations, r.mean_legacy_index);
    }
    auto p = dm::graphics::RPlot::create();
    p.lines(x, y, "actual completed Floyd iterations", {37, 99, 235}).points(
        x, y, {37, 99, 235}, 5).title("Original six-prime first-collision experiment: actual native shared walks").x_label("sqrt(declared annihilating order)").y_label("mean actual completed Floyd iterations");
    p.save_svg("build/pollard_rho_log_original.svg");
}
```
