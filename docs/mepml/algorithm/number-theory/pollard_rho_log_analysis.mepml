> Explicit controls

```{cpp, results="markdown", file="figures/pollard_rho_log_controls.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <datamunge/plot/plot.hpp>
#include <datamunge/plot/diagram.hpp>
#include <datamunge/algorithms/modular_exponentiation.hpp>
#include <datamunge/algorithms/integer_arithmetic.hpp>
#include <filesystem>
#include <print>
#include <algorithm>
#include <cmath>
#include <limits>
#include <climits>
#include <datamunge/algorithms/number_theory.hpp>
#include <numeric>
#include <numbers>
#include <random>
#include <string>
#include <vector>
#include <datamunge/algorithms/discrete_log.hpp>
int main() {
    std::filesystem::create_directories("build");

    const std::uint64_t prime =
        104729, base =
        6, secret =
        31337, target =
        dm::algorithms::mod_pow(base, secret, prime), actual_order =
        dm::algorithms::element_order(base, prime);
    const auto canonical =
        dm::algorithms::pohlig_hellman_log(base, target, prime, actual_order);
    std::vector<std::uint64_t> exponents{secret,
                                         static_cast<std::uint64_t>(canonical),
                                         static_cast<std::uint64_t>(canonical) +
                                         actual_order};
    std::vector<double> v;
    std::vector<std::string> labels{"original secret", "native exact-order log",
                                    "one period later"};
    std::print("Native exact base order{}.\n| representative | exponent | actual equation verified |\n| --- " "| ---: | --- |\n",
               actual_order);
    for (std::size_t i = 0; i < exponents.size(); ++i) {
        v.push_back(exponents[i]);
        std::print("| {} | {} | {} |\n", labels[i], exponents[i],
                   dm::algorithms::mod_pow(base, exponents[i], prime) == target);
    }
    auto p =
        dm::graphics::RPlot::barplot(v, labels,
                                     "distinct verified exponent representatives");
    p.title("Original base6 has order5512: a verified logarithm does not identify a unique secret").y_label("verified exponent representative");
    p.save_svg("build/pollard_rho_log_controls.svg");
}
```
// result_begin: markdown
Native exact base order5512.
| representative | exponent | actual equation verified |
| --- | ---: | --- |
