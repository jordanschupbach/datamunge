> Actual selected work

```{cpp, results="markdown", file="figures/pollard_rho_log_work.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <datamunge/plot/plot.hpp>
#include <datamunge/plot/diagram.hpp>
#include <datamunge/algorithms/modular_exponentiation.hpp>
#include <datamunge/algorithms/integer_arithmetic.hpp>
#include <filesystem>
#include <print>
#include <algorithm>
#include <cmath>
#include <limits>
#include <climits>
#include <datamunge/algorithms/number_theory.hpp>
#include <numeric>
#include <numbers>
#include <random>
#include <string>
#include <vector>
#include <datamunge/algorithms/discrete_log.hpp>
int main() {
    std::filesystem::create_directories("build");

    const auto target = dm::algorithms::mod_pow(2, 17, 1019);
    auto r = dm::algorithms::pollard_rho_log_run(2, target, 1019, 1018);
    std::vector<std::string> labels{"cursor updates", "collisions",
                                    "candidate tests", "power calls"};
    std::vector<double> raw{double(r.work.walk_updates),
                            double(r.work.collisions),
                            double(r.work.candidate_tests),
                            double(r.work.power_calls)}, shown = raw;
    std::print("\n| actual selected event | actual raw count |\n| --- | ---: |\n");
    for (std::size_t i = 0; i < raw.size(); ++i) {
        std::print("| {} | {} |\n", labels[i], raw[i]);
        shown[i] = std::log10(raw[i] + 1);
    }
    auto p =
        dm::graphics::RPlot::barplot(shown, labels,
                                     "actual selected work, logarithmic display");
    p.title("Native rho-log solver: actual cursor, collision and verification work").y_label("log10(actual selected count + 1)");
    p.save_svg("build/pollard_rho_log_work.svg");
}
```
