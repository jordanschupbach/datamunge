> Explicit controls

```{cpp, results="markdown", file="figures/pollard_kangaroo_controls.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <datamunge/plot/plot.hpp>
#include <datamunge/plot/diagram.hpp>
#include <datamunge/algorithms/modular_exponentiation.hpp>
#include <datamunge/algorithms/integer_arithmetic.hpp>
#include <filesystem>
#include <print>
#include <algorithm>
#include <cmath>
#include <limits>
#include <climits>
#include <datamunge/algorithms/number_theory.hpp>
#include <numeric>
#include <numbers>
#include <random>
#include <string>
#include <vector>
#include <datamunge/algorithms/pollard_kangaroo.hpp>
int main() {
    std::filesystem::create_directories("build");

    const auto target = dm::algorithms::mod_pow(2, 7, 1019);
    std::vector<std::string> labels{"lower endpoint", "upper endpoint",
                                    "empty interval", "zero attempts"};
    std::vector<dm::algorithms::KangarooRun> runs;
    runs.push_back(dm::algorithms::pollard_kangaroo_run(2, target, 1019, 7, 9));
    runs.push_back(dm::algorithms::pollard_kangaroo_run(2, target, 1019, 5, 7));
    runs.push_back(dm::algorithms::pollard_kangaroo_run(2, target, 1019, 9, 8));
    dm::algorithms::KangarooOptions no;
    no.max_attempts = 0;
    runs.push_back(dm::algorithms::pollard_kangaroo_run(2, target, 1019, 5, 9,
                                                        0x2545F4914F6CDD1DULL,
                                                        no));
    std::vector<double> v;
    std::print("\n| case | actual verified found | actual jumps | actual attempts |\n| --- | --- | ---: | " "---: |\n");
    for (std::size_t i = 0; i < runs.size(); ++i) {
        auto &r = runs[i];
        v.push_back(r.result.found);
        std::print("| {} | {} | {} | {} |\n", labels[i], r.result.found,
                   r.result.jumps, r.attempts);
    }
    auto p =
        dm::graphics::RPlot::barplot(v, labels, "actual verified found flag");
    p.title("Kangaroo endpoints can verify without any actual walk jumps").y_label("actual verified result (1=yes)");
    p.save_svg("build/pollard_kangaroo_controls.svg");
}
```
