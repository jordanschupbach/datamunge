> Exact exponent distances at the uint64 boundary

```{cpp, results="markdown", file="figures/pollard_kangaroo_work.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <datamunge/plot/plot.hpp>
#include <datamunge/plot/diagram.hpp>
#include <datamunge/algorithms/modular_exponentiation.hpp>
#include <datamunge/algorithms/integer_arithmetic.hpp>
#include <filesystem>
#include <print>
#include <algorithm>
#include <cmath>
#include <limits>
#include <climits>
#include <datamunge/algorithms/number_theory.hpp>
#include <numeric>
#include <numbers>
#include <random>
#include <string>
#include <vector>
#include <datamunge/algorithms/pollard_kangaroo.hpp>
int main() {
    std::filesystem::create_directories("build");

    const auto top =
        std::numeric_limits<std::uint64_t>::max(), secret =
        top - 10, target = dm::algorithms::mod_pow(2, secret, 1019);
    auto t =
        dm::algorithms::pollard_kangaroo_trace(2, target, 1019, top - 20, top);
    std::vector<double> x, y;
    std::print("\n| actual tame jump | exact assigned trail exponent | exact excess above UINT64_MAX |\n| " "---: | --- | --- |\n");
    for (std::size_t i = 0; i < std::min<std::size_t>(6, t.jumps.size()); ++i) {
        auto &r = t.jumps[i];
        const auto excess =
            r.trail_exponent_after - static_cast<unsigned __int128>(top);
        x.push_back(i + 1);
        y.push_back(static_cast<double>(excess));
        std::print("| {} | {} | {} |\n", i + 1,
                   dm::algorithms::uint128_text(r.trail_exponent_after),
                   dm::algorithms::uint128_text(excess));
    }
    std::print("Actual final verification flag{}, candidate{}. Full values above are exact decimal; only " "small excesses are plotted.\n",
               t.run.result.found, t.run.result.x);
    auto p = dm::graphics::RPlot::create();
    p.lines(x, y, "actual widened trail excess", {37, 99, 235}).points(
        x, y, {37, 99, 235}, 4).title("Actual tame trail exponents remain exact above UINT64_MAX").x_label("actual tame jump ordinal").y_label("exact excess above UINT64_MAX (display double)");
    p.save_svg("build/pollard_kangaroo_work.svg");
}
```
