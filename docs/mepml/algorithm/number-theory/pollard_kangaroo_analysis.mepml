> The retained original experiment

```{cpp, results="markdown", file="figures/pollard_kangaroo_original.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <datamunge/plot/plot.hpp>
#include <datamunge/plot/diagram.hpp>
#include <datamunge/algorithms/modular_exponentiation.hpp>
#include <datamunge/algorithms/integer_arithmetic.hpp>
#include <filesystem>
#include <print>
#include <algorithm>
#include <cmath>
#include <limits>
#include <climits>
#include <datamunge/algorithms/number_theory.hpp>
#include <numeric>
#include <numbers>
#include <random>
#include <string>
#include <vector>
#include <datamunge/algorithms/pollard_kangaroo.hpp>
int main() {
    std::filesystem::create_directories("build");

    const std::uint64_t prime = 1000003, base = 2;
    std::print("\n| original exponent | lower | upper | actual found | actual returned x | actual jumps | " "verified equation |\n| ---: | ---: | ---: | --- | ---: | ---: | --- |\n");
    for (std::uint64_t secret : {123456ULL, 654321ULL, 999001ULL}) {
        const auto target =
            dm::algorithms::mod_pow(base, secret, prime), lo =
            secret > 20000 ? secret - 20000 : 0, hi = secret + 20000;
        auto r = dm::algorithms::pollard_kangaroo(base, target, prime, lo, hi);
        std::print("| {} | {} | {} | {} | {} | {} | {} |\n", secret, lo, hi,
                   r.found, r.x, r.jumps,
                   r.found &&
                   dm::algorithms::mod_pow(base, r.x, prime) == target);
    }
    std::vector<double> x, y;
    std::print("\n| original interval width | actual jumps | actual found |\n| ---: | ---: | --- |\n");
    for (std::uint64_t width : {2500ULL, 10000ULL, 40000ULL, 160000ULL,
                                640000ULL}) {
        const std::uint64_t secret =
            500000, target = dm::algorithms::mod_pow(base, secret, prime);
        auto r =
            dm::algorithms::pollard_kangaroo(base, target, prime,
                                             secret - width / 2,
                                             secret + width / 2);
        x.push_back(std::sqrt(static_cast<double>(width)));
        y.push_back(r.jumps);
        std::print("| {} | {} | {} |\n", width, r.jumps, r.found);
    }
    auto p = dm::graphics::RPlot::create();
    p.lines(x, y, "actual native jumps", {5, 150, 105}).points(x, y,
                                                               {5, 150, 105}, 5).title("Original kangaroo interval settings: actual finite-run jump counts").x_label("sqrt(requested interval width)").y_label("actual tame plus wild jumps");
    p.save_svg("build/pollard_kangaroo_original.svg");
}
```
