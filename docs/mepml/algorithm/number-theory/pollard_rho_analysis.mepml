> Explicit controls

```{cpp, results="markdown", file="figures/pollard_rho_controls.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <datamunge/plot/plot.hpp>
#include <datamunge/plot/diagram.hpp>
#include <datamunge/algorithms/modular_exponentiation.hpp>
#include <datamunge/algorithms/integer_arithmetic.hpp>
#include <filesystem>
#include <print>
#include <algorithm>
#include <cmath>
#include <limits>
#include <climits>
#include <datamunge/algorithms/number_theory.hpp>
#include <numeric>
#include <numbers>
#include <random>
#include <string>
#include <vector>
#include <datamunge/algorithms/pollard_rho.hpp>
int main() {
    std::filesystem::create_directories("build");

    std::vector<double> v;
    std::vector<std::string> labels;
    std::print("\n| input | actual splitter return | proper factor | actual polynomial evaluations |\n| ---: " "| ---: | --- | ---: |\n");
    for (std::uint64_t n : {0ULL, 1ULL, 2ULL, 17ULL, 8051ULL}) {
        auto t = dm::algorithms::pollard_rho_factor_trace(n);
        const bool proper = t.factor > 1 && t.factor < n && n % t.factor == 0;
        labels.push_back(std::to_string(n));
        v.push_back(t.work.evaluations);
        std::print("| {} | {} | {} | {} |\n", n, t.factor, proper,
                   t.work.evaluations);
    }
    auto p =
        dm::graphics::RPlot::barplot(v, labels, "actual polynomial evaluations");
    p.title("Brent splitter controls: small, even and prime inputs bypass the walk").x_label("native input").y_label("actual polynomial calls");
    p.save_svg("build/pollard_rho_controls.svg");
}
```
