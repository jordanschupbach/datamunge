> The retained original experiment

```{cpp, results="markdown", file="figures/pollard_rho_original.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <datamunge/plot/plot.hpp>
#include <datamunge/plot/diagram.hpp>
#include <datamunge/algorithms/modular_exponentiation.hpp>
#include <datamunge/algorithms/integer_arithmetic.hpp>
#include <filesystem>
#include <print>
#include <algorithm>
#include <cmath>
#include <limits>
#include <climits>
#include <datamunge/algorithms/number_theory.hpp>
#include <numeric>
#include <numbers>
#include <random>
#include <string>
#include <vector>
#include <datamunge/algorithms/pollard_rho.hpp>
int main() {
    std::filesystem::create_directories("build");

    std::print("\n| original input | actual prime factors |\n| ---: | --- |\n");
    for (std::uint64_t n : {8051ULL, 12ULL, 600851475143ULL, 1000000007ULL})
        std::print("| {} | `{}` |\n", n, dm::algorithms::factorize(n));
    const auto divisor = dm::algorithms::pollard_rho_factor(8051);
    std::print("Original8051 split, normalized actual pair: {} and {}.\n",
               std::min(divisor, 8051 / divisor),
               std::max(divisor, 8051 / divisor));
    auto walk = dm::algorithms::rho_polynomial_walk(8051, 1, 2, 16, 83);
    std::vector<double> x, y, tx, ty, cx, cy;
    std::print("Separate original forward-orbit fixture modulo hidden83: first-repeat head{}, period{}. " "This is not Brent cursor visitation.\n",
               walk.cycle_head, walk.period);
    std::print("\n| forward visit | actual x mod8051 | actual x mod83 |\n| ---: | ---: | ---: |\n");
    for (std::size_t i = 0; i < walk.states.size(); ++i) {
        x.push_back(i);
        y.push_back(walk.projected[i]);
        (i < walk.cycle_head ? tx : cx).push_back(i);
        (i < walk.cycle_head ? ty : cy).push_back(walk.projected[i]);
        std::print("| {} | {} | {} |\n", i, walk.states[i], walk.projected[i]);
    }
    auto p = dm::graphics::RPlot::create();
    p.lines(x, y, "actual forward prefix", {156, 163, 175}, 1);
    if (!tx.empty())
        p.points(tx, ty, "actual transient", {37, 99, 235}, 5);
    if (!cx.empty())
        p.points(cx, cy, std::format("actual cycle, period{}", walk.period),
                 {220, 38, 38}, 5);
    p.title("Separate original polynomial orbit: actual projection modulo83").x_label("forward-orbit visit index").y_label("actual residue mod83");
    p.save_svg("build/pollard_rho_original.svg");
}
```
