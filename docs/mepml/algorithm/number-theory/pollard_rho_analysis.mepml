> Full-width polynomial addition controls

```{cpp, results="markdown", file="figures/pollard_rho_work.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <datamunge/plot/plot.hpp>
#include <datamunge/plot/diagram.hpp>
#include <datamunge/algorithms/modular_exponentiation.hpp>
#include <datamunge/algorithms/integer_arithmetic.hpp>
#include <filesystem>
#include <print>
#include <algorithm>
#include <cmath>
#include <limits>
#include <climits>
#include <datamunge/algorithms/number_theory.hpp>
#include <numeric>
#include <numbers>
#include <random>
#include <string>
#include <vector>
#include <datamunge/algorithms/pollard_rho.hpp>
int main() {
    std::filesystem::create_directories("build");

    const auto top = std::numeric_limits<std::uint64_t>::max();
    std::vector<double> v;
    std::vector<std::string> labels;
    std::print("\n| modulus | actual starting residue | c | actual next residue |\n| ---: | ---: | ---: | " "---: |\n");
    for (std::uint64_t n : std::vector<std::uint64_t>{8051, top, top - 58}) {
        auto t = dm::algorithms::rho_polynomial_walk(n, n - 1, n - 100, 2);
        labels.push_back(n == 8051 ? "8051" : n == top ? "UINT64_MAX"
                         : "UINT64_MAX-58");
        v.push_back(t.states[1]);
        std::print("| {} | {} | {} | {} |\n", n, t.states[0], n - 1, t.states[1]);
    }
    auto p =
        dm::graphics::RPlot::barplot(v, labels, "actual exact next residue");
    p.title("The same native polynomial keeps addition carry at the full uint64 range").x_label("explicit modulus fixture").y_label("actual next residue");
    p.save_svg("build/pollard_rho_work.svg");
}
```
