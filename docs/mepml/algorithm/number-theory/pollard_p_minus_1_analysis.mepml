> Actual selected work

```{cpp, results="markdown", file="figures/pollard_p_minus_1_work.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
    std::filesystem::create_directories("build");

    std::vector<double> v;
    std::vector<std::string> labels;
    std::print("\n| requested bound B | actual powering/gcd stages | actual proper divisor |\n| ---: | ---: | " "---: |\n");
    for (std::uint64_t bound : {0ULL, 1ULL, 2ULL, 3ULL, 4ULL, 8ULL, 20ULL}) {
        auto r = dm::algorithms::pollard_p_minus_one_run(391, bound);
        labels.push_back(std::to_string(bound));
        v.push_back(r.stages);
        std::print("| {} | {} | {} |\n", bound, r.stages, r.divisor);
    }
    auto p =
        dm::graphics::RPlot::barplot(v, labels,
                                     "actual executed factorial stages");
    p.title("An early proper gcd stops the actual native work before the requested bound").x_label("requested B").y_label("actual powering/gcd pairs");
    p.save_svg("build/pollard_p_minus_1_work.svg");
}
```
