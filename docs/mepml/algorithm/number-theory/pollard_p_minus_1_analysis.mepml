> Explicit controls

```{cpp, results="markdown", file="figures/pollard_p_minus_1_controls.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
    std::filesystem::create_directories("build");

    struct Case {
        std::uint64_t n, bound;
        const char *name;
    };
    std::vector<double> v;
    std::vector<std::string> labels;
    std::print("\n| case | actual divisor | actual stages | full collapse | small-prime shortcut |\n| --- | " "---: | ---: | --- | --- |\n");
    for (auto c : std::vector<Case>{{391, 3, "391/B3"}, {391, 4, "391/B4"},
                                    {85, 4, "85 collapse"}, {14, 20, "even14"},
                                    {2, 20, "prime2"}}) {
        auto r = dm::algorithms::pollard_p_minus_one_run(c.n, c.bound);
        v.push_back(r.divisor != 0);
        labels.push_back(c.name);
        std::print("| {} | {} | {} | {} | {} |\n", c.name, r.divisor, r.stages,
                   r.stop == dm::algorithms::PMinusOneStop::Collapsed,
                   r.stop == dm::algorithms::PMinusOneStop::SmallPrime);
    }
    auto p =
        dm::graphics::RPlot::barplot(v, labels, "actual proper factor found");
    p.title("Factorial p-minus-one controls: exponent multiplicity and full collapse").y_label("actual proper divisor found (1=yes)");
    p.save_svg("build/pollard_p_minus_1_controls.svg");
}
```
