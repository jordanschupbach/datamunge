> The retained original experiment

```{cpp, results="markdown", file="figures/pollard_p_minus_1_original.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
    std::filesystem::create_directories("build");

    const std::uint64_t smooth = 1009ULL * 2003, safe = 2039ULL * 2063;
    std::print("\n| original modulus | B | actual proper divisor (zero = unresolved) |\n| ---: | ---: | ---: " "|\n| {} | 20 | {} |\n| {} | 50 | {} |\n| {} | 1100 | {} |\n",
               smooth, dm::algorithms::pollard_p_minus_1(smooth, 20), safe,
               dm::algorithms::pollard_p_minus_1(safe, 50), safe,
               dm::algorithms::pollard_p_minus_1(safe, 1100));
    std::vector<double> x, a, b;
    std::print("\n| B | actual smooth-case factor | actual safe-case factor |\n| ---: | ---: | ---: |\n");
    for (std::uint64_t bound = 2; bound <= 40; ++bound) {
        auto f =
            dm::algorithms::pollard_p_minus_1(smooth, bound), g =
            dm::algorithms::pollard_p_minus_1(safe, bound);
        x.push_back(bound);
        a.push_back(f != 0);
        b.push_back(g != 0);
        if (bound % 4 == 0)
            std::print("| {} | {} | {} |\n", bound, f, g);
    }
    auto p = dm::graphics::RPlot::create();
    p.lines(x, a, "1009*2003", {5, 150, 105}).points(x, a, {5, 150, 105}, 4).lines(x, b, "2039*2063", {220, 38, 38}).points(x, b, {220, 38, 38}, 3).title("Original fixed-base factorial schedule: actual success over requested B").x_label("inclusive factorial multiplier bound B").y_label("actual proper divisor found (1=yes)");
    p.save_svg("build/pollard_p_minus_1_original.svg");
}
```
