> The retained original experiment

```{cpp, results="markdown", file="figures/rounding_functions_original.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    const auto ties = a::rounding_example_ties();
    auto even =
        a::rounding_trace(ties, a::RoundMode::HalfToEven), up =
        a::rounding_trace(ties, a::RoundMode::HalfUp);
    std::print("| original scalar | half-even | half-away | half-up |\n| ---: | ---: | ---: | ---: |\n");
    for (double x : {.5, 1.5, 2.5, 3.5, -.5, -1.5})
        std::print("| {} | {} | {} | {} |\n", x, a::round_half_to_even(x),
                   a::round_half_away_from_zero(x), a::round_half_up(x));
    std::print("\nOriginal positive ties {}, actual half-even mean {}, half-up mean {}.\n\n| actual prefix " "size | half-even running mean | half-up running mean |\n| ---: | ---: | ---: |\n",
               ties.size(), even.mean_error, up.mean_error);
    std::vector<double> x, e, u;
    for (std::size_t i = 0; i < ties.size(); ++i) {
        std::print("| {} | {} | {} |\n", i + 1, even.steps[i].mean_error,
                   up.steps[i].mean_error);
        x.push_back(i + 1);
        e.push_back(even.steps[i].mean_error);
        u.push_back(up.steps[i].mean_error);
    }
    auto p = g::RPlot::create();
    p.lines(x, e, "actual half-even prefix mean", {37, 99, 235}).lines(
        x, u, "actual half-up prefix mean", {234, 88, 12}).title(
        "Original 60 positive ties: actual signed-error means").x_label(
        "actual observed prefix size").y_label("mean rounded-minus-input error");
    p.save_svg("build/rounding_functions_original.svg");
}
```
