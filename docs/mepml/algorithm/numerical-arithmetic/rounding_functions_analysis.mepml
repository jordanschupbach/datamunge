> Explicit controls

```{cpp, results="markdown", file="figures/rounding_functions_controls.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    const std::vector<double> values{std::nextafter(.5, 0.), .5,
                                     std::nextafter(.5, 1.),
                                     std::nextafter(-.5, 0.), -.5,
                                     std::nextafter(-.5, -1.)};
    auto t = a::rounding_trace(values, a::RoundMode::HalfDown);
    std::print("| original float | widened fraction | actual tie | half-down output |\n| ---: | ---: | --- " "| ---: |\n");
    std::vector<double> x, y;
    for (std::size_t i = 0; i < values.size(); ++i) {
        const auto &s = t.steps[i];
        std::print("| {:.17g} | {:.20g} | {} | {} |\n", s.input, s.fraction,
                   s.tie, s.rounded);
        x.push_back(i);
        y.push_back(s.rounded);
    }
    bool rejected = false;
    try {
        a::rounding_run({std::numeric_limits<double>::quiet_NaN()},
                        a::RoundMode::HalfUp);
    } catch (const std::invalid_argument &) {
        rejected = true;
    }
    std::print("Nonfinite summary observation rejected: {}; scalar infinity propagates: {}.\n",
               rejected,
               a::round_half_to_even(std::numeric_limits<double>::infinity()));
    if (!rejected || t.steps[3].tie || t.rounded[3] != 0)
        return 1;
    auto p = g::RPlot::create();
    p.points(x, y, {37, 99, 235}, 6).title("Adjacent represented floats are not all half-integer ties").x_label("listed control input index").y_label("actual half-down output");
    p.save_svg("build/rounding_functions_controls.svg");
}
```
