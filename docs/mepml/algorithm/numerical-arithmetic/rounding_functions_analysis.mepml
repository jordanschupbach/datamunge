> Actual selected work and sensitivity

```{cpp, results="markdown", file="figures/rounding_functions_work.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    auto values = a::rounding_example_ties();
    std::vector<double> x, y;
    std::vector<std::string> labels;
    std::print("| rule | actual ties | observed mean error |\n| --- | ---: | ---: |\n");
    for (auto mode : {a::RoundMode::HalfToEven, a::RoundMode::HalfAwayFromZero,
                      a::RoundMode::HalfUp, a::RoundMode::HalfDown,
                      a::RoundMode::TowardZero, a::RoundMode::Ceil,
                      a::RoundMode::Floor}) {
        auto t = a::rounding_run(values, mode);
        std::print("| {} | {} | {} |\n", a::round_mode_name(mode), t.ties,
                   t.mean_error);
        x.push_back(x.size());
        y.push_back(t.mean_error);
        labels.emplace_back(a::round_mode_name(mode));
    }
    labels = {"even", "away", "up", "down", "trunc", "ceil", "floor"};
    auto p = g::RPlot::create();
    p.bars(x, y, "actual mean on same 60 positive ties", {22, 163, 74}, .8).x_ticks(x, labels).title("Same observed sample under seven rounding rules").x_label("rounding rule (full names in table)").y_label("observed signed mean error");
    p.save_svg("build/rounding_functions_work.svg");
}
```
