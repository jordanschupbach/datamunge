> Rank a controlled typo in actual Titanic names

The canonical Titanic DataFrame contains891 passenger rows. Its Name column
comes from the
[documented source CSV|https://raw.githubusercontent.com/datasciencedojo/datasets/master/titanic.csv].
All891 Name bytes and their order were checked against both the repository CSV
and that upstream source. The query Braund, Mr. Oewn Harris deliberately swaps
two letters in the name on original row zero. This creates one known source
record by construction; it does not provide a labelled entity-resolution test
set or assess false-link rates.

The native ranking helper admits the complete candidate count and total query
plus all-name bytes before scoring. It scores every candidate once, then sorts
by the actual computed refined score, breaking exact score ties by original row
index. Equal printed decimals need not be exact computed ties. Returning eight
rows does not mean it only inspected eight input names. No punctuation/title
handling, case folding, tokenization or probabilistic calibration is fitted.

```{cpp, results="markdown", file="figures/jaro_titanic.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
    std::filesystem::create_directories("build");

    const auto passengers = dm::datasets::titanic();
    const auto &names = passengers.get_column<std::string>("Name").values();
    if (names.at(0) != "Braund, Mr. Owen Harris")
        throw std::runtime_error("source row zero changed");
    const std::string query = "Braund, Mr. Oewn Harris";
    const auto rows = dm::algorithms::jaro_winkler_rank(names, query, 8);
    std::print("Query: {}. Complete candidates {}.\n", query, names.size());
    std::print("| rank | original row | candidate name | Jaro | Winkler | prefix bytes |\n| ---: | ---: | " "--- | ---: | ---: | ---: |\n");
    std::vector<double> ranks, jaro, winkler;
    for (std::size_t i = 0; i < rows.size(); ++i) {
        const auto &row = rows[i];
        std::print("| {} | {} | {} | {:.12f} | {:.12f} | {} |\n", i + 1,
                   row.index, row.value, row.score.jaro, row.score.winkler,
                   row.score.prefix);
        ranks.push_back(double(i + 1));
        jaro.push_back(row.score.jaro);
        winkler.push_back(row.score.winkler);
    }
    if (rows.front().index != 0)
        throw std::runtime_error("controlled typo did not recover source first");
    bool cap = false;
    try {
        (void) dm::algorithms::jaro_winkler_rank(names, query, 1, .1, {890, 0});
    } catch (const std::length_error &) {
        cap = true;
    }
    std::print("Returning one result still rejects a complete candidate cap of890: {}.\n",
               cap);
    if (!cap)
        throw std::runtime_error("incomplete ranking admission");
    auto p = dm::graphics::RPlot::create();
    p.points(ranks, jaro, "Jaro", {35, 95, 210}, 8).points(ranks, winkler,
                                                           "Winkler",
                                                           {210, 55, 40}, 5).legend({"Jaro", "unconditional Winkler"}, {{35, 95, 210}, {210, 55, 40}}).title("Controlled Titanic typo: top eight actual ranked name scores").x_label("rank, ordered by computed Winkler score").y_label("byte similarity, not identity probability").ylim(.6, 1.15).save_svg("build/jaro_titanic.svg");
}
```
