> Original pair results and kitten/sitting table

Retain kitten/sitting, flaw/lawn, saturday/sunday, book/back, empty/abc and
distance/distance. Their scalar results below come directly from the canonical
API. For the original detailed pair, actual rows are sitting and columns kitten,
because the shorter string occupies rolling-row columns. This transpose of the
old display preserves the exact symmetric distance while showing the real
producer orientation. The figure overlays the additional native optimal path
onto actual row snapshots. No report-side DP or traceback reconstruction
remains.

The familiar three-edit kitten→sitten→sittin→sitting script explains the cost3;
the displayed native path is in the explicit sitting-row/kitten-column
orientation and need not be that same forward textual script.

```{cpp, results="markdown", file="figures/levenshtein_original.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
    std::filesystem::create_directories("build");
    std::print("| original first bytes | original second bytes | actual scalar distance |\n| --- | --- | " "---: |\n");
    for (auto[a, b] : std::vector<std::pair<std::string, std::string>>{
         {"kitten", "sitting"}, {"flaw", "lawn"}, {"saturday", "sunday"},
         {"book", "back"}, {"", "abc"}, {"distance", "distance"}
     })
        std::print("| {} | {} | {} |\n", a.empty() ? "empty" : a, b,
                   dm::algorithms::levenshtein_distance(a, b));
    auto t = dm::algorithms::levenshtein_trace("kitten", "sitting");
    std::print("\nActual row bytes {}; actual column bytes {}.\n\n| actual row prefix | empty | k | i | t | " "t | e | n |\n| ---: | ---: | ---: | ---: | ---: | ---: | ---: | ---: |\n",
               t.row_bytes, t.column_bytes);
    auto p = dm::graphics::RPlot::create();
    for (std::size_t i = 0; i < t.table.size(); ++i) {
        std::print("| {} |", i);
        for (std::size_t j = 0; j < t.table[i].size(); ++j) {
            std::print(" {} |", t.table[i][j]);
            p.text(j, -double(i), std::to_string(t.table[i][j]), {31, 41, 55},
                   12);
        }
        std::print("\n");
    }
    std::vector<double> x, y;
    for (auto &e : t.path) {
        x.push_back(e.column);
        y.push_back(-double(e.row));
    }
    x.push_back(0);
    y.push_back(0);
    p.line(x, y, "native optimal path", {220, 38, 38}, 2);
    for (std::size_t j = 0; j < t.column_bytes.size(); ++j)
        p.text(j + 1, .7, t.column_bytes.substr(j, 1), {37, 99, 235}, 14);
    for (std::size_t i = 0; i < t.row_bytes.size(); ++i)
        p.text(-.6, -double(i + 1), t.row_bytes.substr(i, 1), {22, 163, 74}, 14);
    p.size(850, 850).x_limits(-1.5, 7.5).y_limits(-8, 2).title(
        "Actual rolling-row snapshots, additional native path").x_label(
        "kitten prefix length").y_label("negative sitting prefix length").save_svg("build/levenshtein_original.svg");
}
```
