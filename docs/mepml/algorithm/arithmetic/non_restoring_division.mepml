> Retain all four original divisions

The original pairs217/13,100/7,1000000/999 and(2⁶⁴−1)/3 are preserved. The table
compares their exact native results with built-in unsigned division and
remainder. The plotted signed register history belongs to the original217/13
run, with all64 actual stages included. Conversion to double occurs only for
that display; exact signed values remain available in the native records and
decimal formatter.

```{cpp, results="markdown", file="figures/nonrestoring_original.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
    std::filesystem::create_directories("build");
    std::print("| dividend | divisor | actual quotient | actual remainder | built-in quotient | built-in " "remainder |\n| ---: | ---: | ---: | ---: | ---: | ---: |\n");
    for (auto[n, d] : dm::algorithms::nonrestoring_demo_pairs()) {
        auto r = dm::algorithms::non_restoring_divide(n, d);
        std::print("| {} | {} | {} | {} | {} | {} |\n", n, d, r.quotient,
                   r.remainder, n / d, n % d);
    }
    auto t = dm::algorithms::non_restoring_division_trace(217, 13);
    std::vector<double> x, y;
    for (std::size_t i = 0; i < t.steps.size(); ++i) {
        x.push_back(i + 1);
        y.push_back(dm::algorithms::division_wide_approximation(t.steps[i].after));
    }
    auto p = dm::graphics::RPlot::create();
    p.lines(x, y, "actual signed A", {36, 105, 172}).points(x, y, "",
                                                            {36, 105, 172}, 3).abline_h(0, {148, 163, 184}, 1).title("Original217 / 13: actual post-stage signed remainder").x_label("actual completed bit stages").y_label("signed A before final correction").save_svg("build/nonrestoring_original.svg");
    std::print("\nActual final A before correction `{}`, after `{}`; extra addition {}.\n",
               dm::algorithms::division_wide_decimal(t.final_before),
               dm::algorithms::division_wide_decimal(t.final_after),
               t.final_corrected);
}
