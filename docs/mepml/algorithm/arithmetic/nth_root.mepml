\alttext(The exact hand reference is89/24; all displayed rounded values come from the native producer.)

> Retain the original known roots

The original checks are sqrt(2), cube-root27=3, tenth-root1024=2 and
cube-root1000=10. Their actual native values and update counts are computed
below. The error plot belongs to the default stopped a50/n3 run and compares
actual states with native cbrt(50). This is a useful library comparison, not an
independent exact oracle. The plotted log10(max(error,10⁻¹⁸)) has an explicit
display floor; zero printed difference does not establish a correctly rounded
answer for every input.

```{cpp, results="markdown", file="figures/nth_root_original.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
    std::filesystem::create_directories("build");
    std::vector<std::pair<double, int>> pairs{{2, 2}, {27, 3}, {1024, 10},
                                              {1000, 3}};
    std::vector<double> references{std::sqrt(2.), 3, 2, 10};
    std::print("| original radicand | degree | actual result | comparison reference | actual updates | " "state-change accepted |\n| ---: | ---: | ---: | ---: | ---: | --- |\n");
    for (std::size_t i = 0; i < pairs.size(); ++i) {
        auto[a, n] = pairs[i];
        auto r = dm::algorithms::nth_root_run(a, n);
        std::print("| {} | {} | {} | {} | {} | {} |\n", a, n, r.value,
                   references[i], r.updates, r.converged);
    }
    auto s = dm::algorithms::nth_root_demo_study();
    std::vector<double> errors;
    for (double error : s.reference_errors)
        errors.push_back(std::log10(std::max(error, 1e-18)));
    auto p = dm::graphics::RPlot::create();
    p.lines(s.indices, errors, "actual state error", {36, 105, 172}).points(
        s.indices, errors, "", {36, 105, 172}, 5).title("Original cube root50: actual stopped Newton states").x_label("actual assigned updates").y_label("log10(max(cbrt reference error, 1e-18))").save_svg("build/nth_root_original.svg");
}
```
