> Explicit controls

```{cpp, results="markdown", file="figures/spigot_controls.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    std::vector<double> x, y;
    std::print("| fractional digits | actual output | certified | columns | updates |\n| ---: | --- | --- | " "---: | ---: |\n");
    for (int n : {0, 1, 2, 5, 10, 20}) {
        auto r = a::spigot_e_run(n);
        std::print("| {} | `{}` | {} | {} | {} |\n", n, r.digits, r.certified,
                   r.columns, r.column_updates);
        x.push_back(n);
        y.push_back(r.column_updates);
    }
    auto plot = g::RPlot::create();
    plot.lines(x, y, "actual values", {37, 99, 235}).points(x, y, {37, 99, 235},
                                                            4).title(
        "Zero-digit point and certified prefix controls").x_label(
        "fractional digits").y_label("actual column visits");
    plot.save_svg("build/spigot_controls.svg");
}
```
