> The retained original experiment

```{cpp, results="markdown", file="figures/spigot_original.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    auto prefix = a::spigot_e_run(40);
    auto r = a::spigot_e_run(400);
    std::print("| original40 fractional digits | known prefix reference | certified |\n| --- | --- | --- " "|\n| `{}` | `2.7182818284590452353602874713526624977572` | {} |\n",
               prefix.digits, prefix.certified);
    std::vector<std::string> labels;
    std::vector<double> heights;
    std::print("\n| decimal digit | actual count including leading2 |\n| ---: | ---: |\n");
    for (std::size_t i = 0; i < 10; ++i) {
        std::print("| {} | {} |\n", i, r.frequencies[i]);
        labels.push_back(std::to_string(i));
        heights.push_back(r.frequencies[i]);
    }
    auto plot =
        g::RPlot::barplot(heights, labels, "actual digit counts", {124, 58, 237});
    plot.title("Original400 fractional digits plus leading2: counts").x_label(
        "decimal digit").y_label("actual occurrences in401 digits");
    plot.save_svg("build/spigot_original.svg");
}
```
