> Actual selected work and sensitivity

```{cpp, results="markdown", file="figures/spigot_work.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    std::vector<double> x, y;
    std::print("| requested fractional digits | actual column visits | d*(d+19) reference | certified |\n| " "---: | ---: | ---: | --- |\n");
    for (int n : {1, 5, 10, 20, 40, 100, 200, 400}) {
        auto r = a::spigot_e_run(n);
        std::print("| {} | {} | {} | {} |\n", n, r.column_updates, n * (n + 19),
                   r.certified);
        x.push_back(n);
        y.push_back(r.column_updates);
    }
    auto plot = g::RPlot::create();
    plot.lines(x, y, "actual values", {37, 99, 235}).points(x, y, {37, 99, 235},
                                                            4).title(
        "Actual mixed-radix work grows quadratically").x_label(
        "fractional digits").y_label("actual column updates");
    plot.save_svg("build/spigot_work.svg");
}
```
