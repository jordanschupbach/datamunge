> The retained original experiment

```{cpp, results="markdown", file="figures/sqrt_digits_original.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <filesystem>
#include <print>
#include <algorithm>
#include <cmath>
#include <limits>
#include <numeric>
#include <numbers>
#include <random>
#include <string>
#include <vector>
#include <map>
#include <set>
#include <array>
#include <tuple>
#include <bit>
#include <datamunge/random/quality.hpp>
#include <datamunge/algorithms/sqrt_digits.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    std::print("| original radicand | fractional digits | actual exact truncated string |\n| ---: | ---: | " "--- |\n");
    for (const auto & [n, f] : std::vector<std::pair<std::uint64_t, int>> {
        { 2, 12 }, {152, 8}, {144, 4}, {2025, 4}
    })
        std::print("| {} | {} | `{}` |\n", n, f, a::digit_by_digit_sqrt(n, f));
    std::vector<double> x, y;
    std::print("\n| original fractional count | actual root2 string | approximate double absolute error " "|\n| ---: | --- | ---: |\n");
    for (int f = 1; f <= 13; ++f) {
        const auto text = a::digit_by_digit_sqrt(2, f);
        const double error = std::abs(std::stod(text) - std::sqrt(2.));
        std::print("| {} | `{}` | {} |\n", f, text, error);
        x.push_back(f);
        y.push_back(error > 0 ? -std::log10(error)
                    : std::numeric_limits<double>::quiet_NaN());
    }
    auto plot = g::RPlot::create();
    plot.lines(x, y, "actual values", {37, 99, 235}).points(x, y, {37, 99, 235},
                                                            4).title(
        "Original root2: measured double-reference accuracy").x_label(
        "fractional digits").y_label("minus log10 approximate error");
    plot.save_svg("build/sqrt_digits_original.svg");
}
```
