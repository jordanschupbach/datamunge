> Explicit controls

```{cpp, results="markdown", file="figures/sqrt_digits_controls.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <filesystem>
#include <print>
#include <algorithm>
#include <cmath>
#include <limits>
#include <numeric>
#include <numbers>
#include <random>
#include <string>
#include <vector>
#include <map>
#include <set>
#include <array>
#include <tuple>
#include <bit>
#include <datamunge/random/quality.hpp>
#include <datamunge/algorithms/sqrt_digits.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    std::vector<double> x, y;
    std::print("| radicand | actual20-digit truncated root | actual candidate tests |\n| ---: | --- | ---: " "|\n");
    for (const std::uint64_t n : {std::uint64_t{0}, std::uint64_t{1},
                                  std::uint64_t{2}, std::uint64_t{144},
                                  std::uint64_t{18446744065119617025ULL},
                                  std::numeric_limits<std::uint64_t>::max()}) {
        auto r = a::sqrt_digits_run(n, 20);
        std::print("| {} | `{}` | {} |\n", n, r.digits, r.candidate_tests);
        x.push_back(x.size());
        y.push_back(r.candidate_tests);
    }
    auto plot = g::RPlot::create();
    plot.lines(x, y, "actual values", {37, 99, 235}).points(x, y, {37, 99, 235},
                                                            4).title(
        "Zero, squares and full-width unsigned radicands").x_label(
        "control index").y_label("actual candidate comparisons");
    plot.save_svg("build/sqrt_digits_controls.svg");
}
