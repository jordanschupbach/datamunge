> Retain the original four unsigned divisions

The original pairs100/7,1000000/999,123456789/12345 and(2⁶⁴−1)/7 are preserved.
The table checks actual quotient and remainder against built-in operators and
reports actual reciprocal/correction work. The figure counts every exact
comparison, including each final unsuccessful down/up test. Large dividends can
require many unit corrections because a double reciprocal carries fewer
significant bits than a64-bit integer; those corrections are actual producer
work rather than a single assumed cleanup step.

```{cpp, results="markdown", file="figures/integer_newton_original.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <datamunge/algorithms/division.hpp>
#include <datamunge/plot/plot.hpp>
#include <filesystem>
#include <print>
int main() {
    std::filesystem::create_directories("build");
    std::vector<std::string> labels{"100/7", "1e6/999", "123456789/12345",
                                    "max/7"};
    std::vector<double> checks;
    auto pairs = dm::algorithms::integer_newton_demo_pairs();
    std::print("| dividend | divisor | actual quotient | actual remainder | built-in quotient | built-in " "remainder | actual reciprocal updates | down corrections | up corrections | exact " "comparisons |\n| ---: | ---: | ---: | ---: | ---: | ---: | ---: | ---: | ---: | ---: |\n");
    for (auto[n, d] : pairs) {
        auto r = dm::algorithms::integer_newton_division_analyze(n, d);
        checks.push_back(r.comparison_tests);
        std::print("| {} | {} | {} | {} | {} | {} | {} | {} | {} | {} |\n", n,
                   d, r.result.quotient, r.result.remainder, n / d, n % d,
                   r.reciprocal_updates, r.decrements, r.increments,
                   r.comparison_tests);
    }
    auto p = dm::graphics::RPlot::barplot(checks, labels, "exact comparisons");
    p.title("Original integer divisions: actual correction comparisons").x_label("original unsigned pair").y_label("actual exact product comparisons").save_svg("build/integer_newton_original.svg");
    auto t = dm::algorithms::integer_newton_division_trace(100, 7);
    std::print("\nOperative rounded denominator {}, actual seed {}, actual five-update final reciprocal " "{}.\n",
               t.rounded_denominator, t.seed, t.reciprocal);
}
