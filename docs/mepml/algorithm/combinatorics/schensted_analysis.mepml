> Explicit controls

```{cpp, results="markdown", file="figures/schensted_controls.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <filesystem>
#include <print>
#include <algorithm>
#include <cmath>
#include <limits>
#include <numeric>
#include <numbers>
#include <random>
#include <string>
#include <vector>
#include <map>
#include <set>
#include <array>
#include <tuple>
#include <bit>
#include <datamunge/algorithms/schensted.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    std::vector<double> x, y;
    std::vector<std::vector<int>> v{{}, {1, 1, 2, 2}, {4, 3, 2, 1}, {1, 2, 3, 4}};
    std::print("| control | actual P | actual first row length | bumps |\n| ---: | --- | ---: | ---: |\n");
    for (std::size_t i = 0; i < v.size(); ++i) {
        auto r = a::schensted_run(v[i]);
        auto first = r.tableau.p.empty() ? 0 : r.tableau.p[0].size();
        std::print("| {} | `{}` | {} | {} |\n", i, r.tableau.p, first, r.bumps);
        x.push_back(i);
        y.push_back(first);
    }
    auto plot = g::RPlot::create();
    plot.lines(x, y, "actual values", {37, 99, 235}).points(x, y, {37, 99, 235},
                                                            5).title(
        "Duplicate inputs use nondecreasing subsequences").x_label("control").y_label("actual first-row length");
    plot.save_svg("build/schensted_controls.svg");
}
```
// result_begin: markdown
| control | actual P | actual first row length | bumps |
| ---: | --- | ---: | ---: |
| 0 | `[]` | 0 | 0 |
| 1 | `[[1, 1, 2, 2]]` | 4 | 0 |
| 2 | `[[1], [2], [3], [4]]` | 1 | 6 |
| 3 | `[[1, 2, 3, 4]]` | 4 | 0 |
\image(figures/schensted_controls.svg)
// result_end
\caption(Actual outcomes on controlled native inputs; errors, truncation and unresolved outcomes retain their stated meanings.)
\alttext(Actual outcomes on controlled native inputs; errors, truncation and unresolved outcomes retain their stated meanings.)

> Actual selected work and sensitivity

```{cpp, results="markdown", file="figures/schensted_work.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <filesystem>
#include <print>
#include <algorithm>
#include <cmath>
#include <limits>
#include <numeric>
#include <numbers>
#include <random>
#include <string>
#include <vector>
#include <map>
#include <set>
#include <array>
#include <tuple>
#include <bit>
#include <datamunge/algorithms/schensted.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    std::vector<double> x, y;
    std::print("| ascending length | actual comparisons | appends | bumps |\n| ---: | ---: | ---: | ---: " "|\n");
    for (int n : {2, 4, 8, 16, 32, 64}) {
        std::vector<int> v(n);
        std::iota(v.begin(), v.end(), 0);
        auto r = a::schensted_run(v);
        std::print("| {} | {} | {} | {} |\n", n, r.comparisons, r.appends,
                   r.bumps);
        x.push_back(n);
        y.push_back(r.comparisons);
    }
    auto plot = g::RPlot::create();
    plot.lines(x, y, "actual values", {37, 99, 235}).points(x, y, {37, 99, 235},
                                                            5).title(
        "Ascending rows expose actual quadratic scans").x_label("input length").y_label("actual row comparisons");
    plot.save_svg("build/schensted_work.svg");
}
```
