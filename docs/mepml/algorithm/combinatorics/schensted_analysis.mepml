> The retained original experiment

```{cpp, results="markdown", file="figures/schensted_original.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <filesystem>
#include <print>
#include <algorithm>
#include <cmath>
#include <limits>
#include <numeric>
#include <numbers>
#include <random>
#include <string>
#include <vector>
#include <map>
#include <set>
#include <array>
#include <tuple>
#include <bit>
#include <datamunge/algorithms/schensted.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    auto r = a::schensted_trace({4, 1, 3, 6, 2, 5});
    std::print("Actual P `{}`; actual Q `{}`. First row length {}.\n\n| insertion | row | carried | bumped " "| after |\n| ---: | ---: | ---: | --- | --- |\n",
               r.tableau.p, r.tableau.q, r.tableau.p[0].size());
    for (const auto &s : r.steps)
        std::print("| {} | {} | {} | {} | `{}` |\n", s.input_index, s.row,
                   s.carried, s.bumped, s.after);
    auto tableau = a::schensted_diagram(r.tableau);
    tableau.save_svg("build/schensted_original.svg");
}
```
// result_begin: markdown
Actual P `[[1, 2, 5], [3, 6], [4]]`; actual Q `[[1, 3, 4], [2, 6], [5]]`. First row length 3.

| insertion | row | carried | bumped | after |
| ---: | ---: | ---: | --- | --- |
| 0 | 0 | 4 | false | `[4]` |
| 1 | 0 | 1 | true | `[1]` |
| 1 | 1 | 4 | false | `[4]` |
| 2 | 0 | 3 | false | `[1, 3]` |
| 3 | 0 | 6 | false | `[1, 3, 6]` |
| 4 | 0 | 2 | true | `[1, 2, 6]` |
| 4 | 1 | 3 | true | `[3]` |
| 4 | 2 | 4 | false | `[4]` |
| 5 | 0 | 5 | true | `[1, 2, 5]` |
| 5 | 1 | 6 | false | `[3, 6]` |
\image(figures/schensted_original.svg)
// result_end
