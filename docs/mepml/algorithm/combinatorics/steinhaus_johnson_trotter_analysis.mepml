> Explicit controls

```{cpp, results="markdown", file="figures/steinhaus_johnson_trotter_controls.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <filesystem>
#include <print>
#include <algorithm>
#include <cmath>
#include <limits>
#include <numeric>
#include <numbers>
#include <random>
#include <string>
#include <vector>
#include <map>
#include <set>
#include <array>
#include <tuple>
#include <bit>
#include <datamunge/random/quality.hpp>
#include <datamunge/algorithms/steinhaus_johnson_trotter.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    std::vector<double> x, y;
    std::print("| n | actual rows | swaps | terminal-inclusive mobile tests |\n| ---: | ---: | ---: | ---: " "|\n");
    for (std::size_t n = 0; n <= 5; ++n) {
        auto r = a::sjt_run(n);
        std::print("| {} | {} | {} | {} |\n", n, r.permutations.size(),
                   r.adjacent_swaps, r.mobile_tests);
        x.push_back(n);
        y.push_back(r.permutations.size());
    }
    auto plot = g::RPlot::create();
    plot.lines(x, y, "actual executed values", {37, 99, 235}).points(
        x, y, {37, 99, 235}, 4).title("Empty and small complete permutation streams").x_label("order n").y_label("actual output rows");
    plot.save_svg("build/steinhaus_johnson_trotter_controls.svg");
}
```
