    plot.lines(x, y, "actual executed values", {37, 99, 235}).points(
        x, y, {37, 99, 235}, 4).title("Actual complete-stream candidate scans").x_label("order n").y_label("actual tested positions");
    plot.save_svg("build/steinhaus_johnson_trotter_work.svg");
}
