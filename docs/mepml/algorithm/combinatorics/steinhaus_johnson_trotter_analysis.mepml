> The retained original experiment

```{cpp, results="markdown", file="figures/steinhaus_johnson_trotter_original.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <filesystem>
#include <print>
#include <algorithm>
#include <cmath>
#include <limits>
#include <numeric>
#include <numbers>
#include <random>
#include <string>
#include <vector>
#include <map>
#include <set>
#include <array>
#include <tuple>
#include <bit>
#include <datamunge/random/quality.hpp>
#include <datamunge/algorithms/steinhaus_johnson_trotter.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    auto r = a::sjt_run(4);
    std::vector<double> x;
    for (std::size_t i = 0; i < r.permutations.size(); ++i)
        x.push_back(i);
    std::print("| original row | actual permutation |\n| ---: | --- |\n");
    for (std::size_t i = 0; i < r.permutations.size(); ++i)
        std::print("| {} | `{}` |\n", i, r.permutations[i]);
    auto plot = g::RPlot::create();
    const std::array<g::RGB, 4> colors{{{37, 99, 235}, {220, 38, 38},
                                        {5, 150, 105}, {124, 58, 237}}};
    for (int v = 1; v <= 4; ++v) {
        std::vector<double> y(r.value_positions[v].begin(),
                              r.value_positions[v].end());
        plot.lines(x, y, std::format("value{}", v), colors[v - 1]);
    }
    plot.title("Original n=4: actual value positions during swaps").x_label(
        "permutation row").y_label("zero-based position");
    plot.save_svg("build/steinhaus_johnson_trotter_original.svg");
}
```
