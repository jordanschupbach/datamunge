> The retained original experiment

```{cpp, results="markdown", file="figures/subset_sum_original.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    const std::vector<long long> nums{3, 34, 4, 12, 5, 2, 15, 9};
    std::print("| original target | found | actual indices | actual values |\n| ---: | --- | --- | --- |\n");
    for (long long target : {9, 30, 100}) {
        auto r = a::subset_sum_run(nums, target);
        std::vector<long long> values;
        for (auto i : r.result.indices)
            values.push_back(nums[i]);
        std::print("| {} | {} | `{}` | `{}` |\n", target, r.result.found,
                   r.result.indices, values);
    }
    auto negative = a::subset_sum_run({-7, -3, 2, 5, 8, -1}, 0);
    std::print("Original negative-key target0: found {}, witness `{}`; empty subset is allowed.\n\n| n | " "exhaustive space reference | half-space reference |\n| ---: | ---: | ---: |\n",
               negative.result.found, negative.result.indices);
    std::vector<double> x, y, z;
    for (int n = 4; n <= 40; n += 4) {
        x.push_back(n);
        y.push_back(std::pow(2., n));
        z.push_back(std::pow(2., n / 2.));
        std::print("| {} | {:.0f} | {:.0f} |\n", n, y.back(), z.back());
    }
    auto logy = y, logz = z;
    for (auto &v : logy) v = std::log2(v);
    for (auto &v : logz) v = std::log2(v);
    auto chart = g::RPlot::create();
    chart.lines(x, logy, "2^n analytic search space", {220, 38, 38}).lines(
        x, logz, "2^(n/2) analytic half space", {37, 99, 235}).title(
        "Original search spaces through40 keys: analytic, not runtime").x_label(
        "keys").y_label("log2 candidate space");
    chart.save_svg("build/subset_sum_original.svg");
}
```
