> Explicit controls

```{cpp, results="markdown", file="figures/subset_sum_controls.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    std::vector<std::vector<long long>> keys{{}, {0}, {1, 2, 3},
                                             {-7, -3, 2, 5, 8, -1},
                                             {std::numeric_limits<long long>::max(),
                                              std::numeric_limits<long long>::max(),
                                              -std::numeric_limits<long long>::max()}};
    std::vector<long long> targets{0, 1, 7, 0,
                                   std::numeric_limits<long long>::max()};
    std::vector<double> x, y;
    std::print("| control | found | actual witness indices | executed left probes |\n| ---: | --- | --- | " "---: |\n");
    for (std::size_t i = 0; i < keys.size(); ++i) {
        auto r = a::subset_sum_run(keys[i], targets[i]);
        x.push_back(i);
        y.push_back(r.left_probes);
        std::print("| {} | {} | `{}` | {} |\n", i, r.result.found,
                   r.result.indices, r.left_probes);
    }
    auto plot = g::RPlot::create();
    plot.lines(x, y, "actual native values", {37, 99, 235}).points(
        x, y, {37, 99, 235}, 4).title("Empty, impossible, signed and full-width exact controls").x_label("control index").y_label("actual left lookups");
    plot.save_svg("build/subset_sum_controls.svg");
}
```
