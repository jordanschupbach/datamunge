> Actual selected work and sensitivity

```{cpp, results="markdown", file="figures/subset_sum_work.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    std::vector<double> x, y;
    std::print("| n | actual right masks | actual exhausted left probes | bit tests | sort comparisons | " "lookup comparisons |\n| ---: | ---: | ---: | ---: | ---: | ---: |\n");
    for (int n = 4; n <= 28; n += 4) {
        std::vector<long long> keys(n, 2);
        auto r = a::subset_sum_run(keys, 1);
        x.push_back(n);
        y.push_back(r.right_subsets + r.left_probes);
        std::print("| {} | {} | {} | {} | {} | {} |\n", n, r.right_subsets,
                   r.left_probes, r.bit_tests, r.sort_comparisons,
                   r.lookup_comparisons);
    }
    auto plot = g::RPlot::create();
    plot.lines(x, y, "actual native values", {37, 99, 235}).points(
        x, y, {37, 99, 235}, 4).title("Actual impossible odd-target half-mask work").x_label("even-valued input keys").y_label("actual enumerated right masks plus left probes");
    plot.save_svg("build/subset_sum_work.svg");
}
```
