> Actual selected work and sensitivity

```{cpp, results="markdown", file="figures/reverse_delete_work.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <filesystem>
#include <print>
#include <algorithm>
#include <cmath>
#include <limits>
#include <numeric>
#include <numbers>
#include <random>
#include <string>
#include <vector>
#include <map>
#include <set>
#include <array>
#include <tuple>
#include <bit>
#include <datamunge/algorithms/reverse_delete.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    std::vector<double> x, y;
    std::print("| cycle vertices / edges | actual connectivity passes | actual edge-slot visits | selected " "edges | actual forest weight |\n| ---: | ---: | ---: | ---: | ---: |\n");
    for (std::size_t n : {3, 8, 16, 32, 64, 128}) {
        auto t = a::reverse_delete_run(n, a::reverse_delete_cycle(n));
        std::print("| {} | {} | {} | {} | {} |\n", n, t.connectivity_passes,
                   t.edge_visits, t.forest.edges.size(), t.forest.total_weight);
        x.push_back(n);
        y.push_back(t.edge_visits);
    }
    auto p = g::RPlot::create();
    p.lines(x, y, "actual complete edge-slot scans", {37, 99, 235}).points(
        x, y, {37, 99, 235}, 5).title("Native weighted cycles: actual direct connectivity work").x_label("cycle edge count E").y_label("actual E(E+1) inspected slots");
    p.save_svg("build/reverse_delete_work.svg");
}
```
