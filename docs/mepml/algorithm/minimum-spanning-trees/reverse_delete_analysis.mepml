> The retained original experiment

```{cpp, results="markdown", file="figures/reverse_delete_original.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <filesystem>
#include <print>
#include <algorithm>
#include <cmath>
#include <limits>
#include <numeric>
#include <numbers>
#include <random>
#include <string>
#include <vector>
#include <map>
#include <set>
#include <array>
#include <tuple>
#include <bit>
#include <datamunge/algorithms/reverse_delete.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    const std::vector<a::WeightedEdge> edges{{0, 1, 1}, {1, 2, 2}, {0, 2, 8}};
    auto t = a::reverse_delete_trace(3, edges);
    std::print("Original triangle: actual forest weight {}, connected {}, retained edges {}.\n\n| actual " "processing order | original edge id | weight | kept after its decision | components without " "|\n| ---: | ---: | ---: | --- | ---: |\n",
               t.forest.total_weight, t.forest.is_connected, t.forest.edges);
    std::vector<double> x, y;
    for (std::size_t i = 0; i < t.steps.size(); ++i) {
        const auto &s = t.steps[i];
        std::print("| {} | {} | {} | {} | {} |\n", i, s.edge_index,
                   std::get<2>(edges[s.edge_index]), !s.removed,
                   s.components_without);
        x.push_back(i);
        y.push_back(std::count(s.kept.begin(), s.kept.end(), char{1}));
    }
    auto p = g::RPlot::create();
    p.lines(x, y, "actual retained edges after each decision", {37, 99, 235}).points(x, y, {37, 99, 235}, 6).title("Original weight 1,2,8 triangle: actual reverse deletion").x_label("actual descending-weight decision").y_label("actual remaining original edges");
    p.save_svg("build/reverse_delete_original.svg");
}
```
