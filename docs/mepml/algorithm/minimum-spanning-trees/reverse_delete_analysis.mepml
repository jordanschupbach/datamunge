> Explicit controls

```{cpp, results="markdown", file="figures/reverse_delete_controls.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <filesystem>
#include <print>
#include <algorithm>
#include <cmath>
#include <limits>
#include <numeric>
#include <numbers>
#include <random>
#include <string>
#include <vector>
#include <map>
#include <set>
#include <array>
#include <tuple>
#include <bit>
#include <datamunge/algorithms/reverse_delete.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    const std::vector<std::vector<a::WeightedEdge>> models{
        {{0, 1, 1}, {2, 3, 2}}, {{0, 1, 2}, {0, 1, 1}, {0, 0, -100}},
        {{0, 1, -3}, {1, 2, -2}, {0, 2, 4}}
    };
    std::vector<double> x, y;
    std::vector<std::string> labels{"disconnected", "parallel / loop",
                                    "negative weights"};
    std::print("| control | original components | actual forest edges | actual total | connected |\n| --- | " "---: | ---: | ---: | --- |\n");
    for (std::size_t i = 0; i < models.size(); ++i) {
        auto t = a::reverse_delete_run(i == 0 ? 4 : 3, models[i]);
        std::print("| {} | {} | {} | {} | {} |\n", labels[i],
                   t.initial_components, t.forest.edges.size(),
                   t.forest.total_weight, t.forest.is_connected);
        x.push_back(i);
        y.push_back(t.forest.edges.size());
    }
    bool bad = false;
    try {
        a::reverse_delete(2, {{0, 2, 1}});
    } catch (const std::invalid_argument &) {
        bad = true;
    }
    std::print("Invalid endpoint rejected: {}.\n", bad);
    if (!bad)
        return 1;
    auto p = g::RPlot::create();
    p.bars(x, y, "actual forest edges", {22, 163, 74}, .8).x_ticks(x, labels).title("Reverse-delete keeps every original graph component").x_label("controlled graph").y_label("actual selected forest edges");
    p.save_svg("build/reverse_delete_controls.svg");
}
```
