> Original40-value fixture

Retain unsigned32 seed20240501, update state=1103515245*state+12345 modulo2^32
and output(state>>16)%100 for40 values. The native fixture preserves that exact
order. This small deterministic LCG is a reproducible input generator, not a
randomized-order guarantee. The plot retains the original input-rank versus
sorted-rank comparison; selected work below comes from one actual complete sort
and shelf history.

```{cpp, results="markdown", file="figures/library_sort_original.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <datamunge/algorithms/library_sort.hpp>
#include <datamunge/plot/plot.hpp>
#include <filesystem>
#include <print>
int main() {
    std::filesystem::create_directories("build");
    auto input = dm::algorithms::library_sort_demo_input();
    auto t = dm::algorithms::library_sort_trace(input);
    std::vector<double> x, a, b;
    std::print("| original input index | actual original value | actual sorted-rank value |\n| ---: | ---: " "| ---: |\n");
    for (std::size_t i = 0; i < input.size(); ++i) {
        std::print("| {} | {} | {} |\n", i, input[i], t.analysis.values[i]);
        x.push_back(i);
        a.push_back(input[i]);
        b.push_back(t.analysis.values[i]);
    }
    std::print("\nActual shelf capacity {}; actual search iterations {}; actual value comparisons {}; " "actual occupancy reads {}; actual shifted pairs {}; actual placements {}; actual captured " "entries {}.\n",
               t.analysis.work.capacity, t.analysis.work.search_iterations,
               t.analysis.work.comparisons, t.analysis.work.occupancy_reads,
               t.analysis.work.shift_writes, t.analysis.work.placements,
               t.captured_entries);
    auto p = dm::graphics::RPlot::create();
    p.line(x, a, "original input", {148, 163, 184}, 1.5).points(x, a, "",
                                                                {148, 163, 184},
                                                                3).line(
        x, b, "actual sorted", {37, 99, 235}, 2).points(x, b, "", {37, 99, 235},
                                                        3).y_limits(-5, 135).title("Original40-value fixture and actual sorted output").x_label("original input index or sorted rank").y_label("integer value").save_svg("build/library_sort_original.svg");
}
