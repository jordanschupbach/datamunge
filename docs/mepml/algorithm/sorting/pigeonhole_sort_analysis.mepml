> Explicit controls

```{cpp, results="markdown", file="figures/pigeonhole_sort_controls.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <datamunge/plot/plot.hpp>
#include <datamunge/plot/diagram.hpp>
#include <datamunge/algorithms/modular_exponentiation.hpp>
#include <datamunge/algorithms/integer_arithmetic.hpp>
#include <filesystem>
#include <print>
#include <algorithm>
#include <cmath>
#include <limits>
#include <climits>
#include <datamunge/algorithms/number_theory.hpp>
#include <numeric>
#include <numbers>
#include <random>
#include <string>
#include <vector>
#include <datamunge/algorithms/pigeonhole_sort.hpp>
int main() {
    std::filesystem::create_directories("build");

    std::vector<std::vector<int>> cases{{}, {1}, {2, 2, 2},
                                        {INT_MIN, INT_MIN + 3}};
    std::vector<std::string> labels{"empty", "singleton", "duplicates",
                                    "near INT_MIN"};
    std::vector<double> v;
    std::print("\n| case | actual dense holes | actual appends | actual sorted values |\n| --- | ---: | ---: " "| --- |\n");
    for (std::size_t i = 0; i < cases.size(); ++i) {
        auto t = dm::algorithms::pigeonhole_sort_trace(cases[i]);
        v.push_back(t.run.holes);
        std::print("| {} | {} | {} | `{}` |\n", labels[i], t.run.holes,
                   t.run.placements, t.run.sorted);
    }
    bool rejected = false;
    try {
        dm::algorithms::pigeonhole_sort({INT_MIN, INT_MAX});
    } catch (const std::length_error &) {
        rejected = true;
    }
    std::print("Full signed range rejected before dense allocation: {}.\n",
               rejected);
    auto p =
        dm::graphics::RPlot::barplot(v, labels, "actual allocated buckets");
    p.title("Pigeonhole controls: early returns and widened signed offsets").y_label("actual dense bucket count");
    p.save_svg("build/pigeonhole_sort_controls.svg");
}
```
