> Actual selected work

```{cpp, results="markdown", file="figures/pigeonhole_sort_work.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <datamunge/plot/plot.hpp>
#include <datamunge/plot/diagram.hpp>
#include <datamunge/algorithms/modular_exponentiation.hpp>
#include <datamunge/algorithms/integer_arithmetic.hpp>
#include <filesystem>
#include <print>
#include <algorithm>
#include <cmath>
#include <limits>
#include <climits>
#include <datamunge/algorithms/number_theory.hpp>
#include <numeric>
#include <numbers>
#include <random>
#include <string>
#include <vector>
#include <datamunge/algorithms/pigeonhole_sort.hpp>
int main() {
    std::filesystem::create_directories("build");

    std::vector<double> v;
    std::vector<std::string> labels;
    std::print("\n| two input values | actual placements | actual scanned buckets | actual emitted values " "|\n| --- | ---: | ---: | ---: |\n");
    for (int range : {32, 128, 512, 2048}) {
        auto r = dm::algorithms::pigeonhole_sort_run({0, range - 1});
        labels.push_back(std::to_string(range));
        v.push_back(r.scanned_holes);
        std::print("| 0 and{} | {} | {} | {} |\n", range - 1, r.placements,
                   r.scanned_holes, r.emitted);
    }
    auto p = dm::graphics::RPlot::barplot(v, labels, "actual scanned buckets");
    p.title("Two integers can require thousands of actual empty-bucket scans").x_label("dense value range").y_label("actual scanned buckets");
    p.save_svg("build/pigeonhole_sort_work.svg");
}
```
