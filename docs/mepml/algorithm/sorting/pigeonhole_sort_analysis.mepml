> The retained original experiment

```{cpp, results="markdown", file="figures/pigeonhole_sort_original.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <datamunge/plot/plot.hpp>
#include <datamunge/plot/diagram.hpp>
#include <datamunge/algorithms/modular_exponentiation.hpp>
#include <datamunge/algorithms/integer_arithmetic.hpp>
#include <filesystem>
#include <print>
#include <algorithm>
#include <cmath>
#include <limits>
#include <climits>
#include <datamunge/algorithms/number_theory.hpp>
#include <numeric>
#include <numbers>
#include <random>
#include <string>
#include <vector>
#include <datamunge/algorithms/pigeonhole_sort.hpp>
int main() {
    std::filesystem::create_directories("build");

    std::print("Original seven values sorted: `{}`.\n",
               dm::algorithms::pigeonhole_sort({5, 3, 8, 1, 9, 2, 7}));
    std::mt19937 rng(2);
    std::uniform_int_distribution<int> value(1, 20);
    std::vector<int> a(200);
    for (int &x : a)
        x = value(rng);
    auto t = dm::algorithms::pigeonhole_sort_trace(a);
    std::print("Actual input appends {}, allocated holes {}, scanned holes {}, emitted {}.\n",
               t.run.placements, t.run.holes, t.run.scanned_holes, t.run.emitted);
    std::vector<double> x, y;
    std::print("\n| value | actual hole occupancy |\n| ---: | ---: |\n");
    for (std::size_t h = 0; h < t.occupancies.size(); ++h) {
        const auto key =
            static_cast<long long>(t.run.minimum) + static_cast<long long>(h);
        x.push_back(key);
        y.push_back(t.occupancies[h]);
        std::print("| {} | {} |\n", key, t.occupancies[h]);
    }
    auto p = dm::graphics::RPlot::create();
    p.bars(x, y, "actual final occupancy", {37, 99, 235}, .8).title(
        "Original seed2 / 200 values: actual pigeonhole bucket sizes").x_label(
        "integer value").y_label("actual append count");
    p.save_svg("build/pigeonhole_sort_original.svg");
}
```
