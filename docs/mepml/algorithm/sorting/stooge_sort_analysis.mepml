> The retained original experiment

```{cpp, results="markdown", file="figures/stooge_sort_original.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <filesystem>
#include <print>
#include <algorithm>
#include <cmath>
#include <limits>
#include <numeric>
#include <numbers>
#include <random>
#include <string>
#include <vector>
#include <map>
#include <set>
#include <array>
#include <tuple>
#include <bit>
#include <datamunge/random/quality.hpp>
#include <datamunge/algorithms/stooge_sort.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    auto r = a::stooge_sort_run(std::vector<int>{5, 1, 4, 2, 8, 0, 7, 3, 6});
    std::print("Original input `{}`; actual sorted `{}`; calls {}, swaps {}.\n\n| n | actual calls | " "asymptotic n^p reference | n squared reference |\n",
               std::vector<int>{5, 1, 4, 2, 8, 0, 7, 3, 6}, r.values,
               r.comparisons, r.swaps);
    std::print("| ---: | ---: | ---: | ---: |\n");
    std::vector<double> x, y, p, q;
    for (int n = 3; n <= 200; ++n) {
        std::vector<int> v(n);
        std::iota(v.begin(), v.end(), 0);
        std::reverse(v.begin(), v.end());
        auto a = a::stooge_sort_run(v);
        x.push_back(n);
        y.push_back(a.comparisons);
        p.push_back(std::pow(n, std::log(3.) / std::log(1.5)));
        q.push_back(n * n);
        std::print("| {} | {} | {:.9g} | {} |\n", n, a.comparisons, p.back(),
                   n * n);
    }
    auto chart = g::RPlot::create();
    chart.lines(x, y, "actual recursive calls", {37, 99, 235}).lines(
        x, p, "n^p analytic reference", {124, 58, 237}).lines(
        x, q, "n squared reference", {5, 150, 105}).title(
        "Original n=3..200: actual calls and analytic references").x_label(
        "keys").y_label("count / reference value");
    chart.save_svg("build/stooge_sort_original.svg");
}
```
