> Actual selected work and sensitivity

```{cpp, results="markdown", file="figures/stooge_sort_work.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <filesystem>
#include <print>
#include <algorithm>
#include <cmath>
#include <limits>
#include <numeric>
#include <numbers>
#include <random>
#include <string>
#include <vector>
#include <map>
#include <set>
#include <array>
#include <tuple>
#include <bit>
#include <datamunge/random/quality.hpp>
#include <datamunge/algorithms/stooge_sort.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    std::vector<double> x, y;
    std::print("| n | actual calls | actual swaps on reverse keys |\n| ---: | ---: | ---: |\n");
    for (int n = 2; n <= 30; ++n) {
        std::vector<int> v(n);
        std::iota(v.rbegin(), v.rend(), 0);
        auto r = a::stooge_sort_run(v);
        x.push_back(n);
        y.push_back(r.comparisons);
        std::print("| {} | {} | {} |\n", n, r.comparisons, r.swaps);
    }
    auto plot = g::RPlot::create();
    plot.lines(x, y, "actual executed values", {37, 99, 235}).points(
        x, y, {37, 99, 235}, 4).title("Actual ceiling-induced recursion plateaus").x_label("keys").y_label("actual recursive comparisons");
    plot.save_svg("build/stooge_sort_work.svg");
}
