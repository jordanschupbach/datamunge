> Explicit controls

```{cpp, results="markdown", file="figures/stooge_sort_controls.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <filesystem>
#include <print>
#include <algorithm>
#include <cmath>
#include <limits>
#include <numeric>
#include <numbers>
#include <random>
#include <string>
#include <vector>
#include <map>
#include <set>
#include <array>
#include <tuple>
#include <bit>
#include <datamunge/random/quality.hpp>
#include <datamunge/algorithms/stooge_sort.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    std::vector<double> x, y;
    std::print("| control keys | actual sorted | calls | swaps |\n| --- | --- | ---: | ---: |\n");
    std::vector<std::vector<int>> cases{{}, {1}, {2, 1}, {1, 1, 1}, {3, 2, 1},
                                        {1, 2, 3}};
    for (std::size_t i = 0; i < cases.size(); ++i) {
        auto r = a::stooge_sort_run(cases[i]);
        std::print("| `{}` | `{}` | {} | {} |\n", cases[i], r.values,
                   r.comparisons, r.swaps);
        x.push_back(i);
        y.push_back(r.swaps);
    }
    auto plot = g::RPlot::create();
    plot.lines(x, y, "actual executed values", {37, 99, 235}).points(
        x, y, {37, 99, 235}, 4).title("Actual swaps depend on keys; recursion depends on length").x_label("control index").y_label("actual endpoint swaps");
    plot.save_svg("build/stooge_sort_controls.svg");
}
```
