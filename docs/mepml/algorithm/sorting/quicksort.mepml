> The retained original experiment

```{cpp, results="markdown", file="figures/quicksort_original.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");

    auto seven = a::quicksort_run({9, 3, 7, 1, 8, 5, 2});
    std::print("Original seven-key result {}, actual comparisons {}, actual partitions {}.\n",
               seven.values, seven.comparisons, seven.partitions);
    auto rows =
        a::quicksort_scaling({50, 100, 200, 500, 1000, 2000, 5000, 10000});
    std::vector<double> x, y, z;
    std::print("\n| original n | actual comparisons | mathematical n log2 n | actual/reference |\n| ---: | " "---: | ---: | ---: |\n");
    for (const auto &r : rows) {
        x.push_back(r.size);
        y.push_back(r.comparisons);
        z.push_back(r.reference);
        std::print("| {} | {} | {} | {} |\n", r.size, r.comparisons,
                   r.reference, r.comparisons / r.reference);
    }
    auto p = g::RPlot::create();
    p.lines(x, y, "actual canonical comparisons", {37, 99, 235}).lines(
        x, z, "mathematical n log2 n", {234, 88, 12}).title(
        "Original seed 20240927: actual quicksort comparisons").x_label(
        "generated keys").y_label("key comparisons / reference scale");
    p.save_svg("build/quicksort_original.svg");
}
```
