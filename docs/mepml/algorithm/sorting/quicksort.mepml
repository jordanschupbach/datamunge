> Explicit controls

```{cpp, results="markdown", file="figures/quicksort_controls.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");

    std::vector<std::string> labels{"empty", "singleton", "16 equal",
                                    "17 equal", "256 equal"};
    std::vector<std::vector<std::int64_t>> cases{{}, {7},
                                                 std::vector<std::int64_t>(
                                                 16, 7),
                                                 std::vector<std::int64_t>(
                                                 17, 7),
                                                 std::vector<std::int64_t>(
                                                 256, 7)};
    std::vector<double> counts;
    std::print("\n| actual fixture | comparisons | partitions | live recursion depth |\n| --- | ---: | ---: " "| ---: |\n");
    for (std::size_t i = 0; i < cases.size(); ++i) {
        auto r = a::quicksort_run(cases[i]);
        counts.push_back(std::log10(r.partitions + 1.0));
        std::print("| {} | {} | {} | {} |\n", labels[i], r.comparisons,
                   r.partitions, r.max_depth);
    }
    auto p =
        g::RPlot::barplot(counts, labels, "log10(actual Lomuto partitions + 1)");
    p.title("The sixteen-key cutoff and equal-key worst case").y_label(
        "log10(partitions + 1)");
    p.save_svg("build/quicksort_controls.svg");
}
```
