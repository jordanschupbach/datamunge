> Actual selected work and sensitivity

```{cpp, results="markdown", file="figures/quicksort_work.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");

    std::vector<double> x, y;
    std::print("\n| equal keys n | actual comparisons | actual comparisons / n squared | actual live " "recursion depth |\n| ---: | ---: | ---: | ---: |\n");
    for (std::size_t n : {32, 64, 128, 256, 512, 1024}) {
        auto r = a::quicksort_run(std::vector<std::int64_t>(n, 7));
        x.push_back(n);
        y.push_back(double(r.comparisons) / (double(n) * n));
        std::print("| {} | {} | {} | {} |\n", n, r.comparisons, y.back(),
                   r.max_depth);
    }
    auto p = g::RPlot::create();
    p.lines(x, y, "actual comparisons / n squared", {16, 122, 87}).points(
        x, y, {16, 122, 87}, 5).title("Quadratic equal-key time with bounded recursive stack").x_label("equal input keys").y_label("actual comparisons / n squared");
    p.save_svg("build/quicksort_work.svg");
}
```
