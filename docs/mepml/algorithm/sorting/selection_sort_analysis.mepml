> Explicit controls

```{cpp, results="markdown", file="figures/selection_sort_controls.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <filesystem>
#include <print>
#include <algorithm>
#include <cmath>
#include <limits>
#include <numeric>
#include <numbers>
#include <random>
#include <string>
#include <vector>
#include <map>
#include <set>
#include <array>
#include <tuple>
#include <bit>
#include <datamunge/random/quality.hpp>
#include <datamunge/algorithms/selection_sort.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    std::vector<double> x, y;
    const std::vector<std::vector<int>> cases{{}, {1}, {1, 2, 3, 4},
                                              {4, 3, 2, 1}, {2, 2, 2, 2}};
    std::print("| control | actual output | comparisons | swaps |\n| ---: | --- | ---: | ---: |\n");
    for (std::size_t i = 0; i < cases.size(); ++i) {
        auto r = a::selection_sort_run(cases[i]);
        std::print("| {} | `{}` | {} | {} |\n", i, r.values, r.comparisons,
                   r.swaps);
        x.push_back(i);
        y.push_back(r.swaps);
    }
    auto plot = g::RPlot::create();
    plot.lines(x, y, "actual values", {37, 99, 235}).points(x, y, {37, 99, 235},
                                                            5).title(
        "Sorted and equal keys need no swaps").x_label("control").y_label(
        "actual non-self swaps");
    plot.save_svg("build/selection_sort_controls.svg");
}
```
// result_begin: markdown
| control | actual output | comparisons | swaps |
| ---: | --- | ---: | ---: |
| 0 | `[]` | 0 | 0 |
| 1 | `[1]` | 0 | 0 |
| 2 | `[1, 2, 3, 4]` | 6 | 0 |
| 3 | `[1, 2, 3, 4]` | 6 | 2 |
| 4 | `[2, 2, 2, 2]` | 6 | 0 |
\image(figures/selection_sort_controls.svg)
// result_end
