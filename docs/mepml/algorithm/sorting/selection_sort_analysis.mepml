> The retained original experiment

```{cpp, results="markdown", file="figures/selection_sort_original.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <filesystem>
#include <print>
#include <algorithm>
#include <cmath>
#include <limits>
#include <numeric>
#include <numbers>
#include <random>
#include <string>
#include <vector>
#include <map>
#include <set>
#include <array>
#include <tuple>
#include <bit>
#include <datamunge/random/quality.hpp>
#include <datamunge/algorithms/selection_sort.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    auto r = a::selection_sort_trace({5, 3, 8, 1, 9, 2, 7});
    std::vector<double> x, y;
    std::print("| actual pass | actual selected minimum | actual array |\n| ---: | ---: | --- |\n");
    for (const auto &s : r.steps) {
        std::print("| {} | {} | `{}` |\n", s.position, s.minimum, s.after);
        x.push_back(s.position);
        y.push_back(s.minimum);
    }
    auto plot = g::RPlot::create();
    plot.lines(x, y, "actual values", {37, 99, 235}).points(x, y, {37, 99, 235},
                                                            5).title(
        "Original seven keys: actual prefix selections").x_label("pass position").y_label("actual selected minimum");
    plot.save_svg("build/selection_sort_original.svg");
}
```
