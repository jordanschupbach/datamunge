| 2 | 3 | `[1, 2, 3, 5, 9, 8, 7]` |
| 3 | 5 | `[1, 2, 3, 5, 9, 8, 7]` |
| 4 | 7 | `[1, 2, 3, 5, 7, 8, 9]` |
| 5 | 8 | `[1, 2, 3, 5, 7, 8, 9]` |
