> Actual selected work and sensitivity

```{cpp, results="markdown", file="figures/selection_sort_work.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <filesystem>
#include <print>
#include <algorithm>
#include <cmath>
#include <limits>
#include <numeric>
#include <numbers>
#include <random>
#include <string>
#include <vector>
#include <map>
#include <set>
#include <array>
#include <tuple>
#include <bit>
#include <datamunge/random/quality.hpp>
#include <datamunge/algorithms/selection_sort.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    std::vector<double> x, comparisons, swaps;
    std::print("| original shuffled size | actual comparisons | actual swaps | n minus one reference |\n| " "---: | ---: | ---: | ---: |\n");
    for (const auto &input : a::selection_sort_example_arrays()) {
        auto r = a::selection_sort_run(input);
        x.push_back(input.size());
        comparisons.push_back(r.comparisons);
        swaps.push_back(r.swaps);
        std::print("| {} | {} | {} | {} |\n", input.size(), r.comparisons,
                   r.swaps, input.size() - 1);
    }
    auto plot = g::RPlot::create();
    plot.lines(x, comparisons, "actual comparisons", {220, 38, 38}).lines(
        x, swaps, "actual swaps", {37, 99, 235}).title("Original mt19937 seed2: measured comparisons and swaps").x_label("array size").y_label("actual selected operations");
    plot.save_svg("build/selection_sort_work.svg");
}
```
