> Checking the theory and controls

```{cpp, results="markdown", file="figures/tree_sort_controls.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <filesystem>
#include <print>
#include <algorithm>
#include <cmath>
#include <limits>
#include <numeric>
#include <numbers>
#include <random>
#include <string>
#include <vector>
#include <map>
#include <set>
#include <array>
#include <tuple>
#include <bit>
#include <datamunge/random/quality.hpp>
#include <datamunge/algorithms/tree_sort.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    std::vector<double> x, y;
    std::print("| input | sorted | comparisons |\n|---|---|---:|\n");
    int i = 0;
    for (auto keys : std::vector<std::vector<int>>{{}, {4}, {2, 2, 2},
                                                   {3, 2, 1}, {1, 2, 3}}) {
        auto r = a::tree_sort_work(keys);
        std::print("|`{}`|`{}`|{}|\n", keys, r.sorted, r.comparisons);
        x.push_back(i++);
        y.push_back(r.comparisons);
    }
    auto p = g::RPlot::create();
    p.line(x, y, "actual", {37, 99, 235}, 2);
    p.points(x, y, "", {37, 99, 235}, 5);
    p.title("Empty, duplicates and order controls").x_label("control index").y_label("actual comparisons");
    p.save_svg("build/tree_sort_controls.svg");
}
```
