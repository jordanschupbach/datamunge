> Sensitivity and selected work

```{cpp, results="markdown", file="figures/tree_sort_work.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <filesystem>
#include <print>
#include <algorithm>
#include <cmath>
#include <limits>
#include <numeric>
#include <numbers>
#include <random>
#include <string>
#include <vector>
#include <map>
#include <set>
#include <array>
#include <tuple>
#include <bit>
#include <datamunge/random/quality.hpp>
#include <datamunge/algorithms/tree_sort.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    std::vector<double> x, y;
    std::print("| n | actual comparisons | n(n-1)/2 |\n|---:|---:|---:|\n");
    for (int n : {8, 16, 32, 64, 128, 256, 512}) {
        std::vector<int> keys(n);
        std::iota(keys.begin(), keys.end(), 0);
        auto r = a::tree_sort_work(keys);
        std::print("|{}|{}|{}|\n", n, r.comparisons, n * (n - 1) / 2);
        x.push_back(n);
        y.push_back(r.comparisons);
    }
    auto p = g::RPlot::create();
    p.line(x, y, "actual", {37, 99, 235}, 2);
    p.points(x, y, "", {37, 99, 235}, 5);
    p.title("Actual ordered-input quadratic insertion work").x_label("n keys").y_label("actual comparisons");
    p.save_svg("build/tree_sort_work.svg");
}
```
