> The retained original experiment

```{cpp, results="markdown", file="figures/tree_sort_original.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <filesystem>
#include <print>
#include <algorithm>
#include <cmath>
#include <limits>
#include <numeric>
#include <numbers>
#include <random>
#include <string>
#include <vector>
#include <map>
#include <set>
#include <array>
#include <tuple>
#include <bit>
#include <datamunge/random/quality.hpp>
#include <datamunge/algorithms/tree_sort.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    auto r = a::tree_sort_work({5, 3, 8, 1, 9, 2, 7});
    std::vector<double> x(r.values.size()), y;
    for (std::size_t rank = 0; rank < r.inorder.size(); ++rank)
        x[r.inorder[rank]] = rank;
    for (auto d : r.depth)
        y.push_back(-double(d));
    auto p = g::RPlot::create();
    for (std::size_t i = 0; i < r.values.size(); ++i) {
        for (int c : {r.left[i], r.right[i]})
            if (c >= 0)
                p.line({x[i], x[c]}, {y[i], y[c]}, "", {148, 163, 184});
        p.text(x[i], y[i] + .12, std::to_string(r.values[i]));
    }
    p.points(x, y, "actual BST", {37, 99, 235}, 10);
    p.title("Original seven keys: actual producer tree").x_label("in-order rank").y_label("negative depth");
    p.save_svg("build/tree_sort_original.svg");
    std::print("Actual sorted keys `{}`; comparisons {}.\n", r.sorted,
               r.comparisons);
}
```
// result_begin: markdown
Actual sorted keys `[1, 2, 3, 5, 7, 8, 9]`; comparisons 11.
