| actual sorted position | actual key | actual carried payload |
| ---: | ---: | ---: |
| 0 | 1 | 1 |
| 1 | 1 | 3 |
| 2 | 2 | 0 |
| 3 | 2 | 2 |
\image(figures/merge_sort_tiny.svg)
// result_end
\caption(A real equal-key comparison and actual stable payload output.)
\alttext(Equal fronts select the left run because right_key<left_key is false.)

> Original eight values and producing work

Retain4,1,3,2,6,5,2,6. Every captured output tag is the original position
carried through actual moves; equal2 and6 values retain increasing original
indices. The comparison count is input dependent. The scratch and copyback
writes are not inferred from a separate simulation.

```{cpp, results="markdown", file="figures/merge_sort_original.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <datamunge/algorithms/merge_sort.hpp>
#include <datamunge/plot/plot.hpp>
#include <filesystem>
#include <print>
int main() {
    std::filesystem::create_directories("build");
    auto t =
        dm::algorithms::merge_sort_trace(dm::algorithms::merge_sort_demo_values());
    std::print("| actual sorted position | actual value | actual original index |\n| ---: | ---: | ---: " "|\n");
    std::vector<double> x, before, after;
    for (std::size_t i = 0; i < t.output.size(); ++i) {
        std::print("| {} | {} | {} |\n", i, t.output[i].key, t.output[i].tag);
        x.push_back(i);
        before.push_back(t.input[i].key);
        after.push_back(t.output[i].key);
    }
    std::print("\n| actual selected operation | count |\n| --- | ---: |\n| comparisons | {} |\n| scratch " "writes | {} |\n| copyback writes | {} |\n| completed merges | {} |\n| worst-case comparison " "bound | {} |\n",
               t.work.comparisons, t.work.scratch_writes, t.work.copy_writes,
               t.work.merges,
               dm::algorithms::merge_sort_comparison_bound(t.input.size()));
    auto p = dm::graphics::RPlot::create();
    p.line(x, before, "original values");
    p.line(x, after, "sorted values", {22, 163, 74});
    p.x_label("position in the displayed sequence").y_label(
        "actual integer value").title("Original eight values: actual before and after").save_svg("build/merge_sort_original.svg");
}
```
