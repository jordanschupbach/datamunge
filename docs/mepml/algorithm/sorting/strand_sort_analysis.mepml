> The retained original experiment

```{cpp, results="markdown", file="figures/strand_sort_original.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <filesystem>
#include <print>
#include <algorithm>
#include <cmath>
#include <limits>
#include <numeric>
#include <numbers>
#include <random>
#include <string>
#include <vector>
#include <map>
#include <set>
#include <array>
#include <tuple>
#include <bit>
#include <datamunge/random/quality.hpp>
#include <datamunge/algorithms/strand_sort.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    auto r =
        a::strand_sort_run(std::vector<int>{3, 1, 4, 1, 5, 9, 2, 6, 5, 3, 5, 8,
                                            9, 7, 9});
    std::print("Original15 keys sorted to `{}` in {} actual strands.\n\n| shuffled prefix percent | actual " "strands | extraction comparisons | merge comparisons |\n| ---: | ---: | ---: | ---: |\n",
               r.values, r.strands);
    auto arrays = a::strand_sort_example_arrays();
    std::vector<double> x, y;
    for (std::size_t i = 0; i < arrays.size(); ++i) {
        auto r = a::strand_sort_run(arrays[i]);
        x.push_back(i * 10);
        y.push_back(r.strands);
        std::print("| {} | {} | {} | {} |\n", i * 10, r.strands,
                   r.extraction_comparisons, r.merge_comparisons);
    }
    auto plot = g::RPlot::create();
    plot.lines(x, y, "actual executed values", {37, 99, 235}).points(
        x, y, {37, 99, 235}, 4).title("Original400 keys: same sequential seed7 prefix shuffles").x_label("shuffled prefix percent").y_label("actual strands");
    plot.save_svg("build/strand_sort_original.svg");
}
```
