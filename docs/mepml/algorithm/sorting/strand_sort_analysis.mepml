> Explicit controls

```{cpp, results="markdown", file="figures/strand_sort_controls.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <filesystem>
#include <print>
#include <algorithm>
#include <cmath>
#include <limits>
#include <numeric>
#include <numbers>
#include <random>
#include <string>
#include <vector>
#include <map>
#include <set>
#include <array>
#include <tuple>
#include <bit>
#include <datamunge/random/quality.hpp>
#include <datamunge/algorithms/strand_sort.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    std::vector<double> x, y;
    std::vector<std::vector<int>> cases{{}, {1}, {1, 2, 3, 4}, {4, 3, 2, 1},
                                        {2, 2, 2, 2}, {2, 1, 2, 1}};
    std::print("| input | actual sorted | actual strands |\n| --- | --- | ---: |\n");
    for (std::size_t i = 0; i < cases.size(); ++i) {
        auto r = a::strand_sort_run(cases[i]);
        x.push_back(i);
        y.push_back(r.strands);
        std::print("| `{}` | `{}` | {} |\n", cases[i], r.values, r.strands);
    }
    auto plot = g::RPlot::create();
    plot.lines(x, y, "actual executed values", {37, 99, 235}).points(
        x, y, {37, 99, 235}, 4).title("Actual extraction counts for ordered and duplicate keys").x_label("control index").y_label("actual strands");
    plot.save_svg("build/strand_sort_controls.svg");
}
```
