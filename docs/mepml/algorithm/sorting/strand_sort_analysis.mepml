> Actual selected work and sensitivity

```{cpp, results="markdown", file="figures/strand_sort_work.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <filesystem>
#include <print>
#include <algorithm>
#include <cmath>
#include <limits>
#include <numeric>
#include <numbers>
#include <random>
#include <string>
#include <vector>
#include <map>
#include <set>
#include <array>
#include <tuple>
#include <bit>
#include <datamunge/random/quality.hpp>
#include <datamunge/algorithms/strand_sort.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    std::vector<double> x, y;
    std::print("| reverse keys | actual strands | actual extraction+merge comparisons |\n| ---: | ---: | " "---: |\n");
    for (int n : {1, 2, 4, 8, 16, 32, 64, 128, 256}) {
        std::vector<int> v(n);
        std::iota(v.rbegin(), v.rend(), 0);
        auto r = a::strand_sort_run(v);
        x.push_back(n);
        y.push_back(r.extraction_comparisons + r.merge_comparisons);
        std::print("| {} | {} | {} |\n", n, r.strands,
                   r.extraction_comparisons + r.merge_comparisons);
    }
    auto plot = g::RPlot::create();
    plot.lines(x, y, "actual executed values", {37, 99, 235}).points(
        x, y, {37, 99, 235}, 4).title("Actual reverse-input comparison growth").x_label("keys").y_label("actual comparisons");
    plot.save_svg("build/strand_sort_work.svg");
}
```
