> The retained original experiment

```{cpp, results="markdown", file="figures/timsort_original.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    const std::vector<int> original{5, 6, 7, 1, 2, 3, 9, 8, 4, 0, 10, 11};
    auto sorted = a::timsort_run(original);
    std::print("Original input `{}`; actual stable sorted `{}`.\n\n| original shuffled prefix percent | " "actual raw input runs | actual consumed runs after extension | actual merges | comparisons " "|\n| ---: | ---: | ---: | ---: | ---: |\n",
               original, sorted.values);
    auto arrays = a::timsort_example_arrays();
    std::vector<double> x, y, z;
    for (std::size_t i = 0; i < arrays.size(); ++i) {
        auto profile = a::timsort_input_profile(arrays[i]);
        auto r = a::timsort_run(arrays[i]);
        x.push_back(i * 10);
        y.push_back(profile.lengths.size());
        z.push_back(r.natural_runs);
        std::print("| {} | {} | {} | {} | {} |\n", i * 10,
                   profile.lengths.size(), r.natural_runs, r.merges,
                   r.comparisons);
    }
    auto chart = g::RPlot::create();
    chart.lines(x, y, "actual raw input profile", {37, 99, 235}).lines(
        x, z, "actual consumed extended runs", {5, 150, 105}).title(
        "Original1000 keys, sequential seed9 prefix shuffles").x_label(
        "shuffled prefix percent").y_label("actual run count");
    chart.save_svg("build/timsort_original.svg");
}
```
