> Explicit controls

```{cpp, results="markdown", file="figures/timsort_controls.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    std::vector<std::vector<int>> cases{{}, {1}, {1, 2, 3, 4}, {4, 3, 2, 1},
                                        {2, 2, 2, 2}, {2, 1, 2, 1}};
    std::vector<double> x, y;
    std::print("| control keys | actual sorted | raw runs | consumed runs | actual reversal swaps |\n| --- " "| --- | ---: | ---: | ---: |\n");
    for (std::size_t i = 0; i < cases.size(); ++i) {
        auto profile = a::timsort_input_profile(cases[i]);
        auto r = a::timsort_run(cases[i]);
        x.push_back(i);
        y.push_back(r.reversed_swaps);
        std::print("| `{}` | `{}` | {} | {} | {} |\n", cases[i], r.values,
                   profile.lengths.size(), r.natural_runs, r.reversed_swaps);
    }
    auto plot = g::RPlot::create();
    plot.lines(x, y, "actual native values", {37, 99, 235}).points(
        x, y, {37, 99, 235}, 4).title("Strict reversal preserves ties and handles empty inputs").x_label("control index").y_label("actual reversal swaps");
    plot.save_svg("build/timsort_controls.svg");
}
```
