> Actual selected work and sensitivity

```{cpp, results="markdown", file="figures/samplesort_work.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <filesystem>
#include <print>
#include <algorithm>
#include <cmath>
#include <limits>
#include <numeric>
#include <numbers>
#include <random>
#include <string>
#include <vector>
#include <map>
#include <set>
#include <array>
#include <tuple>
#include <bit>
#include <datamunge/algorithms/samplesort.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    std::vector<double> x, y;
    std::print("| keys | actual total comparisons | sample | classify | leaves | depth |\n| ---: | ---: | " "---: | ---: | ---: | ---: |\n");
    for (std::size_t n : {16, 64, 256, 1024, 4096, 8000}) {
        auto r = a::samplesort_run(a::samplesort_example_values(n));
        std::print("| {} | {} | {} | {} | {} | {} |\n", n, r.comparisons,
                   r.sample_comparisons, r.splitter_comparisons,
                   r.leaf_comparisons, r.maximum_depth);
        x.push_back(n);
        y.push_back(r.comparisons);
    }
    auto plot = g::RPlot::create();
    plot.lines(x, y, "actual values", {37, 99, 235}).points(x, y, {37, 99, 235},
                                                            5).title(
        "Actual comparator work on controlled seeded keys").x_label("keys").y_label("actual operator-less calls");
    plot.save_svg("build/samplesort_work.svg");
}
```
