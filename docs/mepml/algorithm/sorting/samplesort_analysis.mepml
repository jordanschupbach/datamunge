> The retained original experiment

```{cpp, results="markdown", file="figures/samplesort_original.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <filesystem>
#include <print>
#include <algorithm>
#include <cmath>
#include <limits>
#include <numeric>
#include <numbers>
#include <random>
#include <string>
#include <vector>
#include <map>
#include <set>
#include <array>
#include <tuple>
#include <bit>
#include <datamunge/algorithms/samplesort.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    auto small =
        a::samplesort_run(std::vector<int>{37, 12, 88, 4, 61, 25, 9, 73, 50, 18,
                                           96, 42, 5, 67, 30});
    auto r = a::samplesort_trace(a::samplesort_example_values());
    std::print("Original fifteen keys sorted `{}`; actual partitions {}.\n\nOriginal 8000 keys: sorted {}, " "comparisons {}, partitions {}.\n\n| actual first partition bucket | actual keys |\n| ---: | " "---: |\n",
               small.values, small.partitions,
               std::is_sorted(r.values.begin(), r.values.end()), r.comparisons,
               r.partitions);
    std::vector<double> x, y;
    const auto &root = r.steps[0];
    for (std::size_t i = 0; i < root.bucket_sizes.size(); ++i) {
        std::print("| {} | {} |\n", i, root.bucket_sizes[i]);
        x.push_back(i);
        y.push_back(root.bucket_sizes[i]);
    }
    std::print("\nActual first sample source addresses `{}`; actual sorted sample `{}`; splitters `{}`.\n",
               root.sample_indices, root.sample, root.splitters);
    auto plot = g::RPlot::create();
    plot.lines(x, y, "actual values", {37, 99, 235}).points(x, y, {37, 99, 235},
                                                            5).title(
        "Original seed 21: actual first partition occupancy").x_label("bucket").y_label("actual keys");
    plot.save_svg("build/samplesort_original.svg");
}
```
