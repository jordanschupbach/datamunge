> Explicit controls

```{cpp, results="markdown", file="figures/samplesort_controls.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <filesystem>
#include <print>
#include <algorithm>
#include <cmath>
#include <limits>
#include <numeric>
#include <numbers>
#include <random>
#include <string>
#include <vector>
#include <map>
#include <set>
#include <array>
#include <tuple>
#include <bit>
#include <datamunge/algorithms/samplesort.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    std::vector<double> x, y;
    std::print("| control | keys | actual partitions | actual fallbacks | sorted |\n| ---: | ---: | ---: | " "---: | --- |\n");
    std::vector<std::vector<int>> v{{}, {1}, {3, 2, 1}, std::vector<int>(100, 7)};
    for (std::size_t i = 0; i < v.size(); ++i) {
        auto r = a::samplesort_trace(v[i]);
        std::print("| {} | {} | {} | {} | {} |\n", i, r.values.size(),
                   r.partitions, r.fallbacks,
                   std::is_sorted(r.values.begin(), r.values.end()));
        x.push_back(i);
        y.push_back(r.comparisons);
    }
    bool bad = false;
    try {
        a::samplesort_run(std::vector<double>{1,
                                              std::numeric_limits<double>::quiet_NaN()});
    } catch (const std::invalid_argument &) {
        bad = true;
    }
    std::print("Nonfinite key rejected {}.\n", bad);
    if (!bad)
        return 1;
    auto plot = g::RPlot::create();
    plot.lines(x, y, "actual values", {37, 99, 235}).points(x, y, {37, 99, 235},
                                                            5).title(
        "Empty, tiny and all-equal native controls").x_label("control").y_label(
        "actual comparisons");
    plot.save_svg("build/samplesort_controls.svg");
}
```
