> Explicit controls

```{cpp, results="markdown", file="figures/postman_sort_controls.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <datamunge/plot/plot.hpp>
#include <datamunge/plot/diagram.hpp>
#include <datamunge/algorithms/modular_exponentiation.hpp>
#include <datamunge/algorithms/integer_arithmetic.hpp>
#include <filesystem>
#include <print>
#include <algorithm>
#include <cmath>
#include <limits>
#include <climits>
#include <datamunge/algorithms/number_theory.hpp>
#include <numeric>
#include <numbers>
#include <random>
#include <string>
#include <vector>
#include <map>
#include <set>
#include <array>
#include <tuple>
#include <datamunge/algorithms/prufer.hpp>
#include <datamunge/algorithms/flow_diagram.hpp>
#include <datamunge/algorithms/postman_sort.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");

    std::vector<std::vector<std::uint32_t>> cases{{}, {7},
                                                  std::vector<std::uint32_t>(
                                                  32, 7),
                                                  std::vector<std::uint32_t>(
                                                  33, 7),
                                                  {UINT32_MAX, 0, UINT32_MAX, 1}};
    std::vector<std::string> labels{"empty", "singleton", "32 equal",
                                    "33 equal", "full-word keys"};
    std::vector<double> v;
    std::print("\n| fixture | actual radix nodes | actual insertion nodes | output count |\n| --- | ---: | " "---: | ---: |\n");
    for (std::size_t i = 0; i < cases.size(); ++i) {
        auto r = a::postman_sort_run(cases[i]);
        v.push_back(r.radix_nodes);
        std::print("| {} | {} | {} | {} |\n", labels[i], r.radix_nodes,
                   r.nodes - r.radix_nodes, r.sorted.size());
    }
    bool capped = false;
    try {
        a::PostmanOptions o;
        o.max_operations = 1;
        a::postman_sort_run({3, 2, 1}, o);
    } catch (const std::length_error &) {
        capped = true;
    }
    std::print("Selected work cap checked: {}.\n", capped);
    auto p = g::RPlot::barplot(v, labels, "actual byte passes");
    p.title("Postman controls: the default 32-key cutoff changes the actual path").y_label("actual radix nodes");
    p.save_svg("build/postman_sort_controls.svg");
}
```
