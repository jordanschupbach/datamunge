> The retained original experiment

```{cpp, results="markdown", file="figures/postman_sort_original.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <datamunge/plot/plot.hpp>
#include <datamunge/plot/diagram.hpp>
#include <datamunge/algorithms/modular_exponentiation.hpp>
#include <datamunge/algorithms/integer_arithmetic.hpp>
#include <filesystem>
#include <print>
#include <algorithm>
#include <cmath>
#include <limits>
#include <climits>
#include <datamunge/algorithms/number_theory.hpp>
#include <numeric>
#include <numbers>
#include <random>
#include <string>
#include <vector>
#include <map>
#include <set>
#include <array>
#include <tuple>
#include <datamunge/algorithms/prufer.hpp>
#include <datamunge/algorithms/flow_diagram.hpp>
#include <datamunge/algorithms/postman_sort.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");

    auto small =
        a::postman_sort_trace({300000, 12, 9000000, 42, 300500, 12, 8000123,
                               500, 9000001, 77});
    std::print("Original ten keys: actual sorted {}, radix nodes {}, insertion nodes {}.\n",
               small.run.sorted, small.run.radix_nodes,
               small.run.nodes - small.run.radix_nodes);
    auto t = a::postman_sort_trace(a::postman_uniform_keys(8000, 22));
    const auto &root = t.nodes[0];
    std::vector<double> counts;
    std::vector<std::string> labels;
    std::print("\n| actual top-byte group (16 buckets) | actual key count |\n| ---: | ---: |\n");
    for (std::size_t i = 0; i < 16; ++i) {
        auto count =
            std::accumulate(root.counts.begin() + 16 * i,
                            root.counts.begin() + 16 * (i + 1), std::size_t{0});
        counts.push_back(count);
        labels.push_back(std::to_string(i));
        std::print("| {} | {} |\n", i, count);
    }
    auto p =
        g::RPlot::barplot(counts, labels, "actual root histogram groups",
                          {234, 88, 12});
    p.title("Original 8000 seed 22 words: buckets read from the actual first byte pass").x_label("high-byte bucket group").y_label("actual keys");
    p.save_svg("build/postman_sort_original.svg");
}
```
