> Actual selected work and sensitivity

```{cpp, results="markdown", file="figures/postman_sort_work.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <datamunge/plot/plot.hpp>
#include <datamunge/plot/diagram.hpp>
#include <datamunge/algorithms/modular_exponentiation.hpp>
#include <datamunge/algorithms/integer_arithmetic.hpp>
#include <filesystem>
#include <print>
#include <algorithm>
#include <cmath>
#include <limits>
#include <climits>
#include <datamunge/algorithms/number_theory.hpp>
#include <numeric>
#include <numbers>
#include <random>
#include <string>
#include <vector>
#include <map>
#include <set>
#include <array>
#include <tuple>
#include <datamunge/algorithms/prufer.hpp>
#include <datamunge/algorithms/flow_diagram.hpp>
#include <datamunge/algorithms/postman_sort.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");

    std::vector<std::string> labels{"uniform8000", "equal8000", "two words"};
    std::vector<std::vector<std::uint32_t>> cases{a::postman_uniform_keys(
                                                  8000, 22),
                                                  std::vector<std::uint32_t>(
                                                  8000, 7), {UINT32_MAX, 0}};
    std::vector<double> v;
    std::print("\n| fixture | actual scanned keys | actual stable distributions | actual prefix additions | " "insertion comparisons | total selected events |\n| --- | ---: | ---: | ---: | ---: | ---: " "|\n");
    for (std::size_t i = 0; i < cases.size(); ++i) {
        auto r = a::postman_sort_run(cases[i]);
        v.push_back(std::log10(1. + r.operations));
        std::print("| {} | {} | {} | {} | {} | {} |\n", labels[i], r.key_scans,
                   r.distributions, r.prefix_steps, r.comparisons, r.operations);
    }
    auto p = g::RPlot::barplot(v, labels, "log10(actual selected events+1)");
    p.title("Same native sorter: actual work depends on byte concentration and fallback").y_label("log10(actual selected events+1)");
    p.save_svg("build/postman_sort_work.svg");
}
```
