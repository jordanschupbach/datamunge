> Producing work and finite observations

The table retains raw counts. The figure displays log10(count+1) so the single
reversal stays visible alongside quadratic search work.

```{cpp, results="markdown", file="figures/pancake_sort_work.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
    std::filesystem::create_directories("build");
    std::vector<double> x, y, z;
    std::print("| n | actual comparisons | actual flips |\n| ---: | ---: | ---: |\n");
    for (int n : {4, 8, 16, 32, 64}) {
        std::vector<int> a(n);
        std::iota(a.rbegin(), a.rend(), 1);
        auto t = dm::algorithms::pancake_sort_trace(a);
        std::size_t c = 0;
        for (auto &r : t.steps)
            c += r.comparisons;
        x.push_back(n);
        y.push_back(c);
        z.push_back(t.result.flips.size());
        std::print("| {} | {} | {} |\n", n, c, t.result.flips.size());
    }
    for (auto &value : y) value = std::log10(value + 1);
    for (auto &value : z) value = std::log10(value + 1);
    auto p = dm::graphics::RPlot::create();
    p.lines(x, y, "actual comparisons", {37, 99, 235}).points(x, y,
                                                              {37, 99, 235}, 4).lines(x, z, "actual flips", {220, 38, 38}).points(x, z, {220, 38, 38}, 4).title("Reverse pancakes: searches and reversals on a logarithmic count display").x_label("input size").y_label("log10(actual operation count + 1)");
    p.save_svg("build/pancake_sort_work.svg");
}
```
// result_begin: markdown
| n | actual comparisons | actual flips |
| ---: | ---: | ---: |
| 4 | 6 | 1 |
| 8 | 28 | 1 |
| 16 | 120 | 1 |
| 32 | 496 | 1 |
| 64 | 2016 | 1 |
\image(figures/pancake_sort_work.svg)
