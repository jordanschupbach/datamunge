> The original fixture, retained

This complete program retains the original inputs, seed and substantive
experiment. Any added display prefix is explicitly separate from the original
random call schedule.

```{cpp, results="markdown", file="figures/pancake_sort_original.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>


using namespace datamunge::algorithms;
using namespace datamunge::graphics;

int main() {
    std::ostringstream original_output;
    auto *original_cout = std::cout.rdbuf(original_output.rdbuf());

    std::filesystem::create_directories("build");
    const std::vector<int> original = {5, 3, 8, 1, 9, 2, 7};
    const PancakeResult res = pancake_sort(original);

    std::cout << "=== Pancake sort of [5,3,8,1,9,2,7] ===\n";
    std::cout << "sorted: ";
    for (int v : res.sorted)
        std::cout << v << " ";
    std::cout << "\nflip sequence (prefix lengths): ";
    for (std::size_t k : res.flips)
        std::cout << k << " ";
    std::cout << "\n(" << res.flips.size() << " flips; bound 2(n-1) = " <<
        2 * (original.size() - 1) << ")\n";

    auto trace = pancake_sort_trace(original);
    const auto &states = trace.states;
    auto plot = RPlot::create();
    for (std::size_t s = 0; s < states.size(); ++s)
        for (std::size_t p = 0; p < states[s].size(); ++p)
            plot.text(static_cast<double>(p), -static_cast<double>(s),
                      std::to_string(states[s][p]),
                      states[s][p] == 9 ? RGB{220, 38, 38} : RGB{37, 99, 235},
                      13.0);
    for (std::size_t s = 1; s < states.size(); ++s)
        plot.text(-1.3, -static_cast<double>(s),
                  "flip " + std::to_string(res.flips[s - 1]), RGB{31, 41, 55},
                  10.0);
    plot.text(-1.3, 0.0, "start", RGB{31, 41, 55}, 10.0);
    plot.title("Pancake sort: the array after each prefix flip (9 in red)").x_label("position").y_label("flip step (downward)").background({250, 250, 252});
    plot.x_limits(-2.0, static_cast<double>(original.size()));
    plot.y_limits(-static_cast<double>(states.size()), 0.8);
    plot.save_svg("build/pancake_sort_original.svg");
    std::cout << "\nwrote pancake_sort.svg\n";
    std::cout.rdbuf(original_cout);
    std::print("| Original computed output |\n| --- |\n");
    std::istringstream lines(original_output.str());
    std::string line;
    while (std::getline(lines, line)) {
        while (!line.empty() && line.back() == ' ') line.pop_back();
        if (!line.empty()) std::print("| `{}` |\n", line);
    }

    return 0;
}
```
