> Controls and boundary cases

```{cpp, results="markdown", file="figures/pancake_sort_controls.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
    std::filesystem::create_directories("build");
    std::vector<std::vector<int>> cases{{}, {1}, {1, 2, 3}, {3, 2, 1}, {2, 2, 2}};
    std::vector<double> v;
    std::vector<std::string> labels{"empty", "singleton", "sorted", "reverse",
                                    "equal"};
    std::print("| case | sorted | actual flips |\n| --- | --- | ---: |\n");
    for (std::size_t i = 0; i < cases.size(); ++i) {
        auto t = dm::algorithms::pancake_sort(cases[i]);
        v.push_back(t.flips.size());
        std::print("| {} | `{}` | {} |\n", labels[i], t.sorted, t.flips.size());
    }
    auto p = dm::graphics::RPlot::barplot(v, labels, "actual reversals");
    p.title("Greedy pancake controls: equal keys need not skip all flips").y_label("actual reversals");
    p.save_svg("build/pancake_sort_controls.svg");
}
```
// result_begin: markdown
| case | sorted | actual flips |
| --- | --- | ---: |
| empty | `[]` | 0 |
| singleton | `[1]` | 0 |
| sorted | `[1, 2, 3]` | 0 |
| reverse | `[1, 2, 3]` | 1 |
| equal | `[2, 2, 2]` | 2 |
\image(figures/pancake_sort_controls.svg)
// result_end
\caption(Explicit controlled inputs and their actual native outcomes.)
