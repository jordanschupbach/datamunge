> The retained original experiment

```{cpp, results="markdown", file="figures/shell_sort_original.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <filesystem>
#include <print>
#include <algorithm>
#include <cmath>
#include <limits>
#include <numeric>
#include <numbers>
#include <random>
#include <string>
#include <vector>
#include <map>
#include <set>
#include <array>
#include <tuple>
#include <bit>
#include <datamunge/random/quality.hpp>
#include <datamunge/algorithms/shell_sort.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    auto r = a::shell_sort_trace({5, 3, 8, 1, 9, 2, 7});
    std::vector<double> x, y;
    std::print("| gap | actual state | comparisons | shifts |\n| ---: | --- | ---: | ---: |\n");
    for (const auto &s : r.passes) {
        std::print("| {} | `{}` | {} | {} |\n", s.gap, s.after, s.comparisons,
                   s.shifts);
        x.push_back(s.gap);
        y.push_back(s.comparisons);
    }
    auto plot = g::RPlot::create();
    plot.lines(x, y, "actual values", {37, 99, 235}).points(x, y, {37, 99, 235},
                                                            4).title(
        "Original seven keys: actual gap work").x_label("gap").y_label(
        "key comparisons");
    plot.save_svg("build/shell_sort_original.svg");
}
```
// result_begin: markdown
| gap | actual state | comparisons | shifts |
| ---: | --- | ---: | ---: |
| 3 | `[1, 3, 2, 5, 9, 8, 7]` | 4 | 2 |
| 1 | `[1, 2, 3, 5, 7, 8, 9]` | 10 | 4 |
\image(figures/shell_sort_original.svg)
