> Explicit controls

```{cpp, results="markdown", file="figures/shell_sort_controls.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <filesystem>
#include <print>
#include <algorithm>
#include <cmath>
#include <limits>
#include <numeric>
#include <numbers>
#include <random>
#include <string>
#include <vector>
#include <map>
#include <set>
#include <array>
#include <tuple>
#include <bit>
#include <datamunge/random/quality.hpp>
#include <datamunge/algorithms/shell_sort.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    std::vector<double> x, y;
    const std::vector<std::vector<int>> inputs{{}, {1}, {1, 2, 3, 4},
                                               {4, 3, 2, 1}, {2, 2, 2, 2}};
    std::print("| control | actual sorted keys | comparisons | shifts |\n| ---: | --- | ---: | ---: |\n");
    for (std::size_t i = 0; i < inputs.size(); ++i) {
        auto r = a::shell_sort_run(inputs[i]);
        std::print("| {} | `{}` | {} | {} |\n", i, r.values, r.comparisons,
                   r.shifts);
        x.push_back(i);
        y.push_back(r.shifts);
    }
    auto plot = g::RPlot::create();
    plot.lines(x, y, "actual values", {37, 99, 235}).points(x, y, {37, 99, 235},
                                                            4).title(
        "Sorted and equal-key controls").x_label("control index").y_label(
        "actual shifts");
    plot.save_svg("build/shell_sort_controls.svg");
}
```
