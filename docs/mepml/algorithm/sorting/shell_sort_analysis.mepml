> Actual selected work and sensitivity

```{cpp, results="markdown", file="figures/shell_sort_work.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <filesystem>
#include <print>
#include <algorithm>
#include <cmath>
#include <limits>
#include <numeric>
#include <numbers>
#include <random>
#include <string>
#include <vector>
#include <map>
#include <set>
#include <array>
#include <tuple>
#include <bit>
#include <datamunge/random/quality.hpp>
#include <datamunge/algorithms/shell_sort.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    std::vector<double> x, y, z;
    std::print("| original shuffled size | Shell comparisons | insertion comparisons |\n| ---: | ---: | " "---: |\n");
    for (const auto &v : a::shell_sort_example_arrays()) {
        auto s = a::shell_sort_run(v), i = a::insertion_sort_work(v);
        std::print("| {} | {} | {} |\n", v.size(), s.comparisons, i.comparisons);
        x.push_back(v.size());
        y.push_back(s.comparisons);
        z.push_back(i.comparisons);
    }
    auto plot = g::RPlot::create();
    plot.lines(x, y, "halving-gap Shell", {37, 99, 235}).lines(
        x, z, "ordinary insertion", {220, 38, 38}).title(
        "Original mt19937 seed3: actual key comparisons").x_label("keys").y_label("comparisons");
    plot.save_svg("build/shell_sort_work.svg");
}
```
