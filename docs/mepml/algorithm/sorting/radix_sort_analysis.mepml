> Explicit controls

```{cpp, results="markdown", file="figures/radix_sort_controls.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <datamunge/plot/plot.hpp>
#include <datamunge/plot/diagram.hpp>
#include <datamunge/algorithms/modular_exponentiation.hpp>
#include <datamunge/algorithms/integer_arithmetic.hpp>
#include <filesystem>
#include <print>
#include <algorithm>
#include <cmath>
#include <limits>
#include <climits>
#include <datamunge/algorithms/number_theory.hpp>
#include <numeric>
#include <numbers>
#include <random>
#include <string>
#include <vector>
#include <map>
#include <set>
#include <array>
#include <tuple>
#include <datamunge/algorithms/prufer.hpp>
#include <datamunge/algorithms/flow_diagram.hpp>
#include <datamunge/geometry/hull_algorithms.hpp>
#include <datamunge/random/sampling_analysis.hpp>
#include <iomanip>
#include <bit>
#include <datamunge/algorithms/radix_sort.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");

    const auto lo =
        std::numeric_limits<std::int64_t>::min(), hi =
        std::numeric_limits<std::int64_t>::max();
    auto t = a::radix_sort_trace({hi, -1, lo, 0, -1, hi, lo});
    std::vector<double> x, y;
    std::print("\n| final rank | actual signed key | original identity |\n| ---: | ---: | ---: |\n");
    for (std::size_t i = 0; i < t.values.size(); ++i) {
        x.push_back(i);
        y.push_back(t.origins[i]);
        std::print("| {} | {} | {} |\n", i, t.values[i], t.origins[i]);
    }
    std::print("Empty pass count {}, singleton pass count {}.\n",
               a::radix_sort_trace({}).passes.size(),
               a::radix_sort_trace({7}).passes.size());
    auto p = g::RPlot::create();
    p.points(x, y, "actual original identity", {22, 163, 74}, 6).title(
        "Full signed range: equal keys keep input order").x_label(
        "actual sorted rank").y_label("original input identity");
    p.save_svg("build/radix_sort_controls.svg");
}
