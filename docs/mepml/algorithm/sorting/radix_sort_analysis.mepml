int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");

    auto t = a::radix_sort_trace({170, 45, 75, 90, 2, 802, 24, 66});
    std::print("\n| actual native byte shift | actual values | actual input identities |\n| ---: | --- | " "--- |\n");
    for (const auto &s : t.passes)
        std::print("| {} | `{}` | `{}` |\n", s.shift, s.values, s.origins);
    std::print("Original signed example: {}.\n",
               a::radix_sort_run({3, -1, -128, 127, 0, -1, 42, -42}).values);
    std::vector<std::string> labels;
    std::vector<double> counts;
    const auto &s = t.passes[0];
    std::print("\n| actual byte-zero bucket | count | actual starting prefix |\n| ---: | ---: | ---: |\n");
    for (std::size_t b = 0; b < 256; ++b)
        if (s.counts[b]) {
            labels.push_back(std::to_string(b));
    counts.push_back(s.counts[b]);
    std::print("| {} | {} | {} |\n", b, s.counts[b], s.offsets[b]);
        }
        auto p =
            g::RPlot::barplot(counts, labels,
                              "actual occupied byte-zero buckets");
        p.title("Original positive keys: actual base256 first-pass histogram").x_label("byte value, occupied buckets only").y_label("actual keys per bucket");
        p.save_svg("build/radix_sort_original.svg");
}
