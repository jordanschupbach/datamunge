#include <string>
#include <vector>
#include <map>
#include <set>
#include <array>
#include <tuple>
#include <datamunge/algorithms/prufer.hpp>
#include <datamunge/algorithms/flow_diagram.hpp>
#include <datamunge/geometry/hull_algorithms.hpp>
#include <datamunge/random/sampling_analysis.hpp>
#include <iomanip>
#include <bit>
#include <datamunge/algorithms/radix_sort.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");

    std::vector<double> x, y;
    std::print("\n| keys n | actual digit reads | actual scatter pairs | actual prefix steps | selected " "total |\n| ---: | ---: | ---: | ---: | ---: |\n");
    for (std::size_t n : {0, 1, 2, 8, 64, 512, 4096}) {
        auto r = a::radix_sort_run(std::vector<std::int64_t>(n, -7));
        const auto total = r.digit_reads + r.scatters + r.prefix_steps;
        x.push_back(n);
        y.push_back(total);
        std::print("| {} | {} | {} | {} | {} |\n", n, r.digit_reads, r.scatters,
                   r.prefix_steps, total);
    }
    auto p = g::RPlot::create();
    p.lines(x, y, "actual reads + scatters + prefixes", {16, 122, 87}).points(
        x, y, {16, 122, 87}, 5).title("Actual fixed-width radix work, including bucket overhead").x_label("input keys").y_label("actual selected events");
    p.save_svg("build/radix_sort_work.svg");
}
