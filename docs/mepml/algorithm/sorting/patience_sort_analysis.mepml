> Controls and boundary cases

```{cpp, results="markdown", file="figures/patience_sort_controls.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <datamunge/plot/diagram.hpp>
#include <datamunge/plot/plot.hpp>
#include <filesystem>
#include <print>
#include <iostream>
#include <sstream>
#include <algorithm>
#include <cmath>
#include <numeric>
#include <vector>
#include <string>
#include <datamunge/algorithms/patience_sort.hpp>
int main() {
    std::filesystem::create_directories("build");
    std::vector<std::vector<int>> cases{{}, {2, 2, 2}, {1, 2, 3}, {3, 2, 1},
                                        {1, 2, 1, 2}};
    std::vector<double> v;
    std::vector<std::string> labels{"empty", "equal", "increasing",
                                    "decreasing", "repeated"};
    std::print("| case | actual piles | sorted |\n| --- | ---: | --- |\n");
    for (std::size_t i = 0; i < cases.size(); ++i) {
        auto t = dm::algorithms::patience_sort_trace(cases[i]);
        v.push_back(t.piles.size());
        std::print("| {} | {} | `{}` |\n", labels[i], t.piles.size(), t.sorted);
    }
    auto p = dm::graphics::RPlot::barplot(v, labels, "strict LIS / pile count");
    p.title("Patience controls distinguish strict and nondecreasing subsequences").y_label("actual pile count");
    p.save_svg("build/patience_sort_controls.svg");
}
```
// result_begin: markdown
| case | actual piles | sorted |
| --- | ---: | --- |
| empty | 0 | `[]` |
| equal | 1 | `[2, 2, 2]` |
| increasing | 3 | `[1, 2, 3]` |
| decreasing | 1 | `[1, 2, 3]` |
| repeated | 2 | `[1, 1, 2, 2]` |
\image(figures/patience_sort_controls.svg)
// result_end
