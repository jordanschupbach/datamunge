> The original fixture, retained

This complete program retains the original inputs, seed and substantive
experiment. Any added display prefix is explicitly separate from the original
random call schedule.

```{cpp, results="markdown", file="figures/patience_sort_original.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <datamunge/plot/diagram.hpp>
#include <datamunge/plot/plot.hpp>
#include <filesystem>
#include <print>
#include <iostream>
#include <sstream>
#include <algorithm>
#include <cmath>
#include <numeric>
#include <vector>
#include <string>
#include <datamunge/algorithms/patience_sort.hpp>
#include <filesystem>
#include <datamunge/algorithms/sorting_extra.hpp>
#include <datamunge/plot/plot.hpp>

#include <iostream>
#include <sstream>
#include <string>
#include <vector>

using namespace datamunge::algorithms;
using namespace datamunge::graphics;

int main() {
    std::ostringstream original_output;
    auto *original_cout = std::cout.rdbuf(original_output.rdbuf());

    std::filesystem::create_directories("build");
    std::vector<int> a = {7, 2, 8, 1, 3, 9, 4, 6, 5, 0};
    auto s = a;
    patience_sort(s);
    std::cout << "=== patience sort ===\n";
    std::cout << "input:  ";
    for (int x : a)
        std::cout << x << " ";
    std::cout << "\n";
    std::cout << "sorted: ";
    for (int x : s)
        std::cout << x << " ";
    std::cout << "\n";

    auto trace = patience_sort_trace(a);
    std::vector<int> sizes;
    for (const auto &pile : trace.piles)
        sizes.push_back(static_cast<int>(pile.size()));
    std::cout << "piles: " << sizes.size() <<
        " (= longest increasing subsequence length)\n";
    std::vector<double> heights;
    std::vector<std::string> labels;
    for (std::size_t i = 0; i < sizes.size(); ++i) {
        std::cout << "  pile " << i << ": " << sizes[i] << " cards\n";
        heights.push_back(sizes[i]);
        labels.push_back("P" + std::to_string(i));
    }

    auto plot = RPlot::barplot(heights, labels, "size", RGB{124, 58, 237});
    plot.title("Patience sort piles (their count = longest increasing subsequence)").x_label("pile").y_label("cards").background({250, 250, 252});
    plot.save_svg("build/patience_sort_original.svg");
    std::cout << "\nwrote patience_sort.svg\n";
    std::cout.rdbuf(original_cout);
    std::print("| Original computed output |\n| --- |\n");
    std::istringstream lines(original_output.str());
    std::string line;
    while (std::getline(lines, line)) {
        while (!line.empty() && line.back() == ' ') line.pop_back();
        if (!line.empty()) std::print("| `{}` |\n", line);
    }

    return 0;
}
```
