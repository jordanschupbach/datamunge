> Producing work and finite observations

```{cpp, results="markdown", file="figures/patience_sort_work.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <datamunge/plot/diagram.hpp>
#include <datamunge/plot/plot.hpp>
#include <filesystem>
#include <print>
#include <iostream>
#include <sstream>
#include <algorithm>
#include <cmath>
#include <numeric>
#include <vector>
#include <string>
#include <datamunge/algorithms/patience_sort.hpp>
int main() {
    std::filesystem::create_directories("build");
    std::vector<double> x, y, z;
    std::print("| n | increasing-input pile count | actual top comparisons |\n| ---: | ---: | ---: |\n");
    for (int n : {4, 8, 16, 32, 64}) {
        std::vector<int> a(n);
        std::iota(a.begin(), a.end(), 0);
        auto t = dm::algorithms::patience_sort_trace(a);
        std::size_t c = 0;
        for (auto &r : t.deals)
            c += r.comparisons;
        x.push_back(n);
        y.push_back(c);
        z.push_back(t.piles.size());
        std::print("| {} | {} | {} |\n", n, t.piles.size(), c);
    }
    auto p = dm::graphics::RPlot::create();
    p.lines(x, y, "actual top comparisons", {37, 99, 235}).points(x, y,
                                                                  {37, 99, 235},
                                                                  4).lines(
        x, z, "actual piles", {220, 38, 38}).title("Increasing patience inputs: binary-search work and completed piles").x_label("input size").y_label("actual count");
    p.save_svg("build/patience_sort_work.svg");
}
```
