> Repeated values, empty input and complete caps

Equal values are allowed. The algorithm permutes positions, retaining n! rows,
rather than deduplicating visible value arrangements. For input 1, 1, 2 there
are six positional rows but only three distinct value rows; the first swap
exchanges two equal ones and leaves the visible row unchanged. Therefore
comparing consecutive rows is not a complete swap audit. If multiplicities are
m1,m2,…, the number of distinct value arrangements is n!/∏mi!, and every
arrangement occurs ∏mi! times in the positional enumeration.

Empty input has one empty permutation, since 0!=1; it is not an empty result.
The following controls also exercise exact and one-short complete output/history
limits before generation.

```{cpp, results="markdown", file="figures/heap_controls.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
    std::filesystem::create_directories("build");

    const std::vector<std::vector<int>> inputs{{}, {7}, {1, 1, 2}, {9, 9, 9}};
    std::vector<double> x, emitted, unique;
    std::print("| case | n | emitted rows | unique value rows | actual swaps | equal-valued swaps |\n| ---: " "| ---: | ---: | ---: | ---: | ---: |\n");
    for (std::size_t j = 0; j < inputs.size(); ++j) {
        const auto t = dm::algorithms::heap_permutations_trace(inputs[j]);
        const std::set<std::vector<int>> distinct(t.run.permutations.begin(),
                                                  t.run.permutations.end());
        std::size_t invisible = 0;
        for (const auto &e : t.swaps)
            invisible += e.left_value == e.right_value;
        std::print("| {} | {} | {} | {} | {} | {} |\n", j + 1, inputs[j].size(),
                   t.run.permutations.size(), distinct.size(), t.run.work.swaps,
                   invisible);
        x.push_back(j + 1);
        emitted.push_back(t.run.permutations.size());
        unique.push_back(distinct.size());
    }
    const auto exact =
        dm::algorithms::heap_permutations_trace({1, 2, 3}, {6, 18, 5});
    bool rows_reject =
        false, values_reject =
        false, history_reject = false, huge_reject = false;
    try {
        (void) dm::algorithms::heap_permutations_trace({1, 2, 3}, {5, 18, 5});
    } catch (const std::length_error &) {
        rows_reject = true;
    }
    try {
        (void) dm::algorithms::heap_permutations_trace({1, 2, 3}, {6, 17, 5});
    } catch (const std::length_error &) {
        values_reject = true;
    }
    try {
        (void) dm::algorithms::heap_permutations_trace({1, 2, 3}, {6, 18, 4});
    } catch (const std::length_error &) {
        history_reject = true;
    }
    try {
        (void) dm::algorithms::heap_permutation_size(std::numeric_limits<
                                                     std::size_t>::max());
    } catch (const std::length_error &) {
        huge_reject = true;
    }
    std::print("\nExact caps retain {} rows/{} swaps. One-short row/value/history limits reject: {}/{}/{}. " "Huge count-only request rejects: {}.\n",
               exact.run.permutations.size(), exact.swaps.size(), rows_reject,
               values_reject, history_reject, huge_reject);
    if (!rows_reject || !values_reject || !history_reject || !huge_reject)
        throw std::runtime_error("complete limits");
    auto plot = dm::graphics::RPlot::create();
    std::vector<double> left = x, right = x;
    for (auto &v : left)
        v -= .18;
    for (auto &v : right)
        v += .18;
    plot.bars(left, emitted, "emitted positional rows", {37, 99, 235}, .32).bars(right, unique, "unique value rows", {220, 38, 38}, .32).title("Repeated values retain positional multiplicity").x_label("case: 1 empty; 2 singleton; 3 (1,1,2); 4 (9,9,9)").y_label("row count").y_limits(0, 8).save_svg("build/heap_controls.svg");
}
```
