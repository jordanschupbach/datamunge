> Checking the theory and controls

```{cpp, results="markdown", file="figures/uniform_binary_search_controls.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    std::vector<double> x, y;
    std::vector<int> keys{1, 2, 2, 4};
    std::print("| query | found | actual index |\n|---:|---|---|\n");
    for (int key : {0, 1, 2, 3, 4, 5}) {
        auto r =
            a::uniform_binary_search_work(keys, key, a::uniform_search_table(4));
        bool found = r.index != std::size_t(-1);
        std::print("|{}|{}|{}|\n", key, found,
                   found ? std::to_string(r.index) : "absent");
        x.push_back(key);
        y.push_back(r.comparisons);
    }
    auto p = g::RPlot::create();
    p.line(x, y, "actual", {37, 99, 235}, 2);
    p.points(x, y, "", {37, 99, 235}, 5);
    p.title("Duplicates choose the rightmost match; misses are explicit").x_label("key").y_label("actual comparisons excluding validation");
    p.save_svg("build/uniform_binary_search_controls.svg");
}
```
// result_begin: markdown
| query | found | actual index |
|---:|---|---|
|0|false|absent|
|1|true|0|
|2|true|2|
|3|false|absent|
|4|true|3|
|5|false|absent|
\image(figures/uniform_binary_search_controls.svg)
