> The retained original experiment

```{cpp, results="markdown", file="figures/uniform_binary_search_original.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    std::vector<int> keys(100);
    for (int i = 0; i < 100; ++i)
        keys[i] = 3 * i;
    auto r =
        a::uniform_binary_search_work(keys, 231, a::uniform_search_table(100));
    std::vector<double> x, y;
    std::print("| step | stride | actual running index |\n|---:|---:|---:|\n");
    for (std::size_t i = 0; i < r.probes.size(); ++i) {
        auto q = r.probes[i];
        std::print("|{}|{}|{}|\n", i + 1, q.step, q.after);
        x.push_back(i + 1);
        y.push_back(q.after);
    }
    std::print("\nActual target231 match index {}; expected77.\n", r.index);
    auto p = g::RPlot::create();
    p.line(x, y, "actual", {37, 99, 235}, 2);
    p.points(x, y, "", {37, 99, 235}, 5);
    p.title("Original100 keys: actual running index reaches77").x_label(
        "scheduled step").y_label("actual running index");
    p.save_svg("build/uniform_binary_search_original.svg");
}
```
// result_begin: markdown
| step | stride | actual running index |
|---:|---:|---:|
|1|64|63|
|2|32|63|
|3|16|63|
|4|8|71|
|5|4|75|
|6|2|77|
|7|1|77|

Actual target231 match index 77; expected77.
