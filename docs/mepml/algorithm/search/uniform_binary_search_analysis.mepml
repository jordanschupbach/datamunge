> Sensitivity and selected work

```{cpp, results="markdown", file="figures/uniform_binary_search_work.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    std::vector<double> x, y;
    std::print("| n | schedule probes | actual comparisons |\n|---:|---:|---:|\n");
    for (int n : {1, 2, 3, 4, 7, 8, 15, 16, 31, 32, 100, 1000}) {
        std::vector<int> keys(n);
        std::iota(keys.begin(), keys.end(), 0);
        auto r =
            a::uniform_binary_search_work(keys, n - 1,
                                          a::uniform_search_table(n));
        std::print("|{}|{}|{}|\n", n, r.probes.size(), r.comparisons);
        x.push_back(n);
        y.push_back(r.probes.size());
    }
    std::print("\nINT_MAX schedule length {}.\n",
               a::uniform_search_table(INT_MAX).size());
    auto p = g::RPlot::create();
    p.line(x, y, "actual", {37, 99, 235}, 2);
    p.points(x, y, "", {37, 99, 235}, 5);
    p.title("Fixed schedule length grows logarithmically").x_label("n").y_label(
        "actual schedule probes");
    p.save_svg("build/uniform_binary_search_work.svg");
}
```
// result_begin: markdown
| n | schedule probes | actual comparisons |
|---:|---:|---:|
|1|1|2|
