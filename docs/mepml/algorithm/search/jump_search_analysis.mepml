| --- | --- | ---: | ---: | ---: | ---: | ---: |
| empty | false | -1 | 0 | 0 | 0 | 0 |
| singleton equal | true | 0 | 2 | 1 | 1 | 0 |
| duplicate first | true | 0 | 2 | 1 | 1 | 0 |
| below all | false | -1 | 2 | 1 | 1 | 1 |
| above all | false | -1 | 3 | 3 | 0 | 0 |
| gap | false | -1 | 4 | 3 | 1 | 1 |
