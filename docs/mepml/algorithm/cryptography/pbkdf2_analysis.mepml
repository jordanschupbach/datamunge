> The original fixture, retained

This complete program retains the original inputs, seed and substantive
experiment. Any added display prefix is explicitly separate from the original
random call schedule.

```{cpp, results="markdown", file="figures/pbkdf2_original.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>


using namespace datamunge::algorithms;
using namespace datamunge::graphics;

int main() {
    std::ostringstream original_output;
    auto *original_cout = std::cout.rdbuf(original_output.rdbuf());

    std::filesystem::create_directories("build");
    std::cout <<
        "=== Standard PBKDF2-HMAC-SHA256 vectors (\"password\",\"salt\") ===\n";
    std::cout << "c=1     : " <<
        pbkdf2_hmac_sha256_hex("password", "salt", 1, 32) << "\n";
    std::cout << "c=2     : " <<
        pbkdf2_hmac_sha256_hex("password", "salt", 2, 32) << "\n";
    std::cout << "c=4096  : " <<
        pbkdf2_hmac_sha256_hex("password", "salt", 4096, 32) << "\n";

    std::cout << "\n=== Same password, different salt -> unrelated keys ===\n";
    std::cout << "salt=\"salt1\": " <<
        pbkdf2_hmac_sha256_hex("password", "salt1", 1000, 16) << "\n";
    std::cout << "salt=\"salt2\": " <<
        pbkdf2_hmac_sha256_hex("password", "salt2", 1000, 16) << "\n";

    // Cost curve: HMAC evaluations = c per 32-byte block. Plot vs iteration count.
    std::vector<double> iters = {1000, 2000, 4000, 8000, 16000, 32000};
    std::vector<double> hmac_calls;
    for (double c : iters)
        hmac_calls.push_back(pbkdf2_hmac_sha256_run("password", "salt",
                                                    static_cast<std::uint32_t>(
                                                    c), 32).hmac_calls);  // one 32-byte block -> exactly c HMACs
    std::cout <<
        "\n=== Work factor (HMAC-SHA256 evaluations per derivation) ===\n";
    for (std::size_t i = 0; i < iters.size(); ++i)
        std::cout << "  c=" << (int) iters[i] << " -> " <<
            (int) hmac_calls[i] << " HMAC calls\n";

    RPlot p = RPlot::create();
    p.lines(iters, hmac_calls, "HMAC evaluations", {37, 99, 235}, 2.0);
    p.points(iters, hmac_calls, "", {220, 38, 38}, 5.0);
    p.title("Original PBKDF2 settings: actual HMAC calls").x_label(
        "iterations per 32-byte block").y_label("actual HMAC calls");
    p.save_svg("build/pbkdf2_original.svg");
    std::cout << "\nwrote build/pbkdf2_original.svg\n";
    std::cout.rdbuf(original_cout);
    std::print("| Original computed output |\n| --- |\n");
    std::istringstream lines(original_output.str());
    std::string line;
    while (std::getline(lines, line)) {
        while (!line.empty() && line.back() == ' ') line.pop_back();
        if (!line.empty()) std::print("| `{}` |\n", line);
    }

    return 0;
}
```
