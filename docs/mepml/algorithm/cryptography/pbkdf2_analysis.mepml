> Producing work and finite observations

```{cpp, results="markdown", file="figures/pbkdf2_work.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
    std::filesystem::create_directories("build");
    std::vector<double> x, y;
    std::print("| iterations | actual HMAC calls |\n| ---: | ---: |\n");
    for (std::uint32_t c : {1000, 2000, 4000, 8000, 16000, 32000}) {
        auto r =
            dm::algorithms::pbkdf2_hmac_sha256_run("password", "salt", c, 32);
        x.push_back(c);
        y.push_back(r.hmac_calls);
        std::print("| {} | {} |\n", c, r.hmac_calls);
    }
    auto p = dm::graphics::RPlot::create();
    p.lines(x, y, "actual HMAC calls", {37, 99, 235}).points(x, y,
                                                             {37, 99, 235}, 4).title("Original PBKDF2 work settings: measured producing call counts").x_label("iterations c").y_label("actual HMAC calls");
    p.save_svg("build/pbkdf2_work.svg");
}
```
