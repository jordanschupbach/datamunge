> Controls and boundary cases

```{cpp, results="markdown", file="figures/pbkdf2_controls.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
    std::filesystem::create_directories("build");
    std::vector<double> v;
    std::vector<std::string> labels;
    std::print("| requested bytes | actual HMAC calls at c=2 | derived hex |\n| ---: | ---: | --- |\n");
    for (std::size_t n : {0, 1, 31, 32, 33, 64, 65}) {
        auto r = dm::algorithms::pbkdf2_hmac_sha256_run("p", "s", 2, n);
        labels.push_back(std::to_string(n));
        v.push_back(r.hmac_calls);
        std::print("| {} | {} | `{}` |\n", n, r.hmac_calls,
                   (n ? dm::algorithms::pbkdf2_hmac_sha256_hex("p", "s", 2, n)
                    : std::string("(empty)")));
    }
    auto p = dm::graphics::RPlot::barplot(v, labels, "actual HMAC calls");
    p.title("PBKDF2 block-boundary work: partial blocks still require full chains").x_label("requested key bytes").y_label("actual HMAC calls");
    p.save_svg("build/pbkdf2_controls.svg");
}
```
