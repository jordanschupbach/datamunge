> The retained original experiment

```{cpp, results="markdown", file="figures/rc4_original.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <datamunge/plot/plot.hpp>
#include <datamunge/plot/diagram.hpp>
#include <datamunge/algorithms/modular_exponentiation.hpp>
#include <datamunge/algorithms/integer_arithmetic.hpp>
#include <filesystem>
#include <print>
#include <algorithm>
#include <cmath>
#include <limits>
#include <climits>
#include <datamunge/algorithms/number_theory.hpp>
#include <numeric>
#include <numbers>
#include <random>
#include <string>
#include <vector>
#include <map>
#include <set>
#include <array>
#include <tuple>
#include <datamunge/algorithms/prufer.hpp>
#include <datamunge/algorithms/flow_diagram.hpp>
#include <datamunge/geometry/hull_algorithms.hpp>
#include <datamunge/random/sampling_analysis.hpp>
#include <iomanip>
#include <datamunge/algorithms/qr_algorithm.hpp>
#include <datamunge/stats/lm.hpp>
#include <datamunge/algorithms/arithmetic_coding.hpp>
#include <datamunge/nn/rbf.hpp>
#include <datamunge/nn/model_plot.hpp>
#include <bit>
#include <datamunge/algorithms/rc4.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");

    const auto hex = [](const std::string & bytes) {
        std::string out;
        for (unsigned char c : bytes)
            out += std::format("{:02x}", unsigned(c));
        return out;
    };
    std::print("\n| original key | original plaintext | actual native ciphertext hex | exact decrypt |\n| " "--- | --- | --- | --- |\n");
    for (const auto & [key, text] : std::vector<std::pair<std::string, std::string>> {
        { "Key", "Plaintext" }, {"Wiki", "pedia"}, {"Secret", "Attack at dawn"}
    }) {
        const auto cipher = a::rc4_encrypt(key, text);
        std::print("| {} | {} | {} | {} |\n", key, text, hex(cipher),
                   a::rc4_encrypt(key, cipher) == text);
    }
    auto study = a::rc4_second_byte_study();
    std::print("Actual deterministic key draws: {}; distinct strings: {}; actual second-byte zeros: {}; " "fraction: {}.\n",
               study.keys, study.unique_keys, study.counts[0],
               double(study.counts[0]) / study.keys);
    std::vector<double> counts;
    std::vector<std::string> labels;
    for (std::size_t i = 0; i < 16; ++i) {
        counts.push_back(study.groups[i]);
        labels.push_back(std::to_string(i));
    }
    auto p =
        g::RPlot::barplot(counts, labels,
                          "actual deterministic second-byte high-nibble counts");
    p.abline_h(double(study.keys) / 16, {37, 99, 235}).title(
        "Original 20,000-key recipe: actual grouped second bytes").x_label(
        "second-byte high nibble").y_label("actual key-string draws per bin");
    p.save_svg("build/rc4_original.svg");
}
```
