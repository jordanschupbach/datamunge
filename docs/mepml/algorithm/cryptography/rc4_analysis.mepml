> Explicit controls

```{cpp, results="markdown", file="figures/rc4_controls.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <datamunge/plot/plot.hpp>
#include <datamunge/plot/diagram.hpp>
#include <datamunge/algorithms/modular_exponentiation.hpp>
#include <datamunge/algorithms/integer_arithmetic.hpp>
#include <filesystem>
#include <print>
#include <algorithm>
#include <cmath>
#include <limits>
#include <climits>
#include <datamunge/algorithms/number_theory.hpp>
#include <numeric>
#include <numbers>
#include <random>
#include <string>
#include <vector>
#include <map>
#include <set>
#include <array>
#include <tuple>
#include <datamunge/algorithms/prufer.hpp>
#include <datamunge/algorithms/flow_diagram.hpp>
#include <datamunge/geometry/hull_algorithms.hpp>
#include <datamunge/random/sampling_analysis.hpp>
#include <iomanip>
#include <datamunge/algorithms/qr_algorithm.hpp>
#include <datamunge/stats/lm.hpp>
#include <datamunge/algorithms/arithmetic_coding.hpp>
#include <datamunge/nn/rbf.hpp>
#include <datamunge/nn/model_plot.hpp>
#include <bit>
#include <datamunge/algorithms/rc4.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");

    const std::string key("\x01\x02\x03\x04\x05", 5);
    const auto t = a::rc4_trace(key, 16);
    std::string actual;
    for (auto byte : t.bytes)
        actual += std::format("{:02x}", unsigned(byte));
    const bool vector = actual == "b2396305f03dc027ccc3524a0a1118a8";
    const std::string binary("a\0\xff", 3);
    const auto encoded = a::rc4_encrypt(key, binary);
    const bool roundtrip = a::rc4_encrypt(key, encoded) == binary;
    bool empty = false;
    try {
        a::rc4_keystream("", 0);
    } catch (const std::invalid_argument &) {
        empty = true;
    }
    std::print("\n| actual control | outcome |\n| --- | --- |\n| RFC6229 first16 bytes | {} |\n| exact RFC " "byte comparison | {} |\n| embedded-NUL/high-byte round trip | {} |\n| empty key rejected " "before indexing | {} |\n",
               actual, vector, roundtrip, empty);
    auto p =
        g::RPlot::barplot({double(t.scheduling.size()), double(t.steps.size())},
                          {"actual KSA swaps", "actual PRGA steps"},
                          "actual state updates");
    p.title("RFC6229 conformance uses the real byte-stream producer").y_label(
        "actual schedule/output updates");
    p.save_svg("build/rc4_controls.svg");
    if (!vector || !roundtrip || !empty)
        return 1;
}
```
