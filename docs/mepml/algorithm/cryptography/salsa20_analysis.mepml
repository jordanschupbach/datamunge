> The retained original experiment

```{cpp, results="markdown", file="figures/salsa20_original.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <filesystem>
#include <print>
#include <algorithm>
#include <cmath>
#include <limits>
#include <numeric>
#include <numbers>
#include <random>
#include <string>
#include <vector>
#include <map>
#include <set>
#include <array>
#include <tuple>
#include <bit>
#include <datamunge/algorithms/salsa20.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    auto e = a::salsa20_example();
    auto r = a::salsa20_stream_trace(e.key, 0, e.nonce, e.plaintext);
    auto recovered = a::salsa20_encrypt(e.key, 0, e.nonce, r.output);
    std::print("Original message: {}\n\nActual bytes {}, blocks {}, byte XORs {}, round-trip {}.\n\n| byte " "index | actual ciphertext byte |\n| ---: | ---: |\n",
               e.plaintext, r.output.size(), r.block_calls, r.byte_xors,
               recovered == e.plaintext);
    std::vector<double> x, y;
    for (std::size_t i = 0; i < r.output.size(); ++i) {
        auto v = static_cast<unsigned char>(r.output[i]);
        std::print("| {} | {} |\n", i, unsigned(v));
        x.push_back(i);
        y.push_back(v);
    }
    if (recovered != e.plaintext)
        return 1;
    auto plot = g::RPlot::create();
    plot.lines(x, y, "actual values", {37, 99, 235}).points(x, y, {37, 99, 235},
                                                            5).title(
        "Original message: actual ciphertext byte values").x_label("byte index").y_label("byte value");
    plot.save_svg("build/salsa20_original.svg");
}
```
