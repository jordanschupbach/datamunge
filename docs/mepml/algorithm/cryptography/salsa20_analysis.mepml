> Explicit controls

```{cpp, results="markdown", file="figures/salsa20_controls.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <filesystem>
#include <print>
#include <algorithm>
#include <cmath>
#include <limits>
#include <numeric>
#include <numbers>
#include <random>
#include <string>
#include <vector>
#include <map>
#include <set>
#include <array>
#include <tuple>
#include <bit>
#include <datamunge/algorithms/salsa20.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    auto e = a::salsa20_example();
    std::vector<double> x, y;
    std::print("| raw binary length | actual blocks | actual XORs | round-trip |\n| ---: | ---: | ---: | " "--- |\n");
    for (std::size_t n : {0, 1, 63, 64, 65, 145}) {
        std::string data(n, char{0});
        auto r = a::salsa20_stream_trace(e.key, 3, e.nonce, data);
        auto recovered = a::salsa20_encrypt(e.key, 3, e.nonce, r.output);
        std::print("| {} | {} | {} | {} |\n", n, r.block_calls, r.byte_xors,
                   recovered == data);
        x.push_back(n);
        y.push_back(r.block_calls);
    }
    bool wrap = false;
    try {
        a::salsa20_stream_run(e.key, std::numeric_limits<std::uint64_t>::max(),
                              e.nonce, std::string(65, char{0}));
    } catch (const std::overflow_error &) {
        wrap = true;
    }
    std::print("Counter wrap rejected {}.\n", wrap);
    if (!wrap)
        return 1;
    auto plot = g::RPlot::create();
    plot.lines(x, y, "actual values", {37, 99, 235}).points(x, y, {37, 99, 235},
                                                            5).title(
        "Actual partial and complete counter blocks").x_label("message bytes").y_label("actual generated blocks");
    plot.save_svg("build/salsa20_controls.svg");
}
```
// result_begin: markdown
| raw binary length | actual blocks | actual XORs | round-trip |
| ---: | ---: | ---: | --- |
| 0 | 0 | 0 | true |
| 1 | 1 | 1 | true |
| 63 | 1 | 63 | true |
| 64 | 1 | 64 | true |
| 65 | 2 | 65 | true |
| 145 | 3 | 145 | true |
Counter wrap rejected true.
\image(figures/salsa20_controls.svg)
