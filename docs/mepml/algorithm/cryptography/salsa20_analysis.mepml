int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    auto e = a::salsa20_example();
    auto r = a::salsa20_byte_study(e.key, e.nonce);
    std::vector<double> x, y;
    std::print("Actual generated blocks {}, bytes {}.\n\n| high nibble | actual byte count |\n| ---: | ---: " "|\n",
               r.blocks, r.bytes);
    for (std::size_t i = 0; i < r.groups.size(); ++i) {
        std::print("| {} | {} |\n", i, r.groups[i]);
        x.push_back(i);
        y.push_back(r.groups[i]);
    }
    auto plot = g::RPlot::create();
    plot.lines(x, y, "actual values", {37, 99, 235}).points(x, y, {37, 99, 235},
                                                            5).title(
        "Fixed-key byte histogram: diagnostic, not security proof").x_label(
        "high nibble").y_label("actual observed bytes");
    plot.save_svg("build/salsa20_work.svg");
}
