> Actual selected work and sensitivity

```{cpp, results="markdown", file="figures/shamir_secret_sharing_work.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <filesystem>
#include <print>
#include <algorithm>
#include <cmath>
#include <limits>
#include <numeric>
#include <numbers>
#include <random>
#include <string>
#include <vector>
#include <map>
#include <set>
#include <array>
#include <tuple>
#include <bit>
#include <datamunge/random/quality.hpp>
#include <datamunge/algorithms/shamir_secret_sharing.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    std::vector<double> x, y;
    std::print("| supplied threshold | actual split products | actual combine products | actual " "inverse-only products | recovered |\n| ---: | ---: | ---: | ---: | ---: |\n");
    for (std::size_t k : {1, 2, 3, 4, 8, 16}) {
        std::vector<std::uint64_t> c(k - 1, 7);
        auto split = a::shamir_split_run(1234, k, c, 2087);
        auto r = a::shamir_combine_run(split.shares, 2087);
        std::print("| {} | {} | {} | {} | {} |\n", k, split.modular_products,
                   r.modular_products, r.inverse_products, r.secret);
        x.push_back(k);
        y.push_back(r.modular_products);
    }
    auto plot = g::RPlot::create();
    plot.lines(x, y, "actual values", {37, 99, 235}).points(x, y, {37, 99, 235},
                                                            5).title(
        "Actual interpolation products include delegated inverses").x_label(
        "supplied share count").y_label("actual modular products");
    plot.save_svg("build/shamir_secret_sharing_work.svg");
}
```
