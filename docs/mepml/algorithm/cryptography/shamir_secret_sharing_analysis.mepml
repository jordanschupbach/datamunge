> Explicit controls

```{cpp, results="markdown", file="figures/shamir_secret_sharing_controls.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <filesystem>
#include <print>
#include <algorithm>
#include <cmath>
#include <limits>
#include <numeric>
#include <numbers>
#include <random>
#include <string>
#include <vector>
#include <map>
#include <set>
#include <array>
#include <tuple>
#include <bit>
#include <datamunge/random/quality.hpp>
#include <datamunge/algorithms/shamir_secret_sharing.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    const std::vector<a::SecretShare> observed{{1, 5}, {2, 9}};
    std::vector<double> x, y;
    std::print("| candidate constant | actual compatible a1 | actual compatible a2 | reproduces both public " "observations |\n| ---: | ---: | ---: | --- |\n");
    for (std::uint64_t candidate = 0; candidate < 17; ++candidate) {
        auto c = a::shamir_quadratic_completion(observed, candidate, 17);
        auto r = a::shamir_split_run(candidate, 3, c, 17);
        bool matches = r.shares[0].y == 5 && r.shares[1].y == 9;
        std::print("| {} | {} | {} | {} |\n", candidate, c[0], c[1], matches);
        if (!matches)
            return 1;
        x.push_back(candidate);
        y.push_back(c[1]);
    }
    auto plot = g::RPlot::create();
    plot.lines(x, y, "actual values", {37, 99, 235}).points(x, y, {37, 99, 235},
                                                            5).title(
        "Every field17 candidate fits the same two observations").x_label(
        "candidate secret").y_label("actual compatible quadratic coefficient");
    plot.save_svg("build/shamir_secret_sharing_controls.svg");
}
```
