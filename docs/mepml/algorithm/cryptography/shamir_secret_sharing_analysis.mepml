> The retained original experiment

```{cpp, results="markdown", file="figures/shamir_secret_sharing_original.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <filesystem>
#include <print>
#include <algorithm>
#include <cmath>
#include <limits>
#include <numeric>
#include <numbers>
#include <random>
#include <string>
#include <vector>
#include <map>
#include <set>
#include <array>
#include <tuple>
#include <bit>
#include <datamunge/random/quality.hpp>
#include <datamunge/algorithms/shamir_secret_sharing.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    auto r = a::shamir_split_trace(1234, 6, {166, 94}, 2087);
    std::print("| original share x | actual field y |\n| ---: | ---: |\n");
    for (auto s : r.shares)
        std::print("| {} | {} |\n", s.x, s.y);
    std::print("\n| original three-share indices | actual reconstructed secret | actual modular products " "|\n| --- | ---: | ---: |\n");
    std::vector<double> x, y;
    const std::vector<std::vector<int>> subsets{{0, 1, 2}, {0, 2, 4}, {1, 3, 5},
                                                {2, 4, 5}};
    for (std::size_t i = 0; i < subsets.size(); ++i) {
        std::vector<a::SecretShare> chosen;
        for (int id : subsets[i])
            chosen.push_back(r.shares[id]);
        auto c = a::shamir_combine_trace(chosen, 2087);
        std::print("| `{}` | {} | {} |\n", subsets[i], c.secret,
                   c.modular_products);
        x.push_back(i);
        y.push_back(c.secret);
    }
    auto two = a::shamir_combine_trace({r.shares[0], r.shares[1]}, 2087);
    std::print("\nTwo-share interpolant at zero is {}, which does not certify the original threshold.\n",
               two.secret);
    auto plot = g::RPlot::create();
    plot.lines(x, y, "actual values", {37, 99, 235}).points(x, y, {37, 99, 235},
                                                            5).title(
        "Original four sufficient subsets recover the same constant").x_label(
        "three-share subset index").y_label("actual reconstructed field residue");
    plot.save_svg("build/shamir_secret_sharing_original.svg");
}
```
