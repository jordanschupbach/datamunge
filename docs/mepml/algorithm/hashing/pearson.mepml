> Controls and boundary cases

```{cpp, results="markdown", file="figures/pearson_controls.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
    std::filesystem::create_directories("build");
    std::vector<double> v;
    std::vector<std::string> labels;
    std::print("| bytes | 8-bit hash | native 2-byte extension |\n| --- | ---: | ---: |\n");
    for (const std::string word : {"hash", "hush", "", "a", "aa"}) {
        auto h = dm::algorithms::pearson_hash(word);
        v.push_back(h);
        labels.push_back(word.empty() ? "empty" : word);
        std::print("| {} | {} | {} |\n", labels.back(), int(h),
                   dm::algorithms::pearson_hash_wide(word, 2));
    }
    auto p = dm::graphics::RPlot::barplot(v, labels, "actual hash byte");
    p.title("Pearson controls: byte sensitivity is weaker than collision freedom").y_label("actual eight-bit hash");
    p.save_svg("build/pearson_controls.svg");
}
```
// result_begin: markdown
| bytes | 8-bit hash | native 2-byte extension |
| --- | ---: | ---: |
| hash | 12 | 3268 |
| hush | 39 | 10189 |
| empty | 0 | 0 |
| a | 96 | 24786 |
| aa | 6 | 1619 |
\image(figures/pearson_controls.svg)
