> The original fixture, retained

This complete program retains the original inputs, seed and substantive
experiment. Any added display prefix is explicitly separate from the original
random call schedule.

```{cpp, results="markdown", file="figures/pearson_original.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>


using namespace datamunge::algorithms;
using namespace datamunge::graphics;

int main() {
    std::ostringstream original_output;
    auto *original_cout = std::cout.rdbuf(original_output.rdbuf());

    std::filesystem::create_directories("build");
    const std::vector<std::string> words = {"the", "quick", "brown", "fox",
                                            "jumps", "over", "lazy", "dog",
                                            "hash", "table", "algorithm",
                                            "data", "structure", "vector",
                                            "matrix", "graph", "tree", "heap",
                                            "queue", "stack", "alpha", "beta",
                                            "gamma", "delta", "one", "two",
                                            "three", "four", "five", "six",
                                            "seven", "eight"};

    std::cout << "=== Pearson hashing (8-bit) ===\n";
    std::cout << "hash(\"hash\") = " <<
        static_cast<int>(pearson_hash("hash")) << '\n';
    std::cout << "hash(\"hush\") = " <<
        static_cast<int>(pearson_hash("hush")) <<
        "  (one-byte change flips it)\n\n";

    std::vector<double> buckets(16, 0.0);
    for (const auto &w : words)
        buckets[pearson_hash(w) / 16] += 1.0;  // high nibble bucket
    std::cout << words.size() <<
        " words into 16 buckets (by high nibble of the 8-bit hash):\n  ";
    for (double b : buckets)
        std::cout << static_cast<int>(b) << ' ';
    std::cout << "\n(ideal ~" << double(words.size()) / 16.0 <<
        " per bucket)\n";

    std::vector<std::string> labels;
    for (int i = 0; i < 16; ++i)
        labels.push_back(std::to_string(i));
    RPlot p =
        RPlot::barplot(buckets, labels, "words per bucket", {147, 51, 234});
    p.abline_h(double(words.size()) / 16.0, {220, 38, 38}, 1.5);
    p.title("Original 32-word cohort: descriptive Pearson high-nibble counts").x_label("high-nibble bucket").y_label("actual word count");
    p.save_svg("build/pearson_original.svg");
    std::cout << "\nwrote build/pearson_original.svg\n";
    std::cout.rdbuf(original_cout);
    std::print("| Original computed output |\n| --- |\n");
    std::istringstream lines(original_output.str());
    std::string line;
    while (std::getline(lines, line)) {
        while (!line.empty() && line.back() == ' ') line.pop_back();
        if (!line.empty()) std::print("| `{}` |\n", line);
    }

    return 0;
}
```
