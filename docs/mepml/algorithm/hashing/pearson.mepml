> Producing work and finite observations

```{cpp, results="markdown", file="figures/pearson_work.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
    std::filesystem::create_directories("build");
    std::vector<double> v(16, 0);
    for (int i = 0; i < 256; ++i) {
        std::string d(1, static_cast<char>(i));
        ++v[dm::algorithms::pearson_hash(d) / 16];
    }
    std::vector<std::string> labels;
    for (int i = 0; i < 16; ++i)
        labels.push_back(std::to_string(i));
    std::print("All256 one-byte inputs, actual high-nibble counts: `{}`.\n", v);
    auto p = dm::graphics::RPlot::barplot(v, labels, "actual count");
    p.title("Pearson complete one-byte domain: permutation forces exact balance").x_label("high nibble").y_label("actual count");
    p.save_svg("build/pearson_work.svg");
}
```
// result_begin: markdown
All256 one-byte inputs, actual high-nibble counts: `[16, 16, 16, 16, 16, 16, 16, 16, 16, 16, 16, 16, 16, 16, 16, 16]`.
\image(figures/pearson_work.svg)
// result_end
