> The retained original experiment

```{cpp, results="markdown", file="figures/siphash_original.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    auto key = a::siphash_example_key();
    std::print("| original reference length | actual hash hex | reference hash hex |\n| ---: | --- | --- " "|\n");
    for (std::size_t n : {0, 15})
        std::print("| {} | {:016x} | {} |\n", n,
                   a::siphash24(key, a::siphash_example_message(n)),
                   n == 0 ? "726fdb47dd0e0e31" : "a129ca6149be45e5");
    auto key2 = key;
    key2[0] ^= 1;
    auto first =
        a::siphash_bucket_counts(key, a::siphash_example_words(), 16), second =
        a::siphash_bucket_counts(key2, a::siphash_example_words(), 16);
    std::vector<double> x, y, z;
    std::print("\n| bucket | original keyA | one-bit changed keyB |\n| ---: | ---: | ---: |\n");
    for (std::size_t i = 0; i < 16; ++i) {
        std::print("| {} | {} | {} |\n", i, first[i], second[i]);
        x.push_back(i);
        y.push_back(first[i]);
        z.push_back(second[i]);
    }
    auto plot = g::RPlot::create();
    plot.lines(x, y, "reference keyA", {37, 99, 235}).lines(
        x, z, "one-bit changed keyB", {220, 38, 38}).title(
        "Original32 words: actual keyed bucket counts").x_label("bucket").y_label("message count");
    plot.save_svg("build/siphash_original.svg");
}
```
