> Explicit controls

```{cpp, results="markdown", file="figures/siphash_controls.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    std::vector<double> x, y;
    auto key = a::siphash_example_key();
    std::print("| raw byte length | actual hash | blocks | rounds |\n| ---: | --- | ---: | ---: |\n");
    for (std::size_t n : {0, 1, 7, 8, 9, 15, 16, 255, 256}) {
        auto r = a::siphash24_run(key, a::siphash_example_message(n));
        std::print("| {} | {:016x} | {} | {} |\n", n, r.hash, r.blocks, r.rounds);
        x.push_back(n);
        y.push_back(r.rounds);
    }
    auto plot = g::RPlot::create();
    plot.lines(x, y, "actual values", {37, 99, 235}).points(x, y, {37, 99, 235},
                                                            4).title(
        "Binary lengths across full and tail blocks").x_label("raw bytes").y_label("actual SipRounds");
    plot.save_svg("build/siphash_controls.svg");
}
```
