> Actual selected work and sensitivity

```{cpp, results="markdown", file="figures/siphash_work.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    std::vector<double> x, y;
    auto key = a::siphash_example_key();
    std::print("| sequential binary bytes | actual blocks | actual rounds | 2*(floor(L/8)+1)+4 |\n| ---: | " "---: | ---: | ---: |\n");
    for (std::size_t n : {0, 8, 16, 32, 64, 128, 256, 512, 1024}) {
        auto r = a::siphash24_run(key, a::siphash_example_message(n));
        std::print("| {} | {} | {} | {} |\n", n, r.blocks, r.rounds,
                   2 * (n / 8 + 1) + 4);
        x.push_back(n);
        y.push_back(r.rounds);
    }
    auto plot = g::RPlot::create();
    plot.lines(x, y, "actual values", {37, 99, 235}).points(x, y, {37, 99, 235},
                                                            4).title(
        "Actual rounds match block geometry").x_label("raw message bytes").y_label("actual SipRounds");
    plot.save_svg("build/siphash_work.svg");
}
```
