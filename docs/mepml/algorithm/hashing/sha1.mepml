> The retained original experiment

```{cpp, results="markdown", file="figures/sha1_original.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    std::print("| original reference message | actual lowercase digest |\n| --- | --- |\n");
    for (const auto &m : std::vector<std::string>{"", "abc",
                                                  "abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq"})
        std::print("| {} | {} |\n", m.empty() ? "(empty)" : m, a::sha1_hex(m));
    auto r = a::sha1_avalanche("avalanche");
    std::vector<double> x, y;
    std::print("\nOriginal avalanche: actual mean {} changed bits out of 160, calls {}, compression blocks " "{}.\n\n| exact changed digest bits | actual input flips |\n| ---: | ---: |\n",
               r.mean, r.hash_calls, r.compression_blocks);
    for (std::size_t i = 0; i < r.histogram.size(); ++i) {
        std::print("| {} | {} |\n", i, r.histogram[i]);
        x.push_back(i);
        y.push_back(r.histogram[i]);
    }
    auto plot = g::RPlot::create();
    plot.lines(x, y, "actual values", {37, 99, 235}).points(x, y, {37, 99, 235},
                                                            5).title(
        "Original avalanche: full Hamming-distance support").x_label(
        "exact changed output bits").y_label("actual single-bit input flips");
    plot.save_svg("build/sha1_original.svg");
}
```
