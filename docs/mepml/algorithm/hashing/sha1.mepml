> Actual selected work and sensitivity

```{cpp, results="markdown", file="figures/sha1_work.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    std::vector<double> x, y;
    std::print("| message bytes | actual blocks | actual schedule expansions | actual rounds |\n| ---: | " "---: | ---: | ---: |\n");
    for (std::size_t n : {1, 16, 64, 256, 1024, 4096, 16384}) {
        auto r = a::sha1_run(std::string(n, 'a'));
        std::print("| {} | {} | {} | {} |\n", n, r.compression_blocks,
                   r.schedule_expansions, r.rounds);
        x.push_back(n);
        y.push_back(r.rounds);
    }
    auto plot = g::RPlot::create();
    plot.lines(x, y, "actual values", {37, 99, 235}).points(x, y, {37, 99, 235},
                                                            5).title(
        "Actual fixed-round native hash work").x_label("raw bytes").y_label(
        "actual compression rounds");
    plot.save_svg("build/sha1_work.svg");
}
```
// result_begin: markdown
