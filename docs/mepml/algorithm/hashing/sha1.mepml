> Explicit controls

```{cpp, results="markdown", file="figures/sha1_controls.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    std::vector<double> x, y;
    std::print("| original raw bytes | actual padded bytes | actual blocks | actual rounds |\n| ---: | ---: " "| ---: | ---: |\n");
    for (std::size_t n : {0, 1, 55, 56, 63, 64, 65, 119, 120}) {
        auto r = a::sha1_run(std::string(n, char{0}));
        std::print("| {} | {} | {} | {} |\n", n, r.padded_bytes,
                   r.compression_blocks, r.rounds);
        x.push_back(n);
        y.push_back(r.compression_blocks);
    }
    bool cap = false;
    try {
        a::SHAOptions o;
        o.max_trace_entries = 1;
        a::sha1_trace("abc", o);
    } catch (const std::length_error &) {
        cap = true;
    }
    std::print("Complete trace admission rejected {}.\n", cap);
    if (!cap)
        return 1;
    auto plot = g::RPlot::create();
    plot.lines(x, y, "actual values", {37, 99, 235}).points(x, y, {37, 99, 235},
                                                            5).title(
        "Padding boundaries in actual native compression work").x_label(
        "raw message bytes").y_label("actual compression blocks");
    plot.save_svg("build/sha1_controls.svg");
}
```
