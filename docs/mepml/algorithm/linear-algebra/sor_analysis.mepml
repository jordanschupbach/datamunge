> The retained original experiment

```{cpp, results="markdown", file="figures/sor_original.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    const auto A = a::laplacian_1d_matrix(30);
    const std::vector<double> b(30, 1);
    const double reference = 2 / (1 + std::sin(std::numbers::pi / 31));
    std::vector<double> x, y;
    std::print("| original omega | actual sweeps | converged | actual residual |\n| ---: | ---: | --- | " "---: |\n");
    for (double w = .1; w <= 1.951; w += .05) {
        a::SOROptions o;
        o.omega = w;
        o.max_iterations = 100000;
        o.tolerance = 1e-8;
        auto r = a::sor_run(A, b, o);
        std::print("| {} | {} | {} | {} |\n", w, r.solution.iterations,
                   r.solution.converged, r.solution.residual);
        x.push_back(w);
        y.push_back(r.solution.iterations);
    }
    std::print("\nAnalytic asymptotic spectral omega reference {}.\n", reference);
    auto plot = g::RPlot::create();
    plot.lines(x, y, "actual values", {37, 99, 235}).points(x, y, {37, 99, 235},
                                                            4).title(
        "Original thirty-point Laplacian: actual sweep counts").x_label("omega").y_label("complete sweeps to absolute tolerance");
    plot.save_svg("build/sor_original.svg");
}
```
