> Explicit controls

```{cpp, results="markdown", file="figures/sor_controls.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    std::vector<double> x, y;
    std::print("| requested sweep cap | actual sweeps | converged | actual residual |\n| ---: | ---: | --- " "| ---: |\n");
    for (int cap : {0, 1, 2, 5, 20, 100}) {
        a::SOROptions o;
        o.max_iterations = cap;
        o.tolerance = 1e-8;
        auto r = a::sor_run({{2, -1}, {-1, 2}}, {1, 1}, o);
        std::print("| {} | {} | {} | {} |\n", cap, r.solution.iterations,
                   r.solution.converged, r.solution.residual);
        x.push_back(cap);
        y.push_back(r.solution.residual);
    }
    auto plot = g::RPlot::create();
    plot.lines(x, y, "actual values", {37, 99, 235}).points(x, y, {37, 99, 235},
                                                            4).title(
        "A sweep cap is not convergence").x_label("requested maximum sweeps").y_label("actual final residual");
    plot.save_svg("build/sor_controls.svg");
}
```
