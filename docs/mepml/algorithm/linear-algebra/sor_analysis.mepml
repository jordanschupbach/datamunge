> Actual selected work and sensitivity

```{cpp, results="markdown", file="figures/sor_work.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    a::SOROptions o;
    o.omega = 1.5;
    o.max_iterations = 200;
    o.tolerance = 1e-8;
    auto r =
        a::sor_trace(a::laplacian_1d_matrix(10), std::vector<double>(10, 1), o);
    std::vector<double> x, y;
    std::print("| actual sweep | residual |\n| ---: | ---: |\n");
    for (const auto &s : r.sweeps) {
        std::print("| {} | {} |\n", s.iteration, s.residual);
        x.push_back(s.iteration);
        y.push_back(s.residual);
    }
    std::print("\nActual updates {}; off-diagonal visits {}; independently recomputed residual products " "{}.\n",
               r.coordinate_updates, r.off_diagonal_visits, r.residual_products);
    auto plot = g::RPlot::create();
    plot.lines(x, y, "actual values", {37, 99, 235}).points(x, y, {37, 99, 235},
                                                            4).title(
        "Actual residual history for a ten-point Laplacian").x_label(
        "complete sweeps").y_label("absolute Euclidean residual");
    plot.save_svg("build/sor_work.svg");
}
```
