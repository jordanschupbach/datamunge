> Explicit controls

```{cpp, results="markdown", file="figures/qr_algorithm_controls.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <datamunge/plot/plot.hpp>
#include <datamunge/plot/diagram.hpp>
#include <datamunge/algorithms/modular_exponentiation.hpp>
#include <datamunge/algorithms/integer_arithmetic.hpp>
#include <filesystem>
#include <print>
#include <algorithm>
#include <cmath>
#include <limits>
#include <climits>
#include <datamunge/algorithms/number_theory.hpp>
#include <numeric>
#include <numbers>
#include <random>
#include <string>
#include <vector>
#include <map>
#include <set>
#include <array>
#include <tuple>
#include <datamunge/algorithms/prufer.hpp>
#include <datamunge/algorithms/flow_diagram.hpp>
#include <datamunge/geometry/hull_algorithms.hpp>
#include <datamunge/random/sampling_analysis.hpp>
#include <iomanip>
#include <bit>
#include <datamunge/algorithms/qr_algorithm.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");

    std::vector<a::QrMatrix> cases{{{0, 0}, {0, 0}}, {{2, 0}, {0, 2}},
                                   {{2, 1, 1}, {1, 3, 0}, {1, 0, 4}}};
    std::vector<std::string> labels{"zero matrix", "repeated diagonal",
                                    "zero neighbor, coupled row"};
    std::vector<double> counts;
    std::print("\n| control | actual spectrum | actual QR steps |\n| --- | --- | ---: |\n");
    for (std::size_t i = 0; i < cases.size(); ++i) {
        auto r = a::qr_eigenvalues_run(cases[i]);
        counts.push_back(r.iterations);
        std::print("| {} | `{}` | {} |\n", labels[i], r.eigenvalues,
                   r.iterations);
    }
    bool budget = false, bad = false;
    try {
        a::qr_eigenvalues({{2, 1}, {1, 2}}, 0);
    } catch (const std::runtime_error &) {
        budget = true;
    }
    try {
        a::qr_eigenvalues({{1, 2}, {0, 1}});
    } catch (const std::invalid_argument &) {
        bad = true;
    }
    std::print("Zero budget on coupled block rejected: {}; nonsymmetry rejected: {}.\n",
               budget, bad);
    auto p = g::RPlot::barplot(counts, labels, "actual QR steps");
    p.title("Deflation checks the complete trailing row").y_label(
        "actual Householder QR steps");
    p.save_svg("build/qr_algorithm_controls.svg");
}
```
