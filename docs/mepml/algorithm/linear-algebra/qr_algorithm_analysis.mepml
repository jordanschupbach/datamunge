int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");

    std::vector<double> x, y;
    std::print("\n| Toeplitz order | actual QR steps | actual deflations | min eigenvalue | max eigenvalue " "|\n| ---: | ---: | ---: | ---: | ---: |\n");
    for (std::size_t n : {2, 4, 8, 16, 32}) {
        auto r = a::qr_eigenvalues_run(a::qr_tridiagonal(n));
        x.push_back(n);
        y.push_back(r.iterations);
        std::print("| {} | {} | {} | {} | {} |\n", n, r.iterations,
                   r.deflations, r.eigenvalues.front(), r.eigenvalues.back());
    }
    auto p = g::RPlot::create();
    p.lines(x, y, "actual dense QR steps", {16, 122, 87}).points(x, y,
                                                                 {16, 122, 87},
                                                                 5).title(
        "Structured symmetric inputs: actual QR step counts").x_label(
        "matrix order").y_label("actual dense QR steps");
    p.save_svg("build/qr_algorithm_work.svg");
}
