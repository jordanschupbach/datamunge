> The retained original experiment

```{cpp, results="markdown", file="figures/qr_algorithm_original.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <datamunge/plot/plot.hpp>
#include <datamunge/plot/diagram.hpp>
#include <datamunge/algorithms/modular_exponentiation.hpp>
#include <datamunge/algorithms/integer_arithmetic.hpp>
#include <filesystem>
#include <print>
#include <algorithm>
#include <cmath>
#include <limits>
#include <climits>
#include <datamunge/algorithms/number_theory.hpp>
#include <numeric>
#include <numbers>
#include <random>
#include <string>
#include <vector>
#include <map>
#include <set>
#include <array>
#include <tuple>
#include <datamunge/algorithms/prufer.hpp>
#include <datamunge/algorithms/flow_diagram.hpp>
#include <datamunge/geometry/hull_algorithms.hpp>
#include <datamunge/random/sampling_analysis.hpp>
#include <iomanip>
#include <bit>
#include <datamunge/algorithms/qr_algorithm.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");

    const a::QrMatrix A{{2, -2.5, -3.5, 0}, {-2.5, 2, 0, -3.5},
                        {-3.5, 0, 2, -2.5}, {0, -3.5, -2.5, 2}};
    auto spectrum = a::qr_eigenvalues(A);
    auto t = a::qr_eigenvalues_trace({{4, 1, .5}, {1, 3, .8}, {.5, .8, 2}});
    std::print("Retained four-by-four spectrum: {}. Target multiset: [-4,1,3,8].\n",
               spectrum);
    std::vector<double> x, y;
    std::print("\n| actual record | active order | block steps | complete trailing norm |\n| ---: | ---: | " "---: | ---: |\n");
    for (std::size_t i = 0; i < t.steps.size(); ++i) {
        x.push_back(i);
        y.push_back(std::log10(t.steps[i].trailing_norm + 1e-16));
        std::print("| {} | {} | {} | {} |\n", i, t.steps[i].active,
                   t.steps[i].iteration, t.steps[i].trailing_norm);
    }
    auto p = g::RPlot::create();
    p.lines(x, y, "log10(actual trailing norm + 1e-16)", {37, 99, 235}).points(
        x, y, {37, 99, 235}, 5).title("Dense QR: actual complete trailing-row history").x_label("actual retained record").y_label("log10(norm + 1e-16)");
    p.save_svg("build/qr_algorithm_original.svg");
}
```
