> Actual selected work and sensitivity

```{cpp, results="markdown", file="figures/power_iteration_work.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <datamunge/plot/plot.hpp>
#include <datamunge/plot/diagram.hpp>
#include <datamunge/algorithms/modular_exponentiation.hpp>
#include <datamunge/algorithms/integer_arithmetic.hpp>
#include <filesystem>
#include <print>
#include <algorithm>
#include <cmath>
#include <limits>
#include <climits>
#include <datamunge/algorithms/number_theory.hpp>
#include <numeric>
#include <numbers>
#include <random>
#include <string>
#include <vector>
#include <map>
#include <set>
#include <array>
#include <tuple>
#include <datamunge/algorithms/prufer.hpp>
#include <datamunge/algorithms/flow_diagram.hpp>
#include <datamunge/algorithms/power_iteration.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");

    std::vector<double> x, y;
    std::print("\n| secondary eigenvalue | attempted updates | actual dense products | actual scalar " "product terms | final residual |\n| ---: | ---: | ---: | ---: | ---: |\n");
    for (double ratio : {.1, .5, .9, .99}) {
        auto r = a::power_iteration_from({{1, 0}, {0, ratio}}, {1, 1}, 25);
        x.push_back(ratio);
        y.push_back(r.residual_norm);
        std::print("| {} | {} | {} | {} | {} |\n", ratio, r.attempts,
                   r.matvec_calls, r.scalar_products, r.residual_norm);
    }
    auto p = g::RPlot::create();
    p.lines(x, y, "actual final residual after 25 updates", {16, 122, 87}).points(x, y, {16, 122, 87}, 5).title("Explicit diagonal gap controls: equal native product counts, different residuals").x_label("second eigenvalue / dominant eigenvalue").y_label("actual final residual");
    p.save_svg("build/power_iteration_work.svg");
}
```
