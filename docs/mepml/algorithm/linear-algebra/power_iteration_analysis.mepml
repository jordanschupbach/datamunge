> Explicit controls

```{cpp, results="markdown", file="figures/power_iteration_controls.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <datamunge/plot/plot.hpp>
#include <datamunge/plot/diagram.hpp>
#include <datamunge/algorithms/modular_exponentiation.hpp>
#include <datamunge/algorithms/integer_arithmetic.hpp>
#include <filesystem>
#include <print>
#include <algorithm>
#include <cmath>
#include <limits>
#include <climits>
#include <datamunge/algorithms/number_theory.hpp>
#include <numeric>
#include <numbers>
#include <random>
#include <string>
#include <vector>
#include <map>
#include <set>
#include <array>
#include <tuple>
#include <datamunge/algorithms/prufer.hpp>
#include <datamunge/algorithms/flow_diagram.hpp>
#include <datamunge/algorithms/power_iteration.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");

    std::vector<std::vector<std::vector<double>> > matrices{{{-3, 0}, {0, 1}},
                                                            {{1, 0}, {0, -1}},
                                                            {{0, 0}, {0, 0}}};
    std::vector<std::string> labels{"negative dominant", "equal magnitudes",
                                    "zero matrix"};
    std::vector<double> v;
    std::print("\n| fixture | actual final Rayleigh value | final residual norm | accepted updates | " "tiny-product stop |\n| --- | ---: | ---: | ---: | --- |\n");
    for (std::size_t i = 0; i < matrices.size(); ++i) {
        auto r = a::power_iteration_from(matrices[i], {1, 1}, 25);
        v.push_back(r.residual_norm);
        std::print("| {} | {} | {} | {} | {} |\n", labels[i], r.pair.value,
                   r.residual_norm, r.accepted, r.tiny_product);
    }
    bool ragged = false;
    try {
        a::power_iteration({{1, 2}, {3}}, 1);
    } catch (const std::invalid_argument &) {
        ragged = true;
    }
    std::print("Complete ragged-matrix guard: {}.\n", ragged);
    auto p = g::RPlot::barplot(v, labels, "actual final residual norm");
    p.title("Power controls: a fixed iteration count does not certify an eigenpair").y_label("actual norm of A v - rho v");
    p.save_svg("build/power_iteration_controls.svg");
}
```
