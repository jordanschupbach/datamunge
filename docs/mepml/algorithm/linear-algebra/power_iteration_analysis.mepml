> The retained original experiment

```{cpp, results="markdown", file="figures/power_iteration_original.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <datamunge/plot/plot.hpp>
#include <datamunge/plot/diagram.hpp>
#include <datamunge/algorithms/modular_exponentiation.hpp>
#include <datamunge/algorithms/integer_arithmetic.hpp>
#include <filesystem>
#include <print>
#include <algorithm>
#include <cmath>
#include <limits>
#include <climits>
#include <datamunge/algorithms/number_theory.hpp>
#include <numeric>
#include <numbers>
#include <random>
#include <string>
#include <vector>
#include <map>
#include <set>
#include <array>
#include <tuple>
#include <datamunge/algorithms/prufer.hpp>
#include <datamunge/algorithms/flow_diagram.hpp>
#include <datamunge/algorithms/power_iteration.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");

    const std::vector<std::vector<double>> matrix{{2, 1}, {1, 2}};
    auto seeded = a::power_iteration(matrix);
    auto t = a::power_iteration_trace(matrix, {1, 0}, 15);
    std::print("Original seeded result: value {}, vector {}. Teaching explicit-start result: value {}, " "residual {}.\n",
               seeded.value, seeded.vector, t.run.pair.value,
               t.run.residual_norm);
    std::vector<double> x, y;
    std::print("\n| actual attempt | actual before-iterate quotient | actual before residual |\n| ---: | " "---: | ---: |\n");
    for (auto &s : t.steps) {
        x.push_back(s.iteration);
        y.push_back(s.rayleigh_before);
        std::print("| {} | {} | {} |\n", s.iteration, s.rayleigh_before,
                   s.residual_before);
    }
    auto p = g::RPlot::create();
    p.lines(x, y, "actual Rayleigh quotient before update", {37, 99, 235}).points(x, y, {37, 99, 235}, 5).abline_h(3, {22, 163, 74}).title("Original matrix and teaching start(1,0): actual native quotient trajectory").x_label("actual update attempt").y_label("Rayleigh quotient").y_limits(1.8, 3.2);
    p.save_svg("build/power_iteration_original.svg");
}
```
