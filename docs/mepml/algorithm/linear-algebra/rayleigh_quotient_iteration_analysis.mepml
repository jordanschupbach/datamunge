> Explicit controls

```{cpp, results="markdown", file="figures/rayleigh_quotient_iteration_controls.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <datamunge/plot/plot.hpp>
#include <datamunge/plot/diagram.hpp>
#include <datamunge/algorithms/modular_exponentiation.hpp>
#include <datamunge/algorithms/integer_arithmetic.hpp>
#include <filesystem>
#include <print>
#include <algorithm>
#include <cmath>
#include <limits>
#include <climits>
#include <datamunge/algorithms/number_theory.hpp>
#include <numeric>
#include <numbers>
#include <random>
#include <string>
#include <vector>
#include <map>
#include <set>
#include <array>
#include <tuple>
#include <datamunge/algorithms/prufer.hpp>
#include <datamunge/algorithms/flow_diagram.hpp>
#include <datamunge/geometry/hull_algorithms.hpp>
#include <datamunge/random/sampling_analysis.hpp>
#include <iomanip>
#include <datamunge/algorithms/qr_algorithm.hpp>
#include <datamunge/stats/lm.hpp>
#include <datamunge/algorithms/arithmetic_coding.hpp>
#include <datamunge/nn/rbf.hpp>
#include <datamunge/nn/model_plot.hpp>
#include <bit>
#include <datamunge/algorithms/rayleigh_quotient_iteration.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");

    const std::vector<std::vector<double>> A{{1, 0}, {0, 3}};
    a::RayleighOptions zero;
    zero.max_iterations = 0;
    const std::vector<a::RayleighRun> cases{a::rayleigh_iteration_run(A, {1, 0}),
                                            a::rayleigh_iteration_run(A, {0, 2},
                                                                      zero),
                                            a::rayleigh_iteration_run(A,
                                                                      {1, .5},
                                                                      zero)};
    std::vector<std::string> labels{"exact eigenvector",
                                    "zero solves, exact start",
                                    "zero solves, mixed start"};
    std::vector<double> residuals;
    std::print("\n| actual control | actual quotient | actual residual | actual solves | converged |\n| --- " "| ---: | ---: | ---: | --- |\n");
    for (std::size_t i = 0; i < cases.size(); ++i) {
        residuals.push_back(cases[i].relative_residual);
        std::print("| {} | {} | {} | {} | {} |\n", labels[i],
                   cases[i].pair.value, cases[i].residual, cases[i].solves,
                   cases[i].converged);
    }
    bool singular = false;
    try {
        a::rayleigh_iteration_run({{1, 0, 0}, {0, 2, 0}, {0, 0, 3}}, {1, 0, 1});
    } catch (const std::domain_error &) {
        singular = true;
    }
    std::print("Exact singular shift before convergence is explicitly rejected: {}.\n",
               singular);
    auto p = g::RPlot::barplot(residuals, labels, "actual relative residual");
    p.title("Actual initial quotients and honest zero-step diagnostics").y_label("actual relative backward-error diagnostic");
    p.save_svg("build/rayleigh_quotient_iteration_controls.svg");
}
