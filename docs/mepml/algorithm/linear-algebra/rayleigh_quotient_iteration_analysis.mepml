#include <datamunge/algorithms/prufer.hpp>
#include <datamunge/algorithms/flow_diagram.hpp>
#include <datamunge/geometry/hull_algorithms.hpp>
#include <datamunge/random/sampling_analysis.hpp>
#include <iomanip>
#include <datamunge/algorithms/qr_algorithm.hpp>
#include <datamunge/stats/lm.hpp>
#include <datamunge/algorithms/arithmetic_coding.hpp>
#include <datamunge/nn/rbf.hpp>
#include <datamunge/nn/model_plot.hpp>
#include <bit>
#include <datamunge/algorithms/rayleigh_quotient_iteration.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");

    const auto input = a::rayleigh_example_matrix();
    a::RayleighOptions o;
    o.max_iterations = 7;
    auto t = a::rayleigh_iteration_trace(input, {.5, .4, .9}, o);
    std::print("Actual spectrum of original rounded-basis input: {}. Nominal construction values1,3,7 are " "not exact eigenvalues of rounded Q.\n",
               a::qr_eigenvalues(input));
    std::print("Actual final pair: value {}, direction {}, converged {}.\n",
               t.pair.value, t.pair.vector, t.converged);
    std::vector<double> x, y;
    std::print("\n| actual solve boundary | actual absolute residual | actual matching quotient |\n| ---: | " "---: | ---: |\n");
    for (const auto &s : t.steps) {
        x.push_back(s.iteration);
        y.push_back(std::log10(s.residual + 1e-17));
        std::print("| {} | {} | {} |\n", s.iteration, s.residual, s.pair.value);
    }
    auto p = g::RPlot::create();
    p.lines(x, y, "log10(actual residual + 1e-17)", {190, 24, 93}).points(
        x, y, {190, 24, 93}, 5).title("Original Rayleigh input: actual residual-stopped iterates").x_label("actual completed changing-shift solves").y_label("log10(actual absolute residual + 1e-17)");
    p.save_svg("build/rayleigh_quotient_iteration_original.svg");
}
