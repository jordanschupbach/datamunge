#include <datamunge/stats/lm.hpp>
#include <datamunge/algorithms/arithmetic_coding.hpp>
#include <datamunge/nn/rbf.hpp>
#include <datamunge/nn/model_plot.hpp>
#include <bit>
#include <datamunge/algorithms/rayleigh_quotient_iteration.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");

    auto t = a::rayleigh_iteration_trace({{1, 0}, {0, 3}}, {1, .25});
    std::print("\n| actual solve boundary | actual used shift | actual current quotient | actual absolute " "residual | actual relative residual | converged |\n| ---: | ---: | ---: | ---: | ---: | --- " "|\n");
    for (const auto &s : t.steps)
        std::print("| {} | {} | {} | {} | {} | {} |\n", s.iteration, s.shift,
                   s.pair.value, s.residual, s.relative_residual, s.converged);

    g::Diagram d;
    d.node("n0", {0, 0},
           std::format("Actual initial Rayleigh value\n{}",
                       t.steps[0].pair.value));
    d.node("n1", {10, 0},
           std::format("Actual first solved direction\n{}",
                       t.steps[1].pair.vector));
    d.node("n2", {20, 0},
           std::format("Actual final converged / solves\n{} / {}", t.converged,
                       t.solves));
    d.edge("n0", "n1").edge("n1", "n2");
    d.save_svg("build/rayleigh_quotient_iteration_tiny.svg");
}
