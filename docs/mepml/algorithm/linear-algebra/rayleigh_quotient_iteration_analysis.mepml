#include <datamunge/algorithms/flow_diagram.hpp>
#include <datamunge/geometry/hull_algorithms.hpp>
#include <datamunge/random/sampling_analysis.hpp>
#include <iomanip>
#include <datamunge/algorithms/qr_algorithm.hpp>
#include <datamunge/stats/lm.hpp>
#include <datamunge/algorithms/arithmetic_coding.hpp>
#include <datamunge/nn/rbf.hpp>
#include <datamunge/nn/model_plot.hpp>
#include <bit>
#include <datamunge/algorithms/rayleigh_quotient_iteration.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");

    std::vector<double> x, y;
    std::print("\n| relative stopping tolerance | actual solves | actual factorizations | actual final " "relative residual | converged |\n| ---: | ---: | ---: | ---: | --- |\n");
    for (double tolerance : {1e-4, 1e-8, 1e-12, 1e-14}) {
        a::RayleighOptions o;
        o.tolerance = tolerance;
        auto r =
            a::rayleigh_iteration_run(a::rayleigh_example_matrix(),
                                      {.5, .4, .9}, o);
        x.push_back(-std::log10(tolerance));
        y.push_back(r.solves);
        std::print("| {} | {} | {} | {} | {} |\n", tolerance, r.solves,
                   r.factorizations, r.relative_residual, r.converged);
    }
    auto p = g::RPlot::create();
    p.lines(x, y, "actual changing-shift solves", {16, 122, 87}).points(
        x, y, {16, 122, 87}, 5).title("Stopping tolerance controls actual native factorization work").x_label("minus log10(relative tolerance)").y_label("actual solves / factorizations");
    p.save_svg("build/rayleigh_quotient_iteration_work.svg");
}
