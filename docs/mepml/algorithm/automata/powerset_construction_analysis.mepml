> The retained original experiment

```{cpp, results="markdown", file="figures/powerset_construction_original.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <datamunge/plot/plot.hpp>
#include <datamunge/plot/diagram.hpp>
#include <datamunge/algorithms/modular_exponentiation.hpp>
#include <datamunge/algorithms/integer_arithmetic.hpp>
#include <filesystem>
#include <print>
#include <algorithm>
#include <cmath>
#include <limits>
#include <climits>
#include <datamunge/algorithms/number_theory.hpp>
#include <numeric>
#include <numbers>
#include <random>
#include <string>
#include <vector>
#include <map>
#include <set>
#include <array>
#include <tuple>
#include <datamunge/algorithms/prufer.hpp>
#include <datamunge/algorithms/flow_diagram.hpp>
#include <datamunge/algorithms/powerset_examples.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");

    auto d = a::powerset_construction_trace(a::nth_from_end_nfa(2), false, 16);
    std::print("Original n2 words:01={},10={},110={}.\n",
               a::dfa_accepts(d.dfa, {0, 1}), a::dfa_accepts(d.dfa, {1, 0}),
               a::dfa_accepts(d.dfa, {1, 1, 0}));
    std::vector<double> x, y, reference;
    std::print("\n| suffix position n | native NFA states | actual DFA states | mathematical2^n reference " "|\n| ---: | ---: | ---: | ---: |\n");
    for (int n = 1; n <= 6; ++n) {
        auto source = a::nth_from_end_nfa(n);
        auto t = a::powerset_construction_trace(source, false, 128);
        x.push_back(n);
        y.push_back(t.dfa.num_states);
        reference.push_back(std::ldexp(1., n));
        std::print("| {} | {} | {} | {} |\n", n, source.num_states,
                   t.dfa.num_states, std::ldexp(1., n));
    }
    auto p = g::RPlot::create();
    p.lines(x, reference, "2^n reference", {220, 38, 38}).points(
        x, y, "actual native reachable subsets", {37, 99, 235}, 6).title(
        "Original suffix-language family: actual reachable subset blow-up").x_label("suffix position n").y_label("actual deterministic states");
    p.save_svg("build/powerset_construction_original.svg");
}
```
