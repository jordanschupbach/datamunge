> Explicit controls

```{cpp, results="markdown", file="figures/powerset_construction_controls.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <datamunge/plot/plot.hpp>
#include <datamunge/plot/diagram.hpp>
#include <datamunge/algorithms/modular_exponentiation.hpp>
#include <datamunge/algorithms/integer_arithmetic.hpp>
#include <filesystem>
#include <print>
#include <algorithm>
#include <cmath>
#include <limits>
#include <climits>
#include <datamunge/algorithms/number_theory.hpp>
#include <numeric>
#include <numbers>
#include <random>
#include <string>
#include <vector>
#include <map>
#include <set>
#include <array>
#include <tuple>
#include <datamunge/algorithms/prufer.hpp>
#include <datamunge/algorithms/flow_diagram.hpp>
#include <datamunge/algorithms/powerset_examples.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");

    a::NFA empty{0, 1, {}, {}, {}};
    a::NFA missing{1, 1, {{{}}}, {0}, {1}};
    std::vector<std::string> labels{"empty partial", "empty complete",
                                    "missing partial", "missing complete"};
    std::vector<double> counts;
    std::print("\n| policy fixture | actual states | actual start id | actual unions |\n| --- | ---: | ---: " "| ---: |\n");
    for (int i = 0; i < 4; ++i) {
        auto t =
            a::powerset_construction_trace(i < 2 ? empty : missing, i % 2, 8);
        counts.push_back(t.dfa.num_states);
        std::print("| {} | {} | {} | {} |\n", labels[i], t.dfa.num_states,
                   t.dfa.start, t.transition_unions);
    }
    bool capped = false, bad = false;
    try {
        a::powerset_construction_trace(a::nth_from_end_nfa(8), false, 32);
    } catch (const std::runtime_error &) {
        capped = true;
    }
    try {
        auto n = missing;
        n.delta[0][0] = {2};
        a::powerset_construction_trace(n);
    } catch (const std::invalid_argument &) {
        bad = true;
    }
    std::print("Output-state cap checked: {}; complete invalid-target guard: {}.\n",
               capped, bad);
    auto p = g::RPlot::barplot(counts, labels, "actual retained DFA states");
    p.title("Empty source subsets: partial missing moves and explicit complete traps").y_label("actual states");
    p.save_svg("build/powerset_construction_controls.svg");
}
```
