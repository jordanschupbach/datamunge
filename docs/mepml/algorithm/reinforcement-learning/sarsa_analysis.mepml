> The retained original experiment

```{cpp, results="markdown", file="figures/sarsa_original.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <filesystem>
#include <print>
#include <algorithm>
#include <cmath>
#include <limits>
#include <numeric>
#include <numbers>
#include <random>
#include <string>
#include <vector>
#include <map>
#include <set>
#include <array>
#include <tuple>
#include <bit>
#include <datamunge/algorithms/sarsa.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    auto env = a::tabular_cliff();
    a::RLParameters p;
    p.learning_rate = .5;
    p.discount = 1;
    p.epsilon = .1;
    p.episodes = 500;
    p.max_steps = 2000;
    p.seed = 7;
    auto r = a::sarsa_run(env, p);
    auto q = a::q_learning_run(env, p);
    auto sar = a::trailing_return_mean(r.result.episode_returns, 10);
    auto ql = a::trailing_return_mean(q.result.episode_returns, 10);
    auto sroll = a::tabular_policy_rollout(env, r.result.greedy_policy);
    auto qroll = a::tabular_policy_rollout(env, q.result.greedy_policy);
    std::print("Actual last-50 means: SARSA {}, Q-learning {}.\nActual greedy rollout rewards: SARSA {}, " "Q-learning {}.\n\n| episode | actual SARSA return | actual Q-learning return | SARSA " "trailing-10 | Q-learning trailing-10 |\n| ---: | ---: | ---: | ---: | ---: |\n",
               a::trailing_return_mean(r.result.episode_returns, 50).back(),
               a::trailing_return_mean(q.result.episode_returns, 50).back(),
               sroll.total_reward, qroll.total_reward);
    std::vector<double> x;
    for (std::size_t i = 0; i < sar.size(); ++i) {
        x.push_back(i);
        std::print("| {} | {} | {} | {} | {} |\n", i,
                   r.result.episode_returns[i], q.result.episode_returns[i],
                   sar[i], ql[i]);
    }
    auto plot = g::RPlot::create();
    plot.lines(x, sar, "actual SARSA trailing-10", {37, 99, 235}).lines(
        x, ql, "actual Q-learning trailing-10", {220, 38, 38}).title(
        "Original cliff: actual behavior training returns").x_label("episode").y_label("undiscounted reward, trailing mean");
    plot.save_svg("build/sarsa_original.svg");
}
```
