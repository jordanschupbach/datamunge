> Explicit controls

```{cpp, results="markdown", file="figures/sarsa_controls.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <filesystem>
#include <print>
#include <algorithm>
#include <cmath>
#include <limits>
#include <numeric>
#include <numbers>
#include <random>
#include <string>
#include <vector>
#include <map>
#include <set>
#include <array>
#include <tuple>
#include <bit>
#include <datamunge/algorithms/sarsa.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    std::vector<double> x, y;
    std::print("| step cap | actual resets | actual transitions | actual behavior selections |\n| ---: | " "---: | ---: | ---: |\n");
    for (std::size_t cap : {0, 1, 2, 4}) {
        a::RLParameters p;
        p.episodes = 2;
        p.max_steps = cap;
        p.seed = 7;
        auto r = a::sarsa_trace(a::tabular_corridor(3), p);
        std::print("| {} | {} | {} | {} |\n", cap, r.reset_calls, r.transitions,
                   r.action_selections);
        x.push_back(cap);
        y.push_back(r.action_selections);
    }
    auto cliff = a::tabular_cliff().step(36, 1);
    std::print("\nActual entering cliff returns state {}, reward {}, terminal {}.\n",
               cliff.next_state, cliff.reward, cliff.terminal);
    auto plot = g::RPlot::create();
    plot.lines(x, y, "actual values", {37, 99, 235}).points(x, y, {37, 99, 235},
                                                            5).title(
        "Selections can include unused next actions").x_label("step cap").y_label("actual selections");
    plot.save_svg("build/sarsa_controls.svg");
}
```
// result_begin: markdown
| step cap | actual resets | actual transitions | actual behavior selections |
| ---: | ---: | ---: | ---: |
| 0 | 2 | 0 | 2 |
| 1 | 2 | 2 | 4 |
| 2 | 2 | 4 | 6 |
| 4 | 2 | 6 | 7 |

Actual entering cliff returns state 36, reward -100, terminal false.
\image(figures/sarsa_controls.svg)
// result_end
\caption(Actual outcomes on controlled native inputs; errors, truncation and unresolved outcomes retain their stated meanings.)
