> Actual selected work and sensitivity

```{cpp, results="markdown", file="figures/runge_kutta4_work.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    auto f = [](double, const auto &y) { return y; };
    std::vector<double> x, y;
    std::print("| actual steps | actual RHS calls | actual committed scalar updates | intrinsic samples " "|\n| ---: | ---: | ---: | ---: |\n");
    for (int steps : {1, 4, 16, 64, 256}) {
        auto t = a::runge_kutta4_run(f, {1, 2}, 0, 1, steps);
        std::print("| {} | {} | {} | {} |\n", steps, t.rhs_calls,
                   t.scalar_updates, t.solution.t.size());
        x.push_back(steps);
        y.push_back(t.rhs_calls);
    }
    auto p = g::RPlot::create();
    p.lines(x, y, "actual callback calls for two-state system", {37, 99, 235}).points(x, y, {37, 99, 235}, 5).title("Classical RK4: four actual callbacks per step").x_label("actual committed uniform steps").y_label("actual derivative callback invocations");
    p.save_svg("build/runge_kutta4_work.svg");
}
