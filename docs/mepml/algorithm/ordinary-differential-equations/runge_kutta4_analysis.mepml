> The retained original experiment

```{cpp, results="markdown", file="figures/runge_kutta4_original.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    auto decay = [](double, const auto &y) {
        return std::vector<double>{-y[0]};
    };
    auto growth = [](double, const auto &y) { return y; };
    std::print("| actual uniform steps | native Euler endpoint error | native RK4 endpoint error | actual " "RK4 calls |\n| ---: | ---: | ---: | ---: |\n");
    std::vector<double> x, e, r;
    for (int steps : {4, 8, 16, 32, 64, 128, 256}) {
        auto et = a::euler_method(decay, {1}, 0, 1, steps);
        auto rt = a::runge_kutta4_run(decay, {1}, 0, 1, steps);
        const auto ee =
            std::abs(et.y.back()[0] - std::exp(-1.)), re =
            std::abs(rt.solution.y.back()[0] - std::exp(-1.));
        std::print("| {} | {} | {} | {} |\n", steps, ee, re, rt.rhs_calls);
        x.push_back(std::log10(1. / steps));
        e.push_back(std::log10(ee));
        r.push_back(std::log10(re));
    }
    auto grow = a::runge_kutta4_run(growth, {1}, 0, 1, 10);
    std::print("Original growth example, actual RK4 endpoint {}, analytic e {}, absolute error {}.\n",
               grow.solution.y.back()[0], std::exp(1.),
               std::abs(grow.solution.y.back()[0] - std::exp(1.)));
    auto p = g::RPlot::create();
    p.lines(x, e, "actual canonical Euler endpoint error", {234, 88, 12}).points(x, e, {234, 88, 12}, 4).lines(x, r, "actual canonical RK4 endpoint error", {37, 99, 235}).points(x, r, {37, 99, 235}, 4).title("Original exponential decay: measured Euler and RK4 convergence").x_label("log10 nominal step size").y_label("log10 actual endpoint absolute error");
    p.save_svg("build/runge_kutta4_original.svg");
}
```
