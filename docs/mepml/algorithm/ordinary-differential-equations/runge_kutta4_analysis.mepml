> Explicit controls

```{cpp, results="markdown", file="figures/runge_kutta4_controls.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    auto f = [](double, const auto &y) {
        return std::vector<double>{-10 * y[0]};
    };
    std::vector<double> x, y;
    std::print("| actual steps on [0,1] | actual endpoint | analytic endpoint | actual calls |\n| ---: | " "---: | ---: | ---: |\n");
    for (int steps : {1, 2, 4, 8, 16, 32}) {
        auto t = a::runge_kutta4_run(f, {1}, 0, 1, steps);
        std::print("| {} | {} | {} | {} |\n", steps, t.solution.y.back()[0],
                   std::exp(-10.), t.rhs_calls);
        x.push_back(steps);
        y.push_back(std::log10(std::abs(t.solution.y.back()[0]) + 1e-17));
    }
    bool shape = false, steps_bad = false;
    try {
        a::runge_kutta4([](double, const auto &) {
            return std::vector<double>{};
        }, {1}, 0, 1, 2);
    } catch (const std::invalid_argument &) {
        shape = true;
    }
    try {
        a::runge_kutta4(f, {1}, 0, 1, 0);
    } catch (const std::invalid_argument &) {
        steps_bad = true;
    }
    std::print("Malformed derivative shape rejected: {}; zero steps rejected: {}.\n",
               shape, steps_bad);
    if (!shape || !steps_bad)
        return 1;
    auto p = g::RPlot::create();
    p.lines(x, y, "actual log10 absolute RK4 endpoint", {220, 38, 38}).points(
        x, y, {220, 38, 38}, 5).title("A completed finite RK4 run can still be unstable").x_label("actual uniform steps for lambda=-10").y_label("log10(abs(actual endpoint) + 1e-17)");
    p.save_svg("build/runge_kutta4_controls.svg");
}
```
