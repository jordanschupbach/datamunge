> Actual selected work and sensitivity

```{cpp, results="markdown", file="figures/roulette_wheel_work.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <filesystem>
#include <print>
#include <algorithm>
#include <cmath>
#include <limits>
#include <numeric>
#include <numbers>
#include <random>
#include <string>
#include <vector>
#include <map>
#include <set>
#include <array>
#include <tuple>
#include <bit>
#include <datamunge/algorithms/roulette_wheel.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    std::vector<double> x, y;
    std::print("| actual draws | actual binary comparisons | population |\n| ---: | ---: | ---: |\n");
    for (std::size_t n : {1, 10, 100, 1000, 10000, 100000}) {
        auto t = a::roulette_wheel_run({1, 2, 3, 4, 5}, n, 1);
        std::print("| {} | {} | {} |\n", n, t.comparisons, t.counts.size());
        x.push_back(n);
        y.push_back(t.comparisons);
    }
    auto p = g::RPlot::create();
    p.lines(x, y, "actual binary-search comparisons", {37, 99, 235}).points(
        x, y, {37, 99, 235}, 5).title("Actual fixed-population roulette search work").x_label("actual requested draws").y_label("actual binary midpoint comparisons");
    p.save_svg("build/roulette_wheel_work.svg");
}
```
