> The retained original experiment

```{cpp, results="markdown", file="figures/roulette_wheel_original.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <filesystem>
#include <print>
#include <algorithm>
#include <cmath>
#include <limits>
#include <numeric>
#include <numbers>
#include <random>
#include <string>
#include <vector>
#include <map>
#include <set>
#include <array>
#include <tuple>
#include <bit>
#include <datamunge/algorithms/roulette_wheel.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    const std::vector<double> fitness{1, 2, 3, 4, 5};
    auto t = a::roulette_wheel_run(fitness, 300000, 1);
    std::vector<double> x, expected, observed;
    std::print("| input id | fitness | represented ideal share | actual picks | observed share |\n| ---: | " "---: | ---: | ---: | ---: |\n");
    for (std::size_t i = 0; i < fitness.size(); ++i) {
        const double share =
            fitness[i] / t.total, frequency =
            double(t.counts[i]) / t.picks.size();
        std::print("| {} | {} | {} | {} | {} |\n", i, fitness[i], share,
                   t.counts[i], frequency);
        x.push_back(i);
        expected.push_back(share);
        observed.push_back(frequency);
    }
    std::print("Actual draws {}, actual binary midpoint comparisons {}, scaled overflow model {}.\n",
               t.picks.size(), t.comparisons, t.scaled);
    auto p = g::RPlot::create();
    p.lines(x, expected, "explicit model share", {22, 163, 74}).points(
        x, observed, "actual observed share", {37, 99, 235}, 6).title(
        "Original five fitnesses: actual 300,000-draw shares").x_label(
        "original population id").y_label("ideal / observed selection fraction");
    p.save_svg("build/roulette_wheel_original.svg");
}
```
