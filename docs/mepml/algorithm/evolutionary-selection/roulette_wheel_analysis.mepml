> Explicit controls

```{cpp, results="markdown", file="figures/roulette_wheel_controls.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <filesystem>
#include <print>
#include <algorithm>
#include <cmath>
#include <limits>
#include <numeric>
#include <numbers>
#include <random>
#include <string>
#include <vector>
#include <map>
#include <set>
#include <array>
#include <tuple>
#include <bit>
#include <datamunge/algorithms/roulette_wheel.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    auto zero = a::roulette_wheel_run({0, 2, 0}, 100, 1);
    auto large = a::roulette_wheel_run({1e308, 1e308}, 100, 1);
    std::print("Actual zero-weight control counts: {}. Overflow model scaled: {}; counts {}.\n",
               zero.counts, large.scaled, large.counts);
    std::size_t rejected = 0;
    for (const auto &f : std::vector<std::vector<double>>{
         {}, {0, 0}, {1, -1}, {1, std::numeric_limits<double>::infinity()}
     })
        try {
            a::roulette_wheel_run(f, 0);
        } catch (const std::invalid_argument &) {
            ++rejected;
        }
        std::print("Actual invalid complete models rejected even for zero draws: {}.\n",
                   rejected);
        if (rejected != 4 || zero.counts[1] != 100 || !large.scaled)
            return 1;
        auto p = g::RPlot::create();
        p.bars({0, 1, 2},
               {double(zero.counts[0]), double(zero.counts[1]),
                double(zero.counts[2])}, "actual counts", {22, 163, 74}, .8).title("Zero fitness has no represented selectable interval").x_label("original input id").y_label("actual native picks");
        p.save_svg("build/roulette_wheel_controls.svg");
}
```
