> Actual selected work and sensitivity

```{cpp, results="markdown", file="figures/sobel_work.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    auto r = a::sobel_run(a::sobel_square_example());
    std::vector<double> x, y;
    std::print("| relative fraction | actual threshold | selected pixels |\n| ---: | ---: | ---: |\n");
    for (double f : {0., .25, .5, .75, .9, 1.}) {
        auto e = a::sobel_edges(r.result, f);
        std::print("| {} | {} | {} |\n", f, e.threshold, e.pixels.size());
        x.push_back(f);
        y.push_back(e.pixels.size());
    }
    auto plot = g::RPlot::create();
    plot.lines(x, y, "actual values", {37, 99, 235}).points(x, y, {37, 99, 235},
                                                            4).title(
        "Actual strict-threshold sensitivity").x_label("fraction of actual maximum").y_label("selected interior response pixels");
    plot.save_svg("build/sobel_work.svg");
}
```
