> The retained original experiment

```{cpp, results="markdown", file="figures/sobel_original.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    auto r = a::sobel_run(a::sobel_square_example());
    auto edges = a::sobel_edges(r.result, .5);
    std::print("| original rows | interior pixels | sample visits | actual maximum | threshold | selected " "pixels |\n| ---: | ---: | ---: | ---: | ---: | ---: |\n| 32 | {} | {} | {} | {} | {} |\n",
               r.interior_pixels, r.sample_visits, edges.maximum,
               edges.threshold, edges.pixels.size());
    std::vector<double> x, y;
    for (const auto &p : edges.pixels) {
        x.push_back(p[1]);
        y.push_back(-double(p[0]));
    }
    auto plot = g::RPlot::create();
    plot.points(x, y, {37, 99, 235}, 4).lines({7.5, 23.5, 23.5, 7.5, 7.5},
                                              {-7.5, -7.5, -23.5, -23.5, -7.5},
                                              "analytic bright-square boundary",
                                              {220, 38, 38}).title(
        "Original32x32 square: actual thresholded responses").x_label(
        "image column").y_label("negative image row").size(760, 800).margins(
        80, 40, 72, 88).x_limits(-1, 32).y_limits(-32, 1);
    plot.save_svg("build/sobel_original.svg");
}
```
