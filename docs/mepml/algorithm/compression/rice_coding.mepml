> Actual selected work and sensitivity

```{cpp, results="markdown", file="figures/rice_coding_work.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    auto rows = a::rice_length_study();
    std::vector<double> x, y;
    std::print("| k | M | conditional actual-span mean | actual full-support bits | finite normalization " "|\n| ---: | ---: | ---: | ---: | ---: |\n");
    for (const auto &r : rows) {
        std::print("| {} | {} | {} | {} | {} |\n", r.k, r.parameter,
                   r.mean_bits, r.emitted_bits, r.normalization);
        x.push_back(r.k);
        y.push_back(r.mean_bits);
    }
    auto p = g::RPlot::create();
    p.lines(x, y, "native actual-span weighted mean", {37, 99, 235}).points(
        x, y, {37, 99, 235}, 6).title("Original finite support 0..299: conditional Rice lengths").x_label("explicit remainder width k").y_label("conditional expected emitted bits");
    p.save_svg("build/rice_coding_work.svg");
}
```
