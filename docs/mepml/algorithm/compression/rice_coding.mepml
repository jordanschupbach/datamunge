> The retained original experiment

```{cpp, results="markdown", file="figures/rice_coding_original.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    const std::vector<std::uint64_t> values{0, 1, 2, 5, 9, 17, 3, 42};
    auto t = a::rice_encode_trace(values, 3);
    auto d = a::rice_decode_trace(t.bits, 3, values.size());
    std::print("Original input: {}. Actual parsed values: ", values);
    for (const auto &w : d.words)
        std::print("{} ", w.value);
    std::print("\n\n| value | actual q | actual r | begin | end | actual bits |\n| ---: | ---: | ---: | " "---: | ---: | ---: |\n");
    std::vector<double> x, y;
    for (const auto &w : t.words) {
        std::print("| {} | {} | {} | {} | {} | {} |\n", w.value, w.quotient,
                   w.remainder, w.begin, w.end, w.end - w.begin);
        x.push_back(w.value);
        y.push_back(w.end - w.begin);
    }
    auto p = g::RPlot::create();
    p.points(x, y, {37, 99, 235}, 6).title("Original eight integers: actual Rice k=3 lengths").x_label("original unsigned value").y_label("actual emitted bits per word");
    p.save_svg("build/rice_coding_original.svg");
}
```
