> Explicit controls

```{cpp, results="markdown", file="figures/rice_coding_controls.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    std::vector<double> x, y;
    std::print("| k | actual stream bits | parsed values |\n| ---: | ---: | --- |\n");
    for (int k : {0, 2, 6}) {
        auto t = a::rice_encode_trace({0, 1, 8, 32}, k);
        auto d = a::rice_decode_trace(t.bits, k, 4);
        std::vector<std::uint64_t> v;
        for (const auto &w : d.words)
            v.push_back(w.value);
        std::print("| {} | {} | `{}` |\n", k, t.bits.size(), v);
        x.push_back(k);
        y.push_back(t.bits.size());
    }
    bool invalid = false, truncated = false;
    try {
        a::rice_encode_trace({}, 31);
    } catch (const std::invalid_argument &) {
        invalid = true;
    }
    try {
        a::rice_decode_trace({true, true}, 2, 1);
    } catch (const std::invalid_argument &) {
        truncated = true;
    }
    std::print("Invalid k rejected on empty input: {}; truncated unary stream rejected: {}.\n",
               invalid, truncated);
    if (!invalid || !truncated)
        return 1;
    auto p = g::RPlot::create();
    p.lines(x, y, "actual bits for same four values", {22, 163, 74}).points(
        x, y, {22, 163, 74}, 5).title("Actual Rice framing and checked model controls").x_label("explicit k").y_label("actual stream bits");
    p.save_svg("build/rice_coding_controls.svg");
}
```
