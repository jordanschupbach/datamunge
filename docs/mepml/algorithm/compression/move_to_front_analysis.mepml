\alttext(All counts and the round-trip result are computed; no entropy coder or compressed size is implied.)

> Compare raw order with BWT order

BWT preserves byte frequencies but changes their order, often clustering equal
bytes. MTF depends on recency rather than byte frequency alone, so its rank
distribution can change. The next pair of panels compares actual ranks for the
same original text with and without BWT. Identical count axes keep the buckets
comparable. A benefit on this finite repetitive input is not a universal
ordering or compression guarantee.

```{cpp, results="markdown", file="figures/mtf_order.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <datamunge/algorithms/move_to_front.hpp>
#include <datamunge/algorithms/burrows_wheeler.hpp>
#include <datamunge/plot/plot.hpp>
#include <filesystem>
#include <print>
int main() {
    std::filesystem::create_directories("build");
    auto text = dm::algorithms::mtf_demo_text();
    auto bw = dm::algorithms::bwt_transform(text);
    auto layout = dm::graphics::RLayout::create(1, 2);
    std::print("| ordering | zero ranks | ranks1..3 | ranks4..255 | actual median | empirical entropy |\n| " "--- | ---: | ---: | ---: | ---: | ---: |\n");
    for (auto &item : std::vector<std::pair<std::string, std::string>>{
         {"raw", text}, {"cyclic BWT", bw.transformed}
     }) {
        auto s =
            dm::algorithms::mtf_index_summary(dm::algorithms::mtf_encode(
                                              item.second));
        std::print("| {} | {} | {} | {} | {} | {} |\n", item.first, s.zeros,
                   s.one_to_three, s.four_or_more, s.median, s.entropy_bits);
        auto p =
            dm::graphics::RPlot::barplot({double(s.zeros),
                                          double(s.one_to_three),
                                          double(s.four_or_more)},
                                         {"0", "1..3", "4..255"},
                                         "actual counts");
        p.title(item.first).x_label("rank bucket").y_label("observed bytes").y_limits(0, text.size());
        layout.add(p);
    }
    layout.fit_panels().save_svg("build/mtf_order.svg");
}
```
