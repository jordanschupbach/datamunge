> Explicit controls

```{cpp, results="markdown", file="figures/shannon_fano_controls.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    const std::vector<std::vector<std::size_t>> counts{{}, {10}, {1, 1, 1, 1},
                                                       {35, 17, 17, 16, 15}};
    std::vector<double> x, y;
    std::print("| controlled frequencies | actual Shannon-Fano average | actual Huffman average | " "difference |\n| --- | ---: | ---: | ---: |\n");
    for (std::size_t i = 0; i < counts.size(); ++i) {
        auto text = a::shannon_fano_frequency_text(counts[i]);
        auto r = a::shannon_fano_build_run(text);
        auto h = a::huffman_build(text);
        const double optimal = a::huffman_average_bits(h, text);
        std::print("| `{}` | {} | {} | {} |\n", counts[i], r.average_bits,
                   optimal, r.average_bits - optimal);
        x.push_back(i);
        y.push_back(r.average_bits - optimal);
    }
    auto plot = g::RPlot::create();
    plot.lines(x, y, "actual values", {37, 99, 235}).points(x, y, {37, 99, 235},
                                                            5).title(
        "A controlled top-down code can exceed Huffman length").x_label(
        "frequency control").y_label("actual Shannon-Fano minus Huffman bits per byte");
    plot.save_svg("build/shannon_fano_controls.svg");
}
```
// result_begin: markdown
| controlled frequencies | actual Shannon-Fano average | actual Huffman average | difference |
| --- | ---: | ---: | ---: |
| `[]` | 0 | 0 | 0 |
| `[10]` | 1 | 1 | 0 |
| `[1, 1, 1, 1]` | 2 | 2 | 0 |
| `[35, 17, 17, 16, 15]` | 2.31 | 2.3 | 0.010000000000000231 |
\image(figures/shannon_fano_controls.svg)
// result_end
