> The retained original experiment

```{cpp, results="markdown", file="figures/shannon_fano_original.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    const auto text = a::shannon_fano_example_text();
    auto r = a::shannon_fano_build_trace(text);
    auto hf = a::huffman_build(text);
    auto encoded = a::shannon_fano_encode_trace(r.code, text);
    auto decoded =
        a::shannon_fano_decode_trace(r.code, encoded.bits, text.size());
    std::vector<double> x{0, 1, 2, 3}, y{r.entropy,
                                         a::huffman_average_bits(hf, text),
                                         r.average_bits, 8};
    std::print("Original {}-byte text: {}\n\n| quantity | actual bits per byte |\n| --- | ---: |\n| " "empirical entropy | {} |\n| Huffman | {} |\n| Shannon-Fano | {} |\n| fixed-byte reference | " "8 |\n\nActual encoded bits {}, decoded round-trip {}.\n",
               text.size(), text, r.entropy, y[1], r.average_bits,
               encoded.bits.size(), decoded.text == text);
    if (decoded.text != text)
        return 1;
    auto plot = g::RPlot::create();
    plot.bars(x, y, "actual length or labelled reference", {37, 99, 235}, .7).x_ticks(x, {"entropy", "Huffman", "Shannon-Fano", "8-bit reference"}).title("Original pangrams: actual model coding comparison").y_label("bits per source byte");
    plot.save_svg("build/shannon_fano_original.svg");
}
```
// result_begin: markdown
Original 85-byte text: the quick brown fox jumps over the lazy dog. pack my box with five dozen liquor jugs.

