> Actual selected work and sensitivity

```{cpp, results="markdown", file="figures/shannon_fano_work.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    std::vector<double> x, y;
    std::print("| distinct equal-count bytes | actual split comparisons | actual code-bit appends | actual " "average length |\n| ---: | ---: | ---: | ---: |\n");
    for (std::size_t n : {1, 2, 4, 8, 16, 32, 64, 128, 256}) {
        auto r =
            a::shannon_fano_build_run(a::shannon_fano_frequency_text(
                                      std::vector<std::size_t>(n, 1)));
        std::print("| {} | {} | {} | {} |\n", n, r.split_comparisons,
                   r.code_bit_appends, r.average_bits);
        x.push_back(n);
        y.push_back(r.split_comparisons);
    }
    auto plot = g::RPlot::create();
    plot.lines(x, y, "actual values", {37, 99, 235}).points(x, y, {37, 99, 235},
                                                            5).title(
        "Actual split-boundary work on a controlled byte alphabet").x_label(
        "active byte symbols").y_label("actual candidate boundary comparisons");
    plot.save_svg("build/shannon_fano_work.svg");
}
```
