> Explicit controls

```{cpp, results="markdown", file="figures/shannon_fano_elias_controls.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    std::vector<double> x, y;
    std::print("| control | actual active words | actual generated bits |\n| ---: | ---: | ---: |\n");
    const std::vector<std::vector<std::uint32_t>> models{{}, {1}, {0, 1, 0, 1},
                                                         {4294967295u, 1, 1}};
    for (std::size_t i = 0; i < models.size(); ++i) {
        auto r = a::shannon_fano_elias_trace(models[i]);
        std::print("| {} | {} | {} |\n", i, r.words.size(), r.emitted_bits);
        x.push_back(i);
        y.push_back(r.emitted_bits);
    }
    bool truncated = false, extra = false;
    try {
        a::shannon_fano_elias_decode({false}, {1, 1}, 1);
    } catch (const std::invalid_argument &) {
        truncated = true;
    }
    try {
        a::shannon_fano_elias_decode({false, true, true, true}, {1, 1}, 1);
    } catch (const std::invalid_argument &) {
        extra = true;
    }
    std::print("Truncated word rejected {}; extra complete word rejected {}.\n",
               truncated, extra);
    if (!truncated || !extra)
        return 1;
    auto plot = g::RPlot::create();
    plot.lines(x, y, "actual values", {37, 99, 235}).points(x, y, {37, 99, 235},
                                                            5).title(
        "Empty, singleton, inactive and skewed exact-count controls").x_label(
        "control").y_label("actual generated codeword bits");
    plot.save_svg("build/shannon_fano_elias_controls.svg");
}
```
