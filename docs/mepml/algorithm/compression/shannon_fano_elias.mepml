> Actual selected work and sensitivity

```{cpp, results="markdown", file="figures/shannon_fano_elias_work.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    std::vector<double> x, average, bound;
    std::print("| dominant frequency2^k | actual entropy | actual mean word bits | entropy plus2 reference " "|\n| ---: | ---: | ---: | ---: |\n");
    for (unsigned k : {0, 1, 2, 4, 8, 16, 24, 30}) {
        auto r = a::shannon_fano_elias_run({1, std::uint32_t{1} << k});
        std::print("| {} | {} | {} | {} |\n", k, r.entropy, r.average_bits,
                   r.entropy + 2);
        x.push_back(k);
        average.push_back(r.average_bits);
        bound.push_back(r.entropy + 2);
    }
    auto plot = g::RPlot::create();
    plot.lines(x, average, "actual weighted mean word length", {37, 99, 235}).lines(x, bound, "entropy plus2 mathematical upper bound", {220, 38, 38}).title("Exact midpoint coding under controlled frequency skew").x_label("dominant-count exponent k").y_label("bits per symbol");
    plot.save_svg("build/shannon_fano_elias_work.svg");
}
