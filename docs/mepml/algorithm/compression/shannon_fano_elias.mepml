> The retained original experiment

```{cpp, results="markdown", file="figures/shannon_fano_elias_original.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    const std::vector<std::uint32_t> f{10, 5, 3, 2};
    const std::vector<int> message{0, 0, 1, 0, 2, 0, 1, 3, 0, 2};
    auto book = a::shannon_fano_elias_trace(f);
    auto r = a::shannon_fano_elias_encode_trace(message, f);
    auto d = a::shannon_fano_elias_decode_trace(r.bits, f, message.size());
    std::print("Actual message `{}`, decoded `{}`, round-trip {}.\nActual logical bits {}, model entropy " "{}, model average code length {}.\n\n| original symbol | actual frequency | actual word " "length | actual emitted word |\n| ---: | ---: | ---: | --- |\n",
               message, d.symbols, message == d.symbols, r.bits.size(),
               book.entropy, book.average_bits);
    std::vector<double> x, y;
    for (const auto &w : book.words) {
        std::print("| {} | {} | {} | `{}` |\n", w.symbol, w.frequency, w.length,
                   w.bits);
        x.push_back(w.symbol);
        y.push_back(w.length);
    }
    if (message != d.symbols)
        return 1;
    auto plot = g::RPlot::create();
    plot.lines(x, y, "actual values", {37, 99, 235}).points(x, y, {37, 99, 235},
                                                            5).title(
        "Original four-symbol midpoint code: actual word lengths").x_label(
        "symbol id").y_label("actual logical bits per word");
    plot.save_svg("build/shannon_fano_elias_original.svg");
}
```
// result_begin: markdown
Actual message `[0, 0, 1, 0, 2, 0, 1, 3, 0, 2]`, decoded `[0, 0, 1, 0, 2, 0, 1, 3, 0, 2]`, round-trip true.
Actual logical bits 29, model entropy 1.7427376486136672, model average code length 2.85.

| original symbol | actual frequency | actual word length | actual emitted word |
| ---: | ---: | ---: | --- |
| 0 | 10 | 2 | `[false, true]` |
| 1 | 5 | 3 | `[true, false, true]` |
| 2 | 3 | 4 | `[true, true, false, true]` |
| 3 | 2 | 5 | `[true, true, true, true, false]` |
\image(figures/shannon_fano_elias_original.svg)
