> Actual selected work and sensitivity

```{cpp, results="markdown", file="figures/range_coding_work.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");

    const auto message = a::range_frequency_pattern({50, 20, 20, 10}, 10);
    const std::vector<std::vector<std::uint32_t>> models{{1, 1, 1, 1},
                                                         {50, 20, 20, 10},
                                                         {10, 20, 20, 50}};
    std::vector<std::string> labels{"uniform model", "matched model",
                                    "reversed heavy symbol"};
    std::vector<double> rates;
    std::print("\n| static model | actual bytes | actual bits/symbol | actual byte renormalizations | round " "trip |\n| --- | ---: | ---: | ---: | --- |\n");
    for (std::size_t i = 0; i < models.size(); ++i) {
        auto r = a::range_encode_run(message, models[i]);
        auto d = a::range_decode_run(r.bytes, models[i], message.size());
        rates.push_back(8. * r.bytes.size() / message.size());
        std::print("| {} | {} | {} | {} | {} |\n", labels[i], r.bytes.size(),
                   rates.back(), r.renormalizations, d.symbols == message);
    }
    auto p =
        g::RPlot::barplot(rates, labels,
                          "actual bits per original message symbol");
    p.title("A mismatched static model changes actual code length").y_label(
        "actual bits per symbol including flush");
    p.save_svg("build/range_coding_work.svg");
}
```
// result_begin: markdown
| static model | actual bytes | actual bits/symbol | actual byte renormalizations | round trip |
| --- | ---: | ---: | ---: | --- |
| uniform model | 253 | 2.024 | 249 | true |
| matched model | 224 | 1.792 | 220 | true |
| reversed heavy symbol | 340 | 2.72 | 336 | true |
\image(figures/range_coding_work.svg)
