> The retained original experiment

```{cpp, results="markdown", file="figures/range_coding_original.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");

    const std::vector<std::uint32_t> model{50, 20, 20, 10};
    const double entropy = a::shannon_entropy_bits({50, 20, 20, 10});
    std::vector<double> x, y;
    std::print("\n| original repetitions | actual symbols | actual encoded bytes | actual bits/symbol | " "exact round trip |\n| ---: | ---: | ---: | ---: | --- |\n");
    for (std::size_t reps = 1; reps <= 12; ++reps) {
        auto message = a::range_frequency_pattern(model, reps);
        auto encoded = a::range_encode_run(message, model);
        auto decoded =
            a::range_decode_run(encoded.bytes, model, message.size());
        const double bits = 8. * encoded.bytes.size() / message.size();
        x.push_back(message.size());
        y.push_back(bits);
        std::print("| {} | {} | {} | {} | {} |\n", reps, message.size(),
                   encoded.bytes.size(), bits, decoded.symbols == message);
    }
    auto p = g::RPlot::create();
    p.lines(x, y, "actual static-model bits per symbol", {37, 99, 235}).points(
        x, y, {37, 99, 235}, 5).abline_h(entropy, {22, 163, 74}).title(
        "Original static model: actual bytes include four-byte framing").y_limits(1.65, 2.15).x_label("actual original-pattern symbols").y_label("actual bits per symbol / entropy reference");
    p.save_svg("build/range_coding_original.svg");
}
```
