> Explicit controls

```{cpp, results="markdown", file="figures/range_coding_controls.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");

    std::vector<std::string> labels{"empty message", "single-symbol model",
                                    "zero-frequency symbol", "truncated stream",
                                    "oversized total"};
    std::vector<double> values;
    auto empty = a::range_encode({}, {1});
    auto deterministic = a::range_encode(std::vector<int>(100, 0), {1});
    values.push_back(empty.size());
    values.push_back(deterministic.size());
    bool zero = false, truncated = false, total = false;
    try {
        a::range_encode({1}, {1, 0});
    } catch (const std::invalid_argument &) {
        zero = true;
    }
    try {
        a::range_decode({0, 0, 0}, {1}, 0);
    } catch (const std::runtime_error &) {
        truncated = true;
    }
    try {
        a::range_encode({0}, {65536, 1});
    } catch (const std::invalid_argument &) {
        total = true;
    }
    values.push_back(zero ? 0 : 1);
    values.push_back(truncated ? 0 : 1);
    values.push_back(total ? 0 : 1);
    std::print("\n| actual control | emitted bytes or rejection |\n| --- | --- |\n| empty message | {} " "actual bytes |\n|100 deterministic symbols | {} actual bytes; count is external |\n| " "zero-frequency symbol | rejected {} |\n| fewer than4 decoder bytes | rejected {} |\n| model " "total65537 | rejected {} |\n",
               empty.size(), deterministic.size(), zero, truncated, total);
    auto p =
        g::RPlot::barplot(values, labels,
                          "actual bytes (rejected cases shown at zero)");
    p.title("Framing and checked model/stream boundaries").y_label(
        "actual encoded bytes; rejected cases zero");
    p.save_svg("build/range_coding_controls.svg");
}
```
