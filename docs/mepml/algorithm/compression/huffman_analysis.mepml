> Empty, singleton, huge weights and malformed input

Zero counts are absent symbols with length 0. A lone positive count has length 1
and no merges, so weighted_bits equals its count while merge_cost is 0. Four
equal UINT64_MAX counts instead require balanced lengths2,2,2,2. The old uint64
heap overflowed and produced3,3,2,1; the corrected exact kernel returns the
balanced result without narrowing the supported per-count domain.

The byte model is an owned public aggregate, so every codec validates it before
walking: a wholly empty model or a connected acyclic full binary tree with
unique byte leaves, checked indices and exact code-map/path agreement. A full
byte tree has at most 511 nodes. Valid older node numbering is accepted,
including a root away from the end. Every input digit must be 0/1, singleton
payloads use only 0, and a final partial codeword is rejected. Unknown source
bytes preserve the out_of_range error from lookup. No output is returned
partially on failure.

```{cpp, results="markdown", file="figures/huffman_controls.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <datamunge/algorithms/huffman_analysis.hpp>
#include <algorithm>
#include <cmath>
#include <filesystem>
#include <format>
#include <limits>
#include <print>
#include <stdexcept>
#include <string>
#include <vector>
int main() {
    std::filesystem::create_directories("build");
    const auto maximum = std::numeric_limits<std::uint64_t>::max();
    const std::vector<std::vector<std::uint64_t>> cases = {
        {}, {0, 0}, {0, 7, 0}, {maximum, maximum, maximum, maximum}
    };
    std::print("| case | lengths | exact total weight | exact weighted bits | exact merge cost | entropy | " "mean |\n| ---: | --- | ---: | ---: | ---: | ---: | ---: |\n");
    for (std::size_t i = 0; i < cases.size(); ++i) {
        const auto t = dm::algorithms::huffman_counts_trace(cases[i]);
        const auto s = dm::algorithms::huffman_summary(t.counts, t.run.lengths);
        std::print("| {} | {} | {} | {} | {} | {:.9f} | {:.9f} |\n", i + 1,
                   t.run.lengths, t.run.total_weight, t.run.weighted_bits,
                   t.run.merge_cost, s.entropy_bits, s.mean_bits);
    }
    const auto model = dm::algorithms::huffman_build("abc");
    bool nonbinary =
        false, singleton =
        false, truncated = false, cycle = false, quota = false;
    try {
        (void) dm::algorithms::huffman_decode(model, "x");
    } catch (const std::invalid_argument &) {
        nonbinary = true;
    }
    try {
        (void) dm::algorithms::huffman_decode(dm::algorithms::huffman_build(
                                              "aaaa"), "1");
    } catch (const std::invalid_argument &) {
        singleton = true;
    }
    for (const auto & [symbol, word] : model.codes)
        if (word.size() > 1) {
            try {
                (void) dm::algorithms::huffman_decode(model,
                                                      word.substr(
                                                      0, word.size() - 1));
            } catch (const std::invalid_argument &) {
                truncated = true;
            }
            break;
        }
        auto broken = model;
        broken.tree[broken.root].left = broken.root;
        try {
            (void) dm::algorithms::huffman_decode(broken, "0");
        } catch (const std::invalid_argument &) {
            cycle = true;
        }
        const auto exact =
            dm::algorithms::huffman_counts_trace({1, 1, 2}, {3, 2});
        try {
            (void) dm::algorithms::huffman_counts_trace({1, 1, 2}, {3, 1});
        } catch (const std::length_error &) {
            quota = true;
        }
        std::print("\nNonbinary rejected {}; singleton1 rejected {}; incomplete suffix rejected {}; cyclic " "model rejected {}; exact merge records {}; one-short record cap rejected {}.\n",
                   nonbinary, singleton, truncated, cycle, exact.merges.size(),
                   quota);
        const auto wide =
            dm::algorithms::huffman_counts_run({maximum, maximum, maximum,
                                                maximum});
        std::vector<double> lengths(wide.lengths.begin(), wide.lengths.end());
        auto p =
            dm::graphics::RPlot::barplot(lengths, {"0", "1", "2", "3"},
                                         "actual lengths", {37, 99, 235});
        p.title("Four maximum uint64 counts: exact balanced construction").x_label("original symbol index").y_label("logical code length").y_limits(0, 4).save_svg("build/huffman_controls.svg");
        if (!nonbinary || !singleton || !truncated || !cycle || !quota ||
            wide.lengths != std::vector<int>{2, 2, 2, 2})
            throw std::runtime_error("codec/weight controls");
}
