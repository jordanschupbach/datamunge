> Actual selected work and sensitivity

```{cpp, results="markdown", file="figures/run_length_encoding_work.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    std::vector<double> x, constant, alternating;
    std::print("| source bytes | one-run comparisons | alternating comparisons | one-run records | " "alternating records |\n| ---: | ---: | ---: | ---: | ---: |\n");
    for (std::size_t n : {1, 2, 4, 8, 16, 32, 64, 128}) {
        const auto same =
            a::rle_example_pattern(n), alt = a::rle_example_pattern(n, true);
        auto u = a::rle_encode_run(same), v = a::rle_encode_run(alt);
        std::print("| {} | {} | {} | {} | {} |\n", n, u.comparisons,
                   v.comparisons, u.runs.size(), v.runs.size());
        x.push_back(n);
        constant.push_back(u.comparisons);
        alternating.push_back(v.comparisons);
    }
    auto p = g::RPlot::create();
    p.lines(x, constant, "actual one-run equality tests", {37, 99, 235}).lines(
        x, alternating, "actual alternating equality tests", {234, 88, 12}).title("Actual RLE boundary work depends on the run count").x_label("source bytes").y_label("actual equality tests");
    p.save_svg("build/run_length_encoding_work.svg");
}
```
