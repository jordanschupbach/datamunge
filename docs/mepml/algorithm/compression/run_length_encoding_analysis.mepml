> The retained original experiment

```{cpp, results="markdown", file="figures/run_length_encoding_original.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    const std::string scan =
        "WWWWWWWWWWWWBWWWWWWWWWWWWBBBWWWWWWWWWWWWWWWWWWWWWWWWBWWWWWWWWWWWWWW", noisy = "ABCDEFGHIJKLMNOPQRSTUVWXYZ";
    auto t = a::rle_encode_trace(scan);
    auto n = a::rle_encode_run(noisy);
    std::print("Scanline bytes {}, logical records {}, actual round-trip {}. Run-free alphabet bytes {}, " "logical records {}. No serialized-size claim is made.\n\n| run | byte code | begin | end | " "count |\n| ---: | ---: | ---: | ---: | ---: |\n",
               scan.size(), t.runs.size(), a::rle_decode(t.runs) == scan,
               noisy.size(), n.runs.size());
    std::vector<double> x, y;
    for (const auto &s : t.steps) {
        std::print("| {} | {} | {} | {} | {} |\n", s.run_index,
                   unsigned(static_cast<unsigned char>(s.symbol)), s.begin,
                   s.end, s.end - s.begin);
        x.push_back(s.run_index);
        y.push_back(s.end - s.begin);
    }
    auto p = g::RPlot::create();
    p.bars(x, y, "actual scanline run lengths", {22, 163, 74}, .8).title(
        "Original bitmap scanline: actual maximal byte spans").x_label(
        "actual chronological run").y_label("original bytes in run");
    p.save_svg("build/run_length_encoding_original.svg");
}
```
