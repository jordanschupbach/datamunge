> Explicit controls

```{cpp, results="markdown", file="figures/run_length_encoding_controls.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    const std::vector<std::string> cases{std::string{}, std::string(8, 'A'), std::string{'a', char {
        0
    }, char { 0 }, 'b'}, "ABC"};
    std::vector<double> x, y;
    std::vector<std::string> labels{"empty", "one run", "embedded NUL",
                                    "run-free"};
    std::print("| control | bytes | logical records | actual round-trip |\n| --- | ---: | ---: | --- |\n");
    for (std::size_t i = 0; i < cases.size(); ++i) {
        auto r = a::rle_encode_run(cases[i]);
        bool ok = a::rle_decode(r.runs) == cases[i];
        std::print("| {} | {} | {} | {} |\n", labels[i], cases[i].size(),
                   r.runs.size(), ok);
        if (!ok)
            return 1;
        x.push_back(i);
        y.push_back(r.runs.size());
    }
    a::RLEOptions o;
    o.max_bytes = 3;
    bool rejected = false;
    try {
        a::rle_decode_run({{'X', 4}}, o);
    } catch (const std::length_error &) {
        rejected = true;
    }
    std::print("Oversized complete decoded length rejected: {}.\n", rejected);
    if (!rejected)
        return 1;
    auto p = g::RPlot::create();
    p.bars(x, y, "actual logical records", {22, 163, 74}, .8).x_ticks(x, labels).title("Raw-byte and complete-allocation RLE controls").x_label("controlled string").y_label("logical symbol/count records");
    p.save_svg("build/run_length_encoding_controls.svg");
}
```
