> The retained original experiment

```{cpp, results="markdown", file="figures/slerp_original.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <filesystem>
#include <print>
#include <algorithm>
#include <cmath>
#include <limits>
#include <numeric>
#include <numbers>
#include <random>
#include <string>
#include <vector>
#include <map>
#include <set>
#include <array>
#include <tuple>
#include <bit>
#include <datamunge/random/quality.hpp>
#include <datamunge/algorithms/slerp.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    std::vector<double> x, y;
    std::print("| original t | actual quaternion | norm | angle degrees |\n| ---: | --- | ---: | ---: |\n");
    for (int i = 0; i <= 20; ++i) {
        const double t = i / 20.;
        auto q =
            a::slerp({1, 0, 0, 0}, a::quat_z_rotation(std::numbers::pi / 2), t);
        const double angle =
            a::quat_angle_between({1, 0, 0, 0}, q) * 180 / std::numbers::pi;
        std::print("| {} | `{}` | {} | {} |\n", t, q, a::quat_norm(q), angle);
        x.push_back(t);
        y.push_back(angle);
    }
    auto plot = g::RPlot::create();
    plot.lines(x, y, "actual values", {37, 99, 235}).points(x, y, {37, 99, 235},
                                                            4).title(
        "Original identity to90 degrees: actual angle").x_label("fraction").y_label("full rotation angle in degrees");
    plot.save_svg("build/slerp_original.svg");
}
```
