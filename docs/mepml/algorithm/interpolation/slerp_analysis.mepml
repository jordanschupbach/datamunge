> Actual selected work and sensitivity

```{cpp, results="markdown", file="figures/slerp_work.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <filesystem>
#include <print>
#include <algorithm>
#include <cmath>
#include <limits>
#include <numeric>
#include <numbers>
#include <random>
#include <string>
#include <vector>
#include <map>
#include <set>
#include <array>
#include <tuple>
#include <bit>
#include <datamunge/random/quality.hpp>
#include <datamunge/algorithms/slerp.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    std::vector<double> x, y;
    std::print("| target radians | actual halfway angle | constant-rate reference | branch |\n| ---: | ---: " "| ---: | --- |\n");
    for (double angle : {.001, .01, .05, .1, .5, 1., 2., 3.}) {
        auto r = a::slerp_run({1, 0, 0, 0}, a::quat_z_rotation(angle), .25);
        const double actual = a::quat_angle_between(r.start, r.value);
        std::print("| {} | {} | {} | {} |\n", angle, actual, angle * .25,
                   r.normalized_linear ? "normalized chord" : "spherical");
        x.push_back(angle);
        y.push_back((actual - angle * .25) * 1e6);
    }
    auto plot = g::RPlot::create();
    plot.lines(x, y, "actual values", {37, 99, 235}).points(x, y, {37, 99, 235},
                                                            4).title(
        "Quarter-time angle error across actual branches").x_label(
        "target rotation in radians").y_label("angle error in microradians");
    plot.save_svg("build/slerp_work.svg");
}
```
