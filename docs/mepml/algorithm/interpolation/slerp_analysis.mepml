> Explicit controls

```{cpp, results="markdown", file="figures/slerp_controls.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <filesystem>
#include <print>
#include <algorithm>
#include <cmath>
#include <limits>
#include <numeric>
#include <numbers>
#include <random>
#include <string>
#include <vector>
#include <map>
#include <set>
#include <array>
#include <tuple>
#include <bit>
#include <datamunge/random/quality.hpp>
#include <datamunge/algorithms/slerp.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    const std::vector<a::Quaternion> targets{{1, 0, 0, 0}, {-1, 0, 0, 0},
                                             a::quat_z_rotation(.01),
                                             a::quat_z_rotation(std::numbers::pi),
                                             {1e308, 0, 0, 0}, {1e-308, 0, 0, 0}};
    std::vector<double> x, y;
    std::print("| control | flipped | normalized-linear | norm | angle |\n| ---: | --- | --- | ---: | ---: " "|\n");
    for (std::size_t i = 0; i < targets.size(); ++i) {
        auto r = a::slerp_run({1, 0, 0, 0}, targets[i], .5);
        const auto angle = a::quat_angle_between(r.start, r.value);
        std::print("| {} | {} | {} | {} | {} |\n", i, r.sign_flipped,
                   r.normalized_linear, a::quat_norm(r.value), angle);
        x.push_back(i);
        y.push_back(angle);
    }
    auto plot = g::RPlot::create();
    plot.lines(x, y, "actual values", {37, 99, 235}).points(x, y, {37, 99, 235},
                                                            4).title(
        "Equivalent signs, near parallels and extreme scales").x_label(
        "control index").y_label("actual full rotation angle");
    plot.save_svg("build/slerp_controls.svg");
}
```
