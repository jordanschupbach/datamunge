> Explicit controls

```{cpp, results="markdown", file="figures/rabin_karp_controls.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");

    std::vector<std::pair<std::string, std::string>> cases{
        {"aaa", "aa"}, {"abc", ""}, {"a", "long"},
        {std::string("a\0a\0", 4), std::string("a\0", 2)}
    };
    std::vector<std::string> labels{"overlap", "empty pattern", "too long",
                                    "embedded NUL"};
    std::vector<double> counts;
    std::print("\n| fixture | actual offsets | actual visited windows |\n| --- | --- | ---: |\n");
    for (std::size_t i = 0; i < cases.size(); ++i) {
        auto r = a::rabin_karp_run(cases[i].first, cases[i].second);
        counts.push_back(r.matches.size());
        std::print("| {} | `{}` | {} |\n", labels[i], r.matches,
                   r.visited_windows);
    }
    auto p = g::RPlot::barplot(counts, labels, "actual exact match count");
    p.title("Byte-string boundary and overlap conventions").y_label(
        "actual matching offsets");
    p.save_svg("build/rabin_karp_controls.svg");
}
```
// result_begin: markdown
| fixture | actual offsets | actual visited windows |
| --- | --- | ---: |
| overlap | `[0, 1]` | 2 |
| empty pattern | `[0, 1, 2, 3]` | 4 |
| too long | `[]` | 0 |
| embedded NUL | `[0, 2]` | 3 |
\image(figures/rabin_karp_controls.svg)
// result_end
\caption(Actual outcomes on controlled native inputs; errors, truncation and unresolved outcomes retain their stated meanings.)
\alttext(Actual outcomes on controlled native inputs; errors, truncation and unresolved outcomes retain their stated meanings.)

> Actual selected work and sensitivity

```{cpp, results="markdown", file="figures/rabin_karp_work.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");

    std::vector<double> x, y, z;
    std::print("\n| repeated text length | pattern length | actual windows | actual compared bytes |\n| " "---: | ---: | ---: | ---: |\n");
    for (std::size_t n : {32, 64, 128, 256, 512}) {
        auto r = a::rabin_karp_run(std::string(n, 'a'), std::string(16, 'a'));
        x.push_back(n);
        y.push_back(r.visited_windows);
        z.push_back(r.compared_bytes);
        std::print("| {} | 16 | {} | {} |\n", n, r.visited_windows,
                   r.compared_bytes);
    }
    auto p = g::RPlot::create();
    p.lines(x, y, "actual visited windows", {37, 99, 235}).lines(
        x, z, "actual exact byte comparisons", {234, 88, 12}).title(
        "Every repeated window is a genuine hash candidate").x_label(
        "repeated text bytes").y_label("actual selected events");
    p.save_svg("build/rabin_karp_work.svg");
}
```
