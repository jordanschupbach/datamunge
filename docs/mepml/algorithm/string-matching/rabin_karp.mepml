> The retained original experiment

```{cpp, results="markdown", file="figures/rabin_karp_original.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");

    a::RabinKarpOptions o;
    o.base = 10;
    o.modulus = 101;
    auto t = a::rabin_karp_trace("abababbb", "aba", o);
    std::vector<double> x, y, mx, my;
    std::print("\n| original window start | actual raw-byte hash | exact candidate | exact match |\n| ---: " "| ---: | --- | --- |\n");
    for (const auto &s : t.windows) {
        x.push_back(s.start);
        y.push_back(s.hash);
        if (s.matched) {
            mx.push_back(s.start);
            my.push_back(s.hash);
        }
        std::print("| {} | {} | {} | {} |\n", s.start, s.hash, s.candidate,
                   s.matched);
    }
    std::print("Actual default-hash matches: {}.\n",
               a::rabin_karp_search("abababbb", "aba"));
    auto p = g::RPlot::create();
    p.lines(x, y, "actual raw-byte hashes, base10 mod101", {37, 99, 235}).points(mx, my, "actual exact matches", {22, 163, 74}, 7).abline_h(t.pattern_hash, {220, 38, 38}).title("Original text: actual native rolling windows").x_label("window byte offset").y_label("actual raw-byte polynomial hash");
    p.save_svg("build/rabin_karp_original.svg");
}
```
// result_begin: markdown
| original window start | actual raw-byte hash | exact candidate | exact match |
| ---: | ---: | --- | --- |
| 0 | 71 | true | true |
| 1 | 61 | false | false |
| 2 | 71 | true | true |
| 3 | 61 | false | false |
| 4 | 72 | false | false |
| 5 | 71 | true | false |
Actual default-hash matches: [0, 2].
\image(figures/rabin_karp_original.svg)
