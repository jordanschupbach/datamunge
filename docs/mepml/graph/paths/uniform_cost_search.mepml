> Sensitivity and selected work

```{cpp, results="markdown", file="figures/uniform_cost_search_work.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    auto graph = a::uniform_cost_example_graph();
    std::vector<double> x, y;
    std::print("| goal | cost | settled | edge checks | successful relaxations " "|\n|---:|---:|---:|---:|---:|\n");
    for (int goal = 0; goal < 10; ++goal) {
        auto r = a::uniform_cost_search(10, graph, 0, goal);
        std::print("|{}|{}|{}|{}|{}|\n", goal, r.cost, r.expanded,
                   r.edge_checks, r.relaxations);
        x.push_back(goal);
        y.push_back(r.edge_checks);
    }
    auto p = g::RPlot::create();
    p.line(x, y, "actual", {37, 99, 235}, 2);
    p.points(x, y, "", {37, 99, 235}, 5);
    p.title("Actual relaxation work depends on the requested goal").x_label(
        "goal ID").y_label("actual outgoing-edge checks");
    p.save_svg("build/uniform_cost_search_work.svg");
}
```
