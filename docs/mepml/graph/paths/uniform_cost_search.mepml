> Checking the theory and controls

```{cpp, results="markdown", file="figures/uniform_cost_search_controls.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    std::vector<double> x, y;
    std::print("| goal | found | cost if found | settled |\n|---:|---|---:|---:|\n");
    for (int goal = 0; goal < 4; ++goal) {
        auto r =
            a::uniform_cost_search(4, {{{1, 0}}, {{2, 0}}, {}, {}}, 0, goal);
        std::print("|{}|{}|{}|{}|\n", goal, r.found, r.cost, r.expanded);
        x.push_back(goal);
        y.push_back(r.expanded);
    }
    auto p = g::RPlot::create();
    p.line(x, y, "actual", {37, 99, 235}, 2);
    p.points(x, y, "", {37, 99, 235}, 5);
    p.title("Zero-cost paths, start=goal and unreachable control").x_label(
        "goal ID").y_label("actual settlements");
    p.save_svg("build/uniform_cost_search_controls.svg");
}
```
// result_begin: markdown
| goal | found | cost if found | settled |
|---:|---|---:|---:|
|0|true|0|1|
|1|true|0|2|
|2|true|0|3|
|3|false|0|3|
\image(figures/uniform_cost_search_controls.svg)
// result_end
