> The retained original experiment

```{cpp, results="markdown", file="figures/uniform_cost_search_original.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    auto graph = a::uniform_cost_example_graph();
    auto r = a::uniform_cost_search(10, graph, 0, 5);
    auto far = a::uniform_cost_search(10, graph, 0, 9);
    std::print("| goal | actual path | cost | settled " "|\n|---:|---|---:|---:|\n|5|`{}`|{}|{}|\n|9|`{}`|{}|{}|\n",
               r.path, r.cost, r.expanded, far.path, far.cost, far.expanded);
    auto p =
        g::RPlot::barplot({double(r.expanded), double(far.expanded)},
                          {"goal5", "goal9"}, "actual settlements",
                          {5, 150, 105});
    p.title("Original ten-node graph: executed early stopping").y_label(
        "settled vertices");
    p.save_svg("build/uniform_cost_search_original.svg");
}
```
