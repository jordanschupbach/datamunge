> The retained original experiment

```{cpp, results="markdown", file="figures/topological_sort_original.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <filesystem>
#include <print>
#include <algorithm>
#include <cmath>
#include <limits>
#include <numeric>
#include <numbers>
#include <random>
#include <string>
#include <vector>
#include <map>
#include <set>
#include <array>
#include <tuple>
#include <bit>
#include <datamunge/random/quality.hpp>
#include <datamunge/algorithms/topological_sort.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    const std::vector<std::string> names{"CS101", "MA210", "CS201", "CS240",
                                         "CS310", "CS330"};
    const std::vector<std::pair<std::size_t, std::size_t>> edges{{0, 2}, {0, 3},
                                                                 {1, 2}, {1, 4},
                                                                 {2, 4}, {2, 5},
                                                                 {3, 5}};
    auto r = a::topological_sort_run(6, edges);
    std::print("Original curriculum actual order `{}`; DAG {}; witness valid {}.\n\n| actual position | " "original course | actual level |\n| ---: | --- | ---: |\n",
               r.result.order, r.result.is_dag,
               a::is_topological_order(6, edges, r.result.order));
    for (auto i : r.result.order)
        std::print("| {} | {} | {} |\n", r.positions[i], names[i], r.levels[i]);
    g::Diagram diagram(48, 1200);
    const std::array<double, 6> lanes{2, -2, 2, -2, 2, -2};
    for (std::size_t i = 0; i < 6; ++i)
        diagram.node(std::to_string(i), {double(r.levels[i]) * 5, lanes[i]},
                     std::format("{}; position{}", names[i], r.positions[i]));
    for (auto[u, v] : edges)
        diagram.edge(std::to_string(u), std::to_string(v));
    diagram.save_svg("build/topological_sort_original.svg");
}
```
