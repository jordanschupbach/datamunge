> Explicit controls

```{cpp, results="markdown", file="figures/topological_sort_controls.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <filesystem>
#include <print>
#include <algorithm>
#include <cmath>
#include <limits>
#include <numeric>
#include <numbers>
#include <random>
#include <string>
#include <vector>
#include <map>
#include <set>
#include <array>
#include <tuple>
#include <bit>
#include <datamunge/random/quality.hpp>
#include <datamunge/algorithms/topological_sort.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    std::vector<double> x, y;
    std::vector<std::vector<std::pair<std::size_t, std::size_t>> > cases{
        {}, {{0, 1}, {1, 2}}, {{0, 1}, {1, 0}}, {{0, 1}, {1, 0}, {1, 2}},
        {{0, 1}, {0, 1}, {1, 2}}
    };
    std::print("| control | actual DAG status | compatibility order | actual partial emissions | remaining " "indegrees |\n| ---: | --- | --- | --- | --- |\n");
    for (std::size_t i = 0; i < cases.size(); ++i) {
        auto r = a::topological_sort_run(3, cases[i]);
        x.push_back(i);
        y.push_back(r.emitted.size());
        std::print("| {} | {} | `{}` | `{}` | `{}` |\n", i, r.result.is_dag,
                   r.result.order, r.emitted, r.remaining_indegree);
    }
    auto plot = g::RPlot::create();
    plot.lines(x, y, "actual native values", {37, 99, 235}).points(
        x, y, {37, 99, 235}, 4).title("Cyclic and duplicate-edge controls retain actual partial progress").x_label("control index").y_label("actual emitted vertices");
    plot.save_svg("build/topological_sort_controls.svg");
}
```
