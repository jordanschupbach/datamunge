> Actual selected work and sensitivity

```{cpp, results="markdown", file="figures/topological_sort_work.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <filesystem>
#include <print>
#include <algorithm>
#include <cmath>
#include <limits>
#include <numeric>
#include <numbers>
#include <random>
#include <string>
#include <vector>
#include <map>
#include <set>
#include <array>
#include <tuple>
#include <bit>
#include <datamunge/random/quality.hpp>
#include <datamunge/algorithms/topological_sort.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    std::vector<double> x, y;
    std::print("| chain vertices | actual emitted vertices | actual edge decrements | actual enqueues |\n| " "---: | ---: | ---: | ---: |\n");
    for (std::size_t n : {1, 2, 8, 32, 128, 512, 2048}) {
        std::vector<std::pair<std::size_t, std::size_t>> edges;
        for (std::size_t i = 1; i < n; ++i)
            edges.emplace_back(i - 1, i);
        auto r = a::topological_sort_run(n, edges);
        x.push_back(n);
        y.push_back(r.emitted.size() + r.edge_visits);
        std::print("| {} | {} | {} | {} |\n", n, r.emitted.size(),
                   r.edge_visits, r.enqueues);
    }
    auto plot = g::RPlot::create();
    plot.lines(x, y, "actual native values", {37, 99, 235}).points(
        x, y, {37, 99, 235}, 4).title("Actual chain vertex emissions plus successor removals").x_label("chain vertices").y_label("actual selected events");
    plot.save_svg("build/topological_sort_work.svg");
}
```
