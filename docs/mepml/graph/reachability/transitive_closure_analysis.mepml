> Actual selected work and sensitivity

```{cpp, results="markdown", file="figures/transitive_closure_work.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <filesystem>
#include <print>
#include <algorithm>
#include <cmath>
#include <limits>
#include <numeric>
#include <numbers>
#include <random>
#include <string>
#include <vector>
#include <map>
#include <set>
#include <array>
#include <tuple>
#include <bit>
#include <datamunge/random/quality.hpp>
#include <datamunge/algorithms/transitive_closure.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    std::vector<double> x, y;
    std::print("| directed cycle vertices | actual row predicates | actual gated inner updates | actual " "false-to-true paths |\n| ---: | ---: | ---: | ---: |\n");
    for (std::size_t n : {4, 8, 16, 32, 64, 128}) {
        std::vector<std::pair<std::size_t, std::size_t>> edges;
        for (std::size_t i = 0; i < n; ++i)
            edges.emplace_back(i, (i + 1) % n);
        auto r = a::transitive_closure_run(n, edges);
        x.push_back(n);
        y.push_back(r.candidate_updates);
        std::print("| {} | {} | {} | {} |\n", n, r.row_tests,
                   r.candidate_updates, r.new_paths);
    }
    auto plot = g::RPlot::create();
    plot.lines(x, y, "actual native values", {37, 99, 235}).points(
        x, y, {37, 99, 235}, 4).title("Actual Warshall updates retain data-dependent row gating").x_label("cycle vertices").y_label("actual inner candidate updates");
    plot.save_svg("build/transitive_closure_work.svg");
}
```
