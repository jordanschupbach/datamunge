> Explicit controls

```{cpp, results="markdown", file="figures/transitive_closure_controls.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <filesystem>
#include <print>
#include <algorithm>
#include <cmath>
#include <limits>
#include <numeric>
#include <numbers>
#include <random>
#include <string>
#include <vector>
#include <map>
#include <set>
#include <array>
#include <tuple>
#include <bit>
#include <datamunge/random/quality.hpp>
#include <datamunge/algorithms/transitive_closure.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    std::vector<double> x, y;
    std::print("| control | reflexive seed | actual self-reachable vertices | actual final matrix |\n| ---: " "| --- | ---: | --- |\n");
    for (int i = 0; i < 4; ++i) {
        bool reflexive = i % 2;
        std::vector<std::pair<std::size_t, std::size_t>> edges =
            i < 2 ? std::vector<std::pair<std::size_t, std::size_t>>{{0, 1}}
            : std::vector<std::pair<std::size_t, std::size_t>>{{0, 1}, {1, 0}};
        auto r = a::transitive_closure_run(2, edges, reflexive);
        int diagonal = int(r.reachable[0][0]) + int(r.reachable[1][1]);
        x.push_back(i);
        y.push_back(diagonal);
        std::print("| {} | {} | {} | `{}` |\n", i, reflexive, diagonal,
                   r.reachable);
    }
    auto plot = g::RPlot::create();
    plot.lines(x, y, "actual native values", {37, 99, 235}).points(
        x, y, {37, 99, 235}, 4).title("Cycles create positive-length self paths without reflexive seeding").x_label("control index").y_label("actual true diagonal entries");
    plot.save_svg("build/transitive_closure_controls.svg");
}
```
// result_begin: markdown
| control | reflexive seed | actual self-reachable vertices | actual final matrix |
| ---: | --- | ---: | --- |
| 0 | false | 0 | `[[false, true], [false, false]]` |
| 1 | true | 2 | `[[true, true], [false, true]]` |
| 2 | false | 2 | `[[true, true], [true, true]]` |
| 3 | true | 2 | `[[true, true], [true, true]]` |
\image(figures/transitive_closure_controls.svg)
// result_end
