> The retained original experiment

```{cpp, results="markdown", file="figures/transitive_closure_original.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <filesystem>
#include <print>
#include <algorithm>
#include <cmath>
#include <limits>
#include <numeric>
#include <numbers>
#include <random>
#include <string>
#include <vector>
#include <map>
#include <set>
#include <array>
#include <tuple>
#include <bit>
#include <datamunge/random/quality.hpp>
#include <datamunge/algorithms/transitive_closure.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    auto r = a::transitive_closure_run(3, {{0, 1}, {1, 2}});
    std::print("Original chain query0->2 is {}.\n\n| original source | reaches0 | reaches1 | reaches2 |\n| " "---: | --- | --- | --- |\n",
               bool(r.reachable[0][2]));
    std::vector<double> x, y;
    for (std::size_t i = 0; i < 3; ++i) {
        std::print("| {} | {} | {} | {} |\n", i, bool(r.reachable[i][0]),
                   bool(r.reachable[i][1]), bool(r.reachable[i][2]));
        for (std::size_t j = 0; j < 3; ++j)
            if (r.reachable[i][j]) {
                x.push_back(j);
        y.push_back(-double(i));
            }
    }
    auto chart = g::RPlot::create();
    chart.points(x, y, {37, 99, 235}, 12).size(760, 800).margins(80, 40, 72, 88).xlim(-.5, 2.5).ylim(-2.5, .5).title("Original chain: actual reachable source/target pairs").x_label("target vertex").y_label("negative source; source0 at top");
    chart.save_svg("build/transitive_closure_original.svg");
}
```
