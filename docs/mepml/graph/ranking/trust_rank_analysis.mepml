> The retained original experiment

```{cpp, results="markdown", file="figures/trust_rank_original.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <filesystem>
#include <print>
#include <algorithm>
#include <cmath>
#include <limits>
#include <numeric>
#include <numbers>
#include <random>
#include <string>
#include <vector>
#include <map>
#include <set>
#include <array>
#include <tuple>
#include <bit>
#include <datamunge/random/quality.hpp>
#include <datamunge/algorithms/trust_rank.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    auto r = a::trust_rank_work(3, {{0, 1}, {1, 2}, {2, 0}}, {0});
    std::vector<double> x{0, 1, 2}, y = r.rank;
    std::print("| vertex | actual score |\n|---:|---:|\n");
    for (std::size_t i = 0; i < 3; ++i)
        std::print("|{}|{}|\n", i, r.rank[i]);
    std::print("\nConverged {}; iterations {}; mass {}.\n", r.converged,
               r.iterations, std::accumulate(y.begin(), y.end(), 0.));
    auto p = g::RPlot::create();
    p.line(x, y, "actual", {37, 99, 235}, 2);
    p.points(x, y, "", {37, 99, 235}, 5);
    p.title("Original three-cycle: actual trusted scores").x_label("vertex").y_label("rank mass");
    p.save_svg("build/trust_rank_original.svg");
}
```
