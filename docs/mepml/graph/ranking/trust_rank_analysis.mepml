> Checking the theory and controls

```{cpp, results="markdown", file="figures/trust_rank_controls.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <filesystem>
#include <print>
#include <algorithm>
#include <cmath>
#include <limits>
#include <numeric>
#include <numbers>
#include <random>
#include <string>
#include <vector>
#include <map>
#include <set>
#include <array>
#include <tuple>
#include <bit>
#include <datamunge/random/quality.hpp>
#include <datamunge/algorithms/trust_rank.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    std::vector<double> x, y;
    std::print("| control | rank | converged |\n|---|---|---|\n");
    int i = 0;
    for (auto seeds : std::vector<std::vector<std::size_t>>{{0}, {1}, {0, 0, 1}}) {
        auto r = a::trust_rank_work(3, {{0, 1}}, seeds);
        std::print("|`{}`|`{}`|{}|\n", seeds, r.rank, r.converged);
        x.push_back(i++);
        y.push_back(std::accumulate(r.rank.begin(), r.rank.end(), 0.));
    }
    auto p = g::RPlot::create();
    p.line(x, y, "actual", {37, 99, 235}, 2);
    p.points(x, y, "", {37, 99, 235}, 5);
    p.y_limits(.95, 1.05).title("Dangling redistribution and repeated-seed controls").x_label("control index").y_label("actual total mass");
    p.save_svg("build/trust_rank_controls.svg");
}
```
