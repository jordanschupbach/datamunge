> Sensitivity and selected work

```{cpp, results="markdown", file="figures/trust_rank_work.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <filesystem>
#include <print>
#include <algorithm>
#include <cmath>
#include <limits>
#include <numeric>
#include <numbers>
#include <random>
#include <string>
#include <vector>
#include <map>
#include <set>
#include <array>
#include <tuple>
#include <bit>
#include <datamunge/random/quality.hpp>
#include <datamunge/algorithms/trust_rank.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    std::vector<double> x, y;
    std::print("| damping | actual iterations | actual last delta |\n|---:|---:|---:|\n");
    for (double alpha : {0., .25, .5, .75, .85, .95, .99}) {
        auto r =
            a::trust_rank_work(3, {{0, 1}, {1, 2}, {2, 0}}, {0}, alpha, 1e-10,
                               10000);
        std::print("|{}|{}|{}|\n", alpha, r.iterations, r.deltas.back());
        x.push_back(alpha);
        y.push_back(r.iterations);
    }
    auto p = g::RPlot::create();
    p.line(x, y, "actual", {37, 99, 235}, 2);
    p.points(x, y, "", {37, 99, 235}, 5);
    p.title("Weaker contraction requires more actual updates").x_label(
        "damping alpha").y_label("actual updates to tolerance");
    p.save_svg("build/trust_rank_work.svg");
}
```
