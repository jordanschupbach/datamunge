> Actual selected work and sensitivity

```{cpp, results="markdown", file="figures/subgraph_isomorphism_work.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <filesystem>
#include <print>
#include <algorithm>
#include <cmath>
#include <limits>
#include <numeric>
#include <numbers>
#include <random>
#include <string>
#include <vector>
#include <map>
#include <set>
#include <array>
#include <tuple>
#include <bit>
#include <datamunge/random/quality.hpp>
#include <datamunge/algorithms/subgraph_isomorphism.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    std::vector<std::vector<int>> p{{1, 2}, {0, 2}, {0, 1}};
    std::vector<double> x, y;
    std::print("| target cycle | actual candidate trials | actual backtracks | required edge tests |\n| " "---: | ---: | ---: | ---: |\n");
    for (int n : {4, 8, 16, 32, 64}) {
        auto t = a::subgraph_cycle_graph(n);
        auto r = a::subgraph_isomorphism_run(3, p, n, t);
        x.push_back(n);
        y.push_back(r.candidate_trials);
        std::print("| {} | {} | {} | {} |\n", n, r.candidate_trials,
                   r.backtracks, r.required_edge_tests);
    }
    auto plot = g::RPlot::create();
    plot.lines(x, y, "actual executed values", {37, 99, 235}).points(
        x, y, {37, 99, 235}, 4).title("Actual failed triangle search on longer cycles").x_label("target vertices").y_label("actual candidate trials");
    plot.save_svg("build/subgraph_isomorphism_work.svg");
}
```
