> Explicit controls

```{cpp, results="markdown", file="figures/subgraph_isomorphism_controls.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <filesystem>
#include <print>
#include <algorithm>
#include <cmath>
#include <limits>
#include <numeric>
#include <numbers>
#include <random>
#include <string>
#include <vector>
#include <map>
#include <set>
#include <array>
#include <tuple>
#include <bit>
#include <datamunge/random/quality.hpp>
#include <datamunge/algorithms/subgraph_isomorphism.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    std::vector<std::vector<int>> p{{1, 2}, {0, 2}, {0, 1}};
    std::vector<double> x, y;
    std::print("| target cycle size | triangle found | actual candidate trials | degree prunes | edge " "prunes |\n| ---: | --- | ---: | ---: | ---: |\n");
    for (int n = 3; n <= 10; ++n) {
        auto t = a::subgraph_cycle_graph(n);
        auto r = a::subgraph_isomorphism_run(3, p, n, t);
        x.push_back(n);
        y.push_back(r.candidate_trials);
        std::print("| {} | {} | {} | {} | {} |\n", n, r.match.found,
                   r.candidate_trials, r.degree_prunes, r.adjacency_prunes);
    }
    auto e = a::subgraph_isomorphism_run(0, {}, 0, {});
    std::print("Empty pattern success {}, empty mapping {}.\n", e.match.found,
               e.match.mapping.empty());
    auto plot = g::RPlot::create();
    plot.lines(x, y, "actual executed values", {37, 99, 235}).points(
        x, y, {37, 99, 235}, 4).title("Triangle succeeds only in the three-cycle control").x_label("target cycle vertices").y_label("actual candidate trials");
    plot.save_svg("build/subgraph_isomorphism_controls.svg");
}
```
