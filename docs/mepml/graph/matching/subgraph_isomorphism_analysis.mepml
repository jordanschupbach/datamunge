> The retained original experiment

```{cpp, results="markdown", file="figures/subgraph_isomorphism_original.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <filesystem>
#include <print>
#include <algorithm>
#include <cmath>
#include <limits>
#include <numeric>
#include <numbers>
#include <random>
#include <string>
#include <vector>
#include <map>
#include <set>
#include <array>
#include <tuple>
#include <bit>
#include <datamunge/random/quality.hpp>
#include <datamunge/algorithms/subgraph_isomorphism.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    std::vector<std::vector<int>> p{{1, 2}, {0, 2}, {0, 1, 3}, {2}}, t{
        {1}, {0, 2, 3, 4}, {1, 3, 4}, {1, 2, 4, 5}, {1, 2, 3}, {3}
    };
    auto r = a::subgraph_isomorphism_run(4, p, 6, t);
    std::print("Original triangle with pendant found {}; actual mapping `{}`.\n\n| target vertex | used by " "actual injection |\n| ---: | ---: |\n",
               r.match.found, r.match.mapping);
    std::vector<double> y;
    std::vector<std::string> labels;
    for (std::size_t i = 0; i < r.target_matched.size(); ++i) {
        y.push_back(r.target_matched[i] ? 1 : 0);
        labels.push_back(std::to_string(i));
        std::print("| {} | {} |\n", i, y.back());
    }
    auto chart =
        g::RPlot::barplot(y, labels, "actual selected target vertices",
                          {5, 150, 105});
    chart.title("Original target: vertices used by the actual first injection").x_label("target vertex").y_label("used0/1");
    chart.save_svg("build/subgraph_isomorphism_original.svg");
}
```
