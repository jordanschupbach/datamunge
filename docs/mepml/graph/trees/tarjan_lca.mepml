> The retained original experiment

```{cpp, results="markdown", file="figures/tarjan_lca_original.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    const std::vector<std::pair<std::size_t, std::size_t>> edges{{0, 1}, {0, 2},
                                                                 {1, 3}, {1, 4},
                                                                 {3, 6}, {2, 5},
                                                                 {5, 7}}, queries{{6, 7}, {3, 4}, {6, 4}, {5, 7}, {6, 1}, {4, 4}, {7, 2}};
    auto r = a::tarjan_lca_run(8, 0, edges, queries);
    std::print("| original query | actual lowest common ancestor |\n| --- | ---: |\n");
    for (std::size_t i = 0; i < queries.size(); ++i)
        std::print("| `{}` | {} |\n", queries[i], r.lca[i]);
    std::vector<double> px{3.5, 2, 5, 1, 3, 5, 1, 5}, py{3, 2, 2, 1, 1, 1, 0, 0}, ex0, ey0, ex1, ey1, qx0, qy0, qx1, qy1;
    for (auto[u, v] : edges) {
        ex0.push_back(px[u]);
        ey0.push_back(py[u]);
        ex1.push_back(px[v]);
        ey1.push_back(py[v]);
    }
    for (auto[u, v] : queries)
        if (u != v) {
            qx0.push_back(px[u]);
    qy0.push_back(py[u]);
    qx1.push_back(px[v]);
    qy1.push_back(py[v]);
        }
        auto chart = g::RPlot::create();
        chart.segments(ex0, ey0, ex1, ey1, {148, 163, 184}, 3).segments(
            qx0, qy0, qx1, qy1, {220, 38, 38}, 1).points(px, py, {37, 99, 235},
                                                         8);
        for (std::size_t i = 0; i < 8; ++i)
            chart.text(px[i] + .14, py[i] + .12, std::to_string(i),
                       {17, 24, 39}, 15);
        chart.title("Original eight-node rooted tree; red chords are actual queries").x_label("fixed tree layout").y_label("depth; root at top").xlim(.3, 5.7).ylim(-.5, 3.5).show_grid(false);
        chart.save_svg("build/tarjan_lca_original.svg");
}
```
