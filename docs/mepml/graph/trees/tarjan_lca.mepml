> Explicit controls

```{cpp, results="markdown", file="figures/tarjan_lca_controls.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    const std::vector<std::pair<std::size_t, std::size_t>> edges{{0, 1}, {0, 2},
                                                                 {1, 3}, {1, 4},
                                                                 {3, 6}, {2, 5},
                                                                 {5, 7}}, queries{{6, 7}, {3, 4}, {6, 4}, {5, 7}, {6, 1}, {4, 4}, {7, 2}};
    std::vector<double> x, y;
    std::print("| root | actual answers in original query order | actual unions | answer writes |\n| ---: | " "--- | ---: | ---: |\n");
    for (std::size_t root : {0, 1, 2, 7}) {
        auto r = a::tarjan_lca_run(8, root, edges, queries);
        x.push_back(root);
        y.push_back(r.answer_writes);
        std::print("| {} | `{}` | {} | {} |\n", root, r.lca, r.unions,
                   r.answer_writes);
    }
    auto plot = g::RPlot::create();
    plot.lines(x, y, "actual native values", {37, 99, 235}).points(
        x, y, {37, 99, 235}, 4).title("Rerooting changes ancestry, not complete query coverage").x_label("root vertex").y_label("actual answer writes including duplicate self query");
    plot.save_svg("build/tarjan_lca_controls.svg");
}
```
