> Actual selected work and sensitivity

```{cpp, results="markdown", file="figures/tarjan_lca_work.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    std::vector<double> x, y;
    std::print("| chain vertices | producing adjacency visits | queries inspected | unions | find calls | " "parent hops | validation adjacency visits |\n| ---: | ---: | ---: | ---: | ---: | ---: | " "---: |\n");
    for (std::size_t n : {1, 2, 8, 32, 128, 512, 2048}) {
        std::vector<std::pair<std::size_t, std::size_t>> edges, queries;
        for (std::size_t i = 1; i < n; ++i)
            edges.emplace_back(i - 1, i);
        for (std::size_t i = 0; i < n; ++i)
            queries.emplace_back(i, n - 1);
        auto r = a::tarjan_lca_run(n, 0, edges, queries);
        x.push_back(n);
        y.push_back(r.edge_visits + r.query_visits + r.parent_hops);
        std::print("| {} | {} | {} | {} | {} | {} | {} |\n", n, r.edge_visits,
                   r.query_visits, r.unions, r.find_calls, r.parent_hops,
                   r.preflight_edges);
    }
    auto plot = g::RPlot::create();
    plot.lines(x, y, "actual native values", {37, 99, 235}).points(
        x, y, {37, 99, 235}, 4).title("Actual iterative chain traversal and selected union-find work").x_label("chain vertices").y_label("actual edge/query inspections plus representative hops");
    plot.save_svg("build/tarjan_lca_work.svg");
}
```
