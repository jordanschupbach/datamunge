> A forest and stable ties

The disconnected control has two separate pairs, a negative loop and a reverse
parallel edge. It returns a minimum forest with connected=false, not a failed
empty tree. Two equal-weight triangles illustrate another limit: permuting tied
input edges can change which optimum tree is selected while preserving the
optimum total.

```{cpp, results="markdown", file="figures/kruskal_controls.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
    std::filesystem::create_directories("build");
    const auto forest =
        dm::algorithms::kruskal_trace(4,
                                      {{0, 0, -10}, {0, 1, -2}, {1, 0, -2},
                                       {2, 3, 3}});
    std::print("| actual forest scan | input identity | accepted | components after |\n| ---: | ---: | --- " "| ---: |\n");
    std::vector<double> x, y;
    for (std::size_t i = 0; i < forest.steps.size(); ++i) {
        const auto &e = forest.steps[i];
        std::print("| {} | {} | {} | {} |\n", i, e.input_index, e.accepted,
                   e.components_after);
        x.push_back(i);
        y.push_back(e.components_after);
    }
    std::print("\nActual forest total {:.1f}; connected {}; accepted edges {}.\n",
               forest.outcome.result.total_weight,
               forest.outcome.result.is_connected,
               forest.outcome.result.edges.size());
    std::print("\n| tied input ordering | actual selected edge u | actual selected edge v | actual total " "|\n| --- | ---: | ---: | ---: |\n");
    const std::vector<std::vector<dm::algorithms::WeightedEdge>> cases = {
        {{0, 1, 1}, {1, 2, 1}, {0, 2, 1}}, {{0, 2, 1}, {1, 2, 1}, {0, 1, 1}}
    };
    for (std::size_t i = 0; i < cases.size(); ++i) {
        const auto r = dm::algorithms::kruskal(3, cases[i]);
        for (auto[u, v, w] : r.edges)
            std::print("| {} | {} | {} | {:.1f} |\n", i, u, v, r.total_weight);
    }
    auto p = dm::graphics::RPlot::create();
    p.line(x, y, "components", {37, 99, 235}, 2).points(x, y, "", {37, 99, 235},
                                                        5).y_limits(0, 5).title(
        "Actual disconnected forest component counts").x_label(
        "actual scan ordinal").y_label("components after decision").save_svg(
        "build/kruskal_controls.svg");
}
```
