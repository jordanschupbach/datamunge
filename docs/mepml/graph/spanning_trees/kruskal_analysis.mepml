> Original six vertices and nine edges

Retain every original tuple and drawing coordinate. All nine weights are
distinct, so the connected graph has a unique minimum spanning tree. The actual
selected total is independently checked against every five-edge spanning subset,
rather than inferred from the figure’s geometry. Coordinates are for drawing
only; they do not determine edge weights.

```{cpp, results="markdown", file="figures/kruskal_original.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
    std::filesystem::create_directories("build");
    const std::vector<dm::algorithms::WeightedEdge> edges = {{0, 1, 7},
                                                             {0, 3, 5},
                                                             {1, 2, 8},
                                                             {1, 3, 9},
                                                             {1, 4, 6},
                                                             {2, 4, 10},
                                                             {2, 5, 4},
                                                             {3, 4, 3},
                                                             {4, 5, 2}};
    const std::vector<double> x = {0, 2, 4, 1, 3, 5}, y = {2, 3, 2.5, .5, .5, 1};
    const auto t = dm::algorithms::kruskal_trace(6, edges);
    std::print("| actual selected ordinal | original endpoint u | original endpoint v | actual weight |\n| " "---: | ---: | ---: | ---: |\n");
    for (std::size_t i = 0; i < t.outcome.result.edges.size(); ++i) {
        auto[u, v, w] = t.outcome.result.edges[i];
        std::print("| {} | {} | {} | {:.1f} |\n", i, u, v, w);
    }
    std::print("\nActual total {:.1f}; connected {}; input edges {}; actual scanned {}; root searches {}.\n",
               t.outcome.result.total_weight, t.outcome.result.is_connected,
               t.outcome.work.input_edges, t.outcome.work.scanned_edges,
               t.outcome.work.find_calls);
    auto p = dm::graphics::RPlot::create();
    for (auto[u, v, w] : edges)
        p.line({x[u], x[v]}, {y[u], y[v]}, "", {203, 213, 225}, 1);
    for (auto[u, v, w] : t.outcome.result.edges)
        p.line({x[u], x[v]}, {y[u], y[v]}, "", {37, 99, 235}, 4);
    p.points(x, y, "vertices", {30, 41, 59}, 10);
    for (std::size_t i = 0; i < x.size(); ++i)
        p.text(x[i] + .15, y[i] + .16, std::to_string(i), {17, 24, 39}, 15);
    p.size(850, 850).margins(95, 35, 60, 70).x_limits(-1, 6).y_limits(-1, 6).title("Original graph and actual minimum tree").x_label("drawing x").y_label("drawing y").save_svg("build/kruskal_original.svg");
}
```
