> Handle cycles, isolates and arithmetic failures

A zero-total cycle is allowed. A negative cycle anywhere returns
has_negative_cycle=true and an all-infinity matrix, including the diagonal;
these infinities are an invalid-problem convention rather than unreachable-path
answers. No Dijkstra search starts in that case. The control figure plots the
actual decreasing target potential after each check of the two-edge negative
cycle. The nth pass is detection evidence in exact arithmetic, not a request to
continue optimizing an unbounded objective.

```{cpp, results="markdown", file="figures/johnson_controls.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
    std::filesystem::create_directories("build");
    using E = dm::algorithms::WeightedEdge;
    const std::vector<std::pair<const char *, std::pair<std::size_t, std::vector<E>> >> cases = {{"empty", {0, {}}}, {"four isolates", {4, {}}}, {"disconnected negative cycle", {4, {{2, 3, -1}, {3, 2, -1}}}}, {"zero cycle", {2, {{0, 1, 0}, {1, 0, 0}, {0, 0, 0}}}}, {"parallel edges", {2, {{0, 1, 8}, {0, 1, 3}, {0, 1, 3}}}}, {"negative cycle", {2, {{0, 1, -1}, {1, 0, -1}}}}};
    std::print("| control | n | negative cycle | potential passes | BF checks | Dijkstra checks | restored " "cells |\n| --- | ---: | --- | ---: | ---: | ---: | ---: |\n");
    for (const auto & [name, input] : cases) {
        const auto a =
            dm::algorithms::johnson_analyze(input.first, input.second);
        const auto &w = a.work;
        std::print("| {} | {} | {} | {} | {} | {} | {} |\n", name, input.first,
                   a.result.has_negative_cycle, w.potential_passes,
                   w.potential_checks, w.dijkstra_checks, w.restored_cells);
    }
    const auto original =
        dm::algorithms::johnson_trace(3, dm::algorithms::johnson_demo_edges());
    bool event_cap =
        false, cells_cap = false, invalid = false, overflow = false;
    try {
        (void) dm::algorithms::johnson_trace(3, original.edges,
                                             {6, 9, original.events.size() - 1});
    } catch (const std::length_error &) {
        event_cap = true;
    }
    try {
        (void) dm::algorithms::johnson_analyze(3, original.edges, {6, 8, 0});
    } catch (const std::length_error &) {
        cells_cap = true;
    }
    try {
        (void) dm::algorithms::johnson_analyze(2, {{0, 2, 1}});
    } catch (const std::invalid_argument &) {
        invalid = true;
    }
    const double m = std::numeric_limits<double>::max();
    try {
        (void) dm::algorithms::johnson_analyze(3, {{0, 1, m}, {1, 2, m}});
    } catch (const std::overflow_error &) {
        overflow = true;
    }
    const bool cycle_fixed =
        dm::algorithms::johnson_analyze(3, {{0, 1, -m}, {1, 0, -m}}).result.has_negative_cycle;
    if (!event_cap || !cells_cap || !invalid || !overflow || !cycle_fixed)
        throw std::runtime_error("controls");
    std::print("\nOne-short event and matrix limits reject; invalid endpoint rejects; finite distance " "overflow rejects; the extreme negative cycle is detected.\n");
    const auto t = dm::algorithms::johnson_trace(2, {{0, 1, -1}, {1, 0, -1}});
    std::vector<double> x, y;
    for (const auto &e : t.events)
        if (e.action == dm::algorithms::JohnsonAction::Potential) {
            x.push_back(x.size() + 1);
    y.push_back(e.after);
        }
        auto p = dm::graphics::RPlot::create();
        p.line(x, y, "", {220, 38, 38}, 2).points(x, y, "", {220, 38, 38}, 5).title("Negative cycle: actual target potential after each check").x_label("potential edge check").y_label("updated target potential").y_limits(-4.5, 0).save_svg("build/johnson_controls.svg");
}
```
