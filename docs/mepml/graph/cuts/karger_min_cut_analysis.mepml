> Count loops and parallel edges correctly

Self-loops never cross a partition. Every parallel record crossing the sides
counts once. Isolated vertices belong to the original vertex set and can yield a
nontrivial zero cut. For reproducibility, side A is the actual component
containing vertex0, both sides are sorted, and equal best cuts retain the first
trial's partition. A returned partition is always nonempty on both sides for n
at least two.

```{cpp, results="markdown", file="figures/karger_controls.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
    std::filesystem::create_directories("build");
    std::print("| control | cut | side A size | side B size |\n| --- | ---: | ---: | ---: |\n");
    const auto show =
        [](const char *name, std::size_t n,
           const std::vector<std::pair<std::size_t, std::size_t>> & e) {
        const auto r = dm::algorithms::karger_min_cut(n, e, 16, 7);
        std::print("| {} | {} | {} | {} |\n", name, r.cut_size, r.side_a.size(),
                   r.side_b.size());
    };
    show("parallel plus loops", 2, {{0, 0}, {0, 1}, {0, 1}, {1, 1}});
    show("all isolates", 3, {});
    show("disconnected", 5, {{0, 1}, {1, 2}, {2, 0}, {3, 4}});
    bool cap = false, invalid = false;
    try {
        (void) dm::algorithms::karger_trace(2, {{0, 1}}, 1, 7, {3, 1, 2});
    } catch (const std::length_error &) {
        cap = true;
    }
    try {
        (void) dm::algorithms::karger_min_cut(2, {{0, 2}}, 1);
    } catch (const std::invalid_argument &) {
        invalid = true;
    }
    if (!cap || !invalid)
        throw std::runtime_error("admission guards");
    std::print("\nOne-short history admission and an invalid endpoint reject.\n");
    const auto t =
        dm::algorithms::karger_trace(4, {{0, 1}, {1, 2}, {2, 0}, {2, 3}}, 100, 7);
    std::vector<double> x, y, best;
    std::size_t running = 99;
    for (std::size_t i = 0; i < t.trials.size(); ++i) {
        running = std::min(running, t.trials[i].cut_size);
        x.push_back(i);
        y.push_back(t.trials[i].cut_size);
        best.push_back(running);
    }
    auto p = dm::graphics::RPlot::create();
    p.points(x, y, "trial", {120, 120, 120}, 3).line(x, best, "best",
                                                     {220, 38, 38}, 2).title(
        "Every actual trial and retained best cut").x_label("trial ordinal").y_label("original crossing-edge count").y_limits(.5, 5).save_svg("build/karger_controls.svg");
}
```
