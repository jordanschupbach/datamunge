> The retained original experiment

```{cpp, results="markdown", file="figures/tarjan_scc_original.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    const std::vector<std::vector<int>> adj{{1}, {2}, {0, 3}, {4}, {5}, {3, 6},
                                            {7}, {}};
    auto r = a::tarjan_scc_run(8, adj);
    auto other = a::kosaraju_scc(8, adj);
    bool same = true;
    for (std::size_t i = 0; i < 8; ++i)
        for (std::size_t j = 0; j < 8; ++j)
            same &=
                (r.components[i] == r.components[j]) == (other[i] == other[j]);
    std::print("Original8-vertex graph actual IDs `{}`; Kosaraju partition agrees {}.\n\n| actual component " "| original members |\n| ---: | --- |\n",
               r.components, same);
    std::vector<double> sizes;
    std::vector<std::string> labels;
    for (std::size_t c = 0; c < r.component_count; ++c) {
        std::vector<int> members;
        for (int v = 0; v < 8; ++v)
            if (r.components[v] == int(c))
                members.push_back(v);
        std::print("| {} | `{}` |\n", c, members);
        labels.push_back(std::to_string(c));
        sizes.push_back(members.size());
    }
    auto chart =
        g::RPlot::barplot(sizes, labels, "actual SCC sizes", {37, 99, 235});
    chart.title("Original graph: actual Tarjan pop-order components").x_label(
        "actual component ID").y_label("vertices");
    chart.save_svg("build/tarjan_scc_original.svg");
}
```
// result_begin: markdown
Original8-vertex graph actual IDs `[3, 3, 3, 2, 2, 2, 1, 0]`; Kosaraju partition agrees true.

| actual component | original members |
| ---: | --- |
| 0 | `[7]` |
| 1 | `[6]` |
| 2 | `[3, 4, 5]` |
| 3 | `[0, 1, 2]` |
\image(figures/tarjan_scc_original.svg)
