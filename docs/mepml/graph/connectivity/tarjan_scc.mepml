> Actual selected work and sensitivity

```{cpp, results="markdown", file="figures/tarjan_scc_work.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    std::vector<double> x, y;
    std::print("| directed cycle vertices | actual discoveries | edge visits | peak explicit frames |\n| " "---: | ---: | ---: | ---: |\n");
    for (int n : {1, 2, 4, 16, 64, 256, 1024}) {
        std::vector<std::vector<int>> adj(n);
        for (int i = 0; i < n; ++i)
            adj[i].push_back((i + 1) % n);
        auto r = a::tarjan_scc_run(n, adj);
        x.push_back(n);
        y.push_back(r.edge_visits + r.discoveries);
        std::print("| {} | {} | {} | {} |\n", n, r.discoveries, r.edge_visits,
                   r.peak_frames);
    }
    auto plot = g::RPlot::create();
    plot.lines(x, y, "actual native values", {37, 99, 235}).points(
        x, y, {37, 99, 235}, 4).title("Actual cycle traversal discovers vertices and scans edges once").x_label("vertices in directed cycle").y_label("actual discoveries plus edge visits");
    plot.save_svg("build/tarjan_scc_work.svg");
}
```
