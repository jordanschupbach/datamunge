> Explicit controls

```{cpp, results="markdown", file="figures/tarjan_scc_controls.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    std::vector<std::vector<std::vector<int>> > graphs{{}, {{}}, {{0}},
                                                       {{1}, {}}, {{1}, {0}},
                                                       {{1, 1}, {0}}};
    std::vector<double> x, y;
    std::print("| control | vertices | actual SCCs | actual edge visits |\n| ---: | ---: | ---: | ---: |\n");
    for (std::size_t i = 0; i < graphs.size(); ++i) {
        auto r = a::tarjan_scc_run(int(graphs[i].size()), graphs[i]);
        x.push_back(i);
        y.push_back(r.component_count);
        std::print("| {} | {} | {} | {} |\n", i, graphs[i].size(),
                   r.component_count, r.edge_visits);
    }
    auto plot = g::RPlot::create();
    plot.lines(x, y, "actual native values", {37, 99, 235}).points(
        x, y, {37, 99, 235}, 4).title("Empty, isolated, loop, chain, cycle and duplicate controls").x_label("control index").y_label("actual component count");
    plot.save_svg("build/tarjan_scc_controls.svg");
}
```
