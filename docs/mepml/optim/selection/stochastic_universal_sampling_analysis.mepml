> Actual selected work and sensitivity

```{cpp, results="markdown", file="figures/stochastic_universal_sampling_work.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <filesystem>
#include <print>
#include <algorithm>
#include <cmath>
#include <limits>
#include <numeric>
#include <numbers>
#include <random>
#include <string>
#include <vector>
#include <map>
#include <set>
#include <array>
#include <tuple>
#include <bit>
#include <datamunge/random/quality.hpp>
#include <datamunge/algorithms/stochastic_universal_sampling.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    std::vector<double> x, y;
    std::print("| slots | actual RNG words | actual bucket advances | selected indices |\n| ---: | ---: | " "---: | ---: |\n");
    for (int n : {0, 1, 10, 100, 1000, 10000}) {
        auto r = a::sus_run({1, 2, 3, 4, 5, 6}, n, 3);
        x.push_back(n);
        y.push_back(r.indices.size() + r.boundary_advances);
        std::print("| {} | {} | {} | {} |\n", n, r.random_words,
                   r.boundary_advances, r.indices.size());
    }
    auto plot = g::RPlot::create();
    plot.lines(x, y, "actual executed values", {37, 99, 235}).points(
        x, y, {37, 99, 235}, 4).title("Actual pointer events plus forward bucket advances").x_label("requested slots").y_label("selected event count");
    plot.save_svg("build/stochastic_universal_sampling_work.svg");
}
```
