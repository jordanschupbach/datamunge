> The retained original experiment

```{cpp, results="markdown", file="figures/stochastic_universal_sampling_original.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <filesystem>
#include <print>
#include <algorithm>
#include <cmath>
#include <limits>
#include <numeric>
#include <numbers>
#include <random>
#include <string>
#include <vector>
#include <map>
#include <set>
#include <array>
#include <tuple>
#include <bit>
#include <datamunge/random/quality.hpp>
#include <datamunge/algorithms/stochastic_universal_sampling.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    auto r = a::sus_run({1, 2, 3, 4, 5, 6}, 1000, 3);
    std::vector<double> x, y;
    std::print("| original row | weight | actual count | ideal expected |\n| ---: | ---: | ---: | ---: |\n");
    for (std::size_t i = 0; i < 6; ++i) {
        x.push_back(i + 1);
        y.push_back(r.counts[i]);
        std::print("| {} | {} | {} | {:.9g} |\n", i, i + 1, r.counts[i],
                   (double) r.expected[i]);
    }
    std::print("Actual raw RNG words {}, bucket advances {}.\n", r.random_words,
               r.boundary_advances);
    auto plot = g::RPlot::create();
    plot.lines(x, y, "actual executed values", {37, 99, 235}).points(
        x, y, {37, 99, 235}, 4).title("Original1000 parent slots, weights1..6, seed3").x_label("weight").y_label("actual selected count");
    plot.save_svg("build/stochastic_universal_sampling_original.svg");
}
```
