> Explicit controls

```{cpp, results="markdown", file="figures/stochastic_universal_sampling_controls.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <filesystem>
#include <print>
#include <algorithm>
#include <cmath>
#include <limits>
#include <numeric>
#include <numbers>
#include <random>
#include <string>
#include <vector>
#include <map>
#include <set>
#include <array>
#include <tuple>
#include <bit>
#include <datamunge/random/quality.hpp>
#include <datamunge/algorithms/stochastic_universal_sampling.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    std::vector<double> x, y;
    std::print("| seed | zero-mass row | positive rows actual counts | actual RNG words |\n| ---: | ---: | " "--- | ---: |\n");
    for (unsigned seed = 0; seed < 12; ++seed) {
        auto r = a::sus_run({0, 1, 2, 0}, 7, seed);
        x.push_back(seed);
        y.push_back(r.counts[1]);
        std::print("| {} | {} | `{}` | {} |\n", seed, r.counts[0] + r.counts[3],
                   r.counts, r.random_words);
    }
    auto z = a::sus_run({0, 0}, 0, 3);
    std::print("Zero picks: {} draws, counts `{}`.\n", z.random_words, z.counts);
    auto plot = g::RPlot::create();
    plot.lines(x, y, "actual executed values", {37, 99, 235}).points(
        x, y, {37, 99, 235}, 4).title("Actual fractional allocation varies with the offset").x_label("local seed").y_label("count assigned to weight1");
    plot.save_svg("build/stochastic_universal_sampling_controls.svg");
}
```
