> The retained original experiment

```{cpp, results="markdown", file="figures/tournament_selection_original.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <filesystem>
#include <print>
#include <algorithm>
#include <cmath>
#include <limits>
#include <numeric>
#include <numbers>
#include <random>
#include <string>
#include <vector>
#include <map>
#include <set>
#include <array>
#include <tuple>
#include <bit>
#include <datamunge/random/quality.hpp>
#include <datamunge/algorithms/tournament_selection.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    const std::vector<double> fitness{1, 2, 3, 4, 5, 6, 7, 8};
    constexpr int N = 200000;
    std::vector<double> x;
    for (int i = 0; i < 8; ++i)
        x.push_back(i + 1);
    auto chart = g::RPlot::create();
    const std::array<int, 4> sizes{1, 2, 4, 8};
    const std::array<g::RGB, 4> colors{{{148, 163, 184}, {37, 99, 235},
                                        {5, 150, 105}, {124, 58, 237}}};
    std::print("| original k | actual best count /200000 | empirical best fraction | ideal uniform best " "probability | actual draws |\n| ---: | ---: | ---: | ---: | ---: |\n");
    for (std::size_t j = 0; j < sizes.size(); ++j) {
        auto r = a::tournament_run(fitness, N, sizes[j], 1);
        std::vector<double> prob;
        for (auto count : r.counts)
            prob.push_back(double(count) / N);
        chart.lines(x, prob, std::format("actual k{}", sizes[j]), colors[j]);
        std::print("| {} | {} | {:.9g} | {:.9g} | {} |\n", sizes[j],
                   r.counts.back(), prob.back(), 1 - std::pow(7. / 8, sizes[j]),
                   r.random_words);
    }
    chart.title("Original200000 parents, seed1: actual winner frequencies").x_label("ascending fitness1..8").y_label("actual winner fraction");
    chart.save_svg("build/tournament_selection_original.svg");
}
```
