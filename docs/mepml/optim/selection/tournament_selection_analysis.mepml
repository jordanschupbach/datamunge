> Explicit controls

```{cpp, results="markdown", file="figures/tournament_selection_controls.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <filesystem>
#include <print>
#include <algorithm>
#include <cmath>
#include <limits>
#include <numeric>
#include <numbers>
#include <random>
#include <string>
#include <vector>
#include <map>
#include <set>
#include <array>
#include <tuple>
#include <bit>
#include <datamunge/random/quality.hpp>
#include <datamunge/algorithms/tournament_selection.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    std::vector<double> x, y;
    std::print("| k | actual first-row winners under equal fitness | actual final-row winners | selected " "comparisons |\n| ---: | ---: | ---: | ---: |\n");
    for (int k : {1, 2, 4, 8, 16}) {
        auto r = a::tournament_run({2, 2, 2, 2}, 10000, k, 1);
        x.push_back(k);
        y.push_back(double(r.counts[0]) / 10000);
        std::print("| {} | {} | {} | {} |\n", k, r.counts[0], r.counts.back(),
                   r.comparisons);
    }
    auto plot = g::RPlot::create();
    plot.lines(x, y, "actual native values", {37, 99, 235}).points(
        x, y, {37, 99, 235}, 4).title("Equal-fitness ties retain the actual first sampled contender").x_label("contestants per parent").y_label("actual first-row winner fraction");
    plot.save_svg("build/tournament_selection_controls.svg");
}
```
