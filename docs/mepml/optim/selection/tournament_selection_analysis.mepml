> Actual selected work and sensitivity

```{cpp, results="markdown", file="figures/tournament_selection_work.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <filesystem>
#include <print>
#include <algorithm>
#include <cmath>
#include <limits>
#include <numeric>
#include <numbers>
#include <random>
#include <string>
#include <vector>
#include <map>
#include <set>
#include <array>
#include <tuple>
#include <bit>
#include <datamunge/random/quality.hpp>
#include <datamunge/algorithms/tournament_selection.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    std::vector<double> x, y;
    std::print("| k | actual draws | actual strict comparisons |\n| ---: | ---: | ---: |\n");
    for (int k : {1, 2, 4, 8, 16, 32, 64}) {
        auto r = a::tournament_run({1, 2, 3, 4, 5, 6, 7, 8}, 1000, k, 1);
        x.push_back(k);
        y.push_back(r.random_words);
        std::print("| {} | {} | {} |\n", k, r.random_words, r.comparisons);
    }
    auto plot = g::RPlot::create();
    plot.lines(x, y, "actual native values", {37, 99, 235}).points(
        x, y, {37, 99, 235}, 4).title("Actual selected work scales with contestants per parent").x_label("k for1000 parent slots").y_label("actual raw draws");
    plot.save_svg("build/tournament_selection_work.svg");
}
