//? Title: GRASP for MAX-CUT: construct, flip, retain the best
//? Subtitle: Actual RCL choices, immediate local moves and one-run restart prefixes
//? Exports: both
//? Lang: en-GB

\abstract(
Split a weighted graph's vertices into two sides to maximize the weight crossing
between them. Greedy placement can miss useful configurations, and a partition
that resists every single-vertex flip can still be globally poor. This report
follows actual greedy-randomized construction and cyclic local improvement, then
retains the best completed restart. A three-vertex example shows one improving
flip, a four-cycle proves the gap between local and global optimality, and the
original fourteen-vertex graph supplies an exhaustively checked reference.
Actual histories replace repeated prefix reruns, while seed, tolerance,
validation and resource policies bound what the results mean.
)

\toc

> One actual improving flip

Use a triangle with weights w₀₁=1, w₀₂=2 and w₁₂=3. With alpha one and seed
three, the native construction places sides (0,1,0), cutting weights one and
three for value four. Its first local test flips vertex zero, changing the sides
to (1,1,0). Edge 01 leaves the cut and edge 02 enters: the actual gain is
−1+2=1, and the resulting cut has value five. A triangle cannot cut all three
edges; isolating each vertex gives values three, four and five, so five is also
the optimum.

```{cpp, results="markdown", file="figures/grasp_tiny.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
    std::filesystem::create_directories("build");

    const dm::algorithms::GraspAdjacency adj{{{1, 1}, {2, 2}}, {{0, 1}, {2, 3}},
                                             {{0, 2}, {1, 3}}};
    const auto t = dm::algorithms::grasp_max_cut_trace(3, adj, 1, 1, 3);
    const auto &restart = t.restarts.at(0);
    std::print("| step | candidate | gain side 0 | gain side 1 | in RCL | chosen | threshold |\n| ---: | " "---: | ---: | ---: | --- | --- | ---: |\n");
    for (const auto &s : t.construction)
        for (std::size_t i = 0; i < s.candidates.size(); ++i) {
            const auto &c = s.candidates[i];
    std::print("| {} | {} | {} | {} | {} | {} | {} |\n", s.step, c.vertex,
               c.gain0, c.gain1, c.in_rcl, i == s.pick, s.threshold);
        }
        std::print("\n| pass | vertex | before side | computed gain | accepted |\n| ---: | ---: | ---: | ---: | " "--- |\n");
        for (const auto &f : t.flips)
            std::print("| {} | {} | {} | {} | {} |\n", f.pass, f.vertex,
                       f.before_side, f.delta, f.accepted);
        const double constructed =
            dm::algorithms::grasp_cut_check(adj, restart.constructed_side).value;
        std::print("\nConstructed objective {} (separate check); producing final objective {}; accepted flips " "{}.\n",
                   constructed, restart.final_value, t.run.work.accepted_flips);
        dm::graphics::Diagram d(75, 1100);
        dm::graphics::DiagramNodeStyle style;
        style.circle = true;
        style.width = 1;
        style.height = 1;
        style.font_size = 21;
        const std::vector<dm::graphics::DiagramPoint> positions{{0, 0}, {3, 0},
                                                                {1.5, 2.6}};
        for (int phase = 0; phase < 2; ++phase) {
            const auto &side =
                phase ? restart.final_side : restart.constructed_side;
            const double offset = phase ? 7. : 0.;
            for (int v = 0; v < 3; ++v) {
                style.fill =
                    side[v] ? dm::graphics::RGB{191, 219, 254}
                    : dm::graphics::RGB{254, 202, 202};
                d.node(std::format("{}-{}", phase, v),
                       {positions[v].x + offset, positions[v].y},
                       std::format("v{}\ns{}", v, side[v]), style);
            }
            for (int u = 0; u < 3; ++u)
                for (auto[v, w] : adj[u])
                    if (u < v)
                        d.link(std::format("{}-{}", phase, u),
                               std::format("{}-{}", phase, v),
                               std::format("w={}", w));
            d.text({1.5 + offset, 4},
                   std::format("{}: cut {}",
                               phase ? "After local scan" : "Constructed",
                               phase ? restart.final_value : constructed), 24);
        }
        d.text({5, -1.5},
               std::format("Actual v0 flip: gain {}; final value {}",
                           t.flips[0].delta, restart.final_value), 24).save_svg(
            "build/grasp_tiny.svg");
        if (restart.constructed_side != std::vector<int>{0, 1, 0} ||
            restart.final_side != std::vector<int>{1, 1, 0} ||
            restart.final_value != 5)
            throw std::runtime_error("tiny actual phases");
}
