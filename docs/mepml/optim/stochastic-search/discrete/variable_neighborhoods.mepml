//? Title: Variable and iterated neighborhood search
//? Exports: both
//? Lang: en-GB

> Variable neighborhood descent

The descent scans 2-opt and 3-opt neighborhoods until no scanned move
improves the tour. After an improvement it restarts from the first
neighborhood. The native API can also shuffle the neighborhood order.

> Basic and reduced variable neighborhood search

The basic algorithm shakes the tour and then descends from the perturbed
tour. Reduced VNS scores the perturbed tour directly. Either search advances
to the next shaking neighborhood when a trial fails, and returns to the
first after an improvement. See
[Hansen and Mladenović|https://doi.org/10.1016/S0377-2217(00)00100-4].

> Iterated local search

A 3-opt perturbation alternates with local descent. The outer search retains
one locally improved tour, while the reported incumbent is the best trial
ever scored. Updates counts both local improvements and accepted outer moves.
See [Lourenço, Martin and Stützle|https://doi.org/10.1007/978-3-319-91086-4_5].

> Tour benchmark

The same eight workbench cities are used for every setting. Enumerating every
tour with city zero fixed gives an exact reference length outside the search
budget. Each setting uses seeds 1, 7, 42 and 123 with a cap of 192 scored tours.
The figure averages percentage gaps across the four seeds and carries forward
the last observation when a search exhausts its neighborhood.

```{cpp, id=variable-neighborhoods, cache=yes, results="markdown", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

#include <array>
#include <cmath>
#include <filesystem>
#include <limits>
#include <numeric>
#include <print>
#include <random>
#include <stdexcept>
#include <variant>

namespace o = dm::optim;
using Tour = std::vector<std::size_t>;
constexpr std::size_t budget = 192;
constexpr std::array<std::uint64_t, 4> seeds{1, 7, 42, 123};
constexpr std::array<std::array<double, 2>, 8> cities{{
    {0, 0}, {2, 1}, {5, 0}, {7, 2}, {6, 6}, {3, 4}, {1, 7}, {0, 3},
}};

double length(const std::vector<std::vector<double>>& edges, const Tour& tour) {
    double sum = 0;
    for (std::size_t i = 0; i < tour.size(); ++i) sum += edges[tour[i]][tour[(i + 1) % tour.size()]];
    return sum;
}

int main() {
    std::vector edges(cities.size(), std::vector<double>(cities.size()));
    for (std::size_t i = 0; i < cities.size(); ++i) {
        for (std::size_t j = 0; j < i; ++j) {
            edges[i][j] = edges[j][i] = std::hypot(cities[i][0] - cities[j][0], cities[i][1] - cities[j][1]);
        }
    }
    Tour order(cities.size());
    std::iota(order.begin(), order.end(), 0);
    double optimum = std::numeric_limits<double>::infinity();
    do {
        optimum = std::min(optimum, length(edges, order));
    } while (std::next_permutation(order.begin() + 1, order.end()));
    std::print("The exact optimum is {:.8f}. All seeds follow.\n\n", optimum);
    std::print("| Setting | Seed | Calls | Final gap (%) | Updates |\n"
               "| --- | ---: | ---: | ---: | ---: |\n");
    auto plot = dm::graphics::RPlot::create();
    std::vector<dm::graphics::RGBA> colors{{30,99,168}, {205,99,31}, {45,138,83},
                                          {137,72,155}, {155,99,55}, {71,125,132}};

    const std::vector<std::string> labels{"Descent", "Basic VNS", "Reduced VNS", "Iterated local search"};
    using Move = std::variant<o::TwoOptMove, o::ThreeOptMove>;
    const auto shake = [](const Tour& t, std::size_t k, auto& rng) -> std::optional<Move> {
        if (k == 0) return *o::sample_two_opt(t.size(), rng);
        return *o::sample_three_opt(t.size(), rng);
    };
    const auto apply = [](Tour& t, const Move& move) {
        std::visit([&](const auto& m) {
            if constexpr (std::is_same_v<std::decay_t<decltype(m)>, o::TwoOptMove>) o::apply_two_opt(t, m);
            else o::apply_three_opt(t, m);
        }, move);
    };
    const auto enumerate = [](const Tour& t, std::size_t k, auto&) {
        std::vector<Move> moves;
        for (std::size_t a = 1; a <= t.size(); ++a) {
            for (std::size_t b = a + 2; b <= t.size() && b - a <= t.size() - 2; ++b) {
                if (k == 0) {
                    moves.emplace_back(o::TwoOptMove{a, b});
                    continue;
                }
                for (std::size_t c = b + 2; c <= t.size() && c - a <= t.size() - 2; ++c) {
                    for (const auto pattern : {o::ThreeOptPattern::reverse_both, o::ThreeOptPattern::exchange,
                                               o::ThreeOptPattern::exchange_first, o::ThreeOptPattern::exchange_second}) {
                        moves.emplace_back(o::ThreeOptMove{a, b, c, pattern});
                    }
                }
            }
        }
        return moves;
    };

    for (std::size_t setting = 0; setting < labels.size(); ++setting) {
        std::vector<double> steps, means(budget);
        for (const auto seed : seeds) {
            std::mt19937_64 start_rng(seed);
            auto initial = order;
            std::shuffle(initial.begin() + 1, initial.end(), start_rng);
            std::vector<double> best;
            const auto score = [&](const Tour& tour) {
                const double value = length(edges, tour);
                best.push_back(best.empty() ? value : std::min(value, best.back()));
                return value;
            };

            const o::VariableNeighborhoodOptions options{budget, seed, 2, false};
            const std::array methods{o::VariableNeighborhoodMethod::descent,
                                     o::VariableNeighborhoodMethod::basic,
                                     o::VariableNeighborhoodMethod::reduced};
            const auto perturb = [&](const Tour& t, auto& rng) { return shake(t, 1, rng); };
            const auto result = setting == 3
                ? o::iterated_local_search(initial, score, enumerate, perturb, apply, options)
                : o::variable_neighborhood_search(initial, score, enumerate, shake, apply, methods[setting], options);
            const auto updates = result.accepted;
            if (result.evaluations != best.size() || result.evaluations > budget ||
                std::abs(result.value - length(edges, result.best)) > 1e-10 ||
                std::abs(result.value - best.back()) > 1e-10 || result.value < optimum - 1e-10) {
                throw std::runtime_error("Inconsistent discrete search result");
            }
            for (std::size_t i = 0; i < budget; ++i) {
                means[i] += 100 * (best[std::min(i, best.size()-1)] / optimum - 1) / seeds.size();
            }
            std::print("| {} | {} | {} | {:.5f} | {} |\n", labels[setting], seed,
                       result.evaluations, 100*(result.value/optimum-1), updates);
        }
        for (std::size_t i = 0; i < budget; ++i) steps.push_back(i + 1);
        plot.line(steps, means, labels[setting], colors[setting]);
    }

    colors.resize(labels.size());
    plot.title("Eight-city symmetric tour").x_label("Tour evaluations")
        .y_label("Mean incumbent gap (%)").legend(labels, colors).size(850, 480);
    std::filesystem::create_directories("build");
    const auto file = "build/variable_neighborhoods.svg";
    plot.save_svg(file);
    std::filesystem::create_directories("figures");
    std::filesystem::copy_file(file, "figures/variable_neighborhoods.svg", std::filesystem::copy_options::overwrite_existing);
}
```
