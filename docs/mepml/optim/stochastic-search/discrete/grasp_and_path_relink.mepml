//? Title: GRASP, reactive construction and forward path relinking
//? Exports: both
//? Lang: en-GB

> Restricted candidate lists

The construction phase appends an unvisited city. A restricted list keeps
moves whose edge length is within an interpolation of the best and worst
remaining edges, and the algorithm samples that list uniformly.
Each complete tour receives 2-opt descent.

> Reactive GRASP

The reactive setting selects among four interpolation controls. It gives
more probability to controls with lower historical mean post-descent cost.
The baseline uses a fixed interpolation control.

> Forward path relinking

After local descent, the new tour is linked toward the previous best tour.
A swap into a matching position reduces Hamming distance to the guide.
Among scored forward swaps, the algorithm follows the best. Intermediate
tours can become incumbents. The common budget charges their evaluations
alongside construction and descent. Updates counts constructed tours.

> Scatter search

The reference set keeps its lowest-cost tours and fills its other slots
with tours far from the selected ones. Forward paths combine each pair.
A new batch of random tours diversifies the next iteration. For scatter
search, Updates counts selected forward path steps.

See [Glover, Laguna and Martí|https://www.sciencedirect.com/science/article/pii/S0377221704005430]
and [Resende and Ribeiro|https://doi.org/10.1007/978-1-4939-6530-4].

> Tour benchmark

The same eight workbench cities are used for every setting. Enumerating every
tour with city zero fixed gives an exact reference length outside the search
budget. Each setting uses seeds 1, 7, 42 and 123 with a cap of 192 scored tours.
The figure averages percentage gaps across the four seeds and carries forward
the last observation when a search exhausts its neighborhood.

```{cpp, id=grasp-and-path-relink, cache=yes, results="markdown", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

#include <array>
#include <cmath>
#include <filesystem>
#include <limits>
#include <numeric>
#include <print>
#include <random>
#include <stdexcept>
#include <variant>

namespace o = dm::optim;
using Tour = std::vector<std::size_t>;
constexpr std::size_t budget = 192;
constexpr std::array<std::uint64_t, 4> seeds{1, 7, 42, 123};
constexpr std::array<std::array<double, 2>, 8> cities{{
    {0, 0}, {2, 1}, {5, 0}, {7, 2}, {6, 6}, {3, 4}, {1, 7}, {0, 3},
}};

double length(const std::vector<std::vector<double>>& edges, const Tour& tour) {
    double sum = 0;
    for (std::size_t i = 0; i < tour.size(); ++i) sum += edges[tour[i]][tour[(i + 1) % tour.size()]];
    return sum;
}

int main() {
    std::vector edges(cities.size(), std::vector<double>(cities.size()));
    for (std::size_t i = 0; i < cities.size(); ++i) {
        for (std::size_t j = 0; j < i; ++j) {
            edges[i][j] = edges[j][i] = std::hypot(cities[i][0] - cities[j][0], cities[i][1] - cities[j][1]);
        }
    }
    Tour order(cities.size());
    std::iota(order.begin(), order.end(), 0);
    double optimum = std::numeric_limits<double>::infinity();
    do {
        optimum = std::min(optimum, length(edges, order));
    } while (std::next_permutation(order.begin() + 1, order.end()));
    std::print("The exact optimum is {:.8f}. All seeds follow.\n\n", optimum);
    std::print("| Setting | Seed | Calls | Final gap (%) | Updates |\n"
               "| --- | ---: | ---: | ---: | ---: |\n");
    auto plot = dm::graphics::RPlot::create();
    std::vector<dm::graphics::RGBA> colors{{30,99,168}, {205,99,31}, {45,138,83},
                                          {137,72,155}, {155,99,55}, {71,125,132}};

    const auto moves = [](const Tour& t, auto&) {
        std::vector<o::TwoOptMove> trials;
        for (std::size_t a = 1; a <= t.size(); ++a) {
            for (std::size_t b = a + 2; b <= t.size() && b - a <= t.size() - 2; ++b) {
                trials.push_back({a, b});
            }
        }
        return trials;
    };

    const std::vector<std::string> labels{"Fixed alpha", "Reactive alpha", "Reactive with relinking", "Scatter search"};
    const auto construct = [&](double alpha, auto& rng) -> std::optional<Tour> {
        Tour tour{0};
        while (tour.size() < cities.size()) {
            std::vector<std::pair<std::size_t, double>> choices;
            for (std::size_t city = 1; city < cities.size(); ++city) {
                if (std::ranges::find(tour, city) == tour.end()) choices.emplace_back(city, edges[tour.back()][city]);
            }
            tour.push_back(*o::grasp_choose(choices, alpha, rng));
        }
        return tour;
    };
    const auto enumerate = [&](const Tour& tour, std::size_t, auto& rng) { return moves(tour, rng); };
    const auto distance = [](const Tour& a, const Tour& b) {
        return std::inner_product(a.begin(), a.end(), b.begin(), std::size_t{0}, std::plus{}, std::not_equal_to{});
    };
    const auto forward = [](const Tour& from, const Tour& guide, auto&) {
        std::vector<std::pair<std::size_t, std::size_t>> swaps;
        for (std::size_t i = 1; i < from.size(); ++i) {
            if (from[i] != guide[i])
                swaps.emplace_back(i, std::ranges::find(from, guide[i]) - from.begin());
        }
        return swaps;
    };
    const auto apply_swap = [](Tour& tour, const std::pair<std::size_t, std::size_t>& move) {
        std::swap(tour[move.first], tour[move.second]);
    };

    for (std::size_t setting = 0; setting < labels.size(); ++setting) {
        std::vector<double> steps, means(budget);
        for (const auto seed : seeds) {
            std::mt19937_64 start_rng(seed);
            auto initial = order;
            std::shuffle(initial.begin() + 1, initial.end(), start_rng);
            std::vector<double> best;
            const auto score = [&](const Tour& tour) {
                const double value = length(edges, tour);
                best.push_back(best.empty() ? value : std::min(value, best.back()));
                return value;
            };

            o::GraspOptions options;
            options.local = {budget, seed};
            if (setting != 0) options.alphas = {0, 0.2, 0.5, 1};
            options.adaptation_interval = 4;
            o::NeighborhoodResult<Tour> result;
            std::size_t updates = 0;
            if (setting == 3) {
                const auto diversify = [&](auto& rng) { return construct(1, rng); };
                result = o::scatter_search(initial, score, diversify, distance, forward, apply_swap,
                                           {budget, seed, 6, 3, 8});
                updates = result.accepted;
            } else {
                const auto run = setting == 2
                    ? o::grasp_path_relink(initial, score, construct, enumerate, o::apply_two_opt,
                                           distance, forward, apply_swap, options)
                    : o::grasp_search(initial, score, construct, enumerate, o::apply_two_opt, options);
                result = run.search;
                updates = run.constructions;
            }

            if (result.evaluations != best.size() || result.evaluations > budget ||
                std::abs(result.value - length(edges, result.best)) > 1e-10 ||
                std::abs(result.value - best.back()) > 1e-10 || result.value < optimum - 1e-10) {
                throw std::runtime_error("Inconsistent discrete search result");
            }
            for (std::size_t i = 0; i < budget; ++i) {
                means[i] += 100 * (best[std::min(i, best.size()-1)] / optimum - 1) / seeds.size();
            }
            std::print("| {} | {} | {} | {:.5f} | {} |\n", labels[setting], seed,
                       result.evaluations, 100*(result.value/optimum-1), updates);
        }
        for (std::size_t i = 0; i < budget; ++i) steps.push_back(i + 1);
        plot.line(steps, means, labels[setting], colors[setting]);
    }

    colors.resize(labels.size());
    plot.title("Eight-city symmetric tour").x_label("Tour evaluations")
        .y_label("Mean incumbent gap (%)").legend(labels, colors).size(850, 480);
    std::filesystem::create_directories("build");
    const auto file = "build/grasp_and_path_relink.svg";
    plot.save_svg(file);
    std::filesystem::create_directories("figures");
    std::filesystem::copy_file(file, "figures/grasp_and_path_relink.svg", std::filesystem::copy_options::overwrite_existing);
}
```
