//? Title: Discrete neighborhood acceptance rules
//? Exports: both
//? Lang: en-GB

> Discrete simulated annealing

Metropolis acceptance allows uphill moves with probability exp(−Δ/T).
The temperature is multiplied by 0.98 after each attempted move.
See [Kirkpatrick, Gelatt and Vecchi|https://doi.org/10.1126/science.220.4598.671].

> Threshold accepting and record-to-record travel

Threshold accepting compares the trial to the current loss and decreases the
allowance as the budget progresses. Record-to-record travel uses a fixed
allowance above the best observed loss. See
[Dueck and Scheuer|https://doi.org/10.1016/0021-9991(90)90201-B] and
[Dueck|https://doi.org/10.1006/jcph.1993.1010].

> Great deluge

Classical great deluge accepts a trial below a water level that decreases by
a fixed amount per proposal. The experiment sets the initial level to 35
tour-length units. The extended rule schedules the level from the initial
loss to an exact target over the available budget and can accept strict
improvements above its current level. See
[Burke, Bykov, Newall and Petrović|https://doi.org/10.2298/YJOR0302139B].

> Late acceptance and strict improvement

Late acceptance compares each trial to the current loss and to the loss in
the current ring-buffer slot. Strict improvement provides a greedy reference
on the same 2-opt neighborhood. Updates counts accepted moves.
See [Burke and Bykov|https://doi.org/10.1016/j.ejor.2016.07.012].

> Tour benchmark

The same eight workbench cities are used for every setting. Enumerating every
tour with city zero fixed gives an exact reference length outside the search
budget. Each setting uses seeds 1, 7, 42 and 123 with a cap of 192 scored tours.
The figure averages percentage gaps across the four seeds and carries forward
the last observation when a search exhausts its neighborhood.

```{cpp, id=acceptance-rules, cache=yes, results="markdown", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

#include <array>
#include <cmath>
#include <filesystem>
#include <limits>
#include <numeric>
#include <print>
#include <random>
#include <stdexcept>
#include <variant>

namespace o = dm::optim;
using Tour = std::vector<std::size_t>;
constexpr std::size_t budget = 192;
constexpr std::array<std::uint64_t, 4> seeds{1, 7, 42, 123};
constexpr std::array<std::array<double, 2>, 8> cities{{
    {0, 0}, {2, 1}, {5, 0}, {7, 2}, {6, 6}, {3, 4}, {1, 7}, {0, 3},
}};

double length(const std::vector<std::vector<double>>& edges, const Tour& tour) {
    double sum = 0;
    for (std::size_t i = 0; i < tour.size(); ++i) sum += edges[tour[i]][tour[(i + 1) % tour.size()]];
    return sum;
}

int main() {
    std::vector edges(cities.size(), std::vector<double>(cities.size()));
    for (std::size_t i = 0; i < cities.size(); ++i) {
        for (std::size_t j = 0; j < i; ++j) {
            edges[i][j] = edges[j][i] = std::hypot(cities[i][0] - cities[j][0], cities[i][1] - cities[j][1]);
        }
    }
    Tour order(cities.size());
    std::iota(order.begin(), order.end(), 0);
    double optimum = std::numeric_limits<double>::infinity();
    do {
        optimum = std::min(optimum, length(edges, order));
    } while (std::next_permutation(order.begin() + 1, order.end()));
    std::print("The exact optimum is {:.8f}. All seeds follow.\n\n", optimum);
    std::print("| Setting | Seed | Calls | Final gap (%) | Updates |\n"
               "| --- | ---: | ---: | ---: | ---: |\n");
    auto plot = dm::graphics::RPlot::create();
    std::vector<dm::graphics::RGBA> colors{{30,99,168}, {205,99,31}, {45,138,83},
                                          {137,72,155}, {155,99,55}, {71,125,132}, {185,58,96}};

    const auto propose = [](const Tour& tour, auto& rng) { return o::sample_two_opt(tour.size(), rng); };
    const auto apply = o::apply_two_opt;

    const std::vector<std::string> labels{"Strict", "Annealing", "Threshold", "Record", "Deluge", "Extended deluge", "Late"};
    const std::array policies{o::NeighborhoodAcceptance::improving, o::NeighborhoodAcceptance::annealing,
        o::NeighborhoodAcceptance::threshold, o::NeighborhoodAcceptance::record,
        o::NeighborhoodAcceptance::deluge, o::NeighborhoodAcceptance::extended_deluge,
        o::NeighborhoodAcceptance::late};

    for (std::size_t setting = 0; setting < labels.size(); ++setting) {
        std::vector<double> steps, means(budget);
        for (const auto seed : seeds) {
            std::mt19937_64 start_rng(seed);
            auto initial = order;
            std::shuffle(initial.begin() + 1, initial.end(), start_rng);
            std::vector<double> best;
            const auto score = [&](const Tour& tour) {
                const double value = length(edges, tour);
                best.push_back(best.empty() ? value : std::min(value, best.back()));
                return value;
            };

            o::NeighborhoodSearchOptions options;
            options.evaluations = budget;
            options.seed = seed;
            options.acceptance = policies[setting];
            options.initial_temperature = 3;
            options.cooling = 0.98;
            options.tolerance = 2;
            options.initial_level = 35;
            options.rain_speed = 0.07;
            options.target_level = optimum;
            const auto result = o::neighborhood_search(initial, score, propose, apply, options);
            const auto updates = result.accepted;
            if (result.evaluations != best.size() || result.evaluations > budget ||
                std::abs(result.value - length(edges, result.best)) > 1e-10 ||
                std::abs(result.value - best.back()) > 1e-10 || result.value < optimum - 1e-10) {
                throw std::runtime_error("Inconsistent discrete search result");
            }
            for (std::size_t i = 0; i < budget; ++i) {
                means[i] += 100 * (best[std::min(i, best.size()-1)] / optimum - 1) / seeds.size();
            }
            std::print("| {} | {} | {} | {:.5f} | {} |\n", labels[setting], seed,
                       result.evaluations, 100*(result.value/optimum-1), updates);
        }
        for (std::size_t i = 0; i < budget; ++i) steps.push_back(i + 1);
        plot.line(steps, means, labels[setting], colors[setting]);
    }

    colors.resize(labels.size());
    plot.title("Eight-city symmetric tour").x_label("Tour evaluations")
        .y_label("Mean incumbent gap (%)").legend(labels, colors).size(850, 480);
    std::filesystem::create_directories("build");
    const auto file = "build/acceptance_rules.svg";
    plot.save_svg(file);
    std::filesystem::create_directories("figures");
    std::filesystem::copy_file(file, "figures/acceptance_rules.svg", std::filesystem::copy_options::overwrite_existing);
}
```
