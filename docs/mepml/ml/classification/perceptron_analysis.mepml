> Controls and boundary cases

```{cpp, results="markdown", file="figures/perceptron_controls.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
    std::filesystem::create_directories("build");
    std::vector<double> v;
    std::vector<std::string> labels;
    std::print("| epoch budget | actual completed passes | updates | converged |\n| ---: | ---: | ---: | " "--- |\n");
    for (std::size_t cap : {0, 1, 2, 5, 10}) {
        auto m = dm::algorithms::perceptron_train({{1}, {1}}, {1, -1}, cap);
        labels.push_back(std::to_string(cap));
        v.push_back(m.total_mistakes);
        std::print("| {} | {} | {} | {} |\n", cap, m.epochs_run,
                   m.total_mistakes, m.converged);
    }
    auto p = dm::graphics::RPlot::barplot(v, labels, "actual online updates");
    p.title("Contradictory perceptron labels: budget exhaustion is not convergence").x_label("epoch budget").y_label("actual updates");
    p.save_svg("build/perceptron_controls.svg");
}
```
// result_begin: markdown
| epoch budget | actual completed passes | updates | converged |
| ---: | ---: | ---: | --- |
| 0 | 0 | 0 | false |
| 1 | 1 | 2 | false |
| 2 | 2 | 4 | false |
