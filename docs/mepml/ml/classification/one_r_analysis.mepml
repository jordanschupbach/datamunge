> Fit on native Titanic training rows, then freeze

Use dm::datasets::titanic() directly and the same reproducible,
unstratified70/30 split used by the ZeroR report: test fraction.3, seed2024.
The624 training passengers choose the rule and every class/value majority;
the267 test passengers are evaluated once with that rule frozen. Predictors
Pclass,SibSp andParch are complete numeric integer categories. Count-valued
SibSp/Parch are treated nominally here; no numeric distance, binning,
imputation, test-dependent encoding or response column is used as a predictor.

A ZeroR global-majority baseline is trained on the same training rows and
evaluated on the same test rows. Neither selected-feature training accuracy nor
a comparison on this one split establishes general superiority. Raw held-out
confusion rows are true classes and columns are predicted classes; the bar chart
shows correct counts by actual true class, so class imbalance remains visible.

```{cpp, results="markdown", file="figures/one_r_titanic.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <datamunge/algorithms/one_r.hpp>
#include <datamunge/algorithms/zero_r.hpp>
#include <datamunge/datasets/datasets.hpp>
#include <datamunge/stats/train_test_split.hpp>
#include <datamunge/plot/plot.hpp>
#include <filesystem>
#include <print>
int main() {
    std::filesystem::create_directories("build");
    auto[train, test] =
        dm::stats::train_test_split(dm::datasets::titanic(), .3, 2024);
    auto fit =
        dm::algorithms::one_r_dataframe(train, {"Pclass", "SibSp", "Parch"},
                                        "Survived");
    auto held = dm::algorithms::one_r_dataframe(test, fit.names, "Survived");
    auto t = dm::algorithms::one_r_train_trace(fit.features, fit.labels);
    auto evaluation =
        dm::algorithms::one_r_evaluate(t.model, held.features, held.labels);
    auto zero = dm::algorithms::zero_r_train(fit.labels);
    std::print("Training rows: {}. Held-out rows: {}. Actual selected column: {}. Training accuracy: " "{:.9f}. Fixed-model test accuracy: {:.9f}. Unseen-value fallback rows: {}.\n\n",
               fit.labels.size(), held.labels.size(),
               fit.names[t.model.feature], t.model.accuracy(),
               double(evaluation.correct) / evaluation.rows,
               evaluation.fallbacks);
    std::print("ZeroR on the identical frozen split:\n\n{}\n\n",
               dm::algorithms::zero_r_evaluate(zero, test, "Survived").to_md(9));
    std::print("| actual true class | actual predicted class | raw held-out count |\n| ---: | ---: | ---: " "|\n");
    std::vector<double> correct;
    std::vector<std::string> names;
    for (std::size_t i = 0; i < evaluation.classes.size(); ++i) {
        correct.push_back(evaluation.confusion[i][i]);
        names.push_back(std::format("true class{}", evaluation.classes[i]));
        for (std::size_t j = 0; j < evaluation.classes.size(); ++j)
            std::print("| {} | {} | {} |\n", evaluation.classes[i],
                       evaluation.classes[j], evaluation.confusion[i][j]);
    }
    auto p =
        dm::graphics::RPlot::barplot(correct, names, "correct predictions");
    p.title("Titanic held-out rows: actual correct counts by class").x_label(
        "actual true class").y_label("raw correct held-out count").save_svg(
        "build/one_r_titanic.svg");
}
```
