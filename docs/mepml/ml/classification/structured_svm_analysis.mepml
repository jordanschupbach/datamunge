> The retained original experiment

```{cpp, results="markdown", file="figures/structured_svm_original.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <filesystem>
#include <print>
#include <algorithm>
#include <cmath>
#include <limits>
#include <numeric>
#include <numbers>
#include <random>
#include <string>
#include <vector>
#include <map>
#include <set>
#include <array>
#include <tuple>
#include <bit>
#include <datamunge/random/quality.hpp>
#include <datamunge/algorithms/structured_svm_analysis.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    auto d = a::structured_svm_example_cohort();
    a::StructuredSVMParameters p;
    p.lambda = .01;
    p.epochs = 100;
    p.seed = 1;
    auto r = a::structured_svm_run(d.features, d.labels, 3, p);
    std::print("Original180 rows, lambda.01,100 epochs, seed1: {} actual updates, training accuracy {:.9g}, " "objective {:.9g}.\n\n| original centroid | actual predicted class |\n| --- | ---: |\n",
               r.updates,
               double(r.epochs.back().objective.correct) / d.features.size(),
               r.epochs.back().objective.value);
    for (const auto &pt : std::vector<std::vector<double>>{{0, 0}, {6, 0},
                                                           {3, 6}})
        std::print("| `{}` | {} |\n", pt, a::structured_svm_predict(r.model, pt));
    auto regions = a::structured_svm_regions(r.model, -2.1, 7, 14);
    auto chart = g::RPlot::create();
    const std::array<g::RGB, 3> pale{{{191, 219, 254}, {254, 202, 202},
                                      {187, 247, 208}}}, dark{
        {{37, 99, 235}, {220, 38, 38}, {5, 150, 105}}
    };
    for (std::size_t c = 0; c < 3; ++c) {
        chart.points(regions.x[c], regions.y[c], pale[c], 9);
        std::vector<double> x, y;
        for (std::size_t i = 0; i < d.labels.size(); ++i)
            if (d.labels[i] == int(c)) {
                x.push_back(d.features[i][0]);
        y.push_back(d.features[i][1]);
            }
            chart.points(x, y, dark[c], 4);
    }
    chart.size(760, 800).margins(80, 40, 72, 88).xlim(-2.5, 7.5).ylim(-2.5, 7.5).title("Original two-feature cohort: actual linear decision regions").x_label("feature1").y_label("feature2");
    chart.save_svg("build/structured_svm_original.svg");
}
```
