> Explicit controls

```{cpp, results="markdown", file="figures/structured_svm_controls.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <filesystem>
#include <print>
#include <algorithm>
#include <cmath>
#include <limits>
#include <numeric>
#include <numbers>
#include <random>
#include <string>
#include <vector>
#include <map>
#include <set>
#include <array>
#include <tuple>
#include <bit>
#include <datamunge/random/quality.hpp>
#include <datamunge/algorithms/structured_svm_analysis.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    auto train = a::structured_svm_example_cohort();
    auto test = a::structured_svm_example_cohort(60, 11);
    a::StructuredSVMParameters p;
    p.lambda = .01;
    p.epochs = 100;
    p.seed = 1;
    auto r = a::structured_svm_run(train.features, train.labels, 3, p);
    dm::nn::ConfusionMatrix matrix(3);
    for (std::size_t i = 0; i < test.labels.size(); ++i)
        matrix.add(std::size_t(test.labels[i]),
                   a::structured_svm_predict(r.model, test.features[i]));
    std::print("Independent controlled held-out180 rows seed11; training seed3; actual accuracy " "{:.9g}.\n\n| truth | predicted0 | predicted1 | predicted2 |\n| ---: | ---: | ---: | ---: " "|\n",
               matrix.accuracy());
    for (std::size_t c = 0; c < 3; ++c)
        std::print("| {} | {} | {} | {} |\n", c, matrix.cells()[c][0],
                   matrix.cells()[c][1], matrix.cells()[c][2]);
    matrix.save_svg("build/structured_svm_controls.svg",
                    {.title = "Actual held-out seed11 predictions:180 rows",
                     .labels = {"class0", "class1", "class2"}});
}
