> Actual selected work and sensitivity

```{cpp, results="markdown", file="figures/structured_svm_work.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <filesystem>
#include <print>
#include <algorithm>
#include <cmath>
#include <limits>
#include <numeric>
#include <numbers>
#include <random>
#include <string>
#include <vector>
#include <map>
#include <set>
#include <array>
#include <tuple>
#include <bit>
#include <datamunge/random/quality.hpp>
#include <datamunge/algorithms/structured_svm_analysis.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    auto d = a::structured_svm_example_cohort();
    a::StructuredSVMParameters p;
    p.lambda = .01;
    p.epochs = 100;
    p.seed = 1;
    auto r = a::structured_svm_run(d.features, d.labels, 3, p);
    std::vector<double> x, y;
    std::print("| actual completed epoch | sampled updates | actual regularizer | mean hinge | objective | " "correct /180 |\n| ---: | ---: | ---: | ---: | ---: | ---: |\n");
    for (const auto &e : r.epochs) {
        x.push_back(e.epoch);
        y.push_back(e.objective.value);
        std::print("| {} | {} | {:.9g} | {:.9g} | {:.9g} | {} |\n", e.epoch,
                   e.updates, e.objective.regularizer, e.objective.mean_hinge,
                   e.objective.value, e.objective.correct);
    }
    std::print("Actual selected score terms {}, shrink assignments {}, hinge assignments {}, objective norm " "terms {}.\n",
               r.score_terms, r.shrink_assignments, r.hinge_assignments,
               r.objective_norm_terms);
    auto plot = g::RPlot::create();
    plot.lines(x, y, "actual executed values", {37, 99, 235}).points(
        x, y, {37, 99, 235}, 4).title("Actual full-data objective after each sampled epoch").x_label("completed epochs").y_label("regularized multiclass objective");
    plot.save_svg("build/structured_svm_work.svg");
}
```
