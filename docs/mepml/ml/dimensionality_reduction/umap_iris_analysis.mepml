> Checking the theory and controls

```{cpp, results="markdown", file="figures/umap_iris_controls.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    const auto iris = dm::datasets::iris();
    const std::vector<std::string> features{"Sepal.Length", "Sepal.Width",
                                            "Petal.Length", "Petal.Width"};
    std::vector<std::string> labels;
    for (std::size_t i = 0; i < iris.nrows(); ++i)
        labels.push_back(iris.string_at("Species", i));
    std::vector<double> x, y;
    std::print("| setting | within | between | actual calibration diagnostic |\n|---:|---:|---:|---:|\n");
    for (std::size_t setting : {5, 6, 8, 10, 15, 20, 30}) {
        dm::stats::UMAPOptions o;
        o.n_neighbors = setting;
        dm::stats::UMAP m(iris, features, o);
        auto metrics =
            dm::stats::embedding_group_distances(m.embedding(), labels);
        double max_error = 0;
        for (std::size_t i = 0; i < m.observations(); ++i) {
            double sum = 0;
            for (std::size_t j = 0; j < m.observations(); ++j)
                sum += m.directed_memberships()(i, j);
            max_error =
                std::max(max_error, std::abs(sum - std::log2(double(setting))));
        }
        std::print("|{}|{}|{}|{}|\n", setting, metrics.double_at("within", 0),
                   metrics.double_at("between", 0), max_error);
        x.push_back(setting);
        y.push_back(metrics.double_at("within", 0) / metrics.double_at(
                    "between", 0));
    }
    auto p = g::RPlot::create();
    p.line(x, y, "actual", {37, 99, 235}, 2);
    p.points(x, y, "", {37, 99, 235}, 5);
    p.title("Actual Iris sensitivity; no universal method ranking").x_label(
        "n_neighbors").y_label("within / between mean distance");
    p.save_svg("build/umap_iris_controls.svg");
}
```
