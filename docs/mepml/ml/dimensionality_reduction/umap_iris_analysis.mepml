> The retained original experiment

```{cpp, results="markdown", file="figures/umap_iris_original.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    const auto iris = dm::datasets::iris();
    const std::vector<std::string> features{"Sepal.Length", "Sepal.Width",
                                            "Petal.Length", "Petal.Width"};
    std::vector<std::string> labels;
    for (std::size_t i = 0; i < iris.nrows(); ++i)
        labels.push_back(iris.string_at("Species", i));
    dm::stats::UMAP m(iris, features);
    std::print("{}\n", m.summary());
    std::print("\n{}\n",
               dm::stats::embedding_group_distances(m.embedding(), labels).to_md());
    auto eda = g::RPlot::create();
    eda.points(iris.numeric_column("Petal.Length").values(),
               iris.numeric_column("Petal.Width").values(),
               "all150 observations", {148, 163, 184});
    eda.title("Raw petal measurements, cm").x_label("Petal.Length").y_label(
        "Petal.Width");
    auto embed = m.plot_embedding(labels);
    embed.title("UMAP; species withheld during fit");
    g::RLayout::create(1, 2).add(eda).add(embed).size(1100, 490).fit_panels().save_svg("build/umap_iris_original.svg");
    std::print("\n| row | actual calibrated value |\n|---:|---:|\n");
    for (std::size_t i : {0, 1, 50, 51, 100, 101, 149})
        std::print("|{}|{}|\n", i, m.sigmas()[i]);
}
```
