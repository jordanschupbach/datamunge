> Sensitivity and selected work

```{cpp, results="markdown", file="figures/umap_iris_work.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    auto roll = dm::stats::embedding_swiss_roll();
    std::vector<std::string> features{"x", "y", "z"};
    dm::stats::UMAPOptions o;
    o.n_neighbors = 8;
    dm::stats::UMAP m(roll, features, o);
    dm::stats::PCA pca(roll, features, {true, false});
    dm::stats::MDS mds(roll, features);
    dm::stats::Isomap iso(roll, features);
    std::print("| method | abs corr(axis0,t) | abs corr(axis1,t) | abs corr(axis0,height) | abs " "corr(axis1,height) |\n|---|---:|---:|---:|---:|---:|\n");
    auto t =
        roll.numeric_column("t").values(), h =
        roll.numeric_column("height").values();
    for (auto pair : std::vector<std::pair<std::string, const dm::linalg::DenseMatrix<double> *>>{{"UMAP", &m.embedding()}, {"PCA unscaled", &pca.scores()}, {"MDS", &mds.embedding()}, {"Isomap k10", &iso.embedding()}}) {
        const auto &z = *pair.second;
        std::print("|{}|{}|{}|{}|{}|\n", pair.first,
                   dm::stats::embedding_abs_correlation(z.col(0), t),
                   dm::stats::embedding_abs_correlation(z.col(1), t),
                   dm::stats::embedding_abs_correlation(z.col(0), h),
                   dm::stats::embedding_abs_correlation(z.col(1), h));
    }
    std::vector<std::string> bins;
    for (auto q : t)
        bins.push_back("t band " + std::to_string(int((q -
                                                       1.5 * std::numbers::pi) /
                                                      std::numbers::pi)));
    auto fitted = m.plot_embedding(bins);
    fitted.title("Swiss roll: UMAP seed42");
    auto baseline = pca.plot_scores(bins);
    baseline.title("Same data: unscaled PCA");
    g::RLayout::create(1, 2).add(fitted).add(baseline).size(1100, 490).fit_panels().save_svg("build/umap_iris_work.svg");
    std::print("\n| Swiss k | abs corr(axis0,t) | abs corr(axis1,height) |\n|---:|---:|---:|\n");
    for (std::size_t k : {5, 6, 8, 10, 15, 20, 30}) {
        dm::stats::UMAPOptions sweep;
        sweep.n_neighbors = k;
        dm::stats::UMAP z(roll, features, sweep);
        std::print("|{}|{}|{}|\n", k,
                   dm::stats::embedding_abs_correlation(z.dimension(0), t),
                   dm::stats::embedding_abs_correlation(z.dimension(1), h));
    }
    auto iris = dm::datasets::iris();
    std::vector<std::string> labels;
    for (std::size_t i = 0; i < iris.nrows(); ++i)
        labels.push_back(iris.string_at("Species", i));
    dm::stats::TSNE comparator(iris,
                               {"Sepal.Length", "Sepal.Width", "Petal.Length",
                                "Petal.Width"});
    std::print("\nIris t-SNE comparator, labels withheld:\n\n{}\n",
               dm::stats::embedding_group_distances(comparator.embedding(),
                                                    labels).to_md());
}
```
