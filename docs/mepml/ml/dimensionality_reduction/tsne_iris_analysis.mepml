> Checking the theory and controls

```{cpp, results="markdown", file="figures/tsne_iris_controls.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <filesystem>
#include <print>
#include <algorithm>
#include <cmath>
#include <limits>
#include <numeric>
#include <numbers>
#include <random>
#include <string>
#include <vector>
#include <map>
#include <set>
#include <array>
#include <tuple>
#include <bit>
#include <datamunge/random/quality.hpp>
#include <datamunge/stats/embedding_diagnostics.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    const auto iris = dm::datasets::iris();
    const std::vector<std::string> features{"Sepal.Length", "Sepal.Width",
                                            "Petal.Length", "Petal.Width"};
    std::vector<std::string> labels;
    for (std::size_t i = 0; i < iris.nrows(); ++i)
        labels.push_back(iris.string_at("Species", i));
    std::vector<double> x, y;
    std::print("| setting | within | between | actual calibration diagnostic |\n|---:|---:|---:|---:|\n");
    for (double setting : {5., 30., 50.}) {
        dm::stats::TSNEOptions o;
        o.perplexity = setting;
        dm::stats::TSNE m(iris, features, o);
        auto metrics =
            dm::stats::embedding_group_distances(m.embedding(), labels);
        double mean =
            std::accumulate(m.achieved_perplexity().begin(),
                            m.achieved_perplexity().end(), 0.) /
            m.observations();
        std::print("|{}|{}|{}|{}|\n", setting, metrics.double_at("within", 0),
                   metrics.double_at("between", 0), mean);
        x.push_back(setting);
        y.push_back(metrics.double_at("within", 0) / metrics.double_at(
                    "between", 0));
    }
    auto p = g::RPlot::create();
    p.line(x, y, "actual", {37, 99, 235}, 2);
    p.points(x, y, "", {37, 99, 235}, 5);
    p.title("Actual Iris sensitivity; no universal method ranking").x_label(
        "perplexity").y_label("within / between mean distance");
    p.save_svg("build/tsne_iris_controls.svg");
}
```
