> The retained original experiment

```{cpp, results="markdown", file="figures/td_learning_original.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    auto env = a::td_random_walk_environment(2024);
    a::RLParameters p;
    p.learning_rate = .1;
    p.discount = 1;
    p.episodes = 300;
    p.seed = 0;
    auto r = a::td_prediction_trace(env, std::vector<std::size_t>(7), p);
    std::print("| original completed episodes | actual values A..E | actual interior RMSE |\n| ---: | --- | " "---: |\n");
    for (std::size_t ep : {0, 1, 10, 100, 300}) {
        const auto &v = r.episodes[ep].values;
        std::print("| {} | `{}` | {:.9g} |\n", ep,
                   std::vector<double>(v.begin() + 1, v.begin() + 6),
                   a::td_random_walk_rmse(v));
    }
    std::vector<double> x{1, 2, 3, 4, 5};
    auto truth = a::td_random_walk_truth();
    auto chart = g::RPlot::create();
    chart.lines(x, std::vector<double>(truth.begin() + 1, truth.begin() + 6),
                "mathematical k/6 reference", {17, 24, 39});
    const std::array<std::size_t, 3> show{1, 100, 300};
    const std::array<g::RGB, 3> colors{{{147, 197, 253}, {59, 130, 246},
                                        {30, 64, 175}}};
    for (std::size_t i = 0; i < show.size(); ++i) {
        const auto &v = r.episodes[show[i]].values;
        chart.lines(x, std::vector<double>(v.begin() + 1, v.begin() + 6),
                    std::format("actual TD {} episodes", show[i]), colors[i]);
    }
    chart.title("Original seed2024 walk: actual alpha.1 TD snapshots").x_label(
        "interior state1..5").y_label("actual value estimate");
    chart.save_svg("build/td_learning_original.svg");
}
```
