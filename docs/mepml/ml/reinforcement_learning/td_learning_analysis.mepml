> Explicit controls

```{cpp, results="markdown", file="figures/td_learning_controls.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    std::vector<double> x, y;
    std::print("| transition cap per episode | actual resets | actual transitions | terminal episodes | " "truncated episodes |\n| ---: | ---: | ---: | ---: | ---: |\n");
    for (std::size_t cap : {0, 1, 2, 5, 20, 1000}) {
        auto env = a::td_random_walk_environment(2024);
        a::RLParameters p;
        p.discount = 1;
        p.episodes = 50;
        p.max_steps = cap;
        auto r = a::td_prediction_run(env, std::vector<std::size_t>(7), p);
        x.push_back(cap);
        y.push_back(r.truncated);
        std::print("| {} | {} | {} | {} | {} |\n", cap, r.resets, r.transitions,
                   r.terminated, r.truncated);
    }
    auto plot = g::RPlot::create();
    plot.lines(x, y, "actual native values", {37, 99, 235}).points(
        x, y, {37, 99, 235}, 4).title("Step-cap exhaustion is recorded as truncation").x_label("per-episode transition cap").y_label("actual truncated episodes");
    plot.save_svg("build/td_learning_controls.svg");
}
```
