> Actual selected work and sensitivity

```{cpp, results="markdown", file="figures/td_learning_work.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    auto env = a::td_random_walk_environment(2024);
    a::RLParameters p;
    p.learning_rate = .1;
    p.discount = 1;
    p.episodes = 300;
    auto r = a::td_prediction_trace(env, std::vector<std::size_t>(7), p);
    std::vector<double> x, y;
    std::print("| actual completed episodes | actual last-episode transitions | actual interior RMSE |\n| " "---: | ---: | ---: |\n");
    for (const auto &e : r.episodes) {
        x.push_back(e.episode);
        y.push_back(a::td_random_walk_rmse(e.values));
        std::print("| {} | {} | {:.9g} |\n", e.episode, e.transitions, y.back());
    }
    auto plot = g::RPlot::create();
    plot.lines(x, y, "actual native values", {37, 99, 235}).points(
        x, y, {37, 99, 235}, 4).title("Actual constant-step prediction error fluctuates with experience").x_label("completed episodes").y_label("actual interior value RMSE");
    plot.save_svg("build/td_learning_work.svg");
}
