> Actual selected work and sensitivity

```{cpp, results="markdown", file="figures/rvm_work.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    auto e = a::rvm_sine_example();
    a::RVMOptions o;
    o.gamma = .5;
    o.max_iterations = 300;
    auto r = a::rvm_train_trace(e.inputs, e.targets, o);
    std::vector<double> x, y;
    std::print("| actual update | preupdate beta | updated beta | preupdate SSE | maximum log-alpha change " "|\n| ---: | ---: | ---: | ---: | ---: |\n");
    for (const auto &s : r.steps) {
        std::print("| {} | {} | {} | {} | {} |\n", s.iteration, s.beta_before,
                   s.beta_after, s.squared_error, s.maximum_log_change);
        x.push_back(s.iteration);
        y.push_back(s.maximum_log_change);
    }
    auto plot = g::RPlot::create();
    plot.lines(x, y, "actual values", {37, 99, 235}).points(x, y, {37, 99, 235},
                                                            5).title(
        "Actual fixed-point precision update history").x_label("actual update").y_label("actual maximum log-alpha change");
    plot.save_svg("build/rvm_work.svg");
}
```
