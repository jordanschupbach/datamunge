> The retained original experiment

```{cpp, results="markdown", file="figures/rvm_original.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    auto e = a::rvm_sine_example();
    a::RVMOptions o;
    o.gamma = .5;
    o.max_iterations = 300;
    auto r = a::rvm_train_trace(e.inputs, e.targets, o);
    std::print("Original noiseless sine: actual updates {}, actual selected centers {}, final beta {}, " "solves {}, criterion met {}.\n\n| grid x | sine truth | actual mean | actual conditional " "predictive variance |\n| ---: | ---: | ---: | ---: |\n",
               r.model.iterations, r.model.num_relevance_vectors, r.model.beta,
               r.posterior_solves, r.converged);
    std::vector<double> x, y, upper, lower;
    for (std::size_t i = 0; i < e.grid.size(); ++i) {
        auto p = a::rvm_predictive(r, e.grid[i]);
        std::print("| {} | {} | {} | {} |\n", e.grid[i][0], e.truth[i], p.mean,
                   p.variance);
        x.push_back(e.grid[i][0]);
        y.push_back(p.mean);
        upper.push_back(p.mean + 1.96 * std::sqrt(p.variance));
        lower.push_back(p.mean - 1.96 * std::sqrt(p.variance));
    }
    auto plot = g::RPlot::create();
    plot.lines(x, e.truth, "noiseless sine truth", {22, 163, 74}).lines(
        x, y, "actual matched posterior mean", {37, 99, 235}).lines(
        x, upper, "conditional mean plus 1.96 SD", {156, 163, 175}).lines(
        x, lower, "conditional mean minus 1.96 SD", {156, 163, 175}).title(
        "Original sine fixture: conditional Gaussian predictions").x_label(
        "x").y_label("regression output");
    plot.save_svg("build/rvm_original.svg");
}
```
