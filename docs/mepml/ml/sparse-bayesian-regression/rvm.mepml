> Explicit controls

```{cpp, results="markdown", file="figures/rvm_controls.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    std::vector<double> x, y;
    std::print("| update budget | actual solves | actual active centers | mean at 0.5 | conditional " "variance |\n| ---: | ---: | ---: | ---: | ---: |\n");
    for (std::size_t n : {0, 1, 3, 10}) {
        a::RVMOptions o;
        o.max_iterations = n;
        auto r = a::rvm_train_run({{0}, {1}, {2}}, {0, 1, 0}, o);
        auto p = a::rvm_predictive(r, {.5});
        std::print("| {} | {} | {} | {} | {} |\n", n, r.posterior_solves,
                   r.model.num_relevance_vectors, p.mean, p.variance);
        x.push_back(n);
        y.push_back(p.variance);
    }
    bool bad = false;
    try {
        a::rvm_train({}, {});
    } catch (const std::invalid_argument &) {
        bad = true;
    }
    std::print("Empty training input rejected {}.\n", bad);
    if (!bad)
        return 1;
    auto plot = g::RPlot::create();
    plot.lines(x, y, "actual values", {37, 99, 235}).points(x, y, {37, 99, 235},
                                                            5).title(
        "Finite update budgets retain matched posterior variance").x_label(
        "update budget").y_label("actual conditional variance");
    plot.save_svg("build/rvm_controls.svg");
}
```
