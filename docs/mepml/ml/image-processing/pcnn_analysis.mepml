> The original fixture, retained

This complete program retains the original inputs, seed and substantive
experiment. Any added display prefix is explicitly separate from the original
random call schedule.

```{cpp, results="markdown", file="figures/pcnn_original.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>


using namespace datamunge::algorithms;
using namespace datamunge::graphics;

int main() {
    std::ostringstream original_output;
    auto *original_cout = std::cout.rdbuf(original_output.rdbuf());

    std::filesystem::create_directories("build");
    const std::size_t R = 16, C = 16;
    std::vector<std::vector<double>> img(R, std::vector<double>(C, 0.3));
    const double cx = 7.5, cy = 7.5, rad = 4.0;
    for (std::size_t i = 0; i < R; ++i)
        for (std::size_t j = 0; j < C; ++j)
            if (std::hypot(i - cy, j - cx) <= rad)
                img[i][j] = 0.9;  // bright disk

    PCNNParameters params;
    params.iterations = 25;
    params.beta = 0.2;
    params.threshold_decay = 0.8;
    params.threshold_gain = 20.0;
    PCNNResult r = pcnn_run(img, params);

    double disk = 0, bg = 0;
    int nd = 0, nb = 0;
    for (std::size_t i = 0; i < R; ++i)
        for (std::size_t j = 0; j < C; ++j) {
            if (r.first_fire[i][j] == 0)
                continue;
    if (std::hypot(i - cy, j - cx) <= rad) {
        disk += r.first_fire[i][j];
        ++nd;
    } else {
        bg += r.first_fire[i][j];
        ++nb;
    }
        }
        std::cout <<
            "=== PCNN on a 16x16 image (bright disk on dim background) ===\n";
        std::cout << "disk pixels: mean first-fire iteration = " << disk / nd <<
            " (" << nd << " pixels)\n";
        std::cout << "background:  mean first-fire iteration = " << bg / nb <<
            " (" << nb << " pixels)\n";
        std::cout << "=> the brighter disk segments out earlier by ~" <<
            (bg / nb - disk / nd) << " iterations\n\n";

        std::cout << "time signature (neurons firing each iteration):\n  ";
        for (int c : r.time_signature)
            std::cout << c << ' ';
        std::cout << '\n';

        std::vector<double> it_x, sig;
        for (std::size_t i = 0; i < r.time_signature.size(); ++i) {
            it_x.push_back(i + 1);
            sig.push_back(r.time_signature[i]);
        }
        RPlot p = RPlot::create();
        p.bars(it_x, sig, "neurons firing", {37, 99, 235}, 0.8);
        p.title("Original synthetic disk: actual PCNN firing counts").x_label(
            "iteration").y_label("actual firing pixels");
        p.save_svg("build/pcnn_original.svg");
        std::cout << "\nwrote build/pcnn_original.svg\n";
        std::cout.rdbuf(original_cout);
        std::print("| Original computed output |\n| --- |\n");
        std::istringstream lines(original_output.str());
        std::string line;
        while (std::getline(lines, line)) {
            while (!line.empty() && line.back() == ' ') line.pop_back();
            if (!line.empty()) std::print("| `{}` |\n", line);
        }

        return 0;
}
```
