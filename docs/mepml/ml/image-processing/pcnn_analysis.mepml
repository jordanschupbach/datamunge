> Controls and boundary cases

```{cpp, results="markdown", file="figures/pcnn_controls.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
    std::filesystem::create_directories("build");
    std::vector<double> x, a, b;
    dm::algorithms::PCNNParameters q;
    q.iterations = 8;
    q.beta =
        2;  // Explicit stronger-coupling control; original disk keeps beta=.2.
    auto no = q;
    no.beta = 0;
    auto linked =
        dm::algorithms::pcnn_run({{.9, .3}, {.3, .3}}, q), unlinked =
        dm::algorithms::pcnn_run({{.9, .3}, {.3, .3}}, no);
    std::print("| iteration | linked actual firings | unlinked actual firings |\n| ---: | ---: | ---: |\n");
    for (std::size_t i = 0; i < q.iterations; ++i) {
        x.push_back(i + 1);
        a.push_back(linked.time_signature[i]);
        b.push_back(unlinked.time_signature[i]);
        std::print("| {} | {} | {} |\n", i + 1, a.back(), b.back());
    }
    auto p = dm::graphics::RPlot::create();
    p.lines(x, a, "beta=2", {37, 99, 235}).points(x, a, {37, 99, 235}, 4).lines(
        x, b, "beta=0", {220, 38, 38}).points(x, b, {220, 38, 38}, 3).title(
        "PCNN coupling control: same stimulus and threshold schedule").x_label(
        "iteration").y_label("actual firing count");
    p.save_svg("build/pcnn_controls.svg");
}
```
