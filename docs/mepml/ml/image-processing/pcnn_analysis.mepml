> Producing work and finite observations

```{cpp, results="markdown", file="figures/pcnn_work.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
    std::filesystem::create_directories("build");
    dm::algorithms::PCNNParameters q;
    q.iterations = 4;
    q.beta = 0;
    auto t = dm::algorithms::pcnn_trace({{0, .2, .5, .9}}, q);
    std::vector<double> x, y;
    std::print("| iteration | column | actual decayed threshold | actual activity | actual pulse |\n| ---: " "| ---: | ---: | ---: | ---: |\n");
    for (auto &r : t.cells) {
        std::print("| {} | {} | {} | {} | {} |\n", r.iteration, r.column,
                   r.decayed, r.activity, r.pulse);
        if (r.column == 3) {
            x.push_back(r.iteration);
            y.push_back(r.decayed);
        }
    }
    auto p = dm::graphics::RPlot::create();
    p.lines(x, y, "actual pre-test threshold", {37, 99, 235}).points(
        x, y, {37, 99, 235}, 4).abline_h(.9, {220, 38, 38}, 2).title(
        "One actual bright-pixel threshold: decay and refractory jump").x_label(
        "iteration").y_label("actual pre-test threshold");
    p.save_svg("build/pcnn_work.svg");
}
```
