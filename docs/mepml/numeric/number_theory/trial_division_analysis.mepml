> Checking the theory and controls

```{cpp, results="markdown", file="figures/trial_division_controls.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    std::vector<double> x, y;
    std::print("| n | actual factors |\n|---:|---|\n");
    for (std::uint64_t n : {1ULL, 2ULL, 8ULL, 49ULL, 97ULL}) {
        auto r = a::trial_division_work(n);
        std::print("|{}|`{}`|\n", n, r.factors);
        x.push_back(n);
        y.push_back(r.tests);
    }
    try {
        a::trial_division_work(0);
    } catch (const std::invalid_argument &) {
        std::print("\nZero is rejected: it has no finite prime factorization.\n");
    }
    auto p = g::RPlot::create();
    p.line(x, y, "actual", {37, 99, 235}, 2);
    p.points(x, y, "", {37, 99, 235}, 5);
    p.title("Unit, prime and repeated-factor controls").x_label("n").y_label(
        "actual tests");
    p.save_svg("build/trial_division_controls.svg");
}
```
// result_begin: markdown
| n | actual factors |
|---:|---|
|1|`[]`|
|2|`[2]`|
|8|`[2, 2, 2]`|
|49|`[7, 7]`|
|97|`[97]`|

Zero is rejected: it has no finite prime factorization.
