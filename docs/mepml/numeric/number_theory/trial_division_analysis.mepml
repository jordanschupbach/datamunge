> Sensitivity and selected work

```{cpp, results="markdown", file="figures/trial_division_work.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    std::vector<double> x, y;
    std::print("| p | p squared | actual odd candidates | actual tests |\n|---:|---:|---:|---:|\n");
    for (std::uint64_t p : {101ULL, 331ULL, 1009ULL, 3167ULL, 10007ULL,
                            31627ULL, 100003ULL}) {
        auto r = a::trial_division_work(p * p);
        std::print("|{}|{}|{}|{}|\n", p, p * p, r.odd_candidates, r.tests);
        x.push_back(p);
        y.push_back(r.odd_candidates);
    }
    auto p = g::RPlot::create();
    p.line(x, y, "actual", {37, 99, 235}, 2);
    p.points(x, y, "", {37, 99, 235}, 5);
    p.title("Original prime-square cohort: actual square-root work").x_label(
        "sqrt(n) = p").y_label("actual odd candidates");
    p.save_svg("build/trial_division_work.svg");
}
```
