> The retained original experiment

```{cpp, results="markdown", file="figures/trial_division_original.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    std::print("| n | prime factors | tests |\n|---:|---|---:|\n");
    std::vector<double> x, y;
    for (std::uint64_t n : {360ULL, 1001ULL, 2027ULL, 1000000007ULL}) {
        auto r = a::trial_division_work(n);
        std::print("|{}|`{}`|{}|\n", n, r.factors, r.tests);
        x.push_back(std::log10(double(n)));
        y.push_back(r.tests);
    }
    auto p = g::RPlot::create();
    p.line(x, y, "actual", {37, 99, 235}, 2);
    p.points(x, y, "", {37, 99, 235}, 5);
    p.title("Original four factorizations: actual tests").x_label("log10 n").y_label("actual remainder tests");
    p.save_svg("build/trial_division_original.svg");
}
```
// result_begin: markdown
| n | prime factors | tests |
|---:|---|---:|
|360|`[2, 2, 2, 3, 3, 5]`|7|
|1001|`[7, 11, 13]`|8|
|2027|`[2027]`|23|
|1000000007|`[1000000007]`|15811|
\image(figures/trial_division_original.svg)
// result_end
