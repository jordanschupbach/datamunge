> The retained original experiment

```{cpp, results="markdown", file="figures/sundaram_sieve_original.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    auto r = a::sundaram_run(100);
    std::print("Original inclusive100 primes `{}`; count {}; actual strikes {}, distinct marks {}.\n\n| odd " "index | represented odd number | actual survives |\n| ---: | ---: | ---: |\n",
               r.primes, r.primes.size(), r.strikes, r.first_marks);
    std::vector<double> x, y;
    for (std::size_t i = 1; i < r.marked.size(); ++i) {
        x.push_back(2 * i + 1);
        y.push_back(r.marked[i] ? 0 : 1);
        std::print("| {} | {} | {} |\n", i, 2 * i + 1, y.back());
    }
    auto plot = g::RPlot::create();
    plot.lines(x, y, "actual native values", {37, 99, 235}).points(
        x, y, {37, 99, 235}, 4).title("Original bound100: actual final odd-candidate flags").x_label("represented odd integer").y_label("actual unmarked flag");
    plot.save_svg("build/sundaram_sieve_original.svg");
}
```
