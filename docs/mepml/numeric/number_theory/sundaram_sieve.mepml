> Actual selected work and sensitivity

```{cpp, results="markdown", file="figures/sundaram_sieve_work.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    std::vector<double> x, y;
    std::print("| bound | actual pair strikes | distinct marks | survivor tests |\n| ---: | ---: | ---: | " "---: |\n");
    for (std::uint64_t n : {100, 200, 500, 1000, 2000, 5000, 10000}) {
        auto r = a::sundaram_run(n);
        x.push_back(n);
        y.push_back(r.strikes);
        std::print("| {} | {} | {} | {} |\n", n, r.strikes, r.first_marks,
                   r.output_tests);
    }
    auto plot = g::RPlot::create();
    plot.lines(x, y, "actual native values", {37, 99, 235}).points(
        x, y, {37, 99, 235}, 4).title("Actual pair strikes include repeated odd composites").x_label("inclusive bound").y_label("actual i,j strikes");
    plot.save_svg("build/sundaram_sieve_work.svg");
}
```
