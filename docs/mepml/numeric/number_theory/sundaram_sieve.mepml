> Explicit controls

```{cpp, results="markdown", file="figures/sundaram_sieve_controls.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    std::vector<double> x, y;
    std::print("| inclusive bound | actual primes | actual odd marker cells | actual pair strikes |\n| ---: " "| --- | ---: | ---: |\n");
    for (std::uint64_t n = 0; n <= 12; ++n) {
        auto r = a::sundaram_run(n);
        x.push_back(n);
        y.push_back(r.primes.size());
        std::print("| {} | `{}` | {} | {} |\n", n, r.primes, r.marked.size(),
                   r.strikes);
    }
    auto plot = g::RPlot::create();
    plot.lines(x, y, "actual native values", {37, 99, 235}).points(
        x, y, {37, 99, 235}, 4).title("Inclusive small-bound controls handle2 separately").x_label("inclusive bound").y_label("actual prime count");
    plot.save_svg("build/sundaram_sieve_controls.svg");
}
```
