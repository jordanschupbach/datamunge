> The retained original experiment

```{cpp, results="markdown", file="figures/tonelli_shanks_original.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <filesystem>
#include <print>
#include <algorithm>
#include <cmath>
#include <limits>
#include <numeric>
#include <numbers>
#include <random>
#include <string>
#include <vector>
#include <map>
#include <set>
#include <array>
#include <tuple>
#include <bit>
#include <datamunge/random/quality.hpp>
#include <datamunge/algorithms/tonelli_shanks.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    std::print("| original n | prime p | root exists | actual smaller root |\n| ---: | ---: | --- | ---: " "|\n");
    for (auto[n, p] : std::vector<std::pair<std::uint64_t, std::uint64_t>>{
         {10, 13}, {2, 17}, {5, 7}
     }) {
        auto r = a::tonelli_shanks_run(n, p);
        std::print("| {} | {} | {} | {} |\n", n, p, r.result.exists,
                   r.result.root);
    }
    std::vector<double> x, y, z;
    std::print("\n| original residue modulo101 | actual smaller root | complementary root |\n| ---: | ---: " "| ---: |\n");
    for (std::uint64_t n = 0; n < 101; ++n) {
        auto r = a::tonelli_shanks_run(n, 101);
        if (r.result.exists) {
            auto other = r.result.root ? 101 - r.result.root : 0;
            x.push_back(n);
            y.push_back(r.result.root);
            z.push_back(other);
            std::print("| {} | {} | {} |\n", n, r.result.root, other);
        }
    }
    auto chart = g::RPlot::create();
    chart.points(x, y, "actual smaller roots", {37, 99, 235}, 4).points(
        x, z, "actual complementary roots", {220, 38, 38}, 4).size(760, 800).margins(80, 40, 72, 88).xlim(-2, 103).ylim(-2, 103).title("Original modulo101 roots; zero has one distinct root").x_label("quadratic residue").y_label("root representative");
    chart.save_svg("build/tonelli_shanks_original.svg");
}
```
