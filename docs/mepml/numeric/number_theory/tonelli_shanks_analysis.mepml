#include <set>
#include <array>
#include <tuple>
#include <bit>
#include <datamunge/random/quality.hpp>
#include <datamunge/algorithms/tonelli_shanks.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    std::vector<double> x, y;
    std::print("| residue modulo101 | actual auxiliary tests | actual refinements | actual root-kernel " "products |\n| ---: | ---: | ---: | ---: |\n");
    for (std::uint64_t n = 1; n < 101; ++n) {
        auto r = a::tonelli_shanks_run(n, 101);
        if (r.result.exists) {
            x.push_back(n);
            y.push_back(r.products);
            std::print("| {} | {} | {} | {} |\n", n, r.nonresidue_tests,
                       r.refinements, r.products);
        }
    }
    auto plot = g::RPlot::create();
    plot.lines(x, y, "actual native values", {37, 99, 235}).points(
        x, y, {37, 99, 235}, 4).title("Actual modular work varies across residues at fixed prime101").x_label("quadratic residue").y_label("actual root-kernel modular products");
    plot.save_svg("build/tonelli_shanks_work.svg");
}
