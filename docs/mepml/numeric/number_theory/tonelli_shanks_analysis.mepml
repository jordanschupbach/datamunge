> Explicit controls

```{cpp, results="markdown", file="figures/tonelli_shanks_controls.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <filesystem>
#include <print>
#include <algorithm>
#include <cmath>
#include <limits>
#include <numeric>
#include <numbers>
#include <random>
#include <string>
#include <vector>
#include <map>
#include <set>
#include <array>
#include <tuple>
#include <bit>
#include <datamunge/random/quality.hpp>
#include <datamunge/algorithms/tonelli_shanks.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    std::vector<double> x, y;
    std::print("| validated prime | radicand0 root | radicand1 smaller root | actual products for1 |\n| " "---: | ---: | ---: | ---: |\n");
    for (std::uint64_t p : {2, 3, 5, 7, 13, 17, 101, 257}) {
        auto z = a::tonelli_shanks_run(0, p);
        auto r = a::tonelli_shanks_run(1, p);
        x.push_back(p);
        y.push_back(r.products);
        std::print("| {} | {} | {} | {} |\n", p, z.result.root, r.result.root,
                   r.products);
    }
    for (std::uint64_t p : {0, 1, 4, 9, 15})
        try {
            a::tonelli_shanks_run(0, p);
        } catch (const std::invalid_argument &) {
            std::print("Malformed/nonprime modulus {} rejected even for radicand0.\n",
                       p);
        }
        auto plot = g::RPlot::create();
        plot.lines(x, y, "actual native values", {37, 99, 235}).points(
            x, y, {37, 99, 235}, 4).title("Prime validation precedes zero and direct-root shortcuts").x_label("validated prime modulus").y_label("actual root-kernel products for1");
        plot.save_svg("build/tonelli_shanks_controls.svg");
}
```
