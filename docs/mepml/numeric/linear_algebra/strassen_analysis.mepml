> Actual selected work and sensitivity

```{cpp, results="markdown", file="figures/strassen_work.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <filesystem>
#include <print>
#include <algorithm>
#include <cmath>
#include <limits>
#include <numeric>
#include <numbers>
#include <random>
#include <string>
#include <vector>
#include <map>
#include <set>
#include <array>
#include <tuple>
#include <bit>
#include <datamunge/random/quality.hpp>
#include <datamunge/algorithms/strassen.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    std::vector<double> x, y;
    std::print("| original square order | padded order | actual products | unpadded n cubed reference |\n| " "---: | ---: | ---: | ---: |\n");
    for (std::size_t n : {2, 16, 32, 64, 65, 100, 128}) {
        a::StrassenMatrix A(n, std::vector<double>(n, 1));
        auto r = a::strassen_run(A, A);
        x.push_back(n);
        y.push_back(r.scalar_products);
        std::print("| {} | {} | {} | {} |\n", n, r.padded_order,
                   r.scalar_products, n * n * n);
    }
    auto plot = g::RPlot::create();
    plot.lines(x, y, "actual executed values", {37, 99, 235}).points(
        x, y, {37, 99, 235}, 4).title("Actual default crossover and padding discontinuity").x_label("unpaded square order").y_label("actual scalar products");
    plot.save_svg("build/strassen_work.svg");
}
