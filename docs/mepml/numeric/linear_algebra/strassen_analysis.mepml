> The retained original experiment

```{cpp, results="markdown", file="figures/strassen_original.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <filesystem>
#include <print>
#include <algorithm>
#include <cmath>
#include <limits>
#include <numeric>
#include <numbers>
#include <random>
#include <string>
#include <vector>
#include <map>
#include <set>
#include <array>
#include <tuple>
#include <bit>
#include <datamunge/random/quality.hpp>
#include <datamunge/algorithms/strassen.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    auto small = a::strassen_run({{1, 2}, {3, 4}}, {{5, 6}, {7, 8}});
    std::print("Original2x2 default result `{}`, actual scalar products {} (default crossover64).\n",
               small.product, small.scalar_products);
    auto matrices = a::strassen_example_matrices();
    auto r = a::strassen_run(matrices[0], matrices[1]);
    auto ref = a::strassen_schoolbook_run(matrices[0], matrices[1]);
    double error = 0;
    for (std::size_t i = 0; i < 100; ++i)
        for (std::size_t j = 0; j < 100; ++j)
            error =
                std::max(error, std::abs(r.product[i][j] - ref.product[i][j]));
    std::print("Original100x100: padded order {}, actual products {}, unpadded reference products {}, " "maximum difference {:.9g}.\n\n| n | n cubed analytic reference | n^log2(7) analytic " "reference |\n| ---: | ---: | ---: |\n",
               r.padded_order, r.scalar_products, ref.scalar_products, error);
    std::vector<double> x, y, z;
    for (int e = 1; e <= 12; ++e) {
        double n = std::pow(2., e);
        x.push_back(n);
        y.push_back(n * n * n);
        z.push_back(std::pow(n, std::log2(7.)));
        std::print("| {:.0f} | {:.9g} | {:.9g} |\n", n, y.back(), z.back());
    }
    auto chart = g::RPlot::create();
    chart.lines(x, y, "n cubed analytic only", {220, 38, 38}).lines(
        x, z, "n^log2(7) analytic only", {37, 99, 235}).title(
        "Original powers through4096: analytic references, not executed matrices").x_label("reference order").y_label("analytic value");
    chart.save_svg("build/strassen_original.svg");
}
```
