> Explicit controls

```{cpp, results="markdown", file="figures/strassen_controls.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <filesystem>
#include <print>
#include <algorithm>
#include <cmath>
#include <limits>
#include <numeric>
#include <numbers>
#include <random>
#include <string>
#include <vector>
#include <map>
#include <set>
#include <array>
#include <tuple>
#include <bit>
#include <datamunge/random/quality.hpp>
#include <datamunge/algorithms/strassen.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    std::vector<double> x, y;
    std::print("| leaf crossover | actual2x2 scalar products | block additions | actual result |\n| ---: | " "---: | ---: | --- |\n");
    for (std::size_t threshold : {1, 2, 64}) {
        a::StrassenOptions o;
        o.leaf_size = threshold;
        auto r = a::strassen_run({{1, 2}, {3, 4}}, {{5, 6}, {7, 8}}, o);
        x.push_back(threshold);
        y.push_back(r.scalar_products);
        std::print("| {} | {} | {} | `{}` |\n", threshold, r.scalar_products,
                   r.block_additions, r.product);
    }
    auto plot = g::RPlot::create();
    plot.lines(x, y, "actual executed values", {37, 99, 235}).points(
        x, y, {37, 99, 235}, 4).title("Same2x2 product, explicitly different native crossover").x_label("leaf crossover").y_label("actual scalar products");
    plot.save_svg("build/strassen_controls.svg");
}
```
