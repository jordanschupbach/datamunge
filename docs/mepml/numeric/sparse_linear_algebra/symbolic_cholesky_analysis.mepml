> The retained original experiment

```{cpp, results="markdown", file="figures/symbolic_cholesky_original.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    auto adj = a::symbolic_cholesky_grid();
    auto r = a::symbolic_cholesky_run(adj);
    std::print("Original5x5 grid: {} input undirected edges, {} actual fill edges, {} off-diagonal factor " "entries.\n\n| actual lower row | structural columns |\n| ---: | --- |\n",
               r.input_edges, r.fill.size(), r.factor_entries);
    for (std::size_t i = 0; i < r.lower.size(); ++i)
        std::print("| {} | `{}` |\n", i, r.lower[i]);
    std::vector<double> ox, oy, fx, fy;
    for (std::size_t i = 0; i < adj.size(); ++i)
        for (int j : adj[i])
            if (j < int(i)) {
                ox.push_back(j);
    oy.push_back(-double(i));
            }
            for (auto[u, v] : r.fill) {
                fx.push_back(u);
                fy.push_back(-double(v));
            }
            auto chart = g::RPlot::create();
            chart.points(ox, oy, "original structural entries", {37, 99, 235}, 4).points(fx, fy, "actual new fill entries", {220, 38, 38}, 4).size(760, 800).margins(80, 40, 72, 88).xlim(-1, 25).ylim(-25, 1).title("Original5x5 grid: actual natural-order lower fill").x_label("column").y_label("negative row; row0 at top");
            chart.save_svg("build/symbolic_cholesky_original.svg");
}
```
