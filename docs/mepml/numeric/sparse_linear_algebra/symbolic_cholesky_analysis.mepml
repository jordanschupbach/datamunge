> Explicit controls

```{cpp, results="markdown", file="figures/symbolic_cholesky_controls.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    std::vector<std::vector<std::vector<int>> > graphs{{}, {{}}, {{1}, {0}},
                                                       {{1, 2}, {0}, {0}},
                                                       {{1}, {0, 2}, {1}}};
    std::vector<double> x, y;
    std::print("| control | input edges | actual new fill edges | pair tests |\n| ---: | ---: | ---: | ---: " "|\n");
    for (std::size_t i = 0; i < graphs.size(); ++i) {
        auto r = a::symbolic_cholesky_run(graphs[i]);
        x.push_back(i);
        y.push_back(r.fill.size());
        std::print("| {} | {} | {} | {} |\n", i, r.input_edges, r.fill.size(),
                   r.pair_tests);
    }
    auto plot = g::RPlot::create();
    plot.lines(x, y, "actual native values", {37, 99, 235}).points(
        x, y, {37, 99, 235}, 4).title("Empty, chain and center-first star structural controls").x_label("control index").y_label("actual new fill edges");
    plot.save_svg("build/symbolic_cholesky_controls.svg");
}
```
