> Actual selected work and sensitivity

```{cpp, results="markdown", file="figures/symbolic_cholesky_work.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    std::vector<double> x, y;
    std::print("| grid side | vertices | input edges | actual fill edges | pair attempts |\n| ---: | ---: | " "---: | ---: | ---: |\n");
    for (std::size_t side = 2; side <= 12; ++side) {
        auto r = a::symbolic_cholesky_run(a::symbolic_cholesky_grid(side));
        x.push_back(side * side);
        y.push_back(r.pair_tests);
        std::print("| {} | {} | {} | {} | {} |\n", side, side * side,
                   r.input_edges, r.fill.size(), r.pair_tests);
    }
    auto plot = g::RPlot::create();
    plot.lines(x, y, "actual native values", {37, 99, 235}).points(
        x, y, {37, 99, 235}, 4).title("Actual natural-order grid elimination pair work").x_label("grid vertices").y_label("actual higher-neighbor pairs");
    plot.save_svg("build/symbolic_cholesky_work.svg");
}
```
