> The retained original experiment

```{cpp, results="markdown", file="figures/summed_area_table_original.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <filesystem>
#include <print>
#include <algorithm>
#include <cmath>
#include <limits>
#include <numeric>
#include <numbers>
#include <random>
#include <string>
#include <vector>
#include <map>
#include <set>
#include <array>
#include <tuple>
#include <bit>
#include <datamunge/random/quality.hpp>
#include <datamunge/algorithms/summed_area_table.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    auto grid = a::summed_area_example_grid();
    a::SummedAreaTable sat(grid);
    std::print("| original inclusive rectangle | actual sum | actual mean | prefix reads |\n| --- | ---: | " "---: | ---: |\n");
    for (const auto &q : std::vector<std::array<std::size_t, 4>>{{0, 0, 5, 5},
                                                                 {0, 0, 2, 2},
                                                                 {2, 2, 4, 4},
                                                                 {1, 3, 4, 5}}) {
        auto r = sat.query(q[0], q[1], q[2], q[3]);
        std::print("| `{}` | {} | {} | {} |\n", q, r.value,
                   sat.rect_mean(q[0], q[1], q[2], q[3]), r.lookups);
    }
    std::print("\n| original radius about(3,3) | actual box mean |\n| ---: | ---: |\n");
    for (std::size_t radius = 0; radius <= 2; ++radius)
        std::print("| {} | {} |\n", radius,
                   sat.rect_mean(3 - radius, 3 - radius, 3 + radius, 3 + radius));
    std::vector<double> x, y;
    for (std::size_t k = 0; k < 6; ++k) {
        x.push_back(k);
        y.push_back(sat.rect_sum(0, 0, k, k));
    }
    auto plot = g::RPlot::create();
    plot.lines(x, y, "actual native values", {37, 99, 235}).points(
        x, y, {37, 99, 235}, 4).title("Original1..36 grid: actual diagonal prefix sums").x_label("last row and column").y_label("actual inclusive prefix sum");
    plot.save_svg("build/summed_area_table_original.svg");
}
```
