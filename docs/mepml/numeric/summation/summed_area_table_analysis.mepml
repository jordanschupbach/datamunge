> Actual selected work and sensitivity

```{cpp, results="markdown", file="figures/summed_area_table_work.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <filesystem>
#include <print>
#include <algorithm>
#include <cmath>
#include <limits>
#include <numeric>
#include <numbers>
#include <random>
#include <string>
#include <vector>
#include <map>
#include <set>
#include <array>
#include <tuple>
#include <bit>
#include <datamunge/random/quality.hpp>
#include <datamunge/algorithms/summed_area_table.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    std::vector<double> x, y;
    std::print("| grid side | actual input cells | zero-bordered cells | actual captured build transitions " "|\n| ---: | ---: | ---: | ---: |\n");
    for (std::size_t n : {1, 2, 4, 8, 16, 32, 64}) {
        a::SummedAreaTable s(std::vector<std::vector<double>>(
                             n, std::vector<double>(n, 1)), {.capture = true});
        x.push_back(n * n);
        y.push_back(s.steps().size());
        std::print("| {} | {} | {} | {} |\n", n, n * n,
                   s.prefix().size() * s.prefix()[0].size(), s.steps().size());
    }
    auto plot = g::RPlot::create();
    plot.lines(x, y, "actual native values", {37, 99, 235}).points(
        x, y, {37, 99, 235}, 4).title("Actual build visits every supplied grid cell once").x_label("input cells").y_label("actual prefix transitions");
    plot.save_svg("build/summed_area_table_work.svg");
}
```
