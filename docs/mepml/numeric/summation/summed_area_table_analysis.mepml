> Explicit controls

```{cpp, results="markdown", file="figures/summed_area_table_controls.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <filesystem>
#include <print>
#include <algorithm>
#include <cmath>
#include <limits>
#include <numeric>
#include <numbers>
#include <random>
#include <string>
#include <vector>
#include <map>
#include <set>
#include <array>
#include <tuple>
#include <bit>
#include <datamunge/random/quality.hpp>
#include <datamunge/algorithms/summed_area_table.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    std::vector<double> x, y;
    std::print("| side | actual rectangle area | actual prefix reads | actual sum |\n| ---: | ---: | ---: | " "---: |\n");
    a::SummedAreaTable sat(a::summed_area_example_grid());
    for (std::size_t k = 1; k <= 6; ++k) {
        auto q = sat.query(0, 0, k - 1, k - 1);
        x.push_back(k * k);
        y.push_back(q.lookups);
        std::print("| {} | {} | {} | {} |\n", k, k * k, q.lookups, q.value);
    }
    try {
        sat.rect_sum(4, 0, 2, 1);
    } catch (const std::out_of_range &) {
        std::print("Reversed inclusive rectangle rejected.\n");
    }
    auto plot = g::RPlot::create();
    plot.lines(x, y, "actual native values", {37, 99, 235}).points(
        x, y, {37, 99, 235}, 4).title("Actual query reads are independent of rectangle area").x_label("rectangle cells").y_label("actual prefix lookups");
    plot.save_svg("build/summed_area_table_controls.svg");
}
```
// result_begin: markdown
| side | actual rectangle area | actual prefix reads | actual sum |
| ---: | ---: | ---: | ---: |
