> Explicit controls

```{cpp, results="markdown", file="figures/ternary_search_controls.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <filesystem>
#include <print>
#include <algorithm>
#include <cmath>
#include <limits>
#include <numeric>
#include <numbers>
#include <random>
#include <string>
#include <vector>
#include <map>
#include <set>
#include <array>
#include <tuple>
#include <bit>
#include <datamunge/random/quality.hpp>
#include <datamunge/algorithms/ternary_search.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    std::vector<double> x, y;
    std::print("| cap | actual reductions | actual callback evaluations | tolerance met | precision limited " "|\n| ---: | ---: | ---: | --- | --- |\n");
    for (int cap : {0, 1, 2, 5, 20, 200}) {
        a::TernaryOptions o;
        o.max_iterations = cap;
        auto r = a::ternary_search_max_run([](double x) {
            return -(x - 1) * (x - 1);
        }, 0, 5, o);
        x.push_back(cap);
        y.push_back(r.evaluations);
        std::print("| {} | {} | {} | {} | {} |\n", cap, r.result.iterations,
                   r.evaluations, r.converged, r.precision_limited);
    }
    a::TernaryOptions o;
    o.tolerance = 0;
    auto adjacent = a::ternary_search_max_run([](double x) {
        return x;
    }, 1, std::nextafter(1., 2.), o);
    std::print("Adjacent endpoints with zero tolerance: converged {}, precision limited {}, evaluations " "{}.\n",
               adjacent.converged, adjacent.precision_limited,
               adjacent.evaluations);
    auto plot = g::RPlot::create();
    plot.lines(x, y, "actual native values", {37, 99, 235}).points(
        x, y, {37, 99, 235}, 4).title("Actual iteration caps include one final midpoint evaluation").x_label("requested reduction cap").y_label("actual objective calls");
    plot.save_svg("build/ternary_search_controls.svg");
}
```
