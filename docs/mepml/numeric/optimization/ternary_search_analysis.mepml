> Actual selected work and sensitivity

```{cpp, results="markdown", file="figures/ternary_search_work.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <filesystem>
#include <print>
#include <algorithm>
#include <cmath>
#include <limits>
#include <numeric>
#include <numbers>
#include <random>
#include <string>
#include <vector>
#include <map>
#include <set>
#include <array>
#include <tuple>
#include <bit>
#include <datamunge/random/quality.hpp>
#include <datamunge/algorithms/ternary_search.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    std::vector<double> x, y;
    std::print("| requested tolerance | actual reductions | actual final width | evaluations |\n| ---: | " "---: | ---: | ---: |\n");
    for (int digits = 1; digits <= 12; ++digits) {
        a::TernaryOptions o;
        o.tolerance = std::pow(10., -digits);
        auto r = a::ternary_search_max_run([](double x) {
            return x * std::exp(-x);
        }, 0, 5, o);
        x.push_back(digits);
        y.push_back(r.result.iterations);
        std::print("| {:.9g} | {} | {:.12g} | {} |\n", o.tolerance,
                   r.result.iterations, r.hi - r.lo, r.evaluations);
    }
    auto plot = g::RPlot::create();
    plot.lines(x, y, "actual native values", {37, 99, 235}).points(
        x, y, {37, 99, 235}, 4).title("Actual precision demand versus bracket reductions").x_label("requested decimal tolerance digits").y_label("actual completed reductions");
    plot.save_svg("build/ternary_search_work.svg");
}
```
