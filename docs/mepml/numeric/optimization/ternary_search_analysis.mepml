> The retained original experiment

```{cpp, results="markdown", file="figures/ternary_search_original.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <filesystem>
#include <print>
#include <algorithm>
#include <cmath>
#include <limits>
#include <numeric>
#include <numbers>
#include <random>
#include <string>
#include <vector>
#include <map>
#include <set>
#include <array>
#include <tuple>
#include <bit>
#include <datamunge/random/quality.hpp>
#include <datamunge/algorithms/ternary_search.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    auto f = [](double x) { return x * std::exp(-x); };
    auto r = a::ternary_search_max_trace(f, 0, 5);
    auto mn = a::ternary_search_min_run([](double x) {
        return (x - 3) * (x - 3) + 1;
    }, -10, 10);
    std::print("Original x*exp(-x) maximum x {:.12g}, f {:.12g}, iterations {}, converged {}; minimum " "quadratic x {:.12g}, f {:.12g}.\n\n| actual completed reduction | actual log width | " "exact-arithmetic reference log width |\n| ---: | ---: | ---: |\n",
               r.result.x, r.result.value, r.result.iterations, r.converged,
               mn.result.x, mn.result.value);
    std::vector<double> x, y, z;
    x.push_back(0);
    y.push_back(std::log10(5.));
    z.push_back(std::log10(5.));
    for (std::size_t i = 0; i < r.steps.size(); ++i) {
        const auto &s = r.steps[i];
        x.push_back(i + 1);
        y.push_back(std::log10(s.hi_after - s.lo_after));
        z.push_back(std::log10(5.) + (i + 1) * std::log10(2. / 3));
        std::print("| {} | {:.12g} | {:.12g} |\n", i + 1, y.back(), z.back());
    }
    auto chart = g::RPlot::create();
    chart.lines(x, y, "actual native log width", {37, 99, 235}).lines(
        x, z, "analytic2/3 reference", {220, 38, 38}).points(x, y,
                                                             {37, 99, 235}, 3).title("Original[0,5] peak: actual and analytic bracket contraction").x_label("completed reductions").y_label("log10 interval width");
    chart.save_svg("build/ternary_search_original.svg");
}
```
