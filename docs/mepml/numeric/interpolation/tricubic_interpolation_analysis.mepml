> Checking the theory and controls

```{cpp, results="markdown", file="figures/tricubic_interpolation_controls.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <filesystem>
#include <print>
#include <algorithm>
#include <cmath>
#include <limits>
#include <numeric>
#include <numbers>
#include <random>
#include <string>
#include <vector>
#include <map>
#include <set>
#include <array>
#include <tuple>
#include <bit>
#include <datamunge/random/quality.hpp>
#include <datamunge/algorithms/tricubic_interpolation.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    std::vector<double> axis{0, 1, 2, 3}, v(64);
    std::iota(v.begin(), v.end(), 0.);
    std::vector<double> x, y;
    std::print("| query coordinate | actual value | linear truth |\n|---:|---:|---:|\n");
    for (double q : {0., .25, .5, 1., 1.5, 2., 2.5, 3.}) {
        auto r = a::tricubic_work(axis, axis, axis, v, q, q, q);
        std::print("|{}|{}|{}|\n", q, r.value, 21 * q);
        x.push_back(q);
        y.push_back(r.value - 21 * q);
    }
    auto p = g::RPlot::create();
    p.line(x, y, "actual", {37, 99, 235}, 2);
    p.points(x, y, "", {37, 99, 235}, 5);
    p.title("Clamping changes linear reproduction near boundaries").x_label(
        "q on diagonal").y_label("actual error against21q");
    p.save_svg("build/tricubic_interpolation_controls.svg");
}
```
