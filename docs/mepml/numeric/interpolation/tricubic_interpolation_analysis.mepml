> Sensitivity and selected work

```{cpp, results="markdown", file="figures/tricubic_interpolation_work.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <filesystem>
#include <print>
#include <algorithm>
#include <cmath>
#include <limits>
#include <numeric>
#include <numbers>
#include <random>
#include <string>
#include <vector>
#include <map>
#include <set>
#include <array>
#include <tuple>
#include <bit>
#include <datamunge/random/quality.hpp>
#include <datamunge/algorithms/tricubic_interpolation.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    auto r = a::tricubic_example();
    std::vector<double> x, y;
    std::print("| x | actual cubic absolute error | actual linear absolute error |\n|---:|---:|---:|\n");
    for (std::size_t i = 0; i < r.x.size(); ++i) {
        double e = std::abs(r.cubic[i] - r.truth[i]);
        x.push_back(r.x[i]);
        y.push_back(e);
        if (i % 10 == 0)
            std::print("|{}|{}|{}|\n", r.x[i], e,
                       std::abs(r.linear[i] - r.truth[i]));
    }
    auto p = g::RPlot::create();
    p.line(x, y, "actual", {37, 99, 235}, 2);
    p.points(x, y, "", {37, 99, 235}, 5);
    p.title("Original line error includes boundary effects").x_label("x").y_label("actual tricubic absolute error");
    p.save_svg("build/tricubic_interpolation_work.svg");
}
```
