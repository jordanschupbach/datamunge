> The retained original experiment

```{cpp, results="markdown", file="figures/tricubic_interpolation_original.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <filesystem>
#include <print>
#include <algorithm>
#include <cmath>
#include <limits>
#include <numeric>
#include <numbers>
#include <random>
#include <string>
#include <vector>
#include <map>
#include <set>
#include <array>
#include <tuple>
#include <bit>
#include <datamunge/random/quality.hpp>
#include <datamunge/algorithms/tricubic_interpolation.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    auto r = a::tricubic_example();
    std::print("| x | truth | cubic | linear |\n|---:|---:|---:|---:|\n");
    for (std::size_t i = 0; i < r.x.size(); i += 10)
        std::print("|{}|{}|{}|{}|\n", r.x[i], r.truth[i], r.cubic[i],
                   r.linear[i]);
    auto p = g::RPlot::create();
    p.line(r.x, r.truth, "analytic truth", {31, 41, 55}, 2.5);
    p.line(r.x, r.cubic, "actual tricubic", {37, 99, 235});
    p.line(r.x, r.linear, "actual trilinear", {220, 38, 38});
    p.title("Original9-cubed smooth field, y.35 z-.5").x_label("x").y_label(
        "field");
    p.save_svg("build/tricubic_interpolation_original.svg");
}
```
