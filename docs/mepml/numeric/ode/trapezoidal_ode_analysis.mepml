> Explicit controls

```{cpp, results="markdown", file="figures/trapezoidal_ode_controls.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <filesystem>
#include <print>
#include <algorithm>
#include <cmath>
#include <limits>
#include <numeric>
#include <numbers>
#include <random>
#include <string>
#include <vector>
#include <map>
#include <set>
#include <array>
#include <tuple>
#include <bit>
#include <datamunge/random/quality.hpp>
#include <datamunge/algorithms/trapezoidal_ode.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    std::vector<double> x, y;
    std::print("| Newton cap | accepted all steps | stop | actual accepted steps | actual correction " "assignments | actual final candidate residual |\n| ---: | --- | --- | ---: | ---: | ---: " "|\n");
    for (int cap : {0, 1, 2, 4, 8, 60}) {
        a::TrapezoidOptions o;
        o.max_newton_iterations = cap;
        auto r = a::trapezoidal_ode_run([](double, double y) {
            return -y;
        }, 1, 0, 1, 10, o);
        x.push_back(cap);
        y.push_back(r.completed_steps);
        std::print("| {} | {} | {} | {} | {} | {:.9g} |\n", cap, r.converged,
                   r.stop, r.completed_steps, r.newton_updates,
                   r.steps.back().residual);
    }
    auto plot = g::RPlot::create();
    plot.lines(x, y, "actual native values", {37, 99, 235}).points(
        x, y, {37, 99, 235}, 4).title("Unresolved implicit solves do not enter the accepted trajectory").x_label("per-step Newton assignment cap").y_label("actually accepted time steps");
    plot.save_svg("build/trapezoidal_ode_controls.svg");
}
```
