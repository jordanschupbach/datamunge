> Actual selected work and sensitivity

```{cpp, results="markdown", file="figures/trapezoidal_ode_work.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <filesystem>
#include <print>
#include <algorithm>
#include <cmath>
#include <limits>
#include <numeric>
#include <numbers>
#include <random>
#include <string>
#include <vector>
#include <map>
#include <set>
#include <array>
#include <tuple>
#include <bit>
#include <datamunge/random/quality.hpp>
#include <datamunge/algorithms/trapezoidal_ode.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    auto r = a::trapezoidal_ode_run([](double, double y) {
        return -50 * y;
    }, 1, 0, 1, 10);
    std::vector<double> x, y, z;
    std::print("| actual accepted time | actual stiff value | exact exponential reference | actual implicit " "residual |\n| ---: | ---: | ---: | ---: |\n");
    for (std::size_t i = 0; i < r.trajectory.size(); ++i) {
        auto[t, value] = r.trajectory[i];
        x.push_back(t);
        y.push_back(value);
        z.push_back(std::exp(-50 * t));
        std::print("| {:.9g} | {:.12g} | {:.12g} | {:.9g} |\n", t, value,
                   z.back(), i ? r.steps[i - 1].residual : 0);
    }
    auto chart = g::RPlot::create();
    chart.lines(x, y, "actual solved trapezoidal values", {37, 99, 235}).points(
        x, y, {37, 99, 235}, 4).lines(x, z, "exact exp(-50t) reference",
                                      {17, 24, 39}).title(
        "Actual stiff oscillations: A-stability does not imply L-stability").x_label("accepted time").y_label("state value");
    chart.save_svg("build/trapezoidal_ode_work.svg");
}
```
