> The retained original experiment

```{cpp, results="markdown", file="figures/trapezoidal_ode_original.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <filesystem>
#include <print>
#include <algorithm>
#include <cmath>
#include <limits>
#include <numeric>
#include <numbers>
#include <random>
#include <string>
#include <vector>
#include <map>
#include <set>
#include <array>
#include <tuple>
#include <bit>
#include <datamunge/random/quality.hpp>
#include <datamunge/algorithms/trapezoidal_ode.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    std::vector<double> x, y, reference;
    double previous = 0;
    std::print("| original steps | h | actual final error against exp(-1) | preceding error ratio | actual " "accepted steps | RHS calls |\n| ---: | ---: | ---: | ---: | ---: | ---: |\n");
    for (int n = 4; n <= 256; n *= 2) {
        auto r = a::trapezoidal_ode_run([](double, double y) {
            return -y;
        }, 1, 0, 1, n);
        if (!r.converged)
            throw std::runtime_error(r.stop);
        double error = std::abs(r.trajectory.back().second - std::exp(-1.));
        x.push_back(std::log10(1. / n));
        y.push_back(std::log10(error));
        std::print("| {} | {:.9g} | {:.12g} | {:.9g} | {} | {} |\n", n, 1. / n,
                   error, previous ? previous / error : 0, r.completed_steps,
                   r.evaluations);
        previous = error;
    }
    for (double lx : x)
        reference.push_back(2 * lx + y.front() - 2 * x.front());
    auto stiff = a::trapezoidal_ode_run([](double, double y) {
        return -50 * y;
    }, 1, 0, 1, 10);
    std::print("Original stiff -50y with h.1: converged {}, actual final y {:.12g}, mathematical " "amplification reference {:.12g}.\n",
               stiff.converged, stiff.trajectory.back().second,
               std::pow(-3. / 7, 10));
    auto chart = g::RPlot::create();
    chart.lines(x, y, "actual solved final error", {37, 99, 235}).points(
        x, y, {37, 99, 235}, 4).lines(x, reference, "analytic slope2 reference",
                                      {148, 163, 184}).title(
        "Original decay study: actual implicit trapezoidal convergence").x_label("log10 h").y_label("log10 final error");
    chart.save_svg("build/trapezoidal_ode_original.svg");
}
```
