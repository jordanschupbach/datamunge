> The retained original experiment

```{cpp, results="markdown", file="figures/verlet_original.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    auto accel = [](const std::vector<double> & x) {
        return std::vector<double>{-x[0]};
    };
    auto vv = a::velocity_verlet(accel, {1}, {0}, 0, 50, 2000);
    auto fe = a::euler_method([](double, const std::vector<double> & z) {
        return std::vector<double>{z[1], -z[0]};
    }, {1, 0}, 0, 50, 2000);
    std::vector<double> energy, euler;
    for (std::size_t i = 0; i < vv.t.size(); ++i) {
        energy.push_back(.5 * (vv.x[i][0] * vv.x[i][0] + vv.v[i][0] * vv.v[i][0]));
        euler.push_back(.5 * (fe.y[i][0] * fe.y[i][0] + fe.y[i][1] * fe.y[i][1]));
    }
    std::print("| actual Verlet min energy | max energy | Euler final energy | actual x50 | exact cos50 " "|\n|---:|---:|---:|---:|---:|\n|{}|{}|{}|{}|{}|\n",
               *std::min_element(energy.begin(), energy.end()),
               *std::max_element(energy.begin(), energy.end()), euler.back(),
               vv.x.back()[0], std::cos(50.));
    auto p = g::RPlot::create();
    p.line(vv.t, energy, "actual Verlet", {37, 99, 235});
    p.line(fe.t, euler, "actual forward Euler", {220, 38, 38});
    p.title("Original oscillator:2000 steps over [0,50]").x_label("time").y_label("physical energy");
    p.save_svg("build/verlet_original.svg");
}
```
// result_begin: markdown
| actual Verlet min energy | max energy | Euler final energy | actual x50 | exact cos50 |
