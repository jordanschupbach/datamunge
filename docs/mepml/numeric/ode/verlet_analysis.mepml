> Sensitivity and selected work

```{cpp, results="markdown", file="figures/verlet_work.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    std::vector<double> x, y;
    std::print("| steps to t1 | actual final absolute x error | acceleration calls |\n|---:|---:|---:|\n");
    for (int n : {4, 8, 16, 32, 64, 128, 256}) {
        auto r = a::velocity_verlet_work([](const std::vector<double> & x) {
            return std::vector<double>{-x[0]};
        }, {1}, {0}, 0, 1, n);
        double error = std::abs(r.solution.x.back()[0] - std::cos(1.));
        std::print("|{}|{}|{}|\n", n, error, r.acceleration_calls);
        x.push_back(std::log2(n));
        y.push_back(std::log2(error));
    }
    auto p = g::RPlot::create();
    p.line(x, y, "actual", {37, 99, 235}, 2);
    p.points(x, y, "", {37, 99, 235}, 5);
    p.title("Actual final-position error: slope near -2 in log2 coordinates").x_label("log2 steps").y_label("log2 actual absolute error");
    p.save_svg("build/verlet_work.svg");
}
```
