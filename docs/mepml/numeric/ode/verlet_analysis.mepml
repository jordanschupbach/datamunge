> Checking the theory and controls

```{cpp, results="markdown", file="figures/verlet_controls.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    std::vector<double> x, y;
    std::print("| h | actual x after10 steps | actual energy |\n|---:|---:|---:|\n");
    for (double h : {.1, .5, 1., 1.9, 2., 2.1}) {
        auto r = a::velocity_verlet([](const std::vector<double> & x) {
            return std::vector<double>{-x[0]};
        }, {1}, {0}, 0, 10 * h, 10);
        double energy =
            .5 * (std::pow(r.x.back()[0], 2) + std::pow(r.v.back()[0], 2));
        std::print("|{}|{}|{}|\n", h, r.x.back()[0], energy);
        x.push_back(h);
        y.push_back(energy);
    }
    auto p = g::RPlot::create();
    p.line(x, y, "actual", {37, 99, 235}, 2);
    p.points(x, y, "", {37, 99, 235}, 5);
    p.title("Oscillator step-size stability has a boundary at |h|2").x_label(
        "step h").y_label("actual final physical energy");
    p.save_svg("build/verlet_controls.svg");
}
```
