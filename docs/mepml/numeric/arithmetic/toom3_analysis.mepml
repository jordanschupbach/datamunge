> The retained original experiment

```{cpp, results="markdown", file="figures/toom3_original.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <filesystem>
#include <print>
#include <algorithm>
#include <cmath>
#include <limits>
#include <numeric>
#include <numbers>
#include <random>
#include <string>
#include <vector>
#include <map>
#include <set>
#include <array>
#include <tuple>
#include <bit>
#include <datamunge/random/quality.hpp>
#include <datamunge/algorithms/toom3.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    const std::string a0 =
        "31415926535897932384626433832795028841971693993751", b0 =
        "27182818284590452353602874713526624977572470936999";
    auto r = a::toom3_run(a0, b0);
    std::print("Original product {}; digits {}; matches native Karatsuba {}; actual Toom calls {}, " "Karatsuba calls {}, scalar leaves {}.\nRepunit R9 squared {}.\n\n| reference digits | " "schoolbook n^2 | Karatsuba n^log2(3) | Toom n^log3(5) |\n| ---: | ---: | ---: | ---: |\n",
               r.value, r.value.size(),
               r.value == a::karatsuba_multiply(a0, b0), r.toom_calls,
               r.karatsuba_calls, r.schoolbook_calls,
               a::toom3_mul("111111111", "111111111"));
    std::vector<double> x, y, z, w;
    for (int n = 3; n <= 81; n += 3) {
        x.push_back(n);
        y.push_back(n * n);
        z.push_back(std::pow(n, std::log2(3.)));
        w.push_back(std::pow(n, std::log(5.) / std::log(3.)));
        std::print("| {} | {} | {:.9g} | {:.9g} |\n", n, n * n, z.back(),
                   w.back());
    }
    auto chart = g::RPlot::create();
    chart.lines(x, y, "analytic n squared", {220, 38, 38}).lines(
        x, z, "analytic Karatsuba exponent", {5, 150, 105}).lines(
        x, w, "analytic Toom exponent", {37, 99, 235}).title(
        "Original digit-exponent references: analytic, not timing").x_label(
        "reference digits").y_label("analytic arithmetic reference");
    chart.save_svg("build/toom3_original.svg");
}
```
