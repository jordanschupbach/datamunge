> Explicit controls

```{cpp, results="markdown", file="figures/toom3_controls.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <filesystem>
#include <print>
#include <algorithm>
#include <cmath>
#include <limits>
#include <numeric>
#include <numbers>
#include <random>
#include <string>
#include <vector>
#include <map>
#include <set>
#include <array>
#include <tuple>
#include <bit>
#include <datamunge/random/quality.hpp>
#include <datamunge/algorithms/toom3.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    std::vector<std::pair<std::string, std::string>> cases{
        {"", "123"}, {"00012", "003"}, {"0", "999"}, {"123", "456"},
        {"111111111", "111111111"}
    };
    std::vector<double> x, y;
    std::print("| supplied operands | actual normalized product | actual Toom calls | actual scalar " "products |\n| --- | --- | ---: | ---: |\n");
    for (std::size_t i = 0; i < cases.size(); ++i) {
        auto r = a::toom3_run(cases[i].first, cases[i].second);
        x.push_back(i);
        y.push_back(r.scalar_products);
        std::print("| `{}` times `{}` | {} | {} | {} |\n",
                   cases[i].first.empty() ? "(empty)" : cases[i].first,
                   cases[i].second, r.value, r.toom_calls, r.scalar_products);
    }
    auto plot = g::RPlot::create();
    plot.lines(x, y, "actual native values", {37, 99, 235}).points(
        x, y, {37, 99, 235}, 4).title("Small and leading-zero controls use actual crossover branches").x_label("control index").y_label("actual schoolbook scalar products");
    plot.save_svg("build/toom3_controls.svg");
}
```
