        y.push_back(r.scalar_products);
        std::print("| {} | {} | {} | {} | {} | {} |\n", n, r.toom_calls,
                   r.karatsuba_calls, r.schoolbook_calls, r.scalar_products,
                   r.operations);
    }
    auto plot = g::RPlot::create();
    plot.lines(x, y, "actual native values", {37, 99, 235}).points(
        x, y, {37, 99, 235}, 4).title("Actual default Toom and Karatsuba crossover work").x_label("digits per operand").y_label("actual schoolbook coefficient products");
    plot.save_svg("build/toom3_work.svg");
}
