    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    std::vector<double> x, y;
    std::print("| digits per repeated9 operand | actual Toom internals | Karatsuba internals | schoolbook " "leaves | scalar products | selected arithmetic |\n| ---: | ---: | ---: | ---: | ---: | ---: " "|\n");
    for (std::size_t n : {8, 16, 32, 48, 49, 64, 128, 256, 512, 1024}) {
        auto r = a::toom3_run(std::string(n, '9'), std::string(n, '9'));
