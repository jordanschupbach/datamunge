> Actual selected work and sensitivity

```{cpp, results="markdown", file="figures/srt_division_work.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    std::vector<double> x, y;
    std::print("| requested digits | actual emitted digits | actual -1 / 0 / +1 counts |\n| ---: | ---: | " "--- |\n");
    for (int b : {0, 4, 16, 40, 80, 256, 1024}) {
        auto r = a::srt_division_run(.7, .9, b);
        x.push_back(b);
        y.push_back(r.digits.size());
        std::print("| {} | {} | `{}` |\n", b, r.digits.size(), r.counts);
    }
    auto plot = g::RPlot::create();
    plot.lines(x, y, "actual executed values", {37, 99, 235}).points(
        x, y, {37, 99, 235}, 4).title("Actual output grows with requested precision").x_label("requested digits").y_label("actual emitted digits");
    plot.save_svg("build/srt_division_work.svg");
}
```
