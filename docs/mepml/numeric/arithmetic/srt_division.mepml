> The retained original experiment

```{cpp, results="markdown", file="figures/srt_division_original.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    auto r = a::srt_division_trace(.7, .9, 40);
    std::print("Original N=.7,D=.9,bits40; first16 digits `{}`; quotient {:.17g}; native division {:.17g}; " "absolute error {:.9g}.\n",
               std::vector<int>(r.digits.begin(), r.digits.begin() + 16),
               r.value, .7 / .9, std::abs(r.value - .7 / .9));
    std::vector<double> x, y;
    std::print("| actual first24 steps | remainder |\n| ---: | ---: |\n");
    for (std::size_t i = 0; i < 24; ++i) {
        x.push_back(i + 1);
        y.push_back(r.steps[i].after);
        std::print("| {} | {:.12g} |\n", i + 1, y.back());
    }
    auto plot = g::RPlot::create();
    plot.lines(x, y, "actual executed values", {37, 99, 235}).points(
        x, y, {37, 99, 235}, 4).title("Original .7/.9: actual first24 remainders").x_label("emitted digits").y_label("normalized remainder");
    plot.save_svg("build/srt_division_original.svg");
}
```
