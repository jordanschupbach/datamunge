> Explicit controls

```{cpp, results="markdown", file="figures/srt_division_controls.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    std::vector<double> x, y;
    std::print("| bits | actual quotient | actual error | nominal exact-arithmetic tail |\n| ---: | ---: | " "---: | ---: |\n");
    for (int b : {0, 1, 2, 4, 8, 16, 32, 53, 80}) {
        auto r = a::srt_division_run(.7, .9, b);
        x.push_back(b);
        y.push_back(std::log10(std::max(std::abs(r.value - .7 / .9), 1e-17)));
        std::print("| {} | {:.17g} | {:.9g} | {:.9g} |\n", b, r.value,
                   std::abs(r.value - .7 / .9), r.nominal_tail_bound);
    }
    try {
        a::srt_division_run(1, 0, 4);
    } catch (const std::invalid_argument &) {
        std::print("Zero divisor rejected before normalization.\n");
    }
    auto plot = g::RPlot::create();
    plot.lines(x, y, "actual executed values", {37, 99, 235}).points(
        x, y, {37, 99, 235}, 4).title("Actual error reaches floating precision").x_label("requested digits").y_label("log10 error; display floor1e-17");
    plot.save_svg("build/srt_division_controls.svg");
}
```
