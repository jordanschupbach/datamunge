> Actual selected work and sensitivity

```{cpp, results="markdown", file="figures/stone_sip_work.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    std::vector<double> x, y;
    std::print("| square side | cells | actual factors | residual products | triangular visits | correction " "assignments |\n| ---: | ---: | ---: | ---: | ---: | ---: |\n");
    for (int n : {2, 4, 8, 16, 30}) {
        auto grid = a::stone_poisson_example(n, n);
        a::StoneOptions o;
        o.max_iterations = 10;
        auto r = a::stone_sip_run(grid, o);
        x.push_back(n * n);
        y.push_back(r.factorized_cells + r.residual_products +
                    r.triangular_cells + r.correction_assignments);
        std::print("| {} | {} | {} | {} | {} | {} |\n", n, n * n,
                   r.factorized_cells, r.residual_products, r.triangular_cells,
                   r.correction_assignments);
    }
    auto plot = g::RPlot::create();
    plot.lines(x, y, "actual executed values", {37, 99, 235}).points(
        x, y, {37, 99, 235}, 4).title("Actual selected grid visits through at most ten corrections").x_label("cells").y_label("actual selected visits");
    plot.save_svg("build/stone_sip_work.svg");
}
```
