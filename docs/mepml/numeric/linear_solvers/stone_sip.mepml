> Explicit controls

```{cpp, results="markdown", file="figures/stone_sip_controls.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    auto grid = a::stone_poisson_example(5, 5);
    std::vector<double> x, y;
    std::print("| correction cap | completed corrections | matching final residual | converged |\n| ---: | " "---: | ---: | --- |\n");
    for (int cap : {0, 1, 2, 5, 10, 20}) {
        a::StoneOptions o;
        o.max_iterations = cap;
        auto r = a::stone_sip_run(grid, o);
        x.push_back(cap);
        y.push_back(r.result.residual);
        std::print("| {} | {} | {:.12g} | {} |\n", cap, r.result.iterations,
                   r.result.residual, r.converged);
    }
    auto plot = g::RPlot::create();
    plot.lines(x, y, "actual executed values", {37, 99, 235}).points(
        x, y, {37, 99, 235}, 4).title("Zero and exhausted correction caps retain honest residuals").x_label("correction cap").y_label("actual final residual");
    plot.save_svg("build/stone_sip_controls.svg");
}
```
