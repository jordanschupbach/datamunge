> The retained original experiment

```{cpp, results="markdown", file="figures/stone_sip_original.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    auto grid = a::stone_poisson_example();
    a::StoneOptions o;
    o.max_iterations = 500;
    o.tolerance = 1e-12;
    auto r = a::stone_sip_trace(grid, o);
    double error = 0;
    for (std::size_t i = 0; i < grid.known.size(); ++i)
        error = std::max(error, std::abs(r.result.x[i] - grid.known[i]));
    std::print("Original30x30 seed1: {} completed corrections, final residual {:.9g}, max known-solution " "error {:.9g}, converged {}.\n\n| original cap | actual completed corrections | residual at " "returned iterate |\n| ---: | ---: | ---: |\n",
               r.result.iterations, r.result.residual, error, r.converged);
    for (int cap : {1, 2, 5, 10, 20, 40, 60, 80}) {
        o.max_iterations = cap;
        auto c = a::stone_sip_run(grid, o);
        std::print("| {} | {} | {:.12g} |\n", cap, c.result.iterations,
                   c.result.residual);
    }
    std::vector<double> x, y;
    for (const auto &s : r.history) {
        x.push_back(s.iteration);
        y.push_back(std::log10(std::max(s.residual, 1e-16)));
    }
    auto plot = g::RPlot::create();
    plot.lines(x, y, "actual executed values", {37, 99, 235}).points(
        x, y, {37, 99, 235}, 4).title("Original Poisson system: actual post-correction residual history").x_label("completed corrections").y_label("log10 Euclidean residual");
    plot.save_svg("build/stone_sip_original.svg");
}
```
