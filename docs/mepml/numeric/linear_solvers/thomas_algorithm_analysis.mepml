> The retained original experiment

```{cpp, results="markdown", file="figures/thomas_algorithm_original.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    auto grid = a::thomas_poisson_example();
    auto r = a::thomas_run(grid.sub, grid.diagonal, grid.super, grid.rhs);
    double error = 0;
    for (std::size_t i = 0; i < r.x.size(); ++i)
        error = std::max(error, std::abs(r.x[i] - grid.exact[i]));
    std::print("Original49 interior nodes: max continuous sine error {:.9g}; actual discrete residual norm " "{:.9g}; actual divisions {}.\n\n| original interior x | actual solution | continuous sine " "reference | algebraic residual |\n| ---: | ---: | ---: | ---: |\n",
               error, r.residual_norm, r.divisions);
    for (std::size_t i = 0; i < r.x.size(); ++i)
        std::print("| {:.9g} | {:.12g} | {:.12g} | {:.9g} |\n",
                   grid.coordinates[i], r.x[i], grid.exact[i], r.residual[i]);
    std::vector<double> refx, refy;
    for (int i = 0; i <= 100; ++i) {
        refx.push_back(i / 100.);
        refy.push_back(std::sin(std::numbers::pi * refx.back()));
    }
    auto chart = g::RPlot::create();
    chart.lines(refx, refy, "continuous sine reference", {17, 24, 39}).points(
        grid.coordinates, r.x, "actual discrete Thomas solution", {37, 99, 235},
        4).title("Original49-node Dirichlet Poisson solve").x_label(
        "interior coordinate").y_label("solution");
    chart.save_svg("build/thomas_algorithm_original.svg");
}
```
