> Actual selected work and sensitivity

```{cpp, results="markdown", file="figures/thomas_algorithm_work.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    std::vector<double> x, y;
    std::print("| interior rows | actual eliminated rows | actual substitutions | max continuous sine error " "|\n| ---: | ---: | ---: | ---: |\n");
    for (std::size_t n : {9, 19, 39, 79, 159, 319}) {
        auto grid = a::thomas_poisson_example(n);
        auto r = a::thomas_run(grid.sub, grid.diagonal, grid.super, grid.rhs);
        double err = 0;
        for (std::size_t i = 0; i < n; ++i)
            err = std::max(err, std::abs(r.x[i] - grid.exact[i]));
        x.push_back(std::log10(1. / (n + 1)));
        y.push_back(std::log10(err));
        std::print("| {} | {} | {} | {:.9g} |\n", n, r.eliminations,
                   r.substitutions, err);
    }
    auto plot = g::RPlot::create();
    plot.lines(x, y, "actual native values", {37, 99, 235}).points(
        x, y, {37, 99, 235}, 4).title("Solved sine-forcing grids show discretization sensitivity").x_label("log10 grid spacing").y_label("log10 max continuous error");
    plot.save_svg("build/thomas_algorithm_work.svg");
}
```
