> Explicit controls

```{cpp, results="markdown", file="figures/thomas_algorithm_controls.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    std::vector<double> x, y;
    std::print("| rows | actual divisions | actual algebraic residual norm |\n| ---: | ---: | ---: |\n");
    for (std::size_t n : {0, 1, 2, 4, 8}) {
        auto grid = a::thomas_poisson_example(n);
        auto r = a::thomas_run(grid.sub, grid.diagonal, grid.super, grid.rhs);
        x.push_back(n);
        y.push_back(r.divisions);
        std::print("| {} | {} | {:.9g} |\n", n, r.divisions, r.residual_norm);
    }
    try {
        a::thomas_run({0, 1}, {0, 1}, {1, 0}, {1, 2});
    } catch (const std::domain_error &) {
        std::print("Nonsingular matrix requiring an initial pivot exchange is explicitly rejected by this " "no-pivot solver.\n");
    }
    auto plot = g::RPlot::create();
    plot.lines(x, y, "actual native values", {37, 99, 235}).points(
        x, y, {37, 99, 235}, 4).title("Empty and small valid systems disclose actual divisions").x_label("rows").y_label("actual divisions");
    plot.save_svg("build/thomas_algorithm_controls.svg");
}
```
