> The retained original experiment

```{cpp, results="markdown", file="figures/simplex_original.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    auto r = a::simplex_trace({5, 4}, {{6, 4}, {1, 2}}, {24, 6});
    std::print("| status integer | actual x | objective | pivots | cell updates |\n| ---: | --- | ---: | " "---: | ---: |\n| {} | `{}` | {} | {} | {} |\n",
               int(r.result.status), r.result.x, r.result.value, r.pivots,
               r.cell_updates);
    std::print("\n| pivot | actual basis | actual tableau |\n| ---: | --- | --- |\n");
    for (std::size_t i = 0; i < r.history.size(); ++i)
        std::print("| {} | `{}` | `{}` |\n", i, r.history[i].basis,
                   r.history[i].tableau);
    auto plot = g::RPlot::create();
    plot.polygon({0, 4, 3, 0}, {0, 0, 1.5, 3}, {191, 219, 254}, true).lines(
        {0, 4, 3, 0, 0}, {0, 0, 1.5, 3, 0}, "analytic feasible region",
        {37, 99, 235}).points({r.result.x[0]}, {r.result.x[1]}, {220, 38, 38}, 8).lines({1, 4.2}, {4, 0}, "objective21 contour", {234, 88, 12}).title("Original LP: actual solution at analytic vertex").x_label("x").y_label("y").size(760, 800).margins(80, 40, 72, 88).x_limits(-1, 5).y_limits(-1, 5);
    plot.save_svg("build/simplex_original.svg");
}
```
