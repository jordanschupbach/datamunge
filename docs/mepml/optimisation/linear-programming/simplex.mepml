> Actual selected work and sensitivity

```{cpp, results="markdown", file="figures/simplex_work.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    std::vector<double> x{0}, y{0};
    auto r = a::simplex_trace({5, 4}, {{6, 4}, {1, 2}}, {24, 6});
    std::print("| actual completed pivots | objective row RHS |\n| ---: | ---: |\n| 0 | 0 |\n");
    for (std::size_t i = 0; i < r.history.size(); ++i) {
        const auto value = r.history[i].tableau.back().back();
        std::print("| {} | {} |\n", i + 1, value);
        x.push_back(i + 1);
        y.push_back(value);
    }
    auto plot = g::RPlot::create();
    plot.lines(x, y, "actual values", {37, 99, 235}).points(x, y, {37, 99, 235},
                                                            4).title(
        "Original LP: actual objective improvement").x_label("completed pivots").y_label("objective");
    plot.save_svg("build/simplex_work.svg");
}
```
