> Explicit controls

```{cpp, results="markdown", file="figures/simplex_controls.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    std::vector<double> x, y;
    std::print("| requested pivot limit | actual status (0 optimal,1 unbounded,2 limit) | objective | " "pivots |\n| ---: | ---: | ---: | ---: |\n");
    for (std::size_t cap : {0, 1, 2, 3}) {
        a::SimplexOptions o;
        o.max_pivots = cap;
        auto r = a::simplex_run({5, 4}, {{6, 4}, {1, 2}}, {24, 6}, o);
        std::print("| {} | {} | {} | {} |\n", cap, int(r.result.status),
                   r.result.value, r.pivots);
        x.push_back(cap);
        y.push_back(int(r.result.status));
    }
    auto unbounded = a::simplex_run({1}, {}, {});
    std::print("\nUnconstrained improving objective status {}. Negative RHS is rejected: no PhaseI.\n",
               int(unbounded.result.status));
    auto plot = g::RPlot::create();
    plot.lines(x, y, "actual values", {37, 99, 235}).points(x, y, {37, 99, 235},
                                                            4).title(
        "A pivot limit is not an optimality claim").x_label("maximum pivots").y_label("actual status code");
    plot.save_svg("build/simplex_controls.svg");
}
```
