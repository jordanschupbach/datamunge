> The retained original experiment

```{cpp, results="markdown", file="figures/spea2_original.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <filesystem>
#include <print>
#include <algorithm>
#include <cmath>
#include <limits>
#include <numeric>
#include <numbers>
#include <random>
#include <string>
#include <vector>
#include <map>
#include <set>
#include <array>
#include <tuple>
#include <bit>
#include <datamunge/random/quality.hpp>
#include <datamunge/optim/spea2.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    namespace o = dm::optim;
    auto six =
        o::spea2_select_trace({{.1, .9}, {.3, .4}, {.6, .2}, {.9, .1}, {.5, .6},
                               {.8, .5}}, 4);
    std::print("| original point index | actual strength | raw | density | fitness |\n| ---: | ---: | ---: " "| ---: | ---: |\n");
    for (const auto &p : six.pool)
        std::print("| {} | {} | {} | {} | {} |\n", p.pool_index, p.strength,
                   p.raw, p.density, p.fitness);
    o::ZDT1Objective problem(30);
    o::SPEA2Options options;
    options.population_size = 100;
    options.archive_size = 100;
    options.max_generations = 250;
    options.seed = 1;
    auto r =
        o::SPEA2(options).optimize_run(problem, std::vector<double>(30, 0),
                                       std::vector<double>(30, 1));
    auto summary = o::zdt1_front_summary(r.front);
    std::print("\n| original variables | population/archive | selection generations | actual callbacks | " "front points | mean vertical gap |\n| ---: | --- | ---: | ---: | ---: | ---: |\n| 30 | " "100/100 | 250 | {} | {} | {} |\n",
               r.evaluations, summary.points, summary.mean_gap);
    std::vector<double> x, y, tx, ty;
    for (const auto &p : r.front) {
        x.push_back(p.objectives[0]);
        y.push_back(p.objectives[1]);
    }
    for (const auto &p : o::zdt1_front()) {
        tx.push_back(p.objectives[0]);
        ty.push_back(p.objectives[1]);
    }
    auto plot = g::RPlot::create();
    plot.points(x, y, {37, 99, 235}, 4).lines(tx, ty,
                                              "analytic g=1 Pareto reference",
                                              {220, 38, 38}).title(
        "Original ZDT1 settings: actual corrected-density archive").x_label(
        "minimized f1").y_label("minimized f2");
    plot.save_svg("build/spea2_original.svg");
}
```
