> Explicit controls

```{cpp, results="markdown", file="figures/spea2_controls.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <filesystem>
#include <print>
#include <algorithm>
#include <cmath>
#include <limits>
#include <numeric>
#include <numbers>
#include <random>
#include <string>
#include <vector>
#include <map>
#include <set>
#include <array>
#include <tuple>
#include <bit>
#include <datamunge/random/quality.hpp>
#include <datamunge/optim/spea2.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    namespace o = dm::optim;
    const std::vector<std::vector<std::vector<double>> > pools{
        {}, {{1, 1}}, {{0, 1}, {1, 0}, {1, 1}},
        {{0, 1}, {.5, .5}, {1, 0}, {.5, .5}},
        {{0, 100}, {.5, 50}, {1, 0}, {.5, 50}}
    };
    std::vector<double> x, y;
    std::print("| control pool | actual selected indices | actual removed indices | distance calls |\n| " "---: | --- | --- | ---: |\n");
    for (std::size_t i = 0; i < pools.size(); ++i) {
        auto r = o::spea2_select_trace(pools[i], 2);
        std::print("| {} | `{}` | `{}` | {} |\n", i, r.selected, r.truncated,
                   r.distance_calls);
        x.push_back(i);
        y.push_back(r.distance_calls);
    }
    auto plot = g::RPlot::create();
    plot.lines(x, y, "actual values", {37, 99, 235}).points(x, y, {37, 99, 235},
                                                            4).title(
        "Empty, duplicate, dominated and rescaled pools").x_label(
        "control index").y_label("actual density/truncation distance calls");
    plot.save_svg("build/spea2_controls.svg");
}
```
