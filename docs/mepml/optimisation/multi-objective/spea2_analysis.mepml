> Actual selected work and sensitivity

```{cpp, results="markdown", file="figures/spea2_work.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <filesystem>
#include <print>
#include <algorithm>
#include <cmath>
#include <limits>
#include <numeric>
#include <numbers>
#include <random>
#include <string>
#include <vector>
#include <map>
#include <set>
#include <array>
#include <tuple>
#include <bit>
#include <datamunge/random/quality.hpp>
#include <datamunge/optim/spea2.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    namespace o = dm::optim;
    o::ZDT1Objective problem(3);
    o::SPEA2Options options;
    options.population_size = 20;
    options.archive_size = 10;
    options.max_generations = 20;
    options.seed = 1;
    auto r =
        o::SPEA2(options).optimize_trace(problem, std::vector<double>(3, 0),
                                         std::vector<double>(3, 1));
    std::vector<double> x, y;
    std::print("| actual selection generation | callbacks so far | scored pool | actual retained indices | " "actual removed indices |\n| ---: | ---: | ---: | --- | --- |\n");
    for (const auto &s : r.generations) {
        std::print("| {} | {} | {} | `{}` | `{}` |\n", s.generation,
                   s.evaluations, s.pool.size(), s.selected, s.truncated);
        x.push_back(s.generation);
        y.push_back(s.evaluations);
    }
    auto plot = g::RPlot::create();
    plot.lines(x, y, "actual values", {37, 99, 235}).points(x, y, {37, 99, 235},
                                                            4).title(
        "Actual callback work across selected generations").x_label(
        "archive-selection generation").y_label("cumulative callbacks");
    plot.save_svg("build/spea2_work.svg");
}
```
