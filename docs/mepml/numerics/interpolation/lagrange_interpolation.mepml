> Original eleven-node Runge example without clipping

Retain f(x)=1/(1+25x²) and the original eleven equally spaced nodes on[−1,1].
The original plot’s fixed upper limit1.3 clipped substantial actual overshoot;
this replacement derives limits from the full computed curves. Evaluate a
deterministic2001-point grid including both endpoints, replacing an accumulating
floating increment loop that could drift past an endpoint. The reported maximum
is over that finite grid, not a certified continuous supremum.

```{cpp, results="markdown", file="figures/lagrange_original.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
    std::filesystem::create_directories("build");
    auto f = [](double x) { return 1 / (1 + 25 * x * x); };
    std::vector<double> nodes, values;
    for (int i = 0; i < 11; ++i) {
        const double x = -1. + 2. * i / 10;
        nodes.push_back(x);
        values.push_back(f(x));
    }
    double node_error = 0, max_error = 0, at = 0, lo = 0, hi = 1;
    std::vector<double> x, truth, fit;
    for (std::size_t i = 0; i < nodes.size(); ++i)
        node_error =
            std::max(node_error,
                     std::abs(dm::algorithms::lagrange_interpolate(nodes,
                                                                   values,
                                                                   nodes[i]) -
                              values[i]));
    for (int i = 0; i <= 2000; ++i) {
        const double q =
            -1. + 2. * i / 2000, v =
            dm::algorithms::lagrange_interpolate(nodes, values, q), e =
            std::abs(v - f(q));
        x.push_back(q);
        truth.push_back(f(q));
        fit.push_back(v);
        lo = std::min(lo, v);
        hi = std::max(hi, v);
        if (e > max_error) {
            max_error = e;
            at = q;
        }
    }
    std::print("| original nodes | actual grid evaluations | maximum node residual | maximum sampled " "approximation error | actual grid coordinate of first maximum | observed curve minimum | " "observed curve maximum |\n| ---: | ---: | ---: | ---: | ---: | ---: | ---: |\n| {} | {} | " "{:.12e} | {:.12e} | {:.9f} | {:.9f} | {:.9f} |\n",
               nodes.size(), x.size(), node_error, max_error, at, lo, hi);
    const double span = hi - lo;
    auto p = dm::graphics::RPlot::create();
    p.line(x, truth, "truth", {22, 163, 74}, 2).line(x, fit, "direct fit",
                                                     {220, 38, 38}, 2).points(
        nodes, values, "nodes", {37, 99, 235}, 6).y_limits(lo - .1 * span,
                                                           hi + .25 * span).title("Original Runge nodes: full actual overshoot").x_label("x").y_label("function or polynomial value").save_svg("build/lagrange_original.svg");
}
```
// result_begin: markdown
| original nodes | actual grid evaluations | maximum node residual | maximum sampled approximation error | actual grid coordinate of first maximum | observed curve minimum | observed curve maximum |
| ---: | ---: | ---: | ---: | ---: | ---: | ---: |
| 11 | 2001 | 0.000000000000e+00 | 1.915643050219e+00 | 0.940000000 | -0.257177794 | 1.958951842 |
\image(figures/lagrange_original.svg)
// result_end
\caption(Original eleven equispaced nodes and the full actual direct interpolant.)
