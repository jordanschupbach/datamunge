\alttext(Actual cosine bracket half-widths for ITP and bisection with residual stopping disabled.)

Here ITP stops on a computed callback zero while its last pre-evaluation
half-width remains above 1e-12. The zero-callback stopping reason, rather than
an interval certificate, explains why that green curve ends there.

> Controls: units, discontinuity and precision

A small residual alone need not locate a root accurately. Scale a linear
function by 1e-20: a combined function/coordinate tolerance accepts a point in a
wide bracket, while the position-only run continues. A finite jump can meet the
interval test with residual one despite having no zero. Finally, adjacent
doubles near one cannot contain an interior double; asking for a subnormal
coordinate tolerance reports stagnation, rather than repeating an endpoint. A
second precision control starts at one with a five-ulp bracket and tolerance
three quarters of an ulp. Its second projected centre falls between doubles; the
rounded trial leaves a two-ulp bracket after its two allowed trials, so the
solver reports projection limit with converged=false. The last figure shows the
jump control's shrinking interval and constant actual residual side by side,
using matched position-only controls for both solvers.

```{cpp, results="markdown", file="figures/itp_controls.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <datamunge/algorithms/itp_analysis.hpp>
#include <filesystem>
#include <print>
#include <limits>
#include <cmath>
#include <stdexcept>
int main() {
    std::filesystem::create_directories("build");

    const auto scaled = [](double x) { return 1e-20 * (x - .731); };
    const auto combined = dm::algorithms::itp_run(scaled, 0, 2, {1e-10, 1e-10});
    const auto positional = dm::algorithms::itp_run(scaled, 0, 2, {1e-10, 0});
    const auto jump = [](double x) { return x < .731 ? -1. : 1.; };
    const auto a = dm::algorithms::itp_trace(jump, 0, 2, {1e-10, 0});
    const auto b = dm::algorithms::bisection_trace(jump, 0, 2, {1e-10, 0, 100});
    const auto stalled = dm::algorithms::itp_run([](double x) {
        return x == 1 ? -1. : 1.;
    }, 1, std::nextafter(1., 2.), {std::numeric_limits<double>::denorm_min(), 0});
    const double ulp = std::nextafter(1., 2.) - 1.;
    const auto rounded = dm::algorithms::itp_run([ulp](double x) {
        return x < 1 + 3 * ulp ? -1. : 1.;
    }, 1, 1 + 5 * ulp, {.75 * ulp, 0, 100, 0});
    std::print("| control | converged flag | returned root | absolute residual | candidate radius | stop " "|\n| --- | --- | ---: | ---: | ---: | --- |\n");
    for (const auto & [name, r] : std::vector<std::pair<std::string, dm::algorithms::ItpRun>> {
        {
            "scaled linear combined", combined
        }, {"scaled linear positional", positional}, {"finite jump", a.run}, {
            "adjacent doubles", stalled
        }, {"rounded projection allowance", rounded}
    })
        std::print("| {} | {} | {:.15f} | {:.8e} | {:.8e} | {} |\n", name,
                   r.result.converged, r.result.root, r.result.residual,
                   r.radius, dm::algorithms::itp_stop_name(r.stop));
    bool nonfinite = false, record_cap = false;
    int callbacks = 0;
    try {
        (void) dm::algorithms::itp_run([](double) {
            return std::numeric_limits<double>::infinity();
        }, 0, 1);
    } catch (const std::domain_error &) {
        nonfinite = true;
    }
    try {
        (void) dm::algorithms::itp_trace([&](double x) {
            ++callbacks; return std::cos(x) - x;
        }, 0, 1, {1e-12, 0, 100, 1, 1});
    } catch (const std::length_error &) {
        record_cap = true;
    }
    std::print("Nonfinite callback rejected: {}. One-record cap rejected before the next callback: {}; " "actual calls {}.\n",
               nonfinite, record_cap, callbacks);
    if (!nonfinite || !record_cap || callbacks != 3)
        throw std::runtime_error("control mismatch");
    auto width =
        dm::algorithms::itp_bisection_plot(a, b).title("Finite jump: interval contracts").ylim(-12, 3);
    auto residual =
        dm::algorithms::itp_bisection_plot(a, b, true).title(
        "Finite jump: residual stays one").ylim(-1, 1);
    auto layout = dm::graphics::RLayout::create(2, 1);
    layout.add(width).add(residual).size(1000, 1000).title(
        "A narrow sign bracket does not prove a root without continuity").fit_panels().save_svg("build/itp_controls.svg");
}
```
