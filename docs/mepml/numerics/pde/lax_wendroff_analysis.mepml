> Original200-cell Gaussian

Retain length1, speed1,200 cells, dx=1/200, dt=0.8*dx, initial
exp(−120*(x−0.5)^2), and round(1/(a*dt))=250 steps. The analytic reference wraps
x−a*t into[0,1), preserving the original periodic shift formula. Its tiny
endpoint derivative mismatch means this Gaussian is not the smooth periodic
refinement control used later. The trace performs one complete run and stores
its original and every actual state, not repeated prefix runs.

```{cpp, results="markdown", file="figures/lax_original.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <datamunge/algorithms/lax_wendroff.hpp>
#include <datamunge/plot/plot.hpp>
#include <filesystem>
#include <cmath>
#include <print>
int main() {
    std::filesystem::create_directories("build");
    const int n = 200;
    const double dx = 1. / n, dt = .8 * dx;
    const int steps = std::lround(1 / dt);
    const double time = steps * dt;
    auto exact = [](double x) {
        x = std::fmod(x, 1.);
        if (x < 0)
            x += 1;
        return std::exp(-120 * (x - .5) * (x - .5));
    };
    std::vector<double> x, u, truth;
    for (int j = 0; j < n; ++j) {
        x.push_back(j * dx);
        u.push_back(exact(x.back()));
        truth.push_back(exact(x.back() - time));
    }
    auto t = dm::algorithms::lax_wendroff_trace(u, 1, dx, dt, steps);
    double error = 0;
    for (int j = 0; j < n; ++j)
        error = std::max(error, std::abs(t.analysis.values[j] - truth[j]));
    std::print("| actual cells | actual steps | actual Courant | actual maximum error to shifted Gaussian | " "actual mass drift | actual final minimum | actual final maximum |\n| ---: | ---: | ---: | " "---: | ---: | ---: | ---: |\n| {} | {} | {} | {:.12g} | {:.12g} | {:.12g} | {:.12g} |\n",
               n, steps, t.analysis.courant, error,
               t.diagnostics.back().mass - t.diagnostics.front().mass,
               t.diagnostics.back().minimum, t.diagnostics.back().maximum);
    std::print("\nActual cell updates {}; selected stencil operands {}; captured logical entries {}.\n",
               t.analysis.work.cell_updates, t.analysis.work.stencil_reads,
               t.captured_entries);
    auto p = dm::graphics::RPlot::create();
    p.line(x, u, "original", {148, 163, 184}, 2).line(x, truth,
                                                      "analytic shift",
                                                      {22, 163, 74}, 2).line(
        x, t.analysis.values, "actual final", {37, 99, 235}, 2).y_limits(
        -.12, 1.35).title("Original Gaussian: actual full250-step evolution").x_label("periodic x").y_label("transported value").save_svg("build/lax_original.svg");
}
```
