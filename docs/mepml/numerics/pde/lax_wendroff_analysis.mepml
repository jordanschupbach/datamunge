> Smooth periodic refinement

Use sin(2*pi*x), CFL0.8 and n=40,80,160,320. Exactly5*n/4 complete updates reach
time1 up to floating-point arithmetic. Each measured error compares the actual
full final grid with the analytic sine at the actual time. Second-order
consistency predicts O(dx^2) at fixed final time for smooth data; measured
pairwise orders are observations rather than a guarantee on arbitrary inputs.
The plotted n^-2 line is anchored at the first observed error and explicitly
labelled as a reference.

```{cpp, results="markdown", file="figures/lax_refinement.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <datamunge/algorithms/lax_wendroff.hpp>
#include <datamunge/plot/plot.hpp>
#include <filesystem>
#include <cmath>
#include <numbers>
#include <print>
int main() {
    std::filesystem::create_directories("build");
    std::vector<double> x, y, reference;
    double previous = 0, first = 0;
    std::print("| actual cells | actual steps | actual maximum sine error | observed pairwise order, first " "row0 sentinel | actual cell updates |\n| ---: | ---: | ---: | ---: | ---: |\n");
    for (int n : {40, 80, 160, 320}) {
        double dx = 1. / n, dt = .8 * dx;
        int steps = 5 * n / 4;
        std::vector<double> u(n);
        for (int j = 0; j < n; ++j)
            u[j] = std::sin(2 * std::numbers::pi * j * dx);
        auto a = dm::algorithms::lax_wendroff_analyze(u, 1, dx, dt, steps);
        double error = 0;
        for (int j = 0; j < n; ++j)
            error =
                std::max(error,
                         std::abs(a.values[j] - std::sin(
                                  2 * std::numbers::pi * (j * dx - steps * dt))));
        std::print("| {} | {} | {:.12g} | {:.8f} | {} |\n", n, steps, error,
                   previous ? std::log2(previous / error) : 0,
                   a.work.cell_updates);
        if (!first)
            first = error;
        previous = error;
        x.push_back(std::log2(n));
        y.push_back(std::log2(error));
        reference.push_back(std::log2(first * std::pow(40. / n, 2)));
    }
    auto p = dm::graphics::RPlot::create();
    p.line(x, reference, "anchored n^-2 reference", {22, 163, 74}, 1.5).line(
        x, y, "actual error", {37, 99, 235}, 2).points(x, y, "", {37, 99, 235},
                                                       5).title(
        "Actual smooth-grid errors and second-order reference").x_label(
        "log2(grid cells)").y_label("log2(maximum final error)").save_svg(
        "build/lax_refinement.svg");
}
```
