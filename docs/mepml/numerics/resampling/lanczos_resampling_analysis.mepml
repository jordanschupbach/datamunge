\alttext(Actual finite-grid errors and integer-sample equality are computed; smooth-example performance is not generalized to arbitrary signals.)

> Raw DC ripple, explicit normalization and ringing

For all-one samples, the raw output equals the actual weight sum. Explicit
normalization returns one on this control, but does not remove negative kernel
weights or guarantee monotone reconstruction of a step. Position clamping makes
even huge finite outside queries return the numeric border sample, while
near-border virtual taps still use the edge extension.

```{cpp, results="markdown", file="figures/lanczos_resampling_dc.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
    std::filesystem::create_directories("build");
    const std::vector<double> ones(9, 1);
    std::print("| actual query | effective clamped position | actual raw constant output | actual raw " "weight sum | explicitly normalized output |\n| ---: | ---: | ---: | ---: | ---: |\n");
    for (double q : {-100., 0., .25, .5, 7.5, 8., 100.}) {
        const auto a =
            dm::algorithms::lanczos_resample_analyze(ones, q, 3), n =
            dm::algorithms::lanczos_resample_analyze(ones, q, 3, true);
        std::print("| {:.2f} | {:.2f} | {:.12f} | {:.12f} | {:.12f} |\n", q,
                   a.effective_position, a.value, a.weight_sum, n.value);
    }
    const std::vector<double> step = {0, 0, 0, 0, 1, 1, 1, 1, 1};
    std::print("\n| normalized step query | actual normalized value |\n| ---: | ---: |\n");
    for (double q : {2.5, 3.5, 4.5})
        std::print("| {:.1f} | {:.12f} |\n", q,
                   dm::algorithms::lanczos_resample_analyze(step, q, 3, true).value);
    std::vector<double> x, y, z;
    for (int i = 0; i <= 200; ++i) {
        const double q = i / 25.;
        x.push_back(q);
        y.push_back(dm::algorithms::lanczos_resample_analyze(ones, q, 3).value);
        z.push_back(dm::algorithms::lanczos_resample_analyze(ones, q, 3, true).value);
    }
    auto p = dm::graphics::RPlot::create();
    p.line(x, y, "raw DC", {220, 38, 38}, 2).line(x, z, "normalized",
                                                  {37, 99, 235}, 2).y_limits(
        .985, 1.02).title("Actual constant gain depends on explicit normalization").x_label("actual query position").y_label("reconstructed all-one signal").save_svg("build/lanczos_resampling_dc.svg");
}
```
