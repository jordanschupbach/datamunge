> The original thirty-sample signal

Retain f(t)=sin(0.4t)+0.5cos(0.17t)+0.2sin(0.9t), thirty integer samples and raw
Lanczos3. Keep the original comparison interval4 through25 and spacing0.05, but
construct its421 positions by an integer loop so both endpoints are explicit
rather than subject to accumulated step drift. The exact analytic function is an
independent reconstruction target on this synthetic control. A separate linear
interpolant provides the original baseline, not a universal ranking across
signals.

```{cpp, results="markdown", file="figures/lanczos_resampling_original.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
    std::filesystem::create_directories("build");
    auto f = [](double t) {
        return std::sin(.4 * t) + .5 * std::cos(.17 * t) + .2 * std::sin(
            .9 * t);
    };
    std::vector<double> samples(30);
    for (int i = 0; i < 30; ++i)
        samples[i] = f(i);
    std::vector<double> x, truth, raw, linear;
    double re = 0, le = 0;
    for (int i = 0; i <= 420; ++i) {
        const double p = 4. + i * .05;
        const auto k = std::size_t(std::floor(p));
        const double fraction =
            p - k, l =
            (1 - fraction) * samples[k] + fraction * samples[k + 1], r =
            dm::algorithms::lanczos_resample_at(samples, p, 3);
        x.push_back(p);
        truth.push_back(f(p));
        raw.push_back(r);
        linear.push_back(l);
        re = std::max(re, std::abs(r - f(p)));
        le = std::max(le, std::abs(l - f(p)));
    }
    std::print("| original integer control k | actual raw result | original sample |\n| ---: | ---: | ---: " "|\n| 7 | {:.12f} | {:.12f} |\n",
               dm::algorithms::lanczos_resample_at(samples, 7, 3), samples[7]);
    std::print("\n| original sample count | actual query count | maximum sampled raw reconstruction error | " "maximum sampled linear error |\n| ---: | ---: | ---: | ---: |\n| {} | {} | {:.12e} | " "{:.12e} |\n",
               samples.size(), x.size(), re, le);
    std::vector<double> sx;
    for (int i = 0; i < 30; ++i)
        sx.push_back(i);
    auto p = dm::graphics::RPlot::create();
    p.line(x, truth, "truth", {30, 30, 30}, 2).line(x, raw, "raw a3",
                                                    {37, 99, 235}, 2).line(
        x, linear, "linear", {220, 120, 120}, 1.5).points(sx, samples,
                                                          "samples",
                                                          {22, 163, 74}, 4).y_limits(-2, 2.5).title("Original sampled signal and actual reconstructions").x_label("sample-index position").y_label("signal value").save_svg("build/lanczos_resampling_original.svg");
}
```
