\caption(Actual phase-dependent raw gain and explicit normalization, with a step ringing control.)
\alttext(The raw all-one curve ripples below one; normalization restores this constant while separate step values still undershoot and overshoot.)

> Window width is a measured tradeoff

Compare a1,2,3,4,6,8 on the same original signal, using a common1301-position
interior interval8 through21. Every window stays within the thirty original
samples. Each raw and normalized query is a complete native evaluation. The
profile records actual2*a tap work alongside finite-grid reconstruction errors;
it does not assume increasing width always lowers error. Linear interpolation is
an explicit fixed baseline. The method performs no separate antialiasing
prefilter or cutoff adjustment for aggressive downsampling.

```{cpp, results="markdown", file="figures/lanczos_resampling_width.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
    std::filesystem::create_directories("build");
    auto f = [](double t) {
        return std::sin(.4 * t) + .5 * std::cos(.17 * t) + .2 * std::sin(
            .9 * t);
    };
    std::vector<double> samples(30);
    for (int i = 0; i < 30; ++i)
        samples[i] = f(i);
    std::vector<double> x, y, z, l;
    std::print("| actual lobes a | actual grid size | actual taps per query | maximum sampled raw error | " "maximum sampled normalized error | maximum sampled linear error |\n| ---: | ---: | ---: | " "---: | ---: | ---: |\n");
    for (int a : {1, 2, 3, 4, 6, 8}) {
        double re = 0, ne = 0, le = 0;
        std::size_t taps = 0;
        for (int i = 0; i <= 1300; ++i) {
            const double q = 8. + i * .01;
            const auto k = std::size_t(std::floor(q));
            const double fraction = q - k;
            const auto r =
                dm::algorithms::lanczos_resample_analyze(samples, q, a), n =
                dm::algorithms::lanczos_resample_analyze(samples, q, a, true);
            re = std::max(re, std::abs(r.value - f(q)));
            ne = std::max(ne, std::abs(n.value - f(q)));
            le =
                std::max(le,
                         std::abs((1 - fraction) * samples[k] +
                                  fraction * samples[k + 1] - f(q)));
            taps = r.work.taps;
        }
        std::print("| {} | 1301 | {} | {:.12e} | {:.12e} | {:.12e} |\n", a,
                   taps, re, ne, le);
        x.push_back(a);
        y.push_back(re);
        z.push_back(ne);
        l.push_back(le);
    }
    auto p = dm::graphics::RPlot::create();
    p.line(x, y, "raw", {220, 38, 38}, 2).points(x, y, "", {220, 38, 38}, 4).line(x, z, "normalized", {37, 99, 235}, 2).points(x, z, "", {37, 99, 235}, 4).line(x, l, "linear", {22, 163, 74}, 2).title("Actual width tradeoffs on the original signal").x_label("actual window half-width a").y_label("maximum sampled absolute reconstruction error").save_svg("build/lanczos_resampling_width.svg");
}
```
