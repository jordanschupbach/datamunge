| 5 | 0.0625 | 0.000244140625 | true |
| 6 | 0.03125 | 3.0517578125e-05 | true |
| 7 | 0.015625 | 3.81469726562e-06 | true |
| 8 | 0.0078125 | 4.76837158203e-07 | true |
| 9 | 0.00390625 | 5.96046447754e-08 | false |

