// result_end
\caption(Nine actual inspected iterates show eight updates with exact factor one half. The root is exactly zero, so |x| is coordinate error here.)
\alttext(A straight decreasing line on the base-two error scale demonstrates linear convergence at the triple root.)

> Stop reasons, scaling and limits

A residual tolerance has function units. Multiplying f and both derivatives by a
constant leaves the exact Halley correction unchanged, but changes an absolute
residual test; floating products can also underflow or overflow. The next block
shows that a sufficiently small function scale accepts the initial x=2 even
though it is far from √2. It also contrasts an exactly zero denominator with a
nonzero denominator that produces zero corrections repeatedly.

```{cpp, results="markdown", file="figures/halley_controls.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
    std::filesystem::create_directories("build");
    auto f = [](double x) { return x * x - 2.; };
    auto df = [](double x) { return 2 * x; };
    auto d2 = [](double) { return 2.; };

    std::vector<double> cases, updates;
    std::print("| case | root estimate | residual | converged | stop enum | updates | f calls |\n| --- | " "---: | ---: | --- | ---: | ---: | ---: |\n");
    const std::vector<dm::algorithms::HalleyRun> runs{dm::algorithms::halley_run(f, df, d2, 2.), dm::algorithms::halley_run([&](double x) {
        return 1e-12 * f(x);
    }, [&](double x) {
        return 1e-12 * df(x);
    }, [](double) {
        return 2e-12;
    }, 2.), dm::algorithms::halley_run([](double) {
        return 1.;
    }, [](double) {
        return 0.;
    }, [](double) {
        return 0.;
    }, 0.), dm::algorithms::halley_run([](double) {
        return 1.;
    }, [](double) {
        return 0.;
    }, [](double) {
        return 2.;
    }, 0., 1e-10, 5)};
    const std::vector<std::string> names{"ordinary", "scaled",
                                         "zero denominator", "zero correction"};
    for (std::size_t i = 0; i < runs.size(); ++i) {
        const auto &r = runs[i];
        std::print("| {} | {:.12g} | {:.12g} | {} | {} | {} | {} |\n", names[i],
                   r.result.root, r.result.residual, r.result.converged,
                   int(r.stop), r.work.updates, r.work.f_calls);
        cases.push_back(i + 1);
        updates.push_back(r.work.updates);
    }
    int calls = 0;
    bool rejected = false;
    try {
        (void) dm::algorithms::halley_trace([&](double x) {
            ++calls; return f(x);
        }, df, d2, 2., 1e-10, 100, 1);
    } catch (const std::length_error &) {
        rejected = true;
    }
    std::print("\nOnline cap one rejects before second f callback: {}; actual f calls before rejection " "{}.\n",
               rejected, calls);
    if (!rejected || calls != 1 || runs[1].result.root != 2 ||
        !runs[1].result.converged || runs[3].work.updates != 5)
        throw std::runtime_error("controls");
    auto plot = dm::graphics::RPlot::create();
    plot.bars(cases, updates, "actual updates", {37, 99, 235}, .65).title(
        "Stopping behavior changes the producing work").x_label(
        "case: 1 ordinary; 2 scaled; 3 zero denominator; 4 zero correction").y_label("applied updates").save_svg("build/halley_controls.svg");
}
```
