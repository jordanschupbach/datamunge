> Failure controls are part of the method

On diag(2,5), the start (0,1) has no component in the nearest eigenspace for
shift 2.1: it stays at the eigenvalue five with zero residual. This is a perfect
residual for the wrong requested eigenvalue. At shift 3.5 the two distances tie;
the equal-entry start alternates directions with Rayleigh value 3.5 and residual
1.5 instead of converging. An exact shift of two is singular for this diagonal
matrix and throws before the first inverse solve. Rounded near-singular matrices
may instead have a tiny nonzero computed pivot; exact-zero rejection is not a
condition-number estimator or a certificate of mathematical nonsingularity.

```{cpp, results="markdown", file="figures/inverse_controls.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <datamunge/algorithms/inverse_iteration_analysis.hpp>
#include <filesystem>
#include <format>
#include <print>
#include <stdexcept>
int main() {
    std::filesystem::create_directories("build");

    const std::vector<std::vector<double>> a{{2, 0}, {0, 5}};
    const auto convergent =
        dm::algorithms::inverse_iteration_trace(a, 2.1, {8});
    const auto missing =
        dm::algorithms::inverse_iteration_trace(a, 2.1, {8}, {0, 1});
    const auto tied = dm::algorithms::inverse_iteration_trace(a, 3.5, {8});
    std::print("| control | final Rayleigh | residual |\n| --- | ---: | ---: |\n");
    for (const auto & [label, run] : std::vector<std::pair<std::string, dm::algorithms::InverseIterationRun>> {
        {
            "nonzero wanted component", convergent.run
        }, {"missing wanted component", missing.run}, {"equal-distance shift",
                                                       tied.run}
    })
        std::print("| {} | {:.10f} | {:.8e} |\n", label, run.pair.value,
                   run.residual);
    bool singular = false, history_cap = false;
    try {
        (void) dm::algorithms::inverse_iteration_run(a, 2, {1});
    } catch (const std::domain_error &) {
        singular = true;
    }
    try {
        (void) dm::algorithms::inverse_iteration_trace(a, 2.1, {8, 2, 17});
    } catch (const std::length_error &) {
        history_cap = true;
    }
    const auto exact_cap =
        dm::algorithms::inverse_iteration_trace(a, 2.1, {8, 2, 18});
    std::print("Exact singular shift rejected: {}. Complete history cap seventeen rejected: {}. Exact " "eighteen-entry admission retains {} states.\n",
               singular, history_cap, exact_cap.steps.size());
    if (!singular || !history_cap)
        throw std::runtime_error("control did not trigger");
    dm::algorithms::inverse_iteration_residual_plot({convergent, missing, tied},
                                                    {"convergent",
                                                     "missing component",
                                                     "equal distances"}).title(
        "Residual controls: convergence, wrong target and a tie").ylim(-19, 4).save_svg("build/inverse_controls.svg");
}
```
