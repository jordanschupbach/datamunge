> Actual selected work and sensitivity

```{cpp, results="markdown", file="figures/token_bucket_work.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    a::TokenBucket bucket(5, 1);
    bucket.allow(0, 5);
    std::vector<double> x, y;
    std::print("| actual supplied time | actual added tokens | actual stored tokens |\n| ---: | ---: | ---: " "|\n");
    for (double time : {.5, 1., 2., 3., 5., 10., 100.}) {
        auto s = bucket.peek(time);
        x.push_back(time);
        y.push_back(s.after);
        std::print("| {} | {} | {} |\n", time, s.refilled, s.after);
    }
    auto plot = g::RPlot::create();
    plot.lines(x, y, "actual native values", {37, 99, 235}).points(
        x, y, {37, 99, 235}, 4).title("Actual idle refill saturates at finite capacity").x_label("caller time").y_label("actual available tokens");
    plot.save_svg("build/token_bucket_work.svg");
}
```
