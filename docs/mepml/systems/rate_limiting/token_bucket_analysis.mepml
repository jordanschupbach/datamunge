> Explicit controls

```{cpp, results="markdown", file="figures/token_bucket_controls.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    a::TokenBucket bucket(3, 0);
    std::vector<double> x, y;
    std::print("| actual cost | refill at time10 | admitted | stored after |\n| ---: | ---: | --- | ---: " "|\n");
    for (double cost : {0., 4., 2., 1., 1.}) {
        auto s = bucket.consume(10, cost);
        x.push_back(x.size());
        y.push_back(s.after);
        std::print("| {} | {} | {} | {} |\n", cost, s.refilled, s.consumed,
                   s.after);
    }
    try {
        bucket.allow(9);
    } catch (const std::invalid_argument &) {
        std::print("Backward time rejected before mutation.\n");
    }
    auto plot = g::RPlot::create();
    plot.lines(x, y, "actual native values", {37, 99, 235}).points(
        x, y, {37, 99, 235}, 4).title("Zero-rate, zero-cost and over-capacity controls").x_label("control operation").y_label("actual stored tokens");
    plot.save_svg("build/token_bucket_controls.svg");
}
```
