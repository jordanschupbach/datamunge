> The retained original experiment

```{cpp, results="markdown", file="figures/token_bucket_original.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    a::TokenBucket bucket(5, 1);
    std::vector<double> x, y;
    std::print("| original operation | time | actual refill | admitted | actual tokens after |\n| ---: | " "---: | ---: | --- | ---: |\n");
    for (int i = 0; i < 8; ++i) {
        auto s = bucket.consume(0);
        x.push_back(s.time);
        y.push_back(s.after);
        std::print("| {} | {} | {} | {} | {} |\n", i, s.time, s.refilled,
                   s.consumed, s.after);
    }
    for (int t = 1; t <= 6; ++t) {
        auto s = bucket.consume(t);
        x.push_back(s.time);
        y.push_back(s.after);
        std::print("| {} | {} | {} | {} | {} |\n", t + 7, s.time, s.refilled,
                   s.consumed, s.after);
    }
    auto plot = g::RPlot::create();
    plot.lines(x, y, "actual native values", {37, 99, 235}).points(
        x, y, {37, 99, 235}, 4).title("Original capacity5: eight requests at0, then one per time unit").x_label("caller time").y_label("actual tokens after request");
    plot.save_svg("build/token_bucket_original.svg");
}
```
