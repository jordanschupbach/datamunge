> Checking the theory and controls

```{cpp, results="markdown", file="figures/truncated_backoff_controls.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <filesystem>
#include <print>
#include <algorithm>
#include <cmath>
#include <limits>
#include <numeric>
#include <numbers>
#include <random>
#include <string>
#include <vector>
#include <map>
#include <set>
#include <array>
#include <tuple>
#include <bit>
#include <datamunge/random/quality.hpp>
#include <datamunge/algorithms/truncated_binary_exponential_backoff.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    std::vector<double> x, y;
    std::print("| supplied fraction | actual slot at c3 |\n|---:|---:|\n");
    for (double u : {0., .125, .5, std::nextafter(1., 0.)}) {
        auto slot = a::backoff_slot(3, u);
        std::print("|{}|{}|\n", u, slot);
        x.push_back(u);
        y.push_back(slot);
    }
    try {
        a::backoff_slot(3, 1);
    } catch (const std::invalid_argument &) {
        std::print("\nThe excluded upper endpoint is rejected.\n");
    }
    auto p = g::RPlot::create();
    p.line(x, y, "actual", {37, 99, 235}, 2);
    p.points(x, y, "", {37, 99, 235}, 5);
    p.title("Caller-fraction boundaries map to valid slots").x_label(
        "u in [0,1)").y_label("actual slot");
    p.save_svg("build/truncated_backoff_controls.svg");
}
```
// result_begin: markdown
| supplied fraction | actual slot at c3 |
|---:|---:|
|0|0|
|0.125|1|
|0.5|4|
|0.9999999999999999|7|

The excluded upper endpoint is rejected.
