> Sensitivity and selected work

```{cpp, results="markdown", file="figures/truncated_backoff_work.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <filesystem>
#include <print>
#include <algorithm>
#include <cmath>
#include <limits>
#include <numeric>
#include <numbers>
#include <random>
#include <string>
#include <vector>
#include <map>
#include <set>
#include <array>
#include <tuple>
#include <bit>
#include <datamunge/random/quality.hpp>
#include <datamunge/algorithms/truncated_binary_exponential_backoff.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    std::vector<double> x, y;
    std::print("| collisions | mean enumerated slot | ideal recollision probability |\n|---:|---:|---:|\n");
    for (int c = 0; c <= 15; ++c) {
        int w = a::contention_window(c);
        double sum = 0;
        for (int j = 0; j < w; ++j)
            sum += a::backoff_slot(c, (j + .5) / w);
        std::print("|{}|{}|{}|\n", c, sum / w, 1. / w);
        x.push_back(c);
        y.push_back(sum / w);
    }
    auto p = g::RPlot::create();
    p.line(x, y, "actual", {37, 99, 235}, 2);
    p.points(x, y, "", {37, 99, 235}, 5);
    p.title("Exhaustive slot-midpoint enumeration verifies the mean").x_label(
        "collisions").y_label("actual enumerated mean slot");
    p.save_svg("build/truncated_backoff_work.svg");
}
```
