> The retained original experiment

```{cpp, results="markdown", file="figures/truncated_backoff_original.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <filesystem>
#include <print>
#include <algorithm>
#include <cmath>
#include <limits>
#include <numeric>
#include <numbers>
#include <random>
#include <string>
#include <vector>
#include <map>
#include <set>
#include <array>
#include <tuple>
#include <bit>
#include <datamunge/random/quality.hpp>
#include <datamunge/algorithms/truncated_binary_exponential_backoff.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    std::vector<double> x, y;
    std::print("| collisions | window | largest slot | abandon |\n|---:|---:|---:|---|\n");
    for (int c = 0; c <= 16; ++c) {
        int w = a::contention_window(c);
        std::print("|{}|{}|{}|{}|\n", c, w, a::max_backoff_slots(c),
                   a::backoff_give_up(c));
        x.push_back(c);
        y.push_back(std::log2(w));
    }
    auto p = g::RPlot::create();
    p.line(x, y, "actual", {37, 99, 235}, 2);
    p.points(x, y, "", {37, 99, 235}, 5);
    p.title("Original collision0..16 policy, including abandonment").x_label(
        "collisions").y_label("log2 actual descriptive window");
    p.save_svg("build/truncated_backoff_original.svg");
}
```
