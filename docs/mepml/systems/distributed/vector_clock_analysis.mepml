> The retained original experiment

```{cpp, results="markdown", file="figures/vector_clock_original.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    a::VectorClock c0(3), c1(3), c2(3);
    a::vc_event(c0, 0);
    auto A = c0;
    auto S = a::vc_send(c0, 0);
    a::vc_receive(c1, 1, S);
    auto R = c1;
    a::vc_event(c2, 2);
    auto C = c2;
    std::print("| event | actual vector |\n|---|---|\n|A local|`{}`|\n|S send|`{}`|\n|R receive|`{}`|\n|C " "independent|`{}`|\n\nA before R {}; C concurrent R {}.\n",
               A.v, S.v, R.v, C.v, a::vc_happens_before(A, R),
               a::vc_concurrent(C, R));
    auto p =
        g::RPlot::barplot({double(R.v[0]), double(R.v[1]), double(R.v[2])},
                          {"P0", "P1", "P2"}, "actual receive counters",
                          {37, 99, 235});
    p.title("Original three-process receive stamp").y_label("known event count");
    p.save_svg("build/vector_clock_original.svg");
}
```
// result_begin: markdown
| event | actual vector |
|---|---|
|A local|`[1, 0, 0]`|
|S send|`[2, 0, 0]`|
|R receive|`[2, 1, 0]`|
|C independent|`[0, 0, 1]`|

A before R true; C concurrent R true.
\image(figures/vector_clock_original.svg)
// result_end
\caption(Actual canonical outputs; analytic reference values are identified explicitly.)
\alttext(Actual canonical outputs; analytic reference values are identified explicitly.)

> Checking the theory and controls

```{cpp, results="markdown", file="figures/vector_clock_controls.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    a::VectorClock a0(2), b(2);
    a::vc_event(a0, 0);
    a::vc_event(b, 1);
    std::vector<double> x{0, 1, 2}, y{double(a::vc_happens_before(a0, b)),
                                      double(a::vc_concurrent(a0, b)),
                                      double(a::vc_concurrent(a0, a0))};
    std::print("| comparison | result |\n|---|---|\n|incomparable before|{}|\n|incomparable " "concurrent|{}|\n|equal concurrent|{}|\n",
               bool(y[0]), bool(y[1]), bool(y[2]));
    auto p = g::RPlot::create();
    p.line(x, y, "actual", {37, 99, 235}, 2);
    p.points(x, y, "", {37, 99, 235}, 5);
    p.title("Strict order, incomparable clocks and equality").x_label(
        "comparison index").y_label("actual Boolean result");
    p.save_svg("build/vector_clock_controls.svg");
}
```
// result_begin: markdown
| comparison | result |
|---|---|
|incomparable before|false|
|incomparable concurrent|true|
|equal concurrent|false|
\image(figures/vector_clock_controls.svg)
// result_end
\caption(Actual canonical outputs; analytic reference values are identified explicitly.)
\alttext(Actual canonical outputs; analytic reference values are identified explicitly.)

> Sensitivity and selected work

```{cpp, results="markdown", file="figures/vector_clock_work.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    std::vector<double> x, y;
    std::print("| process count | message vector entries | actual own counter |\n|---:|---:|---:|\n");
    for (std::size_t n : {1, 2, 4, 8, 16, 32, 64}) {
        a::VectorClock c(n);
        auto m = a::vc_send(c, n - 1);
        std::print("|{}|{}|{}|\n", n, m.v.size(), m.v.back());
        x.push_back(n);
        y.push_back(m.v.size());
    }
    auto p = g::RPlot::create();
    p.line(x, y, "actual", {37, 99, 235}, 2);
    p.points(x, y, "", {37, 99, 235}, 5);
    p.title("Actual message width grows with process count").x_label("processes").y_label("actual transmitted counter entries");
    p.save_svg("build/vector_clock_work.svg");
}
```
// result_begin: markdown
| process count | message vector entries | actual own counter |
|---:|---:|---:|
|1|1|1|
|2|2|1|
|4|4|1|
|8|8|1|
|16|16|1|
|32|32|1|
|64|64|1|
