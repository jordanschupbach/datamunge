> Sensitivity and selected work

```{cpp, results="markdown", file="figures/wang_landau_work.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    a::WangLandauOptions o;
    o.max_check_records = 100;
    auto r = a::wang_landau_work(10, o);
    std::vector<double> x, y;
    std::print("| proposals | actual log f | actual minimum | actual mean | actual flat " "|\n|---:|---:|---:|---:|---|\n");
    for (auto q : r.check_records) {
        std::print("|{}|{}|{}|{}|{}|\n", q.moves, q.log_f, q.minimum, q.mean,
                   q.flat);
        x.push_back(q.moves);
        y.push_back(q.log_f);
    }
    auto p = g::RPlot::create();
    p.line(x, y, "actual", {37, 99, 235}, 2);
    p.points(x, y, "", {37, 99, 235}, 5);
    p.title("Actual flatness checks and modification-factor schedule").x_label(
        "actual proposals").y_label("actual log f before check");
    p.save_svg("build/wang_landau_work.svg");
}
```
