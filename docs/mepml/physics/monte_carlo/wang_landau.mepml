> The retained original experiment

```{cpp, results="markdown", file="figures/wang_landau_original.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    auto r = a::wang_landau_work(30);
    std::vector<double> energy, exact;
    std::print("| E | actual log g | exact log binomial | absolute error |\n|---:|---:|---:|---:|\n");
    double max_error = 0;
    for (int E = 0; E <= 30; ++E) {
        double ex = std::lgamma(31) - std::lgamma(E + 1) - std::lgamma(31 - E);
        energy.push_back(E);
        exact.push_back(ex);
        max_error = std::max(max_error, std::abs(r.log_density[E] - ex));
        if (E % 5 == 0)
            std::print("|{}|{}|{}|{}|\n", E, r.log_density[E], ex,
                       std::abs(r.log_density[E] - ex));
    }
    std::print("\nActual complete {}; proposals {}; flat stages {}; maximum error {}.\n",
               r.complete, r.moves, r.completed_stages, max_error);
    auto p = g::RPlot::create();
    p.line(energy, exact, "exact log binomial", {31, 41, 55}, 2.5);
    p.points(energy, r.log_density, "actual adaptive estimate", {37, 99, 235}, 5);
    p.title("Original30 spins, seed1: actual density estimate").x_label(
        "energy, up-spins").y_label("log density normalized at E0");
    p.save_svg("build/wang_landau_original.svg");
}
```
