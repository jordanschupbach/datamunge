> Checking the theory and controls

```{cpp, results="markdown", file="figures/wang_landau_controls.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    std::vector<double> x, y;
    std::print("| move budget | actual proposals | complete | current log f |\n|---:|---:|---|---:|\n");
    for (std::size_t budget : {0, 10, 100, 1000, 10000, 100000}) {
        a::WangLandauOptions o;
        o.max_moves = budget;
        auto r = a::wang_landau_work(4, o);
        std::print("|{}|{}|{}|{}|\n", budget, r.moves, r.complete,
                   r.log_f_remaining);
        x.push_back(budget);
        y.push_back(r.completed_stages);
    }
    auto p = g::RPlot::create();
    p.line(x, y, "actual", {37, 99, 235}, 2);
    p.points(x, y, "", {37, 99, 235}, 5);
    p.title("Resource-limited runs retain explicit unresolved state").x_label(
        "proposal budget").y_label("actual completed flat stages");
    p.save_svg("build/wang_landau_controls.svg");
}
```
