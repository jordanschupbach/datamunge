```{cpp, results="output", file="figures/adaboost_scatter.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

int main() {
  std::filesystem::create_directories("build");
  const auto cancer = dm::datasets::breast_cancer();
  auto plot = dm::graphics::RPlot::create();
  for (const auto& [label, color] : {std::pair{"benign", dm::RGB{37, 99, 235}}, {"malignant", dm::RGB{220, 38, 38}}}) {
    const auto rows = cancer | dm::filter_rows([&](const auto& r) { return r.get_string("diagnosis") == label; });
    plot.points(rows.get_column<double>("worst_perimeter").values(),
                rows.get_column<double>("mean_concave_points").values(), label, color, 3.5);
  }
  plot.title("Two of the 30 measurements, by diagnosis")
      .x_label("worst_perimeter")
      .y_label("mean_concave_points")
      .size(760, 520)
      .save_svg("build/adaboost_scatter.svg");
}
