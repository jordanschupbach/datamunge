We hold out 30% of the tumours for testing. `stats::train_test_split()`
stratifies by diagnosis, so both parts keep the class proportions.

```{cpp, results="markdown", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

int main() {
  const auto [train, test] = dm::stats::train_test_split(dm::datasets::breast_cancer(), 0.3, 1, "diagnosis");
  std::print("{}\n\n{}\n", train | dm::group_by("diagnosis") | dm::count("Training") | dm::to_md(),
             test | dm::group_by("diagnosis") | dm::count("Test") | dm::to_md());
}
```
// result_begin: markdown
