| :--- | :--- | :--- | :--- | :--- |
| vanilla | > 1000 | FFFFFFFF... | 2.4e-04 | 4.9e-04 |
| away-step | 4 | FFDF | -6.9e-18 | 2.8e-17 |
| pairwise | 3 | PDP | -2.1e-17 | -0.0e+00 |

\image(figures/frank_wolfe_triangle.svg)
// result_end

\caption(Left: vanilla Frank-Wolfe with line search, first 40 iterates; right: the away-step variant. The grey curve is the level set of \(f\) through \(x^\star\), a circle drawn with unequal axis scales. Table: steps to a gap of \(10^{-12}\) (at most 1,000), the first moves (F forward, D drop, P pairwise), and the final error and gap.)
\alttext(Two panels showing the triangle with corners 0 0, 1 0 and 0 1, a red point c at 0.7, 0.7 outside it, and a grey level curve around c touching the hypotenuse at x star, 0.5, 0.5. Left, vanilla: the blue path goes from the origin along the bottom edge to 0.7 0, up to about 0.37 0.47, then zig-zags in a tight fan of ever shorter segments that converges on x star from below the hypotenuse. Right, away-step: the path goes from the origin to 0.7 0, to about 0.37 0.47, onto the hypotenuse at about 0.44 0.56, and along it to x star, four segments in all.)

Vanilla Frank-Wolfe is still \(2.4\times10^{-4}\) from optimal after 1,000 steps, with every step
a forward one. The two variants are exact to rounding after four and three steps.

>> One drop step, by hand

The away-step run can be checked by hand. From \(x_0=(0,0)\) the gradient is \((-0.7,-0.7)\), both
other vertices tie, and the oracle returns \((1,0)\); line search along \((1,0)\) stops at
\(x_1=(0.7,0)\). Next the oracle returns \((0,1)\), and line search gives a point inside the
triangle, with the active set \(\{(0,0),(1,0),(0,1)\}\). Now the worst active vertex is \((0,0)\),
where \(\langle\nabla f,v\rangle\) is largest, and moving away from it descends faster than moving
towards a vertex. The full away step removes all of its weight, which puts the iterate on the
hypotenuse: that is the *drop*. One more forward step along the hypotenuse lands on
\(x^\star\). Vanilla Frank-Wolfe never removes the weight on \((0,0)\), so it can only approach the
edge.

> Checking the theory

>> Least squares over a simplex

A larger test: \(f(x)=\tfrac12\lVert Ax-b\rVert^2\) over \(\Delta_{40}\), with \(A\) an \(80\times40\)
standard normal matrix and \(b\) standard normal. With more rows than columns \(f\) is strongly
convex, and the minimiser has 14 nonzero coordinates, so it lies inside a face of the simplex.
Here \(L=\lambda_{\max}(A^\top A)\) (found by power iteration) and \(D^2=2\), so the theorem promises
\(h_k\le4L/(k+2)\). The reference \(f^\star\) is the pairwise variant run to a gap of \(10^{-13}\).

```{cpp, results="markdown", file="figures/frank_wolfe_rates.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <random>

namespace alg = dm::algorithms;

int main() {
  std::filesystem::create_directories("build");
  const int m = 80, d = 40;
  std::mt19937_64 rng(4);
  std::normal_distribution<double> z;
  std::vector<std::vector<double>> A(m, std::vector<double>(d));
  std::vector<double> b(m);
  for (auto& row : A)
    for (auto& v : row) v = z(rng);
  for (auto& v : b) v = z(rng);
  const auto residual = [&](const std::vector<double>& x) {
    std::vector<double> r(b.size());
    for (int i = 0; i < m; ++i) r[i] = std::inner_product(A[i].begin(), A[i].end(), x.begin(), -b[i]);
    return r;
  };
  const auto f = [&](const std::vector<double>& x) {
    const auto r = residual(x);
    return 0.5 * std::inner_product(r.begin(), r.end(), r.begin(), 0.0);
  };
  const auto grad = [&](const std::vector<double>& x) {
    const auto r = residual(x);
    std::vector<double> g(d, 0.0);
    for (int i = 0; i < m; ++i)
      for (int j = 0; j < d; ++j) g[j] += A[i][j] * r[i];
    return g;
  };
  std::vector<std::vector<double>> AtA(d, std::vector<double>(d, 0.0));
  for (int i = 0; i < m; ++i)
    for (int j = 0; j < d; ++j)
      for (int k = 0; k < d; ++k) AtA[j][k] += A[i][j] * A[i][k];
  const double L = alg::power_iteration(AtA, 2000).value;
  std::vector<double> x0(d, 0.0);
  x0[0] = 1.0;

  const auto ref = alg::frank_wolfe(f, grad, alg::simplex_lmo, x0,
                                    {.max_iter = 100000, .tolerance = 1e-13, .variant = alg::FrankWolfeVariant::Pairwise,
                                     .step = alg::FrankWolfeStep::LineSearch});
  const double f_star = ref.objective.back();
  int support = 0;
  for (const double v : ref.x) support += v > 0;

  struct Run {
    std::string label;
    alg::FrankWolfeVariant variant;
    alg::FrankWolfeStep step;
    dm::RGB colour;
  };
  const std::vector<Run> runs = {
      {"vanilla, 2/(k+2)", alg::FrankWolfeVariant::Vanilla, alg::FrankWolfeStep::Standard, {234, 88, 12}},
      {"vanilla, line search", alg::FrankWolfeVariant::Vanilla, alg::FrankWolfeStep::LineSearch, {217, 119, 6}},
      {"away-step", alg::FrankWolfeVariant::AwayStep, alg::FrankWolfeStep::LineSearch, {37, 99, 235}},
      {"pairwise", alg::FrankWolfeVariant::Pairwise, alg::FrankWolfeStep::LineSearch, {5, 150, 105}}};
  std::vector<std::string> name, e10, e100, e2000, steps;
  int violations = 0;
  auto left = dm::graphics::RPlot::create();
  auto right = dm::graphics::RPlot::create();
  for (const auto& run : runs) {
    const auto r = alg::frank_wolfe(f, grad, alg::simplex_lmo, x0,
                                    {.max_iter = 2000, .tolerance = -1.0, .variant = run.variant, .step = run.step});
    std::vector<double> lk, le, k_lin, le_lin;
    int reached = -1;
    for (std::size_t k = 1; k < r.objective.size(); ++k) {
      const double err = std::max(r.objective[k] - f_star, 1e-16);
      if (r.gap[k] < r.objective[k] - f_star - 1e-9) ++violations;
      if (r.objective[k] - f_star > 4 * L / (k + 2.0)) ++violations;
      if (reached < 0 && err <= 1e-12) reached = static_cast<int>(k);
      lk.push_back(std::log10(double(k)));
      le.push_back(std::log10(err));
      if (k <= 200) k_lin.push_back(double(k)), le_lin.push_back(std::log10(err));
    }
    name.push_back(run.label);
    e10.push_back(std::format("{:.1e}", r.objective[10] - f_star));
    e100.push_back(std::format("{:.1e}", r.objective[100] - f_star));
    e2000.push_back(std::format("{:.1e}", r.objective[2000] - f_star));
    steps.push_back(reached < 0 ? "> 2000" : std::to_string(reached));
    left.lines(lk, le, run.label, run.colour, 2.0);
    right.lines(k_lin, le_lin, run.colour, 2.0);
  }
  std::vector<double> bk, bv;
  for (int k = 1; k <= 2000; k += 10) bk.push_back(std::log10(double(k))), bv.push_back(std::log10(4 * L / (k + 2.0)));
  left.lines(bk, bv, "bound 4L/(k+2)", dm::RGB{100, 116, 139}, 1.5)
      .x_limits(0, 3.4)
      .y_limits(-17, 6)
      .title("Error, log-log")
      .x_label("log10 k")
      .y_label("log10 (f(x_k) - f*)");
  right.x_limits(0, 200).y_limits(-17, 6).title("Error, first 200 steps").x_label("k").y_label("log10 (f(x_k) - f*)");
  dm::graphics::RLayout::create(1, 2).add(left).add(right).size(1100, 500).fit_panels().save_svg("build/frank_wolfe_rates.svg");

  dm::dstruct::DataFrame table;
  table.add_column("method", name);
  table.add_column("error at k = 10", e10);
  table.add_column("k = 100", e100);
  table.add_column("k = 2000", e2000);
  table.add_column("steps to error 1e-12", steps);
  std::print("\\(L={:.1f}\\), \\(f^\\star={:.6f}\\) with {} nonzero coordinates (reference: {} pairwise steps). ", L, f_star,
             support, ref.iterations);
  std::print("Violations of Lemma 1 or of the theorem's bound over all 8,000 iterates: {}.\n\n{}\n", violations, table.to_md());
}
```
