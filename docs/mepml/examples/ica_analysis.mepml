> Checking the theory

>> Preserve the waveform demonstration without assuming random independence

The original report used a sine, square wave and sawtooth on a common deterministic
time grid. Those traces can be separated well in this example, but sharing a time
index does not establish independent random variables. `ica_benchmark(...,"waveforms")`
retains those exact formulas and the original three-by-three mixing matrix.

Fit only x1,x2,x3. For comparison, fit centered, unscaled PCA on the same mixtures.
One-to-one absolute-correlation matching measures recovery for both methods. The
right plot restores the chosen sign, mean and scale of each true source only for
comparison; this supervised alignment is not part of the blind ICA fit. The first
200 of 1000 samples are displayed and all 1000 contribute to fitting and scoring.

```{cpp, results="markdown", file="figures/ica_waveforms.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
  const auto                      d     = dm::stats::ica_benchmark(1000, 42, "waveforms");
  const std::vector<std::string>  names = {"x1", "x2", "x3"};
  const dm::stats::ICA            m(d, names, {3, "logcosh", 500, 1e-8, 42});
  const dm::stats::PCA            pca(d, names, {true, false});
  dm::linalg::DenseMatrix<double> truth(d.nrows(), 3);
  for (std::size_t i = 0; i < d.nrows(); ++i)
    for (std::size_t j = 0; j < 3; ++j)
      truth(i, j) = d.double_at("s" + std::to_string(j + 1), i);
  const auto match     = dm::stats::ica_source_matches(truth, m.sources()),
             pca_match = dm::stats::ica_source_matches(truth, pca.scores());
  auto left = dm::graphics::RPlot::create(), right = dm::graphics::RPlot::create();
  const std::vector<dm::graphics::RGB> colors = {{37, 99, 235}, {220, 38, 38}, {22, 163, 74}};
  for (std::size_t j = 0; j < 3; ++j) {
    std::vector<double> time, mixed, original, recovered;
    const auto          c = std::size_t(match.double_at("component", j)) - 1;
    for (std::size_t i = 0; i < 200; ++i) {
      time.push_back(i);
      mixed.push_back(d.double_at(names[j], i) + 4 * j);
      original.push_back(truth(i, j) + 4 * j);
      recovered.push_back(
          match.double_at("offset", j) + match.double_at("multiplier", j) * m.sources()(i, c) +
          4 * j);
    }
    left.line(time, mixed, names[j], colors[j]);
    right.line(time, recovered, "source " + std::to_string(j + 1), colors[j])
        .points(time, original, "", colors[j], 1.5);
  }
  left.title("Observed mixtures, with vertical offsets")
      .x_label("sample index")
      .y_label("mixture + 4 per trace")
      .y_limits(-2.5, 14);
  right.title("Aligned ICA lines and true-source dots")
      .x_label("sample index")
      .y_label("source + 4 per trace")
      .y_limits(-2.5, 14);
  std::filesystem::create_directories("build");
  dm::graphics::RLayout::create(1, 2).add(left).add(right).size(1100, 490).fit_panels().save_svg(
      "build/ica_waveforms.svg");
  std::print(
      "ICA matching (all 1000 rows):\n\n{}\n\nPCA matching on identical mixtures:\n\n{}\n\nICA "
      "component diagnostics:\n\n{}\n",
      match.to_md(8),
      pca_match.to_md(8),
      m.component_diagnostics().to_md(9));
}
```
