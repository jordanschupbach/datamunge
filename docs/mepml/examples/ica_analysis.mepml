>> Independent-source recovery and a Gaussian control

The independent benchmark draws separate Laplace, uniform and Rademacher source
coordinates, each with population variance one before finite-sample variation.
Compare it with three independent Gaussian sources using the identical mixing
matrix. For each family, four declared data seeds and all three contrasts are fit
with the same 500-update budget and 1e-8 tolerance. The plotted score is the mean
absolute correlation after one-to-one source matching; the table also reports the
worst individual match and numerical stopping.

Gaussian nonidentifiability is a population statement, not a hypothesis test based
on one low score. If \(s\sim N(0,I)\), every orthogonal \(Q\) gives \(Qs\sim N(0,I)\)
because \(\|Qs\|^2=\|s\|^2\). The rotated Gaussian coordinates are also independent.
No observation-only method can distinguish these alternative source bases. Finite
samples can still produce a converged contrast direction and accidentally high
matching correlations; neither contradicts the identification failure. These seed
runs are descriptive sensitivity checks, not confidence intervals or significance tests.

```{cpp, results="markdown", file="figures/ica_controls.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
  auto left = dm::graphics::RPlot::create(), right = dm::graphics::RPlot::create();
  dm::dstruct::DataFrame         table;
  const std::vector<std::string> contrasts    = {"logcosh", "exp", "cube"},
                                 families     = {"independent", "gaussian"};
  const std::vector<std::uint64_t>     seeds  = {3, 7, 11, 19};
  const std::vector<dm::graphics::RGB> colors = {{37, 99, 235}, {220, 38, 38}};
  for (std::size_t family = 0; family < 2; ++family) {
    std::vector<double> x, score, iterations;
    for (std::size_t s = 0; s < seeds.size(); ++s) {
      const auto d = dm::stats::ica_benchmark(1200, seeds[s], families[family]);
      dm::linalg::DenseMatrix<double> truth(d.nrows(), 3);
      for (std::size_t i = 0; i < d.nrows(); ++i)
        for (std::size_t j = 0; j < 3; ++j)
          truth(i, j) = d.double_at("s" + std::to_string(j + 1), i);
      for (std::size_t c = 0; c < contrasts.size(); ++c) {
        const dm::stats::ICA m(d, {"x1", "x2", "x3"}, {3, contrasts[c], 500, 1e-8, 42});
        const auto           matches = dm::stats::ica_source_matches(truth, m.sources());
        const auto           values  = matches.numeric_column("absolute_correlation").values();
        const double         mean    = std::accumulate(values.begin(), values.end(), 0.) / 3;
        const auto count = *std::max_element(m.iterations().begin(), m.iterations().end());
        x.push_back(s + 1 + (double(c) - 1) * .2);
        score.push_back(mean);
        iterations.push_back(std::log10(count));
        dm::dstruct::DataFrame row;
        row.add_column("family", std::vector<std::string>{families[family]});
        row.add_column("data_seed", std::vector<double>{double(seeds[s])});
        row.add_column("contrast", std::vector<std::string>{contrasts[c]});
        row.add_column("mean_abs_correlation", std::vector<double>{mean});
        row.add_column(
            "minimum_abs_correlation",
            std::vector<double>{*std::min_element(values.begin(), values.end())});
        row.add_column("converged", std::vector<double>{m.converged() ? 1. : 0.});
        row.add_column("max_component_iterations", std::vector<double>{double(count)});
        table = table.ncols() ? table.concat_rows(row) : row;
      }
    }
    left.points(x, score, families[family], colors[family], 5);
    right.points(x, iterations, families[family], colors[family], 5);
  }
  left.title("Source recovery across four data seeds")
      .x_label("seed group; three contrasts per group")
      .y_label("mean absolute source correlation")
      .x_limits(.5, 4.5)
      .y_limits(.4, 1.4);
  right.title("Gaussian axes remain unidentifiable")
      .x_label("seed group; three contrasts per group")
      .y_label("log10 maximum component iterations")
      .x_limits(.5, 4.5)
      .y_limits(-.1, 4.5);
  std::filesystem::create_directories("build");
  dm::graphics::RLayout::create(1, 2).add(left).add(right).size(1100, 490).fit_panels().save_svg(
      "build/ica_controls.svg");
  std::print(
      "Seed groups: 3, 7, 11, 19; within-group offsets: logcosh, exp, cube.\n\n{}\n",
      table.to_md(8));
}
```
