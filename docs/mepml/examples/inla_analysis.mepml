\image(figures/inla_normal_exact.svg)
// result_end
\caption(Normal likelihood and normal prior make the mode, mean and inverse-Hessian covariance agree with the exact posterior.)
\alttext(Prior centered at zero, normalized likelihood shape centered at two, and exact posterior centered at 1.5 with SD 0.5. Direct scalar quadrature checks mean, spread and normalized evidence.)

>> Four Bernoulli outcomes: mode and mean separate

Now take \(y=(1,1,1,0)\), a logit link, and \(x\sim N(0,4)\).
The score is \(3-4\operatorname{logistic}(x)-x/4\), and the negative Hessian is
\(4p(1-p)+1/4\). At zero they equal one and 1.25, so the first Newton proposal
is 0.8. The converged mode and local variance describe a Gaussian approximation,
not the exact posterior mean and spread.

`inla_scalar_reference` instead integrates the actual scalar likelihood times its
normal prior on a dense finite midpoint grid. It has quadrature and tail truncation
error, so its window, resolution and edge mass are explicit. We compare small and
larger samples with the same exact success fraction three quarters. Improving
agreement along this sequence is evidence for these inputs, not a universal monotonic
error theorem. A small final Newton score cannot detect the skew error.

```{cpp, results="markdown", file="figures/inla_bernoulli_skew.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
  namespace b           = dm::bayes;
  using M               = dm::linalg::DenseMatrix<double>;
  const auto likelihood = b::inla_binomial_logit_likelihood();
  const auto fit        = b::INLA().conditional(M(4, 1, 1), {1, 1, 1, 0}, likelihood, M(1, 1, .25));
  const auto ref = b::inla_scalar_reference({1, 1, 1, 0}, likelihood, .25, {}, -12, 12, 16001);
  std::vector<double> shown_x, shown_density, gaussian;
  for (std::size_t i = 0; i < ref.marginal_grid[0].size(); ++i) {
    const double v = ref.marginal_grid[0][i];
    if (v < -4 || v > 7)
      continue;
    shown_x.push_back(v);
    shown_density.push_back(ref.marginal_density[0][i]);
    gaussian.push_back(std::exp(b::normal_lpdf(v, fit.mode[0], std::sqrt(fit.covariance(0, 0)))));
  }
  auto density = dm::graphics::RPlot::create()
                     .line(shown_x, shown_density, "direct", {190, 100, 35})
                     .line(shown_x, gaussian, "Gaussian", {40, 100, 190})
                     .title("Four outcomes: a skew posterior")
                     .x_label("log-odds x")
                     .y_label("density")
                     .x_limits(-4, 7)
                     .y_limits(0, .65)
                     .legend({"direct", "Gaussian"}, {{190, 100, 35}, {40, 100, 190}});
  std::vector<double> n, axis, mean_error, sd_error, exact_mean, exact_sd, approx_mean, approx_sd;
  for (std::size_t count : {4, 20, 100, 400}) {
    std::vector<double> y(count, 0);
    std::fill(y.begin(), y.begin() + 3 * count / 4, 1);
    const auto f = b::INLA().conditional(M(count, 1, 1), y, likelihood, M(1, 1, .25));
    const auto r = b::inla_scalar_reference(y, likelihood, .25, {}, -12, 12, 8001);
    n.push_back(count);
    axis.push_back(std::log10(double(count)));
    approx_mean.push_back(f.mode[0]);
    approx_sd.push_back(std::sqrt(f.covariance(0, 0)));
    exact_mean.push_back(r.mean[0]);
    exact_sd.push_back(r.sd[0]);
    mean_error.push_back(std::abs(f.mode[0] - r.mean[0]));
    sd_error.push_back(std::abs(std::sqrt(f.covariance(0, 0)) - r.sd[0]));
  }
  auto errors = dm::graphics::RPlot::create()
                    .line(axis, mean_error, "mean", {40, 100, 190})
                    .points(axis, mean_error, "", {40, 100, 190}, 5)
                    .line(axis, sd_error, "SD", {190, 100, 35})
                    .points(axis, sd_error, "", {190, 100, 35}, 5)
                    .title("Approximation error along a sequence")
                    .x_label("observations (log-spaced)")
                    .x_ticks(axis, {"4", "20", "100", "400"})
                    .y_label("absolute difference")
                    .x_limits(.5, 2.7)
                    .y_limits(0, .23)
                    .legend({"mean", "SD"}, {{40, 100, 190}, {190, 100, 35}});
  dm::graphics::RLayout::create(1, 2)
      .add(density)
      .add(errors)
      .size(1100, 490)
      .fit_panels()
      .save_svg("build/inla_bernoulli_skew.svg");
  dm::dstruct::DataFrame table;
  table.add_column("observations", n);
  table.add_column("Gaussian_mean", approx_mean);
  table.add_column("reference_mean", exact_mean);
  table.add_column("Gaussian_sd", approx_sd);
  table.add_column("reference_sd", exact_sd);
  std::print(
      "Small-sample conditional fit\n\n{}\n\nReference edge mass={:.3g}; log "
      "evidence={:.9f}.\n\nFixed-success-fraction sequence\n\n{}\n",
      b::inla_conditional_table(fit).to_md(6),
      ref.edge_mass,
      ref.log_evidence,
      table.to_md(6));
}
```
