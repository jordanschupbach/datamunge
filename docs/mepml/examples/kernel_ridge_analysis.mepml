// result_end
\caption(A small tuning score does not certify optimal recovery of the known sine mean.)
\alttext(The selected RBF fit follows the sine but has visible local departures. The second panel shows fixed-metric LOO MSE versus log penalty at the selected gamma, with its minimum marked.)

>> Hold the kernel fixed to test the shrinkage claim

Set gamma to five and sweep eight penalties, refitting only the coefficients.
The table reports the actual squared function norm and training RSS, as well as
the three distinct RMSEs. Df decreases towards one, the norm decreases, and
training RSS increases. The error curves need not follow that monotone pattern.
The truth grid is an explicit simulation diagnostic and is never used by the
library's automatic selection rule.

```{cpp, results="markdown", file="figures/krr_penalty_path.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
  const auto             d = dm::stats::kernel_ridge_wave();
  dm::dstruct::DataFrame truth;
  truth.add_column("x", dm::seql(0, 1, 401).values());
  truth = truth.mutate_with(
      "y", [](const auto& r) { return std::sin(2 * std::numbers::pi * r.get_double("x")); });
  std::vector<double> lambda, axis, df, norm, rss, training, loo, recovery;
  for (double penalty : {.0001, .001, .01, .1, 1., 10., 100., 1000.}) {
    dm::stats::KernelRidgeRegressionOptions o;
    o.gamma  = 5;
    o.lambda = penalty;
    const dm::stats::KernelRidgeRegression m(d, "y ~ x", o);
    const auto                             diag = m.diagnostics();
    lambda.push_back(penalty);
    axis.push_back(std::log10(penalty));
    df.push_back(m.effective_degrees_of_freedom());
    norm.push_back(diag.double_at("rkhs_norm_squared", 0));
    training.push_back(diag.double_at("training_rmse", 0));
    rss.push_back(d.nrows() * training.back() * training.back());
    loo.push_back(m.rmse());
    recovery.push_back(m.score(truth).double_at("rmse", 0));
  }
  auto degrees = dm::graphics::RPlot::create()
                     .line(axis, df, "df", {40, 100, 190})
                     .title("Fixed gamma: complexity shrinks")
                     .x_label("log10 lambda")
                     .y_label("effective degrees of freedom")
                     .x_limits(-4, 3)
                     .y_limits(0, 21);
  auto errors = dm::graphics::RPlot::create()
                    .line(axis, training, "training", {130, 130, 130})
                    .line(axis, loo, "fixed-metric LOO", {40, 100, 190})
                    .line(axis, recovery, "known mean", {190, 100, 35})
                    .title("Error need not be monotone")
                    .x_label("log10 lambda")
                    .y_label("RMSE")
                    .x_limits(-4, 3)
                    .y_limits(0, 1.15)
                    .legend(
                        {"training", "fixed-metric LOO", "known mean"},
                        {{130, 130, 130}, {40, 100, 190}, {190, 100, 35}});
  dm::graphics::RLayout::create(1, 2)
      .add(degrees)
      .add(errors)
      .size(1100, 490)
      .fit_panels()
      .save_svg("build/krr_penalty_path.svg");
  dm::dstruct::DataFrame table;
  table.add_column("lambda", lambda);
  table.add_column("df", df);
  table.add_column("rkhs_norm_squared", norm);
  table.add_column("training_RSS", rss);
  table.add_column("training_RMSE", training);
  table.add_column("fixed_metric_LOO_RMSE", loo);
  table.add_column("mean_curve_RMSE", recovery);
  std::print("{}\n", table.to_md(6));
}
```
