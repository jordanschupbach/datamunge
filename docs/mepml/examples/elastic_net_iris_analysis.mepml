| 0.00 | 0.0016857 | 0.3065773 | 0.3211602 | 0.3483351 | 0.9630340 | 4 | 1 | 1 |
| 0.25 | 0.0014717 | 0.3066346 | 0.3209642 | 0.3488251 | 0.9629299 | 4 | 1 | 0 |
| 0.50 | 0.0023728 | 0.3068977 | 0.3207591 | 0.3503871 | 0.9625971 | 3 | 1 | 0 |
