\alttext(Four requested-point loss traces compare two rates with and without extrapolation. Eta 1.5 can remain stable for plain gradient steps while the accelerated recurrence grows.)

> Iris: match the objective before comparing solvers

Predict Petal.Length from Sepal.Length, Sepal.Width and Petal.Width on all 150
Iris flowers. This is a numerical optimisation comparison on a fixed training
objective, not a held-out prediction study. All measurements use centimetres.
We keep raw predictor units and explicitly turn scaling off in the Lasso reference;
otherwise the same numeric penalty would define a different problem. The first
design column is the unpenalised intercept. Both solvers minimise
RSS/(2*n)+lambda*sum(abs(slopes)), with lambda=.1. The smooth gradient Lipschitz
constant is the largest eigenvalue of X transpose X/n; eta=.01 is checked against
that design before using the fixed-step routines. Coordinate-descent tolerances
are tightened for the reference, and its native KKT diagnostics remain visible.

```{cpp, results="markdown", file="figures/opt_proximal_iris.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
  namespace o                        = dm::optim;
  const auto                 iris    = dm::datasets::iris();
  const std::string          formula = "Petal.Length ~ Sepal.Length + Sepal.Width + Petal.Width";
  auto                       data    = o::LeastSquaresObjective::from_data(iris, formula);
  o::L1LeastSquaresObjective f(data.design(), data.response(), .1, false);
  const double               L = data.mean_loss_lipschitz();
  if (.01 * L > 1)
    throw std::runtime_error("fixed proximal step exceeds 1/L");
  std::print("Mean-loss L={:.9g}; eta*L={:.9g}.\n", L, .01 * L);
  dm::stats::LassoOptions opts;
  opts.lambda      = .1;
  opts.standardize = false;
  opts.tol         = 1e-10;
  opts.max_iter    = 100000;
  const dm::stats::Lasso reference(iris, formula, opts);
  std::vector<double>    control{reference.intercept()};
  control.insert(control.end(), reference.coefficients().begin(), reference.coefficients().end());
  const auto a = o::trace_optimize<o::ProximalFunction>(
                 f, o::ProximalGradient({.01, 20000, 1e-10}), std::vector<double>(4, 0)),
             b = o::trace_optimize<o::ProximalFunction>(
                 f, o::FISTA({.01, 20000, 1e-10}), std::vector<double>(4, 0));
  o::optimization_comparison(f, {a, b}, {"ISTA", "FISTA"}, "gradient", f.evaluate(control))
      .title("Iris: matched raw-unit lasso loss")
      .size(850, 490)
      .save_svg("build/opt_proximal_iris.svg");
  std::print(
      "{}\n\nReference diagnostics\n\n{}\n\nReference "
      "slopes\n\n{}\n\nISTA\n\n{}\n\nFISTA\n\n{}\n\nMapping norms: ISTA={:.6g}, FISTA={:.6g}; "
      "reference F={:.9g}.\n",
      (iris | dm::group_by("Species") |
       dm::summarise(dm::agg::n("n"), dm::agg::mean("Petal.Length", "mean_length_cm")))
          .to_md(4),
      reference.diagnostics().to_md(9),
      reference.coefficient_table().to_md(7),
      a.summary().to_md(7),
      b.summary().to_md(7),
      o::proximal_mapping_norm(f, a.coordinates, .01),
      o::proximal_mapping_norm(f, b.coordinates, .01),
      f.evaluate(control));
}
```
