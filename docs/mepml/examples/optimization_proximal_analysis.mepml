\caption(A solver comparison is meaningful only after matching units, intercept treatment and penalty convention.)
\alttext(ISTA and FISTA sample the same raw-unit Iris lasso objective, with the coordinate-descent reference loss as a numerical control. Final mapping norms and reference KKT diagnostics accompany the plot.)

>> Repeat the matched comparison along a penalty path

Sweep six declared penalties, fitting FISTA from zero each time and comparing with
the separately implemented coordinate-descent model. No warm-start cost advantage
is claimed. Penalised slopes can become exactly zero; the intercept is never
thresholded. The figure shows FISTA lines and reference points in identical units,
plus the maximum coefficient difference. Correlated predictors can make coefficient
accuracy more demanding than objective accuracy, so the table also prints each
post-run mapping norm and the reference solver's convergence flag.

```{cpp, results="markdown", file="figures/opt_proximal_path.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
  namespace o                 = dm::optim;
  const auto          iris    = dm::datasets::iris();
  const std::string   formula = "Petal.Length ~ Sepal.Length + Sepal.Width + Petal.Width";
  auto                data    = o::LeastSquaresObjective::from_data(iris, formula);
  std::vector<double> penalty, error, mapping;
  std::vector<std::vector<double>> fitted(3), control(3);
  for (double lambda : {0., .01, .03, .1, .3, 1.}) {
    o::L1LeastSquaresObjective f(data.design(), data.response(), lambda, false);
    const auto                 run = o::trace_optimize<o::ProximalFunction>(
        f, o::FISTA({.01, 20000, 1e-10}), std::vector<double>(4, 0));
    dm::stats::LassoOptions opt;
    opt.lambda      = lambda;
    opt.standardize = false;
    opt.tol         = 1e-10;
    opt.max_iter    = 100000;
    const dm::stats::Lasso ref(iris, formula, opt);
    double                 e = std::abs(run.coordinates[0] - ref.intercept());
    for (std::size_t j = 0; j < 3; ++j) {
      fitted[j].push_back(run.coordinates[j + 1]);
      control[j].push_back(ref.coefficients()[j]);
      e = std::max(e, std::abs(run.coordinates[j + 1] - ref.coefficients()[j]));
    }
    penalty.push_back(lambda);
    error.push_back(std::log10(std::max(1e-14, e)));
    mapping.push_back(o::proximal_mapping_norm(f, run.coordinates, .01));
    std::print(
        "lambda={}: max coefficient difference={:.6g}, mapping norm={:.6g}, reference "
        "converged={}.\n",
        lambda,
        e,
        mapping.back(),
        ref.converged());
  }
  const std::vector<std::string>       labels{"Sepal.Length", "Sepal.Width", "Petal.Width"};
  const std::vector<dm::graphics::RGB> colors{{40, 100, 190}, {190, 100, 35}, {70, 145, 90}};
  auto                                 path = dm::graphics::RPlot::create();
  for (std::size_t j = 0; j < 3; ++j)
    path.line(penalty, fitted[j], labels[j], colors[j])
        .points(penalty, control[j], "coordinate control", colors[j], 3);
  path.title("Slopes: FISTA lines and lasso points")
      .x_label("lambda, raw measurement units")
      .y_label("slope")
      .x_limits(0, 1)
      .y_limits(-1, 2.8)
      .legend(labels, colors);
  auto check = dm::graphics::RPlot::create()
                   .line(penalty, error, "coefficient difference", {40, 100, 190})
                   .title("Matched-solver coefficient check")
                   .x_label("lambda")
                   .y_label("log10 maximum difference, floor 1e-14")
                   .x_limits(0, 1);
  dm::graphics::RLayout::create(1, 2).add(path).add(check).size(1100, 490).fit_panels().save_svg(
      "build/opt_proximal_path.svg");
  dm::dstruct::DataFrame table;
  table.add_column("lambda", penalty);
  table.add_column("mapping_norm", mapping);
  std::print("\n{}\n", table.to_md(10));
}
```
