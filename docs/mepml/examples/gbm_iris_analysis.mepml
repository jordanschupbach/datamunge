> Iris: validation before a final test

>> Declare the split and candidate settings

`dm::datasets::iris()` contains 150 flowers, four numeric measurements in centimetres,
and three species with 50 rows each. Use just Petal.Length and Petal.Width, so decision
regions can be drawn without fixing omitted coordinates. Before fitting, zero-based rows
with index modulo five equal to zero form the 30-row test set; those equal to one form
the 30-row validation set; the remaining 90 rows fit the candidate models. This gives
30/10/10 fitting/validation/test flowers per species. There are no missing values here.

Fix depth two, minimum leaf size two and full-sample fitting. Search eta in {.03,.1,.3}
and every prefix from zero through 120. `gbm_validation_search()` fits one 120-round
model per rate, scores its fixed prefixes on the validation rows and selects the lowest
validation mean log loss. Exact ties prefer the first supplied rate and earliest prefix.
The 363-row candidate table includes the prior-only option for every rate. Training loss
and accuracy accompany the validation metrics for interpretation; they do not select
settings. This is a single declared validation split, not cross-validation or an
uncertainty estimate. A grid endpoint winner means the best setting within this grid.

```{cpp, results="markdown", file="figures/gbm_iris_validation.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
  const auto               d = dm::datasets::iris();
  std::vector<std::size_t> fitting, validation, testing;
  for (std::size_t i = 0; i < d.nrows(); ++i) {
    if (i % 5 == 0)
      testing.push_back(i);
    else if (i % 5 == 1)
      validation.push_back(i);
    else
      fitting.push_back(i);
  }
  const auto train = d.take_rows(fitting), valid = d.take_rows(validation),
             test                         = d.take_rows(testing);
  const std::string               formula = "Species ~ Petal.Length + Petal.Width";
  dm::stats::GBMClassifierOptions options{120, .1, 2};
  options.min_samples_leaf = 2;
  const auto search =
      dm::stats::gbm_validation_search(train, valid, formula, options, {.03, .1, .3});
  auto left = dm::graphics::RPlot::create(), right = dm::graphics::RPlot::create();
  const std::vector<double>            rates  = {.03, .1, .3};
  const std::vector<std::string>       labels = {"eta .03", "eta .1", "eta .3"};
  const std::vector<dm::graphics::RGB> colors = {{37, 99, 235}, {22, 163, 74}, {220, 38, 38}};
  for (std::size_t j = 0; j < rates.size(); ++j) {
    std::vector<std::size_t> rows;
    for (std::size_t i = 0; i < search.candidates.nrows(); ++i)
      if (search.candidates.double_at("learning_rate", i) == rates[j])
        rows.push_back(i);
    const auto curve = search.candidates.take_rows(rows);
    left.line(
        curve.numeric_column("round").values(),
        curve.numeric_column("mean_log_loss").values(),
        labels[j],
        colors[j]);
    if (rates[j] == search.selected_options.learning_rate) {
      right
          .line(
              curve.numeric_column("round").values(),
              curve.numeric_column("training_accuracy").values(),
              "fitting rows",
              {37, 99, 235})
          .line(
              curve.numeric_column("round").values(),
              curve.numeric_column("accuracy").values(),
              "validation rows",
              {220, 38, 38});
    }
  }
  left.title("Validation loss selects rate and round")
      .x_label("round")
      .y_label("validation mean log loss")
      .y_limits(0, 1.6);
  right.title("Selected rate: two accuracy curves")
      .x_label("round")
      .y_label("accuracy fraction")
      .y_limits(0, 1.4);
  std::filesystem::create_directories("build");
  dm::graphics::RLayout::create(1, 2).add(left).add(right).size(1100, 490).fit_panels().save_svg(
      "build/gbm_iris_validation.svg");
  std::print(
      "Fitting/validation/reserved test rows: {}/{}/{}. Candidate stages: {}.\nSelected eta: {}; "
      "selected rounds: {}.\n\nFitting data preview:\n\n{}\n\nLowest validation losses:\n\n{}\n",
      train.nrows(),
      valid.nrows(),
      test.nrows(),
      search.candidates.nrows(),
      search.selected_options.learning_rate,
      search.selected_rounds,
      train.head(3).to_md(2),
      search.candidates.sort_by("mean_log_loss", true)
          .head(6)
          .select(
              {"learning_rate",
               "round",
               "training_mean_log_loss",
               "mean_log_loss",
               "training_accuracy",
               "accuracy",
               "brier"})
          .to_md(8));
}
```
