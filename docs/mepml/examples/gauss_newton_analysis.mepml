>> Recover a generated three-parameter sinusoid

Retain the original report's model \(a\sin(bx+c)\): forty exact values on
\(x_i=.15i\) generated from \((a,b,c)=(3,1.2,.5)\), starting from \((2.5,1,.3)\).
Its analytic Jacobian row is
\((\sin(bx+c),ax\cos(bx+c),a\cos(bx+c))\). Compare analytic and default central-difference
fits using the same stopping tolerance. The table reports actual final SSE and
stationarity diagnostics, while the curve plot uses the analytic fit.

This is a consistency test with known inputs, not a noisy-data performance estimate.
Frequency and phase can have other basins, phase is periodic, and a sign change in
amplitude can be offset by a phase shift. Recovering this representative from this
start does not establish global uniqueness or reliable recovery from arbitrary guesses.

```{cpp, results="markdown", file="figures/gn_sinusoid.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
  const auto model = [](const std::vector<double>& p, double x) {
    return p[0] * std::sin(p[1] * x + p[2]);
  };
  const auto jacobian = [](const std::vector<double>& p, double x) {
    const double t = p[1] * x + p[2];
    return std::vector<double>{std::sin(t), p[0] * x * std::cos(t), p[0] * std::cos(t)};
  };
  std::vector<double> x, y;
  for (int i = 0; i < 40; ++i) {
    x.push_back(.15 * i);
    y.push_back(model({3, 1.2, .5}, x.back()));
  }
  const auto analytic =
                 dm::algorithms::gauss_newton(model, jacobian, x, y, {2.5, 1, .3}, 100, 1e-12),
             numeric       = dm::algorithms::gauss_newton(model, x, y, {2.5, 1, .3}, 100, 1e-12);
  auto                left = dm::graphics::RPlot::create(), right = dm::graphics::RPlot::create();
  std::vector<double> grid, curve;
  for (int i = 0; i <= 200; ++i) {
    grid.push_back(6. * i / 200);
    curve.push_back(model(analytic.params, grid.back()));
  }
  left.points(x, y, "generated data", {220, 38, 38}, 4)
      .line(grid, curve, "analytic-J fit", {37, 99, 235})
      .x_limits(-.1, 6.4)
      .title("Recover the generated sinusoid")
      .x_label("x")
      .y_label("response")
      .y_limits(-3.5, 5.5);
  dm::dstruct::DataFrame                                      table;
  const std::vector<const dm::algorithms::GaussNewtonResult*> fits = {&analytic, &numeric};
  const std::vector<std::string>       names  = {"analytic J", "central differences"};
  const std::vector<dm::graphics::RGB> colors = {{37, 99, 235}, {220, 38, 38}};
  for (std::size_t j = 0; j < 2; ++j) {
    std::vector<double> losses;
    for (const auto& row : fits[j]->history)
      losses.push_back(std::log10(std::max(1e-28, row.sse)));
    right.line(fits[j]->trace().numeric_column("iteration").values(), losses, names[j], colors[j]);
    auto row = fits[j]->trace().tail(1);
    row.add_column("derivatives", std::vector<std::string>{names[j]});
    row.add_column(
        "step_tolerance_met", std::vector<double>{fits[j]->step_tolerance_met ? 1. : 0.});
    table = table.ncols() ? table.concat_rows(row) : row;
  }
  right.title("Two derivative routes agree")
      .x_label("completed updates")
      .y_label("log10 SSE, floor -28")
      .y_limits(-28, 6);
  std::filesystem::create_directories("build");
  dm::graphics::RLayout::create(1, 2).add(left).add(right).size(1100, 490).fit_panels().save_svg(
      "build/gn_sinusoid.svg");
  dm::dstruct::DataFrame::MarkdownOptions fmt;
  fmt.digits     = 10;
  fmt.scientific = {"sse", "gradient_inf", "next_step_norm"};
  std::print(
      "True representative: (3, 1.2, .5).\n\n{}\n",
      table
          .select(
              {"derivatives",
               "iteration",
               "step_tolerance_met",
               "sse",
               "gradient_inf",
               "next_step_norm",
               "p0",
               "p1",
               "p2"})
          .to_md(fmt));
}
```
