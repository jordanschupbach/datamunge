>> Insufficient padding wraps a linear convolution tail

For a=(1,2,3,4) and b=(1,1), full linear convolution is (1,3,5,7,4).
Multiplying length-four spectra instead gives period-four output (5,3,5,7): the final
four wraps into the first sample. The native linear helper pads to eight, then returns
the five supported outputs. Padding here prevents aliasing in the convolution index;
it has a different purpose from interpolating a spectrum display.

```{cpp, results="markdown", file="figures/fft_convolution.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
  using namespace dm::algorithms;
  const auto linear = fft_linear_convolution({1, 2, 3, 4}, {1, 1});
  auto       X      = fft_real({1, 2, 3, 4});
  const auto H      = fft_real({1, 1, 0, 0});
  for (std::size_t k = 0; k < X.size(); ++k)
    X[k] *= H[k];
  const auto          inverse = fft(X, true);
  std::vector<double> circular;
  for (auto z : inverse)
    circular.push_back(z.real());
  dm::dstruct::DataFrame table;
  table.add_column("index", std::vector<double>{0, 1, 2, 3, 4});
  table.add_column("full_linear", linear);
  table.add_column(
      "period_four",
      std::vector<double>{
          circular[0],
          circular[1],
          circular[2],
          circular[3],
          std::numeric_limits<double>::quiet_NaN()});
  auto full = dm::graphics::RPlot::create(), wrap = dm::graphics::RPlot::create();
  full.bars({0, 1, 2, 3, 4}, linear, "linear", {37, 99, 235}, .5)
      .title("Eight FFT bins prevent wraparound")
      .x_label("full output index")
      .y_label("convolution value")
      .y_limits(0, 10);
  wrap.bars({0, 1, 2, 3}, circular, "circular", {220, 38, 38}, .5)
      .title("A period of four folds the tail into zero")
      .x_label("index modulo four")
      .y_label("convolution value")
      .y_limits(0, 10);
  std::filesystem::create_directories("build");
  dm::graphics::RLayout::create(1, 2).add(full).add(wrap).size(1100, 490).fit_panels().save_svg(
      "build/fft_convolution.svg");
  std::print(
      "{}\n\nPeriod-four bin zero: {:.9f}; full linear first plus final: {:.9f}.\n",
      table.to_md(9),
      circular[0],
      linear[0] + linear[4]);
}
```
