These glTF files contain embedded mesh data and can be opened in a glTF viewer.

)

\tab(Python,

```{python, results="markdown", nix-shell="git+file:../../../..#python", cmd="env -u PYTHONPATH ../../../../build/venv/pydatamunge-run/bin/python {file}", file="figures/rebot_arm_python.png"}
from pathlib import Path
import shutil
from pydatamunge import datamunge as dm

# The same native download and SHA-256 verification as the C++ tab.
assets = Path(dm.fetch("rebot_devarm", "../../../../build/cad-assets/rebot"))
out = Path("build/cad_python")
out.mkdir(parents=True, exist_ok=True)
Path("build/figs").mkdir(parents=True, exist_ok=True)

arm = dm.CadScene.from_urdf(str(
    assets / "Rebot_Arm_description/DM/urdf/ReBot_Arm_DM.urdf"))
arm.set_joint("joint2", -.8)
arm.set_joint("joint3", -.7)
arm.set_joint("finger_left", .015)
arm.save_gltf(str(out / "rebot_arm.gltf"))
part = dm.CadScene.from_file(str(
    assets / "hardware/reBot_B601_DM/Metal_Parts/03_Link1.step"))
part.save_gltf(str(out / "rebot_link1.gltf"))

# Render the reopened exports, after checking geometry counts.
saved_arm = dm.CadScene.from_file(str(out / "rebot_arm.gltf"))
saved_part = dm.CadScene.from_file(str(out / "rebot_link1.gltf"))
for source, saved in [(arm, saved_arm), (part, saved_part)]:
    if (source.object_count(), source.triangle_count()) != (
            saved.object_count(), saved.triangle_count()):
        raise RuntimeError("Export changed the object or triangle count")

saved_part.size(900, 650)
saved_part.samples(2)
saved_part.light(.5, -1, 2, "#ffffff", 1.2)
saved_part.light(-1, .5, .5, "#dce8ff", .5)
saved_part.render("build/figs/rebot_link1_python.png")
Path("figures").mkdir(exist_ok=True)
shutil.copyfile("build/figs/rebot_link1_python.png", "figures/rebot_link1_python.png")
saved_arm.size(1100, 850)
saved_arm.samples(2)
saved_arm.light(.5, -1, 2, "#ffffff", 1.3)
saved_arm.light(-1, -.5, .5, "#dce8ff", .6)
saved_arm.render("build/figs/rebot_arm_python.png")

print("| Source | Objects | Triangles | Reopened objects | Reopened triangles |\n| --- | ---: | ---: | ---: | ---: |")
for name, source, saved in [("Posed DevArm", arm, saved_arm),
                            ("STEP link", part, saved_part)]:
    print(f"| {name} | {source.object_count()} | {source.triangle_count()} | "
          f"{saved.object_count()} | {saved.triangle_count()} |")
```
