\tab(R,

```{r, results="markdown", nix-shell="git+file:../../../..#r", cmd="env R_LIBS_USER=../../../../build/r/library Rscript {file}", file="figures/rebot_arm_r.png"}
suppressPackageStartupMessages(library(datamunger))
# Native downloading, verification and cache layout are shared by all tabs.
assets <- fetch("rebot_devarm", "../../../../build/cad-assets/rebot")
out <- "build/cad_r"
dir.create(out, recursive=TRUE, showWarnings=FALSE)
dir.create("build/figs", recursive=TRUE, showWarnings=FALSE)

arm <- CadScene_from_urdf(file.path(
  assets, "Rebot_Arm_description/DM/urdf/ReBot_Arm_DM.urdf"))
invisible(arm$set_joint("joint2", -.8))
invisible(arm$set_joint("joint3", -.7))
invisible(arm$set_joint("finger_left", .015))
invisible(arm$save_gltf(file.path(out, "rebot_arm.gltf")))
part <- CadScene_from_file(file.path(
  assets, "hardware/reBot_B601_DM/Metal_Parts/03_Link1.step"))
invisible(part$save_gltf(file.path(out, "rebot_link1.gltf")))

saved_arm <- CadScene_from_file(file.path(out, "rebot_arm.gltf"))
saved_part <- CadScene_from_file(file.path(out, "rebot_link1.gltf"))
stopifnot(arm$object_count() == saved_arm$object_count(),
          arm$triangle_count() == saved_arm$triangle_count(),
          part$object_count() == saved_part$object_count(),
          part$triangle_count() == saved_part$triangle_count())
invisible(saved_part$size(900L, 650L))
invisible(saved_part$samples(2L))
invisible(saved_part$light(.5, -1, 2, "#ffffff", 1.2))
invisible(saved_part$light(-1, .5, .5, "#dce8ff", .5))
invisible(saved_part$render("build/figs/rebot_link1_r.png"))
dir.create("figures", showWarnings=FALSE)
stopifnot(file.copy("build/figs/rebot_link1_r.png", "figures/rebot_link1_r.png", overwrite=TRUE))
invisible(saved_arm$size(1100L, 850L))
invisible(saved_arm$samples(2L))
invisible(saved_arm$light(.5, -1, 2, "#ffffff", 1.3))
invisible(saved_arm$light(-1, -.5, .5, "#dce8ff", .6))
invisible(saved_arm$render("build/figs/rebot_arm_r.png"))

cat("| Source | Objects | Triangles | Reopened objects | Reopened triangles |\n| --- | ---: | ---: | ---: | ---: |\n")
cat(sprintf("| Posed DevArm | %d | %d | %d | %d |\n", arm$object_count(),
  arm$triangle_count(), saved_arm$object_count(), saved_arm$triangle_count()))
cat(sprintf("| STEP link | %d | %d | %d | %d |\n", part$object_count(),
  part$triangle_count(), saved_part$object_count(), saved_part$triangle_count()))
```
