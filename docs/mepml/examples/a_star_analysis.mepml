\image(figures/a_star_terrain.svg)
// result_end

\caption(Elevation of Maunga Whau on the 10 m grid, from green (94 m) through yellow and brown to near-white (195 m). The start and goal are marked.)
\alttext(A coloured elevation map, x from 0 to 860 metres and y from 0 to 600 metres. A cone of high ground, pink to white, fills the left-centre, with the summit area near x equals 190, y equals 300 to 380, and a lower yellow hollow, the crater, near x equals 280, y equals 330. A ridge of yellow ground runs east from the cone to about x equals 700. The surroundings are green lowland. The start is marked near the bottom-right corner at x equals 800, y equals 50, and the goal near the top-left corner at x equals 50, y equals 550.)

The cone rises from about 100 m to 195 m, with the summit just west of a crater whose floor
sits about 40 m lower. A lower ridge runs east from the cone. Start and goal are both on low
ground, 102 m and 108 m, 901 m apart in a straight line, and the straight line passes over
the summit.

>> A cost model for walking, and heuristics derived from it

Walking uphill is slow. *Naismith's rule* for hill walking allows one hour per 5 km of
distance plus one hour per 600 m of ascent, so one metre of climb is worth
\(5000/600\approx8.33\) metres on the flat. A step from cell \(u\) to a neighbour \(v\)
therefore costs

$$
c(u,v)=\ell(u,v)+\lambda\max\bigl(0,\,z_v-z_u\bigr),\qquad \lambda=\tfrac{5000}{600},
$$
\alttext(c of u v equals l of u v plus lambda times the maximum of 0 and z v minus z u, where lambda equals 5000 over 600.)

where \(\ell\) is 10 m for a straight step and \(10\sqrt2\) m for a diagonal one, and descending
is free. The cost of a path is its length plus \(\lambda\) times its total ascent. Each
heuristic below is a lower bound on that, so each is admissible, and each is consistent.

- **Zero**, \(h=0\): Dijkstra's algorithm.
- **Euclidean**, the straight-line horizontal distance \(\sqrt{\Delta x^2+\Delta y^2}\): no path
  is shorter than a straight line, and climbing only adds cost. It is consistent by the
  triangle inequality.
- **Octile**: on an 8-connected grid the shortest route between two cells \(\Delta_1\) and
  \(\Delta_2\) cells apart along the axes takes \(\min(\Delta_1,\Delta_2)\) diagonal steps
  and \(|\Delta_1-\Delta_2|\) straight ones, so its length is
  \(10\bigl(\max+(\sqrt2-1)\min\bigr)\). This is the exact cost on flat ground, at least
  the Euclidean distance, and still a lower bound.
- **Octile plus climb**: any path from \(v\) to the goal must gain at least
  \(\max(0,z_t-z_v)\) metres in net height, and its ascent is at least its net gain. Adding
  \(\lambda\max(0,z_t-z_v)\) keeps the bound admissible. It stays consistent because
  \(\max(0,z_t-z_u)\le\max(0,z_v-z_u)+\max(0,z_t-z_v)\).

All four satisfy \(0\le h_{\text{Euclid}}\le h_{\text{octile}}\le h_{\text{octile+climb}}\le h^*\),
so by dominance each should expand no more cells than the one before.

> Four searches for the same path

`dm::algorithms::terrain_a_star()` runs A* on the grid and records every cell in the order it
was expanded. We run it with each heuristic and check the expanded sets against the theory.
`terrain_cost_from()` and `terrain_cost_to_go()` give the exact \(g^*\) and \(h^*\) of every
cell (two runs of Dijkstra), so we can count the cells with \(g^*+h<C^*\) and with
\(g^*+h\le C^*\).

```{cpp, results="markdown", file="figures/a_star_expansions.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

#include <chrono>

namespace alg = dm::algorithms;

int main() {
  std::filesystem::create_directories("build");
  const auto grid = alg::terrain_from_frame(dm::datasets::volcano(), "x", "y", "elevation", 5000.0 / 600.0);
  const std::size_t start = 80 * grid.cols + 5, goal = 5 * grid.cols + 55;
  const auto from_start = alg::terrain_cost_from(grid, start);
  const auto to_goal = alg::terrain_cost_to_go(grid, goal);
  const double optimum = from_start[goal];

  const std::vector<std::pair<std::string, alg::TerrainHeuristic>> heuristics = {
      {"zero (Dijkstra)", alg::TerrainHeuristic::Zero},
      {"Euclidean", alg::TerrainHeuristic::Euclidean},
      {"octile", alg::TerrainHeuristic::Octile},
      {"octile + climb", alg::TerrainHeuristic::OctileClimb}};

  std::print("| heuristic | \\(h(s)\\) | \\(h(s)/C^*\\) | path cost | expanded | "
             "cells with \\(g^*+h<C^*\\) | cells with \\(g^*+h\\le C^*\\) | queue pushes | time (ms) |\n"
             "| --- | ---: | ---: | ---: | ---: | ---: | ---: | ---: | ---: |\n");
  auto layout = dm::graphics::RLayout::create(2, 2);
  for (const auto& [name, kind] : heuristics) {
    const auto t0 = std::chrono::steady_clock::now();
    const auto path = alg::terrain_a_star(grid, start, goal, kind);
    const auto t1 = std::chrono::steady_clock::now();
    std::size_t below = 0, at_most = 0;
    for (std::size_t c = 0; c < grid.elevation.size(); ++c) {
      const double f = from_start[c] + alg::terrain_heuristic(grid, c, goal, kind);
      below += f < optimum - 1e-9;
      at_most += f <= optimum + 1e-9;
    }
    const double h0 = alg::terrain_heuristic(grid, start, goal, kind);
    std::print("| {} | {:.0f} | {:.2f} | {:.1f} | {} | {} | {} | {} | {:.1f} |\n", name, h0, h0 / optimum, path.cost,
               path.expansion_order.size(), below, at_most, path.pushes,
               std::chrono::duration<double, std::milli>(t1 - t0).count());

    std::vector<double> ex, ey, px, py;
    for (std::size_t c : path.expansion_order) {
      ex.push_back(grid.cell_size * (c / grid.cols));
      ey.push_back(grid.cell_size * (c % grid.cols));
    }
    for (std::size_t c : path.path) {
      px.push_back(grid.cell_size * (c / grid.cols));
      py.push_back(grid.cell_size * (c % grid.cols));
    }
    layout.add(dm::graphics::RPlot::create()
                   .points(ex, ey, "", dm::RGB{147, 197, 253}, 2.5)
                   .lines(px, py, "", dm::RGB{220, 38, 38}, 2.5)
                   .points({px.front()}, {py.front()}, "", dm::RGB{17, 24, 39}, 7.0)
                   .points({px.back()}, {py.back()}, "", dm::RGB{17, 24, 39}, 7.0)
                   .x_limits(0, 860)
                   .y_limits(0, 600)
                   .title(std::format("{}: {} cells expanded", name, path.expansion_order.size()))
                   .x_label("x (m)")
                   .y_label("y (m)"));
  }
  std::print("\nOptimal cost C* = {:.1f}; cells in the grid: {}.\n", optimum, grid.elevation.size());
  layout.size(1200, 900).save_svg("build/a_star_expansions.svg");
}
```
// result_begin: markdown
| heuristic | \(h(s)\) | \(h(s)/C^*\) | path cost | expanded | cells with \(g^*+h<C^*\) | cells with \(g^*+h\le C^*\) | queue pushes | time (ms) |
| --- | ---: | ---: | ---: | ---: | ---: | ---: | ---: | ---: |
| zero (Dijkstra) | 0 | 0.00 | 1291.5 | 4443 | 4442 | 4443 | 6448 | 0.7 |
| Euclidean | 901 | 0.70 | 1291.5 | 2289 | 2285 | 2293 | 3969 | 0.5 |
| octile | 957 | 0.74 | 1291.5 | 2047 | 1990 | 2061 | 3903 | 0.6 |
| octile + climb | 1007 | 0.78 | 1291.5 | 1732 | 1676 | 1746 | 3571 | 0.5 |

Optimal cost C* = 1291.5; cells in the grid: 5307.
\image(figures/a_star_expansions.svg)
// result_end

\caption(Cells expanded (blue) by each heuristic before the goal came off the queue, with the optimal path in red.)
\alttext(Four panels of the 860 by 600 metre grid, each showing expanded cells as light blue dots and the same red optimal path. The path runs north from the start near x equals 800, y equals 50, turns north-west at about y equals 300, and follows the northern edge of the map west to the goal near x equals 50, y equals 550. Top left, Dijkstra: blue fills almost the whole map except the high cone in the west. Top right, Euclidean: the blue region is a broad band around the path plus a strip along the south. Bottom left, octile, and bottom right, octile plus climb: similar but narrower bands, smallest for octile plus climb.)

All four searches return the same cost, \(C^*=1291.5\), which is the cost Dijkstra's
algorithm certifies as optimal. Each expanded count lies between the two bounds of the
theorem. For Dijkstra, the 4,443 expanded cells are exactly the cells that are cheaper to
reach from the start than the goal is. Only the high cone, which costs more to reach than the whole trip, is left
out. Each stronger heuristic expands fewer cells, as dominance predicts: 2,289 for the
straight-line distance, 2,047 for the octile distance, and 1,732 for octile plus climb, 39%
of Dijkstra's work. The searches take well under a millisecond either way. On a grid this
small the heap operations are cheap, and the saving matters for larger maps or costlier
expansions.

Even the best heuristic expands a third of the grid, although the path has only 99
cells. The heuristic sees only 78% of the true cost from the start. The 22% it misses is the
detour around the cone, which no local bound can anticipate. Every cell whose
\(g^*+h\) falls below \(C^*\) must be expanded, and with a gap that large many cells do.

Building this example exposed a subtle issue. In the first run, octile plus climb expanded
1,757 entries, more than the 1,746 cells the theorem allows. The heuristic is consistent, but
25 cells had been expanded twice. On a grid, many routes have the same real cost, for
example a straight step then a diagonal one, or the reverse, but their floating-point sums
can differ in the last bit. The search treated that difference as a cheaper route and
reopened closed cells. `terrain_a_star()` now ignores improvements smaller than a relative
\(10^{-12}\), and a test checks that no cell is expanded twice.

>> How tight are the heuristics?

The ratio \(h/h^*\) measures how much of the true remaining cost a heuristic sees. The figure
plots it for every cell against the cell's elevation.

```{cpp, results="markdown", file="figures/a_star_tightness.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

namespace alg = dm::algorithms;

int main() {
  std::filesystem::create_directories("build");
  const auto grid = alg::terrain_from_frame(dm::datasets::volcano(), "x", "y", "elevation", 5000.0 / 600.0);
  const std::size_t goal = 5 * grid.cols + 55;
  const auto to_goal = alg::terrain_cost_to_go(grid, goal);

  std::print("| heuristic | mean \\(h/h^*\\) | median | 10th percentile | max | cells with \\(h=h^*\\) |\n"
             "| --- | ---: | ---: | ---: | ---: | ---: |\n");
  const std::vector<std::pair<std::string, alg::TerrainHeuristic>> heuristics = {
      {"Euclidean", alg::TerrainHeuristic::Euclidean},
      {"octile", alg::TerrainHeuristic::Octile},
      {"octile + climb", alg::TerrainHeuristic::OctileClimb}};
  const std::vector<dm::RGB> colours = {{245, 158, 11}, {37, 99, 235}, {22, 163, 74}};
  auto layout = dm::graphics::RLayout::create(1, 3);
  for (std::size_t k = 0; k < heuristics.size(); ++k) {
    std::vector<double> ratio, elevation;
    std::size_t exact = 0;
    for (std::size_t c = 0; c < grid.elevation.size(); ++c) {
      if (c == goal) continue;
      const double h = alg::terrain_heuristic(grid, c, goal, heuristics[k].second);
      ratio.push_back(h / to_goal[c]);
      elevation.push_back(grid.elevation[c]);
      exact += std::abs(h - to_goal[c]) < 1e-9;
    }
    auto sorted = ratio;
    std::ranges::sort(sorted);
    double mean = 0.0;
    for (double r : ratio) mean += r / ratio.size();
    std::print("| {} | {:.3f} | {:.3f} | {:.3f} | {:.3f} | {} |\n", heuristics[k].first, mean,
               sorted[sorted.size() / 2], sorted[sorted.size() / 10], sorted.back(), exact);
    layout.add(dm::graphics::RPlot::create()
                   .points(elevation, ratio, "", colours[k], 2.0)
                   .y_limits(0, 1.05)
                   .title(heuristics[k].first)
                   .x_label("elevation of the cell (m)")
                   .y_label("h / h*"));
  }
  layout.size(1350, 440).save_svg("build/a_star_tightness.svg");
}
```
