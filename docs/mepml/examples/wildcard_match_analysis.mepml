> Applying whole-field filters and inspecting work

Each summary row counts matched records once. A field with two occurrences
of `William` still contributes one match to `*William*`; this differs from
an occurrence-counting substring search. The work columns aggregate actual
scan steps, literal byte tests and last-star expansions across records.
They are not wall-clock timings.

```{cpp, results="markdown", file="figures/wildcard_filters.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
  const auto passengers = dm::datasets::titanic();
  const std::vector<std::string> patterns{"Mr.*","*Mr.*","*Mrs.*","*Miss.*","*Master.*","*William*","*Anna*","*mr.*"};
  const auto result = dm::algorithms::wildcard_summary(passengers,"Name",patterns);
  std::print("{}\n",(result.select({"pattern","evaluated_rows","matches","steps","literal_tests","retries"}) |
      dm::mutate("pattern",[](const auto& row) { return "`"+row.get_string("pattern")+"`"; })).to_md());
  std::print("\nA filtered subset:\n\n{}\n",dm::algorithms::wildcard_filter(passengers,"Name","*Anna*")
      .select({"PassengerId","Name","Survived"}).head(6).to_md());
  std::print("\n| title pattern | matched passengers | survival fraction |\n| :--- | ---: | ---: |\n");
  for (const auto& pattern : std::vector<std::string>{"*Mr.*","*Mrs.*","*Miss.*","*Master.*"}) {
    const auto group = dm::algorithms::wildcard_filter(passengers,"Name",pattern);
    const auto summary = group | dm::summarise(dm::agg::n("passengers"),dm::agg::mean("Survived","survival"));
    std::print("| `{}` | {} | {:.6f} |\n",pattern,summary.double_at("passengers",0),summary.double_at("survival",0));
  }
  std::filesystem::create_directories("build");
  dm::graphics::RPlot::barplot(result.get_column("matches").values(),patterns,"matched records")
      .title("Whole-field glob filters count passenger records")
      .x_label("restricted glob pattern").y_label("matched passengers").size(1100,480).save_svg("build/wildcard_filters.svg");
}
```
