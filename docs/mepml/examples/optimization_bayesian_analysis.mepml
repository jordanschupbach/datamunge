| 0.0 | 1.00000 | 0.00000 | 0.00000 | 0.00000 | 1.00000 |
| 0.5 | 0.64516 | 0.42225 | 0.00000 | 0.00005 | -0.19935 |
| 1.0 | 0.00000 | 0.59325 | 0.01123 | 0.04593 | -1.18650 |
| 1.5 | -0.64516 | 0.42225 | 0.04725 | 0.20035 | -1.48966 |
| 2.0 | -1.00000 | 0.00000 | 0.00000 | 0.50000 | -1.00000 |
| 3.0 | -0.68862 | 0.79183 | 0.18432 | 0.34707 | -2.27227 |
| 5.0 | -0.01284 | 0.99994 | 0.08536 | 0.16177 | -2.01272 |


Log marginal likelihood: -2.98515
// result_end

The table reproduces the hand values at \(x=1\): mean 0, standard deviation 0.59325, expected
improvement 0.01123. At the observations the standard deviation is 0 and the mean is the observed
value. Far away, at \(x=5\), the posterior is almost the prior \(N(0,1)\). The log marginal likelihood
is \(-\tfrac12\cdot2/(1-e^{-2})-\tfrac12\log(1-e^{-4})-\log2\pi=-2.98515\).

The three criteria disagree about where to go next. Expected improvement is largest at \(x=3\) (0.184),
just beyond the better observation, where the mean is low (−0.69) and the uncertainty is
substantial (0.79). It still values \(x=5\), where nothing is known, at 0.085, and between the two
observations at \(x=0.5\) it is essentially zero, because a mean of 0.65 is unlikely to beat −1.
Probability of improvement gives its largest value, 0.5, to \(x=2\), the incumbent itself, where
there is nothing to gain. There the mean equals the incumbent and rounding leaves a standard
deviation of about \(10^{-8}\), so \(u\) is 0/0. This shows PI's weakness: it rewards any chance of
improvement, however small the gain.

>> One dimension, step by step

The function \(f(x)=\sin 3x+x^2-0.7x\) on \([-1,2]\) has a local minimum near \(x=1.37\) and a lower one near
\(x=-0.36\). Bayesian optimization starts from three random points, fits \(\ell\) by marginal likelihood
and uses EI.

```{cpp, results="markdown", file="figures/bo_1d.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

struct Wiggle : dm::optim::ArbitraryFunction {
  double evaluate(const std::vector<double>& x) override { return std::sin(3.0 * x[0]) + x[0] * x[0] - 0.7 * x[0]; }
};

int main() {
  std::filesystem::create_directories("build");
  Wiggle f;
  // The true minimum, by a fine grid.
  double x_min = -1.0, f_min = 1e300;
  for (int i = 0; i <= 300000; ++i) {
    const double x = -1.0 + 3.0 * i / 300000.0, v = f.evaluate({x});
    if (v < f_min) f_min = v, x_min = x;
  }
  std::print("True minimum: f({:.4f}) = {:.6f}\n\n", x_min, f_min);

  const dm::optim::GaussianProcessSurrogateOptions gp_options{.noise = 1e-8};
  dm::optim::RBFGaussianProcessSurrogate gp(gp_options);
  const auto r = dm::optim::BayesianOptimization({.initial_samples = 3, .max_iterations = 9, .seed = 5}).run(f, {-1.0}, {2.0}, gp);

  // Refit on each prefix of the history: the surrogate the loop used before each proposal.
  std::vector<double> step, xs, fs, best, ells, eis;
  for (std::size_t n = 1; n <= r.values.size(); ++n) {
    step.push_back(double(n)), xs.push_back(r.points[n - 1][0]), fs.push_back(r.values[n - 1]), best.push_back(r.best_values[n - 1]);
    if (n > 3) {
      dm::optim::RBFGaussianProcessSurrogate g(gp_options);
      g.fit({r.points.begin(), r.points.begin() + long(n - 1)}, {r.values.begin(), r.values.begin() + long(n - 1)});
      ells.push_back(g.length_scale()), eis.push_back(r.acquisition_values[n - 4]);
    } else {
      ells.push_back(std::nan("")), eis.push_back(std::nan(""));
    }
  }
  dm::dstruct::DataFrame table;
  table.add_column("evaluation", step);
  table.add_column("x", xs);
  table.add_column("f(x)", fs);
  table.add_column("best so far", best);
  table.add_column("fitted length scale", ells);
  table.add_column("EI at x", eis);
  dm::dstruct::DataFrame::MarkdownOptions md;
  md.digits = 4;
  md.column_digits = {{"evaluation", 0}};
  std::print("{}\n", table.to_md(md));

  // Panels: the surrogate and EI after 3 and after 6 evaluations.
  const auto blue = dm::RGB{37, 99, 235}, red = dm::RGB{220, 38, 38}, grey = dm::RGB{148, 163, 184}, ink = dm::RGB{17, 24, 39};
  auto fig = dm::graphics::RLayout::create(2, 2);
  for (const std::size_t n : {4u, 6u}) {
    dm::optim::RBFGaussianProcessSurrogate g(gp_options);
    const std::vector<std::vector<double>> px(r.points.begin(), r.points.begin() + long(n));
    const std::vector<double> pv(r.values.begin(), r.values.begin() + long(n));
    g.fit(px, pv);
    const double incumbent = *std::min_element(pv.begin(), pv.end());
    std::vector<double> grid, truth, mu, lo, hi, ei;
    for (int i = 0; i <= 300; ++i) {
      const double x = -1.0 + 3.0 * i / 300.0;
      const auto p = g.predict({x});
      grid.push_back(x), truth.push_back(f.evaluate({x})), mu.push_back(p.mean);
      lo.push_back(p.mean - 2.0 * p.sd), hi.push_back(p.mean + 2.0 * p.sd);
      ei.push_back(dm::optim::expected_improvement(p.mean, p.sd, incumbent));
    }
    std::vector<double> band_x = grid, band_y = hi;
    band_x.insert(band_x.end(), grid.rbegin(), grid.rend());
    band_y.insert(band_y.end(), lo.rbegin(), lo.rend());
    std::vector<double> obs_x;
    for (const auto& q : px) obs_x.push_back(q[0]);
    const double next = r.points[n][0];

    auto surface = dm::graphics::RPlot::create();
    surface.polygon(band_x, band_y, dm::graphics::tint(blue, 0.8), true);
    surface.lines(grid, truth, "f", ink, 1.5).lines(grid, mu, "GP mean +/- 2 sd", blue, 2.0);
    surface.points(obs_x, pv, red, 7.0);
    surface.segments({next}, {-3.0}, {next}, {5.0}, grey, 1.5);
    surface.x_limits(-1.0, 2.0).y_limits(-3.0, 5.0).title(std::format("After {} evaluations", n)).x_label("x").y_label("f(x)");

    double ei_max = *std::max_element(ei.begin(), ei.end());
    auto acq = dm::graphics::RPlot::create();
    acq.lines(grid, ei, red, 2.0).segments({next}, {0.0}, {next}, {1.1 * ei_max}, grey, 1.5);
    acq.x_limits(-1.0, 2.0).y_limits(0.0, 1.1 * ei_max).title(std::format("Expected improvement, n = {}", n)).x_label("x").y_label("EI");
    fig.add(surface).add(acq);
  }
  fig.size(1100, 820).fit_panels();
  fig.save_svg("build/bo_1d.svg");
}
```
