| 1000 | 49F1C09B | 9F1C09B0 | 8 | 0.13 |
| 10000 | 8AC8FCFB | AC8FCFB8 | 8 | 1.71 |
| 100000 | 35EA16C4 | 5EA16C40 | 8 | 35.2 |
