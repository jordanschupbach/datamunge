>> Change the curvature, then check the returned point

Replace diagonal curvature (2,2,2) by (2,100,200), preserving centre, start, settings
and budgets. The minimizer stays fixed. Coordinate normalisation addresses unequal
gradient magnitudes but does not certify convergence or remove all dependence on
scale. This generated objective is the experiment; no external dataset is needed.

```{cpp, results="markdown", file="figures/opt_adaptive_stiff.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
  namespace o = dm::optim;
  o::QuadraticObjective f({2, 100, 200}, {4, -2, 1});
  o::AdaGradOptions     a;
  a.step_size      = .5;
  a.max_iterations = 5000;
  o::RMSPropOptions b;
  b.step_size      = .03;
  b.max_iterations = 5000;
  o::AdaDeltaOptions c;
  c.max_iterations = 5000;
  o::AMSGradOptions d;
  d.step_size      = .03;
  d.max_iterations = 5000;
  o::NadamOptions e;
  e.step_size      = .03;
  e.max_iterations = 5000;
  std::vector<o::OptimizationRun> runs;
  runs.push_back(o::trace_optimize<o::DifferentiableFunction>(f, o::AdaGrad(a), {10, 10, 10}));
  runs.push_back(o::trace_optimize<o::DifferentiableFunction>(f, o::RMSProp(b), {10, 10, 10}));
  runs.push_back(o::trace_optimize<o::DifferentiableFunction>(f, o::AdaDelta(c), {10, 10, 10}));
  runs.push_back(o::trace_optimize<o::DifferentiableFunction>(f, o::AMSGrad(d), {10, 10, 10}));
  runs.push_back(o::trace_optimize<o::DifferentiableFunction>(f, o::Nadam(e), {10, 10, 10}));
  const std::vector<std::string> labels{"AdaGrad", "RMSProp", "AdaDelta", "AMSGrad", "Nadam"};
  o::optimization_comparison(f, runs, labels)
      .title("Stiff bowl: same declared settings")
      .size(850, 490)
      .save_svg("build/opt_adaptive_stiff.svg");
  for (std::size_t i = 0; i < runs.size(); ++i)
    std::print("{}\n\n{}\n\n", labels[i], runs[i].summary().to_md(7));
}
```
