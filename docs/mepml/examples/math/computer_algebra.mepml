//? Title: Computer algebra system
//? Subtitle: Symbolic expressions, calculus and TeX in C++, Python and R
//? Exports: both
//? Lang: en-GB

Choose a language tab for each example. Code and its results stay together.
Run each tab independently. Python uses the local package in
`build/venv/pydatamunge-run`; R uses `build/r/library`. Build these once with
`just build-python` and `just build-r`, and rebuild after binding changes.

> Computer algebra system

`dm::algebra::Expr` builds symbolic expression trees from named variables and
numeric constants. In C++, use `+`, `-`, `*`, `/` and `^`, with numeric literals
on either side; unary `+` and `-` work too. Write `(x ^ 3) - 2 * x + 1`:
C++ gives `^` lower precedence than the arithmetic operators, so combined powers
need parentheses. Powers associate to the left; use `x ^ (y ^ z)` to group a
power on the right. C++ also accepts numeric arguments in named methods, such
as `x.power(3)`.

The named methods `.add()`, `.subtract()`, `.multiply()`, `.divide()` and
`.power()` remain available in every language. Elementary functions include
`.sin()`, `.cos()`, `.exp()` and `.log()`. `.differentiate("x")` and
`.integrate("x")` return new expressions, while `.evaluate({"x"}, {value})`
binds a variable to a number. Copies share immutable expression nodes; numeric
constants use `double`.

Start with $f(x)=x^3-2x+1$. `.to_tex()` renders the actual expression tree as
an owned `dm::Tex` value in C++: fractions, powers, functions and grouping come from
the symbolic structure. Chain `.inline_math()` for table cells or `.display()`
for a standalone equation; annotations such as `.underbrace()` also work.
Use `.to_tex(precision)` to choose significant digits (seven by default).
Single-letter variable names render as math symbols; longer logical names are
escaped literal text. Formatting leaves the symbolic expression unchanged. Python and R return
raw TeX strings from `.to_tex()`; the examples wrap them in math delimiters.

Here $F$ is one antiderivative; the general one is $F(x)+C$. `.simplify()` folds constants and identities;
it does not collect like terms or perform general factorization. Symbolic
integration applies supported rules and throws for unsupported expressions;
differentiation currently requires constant exponents in powers.

\tabs(
\tab(C++,

```{cpp, results="markdown", nix-shell="git+file:../../../..#cpp", cmd="c++ -std=c++23 -O2 {file} -o {bin} $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge) && {bin}"}
#include <dm/dm.hpp>

int main() {
  using dm::algebra::Expr;
  const auto x = Expr::variable("x");
  const auto f = (x ^ 3) - 2 * x + 1;
  std::print("{}\n", f);
  const auto padded = f * 1 + 0;
  const auto derivative = f.differentiate("x").simplify();
  const auto primitive = f.integrate("x").simplify();
  const auto wave = (2 * x).sin();

  std::print("| Operation | Rendered expression |\n|---|---|\n");
  std::print("| Build an expression | {} |\n", padded.to_tex().inline_math());
  std::print("| Simplify | {} |\n", padded.simplify().to_tex().inline_math());
  std::print("| Differentiate with respect to x | {} |\n", derivative.to_tex().inline_math());
  std::print("| Integrate with respect to x | {} |\n", primitive.to_tex().inline_math());
  std::print("| Trigonometric expression | {} |\n", wave.to_tex().inline_math());
  std::print("| Chain-rule derivative | {} |\n\n",
    wave.differentiate("x").simplify().to_tex().inline_math());
  std::print("{}\n\n", (dm::Tex(R"(\frac{df}{dx} = )") +
    derivative.to_tex().underbrace("f'(x)")).display());

  std::print("| x | f(x) | f'(x) | F(x) |\n|---:|---:|---:|---:|\n");
  for (double value : {-1., 0., 1., 2.}) {
    std::print("| {:.0f} | {:.6f} | {:.6f} | {:.6f} |\n", value,
      f.evaluate({"x"}, {value}), derivative.evaluate({"x"}, {value}),
      primitive.evaluate({"x"}, {value}));
  }
  const auto symbolic_area = primitive.evaluate({"x"}, {2}) - primitive.evaluate({"x"}, {0});
  const auto numeric_area = dm::algebra::definite_integral(f, "x", 0, 2);
  std::print("\n{}\n", dm::Tex(std::format(
    R"(\int_0^2 f(x)\,dx = {:.6f},\qquad I_{{\mathrm{{quadrature}}}} = {:.6f})",
    symbolic_area, numeric_area)).display());
}
```
// result_begin: markdown
(((x ^ 3) - (2 * x)) + 1)
| Operation | Rendered expression |
|---|---|
| Build an expression | $\left(x^{3} - 2 \cdot x + 1\right) \cdot 1 + 0$ |
| Simplify | $x^{3} - 2 \cdot x + 1$ |
| Differentiate with respect to x | $3 \cdot x^{2} - 2$ |
| Integrate with respect to x | $\frac{x^{4}}{4} - 2 \cdot \frac{x^{2}}{2} + x$ |
| Trigonometric expression | $\sin\left(2 \cdot x\right)$ |
| Chain-rule derivative | $\cos\left(2 \cdot x\right) \cdot 2$ |

$$
\frac{df}{dx} = \underbrace{3 \cdot x^{2} - 2}_{f'(x)}
$$

| x | f(x) | f'(x) | F(x) |
|---:|---:|---:|---:|
| -1 | 2.000000 | 1.000000 | -1.750000 |
| 0 | 1.000000 | -2.000000 | 0.000000 |
| 1 | 0.000000 | 1.000000 | 0.250000 |
| 2 | 5.000000 | 10.000000 | 2.000000 |

$$
\int_0^2 f(x)\,dx = 2.000000,\qquad I_{\mathrm{quadrature}} = 2.000000
$$
// result_end

)
\tab(Python,

```{python, results="markdown", nix-shell="git+file:../../../..#python", cmd="env -u PYTHONPATH ../../../../build/venv/pydatamunge-run/bin/python {file}"}
from pydatamunge import datamunge as dm

x = dm.Expr.variable("x")
f = x.power(dm.Expr.constant(3)).subtract(x.multiply(dm.Expr.constant(2))).add(dm.Expr.constant(1))
padded = f.multiply(dm.Expr.constant(1)).add(dm.Expr.constant(0))
derivative = f.differentiate("x").simplify()
primitive = f.integrate("x").simplify()
wave = x.multiply(dm.Expr.constant(2)).sin()

print("| Operation | Rendered expression |\n|---|---|")
for label, expression in [
    ("Build an expression", padded),
    ("Simplify", padded.simplify()),
    ("Differentiate with respect to x", derivative),
    ("Integrate with respect to x", primitive),
    ("Trigonometric expression", wave),
    ("Chain-rule derivative", wave.differentiate("x").simplify()),
]:
    print(f"| {label} | ${expression.to_tex()}$ |")
print("\n$$\nf'(x) = " + derivative.to_tex() + "\n$$\n")
print("| x | f(x) | f'(x) | F(x) |\n|---:|---:|---:|---:|")
for value in [-1.0, 0.0, 1.0, 2.0]:
    print(f"| {value:.0f} | {f.evaluate(['x'], [value]):.6f} | "
          f"{derivative.evaluate(['x'], [value]):.6f} | {primitive.evaluate(['x'], [value]):.6f} |")
symbolic_area = primitive.evaluate(["x"], [2]) - primitive.evaluate(["x"], [0])
numeric_area = dm.definite_integral(f, "x", 0, 2)
print(f"\nAntiderivative difference: {symbolic_area:.6f}; quadrature: {numeric_area:.6f}.")
```
