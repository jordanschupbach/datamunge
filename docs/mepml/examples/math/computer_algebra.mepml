\tab(R,

```{r, results="markdown", nix-shell="git+file:../../../..#r", cmd="env R_LIBS_USER=../../../../build/r/library Rscript {file}"}
suppressPackageStartupMessages(library(datamunger))
datamunger::hello()

x <- Expr_variable("x")
f <- x$power(Expr_constant(3))$subtract(x$multiply(Expr_constant(2)))$add(Expr_constant(1))
padded <- f$multiply(Expr_constant(1))$add(Expr_constant(0))
derivative <- f$differentiate("x")$simplify()
primitive <- f$integrate("x")$simplify()
wave <- x$multiply(Expr_constant(2))$sin()

expressions <- list(padded, padded$simplify(), derivative, primitive,
                    wave, wave$differentiate("x")$simplify())
labels <- c("Build an expression", "Simplify", "Differentiate with respect to x",
            "Integrate with respect to x", "Trigonometric expression", "Chain-rule derivative")
cat("| Operation | Rendered expression |\n|---|---|\n")
for (i in seq_along(expressions)) {
  cat(sprintf("| %s | $%s$ |\n", labels[i], expressions[[i]]$to_tex()))
}
cat("\n$$\nf'(x) = ", derivative$to_tex(), "\n$$\n\n", sep = "")
cat("| x | f(x) | f'(x) | F(x) |\n|---:|---:|---:|---:|\n")
for (value in c(-1, 0, 1, 2)) {
  cat(sprintf("| %.0f | %.6f | %.6f | %.6f |\n", value,
    f$evaluate("x", value), derivative$evaluate("x", value), primitive$evaluate("x", value)))
}
symbolic_area <- primitive$evaluate("x", 2) - primitive$evaluate("x", 0)
numeric_area <- definite_integral(f, "x", 0, 2)
cat(sprintf("\nAntiderivative difference: %.6f; quadrature: %.6f.\n", symbolic_area, numeric_area))
```
