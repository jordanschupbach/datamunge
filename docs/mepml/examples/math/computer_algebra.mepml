`dm::algebra::Polynomial` stores coefficients in ascending degree order:
`{-1, 0, 1}` represents $x^2-1$. `.divmod()` returns a quotient and remainder,
`poly_gcd()` returns a monic greatest common divisor, and `RationalFunction`
cancels common polynomial factors. Their `.to_tex(variable, precision)` methods
use conventional signs and powers; choose a formal variable such as `"h"` for
a Taylor polynomial. Rational functions render as fractions, with a unit
denominator omitted. The block composes the original fraction and its reduced
form directly from these TeX values.

The reduced rational-function object does not retain the original excluded
point $x=1$. Polynomial coefficients also use `double` arithmetic.

Finally, `taylor_series(f, "x", center, order)` builds a polynomial in
$h=x-\mathrm{center}$. The code expands $e^x$ about $x=1$ through degree four
and evaluates the result at `value - 1`, comparing it with the original
expression near the expansion point.

\tabs(
\tab(C++,

```{cpp, results="markdown", nix-shell="git+file:../../../..#cpp", cmd="c++ -std=c++23 -O2 {file} -o {bin} $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge) && {bin}"}
#include <dm/dm.hpp>

int main() {
  using dm::algebra::Polynomial;
  // Coefficients are ordered from the constant term upwards.
  const Polynomial p({-1, 0, 1}); // x^2 - 1
  const Polynomial q({-1, 1});    // x - 1
  const auto [quotient, remainder] = p.divmod(q);
  const auto gcd = dm::algebra::poly_gcd(p, q);
  const dm::algebra::RationalFunction reduced(p, q);

  std::print("| Operation | Returned value |\n|---|---|\n");
  std::print("| Dividend p(x) | {} |\n", p.to_tex().inline_math());
  std::print("| Divisor q(x) | {} |\n", q.to_tex().inline_math());
  std::print("| Quotient | {} |\n", quotient.to_tex().inline_math());
  std::print("| Remainder | {} |\n", remainder.to_tex().inline_math());
  std::print("| Monic GCD | {} |\n", gcd.to_tex().inline_math());
  std::print("| Reduced rational function | {} |\n", reduced.to_tex().inline_math());
  std::print("| Reduced function at x = 2 | `{:.6f}` |\n\n", reduced.evaluate(2));
  std::print("{}\n\n", (p.to_tex().frac(q.to_tex()) + " = " +
    reduced.to_tex() + R"(\quad (x\ne 1))").display());

  const auto exponential = dm::algebra::Expr::variable("x").exp();
  const auto taylor = dm::algebra::taylor_series(exponential, "x", 1., 4);
  std::print("Taylor approximation about x = 1, evaluated at h = x - 1:\n\n");
  std::print("{}\n\n", (dm::Tex("T_4(h) = ") + taylor.to_tex("h")).display());
  std::print("| x | Degree-4 approximation | exp(x) | Absolute error |\n|---:|---:|---:|---:|\n");
  for (double value : {0.8, 1., 1.2}) {
    const auto approximation = taylor.evaluate(value - 1.);
    const auto actual = exponential.evaluate({"x"}, {value});
    std::print("| {:.1f} | {:.9f} | {:.9f} | {:.3e} |\n",
      value, approximation, actual, std::abs(approximation - actual));
  }
}
```
// result_begin: markdown
| Operation | Returned value |
|---|---|
| Dividend p(x) | ${x}^{2} - 1$ |
| Divisor q(x) | $x - 1$ |
| Quotient | $x + 1$ |
| Remainder | $0$ |
| Monic GCD | $x - 1$ |
| Reduced rational function | $x + 1$ |
| Reduced function at x = 2 | `3.000000` |

$$
\frac{{x}^{2} - 1}{x - 1} = x + 1\quad (x\ne 1)
$$

Taylor approximation about x = 1, evaluated at h = x - 1:

$$
T_4(h) = 0.1132617\,{h}^{4} + 0.453047\,{h}^{3} + 1.359141\,{h}^{2} + 2.718282\,h + 2.718282
$$

| x | Degree-4 approximation | exp(x) | Absolute error |
|---:|---:|---:|---:|
| 0.8 | 2.225547942 | 2.225540928 | 7.014e-06 |
| 1.0 | 2.718281828 | 2.718281828 | 0.000e+00 |
| 1.2 | 3.320109425 | 3.320116923 | 7.497e-06 |
// result_end

)
\tab(Python,

```{python, results="markdown", nix-shell="git+file:../../../..#python", cmd="env -u PYTHONPATH ../../../../build/venv/pydatamunge-run/bin/python {file}"}
from pydatamunge import datamunge as dm

p = dm.Polynomial([-1, 0, 1])
q = dm.Polynomial([-1, 1])
quotient = dm.poly_quotient(p, q)
remainder = dm.poly_remainder(p, q)
gcd = dm.poly_gcd(p, q)
reduced = dm.RationalFunction(p, q)

print("| Operation | Returned value |\n|---|---|")
for label, value in [("Dividend p(x)", p), ("Divisor q(x)", q),
                     ("Quotient", quotient), ("Remainder", remainder),
                     ("Monic GCD", gcd), ("Reduced rational function", reduced)]:
    print(f"| {label} | ${value.to_tex()}$ |")
print(f"| Reduced function at x = 2 | `{reduced.evaluate(2):.6f}` |")
print("\n$$\n\\frac{" + p.to_tex() + "}{" + q.to_tex() + "} = " + reduced.to_tex() + r"\quad (x\ne 1)" + "\n$$\n")
exponential = dm.Expr.variable("x").exp()
taylor = dm.taylor_series(exponential, "x", 1, 4)
print("Taylor approximation about x = 1, evaluated at h = x - 1:\n")
print("$$\nT_4(h) = " + taylor.to_tex("h") + "\n$$\n")
print("| x | Degree-4 approximation | exp(x) | Absolute error |\n|---:|---:|---:|---:|")
for value in [0.8, 1.0, 1.2]:
    approximation = taylor.evaluate(value - 1)
    actual = exponential.evaluate(["x"], [value])
    print(f"| {value:.1f} | {approximation:.9f} | {actual:.9f} | {abs(approximation-actual):.3e} |")
```
