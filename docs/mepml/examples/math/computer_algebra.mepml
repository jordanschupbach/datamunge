\tab(R,

```{r, results="markdown", nix-shell="git+file:../../../..#r", cmd="env R_LIBS_USER=../../../../build/r/library Rscript {file}"}
suppressPackageStartupMessages(library(datamunger))

p <- Polynomial(c(-1, 0, 1))
q <- Polynomial(c(-1, 1))
quotient <- poly_quotient(p, q)
remainder <- poly_remainder(p, q)
gcd <- poly_gcd(p, q)
reduced <- RationalFunction(p, q)
values <- list(p, q, quotient, remainder, gcd, reduced)
labels <- c("Dividend p(x)", "Divisor q(x)", "Quotient", "Remainder",
            "Monic GCD", "Reduced rational function")
cat("| Operation | Returned value |\n|---|---|\n")
for (i in seq_along(values)) {
  cat(sprintf("| %s | $%s$ |\n", labels[i], values[[i]]$to_tex()))
}
cat(sprintf("| Reduced function at x = 2 | `%.6f` |\n", reduced$evaluate(2)))
cat("\n$$\n\\frac{", p$to_tex(), "}{", q$to_tex(), "} = ", reduced$to_tex(), "\\quad (x\\ne 1)\n$$\n\n", sep = "")
exponential <- Expr_variable("x")$exp()
taylor <- taylor_series(exponential, "x", 1, 4L)
cat("Taylor approximation about x = 1, evaluated at h = x - 1:\n\n")
cat("$$\nT_4(h) = ", taylor$to_tex("h"), "\n$$\n\n", sep = "")
cat("| x | Degree-4 approximation | exp(x) | Absolute error |\n|---:|---:|---:|---:|\n")
for (value in c(0.8, 1, 1.2)) {
  approximation <- taylor$evaluate(value - 1)
  actual <- exponential$evaluate("x", value)
  cat(sprintf("| %.1f | %.9f | %.9f | %.3e |\n", value, approximation, actual, abs(approximation-actual)))
}
```
