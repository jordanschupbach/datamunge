[training history|file:figures/fruit_stream_physics_rl_training.csv],
[physical screening|file:figures/fruit_stream_physics_rl_screening.csv],
[RGB validation|file:figures/fruit_stream_physics_rl_validation.csv],
[held-out outcomes|file:figures/fruit_stream_physics_rl_evaluation.csv],
