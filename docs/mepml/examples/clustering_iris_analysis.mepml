| 10 | 78.8514414 |
| 20 | 78.8514414 |

\image(figures/clustering_iris_sweeps.svg)
// result_end
\caption(An elbow compares model sizes, while a restart sweep compares optimization attempts at one fixed size.)
\alttext(The left panel plots WCSS for one through eight clusters. The right plots the best WCSS from increasing prefixes of one seeded restart stream at three clusters. Tables retain every value.)

>> Compare four linkages and re-cut one Ward tree

Each linkage is fitted at three clusters using the same four raw features.
The table includes a two-cluster cut of the already fitted Ward tree, whose 149 merges
are reused unchanged. Its dendrogram exposes large late merges, but a visually large
height gap is not proof of a true species count. Linkage rankings by a species agreement
score describe this dataset and geometry; they do not establish a universally superior
linkage. Ties among equal distances may change individual merges in another implementation.

```{cpp, results="markdown", file="figures/clustering_iris_linkage.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
  using namespace dm::stats;
  const auto                     d = dm::datasets::iris();
  const std::vector<std::string> f = {"Sepal.Length", "Sepal.Width", "Petal.Length", "Petal.Width"};
  std::vector<std::string>       truth;
  for (std::size_t i = 0; i < d.nrows(); ++i)
    truth.push_back(d.string_at("Species", i));
  std::vector<std::string> name;
  std::vector<double>      k, purity, ari;
  int                      index = 0;
  for (auto linkage :
       {LinkageCriterion::Single,
        LinkageCriterion::Complete,
        LinkageCriterion::Average,
        LinkageCriterion::Ward}) {
    AgglomerativeClusteringOptions o;
    o.n_clusters = 3;
    o.linkage    = linkage;
    const AgglomerativeClustering m(d, f, o);
    const auto a = cluster_agreement(std::vector<int>(m.labels().begin(), m.labels().end()), truth);
    name.push_back(std::vector<std::string>{"single", "complete", "average", "ward"}[index++]);
    k.push_back(a.clusters);
    purity.push_back(a.purity);
    ari.push_back(a.adjusted_rand);
  }
  AgglomerativeClusteringOptions o;
  o.n_clusters = 3;
  const AgglomerativeClustering ward(d, f, o);
  const auto                    cut = ward.cut(2);
  const auto a = cluster_agreement(std::vector<int>(cut.begin(), cut.end()), truth);
  name.push_back("ward recut");
  k.push_back(a.clusters);
  purity.push_back(a.purity);
  ari.push_back(a.adjusted_rand);
  auto tree       = plot_dendrogram(ward, "Ward: all 149 merges retained");
  auto projection = plot_clusters(
      d,
      "Petal.Length",
      "Petal.Width",
      std::vector<int>(cut.begin(), cut.end()),
      "Same Ward tree, cut at two groups");
  dm::dstruct::DataFrame t;
  t.add_column("linkage", name);
  t.add_column("clusters", k);
  t.add_column("purity", purity);
  t.add_column("adjusted_rand", ari);
  std::filesystem::create_directories("build");
  dm::graphics::RLayout::create(1, 2)
      .add(tree)
      .add(projection)
      .size(1100, 490)
      .fit_panels()
      .save_svg("build/clustering_iris_linkage.svg");
  std::print(
      "{}\n\nWard merge history size: {} (unchanged by cut).\n",
      t.to_md(6),
      ward.merge_history().size());
}
```
