\documentclass[tikz,border=9pt]{standalone}
\usepackage[T1]{fontenc}
\usepackage{lmodern}
\usepackage{amsmath}
\usetikzlibrary{arrows.meta,positioning}
\begin{document}
\begin{tikzpicture}[>=Stealth,thick, every node/.style={font=\large},
 obs/.style={draw,rounded corners,minimum width=1.4cm,minimum height=.8cm},
 latent/.style={draw,circle,minimum size=1cm}]
\node[latent,fill=blue!8] (f) at (0,2.4) {$f$};
\node[obs] (x1) at (-3,0) {$x_1$};
\node[obs] (x2) at (0,0) {$x_2$};
\node[obs] (x3) at (3,0) {$x_3$};
\draw[->,blue!70!black] (f) -- node[above left] {$\lambda_1$} (x1);
\draw[->,blue!70!black] (f) -- node[right] {$\lambda_2$} (x2);
\draw[->,blue!70!black] (f) -- node[above right] {$\lambda_3$} (x3);
\foreach \i/\xx in {1/-3,2/0,3/3}{
 \node[latent,fill=red!6] (e\i) at (\xx,-1.7) {$\epsilon_\i$};
 \draw[->,red!70!black] (e\i) -- (x\i);
}
\node at (0,3.5) {$\operatorname{Var}(f)=1,\quad \operatorname{Cov}(f,\epsilon)=0$};
\node at (0,-2.8) {$\operatorname{Cov}(x_i,x_j)=\lambda_i\lambda_j\quad(i\ne j)$};
\node at (0,-3.6) {$\operatorname{Var}(x_j)=\lambda_j^2+\psi_j,\quad
  \operatorname{Var}(\epsilon_j)=\psi_j$};
\node[font=\normalsize] at (0,-4.35) {Independent unique terms add variance, but no cross-covariance.};
\end{tikzpicture}
\end{document}
