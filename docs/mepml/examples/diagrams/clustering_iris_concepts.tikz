\documentclass[tikz,border=10pt]{standalone}
\usepackage[T1]{fontenc}
\usepackage{lmodern}
\usetikzlibrary{arrows.meta}
\begin{document}
\begin{tikzpicture}[font=\sffamily,point/.style={circle,fill=blue!75,inner sep=2.2pt}]
\begin{scope}
\node[font=\sffamily\bfseries] at (1.5,2.5) {K-means: nearby centres};
\draw[rounded corners,gray!50] (-.2,-.4) rectangle (3.2,2.15);
\foreach \x/\y in {.3/.8,.6/1.1,2.2/.8,2.5/1.1} \node[point] at (\x,\y) {};
\draw[dashed,gray] (1.4,-.1)--(1.4,1.9);
\foreach \x in {.45,2.35} {\draw[red,very thick] (\x-.1,.95)--(\x+.1,.95);\draw[red,very thick] (\x,.85)--(\x,1.05);}
\node[align=center] at (1.5,-.95) {Assign to nearest centre;\\update centres to means.};
\end{scope}
\begin{scope}[xshift=4.5cm]
\node[font=\sffamily\bfseries] at (1.5,2.5) {Hierarchy: nested merges};
\draw[rounded corners,gray!50] (-.2,-.4) rectangle (3.2,2.15);
\draw[blue!75,thick] (.3,.1)--(.3,.8)--(.8,.8)--(.8,.1);
\draw[blue!75,thick] (2.1,.1)--(2.1,1.1)--(2.6,1.1)--(2.6,.1);
\draw[blue!75,thick] (.55,.8)--(.55,1.8)--(2.35,1.8)--(2.35,1.1);
\foreach \x in {.3,.8,2.1,2.6} \node[point] at (\x,.1) {};
\node[align=center] at (1.5,-.95) {Choose a linkage;\\cut the fitted merge tree.};
\end{scope}
\begin{scope}[xshift=9cm]
\node[font=\sffamily\bfseries] at (1.5,2.5) {DBSCAN: local density};
\draw[rounded corners,gray!50] (-.2,-.4) rectangle (3.2,2.15);
\draw[dashed,blue!55] (.8,.9) circle (.57);
\draw[blue!75,thick] (.25,.9)--(.8,.9)--(1.35,.9);
\node[point] at (.8,.9) {};
\foreach \x in {.25,1.35} \draw[blue!75,fill=white,thick] (\x,.9) circle (.075);
\draw[gray,thick] (2.5,1.15)--(2.65,1.3) (2.5,1.3)--(2.65,1.15);
\node[font=\small] at (.8,.2) {core + two borders};
\node[font=\small] at (2.6,.65) {noise};
\node[align=center] at (1.5,-.95) {$\mathrm{min\_samples}=3$ includes self;\\border points do not extend chains.};
\end{scope}
\end{tikzpicture}
\end{document}
