\documentclass[tikz,border=10pt]{standalone}
\usepackage{amsmath,lmodern}
\usetikzlibrary{arrows.meta}
\begin{document}
\begin{tikzpicture}[>=Stealth,font=\large,box/.style={draw=blue!55!black,rounded corners,fill=blue!4,align=center,minimum width=4.2cm,minimum height=1.8cm},every edge/.style={draw,thick,->}]
\node[box] (n0) at (0.0,0) {Full gradient\\$g_t=\nabla f(x_t)$};
\node[box,fill=orange!8] (n1) at (5.6,0) {Coordinate memory\\$G_t$ or $V_t$};
\node[box] (n2) at (11.2,0) {Scaled update\\$x_{t+1}=x_t-D_tg_t$};
\path (n0) edge (n1) (n1) edge (n2);
\node[align=center,font=\normalsize] at (5.6,-2) {Diagonal memory changes step lengths; it does not solve for cross-coordinate curvature.};
\end{tikzpicture}
\end{document}
