\documentclass[tikz,border=10pt]{standalone}
\usepackage{amsmath,lmodern}
\usetikzlibrary{arrows.meta}
\begin{document}
\begin{tikzpicture}[>=Stealth,font=\large,box/.style={draw=blue!55!black,rounded corners,fill=blue!4,align=center,minimum width=4.2cm,minimum height=1.8cm},every edge/.style={draw,thick,->}]
\node[box] (n0) at (0.0,0) {Sampled row\\$g_i(w)$};
\node[box,fill=orange!8] (n1) at (5.6,0) {Control variate\\$g_i(w)-g_i(s)+\nabla f(s)/n$};
\node[box] (n2) at (11.2,0) {Mean-loss step\\$w^+=w-\eta v_i$};
\path (n0) edge (n1) (n1) edge (n2);
\node[align=center,font=\normalsize] at (5.6,-2) {SVRG pays for a full snapshot plus two row gradients per update; objective calls are separate.};
\end{tikzpicture}
\end{document}
