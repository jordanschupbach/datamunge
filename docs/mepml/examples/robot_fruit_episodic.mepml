//? Title: Robot-arm fruit-sorting playground
//? Exports: both
//? Lang: en-GB

> Robot-arm fruit-sorting playground

>> A conveyor workcell

This first experiment creates a headless physics environment and imports the
real Seeed DevArm CAD model. One randomly selected apple or banana travels down
the conveyor. An optical pick sensor stops the belt in front of the arm, and
the fruit waits there. The learning task below uses the red bin on one side as
the target for either fruit; the yellow bin is a distractor. This first video holds
the stopped scene for several seconds.

The reusable `dm::sim::ConveyorEnvironment` owns the physical belt, fruit, floor,
pedestal and open sorting bins. Its belt uses tangential contact friction,
not prescribed fruit positions. Physics runs at 240 Hz; the video samples it at
24 frames per second. A seed controls the fruit sequence independently of
rendering. Every run records the seed and trajectory for replay.

```{cpp, results="markdown", nix-shell="git+file:../../..#cpp", cmd="c++ -std=c++23 -O2 {file} -o {bin} $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge) && {bin}"}
#include <dm/dm.hpp>
#include <algorithm>
#include <charconv>
#include <cstdlib>
#include <fstream>
#include <random>
#include <stdexcept>

// The URDF loader bakes link placements into mesh coordinates. Place the arm
// on the end pedestal facing back along the conveyor (a half-turn about Z).
void add_arm(dm::cad::Scene& scene, dm::cad::Scene arm) {
  const int mesh_offset = int(scene.meshes.size());
  const int texture_offset = int(scene.textures.size());
  for (auto& mesh : arm.meshes) {
    for (std::size_t i = 0; i < mesh.positions.size(); i += 3) {
      mesh.positions[i] = .62f - mesh.positions[i];
      mesh.positions[i + 1] = -mesh.positions[i + 1];
      mesh.positions[i + 2] += .72f;
    }
    for (std::size_t i = 0; i < mesh.normals.size(); i += 3) {
      mesh.normals[i] *= -1; mesh.normals[i + 1] *= -1;
    }
    scene.meshes.push_back(std::move(mesh));
  }
  for (auto& texture : arm.textures) scene.textures.push_back(std::move(texture));
  for (auto object : arm.objects) {
    object.mesh_index += mesh_offset;
    for (int* slot : {&object.texture_index, &object.normal_map_index,
                      &object.roughness_map_index, &object.metallic_map_index})
      if (*slot >= 0) *slot += texture_offset;
    object.parent = -1;
    scene.AddObject(object);
  }
}

int main() {
  namespace fs = std::filesystem;
  fs::create_directories("build/fruit_sorting/frames");
  fs::create_directories("figures");
  const fs::path assets = dm::datasets::fetch(
    "rebot_devarm", "../../../build/cad-assets/rebot");
  auto robot = dm::cad::Robot::load_urdf(
    (assets / "Rebot_Arm_description/DM/urdf/ReBot_Arm_DM.urdf").string());
  robot.set_joint("joint2", -1.05);
  robot.set_joint("joint3", -.65);
  robot.set_joint("finger_left", .025);

  // Set DATAMUNGE_CONVEYOR_SEED to the printed integer to repeat a run.
  std::random_device entropy;
  std::uint64_t seed = (std::uint64_t(entropy()) << 32) ^ entropy();
  if (const char* value = std::getenv("DATAMUNGE_CONVEYOR_SEED")) {
    const std::string text(value);
    auto [end, error] = std::from_chars(text.data(), text.data()+text.size(), seed);
    if (error != std::errc{} || end != text.data()+text.size())
      throw std::invalid_argument("DATAMUNGE_CONVEYOR_SEED must be an unsigned integer");
  }
  dm::sim::ConveyorEnvironment env(dm::sim::FruitVariation::Diverse);
  env.reset(seed);
  auto scenery = env.static_scene();
  scenery.objects.erase(std::remove_if(scenery.objects.begin(), scenery.objects.end(),
    [](const auto& o) { return o.name == "apple bin symbol" || o.name == "banana bin symbol"; }),
    scenery.objects.end());
  add_arm(scenery, robot.scene());
  dm::cad::Light key;
  key.direction = {-1, -2, 3}; key.intensity = 1.0f;
  scenery.AddLight(key);
  dm::cad::Light fill;
  fill.direction = {1, 1, 2}; fill.intensity = .35f;
  scenery.AddLight(fill);
  dm::cad::Camera camera;
  camera.position = {-1.65, -2.10, 3.40};
  camera.target = {-.10, 0, .78};
  camera.projection = dm::cad::Projection::Orthographic;
  camera.ortho_height = 1.95;
  dm::cad::RenderOptions options;
  options.width = 960; options.height = 640;
  options.samples = 1; options.background = {.91f, .94f, .96f, 1};

  // Cache the detailed, stationary CAD background. Moving actors are ray traced
  // separately, then depth-composited so rails, bins and the arm occlude them.
  // Static shadows are cached too; moving fruit does not cast onto the backdrop.
  const auto background = dm::cad::render(scenery, camera, options);
  std::ofstream trajectory("build/fruit_sorting/trajectory.csv");
  trajectory << "frame,time,x,y_up,z_across,vx,vy,vz,waiting\n";
  constexpr int fps = 24, frames = 8 * fps;
  double stopped_x = 0;
  for (int frame = 0; frame < frames; ++frame) {
    auto state = env.observation();
    auto moving_scene = env.dynamic_scene();
    moving_scene.lights = scenery.lights;
    auto actors = dm::cad::render(moving_scene, camera, options);
    auto image = background;
    for (std::size_t pixel = 0; pixel < image.depth.size(); ++pixel)
      if (actors.depth[pixel] < image.depth[pixel]) {
        std::copy_n(actors.rgba.begin() + 4*pixel, 4, image.rgba.begin() + 4*pixel);
        image.depth[pixel] = actors.depth[pixel];
        image.object_ids[pixel] = actors.object_ids[pixel];
      }
    image.save(std::format("build/fruit_sorting/frames/{:04}.png", frame));
    if (frame == frames-1) {
      image.save("build/fruit_sorting/poster.png");
      if (state.stage != dm::sim::ConveyorStage::Waiting || std::abs(state.velocity[0]) > .002)
        throw std::runtime_error("Fruit did not stop at the pick station");
      if (std::abs(state.position[0]-stopped_x) > .001)
        throw std::runtime_error("Waiting fruit drifted during the final second");
    }
    if (frame == frames-fps) stopped_x = state.position[0];
    trajectory << std::format("{},{:.8f},{:.8f},{:.8f},{:.8f},{:.8f},{:.8f},{:.8f},{}\n",
      frame, state.time, state.position[0], state.position[1], state.position[2],
      state.velocity[0], state.velocity[1], state.velocity[2],
      state.stage == dm::sim::ConveyorStage::Waiting ? 1 : 0);
    for (int tick = 0; tick < 5; ++tick) env.step(1./120);
  }
  const auto final = env.observation();
  const std::string fruit = final.kind == dm::sim::FruitKind::Apple ? "apple" : "banana";
  std::ofstream metadata("build/fruit_sorting/run.json");
  metadata << std::format("{{\"seed\":{},\"fruit\":\"{}\",\"arrival_seconds\":{:.8f},"
    "\"fps\":{},\"frames\":{},\"physics_hz\":240}}\n",
    seed, fruit, final.arrival_time, fps, frames);

  // H.264 baseline / YUV420 is playable by mep and ordinary HTML video players.
  // Encoding uses the ffmpeg supplied by the repository's C++ development shell.
  const int status = std::system(
    "ffmpeg -hide_banner -loglevel error -y -framerate 24 "
    "-i build/fruit_sorting/frames/%04d.png -frames:v 192 -an "
    "-c:v libx264 -profile:v baseline -level 3.1 -bf 0 -g 48 "
    "-preset fast -crf 19 -pix_fmt yuv420p -movflags +faststart "
    "build/fruit_sorting/arrival.mp4");
  if (status != 0) throw std::runtime_error("ffmpeg could not encode the arrival video");
  fs::copy_file("build/fruit_sorting/arrival.mp4", "figures/fruit_sorting_arrival.mp4",
    fs::copy_options::overwrite_existing);
  fs::copy_file("build/fruit_sorting/poster.png", "figures/fruit_sorting_poster.png",
    fs::copy_options::overwrite_existing);
  std::println("Seed `{}` selected **{}** as the first fruit. The pick sensor stopped the belt at **{:.3f} s**. "
    "The fruit is waiting for the robot; no picking policy has run.\n", seed, fruit, final.arrival_time);
  std::println("\\video(figures/fruit_sorting_arrival.mp4)");
}
```
// result_begin: markdown
Seed `15675708447074113772` selected **banana** as the first fruit. The pick sensor stopped the belt at **4.642 s**. The fruit is waiting for the robot; no picking policy has run.

\video(figures/fruit_sorting_arrival.mp4)
// result_end
\caption(The first randomly selected fruit arrives at the DevArm pick station and waits. Red: target bin for either fruit; yellow: distractor bin.)
\alttext(A Seeed robot arm beside a conveyor, with a red target bin and a yellow spare bin on opposite sides. One fruit travels along the belt and stops in front of the arm.)

[Open or download the arrival video|file:figures/fruit_sorting_arrival.mp4].

\image(figures/fruit_sorting_poster.png)
