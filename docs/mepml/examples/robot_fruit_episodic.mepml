\image(figures/fruit_vision_classifier_learning.svg)
\caption(Training and validation curves. Validation uses prototype 4, which is absent from training; the lowest validation loss selects weights and BN moments together.)
\alttext(Training and validation cross entropy and validation accuracy across forty epochs.)

\image(figures/fruit_vision_confusion.svg)
\caption(All 256 held-out-prototype RGB predictions; true classes run top to bottom and predicted classes left to right.)
\alttext(A two-by-two confusion matrix counts every apple and banana classification.)

\image(figures/fruit_vision_inspection.png)
