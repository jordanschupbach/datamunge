\alttext(Two rows of six fruit prototypes in different colors, sizes and orientations, with visible bounding boxes.)

\image(figures/fruit_vision_camera_samples.png)
\caption(The first 24 unannotated classifier crops from held-out prototype 5. These RGB pixels, enlarged twofold, are the model inputs.)
