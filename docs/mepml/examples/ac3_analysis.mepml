)

Plotting the candidates AC-3 leaves against the number of givens shows a
strong trend: fewer givens leave more candidates. Only puzzles with 30 or
more givens are solved outright. Where the collections overlap, at 22 to 28
givens, the spread is wide. One `hardest` puzzle with 22 givens ends with
fewer candidates than any easy puzzle that AC-3 fails to solve.

```{cpp, results="output", file="figures/ac3_givens.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

namespace sudoku = dm::algorithms::sudoku;

int main() {
  std::filesystem::create_directories("build");
  const auto puzzles = dm::datasets::sudoku();
  auto plot = dm::graphics::RPlot::create();
  const std::vector<std::pair<std::string, dm::RGB>> groups{
      {"easy50", {37, 99, 235}}, {"top95", {234, 88, 12}}, {"hardest", {220, 38, 38}}};
  for (const auto& [name, color] : groups) {
    std::vector<double> givens, left;
    for (std::size_t k = 0; k < puzzles.nrows(); ++k) {
      if (puzzles.string_at("collection", k) != name) continue;
      givens.push_back(puzzles.double_at("givens", k));
      left.push_back(double(sudoku::candidates(sudoku::propagate(puzzles.string_at("puzzle", k)).domains)));
    }
    plot.points(givens, left, name, color, 5.0);
  }
  plot.abline_h(81.0)
      .title("Candidates left by AC-3 against the number of givens")
      .x_label("givens")
      .y_label("candidates after AC-3")
      .size(820, 520)
      .save_svg("build/ac3_givens.svg");
}
```
