| 0 |  | 0 | 0 |  | 0 |  | hs |
| 1 | h | 1 | 0 |  | 0 |  | ei |
| 3 | s | 1 | 0 |  | 0 |  | h |
| 2 | he | 2 | 0 |  | 0 | 0 | r |
| 6 | hi | 2 | 0 |  | 0 |  | s |
