> Keep every moving-state and optimizer write visible

The complete program below uses four stores and two Adam states: learning rate
.0002, beta1=.5, beta2=.999, epsilon1e-8. D first captures its joint BN moments,
commits only D state with explicit Double retention.9, and applies gradients only
to D. G is then recomputed through the updated D using D's updated saved moments;
G's two captures are committed before its selected Adam write. G's fake path is
stopped during D. Neither component API performs these writes or a fitting loop.

All original artifacts are preserved. Additional first/final phase archives expose
the actual full derivatives and captures; every fitting step checks that unselected
stores stay bit exact. First-step effect sizes are saved separately. Final probes
and generated-image controls leave all stores unchanged. Checkpoint restoration
creates independent stores and verifies every tensor. Three validation rows log
diagnostics; no validation/test score selects a checkpoint, seed or epoch.

```{cpp, results="markdown", file="figures/dcgan_learning.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <chrono>
#include <cmath>
#include <dm/dm.hpp>
#include <fstream>
#include <iostream>

namespace nn = dm::nn;
namespace m  = nn::models;
using Arrays = std::map<std::string, nn::Tensor>;
using nn::Tensor;

namespace {
void Require(bool condition, const std::string& message) {
  if (!condition)
    throw std::runtime_error(message);
}
void Near(double actual, double expected, double tolerance, const std::string& message) {
  Require(std::abs(actual - expected) <= tolerance, message);
}
void SaveArrays(const std::string& path, const Arrays& a) {
  nn::save_npz(path, nn::NamedTensors(a.begin(), a.end()));
}
bool Equal(const Tensor& a, const Tensor& b) {
  return nn::equal_bits(a, b);
}
bool Equal(const Arrays& a, const Arrays& b) {
  if (a.size() != b.size())
    return false;
  for (const auto& [key, value] : a)
    if (!b.count(key) || !Equal(value, b.at(key)))
      return false;
  return true;
}
Tensor Gaussian(std::int64_t rows, std::int64_t width, std::uint64_t seed) {
  return nn::cast(
      m::GaussianNoise({rows, width}, 1, seed).reshape({rows, width}), nn::DType::Float32);
}
double MaxAbsDiff(const Tensor& a, const Tensor& b) {
  return nn::max(nn::abs(nn::cast(a, nn::DType::Float64) - nn::cast(b, nn::DType::Float64))).item();
}
void Finite(const Arrays& a, const std::string& message) {
  for (auto& [key, v] : a)
    for (double x : v.to_vector<double>())
      Require(std::isfinite(x), message + key);
}
std::vector<std::int64_t> Range(std::int64_t count) {
  std::vector<std::int64_t> r(count);
  std::iota(r.begin(), r.end(), 0);
  return r;
}
Arrays Fields(const m::DcganOutput& o) {
  return {
      {"fake", o.fake},
      {"real_logit", o.real_logit},
      {"fake_logit", o.fake_logit},
      {"real_probability", o.real_probability},
      {"fake_probability", o.fake_probability},
      {"discriminator_loss", o.d_loss},
      {"generator_loss", o.g_loss}};
}
Arrays TrainingFields(const m::DcganPhaseOutput& a, const m::DcganPhaseOutput& b) {
  return {
      {"d_train_logits", nn::concat({a.real_logit, a.fake_logit}, 0)},
      {"d_for_g_logits", b.fake_logit},
      {"g_train_signed", b.fake},
      {"discriminator_loss", a.loss},
      {"generator_loss", b.loss},
      {"g/stem_bn/batch_mean", b.stem_mean},
      {"g/stem_bn/batch_var", b.stem_variance},
      {"g/up14_bn/batch_mean", b.up14_mean},
      {"g/up14_bn/batch_var", b.up14_variance},
      {"d/down7_bn/batch_mean", a.down7_mean},
      {"d/down7_bn/batch_var", a.down7_variance}};
}
/// Logistic GAN algebra at extreme logits: finite losses and gradients, and
/// a strong non-saturating G gradient when D is confident a sample is fake.
void Algebra(const std::filesystem::path& root) {
  Tensor real = nn::tensor({-80, -2, 2, 80}, {4, 1}), fake = nn::tensor({80, 2, -2, -80}, {4, 1});
  real.requires_grad_();
  fake.requires_grad_();
  const auto   loss = m::LogisticGanObjectives(real, fake);
  const auto   dg   = nn::grad(loss.discriminator, {real, fake});
  const auto   gg   = nn::grad(loss.generator, {fake});
  const Arrays out{
      {"discriminator_loss", loss.discriminator.detach()},
      {"generator_loss", loss.generator.detach()},
      {"d_real_gradient", dg[0]},
      {"d_fake_gradient", dg[1]},
      {"g_fake_gradient", gg[0]}};
  Finite(out, "extreme logits finite GAN loss/gradients");
  Require(gg[0].at({3, 0}) < -.24, "non-saturating G has strong gradient when D confident fake");
  std::cout << "logistic algebra: D loss=" << loss.discriminator.item()
            << ", G loss=" << loss.generator.item() << ", dD/dreal=" << dg[0].values_str()
            << ", dG/dfake=" << gg[0].values_str() << '\n';
  auto saved = out;
  saved.emplace("real", real.detach());
  saved.emplace("fake", fake.detach());
  SaveArrays((root / "logistic_algebra.npz").string(), saved);
}

double Value(const Arrays& a, const std::string& key) {
  return a.at(key).item();
}

/// The fit-pool mean image repeated n times, [n, 784].
Tensor FitMean(const Tensor& fit, std::int64_t n) {
  return nn::tile(nn::mean(nn::reshape(fit, {-1, 784}), {0}, true), {n, 1});
}

void SaveSheet(const std::filesystem::path& path, const Tensor& images, std::int64_t cols) {
  // tflow's Mosaic: 3x pixels, 4-pixel gaps of gray 220.
  nn::save_image_grid(
      nn::reshape(images, {-1, 28, 28, 1}), path.string(), cols, 0, 1, 4, 220 / 255., 3);
}

} // namespace
int main() {
  const std::filesystem::path root   = "build/dcgan";
  const int                   epochs = 3;
  const auto                  data = std::filesystem::path(dm::datasets::data_home()) / "saliency";
  dm::datasets::prepare_example_data("mnist-assets", data.parent_path());
  const auto pools = m::LoadSaliency(data);
  std::filesystem::create_directories(root);
  Algebra(root);
  const Tensor       validation_z = Gaussian(200, 16, 4823), test_z = Gaussian(200, 16, 4831);
  nn::ParameterStore g(5003), d(5011), gs(0), ds(0);
  std::vector<nn::ParameterStore*> stores{&g, &d, &gs, &ds};
  const std::vector<std::string>   prefixes{"0/", "1/", "g_state/", "d_state/"};
  {
    nn::NoGradGuard guard;
    m::Dcgan(g, d, gs, ds, nn::zeros({2, 28, 28, 1}), nn::zeros({2, 16}));
  }
  auto snapshot = [&]() {
    Arrays a;
    for (int k = 0; k < 4; ++k)
      for (const auto& key : stores[k]->names())
        a.emplace(prefixes[k] + key, stores[k]->at(key).detach().clone());
    return a;
  };
  auto train_evaluate = [&](const Tensor& x, const Tensor& z) {
    nn::NoGradGuard guard;
    return TrainingFields(
        m::DcganDiscriminatorPhase(g, d, gs, ds, x, z), m::DcganGeneratorPhase(g, d, gs, ds, x, z));
  };
  auto capture = [&](int group, const Tensor& x, const Tensor& z) {
    auto   out    = group ? m::DcganDiscriminatorPhase(g, d, gs, ds, x, z)
                          : m::DcganGeneratorPhase(g, d, gs, ds, x, z);
    auto   values = nn::grad(out.loss, stores[group]->parameters());
    Arrays a;
    auto   names = stores[group]->names();
    for (std::size_t k = 0; k < names.size(); ++k)
      a.emplace(prefixes[group] + names[k], values[k]);
    return a;
  };
  auto evaluate = [&](const Tensor& x, const Tensor& z) {
    nn::NoGradGuard guard;
    auto            out = Fields(m::Dcgan(g, d, gs, ds, x, z));
    out.emplace(
        "pixel_mmd", m::ImqMmd(m::GanCoarsePixels(x), m::GanCoarsePixels(out.at("fake"))).value);
    return out;
  };
  auto commit = [&](nn::ParameterStore& state,
                    const std::string&  name,
                    const Tensor&       mean,
                    const Tensor&       var) {
    auto next = nn::batch_norm_moving_values(
        state.at(name + "/moving_mean"), state.at(name + "/moving_var"), mean, var, .9);
    state.set(name + "/moving_mean", next.mean);
    state.set(name + "/moving_var", next.variance);
  };
  nn::OptimizerConfig config;
  config.kind    = nn::OptimizerKind::Adam;
  config.beta1   = .5;
  config.beta2   = .999;
  config.epsilon = 1e-8;
  nn::Optimizer               go(g, .0002, config), disc(d, .0002, config);
  std::vector<nn::Optimizer*> optimizers{&go, &disc};
  std::ofstream               effects(root / "phase-effects.tsv");
  effects.precision(17);
  effects << "phase\tG\tD\tG_state\tD_state\n";
  auto check_owner = [&](const Arrays&      before,
                         const Arrays&      after,
                         int                owner,
                         const std::string& phase,
                         bool               record) {
    double changes[4]{};
    for (int k = 0; k < 4; ++k)
      for (const auto& [key, value] : before)
        if (key.rfind(prefixes[k], 0) == 0) {
          double change = MaxAbsDiff(value, after.at(key));
          changes[k]    = std::max(changes[k], change);
          if (k != owner)
            Require(Equal(value, after.at(key)), "unselected phase owner unchanged");
        }
    Require(changes[owner] > 0, "selected owner changed");
    if (record)
      effects << phase << '\t' << changes[0] << '\t' << changes[1] << '\t' << changes[2] << '\t'
              << changes[3] << '\n';
  };
  Require(
      g.count() == 6873 && d.count() == 989 && g.size() + d.size() == 15 &&
          gs.size() + ds.size() == 6,
      "G 6873 + D 989 = 7862 parameters, 15 trainable tensors + 6 BN state variables");
  SaveArrays((root / "initial_arrays.npz").string(), snapshot());
  SaveArrays((root / "probe-initial.npz").string(), snapshot());
  nn::BatchOrder order(1000, 32, 4847);
  std::ofstream  history(root / "history.tsv"), batches(root / "batches.tsv");
  history.precision(17);
  history << "epoch\tvalidation_discriminator_loss\tvalidation_generator_loss\tvalidation_coarse_"
             "pixel_mmd\n";
  batches << "epoch\tstep\trow\tsource_id\n";
  const auto source  = nn::cast(pools[0].source, nn::DType::Int64).to_vector<std::int64_t>();
  int        steps   = 0;
  const auto started = std::chrono::steady_clock::now();
  for (int epoch = 1; epoch <= epochs; ++epoch) {
    const Tensor noise = Gaussian(1000, 16, 4861 + epoch);
    order.begin_epoch();
    int seen = 0;
    for (;;) {
      const auto rows = order.next();
      if (rows.empty())
        break;
      const Tensor x = nn::take_rows(pools[0].images, rows), z = nn::take_rows(noise, rows);
      if (!steps) {
        const auto f = train_evaluate(x, z);
        SaveArrays((root / "probe-first.npz").string(), f);
        for (int group : {0, 1})
          SaveArrays(
              (root / ("probe-initial-gradient-" + std::to_string(group) + ".npz")).string(),
              capture(group, x, z));
        std::cout << "first batch (training BN): D loss=" << Value(f, "discriminator_loss")
                  << ", G loss=" << Value(f, "generator_loss") << '\n';
      }
      for (int group : {1, 0}) {
        const auto before = steps ? Arrays{} : snapshot();
        // D uses one joint real/fake BN batch; G is recomputed AFTER the D write.
        const auto phase        = group ? m::DcganDiscriminatorPhase(g, d, gs, ds, x, z)
                                        : m::DcganGeneratorPhase(g, d, gs, ds, x, z);
        const auto before_state = snapshot();
        if (group == 1)
          commit(ds, "down7_bn", phase.down7_mean, phase.down7_variance);
        else {
          commit(gs, "stem_bn", phase.stem_mean, phase.stem_variance);
          commit(gs, "up14_bn", phase.up14_mean, phase.up14_variance);
        }
        const auto after_state = snapshot();
        check_owner(
            before_state,
            after_state,
            group == 1 ? 3 : 2,
            group == 1 ? "D moments" : "G moments",
            !steps);
        const auto gradient = nn::grad(phase.loss, stores[group]->parameters());
        optimizers[group]->step(gradient);
        check_owner(after_state, snapshot(), group, group == 1 ? "D Adam" : "G Adam", !steps);
        if (!steps) {
          SaveArrays(
              (root / (group == 1 ? "probe-after-d.npz" : "probe-after-g.npz")).string(),
              snapshot());
          if (group == 1) {
            SaveArrays((root / "probe-after-d-forward.npz").string(), train_evaluate(x, z));
            SaveArrays((root / "probe-after-d-gradient-0.npz").string(), capture(0, x, z));
          }
        }
        if (!steps) {
          const auto after   = snapshot();
          bool       changed = false;
          for (const auto& [key, value] : before) {
            const bool own = key.rfind(std::to_string(group) + "/", 0) == 0 ||
                             key.rfind(group == 0 ? "g_state/" : "d_state/", 0) == 0;
            if (own)
              changed |= !Equal(value, after.at(key));
            else
              Require(Equal(value, after.at(key)), "GAN step changes ONLY intended G or D group");
          }
          Require(changed, "intended GAN group updates");
        }
      }
      for (auto row : rows)
        batches << epoch << '\t' << steps << '\t' << row << '\t' << source[row] << '\n';
      ++steps;
      seen += int(rows.size());
    }
    Require(seen == 1000, "all fitting MNIST examples ONCE per epoch");
    const auto v = evaluate(pools[1].images, validation_z);
    history << epoch << '\t' << Value(v, "discriminator_loss") << '\t' << Value(v, "generator_loss")
            << '\t' << Value(v, "pixel_mmd") << '\n';
    std::cout << "epoch " << epoch << ": diagnostic D loss=" << Value(v, "discriminator_loss")
              << ", G loss=" << Value(v, "generator_loss")
              << ", coarse MMD=" << Value(v, "pixel_mmd") << std::endl;
  }
  const double seconds =
      std::chrono::duration<double>(std::chrono::steady_clock::now() - started).count();

  // Final probes (training-mode forward and both gradients) must not touch weights or BN states.
  const auto   probe_before = snapshot();
  const auto   probe_rows   = Range(32);
  const Tensor probe_x      = nn::take_rows(pools[2].images, probe_rows),
               probe_z      = nn::take_rows(test_z, probe_rows);
  SaveArrays((root / "probe-final-training.npz").string(), train_evaluate(probe_x, probe_z));
  for (int group : {0, 1})
    SaveArrays(
        (root / ("probe-final-gradient-" + std::to_string(group) + ".npz")).string(),
        capture(group, probe_x, probe_z));
  Require(Equal(probe_before, snapshot()), "final gradient probes DO not update BN states/weights");

  const auto checkpoint = (root / "final.npz").string();
  SaveArrays(checkpoint, snapshot());
  Require(
      steps == 96 && go.iterations() == 96 && disc.iterations() == 96, "192 explicit Adam writes");
  nn::ParameterStore               rg(1), rd(2), rgs(0), rds(0);
  std::vector<nn::ParameterStore*> restored{&rg, &rd, &rgs, &rds};
  {
    nn::NoGradGuard guard;
    m::Dcgan(rg, rd, rgs, rds, nn::zeros({2, 28, 28, 1}), nn::zeros({2, 16}));
  }
  for (const auto& [key, value] : nn::load_npz(checkpoint))
    for (int k = 0; k < 4; ++k)
      if (key.rfind(prefixes[k], 0) == 0)
        restored[k]->set(key.substr(prefixes[k].size()), value);
  auto restored_arrays = [&]() {
    Arrays a;
    for (int k = 0; k < 4; ++k)
      for (const auto& name : restored[k]->names())
        a.emplace(prefixes[k] + name, restored[k]->at(name).detach().clone());
    return a;
  };
  auto restored_evaluate = [&](const Tensor& x, const Tensor& z) {
    nn::NoGradGuard guard;
    auto            a = Fields(m::Dcgan(rg, rd, rgs, rds, x, z));
    a.emplace(
        "pixel_mmd", m::ImqMmd(m::GanCoarsePixels(x), m::GanCoarsePixels(a.at("fake"))).value);
    return a;
  };
  auto generate = [&](const Tensor& z) {
    nn::NoGradGuard guard;
    return nn::reshape((m::DcganGenerate(rg, rgs, z).image + 1.) * .5, {-1, 784});
  };
  Require(Equal(snapshot(), restored_arrays()), "all final G/D weights restore BIT EXACT");
  const auto   before = restored_arrays();
  const auto   output = restored_evaluate(pools[2].images, test_z);
  const Tensor repeat = generate(test_z);
  Require(
      Equal(output.at("fake"), repeat), "noise-only generation BIT EXACT matches GAN evaluation");
  const auto single = generate(nn::take_rows(test_z, {0})).to_vector<float>();
  const auto all    = repeat.to_vector<float>();
  double     parity = 0;
  for (int i = 0; i < 784; ++i)
    parity = std::max(parity, std::abs(double(single[i]) - all[i]));
  Require(parity < 2e-6, "G single/batch parity");
  const Tensor changed_images = generate(Gaussian(200, 16, 4877));
  Require(!Equal(changed_images, repeat), "different noise affects G images");
  const Tensor zero_images = generate(nn::zeros({200, 16}));
  Require(!Equal(zero_images, repeat), "G not constant zero-latent mapping");
  Require(Equal(before, restored_arrays()), "all G/D diagnostic generation immutable");
  SaveArrays(
      (root / "probe-noise-controls.npz").string(),
      {{"changed", changed_images}, {"zero", zero_images}});

  const Tensor fit_mean = FitMean(pools[0].images, 200);
  const double mean_mmd =
      m::ImqMmd(
          m::GanCoarsePixels(nn::reshape(pools[2].images, {-1, 784})), m::GanCoarsePixels(fit_mean))
          .value.item();
  double     real_accuracy = 0, fake_accuracy = 0;
  const auto real_logit = output.at("real_logit").to_vector<float>(),
             fake_logit = output.at("fake_logit").to_vector<float>();
  for (int b = 0; b < 200; ++b)
    real_accuracy += real_logit[b] >= 0, fake_accuracy += fake_logit[b] < 0;
  const double mean_pixel     = nn::mean(repeat).item();
  const double pixel_variance = nn::mean(nn::square(repeat - nn::mean(repeat, {0}, true))).item();
  SaveSheet(root / "generated.png", nn::slice_axis(repeat, 0, 0, 40), 8);
  SaveSheet(root / "fit_mean.png", nn::slice_axis(fit_mean, 0, 0, 8), 8);
  SaveArrays((root / "outputs.npz").string(), output);
  std::ofstream meta(root / "metrics.json");
  meta.precision(17);
  meta << "{\"generator_parameters\":6873,\"discriminator_parameters\":989,\"epochs\":" << epochs
       << ",\"steps_per_group\":" << steps << ",\"optimizer_updates\":" << 2 * steps
       << ",\"test_discriminator_loss\":" << Value(output, "discriminator_loss")
       << ",\"test_generator_loss\":" << Value(output, "generator_loss")
       << ",\"test_coarse_pixel_mmd\":" << Value(output, "pixel_mmd")
       << ",\"fit_mean_coarse_pixel_mmd\":" << mean_mmd
       << ",\"test_discriminator_real_accuracy\":" << real_accuracy / 200
       << ",\"test_discriminator_fake_accuracy\":" << fake_accuracy / 200
       << ",\"generated_mean_pixel\":" << mean_pixel
       << ",\"generated_mean_per_pixel_variance\":" << pixel_variance
       << ",\"single_batch_max_error\":" << parity << ",\"training_seconds\":" << seconds << "}\n";
  Require(bool(meta) && bool(history) && bool(batches) && bool(effects), "complete GAN artifacts");
  history.close();
  batches.close();
  effects.close();
  meta.close();
  std::cout << "fixed FINAL epoch " << epochs
            << ", test D/G=" << Value(output, "discriminator_loss") << "/"
            << Value(output, "generator_loss") << ", coarse MMD=" << Value(output, "pixel_mmd")
            << ", mean baseline=" << mean_mmd << ", D real/fake accuracy=" << real_accuracy / 200
            << "/" << fake_accuracy / 200 << ", mean pixel=" << mean_pixel
            << ", pixel variance=" << pixel_variance
            << "; D then G/restore/noiseOnly/immutable PASS (training " << seconds
            << " s)\nArtifacts: " << root.string() << "\nAll dcgan checks passed.\n";
  std::ifstream plot_file(root / "history.tsv");
  std::string   plot_header;
  std::getline(plot_file, plot_header);
  std::vector<double> plot_epoch, plot_d, plot_g;
  double              pe, pd, pg, pm;
  while (plot_file >> pe >> pd >> pg >> pm) {
    plot_epoch.push_back(pe);
    plot_d.push_back(pd);
    plot_g.push_back(pg);
  }
  auto plot = dm::graphics::RPlot::create();
  plot.y_limits(0, 2.2)
      .lines(plot_epoch, plot_d, "D logistic loss", {37, 99, 235}, 2)
      .points(plot_epoch, plot_d, "", {37, 99, 235}, 4)
      .lines(plot_epoch, plot_g, "G non-saturating loss", {220, 38, 38}, 2)
      .points(plot_epoch, plot_g, "", {220, 38, 38}, 4)
      .x_label("Completed epoch; fixed final3")
      .y_label("Saved-BN validation game objective")
      .title("Validation records diagnostics, not checkpoint selection")
      .save_svg("build/dcgan_learning.svg");
}
```
