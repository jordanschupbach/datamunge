> Compare unconditional patch-score distributions without pairing observations

Each held-out domain has100 real rows. The translated A rows come from B sources,
and translated B rows from A sources. The CDFs below therefore compare separate
distributions of per-image mean raw patch score; they do not connect corresponding
row numbers. All49 scores enter each image mean, and all100 means enter each
curve. Scores remain raw, with least-squares targets1 for real and0 for fake.
They are not probabilities or independent patch observations.

```{cpp, results="markdown", file="figures/cycle_score_cdfs.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
namespace n = dm::nn;
namespace m = n::models;
using A     = std::map<std::string, n::Tensor>;
A Read(const std::string& path) {
  A a;
  for (const auto& [key, value] : n::load_npz(path))
    a.emplace(key, value);
  return a;
}
std::vector<std::int64_t> BalancedRows(const n::Tensor& ids, const m::SaliencyData& pool) {
  std::map<std::int64_t, std::int64_t> label;
  auto                                 source = pool.source.to_vector<std::int64_t>(),
       labels = pool.labels.to_vector<std::int64_t>(), selected = ids.to_vector<std::int64_t>();
  for (std::size_t i = 0; i < source.size(); ++i)
    label.emplace(source[i], labels[i]);
  std::vector<std::int64_t> rows;
  for (int c = 0; c < 10; ++c) {
    bool found = false;
    for (std::size_t i = 0; i < selected.size(); ++i)
      if (label.at(selected[i]) == c) {
        rows.push_back(i);
        found = true;
        break;
      }
    if (!found)
      throw std::runtime_error("all ten diagnostic classes");
  }
  return rows;
}
int main() {
  auto out = Read("build/cycle_gan/outputs.npz");
  auto p   = dm::graphics::RPlot::create();
  p.y_limits(0, 1.8);
  for (auto [key, label, color] :
       std::vector<std::tuple<std::string, std::string, dm::graphics::RGB>>{
           {"real_a_score", "D_a real", {37, 99, 235}},
           {"fake_a_score", "D_a translated", {220, 38, 38}},
           {"real_b_score", "D_b real", {16, 145, 74}},
           {"fake_b_score", "D_b translated", {147, 51, 234}}}) {
    auto means = n::mean(n::cast(out.at(key), n::DType::Float64), {1, 2, 3}).to_vector<double>();
    std::sort(means.begin(), means.end());
    std::vector<double> probability;
    for (std::size_t i = 0; i < means.size(); ++i)
      probability.push_back(double(i + 1) / means.size());
    p.lines(means, probability, label, color, 2);
  }
  p.x_label("Per-image mean raw patch score; independent source rows")
      .y_label("Empirical cumulative fraction of100 image means")
      .title("Unpaired real and translated score distributions stay separate")
      .save_svg("build/cycle_score_cdfs.svg");
}
```
