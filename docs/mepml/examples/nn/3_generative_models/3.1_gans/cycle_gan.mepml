> Show both directions across all ten classes without changing the model

The next fixed-final gallery chooses the first source of every label in each
domain. Each row has four A->B columns(source,prediction,cycle,known target), then
four B->A columns in the same order. The source identities in the two directions
remain different. Labels choose these display rows only; no refitting or score
selection follows the preview. All80 panels are saved as tensors as well.

```{cpp, results="markdown", file="figures/cycle_balanced.png", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
namespace n = dm::nn;
namespace m = n::models;
using A     = std::map<std::string, n::Tensor>;
A Read(const std::string& path) {
  A a;
  for (const auto& [key, value] : n::load_npz(path))
    a.emplace(key, value);
  return a;
}
std::vector<std::int64_t> BalancedRows(const n::Tensor& ids, const m::SaliencyData& pool) {
  std::map<std::int64_t, std::int64_t> label;
  auto                                 source = pool.source.to_vector<std::int64_t>(),
       labels = pool.labels.to_vector<std::int64_t>(), selected = ids.to_vector<std::int64_t>();
  for (std::size_t i = 0; i < source.size(); ++i)
    label.emplace(source[i], labels[i]);
  std::vector<std::int64_t> rows;
  for (int c = 0; c < 10; ++c) {
    bool found = false;
    for (std::size_t i = 0; i < selected.size(); ++i)
      if (label.at(selected[i]) == c) {
        rows.push_back(i);
        found = true;
        break;
      }
    if (!found)
      throw std::runtime_error("all ten diagnostic classes");
  }
  return rows;
}
int main() {
  auto data = Read("build/cycle_gan/data.npz"), out = Read("build/cycle_gan/outputs.npz"),
       target = Read("build/cycle_gan/diagnostic_known_mapping.npz");
  auto pools  = m::LoadSaliency(std::filesystem::path(dm::datasets::data_home()) / "saliency");
  auto ar     = BalancedRows(data.at("test_ids_a"), pools[2]),
       br     = BalancedRows(data.at("test_ids_b"), pools[2]);
  std::vector<n::Tensor> panels;
  for (int c = 0; c < 10; ++c) {
    for (auto name : {"test_a"})
      panels.push_back(n::take_rows(data.at(name), {ar[c]}));
    for (auto name : {"fake_b", "cycle_a"})
      panels.push_back(n::take_rows(out.at(name), {ar[c]}));
    panels.push_back(n::take_rows(target.at("a_to_b_target"), {ar[c]}));
    panels.push_back(n::take_rows(data.at("test_b"), {br[c]}));
    for (auto name : {"fake_a", "cycle_b"})
      panels.push_back(n::take_rows(out.at(name), {br[c]}));
    panels.push_back(n::take_rows(target.at("b_to_a_target"), {br[c]}));
  }
  auto gallery = n::concat(panels, 0);
  n::save_npz("build/cycle_gan/probe-balanced-gallery.npz", {{"images", gallery}});
  n::save_image_grid(gallery, "build/cycle_balanced.png", 8, 0, 1, 4, 220 / 255., 3);
}
```
