> Inspect all1390 coordinates of the changed second-generator gradient

On the first real training batch, the source wrong control changes the G_ba
partial vector by at most.00081092119216918945 after G_ab's write. The next plot
uses all1390 G_ba coordinates, ordered by sorted source tensor key and then
row-major coordinate. It compares the saved common-snapshot vector with the
saved recomputed control. This is a gradient difference, not a parameter change
or a claim that the alternative schedule would converge to the same result.

```{cpp, results="markdown", file="figures/cycle_wrong_gradient.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
namespace n = dm::nn;
namespace m = n::models;
using A     = std::map<std::string, n::Tensor>;
A Read(const std::string& path) {
  A a;
  for (const auto& [key, value] : n::load_npz(path))
    a.emplace(key, value);
  return a;
}
std::vector<std::int64_t> BalancedRows(const n::Tensor& ids, const m::SaliencyData& pool) {
  std::map<std::int64_t, std::int64_t> label;
  auto                                 source = pool.source.to_vector<std::int64_t>(),
       labels = pool.labels.to_vector<std::int64_t>(), selected = ids.to_vector<std::int64_t>();
  for (std::size_t i = 0; i < source.size(); ++i)
    label.emplace(source[i], labels[i]);
  std::vector<std::int64_t> rows;
  for (int c = 0; c < 10; ++c) {
    bool found = false;
    for (std::size_t i = 0; i < selected.size(); ++i)
      if (label.at(selected[i]) == c) {
        rows.push_back(i);
        found = true;
        break;
      }
    if (!found)
      throw std::runtime_error("all ten diagnostic classes");
  }
  return rows;
}
int main() {
  auto joint = Read("build/cycle_gan/phases/batch0-g-gradient.npz"),
       wrong = Read("build/cycle_gan/probe-wrong-sequential-gradient.npz");
  std::vector<n::Tensor> difference;
  for (auto& [key, value] : wrong)
    difference.push_back(
        n::reshape(
            n::abs(n::cast(value, n::DType::Float64) - n::cast(joint.at(key), n::DType::Float64)),
            {-1}));
  auto delta = n::concat(difference, 0);
  if (delta.numel() != 1390 || std::abs(n::max(delta).item() - .00081092119216918945) > 1e-15)
    throw std::runtime_error("source wrong-sequential vector");
  auto x = n::arange(0, 1390, 1, n::DType::Float64);
  auto p = dm::graphics::RPlot::create();
  p.y_limits(-.00003, .0015)
      .lines(
          x.to_vector<double>(), delta.to_vector<double>(), "After G_ab write", {37, 99, 235}, 1.3)
      .x_label("G_ba partial coordinate; sorted tensor keys then row-major values")
      .y_label("Absolute change from the captured common-snapshot partial")
      .title("Recomputing after the first G write changes the second vector")
      .save_svg("build/cycle_wrong_gradient.svg");
}
```
