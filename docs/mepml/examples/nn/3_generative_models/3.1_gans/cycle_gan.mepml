> Compare the known-map diagnostic with fitting-only target-domain means

The original fixed-final diagnostic mapping MSEs are.229144769 for A->B and
.210121211 for B->A. The known rotation/inversion supplies those targets only
after fitting. An additional reference predicts the fitting B mean for every
A source, or fitting A mean for every B source. Means use all500 fitting rows
of their own target domain and Double arithmetic, with no held-out fitting.
They do not use a source/target correspondence either. The figure records both
model errors and both mean-reference errors without changing the checkpoint.

```{cpp, results="markdown", file="figures/cycle_mapping_errors.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
namespace n = dm::nn;
namespace m = n::models;
using A     = std::map<std::string, n::Tensor>;
A Read(const std::string& path) {
  A a;
  for (const auto& [key, value] : n::load_npz(path))
    a.emplace(key, value);
  return a;
}
std::vector<std::int64_t> BalancedRows(const n::Tensor& ids, const m::SaliencyData& pool) {
  std::map<std::int64_t, std::int64_t> label;
  auto                                 source = pool.source.to_vector<std::int64_t>(),
       labels = pool.labels.to_vector<std::int64_t>(), selected = ids.to_vector<std::int64_t>();
  for (std::size_t i = 0; i < source.size(); ++i)
    label.emplace(source[i], labels[i]);
  std::vector<std::int64_t> rows;
  for (int c = 0; c < 10; ++c) {
    bool found = false;
    for (std::size_t i = 0; i < selected.size(); ++i)
      if (label.at(selected[i]) == c) {
        rows.push_back(i);
        found = true;
        break;
      }
    if (!found)
      throw std::runtime_error("all ten diagnostic classes");
  }
  return rows;
}
int main() {
  auto data = Read("build/cycle_gan/data.npz"), out = Read("build/cycle_gan/outputs.npz"),
       target = Read("build/cycle_gan/diagnostic_known_mapping.npz");
  auto mean_a = n::tile(
           n::mean(n::cast(data.at("fit_a"), n::DType::Float64), {0}, true), {100, 1, 1, 1}),
       mean_b = n::tile(
           n::mean(n::cast(data.at("fit_b"), n::DType::Float64), {0}, true), {100, 1, 1, 1});
  auto mse = [](const n::Tensor& x, const n::Tensor& y) {
    return n::mean(n::square(n::cast(x, n::DType::Float64) - n::cast(y, n::DType::Float64))).item();
  };
  std::vector<double> error{
      mse(out.at("fake_b"), target.at("a_to_b_target")),
      mse(mean_b, target.at("a_to_b_target")),
      mse(out.at("fake_a"), target.at("b_to_a_target")),
      mse(mean_a, target.at("b_to_a_target"))};
  n::save_npz(
      "build/cycle_gan/probe-fitting-mean-baselines.npz",
      {{"mean_a", mean_a}, {"mean_b", mean_b}, {"mse", n::from_vector(error, {4})}});
  std::print(
      "Known-map MSE: G_ab={}, fitting mean_B={}, G_ba={}, fitting mean_A={}.\n",
      error[0],
      error[1],
      error[2],
      error[3]);
  auto p = dm::graphics::RPlot::create();
  p.y_limits(0, .4)
      .points({1, 3}, {error[0], error[2]}, "Fixed-final G", {37, 99, 235}, 5)
      .points({2, 4}, {error[1], error[3]}, "Fitting-only mean", {220, 38, 38}, 5)
      .x_label("1 G_ab;2 mean_B;3 G_ba;4 mean_A")
      .y_label("Mean squared error to known diagnostic target, unit pixels")
      .title("Known-map error is a separate diagnostic, not a fitting objective")
      .save_svg("build/cycle_mapping_errors.svg");
}
```
