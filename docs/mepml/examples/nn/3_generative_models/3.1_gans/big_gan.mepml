> Complete experiment: advance, select gradients, write, then commit captures

G has 789 values in 17 leaves; D 241 in 9. G spectral vectors hold 241 values/18 tensors,
D spectral vectors 77/10, and moving BN statistics 24/6. The complete checkpoint has
1372 values in 60 tensors, with 1030 values optimized. Every /W kernel starts normal(.02).
G's shared class embedding starts normal(.1) and is neither spectral-normalized nor
orthogonally penalized. Cached columns start 1.f/sqrt(float(length)); all three BN saved
means start 0 and variances 1. Source epsilon/floor constants preserve Float32 rounding.

G/D seeds 6803/6823 and sixteen warm-up iterations per spectral store precede the
initial snapshot. BatchOrder 6863 visits all 1000 fitting rows once per epoch in batches
up to 32. Epoch prior seeds 6872/6873/6874, validation 6841, test 6857 and truncation 6907
preserve the source streams. Adam uses.0002, beta 1=0, beta 2=.999, epsilon 1e-8, independently
for G and D. Each batch advances D's spectral cache, writes D, advances G's spectral cache,
recomputes a fresh forward through updated D, captures its G moments, writes G, then
commits those same captures with Float32-rounded.9 retention. It does not recompute
moments at updated G weights. Ownership checks run after every phase, including BN.

Both inference and batch-statistics G paths are explicit. `fake` and `fake_score` select
only display endpoints: both losses ALWAYS use batch-statistics fake pixels. Validation
logs the four source objectives without selecting weights. Epoch 3 is fixed before fitting;
initial/final test outputs are diagnostic controls, with no test result selecting epochs,
weights, seeds or settings. The program retains all original data, proposal, gradient,
checkpoint and control archives. It additionally saves the first full captured G gradient
for the component check later. Every fitting statement remains editable below.

```{cpp, results="markdown", file="figures/big_gan_learning.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <chrono>
#include <cmath>
#include <dm/dm.hpp>
#include <fstream>
#include <iostream>

namespace nn = dm::nn;
namespace m  = nn::models;
using Arrays = std::map<std::string, nn::Tensor>;
using nn::Tensor;

namespace {
void Require(bool condition, const std::string& message) {
  if (!condition)
    throw std::runtime_error(message);
}
void Near(double actual, double expected, double tolerance, const std::string& message) {
  Require(std::abs(actual - expected) <= tolerance, message);
}
void SaveArrays(const std::string& path, const Arrays& a) {
  nn::save_npz(path, nn::NamedTensors(a.begin(), a.end()));
}
bool Equal(const Tensor& a, const Tensor& b) {
  return nn::equal_bits(a, b);
}
bool Equal(const Arrays& a, const Arrays& b) {
  if (a.size() != b.size())
    return false;
  for (const auto& [key, value] : a)
    if (!b.count(key) || !Equal(value, b.at(key)))
      return false;
  return true;
}
Tensor Gaussian(std::int64_t rows, std::int64_t width, std::uint64_t seed) {
  return nn::cast(
      m::GaussianNoise({rows, width}, 1, seed).reshape({rows, width}), nn::DType::Float32);
}
double MaxAbsDiff(const Tensor& a, const Tensor& b) {
  return nn::max(nn::abs(nn::cast(a, nn::DType::Float64) - nn::cast(b, nn::DType::Float64))).item();
}
void Owners(const Arrays& before, const Arrays& after, const std::vector<std::string>& owners) {
  for (const auto& [key, value] : before) {
    bool selected = false;
    for (const auto& prefix : owners)
      selected |= key.rfind(prefix, 0) == 0;
    if (!selected)
      Require(Equal(value, after.at(key)), "unselected owner unchanged");
  }
}
void AppendMoments(Arrays& a, const m::BigGanMoments& c) {
  for (auto& [key, value] : Arrays{
           {"moment/bn1/mean", c.bn1_mean},
           {"moment/bn1/unbiased_var", c.bn1_unbiased_variance},
           {"moment/bn2/mean", c.bn2_mean},
           {"moment/bn2/unbiased_var", c.bn2_unbiased_variance},
           {"moment/output_bn/mean", c.output_mean},
           {"moment/output_bn/unbiased_var", c.output_unbiased_variance}})
    a.emplace(key, value.detach());
}
Arrays Fields(const m::BigGanOutput& o, bool moments) {
  Arrays a{
      {"fake", o.fake},
      {"fake_training", o.fake_training},
      {"fake_inference", o.fake_inference},
      {"fake_score_training", o.fake_score_training},
      {"fake_score_inference", o.fake_score_inference},
      {"real_score", o.real_score},
      {"fake_score", o.fake_score},
      {"d_loss", o.d_loss},
      {"g_source", o.g_source},
      {"g_orthogonal", o.g_orthogonal},
      {"g_loss", o.g_loss}};
  if (moments)
    AppendMoments(a, o.moments);
  return a;
}
double Value(const Arrays& a, const std::string& key) {
  return a.at(key).item();
}

/// 8x8 digits at 8x with 4-pixel gray-220 gaps.
void Mosaic(const std::filesystem::path& path, const Tensor& images, std::int64_t columns) {
  nn::save_image_grid(
      nn::reshape(images, {-1, 8, 8, 1}), path.string(), columns, 0, 1, 4, 220 / 255., 8);
}

} // namespace
int main() {
  const std::filesystem::path root   = "build/big_gan";
  const int                   epochs = 3;
  const auto                  data = std::filesystem::path(dm::datasets::data_home()) / "saliency";
  dm::datasets::prepare_example_data("mnist-assets", data.parent_path());
  const auto pools = m::LoadSaliency(data);
  std::filesystem::create_directories(root);
  std::vector<Tensor> resized;
  Arrays              records;
  for (int k = 0; k < 3; ++k) {
    resized.push_back(m::BigGanResize8(pools[k].images));
    records.emplace(
        std::string(
            k == 0   ? "fit"
            : k == 1 ? "validation"
                     : "test") +
            "_images",
        resized.back());
  }
  SaveArrays((root / "data.npz").string(), records);
  const auto validation = m::GaussianRejectionPrior(200, 12, 6841),
             test       = m::GaussianRejectionPrior(200, 12, 6857);
  SaveArrays(
      (root / "validation_prior.npz").string(),
      {{"z", validation.z}, {"proposals", validation.proposals}});
  SaveArrays((root / "test_prior.npz").string(), {{"z", test.z}, {"proposals", test.proposals}});
  nn::ParameterStore               g(6803), d(6823), gs(0), ds(0), moving(0);
  std::vector<nn::ParameterStore*> stores{&g, &d, &gs, &ds, &moving};
  {
    nn::NoGradGuard guard;
    m::BigGan(
        g,
        d,
        gs,
        ds,
        moving,
        nn::zeros({2, 8, 8, 1}),
        nn::zeros({2, 12}),
        nn::zeros({2}, nn::DType::Int32));
  }
  nn::advance_cached_spectral_state(g, gs, 16);
  nn::advance_cached_spectral_state(d, ds, 16);
  auto snapshot = [&]() {
    Arrays a;
    for (int k = 0; k < 5; ++k)
      for (const auto& name : stores[k]->names())
        a.emplace(std::to_string(k) + "/" + name, stores[k]->at(name).detach().clone());
    return a;
  };
  auto forward = [&](const Tensor& x, const Tensor& z, const Tensor& labels, bool batch) {
    return m::BigGan(g, d, gs, ds, moving, x, z, labels, batch);
  };
  auto evaluate = [&](const Tensor& x, const Tensor& z, const Tensor& labels, bool batch = false) {
    nn::NoGradGuard guard;
    return Fields(forward(x, z, labels, batch), batch);
  };
  auto capture = [&](int group, const Tensor& x, const Tensor& z, const Tensor& labels) {
    auto       out    = forward(x, z, labels, true);
    auto       values = nn::grad(group ? out.d_loss : out.g_loss, stores[group]->parameters());
    Arrays     a;
    const auto names = stores[group]->names();
    for (std::size_t k = 0; k < names.size(); ++k)
      a.emplace(std::to_string(group) + "/" + names[k], values[k]);
    if (group == 0)
      AppendMoments(a, out.moments);
    return a;
  };
  auto component = [&](bool orthogonal, const Tensor& x, const Tensor& z, const Tensor& labels) {
    auto       out    = forward(x, z, labels, true);
    auto       values = nn::grad(orthogonal ? out.g_orthogonal : out.g_source, g.parameters());
    Arrays     a;
    const auto names = g.names();
    for (std::size_t k = 0; k < names.size(); ++k)
      a.emplace("0/" + names[k], values[k]);
    return a;
  };
  nn::OptimizerConfig config;
  config.kind    = nn::OptimizerKind::Adam;
  config.beta1   = 0;
  config.beta2   = .999;
  config.epsilon = 1e-8;
  nn::Optimizer               go(g, .0002, config), disc(d, .0002, config);
  std::vector<nn::Optimizer*> optimizers{&go, &disc};
  std::size_t                 tensors = 0;
  for (int k = 0; k < 5; ++k)
    tensors += stores[k]->size();
  Require(
      g.count() == 789 && d.count() == 241 && gs.count() == 241 && ds.count() == 77 &&
          moving.count() == 24 && tensors == 60,
      "1030 trainable + 342 state values, 60 tensors");
  SaveArrays((root / "initial_arrays.npz").string(), snapshot());
  SaveArrays(
      (root / "initial_outputs.npz").string(), evaluate(resized[2], test.z, pools[2].labels));
  nn::BatchOrder order(1000, 32, 6863);
  int            steps = 0;
  Tensor         first_x, first_z, first_labels;
  std::ofstream  history(root / "history.tsv"), batches(root / "batches.tsv");
  history.precision(17);
  history << "epoch\td_loss\tg_source\tg_orthogonal\tg_loss\n";
  batches << "epoch\tstep\trow\tsource_id\n";
  const auto source  = nn::cast(pools[0].source, nn::DType::Int64).to_vector<std::int64_t>();
  const auto started = std::chrono::steady_clock::now();
  for (int epoch = 1; epoch <= epochs; ++epoch) {
    const auto noise = m::GaussianRejectionPrior(1000, 12, 6871 + epoch);
    order.begin_epoch();
    for (;;) {
      const auto rows = order.next();
      if (rows.empty())
        break;
      const Tensor x = nn::take_rows(resized[0], rows), z = nn::take_rows(noise.z, rows),
                   condition = nn::take_rows(pools[0].labels, rows);
      if (!steps) {
        first_x = x, first_z = z, first_labels = condition;
        SaveArrays((root / "first_forward.npz").string(), evaluate(x, z, condition, true));
        const auto adv   = component(false, x, z, condition),
                   ortho = component(true, x, z, condition);
        const auto full  = capture(0, x, z, condition);
        for (const auto& [key, value] : adv) {
          const auto a = value.to_vector<float>(), o = ortho.at(key).to_vector<float>(),
                     f = full.at(key).to_vector<float>();
          for (std::size_t i = 0; i < a.size(); ++i)
            Near(
                double(a[i]) + o[i],
                f[i],
                3e-5,
                "G partials = adversarial PLUS modified orthogonal");
        }
        SaveArrays((root / "first_adversarial_gradients.npz").string(), adv);
        SaveArrays((root / "first_orthogonal_gradients.npz").string(), ortho);
        SaveArrays((root / "first_full_gradients.npz").string(), full);
      }
      for (int group : {1, 0}) {
        const auto before = snapshot();
        nn::advance_cached_spectral_state(*stores[group], *stores[group + 2]);
        const auto after_sn = snapshot();
        Owners(before, after_sn, {std::to_string(group + 2) + "/"});
        // Recompute after its own SN advance and the prior selected D write.
        const auto out              = forward(x, z, condition, true);
        const auto captured_moments = out.moments; // values from THIS forward, before Adam.
        const auto gradient =
            nn::grad(group ? out.d_loss : out.g_loss, stores[group]->parameters());
        optimizers[group]->step(gradient);
        if (group == 0)
          m::BigGanCommitMoments(moving, captured_moments); // no recomputation at new weights.
        std::vector<std::string> owners{std::to_string(group) + "/"};
        if (group == 0)
          owners.push_back("4/");
        Owners(after_sn, snapshot(), owners);
      }
      for (auto row : rows)
        batches << epoch << '\t' << steps << '\t' << row << '\t' << source[row] << '\n';
      ++steps;
    }
    const auto v = evaluate(resized[1], validation.z, pools[1].labels);
    history << epoch;
    for (auto key : {"d_loss", "g_source", "g_orthogonal", "g_loss"})
      history << '\t' << Value(v, key);
    history << '\n';
    std::cout << "epoch " << epoch << ": D/G=" << Value(v, "d_loss") << '/' << Value(v, "g_loss")
              << ", orthogonal=" << Value(v, "g_orthogonal") << std::endl;
  }
  const double seconds =
      std::chrono::duration<double>(std::chrono::steady_clock::now() - started).count();

  const auto checkpoint = (root / "final.npz").string();
  SaveArrays(checkpoint, snapshot());
  for (int group = 0; group < 2; ++group)
    SaveArrays(
        (root / ("final_gradients_group" + std::to_string(group) + ".npz")).string(),
        capture(group, first_x, first_z, first_labels));
  Require(
      steps == 96 && go.iterations() == 96 && disc.iterations() == 96, "192 explicit Adam writes");
  nn::ParameterStore               rg(1), rd(2), rgs(0), rds(0), rstats(0);
  std::vector<nn::ParameterStore*> restored{&rg, &rd, &rgs, &rds, &rstats};
  {
    nn::NoGradGuard guard;
    m::BigGan(
        rg,
        rd,
        rgs,
        rds,
        rstats,
        nn::zeros({2, 8, 8, 1}),
        nn::zeros({2, 12}),
        nn::zeros({2}, nn::DType::Int32));
  }
  for (const auto& [key, value] : nn::load_npz(checkpoint))
    restored[key[0] - '0']->set(key.substr(2), value);
  auto restored_arrays = [&]() {
    Arrays a;
    for (int k = 0; k < 5; ++k)
      for (const auto& name : restored[k]->names())
        a.emplace(std::to_string(k) + "/" + name, restored[k]->at(name).detach().clone());
    return a;
  };
  auto restored_evaluate = [&](const Tensor& x, const Tensor& z, const Tensor& labels) {
    nn::NoGradGuard guard;
    return Fields(m::BigGan(rg, rd, rgs, rds, rstats, x, z, labels), false);
  };
  auto generate = [&](const Tensor& z, const Tensor& labels) {
    nn::NoGradGuard guard;
    return m::BigGanGenerate(rg, rgs, rstats, z, labels, false).image;
  };
  auto score = [&](const Tensor& x, const Tensor& labels) {
    nn::NoGradGuard guard;
    return m::BigGanDiscriminate(rd, rds, x, labels).score;
  };
  Require(
      Equal(snapshot(), restored_arrays()), "ALL trainable/SN/conditional BN vars restore exact");
  const auto   before    = restored_arrays();
  const auto   output    = restored_evaluate(resized[2], test.z, pools[2].labels);
  const Tensor generated = generate(test.z, pools[2].labels);
  Require(
      Equal(generated, output.at("fake_inference")),
      "class + hierarchical z ONLY generation with FROZEN stats");
  const double parity = MaxAbsDiff(
      generate(nn::take_rows(test.z, {0}), nn::take_rows(pools[2].labels, {0})),
      nn::take_rows(generated, {0}));
  Require(parity < 3e-6, "inference BN single batch parity");
  std::vector<std::int64_t> grid_rows;
  std::vector<std::int32_t> grid_classes;
  for (int c = 0; c < 10; ++c)
    for (int b = 0; b < 8; ++b)
      grid_rows.push_back(b), grid_classes.push_back(c);
  const Tensor grid_z       = nn::take_rows(test.z, grid_rows),
               grid_labels  = nn::from_vector(grid_classes, {80});
  const Tensor grid         = generate(grid_z, grid_labels);
  const double class_effect = MaxAbsDiff(
      nn::slice_axis(grid, 0, 8, 80), nn::tile(nn::slice_axis(grid, 0, 0, 8), {9, 1, 1, 1}));
  auto changed_classes = pools[2].labels.contiguous().to_vector<std::int32_t>();
  for (auto& c : changed_classes)
    c = (c + 1) % 10;
  const Tensor original_scores = score(resized[2], pools[2].labels);
  const Tensor changed_scores  = score(resized[2], nn::from_vector(changed_classes, {200}));
  Require(Equal(original_scores, output.at("real_score")), "projection D image + class ONLY");
  const double projection_effect = MaxAbsDiff(original_scores, changed_scores);
  Require(
      class_effect > 1e-5 && projection_effect > 1e-5,
      "G class conditioning AND D projection class paths active");
  SaveArrays(
      (root / "class_controls.npz").string(),
      {{"z", grid_z},
       {"labels", grid_labels},
       {"fake", grid},
       {"changed_real_scores", changed_scores}});
  Mosaic(root / "class_grid.png", grid, 8);
  Arrays hierarchy;
  for (int chunk = 0; chunk < 3; ++chunk) {
    auto values = test.z.contiguous().to_vector<float>();
    for (int b = 0; b < 200; ++b)
      for (int j = 0; j < 4; ++j)
        values[b * 12 + chunk * 4 + j] = 0;
    const Tensor z    = nn::from_vector(values, {200, 12});
    const Tensor fake = generate(z, pools[2].labels);
    Require(MaxAbsDiff(fake, generated) > 1e-5, "ALL THREE hierarchical latent chunks affect G");
    hierarchy.emplace("zero_chunk" + std::to_string(chunk) + "_z", z);
    hierarchy.emplace("zero_chunk" + std::to_string(chunk) + "_fake", fake);
  }
  SaveArrays((root / "hierarchical_controls.npz").string(), hierarchy);
  std::vector<std::int32_t> trunc_classes(200);
  for (int i = 0; i < 200; ++i)
    trunc_classes[i] = i % 10;
  const Tensor        trunc_labels = nn::from_vector(trunc_classes, {200});
  std::vector<Tensor> trunc_tiles(32);
  for (int k = 0; k < 4; ++k) {
    const double limit = k == 0   ? std::numeric_limits<double>::infinity()
                         : k == 1 ? 2
                         : k == 2 ? 1
                                  : .5;
    const auto   prior = m::GaussianRejectionPrior(200, 12, 6907, limit);
    SaveArrays(
        (root / ("truncated_prior" + std::to_string(k) + ".npz")).string(),
        {{"z", prior.z}, {"proposals", prior.proposals}});
    const Tensor fake = generate(prior.z, trunc_labels);
    SaveArrays(
        (root / ("truncated_output" + std::to_string(k) + ".npz")).string(),
        {{"fake", fake}, {"labels", trunc_labels}});
    for (std::int64_t b = 0; b < 8; ++b)
      trunc_tiles[b * 4 + k] = nn::take_rows(fake, {b});
  }
  const Tensor trunc_gallery = nn::concat(trunc_tiles, 0);
  SaveArrays((root / "truncation_gallery.npz").string(), {{"images", trunc_gallery}});
  Mosaic(root / "truncation.png", trunc_gallery, 4);
  int  invalid = 0;
  auto bad     = grid_classes;
  for (int c : {-1, 10}) {
    bad[0] = c;
    try {
      generate(grid_z, nn::from_vector(bad, {80}));
    } catch (const std::exception&) {
      ++invalid;
    }
  }
  try {
    generate(test.z, nn::take_rows(pools[2].labels, {0}));
  } catch (const std::exception&) {
    ++invalid;
  }
  Require(invalid == 3, "invalid class conditions rejected before OneHot");
  Require(
      Equal(before, restored_arrays()),
      "all truncation/conditional inference keeps SN/BN weights immutable");
  SaveArrays((root / "outputs.npz").string(), output);
  Mosaic(root / "generated.png", nn::slice_axis(generated, 0, 0, 40), 8);
  std::ofstream meta(root / "metrics.json");
  meta.precision(17);
  meta << "{\"trainable_parameters\":1030,\"nontrainable_state_values\":342,\"epochs\":" << epochs
       << ",\"steps_per_group\":" << steps << ",\"optimizer_updates\":" << 2 * steps
       << ",\"selected_epoch_fixed_final\":" << epochs
       << ",\"generator_class_pixel_max_effect\":" << class_effect
       << ",\"discriminator_projection_score_max_effect\":" << projection_effect
       << ",\"single_batch_max_error\":" << parity << ",\"invalid_class_rejected\":" << invalid;
  for (auto key : {"d_loss", "g_source", "g_orthogonal", "g_loss"})
    meta << ",\"test_" << key << "\":" << Value(output, key);
  meta << ",\"training_seconds\":" << seconds << "}\n";
  Require(bool(meta) && bool(history) && bool(batches), "complete BigGAN records");
  history.close();
  batches.close();
  meta.close();
  std::cout << "fixed final=" << epochs << ", test D/G=" << Value(output, "d_loss") << "/"
            << Value(output, "g_loss") << ", class/projection effects=" << class_effect << '/'
            << projection_effect
            << "; hierarchical/CCBN/residual/SN/projection/orthogonal/rejection/restore/immutable "
               "PASS (training "
            << seconds << " s)\nArtifacts: " << root.string() << "\nAll big_gan checks passed.\n";
  std::ifstream input(root / "history.tsv");
  std::string   header;
  std::getline(input, header);
  std::vector<double> axis, dl, gl;
  double              plot_epoch, plot_d, plot_source, plot_orthogonal, plot_total;
  while (input >> plot_epoch >> plot_d >> plot_source >> plot_orthogonal >> plot_total) {
    axis.push_back(plot_epoch);
    dl.push_back(plot_d);
    gl.push_back(plot_total);
  }
  double low  = std::min(0., *std::min_element(gl.begin(), gl.end())),
         high = std::max(
             *std::max_element(dl.begin(), dl.end()), *std::max_element(gl.begin(), gl.end()));
  auto plot = dm::graphics::RPlot::create();
  plot.y_limits(low - .1 * (high - low), high + .4 * (high - low))
      .lines(axis, dl, "D hinge objective", {37, 99, 235}, 2.)
      .points(axis, dl, "", {37, 99, 235}, 4.)
      .lines(axis, gl, "G source + raw orthogonal", {220, 38, 38}, 2.)
      .points(axis, gl, "", {220, 38, 38}, 4.)
      .x_label("Completed epoch; fixed final3")
      .y_label("Batch-statistics game objectives")
      .title("Validation logs do not select the checkpoint")
      .save_svg("build/big_gan_learning.svg");
}
```
