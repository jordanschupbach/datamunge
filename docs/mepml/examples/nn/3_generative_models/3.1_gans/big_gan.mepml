// result_begin: markdown
Ten requested classes, eight repeated codes per row; no class-accuracy claim.
\image(figures/big_gan_classes.png)
// result_end
\caption(Every row reuses identical codes, with only the requested label changing. These eighty panels preserve the original class grid.)
\alttext(Ten class-conditioned rows of eight outputs, with latent columns held fixed across classes.)

> Hold real pixels fixed and change only the projection class

The replay loads D and its spectral vectors from the checkpoint, without G or BN.
For every held-out real image, source features and the unconditional source term are
bit identical under c and(c+1)%10. Only the projection term changes. Both recomputed
scores match the original control archives exactly. The scatter keeps all 200 pairs;
its diagonal marks no score change. The observed maximum score effect.465906 proves
class dependence, without turning the raw score into a class posterior or accuracy.

```{cpp, results="markdown", file="figures/big_gan_projection.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
  namespace n = dm::nn;
  namespace m = n::models;
  n::NoGradGuard    guard;
  n::ParameterStore d(2), sn(0);
  for (const auto& [key, value] : n::load_npz("build/big_gan/final.npz")) {
    if (key.rfind("1/", 0) == 0)
      d.set(key.substr(2), value);
    if (key.rfind("3/", 0) == 0)
      sn.set(key.substr(2), value);
  }
  auto pools = m::LoadSaliency(std::filesystem::path(dm::datasets::data_home()) / "saliency");
  std::map<std::string, n::Tensor> data, original, controls;
  for (const auto& [k, v] : n::load_npz("build/big_gan/data.npz"))
    data.emplace(k, v);
  for (const auto& [k, v] : n::load_npz("build/big_gan/outputs.npz"))
    original.emplace(k, v);
  for (const auto& [k, v] : n::load_npz("build/big_gan/class_controls.npz"))
    controls.emplace(k, v);
  auto classes = pools[2].labels.to_vector<std::int32_t>();
  for (auto& c : classes)
    c = (c + 1) % 10;
  auto a = m::BigGanDiscriminate(d, sn, data.at("test_images"), pools[2].labels),
       changed =
           m::BigGanDiscriminate(d, sn, data.at("test_images"), n::from_vector(classes, {200}));
  if (!n::equal_bits(a.features, changed.features) || !n::equal_bits(a.source, changed.source) ||
      !n::equal_bits(a.score, original.at("real_score")) ||
      !n::equal_bits(changed.score, controls.at("changed_real_scores")))
    throw std::runtime_error("projection replay");
  n::save_npz(
      "build/big_gan/projection_terms.npz",
      {{"features", a.features},
       {"source", a.source},
       {"projection", a.projection},
       {"score", a.score},
       {"changed_projection", changed.projection},
       {"changed_score", changed.score}});
  auto   x = a.score.to_vector<double>(), y = changed.score.to_vector<double>();
  double low =
             std::min(*std::min_element(x.begin(), x.end()), *std::min_element(y.begin(), y.end())),
         high =
             std::max(*std::max_element(x.begin(), x.end()), *std::max_element(y.begin(), y.end())),
         span = high - low;
  std::print(
      "All200 projection replays exact; maximum raw-score change={}.\n",
      n::max(n::abs(a.score - changed.score)).item());
  auto p = dm::graphics::RPlot::create();
  p.y_limits(low - .1 * span, high + .4 * span)
      .lines({low, high}, {low, high}, "No score change", {120, 120, 120}, 1.)
      .points(x, y, "Same image, next class", {37, 99, 235}, 3.)
      .x_label("Original requested-class raw score")
      .y_label("Same pixels, next-class raw score")
      .title("Only the class projection changes")
      .save_svg("build/big_gan_projection.svg");
}
