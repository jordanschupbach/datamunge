\image(figures/pix2pix_pools.png)
// result_end
\caption(Rows are digit0 through9. Columns are fixed binary source then paired grayscale target. Each28x28 panel uses nearest display enlargement3 and four-pixel gray220 gaps.)
\alttext(Ten fitting pairs show their binary Sobel condition beside the original grayscale digit.)

> Keep the complete paired fitting loop and each selected write visible

The batch order seed is6121. Each epoch visits every one of the1000 fitting rows,
retaining the final8 rows after31 full32-row batches. Three fixed epochs give96
steps per group and192 optimizer writes. Separate Adam states use learning rate
.0002,beta1=.5,beta2=.999,epsilon1e-8. Neither a test score nor a validation minimum
selects the final epoch. An optional edited init path imports a complete checkpoint;
the preserved run uses the stated native seeded initialization.

For each batch the program captures D partials and steps D only. A fresh forward
through that updated D supplies G partials, then G alone steps. Every phase checks
that the other store stays bit exact. `Pix2Pix` has no fitting loop, optimizer,
implicit no-grad, gradient capture or mutable normalization state. Evaluation
uses an explicit no-grad guard and computes the signed unbiased coarse-pixel IMQ
MMD separately; it is a diagnostic, not a calibrated quality score.

The program preserves all11 original archives/3118891 values, original gallery,
three-epoch history, all3000 fitting row visits and non-timing metrics. It also
keeps all393 additional phase/probe archives/1673895 values, with each captured
derivative and post-write store. Checkpoint restoration initializes independent
stores(seed1/2), replaces all16 tensors and verifies every value bit exactly.

```{cpp, results="markdown", file="figures/pix2pix_learning.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <chrono>
#include <cmath>
#include <dm/dm.hpp>
#include <fstream>
#include <iostream>

namespace nn = dm::nn;
namespace m  = nn::models;
using Arrays = std::map<std::string, nn::Tensor>;
using nn::Tensor;

namespace {
void Require(bool condition, const std::string& message) {
  if (!condition)
    throw std::runtime_error(message);
}
void SaveArrays(const std::string& path, const Arrays& a) {
  nn::save_npz(path, nn::NamedTensors(a.begin(), a.end()));
}
bool Equal(const Tensor& a, const Tensor& b) {
  return nn::equal_bits(a, b);
}
bool Equal(const Arrays& a, const Arrays& b) {
  if (a.size() != b.size())
    return false;
  for (const auto& [key, value] : a)
    if (!b.count(key) || !Equal(value, b.at(key)))
      return false;
  return true;
}
double MaxAbsDiff(const Tensor& a, const Tensor& b) {
  return nn::max(nn::abs(nn::cast(a, nn::DType::Float64) - nn::cast(b, nn::DType::Float64))).item();
}
Arrays Fields(const m::Pix2PixOutput& o) {
  return {
      {"fake", o.fake},
      {"real_logit", o.real_logit},
      {"fake_logit", o.fake_logit},
      {"g_adversarial", o.g_adversarial},
      {"l1", o.l1},
      {"discriminator_loss", o.discriminator_loss},
      {"generator_loss", o.generator_loss}};
}
double Value(const Arrays& a, const std::string& key) {
  return a.at(key).item();
}
Tensor Flat784(const Tensor& x) {
  return nn::reshape(x, {-1, 784});
}
Tensor Rows(const Tensor& x, const std::vector<std::int64_t>& rows) {
  return nn::take_rows(x, rows);
}
void RequireOnlyOwnersChanged(
    const Arrays&                   before,
    const Arrays&                   after,
    const std::vector<std::string>& prefixes,
    const std::string&              message,
    bool                            require_change) {
  bool changed = false;
  for (const auto& [key, value] : before) {
    bool selected = false;
    for (const auto& prefix : prefixes)
      selected |= key.starts_with(prefix);
    if (!Equal(value, after.at(key))) {
      Require(selected, message);
      changed = true;
    }
  }
  if (require_change)
    Require(changed, message + " changed selected values");
}
void Mosaic(const std::filesystem::path& path, const Tensor& images, std::int64_t columns) {
  nn::save_image_grid(
      nn::reshape(images, {-1, 28, 28, 1}), path.string(), columns, 0, 1, 4, 220 / 255., 3);
}
} // namespace
int main() {
  const auto data = std::filesystem::path(dm::datasets::data_home()) / "saliency";
  dm::datasets::prepare_example_data("mnist-assets", data.parent_path());
  const std::filesystem::path root   = "build/pix2pix";
  const int                   epochs = 3;
  const std::string           init;

  const auto pools = m::LoadSaliency(data);
  std::filesystem::create_directories(root);
  std::vector<Tensor> edges;
  Arrays              source;
  for (int k = 0; k < 3; ++k) {
    edges.push_back(nn::quantized_sobel_edges(pools[k].images));
    const std::string split = k == 0 ? "fit" : k == 1 ? "validation" : "test";
    source.emplace(split + "_images", pools[k].images);
    source.emplace(split + "_edges", edges.back());
    source.emplace(split + "_labels", pools[k].labels);
    source.emplace(split + "_source_ids", pools[k].source);
  }
  SaveArrays((root / "data.npz").string(), source);
  nn::ParameterStore generator(6101), discriminator(6113);
  {
    nn::NoGradGuard guard;
    m::Pix2Pix(generator, discriminator, nn::zeros({1, 28, 28, 1}), nn::zeros({1, 28, 28, 1}));
  }
  auto snapshot = [&]() {
    Arrays a;
    for (auto [prefix, store] : std::vector<std::pair<std::string, nn::ParameterStore*>>{
             {"0/", &generator}, {"1/", &discriminator}})
      for (const auto& name : store->names())
        a.emplace(prefix + name, store->at(name).detach().clone());
    return a;
  };
  auto restore = [&](nn::ParameterStore& g, nn::ParameterStore& d, const std::string& path) {
    auto arrays = nn::load_npz(path);
    Require(arrays.size() == 16, "complete16-leaf checkpoint");
    for (const auto& [key, value] : arrays) {
      Require(
          key.size() > 2 && (key[0] == '0' || key[0] == '1') && key[1] == '/',
          "known store prefix");
      auto& p = key[0] == '0' ? g : d;
      Require(
          p.contains(key.substr(2)) && p.at(key.substr(2)).shape() == value.shape(),
          "known matching checkpoint tensor");
      p.set(key.substr(2), value);
    }
  };
  auto evaluate = [&](const Tensor& x, const Tensor& c) {
    nn::NoGradGuard guard;
    auto            fields = Fields(m::Pix2Pix(generator, discriminator, x, c));
    fields.emplace(
        "pixel_mmd",
        m::ImqMmd(m::GanCoarsePixels(Flat784(x)), m::GanCoarsePixels(Flat784(fields.at("fake"))))
            .value);
    return fields;
  };
  nn::OptimizerConfig config;
  config.kind    = nn::OptimizerKind::Adam;
  config.beta1   = .5;
  config.beta2   = .999;
  config.epsilon = 1e-8;
  nn::Optimizer g_adam(generator, .0002, config), d_adam(discriminator, .0002, config);
  std::filesystem::create_directories(root / "phases");

  if (!init.empty())
    restore(generator, discriminator, init);
  Require(
      generator.count() == 1390 && discriminator.count() == 725 &&
          generator.size() + discriminator.size() == 16,
      "2115 trainable parameters, 16 tensors");
  SaveArrays((root / "initial_arrays.npz").string(), snapshot());
  SaveArrays((root / "initial_outputs.npz").string(), evaluate(pools[2].images, edges[2]));
  nn::BatchOrder order(1000, 32, 6121);
  int            steps = 0;
  std::ofstream  history(root / "history.tsv"), batches(root / "batches.tsv");
  history.precision(17);
  history << "epoch\tdiscriminator_loss\tgenerator_loss\tg_adversarial\tl1\n";
  batches << "epoch\tstep\trow\tsource_id\n";
  const auto source_ids = nn::cast(pools[0].source, nn::DType::Int64).to_vector<std::int64_t>();
  Tensor     first_x, first_c;
  const auto started = std::chrono::steady_clock::now();
  for (int epoch = 1; epoch <= epochs; ++epoch) {
    order.begin_epoch();
    for (;;) {
      const auto rows = order.next();
      if (rows.empty())
        break;
      const Tensor x = Rows(pools[0].images, rows), c = Rows(edges[0], rows);
      if (!steps) {
        first_x = x, first_c = c;
        SaveArrays((root / "first_batch.npz").string(), {{"target", x}, {"source", c}});
      }
      for (int group : {1, 0}) {
        const auto before = snapshot();
        // One current forward for D, then a FRESH forward through updated D for G.
        const auto      out      = m::Pix2Pix(generator, discriminator, x, c);
        auto&           selected = group == 0 ? generator : discriminator;
        nn::GradOptions options;
        options.allow_unused = true;
        auto gradient        = nn::grad(
            group == 0 ? out.generator_loss : out.discriminator_loss,
            selected.parameters(),
            options);
        Arrays captured;
        for (std::size_t i = 0; i < gradient.size(); ++i) {
          if (!gradient[i].defined())
            gradient[i] = nn::zeros(selected.at(selected.names()[i]).shape(), selected.dtype());
          captured.emplace(std::to_string(group) + "/" + selected.names()[i], gradient[i]);
        }
        const auto phase = "phase" + std::to_string(2 * steps + (group == 0));
        SaveArrays((root / "phases" / (phase + "-gradient.npz")).string(), captured);
        (group == 0 ? g_adam : d_adam).step(gradient);
        SaveArrays((root / "phases" / (phase + "-after.npz")).string(), snapshot());
        RequireOnlyOwnersChanged(
            before,
            snapshot(),
            {std::to_string(group) + "/"},
            "Pix2Pix step changes ONLY own group",
            !steps);
      }
      for (auto row : rows)
        batches << epoch << '\t' << steps << '\t' << row << '\t' << source_ids[row] << '\n';
      ++steps;
    }
    SaveArrays((root / ("probe-epoch" + std::to_string(epoch) + ".npz")).string(), snapshot());
    SaveArrays(
        (root / ("probe-epoch" + std::to_string(epoch) + "-test.npz")).string(),
        evaluate(pools[2].images, edges[2]));
    const auto v = evaluate(pools[1].images, edges[1]);
    SaveArrays((root / ("probe-epoch" + std::to_string(epoch) + "-validation.npz")).string(), v);
    history << epoch;
    for (auto key : {"discriminator_loss", "generator_loss", "g_adversarial", "l1"})
      history << '\t' << Value(v, key);
    history << '\n';
    std::cout << "epoch " << epoch << ": D=" << Value(v, "discriminator_loss")
              << ", G=" << Value(v, "generator_loss") << ", paired L1=" << Value(v, "l1")
              << std::endl;
  }
  const double seconds =
      std::chrono::duration<double>(std::chrono::steady_clock::now() - started).count();

  const auto checkpoint = (root / "final.npz").string();
  Require(
      g_adam.iterations() == 96 && d_adam.iterations() == 96, "independent96-step Adam counters");
  SaveArrays(checkpoint, snapshot());
  nn::ParameterStore restored_g(1), restored_d(2);
  {
    nn::NoGradGuard guard;
    m::Pix2Pix(restored_g, restored_d, nn::zeros({1, 28, 28, 1}), nn::zeros({1, 28, 28, 1}));
  }
  restore(restored_g, restored_d, checkpoint);
  auto restored_arrays = [&]() {
    Arrays a;
    for (auto [prefix, store] : std::vector<std::pair<std::string, nn::ParameterStore*>>{
             {"0/", &restored_g}, {"1/", &restored_d}})
      for (const auto& name : store->names())
        a.emplace(prefix + name, store->at(name).detach().clone());
    return a;
  };
  auto restored_evaluate = [&](const Tensor& x, const Tensor& c) {
    nn::NoGradGuard guard;
    auto            fields = Fields(m::Pix2Pix(restored_g, restored_d, x, c));
    fields.emplace(
        "pixel_mmd",
        m::ImqMmd(m::GanCoarsePixels(Flat784(x)), m::GanCoarsePixels(Flat784(fields.at("fake"))))
            .value);
    return fields;
  };
  auto sample = [&](const Tensor& c) {
    nn::NoGradGuard guard;
    return m::Pix2PixGenerate(restored_g, c).image;
  };
  auto score_pair = [&](const Tensor& c, const Tensor& x) {
    nn::NoGradGuard guard;
    return m::Pix2PixDiscriminate(restored_d, c, x);
  };
  Require(Equal(snapshot(), restored_arrays()), "all G/D vars restore exact");
  for (int group = 0; group < 2; ++group) {
    auto            out      = m::Pix2Pix(generator, discriminator, first_x, first_c);
    auto&           selected = group == 0 ? generator : discriminator;
    nn::GradOptions options;
    options.allow_unused = true;
    auto gradients       = nn::grad(
        group == 0 ? out.generator_loss : out.discriminator_loss, selected.parameters(), options);
    Arrays fields;
    for (std::size_t i = 0; i < gradients.size(); ++i)
      fields.emplace(
          std::to_string(group) + "/" + selected.names()[i],
          gradients[i].defined()
              ? gradients[i]
              : nn::zeros(selected.at(selected.names()[i]).shape(), selected.dtype()));
    SaveArrays(
        (root / ("final_gradients_group" + std::to_string(group) + ".npz")).string(), fields);
  }
  const auto   before = restored_arrays();
  const auto   output = restored_evaluate(pools[2].images, edges[2]);
  const Tensor repeat = sample(edges[2]);
  Require(Equal(repeat, output.at("fake")), "SOURCE ONLY translation without TARGET exact");
  const double parity = MaxAbsDiff(sample(Rows(edges[2], {0})), Rows(repeat, {0}));
  Require(parity < 2e-6, "single/batch parity");
  const Tensor zeros = nn::zeros(edges[2].shape());
  const Tensor blank = sample(zeros), wrong_pair = score_pair(zeros, pools[2].images),
               pair = score_pair(edges[2], pools[2].images);
  Require(Equal(pair, output.at("real_logit")), "source+target ONLY PatchD parity");
  const double g_effect = MaxAbsDiff(repeat, blank), d_effect = MaxAbsDiff(pair, wrong_pair);
  Require(g_effect > 1e-6 && d_effect > 1e-6, "BOTH G and D depend on SOURCE");
  SaveArrays(
      (root / "condition_controls.npz").string(),
      {{"zero_source", zeros},
       {"zero_source_prediction", blank},
       {"zero_source_real_logits", wrong_pair}});
  Require(Equal(before, restored_arrays()), "immutable Pix2Pix inference");
  SaveArrays((root / "outputs.npz").string(), output);
  const Tensor baseline = nn::reshape(
      nn::tile(nn::mean(Flat784(pools[0].images), {0}, true), {200, 1}), {200, 28, 28, 1});
  SaveArrays((root / "fit_mean_baseline.npz").string(), {{"image", baseline}});
  const auto pred       = nn::cast(repeat, nn::DType::Float64),
             base       = nn::cast(baseline, nn::DType::Float64),
             truth      = nn::cast(pools[2].images, nn::DType::Float64);
  const double mse      = nn::mean(nn::square(pred - truth)).item(),
               l1       = nn::mean(nn::abs(pred - truth)).item();
  const double base_mse = nn::mean(nn::square(base - truth)).item(),
               base_l1  = nn::mean(nn::abs(base - truth)).item();
  std::vector<Tensor> gallery_rows;
  for (std::int64_t b = 0; b < 10; ++b)
    for (const Tensor* t :
         std::vector<const Tensor*>{&edges[2], &pools[2].images, &repeat, &baseline})
      gallery_rows.push_back(Flat784(Rows(*t, {b})));
  const Tensor gallery = nn::concat(gallery_rows, 0);
  SaveArrays((root / "gallery.npz").string(), {{"images", gallery}});
  Mosaic(root / "paired_examples.png", gallery, 4);
  std::ofstream meta(root / "metrics.json");
  meta.precision(17);
  meta << "{\"parameters\":2115,\"epochs\":" << epochs << ",\"steps_per_group\":" << steps
       << ",\"optimizer_updates\":" << 2 * steps << ",\"selected_epoch_fixed_final\":" << epochs
       << ",\"test_l1\":" << l1 << ",\"test_mse\":" << mse << ",\"fit_mean_l1\":" << base_l1
       << ",\"fit_mean_mse\":" << base_mse << ",\"source_generator_max_effect\":" << g_effect
       << ",\"source_discriminator_max_effect\":" << d_effect
       << ",\"single_batch_max_error\":" << parity;
  for (auto key : {"discriminator_loss", "generator_loss", "g_adversarial"})
    meta << ",\"test_" << key << "\":" << Value(output, key);
  meta << ",\"training_seconds\":" << seconds << "}\n";
  Require(bool(meta) && bool(history) && bool(batches), "complete Pix2Pix records");
  meta.close();
  history.close();
  batches.close();
  std::cout << "fixed final=" << epochs << ", test L1=" << l1 << ", MSE=" << mse
            << ", mean baseline L1/MSE=" << base_l1 << "/" << base_mse
            << ", test D/G=" << Value(output, "discriminator_loss") << "/"
            << Value(output, "generator_loss")
            << "; source only/conditional PatchGAN/restore/immutable PASS (training " << seconds
            << " s)\nArtifacts: " << root.string() << "\nAll pix2pix checks passed.\n";
  std::ifstream file(root / "history.tsv");
  std::string   header;
  std::getline(file, header);
  std::vector<double> plot_epochs, model_l1, mean_l1;
  double              epoch, dl, gl, adversarial, error;
  auto                mean_validation = nn::reshape(
      nn::tile(nn::mean(Flat784(pools[0].images), {0}, true), {200, 1}), {200, 28, 28, 1});
  double mean_error = nn::mean(
                          nn::abs(
                              nn::cast(mean_validation, nn::DType::Float64) -
                              nn::cast(pools[1].images, nn::DType::Float64)))
                          .item();
  while (file >> epoch >> dl >> gl >> adversarial >> error) {
    plot_epochs.push_back(epoch);
    model_l1.push_back(error);
    mean_l1.push_back(mean_error);
  }
  auto learning = dm::graphics::RPlot::create();
  learning.y_limits(0, .75)
      .lines(plot_epochs, model_l1, "Model validation", {37, 99, 235}, 2)
      .points(plot_epochs, model_l1, "", {37, 99, 235}, 4)
      .lines(plot_epochs, mean_l1, "Fit-mean baseline", {220, 38, 38}, 2)
      .x_label("Completed epoch; fixed final3, without early stopping")
      .y_label("Validation mean absolute pixel error, unit pixels")
      .title("Three epochs still trail the fitting-only mean image")
      .save_svg("build/pix2pix_learning.svg");
}
