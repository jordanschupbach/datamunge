> Compare paired error across all ten held-out classes

All200 test rows enter the final aggregate: model L1=.408497557 and
MSE=.191904112, compared with fitting-only mean L1=.151756616 and
MSE=.067798074. The next diagnostic averages pixel errors within each of the ten
20-row test classes. It uses labels only after the fixed final checkpoint, for
reporting. It does not change the objective, train a classifier, select an epoch
or imply that overlapping patch scores are calibrated probabilities.

```{cpp, results="markdown", file="figures/pix2pix_class_errors.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
namespace n = dm::nn;
namespace m = n::models;
using A     = std::map<std::string, n::Tensor>;
A Read(const std::string& file) {
  A a;
  for (const auto& [k, v] : n::load_npz(file))
    a.emplace(k, v);
  return a;
}
std::vector<std::int64_t> Balanced(const n::Tensor& labels) {
  auto                      values = labels.to_vector<std::int64_t>();
  std::vector<std::int64_t> rows;
  for (int c = 0; c < 10; ++c) {
    auto it = std::find(values.begin(), values.end(), c);
    if (it == values.end())
      throw std::runtime_error("all ten preview classes");
    rows.push_back(it - values.begin());
  }
  return rows;
}
void Grid(
    const std::string&               path,
    const std::vector<n::Tensor>&    columns,
    const std::vector<std::int64_t>& rows) {
  std::vector<n::Tensor> panels;
  for (auto row : rows)
    for (const auto& column : columns)
      panels.push_back(n::take_rows(column, {row}));
  n::save_image_grid(n::concat(panels, 0), path, columns.size(), 0, 1, 4, 220 / 255., 3);
}
int main() {
  auto data = Read("build/pix2pix/data.npz"), out = Read("build/pix2pix/outputs.npz"),
       baseline = Read("build/pix2pix/fit_mean_baseline.npz");
  auto labels   = data.at("test_labels").to_vector<std::int64_t>();
  auto truth    = n::cast(data.at("test_images"), n::DType::Float64),
       fake     = n::cast(out.at("fake"), n::DType::Float64),
       mean     = n::cast(baseline.at("image"), n::DType::Float64);
  std::vector<double> classes, model_l1, mean_l1;
  for (int c = 0; c < 10; ++c) {
    std::vector<std::int64_t> rows;
    for (std::size_t i = 0; i < labels.size(); ++i)
      if (labels[i] == c)
        rows.push_back(i);
    if (rows.size() != 20)
      throw std::runtime_error("twenty held-out rows per class");
    classes.push_back(c);
    model_l1.push_back(n::mean(n::abs(n::take_rows(fake - truth, rows))).item());
    mean_l1.push_back(n::mean(n::abs(n::take_rows(mean - truth, rows))).item());
  }
  n::save_npz(
      "build/pix2pix/probe-class-errors.npz",
      {{"model_l1", n::from_vector(model_l1, {10})}, {"mean_l1", n::from_vector(mean_l1, {10})}});
  auto p = dm::graphics::RPlot::create();
  p.y_limits(0, .7)
      .lines(classes, model_l1, "Model L1", {37, 99, 235}, 2)
      .points(classes, model_l1, "", {37, 99, 235}, 4)
      .lines(classes, mean_l1, "Fit-mean L1", {220, 38, 38}, 2)
      .points(classes, mean_l1, "", {220, 38, 38}, 4)
      .x_label("Diagnostic test digit label;20 paired rows per class")
      .y_label("Mean absolute error over every class pixel, unit range")
      .title("The fitting-only mean remains the stronger reference here")
      .save_svg("build/pix2pix_class_errors.svg");
}
```
