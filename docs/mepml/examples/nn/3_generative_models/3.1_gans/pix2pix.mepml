```{cpp, results="markdown", file="figures/pix2pix_patch_controls.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
namespace n = dm::nn;
namespace m = n::models;
using A     = std::map<std::string, n::Tensor>;
A Read(const std::string& file) {
  A a;
  for (const auto& [k, v] : n::load_npz(file))
    a.emplace(k, v);
  return a;
}
std::vector<std::int64_t> Balanced(const n::Tensor& labels) {
  auto                      values = labels.to_vector<std::int64_t>();
  std::vector<std::int64_t> rows;
  for (int c = 0; c < 10; ++c) {
    auto it = std::find(values.begin(), values.end(), c);
    if (it == values.end())
      throw std::runtime_error("all ten preview classes");
    rows.push_back(it - values.begin());
  }
  return rows;
}
void Grid(
    const std::string&               path,
    const std::vector<n::Tensor>&    columns,
    const std::vector<std::int64_t>& rows) {
  std::vector<n::Tensor> panels;
  for (auto row : rows)
    for (const auto& column : columns)
      panels.push_back(n::take_rows(column, {row}));
  n::save_image_grid(n::concat(panels, 0), path, columns.size(), 0, 1, 4, 220 / 255., 3);
}
int main() {
  auto out      = Read("build/pix2pix/outputs.npz"),
       controls = Read("build/pix2pix/condition_controls.npz");
  auto real     = n::select(out.at("real_logit"), 0, 0).to_vector<double>(),
       blank    = n::select(controls.at("zero_source_real_logits"), 0, 0).to_vector<double>();
  std::vector<double> patch(49);
  std::iota(patch.begin(), patch.end(), 0.);
  double low = 0, high = 0;
  for (auto* values : {&real, &blank})
    for (double value : *values) {
      low  = std::min(low, value);
      high = std::max(high, value);
    }
  double range = std::max(1e-8, high - low);
  auto   p     = dm::graphics::RPlot::create();
  p.y_limits(low - .1 * range, high + .6 * range)
      .lines(patch, real, "Real condition", {37, 99, 235}, 2)
      .lines(patch, blank, "Blank condition", {220, 38, 38}, 2)
      .x_label("First real test target; flattened7x7 patch coordinate")
      .y_label("Raw conditional D logit, not a pixel probability")
      .title("The same real target gets different conditional patch scores")
      .save_svg("build/pix2pix_patch_controls.svg");
}
