> Inspect the actual final skip activations

The following probe restores G and evaluates the first eight test conditions.
It saves all65856 values across the seven actual encoder/decoder/skip/image
boundaries. The RMS plot uses every value at each boundary, with a log10 axis.
Concatenation retains channels from both branches; averaging their channels or
adding the two inputs would change the network. These are feature amplitudes,
not importance scores or evidence that a skip is necessary for good predictions.

```{cpp, results="markdown", file="figures/pix2pix_skips.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
namespace n = dm::nn;
namespace m = n::models;
using A     = std::map<std::string, n::Tensor>;
A Read(const std::string& file) {
  A a;
  for (const auto& [k, v] : n::load_npz(file))
    a.emplace(k, v);
  return a;
}
std::vector<std::int64_t> Balanced(const n::Tensor& labels) {
  auto                      values = labels.to_vector<std::int64_t>();
  std::vector<std::int64_t> rows;
  for (int c = 0; c < 10; ++c) {
    auto it = std::find(values.begin(), values.end(), c);
    if (it == values.end())
      throw std::runtime_error("all ten preview classes");
    rows.push_back(it - values.begin());
  }
  return rows;
}
void Grid(
    const std::string&               path,
    const std::vector<n::Tensor>&    columns,
    const std::vector<std::int64_t>& rows) {
  std::vector<n::Tensor> panels;
  for (auto row : rows)
    for (const auto& column : columns)
      panels.push_back(n::take_rows(column, {row}));
  n::save_image_grid(n::concat(panels, 0), path, columns.size(), 0, 1, 4, 220 / 255., 3);
}
int main() {
  auto checkpoint = Read("build/pix2pix/final.npz"), data = Read("build/pix2pix/data.npz");
  n::ParameterStore g(1);
  n::NoGradGuard    guard;
  m::Pix2PixGenerate(g, n::ones({1, 28, 28, 1}));
  for (auto& [key, value] : checkpoint)
    if (key.starts_with("0/"))
      g.set(key.substr(2), value);
  auto out = m::Pix2PixGenerate(g, n::slice_axis(data.at("test_edges"), 0, 0, 8));
  A    fields{
         {"down14", out.down14},
         {"down7", out.down7},
         {"up14", out.up14},
         {"joined14", out.joined14},
         {"up28", out.up28},
         {"joined28", out.joined28},
         {"image", out.image}};
  n::save_npz(
      "build/pix2pix/probe-generator-skips.npz", n::NamedTensors(fields.begin(), fields.end()));
  std::vector<double> index, rms;
  int                 k = 0;
  for (auto name : {"down14", "down7", "up14", "joined14", "up28", "joined28", "image"}) {
    index.push_back(++k);
    rms.push_back(
        std::log10(
            std::max(
                1e-30,
                std::sqrt(
                    n::mean(n::square(n::cast(fields.at(name), n::DType::Float64))).item()))));
  }
  auto bounds = std::minmax_element(rms.begin(), rms.end());
  auto p      = dm::graphics::RPlot::create();
  p.y_limits(*bounds.first - .5, *bounds.second + 2)
      .points(index, rms, "Final RMS", {37, 99, 235}, 4)
      .x_label("1 down14;2 down7;3 up14;4 join14;5 up28;6 join28;7 image")
      .y_label("log10 RMS of every value at the executed boundary")
      .title("Actual concatenation boundaries preserve both feature banks")
      .save_svg("build/pix2pix_skips.svg");
}
```
