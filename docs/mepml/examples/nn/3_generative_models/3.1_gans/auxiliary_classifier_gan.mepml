```{cpp, results="markdown", file="figures/acgan_source_gradients.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
  namespace n = dm::nn;
  std::vector<double> x, d, g;
  for (int k = -80; k <= 80; ++k) {
    x.push_back(k / 10.);
    auto r = n::zeros({1, 1}, n::DType::Float64),
         f = n::full({1, 1}, k / 10., n::DType::Float64).requires_grad_();
    auto o = n::models::LogisticGanObjectives(r, f);
    d.push_back(n::grad(o.discriminator, {f})[0].item());
    g.push_back(n::grad(o.generator, {f})[0].item());
  }
  auto p = dm::graphics::RPlot::create();
  p.lines(x, d, "D fake derivative", {220, 38, 38}, 2.)
      .lines(x, g, "G fake derivative", {37, 99, 235}, 2.)
      .x_label("Fake source logit")
      .y_label("Derivative per fake example")
      .title("Non-saturating G keeps a strong derivative for rejected fakes")
      .save_svg("build/acgan_source_gradients.svg");
  auto r = n::full({1, 1}, 80.).requires_grad_(), f = n::full({1, 1}, -80.).requires_grad_();
  auto o = n::models::LogisticGanObjectives(r, f);
  std::print(
      "Float32: dD/dreal at80={:.9e}; dG/dfake at-80={:.9f}.\n",
      n::grad(o.discriminator, {r})[0].item(),
      n::grad(o.generator, {f})[0].item());
}
