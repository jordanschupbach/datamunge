> Expose the actual discriminator feature mixture

The final probe restores the four D stores and takes the first eight real test
images. At alpha.5, old_path and new_path are each8x4x4x4; mixed is their mean.
The native return also exposes the post-core feature map base and raw score.
All2056 entries are saved for independent checking. The plot keeps all64 channel
coordinates for the first image, rather than selecting only large responses.
These discriminator features are unconstrained and do not share image pixel units.

```{cpp, results="markdown", file="figures/progressive_discriminator.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
namespace n = dm::nn;
using A     = std::map<std::string, n::Tensor>;
A Read(const std::string& file) {
  A a;
  for (const auto& [k, v] : n::load_npz(file))
    a.emplace(k, v);
  return a;
}
int main() {
  n::ParameterStore core(1), old(2), fresh(3), rgb(4);
  auto              data = Read("build/progressive_gan/data.npz"),
       checkpoint        = Read("build/progressive_gan/final.npz");
  n::NoGradGuard guard;
  auto           x = n::slice_axis(data.at("test_images"), 0, 0, 8);
  n::models::ProgressiveGanDiscriminate(core, old, fresh, rgb, x, n::full({}, .5));
  n::ParameterStore* stores[] = {&core, &old, &fresh, &rgb};
  for (auto& [key, value] : checkpoint)
    if (key[0] >= '4')
      stores[key[0] - '4']->set(key.substr(2), value);
  auto out = n::models::ProgressiveGanDiscriminate(core, old, fresh, rgb, x, n::full({}, .5));
  if (n::max(n::abs(out.mixed - .5 * (out.old_path + out.new_path))).item() != 0)
    throw std::runtime_error("D feature mixture");
  n::save_npz(
      "build/progressive_gan/probe-discriminator-features.npz",
      {{"old_path", out.old_path},
       {"new_path", out.new_path},
       {"mixed", out.mixed},
       {"base", out.base},
       {"score", out.score}});
  auto a = n::select(out.old_path, 0, 0).to_vector<double>(),
       b = n::select(out.new_path, 0, 0).to_vector<double>(),
       c = n::select(out.mixed, 0, 0).to_vector<double>();
  std::vector<double> coordinate(64);
  std::iota(coordinate.begin(), coordinate.end(), 0.);
  double low = 0, high = 0;
  for (auto* values : {&a, &b, &c})
    for (double value : *values) {
      low  = std::min(low, value);
      high = std::max(high, value);
    }
  double range = std::max(1e-8, high - low);
  auto   plot  = dm::graphics::RPlot::create();
  plot.y_limits(low - .1 * range, high + .8 * range)
      .lines(coordinate, a, "Old path", {220, 38, 38}, 2)
      .lines(coordinate, b, "New path", {16, 145, 74}, 2)
      .lines(coordinate, c, "Mixed", {37, 99, 235}, 2)
      .x_label("First real image; flattened4x4x4 feature coordinate")
      .y_label("Discriminator feature value")
      .title("Both feature paths meet before the shared core")
      .save_svg("build/progressive_discriminator.svg");
}
