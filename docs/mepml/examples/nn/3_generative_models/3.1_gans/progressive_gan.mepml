> Inspect derivatives without confusing a diagnostic with a training step

smooth_gradients.npz uses the final weights, the first fade batch's real/noise
inputs and alpha.5, taking G partials for groups0-3 and D partials for groups4-7.
All2067 entries are retained. This is a deliberate reevaluation of both paths,
not a stable8 optimizer update. Old RGB groups may have nonzero partials here
even though stable8 excludes them from writes. Norms below pool each group's
source-named tensors; no group is dropped from the diagnostic.

```{cpp, results="markdown", file="figures/progressive_gradients.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
namespace n = dm::nn;
using A     = std::map<std::string, n::Tensor>;
A Read(const std::string& file) {
  A a;
  for (const auto& [k, v] : n::load_npz(file))
    a.emplace(k, v);
  return a;
}
int main() {
  auto                a = Read("build/progressive_gan/smooth_gradients.npz");
  std::vector<double> group, norm;
  for (int k = 0; k < 8; ++k) {
    double square = 0;
    for (auto& [name, t] : a)
      if (name[0] == '0' + k)
        square += n::sum(n::square(n::cast(t, n::DType::Float64))).item();
    group.push_back(k);
    norm.push_back(std::log10(std::max(std::sqrt(square), 1e-30)));
  }
  auto bounds = std::minmax_element(norm.begin(), norm.end());
  auto p      = dm::graphics::RPlot::create();
  p.y_limits(*bounds.first - 1, *bounds.second + 3)
      .points(group, norm, "All groups at.5", {37, 99, 235}, 4)
      .x_label("Group ID0-3 uses G loss;4-7 uses D loss")
      .y_label("log10 Euclidean norm of group partials")
      .title("A smooth diagnostic evaluates all eight groups")
      .save_svg("build/progressive_gradients.svg");
}
```
