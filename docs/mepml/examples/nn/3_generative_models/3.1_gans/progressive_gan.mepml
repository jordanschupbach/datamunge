> Keep every phase capture and optimizer write in the complete program

For raw discriminator scores r and f, the source uses
L_D=.5*(mean((r-1)^2)+mean(f^2)) and L_G=mean((f-1)^2).
The generator objective has no factor.5. Its scale affects derivatives and must
remain explicit when comparing native arithmetic with the original run.

For each batch, one forward supplies all active D partials, which are captured
before any D write. All selected D groups then step. A fresh forward through the
updated D supplies all active G partials, captured before any G write. Calling
a fresh forward separately after each group write would change the method.
Inactive and opposite-store values are checked after every phase. There is no
hidden fitting loop, optimizer write, stage transition or mutable normalization
state in `ProgressiveGan`.

The native batch order seed is6497. Epoch noise seeds6504/6505/6506 each supply
1000 Gaussian16-vectors; validation/test banks use6481/6491. The32-row batches
retain their final8 rows, giving96 batches and576 group optimizer writes.
Counters finish at96,64,64,64,96,64,64,64. Three epochs are fixed in advance;
validation is recorded without early stopping or checkpoint selection. The
restored final checkpoint has all eight stores and24 tensors.

The program retains all eight original NPZ archives, four source PNG galleries,
history/batch records and metrics. It additionally saves each phase's selected
derivatives and complete post-write stores, plus15 probes:399 archives covering
804784 values. These extra artifacts make the update schedule inspectable.

```{cpp, results="markdown", file="figures/progressive_learning.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <chrono>
#include <cmath>
#include <dm/dm.hpp>
#include <fstream>
#include <iostream>

namespace nn = dm::nn;
namespace m  = nn::models;
using Arrays = std::map<std::string, nn::Tensor>;
using nn::Tensor;

namespace {
void Require(bool condition, const std::string& message) {
  if (!condition)
    throw std::runtime_error(message);
}
void Near(double actual, double expected, double tolerance, const std::string& message) {
  Require(std::abs(actual - expected) <= tolerance, message);
}
void SaveArrays(const std::string& path, const Arrays& a) {
  nn::save_npz(path, nn::NamedTensors(a.begin(), a.end()));
}
bool Equal(const Tensor& a, const Tensor& b) {
  return nn::equal_bits(a, b);
}
bool Equal(const Arrays& a, const Arrays& b) {
  if (a.size() != b.size())
    return false;
  for (const auto& [key, value] : a)
    if (!b.count(key) || !Equal(value, b.at(key)))
      return false;
  return true;
}
Tensor Gaussian(std::int64_t rows, std::int64_t width, std::uint64_t seed) {
  return nn::cast(
      m::GaussianNoise({rows, width}, 1, seed).reshape({rows, width}), nn::DType::Float32);
}
double MaxAbsDiff(const Tensor& a, const Tensor& b) {
  return nn::max(nn::abs(nn::cast(a, nn::DType::Float64) - nn::cast(b, nn::DType::Float64))).item();
}
Arrays Fields(const m::ProgressiveGanOutput& o) {
  return {
      {"fake", o.fake},
      {"old4", o.old4},
      {"new8", o.new8},
      {"real_score", o.real_score},
      {"fake_score", o.fake_score},
      {"d_loss", o.d_loss},
      {"g_loss", o.g_loss}};
}
double Value(const Arrays& a, const std::string& key) {
  return a.at(key).item();
}

/// 8x8 images at 8x with 4-pixel gray-220 gaps.
void Mosaic(const std::filesystem::path& path, const Tensor& images, std::int64_t columns) {
  nn::save_image_grid(
      nn::reshape(images, {-1, 8, 8, 1}), path.string(), columns, 0, 1, 4, 220 / 255., 8);
}

} // namespace
int main() {
  const std::filesystem::path root   = "build/progressive_gan";
  const int                   epochs = 3;
  const auto                  data = std::filesystem::path(dm::datasets::data_home()) / "saliency";
  dm::datasets::prepare_example_data("mnist-assets", data.parent_path());
  const auto pools = m::LoadSaliency(data);
  std::filesystem::create_directories(root);
  std::vector<Tensor> resized;
  Arrays              records;
  for (int k = 0; k < 3; ++k) {
    resized.push_back(m::BigGanResize8(pools[k].images));
    const std::string split = k == 0 ? "fit" : k == 1 ? "validation" : "test";
    records.emplace(split + "_original", pools[k].images);
    records.emplace(split + "_images", resized.back());
    records.emplace(split + "_labels", pools[k].labels);
    records.emplace(split + "_source_ids", pools[k].source);
  }
  SaveArrays((root / "data.npz").string(), records);
  const Tensor vz = Gaussian(200, 16, 6481), tz = Gaussian(200, 16, 6491);
  SaveArrays((root / "fixed_noise.npz").string(), {{"validation_z", vz}, {"test_z", tz}});
  std::filesystem::create_directories(root / "phases");
  std::vector<std::unique_ptr<nn::ParameterStore>> stores;
  for (auto seed : {6401, 6407, 6413, 6421, 6427, 6449, 6451, 6469})
    stores.push_back(std::make_unique<nn::ParameterStore>(seed));
  auto forward = [&](const Tensor& x, const Tensor& z, float value) {
    auto alpha = nn::full({1}, value, stores[0]->dtype());
    return m::ProgressiveGan(
        *stores[0],
        *stores[1],
        *stores[2],
        *stores[3],
        *stores[4],
        *stores[5],
        *stores[6],
        *stores[7],
        x,
        z,
        alpha);
  };
  {
    nn::NoGradGuard guard;
    forward(nn::zeros({1, 8, 8, 1}), nn::zeros({1, 16}), 0);
  }
  auto snapshot = [&]() {
    Arrays a;
    for (int k = 0; k < 8; ++k)
      for (const auto& name : stores[k]->names())
        a.emplace(std::to_string(k) + "/" + name, stores[k]->at(name).detach().clone());
    return a;
  };
  auto evaluate = [&](const Tensor& x, const Tensor& z, float value) {
    nn::NoGradGuard guard;
    return Fields(forward(x, z, value));
  };
  auto capture =
      [&](const std::vector<int>& groups, const Tensor& x, const Tensor& z, float value) {
        auto            out = forward(x, z, value);
        Arrays          a;
        nn::GradOptions options;
        options.retain_graph = true;
        options.allow_unused = true;
        for (int k : groups) {
          auto values = nn::grad(k < 4 ? out.g_loss : out.d_loss, stores[k]->parameters(), options);
          auto names  = stores[k]->names();
          for (std::size_t i = 0; i < names.size(); ++i)
            a.emplace(
                std::to_string(k) + "/" + names[i],
                values[i].defined()
                    ? values[i]
                    : nn::zeros(stores[k]->at(names[i]).shape(), stores[k]->dtype()));
        }
        return a;
      };
  nn::OptimizerConfig config;
  config.kind    = nn::OptimizerKind::Adam;
  config.beta1   = .5;
  config.beta2   = .999;
  config.epsilon = 1e-8;
  std::vector<std::unique_ptr<nn::Optimizer>> optimizers;
  for (auto& store : stores)
    optimizers.push_back(std::make_unique<nn::Optimizer>(*store, .0002, config));
  const int count[] = {1236, 5, 296, 5, 213, 8, 296, 8};
  for (int i = 0; i < 8; ++i)
    Require(stores[i]->count() == count[i], "progressive parameter-group counts");
  const auto initial = snapshot();
  SaveArrays((root / "initial_arrays.npz").string(), initial);
  SaveArrays((root / "probe-initial.npz").string(), initial);
  SaveArrays((root / "initial_outputs.npz").string(), evaluate(resized[2], tz, 0));
  nn::BatchOrder order(1000, 32, 6497);
  int            batches_count = 0, group_updates = 0;
  Arrays         old_at_stable;
  std::ofstream  history(root / "history.tsv"), batches(root / "batches.tsv");
  history.precision(17);
  batches.precision(17);
  history << "epoch\tstage\talpha\td_loss\tg_loss\n";
  batches << "epoch\tstep\tstage\talpha\trow\tsource_id\n";
  const auto source = nn::cast(pools[0].source, nn::DType::Int64).to_vector<std::int64_t>();
  Tensor     fade_x, fade_z;
  const auto started = std::chrono::steady_clock::now();
  for (int epoch = 1; epoch <= epochs; ++epoch) {
    const int         stage      = epoch == 1 ? 0 : epoch == 2 ? 1 : 2;
    const std::string stage_name = stage == 0 ? "stable4" : stage == 1 ? "fade8" : "stable8";
    const Tensor      noise      = Gaussian(1000, 16, 6503 + epoch);
    order.begin_epoch();
    int step = 0;
    if (epoch == 3)
      old_at_stable = snapshot();
    for (;;) {
      const auto rows = order.next();
      if (rows.empty())
        break;
      const float  alpha = stage == 0 ? 0 : stage == 1 ? float(step + 1) / 32 : 1;
      const Tensor x = nn::take_rows(resized[0], rows), z = nn::take_rows(noise, rows);
      if (stage == 1 && step == 0)
        fade_x = x, fade_z = z;
      if (step == 0)
        SaveArrays(
            (root / ("probe-first-stage" + std::to_string(stage) + ".npz")).string(),
            evaluate(x, z, alpha));
      for (bool generator : {false, true}) {
        const auto active = m::ProgressiveActiveGroups(stage, generator);
        // One fresh forward per phase; ALL selected gradients are captured before any write.
        const auto      out = forward(x, z, alpha);
        nn::GradOptions options;
        options.retain_graph = true;
        options.allow_unused = true;
        std::vector<std::vector<Tensor>> gradients;
        Arrays                           captured;
        for (int group : active) {
          auto values =
              nn::grad(generator ? out.g_loss : out.d_loss, stores[group]->parameters(), options);
          auto names = stores[group]->names();
          for (std::size_t i = 0; i < values.size(); ++i) {
            if (!values[i].defined())
              values[i] = nn::zeros(stores[group]->at(names[i]).shape(), stores[group]->dtype());
            captured.emplace(std::to_string(group) + "/" + names[i], values[i]);
          }
          gradients.push_back(values);
        }
        const auto phase_name = "batch" + std::to_string(batches_count) + (generator ? "-g" : "-d");
        SaveArrays((root / "phases" / (phase_name + "-gradient.npz")).string(), captured);
        const auto before = snapshot();
        for (std::size_t i = 0; i < active.size(); ++i) {
          optimizers[active[i]]->step(gradients[i]);
          ++group_updates;
        }
        SaveArrays((root / "phases" / (phase_name + "-after.npz")).string(), snapshot());
        const auto after = snapshot();
        for (const auto& [key, value] : before)
          if (std::find(active.begin(), active.end(), key[0] - '0') == active.end())
            Require(
                Equal(value, after.at(key)),
                "inactive/opposite group frozen including old/new RGB paths");
      }
      for (auto row : rows)
        batches << epoch << '\t' << batches_count << '\t' << stage << '\t' << alpha << '\t' << row
                << '\t' << source[row] << '\n';
      ++batches_count;
      ++step;
    }
    Require(step == 32, "32 compact batches / epoch");
    const auto after_epoch = snapshot();
    SaveArrays((root / ("probe-epoch" + std::to_string(epoch) + ".npz")).string(), after_epoch);
    if (stage == 0)
      for (const auto& [key, value] : initial)
        if (key[0] == '2' || key[0] == '3' || key[0] == '6' || key[0] == '7')
          Require(Equal(value, after_epoch.at(key)), "new blocks UNTRAINED before fade");
    if (stage == 2)
      for (const auto& [key, value] : old_at_stable)
        if (key[0] == '1' || key[0] == '5')
          Require(Equal(value, after_epoch.at(key)), "old RGB paths FROZEN after fade");
    const float alpha = stage == 0 ? 0 : 1;
    const auto  v     = evaluate(resized[1], vz, alpha);
    history << epoch << '\t' << stage << '\t' << alpha << '\t' << Value(v, "d_loss") << '\t'
            << Value(v, "g_loss") << '\n';
    SaveArrays((root / ("probe-epoch" + std::to_string(epoch) + "-validation.npz")).string(), v);
    auto test_fields = evaluate(resized[2], tz, alpha);
    SaveArrays(
        (root / ("probe-epoch" + std::to_string(epoch) + "-test.npz")).string(), test_fields);
    Mosaic(
        root / ("epoch" + std::to_string(epoch) + ".png"),
        nn::slice_axis(test_fields.at("fake"), 0, 0, 40),
        8);
    std::cout << "epoch " << epoch << ": " << stage_name << ", alpha=" << alpha
              << ", D/G=" << Value(v, "d_loss") << '/' << Value(v, "g_loss") << std::endl;
  }
  const double seconds =
      std::chrono::duration<double>(std::chrono::steady_clock::now() - started).count();
  SaveArrays((root / "probe-smooth-input.npz").string(), {{"x", fade_x}, {"z", fade_z}});
  SaveArrays(
      (root / "smooth_gradients.npz").string(),
      capture({0, 1, 2, 3, 4, 5, 6, 7}, fade_x, fade_z, .5f));
  SaveArrays((root / "probe-final-alpha-half.npz").string(), evaluate(resized[2], tz, .5f));
  const std::vector<int> expected_iterations{96, 64, 64, 64, 96, 64, 64, 64};
  for (int k = 0; k < 8; ++k)
    Require(optimizers[k]->iterations() == expected_iterations[k], "stage-specific Adam counters");
  const auto checkpoint = (root / "final.npz").string();
  SaveArrays(checkpoint, snapshot());
  std::vector<std::unique_ptr<nn::ParameterStore>> restored;
  for (int seed = 1; seed <= 8; ++seed)
    restored.push_back(std::make_unique<nn::ParameterStore>(seed));
  auto restored_forward = [&](const Tensor& x, const Tensor& z, float value) {
    auto a = nn::full({1}, value);
    return m::ProgressiveGan(
        *restored[0],
        *restored[1],
        *restored[2],
        *restored[3],
        *restored[4],
        *restored[5],
        *restored[6],
        *restored[7],
        x,
        z,
        a);
  };
  {
    nn::NoGradGuard guard;
    restored_forward(nn::zeros({1, 8, 8, 1}), nn::zeros({1, 16}), 0);
  }
  for (const auto& [key, value] : nn::load_npz(checkpoint)) {
    Require(
        key.size() > 2 && key[0] >= '0' && key[0] <= '7' && key[1] == '/',
        "known checkpoint prefix");
    auto& p = *restored[key[0] - '0'];
    Require(
        p.contains(key.substr(2)) && p.at(key.substr(2)).shape() == value.shape(),
        "known checkpoint shape");
    p.set(key.substr(2), value);
  }
  auto restored_arrays = [&]() {
    Arrays a;
    for (int k = 0; k < 8; ++k)
      for (const auto& name : restored[k]->names())
        a.emplace(std::to_string(k) + "/" + name, restored[k]->at(name).detach().clone());
    return a;
  };
  auto restored_evaluate = [&](const Tensor& x, const Tensor& z, float value) {
    nn::NoGradGuard guard;
    return Fields(restored_forward(x, z, value));
  };
  auto sample = [&](const Tensor& z, float value) {
    nn::NoGradGuard guard;
    return m::ProgressiveGanGenerate(
               *restored[0], *restored[1], *restored[2], *restored[3], z, nn::full({1}, value))
        .image;
  };
  Require(Equal(snapshot(), restored_arrays()), "all progressive groups restore exact");
  const auto before      = restored_arrays();
  const auto output      = restored_evaluate(resized[2], tz, 1),
             old         = restored_evaluate(resized[2], tz, 0);
  const Tensor generated = sample(tz, 1);
  Require(Equal(generated, output.at("new8")), "alpha 1 EXACT new8 endpoint");
  Require(
      Equal(old.at("fake"), nn::upsample_nearest(old.at("old4"), 2)),
      "alpha 0 EXACT upsampled old4 endpoint");
  const double parity =
      MaxAbsDiff(sample(nn::take_rows(tz, {0}), 1), nn::take_rows(generated, {0}));
  Require(parity < 2e-6, "noise only single batch parity");
  Arrays              controls;
  std::vector<Tensor> fade_rows(40);
  for (int k = 0; k < 5; ++k) {
    const Tensor image = sample(tz, k * .25f);
    controls.emplace("alpha" + std::to_string(k), image);
    for (int b = 0; b < 8; ++b)
      fade_rows[b * 5 + k] = nn::take_rows(image, {b});
  }
  const Tensor fade    = nn::concat(fade_rows, 0);
  int          invalid = 0;
  for (float value : {-.1f, 1.1f})
    try {
      sample(tz, value);
    } catch (const std::exception&) {
      ++invalid;
    }
  Require(invalid == 2, "invalid fade alpha rejected");
  Require(Equal(before, restored_arrays()), "immutable all progressive stages");
  controls.emplace("old4", old.at("old4"));
  controls.emplace("new8", output.at("new8"));
  controls.emplace("gallery", fade);
  SaveArrays((root / "fade_controls.npz").string(), controls);
  Mosaic(root / "fade_grid.png", fade, 5);
  SaveArrays((root / "outputs.npz").string(), output);
  std::ofstream meta(root / "metrics.json");
  meta.precision(17);
  meta << "{\"parameters\":2067,\"active_parameters_stable4\":1462,\"active_parameters_fade\":2067,"
          "\"active_parameters_stable8\":2054,\"epochs\":"
       << epochs << ",\"batches\":" << batches_count
       << ",\"parameter_group_optimizer_updates\":" << group_updates
       << ",\"selected_epoch_fixed_final\":" << epochs
       << ",\"test_d_loss\":" << Value(output, "d_loss")
       << ",\"test_g_loss\":" << Value(output, "g_loss") << ",\"single_batch_max_error\":" << parity
       << ",\"invalid_alpha_rejected\":2,\"training_seconds\":" << seconds << "}\n";
  Require(bool(meta) && bool(history) && bool(batches), "complete progressive artifacts");
  meta.close();
  history.close();
  batches.close();
  std::cout << "fixed final=" << epochs << ", test D/G=" << Value(output, "d_loss") << '/'
            << Value(output, "g_loss")
            << ", active params 1462 -> 2067 -> 2054, group updates=" << group_updates
            << "; actual growth/alpha endpoints/inactive freeze/captured phase "
               "grads/restore/immutable PASS (training "
            << seconds << " s)\nArtifacts: " << root.string()
            << "\nAll progressive_gan checks passed.\n";
  std::ifstream records_file(root / "history.tsv");
  std::string   header;
  std::getline(records_file, header);
  std::vector<double> plot_epochs, d_losses, g_losses;
  double              ep, st, al, dl, gl;
  while (records_file >> ep >> st >> al >> dl >> gl) {
    plot_epochs.push_back(ep);
    d_losses.push_back(dl);
    g_losses.push_back(gl);
  }
  auto learning = dm::graphics::RPlot::create();
  learning.y_limits(0, 1.5)
      .lines(plot_epochs, d_losses, "Validation D", {37, 99, 235}, 2)
      .points(plot_epochs, d_losses, "", {37, 99, 235}, 4)
      .lines(plot_epochs, g_losses, "Validation G", {220, 38, 38}, 2)
      .points(plot_epochs, g_losses, "", {220, 38, 38}, 4)
      .x_label("Epoch1 stable4;2 fade8 endpoint;3 stable8")
      .y_label("Fixed-bank least-squares objective")
      .title("Three recorded epochs do not establish convergence")
      .save_svg("build/progressive_learning.svg");
}
