> Fit one real CIFAR image with the complete three-scale program

Native dataset preparation obtains CIFAR-10 through the shared configurable cache.
This run uses data_batch_1.bin row0 only. RGB bytes divide by255, then scale to
[-1,1]. Targets16x16 and24x24 use native antialiased Keys bicubic, half-pixel
coordinates and symmetric duplicated edges; target32x32 is the original image.
Interpolation is signed and may overshoot; no clamp is inserted.

Fixed reconstruction noise is coarse shared RGB seed7411 and zero at both higher
scales. Each scale has separate G7307/D7309 stores. Higher scales copy BOTH
groups from the previous final checkpoint and create cold Adam(.0005,.5,.999,
epsilon1e-8) states with clocks0/0. No optimizer history crosses a scale boundary.
There are three epochs of16 steps per scale:48 D writes and48 G writes,288 total.
The selected checkpoint is the fixed final epoch3; no selection or early stopping
uses a test image. The first fitting batch is retained only for comparable logs.

For step t=0..47 at scale k, base seed is7501+10000k+307t. Each frozen lower
generator receives base+97j noise; the current generator receives base+211.
Lower random draws are refreshed at every fitting step. The fixed reconstruction
and measured amplitude stay unchanged. Each batch takes D first, then a fresh G
capture after the D write. No stale G capture is reused. Completed scales retain
weights without optimizers. Explicit no-grad sampling freezes the lower chain;
every saved phase also records all lower G/D weights to verify their immutability.

The complete editable program saves source-compatible arrays, all288 phase
captures/counters, nine epoch records, checkpoints, three PNGs and scalar metrics.
Named maps below only transport tensors and snapshots; all model/preparation,
noise, amplitude, interpolation, objectives and optimizer arithmetic use the native
API. Draw is the visible caller-owned pyramid schedule, including rectangular
integer-truncated sizes. Source command-line init/epoch overrides are replaced
here by the fixed documented default run.

```{cpp, results="markdown", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <chrono>
#include <fstream>
#include <memory>

namespace n = dm::nn;
namespace m = n::models;
using A = std::map<std::string, n::Tensor>;
using T = n::Tensor;
struct Scale {
  n::ParameterStore g{7307}, d{7309};
  std::unique_ptr<n::Optimizer> go, do_;
};
using Models = std::vector<std::unique_ptr<Scale>>;
const int sizes[3] = {16, 24, 32};
T Zero(int count, int h, int w) { return n::zeros({count, h, w, 3}); }
void Save(const std::filesystem::path& file, const A& a) {
  n::NamedTensors values;
  for (const auto& [key, value] : a) values.emplace_back(key, value);
  n::save_npz(file.string(), values);
}
A Weights(const Scale& s) {
  A out;
  for (const auto& [prefix, store] :
       std::vector<std::pair<std::string, const n::ParameterStore*>>{{"0/", &s.g}, {"1/", &s.d}})
    for (const auto& name : store->names()) out.emplace(prefix + name, store->at(name).detach().clone());
  return out;
}
bool Equal(const A& a, const A& b) {
  if (a.size() != b.size()) return false;
  for (const auto& [key, value] : a)
    if (!b.count(key) || !n::equal_bits(value, b.at(key))) return false;
  return true;
}
void Load(Scale& s, const A& values) {
  for (const auto& [key, value] : values)
    (key[0] == '0' ? s.g : s.d).set(key.substr(2), value.detach().clone());
}
A Forward(Scale& s, const A& b) {
  auto o = m::SingleImageGan(s.g, s.d, b.at("image"), b.at("previous"), b.at("noise"),
                            b.at("rec_previous"), b.at("rec_noise"), b.at("amplitude"));
  return {{"fake", o.fake}, {"reconstruction", o.reconstruction},
          {"real_score", o.real_score}, {"fake_score", o.fake_score},
          {"d_loss", o.d_loss}, {"g_loss", o.g_loss},
          {"adversarial_loss", o.adversarial_loss}, {"reconstruction_loss", o.reconstruction_loss}};
}
A Partials(const n::ParameterStore& p, const std::vector<T>& gradient, int group) {
  A out;
  auto names = p.names();
  for (std::size_t i = 0; i < names.size(); ++i)
    out.emplace(std::to_string(group) + "/" + names[i], gradient[i]);
  return out;
}
T Draw(Models& models, const std::vector<float>& amplitudes, const std::vector<T>& fixed,
       int count, int rows, int seed, bool reconstruction = false, int height = 32,
       int width = 32, A* capture = nullptr, int zero_scale = -1) {
  n::NoGradGuard frozen;
  T value = Zero(rows, height / 2, width / 2);
  for (int k = 0; k < count; ++k) {
    int h = k == 0 ? height / 2 : k == 1 ? height * 3 / 4 : height;
    int w = k == 0 ? width / 2 : k == 1 ? width * 3 / 4 : width;
    if (k) value = m::SRBicubic(value, h, w);
    T z = reconstruction ? fixed[k] : m::SingleImageNoise(rows, h, w, k == 0, seed + 97 * k);
    if (k == zero_scale) z = Zero(rows, h, w);
    T previous = value;
    value = m::SingleImageGenerate(models[k]->g, previous, z, n::full({1}, amplitudes[k])).image;
    if (capture) {
      auto prefix = "scale" + std::to_string(k) + "_";
      capture->emplace(prefix + "noise", z);
      capture->emplace(prefix + "previous", previous);
      capture->emplace(prefix + "fake", value);
    }
  }
  return value;
}
int main() {
  const std::filesystem::path root = "build/singan";
  std::filesystem::create_directories(root);
  const auto data = dm::datasets::fetch("cifar10");
  const auto source = n::data::LoadCifar({std::filesystem::path(data) / "data_batch_1.bin"}, n::data::Cifar::k10);
  const T image = 2.0 * m::SRPairs(source.images, {0}).hr - 1.0;
  A pyramid{{"source", image}};
  std::vector<T> targets, fixed;
  for (int k = 0; k < 3; ++k) {
    targets.push_back(k == 2 ? image : m::SRBicubic(image, sizes[k], sizes[k]));
    fixed.push_back(k ? Zero(1, sizes[k], sizes[k]) : m::SingleImageNoise(1, 16, 16, true, 7411));
    pyramid.emplace("target" + std::to_string(k), targets.back());
    pyramid.emplace("fixed_noise" + std::to_string(k), fixed.back());
  }
  Save(root / "data.npz", pyramid);
  Models models;
  std::vector<float> amplitudes;
  std::ofstream history(root / "history.tsv"), steps(root / "steps.tsv");
  history.precision(17);
  history << "scale\tepoch\td_loss\tg_loss\tadversarial_loss\treconstruction_loss\n";
  steps << "scale\tepoch\tstep\tseed\n";
  auto started = std::chrono::steady_clock::now();
  for (int k = 0; k < 3; ++k) {
    const auto dir = root / ("scale" + std::to_string(k));
    std::filesystem::create_directories(dir / "phases");
    std::vector<A> lower;
    for (const auto& s : models) lower.push_back(Weights(*s));
    T prev_rec = k ? m::SRBicubic(Draw(models, amplitudes, fixed, k, 1, 0, true), sizes[k], sizes[k])
                   : Zero(1, 16, 16);
    amplitudes.push_back(k ? float(m::SingleImageAmplitude(targets[k], prev_rec).item()) : 1.f);
    models.push_back(std::make_unique<Scale>());
    auto& model = *models.back();
    {
      n::NoGradGuard init;
      T zero = Zero(1, 4, 4);
      m::SingleImageDiscriminate(model.d, m::SingleImageGenerate(model.g, zero, zero, n::ones({1})).image);
    }
    if (model.g.count() != 371 || model.d.count() != 297) throw std::runtime_error("scale census");
    if (k) Load(model, Weights(*models[k - 1])); // BOTH groups warm-start; no optimizer state copied.
    n::OptimizerConfig cfg;
    cfg.kind = n::OptimizerKind::Adam;
    cfg.beta1 = .5; cfg.beta2 = .999; cfg.epsilon = 1e-8;
    model.go = std::make_unique<n::Optimizer>(model.g, .0005, cfg);
    model.do_ = std::make_unique<n::Optimizer>(model.d, .0005, cfg);
    auto counters = [&](const std::filesystem::path& file) {
      Save(file, {{"iterations", n::from_vector(std::vector<std::int64_t>{model.go->iterations(), model.do_->iterations()}, {2})}});
    };
    auto all_stores = [&]() {
      A out;
      for (std::size_t i = 0; i < models.size(); ++i)
        for (const auto& [key, value] : Weights(*models[i]))
          out.emplace("scale" + std::to_string(i) + "/" + key, value);
      return out;
    };
    Save(dir / "initial_arrays.npz", Weights(model));
    counters(dir / "probe-initial-counters.npz");
    Save(dir / "probe-setup.npz", {{"previous_reconstruction", prev_rec}, {"amplitude", n::full({1}, amplitudes[k])}});
    A diagnostic;
    for (int epoch = 1; epoch <= 3; ++epoch) {
      for (int step = 0; step < 16; ++step) {
        int global = (epoch - 1) * 16 + step, seed = 7501 + 10000 * k + 307 * global;
        T previous = k ? m::SRBicubic(Draw(models, amplitudes, fixed, k, 1, seed), sizes[k], sizes[k])
                       : Zero(1, 16, 16);
        A batch{{"image", targets[k]}, {"previous", previous},
                {"noise", m::SingleImageNoise(1, sizes[k], sizes[k], k == 0, seed + 211)},
                {"rec_previous", prev_rec}, {"rec_noise", fixed[k]},
                {"amplitude", n::full({1}, amplitudes[k])}};
        Save(dir / ("probe-batch" + std::to_string(global) + "-input.npz"), batch);
        if (!global) {
          diagnostic = batch;
          Save(dir / "probe-first-forward.npz", Forward(model, batch));
          auto out = Forward(model, batch);
          Save(dir / "probe-stale-g-gradient.npz", Partials(model.g, n::grad(out.at("g_loss"), model.g.parameters()), 0));
        }
        for (int group : {1, 0}) {
          auto& store = group ? model.d : model.g;
          auto& opt = group ? model.do_ : model.go;
          A before = Weights(model);
          auto out = Forward(model, batch); // Fresh G capture AFTER the D write, same explicit batch.
          auto gradient = n::grad(out.at(group ? "d_loss" : "g_loss"), store.parameters());
          std::string name = "batch" + std::to_string(global) + (group ? "-d" : "-g");
          Save(dir / "phases" / (name + "-gradient.npz"), Partials(store, gradient, group));
          opt->step(gradient);
          A after = Weights(model);
          for (const auto& [key, value] : before)
            if (key[0] != char('0' + group) && !n::equal_bits(value, after.at(key)))
              throw std::runtime_error("unselected owner changed");
          Save(dir / "phases" / (name + "-after.npz"), all_stores());
          counters(dir / "phases" / (name + "-iterations.npz"));
        }
        steps << k << '\t' << epoch << '\t' << global << '\t' << seed << '\n';
      }
      Save(dir / ("probe-epoch" + std::to_string(epoch) + ".npz"), Weights(model));
      A out;
      { n::NoGradGuard evaluation; out = Forward(model, diagnostic); }
      Save(dir / ("probe-epoch" + std::to_string(epoch) + "-forward.npz"), out);
      history << k << '\t' << epoch;
      for (auto key : {"d_loss", "g_loss", "adversarial_loss", "reconstruction_loss"}) history << '\t' << out.at(key).item();
      history << '\n';
    }
    Save(dir / "final.npz", Weights(model));
    for (int group = 0; group < 2; ++group) {
      auto& store = group ? model.d : model.g;
      auto out = Forward(model, diagnostic);
      Save(dir / ("final_gradients_group" + std::to_string(group) + ".npz"),
           Partials(store, n::grad(out.at(group ? "d_loss" : "g_loss"), store.parameters()), group));
    }
    { n::NoGradGuard evaluation; Save(dir / "outputs.npz", Forward(model, diagnostic)); }
    for (int i = 0; i < k; ++i)
      if (!Equal(lower[i], Weights(*models[i]))) throw std::runtime_error("lower scale changed");
    auto restored = std::make_unique<Scale>();
    A saved;
    for (auto& [key, value] : n::load_npz((dir / "final.npz").string())) saved.emplace(key, value);
    Load(*restored, saved);
    if (!Equal(Weights(model), Weights(*restored))) throw std::runtime_error("checkpoint restore");
    { n::NoGradGuard check;
      auto expected = m::SingleImageGenerate(model.g, diagnostic.at("previous"), diagnostic.at("noise"), diagnostic.at("amplitude")).image;
      auto actual = m::SingleImageGenerate(restored->g, diagnostic.at("previous"), diagnostic.at("noise"), diagnostic.at("amplitude")).image;
      if (!n::equal_bits(expected, actual)) throw std::runtime_error("restored generation"); }
    models.back() = std::move(restored); // Frozen scale retains weights only, no optimizer.
  }
  double seconds = std::chrono::duration<double>(std::chrono::steady_clock::now() - started).count();
  std::vector<A> before;
  for (const auto& s : models) before.push_back(Weights(*s));
  A outputs;
  T samples = Draw(models, amplitudes, fixed, 3, 12, 7901, false, 32, 32, &outputs);
  Save(root / "samples.npz", outputs); outputs.clear();
  T rectangular = Draw(models, amplitudes, fixed, 3, 4, 7919, false, 40, 48, &outputs);
  Save(root / "rectangular.npz", outputs); outputs.clear();
  T reconstruction = Draw(models, amplitudes, fixed, 3, 1, 0, true, 32, 32, &outputs);
  Save(root / "reconstruction.npz", outputs); outputs.clear();
  for (int k = 0; k < 3; ++k) {
    T control = Draw(models, amplitudes, fixed, 3, 12, 7901, false, 32, 32, nullptr, k);
    outputs.emplace("zero_noise_scale" + std::to_string(k), control);
    if (n::max(n::abs(control - samples)).item() <= 1e-7) throw std::runtime_error("inactive noise level");
    if (!Equal(before[k], Weights(*models[k]))) throw std::runtime_error("inference wrote weights");
  }
  Save(root / "noise_controls.npz", outputs);
  n::save_image_grid(samples, (root / "samples.png").string(), 4, -1, 1, 0, 220 / 255., 4);
  n::save_image_grid(rectangular, (root / "rectangular.png").string(), 2, -1, 1, 0, 220 / 255., 3);
  n::save_image_grid(n::concat({image, reconstruction}, 0), (root / "reconstruction.png").string(), 2, -1, 1, 0, 220 / 255., 6);
  T s64 = n::cast(samples, n::DType::Float64);
  double mse = n::mean(n::square(n::cast(reconstruction, n::DType::Float64) - n::cast(image, n::DType::Float64))).item();
  double diversity = n::mean(n::square(s64 - n::mean(s64, {0}, true))).item();
  Save(root / "amplitudes.npz", {{"amplitudes", n::from_vector(amplitudes, {3})}});
  std::ofstream meta(root / "metrics.json"); meta.precision(17);
  meta << "{\"epochs_per_scale\":3,\"scales\":3,\"parameters_per_scale\":668,\"steps_per_group_per_scale\":48,\"total_optimizer_updates\":288,\"amplitudes\":["
       << amplitudes[0] << ',' << amplitudes[1] << ',' << amplitudes[2]
       << "],\"training_image_reconstruction_mse\":" << mse << ",\"sample_pixel_variance\":" << diversity
       << ",\"heldout_accuracy\":false,\"selected_epoch_fixed_final\":3,\"training_seconds\":" << seconds << "}\n";
  if (!meta || !history || !steps) throw std::runtime_error("incomplete records");
  std::print("| Single-image result | Native value |\n|---|---|\n| Reconstruction MSE | {} |\n| Sample pixel variance | {} |\n| Scale amplitudes | {}, {}, {} |\n| Optimizer writes | 288 |\n| Held-out accuracy | Not measured |\n",
             mse, diversity, amplitudes[0], amplitudes[1], amplitudes[2]);
}
```
