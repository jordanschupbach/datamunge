> Trace the actual native generator and patch discriminator

The executed generator trace includes the input mixture and final previous-image
skip. For the single-input plotting interface,105 previous coordinates,105 noise
coordinates and one amplitude are packed into211 supplied coordinates, then
sliced into the separate native arguments. All three actual inputs remain visible. The discriminator trace starts from RGB only. A5x7 rectangle makes the
fully convolutional geometry visible; the real run later draws40x48 images.

```{cpp, results="markdown", file="figures/sig_generator.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
  namespace n=dm::nn;namespace m=n::models;
  n::ParameterStore g(7307);
  auto z=m::SingleImageNoise(1,5,7,true,7411),a=n::ones({1});
  n::Module model([&](const n::Tensor& packed) {
    auto previous=n::reshape(n::slice(packed,{0,0},{1,105}),{1,5,7,3});
    auto noise=n::reshape(n::slice(packed,{0,105},{1,105}),{1,5,7,3});
    auto amplitude=n::reshape(n::slice(packed,{0,210},{1,1}),{1});
    n::model_stage("Supplied previous RGB",packed,previous);
    n::model_stage("Supplied noise RGB",packed,noise);
    n::model_stage("Supplied amplitude",packed,amplitude);
    auto o=m::SingleImageGenerate(g,previous,noise,amplitude);
    n::model_stage("Previous + amplitude noise",std::vector<n::Tensor>{previous,noise,amplitude},o.input);
    n::model_stage("Head3 to4 leaky",o.input,o.head);
    n::model_stage("Body4 to4 leaky",o.head,o.body);
    n::model_stage("Output4 to3 tanh",o.body,o.residual);
    return n::model_stage("Previous + correction",std::vector<n::Tensor>{previous,o.residual},o.image);
  },"One residual scale: signed RGB5x7");
  n::ModelPlotOptions options;options.detail=n::ModelPlotDetail::Blocks;
  options.sizing.minimum_extent=2;options.sizing.max_planes=4;
  auto packed=n::concat({n::zeros({1,105}),n::reshape(z,{1,105}),n::reshape(a,{1,1})},1);
  auto fig=model.plot(packed,options);
  if(fig.parameter_count()!=371 || g.size()!=6) throw std::runtime_error("G census");
  fig.save_svg("build/sig_generator.svg");
}
