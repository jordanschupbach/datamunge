> Read all epoch diagnostics and the fixed noise amplitudes

Every curve evaluates the same first batch of its scale after an epoch. These
are diagnostics on the one training image and fixed random/reconstruction inputs,
not comparable validation trajectories from independent datasets. Each scale
changes target resolution and starts from warm weights with cold moments.
G loss includes10 times reconstruction MSE and the full adversarial term.

```{cpp, results="markdown", file="figures/sig_history.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
  namespace n=dm::nn;
  auto layout=dm::graphics::RLayout::create(1,2);
  auto left=dm::graphics::RPlot::create(),right=dm::graphics::RPlot::create();
  std::vector<dm::graphics::RGB> colours{{37,99,235},{220,38,38},{22,163,74}};
  for(int k=0;k<3;++k){
    std::vector<double> d,g,rec;
    for(int e=1;e<=3;++e){
      std::map<std::string,n::Tensor> a;
      for(auto& [key,value]:n::load_npz("build/singan/scale"+std::to_string(k)+"/probe-epoch"+std::to_string(e)+"-forward.npz"))a.emplace(key,value);
      d.push_back(a.at("d_loss").item());g.push_back(a.at("g_loss").item());rec.push_back(a.at("reconstruction_loss").item());
    }
    left.lines({1,2,3},g,"G scale "+std::to_string(k),colours[k]);
    right.lines({1,2,3},rec,"Scale "+std::to_string(k),colours[k]);
  }
  left.y_limits(0,3.8).x_label("Epoch at this scale").y_label("G: adversarial + 10 MSE").title("First-batch generator diagnostic");
  right.y_limits(.10,.25).x_label("Epoch at this scale").y_label("Signed RGB MSE").title("Fixed-noise reconstruction diagnostic");
  layout.add(left).add(right).size(1100,480).fit_panels().save_svg("build/sig_history.svg");
}
