> Complete experiment: state first, then D, then a fresh G

G owns26416 values in four leaves; D owns25153 values in four leaves; the cache owns849
values in four columns, for52418 checkpoint values. Only51569 values are optimized.
G uses seeds5801, D5807; D's uniform limit is sqrt(6.f/float(in+out)), biases are zero,
and initial state columns are1.f/sqrt(float(length)). Warm-up performs16 iterations before
saving the initial arrays. The pre-first-advance forward is archived; the first D phase uses
the seventeenth power iteration. There is one advance before each of96 D steps, and none
during G fitting, inference or restoration. A state advance does not write weights; D and G
writes do not alter the cache. The code checks the ownership of each first write.

Adam uses learning rate.0002, beta1=.5, beta2=.999 and epsilon1e-8, with separate G/D
states. BatchOrder seed4847 visits all1000 fitting rows once per epoch in batches up to32.
Epoch noise seeds4862/4863/4864, validation4823, test4831 and changed-noise4877 preserve
all source draws. D is written before recomputing G's loss through updated D using the same
cached vectors. The final third epoch is fixed; validation and initial/final test diagnostics
never select weights, settings or epochs. Coarse MMD is explicitly added in evaluation,
outside gradient fitting. Every fitting statement remains editable below.

```{cpp, results="markdown", file="figures/spectral_gan_learning.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <chrono>
#include <cmath>
#include <dm/dm.hpp>
#include <fstream>
#include <iostream>

namespace nn = dm::nn;
namespace m  = nn::models;
using Arrays = std::map<std::string, nn::Tensor>;
using nn::Tensor;

namespace {
void Require(bool condition, const std::string& message) {
  if (!condition)
    throw std::runtime_error(message);
}
void Near(double actual, double expected, double tolerance, const std::string& message) {
  Require(std::abs(actual - expected) <= tolerance, message);
}
void SaveArrays(const std::string& path, const Arrays& a) {
  nn::save_npz(path, nn::NamedTensors(a.begin(), a.end()));
}
bool Equal(const Tensor& a, const Tensor& b) {
  return nn::equal_bits(a, b);
}
bool Equal(const Arrays& a, const Arrays& b) {
  if (a.size() != b.size())
    return false;
  for (const auto& [key, value] : a)
    if (!b.count(key) || !Equal(value, b.at(key)))
      return false;
  return true;
}
Tensor Gaussian(std::int64_t rows, std::int64_t width, std::uint64_t seed) {
  return nn::cast(
      m::GaussianNoise({rows, width}, 1, seed).reshape({rows, width}), nn::DType::Float32);
}
double MaxAbsDiff(const Tensor& a, const Tensor& b) {
  return nn::max(nn::abs(nn::cast(a, nn::DType::Float64) - nn::cast(b, nn::DType::Float64))).item();
}
void Mosaic(const std::filesystem::path& path, const Tensor& images, std::int64_t columns) {
  nn::save_image_grid(
      images.reshape({images.size(0), 28, 28, 1}), path.string(), columns, 0, 1, 4, 220 / 255., 3);
}
Arrays Fields(const m::DenseGanOutput& o) {
  Arrays a{
      {"fake", o.fake},
      {"real_score", o.real_score},
      {"fake_score", o.fake_score},
      {"discriminator_loss", o.discriminator_loss},
      {"generator_loss", o.generator_loss}};
  return a;
}

double Value(const Arrays& a, const std::string& key) {
  return a.at(key).item();
}

/// Hinge algebra at extreme, boundary (+-1) and interior raw scores: finite
/// losses and gradients and a constant nonzero G score gradient.
void Algebra(const std::filesystem::path& root) {
  Tensor real = nn::tensor({-80, -2, 1, 2, 80, .5}, {6, 1}),
         fake = nn::tensor({80, 2, -1, -2, -80, -.5}, {6, 1});
  real.requires_grad_();
  fake.requires_grad_();
  const auto loss = m::HingeGanObjectives(real, fake);
  const auto dg   = nn::grad(loss.discriminator, {real, fake});
  const auto gg   = nn::grad(loss.generator, {fake});
  Arrays     out{
          {"real", real.detach()},
          {"fake", fake.detach()},
          {"discriminator_loss", loss.discriminator.detach()},
          {"generator_loss", loss.generator.detach()},
          {"d_real_gradient", dg[0]},
          {"d_fake_gradient", dg[1]},
          {"g_fake_gradient", gg[0]}};
  for (const auto& [key, value] : out)
    for (double x : value.to_vector<double>())
      Require(std::isfinite(x), "finite " + key);
  Require(gg[0].at({3, 0}) < -.15, "hinge G retains constant nonzero raw score gradient");
  std::cout << "hinge algebra: D loss=" << loss.discriminator.item()
            << ", G loss=" << loss.generator.item() << ", dG/dfake=" << gg[0].values_str() << '\n';
  SaveArrays((root / "hinge_algebra.npz").string(), out);
}

} // namespace
int main() {
  const std::filesystem::path root   = "build/spectral_gan";
  const int                   epochs = 3;
  const auto                  data = std::filesystem::path(dm::datasets::data_home()) / "saliency";
  dm::datasets::prepare_example_data("mnist-assets", data.parent_path());
  const auto pools = m::LoadSaliency(data);
  std::filesystem::create_directories(root);
  Algebra(root);
  const Tensor       validation_z = Gaussian(200, 16, 4823), test_z = Gaussian(200, 16, 4831);
  nn::ParameterStore g(5801), d(5807), state(0);
  std::vector<nn::ParameterStore*> stores{&g, &d, &state};
  {
    nn::NoGradGuard guard;
    m::SpectralGan(g, d, state, nn::zeros({2, 784}), nn::zeros({2, 16}));
  }
  nn::advance_cached_spectral_state(
      d, state, 16); // warm-up is explicit, before the initial snapshot.
  auto snapshot = [&]() {
    Arrays a;
    for (int k = 0; k < 3; ++k)
      for (const auto& key : stores[k]->names())
        a.emplace(std::to_string(k) + "/" + key, stores[k]->at(key).detach().clone());
    return a;
  };
  auto forward = [&](const Tensor& x, const Tensor& z) {
    return Fields(m::SpectralGan(g, d, state, x.reshape({x.size(0), 784}), z));
  };
  auto evaluate = [&](const Tensor& x, const Tensor& z) {
    nn::NoGradGuard guard;
    auto            a = forward(x, z);
    a.emplace(
        "pixel_mmd", m::ImqMmd(m::GanCoarsePixels(x), m::GanCoarsePixels(a.at("fake"))).value);
    return a;
  };
  nn::OptimizerConfig config;
  config.kind    = nn::OptimizerKind::Adam;
  config.beta1   = .5;
  config.beta2   = .999;
  config.epsilon = 1e-8;
  nn::Optimizer               go(g, .0002, config), disc(d, .0002, config);
  std::vector<nn::Optimizer*> optimizers{&go, &disc};
  Require(
      g.count() == 26416 && d.count() == 25153 && g.size() + d.size() == 8 &&
          state.count() == 849 && state.size() == 4,
      "G 26416 + D 25153 = 51569 parameters, 8 tensors");
  SaveArrays((root / "initial_arrays.npz").string(), snapshot());
  SaveArrays((root / "initial_outputs.npz").string(), evaluate(pools[2].images, test_z));
  nn::BatchOrder order(1000, 32, 4847);
  std::ofstream  history(root / "history.tsv"), batches(root / "batches.tsv");
  history.precision(17);
  history << "epoch\tvalidation_discriminator_loss\tvalidation_generator_loss\tvalidation_coarse_"
             "pixel_mmd\n";
  batches << "epoch\tstep\trow\tsource_id\n";
  const auto source  = nn::cast(pools[0].source, nn::DType::Int64).to_vector<std::int64_t>();
  int        steps   = 0;
  const auto started = std::chrono::steady_clock::now();
  for (int epoch = 1; epoch <= epochs; ++epoch) {
    const Tensor noise = Gaussian(1000, 16, 4861 + epoch);
    order.begin_epoch();
    int seen = 0;
    for (;;) {
      const auto rows = order.next();
      if (rows.empty())
        break;
      const Tensor x = nn::take_rows(pools[0].images, rows), z = nn::take_rows(noise, rows);
      if (!steps)
        SaveArrays((root / "first_forward.npz").string(), evaluate(x, z));
      {
        const auto before = steps ? Arrays{} : snapshot();
        nn::advance_cached_spectral_state(d, state); // state only, once BEFORE D.
        if (!steps) {
          const auto after   = snapshot();
          bool       changed = false;
          for (const auto& [key, value] : before) {
            if (key.rfind("2/", 0) == 0)
              changed |= !Equal(value, after.at(key));
            else
              Require(Equal(value, after.at(key)), "power iteration leaves G/D unchanged");
          }
          Require(changed, "power iteration changes state");
        }
      }
      for (int group : {1, 0}) {
        const auto before = steps ? Arrays{} : snapshot();
        // D first; recompute a fresh forward through the updated D for G.
        const auto fields = forward(x, z);
        const auto loss   = fields.at(group == 1 ? "discriminator_loss" : "generator_loss");
        optimizers[group]->step(nn::grad(loss, stores[group]->parameters()));
        if (!steps) {
          const auto after   = snapshot();
          bool       changed = false;
          for (const auto& [key, value] : before) {
            if (key.rfind(std::to_string(group) + "/", 0) == 0)
              changed |= !nn::equal_bits(value, after.at(key));
            else
              Require(nn::equal_bits(value, after.at(key)), "unselected group unchanged");
          }
          Require(changed, "selected group changed");
        }
      }
      for (auto row : rows)
        batches << epoch << '\t' << steps << '\t' << row << '\t' << source[row] << '\n';
      ++steps;
      seen += int(rows.size());
    }
    Require(seen == 1000, "all fitting MNIST examples ONCE per epoch");
    const auto v = evaluate(pools[1].images, validation_z);
    history << epoch << '\t' << Value(v, "discriminator_loss") << '\t' << Value(v, "generator_loss")
            << '\t' << Value(v, "pixel_mmd") << '\n';
    std::cout << "epoch " << epoch << ": diagnostic D loss=" << Value(v, "discriminator_loss")
              << ", G loss=" << Value(v, "generator_loss")
              << ", coarse MMD=" << Value(v, "pixel_mmd") << std::endl;
  }
  const double seconds =
      std::chrono::duration<double>(std::chrono::steady_clock::now() - started).count();

  const auto checkpoint = (root / "final.npz").string();
  Require(steps == 96 && go.iterations() == 96 && disc.iterations() == 96, "96 D and 96 G writes");
  SaveArrays(checkpoint, snapshot());
  nn::ParameterStore restored_g(1), restored_d(2), restored_state(3);
  {
    nn::NoGradGuard guard;
    m::SpectralGan(restored_g, restored_d, restored_state, nn::zeros({2, 784}), nn::zeros({2, 16}));
  }
  for (const auto& [key, value] : nn::load_npz(checkpoint))
    (key[0] == '0'   ? restored_g
     : key[0] == '1' ? restored_d
                     : restored_state)
        .set(key.substr(2), value);
  auto restored_arrays = [&]() {
    Arrays a;
    for (int k = 0; k < 3; ++k) {
      auto& store = k == 0 ? restored_g : k == 1 ? restored_d : restored_state;
      for (const auto& key : store.names())
        a.emplace(std::to_string(k) + "/" + key, store.at(key).detach().clone());
    }
    return a;
  };
  auto sample = [&](const Tensor& z) {
    nn::NoGradGuard guard;
    return m::MlpGanGenerate(restored_g, z);
  };
  auto restored_evaluate = [&](const Tensor& x, const Tensor& z) {
    nn::NoGradGuard guard;
    auto            a = Fields(
        m::SpectralGan(restored_g, restored_d, restored_state, x.reshape({x.size(0), 784}), z));
    a.emplace(
        "pixel_mmd", m::ImqMmd(m::GanCoarsePixels(x), m::GanCoarsePixels(a.at("fake"))).value);
    return a;
  };
  Require(Equal(snapshot(), restored_arrays()), "all final G/D weights restore BIT EXACT");
  const auto   before = restored_arrays();
  const auto   output = restored_evaluate(pools[2].images, test_z);
  const Tensor repeat = sample(test_z);
  Require(
      Equal(output.at("fake"), repeat), "noise-only generation BIT EXACT matches GAN evaluation");
  const double parity = MaxAbsDiff(sample(nn::take_rows(test_z, {0})), nn::take_rows(repeat, {0}));
  Require(parity < 2e-6, "G single/batch parity");
  const Tensor changed_z = Gaussian(200, 16, 4877), changed_images = sample(changed_z);
  Require(!Equal(changed_images, repeat), "different noise affects G images");
  const Tensor zero_images = sample(nn::zeros({200, 16}));
  Require(!Equal(zero_images, repeat), "G not constant zero-latent mapping");
  SaveArrays(
      (root / "controls.npz").string(),
      {{"changed_z", changed_z},
       {"changed_images", changed_images},
       {"zero_z", nn::zeros({200, 16})},
       {"zero_images", zero_images}});
  Require(Equal(before, restored_arrays()), "all G/D diagnostic generation immutable");
  SaveArrays((root / "outputs.npz").string(), output);

  const Tensor fit_mean =
      nn::tile(nn::mean(pools[0].images.reshape({1000, 784}), {0}, true), {200, 1});
  const double mean_mmd =
      m::ImqMmd(m::GanCoarsePixels(pools[2].images), m::GanCoarsePixels(fit_mean)).value.item();
  double     real_accuracy = 0, fake_accuracy = 0;
  const auto real_score = output.at("real_score").to_vector<float>(),
             fake_score = output.at("fake_score").to_vector<float>();
  for (int b = 0; b < 200; ++b)
    real_accuracy += real_score[b] >= 0, fake_accuracy += fake_score[b] < 0;
  const auto   pixel_mean = nn::mean(nn::cast(repeat, nn::DType::Float64), {0}, true);
  const double mean_pixel = nn::mean(pixel_mean).item(),
               pixel_variance =
                   nn::mean(nn::square(nn::cast(repeat, nn::DType::Float64) - pixel_mean)).item();
  Mosaic(root / "generated.png", nn::slice_axis(repeat, 0, 0, 40), 8);
  Mosaic(root / "fit_mean.png", nn::slice_axis(fit_mean, 0, 0, 8), 8);
  // Exact spectral norms of the effective (normalized) kernels: finite power
  // iteration does not guarantee 1, so they are reported, not certified.
  double sn[2];
  for (int k = 0; k < 2; ++k) {
    const std::string name  = k ? "output" : "hidden";
    auto&             d     = restored_d;
    auto&             st    = restored_state;
    const Tensor      w     = nn::cast(d.at(name + "/W"), nn::DType::Float64);
    const Tensor      sigma = nn::sum(
        nn::cast(st.at(name + "/v"), nn::DType::Float64) *
        nn::matmul(w, nn::cast(st.at(name + "/u"), nn::DType::Float64)));
    sn[k] = nn::svd(w / std::max(sigma.item(), 1e-6)).s.at({0});
  }
  std::cout << "effective kernel spectral norms (exact SVD): hidden=" << sn[0]
            << ", output=" << sn[1] << '\n';
  std::ofstream meta(root / "metrics.json");
  meta.precision(17);
  meta << "{\"generator_parameters\":26416,\"discriminator_parameters\":25153,\"epochs\":" << epochs
       << ",\"steps_per_group\":" << steps << ",\"optimizer_updates\":" << 2 * steps
       << ",\"selected_epoch_fixed_final\":" << epochs
       << ",\"test_discriminator_loss\":" << Value(output, "discriminator_loss")
       << ",\"test_generator_loss\":" << Value(output, "generator_loss")
       << ",\"test_coarse_pixel_mmd\":" << Value(output, "pixel_mmd")
       << ",\"fit_mean_coarse_pixel_mmd\":" << mean_mmd
       << ",\"test_discriminator_real_accuracy\":" << real_accuracy / 200
       << ",\"test_discriminator_fake_accuracy\":" << fake_accuracy / 200
       << ",\"generated_mean_pixel\":" << mean_pixel
       << ",\"generated_mean_per_pixel_variance\":" << pixel_variance
       << ",\"single_batch_max_error\":" << parity
       << ",\"effective_spectral_norm_hidden\":" << sn[0]
       << ",\"effective_spectral_norm_output\":" << sn[1] << ",\"training_seconds\":" << seconds
       << "}\n";
  Require(bool(meta) && bool(history) && bool(batches), "complete GAN artifacts");
  history.close();
  batches.close();
  meta.close();
  std::cout << "fixed FINAL epoch " << epochs
            << ", test D/G=" << Value(output, "discriminator_loss") << "/"
            << Value(output, "generator_loss") << ", coarse MMD=" << Value(output, "pixel_mmd")
            << ", mean baseline=" << mean_mmd
            << ", D real/fake accuracy (threshold 0)=" << real_accuracy / 200 << "/"
            << fake_accuracy / 200 << ", mean pixel=" << mean_pixel
            << ", pixel variance=" << pixel_variance
            << "; D then G/restore/noiseOnly/immutable PASS (training " << seconds
            << " s)\nArtifacts: " << root.string() << "\nAll spectral_gan checks passed.\n";
  std::ifstream input(root / "history.tsv");
  std::string   header;
  std::getline(input, header);
  std::vector<double> axis, dl, gl;
  double              epoch, a, b, mmd;
  while (input >> epoch >> a >> b >> mmd) {
    axis.push_back(epoch);
    dl.push_back(a);
    gl.push_back(b);
  }
  const double low = std::min(
      {0., *std::min_element(dl.begin(), dl.end()), *std::min_element(gl.begin(), gl.end())});
  const double high =
      std::max(*std::max_element(dl.begin(), dl.end()), *std::max_element(gl.begin(), gl.end()));
  auto p = dm::graphics::RPlot::create();
  p.y_limits(low - .05 * (high - low), high + .4 * (high - low))
      .lines(axis, dl, "Validation D", {37, 99, 235}, 2.)
      .points(axis, dl, "", {37, 99, 235}, 4.)
      .lines(axis, gl, "Validation G", {220, 38, 38}, 2.)
      .points(axis, gl, "", {220, 38, 38}, 4.)
      .x_label("Completed epoch; fixed final3")
      .y_label("Separate game objectives")
      .title("Validation logs do not select the checkpoint")
      .save_svg("build/spectral_gan_learning.svg");
}
```
