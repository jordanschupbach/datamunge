\caption(The executed SRGAN trace has1591 learned values in25 leaves. Saved BN values are excluded from learned counts; the SRGAN trace reads its40 initialized values without writing them.)
\alttext(An executed LR-to-HR generator trace keeps its image-level bicubic skip, native feature upsampling and small residual output convolution.)

```{cpp, results="markdown", file="figures/asr_esrgan_architecture.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
  namespace n = dm::nn;
  namespace m = n::models;
  n::ParameterStore g(7001), stats(0);
  n::Module         model(
      [&](const n::Tensor& lr) {
        auto bic = m::SRBicubic(lr, 32, 32);
        n::model_stage("Bicubic image shortcut", lr, bic);
        auto o = m::AdversarialSRGenerate(g, stats, lr, bic, true, false);
        n::model_stage("Head3 to4", lr, o.head);
        n::model_stage("Three dense blocks and global skip", o.head, o.body);
        n::model_stage("Nearest2 + up conv/leaky", o.body, o.upsampled);
        n::model_stage("HR conv/leaky", o.upsampled, o.packed);
        n::model_stage("Small output conv4 to3", o.packed, o.residual);
        return n::model_stage(
            "Bicubic + image residual", std::vector<n::Tensor>{bic, o.residual}, o.image);
      },
      "ESRGAN: unbounded residual over bicubic");
  n::ModelPlotOptions options;
  options.style                 = n::ModelPlotStyle::Flow;
  options.detail                = n::ModelPlotDetail::Blocks;
  options.sizing.minimum_extent = 2;
  options.sizing.max_planes     = 4;
  auto figure                   = model.plot(n::ones({1, 16, 16, 3}), options);
  if (figure.parameter_count() != 3511 || g.size() != 40 || stats.count() != 0)
    throw std::runtime_error("executed native G census");
  figure.save_svg("build/asr_esrgan_architecture.svg");
}
```
