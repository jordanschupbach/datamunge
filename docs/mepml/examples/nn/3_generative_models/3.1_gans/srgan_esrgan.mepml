```{cpp, results="markdown", file="figures/asr_pairs.png", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
namespace n = dm::nn;
namespace m = n::models;
using A     = std::map<std::string, n::Tensor>;
A Read(const std::string& path) {
  A a;
  for (const auto& [key, value] : n::load_npz(path))
    a.emplace(key, value);
  return a;
}
int main() {
  auto                   a = Read("build/srgan_esrgan/data.npz");
  std::vector<n::Tensor> images;
  for (int i = 0; i < 16; ++i) {
    images.push_back(n::take_rows(a.at("fit_bicubic"), {i}));
    images.push_back(n::take_rows(a.at("fit_hr"), {i}));
  }
  n::save_image_grid(n::concat(images, 0), "build/asr_pairs.png", 8, 0, 1, 4, 220 / 255., 3);
}
