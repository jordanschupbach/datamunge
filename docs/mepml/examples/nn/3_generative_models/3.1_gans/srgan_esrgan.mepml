\image(figures/asr_critic_architecture.svg)
// result_end
\caption(The executed relative critic has1672 unique learned values. The ordinary source variant adds its single score bias and uses the native Glorot dense path.)
\alttext(An executed RGB critic downsamples32→16→8, pools spatially and applies a bias-free raw score head.)

> Run the complete native warm-up, reset and adversarial schedule

CIFAR-10 rows0..127 of data_batch_1.bin fit the models; rows128..159 validate;
test_batch.bin rows64..95 provide the32 test cases, with source IDs50064..50095.
The native CIFAR fetch/reader and native style preparation supply original data
and the complete official VGG archive. Existing prepared caches are reused;
missing style features invoke prepare_example_data("style"). No Python data
preparation, other checkout or recorded-feature fallback is required.

Native antialiased Keys bicubic(a=-.5,half-pixel,symmetric duplicated edges)
forms32→16 LR and16→32 shortcut images. Column and row passes each sum in
Double and cast to Float32; overshoot is preserved. Both trials initialize fresh
G7001/D7013/stats0 and batch order7103. Every epoch has16 batches of8, visiting
all128 fitting rows. Epoch1 steps G pixel loss only, leaving D completely frozen.
Before epoch2, BOTH Adam states reset without changing weights or BN statistics.
Epochs2/3 step D then fresh G on each batch. Adam is(.0001,.9,.999,1e-8).
Each variant therefore has48 cumulative G writes and32 D writes, but final
optimizer counters32/32. BN commits occur after each SRGAN G write using its
same pre-write moments, including warm-up. There is no generator weight EMA.

GAN G is content+.001*adversarial for SRGAN; ESRGAN uses content+.005*adversarial
+.01*pixel L1, preserving source Float32-rounded coefficients. Warm-up G is pixel
MSE/L1. Every component still evaluates in both phases. Each forward exposes
saved-statistic inference AND batch-statistic training G; objectives use the
training image even in read-only validation. The target extracted feature is
stopped; its HR pixel/real-critic paths stay live. Validation is recorded every
epoch, but selection stays fixed at epoch3. Deployment uses the saved-statistic
prediction, which is LR-only and immutable. The HR-target canary must leave BOTH
G paths bit exact.

The complete editable program below owns every capture/write/reset/BN commit.
It saves all original outputs and all515 source phase/probe captures, checks
frozen features and unselected owners, restores independent stores and preserves
the original RGB preview. Its extra per-image metric arrays use the same native
metric policy as the source; no model selection is based on test results.

```{cpp, results="markdown", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <chrono>
#include <dm/dm.hpp>
#include <fstream>
#include <iostream>
namespace nn   = dm::nn;
namespace m    = nn::models;
namespace sr   = m;
namespace data = nn::data;
using nn::Tensor;
using Arrays = std::map<std::string, Tensor>;
const std::vector<std::string> BNNames{
    "residual0/bn1",
    "residual0/bn2",
    "residual1/bn1",
    "residual1/bn2",
    "body_bn"};
void Require(bool ok, const std::string& why) {
  if (!ok)
    throw std::runtime_error(why);
}
void Near(double a, double b, double tolerance, const std::string& why) {
  Require(std::abs(a - b) <= tolerance, why);
}
void RequireFinite(const Arrays& a, const std::string& why) {
  for (const auto& [key, value] : a)
    Require(nn::all(nn::is_finite(value)).item<bool>(), why + " " + key);
}
void SaveArrays(const std::string& path, const Arrays& a) {
  nn::save_npz(path, nn::NamedTensors(a.begin(), a.end()));
}
bool BitEqual(const Tensor& a, const Tensor& b) {
  return nn::equal_bits(a, b);
}
bool BitEqual(const Arrays& a, const Arrays& b) {
  if (a.size() != b.size())
    return false;
  for (const auto& [k, v] : a)
    if (!b.count(k) || !BitEqual(v, b.at(k)))
      return false;
  return true;
}
double MaxAbsDiff(const Tensor& a, const Tensor& b) {
  return nn::max(nn::abs(nn::cast(a, nn::DType::Float64) - nn::cast(b, nn::DType::Float64))).item();
}
void AppendMoments(Arrays& out, const Tensor& means, const Tensor& vars) {
  if (means.defined())
    for (int i = 0; i < 5; ++i) {
      out.emplace("moment/" + BNNames[i] + "/mean", nn::select(means, 0, i));
      out.emplace("moment/" + BNNames[i] + "/unbiased_var", nn::select(vars, 0, i));
    }
}
Arrays Fields(const m::AdversarialSROutput& o, bool debug) {
  Arrays all{
      {"prediction", o.prediction},
      {"prediction_training", o.prediction_training},
      {"residual", o.residual},
      {"real_score", o.real_score},
      {"fake_score", o.fake_score},
      {"fake_inference_score", o.fake_inference_score},
      {"d_loss", o.d_loss},
      {"g_loss", o.g_loss},
      {"gan_loss", o.gan_loss},
      {"pixel_loss", o.pixel_loss},
      {"content_loss", o.content_loss},
      {"adversarial_loss", o.adversarial_loss},
      {"relative_real", o.relative_real},
      {"relative_fake", o.relative_fake},
      {"prediction_feature", o.prediction_feature},
      {"target_feature", o.target_feature},
      {"packed", o.packed},
      {"shuffled", o.shuffled}};
  AppendMoments(all, o.moments_mean, o.moments_unbiased_variance);
  Arrays out;
  for (const auto& [k, v] : all)
    if (debug || !(k.starts_with("moment/") || k == "prediction_feature" || k == "target_feature" ||
                   k == "packed" || k == "shuffled"))
      out.emplace(k, v);
  return out;
}
void Initialize(
    nn::ParameterStore& g,
    nn::ParameterStore& d,
    nn::ParameterStore& s,
    const Tensor&       w,
    const Tensor&       b,
    bool                enhanced) {
  nn::NoGradGuard guard;
  auto            lr = nn::zeros({2, 16, 16, 3}), hr = nn::zeros({2, 32, 32, 3});
  m::AdversarialSR(g, d, s, lr, hr, hr, w, b, enhanced, false);
}
Arrays Snapshot(const std::vector<nn::ParameterStore*>& p) {
  Arrays out;
  for (int k = 0; k < 3; ++k)
    for (const auto& name : p[k]->names())
      out.emplace(std::to_string(k) + "/" + name, p[k]->at(name).detach().clone());
  return out;
}
void Restore(const std::vector<nn::ParameterStore*>& p, const std::string& file) {
  auto        a     = nn::load_npz(file);
  std::size_t count = 0;
  for (auto* owner : p)
    count += owner->size();
  Require(a.size() == count, "complete learned and BN checkpoint");
  for (const auto& [key, v] : a) {
    Require(
        key.size() > 2 && key[0] >= '0' && key[0] <= '2' && key[1] == '/',
        "known source checkpoint owner");
    auto& owner = *p[key[0] - '0'];
    Require(
        owner.contains(key.substr(2)) && owner.at(key.substr(2)).shape() == v.shape(),
        "known matching source checkpoint leaf");
    owner.set(key.substr(2), v);
  }
}
namespace {

double Value(const Arrays& a, const std::string& key) {
  return a.at(key).item();
}

/// Unequal-batch RaGAN fixture: closed-form partials and common logit-shift invariance.
void RaAlgebra(const std::filesystem::path& root) {
  Tensor real = nn::tensor({-2, 0, 3}, {3, 1}), fake = nn::tensor({-1, 2}, {2, 1});
  real.requires_grad_();
  fake.requires_grad_();
  const auto      loss = m::RelativisticAverageGan(real, fake);
  nn::GradOptions o;
  o.retain_graph     = true;
  const auto dg      = nn::grad(loss.discriminator, {real, fake}, o);
  const auto gg      = nn::grad(loss.generator, {real, fake}, o);
  const auto shifted = m::RelativisticAverageGan(real.detach() + 5.0, fake.detach() + 5.0);
  Near(
      loss.discriminator.item(),
      shifted.discriminator.item(),
      3e-7,
      "Ra D common logit shift invariance");
  Near(loss.generator.item(), shifted.generator.item(), 3e-7, "Ra G common logit shift invariance");
  SaveArrays(
      (root / "relativistic_algebra.npz").string(),
      {{"real", real.detach()},
       {"fake", fake.detach()},
       {"d_loss", loss.discriminator.detach()},
       {"g_loss", loss.generator.detach()},
       {"relative_real", loss.real_relative.detach()},
       {"relative_fake", loss.fake_relative.detach()},
       {"d_real_gradient", dg[0]},
       {"d_fake_gradient", dg[1]},
       {"g_real_gradient", gg[0]},
       {"g_fake_gradient", gg[1]}});
  std::cout << "RaGAN algebra: D=" << loss.discriminator.item() << ", G=" << loss.generator.item()
            << ", dG/dreal=" << gg[0].values_str() << '\n';
}

/// 8 test crops (20x20 centre at 4x): bicubic | prediction | HR | 8 |Y error| (red).
void Preview(const sr::SRData& data, const Tensor& prediction, const std::filesystem::path& path) {
  auto       crop = [](const Tensor& x) { return sr::SRCrop(nn::slice_axis(x, 0, 0, 8), 6); };
  const auto p = crop(prediction), truth = crop(data.hr), bic = crop(data.bicubic);
  const auto error = 8. * nn::abs(sr::SRLumaTensor(p) - sr::SRLumaTensor(truth));
  auto       zero  = nn::zeros_like(error);
  auto       tiles = nn::concat(
      {nn::cast(bic, nn::DType::Float64),
             nn::cast(p, nn::DType::Float64),
             nn::cast(truth, nn::DType::Float64),
             nn::concat({error, zero, zero}, 3)},
      2);
  auto bytes = nn::cast(nn::floor(255. * nn::clip(tiles, 0., 1.) + .5), nn::DType::Float32);
  auto image = nn::reshape(bytes, {1, 160, 80, 3});
  image      = nn::squeeze(nn::resize_nearest(image, {640, 320}), {0});
  nn::save_png(image, path.string(), 0, 255);
}

void Train(
    const std::filesystem::path&   root,
    const std::vector<sr::SRData>& pools,
    const Arrays&                  features,
    int                            epochs,
    bool                           enhanced,
    const std::string&             init) {
  const auto  dir   = root / (enhanced ? "esrgan" : "srgan");
  const char* label = enhanced ? "ESRGAN" : "SRGAN";
  std::filesystem::create_directories(dir);
  const auto probe_root = root / (enhanced ? "esrgan" : "srgan");
  std::filesystem::create_directories(probe_root / "phases");
  nn::ParameterStore               g(7001), d(7013), stats(0);
  std::vector<nn::ParameterStore*> stores{&g, &d, &stats};
  const auto                       vgg_w = features.at("block1_conv1_W").detach().clone(),
             vgg_b                       = features.at("block1_conv1_b").detach().clone();
  Initialize(g, d, stats, vgg_w, vgg_b, enhanced);
  std::vector<std::unique_ptr<nn::Optimizer>> optimizers(2);
  nn::OptimizerConfig                         config;
  config.kind           = nn::OptimizerKind::Adam;
  config.beta1          = .9;
  config.beta2          = .999;
  config.epsilon        = 1e-8;
  auto reset_optimizers = [&]() {
    for (int k = 0; k < 2; ++k)
      optimizers[k] = std::make_unique<nn::Optimizer>(*stores[k], .0001, config);
  };
  reset_optimizers();
  auto forward = [&](const Tensor& x, const Tensor& hr, const Tensor& bic, bool phase) {
    return m::AdversarialSR(g, d, stats, x, hr, bic, vgg_w, vgg_b, enhanced, phase);
  };
  auto evaluate = [&](const Tensor& x, const Tensor& hr, bool phase, bool debug = false) {
    nn::NoGradGuard guard;
    return Fields(forward(x, hr, sr::SRBicubic(x, 32, 32), phase), debug);
  };
  auto capture = [&](int group, const Tensor& x, const Tensor& hr, bool phase) {
    // This fresh forward ensures a GAN G capture observes the just-updated critic.
    auto            o = forward(x, hr, sr::SRBicubic(x, 32, 32), phase);
    nn::GradOptions options;
    options.allow_unused = true;
    auto   partial = nn::grad(group ? o.d_loss : o.g_loss, stores[group]->parameters(), options);
    Arrays out;
    for (std::size_t i = 0; i < partial.size(); ++i) {
      auto name = stores[group]->names()[i];
      out.emplace(
          std::to_string(group) + "/" + name,
          partial[i].defined()
              ? partial[i]
              : nn::zeros(stores[group]->at(name).shape(), stores[group]->dtype()));
    }
    if (group == 0)
      AppendMoments(out, o.moments_mean, o.moments_unbiased_variance);
    return out;
  };
  auto apply = [&](int group, const Arrays& captured) {
    std::vector<Tensor> ordered;
    for (const auto& name : stores[group]->names())
      ordered.push_back(captured.at(std::to_string(group) + "/" + name));
    optimizers[group]->step(ordered); // Weight write FIRST, using the selected capture.
    if (group == 0 && !enhanced) {
      nn::NoGradGuard guard;
      for (const auto& name : BNNames) {
        auto next = nn::batch_norm_moving_values(
            stats.at(name + "/moving_mean"),
            stats.at(name + "/moving_var"),
            captured.at("moment/" + name + "/mean"),
            captured.at("moment/" + name + "/unbiased_var"));
        stats.set(name + "/moving_mean", next.mean);
        stats.set(name + "/moving_var", next.variance);
      }
    } // Same pre-weight-write moments, never a post-write recomputation.
  };
  auto check_frozen = [&]() {
    Require(
        BitEqual(vgg_w, features.at("block1_conv1_W")) &&
            BitEqual(vgg_b, features.at("block1_conv1_b")),
        "all1792 official feature values stay exact");
  };
  auto counters = [&](const std::string& file) {
    SaveArrays(
        file,
        {{"iterations",
          nn::tensor(
              {double(optimizers[0]->iterations()), double(optimizers[1]->iterations())},
              {2},
              nn::DType::Int64)}});
  };

  if (!init.empty())
    Restore(
        stores,
        (std::filesystem::path(init) / (enhanced ? "esrgan" : "srgan") / "initial_arrays.npz")
            .string());
  Require(
      g.count() == (enhanced ? 3511 : 1591) && d.count() == (enhanced ? 1672 : 1673) &&
          stats.count() == (enhanced ? 0 : 40),
      "compact SRGAN/ESRGAN parameter census");
  const auto initial = Snapshot(stores);
  SaveArrays((dir / "initial_arrays.npz").string(), initial);
  SaveArrays((dir / "initial_outputs.npz").string(), evaluate(pools[2].lr, pools[2].hr, false));
  check_frozen();
  nn::BatchOrder order(128, 8, 7103);
  int            gsteps = 0, dsteps = 0;
  std::ofstream  history(dir / "history.tsv"), batches(dir / "batches.tsv");
  history.precision(17);
  history << "epoch\tadversarial_phase\tg_loss\tgan_loss\tpixel_loss\tcontent_loss\tadversarial_"
             "loss\td_loss\n";
  batches << "epoch\tstep\trow\n";
  Tensor     first_lr, first_hr;
  const auto started = std::chrono::steady_clock::now();
  for (int epoch = 1; epoch <= epochs; ++epoch) {
    const bool gan = epoch >= 2;
    if (epoch == 2) {
      const auto before = Snapshot(stores);
      counters((probe_root / "probe-reset-before.npz").string());
      reset_optimizers();
      counters((probe_root / "probe-reset-after.npz").string());
      SaveArrays((probe_root / "probe-reset-weights.npz").string(), Snapshot(stores));
      Require(
          BitEqual(before, Snapshot(stores)),
          "warmup-to-GAN optimizer RESET never changes weights/BN");
    }
    order.begin_epoch();
    int epoch_step = 0;
    for (;;) {
      const auto rows = order.next();
      if (rows.empty())
        break;
      const Tensor x = sr::SRBatch(pools[0].lr, rows), y = sr::SRBatch(pools[0].hr, rows);
      if (epoch_step == 0 && (epoch == 1 || epoch == 2)) {
        const auto name = epoch == 1 ? "warm" : "gan";
        SaveArrays(
            (probe_root / (std::string("probe-") + name + "-input.npz")).string(),
            {{"lr", x}, {"hr", y}});
        SaveArrays(
            (probe_root / (std::string("probe-") + name + "-forward.npz")).string(),
            evaluate(x, y, gan, true));
        if (epoch == 2)
          SaveArrays((probe_root / "probe-stale-gan-g.npz").string(), capture(0, x, y, true));
      }
      if (gan && epoch_step == 0 && epoch == 2)
        first_lr = x, first_hr = y;
      for (int group : gan ? std::vector<int>{1, 0} : std::vector<int>{0}) {
        const auto captured = capture(group, x, y, gan);
        const auto before   = Snapshot(stores);
        const auto name = "epoch" + std::to_string(epoch) + "-batch" + std::to_string(epoch_step) +
                          (group ? "-d" : "-g");
        SaveArrays((probe_root / "phases" / (name + "-gradient.npz")).string(), captured);
        apply(group, captured);
        SaveArrays((probe_root / "phases" / (name + "-after.npz")).string(), Snapshot(stores));
        counters((probe_root / "phases" / (name + "-iterations.npz")).string());
        if (!enhanced && epoch == 1 && epoch_step == 0) {
          nn::NoGradGuard guard;
          auto            recomputed = Fields(forward(x, y, sr::SRBicubic(x, 32, 32), gan), true);
          Arrays          moments;
          for (const auto& [key, value] : recomputed)
            if (key.starts_with("moment/"))
              moments.emplace(key, value);
          SaveArrays((probe_root / "probe-poststep-recomputed-moments.npz").string(), moments);
        }
        const auto after = Snapshot(stores);
        for (const auto& [key, value] : before) {
          const int owner = key[0] - '0';
          if (owner != group && !(group == 0 && owner == 2))
            Require(
                BitEqual(value, after.at(key)),
                "SR phase isolation / frozen D during warmup / G during D");
        }
        (group ? dsteps : gsteps)++;
      }
      for (auto row : rows)
        batches << epoch << '\t' << gsteps - 1 << '\t' << row << '\n';
      ++epoch_step;
    }
    Require(epoch_step == 16, "16 cheap fit batches / epoch");
    if (!gan) {
      const auto after = Snapshot(stores);
      for (const auto& [key, value] : initial)
        if (key[0] == '1')
          Require(
              BitEqual(value, after.at(key)),
              "critic COMPLETELY untrained during reconstruction warmup");
    }
    check_frozen();
    SaveArrays(
        (probe_root / ("probe-epoch" + std::to_string(epoch) + ".npz")).string(), Snapshot(stores));
    SaveArrays(
        (probe_root / ("probe-epoch" + std::to_string(epoch) + "-test.npz")).string(),
        evaluate(pools[2].lr, pools[2].hr, gan));
    const auto v = evaluate(pools[1].lr, pools[1].hr, gan);
    SaveArrays(
        (probe_root / ("probe-epoch" + std::to_string(epoch) + "-validation.npz")).string(), v);
    history << epoch << '\t' << gan;
    for (auto key :
         {"g_loss", "gan_loss", "pixel_loss", "content_loss", "adversarial_loss", "d_loss"})
      history << '\t' << Value(v, key);
    history << '\n';
    std::cout << label << " epoch " << epoch << ": " << (gan ? "GAN" : "reconstruction-warmup")
              << ", pixel/content/adv=" << Value(v, "pixel_loss") << '/' << Value(v, "content_loss")
              << '/' << Value(v, "adversarial_loss") << std::endl;
  }
  const double seconds =
      std::chrono::duration<double>(std::chrono::steady_clock::now() - started).count();
  const auto checkpoint = (dir / "final.npz").string();
  SaveArrays(checkpoint, Snapshot(stores));
  SaveArrays((dir / "final_first_forward.npz").string(), evaluate(first_lr, first_hr, true));
  for (int group = 0; group < 2; ++group)
    SaveArrays(
        (dir / ("final_gradients_group" + std::to_string(group) + ".npz")).string(),
        capture(group, first_lr, first_hr, true));
  nn::ParameterStore restored_g(1), restored_d(2), restored_stats(3);
  Initialize(restored_g, restored_d, restored_stats, vgg_w, vgg_b, enhanced);
  std::vector<nn::ParameterStore*> restored{&restored_g, &restored_d, &restored_stats};
  Restore(restored, checkpoint);
  nn::NoGradGuard inference_guard;
  auto            deployed_evaluate = [&](const Tensor& x, const Tensor& hr, bool phase) {
    return Fields(
        m::AdversarialSR(
            restored_g,
            restored_d,
            restored_stats,
            x,
            hr,
            sr::SRBicubic(x, 32, 32),
            vgg_w,
            vgg_b,
            enhanced,
            phase),
        false);
  };
  auto predict = [&](const Tensor& x) {
    return m::AdversarialSRGenerate(
               restored_g, restored_stats, x, sr::SRBicubic(x, 32, 32), enhanced)
        .image;
  };
  Require(BitEqual(Snapshot(stores), Snapshot(restored)), "all SR weights + BN restore BIT EXACT");
  const auto   before     = Snapshot(restored);
  const auto   output     = deployed_evaluate(pools[2].lr, pools[2].hr, true);
  const Tensor prediction = predict(pools[2].lr);
  Require(
      BitEqual(prediction, output.at("prediction")), "LR ONLY prediction without HR/phase exact");
  const double parity =
      MaxAbsDiff(predict(sr::SRBatch(pools[2].lr, {0})), sr::SRBatch(prediction, {0}));
  Require(parity < 3e-6, "LR single/batch parity within FP32");
  const auto canary = deployed_evaluate(pools[2].lr, nn::zeros(pools[2].hr.shape()), true);
  Require(
      BitEqual(canary.at("prediction"), prediction) &&
          BitEqual(canary.at("prediction_training"), output.at("prediction_training")),
      "changing ALL HR targets leaves BOTH G paths BIT EXACT");
  SaveArrays(
      (dir / "target_canary.npz").string(),
      {{"prediction", canary.at("prediction")},
       {"prediction_training", canary.at("prediction_training")},
       {"content_loss", canary.at("content_loss")},
       {"pixel_loss", canary.at("pixel_loss")}});
  check_frozen();
  Require(
      BitEqual(before, Snapshot(restored)),
      "immutable LR inference/evaluation/FROZEN pretrained features");
  SaveArrays((dir / "outputs.npz").string(), output);
  const auto score = sr::SRScore(prediction, pools[2]);
  Preview(pools[2], prediction, dir / "comparison.png");
  auto metric_images = sr::SRScoreImages(prediction, pools[2]);
  auto per_mse       = nn::mean(nn::square(metric_images[0] - metric_images[1]), {1, 2, 3}),
       base_mse      = nn::mean(nn::square(metric_images[2] - metric_images[1]), {1, 2, 3});
  SaveArrays(
      (dir / "probe-per-image-metrics.npz").string(),
      {{"mse", per_mse},
       {"psnr", sr::SRPSNRTensor(per_mse)},
       {"ssim", sr::SRSSIMTensor(metric_images[0], metric_images[1])},
       {"bicubic_psnr", sr::SRPSNRTensor(base_mse)},
       {"bicubic_ssim", sr::SRSSIMTensor(metric_images[2], metric_images[1])}});
  Require(
      optimizers[0]->iterations() == 32 && optimizers[1]->iterations() == 32 && gsteps == 48 &&
          dsteps == 32,
      "cold-reset Adam counters versus cumulative writes");
  std::ofstream meta(dir / "metrics.json");
  meta.precision(17);
  meta << "{\"enhanced\":" << (enhanced ? "true" : "false")
       << ",\"generator_parameters\":" << g.count() << ",\"discriminator_parameters\":" << d.count()
       << ",\"bn_state_values\":" << stats.count()
       << ",\"frozen_vgg_values\":1792,\"epochs\":" << epochs
       << ",\"warmup_epochs\":1,\"generator_updates\":" << gsteps
       << ",\"discriminator_updates\":" << dsteps << ",\"selected_epoch_fixed_final\":" << epochs
       << ",\"test_mean_psnr\":" << score.psnr << ",\"test_mean_ssim\":" << score.ssim
       << ",\"test_pooled_psnr\":" << sr::SRPSNR(score.mse)
       << ",\"bicubic_mean_psnr\":" << score.baseline_psnr
       << ",\"bicubic_mean_ssim\":" << score.baseline_ssim
       << ",\"single_batch_max_error\":" << parity;
  for (auto key :
       {"g_loss", "gan_loss", "pixel_loss", "content_loss", "adversarial_loss", "d_loss"})
    meta << ",\"test_" << key << "\":" << Value(output, key);
  meta << ",\"training_seconds\":" << seconds << "}\n";
  Require(bool(meta) && bool(history) && bool(batches), "complete SRGAN records");
  std::cout << label << ": all 32 test mean PSNR/SSIM=" << score.psnr << '/' << score.ssim
            << ", bicubic=" << score.baseline_psnr << '/' << score.baseline_ssim
            << "; frozen VGG/warmup+GAN/restore/LR only/target canary/immutable PASS (training "
            << seconds << " s)" << std::endl;
}

void Run(
    const std::filesystem::path& data,
    const std::filesystem::path& feature_path,
    const std::filesystem::path& root,
    int                          epochs,
    const std::string&           init) {
  std::filesystem::create_directories(root);
  const auto training = data::LoadCifar({data / "data_batch_1.bin"}, data::Cifar::k10),
             testing  = data::LoadCifar({data / "test_batch.bin"}, data::Cifar::k10);
  Require(training.size() == 10000 && testing.size() == 10000, "canonical CIFAR binary sizes");
  std::vector<sr::SRData> pools;
  Arrays                  records;
  for (int k = 0; k < 3; ++k) {
    const int                 n = k == 0 ? 128 : 32, start = k == 0 ? 0 : k == 1 ? 128 : 64;
    std::vector<std::int64_t> rows;
    for (int i = 0; i < n; ++i)
      rows.push_back(start + i);
    const auto& source = k == 2 ? testing : training;
    pools.push_back(sr::SRPairs(source.images, rows));
    const std::string split = k == 0 ? "fit" : k == 1 ? "validation" : "test";
    records.emplace(split + "_hr", pools.back().hr);
    records.emplace(split + "_lr", pools.back().lr);
    records.emplace(split + "_bicubic", pools.back().bicubic);
    std::vector<std::int32_t> ids;
    for (int i = 0; i < n; ++i)
      ids.push_back(start + i + (k == 2 ? 50000 : 0));
    records.emplace(split + "_source_ids", nn::from_vector(ids, {n}));
    records.emplace(split + "_labels", nn::take_rows(source.labels, rows));
  }
  SaveArrays((root / "data.npz").string(), records);
  Require(
      std::filesystem::exists(feature_path),
      feature_path.string() + " missing; pass features=PATH");
  Arrays full;
  for (auto& [k, v] : nn::load_npz(feature_path.string()))
    full.emplace(k, v);
  if (full.size() != 2)
    Require(full.size() == 32, "original VGG19 convolution inventory");
  Arrays features;
  for (auto name : {"block1_conv1_W", "block1_conv1_b"})
    features.emplace(name, nn::cast(full.at(name), nn::DType::Float32));
  RequireFinite(features, "finite pretrained VGG filter");
  SaveArrays((root / "frozen_features.npz").string(), features);
  RaAlgebra(root);
  Train(root, pools, features, epochs, false, init);
  Train(root, pools, features, epochs, true, init);
  std::cout << "Artifacts: " << root.string() << "\nAll srgan_esrgan checks passed.\n";
}

} // namespace

int main() {
  auto       root    = std::filesystem::path(dm::datasets::data_home());
  const auto data    = dm::datasets::fetch("cifar10");
  const auto feature = root / "style_transfer/vgg19.npz";
  if (!std::filesystem::is_regular_file(feature))
    dm::datasets::prepare_example_data("style");
  Run(data, feature, "build/srgan_esrgan", 3, "");
}
