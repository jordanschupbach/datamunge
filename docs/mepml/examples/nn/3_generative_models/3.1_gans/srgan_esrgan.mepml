> Read validation losses with the phase and normalization path stated

The curves retain all three source validation records for each model. Content
and adversarial components are computed even during epoch1 warm-up, while G
uses only pixel loss then. From epoch2 G switches to the declared GAN objective;
its scale differs across variants. SRGAN objectives use live validation-batch
BN, while its deployed prediction uses saved statistics. Small adversarial
losses are not perceptual-quality scores.

```{cpp, results="markdown", file="figures/asr_learning.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
namespace n = dm::nn;
namespace m = n::models;
using A     = std::map<std::string, n::Tensor>;
A Read(const std::string& path) {
  A a;
  for (const auto& [key, value] : n::load_npz(path))
    a.emplace(key, value);
  return a;
}
int main() {
  auto p = dm::graphics::RPlot::create();
  p.y_limits(0, 2.2);
  for (int k = 0; k < 2; ++k) {
    std::string         name = k ? "esrgan" : "srgan";
    std::vector<double> epoch, g, d;
    for (int e = 1; e <= 3; ++e) {
      auto a = Read(
          "build/srgan_esrgan/" + name + "/probe-epoch" + std::to_string(e) + "-validation.npz");
      epoch.push_back(e);
      g.push_back(a.at("g_loss").item());
      d.push_back(a.at("d_loss").item());
    }
    p.lines(
         epoch,
         g,
         name + " G",
         k ? dm::graphics::RGB{22, 163, 74} : dm::graphics::RGB{37, 99, 235},
         2)
        .lines(
            epoch,
            d,
            name + " D",
            k ? dm::graphics::RGB{147, 51, 234} : dm::graphics::RGB{220, 38, 38},
            2);
  }
  p.x_label("Fixed epoch:1 pixel warm-up,2/3 GAN after cold Adam reset")
      .y_label("Source validation objective, variant-specific scale")
      .title("All validation losses; no test-based checkpoint selection")
      .save_svg("build/asr_learning.svg");
}
