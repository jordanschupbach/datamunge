> Check the softmax and zero gate by hand

Take two query scalars q=(0,log 3), keys k=(0,1) and values v=(2,6). Unscaled
qkᵀ gives rows(0,0) and(0,log 3); row softmax gives(.5,.5) and(.25,.75).
The mixed values are therefore 4 and 5. For an identity projection and residual input
x=(1,3), output=x+gamma×mixed: gamma 0 gives(1,3), gamma.5 gives(3,5.5).
For the sum of outputs at gamma 0, the gate derivative is 4+5=9 while q/k/v
partials vanish. This explains why zero gate initialization preserves input values
but still allows attention's contribution to become active through a gate write.

```{cpp, results="markdown", file="figures/self_attention_gan_algebra.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
  namespace n = dm::nn;
  auto t      = n::DType::Float64;
  auto q      = n::tensor({0., std::log(3.)}, {1, 2, 1}, t).requires_grad_(),
       k      = n::tensor({0., 1.}, {1, 2, 1}, t).requires_grad_(),
       v      = n::tensor({2., 6.}, {1, 2, 1}, t).requires_grad_();
  n::AttentionOptions options;
  options.scale        = 1.;
  options.need_weights = true;
  options.impl         = n::AttentionImpl::Plain;
  auto a               = n::scaled_dot_product_attention(q, k, v, options);
  auto gate            = n::scalar(0., t).requires_grad_();
  auto x               = n::tensor({1., 3.}, {1, 2, 1}, t);
  auto y               = x + gate * a.output;
  auto gradients       = n::grad(n::sum(y), {q, k, v, gate});
  if (std::abs(gradients[3].item() - 9.) > 1e-13)
    throw std::runtime_error("gate partial");
  for (int i = 0; i < 3; ++i)
    if (n::max(n::abs(gradients[i])).item() != 0)
      throw std::runtime_error("zero projection partial");
  std::print(
      "Probability rows: .5,.5 and .25,.75; mixed values: {},{}. Gate partial={}\n",
      a.output.at({0, 0, 0}),
      a.output.at({0, 1, 0}),
      gradients[3].item());
  std::vector<double> axis{0., .25, .5, .75, 1.}, first, second;
  for (double gamma : axis) {
    auto value = x + gamma * a.output;
    first.push_back(value.at({0, 0, 0}));
    second.push_back(value.at({0, 1, 0}));
  }
  auto p = dm::graphics::RPlot::create();
  p.y_limits(0., 12.)
      .lines(axis, first, "Token 1", {37, 99, 235}, 2.)
      .points(axis, first, "", {37, 99, 235}, 4.)
      .lines(axis, second, "Token 2", {220, 38, 38}, 2.)
      .points(axis, second, "", {220, 38, 38}, 4.)
      .x_label("Residual gate gamma; attention held fixed")
      .y_label("Residual output value")
      .title("The gate controls a global weighted response")
      .save_svg("build/self_attention_gan_algebra.svg");
}
```
