> Isolate a nonlocal effect with three controlled tokens

The reusable spectral attention layer accepts finite tokens[B,T,C], not only this
experiment's sixteen 8-feature tokens. Here set T 3,C 2,Q 1,V 1. Zero query/key kernels
give uniform rows(1/3,1/3,1/3); the value and projection kernels select the first
feature with cached sigma 1, biases zero and gamma.5. Inputs(1,0),(2,0),(3,0)
therefore receive a shared residual(1,0). Increasing only token 0's first feature by 3
raises the residual by.5 at every position. The changed token moves 3.5, while both
untouched tokens move.5. These deliberately set weights explain the mechanism;
they are separate from the learned checkpoint later in the report.

```{cpp, results="markdown", file="figures/self_attention_gan_toy.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
  namespace n         = dm::nn;
  auto              t = n::DType::Float64;
  n::ParameterStore p(1, t), s(0, t);
  auto              x = n::tensor({1., 0., 2., 0., 3., 0.}, {1, 3, 2}, t);
  n::models::SpectralSpatialAttention(p, s, x, 1, 1);
  for (const std::string name : {"query", "key"}) {
    p.set("attention/" + name + "/W", n::zeros({2, 1}, t));
    p.set("attention/" + name + "/b", n::zeros({1}, t));
  }
  p.set("attention/value/W", n::tensor({1., 0.}, {2, 1}, t));
  p.set("attention/value/b", n::zeros({1}, t));
  p.set("attention/project/W", n::tensor({1., 0.}, {1, 2}, t));
  p.set("attention/project/b", n::zeros({2}, t));
  p.set("attention/gamma", n::scalar(.5, t));
  s.set("attention/value/u", n::ones({1, 1}, t));
  s.set("attention/value/v", n::tensor({1., 0.}, {2, 1}, t));
  s.set("attention/project/u", n::tensor({1., 0.}, {2, 1}, t));
  s.set("attention/project/v", n::ones({1, 1}, t));
  auto a = n::models::SpectralSpatialAttention(p, s, x, 1, 1),
       b = n::models::SpectralSpatialAttention(
           p, s, n::tensor({4., 0., 2., 0., 3., 0.}, {1, 3, 2}, t), 1, 1);
  auto                delta = b.output - a.output;
  std::vector<double> change;
  for (int i = 0; i < 3; ++i)
    change.push_back(delta.at({0, i, 0}));
  if (std::abs(change[0] - 3.5) > 1e-14 || std::abs(change[1] - .5) > 1e-14 ||
      std::abs(change[2] - .5) > 1e-14)
    throw std::runtime_error("nonlocal toy");
  std::print(
      "First-feature changes: {},{},{}; only token 0 input changed.\n",
      change[0],
      change[1],
      change[2]);
  auto plot = dm::graphics::RPlot::create();
  plot.y_limits(0., 5.5)
      .lines({1., 2., 3.}, change, "Total output change", {37, 99, 235}, 2.)
      .points({1., 2., 3.}, change, "", {37, 99, 235}, 4.)
      .lines({1., 2., 3.}, {3., 0., 0.}, "Direct input change", {220, 38, 38}, 2.)
      .points({1., 2., 3.}, {3., 0., 0.}, "", {220, 38, 38}, 4.)
      .lines({1., 2., 3.}, {.5, .5, .5}, "Mixed residual change", {22, 163, 74}, 2.)
      .points({1., 2., 3.}, {.5, .5, .5}, "", {22, 163, 74}, 4.)
      .x_label("Displayed token1 is the modified source token 0")
      .y_label("First-feature change")
      .title("Untouched positions receive a shared attention response")
      .save_svg("build/self_attention_gan_toy.svg");
}
```
