  std::map<std::string, n::Tensor> a, c;
  for (const auto& [k, v] : n::load_npz("build/self_attention_gan/outputs.npz"))
    a.emplace(k, v);
  for (const auto& [k, v] : n::load_npz("build/self_attention_gan/controls.npz"))
    c.emplace(k, v);
  auto first  = [](const auto& x) { return n::slice_axis(x, 0, 0, 8); };
  auto images = n::concat(
      {first(a.at("fake")), first(c.at("changed_images")), first(c.at("zero_images"))}, 0);
  n::save_image_grid(
      images.reshape({24, 28, 28, 1}), "build/self_attention_gan_noise.png", 8, 0, 1, 4, 220 / 255., 3);
  std::print(
      "Rows: fixed seed4831; changed seed4877; zero input. All control weights unchanged.\n");
}
