> Inspect one fitted attention row without assigning semantic meaning

The first held-out generated/real image supplies query token 0, the upper-left spatial
patch. The plot retains all 16 key probabilities in native row-major patch order.
Each row sums to one; near-uniform weights can still mix information. This single row
is not an explanation of digit identity, a localization benchmark or evidence of useful
long-range reasoning. Both learned residual gates are reported beside the figure.

```{cpp, results="markdown", file="figures/self_attention_gan_weights.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
  namespace n = dm::nn;
  std::map<std::string, n::Tensor> a, p;
  for (const auto& [k, v] : n::load_npz("build/self_attention_gan/outputs.npz"))
    a.emplace(k, v);
  for (const auto& [k, v] : n::load_npz("build/self_attention_gan/final.npz"))
    p.emplace(k, v);
  std::vector<double> keys, g, d;
  for (int k = 0; k < 16; ++k) {
    keys.push_back(k + 1);
    g.push_back(a.at("g_attention").at({0, 0, k}));
    d.push_back(a.at("real_attention").at({0, 0, k}));
  }
  std::print(
      "Learned gates: G={} ; D={} ; selected G/D row sums={},{}\n",
      p.at("0/attention/gamma").item(),
      p.at("1/attention/gamma").item(),
      std::accumulate(g.begin(), g.end(), 0.),
      std::accumulate(d.begin(), d.end(), 0.));
  double
      low = std::min(
          {1. / 16, *std::min_element(g.begin(), g.end()), *std::min_element(d.begin(), d.end())}),
      high = std::max(
          {1. / 16, *std::max_element(g.begin(), g.end()), *std::max_element(d.begin(), d.end())});
  double span = std::max(high - low, 1e-6);
  auto   plot = dm::graphics::RPlot::create();
  plot.y_limits(low - .1 * span, high + .6 * span)
      .lines(keys, g, "G query 0", {37, 99, 235}, 2.)
      .points(keys, g, "", {37, 99, 235}, 4.)
      .lines(keys, d, "Real-D query 0", {220, 38, 38}, 2.)
      .points(keys, d, "", {220, 38, 38}, 4.)
      .lines({1., 16.}, {1. / 16, 1. / 16}, "Uniform1/16", {120, 120, 120}, 1.)
      .x_label("Key token, shown1..16 in row-major patch order")
      .y_label("Probability for first query token")
      .title("One held-out attention row from each network")
      .save_svg("build/self_attention_gan_weights.svg");
}
