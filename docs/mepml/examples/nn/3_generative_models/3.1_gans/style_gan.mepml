> Read the validation histories without treating adversarial losses as quality scores

Both trials use the same fitting row order and latent/noise schedule, with
independent parameters and Adam states. Every epoch's validation D and G loss
is retained below. The D targets are1/0; raw critic scores are not probabilities.
These losses do not measure visual quality or establish convergence.

```{cpp, results="markdown", file="figures/style_learning.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
namespace n = dm::nn;
namespace m = n::models;
using A     = std::map<std::string, n::Tensor>;
A Read(const std::string& path) {
  A a;
  for (const auto& [key, value] : n::load_npz(path))
    a.emplace(key, value);
  return a;
}
#include <fstream>
int main() {
  auto p = dm::graphics::RPlot::create();
  p.y_limits(0, 1.4);
  for (int k = 0; k < 2; ++k) {
    std::string   name = k ? "modulated" : "adain";
    std::ifstream in("build/style_gan/" + name + "/history.tsv");
    std::string   line;
    std::getline(in, line);
    std::vector<double> epoch, d, g;
    double              a, b, c;
    while (in >> a >> b >> c) {
      epoch.push_back(a);
      d.push_back(b);
      g.push_back(c);
    }
    if (epoch.size() != 3)
      throw std::runtime_error("three fixed epochs");
    p.lines(
         epoch,
         d,
         name + " D",
         k ? dm::graphics::RGB{22, 163, 74} : dm::graphics::RGB{37, 99, 235},
         2)
        .lines(
            epoch,
            g,
            name + " G",
            k ? dm::graphics::RGB{147, 51, 234} : dm::graphics::RGB{220, 38, 38},
            2);
  }
  p.x_label("Fixed epoch; final checkpoint is epoch3")
      .y_label("Held-out validation least-squares loss")
      .title("All validation points, independent two-variant runs")
      .save_svg("build/style_learning.svg");
}
