  std::filesystem::create_directories("build");
  dm::graphics::Diagram          d(44, 1500);
  dm::graphics::DiagramNodeStyle a;
  a.width     = 7.4;
  a.height    = 4.8;
  a.font_size = 38;
  d.node("z", {-16, 9}, "z[N,8]", a)
      .node("map", {-6, 9}, "Pixel RMS + map\n2 dense/leaky", a)
