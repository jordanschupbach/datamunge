A Read(const std::string& path) {
  A a;
  for (const auto& [key, value] : n::load_npz(path))
    a.emplace(key, value);
  return a;
}
int main() {
  auto data = Read("build/style_gan/data.npz");
  n::save_image_grid(
      n::slice_axis(data.at("fit_images"), 0, 0, 40),
      "build/style_inputs.png",
      8,
      0,
      1,
      4,
      220 / 255.,
      8);
}
