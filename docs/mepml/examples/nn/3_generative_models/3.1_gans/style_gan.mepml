> Run the complete two-trial experiment with explicit captures and writes

The native loader prepares and checks balanced, disjoint MNIST pools of1000
fitting,200 validation and200 test rows. Half-pixel bilinear28→8 resize reuses
the canonical BigGanResize8 operation. Labels and source IDs are retained only
as metadata. Each trial starts fresh Gseed6607/Dseed6619, uses batch order6679
and separate Adam(.0002,.5,.999,1e-8). There are32 batches per epoch, including
the final8 rows:96 writes per owner over three epochs,192 per trial,384 total.
The original comment saying96 steps per epoch was inconsistent with its loop;
the report preserves the actual loop. Validation is recorded after every epoch;
selection is the fixed final epoch, never a test-driven choice.

Latent and noise draws are source-compatible midpoint-MT Box–Muller banks.
For each row a single80-value noise bank supplies the first16 values to4x4 and
the remaining64 to8x8. Drawing those shapes from independent streams changes
the method. Validation uses zseed6637/noiseseed6653, test6659/6661; epoch e
uses6689+e/6701+e. The visible program saves the full source outputs, all384
phase captures per trial and12 extra probes per trial, checks unselected owners,
restores independent stores and performs every source inference control.
No old example model class, hidden training helper or opposite checkout is used.

```{cpp, results="markdown", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <chrono>
#include <dm/dm.hpp>
#include <fstream>
#include <iostream>
namespace nn = dm::nn;
namespace m  = nn::models;
using nn::Tensor;
using Arrays = std::map<std::string, Tensor>;
void Require(bool ok, const std::string& why) {
  if (!ok)
    throw std::runtime_error(why);
}
void SaveArrays(const std::string& path, const Arrays& a) {
  nn::save_npz(path, nn::NamedTensors(a.begin(), a.end()));
}
Tensor Rows(const Tensor& x, const std::vector<std::int64_t>& rows) {
  return nn::take_rows(x, rows);
}
bool BitEqual(const Tensor& a, const Tensor& b) {
  return nn::equal_bits(a, b);
}
bool BitEqual(const Arrays& a, const Arrays& b) {
  if (a.size() != b.size())
    return false;
  for (const auto& [k, v] : a)
    if (!b.count(k) || !BitEqual(v, b.at(k)))
      return false;
  return true;
}
double MaxAbsDiff(const Tensor& a, const Tensor& b) {
  return nn::max(nn::abs(nn::cast(a, nn::DType::Float64) - nn::cast(b, nn::DType::Float64))).item();
}
Arrays Fields(const m::StyleGanOutput& o) {
  return {
      {"fake", o.fake},
      {"mapped", o.mapped},
      {"first_style", o.first_style},
      {"second_style", o.second_style},
      {"first_demodulator", o.first_demodulator},
      {"second_demodulator", o.second_demodulator},
      {"real_score", o.real_score},
      {"fake_score", o.fake_score},
      {"d_loss", o.d_loss},
      {"g_loss", o.g_loss}};
}
void Initialize(nn::ParameterStore& g, nn::ParameterStore& d, bool v2) {
  nn::NoGradGuard guard;
  auto            w = m::StyleGanMap(g, nn::zeros({1, 8}));
  auto o = m::StyleGanSynthesize(g, w, w, nn::zeros({1, 4, 4, 1}), nn::zeros({1, 8, 8, 1}), v2);
  m::StyleGanDiscriminate(d, o.image);
}
Arrays Snapshot(const std::vector<nn::ParameterStore*>& stores) {
  Arrays a;
  for (int k = 0; k < 2; ++k)
    for (const auto& name : stores[k]->names())
      a.emplace(std::to_string(k) + "/" + name, stores[k]->at(name).detach().clone());
  return a;
}
void Restore(const std::vector<nn::ParameterStore*>& stores, const std::string& file) {
  auto a = nn::load_npz(file);
  Require(a.size() == stores[0]->size() + stores[1]->size(), "complete checkpoint");
  for (const auto& [key, value] : a) {
    Require(
        key.size() > 2 && (key[0] == '0' || key[0] == '1') && key[1] == '/',
        "known checkpoint owner");
    auto& p = *stores[key[0] - '0'];
    Require(
        p.contains(key.substr(2)) && p.at(key.substr(2)).shape() == value.shape(),
        "known matching leaf");
    p.set(key.substr(2), value);
  }
}
std::vector<Tensor> OrderedGradient(nn::ParameterStore& p, int group, const Arrays& a) {
  std::vector<Tensor> out;
  for (const auto& name : p.names())
    out.push_back(a.at(std::to_string(group) + "/" + name));
  return out;
}
void RequireOnlyOwnersChanged(
    const Arrays&                   before,
    const Arrays&                   after,
    const std::vector<std::string>& prefixes,
    const std::string&              why,
    bool                            require_change) {
  bool changed = false;
  for (const auto& [key, v] : before) {
    bool selected = false;
    for (const auto& prefix : prefixes)
      selected |= key.starts_with(prefix);
    if (!BitEqual(v, after.at(key))) {
      Require(selected, why);
      changed = true;
    }
  }
  if (require_change)
    Require(changed, why + " changes selected weights");
}
Tensor Synthesize(
    nn::ParameterStore& g,
    const Tensor&       w0,
    const Tensor&       w1,
    const Tensor&       a,
    const Tensor&       b,
    bool                v2) {
  nn::NoGradGuard guard;
  return m::StyleGanSynthesize(g, w0, w1, a, b, v2).image;
}
Tensor Generate(nn::ParameterStore& g, const Tensor& z, const Tensor& a, const Tensor& b, bool v2) {
  nn::NoGradGuard guard;
  auto            w = m::StyleGanMap(g, z);
  return m::StyleGanSynthesize(g, w, w, a, b, v2).image;
}
namespace {

double Value(const Arrays& a, const std::string& key) {
  return a.at(key).item();
}

/// 28x28 -> 8x8 bilinear with half-pixel centres (scale 3.5).
Tensor Resize8(const Tensor& x) {
  return m::BigGanResize8(x);
}

void Mosaic(const std::filesystem::path& path, const Tensor& images, std::int64_t columns) {
  nn::save_image_grid(
      nn::reshape(images, {-1, 8, 8, 1}), path.string(), columns, 0, 1, 4, 220 / 255., 8);
}

struct Inputs {
  Tensor z, noise4, noise8;
};
/// z [n, 8] from GaussianNoise(zseed); per row 80 noise values from nseed: 16 for 4x4, 64 for 8x8.
Inputs Draw(int n, std::uint32_t zseed, std::uint32_t nseed) {
  const Tensor z     = nn::cast(m::GaussianNoise({8}, n, zseed), nn::DType::Float32);
  const Tensor noise = nn::cast(m::GaussianNoise({80}, n, nseed), nn::DType::Float32);
  return {
      z,
      nn::reshape(nn::slice(noise, {0, 0}, {n, 16}), {n, 4, 4, 1}),
      nn::reshape(nn::slice(noise, {0, 16}, {n, 64}), {n, 8, 8, 1})};
}
void SaveInputs(const std::filesystem::path& path, const Inputs& x) {
  SaveArrays(path.string(), {{"z", x.z}, {"noise4", x.noise4}, {"noise8", x.noise8}});
}
/// Every row replaced by row 0.
Tensor CommonNoise(const Tensor& x) {
  std::vector<std::int64_t> rows(std::size_t(x.size(0)), 0);
  return Rows(x, rows);
}

void Train(
    const std::filesystem::path& root,
    const std::vector<Tensor>&   images,
    int                          epochs,
    bool                         version2,
    const std::string&           init) {
  const auto dir = root / (version2 ? "modulated" : "adain");
  std::filesystem::create_directories(dir);
  const auto probe_root = dir;
  std::filesystem::create_directories(probe_root / "phases");
  const auto validation = Draw(200, 6637, 6653), test = Draw(200, 6659, 6661);
  SaveInputs(dir / "validation_inputs.npz", validation);
  SaveInputs(dir / "test_inputs.npz", test);
  // Parameter order and native initialization match each independently seeded source trial.
  nn::ParameterStore               g(6607), d(6619);
  std::vector<nn::ParameterStore*> stores{&g, &d};
  Initialize(g, d, version2);
  nn::OptimizerConfig config;
  config.kind    = nn::OptimizerKind::Adam;
  config.beta1   = .5;
  config.beta2   = .999;
  config.epsilon = 1e-8;
  nn::Optimizer               go(g, .0002, config), do_(d, .0002, config);
  std::vector<nn::Optimizer*> optimizers{&go, &do_};
  auto evaluate = [&](const Tensor& x, const Tensor& z, const Tensor& a, const Tensor& b) {
    nn::NoGradGuard guard;
    return Fields(m::StyleGan(g, d, x, z, a, b, version2));
  };
  auto capture =
      [&](int group, const Tensor& x, const Tensor& z, const Tensor& a, const Tensor& b) {
        // Every invocation is fresh, so G sees the critic AFTER the D write below.
        auto out     = m::StyleGan(g, d, x, z, a, b, version2);
        auto partial = nn::grad(group == 0 ? out.g_loss : out.d_loss, stores[group]->parameters());
        Arrays result;
        for (std::size_t k = 0; k < partial.size(); ++k)
          result.emplace(std::to_string(group) + "/" + stores[group]->names()[k], partial[k]);
        return result;
      };
  if (!init.empty())
    Restore(
        stores,
        (std::filesystem::path(init) / (version2 ? "modulated" : "adain") / "initial_arrays.npz")
            .string());
  Require(g.count() == (version2 ? 625 : 661) && d.count() == 493, "styled G/D parameter counts");
  SaveArrays((dir / "initial_arrays.npz").string(), Snapshot(stores));
  SaveArrays(
      (dir / "initial_outputs.npz").string(),
      evaluate(images[2], test.z, test.noise4, test.noise8));
  const auto changed_initial = Draw(200, 6659, 6673);
  SaveArrays(
      (probe_root / "probe-initial-noise-control.npz").string(),
      evaluate(images[2], test.z, changed_initial.noise4, changed_initial.noise8));
  Require(
      BitEqual(
          Generate(g, test.z, test.noise4, test.noise8, version2),
          Generate(g, test.z, changed_initial.noise4, changed_initial.noise8, version2)),
      "initial noise strength 0 means EXACT no effect");
  nn::BatchOrder order(1000, 32, 6679);
  int            steps = 0;
  std::ofstream  history(dir / "history.tsv"), batches(dir / "batches.tsv");
  history.precision(17);
  history << "epoch\td_loss\tg_loss\n";
  batches << "epoch\tstep\trow\n";
  Tensor     fx, fz, f4, f8;
  const auto started = std::chrono::steady_clock::now();
  for (int epoch = 1; epoch <= epochs; ++epoch) {
    const auto input = Draw(1000, 6689 + epoch, 6701 + epoch);
    order.begin_epoch();
    for (;;) {
      const auto rows = order.next();
      if (rows.empty())
        break;
      const Tensor x = Rows(images[0], rows), z = Rows(input.z, rows),
                   n4 = Rows(input.noise4, rows), n8 = Rows(input.noise8, rows);
      if (!steps) {
        fx = x;
        fz = z;
        f4 = n4;
        f8 = n8;
        SaveArrays(
            (probe_root / "probe-first-input.npz").string(),
            {{"x", x}, {"z", z}, {"noise4", n4}, {"noise8", n8}});
        SaveArrays((probe_root / "probe-first-forward.npz").string(), evaluate(x, z, n4, n8));
      }
      for (int group : {1, 0}) {
        const auto before   = Snapshot(stores);
        const auto gradient = capture(group, x, z, n4, n8);
        const auto name     = "batch" + std::to_string(steps) + (group == 1 ? "-d" : "-g");
        SaveArrays((probe_root / "phases" / (name + "-gradient.npz")).string(), gradient);
        optimizers[group]->step(OrderedGradient(*stores[group], group, gradient));
        SaveArrays((probe_root / "phases" / (name + "-after.npz")).string(), Snapshot(stores));
        RequireOnlyOwnersChanged(
            before,
            Snapshot(stores),
            {std::to_string(group) + "/"},
            "styled GAN step updates ONLY own group",
            !steps);
      }
      for (auto row : rows)
        batches << epoch << '\t' << steps << '\t' << row << '\n';
      ++steps;
    }
    SaveArrays(
        (probe_root / ("probe-epoch" + std::to_string(epoch) + ".npz")).string(), Snapshot(stores));
    SaveArrays(
        (probe_root / ("probe-epoch" + std::to_string(epoch) + "-test.npz")).string(),
        evaluate(images[2], test.z, test.noise4, test.noise8));
    const auto v = evaluate(images[1], validation.z, validation.noise4, validation.noise8);
    SaveArrays(
        (probe_root / ("probe-epoch" + std::to_string(epoch) + "-validation.npz")).string(), v);
    history << epoch << '\t' << Value(v, "d_loss") << '\t' << Value(v, "g_loss") << '\n';
    std::cout << (version2 ? "modulated" : "adain") << " epoch " << epoch
              << ": D/G=" << Value(v, "d_loss") << '/' << Value(v, "g_loss") << std::endl;
  }
  const double seconds =
      std::chrono::duration<double>(std::chrono::steady_clock::now() - started).count();
  const auto checkpoint = (dir / "final.npz").string();
  SaveArrays(checkpoint, Snapshot(stores));
  for (int group = 0; group < 2; ++group)
    SaveArrays(
        (dir / ("final_gradients_group" + std::to_string(group) + ".npz")).string(),
        capture(group, fx, fz, f4, f8));
  nn::ParameterStore restored_g(1), restored_d(2);
  Initialize(restored_g, restored_d, version2);
  std::vector<nn::ParameterStore*> restored{&restored_g, &restored_d};
  Restore(restored, checkpoint);
  nn::NoGradGuard inference_guard; // All remaining controls are explicit read-only inference.
  auto deployed_evaluate = [&](const Tensor& x, const Tensor& z, const Tensor& a, const Tensor& b) {
    return Fields(m::StyleGan(restored_g, restored_d, x, z, a, b, version2));
  };
  Require(BitEqual(Snapshot(stores), Snapshot(restored)), "all styled GAN weights restore exact");
  const auto   before = Snapshot(restored);
  const auto   output = deployed_evaluate(images[2], test.z, test.noise4, test.noise8);
  const Tensor w      = m::StyleGanMap(restored_g, test.z);
  Require(BitEqual(w, output.at("mapped")), "Z ONLY mapping exact");
  const Tensor plain  = Generate(restored_g, test.z, test.noise4, test.noise8, version2),
               from_w = Synthesize(restored_g, w, w, test.noise4, test.noise8, version2);
  Require(
      BitEqual(plain, output.at("fake")) && BitEqual(plain, from_w),
      "Z + noise ONLY matches W styles + noise ONLY synthesis");
  const double parity = MaxAbsDiff(
      Generate(
          restored_g, Rows(test.z, {0}), Rows(test.noise4, {0}), Rows(test.noise8, {0}), version2),
      Rows(plain, {0}));
  Require(parity < 3e-6, "styled G batch parity");
  const auto   other       = Draw(200, 6719, 6673);
  const Tensor other_w     = m::StyleGanMap(restored_g, other.z);
  const Tensor mixed       = Synthesize(restored_g, w, other_w, test.noise4, test.noise8, version2),
               mixed_first = Synthesize(restored_g, other_w, w, test.noise4, test.noise8, version2),
               changed_noise = Generate(restored_g, test.z, other.noise4, other.noise8, version2);
  const double style_effect  = std::max(MaxAbsDiff(plain, mixed), MaxAbsDiff(plain, mixed_first));
  const double noise_effect  = MaxAbsDiff(plain, changed_noise);
  Require(
      style_effect > 1e-5 && noise_effect > 1e-7,
      "actual per layer styles AND learned noise affect pixels");
  const auto   center_inputs = Draw(2048, 6733, 6737);
  const Tensor center_w      = m::StyleGanMap(restored_g, center_inputs.z);
  const Tensor center =
      nn::cast(nn::mean(nn::cast(center_w, nn::DType::Float64), {0}), nn::DType::Float32);
  const Tensor n4 = CommonNoise(test.noise4), n8 = CommonNoise(test.noise8);
  Arrays       controls{
            {"w", w},
            {"other_z", other.z},
            {"other_w", other_w},
            {"mixed_second", mixed},
            {"mixed_first", mixed_first},
            {"changed_noise4", other.noise4},
            {"changed_noise8", other.noise8},
            {"changed_noise_fake", changed_noise},
            {"center_z", center_inputs.z},
            {"center_w", center_w},
            {"center", center},
            {"common_noise4", n4},
            {"common_noise8", n8}};
  controls.emplace(
      "changed_only_noise4", Generate(restored_g, test.z, other.noise4, test.noise8, version2));
  controls.emplace(
      "changed_only_noise8", Generate(restored_g, test.z, test.noise4, other.noise8, version2));
  if (version2) {
    const Tensor doubled = output.at("first_style") * 2.0;
    const auto   scaled =
        m::StyleGanSynthesize(restored_g, w, w, test.noise4, test.noise8, true, doubled);
    Require(
        MaxAbsDiff(plain, scaled.image) <= 3e-6,
        "demodulated kernel invariant to common positive input style factor up to epsilon");
    controls.emplace("doubled_first_style", doubled);
    controls.emplace("doubled_first_style_fake", scaled.image);
    controls.emplace("doubled_first_style_demodulator", scaled.first_demodulator);
  }
  const Tensor repeated_center = nn::tile(nn::expand_dims(center, 0), {200, 1});
  const Tensor zero_style_varying_noise =
      Synthesize(restored_g, repeated_center, repeated_center, test.noise4, test.noise8, version2);
  SaveArrays(
      (dir / "extra-controls.npz").string(),
      {{"zero_style_varying_noise", zero_style_varying_noise}});
  Require(
      MaxAbsDiff(zero_style_varying_noise, CommonNoise(zero_style_varying_noise)) > 1e-7,
      "psi0 still varies with learned independent noise");
  std::vector<Tensor> gallery(40), mix_gallery(40);
  for (int level = 0; level < 3; ++level) {
    const float  psi = level == 0 ? 1 : level == 1 ? .5f : 0;
    const Tensor truncated =
        nn::expand_dims(center, 0) + double(psi) * (w - nn::expand_dims(center, 0));
    const Tensor image = Synthesize(restored_g, truncated, truncated, n4, n8, version2);
    controls.emplace("truncated_w" + std::to_string(level), truncated);
    controls.emplace("truncated_fake" + std::to_string(level), image);
    if (level == 2)
      Require(
          MaxAbsDiff(image, CommonNoise(image)) <= 3e-6,
          "psi 0 SAME w + SAME noise gives SAME image");
    for (int b = 0; b < 8; ++b)
      gallery[b * 5 + level] = Rows(image, {b});
  }
  const Tensor other_plain =
      Synthesize(restored_g, other_w, other_w, test.noise4, test.noise8, version2);
  for (int b = 0; b < 8; ++b) {
    gallery[b * 5 + 3]     = Rows(plain, {b});
    gallery[b * 5 + 4]     = Rows(changed_noise, {b});
    mix_gallery[b * 5]     = Rows(plain, {b});
    mix_gallery[b * 5 + 1] = Rows(mixed, {b});
    mix_gallery[b * 5 + 2] = Rows(mixed_first, {b});
    mix_gallery[b * 5 + 3] = Rows(other_plain, {b});
    mix_gallery[b * 5 + 4] = Rows(changed_noise, {b});
  }
  controls.emplace("other_plain", other_plain);
  controls.emplace("truncation_gallery", nn::concat(gallery, 0));
  controls.emplace("mix_gallery", nn::concat(mix_gallery, 0));
  SaveArrays((dir / "style_controls.npz").string(), controls);
  Mosaic(dir / "truncation_noise.png", controls.at("truncation_gallery"), 5);
  Mosaic(dir / "style_mixing.png", controls.at("mix_gallery"), 5);
  Mosaic(dir / "generated.png", nn::slice_axis(plain, 0, 0, 40), 8);
  Require(
      BitEqual(before, Snapshot(restored)),
      "all mapping/style mix/truncation/noise inference immutable");
  SaveArrays((dir / "outputs.npz").string(), output);
  std::ofstream meta(dir / "metrics.json");
  meta.precision(17);
  meta << "{\"style2\":" << (version2 ? "true" : "false")
       << ",\"generator_parameters\":" << g.count()
       << ",\"discriminator_parameters\":493,\"epochs\":" << epochs
       << ",\"steps_per_group\":" << steps << ",\"optimizer_updates\":" << 2 * steps
       << ",\"selected_epoch_fixed_final\":" << epochs
       << ",\"test_d_loss\":" << Value(output, "d_loss")
       << ",\"test_g_loss\":" << Value(output, "g_loss")
       << ",\"style_pixel_max_effect\":" << style_effect
       << ",\"noise_pixel_max_effect\":" << noise_effect << ",\"single_batch_max_error\":" << parity
       << ",\"training_seconds\":" << seconds << "}\n";
  Require(bool(meta) && bool(history) && bool(batches), "complete both styled GAN records");
  Require(go.iterations() == 96 && do_.iterations() == 96, "96 explicit writes per owner");
  std::cout << (version2 ? "StyleGAN2" : "StyleGAN1") << ": test D/G=" << Value(output, "d_loss")
            << '/' << Value(output, "g_loss") << ", style effect=" << style_effect
            << ", noise effect=" << noise_effect
            << "; constant/mapping/W mix/truncation/noise/restore/immutable PASS (training "
            << seconds << " s)" << std::endl;
}

void Run(
    const std::filesystem::path& data,
    const std::filesystem::path& root,
    int                          epochs,
    const std::string&           init) {
  std::filesystem::create_directories(root);
  const auto          pools = m::LoadSaliency(data);
  std::vector<Tensor> resized;
  Arrays              records;
  for (int k = 0; k < 3; ++k) {
    resized.push_back(Resize8(pools[k].images));
    const std::string split = k == 0 ? "fit" : k == 1 ? "validation" : "test";
    records.emplace(split + "_original", pools[k].images);
    records.emplace(split + "_images", resized.back());
    records.emplace(split + "_labels", pools[k].labels);
    records.emplace(split + "_source_ids", pools[k].source);
  }
  SaveArrays((root / "data.npz").string(), records);
  Train(root, resized, epochs, false, init);
  Train(root, resized, epochs, true, init);
  std::cout << "Artifacts: " << root.string() << "\nAll style_gan checks passed.\n";
}

} // namespace

int main() {
  auto data = std::filesystem::path(dm::datasets::data_home()) / "saliency";
  dm::datasets::prepare_example_data("mnist-assets", data.parent_path());
  Run(data, "build/style_gan", 3, "");
}
