\caption(The executed adain generator has661 values in17 leaves, including mapping. The separate shared-architecture critic has493 values in6 leaves:4x4/stride2 conv1→4,3x3 conv4→8,128→1 raw dense, with leaky activations after convolutions.)
\alttext(An executed generator trace connects latent mapping, learned constant, both spatial noise inputs,4x4 and8x8 feature maps and grayscale sigmoid output.)

```{cpp, results="markdown", file="figures/style_modulated_architecture.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
  namespace n = dm::nn;
  namespace m = n::models;
  n::ParameterStore g(6607);
  n::Module         model(
      [&](const n::Tensor& packed) {
        auto z  = n::slice(packed, {0, 0}, {1, 8});
        auto n4 = n::reshape(n::slice(packed, {0, 8}, {1, 16}), {1, 4, 4, 1});
        auto n8 = n::reshape(n::slice(packed, {0, 24}, {1, 64}), {1, 8, 8, 1});
        n::model_stage("Supplied Z8", packed, z);
        n::model_stage("Supplied noise4", packed, n4);
        n::model_stage("Supplied noise8", packed, n8);
        auto w = m::StyleGanMap(g, z);
        n::model_stage("Pixel RMS + dense8/leaky x2", z, w);
        auto o = m::StyleGanSynthesize(g, w, w, n4, n8, true);
        n::model_stage("Tile learned constant", g.at("constant"), o.tiled_constant);
        n::model_stage(
            "Styled4 + supplied noise4", std::vector<n::Tensor>{o.tiled_constant, w, n4}, o.first);
        n::model_stage("Nearest up2", o.first, o.upsampled);
        n::model_stage(
            "Styled8 + supplied noise8", std::vector<n::Tensor>{o.upsampled, w, n8}, o.second);
        return n::model_stage("RGB sigmoid", std::vector<n::Tensor>{o.second, w}, o.image);
      },
      "modulated compact generator");
  n::ModelPlotOptions options;
  options.style                 = n::ModelPlotStyle::Flow;
  options.detail                = n::ModelPlotDetail::Blocks;
  options.sizing.minimum_extent = 2;
  options.sizing.max_planes     = 4;
  auto figure                   = model.plot(n::ones({1, 88}), options);
  if (figure.parameter_count() != 625 || g.size() != 19)
    throw std::runtime_error("executed source census");
  figure.save_svg("build/style_modulated_architecture.svg");
}
