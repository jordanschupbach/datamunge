> Complete experiment: D, then E, then G with independent Adam states

Each optimizer uses learning rate .0002,β1=.5,β2=.999,ε=1e-8. BatchOrder(400,32,6089)
provides twelve 32-row minibatches plus a 16-row tail per epoch. Training noise seeds are
6068,6069,6070. Every phase recomputes after the preceding write and selects only its own
parameter store. Each store receives 39 updates; all 117 writes and 1200 fitting-row visits
are visible below. The first batch checks that E's write leaves G's partial bit exact with
D fixed, and saves all82 G derivative values after the first D write.

The full editable program includes native procedural preparation, every fitting update,
checkpoint restore, standalone generation/encoding, joint-pair controls and immutable
inference. There is no legacy example helper or bundled optimizer runner. Archives retain
original group prefixes0/G,1/E,2/D. Native annotated scatter plots replace the old manually
rasterized PNG presentation; the arrays, fixed [-3,3] windows and outside counts are preserved.

```{cpp, results="markdown", file="figures/bigan_learning.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <chrono>
#include <cmath>
#include <dm/dm.hpp>
#include <fstream>
#include <iostream>

namespace nn = dm::nn;
namespace m  = nn::models;
using Arrays = std::map<std::string, nn::Tensor>;
using nn::Tensor;

namespace {
void Require(bool condition, const std::string& message) {
  if (!condition)
    throw std::runtime_error(message);
}
void SaveArrays(const std::string& path, const Arrays& arrays) {
  nn::save_npz(path, nn::NamedTensors(arrays.begin(), arrays.end()));
}
bool Equal(const Tensor& a, const Tensor& b) {
  return nn::equal_bits(a, b);
}
bool Equal(const Arrays& a, const Arrays& b) {
  if (a.size() != b.size())
    return false;
  for (const auto& [name, value] : a)
    if (!b.count(name) || !Equal(value, b.at(name)))
      return false;
  return true;
}
double MaxAbsDiff(const Tensor& a, const Tensor& b) {
  return nn::max(nn::abs(nn::cast(a, nn::DType::Float64) - nn::cast(b, nn::DType::Float64))).item();
}
Arrays Fields(const m::BiganOutput& o) {
  return {
      {"fake", o.fake},
      {"encoded", o.encoded},
      {"real_score", o.real_score},
      {"fake_score", o.fake_score},
      {"discriminator_loss", o.discriminator_loss},
      {"eg_loss", o.eg_loss},
      {"reconstruction", o.reconstruction},
      {"latent_cycle", o.latent_cycle}};
}

double Value(const Arrays& a, const std::string& key) {
  return a.at(key).item();
}

Tensor Gaussian2(std::int64_t n, std::uint32_t seed) {
  return nn::cast(m::GaussianNoise({n, 2}, 1, seed).reshape({n, 2}), nn::DType::Float32);
}

/// tflow Points: ring of eight Gaussians (class i % 8), radius 2, sd .08.
// Native plot rendering replaces the old hand-drawn PNG pixels; all points are retained.
int Plot(std::filesystem::path path, const Tensor& real, const Tensor& mapped) {
  int outside = 0;
  for (const auto& points : {real, mapped}) {
    const auto values = points.to_vector<double>();
    for (std::size_t k = 0; k < values.size(); k += 2)
      outside += std::abs(values[k]) > 3 || std::abs(values[k + 1]) > 3;
  }
  auto p = dm::graphics::RPlot::create();
  p.size(900, 950)
      .margins(90, 30, 90, 80)
      .points(
          nn::select(real, 1, 0).to_vector<double>(),
          nn::select(real, 1, 1).to_vector<double>(),
          "",
          {37, 99, 235, .7},
          3.)
      .points(
          nn::select(mapped, 1, 0).to_vector<double>(),
          nn::select(mapped, 1, 1).to_vector<double>(),
          "",
          {220, 38, 38, .7},
          3.)
      .x_limits(-3, 3)
      .y_limits(-3, 3)
      .x_label("Coordinate0")
      .y_label("Coordinate1")
      .title(
          path.stem() == "encoded"          ? "Blue prior z; red E(test)"
          : path.stem() == "reconstruction" ? "Blue test; red G(E(test))"
                                            : "Blue test; red G(z)");
  p.save_png(path.string());
  path.replace_extension(".svg");
  p.save_svg(path.string());
  return outside;
}

} // namespace
int main() {
  const std::filesystem::path root   = "build/bigan";
  const int                   epochs = 3;
  std::filesystem::create_directories(root);
  const Tensor fit        = m::GaussianRingPoints(400, 5507),
               validation = m::GaussianRingPoints(128, 5519),
               test       = m::GaussianRingPoints(128, 5521);
  const Tensor vz = Gaussian2(128, 6043), tz = Gaussian2(128, 6047);
  SaveArrays(
      (root / "data.npz").string(), {{"fit", fit}, {"validation", validation}, {"test", test}});
  SaveArrays((root / "fixed_noise.npz").string(), {{"validation_z", vz}, {"test_z", tz}});
  nn::ParameterStore               g(6007), e(6011), d(6029);
  std::vector<nn::ParameterStore*> stores{&g, &e, &d};
  {
    nn::NoGradGuard guard;
    m::BidirectionalGan(g, e, d, nn::zeros({1, 2}), nn::zeros({1, 2}));
  }
  auto snapshot = [&]() {
    Arrays out;
    for (int k = 0; k < 3; ++k)
      for (const auto& name : stores[k]->names())
        out.emplace(std::to_string(k) + "/" + name, stores[k]->at(name).detach().clone());
    return out;
  };
  auto forward = [&](const Tensor& x, const Tensor& z) {
    return Fields(m::BidirectionalGan(g, e, d, x, z));
  };
  auto evaluate = [&](const Tensor& x, const Tensor& z) {
    nn::NoGradGuard guard;
    return forward(x, z);
  };
  auto named_g = [&](const Tensor& x, const Tensor& z) {
    Arrays     out;
    const auto gradients = nn::grad(forward(x, z).at("eg_loss"), g.parameters());
    const auto names     = g.names();
    for (std::size_t k = 0; k < names.size(); ++k)
      out.emplace("0/" + names[k], gradients[k]);
    return out;
  };
  nn::OptimizerConfig config;
  config.kind    = nn::OptimizerKind::Adam;
  config.beta1   = .5;
  config.beta2   = .999;
  config.epsilon = 1e-8;
  nn::Optimizer               go(g, .0002, config), eo(e, .0002, config), disc(d, .0002, config);
  std::vector<nn::Optimizer*> optimizers{&go, &eo, &disc};
  Require(
      g.count() == 82 && e.count() == 82 && d.count() == 97 && g.size() + e.size() + d.size() == 12,
      "G 82 / E 82 / joint D 97 = 261 params, 12 tensors");
  SaveArrays((root / "initial_arrays.npz").string(), snapshot());
  SaveArrays((root / "initial_outputs.npz").string(), evaluate(test, tz));
  nn::BatchOrder order(400, 32, 6089);
  int            steps = 0;
  std::ofstream  history(root / "history.tsv"), batches(root / "batches.tsv");
  history.precision(17);
  history << "epoch\tdiscriminator_loss\teg_loss\n";
  batches << "epoch\tstep\trow\n";
  const auto started = std::chrono::steady_clock::now();
  for (int epoch = 1; epoch <= epochs; ++epoch) {
    const Tensor noise = Gaussian2(400, 6067 + epoch);
    order.begin_epoch();
    for (;;) {
      const auto rows = order.next();
      if (rows.empty())
        break;
      const Tensor x = nn::take_rows(fit, rows), z = nn::take_rows(noise, rows);
      if (!steps)
        SaveArrays((root / "first_forward.npz").string(), evaluate(x, z));
      Arrays g_gradient_before_e;
      for (int group : {2, 1, 0}) {
        const auto before = snapshot();
        if (!steps && group == 1)
          g_gradient_before_e = named_g(x, z);
        if (!steps && group == 0) {
          Require(
              Equal(named_g(x, z), g_gradient_before_e),
              "E update leaves G gradient EXACT unchanged: EG blocks independent with D fixed");
          SaveArrays((root / "g_gradient_before_e.npz").string(), g_gradient_before_e);
        }
        // Recompute after each preceding write; select exactly this store.
        const auto out         = forward(x, z);
        const auto derivatives = nn::grad(
            out.at(group == 2 ? "discriminator_loss" : "eg_loss"), stores[group]->parameters());
        optimizers[group]->step(derivatives);
        const auto after = snapshot();
        for (const auto& [name, value] : before)
          if (name.rfind(std::to_string(group) + "/", 0) != 0)
            Require(nn::equal_bits(value, after.at(name)), "unselected store unchanged");
      }
      for (auto row : rows)
        batches << epoch << '\t' << steps << '\t' << row << '\n';
      ++steps;
    }
    const auto v = evaluate(validation, vz);
    history << epoch << '\t' << Value(v, "discriminator_loss") << '\t' << Value(v, "eg_loss")
            << '\n';
    std::cout << "epoch " << epoch << ": D=" << Value(v, "discriminator_loss")
              << ", EG=" << Value(v, "eg_loss") << std::endl;
  }
  const double seconds =
      std::chrono::duration<double>(std::chrono::steady_clock::now() - started).count();

  const auto checkpoint = (root / "final.npz").string();
  Require(
      steps == 39 && go.iterations() == 39 && eo.iterations() == 39 && disc.iterations() == 39,
      "117 explicit updates");
  SaveArrays(checkpoint, snapshot());
  nn::ParameterStore               restored_g(1), restored_e(2), restored_d(3);
  std::vector<nn::ParameterStore*> restored{&restored_g, &restored_e, &restored_d};
  {
    nn::NoGradGuard guard;
    m::BidirectionalGan(restored_g, restored_e, restored_d, nn::zeros({1, 2}), nn::zeros({1, 2}));
  }
  for (const auto& [name, value] : nn::load_npz(checkpoint))
    restored.at(name[0] - '0')->set(name.substr(2), value);
  auto restored_arrays = [&]() {
    Arrays out;
    for (int k = 0; k < 3; ++k)
      for (const auto& name : restored[k]->names())
        out.emplace(std::to_string(k) + "/" + name, restored[k]->at(name).detach().clone());
    return out;
  };
  auto deployed_evaluate = [&](const Tensor& x, const Tensor& z) {
    nn::NoGradGuard guard;
    return Fields(m::BidirectionalGan(restored_g, restored_e, restored_d, x, z));
  };
  auto generate = [&](const Tensor& z) {
    nn::NoGradGuard guard;
    return m::BiganMap(restored_g, z);
  };
  auto encode = [&](const Tensor& x) {
    nn::NoGradGuard guard;
    return m::BiganMap(restored_e, x);
  };
  auto score_pair = [&](const Tensor& x, const Tensor& code) {
    nn::NoGradGuard guard;
    return m::BiganJointScore(restored_d, x, code);
  };
  Require(Equal(snapshot(), restored_arrays()), "all 12 vars restore exact");
  const auto   before = restored_arrays();
  const auto   output = deployed_evaluate(test, tz);
  const Tensor fake = generate(tz), encoded = encode(test);
  Require(
      Equal(fake, output.at("fake")) && Equal(encoded, output.at("encoded")),
      "noise ONLY generation / data ONLY encoding");
  const double parity = std::max(
      MaxAbsDiff(generate(nn::take_rows(tz, {0})), nn::take_rows(fake, {0})),
      MaxAbsDiff(encode(nn::take_rows(test, {0})), nn::take_rows(encoded, {0})));
  Require(parity < 2e-6, "both G/E batch parity");
  const Tensor changed_z = Gaussian2(128, 6073), changed = generate(changed_z);
  Require(!Equal(changed, fake), "G responds to noise");
  const Tensor pair = score_pair(test, encoded);
  Require(Equal(pair, output.at("real_score")), "joint D pair only parity");
  const Tensor zeros     = nn::zeros({128, 2});
  const Tensor zero_code = score_pair(test, zeros), zero_image = score_pair(zeros, encoded);
  const double code_effect  = MaxAbsDiff(pair, zero_code),
               image_effect = MaxAbsDiff(pair, zero_image);
  Require(code_effect > 1e-5 && image_effect > 1e-5, "D uses BOTH joint pair parts");
  SaveArrays(
      (root / "pair_controls.npz").string(),
      {{"pair", pair},
       {"zero_code", zero_code},
       {"zero_image", zero_image},
       {"changed_z", changed_z},
       {"changed_fake", changed}});
  Require(Equal(before, restored_arrays()), "immutable all G/E/D inference");
  SaveArrays((root / "outputs.npz").string(), output);
  const int outside_gen    = Plot(root / "generated.png", test, fake);
  const int outside_latent = Plot(root / "encoded.png", tz, encoded);
  const int outside_reconstruction =
      Plot(root / "reconstruction.png", test, output.at("reconstruction"));
  auto mse = [](const Tensor& a, const Tensor& b) {
    return nn::mean(nn::square(nn::cast(a, nn::DType::Float64) - nn::cast(b, nn::DType::Float64)))
        .item();
  };
  const double reconstruction_mse = mse(output.at("reconstruction"), test);
  const double latent_mse         = mse(output.at("latent_cycle"), tz);
  const double mean_mse =
      mse(nn::tile(nn::mean(nn::cast(fit, nn::DType::Float64), {0}, true), {128, 1}), test);
  std::ofstream meta(root / "metrics.json");
  meta.precision(17);
  meta << "{\"parameters\":261,\"epochs\":" << epochs << ",\"steps_per_group\":" << steps
       << ",\"optimizer_updates\":" << 3 * steps << ",\"selected_epoch_fixed_final\":" << epochs
       << ",\"test_discriminator_loss\":" << Value(output, "discriminator_loss")
       << ",\"test_eg_loss\":" << Value(output, "eg_loss")
       << ",\"test_reconstruction_mse\":" << reconstruction_mse
       << ",\"test_latent_cycle_mse\":" << latent_mse
       << ",\"fit_mean_reconstruction_mse\":" << mean_mse
       << ",\"joint_code_score_max_effect\":" << code_effect
       << ",\"joint_image_score_max_effect\":" << image_effect
       << ",\"outside_generated\":" << outside_gen << ",\"outside_encoded\":" << outside_latent
       << ",\"outside_reconstruction\":" << outside_reconstruction
       << ",\"single_batch_max_error\":" << parity << ",\"training_seconds\":" << seconds << "}\n";
  Require(bool(meta) && bool(history) && bool(batches), "complete BiGAN artifacts");
  history.close();
  batches.close();
  meta.close();
  std::cout << "fixed final=" << epochs << ", D/EG=" << Value(output, "discriminator_loss") << "/"
            << Value(output, "eg_loss") << ", untrained reconstruction MSE=" << reconstruction_mse
            << " vs mean=" << mean_mse << ", latent cycle MSE=" << latent_mse
            << "; joint paths/D then E then G/restore/immutable PASS (training " << seconds
            << " s)\nArtifacts: " << root.string() << "\nAll bidirectional_gan checks passed.\n";
  std::ifstream input(root / "history.tsv");
  std::string   header;
  std::getline(input, header);
  std::vector<double> epochs_axis, d_path, eg_path;
  double              epoch, dl, eg;
  while (input >> epoch >> dl >> eg) {
    epochs_axis.push_back(epoch);
    d_path.push_back(dl);
    eg_path.push_back(eg);
  }
  auto plot = dm::graphics::RPlot::create();
  plot.lines(epochs_axis, d_path, "Validation D", {37, 99, 235}, 2.)
      .points(epochs_axis, d_path, "", {37, 99, 235}, 4.)
      .lines(epochs_axis, eg_path, "Validation EG", {220, 38, 38}, 2.)
      .points(epochs_axis, eg_path, "", {220, 38, 38}, 4.)
      .x_label("Completed epoch; final3 fixed in advance")
      .y_label("Separate game objectives")
      .title("Validation diagnostics do not select the checkpoint")
      .save_svg("build/bigan_learning.svg");
}
```
