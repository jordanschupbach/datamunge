> Retain every validation record and the fixed final checkpoint

D includes real-domain CE; G includes fake-domain CE plus reconstruction10.
The validation curves therefore show those composite losses and reconstruction
L1 separately. They retain all three epochs, without smoothing. A smaller
adversarial objective does not establish visual quality or requested-domain
accuracy; the held-out diagnostics below evaluate those questions separately.

```{cpp, results="markdown", file="figures/star_learning.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
namespace n = dm::nn;
namespace m = n::models;
using A     = std::map<std::string, n::Tensor>;
A Read(const std::string& path) {
  A a;
  for (const auto& [key, value] : n::load_npz(path))
    a.emplace(key, value);
  return a;
}
int main() {
  auto p = dm::graphics::RPlot::create();
  p.y_limits(0, 10);
  std::vector<double> epoch, d, g, reconstruction;
  for (int e = 1; e <= 3; ++e) {
    auto a = Read("build/star_gan/probe-epoch" + std::to_string(e) + "-validation.npz");
    epoch.push_back(e);
    d.push_back(a.at("discriminator_loss").item());
    g.push_back(a.at("generator_loss").item());
    reconstruction.push_back(a.at("reconstruction_loss").item());
  }
  p.lines(epoch, d, "D composite", {37, 99, 235}, 2)
      .lines(epoch, g, "G composite", {220, 38, 38}, 2)
      .lines(epoch, reconstruction, "Roundtrip L1", {22, 163, 74}, 2)
      .x_label("Fixed epoch; final checkpoint is epoch3")
      .y_label("Held-out validation objective or mean L1")
      .title("All three validation records; scales are explicitly different")
      .save_svg("build/star_learning.svg");
}
