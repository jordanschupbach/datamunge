// result_end
> Inspect disjoint real fitting-domain examples

Each digit row shows one original-domain sample, a different inverted-domain
sample and another rotated-domain sample, selected by their original IDs.
These are independent observations rather than transformed paired copies.
Labels are used to make the diagnostic grid, never as network inputs. All
28x28 galleries enlarge pixels3 times with nearest sampling, four-pixel gray
gaps and no outer padding.

```{cpp, results="markdown", file="figures/star_real_domains.png", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
namespace n = dm::nn;
namespace m = n::models;
using A     = std::map<std::string, n::Tensor>;
A Read(const std::string& path) {
  A a;
  for (const auto& [key, value] : n::load_npz(path))
    a.emplace(key, value);
  return a;
}
int main() {
  auto a      = Read("build/star_gan/data.npz");
  auto labels = a.at("fit_digits").to_vector<int>(), domains = a.at("fit_domains").to_vector<int>();
  std::vector<n::Tensor> panels;
  for (int digit = 0; digit < 10; ++digit)
    for (int domain = 0; domain < 3; ++domain) {
      int row = -1;
      for (std::size_t i = 0; i < labels.size() && row < 0; ++i)
        if (labels[i] == digit && domains[i] == domain)
          row = i;
      if (row < 0)
        throw std::runtime_error("all digit/domain cases");
      panels.push_back(n::take_rows(a.at("fit_images"), {row}));
    }
  n::save_image_grid(
      n::concat(panels, 0), "build/star_real_domains.png", 3, 0, 1, 4, 220 / 255., 3);
}
