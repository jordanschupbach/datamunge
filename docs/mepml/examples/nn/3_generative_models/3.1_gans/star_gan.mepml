\alttext(A ten-by-nine gallery shows source/fake/known-target triplets for all ten digits under each of three source domains.)

> Measure the real classifier and generated requested-domain classifier separately

On180 test rows the image-only D classifies real domains with accuracy
.6833333, while generated images match requested domains only.3333333. The
scatter-style confusion display uses all three true/requested classes and all
three predicted classes in each panel. Marker radius is1+2*sqrt(count), increasing with the
number of held-out rows. This classifier is learned alongside G and is not an
independent perceptual evaluator. Domain recognition cannot establish digit
identity, texture fidelity or coverage.

```{cpp, results="markdown", file="figures/star_domain_confusion.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
namespace n = dm::nn;
namespace m = n::models;
using A     = std::map<std::string, n::Tensor>;
A Read(const std::string& path) {
  A a;
  for (const auto& [key, value] : n::load_npz(path))
    a.emplace(key, value);
  return a;
}
int main() {
  auto data = Read("build/star_gan/data.npz"), out = Read("build/star_gan/outputs.npz"),
       target = Read("build/star_gan/fixed_targets.npz");
  std::vector<double> x, y, size;
  for (int head = 0; head < 2; ++head) {
    auto truth = (head ? target.at("test") : data.at("test_domains")).to_vector<int>();
    auto probability =
        out.at(head ? "fake_domain_probability" : "real_domain_probability").to_vector<float>();
    int counts[3][3]{};
    for (int row = 0; row < 180; ++row) {
      int best = 0;
      for (int c = 1; c < 3; ++c)
        if (probability[row * 3 + c] > probability[row * 3 + best])
          best = c;
      ++counts[truth[row]][best];
    }
    for (int a = 0; a < 3; ++a)
      for (int c = 0; c < 3; ++c) {
        x.push_back(c + head * 5);
        y.push_back(a);
        size.push_back(counts[a][c]);
      }
  }
  auto p = dm::graphics::RPlot::create();
  p.y_limits(-.5, 4);
  for (std::size_t i = 0; i < x.size(); ++i)
    p.points(
        {x[i]},
        {y[i]},
        "",
        i < 9 ? dm::graphics::RGB{37, 99, 235} : dm::graphics::RGB{220, 38, 38},
        1. + std::sqrt(size[i]) * 2.);
  p.x_label("Predicted domain0/1/2 at x0/1/2(real) or5/6/7(generated)")
      .y_label("Observed original domain(real) / requested domain(generated)")
      .title("Real and generated domain confusion; marker radius1+2 sqrt(count)")
      .save_svg("build/star_domain_confusion.svg");
}
```
