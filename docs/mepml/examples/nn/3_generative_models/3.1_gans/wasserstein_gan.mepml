> Make the interpolation a detached leaf

For supplied real=(-2,0), fake=(2,0) and alpha=0,.25,.5,.75,1, the segment runs
from fake to real. The source creates xhat=(alpha*real+(1-alpha)*stop(fake)).detach()
and differentiates critic(xhat) with respect to that new leaf. All external
real/alpha/G paths stop; critic parameter paths through the resulting Jacobian
remain available when create_graph is enabled.

A supplied quadratic critic c(x)=.5*sum(x^2) makes this visible: J(x)=x, so its
penalty depends on where xhat lies. The toy below verifies unused external paths
after detaching and a nonzero alpha derivative when the detach is omitted. This
controlled critic is not the fitted tanh network.

```{cpp, results="markdown", file="figures/wgan_interpolation.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
  namespace n = dm::nn;
  auto t      = n::DType::Float64;
  auto real   = n::tile(n::tensor({-2., 0.}, {1, 2}, t), {5, 1}).requires_grad_(),
       fake   = n::tile(n::tensor({2., 0.}, {1, 2}, t), {5, 1}).requires_grad_(),
       alpha  = n::tensor({0., .25, .5, .75, 1.}, {5, 1}, t).requires_grad_();
  auto raw    = alpha * real + (1. - alpha) * fake;
  auto hat    = raw.detach();
  hat.requires_grad_();
  n::GradOptions graph;
  graph.create_graph     = true;
  auto           j       = n::grad(.5 * n::sum(n::square(hat)), {hat}, graph)[0];
  auto           penalty = n::mean(n::square(n::sqrt(n::sum(n::square(j), {1}) + 1e-12) - 1.));
  n::GradOptions unused;
  unused.allow_unused = true;
  auto stopped        = n::grad(penalty, {real, fake, alpha}, unused);
  for (auto& v : stopped)
    if (v.defined())
      throw std::runtime_error("external interpolation path");
  auto live_j       = n::grad(.5 * n::sum(n::square(raw)), {raw}, graph)[0];
  auto live_penalty = n::mean(n::square(n::sqrt(n::sum(n::square(live_j), {1}) + 1e-12) - 1.));
  auto da           = n::grad(live_penalty, {alpha})[0];
  if (n::max(n::abs(da)).item() < 1)
    throw std::runtime_error("missing non-detached control");
  std::print(
      "Detached external gradients undefined; non-detached max alpha partial={}.\n",
      n::max(n::abs(da)).item());
  auto xs = n::select(hat, 1, 0).to_vector<double>(), ys = n::select(hat, 1, 1).to_vector<double>();
  auto p = dm::graphics::RPlot::create();
  p.x_limits(-3, 3)
      .y_limits(-1, 1)
      .lines(xs, ys, "Supplied interpolation segment", {37, 99, 235}, 2)
      .points(xs, ys, "", {37, 99, 235}, 5)
      .x_label("Coordinate1; alpha0 at fake2, alpha1 at real-2")
      .y_label("Coordinate2")
      .title("A new interpolation leaf stops external paths")
      .save_svg("build/wgan_interpolation.svg");
}
```
