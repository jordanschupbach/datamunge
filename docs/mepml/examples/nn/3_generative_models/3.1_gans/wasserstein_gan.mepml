> Keep the penalty’s critic-parameter gradient separate from the base game

At the penalty trial's first critic batch, compute three fresh forwards at the
same initial weights: the base critic gradient,10 times the norm-penalty gradient,
and the full critic gradient. The last critic bias has an unused pure-penalty
path, represented by an explicit zero in the recorded65-coordinate vector. The
base-game real/fake means also cancel that bias partial. No optimizer is run in
this component check. All65 coordinates, their Float32 sum error and the three
vector norms are retained; an independent closed-form oracle checks the components.

```{cpp, results="markdown", file="figures/wgan_gradient_components.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
namespace n = dm::nn;
using A     = std::map<std::string, n::Tensor>;
A Read(const std::string& file) {
  A a;
  for (const auto& [k, v] : n::load_npz(file))
    a.emplace(k, v);
  return a;
}
int main() {
  n::ParameterStore g(5501), c(5503);
  auto              priors = Read("build/wasserstein_gan/probe-priors.npz");
  auto x = priors.at("first_real"), z = priors.at("critic_z0"), a = priors.at("critic_alpha0");
  n::models::WassersteinGan(g, c, x, z, a);
  for (const auto& [key, value] :
       n::load_npz("build/wasserstein_gan/gradient_penalty/initial_arrays.npz"))
    (key[0] == '0' ? g : c).set(key.substr(2), value);
  auto           base    = n::models::WassersteinGan(g, c, x, z, a, 0);
  auto           bg      = n::grad(base.critic_loss, c.parameters());
  auto           partial = n::models::WassersteinGan(g, c, x, z, a, 10);
  n::GradOptions unused;
  unused.allow_unused     = true;
  auto               pg   = n::grad(partial.penalty, c.parameters(), unused);
  auto               full = n::models::WassersteinGan(g, c, x, z, a, 10);
  auto               fg   = n::grad(full.critic_loss, c.parameters());
  std::vector<float> b, p, f;
  auto               parameters = c.parameters();
  for (std::size_t k = 0; k < parameters.size(); ++k) {
    if (!pg[k].defined())
      pg[k] = n::zeros_like(parameters[k]);
    auto bv = bg[k].to_vector<float>(), pv = (10. * pg[k]).to_vector<float>(),
         fv = fg[k].to_vector<float>();
    b.insert(b.end(), bv.begin(), bv.end());
    p.insert(p.end(), pv.begin(), pv.end());
    f.insert(f.end(), fv.begin(), fv.end());
  }
  auto bt = n::from_vector(b, {65}), pt = n::from_vector(p, {65}), ft = n::from_vector(f, {65});
  auto error = n::max(n::abs(ft - bt - pt)).item();
  if (error > 2e-5)
    throw std::runtime_error("gradient vector sum");
  n::save_npz(
      "build/wasserstein_gan/gradient-components.npz",
      {{"base", bt}, {"weighted_penalty", pt}, {"full", ft}});
  std::vector<double> values;
  for (auto& v : {bt, pt, ft})
    values.push_back(std::log10(n::sqrt(n::sum(n::square(v))).item()));
  std::print("All65 critic coordinates; full-base-weightedPenalty max error{}.\n", error);
  auto plot = dm::graphics::RPlot::create();
  plot.y_limits(-3, 3)
      .points({1., 2., 3.}, values, "", {37, 99, 235}, 6)
      .x_label("1 base C gradient;2 weighted GP gradient;3 full C gradient")
      .y_label("log10 Euclidean parameter-gradient norm")
      .title("The penalty supplies a critic-parameter path")
      .save_svg("build/wgan_gradient_components.svg");
}
```
