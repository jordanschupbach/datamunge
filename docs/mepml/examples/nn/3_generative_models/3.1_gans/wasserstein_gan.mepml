  for (const auto& [k, v] : n::load_npz(file))
    a.emplace(k, v);
  return a;
}
int main() {
  std::vector<double> rank;
  for (int k = 0; k < 128; ++k)
    rank.push_back(k + 1);
  auto c = Read("build/wasserstein_gan/clipped/probe-final-output.npz")
               .at("norm")
               .to_vector<double>(),
       g = Read("build/wasserstein_gan/gradient_penalty/probe-final-output.npz")
               .at("norm")
               .to_vector<double>();
  std::sort(c.begin(), c.end());
  std::sort(g.begin(), g.end());
  double top = 1.5 * std::max({1., c.back(), g.back()});
  auto   p   = dm::graphics::RPlot::create();
  p.y_limits(-.02, top)
      .lines(rank, c, "Clipped", {37, 99, 235}, 2)
      .lines(rank, g, "Gradient penalty", {220, 38, 38}, 2)
      .lines({1., 128.}, {1., 1.}, "Unit norm reference", {120, 120, 120}, 1)
      .x_label("Sorted held-out interpolation norm rank")
      .y_label("sqrt(sum(J^2)+1e-12)")
      .title("Every held-out interpolation norm is retained")
      .save_svg("build/wgan_norms.svg");
  std::print(
      "Clipped norm range={}..{}; GP range={}..{}.\n", c.front(), c.back(), g.front(), g.back());
}
