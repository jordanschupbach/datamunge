> Keep both full fitting schedules and every selected write visible

Clipped WGAN uses RMSProp5e-5,rho.9,epsilon1e-8 inside the square root. WGAN-GP
uses Adam1e-4,beta1=0,beta2=.9,epsilon1e-8 outside its bias-corrected square root,
and penalty coefficient10. Both have separate optimizer states for G and C.
D and G objectives consume raw critic scores; there is no sigmoid/classifier.

Every critic phase uses fresh z(seed5601+Cstep) and alpha(seed6601+Cstep), with
the same real batch for its three critic steps. G then gets fresh z(seed7601+Gstep)
and alpha(seed8601+Gstep). Validation/test noise seeds5527/5531 and alpha5537/5549
remain fixed. `MidpointUniform` consumes one local MT word per alpha, with Double
midpoint arithmetic before one final Float32 cast. Source Gaussian banks preserve
their own draw order. No other RNG or a validation/test score selects training.

The complete program preserves all original artifacts and stores every first-step
phase derivative and final probe. It uses native Image/draw_circle to preserve the
source's exact512x512 PNG artifacts; the report's labelled numerical plots use
RPlot. Checkpoints restore independent stores and both optimizers remain caller-owned.
All unselected-store values stay bit exact at each update; no clip occurs during
the penalty trial. Native API calls calculate the symbolic input derivative with
create_graph=true for training and false under no-grad for evaluation.

```{cpp, results="markdown", file="figures/wgan_gap.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <chrono>
#include <cmath>
#include <dm/dm.hpp>
#include <fstream>
#include <iostream>

namespace nn = dm::nn;
namespace m  = nn::models;
using Arrays = std::map<std::string, nn::Tensor>;
using nn::Tensor;

namespace {
void Require(bool condition, const std::string& message) {
  if (!condition)
    throw std::runtime_error(message);
}
void Near(double actual, double expected, double tolerance, const std::string& message) {
  Require(std::abs(actual - expected) <= tolerance, message);
}
void SaveArrays(const std::string& path, const Arrays& a) {
  nn::save_npz(path, nn::NamedTensors(a.begin(), a.end()));
}
bool Equal(const Tensor& a, const Tensor& b) {
  return nn::equal_bits(a, b);
}
bool Equal(const Arrays& a, const Arrays& b) {
  if (a.size() != b.size())
    return false;
  for (const auto& [key, value] : a)
    if (!b.count(key) || !Equal(value, b.at(key)))
      return false;
  return true;
}
Tensor Gaussian(std::int64_t rows, std::int64_t width, std::uint64_t seed) {
  return nn::cast(
      m::GaussianNoise({rows, width}, 1, seed).reshape({rows, width}), nn::DType::Float32);
}
double MaxAbsDiff(const Tensor& a, const Tensor& b) {
  return nn::max(nn::abs(nn::cast(a, nn::DType::Float64) - nn::cast(b, nn::DType::Float64))).item();
}
void Finite(const Arrays& a, const std::string& message) {
  for (auto& [key, v] : a)
    for (double x : v.to_vector<double>())
      Require(std::isfinite(x), message + key);
}
Arrays Fields(const m::WassersteinGanOutput& o) {
  return {
      {"fake", o.fake},
      {"real_score", o.real_score},
      {"fake_score", o.fake_score},
      {"interpolation", o.interpolation},
      {"input_gradient", o.input_gradient},
      {"symbolic_input_gradient", o.symbolic_input_gradient},
      {"norm", o.norm},
      {"penalty", o.penalty},
      {"critic_gap", o.critic_gap},
      {"generator_loss", o.generator_loss},
      {"critic_loss", o.critic_loss}};
}
Tensor Alpha(std::int64_t rows, std::uint32_t seed) {
  return nn::MidpointUniform(rows, 1, seed);
}
Tensor Points(std::int64_t rows, std::uint32_t seed) {
  return m::GaussianRingPoints(rows, seed);
}
// Preserve the source's exact raster artifact using the existing native drawing API.
int Plot(const std::filesystem::path& path, const Tensor& real, const Tensor& fake) {
  namespace im = dm::image;
  im::Image image(512, 512, im::ImageMode::RGB, im::Pixel{248, 248, 248});
  int       outside = 0;
  for (int group : {0, 1}) {
    auto points = (group ? fake : real).to_vector<float>();
    for (std::size_t k = 0; k < points.size() / 2; ++k) {
      double px = points[2 * k], py = points[2 * k + 1];
      if (std::abs(px) > 3 || std::abs(py) > 3) {
        ++outside;
        continue;
      }
      int x = int(std::floor((px + 3) / 6 * 511 + .5)),
          y = int(std::floor((3 - py) / 6 * 511 + .5));
      im::draw_circle(
          image, x, y, 2, group ? im::Pixel{210, 65, 65} : im::Pixel{65, 65, 210}, true);
    }
  }
  im::write_png(image, path.string());
  return outside;
}
double Scalar(const Arrays& a, const std::string& key) {
  return a.at(key).item();
}

void Train(
    const std::filesystem::path& root,
    const Tensor&                fit,
    const Tensor&                validation,
    const Tensor&                test,
    int                          epochs,
    bool                         gp,
    const std::filesystem::path& init) {
  const auto started = std::chrono::steady_clock::now();
  const auto dir     = root / (gp ? "gradient_penalty" : "clipped");
  std::filesystem::create_directories(dir);
  const Tensor vz = Gaussian(128, 2, 5527), tz = Gaussian(128, 2, 5531), va = Alpha(128, 5537),
               ta = Alpha(128, 5549);
  nn::ParameterStore               g(5501), c(5503);
  std::vector<nn::ParameterStore*> stores{&g, &c};
  {
    nn::NoGradGuard guard;
    m::WassersteinCritic(c, m::WassersteinGenerate(g, nn::zeros({1, 2})));
  }
  auto snapshot = [&]() {
    Arrays a;
    for (int group : {0, 1})
      for (const auto& name : stores[group]->names())
        a.emplace(std::to_string(group) + "/" + name, stores[group]->at(name).detach().clone());
    return a;
  };
  auto load = [&](const std::string& file) {
    for (const auto& [key, value] : nn::load_npz(file)) {
      Require(
          key.size() > 2 && (key[0] == '0' || key[0] == '1') && key[1] == '/',
          "known checkpoint prefix");
      auto& store = *stores[key[0] - '0'];
      Require(
          store.contains(key.substr(2)) && store.at(key.substr(2)).shape() == value.shape(),
          "known checkpoint shape");
      store.set(key.substr(2), value);
    }
  };
  auto evaluate = [&](const Tensor& x, const Tensor& z, const Tensor& alpha) {
    nn::NoGradGuard guard;
    auto            out = Fields(m::WassersteinGan(g, c, x, z, alpha, gp ? 10. : 0., false));
    Finite(out, "finite WGAN fields");
    return out;
  };
  auto capture = [&](int group, const Tensor& x, const Tensor& z, const Tensor& alpha) {
    auto out = m::WassersteinGan(g, c, x, z, alpha, gp ? 10. : 0., true);
    auto values =
        nn::grad(group ? out.critic_loss : out.generator_loss, stores[group]->parameters());
    Arrays a;
    auto   names = stores[group]->names();
    for (std::size_t k = 0; k < names.size(); ++k)
      a.emplace(std::to_string(group) + "/" + names[k], values[k]);
    return a;
  };
  nn::OptimizerConfig config;
  config.kind    = gp ? nn::OptimizerKind::Adam : nn::OptimizerKind::RMSProp;
  config.beta1   = 0;
  config.beta2   = .9;
  config.rho     = .9;
  config.epsilon = 1e-8;
  nn::Optimizer go(g, gp ? .0001 : .00005, config), critic(c, gp ? .0001 : .00005, config);
  std::vector<nn::Optimizer*> optimizers{&go, &critic};
  if (!gp)
    m::ClipWassersteinCritic(c); // once before fitting, including both biases.
  if (!init.empty())
    load((init / (gp ? "gradient_penalty" : "clipped") / "initial_arrays.npz").string());
  Require(g.count() == 82 && c.count() == 65, "147 parameters 8 tensors");
  SaveArrays((dir / "initial_arrays.npz").string(), snapshot());
  SaveArrays((dir / "probe-initial.npz").string(), snapshot());
  nn::BatchOrder batches_order(400, 32, 5557);
  int            gsteps = 0, dsteps = 0;
  double         clipmax = 0;
  std::ofstream  history(dir / "history.tsv"), batches(dir / "batches.tsv");
  history.precision(17);
  history << "epoch\tcritic_loss\tgenerator_loss\tcritic_gap\tpenalty\n";
  batches << "epoch\tstep\trow\n";
  for (int epoch = 1; epoch <= epochs; ++epoch) {
    batches_order.begin_epoch();
    for (;;) {
      const auto rows = batches_order.next();
      if (rows.empty())
        break;
      const auto   n = std::int64_t(rows.size());
      const Tensor x = nn::take_rows(fit, rows);
      for (int phase = 0; phase < 3; ++phase) {
        const Tensor z = Gaussian(n, 2, 5601 + dsteps), a = Alpha(n, 6601 + dsteps);
        if (!gsteps && phase == 0) {
          const auto f = evaluate(x, z, a);
          std::cout << (gp ? "GP" : "clip")
                    << " first critic batch: loss=" << Scalar(f, "critic_loss")
                    << ", gap=" << Scalar(f, "critic_gap") << ", penalty=" << Scalar(f, "penalty")
                    << '\n';
        }
        const auto before = snapshot();
        if (!gsteps)
          SaveArrays(
              (dir / ("probe-forward-c" + std::to_string(phase) + ".npz")).string(),
              evaluate(x, z, a));
        // Actual symbolic input derivative retains the critic path for GP.
        const auto out      = m::WassersteinGan(g, c, x, z, a, gp ? 10. : 0., true);
        const auto gradient = nn::grad(out.critic_loss, c.parameters());
        if (!gsteps) {
          Arrays fields;
          auto   names = c.names();
          for (std::size_t k = 0; k < names.size(); ++k)
            fields.emplace("1/" + names[k], gradient[k]);
          SaveArrays(
              (dir / ("probe-gradient-c" + std::to_string(phase) + ".npz")).string(), fields);
        }
        critic.step(gradient); // selected C parameters only; new noise every critic step.
        if (!gsteps)
          SaveArrays(
              (dir / ("probe-after-step-c" + std::to_string(phase) + ".npz")).string(), snapshot());
        if (!gp)
          m::ClipWassersteinCritic(c); // AFTER every C write, before the next forward.
        if (!gsteps)
          SaveArrays(
              (dir / ("probe-after-c" + std::to_string(phase) + ".npz")).string(), snapshot());
        const auto after = snapshot();
        for (const auto& [key, value] : before)
          if (key[0] == '0')
            Require(Equal(value, after.at(key)), "critic step never changes G");
          else if (!gp)
            for (float v : after.at(key).to_vector<float>()) {
              clipmax = std::max(clipmax, std::abs(double(v)));
              Require(std::abs(v) <= .01f, "ALL critic weights clipped AFTER each step");
            }
        ++dsteps;
      }
      const Tensor z = Gaussian(n, 2, 7601 + gsteps), a = Alpha(n, 8601 + gsteps);
      const auto   before = snapshot();
      if (!gsteps)
        SaveArrays((dir / "probe-forward-g.npz").string(), evaluate(x, z, a));
      // Fresh G forward through the current critic, after all three C updates/clips.
      const auto out      = m::WassersteinGan(g, c, x, z, a, gp ? 10. : 0., true);
      const auto gradient = nn::grad(out.generator_loss, g.parameters());
      if (!gsteps) {
        Arrays fields;
        auto   names = g.names();
        for (std::size_t k = 0; k < names.size(); ++k)
          fields.emplace("0/" + names[k], gradient[k]);
        SaveArrays((dir / "probe-gradient-g.npz").string(), fields);
      }
      go.step(gradient); // no clipping after G.
      if (!gsteps)
        SaveArrays((dir / "probe-after-g.npz").string(), snapshot());
      const auto after = snapshot();
      for (const auto& [key, value] : before)
        if (key[0] == '1')
          Require(Equal(value, after.at(key)), "G step never changes critic");
      for (auto row : rows)
        batches << epoch << '\t' << gsteps << '\t' << row << '\n';
      ++gsteps;
    }
    const auto v = evaluate(validation, vz, va);
    history << epoch;
    for (auto key : {"critic_loss", "generator_loss", "critic_gap", "penalty"})
      history << '\t' << Scalar(v, key);
    history << '\n';
    std::cout << (gp ? "GP" : "clip") << " epoch " << epoch
              << ": critic gap=" << Scalar(v, "critic_gap") << ", penalty=" << Scalar(v, "penalty")
              << std::endl;
  }
  const double seconds =
      std::chrono::duration<double>(std::chrono::steady_clock::now() - started).count();
  const auto final_path = (dir / "final.npz").string();
  SaveArrays(final_path, snapshot());
  Require(go.iterations() == 39 && critic.iterations() == 117, "39 G and117 C writes");
  nn::ParameterStore               rg(5501), rc(5503);
  std::vector<nn::ParameterStore*> restored{&rg, &rc};
  {
    nn::NoGradGuard guard;
    m::WassersteinCritic(rc, m::WassersteinGenerate(rg, nn::zeros({1, 2})));
  }
  if (!gp)
    m::ClipWassersteinCritic(rc);
  for (const auto& [key, value] : nn::load_npz(final_path))
    restored[key[0] - '0']->set(key.substr(2), value);
  auto restored_arrays = [&]() {
    Arrays a;
    for (int k : {0, 1})
      for (const auto& name : restored[k]->names())
        a.emplace(std::to_string(k) + "/" + name, restored[k]->at(name).detach().clone());
    return a;
  };
  auto restored_evaluate = [&](const Tensor& x, const Tensor& z, const Tensor& alpha) {
    nn::NoGradGuard guard;
    return Fields(m::WassersteinGan(rg, rc, x, z, alpha, gp ? 10. : 0., false));
  };
  auto generate = [&](const Tensor& z) {
    nn::NoGradGuard guard;
    return m::WassersteinGenerate(rg, z);
  };
  Require(Equal(snapshot(), restored_arrays()), "all 8 vars restore exact");
  const auto before = restored_arrays();
  const auto output = restored_evaluate(test, tz, ta);
  SaveArrays((dir / "probe-final-output.npz").string(), output);
  for (int group : {0, 1})
    SaveArrays(
        (dir / ("probe-final-gradient-" + std::to_string(group) + ".npz")).string(),
        capture(group, test, tz, ta));
  const auto hand     = output.at("input_gradient").to_vector<float>(),
             symbolic = output.at("symbolic_input_gradient").to_vector<float>();
  double jacobian     = 0;
  for (std::size_t i = 0; i < hand.size(); ++i) {
    jacobian = std::max(jacobian, std::abs(double(hand[i]) - symbolic[i]));
    Near(hand[i], symbolic[i], 2e-6, "explicit Jacobian matches actual input gradient");
  }
  const Tensor repeat = generate(tz);
  Require(Equal(repeat, output.at("fake")), "noise ONLY generation exact");
  const Tensor changed = generate(Gaussian(128, 2, 5573));
  const Tensor zero    = generate(nn::zeros({128, 2}));
  SaveArrays((dir / "probe-noise-controls.npz").string(), {{"changed", changed}, {"zero", zero}});
  Require(!Equal(changed, repeat), "changed noise affects G");
  const auto single = generate(nn::take_rows(tz, {0})).to_vector<float>(),
             all    = repeat.to_vector<float>();
  double parity     = 0;
  for (int j = 0; j < 2; ++j)
    parity = std::max(parity, std::abs(double(single[j]) - all[j]));
  Require(parity < 2e-6, "single batch parity");
  Require(Equal(before, restored_arrays()), "immutable inference");
  const int     outside = Plot(dir / "samples.png", test, repeat);
  std::ofstream meta(dir / "metrics.json");
  meta.precision(17);
  meta << "{\"parameters\":147,\"gradient_penalty\":" << (gp ? "true" : "false")
       << ",\"epochs\":" << epochs << ",\"generator_steps\":" << gsteps
       << ",\"critic_steps\":" << dsteps << ",\"maximum_clipped_critic_parameter\":" << clipmax
       << ",\"plot_outside_count\":" << outside << ",\"single_batch_max_error\":" << parity
       << ",\"jacobian_max_error\":" << jacobian;
  for (auto key : {"critic_loss", "generator_loss", "critic_gap", "penalty"})
    meta << ",\"test_" << key << "\":" << Scalar(output, key);
  meta << "}\n";
  Require(bool(meta) && bool(history) && bool(batches), "complete WGAN records");
  meta.close();
  history.close();
  batches.close();
  std::cout << (gp ? "GP" : "clip") << ": D steps=" << dsteps << ", G steps=" << gsteps
            << ", test gap=" << Scalar(output, "critic_gap") << ", GP=" << Scalar(output, "penalty")
            << ", critic loss=" << Scalar(output, "critic_loss")
            << ", Jacobian max error=" << jacobian
            << "; isolation/clip/restore/noiseOnly/batch/immutable PASS (training " << seconds
            << " s)" << std::endl;
}

} // namespace
int main() {
  const std::filesystem::path root = "build/wasserstein_gan";
  std::filesystem::create_directories(root);
  const int epochs = 3;
  auto      fit = Points(400, 5507), validation = Points(128, 5519), test = Points(128, 5521);
  SaveArrays(
      (root / "data.npz").string(), {{"fit", fit}, {"validation", validation}, {"test", test}});
  nn::BatchOrder first(400, 32, 5557);
  first.begin_epoch();
  Arrays priors{
      {"first_real", nn::take_rows(fit, first.next())},
      {"validation_z", Gaussian(128, 2, 5527)},
      {"test_z", Gaussian(128, 2, 5531)},
      {"validation_alpha", Alpha(128, 5537)},
      {"test_alpha", Alpha(128, 5549)},
      {"g_z", Gaussian(32, 2, 7601)},
      {"g_alpha", Alpha(32, 8601)}};
  for (int i = 0; i < 3; ++i) {
    priors.emplace("critic_z" + std::to_string(i), Gaussian(32, 2, 5601 + i));
    priors.emplace("critic_alpha" + std::to_string(i), Alpha(32, 6601 + i));
  }
  SaveArrays((root / "probe-priors.npz").string(), priors);
  Train(root, fit, validation, test, epochs, false, {});
  Train(root, fit, validation, test, epochs, true, {});
  std::cout << "All Wasserstein variants complete with explicit native updates.\n";
  std::vector<double> plot_epochs, clip_gap, gp_gap;
  for (auto variant : {"clipped", "gradient_penalty"}) {
    std::ifstream file(root / variant / "history.tsv");
    std::string   line;
    std::getline(file, line);
    double epoch, cl, gl, gap, penalty;
    while (file >> epoch >> cl >> gl >> gap >> penalty) {
      if (std::string(variant) == "clipped") {
        plot_epochs.push_back(epoch);
        clip_gap.push_back(gap);
      } else
        gp_gap.push_back(gap);
    }
  }
  auto plot = dm::graphics::RPlot::create();
  plot.y_limits(-.02, .015)
      .lines(plot_epochs, clip_gap, "Clipped RMSProp", {37, 99, 235}, 2)
      .points(plot_epochs, clip_gap, "", {37, 99, 235}, 4)
      .lines(plot_epochs, gp_gap, "Gradient penalty Adam", {220, 38, 38}, 2)
      .points(plot_epochs, gp_gap, "", {220, 38, 38}, 4)
      .x_label("Completed epoch; fixed final3")
      .y_label("Validation mean(real score)-mean(fake score)")
      .title("An unconverged critic gap is not a certified distance")
      .save_svg("build/wgan_gap.svg");
}
