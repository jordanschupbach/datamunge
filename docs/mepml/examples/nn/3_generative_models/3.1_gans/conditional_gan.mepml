  d.node("x", {-12, 5}, "Real pixels784\n+ class10", s)
      .node("dr", {18, 5}, "Shared D\ntanh32 → raw1", s)
      .node("z", {-12, -5}, "Noise16\n+ class10", s)
      .node("g", {-2, -5}, "G: tanh32\nsigmoid784", s)
      .node("f", {8, -5}, "Generated pixels784\n+ class10", s)
      .node("df", {18, -5}, "Same D parameters", s)
      .edge("x", "dr")
