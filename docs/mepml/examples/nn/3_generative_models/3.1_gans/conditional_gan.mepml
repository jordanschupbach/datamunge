> Complete experiment: two parameter stores and 192 explicit writes

| Store | Creation order and mapping | Leaves | Values | Seed |
|---|---|---:|---:|---:|
| G | hidden W,b then output W,b;16 +10 condition→tanh32→sigmoid784 |4|26736|5101|
| D | hidden W,b then output W,b;784 +10 condition→tanh32→raw1 |4|25473|5113|

Each Adam state uses .0002,β1=.5,β2=.999,ε=1e-8. BatchOrder(1000,32,4847)
visits each fitting row once per epoch:31 full batches and an eight-row tail. Training
Gaussian banks use4862,4863,4864; fixed validation/test banks use4823/4831. The native
Box–Muller bank is computed in Double and cast once to Float32. All source IDs and
3000 fitting-row visits are retained. Each minibatch writes D, recomputes, then writes G.
Only the selected store is passed to its optimizer; there is no shared Adam clock.

The editable program includes preparation, all fitting, first-write ownership checks,
checkpoint save/restore, standalone generation and immutable controls. The native forward
returns live endpoints only; coarse MMD is added explicitly during evaluation, not hidden
inside every gradient computation. The final third epoch is fixed before the run.
One discrete label vector conditions the matching real and generated rows; continuous data/noise remain differentiable.

```{cpp, results="markdown", file="figures/conditional_gan_learning.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <chrono>
#include <cmath>
#include <dm/dm.hpp>
#include <fstream>
#include <iostream>

namespace nn = dm::nn;
namespace m  = nn::models;
using Arrays = std::map<std::string, nn::Tensor>;
using nn::Tensor;

namespace {
void Require(bool condition, const std::string& message) {
  if (!condition)
    throw std::runtime_error(message);
}
void Near(double actual, double expected, double tolerance, const std::string& message) {
  Require(std::abs(actual - expected) <= tolerance, message);
}
void SaveArrays(const std::string& path, const Arrays& a) {
  nn::save_npz(path, nn::NamedTensors(a.begin(), a.end()));
}
bool Equal(const Tensor& a, const Tensor& b) {
  return nn::equal_bits(a, b);
}
bool Equal(const Arrays& a, const Arrays& b) {
  if (a.size() != b.size())
    return false;
  for (const auto& [key, value] : a)
    if (!b.count(key) || !Equal(value, b.at(key)))
      return false;
  return true;
}
Tensor Gaussian(std::int64_t rows, std::int64_t width, std::uint64_t seed) {
  return nn::cast(
      m::GaussianNoise({rows, width}, 1, seed).reshape({rows, width}), nn::DType::Float32);
}
double MaxAbsDiff(const Tensor& a, const Tensor& b) {
  return nn::max(nn::abs(nn::cast(a, nn::DType::Float64) - nn::cast(b, nn::DType::Float64))).item();
}
void Mosaic(const std::filesystem::path& path, const Tensor& images, std::int64_t columns) {
  nn::save_image_grid(
      images.reshape({images.size(0), 28, 28, 1}), path.string(), columns, 0, 1, 4, 220 / 255., 3);
}
Arrays Fields(const m::ConditionalGanOutput& o) {
  Arrays a{
      {"fake", o.fake},
      {"real_logit", o.real_logit},
      {"fake_logit", o.fake_logit},
      {"real_probability", o.real_probability},
      {"fake_probability", o.fake_probability},
      {"discriminator_loss", o.discriminator_loss},
      {"generator_loss", o.generator_loss}};
  return a;
}

double Value(const Arrays& a, const std::string& key) {
  return a.at(key).item();
}

/// Logistic GAN algebra at extreme logits: finite losses and gradients, and
/// a strong non-saturating G gradient when D is confident a sample is fake.
void Algebra(const std::filesystem::path& root) {
  Tensor real = nn::tensor({-80, -2, 2, 80}, {4, 1}), fake = nn::tensor({80, 2, -2, -80}, {4, 1});
  real.requires_grad_();
  fake.requires_grad_();
  const auto loss = m::LogisticGanObjectives(real, fake);
  const auto dg   = nn::grad(loss.discriminator, {real, fake});
  const auto gg   = nn::grad(loss.generator, {fake});
  Arrays     out{
          {"real", real.detach()},
          {"fake", fake.detach()},
          {"discriminator_loss", loss.discriminator.detach()},
          {"generator_loss", loss.generator.detach()},
          {"d_real_gradient", dg[0]},
          {"d_fake_gradient", dg[1]},
          {"g_fake_gradient", gg[0]}};
  for (const auto& [key, value] : out)
    for (double x : value.to_vector<double>())
      Require(std::isfinite(x), "finite " + key);
  Require(gg[0].at({3, 0}) < -.24, "non-saturating G has strong gradient when D confident fake");
  std::cout << "logistic algebra: D loss=" << loss.discriminator.item()
            << ", G loss=" << loss.generator.item() << ", dG/dfake=" << gg[0].values_str() << '\n';
  SaveArrays((root / "logistic_algebra.npz").string(), out);
}

} // namespace
int main() {
  const std::filesystem::path root   = "build/conditional_gan";
  const int                   epochs = 3;
  const auto                  data = std::filesystem::path(dm::datasets::data_home()) / "saliency";
  dm::datasets::prepare_example_data("mnist-assets", data.parent_path());
  const auto pools = m::LoadSaliency(data);
  std::filesystem::create_directories(root);
  Algebra(root);
  const Tensor       validation_z = Gaussian(200, 16, 4823), test_z = Gaussian(200, 16, 4831);
  nn::ParameterStore g(5101), d(5113);
  std::vector<nn::ParameterStore*> stores{&g, &d};
  {
    nn::NoGradGuard guard;
    m::ConditionalGan(
        g, d, nn::zeros({2, 784}), nn::zeros({2, 16}), nn::zeros({2}, nn::DType::Int32));
  }
  auto snapshot = [&]() {
    Arrays a;
    for (int k = 0; k < 2; ++k)
      for (const auto& key : stores[k]->names())
        a.emplace(std::to_string(k) + "/" + key, stores[k]->at(key).detach().clone());
    return a;
  };
  auto forward = [&](const Tensor& x, const Tensor& z, const Tensor& labels) {
    return Fields(m::ConditionalGan(g, d, x.reshape({x.size(0), 784}), z, labels));
  };
  auto evaluate = [&](const Tensor& x, const Tensor& z, const Tensor& labels) {
    nn::NoGradGuard guard;
    auto            a = forward(x, z, labels);
    a.emplace(
        "pixel_mmd", m::ImqMmd(m::GanCoarsePixels(x), m::GanCoarsePixels(a.at("fake"))).value);
    return a;
  };
  nn::OptimizerConfig config;
  config.kind    = nn::OptimizerKind::Adam;
  config.beta1   = .5;
  config.beta2   = .999;
  config.epsilon = 1e-8;
  nn::Optimizer               go(g, .0002, config), disc(d, .0002, config);
  std::vector<nn::Optimizer*> optimizers{&go, &disc};
  Require(
      g.count() == 26736 && d.count() == 25473 && g.size() + d.size() == 8,
      "G 26736 + D 25473 = 52209 parameters, 8 tensors");
  SaveArrays((root / "initial_arrays.npz").string(), snapshot());
  SaveArrays(
      (root / "initial_outputs.npz").string(), evaluate(pools[2].images, test_z, pools[2].labels));
  nn::BatchOrder order(1000, 32, 4847);
  std::ofstream  history(root / "history.tsv"), batches(root / "batches.tsv");
  history.precision(17);
  history << "epoch\tvalidation_discriminator_loss\tvalidation_generator_loss\tvalidation_coarse_"
             "pixel_mmd\n";
  batches << "epoch\tstep\trow\tsource_id\n";
  const auto source  = nn::cast(pools[0].source, nn::DType::Int64).to_vector<std::int64_t>();
  int        steps   = 0;
  const auto started = std::chrono::steady_clock::now();
  for (int epoch = 1; epoch <= epochs; ++epoch) {
    const Tensor noise = Gaussian(1000, 16, 4861 + epoch);
    order.begin_epoch();
    int seen = 0;
    for (;;) {
      const auto rows = order.next();
      if (rows.empty())
        break;
      const Tensor x = nn::take_rows(pools[0].images, rows), z = nn::take_rows(noise, rows),
                   condition = nn::take_rows(pools[0].labels, rows);
      if (!steps)
        SaveArrays((root / "first_forward.npz").string(), evaluate(x, z, condition));
      for (int group : {1, 0}) {
        const auto before = steps ? Arrays{} : snapshot();
        // D first; recompute a fresh forward through the updated D for G.
        const auto fields = forward(x, z, condition);
        const auto loss   = fields.at(group == 1 ? "discriminator_loss" : "generator_loss");
        optimizers[group]->step(nn::grad(loss, stores[group]->parameters()));
        if (!steps) {
          const auto after   = snapshot();
          bool       changed = false;
          for (const auto& [key, value] : before) {
            if (key.rfind(std::to_string(group) + "/", 0) == 0)
              changed |= !nn::equal_bits(value, after.at(key));
            else
              Require(nn::equal_bits(value, after.at(key)), "unselected group unchanged");
          }
          Require(changed, "selected group changed");
        }
      }
      for (auto row : rows)
        batches << epoch << '\t' << steps << '\t' << row << '\t' << source[row] << '\n';
      ++steps;
      seen += int(rows.size());
    }
    Require(seen == 1000, "all fitting MNIST examples ONCE per epoch");
    const auto v = evaluate(pools[1].images, validation_z, pools[1].labels);
    history << epoch << '\t' << Value(v, "discriminator_loss") << '\t' << Value(v, "generator_loss")
            << '\t' << Value(v, "pixel_mmd") << '\n';
    std::cout << "epoch " << epoch << ": diagnostic D loss=" << Value(v, "discriminator_loss")
              << ", G loss=" << Value(v, "generator_loss")
              << ", coarse MMD=" << Value(v, "pixel_mmd") << std::endl;
  }
  const double seconds =
      std::chrono::duration<double>(std::chrono::steady_clock::now() - started).count();

  const auto checkpoint = (root / "final.npz").string();
  Require(steps == 96 && go.iterations() == 96 && disc.iterations() == 96, "96 D and 96 G writes");
  SaveArrays(checkpoint, snapshot());
  nn::ParameterStore restored_g(1), restored_d(2);
  {
    nn::NoGradGuard guard;
    m::ConditionalGan(
        restored_g,
        restored_d,
        nn::zeros({2, 784}),
        nn::zeros({2, 16}),
        nn::zeros({2}, nn::DType::Int32));
  }
  for (const auto& [key, value] : nn::load_npz(checkpoint))
    (key[0] == '0' ? restored_g : restored_d).set(key.substr(2), value);
  auto restored_arrays = [&]() {
    Arrays a;
    for (int k = 0; k < 2; ++k) {
      auto& store = k == 0 ? restored_g : restored_d;
      for (const auto& key : store.names())
        a.emplace(std::to_string(k) + "/" + key, store.at(key).detach().clone());
    }
    return a;
  };
  auto sample = [&](const Tensor& z, const Tensor& labels) {
    nn::NoGradGuard guard;
    return m::ConditionalGanGenerate(restored_g, z, labels);
  };
  auto restored_evaluate = [&](const Tensor& x, const Tensor& z, const Tensor& labels) {
    nn::NoGradGuard guard;
    auto            a =
        Fields(m::ConditionalGan(restored_g, restored_d, x.reshape({x.size(0), 784}), z, labels));
    a.emplace(
        "pixel_mmd", m::ImqMmd(m::GanCoarsePixels(x), m::GanCoarsePixels(a.at("fake"))).value);
    return a;
  };
  Require(Equal(snapshot(), restored_arrays()), "all final G/D weights restore BIT EXACT");
  const auto   before = restored_arrays();
  const auto   output = restored_evaluate(pools[2].images, test_z, pools[2].labels);
  const Tensor repeat = sample(test_z, pools[2].labels);
  Require(
      Equal(output.at("fake"), repeat), "noise+class generation BIT EXACT matches GAN evaluation");
  const double parity = MaxAbsDiff(
      sample(nn::take_rows(test_z, {0}), nn::take_rows(pools[2].labels, {0})),
      nn::take_rows(repeat, {0}));
  Require(parity < 2e-6, "G single/batch parity");
  const Tensor changed_z      = Gaussian(200, 16, 4877),
               changed_images = sample(changed_z, pools[2].labels);
  Require(!Equal(changed_images, repeat), "different noise affects G images");
  const Tensor zero_images = sample(nn::zeros({200, 16}), pools[2].labels);
  Require(!Equal(zero_images, repeat), "G not constant zero-latent mapping");
  SaveArrays(
      (root / "controls.npz").string(),
      {{"changed_z", changed_z},
       {"changed_images", changed_images},
       {"zero_z", nn::zeros({200, 16})},
       {"zero_images", zero_images}});
  // Same ten test noise vectors for every class (row = class), and D's real
  // logits under shifted labels: BOTH networks must depend on the class.
  std::vector<std::int64_t> grid_rows;
  std::vector<std::int32_t> grid_classes;
  for (int c = 0; c < 10; ++c)
    for (int k = 0; k < 10; ++k)
      grid_rows.push_back(k), grid_classes.push_back(c);
  const Tensor grid_z             = nn::take_rows(test_z, grid_rows),
               grid_labels        = nn::from_vector(grid_classes, {100});
  const Tensor grid               = sample(grid_z, grid_labels);
  const double g_condition_effect = MaxAbsDiff(
      nn::slice_axis(grid, 0, 10, 100), nn::tile(nn::slice_axis(grid, 0, 0, 10), {9, 1}));
  auto wrong_classes = pools[2].labels.contiguous().to_vector<std::int32_t>();
  for (auto& c : wrong_classes)
    c = (c + 1) % 10;
  Tensor       wrong_labels       = nn::from_vector(wrong_classes, {200});
  const auto   wrong              = restored_evaluate(pools[2].images, test_z, wrong_labels);
  const double d_condition_effect = MaxAbsDiff(output.at("real_logit"), wrong.at("real_logit"));
  Require(
      g_condition_effect > 1e-5 && d_condition_effect > 1e-5,
      "BOTH G and D structurally depend on requested class");
  int invalid_rejected = 0;
  for (int invalid : {-1, 10}) {
    auto bad = wrong_classes;
    bad[0]   = invalid;
    try {
      sample(test_z, nn::from_vector(bad, {200}));
    } catch (const std::exception&) {
      ++invalid_rejected;
    }
  }
  try {
    sample(test_z, nn::take_rows(pools[2].labels, {0}));
  } catch (const std::exception&) {
    ++invalid_rejected;
  }
  Require(
      invalid_rejected == 3,
      "negative/out of range/mismatched class labels rejected before OneHot");
  SaveArrays(
      (root / "conditioning_controls.npz").string(),
      {{"grid_z", grid_z},
       {"grid_labels", grid_labels},
       {"grid_images", grid},
       {"wrong_real_logits", wrong.at("real_logit")}});
  Mosaic(root / "same_z_class_grid.png", grid, 10);
  Require(Equal(before, restored_arrays()), "all G/D diagnostic generation immutable");
  SaveArrays((root / "outputs.npz").string(), output);

  const Tensor fit_mean =
      nn::tile(nn::mean(pools[0].images.reshape({1000, 784}), {0}, true), {200, 1});
  const double mean_mmd =
      m::ImqMmd(m::GanCoarsePixels(pools[2].images), m::GanCoarsePixels(fit_mean)).value.item();
  double     real_accuracy = 0, fake_accuracy = 0;
  const auto real_score = output.at("real_logit").to_vector<float>(),
             fake_score = output.at("fake_logit").to_vector<float>();
  for (int b = 0; b < 200; ++b)
    real_accuracy += real_score[b] >= 0, fake_accuracy += fake_score[b] < 0;
  const auto   pixel_mean = nn::mean(nn::cast(repeat, nn::DType::Float64), {0}, true);
  const double mean_pixel = nn::mean(pixel_mean).item(),
               pixel_variance =
                   nn::mean(nn::square(nn::cast(repeat, nn::DType::Float64) - pixel_mean)).item();
  Mosaic(root / "generated.png", nn::slice_axis(repeat, 0, 0, 40), 8);
  Mosaic(root / "fit_mean.png", nn::slice_axis(fit_mean, 0, 0, 8), 8);
  std::ofstream meta(root / "metrics.json");
  meta.precision(17);
  meta << "{\"generator_parameters\":26736,\"discriminator_parameters\":25473,\"epochs\":" << epochs
       << ",\"steps_per_group\":" << steps << ",\"optimizer_updates\":" << 2 * steps
       << ",\"selected_epoch_fixed_final\":" << epochs
       << ",\"test_discriminator_loss\":" << Value(output, "discriminator_loss")
       << ",\"test_generator_loss\":" << Value(output, "generator_loss")
       << ",\"test_coarse_pixel_mmd\":" << Value(output, "pixel_mmd")
       << ",\"fit_mean_coarse_pixel_mmd\":" << mean_mmd
       << ",\"test_discriminator_real_accuracy\":" << real_accuracy / 200
       << ",\"test_discriminator_fake_accuracy\":" << fake_accuracy / 200
       << ",\"generated_mean_pixel\":" << mean_pixel
       << ",\"generated_mean_per_pixel_variance\":" << pixel_variance
       << ",\"generator_class_probability_max_effect\":" << g_condition_effect
       << ",\"discriminator_real_class_logit_max_effect\":" << d_condition_effect
       << ",\"invalid_condition_controls_rejected\":" << invalid_rejected
       << ",\"single_batch_max_error\":" << parity << ",\"training_seconds\":" << seconds << "}\n";
  Require(bool(meta) && bool(history) && bool(batches), "complete GAN artifacts");
  history.close();
  batches.close();
  meta.close();
  std::cout << "fixed FINAL epoch " << epochs
            << ", test D/G=" << Value(output, "discriminator_loss") << "/"
            << Value(output, "generator_loss") << ", coarse MMD=" << Value(output, "pixel_mmd")
            << ", mean baseline=" << mean_mmd << ", D real/fake accuracy=" << real_accuracy / 200
            << "/" << fake_accuracy / 200 << ", mean pixel=" << mean_pixel
            << ", pixel variance=" << pixel_variance
            << "; D then G/restore/noise+classOnly/immutable PASS (training " << seconds
            << " s)\nArtifacts: " << root.string() << "\nAll conditional_gan checks passed.\n";
  std::ifstream input(root / "history.tsv");
  std::string   header;
  std::getline(input, header);
  std::vector<double> axis, dl, gl;
  double              epoch, a, b, mmd;
  while (input >> epoch >> a >> b >> mmd) {
    axis.push_back(epoch);
    dl.push_back(a);
    gl.push_back(b);
  }
  const double low=std::min({0.,*std::min_element(dl.begin(),dl.end()),*std::min_element(gl.begin(),gl.end())});
  const double high=std::max(*std::max_element(dl.begin(),dl.end()),*std::max_element(gl.begin(),gl.end()));
  auto p = dm::graphics::RPlot::create();
  p.y_limits(low-.05*(high-low),high+.4*(high-low)).lines(axis, dl, "Validation D", {37, 99, 235}, 2.)
      .points(axis, dl, "", {37, 99, 235}, 4.)
      .lines(axis, gl, "Validation G", {220, 38, 38}, 2.)
      .points(axis, gl, "", {220, 38, 38}, 4.)
      .x_label("Completed epoch; fixed final3")
      .y_label("Separate game objectives")
      .title("Validation logs do not select the checkpoint")
      .save_svg("build/conditional_gan_learning.svg");
}
```
