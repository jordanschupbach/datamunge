int main(){
 std::filesystem::create_directories("build");
 dm::graphics::Diagram d(72,1800);dm::graphics::DiagramNodeStyle s;
 s.width=10;s.height=4.8;s.font_size=32;
 d.node("h",{-22,2},"Previous h\nWidth4 row",s)
 .node("conv",{-8,2},"1x3 row conv\nNo row bias",s)
 .node("input",{6,11},"Input row\nMask A to16",s)
 .node("gates",{6,2},"Add projections\ni / f / o / g",s)
 .node("cell",{-8,-8},"Previous c\nWidth4 row",s)
 .node("update",{20,-4},"New c and h\nForget bias +1",s)
 .node("head",{34,-4},"1x1 head\nRow logits",s)
 .edge("h","conv").edge("conv","gates").edge("input","gates")
 .edge("gates","update").edge("cell","update").edge("update","head")
 .save_svg("build/pr_method.svg");
}
