\caption(The executed raster network uses two actual16-unit sigmoid maps and a strict degree-masked Bernoulli head. Weight masks stay inside the graph; forbidden stored coordinates receive exactly zero partials.)
\alttext(A binary8x8 image is flattened into a degree-masked16-unit sigmoid layer, a second16-unit sigmoid layer and64 raw image logits, with2400 stored values.)

> Fit both orders with complete visible updates and samplers

Canonical native MNIST saliency preparation provides1000 balanced fit,200
validation and200 disjoint official-test images, with labels, source IDs and a
provenance manifest. BinaryPixels performs Double half-pixel28→8 bilinear
arithmetic, casts once to Float32 and thresholds gray>=.5. Labels remain metadata;
MADE uses no class conditioning. The source's optional TensorFlow directory has
no initial arrays, so its auto default selects native seed8803.

Both models use BatchOrder seed8819, batch size32 and three fixed epochs. There
are31 full batches and one8-row batch per epoch,96 Adam(.003) writes per order,
192 total. Adam uses betas(.9,.999),epsilon1e−8 and no weight decay. The fixed
final epoch3 is chosen before inspecting held-out loss. Both stores begin with
the same raw weights; each gets its own masks, gradients and cold Adam moments.
All1144 forbidden coordinates are checked after every write.

The teacher-forced Bernoulli objective is mean(softplus(logit)−target*logit),
in nats per **binary8x8 pixel**. The per-image NLL sums64 terms. Dividing nats
by log2 gives bits; these are not bits per original28x28 gray pixel. Only
per-image sums enter the final joint-density mixture.

The complete sampler draws a full Double[N,64] midpoint-MT bank in row/ordinal
order. Raster ordinal j writes raw site j; reverse ordinal j writes63−j.
Retained conditionals are indexed by ordinal. Seed8821 supplies final32-sample
and three16-sample epoch banks; seed8827 supplies eight prefix completions.
A completion preserves the first32 sites in its model's order: top half for
raster, bottom half for reverse. It still draws every uniform column and keeps
prefix conditionals zero. Future truth and gray display unknowns never enter
the sampler. Source records contain per-order samples, not invented mixture samples.

```{cpp, results="markdown", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <fstream>
namespace n=dm::nn;namespace m=n::models;
using T=n::Tensor;using A=std::map<std::string,T>;namespace fs=std::filesystem;
void Save(const fs::path& file,const A& fields){
 n::NamedTensors named;for(const auto& [key,value]:fields)named.emplace_back(key,value);
 n::save_npz(file.string(),named);
}
A Weights(const n::ParameterStore& p){
 A out;for(const auto& name:p.names())out.emplace(name,p.at(name).detach().clone());return out;
}
bool Equal(const A& a,const A& b){
 if(a.size()!=b.size())return false;
 for(const auto& [key,value]:a)if(!b.count(key)||!n::equal_bits(value,b.at(key)))return false;
 return true;
}
A Partials(const n::ParameterStore& p,const std::vector<T>& g){
 A out;for(std::size_t k=0;k<g.size();++k)out.emplace(p.names()[k],g[k].detach());return out;
}
A Evaluate(n::ParameterStore& p,const T& x,bool reverse){
 n::NoGradGuard guard;auto o=m::MadeDensity(p,x,reverse);auto l=m::BernoulliPixels(o.logits,x);
 return {{"logits",o.logits},{"hidden1",o.hidden1},{"hidden2",o.hidden2},
 {"probability",l.probability},{"per_image_nll",l.per_image_nll},{"loss",l.loss}};
}
A Sample(n::ParameterStore& p,int count,std::uint32_t seed,bool reverse,const T& prefix={},int prefix_size=0){
 n::NoGradGuard guard;
 auto ordinal=n::reshape(n::arange(0,64),{1,64});
 auto ranks=reverse?63-ordinal:ordinal;
 T canvas=n::zeros({count,64}),conditionals=n::zeros({count,64});
 const auto bank=m::BinaryPixelUniforms(count,seed);
 if(prefix_size)canvas=n::where(n::less(ranks,prefix_size),n::reshape(prefix,{count,64}),canvas);
 for(int j=prefix_size;j<64;++j){
  const int site=reverse?63-j:j;
  auto logits=m::MadeDensity(p,n::reshape(canvas,{count,8,8,1}),reverse).logits;
  auto q=n::slice_axis(n::reshape(n::sigmoid(logits),{count,64}),1,site,site+1);
  auto u=n::slice_axis(bank,1,j,j+1);
  auto bit=n::cast(n::less(u,n::cast(q,n::DType::Float64)),n::DType::Float32);
  auto at_site=n::equal(ordinal,site);
  conditionals=n::where(n::equal(ordinal,j),q,conditionals);
  canvas=n::where(at_site,bit,canvas);
 }
 return {{"images",n::reshape(canvas,{count,8,8,1})},{"uniform",bank},{"conditionals",conditionals}};
}
int main(){
 const fs::path directory="build/made_density";
 for(bool reverse:{false,true}){
 const auto root=directory/(reverse?"reverse":"raster");fs::create_directories(root/"phases");
 n::set_num_threads(4);
 const fs::path data_root=dm::datasets::prepare_example_data("mnist-assets");
 const auto pools=m::LoadSaliency(data_root/"saliency");
 std::vector<T> binary;A data;
 const std::vector<std::string> split{"fit","validation","test"};
 for(int k=0;k<3;++k){
  auto prep=m::BinaryPixels(pools[k].images);binary.push_back(prep.images);
  data[split[k]+"_original"]=pools[k].images;data[split[k]+"_gray"]=prep.gray;
  data[split[k]+"_images"]=prep.images;data[split[k]+"_labels"]=pools[k].labels;
  data[split[k]+"_source_ids"]=pools[k].source;
 }
 Save(root/"data.npz",data);
 auto inventory=m::MadeMasks(reverse);
 Save(root/"mask_inventory.npz",{{"input_degrees",inventory.input_degrees},{"hidden1_degrees",inventory.hidden1_degrees},
 {"hidden2_degrees",inventory.hidden2_degrees},{"input_mask",inventory.input_mask},{"hidden_mask",inventory.hidden_mask},{"output_mask",inventory.output_mask}});
 A masks{{"input/W",inventory.input_mask},{"hidden/W",inventory.hidden_mask},{"output/W",inventory.output_mask}};
 n::ParameterStore p(8803);
 {n::NoGradGuard guard;m::MadeDensity(p,n::zeros({1,8,8,1}),reverse);}
 const auto initial=Weights(p);Save(root/"initial_arrays.npz",initial);
 Save(root/"initial_outputs.npz",Evaluate(p,binary[2],reverse));
 n::OptimizerConfig config;config.kind=n::OptimizerKind::Adam;
 n::Optimizer optimizer(p,.003,config);
 n::BatchOrder order(1000,32,8819);std::vector<std::int64_t> rows;
 std::ofstream batches(root/"batches.tsv"),history(root/"history.tsv");history.precision(17);
 batches<<"epoch\tstep\trow\tsource_id\n";
 history<<"epoch\tvalidation_nll_per_binary_pixel\tvalidation_bits_per_binary_pixel\n";
 auto source=pools[0].source.to_vector<std::int32_t>();
 std::vector<double> val_bits;T first;int updates=0;
 for(int epoch=1;epoch<=3;++epoch){
  order.begin_epoch();
  for(;;){
   rows=order.next();if(rows.empty())break;
   const auto x=n::take_rows(binary[0],rows);
   if(!updates){first=x;Save(root/"first_batch.npz",{{"images",x}});
    Save(root/"first_forward.npz",Evaluate(p,x,reverse));}
   auto output=m::MadeDensity(p,x,reverse);auto objective=m::BernoulliPixels(output.logits,x);
   auto gradients=n::grad(objective.loss,p.parameters());
   const auto phase=root/"phases"/("batch"+std::to_string(updates));
   Save(phase.string()+"-gradient.npz",Partials(p,gradients));
   if(!updates)Save(root/"initial_gradients.npz",Partials(p,gradients));
   optimizer.step(gradients);
   const auto after=Weights(p);Save(phase.string()+"-after.npz",after);
   Save(phase.string()+"-iterations.npz",{{"iterations",n::from_vector(std::vector<std::int64_t>{optimizer.iterations()},{1})}});
   if(!updates)Save(root/"first_after.npz",after);
   for(const auto& [key,value]:initial){
    if(!masks.count(key))continue;
    auto mask=masks.at(key);
    auto forbidden=n::equal(mask,0);
    if(!n::equal_bits(n::where(forbidden,value,n::zeros_like(value)),
                      n::where(forbidden,after.at(key),n::zeros_like(value))) ||
       n::max(n::abs(n::where(forbidden,Partials(p,gradients).at(key),n::zeros_like(value)))).item()!=0)
     throw std::runtime_error("Masked coordinates changed");
   }
   for(auto row:rows)batches<<epoch<<'\t'<<updates<<'\t'<<row<<'\t'<<source[row]<<'\n';
   ++updates;
  }
  const double nll=Evaluate(p,binary[1],reverse).at("loss").item();
  history<<epoch<<'\t'<<nll<<'\t'<<nll/std::log(2.)<<'\n';val_bits.push_back(nll/std::log(2.));
  Save(root/("epoch"+std::to_string(epoch)+"_arrays.npz"),Weights(p));
  Save(root/("epoch"+std::to_string(epoch)+"_samples.npz"),Sample(p,16,8821,reverse));
 }
 if(updates!=96 || optimizer.iterations()!=96)throw std::runtime_error("96 Adam updates");
 p.save((root/"final.npz").string());
 Save(root/"final_gradients.npz",Partials(p,n::grad(m::BernoulliPixels(m::MadeDensity(p,first,reverse).logits,first).loss,p.parameters())));
 n::ParameterStore restored(8803);
 {n::NoGradGuard guard;m::MadeDensity(restored,n::zeros({1,8,8,1}),reverse);}
 restored.load((root/"final.npz").string(),true);
 if(!Equal(Weights(p),Weights(restored)))throw std::runtime_error("Fresh restore");
 const auto before=Weights(restored),out=Evaluate(restored,binary[2],reverse);
 Save(root/"model_arrays.npz",before);Save(root/"outputs.npz",out);
 auto single=n::take_rows(binary[2],{0});
 auto probability=Evaluate(restored,single,reverse).at("probability");
 if(n::max(n::abs(probability-n::take_rows(out.at("probability"),{0}))).item()>1e-6)
  throw std::runtime_error("Batch independence");
 A causal{{"images",single},{"probability",probability}};std::vector<T> jacobian(64);
 auto raw=n::reshape(n::arange(0,64),{1,8,8,1});
 auto rank=reverse?63-raw:raw;
 for(int ordinal=0;ordinal<64;++ordinal){
  const int site=reverse?63-ordinal:ordinal;
  auto input=single.detach().clone().requires_grad_();
  auto logits=n::reshape(m::MadeDensity(restored,input,reverse).logits,{1,64});
  auto gradient=n::reshape(n::grad(n::sum(n::slice_axis(logits,1,site,site+1)),{input})[0],{64});
  if(n::max(n::abs(n::where(n::greater_equal(n::reshape(rank,{64}),ordinal),gradient,n::zeros_like(gradient)))).item()!=0)
   throw std::runtime_error("Current/future derivative");
  auto changed=n::where(n::greater_equal(rank,ordinal),1-single,single);
  auto cp=Evaluate(restored,changed,reverse).at("probability");
  if(!n::equal_bits(n::where(n::less_equal(rank,ordinal),cp,n::zeros_like(cp)),
                   n::where(n::less_equal(rank,ordinal),probability,n::zeros_like(probability))))
   throw std::runtime_error("Future-flip prefix invariant");
  if(ordinal%8==0){causal["changed_input"+std::to_string(site)]=changed;
   causal["changed_probability"+std::to_string(site)]=cp;}
  jacobian[site]=gradient.detach();
 }
 causal["jacobian"]=n::stack(jacobian);Save(root/"causality.npz",causal);
 auto samples=Sample(restored,32,8821,reverse);Save(root/"samples.npz",samples);
 if(!Equal(samples,Sample(restored,32,8821,reverse)))throw std::runtime_error("Repeated sample bank/conditionals");
 auto truth=n::take_rows(binary[2],{0,1,2,3,4,5,6,7});
 auto completion=Sample(restored,8,8827,reverse,truth,32);completion["truth"]=truth;
 Save(root/"completions.npz",completion);
 if(!n::equal_bits(n::where(n::less(rank,32),truth,n::zeros_like(truth)),
                  n::where(n::less(rank,32),completion.at("images"),n::zeros_like(truth))))
  throw std::runtime_error("Observed prefix preservation");
 auto observed=n::where(n::less(rank,32),truth,n::full(truth.shape(),.5));
 auto gallery=n::reshape(n::stack({truth,observed,completion.at("images")},1),{24,8,8,1});
 Save(root/"completion_gallery.npz",{{"images",gallery}});
 n::save_image_grid(n::tile(samples.at("images"),{1,1,1,3}),(root/"samples.png").string(),8,0,1,0,220/255.,8);
 n::save_image_grid(n::tile(gallery,{1,1,1,3}),(root/"completions.png").string(),3,0,1,0,220/255.,8);
 if(!Equal(before,Weights(restored)))throw std::runtime_error("Inference wrote parameters");
 {n::NoGradGuard guard;
  auto posterior=(n::sum(n::cast(binary[0],n::DType::Float64),{0})+.5)/1001.;
  auto target=n::cast(binary[2],n::DType::Float64);
  auto baseline=-n::mean(target*n::log(posterior)+(1-target)*n::log1p(-posterior));
  Save(root/"baseline.npz",{{"probability",n::reshape(n::cast(posterior,n::DType::Float32),{64})}});
  Save(root/"summary.npz",{{"validation_bits",n::from_vector(val_bits,{3})},
   {"test_bits",n::cast(out.at("loss"),n::DType::Float64)/std::log(2.)},
   {"baseline_bits",baseline/std::log(2.)}});
  std::print("| Fixed protocol | Value |\n|---|---:|\n| Fit / validation / test |1000 /200 /200|\n| Stored / active / masked values |2400 /1256 /1144|\n| Epochs / Adam updates |3 /96|\n| Full causal Jacobian entries checked |4096|\n| Test bits per binary pixel |{:.6f}|\n| Fit-only Bernoulli baseline |{:.6f}|\n",out.at("loss").item()/std::log(2.),baseline.item()/std::log(2.));
 }
 }
 A raster,reverse;
 for(auto& [key,value]:n::load_npz((directory/"raster/outputs.npz").string()))raster.emplace(key,value);
 for(auto& [key,value]:n::load_npz((directory/"reverse/outputs.npz").string()))reverse.emplace(key,value);
 auto mixture=m::EqualDensityMixture(n::stack({raster.at("per_image_nll"),reverse.at("per_image_nll")},1));
 Save(directory/"order_ensemble.npz",{{"per_image_nll",mixture.per_image_nll},{"raster_per_image_nll",raster.at("per_image_nll")},{"reverse_per_image_nll",reverse.at("per_image_nll")}});
 Save(directory/"mixture_summary.npz",{{"per_image_nll",mixture.per_image_nll},{"mean_nll",mixture.mean_nll},{"responsibilities",mixture.responsibilities}});
 std::print("Equal-probability mixture test bits per binary pixel: {:.6f}.\n",mixture.mean_nll.item()/64/std::log(2.));
}
```
