int main(){
 namespace n=dm::nn;auto plot=dm::graphics::RPlot::create();int index=0;double baseline=0;
 const std::vector<dm::graphics::RGB> colours{{37,99,235},{220,38,38}};
 for(const std::string order:{"raster","reverse"}){
  std::map<std::string,n::Tensor> a;for(auto& [key,value]:n::load_npz("build/made_density/"+order+"/summary.npz"))a.emplace(key,value);
  plot.lines({1,2,3},a.at("validation_bits").to_vector<double>(),index?"Reverse val":"Raster val",colours[index]);
  plot.points({3},{a.at("test_bits").item()},index?"Reverse test":"Raster test",colours[index],6);++index;
  baseline=a.at("baseline_bits").item();
 }
 n::Tensor mixture;for(auto& [key,value]:n::load_npz("build/made_density/mixture_summary.npz"))if(key=="mean_nll")mixture=value;
 plot.lines({1,3},{baseline,baseline},"Fit-only baseline",{22,163,74})
 .points({3},{mixture.item()/64/std::log(2.)},"Joint mixture",{147,51,234},4)
 .y_limits(.32,1.14).x_label("Fixed epoch").y_label("Bits per binary8x8 pixel")
 .title("Both fixed orders improve; the simple baseline still wins").save_svg("build/md_history.svg");
}
