> Hand-check a four-bit density before loading images

Use input degrees(1,2,3,4), hidden1(1,2,3) and hidden2(2,3,1). Compose the three
comparison masks with<=,<=,<. A zero product at(i,j) means no structural path
from input i to output j; every current/future path must be zero. The following
complete native program builds this tiny network and enumerates all16 binary
states. It fits nothing. The sum of exp(−joint NLL) is one because every output
is a proper Bernoulli conditional on preceding coordinates.

```{cpp, results="markdown", file="figures/md_degree_toy.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main(){
 namespace n=dm::nn;namespace m=n::models;auto t=n::DType::Float64;
 auto d=n::from_vector(std::vector<std::int64_t>{1,2,3,4},{4});
 auto h1d=n::from_vector(std::vector<std::int64_t>{1,2,3},{3});
 auto h2d=n::from_vector(std::vector<std::int64_t>{2,3,1},{3});
 auto a=m::AutoregressiveDegreeMask(d,h1d,false,t),b=m::AutoregressiveDegreeMask(h1d,h2d,false,t),c=m::AutoregressiveDegreeMask(h2d,d,true,t);
 auto paths=n::matmul(n::matmul(a,b),c).to_vector<double>();
 for(int i=0;i<4;++i)for(int j=0;j<=i;++j)if(paths[i*4+j]!=0)throw std::runtime_error("Own/future path");
 std::vector<double> bits;for(int state=0;state<16;++state)for(int j=0;j<4;++j)bits.push_back((state>>j)&1);
 auto x=n::from_vector(bits,{16,4});n::ParameterStore p(8803,t);
 auto h1=n::sigmoid(m::MaskedDensityDense(p,"input",x,a));
 auto h2=n::sigmoid(m::MaskedDensityDense(p,"hidden",h1,b));
 auto logits=m::MaskedDensityDense(p,"output",h2,c);
 auto nll=m::BernoulliPixels(n::reshape(logits,{16,1,4,1}),n::reshape(x,{16,1,4,1})).per_image_nll;
 auto probability=n::exp(-nll);double total=n::sum(probability).item();
 if(std::abs(total-1)>1e-13)throw std::runtime_error("Normalized joint");
 auto plot=dm::graphics::RPlot::create();
 plot.lines(n::arange(0,16).to_vector<double>(),probability.to_vector<double>(),"Native toy joint",{37,99,235})
 .y_limits(0,.11).x_label("Enumerated binary state; bit0 is first input")
 .y_label("Joint probability").title("Degree masks define a normalized four-bit density")
 .save_svg("build/md_degree_toy.svg");
 std::print("| Four-bit worked check | Value |\n|---|---:|\n| Own/future structural paths |0|\n| Enumerated binary states |16|\n| Sum of joint probabilities |{:.15f}|\n",total);
}
