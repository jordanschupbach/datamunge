 auto u=a.at("unigram_bits").item(),t=a.at("transition_bits").item();
 dm::graphics::RPlot::create().lines({1,2,3},a.at("validation_bits").to_vector<double>(),"Validation",{37,99,235})
 .points({3},{a.at("test_bits").item()},"Fixed-final test",{220,38,38},6)
 .lines({1,3},{u,u},"Fit-only unigram",{22,163,74}).lines({1,3},{t,t},"Fit-only transition",{147,51,234})
 .lines({1,3},{8,8},"Uniform codes",{100,116,139})
 .y_limits(5.9,9.6).x_label("Fixed epoch").y_label("Bits per mu-law next-code sample")
 .title("The compact neural endpoint remains worse than both fitted baselines").save_svg("build/wv_history.svg");
}
