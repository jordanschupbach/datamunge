 auto decoded=n::mu_law_decode(a.at("prompts"),256,n::DType::Float64);auto ids=a.at("prompt_source_ids").to_vector<std::int32_t>();
 auto time=n::cast(n::arange(0,384),n::DType::Float64)/8000;auto plot=dm::graphics::RPlot::create();
