> Inspect every scored point of one held-out window

The following native per-position losses retain all224 scored target positions
of the first held-out window. The initial32 positions supply context but are
not plotted as scored targets. Every method is evaluated on the same target
code and true preceding input code. Variability of individual losses does not
change the whole-pool negative result or justify selecting favorable positions.

```{cpp, results="markdown", file="figures/wv_point_losses.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main(){
 namespace n=dm::nn;std::map<std::string,n::Tensor> data,base; n::Tensor logits;
 for(auto& [k,v]:n::load_npz("build/wavenet/data.npz"))data.emplace(k,v);
 for(auto& [k,v]:n::load_npz("build/wavenet/baseline.npz"))base.emplace(k,v);
 for(auto& [k,v]:n::load_npz("build/wavenet/outputs.npz"))if(k=="logits")logits=v;
 auto target=n::slice_axis(n::select(data.at("test_target"),0,0),0,32,256),input=n::slice_axis(n::select(data.at("test_input"),0,0),0,32,256);
 auto z=n::cast(n::slice_axis(n::select(logits,0,0),0,32,256),n::DType::Float64);
 auto neural=-n::sum(n::log_softmax(z)*n::one_hot(target,256,1,0,n::DType::Float64),{1});
 auto unigram=-n::log(n::gather(base.at("unigram_probability"),target));
 auto transition=-n::log(n::gather(n::reshape(base.at("transition_probability"),{65536}),input*256+target));
 auto time=n::arange(32,256).to_vector<double>();
 dm::graphics::RPlot::create().lines(time,neural.to_vector<double>(),"Neural",{37,99,235})
 .lines(time,unigram.to_vector<double>(),"Fit-only unigram",{22,163,74}).lines(time,transition.to_vector<double>(),"Fit-only transition",{147,51,234})
 .y_limits(0,14).x_label("Scored input position; target is the following code").y_label("Per-position NLL (nats)")
 .title("All224 scored positions of the first held-out window").save_svg("build/wv_point_losses.svg");
 n::save_npz("build/wavenet/point_losses.npz",{{"neural",neural},{"unigram",unigram},{"transition",transition}});
}
