> Hand-check a two-block RF5 cache before loading recordings

Use two classes, residual/skip width1 and dilations1,2. The receptive field is
2+1+2=5. Input code0/1 maps to current features−.5/+.5 and previous features
−.25/+.25. Each gate is.5tanh(.4×old+.6×current), since its sigmoid preactivation
is zero. Skip weights are1, the first residual weight is.25, post bias is1 and
the first head weight is.75. At the true beginning with code0, both gate outputs
are negative; ReLU clips their skip sum to zero, so the first head score is.75.
There is no invented code-zero prefix before the beginning.

The native program checks that value, compares all seven cached/full heads,
and differentiates the final head against every continuous encoded input.
At final input index6, times0 and1 are outside RF5 and have exact zero partials;
the preceding five positions carry a nonzero path. No fitting occurs.

```{cpp, results="markdown", file="figures/wv_cache_toy.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main(){
 namespace n=dm::nn;namespace m=n::models;m::WaveStackConfig c{1,1,2,1,2};n::ParameterStore p(1);
 m::WaveStack(p,n::one_hot(n::zeros({1,1},n::DType::Int32),2),c);
 for(auto name:p.names())p.set(name,n::zeros(p.at(name).shape()));
 p.set("input/W",n::tensor({-.25,.25,-.5,.5},{1,2,2,1}));
 for(int i=1;i<=2;++i){auto name="block"+std::to_string(i);
  p.set(name+"/gate/W",n::tensor({.4,0,.6,0},{1,2,1,2}));p.set(name+"/skip/W",n::ones({1,1,1,1}));}
 p.set("block1/residual/W",n::full({1,1,1,1},.25));p.set("post/W",n::ones({1,1,1,1}));p.set("post/b",n::ones({1}));
 p.set("output/W",n::tensor({.75,-.5},{1,1,1,2}));
 auto codes=n::from_vector(std::vector<std::int32_t>{0,1,0,1,1,0,1},{1,7});auto encoded=n::one_hot(codes,2).requires_grad_();
 auto full=m::WaveStack(p,encoded,c).logits;auto values=n::reshape(n::select(full,2,0),{7});
 m::WaveStackCache cache(p,c);std::vector<double> cached;for(auto code:codes.to_vector<std::int32_t>())cached.push_back(cache.next(code).to_vector<float>()[0]);
 if(m::WaveStackField(c)!=5||cached.front()!=.75||cache.consumed()!=7)throw std::runtime_error("Worked RF5/start");
 auto error=n::max(n::abs(values-n::cast(n::from_vector(cached,{7}),n::DType::Float32))).item();
 if(error>2e-6)throw std::runtime_error("Worked cached head");
 auto g=n::grad(n::sum(n::slice_axis(n::slice_axis(full,1,6,7),2,0,1)),{encoded})[0];
 if(n::max(n::abs(n::slice_axis(g,1,0,2))).item()!=0||n::sum(n::abs(n::slice_axis(g,1,2,7))).item()==0)throw std::runtime_error("Worked RF5 derivative");
 dm::graphics::RPlot::create().lines({0,1,2,3,4,5,6},values.to_vector<double>(),"Full native forward",{37,99,235})
 .points({0,1,2,3,4,5,6},cached,"Per-layer cache",{220,38,38},4)
 .y_limits(.65,1.65).x_label("Observed input index").y_label("Next-code head score, class0")
 .title("A hand-set RF5 stack agrees with its circular cache").save_svg("build/wv_cache_toy.svg");
 std::print("RF5; first head.75; all7 heads checked, max error {:.3g}; outside-RF partials exactly0.\n",error);
}
