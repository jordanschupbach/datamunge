int main(){
 namespace n=dm::nn;n::Tensor j;for(auto& [k,v]:n::load_npz("build/pixel_cnn_pp/causality.npz"))if(k=="jacobian")j=n::max(n::abs(v),{2});
 auto show=n::log1p(j*1000);show=show/n::max(show);
 n::save_image_grid(n::reshape(show,{1,64,64,1}),"build/pp_causality.png",1,0,1,0,0,6);
}
```
