> Preserve the original data, optimizer and generation protocol

Native `datasets::fetch("cifar10")` obtains the canonical binary files through
the configurable cache. `nn::data::LoadCifar` retains integer RGB bytes and
labels. The original fixed selections are data_batch_1.bin rows0..127 for fit,
rows128..159 for validation, and test_batch.bin rows64..95 for test. Test IDs
add50000. These pools are disjoint by source record ID; no duplicate-image audit
is claimed. All original labels are retained for provenance and are **unused**
by the density. No TF initial arrays were present, so the native seed8609 path
is the frozen source run; this is not a claim of recorded TF trajectory parity.

`RgbAreaPixels` averages each disjoint4x4 block with integer sums, rounds its
mean half-up to an8-bit code, then computes double(code)/127.5−1 and casts once
to Float32. This exact quantization differs from floating bilinear resizing,
from binarization, and from modelling the original32x32 RGB images. The archive
retains the original bytes, codes, signed images, labels and source IDs.

Three epochs use Adam.003 with default beta1=.9,beta2=.999,epsilon=1e−8,
batch8 and BatchOrder(128,8,8623), exactly48 updates. There is no validation
checkpoint selection, tuning, schedule, clipping or refit. The final third-epoch
store is the fixed endpoint. Every gradient, updated array and iteration count
is saved. All448 masked raw coordinates and their partials remain unchanged or
zero after every write. A fresh store restores final.npz bit identically.

The full editable program below includes the entire raster sampler. A midpoint
MT19937 bank has shape[N,64,4], drawn case first, then pixel, then stream. At
each pixel, stream0 selects a component by cumulative softmax weights using
strict u<cumulative; streams1,2,3 supply inverse-logistic R/G/B draws. Clamp each
draw to[-1,1], round floor((value+1)*127.5+.5), then normalize the resulting
code before using it to couple the next channel. Component selection and all
sampling transforms use native tensor operations. Final24-sample and epoch8-sample
banks use seed8639; six prefix completions use8641. Prefix generation preserves
the first32 whole RGB pixels (the top four rows). It still draws the full bank,
leaves saved prefix parameters zero and prefix component IDs−1. Gray unknown
values occur only in the presentation gallery, never in the conditioning input.

```{cpp, results="markdown", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <fstream>
#include <random>
#include <datamunge/nn/cifar.hpp>
namespace n=dm::nn;namespace m=n::models;
using T=n::Tensor;using A=std::map<std::string,T>;namespace fs=std::filesystem;
void Save(const fs::path& file,const A& fields){
 n::NamedTensors named;for(const auto& [key,value]:fields)named.emplace_back(key,value);
 n::save_npz(file.string(),named);
}
A Weights(const n::ParameterStore& p){
 A out;for(const auto& name:p.names())out.emplace(name,p.at(name).detach().clone());return out;
}
bool Equal(const A& a,const A& b){
 if(a.size()!=b.size())return false;
 for(const auto& [key,value]:a)if(!b.count(key)||!n::equal_bits(value,b.at(key)))return false;
 return true;
}
A Partials(const n::ParameterStore& p,const std::vector<T>& g){
 A out;for(std::size_t k=0;k<g.size();++k)out.emplace(p.names()[k],g[k].detach());return out;
}

A Evaluate(n::ParameterStore& p,const T& x){
 n::NoGradGuard guard;auto o=m::PixelCnnPP(p,x);
 return {{"parameters",o.parameters},{"vertical",o.vertical},{"horizontal",o.horizontal},
 {"pixel_log_probability",o.pixel_log_probability},{"component_log_probability",o.component_log_probability},
 {"mixture_log_probability",o.mixture_log_probability},{"means",o.means},{"log_scales",o.log_scales},
 {"coefficients",o.coefficients},{"channel_log_mass",o.channel_log_mass},{"per_image_nll",o.per_image_nll},{"loss",o.loss}};
}
A Sample(n::ParameterStore& p,int count,std::uint32_t seed,const T& prefix={},int prefix_size=0){
 n::NoGradGuard guard;auto f64=n::DType::Float64;
 std::mt19937 rng(seed);std::vector<double> values(static_cast<std::size_t>(count*64*4));
 for(auto& u:values)u=(double(rng())+.5)/4294967296.;
 auto bank=n::from_vector(values,{count,64,4});
 auto sites=n::reshape(n::arange(0,64),{1,64,1});
 auto canvas=n::zeros({count,64,3}),raw=n::zeros({count,64,30});
 auto components=n::full({count,64},-1,n::DType::Int32);
 if(prefix_size)canvas=n::where(n::less(sites,prefix_size),n::reshape(prefix,{count,64,3}),canvas);
 for(int site=prefix_size;site<64;++site){
  auto head=n::reshape(m::GatedPixelConvolutional(p,n::reshape(canvas,{count,8,8,3}),T(),false,3,30).logits,{count,64,30});
  auto at=n::slice_axis(head,1,site,site+1);
  auto params=n::reshape(n::cast(at,f64),{count,3,10});
  auto logits=n::select(params,2,0);auto mass=n::exp(logits-n::max(logits,{1},true));
  auto cdf=n::cumsum(mass/n::sum(mass,{1},true),1);
  auto u=n::reshape(n::slice_axis(bank,1,site,site+1),{count,4});
  auto chosen=n::cast(n::minimum(n::sum(n::cast(n::greater_equal(n::slice_axis(u,1,0,1),cdf),n::DType::Int32),{1}),n::full({count},2,n::DType::Int32)),n::DType::Int32);
  auto one=n::one_hot(chosen,3,1,0,f64);
  auto selected=n::sum(params*n::expand_dims(one,2),{1});
  std::vector<T> channels;
  for(int c=0;c<3;++c){
   auto mean=n::slice_axis(selected,1,c+1,c+2);
   if(c==1)mean=mean+n::tanh(n::slice_axis(selected,1,7,8))*n::cast(channels[0],f64);
   if(c==2)mean=mean+(n::tanh(n::slice_axis(selected,1,8,9))*n::cast(channels[0],f64)+
                           n::tanh(n::slice_axis(selected,1,9,10))*n::cast(channels[1],f64));
   auto scale=n::exp(n::maximum(n::slice_axis(selected,1,c+4,c+5),n::full({count,1},-7,f64)));
   auto draw=n::slice_axis(u,1,c+1,c+2);
   auto sample=mean+scale*(n::log(draw)-n::log1p(-draw));
   auto code=n::floor((n::clip(sample,-1,1)+1)*127.5+.5);
   channels.push_back(n::cast(code/127.5-1,n::DType::Float32));
  }
  auto at_site=n::equal(sites,site);
  canvas=n::where(at_site,n::reshape(n::concat(channels,1),{count,1,3}),canvas);
  raw=n::where(at_site,at,raw);
  components=n::where(n::equal(n::reshape(sites,{1,64}),site),n::reshape(chosen,{count,1}),components);
 }
 return {{"images",n::reshape(canvas,{count,8,8,3})},{"uniform",bank},{"parameters",raw},{"components",components}};
}
void Algebra(const fs::path& root){
 for(bool normalization:{true,false}){
  const int count=normalization?256:8;
  std::vector<float> images(count*3),parameters(count*30);
  for(int i=0;i<count;++i){
   for(int c=0;c<3;++c){int code=normalization?i:(i*37+c*113)%256;
    if(!normalization&&i<2)code=i?255:0;
    images[i*3+c]=float(double(code)/127.5-1);}
   for(int k=0;k<3;++k)for(int j=0;j<10;++j){
    float value=normalization?0:float(.3*std::sin((i*30+k*10+j)*.37));
    if(j==0&&normalization)value=k==0?-80:k==1?0:80;
    if(j>=1&&j<=3&&normalization)value=k==0?-2:k==1?0:2;
    if(j>=4&&j<=6)value=normalization?(k==0?-7:k==1?-.3f:3.f):(k==0?-8:k==1?-.4f:2.f);
    if(!normalization&&j>=4&&j<=6)value+=.13f*(j-4);
    parameters[i*30+k*10+j]=value;
   }
  }
  auto x=n::from_vector(images,{count,1,1,3});auto p=n::from_vector(parameters,{count,1,1,30}).requires_grad_();
  auto o=m::DiscretizedLogisticRGB(x,p);auto g=n::grad(o.mean_channel_nll,{p})[0];
  Save(root/(normalization?"normalization.npz":"likelihood_fixture.npz"),{{"images",x},{"parameters",p.detach()},
   {"loss",o.mean_channel_nll.detach()},{"gradient",g.detach()},{"pixel_log_probability",o.pixel_log_probability.detach()},
   {"component_log_probability",o.component_log_probability.detach()},{"mixture_log_probability",o.mixture_log_probability.detach()},
   {"channel_log_mass",o.channel_log_mass.detach()}});
  if(normalization){auto total=n::sum(n::exp(n::cast(o.channel_log_mass,n::DType::Float64)),{0});
   if(n::max(n::abs(total-1)).item()>2e-5)throw std::runtime_error("All256 bins and endpoint tails must normalize");}
 }
}
int main(){
 const fs::path root="build/pixel_cnn_pp";fs::create_directories(root/"phases");n::set_num_threads(4);
 const fs::path data_root=dm::datasets::fetch("cifar10");
 const auto train=n::data::LoadCifar({data_root/"data_batch_1.bin"},n::data::Cifar::k10);
 const auto test=n::data::LoadCifar({data_root/"test_batch.bin"},n::data::Cifar::k10);
 std::vector<T> images,codes;A data;std::vector<std::string> names{"fit","validation","test"};
 for(int k=0;k<3;++k){
  int start=k==0?0:k==1?128:64,count=k==0?128:32;const auto& source=k==2?test:train;
  auto original=n::slice_axis(source.images,0,start,start+count).contiguous();auto prep=m::RgbAreaPixels(original);
  images.push_back(prep.images);codes.push_back(prep.codes);
  data[names[k]+"_original"]=original;data[names[k]+"_codes"]=prep.codes;data[names[k]+"_images"]=prep.images;
  data[names[k]+"_labels"]=n::slice_axis(source.labels,0,start,start+count).contiguous();
  data[names[k]+"_source_ids"]=n::cast(n::arange(start+(k==2?50000:0),start+count+(k==2?50000:0)),n::DType::Int32);
 }
 Save(root/"data.npz",data);Algebra(root);
 n::ParameterStore p(8609);{n::NoGradGuard guard;m::PixelCnnPP(p,n::zeros({1,8,8,3}));}
 if(p.count()!=1410||p.size()!=23)throw std::runtime_error("Source1410/23 census");
 const auto initial=Weights(p);Save(root/"initial_arrays.npz",initial);Save(root/"initial_outputs.npz",Evaluate(p,images[2]));
 A masks;int masked=0;
 for(int block=0;block<3;++block)for(bool vertical:{false,true}){
  auto key="block"+std::to_string(block)+(vertical?"/vertical/W":"/horizontal/W");
  masks[key]=m::GatedPixelMask(block?4:3,vertical,block==0);
  masked+=int(n::sum(n::cast(n::equal(masks.at(key),0),n::DType::Int32)).item());
 }
 if(masked!=448)throw std::runtime_error("448 masked coordinates");
 n::Optimizer optimizer(p,.003,{n::OptimizerKind::Adam});n::BatchOrder order(128,8,8623);
 std::ofstream batches(root/"batches.tsv"),history(root/"history.tsv");history.precision(17);
 batches<<"epoch\tstep\trow\n";history<<"epoch\tvalidation_nll_per_RGB_channel\tvalidation_bits_per_RGB_channel\n";
 std::vector<double> validation;T first;int updates=0;
 for(int epoch=1;epoch<=3;++epoch){
  order.begin_epoch();for(;;){auto rows=order.next();if(rows.empty())break;
   auto x=n::take_rows(images[0],rows);if(!updates){first=x;Save(root/"first_batch.npz",{{"images",x}});Save(root/"first_forward.npz",Evaluate(p,x));}
   auto o=m::PixelCnnPP(p,x);auto gradients=n::grad(o.loss,p.parameters());auto partials=Partials(p,gradients);
   const auto phase=root/"phases"/("batch"+std::to_string(updates));Save(phase.string()+"-gradient.npz",partials);
   if(!updates)Save(root/"initial_gradients.npz",partials);
   optimizer.step(gradients);auto after=Weights(p);Save(phase.string()+"-after.npz",after);
   Save(phase.string()+"-iterations.npz",{{"iterations",n::from_vector(std::vector<std::int64_t>{optimizer.iterations()},{1})}});
   if(!updates)Save(root/"first_after.npz",after);
   for(const auto& [key,mask]:masks){auto blocked=n::equal(mask,0);auto zero=n::zeros_like(mask);
    if(!n::equal_bits(n::where(blocked,initial.at(key),zero),n::where(blocked,after.at(key),zero))||
        n::max(n::abs(n::where(blocked,partials.at(key),zero))).item()!=0)throw std::runtime_error("Masked weights or partials changed");}
   for(auto row:rows)batches<<epoch<<'\t'<<updates<<'\t'<<row<<'\n';++updates;
  }
  double loss=Evaluate(p,images[1]).at("loss").item();history<<epoch<<'\t'<<loss<<'\t'<<loss/std::log(2.)<<'\n';validation.push_back(loss/std::log(2.));
  Save(root/("epoch"+std::to_string(epoch)+"_arrays.npz"),Weights(p));
  Save(root/("epoch"+std::to_string(epoch)+"_samples.npz"),Sample(p,8,8639));
 }
 if(updates!=48||optimizer.iterations()!=48)throw std::runtime_error("48 Adam writes");
 p.save((root/"final.npz").string());Save(root/"final_gradients.npz",Partials(p,n::grad(m::PixelCnnPP(p,first).loss,p.parameters())));
 n::ParameterStore restored(8609);{n::NoGradGuard guard;m::PixelCnnPP(restored,n::zeros({1,8,8,3}));}
 restored.load((root/"final.npz").string(),true);if(!Equal(Weights(p),Weights(restored)))throw std::runtime_error("Fresh restore");
 const auto before=Weights(restored),out=Evaluate(restored,images[2]);Save(root/"model_arrays.npz",before);Save(root/"outputs.npz",out);
 auto single=n::take_rows(images[2],{0}),head=Evaluate(restored,single).at("parameters");
 if(n::max(n::abs(head-n::take_rows(out.at("parameters"),{0}))).item()>2e-6)throw std::runtime_error("Single/batch head parity");
 std::vector<T> jacobian;
 auto sites=n::reshape(n::arange(0,64),{1,8,8,1});
 for(int site=0;site<64;++site){auto input=single.detach().clone().requires_grad_();
  auto parameters=n::reshape(m::GatedPixelConvolutional(restored,input,T(),false,3,30).logits,{1,64,30});
  auto g=n::reshape(n::grad(n::sum(n::slice_axis(parameters,1,site,site+1)),{input})[0],{64,3});
  if(n::max(n::abs(n::slice_axis(g,0,site,64))).item()!=0)throw std::runtime_error("Whole current/future RGB derivatives");
  auto changed=n::where(n::greater_equal(sites,site),-single,single);auto changed_head=Evaluate(restored,changed).at("parameters");
  if(n::max(n::abs(n::slice_axis(n::reshape(changed_head-head,{1,64,30}),1,0,site+1))).item()!=0)throw std::runtime_error("Whole-pixel future flip");
  jacobian.push_back(g.detach());
 }
 Save(root/"causality.npz",{{"images",single},{"parameters",head},{"jacobian",n::stack(jacobian)}});
 auto samples=Sample(restored,24,8639);Save(root/"samples.npz",samples);if(!Equal(samples,Sample(restored,24,8639)))throw std::runtime_error("Repeated RGB sampling");
 auto truth=n::take_rows(images[2],{0,1,2,3,4,5});auto completion=Sample(restored,6,8641,truth,32);completion["truth"]=truth;
 Save(root/"completions.npz",completion);
 if(!n::equal_bits(n::slice_axis(n::reshape(truth,{6,64,3}),1,0,32),n::slice_axis(n::reshape(completion.at("images"),{6,64,3}),1,0,32)))throw std::runtime_error("Known prefix changed");
 auto observed=n::where(n::less(sites,32),truth,n::zeros_like(truth));
 auto gallery=n::reshape(n::stack({truth,observed,completion.at("images")},1),{18,8,8,3});Save(root/"completion_gallery.npz",{{"images",gallery}});
 n::save_image_grid(samples.at("images"),(root/"samples.png").string(),6,-1,1,0,220/255.,8);
 n::save_image_grid(gallery,(root/"completions.png").string(),3,-1,1,0,220/255.,8);
 if(!Equal(before,Weights(restored)))throw std::runtime_error("Inference mutation");
 {n::NoGradGuard guard;auto f64=n::DType::Float64;
  auto counts=n::sum(n::one_hot(codes[0],256,1,0,f64),{0,1,2});auto baseline=(counts+.5)/(128*64+128.);
  Save(root/"baseline.npz",{{"probability",baseline}});
  auto hot=n::one_hot(codes[2],256,1,0,f64);auto b_loss=-n::mean(n::sum(hot*n::log(n::reshape(baseline,{1,1,1,3,256})),{4}));
  Save(root/"summary.npz",{{"validation_bits",n::from_vector(validation,{3})},{"test_bits",n::cast(out.at("loss"),f64)/std::log(2.)},
   {"baseline_bits",b_loss/std::log(2.)},{"uniform_bits",n::full({},8,f64)}});
  std::print("| Fixed protocol | Value |\n|---|---:|\n| CIFAR fit / validation / test |128 /32 /32|\n| Stored / active / masked values |1410 /962 /448|\n| Epochs / Adam updates |3 /48|\n| Whole-pixel causal entries checked |12288|\n| Test bits per8-bit RGB channel |{:.6f}|\n| Fit-only channel histogram |{:.6f}|\n| Uniform baseline |8|\n",out.at("loss").item()/std::log(2.),b_loss.item()/std::log(2.));
 }
}
