 double baseline=a.at("baseline_bits").item();
 dm::graphics::RPlot::create().lines({1,2,3},a.at("validation_bits").to_vector<double>(),"Validation",{37,99,235})
 .points({3},{a.at("test_bits").item()},"Fixed-final test",{220,38,38},6)
 .lines({1,3},{baseline,baseline},"Fit-only histogram",{22,163,74})
 .lines({1,3},{8,8},"Uniform8-bit codes",{100,116,139})
 .y_limits(7,10.5).x_label("Fixed epoch").y_label("Bits per8-bit RGB channel")
 .title("The fixed final density improves on both simple baselines").save_svg("build/pp_history.svg");
}
