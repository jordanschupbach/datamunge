 dm::graphics::Diagram d(76,1900);dm::graphics::DiagramNodeStyle s;
 s.width=9;s.height=4.8;s.font_size=31;
 d.node("past",{-29,2},"Whole RGB past\nCurrent excluded",s)
 .node("context",{-17,2},"3 gated blocks\nWidth4 streams",s)
 .node("head",{-5,2},"30 parameters\n3 components",s)
 .node("choice",{7,2},"One component\nPer RGB pixel",s)
 .node("red",{19,2},"Draw R\nQuantize8-bit",s)
 .node("green",{31,2},"Draw G given R\nQuantize8-bit",s)
 .node("blue",{31,-7},"Draw B given R,G\nQuantize8-bit",s)
