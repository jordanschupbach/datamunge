 d.node("x",{-24,0},"Image canvas\nStrict raster past",s)
 .node("v0",{-10,6},"Vertical block 0\nTop raw row only",s)
 .node("v1",{4,6},"Vertical block 1\nCausal feature rows",s)
 .node("v2",{18,6},"Vertical block 2\nCausal feature rows",s)
 .node("h0",{-10,-6},"Horizontal block 0\nLeft raw site only",s)
