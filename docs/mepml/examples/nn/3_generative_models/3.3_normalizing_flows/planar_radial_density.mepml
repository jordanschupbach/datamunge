\image(figures/pr_radial_latent.svg)
// result_end

\caption(The radial latent plot retains all 1,024 supplied Gaussian draws and 128 transformed test rows.)
\alttext(An equal-coordinate-scale scatter plot compares the supplied standard-Gaussian prior with transformed held-out coordinates.)

> Verify each actual whole-map determinant on its own path

The following paired panels retain all 128 forward test rows and all 1,024
inverse prior rows per family. Analytic log determinants are compared with the
log determinant of actual autograd Jacobians. These values vary with the supplied
point; the inverse panel uses the original Gaussian input, not a re-labelled
forward test batch. Signed residual plots retain every difference. The fitted
planar ranges are −.131517187 to −.092588484 forward and .093196355 to
.131750777 inverse; radial ranges are −.268946916 to −.074667394 forward and
.089262053 to .275239974 inverse. Positive actual determinants agree within
Float32 rounding. The independent audit separately composes Double matrix
Jacobians and checks both families, all 96 Adam writes and all source samples.

```{cpp, results="markdown", file="figures/pr_planar_volume.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main(){
 namespace n=dm::nn;std::map<std::string,n::Tensor> data,out,samples,v;
 for(auto& [k,x]:n::load_npz("build/planar_radial_density/planar/data.npz"))data[k]=x;
 for(auto& [k,x]:n::load_npz("build/planar_radial_density/planar/outputs.npz"))out[k]=x;
 for(auto& [k,x]:n::load_npz("build/planar_radial_density/planar/samples.npz"))samples[k]=x;
 for(auto& [k,x]:n::load_npz("build/planar_radial_density/planar/plot_values.npz"))v[k]=x;
 auto panel=[&](const n::Tensor& points,const n::Tensor& analytic,const n::Tensor& actual,const char* title,const char* xlabel){
  auto x=n::select(points,1,0).to_vector<double>();auto p=dm::graphics::RPlot::create();
  p.points(x,analytic.to_vector<double>(),"Analytic logdet",{37,99,235},3)
  .points(x,actual.to_vector<double>(),"Actual Jacobian",{234,88,12},1)
  .margins(72,22,54,64).y_limits(-.4,.7).x_label(xlabel).y_label("Log absolute determinant, nats").title(title);return p;};
 dm::graphics::RLayout::create(1,2)
 .add(panel(data.at("test_points"),out.at("forward_logdet"),v.at("actual_logdet"),"Planar forward: all128 test rows","Observed x0"))
 .add(panel(samples.at("prior"),samples.at("inverse_logdet"),v.at("inverse_actual_logdet"),"Planar inverse: all1024 prior rows","Supplied latent z0"))
 .size(1100,500).fit_panels().save_svg("build/pr_planar_volume.svg");
}
```
