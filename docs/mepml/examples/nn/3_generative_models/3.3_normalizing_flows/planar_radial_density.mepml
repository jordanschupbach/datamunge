```{cpp, results="markdown", file="figures/pr_radial_fixture.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main(){
 namespace n=dm::nn;using T=n::Tensor;std::map<std::string,T> f;
 for(auto& [k,x]:n::load_npz("build/planar_radial_density/radial/elementary_fixtures.npz"))f[k]=n::cast(x,n::DType::Float64);
 auto col=[](const T& x,int k){return n::select(x,1,k);};auto input=f.at("input"),forward=f.at("forward"),inverse=f.at("inverse");
 auto actual=[&](const char* prefix){auto a=f.at(std::string(prefix)+"jacobian_row0"),b=f.at(std::string(prefix)+"jacobian_row1");return n::log(col(a,0)*col(b,1)-col(a,1)*col(b,0));};
 auto af=actual(""),ai=actual("inverse_"),error=n::max(n::abs(f.at("roundtrip")-input),{1},false);
 auto left=dm::graphics::RPlot::create();left.segments(col(input,0).to_vector<double>(),col(input,1).to_vector<double>(),col(forward,0).to_vector<double>(),col(forward,1).to_vector<double>(),{203,213,225},1.5)
 .points(col(input,0).to_vector<double>(),col(input,1).to_vector<double>(),"Supplied input",{100,116,139},5)
 .points(col(forward,0).to_vector<double>(),col(forward,1).to_vector<double>(),"Forward",{37,99,235},3)
 .points(col(inverse,0).to_vector<double>(),col(inverse,1).to_vector<double>(),"Inverse of supplied input",{234,88,12},2)
 .margins(78,22,54,70).x_limits(-12,12).y_limits(-12,12).x_label("Coordinate 0").y_label("Coordinate 1").title("Radial: all nine strong-fixture points");
 auto rows=n::arange(0,9).to_vector<double>();auto right=dm::graphics::RPlot::create();
 right.points(rows,f.at("forward_logdet").to_vector<double>(),"Forward analytic",{37,99,235},4)
 .points(rows,af.to_vector<double>(),"Forward actual",{37,99,235},1)
 .points(rows,f.at("inverse_logdet").to_vector<double>(),"Inverse analytic",{234,88,12},4)
 .points(rows,ai.to_vector<double>(),"Inverse actual",{234,88,12},1)
 .margins(78,22,54,70).x_limits(-.5,8.5).y_limits(-5,8).x_label("Original fixture row").y_label("Log absolute determinant, nats").title("Both actual Jacobians and analytic logdets");
 dm::graphics::RLayout::create(1,2).add(left).add(right).size(1100,574).fit_panels().save_svg("build/pr_radial_fixture.svg");
 n::save_npz("build/pr_radial_fixture_plot_values.npz",{{"forward_actual_logdet",af},{"inverse_actual_logdet",ai},{"roundtrip_max_coordinate_error",error}});
 std::print("| Row | Input x0,x1 | Forward y0,y1 | Inverse of input | Forward logdet | Inverse logdet | Roundtrip max error |\n|---:|---|---|---|---:|---:|---:|\n");
 auto x=input.to_vector<double>(),y=forward.to_vector<double>(),z=inverse.to_vector<double>(),ld=f.at("forward_logdet").to_vector<double>(),il=f.at("inverse_logdet").to_vector<double>(),e=error.to_vector<double>();
 for(int i=0;i<9;++i)std::print("|{}|{:.7g},{:.7g}|{:.7g},{:.7g}|{:.7g},{:.7g}|{:.10g}|{:.10g}|{:.7g}|\n",i,x[2*i],x[2*i+1],y[2*i],y[2*i+1],z[2*i],z[2*i+1],ld[i],il[i],e[i]);
}
