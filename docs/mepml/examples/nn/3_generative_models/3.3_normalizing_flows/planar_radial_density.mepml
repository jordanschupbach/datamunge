int main(){
 std::filesystem::create_directories("build");dm::graphics::Diagram d(28,1150);
 dm::graphics::DiagramNodeStyle s;s.width=10;s.height=5;s.font_size=32;
 d.node("input",{-24,0},"Two coordinates\nChoose one family",s)
 .node("map",{-11,0},"Planar tanh shift\nRadial radius change",s)
 .node("volume",{2,0},"Positive determinant\nOwn inverse path",s)
 .node("stack",{15,0},"4 elementary maps\nPositive global scale",s)
 .node("density",{28,0},"Gaussian base\nAdd per-row logdet",s)
 .edge("input","map").edge("map","volume").edge("volume","stack").edge("stack","density")
 .save_svg("build/pr_method.svg");
}
