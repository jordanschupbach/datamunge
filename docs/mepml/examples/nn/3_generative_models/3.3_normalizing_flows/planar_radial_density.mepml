\image(figures/pr_planar_volume.svg)
// result_end

\caption(All 2,304 analytic/actual determinant markers are retained for planar: two per forward or inverse input.)
\alttext(Two panels compare analytic and actual log determinants for every forward test row and inverse prior row.)

```{cpp, results="markdown", file="figures/pr_planar_jacobians.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main(){
 namespace n=dm::nn;std::map<std::string,n::Tensor> v,o,samples;
 for(auto& [k,x]:n::load_npz("build/planar_radial_density/planar/plot_values.npz"))v[k]=x;
 for(auto& [k,x]:n::load_npz("build/planar_radial_density/planar/outputs.npz"))o[k]=x;
 for(auto& [k,x]:n::load_npz("build/planar_radial_density/planar/samples.npz"))samples[k]=x;
 auto a=(v.at("actual_logdet")-n::cast(o.at("forward_logdet"),n::DType::Float64))*1e7,b=(v.at("inverse_actual_logdet")-n::cast(samples.at("inverse_logdet"),n::DType::Float64))*1e7;
 auto p=dm::graphics::RPlot::create();p.points(n::arange(0,128).to_vector<double>(),a.to_vector<double>(),"Forward, all128 test rows",{37,99,235},3)
 .points(n::arange(0,1024).to_vector<double>(),b.to_vector<double>(),"Inverse, all1024 prior rows",{234,88,12},2)
 .y_limits(-6,9).x_label("Row index in its own pool").y_label("(Actual - analytic logdet) x 1e7")
 .title("Planar actual Jacobians match each per-point log determinant")
 .save_svg("build/pr_planar_jacobians.svg");
}
```
