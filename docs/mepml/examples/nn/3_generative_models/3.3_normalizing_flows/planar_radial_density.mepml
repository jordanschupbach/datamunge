```{cpp, results="markdown", file="figures/pr_history.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <fstream>
int main(){
 namespace n=dm::nn;using T=n::Tensor;std::map<std::string,T> v;
 for(auto& [k,x]:n::load_npz("build/planar_radial_density/planar/plot_values.npz"))v[k]=x;
 auto mean=[](const T& x){return n::select(n::cumsum(x/double(x.size(0)),0),0,x.size(0)-1).item();};
 auto plot=dm::graphics::RPlot::create();std::vector<double> final;int index=0;std::vector<dm::graphics::RGB> colors{{37,99,235},{234,88,12}};
 for(auto family:{"planar","radial"}){std::ifstream file(std::string("build/planar_radial_density/")+family+"/history.tsv");std::string header;std::getline(file,header);std::vector<double> epochs,losses;double e,l,d;while(file>>e>>l>>d){epochs.push_back(e);losses.push_back(l);}plot.lines(epochs,losses,std::string(family)+" validation",colors[index]);
  std::map<std::string,T> out;for(auto& [k,x]:n::load_npz(std::string("build/planar_radial_density/")+family+"/outputs.npz"))out[k]=x;final.push_back(out.at("loss").item());plot.points({3},{final.back()},std::string(family)+" fixed-final test",colors[index++],5);}
 double full=mean(v.at("full_gaussian_point_nll")),diag=mean(v.at("diagonal_gaussian_point_nll")),identity=mean(v.at("identity_point_nll")),truth=mean(v.at("true_point_nll"));
 plot.lines({1,3},{full,full},"Test fitted full Gaussian",{220,38,38}).lines({1,3},{diag,diag},"Test fitted diagonal",{126,34,206})
 .lines({1,3},{identity,identity},"Test identity Gaussian",{100,116,139}).lines({1,3},{truth,truth},"Test analytic truth",{22,163,74})
 .size(1100,620).margins(90,24,60,80).y_limits(2.75,3.35).x_label("Fixed fitting epoch").y_label("NLL, nats per two-coordinate row").title("Fixed-final: planar slight gain, radial Gaussian shortfall").save_svg("build/pr_history.svg");
 std::print("| Fixed-final test method | NLL, nats/row |\n|---|---:|\n| Planar |{:.12f}|\n| Radial |{:.12f}|\n| Fitting-only full Gaussian |{:.12f}|\n| Fitting-only diagonal Gaussian |{:.12f}|\n| Identity Gaussian |{:.12f}|\n| Analytic banana truth |{:.12f}|\n",final[0],final[1],full,diag,identity,truth);
}
