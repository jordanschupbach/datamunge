 auto left=a.at("prior"),right=b.at("latent");
 dm::graphics::RPlot::create().points(n::select(left,1,0).to_vector<double>(),n::select(left,1,1).to_vector<double>(),"Gaussian prior",{148,163,184},3)
 .points(n::select(right,1,0).to_vector<double>(),n::select(right,1,1).to_vector<double>(),"Transformed test",{234,88,12},4)
 .size(900,942).margins(90,24,72,84).x_limits(-4,7).y_limits(-4,7)
 .x_label("Coordinate 0").y_label("Coordinate 1").title("Radial latent space: transformed test and all 1024 Gaussian draws").save_svg("build/pr_radial_latent.svg");
}
```
