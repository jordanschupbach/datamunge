> Keep parameter gradients through both inverses

These are final-model partials of the separate eight-prior-row inverse objective,
not the fitting NLL. All 22 planar and 18 radial scalar coordinates are shown;
vector leaves are expanded by coordinate. The table provides the name for every
plotted ordinal. Independent Double finite differences check all 40 parameter
coordinates, maximum error 1.877e−10; the native full program matches every
source Float32 partial exactly. A live higher graph is a source computational
graph property; it does not override the planar stopped-correction caveat.

```{cpp, results="markdown", file="figures/pr_inverse_gradients.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main(){
 namespace n=dm::nn;auto layout=dm::graphics::RLayout::create(1,2);
 std::print("| Family | Ordinal | Parameter coordinate | Inverse-objective partial |\n|---|---:|---|---:|\n");
 for(auto family:{"planar","radial"}){
  std::vector<double> rows,gradients;int row=0;
  for(auto& [key,value]:n::load_npz(std::string("build/planar_radial_density/")+family+"/inverse_gradients.npz")){
   auto values=value.to_vector<double>();for(std::size_t i=0;i<values.size();++i){rows.push_back(row);gradients.push_back(values[i]);std::print("|{}|{}|{}[{}]|{:.12g}|\n",family,row++,key,i,values[i]);}}
  auto plot=dm::graphics::RPlot::create();plot.lines({-.5,22.5},{0,0},"Zero reference",{148,163,184})
  .points(rows,gradients,"All scalar partials",{37,99,235},4)
  .margins(78,22,54,70).x_limits(-.5,22.5).y_limits(-4.1,2.8).x_label("Parameter-coordinate ordinal (table)").y_label("Inverse-objective partial").title(std::string(family)+": all inverse parameter partials");layout.add(plot);
 }
 layout.size(1100,520).fit_panels().save_svg("build/pr_inverse_gradients.svg");
}
