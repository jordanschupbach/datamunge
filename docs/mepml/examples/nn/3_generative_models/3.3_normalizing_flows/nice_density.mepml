 std::vector<dm::graphics::RGB> colors{{148,163,184},{37,99,235},{234,88,12}};
 for(auto split:{"fit","validation","test"}){auto points=data.at(std::string(split)+"_points");
  plot.points(n::select(points,1,0).to_vector<double>(),n::select(points,1,1).to_vector<double>(),split,colors[i++],3);}
 plot.size(900,942).margins(90,24,72,84).x_limits(-4,7).y_limits(-4,7)
 .x_label("x0").y_label("x1").title("Original banana pools: every row retained")
 .save_svg("build/nice_data.svg");
}
