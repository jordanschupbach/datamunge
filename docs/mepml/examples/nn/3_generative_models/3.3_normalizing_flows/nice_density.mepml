 auto panel=[&](const char* key,const char* title){auto p=n::exp(data.at(key)).to_vector<double>();
  std::vector<std::vector<double>> z(128,std::vector<double>(128));
  for(int x=0;x<128;++x)for(int y=0;y<128;++y)z[x][y]=p[(127-y)*128+x];
  auto plot=dm::graphics::RPlot::create();plot.image(axis,axis,z,dm::graphics::terrain_colors(32),0,.20)
  .margins(72,22,54,64).x_limits(-4,4).y_limits(-4,4).x_label("x0").y_label("x1").title(title);return plot;};
 dm::graphics::RLayout::create(1,2).add(panel("true_log_probability","Analytic banana PDF"))
 .add(panel("model_log_probability","Final NICE PDF")).size(1100,574).fit_panels()
 .save_svg("build/nice_density.svg");
}
