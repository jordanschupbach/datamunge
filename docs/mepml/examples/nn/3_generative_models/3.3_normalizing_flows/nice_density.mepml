> Hand-check one nonlinear coupling and its triangular derivative

Set s(a)=.75 tanh(.8a+.2), b=.5. At a=0, s=.148031490 and the changed
coordinate is .648031490. Its derivative is .6[1−tanh²(.8a+.2)]; the determinant
remains one at every a. The program sets one active hidden unit of the native
16-unit conditioner, checks all five listed points, subtracts the shift to
invert them and compares native input derivatives with the analytic slope.
There is no fitting or random-data substitution in this example.

```{cpp, results="markdown", file="figures/nice_coupling_toy.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main(){
 namespace n=dm::nn;namespace m=n::models;auto type=n::DType::Float64;n::ParameterStore p(1,type);
 auto a=n::from_vector(std::vector<double>{-2,-1,0,1,2},{5});
 auto x=n::stack({a,n::full({5},.5,type)},1).requires_grad_();m::NiceCoupling(p,x,0);
 for(auto name:p.names())p.set(name,n::zeros(p.at(name).shape(),type));
 std::vector<double> w(16),bias(16),v(16);w[0]=.8;bias[0]=.2;v[0]=.75;
 p.set("coupling0/hidden/W",n::from_vector(w,{1,16}));p.set("coupling0/hidden/b",n::from_vector(bias,{16}));p.set("coupling0/shift/W",n::from_vector(v,{16,1}));
 auto y=m::NiceCoupling(p,x,0),rec=m::NiceCoupling(p,y,0,true);
 auto changed=n::reshape(n::slice_axis(y,1,1,2),{5});auto expected=.5+.75*n::tanh(.8*a+.2);
 auto j0=n::grad(n::sum(n::slice_axis(y,1,0,1)),{x},n::GradOptions{true,false,false})[0];
 auto j1=n::grad(n::sum(n::slice_axis(y,1,1,2)),{x})[0];
 auto slope=n::reshape(n::slice_axis(j1,1,0,1),{5});auto theory=.6*(1.-n::square(n::tanh(.8*a+.2)));
 auto determinant=n::select(j0,1,0)*n::select(j1,1,1)-n::select(j0,1,1)*n::select(j1,1,0);
 if(n::max(n::abs(changed-expected)).item()>1e-14||n::max(n::abs(rec-x)).item()>1e-14||n::max(n::abs(slope-theory)).item()>1e-14||n::max(n::abs(determinant-1.)).item()!=0)throw std::runtime_error("Worked coupling/Jacobian");
 auto axis=n::arange(0,257,1,n::DType::Float64)/64.-2.;auto grid=n::stack({axis,n::full({257},.5,type)},1);
 auto curve=n::select(m::NiceCoupling(p,grid,0),1,1);
 dm::graphics::RPlot::create().lines(axis.to_vector<double>(),curve.to_vector<double>(),"b + s(a)",{37,99,235})
 .points(a.to_vector<double>(),std::vector<double>(5,.5),"Original b",{100,116,139},5)
 .points(a.to_vector<double>(),changed.to_vector<double>(),"Native coupling",{220,38,38},4)
 .y_limits(-.4,2.0).x_label("Conditioning coordinate a").y_label("Other coordinate")
 .title("One nonlinear shift: exact-form subtraction inverts addition").save_svg("build/nice_coupling_toy.svg");
 std::print("| a | Changed b | d(changed b)/da | Determinant |\n|---:|---:|---:|---:|\n");
 auto av=a.to_vector<double>(),yv=changed.to_vector<double>(),sv=slope.to_vector<double>();
 for(int i=0;i<5;++i)std::print("|{:.0f}|{:.9f}|{:.9f}|1|\n",av[i],yv[i],sv[i]);
}
