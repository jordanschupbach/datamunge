 for(auto& [k,x]:n::load_npz("build/real_nvp_density/outputs.npz"))o[k]=x;
 for(auto& [k,x]:n::load_npz("build/real_nvp_density/samples.npz"))samples[k]=x;
 auto a=(v.at("actual_logdet")-n::cast(o.at("forward_logdet"),n::DType::Float64))*1e7,b=(v.at("inverse_actual_logdet")-n::cast(samples.at("inverse_logdet"),n::DType::Float64))*1e7;
 auto p=dm::graphics::RPlot::create();p.points(n::arange(0,128).to_vector<double>(),a.to_vector<double>(),"Forward, all128 test rows",{37,99,235},3)
 .points(n::arange(0,1024).to_vector<double>(),b.to_vector<double>(),"Inverse, all1024 prior rows",{234,88,12},2)
 .y_limits(-5,7).x_label("Row index in its own pool").y_label("(Actual - analytic logdet) x 1e7")
 .title("Actual Jacobians match each per-point log determinant")
 .save_svg("build/rnvp_jacobians.svg");
}
