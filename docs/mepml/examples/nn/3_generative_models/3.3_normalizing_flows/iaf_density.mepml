> Hand-check parallel sampling and sequential recovery

Activate only source block 0 and hidden unit8: h=tanh(.7a+.1), mu0=.2,
s0=.8tanh(.1), mu1=.3h−.1, s1=.8tanh(.2h+.05), with known input u=(a,.5).
Zero every other head and the global scale so the remaining blocks are identity.
The parallel observation map is x0=a exp(s0)+.2 and x1=.5exp(s1)+mu1.
Its positive log determinant is s0+s1; the actual off-diagonal derivative is
 dx1/da=.5exp(s1)s1'+mu1'.

For density, first recover a=(x0−.2)exp(−s0), recompute the conditioner using
that recovered prefix, then recover .5=(x1−mu1)exp(−s1). The complete program
checks the two actual whole-map Jacobians, the negative density determinant,
manual sequential recovery, and all five points against these formulas.
There is no fitting or generated observation pool in this worked example.

```{cpp, results="markdown", file="figures/iaf_conditioner_toy.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main(){
 namespace n=dm::nn;namespace m=n::models;auto type=n::DType::Float64;n::ParameterStore p(1,type);
 auto a=n::from_vector(std::vector<double>{-2,-1,0,1,2},{5});auto base=n::stack({a,n::full({5},.5,type)},1).requires_grad_();
 m::IafDensity(p,base);for(auto name:p.names())p.set(name,n::zeros(p.at(name).shape(),type));
 std::vector<double> iw(32),bias(16),ow(64);iw[8]=.7;bias[8]=.1;ow[8*4+1]=.3;ow[8*4+3]=.2;
 p.set("autoregressive0/hidden/W",n::from_vector(iw,{2,16}));p.set("autoregressive0/hidden/b",n::from_vector(bias,{16}));
 p.set("autoregressive0/heads/W",n::from_vector(ow,{16,4}));p.set("autoregressive0/heads/b",n::from_vector(std::vector<double>{.2,-.1,.1,.05},{4}));
 auto generated=m::IafInverse(p,base);auto observed=generated.value.detach().clone().requires_grad_();auto density=m::IafDensity(p,observed);
 auto h=n::tanh(.7*a+.1),s1=.8*n::tanh(.2*h+.05),mu1=.3*h-.1;
 double s0=.8*std::tanh(.1);auto expected=.5*n::exp(s1)+mu1;
 auto dh=.7*(1.-n::square(h)),ds=.8*(1.-n::square(n::tanh(.2*h+.05)))*.2*dh;
 auto theory=.5*n::exp(s1)*ds+.3*dh;
 auto j0=n::grad(n::sum(n::slice_axis(generated.value,1,0,1)),{base},n::GradOptions{true,false,false})[0];
 auto j1=n::grad(n::sum(n::slice_axis(generated.value,1,1,2)),{base})[0];
 auto d0=n::grad(n::sum(n::slice_axis(density.latent,1,0,1)),{observed},n::GradOptions{true,false,false})[0];
 auto d1=n::grad(n::sum(n::slice_axis(density.latent,1,1,2)),{observed})[0];
 auto determinant=[](const n::Tensor& a,const n::Tensor& b){return n::select(a,1,0)*n::select(b,1,1)-n::select(a,1,1)*n::select(b,1,0);};
 auto det=determinant(j0,j1),density_det=determinant(d0,d1);
 auto recovered=observed*0.;
 for(int c=0;c<2;++c){auto heads=m::MafConditioner(p,recovered,0);
  auto value=(n::slice_axis(observed,1,c,c+1)-n::slice_axis(heads.mean,1,c,c+1))*n::exp(-n::slice_axis(heads.scale,1,c,c+1));
  auto other=n::slice_axis(recovered,1,1-c,2-c);recovered=c?n::concat({other,value},1):n::concat({value,other},1);}
 if(n::max(n::abs(n::select(generated.value,1,1)-expected)).item()>1e-14||n::max(n::abs(n::select(j1,1,0)-theory)).item()>1e-14||n::max(n::abs(n::log(det)-generated.logdet)).item()>1e-14||n::max(n::abs(n::log(density_det)-density.logdet)).item()>1e-14||n::max(n::abs(recovered-base)).item()>1e-14||n::max(n::abs(density.latent-base)).item()>1e-14||n::max(n::abs(generated.logdet-s0-s1)).item()>1e-14)throw std::runtime_error("Worked parallel IAF and sequential density");
 auto axis=n::arange(0,257,1,type)/64.-2.;auto grid=n::stack({axis,n::full({257},.5,type)},1);auto curve=n::select(m::IafInverse(p,grid).value,1,1);
 dm::graphics::RPlot::create().lines(axis.to_vector<double>(),curve.to_vector<double>(),"Parallel observation x1",{37,99,235})
 .points(a.to_vector<double>(),std::vector<double>(5,.5),"Known input u1=.5",{100,116,139},5)
 .points(a.to_vector<double>(),n::select(generated.value,1,1).to_vector<double>(),"Native IAF sample map",{220,38,38},4)
 .y_limits(0,1.4).x_label("Earlier known input a=u0").y_label("Second coordinate")
 .title("Known inputs make affine IAF sampling parallel").save_svg("build/iaf_conditioner_toy.svg");
 n::save_npz("build/iaf_toy_values.npz",{{"a",a},{"observation",generated.value},{"logdet",generated.logdet},{"density_logdet",density.logdet},{"actual_determinant",det},{"density_actual_determinant",density_det},{"jacobian_row0",j0},{"jacobian_row1",j1},{"recovered",recovered},{"curve_axis",axis},{"curve",curve}});
 std::print("| Known a | Observation x1 | Sampling logdet | Actual sampling determinant |\n|---:|---:|---:|---:|\n");
 auto av=a.to_vector<double>(),xv=n::select(generated.value,1,1).to_vector<double>(),lv=generated.logdet.to_vector<double>(),dv=det.to_vector<double>();
 for(int i=0;i<5;++i)std::print("|{:.0f}|{:.9f}|{:.9f}|{:.9f}|\n",av[i],xv[i],lv[i],dv[i]);
}
