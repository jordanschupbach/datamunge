> Resolve numerical refinement and the source coefficient floor

For steps h, the source computes dt=1.f/h, half=.5f*dt, sixth=dt/6.f and all
stage times in Float32, then promotes them for tensor arithmetic. This remains
true with Float64 tensors. In particular, 8*6*Double(Float32((1.f/8)/6.f))
is slightly above 1. The grouping of each RK4 update is (a+d)+2(b+c).
Refining the solver reduces truncation error, but does not remove this retained
coefficient/time rounding policy.

The following five runs use 4,8,16,32,64 steps on every one of the same 257
input rows. The table and plot retain the maximum coordinate error against the
continuous solution, the actual-discrete-logdet minus integrated-trace error,
and reverse-RK4 roundtrip error. Coordinate accuracy reaches a floor near
2.66e−8 here. A smaller numerical residual is not a claim of an exact inverse
or exact discrete-map density.

```{cpp, results="markdown", file="figures/cnf_refinement.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
namespace n=dm::nn;namespace m=n::models;using T=n::Tensor;
void SetField(n::ParameterStore& p,double output_weight,bool cross=false){
 m::CnfField(p,n::zeros({1,2},n::DType::Float64),0.f);
 std::vector<double> wi(24,0),wo(16,0);wi[0]=1.;if(cross)wi[8]=1.;wo[0]=output_weight;if(cross)wo[1]=.5;
 p.set("field/hidden/W",n::from_vector(wi,{3,8}));p.set("field/output/W",n::from_vector(wo,{8,2}));p.set("field/hidden/b",n::zeros({8},n::DType::Float64));p.set("field/output/b",n::zeros({2},n::DType::Float64));
}
T ActualLogdet(const T& value,const T& input){
 const auto keep=n::GradOptions{true,false,false};auto a=n::grad(n::sum(n::select(value,1,0)),{input},keep)[0],b=n::grad(n::sum(n::select(value,1,1)),{input},keep)[0];
 auto determinant=n::select(a,1,0)*n::select(b,1,1)-n::select(a,1,1)*n::select(b,1,0);
 if(n::min(determinant).item()<=0)throw std::runtime_error("Positive worked-map determinant");return n::log(determinant);
}
T Continuous(const T& x){auto u=n::sinh(x)*n::exp(n::full({},.9,n::DType::Float64));return n::log(u+n::sqrt(n::square(u)+1.));}
T ContinuousLogdet(const T& x){return .9+n::log(n::cosh(x))-n::log(n::cosh(Continuous(x)));}

int main(){
 auto type=n::DType::Float64;n::ParameterStore p(10003,type);SetField(p,3.);
 auto axis=n::arange(0,257,1,type)/64.-2.;auto input=n::stack({axis,n::zeros({257},type)},1).requires_grad_();auto exact=Continuous(axis);
 std::vector<double> steps,states,determinants,roundtrips;
 std::print("| RK4 steps | Max coordinate / continuous error | Max actual logdet / integrated error | Max reverse roundtrip error |\n|---:|---:|---:|---:|\n");
 for(int count:{4,8,16,32,64}){auto path=m::CnfIntegrate(p,input,false,count),rec=m::CnfIntegrate(p,path.latent,true,count);auto actual=ActualLogdet(path.latent,input);
  double state=n::max(n::abs(n::select(path.latent,1,0)-exact)).item(),det=n::max(n::abs(actual-path.logdet)).item(),back=n::max(n::abs(rec.latent-input)).item();
  steps.push_back(count);states.push_back(state);determinants.push_back(det);roundtrips.push_back(back);std::print("|{}|{:.12g}|{:.12g}|{:.12g}|\n",count,state,det,back);}
 auto s=n::from_vector(steps,{5}),a=n::from_vector(states,{5}),d=n::from_vector(determinants,{5}),r=n::from_vector(roundtrips,{5});auto x=n::log(s)/std::log(2.);
 dm::graphics::RPlot::create().lines(x.to_vector<double>(),(n::log(a)/std::log(10.)).to_vector<double>(),"Coordinate / exact ODE",{37,99,235})
 .lines(x.to_vector<double>(),(n::log(d)/std::log(10.)).to_vector<double>(),"Actual logdet / integral",{234,88,12})
 .lines(x.to_vector<double>(),(n::log(r)/std::log(10.)).to_vector<double>(),"Reverse RK4 roundtrip",{22,163,74})
 .points(x.to_vector<double>(),(n::log(a)/std::log(10.)).to_vector<double>(),"Five coordinate errors",{37,99,235},4)
 .points(x.to_vector<double>(),(n::log(d)/std::log(10.)).to_vector<double>(),"Five logdet errors",{234,88,12},4)
 .points(x.to_vector<double>(),(n::log(r)/std::log(10.)).to_vector<double>(),"Five roundtrip errors",{22,163,74},4)
 .size(1100,620).margins(90,24,60,80).x_limits(1.7,6.3).y_limits(-11.3,-2.5).x_label("Log2 fixed RK4 step count").y_label("Log10 maximum absolute error").title("Refinement retains the source Float32 coefficient/time policy").save_svg("build/cnf_refinement.svg");
 n::save_npz("build/cnf_refinement_values.npz",{{"steps",s},{"coordinate_error",a},{"logdet_error",d},{"roundtrip_error",r}});
}
