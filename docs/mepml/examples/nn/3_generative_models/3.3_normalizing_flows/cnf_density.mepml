```{cpp, results="markdown", file="figures/cnf_history.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <fstream>
int main(){
 namespace n=dm::nn;std::map<std::string,n::Tensor> out,v;
 for(auto& [k,x]:n::load_npz("build/cnf_density/outputs.npz"))out[k]=x;
 for(auto& [k,x]:n::load_npz("build/cnf_density/plot_values.npz"))v[k]=x;
 auto serial=[](const n::Tensor& x){return n::select(n::cumsum(x/double(x.size(0)),0),0,x.size(0)-1).item();};
 std::ifstream f("build/cnf_density/history.tsv");std::string header;std::getline(f,header);
 std::vector<double> epoch,loss;double e,l,d;while(f>>e>>l>>d){epoch.push_back(e);loss.push_back(l);}
 double full=serial(v.at("full_gaussian_point_nll")),diag=serial(v.at("diagonal_gaussian_point_nll")),identity=serial(v.at("identity_point_nll")),truth=serial(v.at("true_point_nll"));
 auto plot=dm::graphics::RPlot::create();plot.lines(epoch,loss,"Validation CNF",{37,99,235})
 .lines({1,3},{full,full},"Test fitted full Gaussian",{220,38,38})
 .lines({1,3},{diag,diag},"Test fitted diagonal",{234,88,12})
 .lines({1,3},{identity,identity},"Test identity Gaussian",{100,116,139})
 .lines({1,3},{truth,truth},"Test analytic truth",{22,163,74})
 .points({3},{out.at("loss").item()},"Final test CNF",{126,34,206},5)
 .y_limits(2.75,3.3).x_label("Fixed fitting epoch").y_label("NLL, nats per two-coordinate row")
 .title("CNF: tiny full-Gaussian gain, diagonal baseline better")
 .save_svg("build/cnf_history.svg");
 std::print("| Fixed-final test method | NLL, nats/row |\n|---|---:|\n| CNF |{:.12f}|\n| Fitting-only full Gaussian |{:.12f}|\n| Fitting-only diagonal Gaussian |{:.12f}|\n| Identity Gaussian |{:.12f}|\n| Analytic banana truth |{:.12f}|\n",out.at("loss").item(),full,diag,identity,truth);
}
