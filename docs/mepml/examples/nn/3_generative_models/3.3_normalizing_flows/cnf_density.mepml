\caption(All five solver resolutions use all 257 worked input rows. Coordinate error plateaus under the retained source Float32 coefficient policy while the other numerical residuals continue to decrease.)
\alttext(Three error profiles fall as step counts increase from 4 to 64; coordinate error levels near log10 error minus 7.6. All fifteen checked error markers remain visible.)

> Derive the deterministic two-probe identity

For a two-dimensional field Jacobian A, [Grathwohl et al., FFJORD
(2018)](https://arxiv.org/abs/1810.01367) motivates trace estimates using probe
contractions. This source uses a fixed pair e+=(1,1), e−=(1,−1):

$$ e_+^TAe_+=A_{00}+A_{01}+A_{10}+A_{11},\quad
 e_-^TAe_-=A_{00}-A_{01}-A_{10}+A_{11},\quad
 \tfrac12(e_+^TAe_++e_-^TAe_-)=\operatorname{tr}(A). $$
\alttext(The two fixed probe contractions have opposite off-diagonal terms, which cancel in their mean, leaving the exact two-dimensional field trace.)

The pair is deterministic, with no random probe stream. A fixed single probe
generally differs from divergence, even with arbitrarily small solver steps.
Native modes 0 and 3 use exact trace or the paired mean; modes 1/2 are fixed-probe
diagnostic integrals and generally do not define a density likelihood.

Set one hidden activation h=tanh(x0+x1), and velocity (.3h,.15h). Its Jacobian
is sech²(x0+x1)*[[.3,.3],[.15,.15]]. Exact trace is .45 sech², the plus probe
is .9 sech² and the minus probe is zero. The following native example retains
five checks and 257 curve rows. It also integrates all four modes: their states
are bit-identical, while the table shows their different trace integrals and
the actual discrete-map logdet. The integrated pair is a numerical full-trace
calculation; the single-probe columns are diagnostics.

```{cpp, results="markdown", file="figures/cnf_probe.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
namespace n=dm::nn;namespace m=n::models;using T=n::Tensor;
void SetField(n::ParameterStore& p,double output_weight,bool cross=false){
 m::CnfField(p,n::zeros({1,2},n::DType::Float64),0.f);
 std::vector<double> wi(24,0),wo(16,0);wi[0]=1.;if(cross)wi[8]=1.;wo[0]=output_weight;if(cross)wo[1]=.5;
 p.set("field/hidden/W",n::from_vector(wi,{3,8}));p.set("field/output/W",n::from_vector(wo,{8,2}));p.set("field/hidden/b",n::zeros({8},n::DType::Float64));p.set("field/output/b",n::zeros({2},n::DType::Float64));
}
T ActualLogdet(const T& value,const T& input){
 const auto keep=n::GradOptions{true,false,false};auto a=n::grad(n::sum(n::select(value,1,0)),{input},keep)[0],b=n::grad(n::sum(n::select(value,1,1)),{input},keep)[0];
 auto determinant=n::select(a,1,0)*n::select(b,1,1)-n::select(a,1,1)*n::select(b,1,0);
 if(n::min(determinant).item()<=0)throw std::runtime_error("Positive worked-map determinant");return n::log(determinant);
}
T Continuous(const T& x){auto u=n::sinh(x)*n::exp(n::full({},.9,n::DType::Float64));return n::log(u+n::sqrt(n::square(u)+1.));}
T ContinuousLogdet(const T& x){return .9+n::log(n::cosh(x))-n::log(n::cosh(Continuous(x)));}

int main(){
 auto type=n::DType::Float64;n::ParameterStore p(10003,type);SetField(p,1.,true);
 auto axis=n::from_vector(std::vector<double>{-2,-1,0,1,2},{5});auto input=n::stack({axis,n::zeros({5},type)},1).requires_grad_();auto f=m::CnfField(p,input,.5f);
 auto field_actual=[&](const T& value,const T& x){const auto keep=n::GradOptions{true,false,false};auto a=n::grad(n::sum(n::select(value,1,0)),{x},keep)[0],b=n::grad(n::sum(n::select(value,1,1)),{x},keep)[0];return n::select(a,1,0)+n::select(b,1,1);};
 auto actual=field_actual(f.velocity,input);auto exact=.45*(1.-n::square(n::tanh(axis)));
 if(n::max(n::abs(f.exact_trace-exact)).item()>1e-16||n::max(n::abs(.5*(f.hutchinson_plus+f.hutchinson_minus)-actual)).item()>1e-16||n::max(n::abs(f.hutchinson_minus)).item()!=0)throw std::runtime_error("Two-probe hand calculation");
 auto dense=n::arange(0,257,1,type)/64.-2.;auto grid=n::stack({dense,n::zeros({257},type)},1).requires_grad_();auto curve=m::CnfField(p,grid,.5f);auto curve_actual=field_actual(curve.velocity,grid);
 auto left=dm::graphics::RPlot::create();left.lines(dense.to_vector<double>(),n::select(curve.velocity,1,0).to_vector<double>(),"Velocity 0",{37,99,235}).lines(dense.to_vector<double>(),n::select(curve.velocity,1,1).to_vector<double>(),"Velocity 1",{234,88,12})
 .points(axis.to_vector<double>(),n::select(f.velocity,1,0).to_vector<double>(),"Five component-0 checks",{37,99,235},4).points(axis.to_vector<double>(),n::select(f.velocity,1,1).to_vector<double>(),"Five component-1 checks",{234,88,12},4)
 .margins(78,22,54,70).x_limits(-2.3,2.3).y_limits(-.4,.9).x_label("Input x0, x1=0").y_label("Field velocity").title("One hidden unit, cross-coordinate field");
 auto right=dm::graphics::RPlot::create();right.lines(dense.to_vector<double>(),curve.hutchinson_plus.to_vector<double>(),"Plus probe",{234,88,12}).lines(dense.to_vector<double>(),curve.hutchinson_minus.to_vector<double>(),"Minus probe",{22,163,74})
 .lines(dense.to_vector<double>(),curve.exact_trace.to_vector<double>(),"Exact field trace",{37,99,235}).lines(dense.to_vector<double>(),curve.divergence.to_vector<double>(),"Paired mean",{126,34,206})
 .points(axis.to_vector<double>(),actual.to_vector<double>(),"Five actual traces",{220,38,38},4)
 .margins(78,22,54,70).x_limits(-2.3,2.3).y_limits(-.1,1.8).x_label("Input x0").y_label("Trace / probe contraction").title("The pair cancels off-diagonal terms");
 dm::graphics::RLayout::create(1,2).add(left).add(right).size(1100,520).fit_panels().save_svg("build/cnf_probe.svg");
 std::vector<T> integrals,states;for(int mode=0;mode<4;++mode){auto path=m::CnfIntegrate(p,input,false,8,mode);integrals.push_back(path.logdet);states.push_back(path.latent);if(mode&&!n::equal_bits(path.latent,states[0]))throw std::runtime_error("Trace mode must not alter velocity path");}
 auto discrete=ActualLogdet(states[0],input);
 n::save_npz("build/cnf_probe_values.npz",{{"axis",axis},{"input",input},{"velocity",f.velocity},{"exact_trace",f.exact_trace},{"plus",f.hutchinson_plus},{"minus",f.hutchinson_minus},{"paired",f.divergence},{"actual_trace",actual},{"dense_axis",dense},{"curve_velocity",curve.velocity},{"curve_exact_trace",curve.exact_trace},{"curve_plus",curve.hutchinson_plus},{"curve_minus",curve.hutchinson_minus},{"curve_paired",curve.divergence},{"curve_actual_trace",curve_actual},{"mode0_integral",integrals[0]},{"mode1_integral",integrals[1]},{"mode2_integral",integrals[2]},{"mode3_integral",integrals[3]},{"mode_states",n::concat(states,1)},{"actual_discrete_logdet",discrete}});
 std::print("| Input x0 | Exact field trace | Plus | Minus | Paired | Exact-mode integral | Plus integral | Minus integral | Paired integral | Actual RK4 logdet |\n|---:|---:|---:|---:|---:|---:|---:|---:|---:|---:|\n");
 auto x=axis.to_vector<double>(),t=f.exact_trace.to_vector<double>(),plus=f.hutchinson_plus.to_vector<double>(),minus=f.hutchinson_minus.to_vector<double>(),paired=f.divergence.to_vector<double>(),i0=integrals[0].to_vector<double>(),i1=integrals[1].to_vector<double>(),i2=integrals[2].to_vector<double>(),i3=integrals[3].to_vector<double>(),j=discrete.to_vector<double>();
 for(int i=0;i<5;++i)std::print("|{:.0f}|{:.10f}|{:.10f}|{:.10f}|{:.10f}|{:.10f}|{:.10f}|{:.10f}|{:.10f}|{:.10f}|\n",x[i],t[i],plus[i],minus[i],paired[i],i0[i],i1[i],i2[i],i3[i],j[i]);
}
