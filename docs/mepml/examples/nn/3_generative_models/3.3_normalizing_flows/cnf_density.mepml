 auto input=data.at("test_points"),tip=input+5.*out.at("field_velocity"),exact=out.at("field_exact_trace"),plus=out.at("field_hutchinson_plus"),minus=out.at("field_hutchinson_minus"),paired=.5*(plus+minus),actual=n::select(out.at("field_jacobian_row0"),1,0)+n::select(out.at("field_jacobian_row1"),1,1);
 auto left=dm::graphics::RPlot::create();left.segments(n::select(input,1,0).to_vector<double>(),n::select(input,1,1).to_vector<double>(),n::select(tip,1,0).to_vector<double>(),n::select(tip,1,1).to_vector<double>(),{203,213,225},1.2)
 .points(n::select(input,1,0).to_vector<double>(),n::select(input,1,1).to_vector<double>(),"Held-out input",{100,116,139},3).points(n::select(tip,1,0).to_vector<double>(),n::select(tip,1,1).to_vector<double>(),"x + 5*velocity",{37,99,235},2)
 .margins(78,22,54,70).x_limits(-4,7).y_limits(-4,7).x_label("Coordinate 0").y_label("Coordinate 1").title("All 128 fitted field velocities at t=.5");
 auto rows=n::arange(0,128).to_vector<double>();auto right=dm::graphics::RPlot::create();right.points(rows,plus.to_vector<double>(),"Plus probe",{234,88,12},3).points(rows,minus.to_vector<double>(),"Minus probe",{22,163,74},3)
 .points(rows,exact.to_vector<double>(),"Exact field trace",{37,99,235},3).points(rows,paired.to_vector<double>(),"Paired mean",{126,34,206},2).points(rows,actual.to_vector<double>(),"Actual Jacobian trace",{30,41,59},1)
 .margins(78,22,54,70).y_limits(-.13,.11).x_label("Original held-out row").y_label("Trace / probe contraction, 1/time").title("The deterministic pair and actual trace agree");
