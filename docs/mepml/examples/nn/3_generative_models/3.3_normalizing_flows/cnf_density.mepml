 auto error=v.at("normalization_error");
 dm::graphics::RPlot::create().points(n::arange(0,1024).to_vector<double>(),(error*1e6).to_vector<double>(),"All prior rows",{37,99,235},2)
 .y_limits(0,5).x_label("Original prior row index").y_label("Absolute identity residual x 1e6, nats")
 .title("Every source sample retains its numerical log identity")
 .save_svg("build/cnf_normalization.svg");
 std::print("| Numerical RK4 / Float32 check | Maximum absolute error |\n|---|---:|\n| inverse(forward(test)) |{:.12g}|\n| forward(inverse(prior)) |{:.12g}|\n| Change-of-variables log identity |{:.12g}|\n",n::max(v.at("forward_roundtrip_absolute_error")).item(),n::max(v.at("inverse_roundtrip_absolute_error")).item(),n::max(error).item());
}
