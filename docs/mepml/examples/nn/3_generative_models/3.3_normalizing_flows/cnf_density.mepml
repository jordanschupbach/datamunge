> Solve one scalar tanh field by hand

Use one active hidden unit, zero biases, hidden spatial weight 1 and output
weight 3 into coordinate 0; all other weights are zero. The native .3 output
scale gives x0'=.9 tanh(x0), x1'=0. Differentiating sinh(x0(t)) yields
.9 sinh(x0(t)), so

$$ x_0(t)=\operatorname{asinh}(e^{.9t}\sinh(x_0(0))),\quad
\frac{dx_0(t)}{dx_0(0)}=\frac{e^{.9t}\cosh(x_0(0))}{\cosh(x_0(t))}>0. $$
\alttext(The scalar tanh ODE has a closed continuous-time solution obtained by exponential evolution of sinh(x0). Its positive derivative gives the continuous two-dimensional area factor because x1 is unchanged.)

The continuous logdet is the logarithm of that derivative. The first program
compares the eight-step native map with this exact continuous target, using
five declared points and all 257 curve rows on [-2,2]. Its actual discrete
Jacobian, exp(integrated trace), and continuous derivative nearly coincide at
this scale; the refinement plot below resolves their numerical differences.
This hand-set field has no fitting or observation pool.

```{cpp, results="markdown", file="figures/cnf_toy.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
namespace n=dm::nn;namespace m=n::models;using T=n::Tensor;
void SetField(n::ParameterStore& p,double output_weight,bool cross=false){
 m::CnfField(p,n::zeros({1,2},n::DType::Float64),0.f);
 std::vector<double> wi(24,0),wo(16,0);wi[0]=1.;if(cross)wi[8]=1.;wo[0]=output_weight;if(cross)wo[1]=.5;
 p.set("field/hidden/W",n::from_vector(wi,{3,8}));p.set("field/output/W",n::from_vector(wo,{8,2}));p.set("field/hidden/b",n::zeros({8},n::DType::Float64));p.set("field/output/b",n::zeros({2},n::DType::Float64));
}
T ActualLogdet(const T& value,const T& input){
 const auto keep=n::GradOptions{true,false,false};auto a=n::grad(n::sum(n::select(value,1,0)),{input},keep)[0],b=n::grad(n::sum(n::select(value,1,1)),{input},keep)[0];
 auto determinant=n::select(a,1,0)*n::select(b,1,1)-n::select(a,1,1)*n::select(b,1,0);
 if(n::min(determinant).item()<=0)throw std::runtime_error("Positive worked-map determinant");return n::log(determinant);
}
T Continuous(const T& x){auto u=n::sinh(x)*n::exp(n::full({},.9,n::DType::Float64));return n::log(u+n::sqrt(n::square(u)+1.));}
T ContinuousLogdet(const T& x){return .9+n::log(n::cosh(x))-n::log(n::cosh(Continuous(x)));}

int main(){
 auto type=n::DType::Float64;n::ParameterStore p(10003,type);SetField(p,3.);
 auto axis=n::from_vector(std::vector<double>{-1,-.5,0,.5,1},{5});auto input=n::stack({axis,n::zeros({5},type)},1).requires_grad_();
 auto path=m::CnfIntegrate(p,input),rec=m::CnfIntegrate(p,path.latent,true);auto actual=ActualLogdet(path.latent,input);
 auto exact=Continuous(axis),exact_ld=ContinuousLogdet(axis);
 if(n::max(n::abs(n::select(path.latent,1,0)-exact)).item()>1e-6||n::max(n::abs(rec.latent-input)).item()>1e-7||n::max(n::abs(actual-path.logdet)).item()>2e-6)throw std::runtime_error("Numerical worked tanh flow");
 auto dense=n::arange(0,257,1,type)/64.-2.;auto grid=n::stack({dense,n::zeros({257},type)},1).requires_grad_();auto curve=m::CnfIntegrate(p,grid);auto curve_actual=ActualLogdet(curve.latent,grid),curve_exact=Continuous(dense),curve_exact_ld=ContinuousLogdet(dense);
 auto left=dm::graphics::RPlot::create();left.lines(dense.to_vector<double>(),curve_exact.to_vector<double>(),"Continuous solution",{148,163,184})
 .lines(dense.to_vector<double>(),n::select(curve.latent,1,0).to_vector<double>(),"Eight-step RK4",{37,99,235})
 .points(axis.to_vector<double>(),n::select(path.latent,1,0).to_vector<double>(),"Five native checks",{220,38,38},4)
 .margins(78,22,54,70).x_limits(-2.3,2.3).y_limits(-3.2,5.4).x_label("Input x0, x1=0").y_label("Final coordinate 0").title("x0' = .9 tanh(x0): exact and RK4");
 auto right=dm::graphics::RPlot::create();right.lines(dense.to_vector<double>(),n::exp(curve_exact_ld).to_vector<double>(),"Continuous derivative",{148,163,184})
 .lines(dense.to_vector<double>(),n::exp(curve_actual).to_vector<double>(),"Actual RK4 determinant",{37,99,235})
 .lines(dense.to_vector<double>(),n::exp(curve.logdet).to_vector<double>(),"Exp integrated trace",{234,88,12})
 .points(axis.to_vector<double>(),n::exp(actual).to_vector<double>(),"Five actual checks",{220,38,38},4)
 .margins(78,22,54,70).x_limits(-2.3,2.3).y_limits(0,4.3).x_label("Input x0").y_label("Positive area factor").title("Three volume calculations nearly coincide");
 dm::graphics::RLayout::create(1,2).add(left).add(right).size(1100,520).fit_panels().save_svg("build/cnf_toy.svg");
 n::save_npz("build/cnf_toy_values.npz",{{"axis",axis},{"input",input},{"value",path.latent},{"integrated_logdet",path.logdet},{"actual_logdet",actual},{"continuous_value",exact},{"continuous_logdet",exact_ld},{"recovered",rec.latent},{"dense_axis",dense},{"curve",curve.latent},{"curve_integrated_logdet",curve.logdet},{"curve_actual_logdet",curve_actual},{"curve_continuous_value",curve_exact},{"curve_continuous_logdet",curve_exact_ld}});
 std::print("| Input x0 | Continuous target | Native eight-step value | Integrated trace | Actual RK4 logdet |\n|---:|---:|---:|---:|---:|\n");auto x=axis.to_vector<double>(),a=exact.to_vector<double>(),v=n::select(path.latent,1,0).to_vector<double>(),ld=path.logdet.to_vector<double>(),j=actual.to_vector<double>();
 for(int i=0;i<5;++i)std::print("|{:.1f}|{:.12f}|{:.12f}|{:.12f}|{:.12f}|\n",x[i],a[i],v[i],ld[i],j[i]);
}
