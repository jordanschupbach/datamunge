> Hand-check a strict Gaussian block and its sequential inverse

For even order, activate hidden unit8 only: h=tanh(.7a+.1). Set mu0=.2,
s0=.8tanh(.1), mu1=.3h−.1 and s1=.8tanh(.2h+.05), with x=(a,.5).
The first heads are constant; the second depend only on a. The map is
z0=(a−.2)exp(−s0), z1=(.5−mu1)exp(−s1), with logdet=−s0−s1.

Its diagonal derivatives are exp(−s0),exp(−s1), while
 dz1/da=−mu1' exp(−s1)−z1 s1'. The program checks the actual Jacobian against
these formulas at five a values. It recovers a from z0 first, recomputes the
native conditioner on the recovered prefix, then recovers .5 from z1.
No fitted weights or generated observation pools enter this worked example.

```{cpp, results="markdown", file="figures/maf_conditioner_toy.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main(){
 namespace n=dm::nn;namespace m=n::models;auto type=n::DType::Float64;n::ParameterStore p(1,type);
 auto a=n::from_vector(std::vector<double>{-2,-1,0,1,2},{5});auto x=n::stack({a,n::full({5},.5,type)},1).requires_grad_();
 m::MafConditioner(p,x,0);for(auto name:p.names())p.set(name,n::zeros(p.at(name).shape(),type));
 std::vector<double> iw(32),bias(16),ow(64);iw[8]=.7;bias[8]=.1;ow[8*4+1]=.3;ow[8*4+3]=.2;
 p.set("autoregressive0/hidden/W",n::from_vector(iw,{2,16}));p.set("autoregressive0/hidden/b",n::from_vector(bias,{16}));
 p.set("autoregressive0/heads/W",n::from_vector(ow,{16,4}));p.set("autoregressive0/heads/b",n::from_vector(std::vector<double>{.2,-.1,.1,.05},{4}));
 auto cond=m::MafConditioner(p,x,0);auto z=(x-cond.mean)*n::exp(-cond.scale),ld=-n::sum(cond.scale,{1});
 auto h=n::tanh(.7*a+.1),s1=.8*n::tanh(.2*h+.05),mu1=.3*h-.1;
 auto expected=(.5-mu1)*n::exp(-s1);double s0=.8*std::tanh(.1);
 auto dh=.7*(1.-n::square(h)),ds=.8*(1.-n::square(n::tanh(.2*h+.05)))*.2*dh;
 auto theory=-.3*dh*n::exp(-s1)-expected*ds;
 auto j0=n::grad(n::sum(n::slice_axis(z,1,0,1)),{x},n::GradOptions{true,false,false})[0];
 auto j1=n::grad(n::sum(n::slice_axis(z,1,1,2)),{x})[0];
 auto det=n::select(j0,1,0)*n::select(j1,1,1)-n::select(j0,1,1)*n::select(j1,1,0);
 auto recovered=x*0.;
 for(int c=0;c<2;++c){auto heads=m::MafConditioner(p,recovered,0);
  auto value=n::slice_axis(z,1,c,c+1)*n::exp(n::slice_axis(heads.scale,1,c,c+1))+n::slice_axis(heads.mean,1,c,c+1);
  auto other=n::slice_axis(recovered,1,1-c,2-c);recovered=c?n::concat({other,value},1):n::concat({value,other},1);}
 if(n::max(n::abs(n::select(z,1,1)-expected)).item()>1e-14||n::max(n::abs(n::select(j1,1,0)-theory)).item()>1e-14||n::max(n::abs(n::log(det)-ld)).item()>1e-14||n::max(n::abs(recovered-x)).item()>1e-14||n::max(n::abs(ld+s0+s1)).item()>1e-14)throw std::runtime_error("Worked strict Gaussian Jacobian/inverse");
 auto axis=n::arange(0,257,1,type)/64.-2.;auto grid=n::stack({axis,n::full({257},.5,type)},1);auto heads=m::MafConditioner(p,grid,0);
 auto curve=n::select((grid-heads.mean)*n::exp(-heads.scale),1,1);
 dm::graphics::RPlot::create().lines(axis.to_vector<double>(),curve.to_vector<double>(),"Parallel density z1",{37,99,235})
 .points(a.to_vector<double>(),std::vector<double>(5,.5),"Original x1=.5",{100,116,139},5)
 .points(a.to_vector<double>(),n::select(z,1,1).to_vector<double>(),"Native strict block",{220,38,38},4)
 .y_limits(0,1.4).x_label("Earlier observation coordinate a=x0").y_label("Second coordinate")
 .title("Strict heads give a parallel triangular density map").save_svg("build/maf_conditioner_toy.svg");
 n::save_npz("build/maf_toy_values.npz",{{"a",a},{"z",z},{"logdet",ld},{"actual_determinant",det},{"jacobian_row0",j0},{"jacobian_row1",j1},{"recovered",recovered},{"curve_axis",axis},{"curve",curve}});
 std::print("| a | Density z1 | Log determinant | Actual determinant |\n|---:|---:|---:|---:|\n");
 auto av=a.to_vector<double>(),zv=n::select(z,1,1).to_vector<double>(),lv=ld.to_vector<double>(),dv=det.to_vector<double>();
 for(int i=0;i<5;++i)std::print("|{:.0f}|{:.9f}|{:.9f}|{:.9f}|\n",av[i],zv[i],lv[i],dv[i]);
}
