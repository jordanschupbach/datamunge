\caption(The executed graph counts 232 values in each pair of autoregressive stages and two in the scale. Every intermediate coordinate batch has width two; the total determinant accumulates all four negative log-scale sums plus the global scale.)
\alttext(A two-coordinate input passes through two grouped pairs of autoregressive stages and a positive diagonal scale; the graph reports 466 learned values.)

> Keep the original data, fitting writes and latent-only sampling visible

The original in-process protocol uses **512 fit / 128 validation / 128 test**
observations. Independent Double Box-Muller banks use seeds 9203/9209/9221,
with raw MT19937 midpoint uniforms, cosine partner before sine partner. Apply
the banana map in Double and cast final observations once to Float32. Integer
source IDs start at 0/10000/20000 for the three pools. These are procedural row
identifiers, not real-world subjects or recordings. There is no downloaded or
substituted dataset. All 1,024 prior rows come from seed 9257 and cast once to
Float32; only these latent values enter inverse sampling.

BatchOrder(512,32,9621) produces 16 full batches per epoch. Fit three fixed
epochs, 48 Adam(.003) writes with betas(.9,.999), epsilon1e-8 and no weight
decay. Epoch three is the predefined final selection, not a test-driven choice.
Warm all leaves before optimizer construction. Evaluate NLL and both Jacobians
with native operations; keep the update and epoch loops explicit. Restored
weights, repeated samples and inference immutability are checked bit for bit.

For exact source replay the model uses rounded_constant=true: log(2*pi) is
first rounded to Float32, even if later promoted to Double. The analytic truth
and full-precision Gaussian baselines use the full Double constant. This tiny
rounding convention cannot explain the gap to truth. The fitting loss remains
Float32 and matches the original exactly.

The complete program also keeps every density grid position, each actual
forward/inverse Jacobian and both roundtrip errors. Fitting-only Gaussian
moments use the MLE divisor N, not N−1; held-out rows never enter them. Native
Double cumulative sums preserve the source's divide-first, serial reduction
order for moments and scalar baseline summaries. All numerical/model operations
are in the datamunge API; the local functions below package named outputs,
checks and file writes. There is no training or sampling loop in a helper header.

```{cpp, results="markdown", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <fstream>
namespace n=dm::nn;namespace m=n::models;namespace fs=std::filesystem;
using T=n::Tensor;using A=std::map<std::string,T>;
void Require(bool ok,const std::string& what){if(!ok)throw std::runtime_error(what);}
void Save(const fs::path& file,const A& fields){
 n::NamedTensors named;for(const auto& [key,value]:fields)named.emplace_back(key,value);
 n::save_npz(file.string(),named);
}
A Weights(const n::ParameterStore& p){
 A out;for(const auto& name:p.names())out.emplace(name,p.at(name).detach().clone());return out;
}
bool Equal(const A& a,const A& b){
 if(a.size()!=b.size())return false;
 for(const auto& [key,value]:a)if(!b.count(key)||!n::equal_bits(value,b.at(key)))return false;
 return true;
}
T Column(const T& x,int k){return n::slice_axis(x,1,k,k+1);}
A Evaluate(n::ParameterStore& p,const T& x){
 auto input=x.detach().clone().requires_grad_();auto path=m::MafDensity(p,input);
 auto rec=m::MafInverse(p,path.latent);auto density=m::NormalFlowDensity(path.latent,path.logdet,true);
 A out{{"latent",path.latent},{"unscaled",path.unscaled},{"reconstruction",rec.value},
  {"base_log_probability",density.base_log_probability},{"log_probability",density.log_probability},
  {"forward_logdet",path.logdet},{"inverse_logdet",rec.logdet},{"loss",density.loss},
  {"coupling0",path.coupling0},{"coupling_logdet0",path.coupling_logdet0},{"coupling_scale0",path.coupling_scale0},{"coupling_shift0",path.coupling_shift0},{"coupling1",path.coupling1},{"coupling_logdet1",path.coupling_logdet1},{"coupling_scale1",path.coupling_scale1},{"coupling_shift1",path.coupling_shift1},{"coupling2",path.coupling2},{"coupling_logdet2",path.coupling_logdet2},{"coupling_scale2",path.coupling_scale2},{"coupling_shift2",path.coupling_shift2},{"coupling3",path.coupling3},{"coupling_logdet3",path.coupling_logdet3},{"coupling_scale3",path.coupling_scale3},{"coupling_shift3",path.coupling_shift3}};
 const T inputs[]{path.conditioner_input0,path.conditioner_input1,path.conditioner_input2,path.conditioner_input3};
 for(int block=0;block<4;++block){
  out["conditioner_input"+std::to_string(block)]=inputs[block];
  auto observed=inputs[block].detach().clone().requires_grad_();auto c=m::MafConditioner(p,observed,block);
  for(int k=0;k<4;++k)out["conditioner_jacobian"+std::to_string(block)+"_"+std::to_string(k)]=
    n::grad(n::sum(Column(k<2?c.mean:c.scale,k%2)),{observed},n::GradOptions{true,false,false})[0];
 }
 for(int k=0;k<2;++k)out["jacobian_row"+std::to_string(k)]=n::grad(n::sum(Column(path.latent,k)),{input},n::GradOptions{true,false,false})[0];
 for(auto& [key,value]:out)value=value.detach().contiguous();return out;
}
A Sample(n::ParameterStore& p,const T& z){
 auto prior=z.detach().clone().requires_grad_();auto inv=m::MafInverse(p,prior);
 auto roundtrip=m::MafDensity(p,inv.value).latent;
 A out{{"prior",z},{"samples",inv.value},{"prior_roundtrip",roundtrip},{"inverse_logdet",inv.logdet}};
 for(int k=0;k<2;++k)out["inverse_jacobian_row"+std::to_string(k)]=n::grad(n::sum(Column(inv.value,k)),{prior},n::GradOptions{true,false,false})[0];
 for(auto& [key,value]:out)value=value.detach().contiguous();return out;
}
T Loss(n::ParameterStore& p,const T& x){auto o=m::MafDensity(p,x);return m::NormalFlowDensity(o.latent,o.logdet,true).loss;}
A NamedGradients(n::ParameterStore& p,const std::vector<T>& gradients){
 A out;auto names=p.names();for(std::size_t i=0;i<names.size();++i)out[names[i]]=gradients[i];return out;
}
// Preserve the source's serial Double reductions without hiding numerical math
// in host loops: divide each row first, native cumulative sum, then last row.
T SerialMean(const T& values){return n::select(n::cumsum(n::cast(values,n::DType::Float64)/double(values.size(0)),0),0,values.size(0)-1);}
T ActualLogdet(const A& fields,const std::string& prefix){
 auto a=n::cast(fields.at(prefix+"jacobian_row0"),n::DType::Float64);
 auto b=n::cast(fields.at(prefix+"jacobian_row1"),n::DType::Float64);
 auto det=n::reshape(Column(a,0)*Column(b,1)-Column(a,1)*Column(b,0),{-1});
 Require(n::min(det).item()>0,"Orientation-preserving actual Jacobian");return n::log(det);
}
int main(){
 n::set_num_threads(4);fs::path root="build/maf_density";fs::create_directories(root);
 A masks;
 for(int block=0;block<4;++block){
  auto inventory=m::MafMasks(block);const auto name="block"+std::to_string(block)+"_";
  masks[name+"input_degrees"]=inventory.input_degrees;masks[name+"hidden_degrees"]=inventory.hidden_degrees;
  masks[name+"output_degrees"]=inventory.output_degrees;masks[name+"input_mask"]=inventory.input_mask;masks[name+"output_mask"]=inventory.output_mask;
 }
 Save(root/"masks.npz",masks);
 A data;std::vector<T> pools;
 for(int split=0;split<3;++split){
  const int rows=split?128:512,seed=split==0?9203:split==1?9209:9221;
  const std::string name=split==0?"fit":split==1?"validation":"test";
  auto base=m::GaussianNoise({2},rows,seed);auto points=m::BananaPoints(base);
  data[name+"_base"]=base;data[name+"_points"]=points;
  data[name+"_source_ids"]=n::cast(n::arange(split*10000,split*10000+rows),n::DType::Int32);
  pools.push_back(points);
 }
 // Explicit latent-only sampling bank: all 1024 rows, generated once with seed9257.
 auto prior=n::cast(m::GaussianNoise({2},1024,9257),n::DType::Float32);
 data["sample_prior"]=prior;Save(root/"data.npz",data);
 std::ofstream protocol(root/"source_protocol.json");
 protocol<<R"JSON({"distribution":"SYNTHETICanalyticbanana","base":"standardGaussian2D","mapping":"x0=u0;x1=u1+.5*(u0^2-1)","true_forward_logdet":0,"fit":512,"validation":128,"test":128,"seeds":[9203,9209,9221],"sample_prior_seed":9257,"sample_prior_count":1024,"source_id_offsets":[0,10000,20000]})JSON"<<'\n';protocol.close();
 n::ParameterStore parameters(9603);
 {n::NoGradGuard guard;m::MafDensity(parameters,n::zeros({1,2}));m::MafInverse(parameters,n::zeros({1,2}));}
 Require(parameters.count()==466&&parameters.size()==17,"466 values /17 leaves");
 Save(root/"initial_arrays.npz",Weights(parameters));Save(root/"initial_outputs.npz",Evaluate(parameters,pools[2]));
 n::OptimizerConfig config;config.kind=n::OptimizerKind::Adam;config.beta1=.9;config.beta2=.999;config.epsilon=1e-8;
 n::Optimizer optimizer(parameters,.003,config);n::BatchOrder order(512,32,9621);
 std::ofstream history(root/"history.tsv"),batches(root/"batches.tsv");history.precision(17);
 history<<"epoch\tvalidation_nll\tvalidation_mean_forward_logdet\n";batches<<"epoch\tstep\trow\n";
 int step=0;T first;
 for(int epoch=1;epoch<=3;++epoch){
  order.begin_epoch();
  for(;;){
   auto rows=order.next();if(rows.empty())break;auto batch=n::take_rows(pools[0],rows);
   if(step==0){first=batch;Save(root/"first_batch.npz",{{"points",batch}});Save(root/"first_forward.npz",Evaluate(parameters,batch));}
   // Complete fitting step: native likelihood, explicit reverse-mode partials,
   // caller-owned Adam write. No model helper owns any update or fitting loop.
   auto loss=Loss(parameters,batch);auto gradients=n::grad(loss,parameters.parameters());
   auto named=NamedGradients(parameters,gradients);Save(root/("batch"+std::to_string(step)+"-gradient.npz"),named);
   if(step==0)Save(root/"initial_gradients.npz",named);
   optimizer.step(gradients);
   Save(root/("batch"+std::to_string(step)+"-after.npz"),Weights(parameters));
   Save(root/("batch"+std::to_string(step)+"-iterations.npz"),{{"iterations",n::from_vector(std::vector<std::int64_t>{optimizer.iterations()},{1})}});
   if(step==0)Save(root/"first_after.npz",Weights(parameters));
   for(auto row:rows)batches<<epoch<<'\t'<<step<<'\t'<<row<<'\n';++step;
  }
  auto validation=Evaluate(parameters,pools[1]);
  history<<epoch<<'\t'<<validation.at("loss").item<float>()<<'\t'<<SerialMean(validation.at("forward_logdet")).item()<<'\n';
  Save(root/("epoch"+std::to_string(epoch)+"_arrays.npz"),Weights(parameters));
  Save(root/("epoch"+std::to_string(epoch)+"_validation.npz"),validation);
 }
 Require(step==48&&optimizer.iterations()==48,"All48 Adam writes");history.close();batches.close();
 parameters.save((root/"final.npz").string());
 Save(root/"final_gradients.npz",NamedGradients(parameters,n::grad(Loss(parameters,first),parameters.parameters())));
 n::ParameterStore deployed(9603);
 {n::NoGradGuard guard;m::MafDensity(deployed,n::zeros({1,2}));m::MafInverse(deployed,n::zeros({1,2}));}
 deployed.load((root/"final.npz").string(),true);Require(Equal(Weights(parameters),Weights(deployed)),"Bit-exact weight restore");
 auto before=Weights(deployed);auto output=Evaluate(deployed,pools[2]);
 Save(root/"outputs.npz",output);Save(root/"model_arrays.npz",Weights(deployed));
 auto samples=Sample(deployed,prior);Require(Equal(samples,Sample(deployed,prior)),"Repeat inverse sampling and Jacobians bit exact");
 Save(root/"samples.npz",samples);auto sample_density=Evaluate(deployed,samples.at("samples"));Save(root/"sample_density.npz",sample_density);
 auto roundtrip=n::abs(n::cast(output.at("reconstruction"),n::DType::Float64)-n::cast(pools[2],n::DType::Float64));
 auto prior_error=n::abs(n::cast(samples.at("prior_roundtrip"),n::DType::Float64)-n::cast(prior,n::DType::Float64));
 auto actual=ActualLogdet(output,"");auto inverse_actual=ActualLogdet(samples,"inverse_");
 auto det_error=n::abs(actual-n::cast(output.at("forward_logdet"),n::DType::Float64));
 auto inverse_error=n::abs(inverse_actual-n::cast(samples.at("inverse_logdet"),n::DType::Float64));
 auto base=m::StandardNormalLogProbability(n::cast(prior,n::DType::Float64));
 auto normalization=n::abs(n::cast(sample_density.at("log_probability"),n::DType::Float64)+n::cast(samples.at("inverse_logdet"),n::DType::Float64)-base);
 Require(n::max(roundtrip).item()<5e-6&&n::max(prior_error).item()<5e-6,"Both roundtrips");
 Require(n::max(det_error).item()<5e-6&&n::max(inverse_error).item()<5e-6,"Both analytic/actual logdets");
 Require(n::max(n::abs(output.at("forward_logdet")+output.at("inverse_logdet"))).item()<5e-6,"Per-point reconstruction logdet cancellation");
 Require((n::max(output.at("forward_logdet"))-n::min(output.at("forward_logdet"))).item()>1e-5,"Spatially varying forward logdet");

 Require(n::max(normalization).item()<2e-5,"All1024 change-of-variables identities");
 auto single=Evaluate(deployed,n::take_rows(pools[2],{0}));
 Require(n::max(n::abs(single.at("latent")-n::take_rows(output.at("latent"),{0}))).item()<2e-6,"Single/batch parity");
 std::vector<float> grid;for(int y=0;y<128;++y)for(int x=0;x<128;++x){grid.push_back(float((x+.5)/16-4));grid.push_back(float(4-(y+.5)/16));}
 auto coordinates=n::from_vector(grid,{128*128,2});auto density=Evaluate(deployed,coordinates);auto truth=m::BananaLogProbability(coordinates);
 Save(root/"grid.npz",{{"points",coordinates},{"model_log_probability",density.at("log_probability")},{"true_log_probability",truth}});
 // Fit-only MLE moments (divide by N), retaining the original serial Double
 // order with native cumsum. No held-out rows enter these two moment estimates.
 auto fit=n::cast(pools[0],n::DType::Float64);auto mean=SerialMean(fit);auto centered=fit-mean;
 auto covariance=SerialMean(n::expand_dims(centered,2)*n::expand_dims(centered,1));
 auto cov=covariance.to_vector<double>();auto test=n::cast(pools[2],n::DType::Float64);
 auto a=n::reshape(Column(test,0),{-1})-n::select(mean,0,0),c=n::reshape(Column(test,1),{-1})-n::select(mean,0,1);
 auto determinant=n::select(n::select(covariance,0,0),0,0)*n::select(n::select(covariance,0,1),0,1)-n::select(n::select(covariance,0,0),0,1)*n::select(n::select(covariance,0,1),0,0);
 Require(determinant.item()>0,"Fitting covariance positive determinant");
 auto full=std::log(2*std::acos(-1.))+.5*n::log(determinant)+.5*(a*a*cov[3]-2.*a*c*cov[1]+c*c*cov[0])/determinant;
 auto diagonal=std::log(2*std::acos(-1.))+.5*std::log(cov[0]*cov[3])+.5*(a*a/cov[0]+c*c/cov[3]);
 auto identity=-m::StandardNormalLogProbability(test);auto true_test=m::BananaLogProbability(pools[2]);
 Save(root/"baseline.npz",{{"fit_mean",mean},{"fit_covariance",covariance},{"true_test_log_probability",true_test}});
 Save(root/"plot_values.npz",{{"full_gaussian_point_nll",full},{"diagonal_gaussian_point_nll",diagonal},{"identity_point_nll",identity},
  {"true_point_nll",-true_test},{"actual_logdet",actual},{"inverse_actual_logdet",inverse_actual},
  {"normalization_error",normalization},{"forward_roundtrip_absolute_error",roundtrip},{"inverse_roundtrip_absolute_error",prior_error}});
 Require(Equal(before,Weights(deployed)),"All inference immutable");
 std::ofstream meta(root/"metrics.json");meta.precision(17);
 meta<<"{\"parameters\":466,\"parameter_tensors\":17,\"coupling_layers\":4,\"hidden\":16,\"base\":\"standardGaussian2D\",\"epochs\":3,\"optimizer_updates\":48,\"selected_epoch_fixed_final\":3,\"test_nll\":"<<output.at("loss").item<float>()
 <<",\"true_test_nll\":"<<SerialMean(-true_test).item()<<",\"fit_full_gaussian_nll\":"<<SerialMean(full).item()
 <<",\"fit_diagonal_gaussian_nll\":"<<SerialMean(diagonal).item()<<",\"identity_gaussian_nll\":"<<SerialMean(identity).item()
 <<",\"forward_logdet_min\":"<<n::min(output.at("forward_logdet")).item()<<",\"forward_logdet_max\":"<<n::max(output.at("forward_logdet")).item()<<",\"mean_forward_logdet\":"<<SerialMean(output.at("forward_logdet")).item()<<",\"forward_inverse_max_error\":"<<n::max(roundtrip).item()
 <<",\"inverse_forward_max_error\":"<<n::max(prior_error).item()<<",\"actual_vs_analytic_logdet_max_error\":"<<n::max(det_error).item()<<",\"ancestral_samples\":1024}";
 std::print("48 Adam writes;466 values/17 leaves;all1024 inverse samples and both Jacobians/roundtrips/normalization/restore/immutability pass. Test NLL {:.9f}.\n",output.at("loss").item());
}
```
