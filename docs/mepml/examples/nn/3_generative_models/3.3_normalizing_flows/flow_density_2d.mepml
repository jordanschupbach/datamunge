 auto error=v.at("normalization_error");auto p=dm::graphics::RPlot::create();p.points(n::arange(0,1024).to_vector<double>(),(error*1e6).to_vector<double>(),"All1024 prior rows",{37,99,235},2)
 .margins(78,22,54,70).y_limits(0,4).x_label("Original prior row index").y_label("Absolute log identity residual x1e6").title(family);layout.add(p);
 std::print("|{}|{:.12g}|{:.12g}|{:.12g}|\n",family,n::max(v.at("forward_roundtrip_absolute_error")).item(),n::max(v.at("inverse_roundtrip_absolute_error")).item(),n::max(error).item());}
 layout.size(1650,620).fit_panels().save_svg("build/study_normalization.svg");
