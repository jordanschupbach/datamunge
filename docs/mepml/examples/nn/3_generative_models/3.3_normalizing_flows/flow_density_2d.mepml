 std::vector<double> axis;for(int i=0;i<128;++i)axis.push_back((i+.5)/16-4);
 for(auto family:{"banana","eight_gaussians","checkerboard"}){std::map<std::string,n::Tensor> data;for(auto& [k,v]:n::load_npz(std::string("build/flow_density_2d/")+family+"/grid.npz"))data[k]=v;
 for(auto key:{"true_log_probability","model_log_probability"}){auto pdf=n::exp(data.at(key)).to_vector<double>();std::vector<std::vector<double>> z(128,std::vector<double>(128));for(int x=0;x<128;++x)for(int y=0;y<128;++y)z[x][y]=pdf[(127-y)*128+x];
 auto p=dm::graphics::RPlot::create();p.image(axis,axis,z,dm::graphics::terrain_colors(32),0,kind==1?1.:.2).margins(72,22,54,64).x_limits(-4,4).y_limits(-4,4).x_label("x0").y_label("x1").title(std::string(family)+(std::string(key)=="true_log_probability"?": analytic PDF":": final model PDF"));layout.add(p);}
 ++kind;}
 layout.size(1100,1722).fit_panels().save_svg("build/study_density.svg");
