> Construct three different laws from the same explicit triples

Let u,v,w be independent standard normals and Phi(z)=.5 erfc(-z/sqrt(2)).
The source uses Double scalar arithmetic, then casts observations once to
Float32. For banana, x=(u,v+.5(u²−1)); the third coordinate is unused and the
saved component is -1. Its inverse has determinant one.

For the other two families, c=min(7,int(8 Phi(w))) selects one of eight equally
likely components. Eight Gaussians use centers (2 cos(2 pi c/8),2 sin(2 pi c/8))
and add independent noise (.15u,.15v). Its true log density uses all eight
mixture terms with fixed weights 1/8, not empirical component frequencies.

Checkerboard uses row=c/2, col=2(c mod2)+(row mod2), then
x=(col−2+Phi(u),row−2+Phi(v)). Eight unit cells have density 1/8, with support
[-2,2)² and even floor(x0+2)+floor(x1+2) parity. Off support the analytic log
probability is **negative infinity**, meaning exactly zero PDF. Do not replace
it with a finite plotting floor. Extreme CDF tails and final Float32 rounding
can put transformed points on cell boundaries; the API does not clip them.

The following worked bank uses five banana coordinates and eight explicitly
chosen component quantiles. Ring points and checker points are at component
centers because u=v=0. These deterministic fixtures explain the law; they are
separate from the original seeded pools that follow.

```{cpp, results="markdown", file="figures/study_laws.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main(){
 namespace n=dm::nn;namespace m=n::models;auto type=n::DType::Float64;
 auto u=n::from_vector(std::vector<double>{-2,-1,0,1,2},{5});
 auto banana=m::FlowStudyPoints(n::stack({u,n::zeros({5},type),n::zeros({5},type)},1),0,type);
 auto wanted=n::from_vector(std::vector<double>{1.5,0,-.5,0,1.5},{5});
 if(!n::equal_bits(n::select(banana.points,1,1),wanted))throw std::runtime_error("Five banana coordinates");
 auto w=n::from_vector(std::vector<double>{-1.6,-.9,-.5,-.15,.15,.5,.9,1.6},{8});
 auto triples=n::stack({n::zeros({8},type),n::zeros({8},type),w},1);
 auto ring=m::FlowStudyPoints(triples,1,type),checker=m::FlowStudyPoints(triples,2,type);
 auto labels=n::cast(n::arange(0,8),n::DType::Int32);
 if(!n::equal_bits(ring.components,labels)||!n::equal_bits(checker.components,labels))throw std::runtime_error("All eight components");
 if(n::max(n::abs(m::FlowStudyLogProbability(checker.points,2)+std::log(8.))).item()>1e-15)throw std::runtime_error("Checker center truth");
 auto axis=n::arange(0,129,1,type)/32.-2.;auto curve=m::FlowStudyPoints(n::stack({axis,n::zeros({129},type),n::zeros({129},type)},1),0,type).points;
 auto p0=dm::graphics::RPlot::create();p0.lines(axis.to_vector<double>(),n::select(curve,1,1).to_vector<double>(),"v=0 curve",{37,99,235})
 .points(u.to_vector<double>(),wanted.to_vector<double>(),"Five native checks",{220,38,38},5);
 auto angle=n::arange(0,129,1,type)*(2*std::acos(-1.)/128.);
 auto p1=dm::graphics::RPlot::create();p1.lines((2*n::cos(angle)).to_vector<double>(),(2*n::sin(angle)).to_vector<double>(),"Radius2",{148,163,184})
 .points(n::select(ring.points,1,0).to_vector<double>(),n::select(ring.points,1,1).to_vector<double>(),"8 centers",{220,38,38},5);
 auto p2=dm::graphics::RPlot::create();std::vector<double> cells{-1.5,-.5,.5,1.5};std::vector<std::vector<double>> z(4,std::vector<double>(4));
 for(int x=0;x<4;++x)for(int y=0;y<4;++y)z[x][y]=(x+y)%2==0?.125:0;
 p2.image(cells,cells,z,dm::graphics::terrain_colors(32),0,.2)
 .points(n::select(checker.points,1,0).to_vector<double>(),n::select(checker.points,1,1).to_vector<double>(),"8 centers",{220,38,38},5);
 auto format=[](auto plot,const char* title){return plot.margins(78,22,54,70).x_limits(-3.5,3.5).y_limits(-3.5,3.5).x_label("x0").y_label("x1").title(title);};
 dm::graphics::RLayout::create(1,3).add(format(p0,"Banana: five exact checks")).add(format(p1,"Eight Gaussian centers")).add(format(p2,"Eight allowed checker cells"))
 .size(1650,574).fit_panels().save_svg("build/study_laws.svg");
 n::save_npz("build/study_laws.npz",{{"banana_points",banana.points},{"banana_curve",curve},{"ring_points",ring.points},{"checker_points",checker.points},{"component",ring.components}});
 std::print("| Family | Component | x0 | x1 | True log density |\n|---|---:|---:|---:|---:|\n");
 for(int kind=0;kind<3;++kind){auto out=kind==0?banana:kind==1?ring:checker;auto values=out.points.to_vector<double>(),logp=m::FlowStudyLogProbability(out.points,kind).to_vector<double>();auto c=out.components.to_vector<std::int32_t>();
 for(int i=0;i<int(c.size());++i)std::print("|{}|{}|{:.9f}|{:.9f}|{:.9f}|\n",kind,c[i],values[i*2],values[i*2+1],logp[i]);}
}
