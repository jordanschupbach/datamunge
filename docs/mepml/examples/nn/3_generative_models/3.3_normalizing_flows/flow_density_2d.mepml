 for(auto family:{"banana","eight_gaussians","checkerboard"}){std::string root=std::string("build/flow_density_2d/")+family+"/";std::map<std::string,n::Tensor> o,s,v;
 for(auto& [k,x]:n::load_npz(root+"outputs.npz"))o[k]=x;for(auto& [k,x]:n::load_npz(root+"samples.npz"))s[k]=x;for(auto& [k,x]:n::load_npz(root+"plot_values.npz"))v[k]=x;
 auto forward=(v.at("actual_logdet")-n::cast(o.at("forward_logdet"),n::DType::Float64))*1e7,inverse=(v.at("inverse_actual_logdet")-n::cast(s.at("inverse_logdet"),n::DType::Float64))*1e7;
 auto p=dm::graphics::RPlot::create();p.points(n::arange(0,128).to_vector<double>(),forward.to_vector<double>(),"Forward128",{37,99,235},3).points(n::arange(0,1024).to_vector<double>(),inverse.to_vector<double>(),"Inverse1024",{234,88,12},2)
 .margins(78,22,54,70).y_limits(-4,6).x_label("Original pool row index").y_label("(Actual-analytic logdet) x1e7").title(family);layout.add(p);}
 layout.size(1650,620).fit_panels().save_svg("build/study_jacobians.svg");
}
