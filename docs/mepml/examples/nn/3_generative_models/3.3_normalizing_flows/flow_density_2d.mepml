```{cpp, results="markdown", file="figures/study_history.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <fstream>
int main(){
 namespace n=dm::nn;auto layout=dm::graphics::RLayout::create(1,3);int kind=0;
 std::print("| Family | Final model | Full Gaussian | Diagonal Gaussian | Identity | Truth |\n|---|---:|---:|---:|---:|---:|\n");
 for(auto family:{"banana","eight_gaussians","checkerboard"}){std::string root=std::string("build/flow_density_2d/")+family+"/";std::map<std::string,n::Tensor> out,v;
 for(auto& [k,x]:n::load_npz(root+"outputs.npz"))out[k]=x;for(auto& [k,x]:n::load_npz(root+"plot_values.npz"))v[k]=x;
 auto serial=[](const n::Tensor& x){return n::select(n::cumsum(x/double(x.size(0)),0),0,x.size(0)-1).item();};
 std::ifstream f(root+"history.tsv");std::string header;std::getline(f,header);std::vector<double> epoch,loss;double e,l,d;while(f>>e>>l>>d){epoch.push_back(e);loss.push_back(l);}
 double full=serial(v.at("full_gaussian_point_nll")),diag=serial(v.at("diagonal_gaussian_point_nll")),identity=serial(v.at("identity_point_nll")),truth=serial(v.at("true_point_nll"));
 auto p=dm::graphics::RPlot::create();p.lines(epoch,loss,"Validation model",{37,99,235}).lines({1,3},{full,full},"Test full Gaussian",{220,38,38}).lines({1,3},{diag,diag},"Test diagonal",{234,88,12}).lines({1,3},{identity,identity},"Test identity",{100,116,139}).lines({1,3},{truth,truth},"Test truth",{22,163,74}).points({3},{out.at("loss").item()},"Final test model",{126,34,206},5)
 .margins(90,24,54,80).y_limits(kind==0?2.5:kind==1?.5:1.8,kind==0?3.4:kind==1?4.9:4.7).x_label("Fixed fitting epoch").y_label("NLL, nats per row").title(family);layout.add(p);++kind;
 std::print("|{}|{:.12f}|{:.12f}|{:.12f}|{:.12f}|{:.12f}|\n",family,out.at("loss").item(),full,diag,identity,truth);}
 layout.size(1650,640).fit_panels().save_svg("build/study_history.svg");
}
