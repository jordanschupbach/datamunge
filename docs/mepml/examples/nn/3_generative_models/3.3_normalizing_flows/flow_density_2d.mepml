> Hand-check one affine coupling before fitting

Keep b=.5 and activate one native conditioner unit. The following deterministic
example checks five mapped points, both Jacobian rows, the inverse and the
point-dependent log determinant. It uses Double arithmetic and no fitted data.

```{cpp, results="markdown", file="figures/study_coupling_toy.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main(){
 namespace n=dm::nn;namespace m=n::models;auto type=n::DType::Float64;n::ParameterStore p(1,type);
 auto a=n::from_vector(std::vector<double>{-2,-1,0,1,2},{5});auto x=n::stack({a,n::full({5},.5,type)},1).requires_grad_();
 m::RealNvpCoupling(p,x,0);for(auto name:p.names())p.set(name,n::zeros(p.at(name).shape(),type));
 std::vector<double> w(16),bias(16),heads(32);w[0]=.7;bias[0]=.1;heads[0]=.2;heads[1]=.3;
 p.set("coupling0/hidden/W",n::from_vector(w,{1,16}));p.set("coupling0/hidden/b",n::from_vector(bias,{16}));
 p.set("coupling0/heads/W",n::from_vector(heads,{16,2}));p.set("coupling0/heads/b",n::from_vector(std::vector<double>{.05,-.1},{2}));
 auto o=m::RealNvpCoupling(p,x,0),rec=m::RealNvpCoupling(p,o.value,0,true);
 auto h=n::tanh(.7*a+.1),raw=.2*h+.05,s=.8*n::tanh(raw),t=.3*h-.1;
 auto hs=.7*(1.-n::square(h)),ds=.8*(1.-n::square(n::tanh(raw)))*.2*hs,dt=.3*hs;
 auto changed=n::select(o.value,1,1),expected=.5*n::exp(s)+t;
 auto j0=n::grad(n::sum(n::slice_axis(o.value,1,0,1)),{x},n::GradOptions{true,false,false})[0];
 auto j1=n::grad(n::sum(n::slice_axis(o.value,1,1,2)),{x})[0];
 auto determinant=n::select(j0,1,0)*n::select(j1,1,1)-n::select(j0,1,1)*n::select(j1,1,0);
 auto slope=n::select(j1,1,0),theory=.5*n::exp(s)*ds+dt;
 if(n::max(n::abs(changed-expected)).item()>1e-14||n::max(n::abs(rec.value-x)).item()>1e-14||n::max(n::abs(slope-theory)).item()>1e-14||n::max(n::abs(determinant-n::exp(s))).item()>1e-14)throw std::runtime_error("Worked affine/Jacobian");
 auto axis=n::arange(0,257,1,type)/64.-2.;auto grid=n::stack({axis,n::full({257},.5,type)},1);
 auto curve=n::select(m::RealNvpCoupling(p,grid,0).value,1,1);
 dm::graphics::RPlot::create().lines(axis.to_vector<double>(),curve.to_vector<double>(),"b exp(s) + t",{37,99,235})
 .points(a.to_vector<double>(),std::vector<double>(5,.5),"Original b",{100,116,139},5)
 .points(a.to_vector<double>(),changed.to_vector<double>(),"Native affine map",{220,38,38},4)
 .y_limits(-.1,1.3).x_label("Conditioning coordinate a").y_label("Other coordinate")
 .title("A bounded affine coupling changes local volume").save_svg("build/study_coupling_toy.svg");
 std::print("| a | Changed b | Log scale s | Actual determinant |\n|---:|---:|---:|---:|\n");
 auto av=a.to_vector<double>(),yv=changed.to_vector<double>(),sv=s.to_vector<double>(),dv=determinant.to_vector<double>();
 for(int i=0;i<5;++i)std::print("|{:.0f}|{:.9f}|{:.9f}|{:.9f}|\n",av[i],yv[i],sv[i],dv[i]);
}
