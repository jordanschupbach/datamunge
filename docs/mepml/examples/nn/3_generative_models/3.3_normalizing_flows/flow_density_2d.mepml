 namespace n=dm::nn;auto layout=dm::graphics::RLayout::create(1,3);
 for(auto family:{"banana","eight_gaussians","checkerboard"}){std::map<std::string,n::Tensor> data;for(auto& [k,v]:n::load_npz(std::string("build/flow_density_2d/")+family+"/data.npz"))data[k]=v;
 auto p=dm::graphics::RPlot::create();std::vector<dm::graphics::RGB> colors{{148,163,184},{37,99,235},{234,88,12}};int i=0;
 for(auto split:{"fit","validation","test"}){auto x=data.at(std::string(split)+"_points");p.points(n::select(x,1,0).to_vector<double>(),n::select(x,1,1).to_vector<double>(),split,colors[i++],2);}
 p.margins(78,22,54,70).x_limits(-5,7).y_limits(-5,7).x_label("x0").y_label("x1").title(family);layout.add(p);}
