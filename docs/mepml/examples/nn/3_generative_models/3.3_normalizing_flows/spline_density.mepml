> Hand-check two bins before fitting a conditioner

Use knots(-2,-2),(0,0),(2,2), widths and heights 2, and slopes 1,2,1. Width/height
logits are zero. Choose the single interior raw derivative so that
.001+softplus(raw+log(expm1(.999)))=2, using Double offset precision.
For the first bin theta=(x+2)/2 gives f(x)=−2+2theta/(1+theta−theta²).
Thus x=−1 maps to−1.2 with derivative .8; x=0 maps to0 with derivative2;
x=1 maps to1.2 with derivative .8. Strict outside tails remain the identity.

The program checks all seven listed points, their actual input derivatives,
analytic log determinants and closed-form inverse. Both panels retain257
native curve evaluations plus the seven checked points. This is a deterministic
worked transform; no fitting or observation pool enters it.

```{cpp, results="markdown", file="figures/spline_toy.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main(){
 namespace n=dm::nn;namespace m=n::models;auto type=n::DType::Float64;
 auto x=n::from_vector(std::vector<double>{-3,-2,-1,0,1,2,3},{7,1}).requires_grad_();
 double raw=std::log(std::expm1(1.999))-std::log(std::expm1(.999));
 auto heads=n::concat({n::zeros({7,4},type),n::full({7,1},raw,type)},1);
 auto f=m::RationalQuadraticSpline(x,heads,false,2),iv=m::RationalQuadraticSpline(f.value,heads,true,2);
 auto j=n::grad(n::sum(f.value),{x})[0];
 auto expected=n::from_vector(std::vector<double>{-3,-2,-1.2,0,1.2,2,3},{7,1});
 auto expected_j=n::from_vector(std::vector<double>{1,1,.8,2,.8,1,1},{7,1});
 if(n::max(n::abs(f.value-expected)).item()>1e-14||n::max(n::abs(j-expected_j)).item()>1e-14||n::max(n::abs(iv.value-x)).item()>1e-14||n::max(n::abs(n::reshape(n::log(j),{-1})-f.logdet)).item()>1e-14||n::max(n::abs(iv.logdet+f.logdet)).item()>1e-14)throw std::runtime_error("Two-bin spline/Jacobian/inverse");
 auto axis=(n::arange(0,257,1,type)*6./256.-3.).requires_grad_();auto grid=n::reshape(axis,{257,1});
 auto gh=n::concat({n::zeros({257,4},type),n::full({257,1},raw,type)},1);auto curve=m::RationalQuadraticSpline(grid,gh,false,2);
 auto derivative=n::grad(n::sum(curve.value),{axis})[0];
 auto left=dm::graphics::RPlot::create();left.lines(axis.to_vector<double>(),curve.value.to_vector<double>(),"Native y(x)",{37,99,235})
 .lines({-3,3},{-3,3},"Identity reference",{148,163,184})
 .points(x.to_vector<double>(),f.value.to_vector<double>(),"Seven checked points",{220,38,38},4)
 .margins(78,22,54,70).x_limits(-3.4,3.4).y_limits(-3.4,5.5).x_label("Input x").y_label("Spline y").title("Two bins: positive rational-quadratic map");
 auto right=dm::graphics::RPlot::create();right.lines(axis.to_vector<double>(),derivative.to_vector<double>(),"Actual derivative",{37,99,235})
 .lines({-3,3},{1,1},"Identity tail slope",{148,163,184})
 .points(x.to_vector<double>(),j.to_vector<double>(),"Seven actual slopes",{220,38,38},4)
 .margins(78,22,54,70).x_limits(-3.4,3.4).y_limits(0,3.2).x_label("Input x").y_label("dy / dx").title("Positive slopes join identity tails");
 dm::graphics::RLayout::create(1,2).add(left).add(right).size(1100,520).fit_panels().save_svg("build/spline_toy.svg");
 n::save_npz("build/spline_toy_values.npz",{{"input",x},{"value",f.value},{"actual_derivative",j},{"logdet",f.logdet},{"recovered",iv.value},{"inverse_logdet",iv.logdet},{"axis",axis},{"curve",curve.value},{"curve_derivative",derivative},{"widths",f.widths},{"heights",f.heights},{"knot_derivatives",f.derivatives}});
 std::print("| x | Native y | Actual derivative | Log determinant |\n|---:|---:|---:|---:|\n");
 auto xv=x.to_vector<double>(),yv=f.value.to_vector<double>(),jv=j.to_vector<double>(),ld=f.logdet.to_vector<double>();
 for(int i=0;i<7;++i)std::print("|{:.0f}|{:.10f}|{:.10f}|{:.10f}|\n",xv[i],yv[i],jv[i],ld[i]);
}
