> Retain the original knots, neighbours, tails and actual derivatives

The complete program saves the original272-point fixture before fitting:
15 declared rows include±10 tails,±4 boundaries, uniform x-knots−2,0,2 and
nearby values, followed by257 dense rows on[-6,6]. Each row receives the same
source11-head template(0,0,0,0,.2,−.3,.1,.4,−.2,.3,.6), as an independently
differentiable head row. The declared neighbours target its uniform x-knots;
inverse panels use the same supplied input rows, rather than a new y-knot grid.

The panels retain all 272 values for each direction:257 dense rows as curves,
15 declared rows as markers. They also show all 272 roundtrip residuals and
both sets of 272 actual-slope/logdet residuals. Actual derivatives are positive;
strict-tail values are unchanged and endpoint slopes are one. Inversion is
algebraic, with the displayed Float32 rounding errors. The four-bin metadata
table is constant across these identical head rows.

```{cpp, results="markdown", file="figures/spline_fixture.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main(){
 namespace n=dm::nn;using T=n::Tensor;std::map<std::string,T> f;
 for(auto& [k,x]:n::load_npz("build/spline_density/spline_fixtures.npz"))f[k]=n::cast(x,n::DType::Float64);
 auto x=n::reshape(f.at("input"),{-1});
 auto values=[&](const T& t,int start,int end){return n::slice_axis(n::reshape(t,{-1}),0,start,end).to_vector<double>();};
 auto left=dm::graphics::RPlot::create();auto slope=dm::graphics::RPlot::create();
 const std::vector<dm::graphics::RGB> colors{{37,99,235},{234,88,12}};
 int i=0;for(auto pair:{std::make_pair("value","Forward"),std::make_pair("inverse","Inverse")}){
  left.lines(values(x,15,272),values(f.at(pair.first),15,272),std::string(pair.second)+" dense257",colors[i])
  .points(values(x,0,15),values(f.at(pair.first),0,15),std::string(pair.second)+" declared15",colors[i],3);++i;}
 left.lines({-10,10},{-10,10},"Identity reference",{148,163,184}).margins(78,22,54,70)
 .x_limits(-11,11).y_limits(-11,17).x_label("Original supplied fixture input").y_label("Output value").title("Original fixture: both scalar maps");
 i=0;for(auto pair:{std::make_pair("input_jacobian","Forward"),std::make_pair("inverse_input_jacobian","Inverse")}){
  slope.lines(values(x,15,272),values(f.at(pair.first),15,272),std::string(pair.second)+" dense257",colors[i])
  .points(values(x,0,15),values(f.at(pair.first),0,15),std::string(pair.second)+" declared15",colors[i],3);++i;}
 slope.lines({-10,10},{1,1},"Identity tail slope",{148,163,184}).margins(78,22,54,70)
 .x_limits(-11,11).y_limits(0,4).x_label("Original supplied fixture input").y_label("Actual scalar derivative").title("Positive slopes meet identity tails");
 auto roundtrip=n::reshape(n::abs(f.at("roundtrip")-f.at("input")),{-1});
 auto forward_error=n::reshape(n::log(f.at("input_jacobian")),{-1})-f.at("logdet");
 auto inverse_error=n::reshape(n::log(f.at("inverse_input_jacobian")),{-1})-f.at("inverse_logdet");
 auto rows=n::arange(0,272).to_vector<double>();
 auto residual=dm::graphics::RPlot::create();residual.points(rows,(roundtrip*1e6).to_vector<double>(),"All272 rows",{37,99,235},2)
 .margins(78,22,54,70).y_limits(0,2).x_label("Original fixture row index").y_label("Absolute roundtrip error x1e6").title("Analytic inverse, Float32 arithmetic");
 auto determinant=dm::graphics::RPlot::create();determinant.points(rows,(forward_error*1e6).to_vector<double>(),"Forward, all272",{37,99,235},2)
 .points(rows,(inverse_error*1e6).to_vector<double>(),"Inverse, all272",{234,88,12},2)
 .margins(78,22,54,70).y_limits(-1,2).x_label("Original fixture row index").y_label("(log actual slope - logdet) x1e6").title("Actual slopes match analytic logdets");
 dm::graphics::RLayout::create(2,2).add(left).add(slope).add(residual).add(determinant).size(1100,1000).fit_panels().save_svg("build/spline_fixture.svg");
 n::save_npz("build/spline_fixture_plot_values.npz",{{"roundtrip_absolute_error",roundtrip},{"forward_logdet_error",forward_error},{"inverse_logdet_error",inverse_error}});
 auto w=n::select(f.at("widths"),0,0).to_vector<double>(),h=n::select(f.at("heights"),0,0).to_vector<double>(),d=n::select(f.at("derivatives"),0,0).to_vector<double>();
 std::print("| Source bin | Actual width | Actual height | Left slope | Right slope |\n|---:|---:|---:|---:|---:|\n");
 for(int j=0;j<4;++j)std::print("|{}|{:.9f}|{:.9f}|{:.9f}|{:.9f}|\n",j,w[j],h[j],d[j],d[j+1]);
}
