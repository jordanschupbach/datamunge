> Hand-check ActNorm moments and install the proposed parameters explicitly

For calibration rows (1,2) and (3,6), coordinate means are (2,4) and population
variances (1,4), using divisor N=2. The source's proposals are

$$ b=-\mu,\qquad a=-\tfrac12\log(v+10^{-6}),\qquad y=(x-\mu)/\sqrt{v+10^{-6}}. $$
\alttext(ActNorm initializes bias to negative mean and log scale to minus one half log population variance plus a small ridge.)

The ridge keeps constant coordinates finite; output variance is v/(v+epsilon),
not exactly one. A diagonal transform scales coordinates but does not decorrelate
them. The native calibration helper returns detached proposals and changes no
store. The caller installs them explicitly. Ordinary forward calls never infer
statistics or recalibrate on their inputs.

```{cpp, results="markdown", file="figures/glow_actnorm_toy.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main(){
 namespace n=dm::nn;namespace m=n::models;auto type=n::DType::Float64;
 auto x=n::from_vector(std::vector<double>{1,2,3,6},{2,2});auto fit=m::FlowActNormCalibration(x);
 if(fit.mean.to_vector<double>()!=std::vector<double>{2,4}||fit.variance.to_vector<double>()!=std::vector<double>{1,4})throw std::runtime_error("Worked population moments");
 n::ParameterStore p(1,type);auto identity=m::FlowActNorm(p,"norm",x);
 if(!n::equal_bits(identity.value,x))throw std::runtime_error("No automatic calibration");
 p.set("norm/bias",fit.bias);p.set("norm/log_scale",fit.log_scale);auto before=p.flatten();
 auto out=m::FlowActNorm(p,"norm",x),rec=m::FlowActNorm(p,"norm",out.value,true);
 auto expected=fit.variance/(fit.variance+1e-6);
 if(n::max(n::abs(rec.value-x)).item()>1e-14||n::max(n::abs(n::mean(out.value,{0}))).item()>1e-14||n::max(n::abs(n::mean(n::square(out.value),{0})-expected)).item()>1e-14||p.flatten()!=before)throw std::runtime_error("Worked ActNorm");
 dm::graphics::RPlot::create().points(n::select(x,1,0).to_vector<double>(),n::select(x,1,1).to_vector<double>(),"Original rows",{100,116,139},6)
 .points(n::select(out.value,1,0).to_vector<double>(),n::select(out.value,1,1).to_vector<double>(),"Explicitly calibrated",{37,99,235},6)
 .size(900,942).margins(90,24,72,84).x_limits(-2,7).y_limits(-2,7)
 .x_label("Coordinate 0").y_label("Coordinate 1").title("Explicit calibration centers and scales two coordinates")
 .save_svg("build/glow_actnorm_toy.svg");
 std::print("| Coordinate | Mean | Population variance | Bias | Log scale |\n|---|---:|---:|---:|---:|\n");
 auto mu=fit.mean.to_vector<double>(),v=fit.variance.to_vector<double>(),a=fit.log_scale.to_vector<double>();
 for(int c=0;c<2;++c)std::print("|{}|{}|{}|{}|{:.12f}|\n",c,mu[c],v[c],-mu[c],a[c]);
}
