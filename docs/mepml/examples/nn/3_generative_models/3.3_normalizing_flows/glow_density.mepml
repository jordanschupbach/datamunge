> Hand-check a signed mixing matrix, its inverse and actual Jacobian

Use W=[[1,2],[3,4]], det W=−2. With row vectors, y=xW, the input Jacobian is
W transpose, also determinant −2. The map reverses orientation and multiplies
area by two; its forward log|det| is log2 and inverse log|det| is −log2.
For example (1,1) maps to (4,6). The native inverse uses the adjugate divided
by det W. It rejects singular matrices; negative signs are valid.

The compact source computes .5log((ad−bc)²), preserving its Float32 arithmetic.
Extreme invertible matrices whose squared determinant overflows or underflows
can therefore be rejected. The fixture here stays far from that limitation.

```{cpp, results="markdown", file="figures/glow_mixing_toy.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main(){
 namespace n=dm::nn;namespace m=n::models;auto type=n::DType::Float64;n::ParameterStore p(1,type);
 p.set("mix/W",n::from_vector(std::vector<double>{1,2,3,4},{2,2}));
 auto x=n::from_vector(std::vector<double>{.2,-.7,1.1,.4,-.3,2},{3,2}).requires_grad_();
 auto out=m::FlowMix2D(p,"mix",x),rec=m::FlowMix2D(p,"mix",out.value,.35,true);
 auto a=n::grad(n::sum(n::slice_axis(out.value,1,0,1)),{x},n::GradOptions{true,false,false})[0];
 auto b=n::grad(n::sum(n::slice_axis(out.value,1,1,2)),{x})[0];
 auto determinant=n::select(a,1,0)*n::select(b,1,1)-n::select(a,1,1)*n::select(b,1,0);
 if(n::max(n::abs(determinant+2.)).item()!=0||std::abs(out.logdet.item()-std::log(2.))>1e-14||n::max(n::abs(rec.value-x)).item()>1e-14)throw std::runtime_error("Signed mixing/Jacobian");
 auto original_x=n::select(x,1,0).to_vector<double>(),original_y=n::select(x,1,1).to_vector<double>();
 auto mapped_x=n::select(out.value,1,0).to_vector<double>(),mapped_y=n::select(out.value,1,1).to_vector<double>();
 dm::graphics::RPlot::create().segments(original_x,original_y,mapped_x,mapped_y,{148,163,184})
 .points(original_x,original_y,"Original rows",{100,116,139},5)
 .points(mapped_x,mapped_y,"Signed matrix output",{37,99,235},5)
 .size(900,942).margins(90,24,72,84).x_limits(-3,10).y_limits(-3,10)
 .x_label("Coordinate 0").y_label("Coordinate 1").title("A negative determinant reverses orientation, not probability")
 .save_svg("build/glow_mixing_toy.svg");
 std::print("All3 actual Jacobian determinants=-2; forward log|det|={:.12f}, inverse={:.12f}; maximum roundtrip error {:.3g}.\n",out.logdet.item(),rec.logdet.item(),n::max(n::abs(rec.value-x)).item());
}
