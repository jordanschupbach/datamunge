```{cpp, results="markdown", file="figures/convolution_im2col_patches.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

int main() {
  namespace n = dm::nn;
  const auto type = n::DType::Float64;
  auto x = n::linspace(1, 9, 9, type).reshape({1, 3, 3, 1}).detach().requires_grad_();
  const auto options = n::conv_options(1, n::Padding::Valid);
  const auto patches = n::im2col2d(x, 2, 2, options);
  const auto output = n::matmul(patches, n::ones({4, 1}, type));
  const auto overlap = n::grad(n::sum(patches), {x})[0].reshape({3, 3});
  if (output.to_vector<double>() != std::vector<double>{12, 16, 24, 28})
    return 1;
  auto a = n::plot_tensor_map(patches, 1, 9).title("Four rows of extracted patches");
  auto b = n::plot_tensor_map(overlap, 0, 4).title("Adjoint coverage counts");
  std::filesystem::create_directories("build");
  dm::graphics::RLayout::create(1, 2).add(a).add(b).size(1100, 470).fit_panels().save_svg(
      "build/convolution_im2col_patches.svg");
  std::print("Patch matrix {}; outputs {}; adjoint counts {}.\n", patches.to_vector<double>(),
             output.to_vector<double>(), overlap.to_vector<double>());
}
```
