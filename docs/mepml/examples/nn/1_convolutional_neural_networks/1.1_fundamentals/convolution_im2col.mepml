> Checking the theory

Rectangular filters, batches, channels, padding, strides and dilation share the same matrix identity. Float64 comparisons check input and filter derivatives separately.

```{cpp, results="markdown", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

int main() {
  namespace n = dm::nn;
  n::Generator rng(149);
  const auto type = n::DType::Float64;
  double forward = 0, input_error = 0, filter_error = 0;
  int checked = 0;
  for (auto padding : {n::Padding::Valid, n::Padding::Same})
    for (int stride : {1, 2})
      for (int dilation : {1, 2}) {
        auto x = n::normal({2, 7, 8, 2}, 0, .3, rng, type).requires_grad_();
        auto k = n::normal({2, 3, 2, 3}, 0, .3, rng, type).requires_grad_();
        const auto options = n::conv_options(stride, padding, dilation);
        const auto native = n::conv2d(x, k, options);
        const auto P = n::im2col2d(x, 2, 3, options), W = k.reshape({12, 3});
        const auto manual = n::matmul(P, W).reshape(native.shape());
        const auto upstream = n::normal(native.shape(), 0, .3, rng, type);
        const auto g = n::grad(n::sum(manual * upstream), {x, k});
        const auto dx = n::conv2d_backprop_input(x.shape(), k, upstream, options);
        const auto dw = n::conv2d_backprop_filter(x, k.shape(), upstream, options);
        forward = std::max(forward, n::max(n::abs(native - manual)).item());
        input_error = std::max(input_error, n::max(n::abs(g[0] - dx)).item());
        filter_error = std::max(filter_error, n::max(n::abs(g[1] - dw)).item());
        ++checked;
      }
  if (std::max({forward, input_error, filter_error}) > 1e-10)
    return 1;
  std::print("{} geometries; maximum forward/input/filter errors {:.12f}, {:.12f}, {:.12f}.\n",
             checked, forward, input_error, filter_error);
}
```
// result_begin: markdown
8 geometries; maximum forward/input/filter errors 0.000000000000, 0.000000000000, 0.000000000000.
// result_end


> Conclusion

The tiny patch matrix explains repeated input coordinates, and the geometry sweep checks
that their scatter-added gradients agree with native convolution. Explicit patches cost
extra memory; the matrix formulation is a reference and teaching tool.

> References

- [Dumoulin and Visin (2016), A guide to convolution arithmetic for deep learning](https://arxiv.org/abs/1603.07285).
