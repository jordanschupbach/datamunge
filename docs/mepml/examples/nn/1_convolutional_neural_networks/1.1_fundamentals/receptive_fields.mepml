```{cpp, results="markdown", file="figures/receptive_fields_support.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

int main() {
  namespace n = dm::nn;
  const auto type = n::DType::Float64;
  const auto fields = n::receptive_fields({{3, 1, 1}, {2, 2, 1}, {3, 1, 1}, {2, 2, 1}});
  auto layout = dm::graphics::RLayout::create(1, 2);
  for (int coordinate : {0, 3}) {
    auto x = n::zeros({1, 28, 28, 1}, type).requires_grad_(), h = x;
    for (int stage = 0; stage < 2; ++stage) {
      h = n::conv2d(h, n::ones({3, 3, 1, 1}, type));
      h = n::avg_pool2d(h, 2, 2);
    }
    const auto selected = n::sum(n::slice(h, {0, coordinate, coordinate, 0}, {1, 1, 1, 1}));
    const auto gradient = n::grad(selected, {x})[0].reshape({28, 28});
    const double centre = 2 + 4 * coordinate;
    int active = 0;
    for (int y = 0; y < 28; ++y)
      for (int column = 0; column < 28; ++column) {
        const bool inside = y + .5 >= centre - 5 && y + .5 < centre + 5 &&
                            column + .5 >= centre - 5 && column + .5 < centre + 5;
        if ((gradient.at({y, column}) > 0) != inside)
          return 1;
        active += inside;
      }
    layout.add(n::plot_tensor_map(gradient).title(coordinate == 0 ? "Boundary unit at (0,0)"
                                                                  : "Interior unit at (3,3)"));
    std::print("Output index {}; centre {}; active input pixels {}.\n", coordinate, centre,
               active);
  }
  for (const auto &f : fields)
    std::print("Width {}; jump {}.\n", f.size, f.jump);
  if (fields.back().size != 10 || fields.back().jump != 4)
    return 1;
  std::filesystem::create_directories("build");
  layout.size(1100, 470).fit_panels().save_svg("build/receptive_fields_support.svg");
}
```
