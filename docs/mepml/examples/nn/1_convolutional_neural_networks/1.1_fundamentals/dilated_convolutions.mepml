```{cpp, results="markdown", file="figures/dilated_convolutions_support.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

int main() {
  namespace n = dm::nn;
  const auto type = n::DType::Float64;
  auto panels = dm::graphics::RLayout::create(2, 2);
  std::vector<std::vector<int>> schedules{{1, 1, 1}, {2, 2, 2}, {1, 2, 4}};
  for (const auto &rates : schedules) {
    auto x = n::zeros({1, 33, 33, 1}, type).requires_grad_(), h = x;
    for (int d : rates)
      h = n::conv2d(h, n::ones({3, 3, 1, 1}, type), n::conv_options(1, n::Padding::Same, d));
    const auto gradient =
        n::grad(n::sum(n::slice(h, {0, 16, 16, 0}, {1, 1, 1, 1})), {x})[0].reshape({33, 33});
    const auto support = n::cast(n::greater(gradient, 0), type);
    auto p = n::plot_tensor_map(support, 0, 1)
                 .title("Rates " + std::to_string(rates[0]) + "," + std::to_string(rates[1]) +
                        "," + std::to_string(rates[2]));
    panels.add(p);
    std::print("Rates {}: {} input pixels have a derivative.\n", rates,
               n::sum(support).item());
  }
  panels.add(
      n::plot_tensor_map(
          n::expand_dilated_kernel(n::ones({3, 3, 1, 1}, type), 2).reshape({5, 5}), 0, 1)
          .title("A 3 by 3 filter expanded at rate 2"));
  std::filesystem::create_directories("build");
  panels.size(1100, 920).fit_panels().save_svg("build/dilated_convolutions_support.svg");
}
```
