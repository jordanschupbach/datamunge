> Checking the theory

Float64 native and zero-expanded filters must agree for both values and derivatives.

```{cpp, results="markdown", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

int main() {
  namespace n = dm::nn;
  n::Generator rng(37);
  const auto type = n::DType::Float64;
  double worst = 0;
  for (auto padding : {n::Padding::Valid, n::Padding::Same})
    for (int d : {1, 2, 3}) {
      auto x = n::normal({1, 9, 10, 2}, 0, .3, rng, type).requires_grad_();
      auto k = n::normal({2, 3, 2, 3}, 0, .3, rng, type).requires_grad_();
      const auto native = n::conv2d(x, k, n::conv_options(1, padding, d));
      const auto expanded =
          n::conv2d(x, n::expand_dilated_kernel(k, d), n::conv_options(1, padding));
      const auto a = n::grad(n::sum(native), {x, k}), b = n::grad(n::sum(expanded), {x, k});
      worst =
          std::max({worst, n::max(n::abs(native - expanded)).item(),
                    n::max(n::abs(a[0] - b[0])).item(), n::max(n::abs(a[1] - b[1])).item()});
    }
  if (worst > 1e-10)
    return 1;
  std::print(
      "Six native/expanded geometries; maximum forward or derivative discrepancy {:.12f}.\n",
      worst);
}
```
// result_begin: markdown
Six native/expanded geometries; maximum forward or derivative discrepancy 0.000000000000.
// result_end

> A controlled prediction example

A fixed rate-two teacher generates outputs from independent Gaussian images. Two students have the same nine weights; only the rate-two student can see every teacher tap. All inputs below are generated tensors.

```{cpp, results="markdown", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

int main() {
  namespace n = dm::nn;
  n::set_num_threads(2);
  n::Generator rng(101);
  const auto training = n::normal({16, 13, 13, 1}, 0, 1, rng),
             test = n::normal({32, 13, 13, 1}, 0, 1, rng);
  const auto truth = n::tensor({.2, -.4, .3, .1, .7, -.2, .3, .1, -.5}, {3, 3, 1, 1});
  const auto train_y = n::conv2d(training, truth, n::conv_options(1, n::Padding::Same, 2));
  const auto test_y = n::conv2d(test, truth, n::conv_options(1, n::Padding::Same, 2));
  std::vector<double> rate, mse;
  for (int dilation : {1, 2}) {
    auto kernel = n::zeros({3, 3, 1, 1}).requires_grad_();
    n::OptimizerConfig config;
    config.kind = n::OptimizerKind::Adam;
    n::Optimizer optimizer({kernel}, .03, config);
    for (int step = 0; step < 350; ++step) {
      const auto prediction =
          n::conv2d(training, kernel, n::conv_options(1, n::Padding::Same, dilation));
      optimizer.minimize(n::mean(n::square(prediction - train_y)));
    }
    n::NoGradGuard guard;
    const auto prediction =
        n::conv2d(test, kernel, n::conv_options(1, n::Padding::Same, dilation));
    rate.push_back(dilation);
    mse.push_back(n::mean(n::square(prediction - test_y)).item());
  }
  if (mse[1] > 1e-7 || mse[0] < .1)
    return 1;
  dm::dstruct::DataFrame t;
  t.add_column("rate", rate);
  t.add_column("held_out_MSE", mse);
  std::print("{}\n", t.to_md(9));
}
```
// result_begin: markdown
| rate | held_out_MSE |
| ---: | ---: |
| 1 | 0.534125268 |
| 2 | 0.000000000 |
// result_end


> Conclusion

Expanded and native kernels agree, while support plots expose the gaps an enclosing box
hides. The controlled fit isolates missing context: the same parameter count cannot recover
independent input values that its sampling pattern never reaches.

> References

- [Yu and Koltun (2016), Multi-Scale Context Aggregation by Dilated Convolutions](https://arxiv.org/abs/1511.07122).
- [Dumoulin and Visin (2016), A guide to convolution arithmetic for deep learning](https://arxiv.org/abs/1603.07285).
