```{cpp, results="markdown", file="figures/cnn_cifar10_crop.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

int main() {
  namespace n = dm::nn;
  n::Generator first(151), repeat(151);
  const auto image = n::ones({1, 32, 32, 3});
  const auto padded = n::pad(image, {{0, 0}, {4, 4}, {4, 4}, {0, 0}});
  const auto a = n::augment::random_crop(padded, 32, 32, first),
             b = n::augment::random_crop(padded, 32, 32, repeat);
  const auto normalised = 2 * a - 1;
  if (n::max(n::abs(a - b)).item() != 0 || n::min(normalised).item() != -1 ||
      n::max(normalised).item() != 1)
    return 1;
  std::filesystem::create_directories("build");
  n::plot_tensor_images((normalised + 1) / 2, 1)
      .title("Seeded crop includes black padding")
      .size(650, 530)
      .save_svg("build/cnn_cifar10_crop.svg");
  std::print("Seeded crop repeats exactly; normalised minimum {}, maximum {}.\n",
             n::min(normalised).item(), n::max(normalised).item());
}
```
