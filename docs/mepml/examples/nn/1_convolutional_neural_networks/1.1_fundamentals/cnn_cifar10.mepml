```{cpp, results="markdown", file="figures/cnn_cifar10_training.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

int main() {
  namespace n = dm::nn;
  n::set_num_threads(2);

  std::filesystem::path cache;
  if (const auto *p = std::getenv("DATAMUNGE_DATA_DIR"))
    cache = p;
  else if (const auto *p = std::getenv("XDG_CACHE_HOME"))
    cache = std::filesystem::path(p) / "datamunge/datasets";
  else
    cache = std::filesystem::path(std::getenv("HOME")) / ".cache/datamunge/datasets";
  dm::datasets::fetch("cifar10", (cache / "cifar10").string());

  const auto raw =
      n::data::LoadCifar({cache / "cifar10/data_batch_1.bin"}, n::data::Cifar::k10);
  const auto images = n::cast(raw.images, n::DType::Float32) / 255.,
             labels = n::cast(raw.labels, n::DType::Int64);
  const auto fit_x = n::slice_axis(images, 0, 0, 256),
             fit_y = n::slice_axis(labels, 0, 0, 256);
  const auto validation_x = 2 * n::slice_axis(images, 0, 256, 320) - 1,
             validation_y = n::slice_axis(labels, 0, 256, 320);
  const auto official = n::load_cifar10((cache / "cifar10").string(), "test");
  const auto test_x = 2 * n::slice_axis(official.images, 0, 0, 128) - 1,
             test_y = n::slice_axis(official.labels, 0, 0, 128);

  n::ParameterStore p(17);
  auto logits = [&](const n::Tensor &input) {
    n::ConvLayerOptions options;
    options.activation = n::Activation::Relu;
    const auto first = n::max_pool2d(n::conv2d(p, "conv1", input, 32, 3, options), 2, 2);
    const auto second = n::max_pool2d(n::conv2d(p, "conv2", first, 64, 3, options), 2, 2);
    const auto hidden =
        n::dense(p, "dense", second.reshape({-1, 8 * 8 * 64}), 128, n::Activation::Relu);
    return n::dense(p, "output", hidden, 10);
  };
  {
    n::NoGradGuard guard;
    logits(n::zeros_like(n::take_rows(fit_x, {0})));
  }
  n::OptimizerConfig config;
  config.kind = n::OptimizerKind::Adam;
  n::Optimizer optimizer(p, .001, config);
  n::BatchOrder batches(fit_x.size(0), 16, 2026);
  n::Generator augmentation_rng(151);
  std::filesystem::create_directories("build");
  const std::string checkpoint = "build/cnn_cifar10_best.npz";
  double best = std::numeric_limits<double>::infinity();
  std::vector<double> epoch, training_nll, validation_nll;
  for (int e = 0; e < 2; ++e) {
    batches.begin_epoch();
    n::WeightedMean average;
    for (auto rows = batches.next(); !rows.empty(); rows = batches.next()) {
      auto input = n::take_rows(fit_x, rows);
      // Independent transforms per image, before mapping padded black to -1.
      std::vector<n::Tensor> augmented;
      for (int64_t row = 0; row < input.size(0); ++row) {
        const auto image = n::slice_axis(input, 0, row, row + 1);
        auto transformed = n::augment::random_crop(
            n::pad(image, {{0, 0}, {4, 4}, {4, 4}, {0, 0}}), 32, 32, augmentation_rng);
        transformed = n::augment::random_flip_left_right(transformed, augmentation_rng);
        augmented.push_back(transformed);
      }
      input = 2 * n::concat(augmented, 0) - 1;

      const auto nll =
          n::sparse_softmax_cross_entropy(logits(input), n::take_rows(fit_y, rows));
      auto loss = nll;
      for (const auto &weight : p.parameters())
        if (weight.dim() >= 2)
          loss = loss + .00005 * n::sum(n::square(weight));
      optimizer.minimize(loss);
      average.add(nll.item(), rows.size());
    }
    n::NoGradGuard guard;
    const double val =
        n::sparse_softmax_cross_entropy(logits(validation_x), validation_y).item();
    epoch.push_back(e + 1);
    training_nll.push_back(average.value());
    validation_nll.push_back(val);
    if (val < best) {
      best = val;
      p.save(checkpoint);
    }
  }
  p.load(checkpoint);
  n::NoGradGuard guard;
  const auto z = logits(test_x);
  const double test_nll = n::sparse_softmax_cross_entropy(z, test_y).item(),
               accuracy = n::accuracy(z, test_y);
  if (!std::isfinite(test_nll) || training_nll.back() >= training_nll.front())
    return 1;
  auto plot = dm::graphics::RPlot::create();
  plot.lines(epoch, training_nll, "training", {37, 99, 235})
      .lines(epoch, validation_nll, "validation", {234, 88, 12})
      .title("A short explicit Adam run; select on validation")
      .x_label("epoch")
      .y_label("mean NLL");
  std::filesystem::create_directories("build");
  plot.size(850, 420).save_svg("build/cnn_cifar10_training.svg");
  std::print(
      "{} fitted rows; 64 validation rows; 128 official-test rows; {} parameters; {} Adam "
      "steps.\n\nSelected validation NLL {:.6f}; test NLL {:.6f}; test accuracy {:.6f}.\n",
      fit_x.size(0), p.count(), optimizer.iterations(), best, test_nll, accuracy);
}
```
// result_begin: markdown
256 fitted rows; 64 validation rows; 128 official-test rows; 545098 parameters; 32 Adam steps.

Selected validation NLL 2.105852; test NLL 2.173872; test accuracy 0.273438.
\image(figures/cnn_cifar10_training.svg)
// result_end
\caption(Training and validation losses come from the visible minibatch loop; the official test subset is evaluated only after checkpoint selection.)
\alttext(Training and validation losses come from the visible minibatch loop; the official test subset is evaluated only after checkpoint selection.)


> Conclusion

The input preview preserves RGB channels, and the seeded crop check establishes padding
semantics. The report makes augmentation, tensor loss, Adam updates and validation selection
visible. Two epochs on 256 rows do not establish full CIFAR-10 benchmark performance.

> References

- [Krizhevsky, Nair and Hinton, CIFAR-10 dataset and binary format](https://www.cs.toronto.edu/~kriz/cifar.html).
- [Dumoulin and Visin (2016), A guide to convolution arithmetic for deep learning](https://arxiv.org/abs/1603.07285).
