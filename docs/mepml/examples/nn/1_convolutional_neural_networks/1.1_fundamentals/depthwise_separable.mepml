```{cpp, results="markdown", file="figures/depthwise_separable_cost.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

int main() {
  namespace n = dm::nn;
  n::Generator rng(19);
  const auto type = n::DType::Float64;
  std::vector<double> multipliers, parameters, dense, errors, ranks;
  for (int m : {1, 2}) {
    auto D = n::normal({3, 3, 3, m}, 0, .3, rng, type).requires_grad_();
    auto P = n::normal({1, 1, 3 * m, 5}, 0, .3, rng, type).requires_grad_();
    const auto W = n::compose_separable_kernel(D, P);
    const auto per_channel = n::transpose(W.reshape({9, 3, 5}), {1, 0, 2});
    const auto singular = n::svd(per_channel, false).s;
    if (n::max(n::abs(n::slice_axis(singular, 1, m, 5))).item() > 1e-10)
      return 1;
    double worst = 0;
    for (int stride : {1, 2}) {
      const auto x = n::normal({2, 7, 8, 3}, 0, .3, rng, type);
      const auto o = n::conv_options(stride);
      const auto factored = n::conv2d(n::depthwise_conv2d(x, D, o), P);
      const auto composed = n::conv2d(x, n::compose_separable_kernel(D, P), o);
      const auto g = n::grad(n::sum(factored), {D, P});
      const auto h = n::grad(n::sum(composed), {D, P});
      worst =
          std::max({worst, n::max(n::abs(factored - composed)).item(),
                    n::max(n::abs(g[0] - h[0])).item(), n::max(n::abs(g[1] - h[1])).item()});
    }
    multipliers.push_back(m);
    parameters.push_back(D.numel() + P.numel());
    dense.push_back(W.numel());
    errors.push_back(worst);
    ranks.push_back(m);
    if (worst > 1e-10)
      return 1;
  }
  auto p = dm::graphics::RPlot::create();
  p.bars({.8, 1.8}, parameters, "separable", {37, 99, 235}, .3)
      .bars({1.2, 2.2}, dense, "dense", {234, 88, 12}, .3)
      .title("Parameter counts at fixed input and output widths")
      .x_label("depth multiplier")
      .y_label("weights")
      .y_limits(0, 170);
  std::filesystem::create_directories("build");
  p.size(850, 420).save_svg("build/depthwise_separable_cost.svg");
  dm::dstruct::DataFrame t;
  t.add_column("multiplier", multipliers);
  t.add_column("separable_weights", parameters);
  t.add_column("dense_weights", dense);
  t.add_column("max_forward_gradient_error", errors);
  std::print("{}\n", t.to_md(10));
}
```
