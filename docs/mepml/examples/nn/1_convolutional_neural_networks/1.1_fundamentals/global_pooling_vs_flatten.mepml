```{cpp, results="markdown", file="figures/global_pooling_vs_flatten_map.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

int main() {
  namespace n = dm::nn;
  n::Generator rng(31);
  const auto type = n::DType::Float64;
  auto x = n::normal({2, 4, 5, 3}, 0, 1, rng, type).requires_grad_();
  const auto w = n::tensor({.4, -.7, .2, .3, -.5, .6}, {3, 2}, type),
             b = n::tensor({.1, -.2}, {2}, type);
  const auto logits = n::matmul(n::global_avg_pool2d(x), w) + b;
  const auto maps = n::matmul(x.reshape({-1, 3}), w).reshape({2, 4, 5, 2});
  const auto permuted = n::matmul(n::global_avg_pool2d(n::reverse(x, {1, 2})), w) + b;
  const auto gradient = n::grad(n::sum(n::slice_axis(logits, 1, 0, 1)), {x})[0];
  const auto expected = n::reshape(n::slice_axis(w, 1, 0, 1), {1, 1, 1, 3}) / 20.;
  const double error = std::max(
      {n::max(n::abs(logits - (n::global_avg_pool2d(maps) + b))).item(),
       n::max(n::abs(logits - permuted)).item(), n::max(n::abs(gradient - expected)).item()});
  if (error > 1e-12)
    return 1;
  const auto map = n::select(n::select(maps, 0, 0), 2, 0);
  std::filesystem::create_directories("build");
  n::plot_tensor_map(map)
      .title("One class-activation map before averaging")
      .size(820, 420)
      .save_svg("build/global_pooling_vs_flatten_map.svg");
  std::print("Maximum CAM, permutation or uniform-gradient discrepancy {:.12f}.\n", error);
}
```
