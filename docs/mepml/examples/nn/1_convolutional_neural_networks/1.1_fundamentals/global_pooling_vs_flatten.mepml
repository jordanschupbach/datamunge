> Checking the theory with explicit head training

Each generated 8×8 two-channel map contains one impulse. Appearance labels identify the active channel; fit on checkerboard-even sites and test on unseen odd sites. Location labels identify left/right with a fixed active channel; test changes only amplitude.

```{cpp, results="markdown", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

int main() {
  namespace n = dm::nn;
  std::vector<std::string> task, head;
  std::vector<double> accuracy, parameters;
  for (bool location : {false, true}) {
    std::vector<float> train_values, test_values;
    std::vector<int64_t> train_labels, test_labels;
    for (int split = 0; split < 2; ++split)
      for (int y = 0; y < 8; ++y)
        for (int x = 0; x < 8; ++x) {
          if (!location && (y + x) % 2 != split)
            continue;
          for (int channel = 0; channel < (location ? 1 : 2); ++channel) {
            std::vector<float> image(128);
            image[(y * 8 + x) * 2 + channel] = location && split ? 80 : 64;
            auto &values = split ? test_values : train_values;
            auto &labels = split ? test_labels : train_labels;
            values.insert(values.end(), image.begin(), image.end());
            labels.push_back(location ? x >= 4 : channel);
          }
        }
    const auto tx = n::from_vector(train_values, {int64_t(train_labels.size()), 8, 8, 2});
    const auto vx = n::from_vector(test_values, {int64_t(test_labels.size()), 8, 8, 2});
    const auto ty = n::from_vector(train_labels), vy = n::from_vector(test_labels);
    for (bool gap : {false, true}) {
      const auto input = gap ? n::global_avg_pool2d(tx) : tx.reshape({-1, 128});
      const auto query = gap ? n::global_avg_pool2d(vx) : vx.reshape({-1, 128});
      auto w = n::zeros({gap ? 2 : 128, 2}).requires_grad_(),
           b = n::zeros({2}).requires_grad_();
      n::OptimizerConfig config;
      config.kind = n::OptimizerKind::Adam;
      n::Optimizer optimizer({w, b}, .05, config);
      for (int step = 0; step < 300; ++step) {
        const auto logits = n::matmul(input, w) + b;
        optimizer.minimize(n::sparse_softmax_cross_entropy(logits, ty));
      }
      n::NoGradGuard guard;
      const double score = n::accuracy(n::matmul(query, w) + b, vy);
      const double expected = location ? (gap ? .5 : 1.) : (gap ? 1. : .5);
      if (score != expected)
        return 1;
      task.push_back(location ? "location" : "appearance");
      head.push_back(gap ? "GAP" : "flatten");
      accuracy.push_back(score);
      parameters.push_back(w.numel() + b.numel());
    }
  }
  dm::dstruct::DataFrame t;
  t.add_column("task", task);
  t.add_column("head", head);
  t.add_column("parameters", parameters);
  t.add_column("held_out_accuracy", accuracy);
  std::print("{}\n", t.to_md(6));
}
```
// result_begin: markdown
| task | head | parameters | held_out_accuracy |
| :--- | :--- | ---: | ---: |
| appearance | flatten | 258 | 0.5 |
| appearance | GAP | 6 | 1.0 |
| location | flatten | 258 | 1.0 |
| location | GAP | 6 | 0.5 |
// result_end


> Conclusion

The exact invariance, class-map and gradient checks hold. Controlled Adam fits expose
both sides of the tradeoff: GAP transfers channel evidence to unseen sites, while flattening
preserves the location information GAP necessarily discards.

> References

- [Lin, Chen and Yan (2014), Network In Network](https://arxiv.org/abs/1312.4400).
