```{cpp, results="markdown", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

int main() {
  namespace n = dm::nn;
  n::ParameterStore p(17, n::DType::Float64), state(0, n::DType::Float64);
  n::BatchNormOptions options;
  options.momentum = .9;
  options.eps = .001;
  const auto x = n::tensor({1, 2, 3, 4}, {2, 1, 1, 2}, n::DType::Float64);
  const auto y = n::batch_norm(p, state, "bn", x, true, options);
  const auto mean = state.at("bn/moving_mean"), variance = state.at("bn/moving_var");
  if (n::max(n::abs(mean - n::tensor({.2, .3}, {2}, n::DType::Float64))).item() > 1e-12 ||
      n::max(n::abs(variance - 1.1)).item() > 1e-12)
    return 1;
  const auto snapshot = state.clone();
  const auto alone = n::batch_norm(p, state, "bn", n::take_rows(x, {0}), false, options);
  const auto together = n::take_rows(n::batch_norm(p, state, "bn", x, false, options), {0});
  if (n::max(n::abs(alone - together)).item() > 1e-12)
    return 1;
  for (const auto &name : state.names())
    if (n::max(n::abs(state.at(name) - snapshot.at(name))).item() != 0)
      return 1;
  std::print("Moving means {}; moving variances {}; inference companion discrepancy {:.12f}; "
             "state unchanged.\n",
             mean.to_vector<double>(), variance.to_vector<double>(),
             n::max(n::abs(alone - together)).item());
}
```
// result_begin: markdown
Moving means [0.19999999999999996, 0.29999999999999993]; moving variances [1.1, 1.1]; inference companion discrepancy 0.000000000000; state unchanged.
// result_end

> A dataset example

Original MNIST input examples are shown before the paired fits.

```{cpp, results="markdown", file="figures/batch_norm_ablation_inputs.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

int main() {
  namespace n = dm::nn;

  std::filesystem::path cache;
  if (const auto *p = std::getenv("DATAMUNGE_DATA_DIR"))
    cache = p;
  else if (const auto *p = std::getenv("XDG_CACHE_HOME"))
    cache = std::filesystem::path(p) / "datamunge/datasets";
  else
    cache = std::filesystem::path(std::getenv("HOME")) / ".cache/datamunge/datasets";
  dm::datasets::fetch("mnist", (cache / "mnist").string());

  const auto data = n::load_mnist((cache / "mnist").string(), "train");
  const auto images = data.images, labels = data.labels;

  std::vector<int64_t> rows;
  for (int cls = 0; cls < 10; ++cls) {
    for (int64_t row = 0; row < labels.numel(); ++row)
      if (labels.at({row}) == cls) {
        rows.push_back(row);
        break;
      }
  }
  if (rows.size() != 10)
    return 1;
  std::filesystem::create_directories("build");
  n::plot_tensor_images(n::take_rows(images, rows), 5)
      .title("MNIST: one original 28 by 28 image per digit")
      .size(1000, 530)
      .save_svg("build/batch_norm_ablation_inputs.svg");
  std::print("One original cached training image per class, IDs 0..4 then 5..9.\n");
}
```
