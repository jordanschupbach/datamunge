```{cpp, results="markdown", file="figures/batch_norm_ablation_pairs.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

int main() {
  namespace n = dm::nn;
  n::set_num_threads(2);

  std::filesystem::path cache;
  if (const auto *p = std::getenv("DATAMUNGE_DATA_DIR"))
    cache = p;
  else if (const auto *p = std::getenv("XDG_CACHE_HOME"))
    cache = std::filesystem::path(p) / "datamunge/datasets";
  else
    cache = std::filesystem::path(std::getenv("HOME")) / ".cache/datamunge/datasets";
  dm::datasets::fetch("mnist", (cache / "mnist").string());

  const auto data = n::load_mnist((cache / "mnist").string(), "train"),
             test = n::load_mnist((cache / "mnist").string(), "test");
  const auto tx = n::slice_axis(data.images, 0, 0, 128),
             ty = n::slice_axis(data.labels, 0, 0, 128);
  const auto vx = n::slice_axis(data.images, 0, 128, 192),
             vy = n::slice_axis(data.labels, 0, 128, 192);
  const auto qx = n::slice_axis(test.images, 0, 0, 64),
             qy = n::slice_axis(test.labels, 0, 0, 64);
  auto logits = [](n::ParameterStore &p, n::ParameterStore &state, const n::Tensor &x, bool bn,
                   bool training) {
    n::BatchNormOptions options;
    options.momentum = .9;
    options.eps = .001;
    auto h = x;
    for (int block = 0; block < 2; ++block) {
      h = n::conv2d(p, "conv" + std::to_string(block + 1), h, block == 0 ? 16 : 32, 3);
      if (bn)
        h = n::batch_norm(p, state, "bn" + std::to_string(block + 1), h, training, options);
      h = n::max_pool2d(n::relu(h), 2, 2);
    }
    h = n::dense(p, "dense", h.reshape({-1, 7 * 7 * 32}), 64, n::Activation::Relu);
    return n::dense(p, "output", h, 10);
  };
  std::filesystem::create_directories("build");
  std::vector<double> seeds, plain_accuracy, bn_accuracy, difference;
  for (int seed : {11, 23, 47}) {
    n::ParameterStore plain(seed), bn(seed), plain_state(0), bn_state(0);
    {
      n::NoGradGuard guard;
      logits(plain, plain_state, n::zeros({1, 28, 28, 1}), false, false);
      logits(bn, bn_state, n::zeros({1, 28, 28, 1}), true, false);
      for (const auto &name : plain.names())
        bn.at(name).copy_(plain.at(name));
    }
    double scores[2]{};
    for (int variant = 0; variant < 2; ++variant) {
      auto &p = variant ? bn : plain;
      auto &state = variant ? bn_state : plain_state;
      n::OptimizerConfig config;
      config.kind = n::OptimizerKind::Adam;
      n::Optimizer optimizer(p, .001, config);
      n::BatchOrder batches(128, 16, 2026);
      const std::string prefix =
          "build/bn_pair_" + std::to_string(seed) + "_" + std::to_string(variant);
      double best = std::numeric_limits<double>::infinity();
      for (int epoch = 0; epoch < 2; ++epoch) {
        batches.begin_epoch();
        for (auto rows = batches.next(); !rows.empty(); rows = batches.next()) {
          const auto z = logits(p, state, n::take_rows(tx, rows), variant, true);
          auto loss = n::sparse_softmax_cross_entropy(z, n::take_rows(ty, rows));
          for (const auto &w : p.parameters())
            if (w.dim() >= 2)
              loss = loss + .00005 * n::sum(n::square(w));
          optimizer.minimize(loss);
        }
        n::NoGradGuard guard;
        const double validation =
            n::sparse_softmax_cross_entropy(logits(p, state, vx, variant, false), vy).item();
        if (validation < best) {
          best = validation;
          p.save(prefix + "_params.npz");
          if (variant)
            state.save(prefix + "_state.npz");
        }
      }
      p.load(prefix + "_params.npz");
      if (variant)
        state.load(prefix + "_state.npz");
      n::NoGradGuard guard;
      const auto snapshot = state.clone();
      const auto z = logits(p, state, qx, variant, false);
      scores[variant] = n::accuracy(z, qy);
      const auto alone = logits(p, state, n::take_rows(qx, {0}), variant, false);
      if (n::max(n::abs(alone - n::take_rows(z, {0}))).item() > 2e-5)
        return 1;
      for (const auto &name : state.names())
        if (n::max(n::abs(state.at(name) - snapshot.at(name))).item() != 0)
          return 1;
      n::ParameterStore restored(0), restored_state(0);
      logits(restored, restored_state, n::zeros({1, 28, 28, 1}), variant, false);
      restored.load(prefix + "_params.npz");
      if (variant)
        restored_state.load(prefix + "_state.npz");
      if (n::max(n::abs(z - logits(restored, restored_state, qx, variant, false))).item() >
          1e-6)
        return 1;
    }
    seeds.push_back(seed);
    plain_accuracy.push_back(scores[0]);
    bn_accuracy.push_back(scores[1]);
    difference.push_back(scores[1] - scores[0]);
  }
  auto plot = dm::graphics::RPlot::create();
  plot.bars({.8, 1.8, 2.8}, plain_accuracy, "plain", {37, 99, 235}, .3)
      .bars({1.2, 2.2, 3.2}, bn_accuracy, "BN", {234, 88, 12}, .3)
      .title("Short paired runs on the same original MNIST rows")
      .x_label("seed pair index")
      .y_label("test subset accuracy")
      .y_limits(0, 1.2);
  plot.size(850, 420).save_svg("build/batch_norm_ablation_pairs.svg");
  dm::dstruct::DataFrame table;
  table.add_column("seed", seeds);
  table.add_column("plain_accuracy", plain_accuracy);
  table.add_column("BN_accuracy", bn_accuracy);
  table.add_column("paired_difference", difference);
  std::print("{}\n", table.to_md(6));
}
```
// result_begin: markdown
| seed | plain_accuracy | BN_accuracy | paired_difference |
| ---: | ---: | ---: | ---: |
| 11 | 0.390625 | 0.390625 | 0.000000 |
| 23 | 0.546875 | 0.421875 | -0.125000 |
| 47 | 0.578125 | 0.437500 | -0.140625 |

