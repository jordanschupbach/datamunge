```{cpp, results="markdown", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

int main() {
  namespace n = dm::nn;
  n::ParameterStore p(17);
  const auto stages = n::models::MnistCnn(p, n::zeros({2, 28, 28, 1}));
  if (p.count() != 105866 || stages.pool1.shape() != n::Shape{2, 14, 14, 16} ||
      stages.pool2.shape() != n::Shape{2, 7, 7, 32} ||
      stages.logits.shape() != n::Shape{2, 10})
    return 1;
  std::print("Parameters {}; pooled spatial widths {} and {}; hidden width {}; classes {}.\n",
             p.count(), stages.pool1.size(1), stages.pool2.size(1), stages.hidden.size(1),
             stages.logits.size(1));
}
```
// result_begin: markdown
Parameters 105866; pooled spatial widths 14 and 7; hidden width 64; classes 10.
// result_end

> A dataset example

The preview shows original MNIST, not the separate bundled 8×8 digits dataset.

```{cpp, results="markdown", file="figures/cnn_mnist_inputs.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

int main() {
  namespace n = dm::nn;

  std::filesystem::path cache;
  if (const auto *p = std::getenv("DATAMUNGE_DATA_DIR"))
    cache = p;
  else if (const auto *p = std::getenv("XDG_CACHE_HOME"))
    cache = std::filesystem::path(p) / "datamunge/datasets";
  else
    cache = std::filesystem::path(std::getenv("HOME")) / ".cache/datamunge/datasets";
  dm::datasets::fetch("mnist", (cache / "mnist").string());

  const auto data = n::load_mnist((cache / "mnist").string(), "train");
  const auto images = data.images, labels = data.labels;

  std::vector<int64_t> rows;
  for (int cls = 0; cls < 10; ++cls) {
    for (int64_t row = 0; row < labels.numel(); ++row)
      if (labels.at({row}) == cls) {
        rows.push_back(row);
        break;
      }
  }
  if (rows.size() != 10)
    return 1;
  std::filesystem::create_directories("build");
  n::plot_tensor_images(n::take_rows(images, rows), 5)
      .title("MNIST: one original 28 by 28 image per digit")
      .size(1000, 530)
      .save_svg("build/cnn_mnist_inputs.svg");
  std::print("One original cached training image per class, IDs 0..4 then 5..9.\n");
}
```
