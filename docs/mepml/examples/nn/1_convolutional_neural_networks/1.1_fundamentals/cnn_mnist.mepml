```{cpp, results="markdown", file="figures/cnn_mnist_training.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

int main() {
  namespace n = dm::nn;
  n::set_num_threads(2);

  std::filesystem::path cache;
  if (const auto *p = std::getenv("DATAMUNGE_DATA_DIR"))
    cache = p;
  else if (const auto *p = std::getenv("XDG_CACHE_HOME"))
    cache = std::filesystem::path(p) / "datamunge/datasets";
  else
    cache = std::filesystem::path(std::getenv("HOME")) / ".cache/datamunge/datasets";
  dm::datasets::fetch("mnist", (cache / "mnist").string());

  const auto training = n::load_mnist((cache / "mnist").string(), "train");
  const auto official = n::load_mnist((cache / "mnist").string(), "test");
  const auto fit_x = n::slice_axis(training.images, 0, 0, 512),
             fit_y = n::slice_axis(training.labels, 0, 0, 512);
  const auto validation_x = n::slice_axis(training.images, 0, 512, 512 + 128),
             validation_y = n::slice_axis(training.labels, 0, 512, 512 + 128);
  const auto test_x = n::slice_axis(official.images, 0, 0, 128),
             test_y = n::slice_axis(official.labels, 0, 0, 128);

  n::ParameterStore p(17);
  auto logits = [&](const n::Tensor &input) {
    return n::models::MnistCnn(p, input).logits;
  };
  {
    n::NoGradGuard guard;
    logits(n::zeros_like(n::take_rows(fit_x, {0})));
  }
  n::OptimizerConfig config;
  config.kind = n::OptimizerKind::Adam;
  n::Optimizer optimizer(p, .001, config);
  n::BatchOrder batches(fit_x.size(0), 16, 2026);
  n::Generator augmentation_rng(151);
  std::filesystem::create_directories("build");
  const std::string checkpoint = "build/cnn_mnist_best.npz";
  double best = std::numeric_limits<double>::infinity();
  std::vector<double> epoch, training_nll, validation_nll;
  for (int e = 0; e < 3; ++e) {
    batches.begin_epoch();
    n::WeightedMean average;
    for (auto rows = batches.next(); !rows.empty(); rows = batches.next()) {
      auto input = n::take_rows(fit_x, rows);
      const auto nll =
          n::sparse_softmax_cross_entropy(logits(input), n::take_rows(fit_y, rows));
      auto loss = nll;
      for (const auto &weight : p.parameters())
        if (weight.dim() >= 2)
          loss = loss + .00005 * n::sum(n::square(weight));
      optimizer.minimize(loss);
      average.add(nll.item(), rows.size());
    }
    n::NoGradGuard guard;
    const double val =
        n::sparse_softmax_cross_entropy(logits(validation_x), validation_y).item();
    epoch.push_back(e + 1);
    training_nll.push_back(average.value());
    validation_nll.push_back(val);
    if (val < best) {
      best = val;
      p.save(checkpoint);
    }
  }
  p.load(checkpoint);
  n::NoGradGuard guard;
  const auto z = logits(test_x);
  const double test_nll = n::sparse_softmax_cross_entropy(z, test_y).item(),
               accuracy = n::accuracy(z, test_y);
  if (!std::isfinite(test_nll) || training_nll.back() >= training_nll.front())
    return 1;
  auto plot = dm::graphics::RPlot::create();
  plot.lines(epoch, training_nll, "training", {37, 99, 235})
      .lines(epoch, validation_nll, "validation", {234, 88, 12})
      .title("A short explicit Adam run; select on validation")
      .x_label("epoch")
      .y_label("mean NLL");
  std::filesystem::create_directories("build");
  plot.size(850, 420).save_svg("build/cnn_mnist_training.svg");
  std::print(
      "{} fitted rows; 128 validation rows; 128 official-test rows; {} parameters; {} Adam "
      "steps.\n\nSelected validation NLL {:.6f}; test NLL {:.6f}; test accuracy {:.6f}.\n",
      fit_x.size(0), p.count(), optimizer.iterations(), best, test_nll, accuracy);
}
```
// result_begin: markdown
512 fitted rows; 128 validation rows; 128 official-test rows; 105866 parameters; 96 Adam steps.

Selected validation NLL 0.634436; test NLL 0.458136; test accuracy 0.843750.
\image(figures/cnn_mnist_training.svg)
// result_end
\caption(Training and validation losses come from the visible minibatch loop; the official test subset is evaluated only after checkpoint selection.)
\alttext(Training and validation losses come from the visible minibatch loop; the official test subset is evaluated only after checkpoint selection.)


> Conclusion

The architecture and parameter count are checked before fitting. The executed report
exposes every Adam update and evaluates the selected checkpoint on untouched original-test
rows. The small, three-epoch result is a reproducible demonstration, not a full MNIST score.

> References

- [LeCun et al. (1998), Gradient-Based Learning Applied to Document Recognition](https://doi.org/10.1109/5.726791).
- [MNIST dataset](https://yann.lecun.org/exdb/mnist/).
