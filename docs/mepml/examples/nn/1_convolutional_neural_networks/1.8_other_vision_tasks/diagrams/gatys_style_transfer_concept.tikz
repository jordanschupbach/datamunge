\documentclass[tikz,border=10pt]{standalone}
\usetikzlibrary{arrows.meta}
\begin{document}
\begin{tikzpicture}[>=Stealth,font=\sffamily\large,box/.style={draw,rounded corners,align=center,text width=4cm,minimum height=1.8cm,fill=blue!7,inner sep=6pt}]
\node[box] (n0) at (0.0,0) {Content and painting\\Frozen VGG19 features};
\node[box] (n1) at (5.2,0) {Only pixels are leaves\\Visible projected Adam};
\node[box] (n2) at (10.4,0) {Restore best image\\Inspect actual changes};
\draw[->,thick] (n0)--(n1);
\draw[->,thick] (n1)--(n2);
\end{tikzpicture}
