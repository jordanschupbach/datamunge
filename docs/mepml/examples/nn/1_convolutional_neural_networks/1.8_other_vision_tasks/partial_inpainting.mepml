> Complete full and compact mask-propagating graphs

Full has8 encoders/8 decoders,width64..512,32,865,236 learned values in60
tensors and10,880 BN values. Compact retains5 encoders/5 decoders,width
8/16/32/64/64,183,684 learned values in36 tensors and592 BN values.
Encoder kernels7/5/5/3... use stride2/ReLU. Nearest decoders concatenate
both feature and mask skips;BN and LeakyReLU.2 apply except at final linear
RGB. BN is absent from the first encoder. Predictions remain raw/unbounded.
Native tests execute full256px backward and every odd-rectangle compact
feature/mask stage,all learned gradients,and empty/all-known identities.
```{cpp, results="markdown", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

#include <print>
int main() {
  namespace n = dm::nn;
  namespace m = n::models;
  n::set_num_threads(2);
  std::print("| graph | learned values | leaves | BN values | BN leaves | stages "
             "|\n|---|---:|---:|---:|---:|---:|\n");
  for (bool compact : {false, true}) {
    const auto config = compact ? m::PartialConfig::Compact() : m::PartialConfig{};
    const int side = compact ? 33 : 256, width = compact ? 35 : 256;
    n::ParameterStore p(83), state(84);
    n::NoGradGuard guard;
    const auto out = m::PartialUNet(p, state, n::full({1, side, width, 3}, .4),
                                    n::ones({1, side, width, 3}), config);
    std::print("| {} | {} | {} | {} | {} | {} |\n", compact ? "compact" : "full", p.count(),
               p.size(), state.count(), state.size(), out.stages.size());
    if (!n::all(n::is_finite(out.image)).item<bool>())
      return 1;
    if (compact) {
      std::print("\nCompact execution stages.\n\n| compact stage | H | W | C | binary mask "
                 "|\n|---:|---:|---:|---:|---|\n");
      for (std::size_t i = 0; i < out.stages.size(); ++i)
        std::print(
            "| {} | {} | {} | {} | {} |\n", i + 1, out.stages[i].size(1),
            out.stages[i].size(2), out.stages[i].size(3),
            n::all(n::logical_or(n::equal(out.masks[i], 0.), n::equal(out.masks[i], 1.)))
                .item<bool>());
    }
  }
}
```
