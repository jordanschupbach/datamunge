> Mask,renormalize and update support at every convolution

A partial convolution multiplies features by a detached multichannel mask,
convolves the masked values,and rescales by kernel_area*Cin/valid_count.
Add bias only where valid_count>0;an entirely unsupported window returns0
and mask0. TensorFlow SAME stride alignment is explicit in this source.
Masks are computational support,not probabilities or learned targets.
The signed fixture exposes counts,renormalized values and input derivatives.
```{cpp, results="markdown", file="figures/partial_inpainting_renormalize.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

#include <print>
int main() {
  namespace n = dm::nn;
  namespace m = n::models;
  const auto x = n::arange(-12, 13).reshape({1, 5, 5, 1}).requires_grad_(),
             axis = n::arange(0, 5), yy = axis.reshape({1, 5, 1, 1}),
             xx = axis.reshape({1, 1, 5, 1}),
             mask = n::logical_not(
                        n::logical_and(n::greater_equal(yy, 1.), n::greater_equal(xx, 1.)))
                        .to(n::DType::Float32);
  const auto result =
                 m::PartialConv(x, mask, n::ones({3, 3, 1, 1}), n::full({1}, 2.), 1, 1, 3);
  const auto g = n::grad(n::sum(result.value), {x})[0];
  std::print("Entirely unsupported windows:{};masked input derivatives max {:.3g};every "
             "derivative finite:{}\n",
             n::count_nonzero(n::equal(result.mask, 0.)).item<std::int64_t>(),
             n::max(n::abs(g) * (1. - mask)).item(), n::all(n::is_finite(g)).item<bool>());
  auto a = n::plot_tensor_map(n::reverse(result.count.reshape({5, 5}), {0}), 0, 9),
       b = n::plot_tensor_map(n::reverse(result.value.reshape({5, 5}), {0}), -110, 10);
  a.title("True multichannel support count")
      .x_label("output column")
      .y_label("output row0 at bottom");
  b.title("Renormalized signed output")
      .x_label("output column")
      .y_label("output row0 at bottom");
  auto layout = dm::graphics::RLayout::create(1, 2);
  layout.add(a).add(b).size(1100, 500).fit_panels().save_svg(
      "build/partial_inpainting_renormalize.svg");
}
```
