> Every full-objective Adam update is visible

Warm all36 learned and16 BN tensors before Adam(.0002). Cache three
truth VGG pool targets with no graph. Each update computes raw U-Net RGB,
observed-preserving composite,raw/composite frozen VGG features,and all seven
objective components. Train all32 images in16 two-image batches per epoch,
three epochs/48 updates. BN updates only during training. Validation uses
moving statistics and the same complete objective. Save parameters and BN
state together as two files for the same selected epoch.

A separate restored predictor receives masked RGB and validity only. It
contains no VGG,truth or optimizer. Test checkpoint parity,repeatability,
immutable learned/BN values,single/batch agreement and independence from
arbitrary finite hidden fill. Composite output preserves every known RGB
exactly. Score all16 held-out images with original masks,raw and metric-only
clipped hole PSNR,full-image PSNR and the observed-mean reference. Distinguish
mean per-image PSNR from PSNR of pooled MSE,which can be negative.
```{cpp, results="markdown", file="figures/partial_inpainting_training.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

#include <print>
int main() {
  namespace n = dm::nn;
  namespace m = n::models;
  n::set_num_threads(2);

  std::filesystem::path cache;
  if (const auto *p = std::getenv("DATAMUNGE_DATA_DIR"))
    cache = p;
  else if (const auto *p = std::getenv("XDG_CACHE_HOME"))
    cache = std::filesystem::path(p) / "datamunge/datasets";
  else
    cache = std::filesystem::path(std::getenv("HOME")) / ".cache/datamunge/datasets";
  dm::datasets::fetch("cifar10", (cache / "cifar10").string());

  std::filesystem::path assets = cache / "style_transfer";
  if (const auto *p = std::getenv("DATAMUNGE_STYLE_DIR"))
    assets = p;
  else
    dm::datasets::prepare_example_data("style", assets.string());

  const auto original_train =
                 n::data::LoadCifar({cache / "cifar10/data_batch_1.bin"}, n::data::Cifar::k10),
             original_test =
                 n::data::LoadCifar({cache / "cifar10/test_batch.bin"}, n::data::Cifar::k10);
  std::vector<std::size_t> fit_rows, val_rows, test_rows;
  for (int i = 0; i < 32; ++i)
    fit_rows.push_back(i);
  for (int i = 32; i < 40; ++i)
    val_rows.push_back(i);
  for (int i = 192; i < 208; ++i)
    test_rows.push_back(i);
  const auto fitting = m::PartialPairs(original_train.images, fit_rows, 107),
             validation = m::PartialPairs(original_train.images, val_rows, 109),
             testing = m::PartialPairs(original_test.images, test_rows, 113);

  const auto weights = m::LoadTensorMap((assets / "vgg16.npz").string());
  m::FrozenVgg16 vgg(weights);
  auto cache_features = [&](const m::PartialData &d) {
    n::NoGradGuard guard;
    std::array<std::vector<n::Tensor>, 3> parts;
    for (std::int64_t i = 0; i < d.truth.size(0); i += 2) {
      const auto f = m::PartialVgg(vgg, n::slice_axis(d.truth, 0, i, i + 2));
      for (int j = 0; j < 3; ++j)
        parts[j].push_back(f[j]);
    }
    return m::PartialFeatures{n::concat(parts[0], 0), n::concat(parts[1], 0),
                              n::concat(parts[2], 0)};
  };
  const auto fit_features = cache_features(fitting), val_features = cache_features(validation);
  std::array<n::Tensor, 3> cached_fit, cached_val;
  for (int i = 0; i < 3; ++i) {
    cached_fit[i] = fit_features[i].clone();
    cached_val[i] = val_features[i].clone();
  }
  n::ParameterStore p(83), state(84);
  const auto config = m::PartialConfig::Compact();
  {
    n::NoGradGuard guard;
    m::PartialUNet(p, state, n::zeros({1, 32, 32, 3}), n::ones({1, 32, 32, 3}), config);
  }
  n::OptimizerConfig options;
  options.kind = n::OptimizerKind::Adam;
  n::Optimizer adam(p, .0002, options);
  auto objectives = [&](const m::PartialData &batch, const m::PartialFeatures &target,
                        bool training, bool update) {
    const auto raw =
                   m::PartialUNet(p, state, batch.input, batch.mask, config, training, update)
                       .image,
               composite = m::PartialComposite(batch.input, raw, batch.mask);
    const auto all = m::PartialVgg(vgg, n::concat({raw, composite}, 0));
    m::PartialFeatures rf, cf;
    for (int i = 0; i < 3; ++i) {
      rf[i] = n::slice_axis(all[i], 0, 0, raw.size(0));
      cf[i] = n::slice_axis(all[i], 0, raw.size(0), 2 * raw.size(0));
    }
    return m::PartialObjective(raw, batch.truth, batch.mask, rf, cf, target);
  };
  auto batch_features = [&](const m::PartialFeatures &f,
                            const std::vector<std::size_t> &rows) {
    return m::PartialFeatures{m::InpaintBatch(f[0], rows), m::InpaintBatch(f[1], rows),
                              m::InpaintBatch(f[2], rows)};
  };
  auto validation_loss = [&] {
    n::NoGradGuard guard;
    auto total = n::full({}, 0., n::DType::Float64);
    for (int i = 0; i < 8; i += 2) {
      const std::vector<std::size_t> rows = {std::size_t(i), std::size_t(i + 1)};
      total = total + objectives(m::PartialBatch(validation, rows),
                                 batch_features(val_features, rows), false, false)[0]
                              .to(n::DType::Float64) *
                          2.;
    }
    return (total / 8.).item();
  };
  const auto probe = m::PartialBatch(fitting, {0, 1});
  const auto probe_features = batch_features(fit_features, {0, 1});
  double initial = 0;
  {
    n::NoGradGuard guard;
    initial = objectives(probe, probe_features, true, false)[0].item();
  }
  std::filesystem::create_directories("build");
  std::filesystem::create_directories("figures");
  n::BatchOrder order(32, 2, 127);
  std::vector<double> epochs, training, valid;
  std::array<std::vector<double>, 6> components;
  double best = INFINITY;
  int selected = 0, updates = 0;
  std::print(
      "183684 learned values/36 tensors,592 BN values/16 tensors;all warm before "
      "Adam(.0002).\n| epoch | total | valid | hole | perceptual | style raw | style "
      "composite | TV | validation |\n|---:|---:|---:|---:|---:|---:|---:|---:|---:|\n");
  for (int epoch = 1; epoch <= 3; ++epoch) {
    order.begin_epoch();
    auto sums = n::zeros({7}, n::DType::Float64);
    int seen = 0;
    for (auto ids = order.next(); !ids.empty(); ids = order.next()) {
      const std::vector<std::size_t> rows(ids.begin(), ids.end());
      const auto losses = objectives(m::PartialBatch(fitting, rows),
                                     batch_features(fit_features, rows), true, true);
      std::vector<n::Tensor> terms(losses.begin(), losses.end());
      const auto values = n::stack(terms, 0);
      if (!n::all(n::is_finite(values)).item<bool>())
        return 1;
      sums = sums + values.detach().to(n::DType::Float64) * double(rows.size());
      seen += rows.size();
      adam.step(n::grad(losses[0], p.parameters()));
      ++updates;
    }
    if (seen != 32)
      return 1;
    const auto mean = sums / 32.;
    const double value = validation_loss();
    epochs.push_back(epoch);
    training.push_back(n::select(mean, 0, 0).item());
    valid.push_back(value);
    for (int j = 0; j < 6; ++j)
      components[j].push_back(n::select(mean, 0, j + 1).item());
    if (value < best) {
      best = value;
      selected = epoch;
      p.save("build/partial_inpainting_best_parameters.npz");
      state.save("build/partial_inpainting_best_bn.npz");
    }
    std::print(
        "| {} | {:.6f} | {:.6f} | {:.6f} | {:.6f} | {:.6f} | {:.6f} | {:.6f} | {:.6f} |\n",
        epoch, training.back(), components[0].back(), components[1].back(),
        components[2].back(), components[3].back(), components[4].back(), components[5].back(),
        value);
  }
  p.load("build/partial_inpainting_best_parameters.npz");
  state.load("build/partial_inpainting_best_bn.npz");
  double learned = 0;
  {
    n::NoGradGuard guard;
    learned = objectives(probe, probe_features, true, false)[0].item();
  }
  if (std::abs(validation_loss() - best) > 1e-5 || learned >= initial ||
      training.back() >= training.front() || updates != 48)
    return 1;
  n::ParameterStore deployed(991), moving(997);
  {
    n::NoGradGuard guard;
    m::PartialUNet(deployed, moving, n::zeros({1, 32, 32, 3}), n::ones({1, 32, 32, 3}),
                   config);
  }
  deployed.load("build/partial_inpainting_best_parameters.npz");
  moving.load("build/partial_inpainting_best_bn.npz");
  std::vector<n::Tensor> snapshots;
  for (const auto &v : deployed.parameters())
    snapshots.push_back(v.clone());
  for (const auto &v : moving.parameters())
    snapshots.push_back(v.clone());
  auto predict = [&](n::ParameterStore &store, n::ParameterStore &statistics,
                     const n::Tensor &observed, const n::Tensor &mask) {
    n::NoGradGuard guard;
    std::vector<n::Tensor> composite, raw;
    for (std::int64_t i = 0; i < observed.size(0); i += 2) {
      const auto x = n::slice_axis(observed, 0, i, std::min(i + 2, observed.size(0))),
                 masks = n::slice_axis(mask, 0, i, std::min(i + 2, mask.size(0)));
      const auto out = m::PartialUNet(store, statistics, x, masks, config, false, false).image;
      raw.push_back(out);
      composite.push_back(m::PartialComposite(x, out, masks));
    }
    return std::pair{n::concat(composite, 0), n::concat(raw, 0)};
  };
  const auto prediction = predict(deployed, moving, testing.input, testing.mask),
             reference = predict(p, state, testing.input, testing.mask),
             repeat = predict(deployed, moving, testing.input, testing.mask),
             single = predict(deployed, moving, n::slice_axis(testing.input, 0, 3, 4),
                              n::slice_axis(testing.mask, 0, 3, 4));
  const double parity = n::max(n::abs(prediction.first - reference.first)).item(),
               batch_error =
                   n::max(n::abs(single.first - n::slice_axis(prediction.first, 0, 3, 4)))
                       .item();
  if (parity > 1e-6 || batch_error > 1e-5 ||
      !n::all(n::equal(prediction.first, repeat.first)).item<bool>())
    return 1;
  const auto observed = n::slice_axis(testing.input, 0, 0, 2),
             mask = n::slice_axis(testing.mask, 0, 0, 2),
             positions = n::arange(0, observed.numel(), 1, n::DType::Float64)
                             .reshape(observed.shape()),
             fill = (1000. + positions - 7. * n::floor(positions / 7.)).to(n::DType::Float32),
             changed = n::where(n::greater(mask, 0.), observed, fill),
             invariant = predict(deployed, moving, changed, mask).first;
  const double hidden_error =
      n::max(n::abs(invariant - n::slice_axis(prediction.first, 0, 0, 2))).item();
  if (hidden_error != 0)
    return 1;
  std::size_t at = 0;
  for (const auto &v : deployed.parameters())
    if (!n::all(n::equal(v, snapshots[at++])).item<bool>())
      return 1;
  for (const auto &v : moving.parameters())
    if (!n::all(n::equal(v, snapshots[at++])).item<bool>())
      return 1;
  vgg.CheckFrozen();
  for (int i = 0; i < 3; ++i)
    if (!n::all(n::equal(cached_fit[i], fit_features[i])).item<bool>() ||
        !n::all(n::equal(cached_val[i], val_features[i])).item<bool>())
      return 1;
  const auto mean = m::PartialMean(testing);
  const auto raw = m::ScoreTensorPartial(testing, prediction.first),
             clipped = m::ScoreTensorPartial(testing, prediction.first, true),
             baseline = m::ScoreTensorPartial(testing, mean);
  if (raw.known_error.item() != 0)
    return 1;
  std::print("{} visible updates;selected epoch{},restored validation {:.6f};fixed fit total "
             "{:.6f}->{:.6f}.\nImage+mask-only deployment:checkpoint parity "
             "{:.3g},single/batch max {:.9g},finite hidden-fill difference {:.3g};repeat "
             "exact;all36 learned/16 BN tensors and all26 VGG tensors immutable,cached "
             "targets unchanged.\n| estimate | hole MSE | mean hole PSNR dB | pooled hole "
             "PSNR dB | full PSNR dB | known max error |\n|---|---:|---:|---:|---:|---:|\n",
             updates, selected, best, initial, learned, parity, batch_error, hidden_error);
  for (const auto &item : std::vector<std::pair<std::string, m::TensorInpaintMetrics>>{
           {"raw composite", raw}, {"metric-clipped", clipped}, {"visible mean", baseline}})
    std::print("| {} | {:.6f} | {:.6f} | {:.6f} | {:.6f} | {:.6f} |\n", item.first,
               item.second.hole_mse.item(), item.second.hole_psnr.item(),
               m::InpaintPSNR(item.second.hole_mse).item(), item.second.full_psnr.item(),
               item.second.known_error.item());
  n::save_image_grid(m::PartialPreviewTiles(testing, prediction.first, mean),
                     "figures/partial_inpainting_predictions.png", 2, 0, 1, 2, 0, 3);
  n::save_npz("build/partial_inpainting_outputs.npz", {{"truth", testing.truth},
                                                       {"observed", testing.input},
                                                       {"mask", testing.mask},
                                                       {"raw", prediction.second},
                                                       {"composite", prediction.first},
                                                       {"visible_mean", mean}});
  auto a = dm::graphics::RPlot::create(), b = dm::graphics::RPlot::create();
  a.bars({0., 1., 2.},
         {raw.hole_psnr.item(), clipped.hole_psnr.item(), baseline.hole_psnr.item()},
         "mean image PSNR", {37, 99, 235})
      .title("All16 held-out hole reconstructions")
      .x_label("0 raw,1 clipped,2 visible mean")
      .y_label("mean per-image hole PSNR in dB")
      .y_limits(-5, 20);
  b.bars({0., 1., 2.},
         {m::InpaintPSNR(raw.hole_mse).item(), m::InpaintPSNR(clipped.hole_mse).item(),
          m::InpaintPSNR(baseline.hole_mse).item()},
         "pooled hole PSNR", {22, 163, 74})
      .title("Pooled MSE gives different PSNR")
      .x_label("0 raw,1 clipped,2 visible mean")
      .y_label("PSNR of pooled hole MSE in dB")
      .y_limits(-5, 20);
  auto metrics = dm::graphics::RLayout::create(1, 2);
  metrics.add(a).add(b).size(1100, 500).fit_panels().save_svg(
      "build/partial_inpainting_metrics.svg");
  std::filesystem::copy_file("build/partial_inpainting_metrics.svg",
                             "figures/partial_inpainting_metrics.svg",
                             std::filesystem::copy_options::overwrite_existing);
  a = dm::graphics::RPlot::create();
  b = dm::graphics::RPlot::create();
  a.lines(epochs, training, "fitting", {37, 99, 235})
      .lines(epochs, valid, "validation", {220, 38, 38})
      .title("Forty-eight explicit Adam updates")
      .x_label("epoch")
      .y_label("full source objective")
      .y_limits(0, 1500);
  const std::array<double, 6> coefficients = {1, 6, .05, 120, 120, .1};
  const std::array<std::string, 6> names = {"valid",         "6 hole",         ".05 percept",
                                            "120 raw style", "120 comp style", ".1 TV"};
  const std::array<dm::graphics::RGB, 6> colors = {{{37, 99, 235},
                                                    {220, 38, 38},
                                                    {22, 163, 74},
                                                    {147, 51, 234},
                                                    {234, 88, 12},
                                                    {8, 145, 178}}};
  for (int j = 0; j < 6; ++j) {
    const auto weighted = n::from_vector(components[j], {3}) * coefficients[j];
    b.lines(epochs, weighted.to_vector<double>(), names[j], colors[j]);
  }
  b.title("Every weighted fitting component")
      .x_label("epoch")
      .y_label("contribution to fitting total")
      .y_limits(0, 350);
  auto curves = dm::graphics::RLayout::create(1, 2);
  curves.add(a).add(b).size(1100, 550).fit_panels().save_svg(
      "build/partial_inpainting_training.svg");
}
```
