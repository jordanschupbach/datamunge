> Actual CIFAR images with reproducible tensor irregular masks

Fitting uses original training rows0..31,validation32..39,and test uses
original test rows192..207. Mask seeds107/109/113 keep splits distinct.
For each source row,MT19937(seed+65537*row) draws one rectangle and two
swept-disk stroke geometries. Tensor coordinates compute every pixel’s
membership,union and coverage;retry until123..563 of1024 pixels are holes.
No host pixel loops or image values determine mask geometry. Reordering
source rows reproduces their masks exactly. Native literal original geometry
oracles compare every mask pixel across multiple seeds and row orders.

The reference preserves known pixels and fills holes with that image’s
observed mean RGB. It is a deterministic statistic of the current observation,
not a model fitted on training labels. All sums/counts use tensors and ignore
hidden values before aggregation;the true unobserved RGB never enters it.
Genuine VGG16 weights and independent Keras pool/loss/gradient fixtures reuse
dm::datasets::prepare_example_data("style") and the shared pinned style asset cache.
```{cpp, results="markdown", file="figures/partial_inpainting_data.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

#include <print>
int main() {
  namespace n = dm::nn;
  namespace m = n::models;
  n::set_num_threads(2);

  std::filesystem::path cache;
  if (const auto *p = std::getenv("DATAMUNGE_DATA_DIR"))
    cache = p;
  else if (const auto *p = std::getenv("XDG_CACHE_HOME"))
    cache = std::filesystem::path(p) / "datamunge/datasets";
  else
    cache = std::filesystem::path(std::getenv("HOME")) / ".cache/datamunge/datasets";
  dm::datasets::fetch("cifar10", (cache / "cifar10").string());

  std::filesystem::path assets = cache / "style_transfer";
  if (const auto *p = std::getenv("DATAMUNGE_STYLE_DIR"))
    assets = p;
  else
    dm::datasets::prepare_example_data("style", assets.string());

  const auto original_train =
                 n::data::LoadCifar({cache / "cifar10/data_batch_1.bin"}, n::data::Cifar::k10),
             original_test =
                 n::data::LoadCifar({cache / "cifar10/test_batch.bin"}, n::data::Cifar::k10);
  std::vector<std::size_t> fit_rows, val_rows, test_rows;
  for (int i = 0; i < 32; ++i)
    fit_rows.push_back(i);
  for (int i = 32; i < 40; ++i)
    val_rows.push_back(i);
  for (int i = 192; i < 208; ++i)
    test_rows.push_back(i);
  const auto fitting = m::PartialPairs(original_train.images, fit_rows, 107),
             validation = m::PartialPairs(original_train.images, val_rows, 109),
             testing = m::PartialPairs(original_test.images, test_rows, 113);

  std::filesystem::create_directories("figures");
  const auto first = m::PartialBatch(fitting, {0, 1, 2, 3, 4, 5, 6, 7});
  const auto mean = m::PartialMean(first);
  n::save_image_grid(m::PartialPreviewTiles(first, mean, mean),
                     "figures/partial_inpainting_inputs.png", 2, 0, 1, 2, 0, 3);
  auto a = dm::graphics::RPlot::create(), b = dm::graphics::RPlot::create();
  const std::vector<std::pair<std::string, m::PartialData>> data = {
      {"fitting", fitting}, {"validation", validation}, {"test", testing}};
  const std::array<dm::graphics::RGB, 3> colors = {
      {{37, 99, 235}, {220, 38, 38}, {22, 163, 74}}};
  int offset = 0, index = 0;
  std::print("| split | original images | mean hole fraction |\n|---|---:|---:|\n");
  for (const auto &item : data) {
    const auto fraction = n::mean(1. - item.second.mask.to(n::DType::Float64), {1, 2, 3});
    a.points(n::arange(offset, offset + fraction.numel()).to_vector<double>(),
             fraction.to_vector<double>(), item.first, colors[index++]);
    offset += fraction.numel();
    std::print("| {} | {} | {:.6f} |\n", item.first, fraction.numel(),
               n::mean(fraction).item());
  }
  a.title("Actual irregular-hole coverage")
      .x_label("prepared split image order")
      .y_label("true missing pixel fraction")
      .y_limits(0, .8);
  const auto baseline = m::PartialMean(testing);
  const auto score = m::ScoreTensorPartial(testing, baseline);
  b.bars({0., 1.}, {score.hole_psnr.item(), score.full_psnr.item()}, "observed mean",
         {147, 51, 234})
      .title("Observed-only context reference")
      .x_label("0 hole PSNR,1 full-image PSNR")
      .y_label("mean image PSNR in dB")
      .y_limits(0, 30);
  auto layout = dm::graphics::RLayout::create(1, 2);
  layout.add(a).add(b).size(1100, 500).fit_panels().save_svg(
      "build/partial_inpainting_data.svg");
  std::print("All16 test reference hole MSE {:.6f},mean hole/full PSNR {:.6f}/{:.6f}dB. No "
             "hidden truth used by reference.\n",
             score.hole_mse.item(), score.hole_psnr.item(), score.full_psnr.item());
}
