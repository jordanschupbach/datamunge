> Stable real/fake losses before fitting

For a raw discriminator score z,real and fake losses are
\(\ell_1(z)=\operatorname{softplus}(-z)\) and
\(\ell_0(z)=\operatorname{softplus}(z)\). Their derivatives are
\(\sigma(z)-1\) and \(\sigma(z)\). At zero these are -.5 and .5;
the stable softplus implementation also handles large signed logits.
```{cpp, results="markdown", file="figures/context_encoder_bce.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

#include <print>
int main() {
  namespace n = dm::nn;
  namespace m = n::models;
  const auto z = n::arange(-8., 8.01, .1, n::DType::Float64).requires_grad_();
  const auto real = m::ContextBCE(z, true), fake = m::ContextBCE(z, false);
  const auto dr = n::grad(real, {z}, {true})[0] * double(z.numel()),
             df = n::grad(fake, {z})[0] * double(z.numel());
  auto a = dm::graphics::RPlot::create(), b = dm::graphics::RPlot::create();
  a.lines(z.to_vector<double>(), n::softplus(-z).to_vector<double>(), "real", {37, 99, 235})
      .lines(z.to_vector<double>(), n::softplus(z).to_vector<double>(), "fake", {220, 38, 38})
      .title("Stable real and fake logit losses")
      .x_label("logit z")
      .y_label("per-logit BCE")
      .y_limits(0, 9);
  b.lines(z.to_vector<double>(), dr.to_vector<double>(), "real derivative", {37, 99, 235})
      .lines(z.to_vector<double>(), df.to_vector<double>(), "fake derivative", {220, 38, 38})
      .title("Every logit keeps its derivative")
      .x_label("logit z")
      .y_label("unaveraged derivative")
      .y_limits(-1.2, 1.4);
  std::filesystem::create_directories("build");
  auto layout = dm::graphics::RLayout::create(1, 2);
  layout.add(a).add(b).size(1100, 480).fit_panels().save_svg("build/context_encoder_bce.svg");
  const auto extreme = n::tensor({-80., 0., 80.});
  std::print("Extreme real/fake mean BCE: {:.6f}/{:.6f};zero-logit derivatives -.5/+.5.\n",
             m::ContextBCE(extreme, true).item(), m::ContextBCE(extreme, false).item());
}
```
