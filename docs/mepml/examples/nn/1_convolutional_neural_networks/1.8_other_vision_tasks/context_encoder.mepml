> Why score only the missing region

A center16x16 hole occupies one quarter of a32x32 image. Preserving the
remaining three quarters means full-image MSE is one fourth of hole MSE;
full-image PSNR is therefore inflated by10log10(4)=6.0206dB.
This protocol reports the **mean of per-image PSNR**,not PSNR computed
from aggregate MSE. Two images with constant hole errors .1 and .2 have
mean hole MSE .025 and mean hole PSNR16.9897dB. Perfect-image PSNR is infinite.
```{cpp, results="markdown", file="figures/context_encoder_hole.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

#include <print>
int main() {
  namespace n = dm::nn;
  namespace m = n::models;
  const auto data = m::ContextPairs(n::zeros({2, 32, 32, 3}, n::DType::Int32), {0, 1});
  const auto errors = n::tensor({.1, .2}).reshape({2, 1, 1, 1});
  const auto output = n::ones_like(data.truth) * (1. - data.valid) * errors;
  const auto score = m::ScoreTensorInpaint(data, output);
  const auto hole = n::tensor({.01, .04}), full = hole / 4.;
  auto p = dm::graphics::RPlot::create();
  p.bars({-.17, .83}, m::InpaintPSNR(hole).to_vector<double>(), "hole PSNR", {37, 99, 235}, .3)
      .bars({.17, 1.17}, m::InpaintPSNR(full).to_vector<double>(), "full PSNR", {220, 38, 38},
            .3)
      .title("Known pixels inflate full-image PSNR")
      .x_label("two images: errors .1 and .2")
      .y_label("PSNR in dB")
      .y_limits(0, 32)
      .size(900, 480);
  std::filesystem::create_directories("build");
  p.save_svg("build/context_encoder_hole.svg");
  std::print("Mean hole MSE {:.6f};mean hole/full PSNR {:.6f}/{:.6f}dB;known error {:.3g}.\n",
             score.hole_mse.item(), score.hole_psnr.item(), score.full_psnr.item(),
             score.known_error.item());
  if (std::abs(score.hole_mse.item() - .025) > 1e-8 ||
      std::abs(score.full_psnr.item() - score.hole_psnr.item() - 10 * std::log10(4.)) > 1e-10)
    return 1;
}
```
