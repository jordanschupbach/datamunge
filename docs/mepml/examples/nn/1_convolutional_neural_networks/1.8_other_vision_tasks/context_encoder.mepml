> Visible alternating Adam and generator-only deployment

For a batch of real target patches and detached generator patches,D minimizes
\(L_D=\operatorname{mean}\ell_1(D(x_{real}))+\operatorname{mean}\ell_0(D(G(x_{masked})))\).
The code concatenates both halves and multiplies the combined mean by2.
G minimizes \(L_G=.999\operatorname{MSE}(G(x),x_{patch})+.001\operatorname{mean}\ell_1(D(G(x)))\).
The source uses Adam G.002/D.0002,beta1.5. Only the active phase’s running BN
statistics update. During G fitting,D is evaluated with stored moments while
its patch derivative remains active;the optimizer receives only G leaves.

Both models are warmed before optimizer creation. Each epoch visits all128
fitting rows once in8-image batches. Validation patch MSE selects a paired
G/BN checkpoint;the adversary is discarded for deployment. The inference
program restores independent G stores,checks frozen tensors and single/batch
agreement,and compares all32 held-out images with the visible-mean reference.
```{cpp, results="markdown", file="figures/context_encoder_training.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

#include <numeric>
#include <print>
int main() {
  namespace n = dm::nn;
  namespace m = n::models;
  n::set_num_threads(2);

  std::filesystem::path cache;
  if (const auto *p = std::getenv("DATAMUNGE_DATA_DIR"))
    cache = p;
  else if (const auto *p = std::getenv("XDG_CACHE_HOME"))
    cache = std::filesystem::path(p) / "datamunge/datasets";
  else
    cache = std::filesystem::path(std::getenv("HOME")) / ".cache/datamunge/datasets";
  dm::datasets::fetch("cifar10", (cache / "cifar10").string());

  const auto raw =
      n::data::LoadCifar({cache / "cifar10/data_batch_1.bin"}, n::data::Cifar::k10);
  const auto test_raw =
      n::data::LoadCifar({cache / "cifar10/test_batch.bin"}, n::data::Cifar::k10);
  std::vector<std::size_t> fit_ids(128), val_ids(32), test_ids(32);
  std::iota(fit_ids.begin(), fit_ids.end(), 0);
  std::iota(val_ids.begin(), val_ids.end(), 128);
  std::iota(test_ids.begin(), test_ids.end(), 160);
  const auto fit = m::ContextPairs(raw.images, fit_ids),
             validation = m::ContextPairs(raw.images, val_ids),
             test = m::ContextPairs(test_raw.images, test_ids);

  const auto cfg = m::ContextConfig::Compact();
  n::ParameterStore g(71), gs(72), d(73), ds(74);
  {
    n::NoGradGuard guard;
    const auto warm = m::ContextEncoder(g, gs, n::zeros({1, 32, 32, 3}), cfg);
    m::ContextDiscriminator(d, ds, warm.patch, cfg);
  }
  n::OptimizerConfig opt;
  opt.kind = n::OptimizerKind::Adam;
  opt.beta1 = .5;
  n::Optimizer g_adam(g, .002, opt), d_adam(d, .0002, opt);
  auto snapshot = [](const n::ParameterStore &p, const n::ParameterStore &state) {
    std::vector<n::Tensor> out;
    for (const auto *store : {&p, &state})
      for (const auto &v : store->parameters())
        out.push_back(v.clone());
    return out;
  };
  auto same = [&](const std::vector<n::Tensor> &before, const n::ParameterStore &p,
                  const n::ParameterStore &state) {
    const auto after = snapshot(p, state);
    for (std::size_t i = 0; i < before.size(); ++i)
      if (!n::all(n::equal(before[i], after[i])).item<bool>())
        return false;
    return true;
  };
  auto predict = [&](n::ParameterStore &p, n::ParameterStore &state, const n::Tensor &masked) {
    n::NoGradGuard guard;
    std::vector<n::Tensor> parts;
    for (std::int64_t first = 0; first < masked.size(0); first += 8) {
      const auto input = n::slice_axis(masked, 0, first, std::min(first + 8, masked.size(0)));
      const auto patch = m::ContextEncoder(p, state, input, cfg).patch;
      parts.push_back(.5 * (m::ContextComposite(input, patch, m::ContextMask()) + 1.));
    }
    return n::concat(parts, 0);
  };
  auto validation_loss = [&]() {
    n::NoGradGuard guard;
    return m::ContextReconstruction(m::ContextEncoder(g, gs, validation.masked, cfg).patch,
                                    validation.patch)
        .item();
  };
  const auto probe = m::InpaintBatch(fit, {0, 1, 2, 3, 4, 5, 6, 7});
  double initial;
  {
    n::NoGradGuard guard;
    initial = m::ContextReconstruction(
                  m::ContextEncoder(g, gs, probe.masked, cfg, true, false).patch, probe.patch)
                  .item();
  }
  n::BatchOrder order(128, 8, 79);
  std::vector<double> epochs, rec, adv, dloss, val;
  double best = INFINITY;
  int selected = 0, steps = 0;
  bool isolated = false;
  std::filesystem::create_directories("build");
  std::filesystem::create_directories("figures");
  std::print("G/D learned {}/{};BN {}/{};warm leaves {}/{}.\n| epoch | patch MSE | G "
             "adversarial | D objective | validation MSE |\n|---:|---:|---:|---:|---:|\n",
             g.count(), d.count(), gs.count(), ds.count(), g.size(), d.size());
  for (int epoch = 1; epoch <= 3; ++epoch) {
    order.begin_epoch();
    double rsum = 0, asum = 0, dsum = 0;
    int batches = 0;
    for (auto ids = order.next(); !ids.empty(); ids = order.next()) {
      const auto batch =
          m::InpaintBatch(fit, std::vector<std::size_t>(ids.begin(), ids.end()));
      const auto g_before = snapshot(g, gs);
      n::Tensor fake;
      {
        n::NoGradGuard guard;
        fake = m::ContextEncoder(g, gs, batch.masked, cfg, true, false).patch;
      }
      const auto disc =
          m::ContextDiscriminator(d, ds, n::concat({batch.patch, fake}, 0), cfg, true, true);
      const auto real = n::slice_axis(disc.logits, 0, 0, 8),
                 generated = n::slice_axis(disc.logits, 0, 8, 16);
      const auto ld = m::ContextBCE(real, true) + m::ContextBCE(generated, false);
      dsum += ld.item();
      d_adam.minimize(ld);
      if (!same(g_before, g, gs))
        return 1;
      const auto d_before = snapshot(d, ds);
      const auto output = m::ContextEncoder(g, gs, batch.masked, cfg, true, true);
      const auto fool = m::ContextDiscriminator(d, ds, output.patch, cfg, false, false);
      const auto reconstruction = m::ContextReconstruction(output.patch, batch.patch),
                 adversarial = m::ContextBCE(fool.logits, true);
      const auto lg = .999 * reconstruction + .001 * adversarial;
      rsum += reconstruction.item();
      asum += adversarial.item();
      g_adam.minimize(lg);
      if (!same(d_before, d, ds) || same(g_before, g, gs))
        return 1;
      isolated = true;
      ++steps;
      ++batches;
    }
    epochs.push_back(epoch);
    rec.push_back(rsum / batches);
    adv.push_back(asum / batches);
    dloss.push_back(dsum / batches);
    val.push_back(validation_loss());
    if (val.back() < best) {
      best = val.back();
      selected = epoch;
      g.save("build/context_encoder_g.npz");
      gs.save("build/context_encoder_bn.npz");
    }
    std::print("| {} | {:.6f} | {:.6f} | {:.6f} | {:.6f} |\n", epoch, rec.back(), adv.back(),
               dloss.back(), val.back());
  }
  g.load("build/context_encoder_g.npz");
  gs.load("build/context_encoder_bn.npz");
  if (std::abs(validation_loss() - best) > 1e-7 || !isolated)
    return 1;
  double learned;
  {
    n::NoGradGuard guard;
    learned = m::ContextReconstruction(
                  m::ContextEncoder(g, gs, probe.masked, cfg, true, false).patch, probe.patch)
                  .item();
  }
  n::ParameterStore deployed(991), moving(997);
  {
    n::NoGradGuard guard;
    m::ContextEncoder(deployed, moving, n::zeros({1, 32, 32, 3}), cfg);
  }
  deployed.load("build/context_encoder_g.npz");
  moving.load("build/context_encoder_bn.npz");
  const auto frozen = snapshot(deployed, moving);
  const auto output = predict(deployed, moving, test.masked),
             reference = predict(g, gs, test.masked),
             repeat = predict(deployed, moving, test.masked), mean = m::ContextFillMean(test);
  const double parity = n::max(n::abs(output - reference)).item();
  if (parity > 1e-7 || !n::all(n::equal(output, repeat)).item<bool>() ||
      !same(frozen, deployed, moving))
    return 1;
  const auto single =
      predict(deployed, moving, n::select(test.masked, 0, 3).reshape({1, 32, 32, 3}));
  if (n::max(n::abs(single - n::select(output, 0, 3))).item() > 1e-6)
    return 1;
  const auto score = m::ScoreTensorInpaint(test, output),
             baseline = m::ScoreTensorInpaint(test, mean);
  if (score.known_error.item() > 1e-7 || learned >= initial || rec.back() >= rec.front())
    return 1;
  std::print(
      "{} visible D and G updates each;selected epoch{},restored validation MSE {:.6f};fixed "
      "fitting MSE {:.6f}->{:.6f}.\nAll phase-isolation checks pass;deployment has only G/RGB "
      "input,exact parity {:.3g},immutable G+BN,single/batch agree.\n| model | hole MSE | "
      "mean hole PSNR dB | mean full PSNR dB | known max error |\n|---|---:|---:|---:|---:|\n",
      steps, selected, best, initial, learned, parity);
  for (const auto &item : std::vector<std::pair<std::string, m::TensorInpaintMetrics>>{
           {"learned", score}, {"visible mean", baseline}})
    std::print("| {} | {:.6f} | {:.6f} | {:.6f} | {:.3g} |\n", item.first,
               item.second.hole_mse.item(), item.second.hole_psnr.item(),
               item.second.full_psnr.item(), item.second.known_error.item());
  n::save_image_grid(m::ContextPreviewTiles(test, output, mean),
                     "figures/context_encoder_predictions.png", 2, 0, 1, 0, 0, 3);
  n::save_npz(
      "build/context_encoder_test.npz",
      {{"prediction", output}, {"truth", test.truth}, {"mean", mean}, {"valid", test.valid}});
  auto a = dm::graphics::RPlot::create(), b = dm::graphics::RPlot::create();
  a.bars({0., 1.}, {score.hole_mse.item(), baseline.hole_mse.item()}, "hole MSE",
         {37, 99, 235})
      .title("All32 held-out hole errors")
      .x_label("0 learned,1 visible mean")
      .y_label("unit-range hole MSE")
      .y_limits(0, .075);
  b.bars({0., 1.}, {score.hole_psnr.item(), baseline.hole_psnr.item()}, "hole PSNR",
         {22, 163, 74})
      .title("Visible mean is a strong reference")
      .x_label("0 learned,1 visible mean")
      .y_label("mean per-image PSNR in dB")
      .y_limits(0, 17);
  auto metrics = dm::graphics::RLayout::create(1, 2);
  metrics.add(a).add(b).size(1100, 480).fit_panels().save_svg(
      "build/context_encoder_metrics.svg");
  std::filesystem::copy_file("build/context_encoder_metrics.svg",
                             "figures/context_encoder_metrics.svg",
                             std::filesystem::copy_options::overwrite_existing);
  a = dm::graphics::RPlot::create();
  b = dm::graphics::RPlot::create();
  a.lines(epochs, rec, "fitting MSE", {37, 99, 235})
      .lines(epochs, val, "validation MSE", {220, 38, 38})
      .title("Complete generator reconstruction")
      .x_label("epoch")
      .y_label("patch MSE in[-1,1] scale")
      .y_limits(0, .28);
  b.lines(epochs, adv, "G adversarial", {22, 163, 74})
      .lines(epochs, dloss, "D objective", {147, 51, 234})
      .title("Alternating adversarial objectives")
      .x_label("epoch")
      .y_label("mean BCE;D sums real+fake")
      .y_limits(0, 1.6);
  auto curves = dm::graphics::RLayout::create(1, 2);
  curves.add(a).add(b).size(1100, 480).fit_panels().save_svg(
      "build/context_encoder_training.svg");
}
```
