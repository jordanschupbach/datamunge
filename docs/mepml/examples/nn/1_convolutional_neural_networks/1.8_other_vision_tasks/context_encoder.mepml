> A three-by-three partial-convolution check

This primitive belongs to the separate partial-inpainting model,also checked
by the source context example. A fixed mask removes the center value5 from
values1 through9. With all-one3x3 weights and zero bias,the center window has
8 valid samples and sum40,so its output is40*9/8=45. The upper-left window
has3 valid samples1,2,4,so its output is7*9/3=21. Padding is unobserved.

For support count s and window size K=kernel²*input_channels,
\(y=(W*(x\odot m)K/\max(s,1)+b)\mathbf1_{s>0}\).
The mask/count are detached;empty windows suppress the bias too.
```{cpp, results="markdown", file="figures/context_encoder_partial.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

#include <print>
int main() {
  namespace n = dm::nn;
  namespace m = n::models;
  const auto x = n::arange(1, 10).reshape({1, 3, 3, 1}).requires_grad_();
  const auto mask = n::tensor({1., 1., 1., 1., 0., 1., 1., 1., 1.}, {1, 3, 3, 1});
  const auto result = m::PartialConv(x, mask, n::ones({3, 3, 1, 1}), n::zeros({1}), 1, 1, 3);
  const auto dx = n::grad(n::sum(result.value), {x})[0];
  if (n::select(result.value.reshape({9}), 0, 4).item() != 45. ||
      n::select(dx.reshape({9}), 0, 4).item() != 0.)
    return 1;
  auto a = n::plot_tensor_map(n::reverse(result.count.reshape({3, 3}), {0}), 0, 9),
       b = n::plot_tensor_map(n::reverse(result.value.reshape({3, 3}), {0}), 0, 70);
  a.title("Observed samples per window").x_label("column").y_label("row from bottom");
  b.title("Renormalized convolution").x_label("column").y_label("row from bottom");
  std::filesystem::create_directories("build");
  auto layout = dm::graphics::RLayout::create(1, 2);
  layout.add(a).add(b).size(1050, 500).fit_panels().save_svg(
      "build/context_encoder_partial.svg");
  std::print(
      "Center count/output: {}/{};upper-left output {};hidden center input derivative {}.\n",
      n::select(result.count.reshape({9}), 0, 4).item(),
      n::select(result.value.reshape({9}), 0, 4).item(),
      n::select(result.value.reshape({9}), 0, 0).item(),
      n::select(dx.reshape({9}), 0, 4).item());
}
```
