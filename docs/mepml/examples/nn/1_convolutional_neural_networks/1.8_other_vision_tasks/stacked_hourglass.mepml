> First-maximum decoding and inclusive joint-weighted PCK

Decode each raw heatmap’s first row-major maximum,then map its pixel center
back to the128px input. Ties at32px decode to(1.5,1.5). No sigmoid,confidence
threshold or target coordinates enter decoding. PCK counts an annotated
joint correct when Euclidean distance<=.2*max(original box extent in crop
pixels). All annotated joints have equal weight across images. This is a
teaching box-normalized PCK,not COCO OKS/AP or an MPII benchmark result.
The distance sweep exposes the inclusive boundary without fitting a threshold.
```{cpp, results="markdown", file="figures/stacked_hourglass_pck.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

#include <print>
int main() {
  namespace n = dm::nn;
  namespace m = n::models;
  const auto error = n::arange(0., 10.0001, .05, n::DType::Float64),
             correct = n::less_equal(error, 5.).to(n::DType::Float64),
             normalized = error / 25.;
  m::PoseData d;
  d.joints = n::tensor({0., 0., 1.}, {1, 1, 3});
  d.box_size = n::tensor({25., 20.}, {1, 2});
  const auto boundary = m::ScoreTensorPose(n::tensor({3., 4., -1.}, {1, 1, 3}), d);
  std::print("3/4/5 fixture:PCK {:.6f},NME {:.6f},pixel error {:.6f};confidence -1 does not "
             "gate scoring.\n",
             boundary.pck.item(), boundary.normalized_error.item(), boundary.pixels.item());
  auto a = dm::graphics::RPlot::create(), b = dm::graphics::RPlot::create();
  a.lines(error.to_vector<double>(), normalized.to_vector<double>(), "NME", {37, 99, 235})
      .title("Original-box normalized error")
      .x_label("Euclidean crop-pixel error")
      .y_label("error /25px box side")
      .y_limits(0, .55);
  b.lines(error.to_vector<double>(), correct.to_vector<double>(), "inclusive PCK",
          {220, 38, 38})
      .title("Boundary distance5px is correct")
      .x_label("Euclidean crop-pixel error")
      .y_label("correct at.2*25px")
      .y_limits(-.1, 1.4);
  auto layout = dm::graphics::RLayout::create(1, 2);
  layout.add(a).add(b).size(1100, 500).fit_panels().save_svg(
      "build/stacked_hourglass_pck.svg");
}
