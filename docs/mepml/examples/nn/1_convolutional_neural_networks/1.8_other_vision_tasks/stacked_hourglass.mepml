> Both supervised heads and every Adam update are explicit

Warm all396 learned and192 BN-state tensors before Adam(.001). For each
two-image minibatch,construct detached masked Gaussian targets,run both
stacks once in training mode,and minimize the sum of both head losses.
All12 crops are used each epoch:three epochs give18 visible updates.
Training updates moving BN once per step. Validation uses moving statistics;
the fixed fitting probe uses batch statistics without updating state.
Save learned parameters and BN values at the same selected epoch.

An independently restored predictor receives RGB only and uses moving BN.
Check exact checkpoint/repeat parity,all learned/BN values immutable,
single/batch agreement and a changed output for different observed crops.
Decode the final head without target input. Compare every held-out annotated
joint with the unchanged SGD prior and declared crop-center reference.
These116 annotated joints share four source images;they are not116
independent test photographs. Display all14 actual held-out crops and skeletons.
```{cpp, results="markdown", file="figures/stacked_hourglass_training.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

#include <print>
int main() {
  namespace n = dm::nn;
  namespace m = n::models;
  n::set_num_threads(2);

  std::filesystem::path cache;
  if (const auto *p = std::getenv("DATAMUNGE_DATA_DIR"))
    cache = p;
  else if (const auto *p = std::getenv("XDG_CACHE_HOME"))
    cache = std::filesystem::path(p) / "datamunge/datasets";
  else
    cache = std::filesystem::path(std::getenv("HOME")) / ".cache/datamunge/datasets";

  std::filesystem::path root = cache / "human_pose";
  if (const auto *p = std::getenv("DATAMUNGE_POSE_DIR"))
    root = p;
  else
    dm::datasets::prepare_example_data("pose", root.string());
  const auto split = m::LoadPoseCrops(root);

  const auto config = m::CompactHourglassConfig();
  n::ParameterStore p(173), state(179);
  {
    n::NoGradGuard guard;
    m::StackedHourglass(p, state, n::zeros({1, 128, 128, 3}), config);
  }
  n::OptimizerConfig options;
  options.kind = n::OptimizerKind::Adam;
  n::Optimizer adam(p, .001, options);
  auto objectives = [&](const m::PoseData &data, bool training, bool update) {
    const auto target = m::PoseHeatmaps(data.joints);
    const auto out = m::StackedHourglass(p, state, data.rgb, config, training, update);
    const auto first = m::PoseHeatmapMSE(out.heatmaps[0], target.heatmap, target.mask, 32),
               second = m::PoseHeatmapMSE(out.heatmaps[1], target.heatmap, target.mask, 32);
    return std::array<n::Tensor, 3>{first + second, first, second};
  };
  const auto probe = m::PoseBatch(split.fit, {0, 1});
  auto probe_loss = [&] {
    n::NoGradGuard guard;
    return objectives(probe, true, false)[0].item();
  };
  auto val_loss = [&] {
    n::NoGradGuard guard;
    return objectives(split.validation, false, false)[0].item();
  };
  const double initial = probe_loss();
  n::BatchOrder order(12, 2, 181);
  std::vector<double> epochs, training, validation, first, second;
  double best = INFINITY;
  int selected = 0, updates = 0;
  std::filesystem::create_directories("build");
  std::filesystem::create_directories("figures");
  std::print("110450 learned values/396 tensors,3936 BN values/192 tensors warmed before "
             "Adam(.001).\n| epoch | fitting total | first head | final head | validation "
             "|\n|---:|---:|---:|---:|---:|\n");
  for (int epoch = 1; epoch <= 3; ++epoch) {
    order.begin_epoch();
    auto total = n::zeros({3}, n::DType::Float64);
    int seen = 0;
    for (auto ids = order.next(); !ids.empty(); ids = order.next()) {
      const std::vector<std::size_t> rows(ids.begin(), ids.end());
      const auto loss = objectives(m::PoseBatch(split.fit, rows), true, true);
      const auto values = n::stack({loss[0], loss[1], loss[2]}, 0);
      if (!n::all(n::is_finite(values)).item<bool>())
        return 1;
      total = total + values.detach().to(n::DType::Float64) * double(rows.size());
      seen += rows.size();
      adam.step(n::grad(loss[0], p.parameters()));
      ++updates;
    }
    if (seen != 12)
      return 1;
    const auto mean = total / 12.;
    epochs.push_back(epoch);
    training.push_back(n::select(mean, 0, 0).item());
    first.push_back(n::select(mean, 0, 1).item());
    second.push_back(n::select(mean, 0, 2).item());
    validation.push_back(val_loss());
    if (validation.back() < best) {
      best = validation.back();
      selected = epoch;
      p.save("build/stacked_hourglass_best_parameters.npz");
      state.save("build/stacked_hourglass_best_bn.npz");
    }
    std::print("| {} | {:.6f} | {:.6f} | {:.6f} | {:.6f} |\n", epoch, training.back(),
               first.back(), second.back(), validation.back());
  }
  p.load("build/stacked_hourglass_best_parameters.npz");
  state.load("build/stacked_hourglass_best_bn.npz");
  const double learned = probe_loss();
  if (std::abs(val_loss() - best) > 1e-7 || learned >= initial ||
      training.back() >= training.front() || updates != 18)
    return 1;
  n::ParameterStore deployed(991), moving(997);
  {
    n::NoGradGuard guard;
    m::StackedHourglass(deployed, moving, n::zeros({1, 128, 128, 3}), config);
  }
  deployed.load("build/stacked_hourglass_best_parameters.npz");
  moving.load("build/stacked_hourglass_best_bn.npz");
  std::vector<n::Tensor> snapshot;
  for (const auto &v : deployed.parameters())
    snapshot.push_back(v.clone());
  for (const auto &v : moving.parameters())
    snapshot.push_back(v.clone());
  auto predict = [&](n::ParameterStore &store, n::ParameterStore &statistics,
                     const n::Tensor &rgb) {
    n::NoGradGuard guard;
    std::vector<n::Tensor> parts;
    for (std::int64_t i = 0; i < rgb.size(0); i += 2)
      parts.push_back(
          m::StackedHourglass(store, statistics,
                              n::slice_axis(rgb, 0, i, std::min(i + 2, rgb.size(0))), config,
                              false, false)
              .heatmaps.back());
    return n::concat(parts, 0);
  };
  const auto heat = predict(deployed, moving, split.test.rgb),
             reference = predict(p, state, split.test.rgb),
             repeat = predict(deployed, moving, split.test.rgb),
             single = predict(deployed, moving, m::PoseBatch(split.test.rgb, {3}));
  const double parity = n::max(n::abs(heat - reference)).item(),
               batch_error = n::max(n::abs(single - n::slice_axis(heat, 0, 3, 4))).item(),
               sensitivity =
                   n::mean(n::abs(n::select(heat, 0, 1) - n::select(heat, 0, 0))).item();
  if (parity > 1e-6 || batch_error > 2e-5 || !n::all(n::equal(heat, repeat)).item<bool>() ||
      sensitivity <= 1e-6)
    return 1;
  std::size_t at = 0;
  for (const auto &v : deployed.parameters())
    if (!n::all(n::equal(v, snapshot[at++])).item<bool>())
      return 1;
  for (const auto &v : moving.parameters())
    if (!n::all(n::equal(v, snapshot[at++])).item<bool>())
      return 1;
  const auto decoded = m::DecodePoseHeatmaps(heat),
             mean = n::load_npz("build/stacked_hourglass_sgd_prior.npz").at(0).second,
             prior = m::ConstantPose(split.test, mean),
             center = m::ConstantPose(split.test, n::full({17, 3}, 63.5));
  const auto score = m::ScoreTensorPose(decoded, split.test),
             baseline = m::ScoreTensorPose(prior, split.test),
             center_score = m::ScoreTensorPose(center, split.test);
  std::print("{} visible updates;selected epoch{},restored validation {:.6f};fixed "
             "training-mode fit {:.6f}->{:.6f}.\nRGB-only restored prediction:checkpoint "
             "parity {:.3g},single/batch maximum {:.9g},repeat exact;all396 learned/192 BN "
             "tensors immutable;different-crop heatmap change {:.6f}.\n| estimate | PCK@.2 "
             "box | NME | mean crop pixels | annotated joints |\n|---|---:|---:|---:|---:|\n",
             updates, selected, best, initial, learned, parity, batch_error, sensitivity);
  for (const auto &item : std::vector<std::pair<std::string, m::TensorPoseMetrics>>{
           {"learned final head", score},
           {"visible SGD prior", baseline},
           {"fixed crop center", center_score}})
    std::print("| {} | {:.6f} | {:.6f} | {:.6f} | {} |\n", item.first, item.second.pck.item(),
               item.second.normalized_error.item(), item.second.pixels.item(),
               item.second.joints.item<int>());
  n::save_image_grid(m::PosePreviewTiles(split.test, decoded, heat),
                     "figures/stacked_hourglass_predictions.png", 2, 0, 1, 2, 0, 1);
  n::save_npz("build/stacked_hourglass_outputs.npz", {{"observed", split.test.rgb},
                                                      {"heatmaps", heat},
                                                      {"decoded", decoded},
                                                      {"truth", split.test.joints},
                                                      {"sgd_prior", prior},
                                                      {"center", center},
                                                      {"image_ids", split.test.image_ids},
                                                      {"person_ids", split.test.person_ids}});
  auto a = dm::graphics::RPlot::create(), b = dm::graphics::RPlot::create();
  a.bars({0., 1., 2.}, {score.pck.item(), baseline.pck.item(), center_score.pck.item()},
         "joint-weighted PCK", {37, 99, 235})
      .title("All116 annotated held-out joints")
      .x_label("0 learned,1 SGD,2 center")
      .y_label("inclusive PCK@.2 box")
      .y_limits(0, .3);
  b.bars({0., 1., 2.},
         {score.pixels.item(), baseline.pixels.item(), center_score.pixels.item()},
         "mean joint error", {22, 163, 74})
      .title("Same true boxes and joint support")
      .x_label("0 learned,1 SGD,2 center")
      .y_label("mean annotated-joint crop-pixel error")
      .y_limits(0, 90);
  auto metrics = dm::graphics::RLayout::create(1, 2);
  metrics.add(a).add(b).size(1100, 500).fit_panels().save_svg(
      "build/stacked_hourglass_metrics.svg");
  std::filesystem::copy_file("build/stacked_hourglass_metrics.svg",
                             "figures/stacked_hourglass_metrics.svg",
                             std::filesystem::copy_options::overwrite_existing);
  a = dm::graphics::RPlot::create();
  b = dm::graphics::RPlot::create();
  a.lines(epochs, training, "fitting total", {37, 99, 235})
      .lines(epochs, validation, "validation", {220, 38, 38})
      .title("Eighteen explicit Adam updates")
      .x_label("epoch")
      .y_label("both-head annotated-image MSE")
      .y_limits(0, 17);
  b.lines(epochs, first, "first head", {37, 99, 235})
      .lines(epochs, second, "final head", {22, 163, 74})
      .title("Both heads retain direct supervision")
      .x_label("epoch")
      .y_label("masked fitting MSE")
      .y_limits(0, 1.6);
  auto curves = dm::graphics::RLayout::create(1, 2);
  curves.add(a).add(b).size(1100, 500).fit_panels().save_svg(
      "build/stacked_hourglass_training.svg");
}
```
