> Explicit hard mining,recomputation and Adam

The complete compact encoder fits24 visible Adam(.0005) updates:three epochs
of eight20-image batches,each containing four distinct images from each fitting
category. Every fitting source appears once per epoch. Frozen current descriptors
select the farthest distinct same-class positive and nearest different-class
negative per anchor. Ties choose the first row. The loss is the mean squared-L2
triplet hinge with margin.2;there is no hidden regularization or fallback.
A fresh differentiable encoder pass follows discrete mining before every update.

Maximum exact validation mAP selects the checkpoint. Restoring must reproduce
its rankings-based score before held-out scoring. Independent deployment uses
only observed RGB and restored parameters;cloned snapshots verify every learned
leaf remains immutable. Saved gallery descriptors/IDs are reloaded,and every
one of48x96 ranked IDs and squared distances must reproduce exactly.

Pooled8x8 RGB and whole-image mean RGB are fixed descriptive transforms,with
no fitted coefficients or optimizer. They join the untrained encoder as simple
references. Actual held-out query/neighbor images show semantic relevance errors.

```{cpp, results="markdown", file="figures/image_retrieval_training.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

#include <print>
int main() {
  namespace n = dm::nn;
  namespace m = n::models;
  n::set_num_threads(2);

  std::filesystem::path cache;
  if (const auto *p = std::getenv("DATAMUNGE_DATA_DIR"))
    cache = p;
  else if (const auto *p = std::getenv("XDG_CACHE_HOME"))
    cache = std::filesystem::path(p) / "datamunge/datasets";
  else
    cache = std::filesystem::path(std::getenv("HOME")) / ".cache/datamunge/datasets";
  dm::datasets::fetch("cifar10", (cache / "cifar10").string());

  const auto data = m::LoadTensorRetrievalData(cache / "cifar10");
  n::ParameterStore p(227);
  // Warm all28 leaves,including the scalar GeM rho and bias-free projection.
  {
    n::NoGradGuard guard;
    m::RetrievalEncoder(p, n::zeros({1, 32, 32, 3}), 8, 32);
  }
  const auto encode = [](n::ParameterStore &weights, const m::TensorRetrievalPool &pool) {
    n::NoGradGuard guard;
    std::vector<n::Tensor> parts;
    for (std::int64_t row = 0; row < std::int64_t(pool.size()); row += 20)
      parts.push_back(
          m::RetrievalEncoder(weights,
                              n::slice_axis(pool.images, 0, row,
                                            std::min(row + 20, std::int64_t(pool.size()))),
                              8, 32)
              .descriptor);
    return n::concat(parts, 0);
  };
  const auto score = [](const n::Tensor &queries, const m::TensorRetrievalPool &query,
                        const n::Tensor &gallery, const m::TensorRetrievalPool &pool) {
    const m::TensorDescriptorIndex index(gallery, pool.ids);
    return m::ScoreTensorRetrieval(queries, query.labels, query.ids, index, pool.labels);
  };
  const auto probe = m::TensorRetrievalRows(data.fit, m::RetrievalBatches(data.fit, 0)[0]);
  n::Tensor frozen;
  {
    n::NoGradGuard guard;
    frozen = m::RetrievalEncoder(p, probe.images, 8, 32).descriptor;
  }
  const auto fixed = m::RetrievalHardTriplets(frozen, probe.labels);
  double initial;
  {
    n::NoGradGuard guard;
    initial =
        m::MeanTriplet(m::RetrievalEncoder(p, probe.images, 8, 32).descriptor, fixed).item();
  }
  const auto untrained_query = encode(p, data.test_query),
             untrained_gallery = encode(p, data.test_gallery);
  n::OptimizerConfig config;
  config.kind = n::OptimizerKind::Adam;
  n::Optimizer adam(p, .0005, config);
  std::filesystem::create_directories("build");
  std::filesystem::create_directories("figures");
  std::vector<double> epochs, losses, maps, hits, powers;
  double best = -1;
  int selected = 0, steps = 0;
  std::print("| epoch | mean batch-hard hinge | validation mAP | validation hit1 | learned p "
             "|\n|---:|---:|---:|---:|---:|\n");
  for (int epoch = 1; epoch <= 3; ++epoch) {
    double total = 0;
    std::set<std::int64_t> seen;
    for (const auto &rows : m::RetrievalBatches(data.fit, epoch)) {
      const auto batch = m::TensorRetrievalRows(data.fit, rows);
      for (const auto id : batch.ids)
        if (!seen.insert(id).second)
          return 1;
      n::Tensor current;
      {
        n::NoGradGuard guard;
        current = m::RetrievalEncoder(p, batch.images, 8, 32).descriptor;
      }
      const auto triplets = m::RetrievalHardTriplets(current, batch.labels);
      // Recompute a differentiable current encoder after frozen discrete hard mining.
      const auto features = m::RetrievalEncoder(p, batch.images, 8, 32).descriptor;
      const auto loss = m::MeanTriplet(features, triplets, .2f);
      if (!std::isfinite(loss.item()))
        return 1;
      total += loss.item() / 8.;
      adam.minimize(loss);
      ++steps;
    }
    if (seen.size() != 160)
      return 1;
    const auto metric = score(encode(p, data.validation_query), data.validation_query,
                              encode(p, data.validation_gallery), data.validation_gallery);
    double power;
    {
      n::NoGradGuard guard;
      power = m::RetrievalEncoder(p, n::slice_axis(data.fit.images, 0, 0, 1), 8, 32)
                  .exponent.item();
    }
    epochs.push_back(epoch);
    losses.push_back(total);
    maps.push_back(metric.map.item());
    hits.push_back(metric.hit1.item());
    powers.push_back(power);
    if (metric.map.item() > best) {
      best = metric.map.item();
      selected = epoch;
      p.save("build/image_retrieval_best.npz");
    }
    std::print("| {} | {:.6f} | {:.6f} | {:.6f} | {:.6f} |\n", epoch, total, maps.back(),
               hits.back(), power);
  }
  p.load("build/image_retrieval_best.npz");
  const auto restored = score(encode(p, data.validation_query), data.validation_query,
                              encode(p, data.validation_gallery), data.validation_gallery);
  if (std::abs(restored.map.item() - best) > 1e-12)
    return 1;
  double learned;
  {
    n::NoGradGuard guard;
    learned =
        m::MeanTriplet(m::RetrievalEncoder(p, probe.images, 8, 32).descriptor, fixed).item();
  }
  // Independently allocated RGB-only deployment:no labels or optimizer are created.
  n::ParameterStore deployed(991);
  {
    n::NoGradGuard guard;
    m::RetrievalEncoder(deployed, n::zeros({1, 32, 32, 3}), 8, 32);
  }
  deployed.load("build/image_retrieval_best.npz");
  std::vector<n::Tensor> snapshot;
  for (const auto &value : deployed.parameters())
    snapshot.push_back(value.clone());
  const auto queries = encode(deployed, data.test_query),
             gallery = encode(deployed, data.test_gallery),
             reference = encode(p, data.test_query),
             repeat = encode(deployed, data.test_query);
  const double parity = n::max(n::abs(queries - reference)).item();
  if (parity > 1e-7 || n::max(n::abs(queries - repeat)).item() != 0)
    return 1;
  {
    n::NoGradGuard guard;
    const auto one = m::RetrievalEncoder(
                         deployed, m::TensorRetrievalRows(data.test_query, {3}).images, 8, 32)
                         .descriptor;
    if (n::max(n::abs(one - n::slice_axis(queries, 0, 3, 4))).item() > 2e-6)
      return 1;
  }
  for (std::size_t i = 0; i < snapshot.size(); ++i)
    if (n::max(n::abs(snapshot[i] - deployed.parameters()[i])).item() != 0)
      return 1;
  const m::TensorDescriptorIndex index(gallery, data.test_gallery.ids);
  n::save_npz(
      "build/image_retrieval_gallery.npz",
      {{"descriptors", gallery}, {"source_ids", n::from_vector(data.test_gallery.ids)}});
  n::Tensor saved_features, saved_ids;
  for (const auto &[name, value] : n::load_npz("build/image_retrieval_gallery.npz")) {
    if (name == "descriptors")
      saved_features = value;
    if (name == "source_ids")
      saved_ids = value;
  }
  const m::TensorDescriptorIndex reloaded(saved_features, saved_ids.to_vector<std::int64_t>());
  for (std::int64_t row = 0; row < 48; ++row) {
    const auto a = index.Rank(queries, row, data.test_query.ids[row]),
               b = reloaded.Rank(queries, row, data.test_query.ids[row]);
    if (!n::all(n::equal(a.ids, b.ids)).item<bool>() ||
        n::max(n::abs(a.distances - b.distances)).item() != 0)
      return 1;
  }
  const auto learned_score = score(queries, data.test_query, gallery, data.test_gallery),
             untrained =
                 score(untrained_query, data.test_query, untrained_gallery, data.test_gallery),
             pixels =
                 score(m::RetrievalPixelDescriptors(data.test_query, 4), data.test_query,
                       m::RetrievalPixelDescriptors(data.test_gallery, 4), data.test_gallery),
             colour =
                 score(m::RetrievalPixelDescriptors(data.test_query, 32), data.test_query,
                       m::RetrievalPixelDescriptors(data.test_gallery, 32), data.test_gallery);
  std::print("{} explicit Adam updates;selected epoch{},restored validation mAP {:.6f};fixed "
             "fitting hinge {:.6f}->{:.6f}. Independent deployment parity {:.3g},all28 leaves "
             "immutable,repeat/single/batch checks pass. All48x96 serialized gallery "
             "rankings/distances reproduce exactly.\n| model | test mAP | hit1 | hit5 | "
             "eligible | no positive |\n|---|---:|---:|---:|---:|---:|\n",
             steps, selected, best, initial, learned, parity);
  const auto print = [](const char *name, const m::TensorRetrievalMetrics &value) {
    std::print("| {} | {:.6f} | {:.6f} | {:.6f} | {} | {} |\n", name, value.map.item(),
               value.hit1.item(), value.hit5.item(), value.eligible.item<std::int64_t>(),
               value.without_positive.item<std::int64_t>());
  };
  print("learned CNN", learned_score);
  print("untrained CNN", untrained);
  print("8x8 pooled RGB", pixels);
  print("mean RGB", colour);
  n::save_image_grid(
      m::RetrievalPreviewTiles(data.test_query, data.test_gallery, queries, index),
      "build/image_retrieval_neighbors.png", 1, 0, 1, 0, 0, 2);
  std::filesystem::copy_file("build/image_retrieval_neighbors.png",
                             "figures/image_retrieval_neighbors.png",
                             std::filesystem::copy_options::overwrite_existing);
  std::vector<double> map_values, hit_values;
  for (const auto *value : {&learned_score, &untrained, &pixels, &colour}) {
    map_values.push_back(value->map.item());
    hit_values.push_back(value->hit1.item());
  }
  auto a = dm::graphics::RPlot::create(), b = dm::graphics::RPlot::create();
  a.bars({0, 1, 2, 3}, map_values, "mean AP", {37, 99, 235}, .6)
      .title("Held-out exact retrieval mAP")
      .x_label("model0..3;see table")
      .y_label("mean average precision")
      .y_limits(0, 1.2);
  b.bars({0, 1, 2, 3}, hit_values, "hit1", {22, 163, 74}, .6)
      .title("Held-out first-neighbor relevance")
      .x_label("model0..3;see table")
      .y_label("fraction with relevant rank1")
      .y_limits(0, 1.2);
  auto baselines = dm::graphics::RLayout::create(1, 2);
  baselines.add(a).add(b).size(1100, 480).fit_panels().save_svg(
      "build/image_retrieval_baselines.svg");
  std::filesystem::copy_file("build/image_retrieval_baselines.svg",
                             "figures/image_retrieval_baselines.svg",
                             std::filesystem::copy_options::overwrite_existing);
  auto loss_plot = dm::graphics::RPlot::create(), map_plot = dm::graphics::RPlot::create(),
       hit_plot = dm::graphics::RPlot::create(), power_plot = dm::graphics::RPlot::create();
  loss_plot.lines(epochs, losses, "hard hinge", {37, 99, 235})
      .title("Complete descriptor Adam fitting")
      .x_label("epoch")
      .y_label("mean selected-triplet hinge")
      .y_limits(0, .28);
  map_plot.lines(epochs, maps, "validation mAP", {22, 163, 74})
      .title("Validation mAP checkpoint selection")
      .x_label("epoch")
      .y_label("mean average precision")
      .y_limits(0, 1.2);
  hit_plot.lines(epochs, hits, "validation hit1", {220, 38, 38})
      .title("Validation first-neighbor relevance")
      .x_label("epoch")
      .y_label("fraction with relevant rank1")
      .y_limits(0, 1.2);
  power_plot.lines(epochs, powers, "learned power", {147, 51, 234})
      .title("GeM power receives optimizer updates")
      .x_label("epoch")
      .y_label("p=1+softplus(rho)")
      .y_limits(2.98, 3.01);
  auto layout = dm::graphics::RLayout::create(2, 2);
  layout.add(loss_plot)
      .add(map_plot)
      .add(hit_plot)
      .add(power_plot)
      .size(1100, 950)
      .fit_panels()
      .save_svg("build/image_retrieval_training.svg");
}
```
