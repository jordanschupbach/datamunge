> Visible complete-model Adam and independent deployment

The compact two-stream model fits36 visible Adam(.001) updates:three epochs
of48 fitting photographs,batch4,shuffle seed239. Both independent streams,
all biases and the dense head are optimized;there is no regularization term
hidden in the objective. Minimum official validation NLL selects the checkpoint,
which must reproduce its score on restore. A separately initialized deployment
store then loads the same checkpoint without constructing any optimizer.

The code verifies prediction parity,exact repeated inference,single/batch
agreement and immutability against cloned snapshots of every learned tensor.
The held-out table compares the learned model,its untrained initialization,
uniform probabilities and the fitting-only color prototypes shown above.
Accuracy uses first-maximum ties;macro recall excludes missing true classes;
Brier is the six-class squared-error **sum**,averaged across images.

```{cpp, results="markdown", file="figures/bilinear_cnn_training.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <print>
int main() {
  int rendered_confusions = 0;
  namespace n             = dm::nn;
  namespace m             = n::models;
  n::set_num_threads(2);

  std::filesystem::path cache;
  if (const auto* p = std::getenv("DATAMUNGE_DATA_DIR"))
    cache = p;
  else if (const auto* p = std::getenv("XDG_CACHE_HOME"))
    cache = std::filesystem::path(p) / "datamunge/datasets";
  else
    cache = std::filesystem::path(std::getenv("HOME")) / ".cache/datamunge/datasets";

  std::filesystem::path root = cache / "flowers102";
  if (const auto* p = std::getenv("DATAMUNGE_FLOWERS_DIR"))
    root = p;
  else
    dm::datasets::prepare_example_data("flowers", root.string());

  const auto        data = m::LoadFlowers(root);
  n::ParameterStore p(233);
  // Warm all54 learned leaves before constructing Adam;there is no BN state.
  {
    n::NoGradGuard guard;
    m::BilinearCNN(p, n::zeros({1, 64, 64, 3}), 16, 6);
  }
  const auto predict = [](n::ParameterStore& weights, const m::FlowerData& batch) {
    n::NoGradGuard         guard;
    std::vector<n::Tensor> parts;
    for (std::int64_t row = 0; row < batch.rgb.shape()[0]; row += 4)
      parts.push_back(
          n::softmax(
              m::BilinearCNN(
                  weights,
                  n::slice_axis(batch.rgb, 0, row, std::min(row + 4, batch.rgb.shape()[0])),
                  16,
                  6)
                  .logits,
              1));
    return n::concat(parts, 0);
  };
  const auto probe = m::FlowerRows(data.fit, {0, 8, 16, 24, 32, 40});
  double     initial;
  {
    n::NoGradGuard guard;
    initial =
        m::FlowerCrossEntropy(m::BilinearCNN(p, probe.rgb, 16, 6).logits, probe.labels, 6).item();
  }
  const auto         untrained = predict(p, data.test);
  n::OptimizerConfig config;
  config.kind = n::OptimizerKind::Adam;
  n::Optimizer  adam(p, .001, config);
  n::BatchOrder order(48, 4, 239);
  std::filesystem::create_directories("build");
  std::filesystem::create_directories("figures");
  std::vector<double> epochs, fit_loss, val_loss, val_accuracy;
  double              best     = INFINITY;
  int                 selected = 0, steps = 0;
  std::print(
      "| epoch | fitting NLL | validation NLL | validation accuracy "
      "|\n|---:|---:|---:|---:|\n");
  for (int epoch = 1; epoch <= 3; ++epoch) {
    order.begin_epoch();
    double sum  = 0;
    int    seen = 0;
    for (auto ids = order.next(); !ids.empty(); ids = order.next()) {
      const auto batch  = m::FlowerRows(data.fit, std::vector<std::size_t>(ids.begin(), ids.end()));
      const auto logits = m::BilinearCNN(p, batch.rgb, 16, 6).logits;
      const auto loss   = m::FlowerCrossEntropy(logits, batch.labels, 6);
      if (!std::isfinite(loss.item()))
        return 1;
      sum += loss.item() * ids.size();
      seen += ids.size();
      adam.minimize(loss);
      ++steps;
    }
    if (seen != 48)
      return 1;
    const auto score = m::ScoreFlowers(predict(p, data.validation), data.validation.labels);
    epochs.push_back(epoch);
    fit_loss.push_back(sum / seen);
    val_loss.push_back(score.nll.item());
    val_accuracy.push_back(score.accuracy.item());
    if (score.nll.item() < best) {
      best     = score.nll.item();
      selected = epoch;
      p.save("build/bilinear_cnn_best.npz");
    }
    std::print(
        "| {} | {:.6f} | {:.6f} | {:.6f} |\n",
        epoch,
        fit_loss.back(),
        val_loss.back(),
        val_accuracy.back());
  }
  p.load("build/bilinear_cnn_best.npz");
  if (std::abs(
          m::ScoreFlowers(predict(p, data.validation), data.validation.labels).nll.item() - best) >
      1e-8)
    return 1;
  double learned;
  {
    n::NoGradGuard guard;
    learned =
        m::FlowerCrossEntropy(m::BilinearCNN(p, probe.rgb, 16, 6).logits, probe.labels, 6).item();
  }
  // Independently allocate a deployment store;it owns no optimizer or training labels.
  n::ParameterStore deployed(997);
  {
    n::NoGradGuard guard;
    m::BilinearCNN(deployed, n::zeros({1, 64, 64, 3}), 16, 6);
  }
  deployed.load("build/bilinear_cnn_best.npz");
  std::vector<n::Tensor> snapshot;
  for (const auto& leaf : deployed.parameters())
    snapshot.push_back(leaf.clone());
  const auto probability = predict(deployed, data.test), reference = predict(p, data.test),
             repeat   = predict(deployed, data.test);
  const double parity = n::max(n::abs(probability - reference)).item();
  if (parity > 1e-7 || n::max(n::abs(probability - repeat)).item() != 0)
    return 1;
  {
    n::NoGradGuard guard;
    const auto     single =
        n::softmax(m::BilinearCNN(deployed, m::FlowerRows(data.test.rgb, {3}), 16, 6).logits, 1);
    if (n::max(n::abs(single - n::slice_axis(probability, 0, 3, 4))).item() > 2e-6)
      return 1;
  }
  for (std::size_t i = 0; i < snapshot.size(); ++i)
    if (n::max(n::abs(snapshot[i] - deployed.parameters()[i])).item() != 0)
      return 1;
  const auto score   = m::ScoreFlowers(probability, data.test.labels),
             before  = m::ScoreFlowers(untrained, data.test.labels),
             uniform = m::ScoreFlowers(n::full({48, 6}, 1. / 6), data.test.labels),
             color = m::ScoreFlowers(m::FlowerColorBaseline(data.fit, data.test), data.test.labels);
  std::print(
      "{} explicit Adam updates;selected epoch{},restored validation NLL {:.6f};balanced "
      "fixed fitting NLL {:.6f}->{:.6f}.\nIndependent deployment parity {:.3g};repeat "
      "exact,single/batch agreement,all54 leaves immutable.\n| model | held-out NLL | "
      "accuracy | macro recall | Brier sum |\n|---|---:|---:|---:|---:|\n",
      steps,
      selected,
      best,
      initial,
      learned,
      parity);
  const auto print = [](const char* name, const m::TensorFlowerMetrics& value) {
    std::print(
        "| {} | {:.6f} | {:.6f} | {:.6f} | {:.6f} |\n",
        name,
        value.nll.item(),
        value.accuracy.item(),
        value.macro_accuracy.item(),
        value.brier.item());
  };
  print("learned bilinear", score);
  print("untrained bilinear", before);
  print("uniform", uniform);
  print("fitting-only color SGD", color);
  n::save_image_grid(
      m::FlowerPredictionTiles(data.test, probability),
      "build/bilinear_cnn_predictions.png",
      8,
      0,
      1,
      0,
      0,
      2);
  std::filesystem::copy_file(
      "build/bilinear_cnn_predictions.png",
      "figures/bilinear_cnn_predictions.png",
      std::filesystem::copy_options::overwrite_existing);

  n::ConfusionMatrix::from_counts(score.confusion.to(n::DType::Int64))
      .save_svg(
          "build/bilinear_cnn_confusion_api_" + std::to_string(rendered_confusions++) + ".svg",
          {.title = "Selected-checkpoint held-out class counts"});
  auto confusion = n::plot_tensor_map(n::reverse(score.confusion.to(n::DType::Float64), {0}), 0, 8);
  confusion.title("Bilinear held-out flower confusion");
  confusion.x_label("predicted local class0..5");
  confusion.y_label("true local class0..5 from bottom");
  confusion.size(800, 650).save_svg("build/bilinear_cnn_confusion.svg");
  std::filesystem::copy_file(
      "build/bilinear_cnn_confusion.svg",
      "figures/bilinear_cnn_confusion.svg",
      std::filesystem::copy_options::overwrite_existing);
  auto a = dm::graphics::RPlot::create(), b = dm::graphics::RPlot::create();
  a.lines(epochs, fit_loss, "fitting NLL", {37, 99, 235})
      .lines(epochs, val_loss, "validation NLL", {220, 38, 38})
      .title("Complete two-stream Adam fitting")
      .x_label("epoch")
      .y_label("mean image NLL")
      .y_limits(
          0,
          1.2 * std::max(
                    *std::max_element(fit_loss.begin(), fit_loss.end()),
                    *std::max_element(val_loss.begin(), val_loss.end())));
  b.lines(epochs, val_accuracy, "validation acc", {22, 163, 74})
      .title("Official validation checkpoint")
      .x_label("epoch")
      .y_label("fraction correct")
      .y_limits(0, 1.2);
  auto layout = dm::graphics::RLayout::create(1, 2);
  layout.add(a).add(b).size(1100, 480).fit_panels().save_svg("build/bilinear_cnn_training.svg");
}
```
