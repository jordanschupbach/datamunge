> A visible optimizer even for the mean-color reference

A simple reference uses only each image’s three mean RGB values. Let mu_c be
a class prototype. Minimize the sum of within-class mean squared color errors:
\(L=\frac18\sum_i\|\mu_{y_i}-\bar x_i\|^2\). Because every fitting class
has eight images,its gradient is2(mu_c-class_mean_c). Starting at zero,one
explicit SGD(.5) step reaches the class mean exactly. No validation or test
labels fit these18 prototype coordinates. Softmax of negative squared color
distance divided by.02 gives a reference probability vector.

```{cpp, results="markdown", file="figures/bilinear_cnn_colour.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

#include <print>
int main() {
  namespace n = dm::nn;
  namespace m = n::models;

  std::filesystem::path cache;
  if (const auto *p = std::getenv("DATAMUNGE_DATA_DIR"))
    cache = p;
  else if (const auto *p = std::getenv("XDG_CACHE_HOME"))
    cache = std::filesystem::path(p) / "datamunge/datasets";
  else
    cache = std::filesystem::path(std::getenv("HOME")) / ".cache/datamunge/datasets";

  std::filesystem::path root = cache / "flowers102";
  if (const auto *p = std::getenv("DATAMUNGE_FLOWERS_DIR"))
    root = p;
  else
    dm::datasets::prepare_example_data("flowers", root.string());

  const auto data = m::LoadFlowers(root);
  const auto means = m::FlowerColorMeans(data.fit).to(n::DType::Float64),
             test = m::FlowerColorMeans(data.test).to(n::DType::Float64);
  n::ParameterStore colour(229, n::DType::Float64);
  const auto centres = colour.get("prototype", {6, 3}, n::init::zeros());
  n::OptimizerConfig config;
  config.kind = n::OptimizerKind::Sgd;
  n::Optimizer sgd(colour, .5, config);
  for (int step = 0; step < 1; ++step) {
    const auto objective = n::sum(n::square(n::gather(centres, data.fit.labels) - means)) / 8.;
    sgd.minimize(objective);
  }
  const auto distance =
      n::sum(n::square(n::expand_dims(test, 1) - n::expand_dims(centres, 0)), {2});
  const auto probability = n::softmax(-distance / .02, 1).to(n::DType::Float32);
  const auto reference = m::FlowerColorBaseline(data.fit, data.test);
  const double error = n::max(n::abs(probability - reference)).item();
  if (error > 1e-7)
    return 1;
  const auto score = m::ScoreFlowers(probability, data.test.labels);
  auto p = n::plot_tensor_map(n::reverse(centres, {0}), 0, 1);
  p.title("Fit-only mean-color prototypes");
  p.x_label("red,green,blue channel");
  p.y_label("local class0..5 from bottom");
  p.size(800, 650);
  std::filesystem::create_directories("build");
  p.save_svg("build/bilinear_cnn_colour.svg");
  std::print("One explicit SGD(.5) step fits18 Float64 prototype coordinates;stable "
             "closed-form reference parity {:.3g}. Held-out color-only NLL {:.6f},accuracy "
             "{:.6f},macro {:.6f},Brier sum {:.6f}. No test labels fit prototypes.\n",
             error, score.nll.item(), score.accuracy.item(), score.macro_accuracy.item(),
             score.brier.item());
}
```
