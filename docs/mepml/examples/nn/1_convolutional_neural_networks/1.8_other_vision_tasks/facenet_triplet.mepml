> Visible mining,recomputation and Adam

The complete compact encoder fits three epochs of32 class-balanced40-image
batches. Frozen current embeddings select strict semi-hard triplets;then a
fresh differentiable forward pass minimizes mean selected-triplet hinge plus
`.00005*sum(kernel²)` using explicit Adam(.001). All ordered positive pairs
are considered:5*8*7=280 per batch. Empty mining batches skip the update.
The learning loop prints both selected and missing-negative counts so that
a changing training set cannot be mistaken for a fixed loss probe.

Fixed512-triplet fitting and validation probes do not depend on the miner.
The lowest validation probe selects the learned checkpoint,which must reproduce
its score on restore. Only validation pairs calibrate the squared-distance
threshold;512 balanced held-out pairs then determine accuracy,confusion and
pairwise AUC(half credit for tied same/different distances). Finally,256
three-way held-out one-support tasks compare trained and untrained embeddings.
Fixed probes use the same float.2 margin as the differentiable hinge;the
legacy printed probe used a double.2 constant,a negligible stated rounding
change. No test labels choose a checkpoint,threshold or update.

```{cpp, results="markdown", file="figures/facenet_triplet_training.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

#include <map>
#include <print>
int main() {
  namespace n = dm::nn;
  namespace m = n::models;
  n::set_num_threads(2);

  std::filesystem::path cache;
  if (const auto *p = std::getenv("DATAMUNGE_DATA_DIR"))
    cache = p;
  else if (const auto *p = std::getenv("XDG_CACHE_HOME"))
    cache = std::filesystem::path(p) / "datamunge/datasets";
  else
    cache = std::filesystem::path(std::getenv("HOME")) / ".cache/datamunge/datasets";
  dm::datasets::fetch("mnist", (cache / "mnist").string());

  const auto train = n::load_mnist((cache / "mnist").string(), "train"),
             test = n::load_mnist((cache / "mnist").string(), "test");
  if (train.images.shape()[0] != 60000 || test.images.shape()[0] != 10000)
    return 1;
  const auto fitting = m::SiameseBuckets(train, {0, 1, 2, 3, 4}, 256),
             probe_buckets = m::SiameseBuckets(train, {0, 1, 2, 3, 4}, 32),
             validation = m::SiameseBuckets(train, {5, 6}, 128),
             testing = m::SiameseBuckets(test, {7, 8, 9}, 128);
  const auto train_labels = m::MetricDatasetLabels(train);
  const auto flatten = [](const m::DigitBuckets &buckets) {
    std::vector<std::size_t> rows;
    for (const auto &bucket : buckets)
      rows.insert(rows.end(), bucket.begin(), bucket.end());
    return rows;
  };
  const auto probe_rows = flatten(probe_buckets), val_rows = flatten(validation),
             test_rows = flatten(testing);
  const auto row_labels = [&](const std::vector<std::size_t> &rows) {
    std::vector<int> labels;
    for (const auto row : rows)
      labels.push_back(train_labels[row]);
    return labels;
  };
  const auto probe = m::FixedMetricTriplets(row_labels(probe_rows), 512, 71),
             val_triplets = m::FixedMetricTriplets(row_labels(val_rows), 512, 73);
  const auto val_pairs = m::SiamesePairs(validation, 256, 79),
             test_pairs = m::SiamesePairs(testing, 512, 83);
  const auto tasks = m::SiameseTasks(testing, 256, 89);
  n::ParameterStore p(17);
  const auto c = m::FaceNetConfig::Compact();
  // Warm all28 leaves before Adam. No hidden BN or optimizer state in the model.
  {
    n::NoGradGuard guard;
    m::FaceNetNN1(p, n::zeros({1, 28, 28, 1}), c);
  }
  const auto encode = [&](const n::ImageDataset &data, const std::vector<std::size_t> &rows) {
    n::NoGradGuard guard;
    std::vector<n::Tensor> parts;
    for (std::size_t start = 0; start < rows.size(); start += 64) {
      const auto end = std::min(rows.size(), start + 64);
      parts.push_back(
          m::FaceNetNN1(p, m::SiameseImages(data, {rows.begin() + start, rows.begin() + end}),
                        c)
              .embedding);
    }
    return n::concat(parts, 0);
  };
  const auto distances = [](const n::Tensor &features, const std::vector<std::size_t> &rows,
                            const std::vector<m::VerificationPair> &pairs) {
    std::map<std::size_t, std::int64_t> index;
    for (std::size_t i = 0; i < rows.size(); ++i)
      index[rows[i]] = i;
    std::vector<std::int64_t> left, right;
    for (const auto &pair : pairs) {
      left.push_back(index.at(pair.left));
      right.push_back(index.at(pair.right));
    }
    return m::MetricPairDistance(features, left, right);
  };
  const auto pair_labels = [](const std::vector<m::VerificationPair> &pairs) {
    std::vector<double> labels;
    for (const auto &pair : pairs)
      labels.push_back(pair.same);
    return n::from_vector(labels);
  };
  std::vector<m::VerificationPair> task_pairs;
  std::vector<std::int64_t> correct;
  for (const auto &task : tasks) {
    correct.push_back(task.correct);
    for (const auto row : task.support)
      task_pairs.push_back({task.query, row, 0});
  }
  const auto correct_columns = n::from_vector(correct);
  const auto episode_scores = [&](const n::Tensor &features) {
    return (-distances(features, test_rows, task_pairs)).reshape({256, 3});
  };
  const double initial = m::MeanTriplet(encode(train, probe_rows).to(n::DType::Float64), probe)
                             .item(),
               untrained = m::SiameseOneShotAccuracy(episode_scores(encode(test, test_rows)),
                                                     correct_columns)
                               .item();
  n::OptimizerConfig config;
  config.kind = n::OptimizerKind::Adam;
  n::Optimizer adam(p, .001, config);
  std::filesystem::create_directories("build");
  std::filesystem::create_directories("figures");
  std::vector<double> epochs, fixed_fit, fixed_val, mined_loss;
  double best = INFINITY;
  int selected = 0, steps = 0, total_mined = 0;
  std::print("| epoch | selected hinge | mined | missing negatives | fixed fitting | fixed "
             "validation |\n|---:|---:|---:|---:|---:|---:|\n");
  for (int epoch = 1; epoch <= 3; ++epoch) {
    double sum = 0;
    int updates = 0, mined = 0, missing = 0;
    for (int batch = 0; batch < 32; ++batch) {
      const auto rows = m::MetricBatchRows(fitting, 8, epoch * 1000 + batch);
      const auto images = m::SiameseImages(train, rows);
      n::Tensor frozen;
      {
        n::NoGradGuard guard;
        frozen = m::FaceNetNN1(p, images, c).embedding;
      }
      const auto mining = m::MineSemiHard(frozen, row_labels(rows));
      if (mining.positive_pairs != 280)
        return 1;
      missing += mining.without_semihard;
      if (mining.triplets.empty())
        continue;
      // Recompute the current encoder graph after detached discrete mining.
      const auto features = m::FaceNetNN1(p, images, c).embedding;
      const auto hinge = m::MeanTriplet(features, mining.triplets);
      if (!std::isfinite(hinge.item()))
        return 1;
      sum += hinge.item();
      adam.minimize(hinge + .00005 * m::WeightSquares(p));
      ++updates;
      ++steps;
      mined += int(mining.triplets.size());
    }
    if (updates == 0)
      return 1;
    const double
        fit = m::MeanTriplet(encode(train, probe_rows).to(n::DType::Float64), probe).item(),
        val =
            m::MeanTriplet(encode(train, val_rows).to(n::DType::Float64), val_triplets).item();
    epochs.push_back(epoch);
    fixed_fit.push_back(fit);
    fixed_val.push_back(val);
    mined_loss.push_back(sum / updates);
    total_mined += mined;
    if (val < best) {
      best = val;
      selected = epoch;
      p.save("build/facenet_triplet_best.npz");
    }
    std::print("| {} | {:.6f} | {} | {} | {:.6f} | {:.6f} |\n", epoch, sum / updates, mined,
               missing, fit, val);
  }
  p.load("build/facenet_triplet_best.npz");
  const auto val_features = encode(train, val_rows);
  if (std::abs(m::MeanTriplet(val_features.to(n::DType::Float64), val_triplets).item() -
               best) > 1e-10)
    return 1;
  const auto threshold = m::CalibrateMetricDistanceThreshold(
      distances(val_features, val_rows, val_pairs), pair_labels(val_pairs));
  const auto test_features = encode(test, test_rows),
             test_distances = distances(test_features, test_rows, test_pairs);
  const auto metric =
      m::MetricDistanceMetrics(test_distances, pair_labels(test_pairs), threshold.item())
          .to_vector<double>();
  const auto scores = episode_scores(test_features);
  const auto accuracy = m::SiameseOneShotAccuracy(scores, correct_columns).item();
  const auto final =
      m::MeanTriplet(encode(train, probe_rows).to(n::DType::Float64), probe).item();
  n::save_image_grid(m::SiameseEpisodeGallery(test, tasks, scores),
                     "build/facenet_triplet_episodes.png", 1, 0, 1, 2, 1, 2);
  std::filesystem::copy_file("build/facenet_triplet_episodes.png",
                             "figures/facenet_triplet_episodes.png",
                             std::filesystem::copy_options::overwrite_existing);
  std::print("{} explicit Adam updates;{} mined triplets;selected epoch{} with restored "
             "validation hinge {:.6f};fixed fitting {:.6f}->{:.6f}.\nValidation-only "
             "threshold {:.6f};512 unseen pairs:accuracy {:.6f},AUC {:.6f},TP/FP/FN/TN "
             "{:.0f}/{:.0f}/{:.0f}/{:.0f};mean same/different distances {:.6f}/{:.6f}.\n256 "
             "unseen3-way tasks:trained {:.6f},untrained {:.6f},chance1/3.\n",
             steps, total_mined, selected, best, initial, final, threshold.item(), metric[0],
             metric[3], metric[4], metric[5], metric[6], metric[7], metric[1], metric[2],
             accuracy, untrained);
  auto a = dm::graphics::RPlot::create(), b = dm::graphics::RPlot::create();
  a.lines(epochs, fixed_fit, "fixed fitting", {37, 99, 235})
      .lines(epochs, fixed_val, "validation", {220, 38, 38})
      .title("Fixed triplet checkpoint objectives")
      .x_label("epoch")
      .y_label("mean hinge;512 fixed triplets")
      .y_limits(0, .28);
  b.lines(epochs, mined_loss, "mined hinge", {22, 163, 74})
      .title("Selected training-triplet hinge")
      .x_label("epoch")
      .y_label("mean per nonempty batch")
      .y_limits(0, .25);
  auto layout = dm::graphics::RLayout::create(1, 2);
  layout.add(a).add(b).size(1100, 480).fit_panels().save_svg(
      "build/facenet_triplet_training.svg");
}
```
