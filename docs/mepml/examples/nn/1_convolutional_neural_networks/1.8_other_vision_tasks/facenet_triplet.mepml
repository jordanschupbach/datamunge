> Actual class-balanced digit inputs

Fitting uses only digits0–4 from the official MNIST training split,256 rows
per class. Validation uses digits5–6 from that split,128/class;testing uses
only digits7–9 from the official test split,128/class. Each training batch
samples eight distinct images from each of the five fitting classes(P5K8),
then shuffles the40 row IDs. The preview uses one actual such batch,regrouped
by class for readability;pixel operations stay in the tensor library.

```{cpp, results="markdown", file="figures/facenet_triplet_data.png", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

#include <print>
int main() {
  namespace n = dm::nn;

  std::filesystem::path cache;
  if (const auto *p = std::getenv("DATAMUNGE_DATA_DIR"))
    cache = p;
  else if (const auto *p = std::getenv("XDG_CACHE_HOME"))
    cache = std::filesystem::path(p) / "datamunge/datasets";
  else
    cache = std::filesystem::path(std::getenv("HOME")) / ".cache/datamunge/datasets";
  dm::datasets::fetch("mnist", (cache / "mnist").string());

  const auto train = n::load_mnist((cache / "mnist").string(), "train");
  const auto buckets = n::models::SiameseBuckets(train, {0, 1, 2, 3, 4}, 256);
  auto rows = n::models::MetricBatchRows(buckets, 8, 1000);
  const auto labels = n::models::MetricDatasetLabels(train);
  std::stable_sort(rows.begin(), rows.end(), [&](auto a, auto b) {
    return labels[a] < labels[b];
  });
  std::filesystem::create_directories("build");
  n::save_image_grid(n::models::SiameseImages(train, rows), "build/facenet_triplet_data.png",
                     8, 0, 1, 2, 1, 3);
  std::print(
      "Actual P5K8 batch:40 distinct rows,grouped for display into five rows of "
      "digits0,1,2,3,4. Fitting256/class;validation128/class(5,6);test128/class(7,8,9).\n");
}
```
