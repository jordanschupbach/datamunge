> Content and style use different normalizations

Content is.5*sum((F-P)^2),retaining spatial layout. A style layer is
.25*mean((G-A)^2) with M-normalized Grams,equivalent to the original
1/(4*C*C*M*M) coefficient on unnormalized Grams. Five layers receive equal.2
weights. The following scale sweep shows the raw single-layer objectives and
their actual tensor derivatives;it does not fit a surrogate model.
```{cpp, results="markdown", file="figures/gatys_style_transfer_losses.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

#include <print>
int main() {
  namespace n = dm::nn;
  namespace m = n::models;
  const auto alpha = n::arange(.5, 1.5001, .01, n::DType::Float64).requires_grad_(),
             base = n::arange(1, 13, 1, n::DType::Float64).reshape({1, 2, 3, 2}),
             generated = alpha.reshape({-1, 1, 1, 1}) * base, target = m::StyleGram(base);
  const auto style = .25 * n::mean(n::square(m::StyleGram(generated) - target), {1, 2}),
             content = .5 * n::sum(n::square(generated - base), {1, 2, 3}),
             sg = n::grad(n::sum(style), {alpha})[0];
  const auto content_gradient = n::sum(n::square(base)).item() * (alpha.detach() - 1.);
  auto a = dm::graphics::RPlot::create(), b = dm::graphics::RPlot::create();
  a.lines(alpha.detach().to_vector<double>(), content.to_vector<double>(), "content loss",
          {37, 99, 235})
      .lines(alpha.detach().to_vector<double>(), style.to_vector<double>(), "style layer",
             {220, 38, 38})
      .title("Different raw objective scales")
      .x_label("feature scale alpha")
      .y_label("raw feature loss")
      .y_limits(0, 2000);
  b.lines(alpha.detach().to_vector<double>(), content_gradient.to_vector<double>(),
          "content adjoint", {37, 99, 235})
      .lines(alpha.detach().to_vector<double>(), sg.to_vector<double>(), "style adjoint",
             {220, 38, 38})
      .title("Actual signed objective derivatives")
      .x_label("feature scale alpha")
      .y_label("loss derivative w.r.t.alpha")
      .y_limits(-2500, 7000);
  std::print("Exact match alpha1 gives content/style0. Separate initial scaling balances "
             "fixed losses in the real pixel fit.\n");
  auto layout = dm::graphics::RLayout::create(1, 2);
  layout.add(a).add(b).size(1100, 500).fit_panels().save_svg(
      "build/gatys_style_transfer_losses.svg");
}
```
