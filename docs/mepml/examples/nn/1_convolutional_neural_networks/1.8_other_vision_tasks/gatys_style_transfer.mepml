> Genuine source images and pretrained weights

Use the official Keras no-top VGG19 HDF5 and the original TensorFlow tutorial
Labrador/Kandinsky JPEGs. The preparation script verifies pinned byte sizes and
SHA256 fingerprints,then decodes all16 convolution pairs without modifying
weights. The separate pinned TensorFlow CPU environment is used only to make
independent Keras feature/objective/every-image-gradient test fixtures.

```{cpp, flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
  const std::filesystem::path cache = dm::datasets::data_home();
  dm::datasets::prepare_example_data("style", (cache / "style_transfer").string());
}
```
// result_begin:
// result_end

The C++ preparation helper requires HDF5 C++ and datamunge via pkg-config.
Report images decode from the original JPEG,center-square crop with integer
floor offsets,legacy bilinear resize to64x64,and tensor RGB/255. They are two
source images for an optimization problem,not a held-out learning benchmark.
The content photo is Elf’s Yellow Labrador Looking,CC BY-SA3.0;the style is
Wassily Kandinsky’s Composition VII(1913),from the tutorial’s source mirror.
```{cpp, results="markdown", file="figures/gatys_style_transfer_data.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

#include <print>
int main() {
  namespace n = dm::nn;
  namespace m = n::models;
  n::set_num_threads(2);

  std::filesystem::path cache;
  if (const auto *p = std::getenv("DATAMUNGE_DATA_DIR"))
    cache = p;
  else if (const auto *p = std::getenv("XDG_CACHE_HOME"))
    cache = std::filesystem::path(p) / "datamunge/datasets";
  else
    cache = std::filesystem::path(std::getenv("HOME")) / ".cache/datamunge/datasets";

  std::filesystem::path assets = cache / "style_transfer";
  if (const auto *p = std::getenv("DATAMUNGE_STYLE_DIR"))
    assets = p;
  else
    dm::datasets::prepare_example_data("style", assets.string());

  const auto content = m::LoadStyleImage(assets / "content.jpg", 64),
             style = m::LoadStyleImage(assets / "style.jpg", 64);
  std::filesystem::create_directories("figures");
  n::save_image_grid(n::concat({content, style}, 2), "figures/gatys_style_transfer_inputs.png",
                     1, 0, 1, 0, 0, 4);
  const auto edges = n::arange(0., 1.0001, .025, n::DType::Float64),
             left = n::slice_axis(edges, 0, 0, 40), right = n::slice_axis(edges, 0, 1, 41),
             centers = (left + right) / 2.;
  auto a = dm::graphics::RPlot::create(), b = dm::graphics::RPlot::create();
  const std::array<dm::graphics::RGB, 3> colors = {
      {{220, 38, 38}, {22, 163, 74}, {37, 99, 235}}};
  for (int c = 0; c < 3; ++c) {
    for (int image = 0; image < 2; ++image) {
      const auto values = n::select(image == 0 ? content : style, 3, c)
                              .to(n::DType::Float64)
                              .reshape({-1, 1}),
                 hits = n::logical_and(n::greater_equal(values, left.reshape({1, 40})),
                                       n::less(values, right.reshape({1, 40}))),
                 density = n::sum(hits.to(n::DType::Float64), {0}) / (values.size(0) * .025);
      auto &p = image == 0 ? a : b;
      p.lines(centers.to_vector<double>(), density.to_vector<double>(),
              std::string(1, std::string("RGB")[c]), colors[c]);
    }
  }
  a.title("Actual content RGB distribution")
      .x_label("encoded unit RGB")
      .y_label("channel density")
      .y_limits(0, 7);
  b.title("Actual painting RGB distribution")
      .x_label("encoded unit RGB")
      .y_label("channel density")
      .y_limits(0, 7);
  auto layout = dm::graphics::RLayout::create(1, 2);
  layout.add(a).add(b).size(1100, 500).fit_panels().save_svg(
      "build/gatys_style_transfer_data.svg");
  std::print("Two original JPEGs center-cropped/resized to64x64;no synthetic replacement or "
             "learned preprocessing.\n");
}
