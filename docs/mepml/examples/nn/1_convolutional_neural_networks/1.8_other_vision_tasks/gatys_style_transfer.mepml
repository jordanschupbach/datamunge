> Optimize generated pixels with an explicit projected Adam loop

Only the12,288 generated64x64 RGB values are optimizer leaves. Initialize
as.75*content+.25*seeded uniform noise;host code draws RNG samples only,
while tensor arithmetic mixes pixels. Cache fixed content features and painting
Grams without recording gradients. Balance raw losses with their initial
Float32 denominators,then hold these denominators and targets fixed.

Show all30 Adam(.03) updates. After each step,project the same image leaf to
[0,1] in place. Select and restore the minimum combined objective over steps0..30.
Check that every pretrained value remains unchanged,targets remain unchanged,
restoration matches the selected objective,and image gradients remain finite.
This example optimizes one output image using source feature targets;it is
not a feed-forward model trained for target-free stylization of new content.
```{cpp, results="markdown", file="figures/gatys_style_transfer_training.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

#include <print>
#include <random>
int main() {
  namespace n = dm::nn;
  namespace m = n::models;
  n::set_num_threads(2);

  std::filesystem::path cache;
  if (const auto *p = std::getenv("DATAMUNGE_DATA_DIR"))
    cache = p;
  else if (const auto *p = std::getenv("XDG_CACHE_HOME"))
    cache = std::filesystem::path(p) / "datamunge/datasets";
  else
    cache = std::filesystem::path(std::getenv("HOME")) / ".cache/datamunge/datasets";

  std::filesystem::path assets = cache / "style_transfer";
  if (const auto *p = std::getenv("DATAMUNGE_STYLE_DIR"))
    assets = p;
  else
    dm::datasets::prepare_example_data("style", assets.string());

  const auto weights = m::LoadTensorMap((assets / "vgg19.npz").string());
  m::FrozenVgg19 vgg(weights);
  const auto content = m::LoadStyleImage(assets / "content.jpg", 64),
             style = m::LoadStyleImage(assets / "style.jpg", 64);
  std::mt19937 rng(17);
  std::uniform_real_distribution<float> draw(0, 1);
  std::vector<float> samples(content.numel());
  for (auto &sample : samples)
    sample = draw(rng);
  const auto initial = .75 * content + .25 * n::from_vector(samples, content.shape());
  auto image = initial.clone().requires_grad_();
  n::Tensor content_target;
  std::array<n::Tensor, 5> targets;
  {
    n::NoGradGuard guard;
    content_target = vgg.Extract(content).content;
    const auto s = vgg.Extract(style);
    for (int i = 0; i < 5; ++i)
      targets[i] = m::StyleGram(s.style[i]);
  }
  const auto target_snapshot = content_target.clone();
  std::array<n::Tensor, 5> style_snapshot;
  for (int i = 0; i < 5; ++i)
    style_snapshot[i] = targets[i].clone();
  auto raw = [&] {
    const auto f = vgg.Extract(image);
    return std::array<n::Tensor, 2>{m::GatysContentLoss(f.content, content_target),
                                    m::GatysStyleLoss(f.style, targets)};
  };
  double initial_content = 0, initial_style = 0;
  {
    n::NoGradGuard guard;
    const auto r = raw();
    initial_content = r[0].item();
    initial_style = r[1].item();
  }
  if (initial_content <= 1e-12 || initial_style <= 1e-12)
    return 1;
  const double content_scale = double(float(initial_content)),
               style_scale = double(float(initial_style));
  auto objective = [&] {
    const auto r = raw();
    return std::array<n::Tensor, 3>{r[0] / content_scale + r[1] / style_scale, r[0], r[1]};
  };
  n::OptimizerConfig config;
  config.kind = n::OptimizerKind::Adam;
  n::Optimizer adam(std::vector<n::Tensor>{image}, .03, config);
  std::filesystem::create_directories("build");
  std::filesystem::create_directories("figures");
  double best = INFINITY;
  int selected = -1;
  std::vector<double> steps, total, relative_content, relative_style;
  std::print("Only{} pixel scalars optimized;VGG32 tensors/20024384 values frozen.\nFixed "
             "initial raw content/style {:.6f}/{:.6f}.\n| step | objective | relative content "
             "| relative style |\n|---:|---:|---:|---:|\n",
             image.numel(), initial_content, initial_style);
  for (int step = 0; step <= 30; ++step) {
    if (step) {
      const auto losses = objective();
      adam.step(n::grad(losses[0], {image}));
      n::NoGradGuard guard;
      image.copy_(n::clip(image, 0., 1.));
    }
    n::NoGradGuard guard;
    const auto losses = objective();
    const double value = losses[0].item();
    if (!std::isfinite(value))
      return 1;
    steps.push_back(step);
    total.push_back(value);
    relative_content.push_back(losses[1].item() / initial_content);
    relative_style.push_back(losses[2].item() / initial_style);
    if (value < best) {
      best = value;
      selected = step;
      n::save_npz("build/gatys_style_transfer_best.npz", {{"image/pixels", image.detach()}});
    }
    std::print("| {} | {:.6f} | {:.6f} | {:.6f} |\n", step, value, relative_content.back(),
               relative_style.back());
  }
  {
    n::NoGradGuard guard;
    image.copy_(n::load_npz("build/gatys_style_transfer_best.npz").at(0).second);
  }
  const auto restored = objective();
  const double gradient = n::sqrt(n::sum(n::square(n::grad(restored[0], {image})[0]))).item(),
               change = n::mean(n::abs(image.detach() - initial)).item();
  if (std::abs(restored[0].item() - best) > 1e-6 || best >= total.front() - 1e-3 ||
      restored[2].item() >= initial_style * .999 || !std::isfinite(gradient) ||
      gradient <= 0 || change <= 1e-4)
    return 1;
  vgg.CheckFrozen();
  if (!n::all(n::equal(content_target, target_snapshot)).item<bool>())
    return 1;
  for (int i = 0; i < 5; ++i)
    if (!n::all(n::equal(targets[i], style_snapshot[i])).item<bool>())
      return 1;
  const auto result = image.detach().clone();
  std::print(
      "Selected step{},restored objective {:.6f};relative content/style {:.6f}/{:.6f};image "
      "gradient norm {:.6f};mean pixel change {:.6f}.\nAll32 frozen weight tensors and six "
      "feature targets unchanged;checkpoint contains generated image only.\n",
      selected, best, restored[1].item() / initial_content, restored[2].item() / initial_style,
      gradient, change);
  n::save_image_grid(n::concat({content, style, initial, result}, 2),
                     "figures/gatys_style_transfer_comparison.png", 1, 0, 1, 0, 0, 4);
  n::save_npz(
      "build/gatys_style_transfer_outputs.npz",
      {{"content", content}, {"style", style}, {"initial", initial}, {"stylized", result}});
  const auto changed = n::mean(n::abs(result - initial), {3}), color = n::mean(result, {1, 2});
  auto a = n::plot_tensor_map(n::reverse(changed.reshape({64, 64}), {0}), 0, .4),
       b = dm::graphics::RPlot::create();
  a.title("Actual generated-pixel change")
      .x_label("generated column")
      .y_label("row0 at bottom");
  b.bars({0., 1., 2.}, color.to_vector<double>(), "stylized RGB", {147, 51, 234})
      .title("Restored output mean RGB")
      .x_label("0 red,1 green,2 blue")
      .y_label("encoded unit value")
      .y_limits(0, 1.2);
  auto diagnostic = dm::graphics::RLayout::create(1, 2);
  diagnostic.add(a).add(b).size(1100, 500).fit_panels().save_svg(
      "build/gatys_style_transfer_change.svg");
  std::filesystem::copy_file("build/gatys_style_transfer_change.svg",
                             "figures/gatys_style_transfer_change.svg",
                             std::filesystem::copy_options::overwrite_existing);
  a = dm::graphics::RPlot::create();
  b = dm::graphics::RPlot::create();
  a.lines(steps, total, "combined", {37, 99, 235})
      .title("Thirty explicit projected Adam steps")
      .x_label("pixel update")
      .y_label("fixed-scale combined objective")
      .y_limits(0, 2.8);
  b.lines(steps, relative_content, "content ratio", {37, 99, 235})
      .lines(steps, relative_style, "style ratio", {220, 38, 38})
      .title("Both fixed targets remain unchanged")
      .x_label("pixel update")
      .y_label("loss divided by initial raw loss")
      .y_limits(0, 1.8);
  auto curves = dm::graphics::RLayout::create(1, 2);
  curves.add(a).add(b).size(1100, 500).fit_panels().save_svg(
      "build/gatys_style_transfer_training.svg");
}
```
