> Full frozen features and an independent gradient oracle

The archive contains20,024,384 Float32 values in32 tensors. The selected
extractor executes12,944,960 values through block5_conv1,with average pools
instead of the ImageNet classification model’s max pools. Content is conv4_2;
style is conv1_1 through conv5_1. Every imported constant is a detached clone
outside the generated image’s optimizer. Native tests compare all six feature
arrays,all objectives and every input derivative with independent Keras.
The preview shows channelwise feature RMS,not learned attention or saliency.
```{cpp, results="markdown", file="figures/gatys_style_transfer_features.png", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

#include <print>
int main() {
  namespace n = dm::nn;
  namespace m = n::models;
  n::set_num_threads(2);

  std::filesystem::path cache;
  if (const auto *p = std::getenv("DATAMUNGE_DATA_DIR"))
    cache = p;
  else if (const auto *p = std::getenv("XDG_CACHE_HOME"))
    cache = std::filesystem::path(p) / "datamunge/datasets";
  else
    cache = std::filesystem::path(std::getenv("HOME")) / ".cache/datamunge/datasets";

  std::filesystem::path assets = cache / "style_transfer";
  if (const auto *p = std::getenv("DATAMUNGE_STYLE_DIR"))
    assets = p;
  else
    dm::datasets::prepare_example_data("style", assets.string());

  const auto weights = m::LoadTensorMap((assets / "vgg19.npz").string());
  m::FrozenVgg19 vgg(weights);
  const auto content = m::LoadStyleImage(assets / "content.jpg", 64);
  n::NoGradGuard guard;
  const auto features = vgg.Extract(content);
  std::int64_t scalars = 0;
  for (const auto &[name, value] : weights)
    scalars += value.numel();
  std::print("{} genuine imported tensors,{} scalars;all constants require_grad=false.\n| "
             "layer | H | W | channels | RMS |\n|---|---:|---:|---:|---:|\n",
             weights.size(), scalars);
  std::vector<n::Tensor> maps;
  for (int i = 0; i < 5; ++i) {
    const auto f = features.style[i];
    std::print("| conv{}_1 | {} | {} | {} | {:.6f} |\n", i + 1, f.size(1), f.size(2),
               f.size(3), n::sqrt(n::mean(f * f)).item());
    const auto rms = n::sqrt(n::mean(n::square(f), {3}, true));
    const auto scaled = rms / n::maximum(n::max(rms), n::full({}, 1e-12));
    const auto display = n::resize_nearest(scaled, {64, 64});
    maps.push_back(n::concat({display, display, display}, 3));
  }
  std::print("| conv4_2 content | {} | {} | {} | {:.6f} |\n", features.content.size(1),
             features.content.size(2), features.content.size(3),
             n::sqrt(n::mean(n::square(features.content))).item());
  vgg.CheckFrozen();
  std::filesystem::create_directories("build");
  n::save_image_grid(n::concat(maps, 0), "build/gatys_style_transfer_features.png", 5, 0, 1, 2,
                     0, 3);
}
```
