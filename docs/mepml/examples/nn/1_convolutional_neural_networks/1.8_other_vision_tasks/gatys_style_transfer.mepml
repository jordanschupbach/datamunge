> Gram statistics discard spatial order within each image

Flatten H*W positions to F[M,C],then compute G=F^T*F/M separately per image.
A spatial permutation changes content features but leaves this channel Gram
unchanged. A Gram matrix is an uncentered channel correlation summary;it
does not specify where a painted structure should appear. No batch images mix.
```{cpp, results="markdown", file="figures/gatys_style_transfer_gram.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

#include <print>
int main() {
  namespace n = dm::nn;
  namespace m = n::models;
  const auto features =
                 n::arange(1, 13, 1, n::DType::Float64).reshape({1, 2, 3, 2}).requires_grad_(),
             permuted = n::reverse(features, {1, 2});
  const auto gram = m::StyleGram(features), other = m::StyleGram(permuted),
             up = n::tensor({1., -2., 3., .5}, {1, 2, 2}).to(n::DType::Float64),
             g = n::grad(n::sum(gram * up), {features})[0];
  std::print("Spatial permutation:Gram maximum difference {:.3g};content loss {:.6f};all12 "
             "adjoints finite:{}\n",
             n::max(n::abs(gram - other)).item(),
             m::GatysContentLoss(features, permuted).item(),
             n::all(n::is_finite(g)).item<bool>());
  auto a = n::plot_tensor_map(n::reverse(gram.reshape({2, 2}), {0}), 0, 61),
       b = n::plot_tensor_map(n::reverse(g.reshape({6, 2}), {0}), 0, 6);
  a.title("Per-image normalized Gram")
      .x_label("feature channel")
      .y_label("feature channel,row0 at bottom");
  b.title("Nonsymmetric Gram upstream")
      .x_label("feature channel")
      .y_label("source position0 at bottom");
  auto layout = dm::graphics::RLayout::create(1, 2);
  layout.add(a).add(b).size(1100, 500).fit_panels().save_svg(
      "build/gatys_style_transfer_gram.svg");
}
```
