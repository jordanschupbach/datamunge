> Fixed ImageNet preprocessing remains differentiable

The pretrained Keras convolution weights expect encoded RGB unit values
reordered to BGR,multiplied by255,and shifted by103.939/116.779/123.68.
The transformation has a channel-permutation derivative scaled by255.
Do not fit new means or convert these pixels to gamma-linear RGB. This
preprocessing matches the imported weights;it is not a learned optimizer step.
```{cpp, results="markdown", file="figures/gatys_style_transfer_preprocess.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

#include <print>
int main() {
  namespace n = dm::nn;
  namespace m = n::models;
  const auto red = n::arange(0., 1.0001, .01, n::DType::Float64), zero = n::zeros_like(red),
             rgb = n::stack({red, zero, 1. - red}, 1).reshape({1, 1, -1, 3}).requires_grad_();
  const auto bgr = m::VggImageNetInput(rgb),
             weights = n::from_vector(std::vector<double>{.2, -.3, .7}, {3}),
             g = n::grad(n::sum(bgr * weights), {rgb})[0];
  std::print("RGB adjoint at first pixel:{};expected[178.5,-76.5,51].\n",
             n::slice_axis(g, 2, 0, 1));
  auto a = dm::graphics::RPlot::create(), b = dm::graphics::RPlot::create();
  const std::array<dm::graphics::RGB, 3> colors = {
      {{37, 99, 235}, {22, 163, 74}, {220, 38, 38}}};
  for (int c = 0; c < 3; ++c) {
    a.lines(red.to_vector<double>(), n::select(bgr, 3, c).to_vector<double>(),
            std::string("BGR")[c] + std::string(" centered"), colors[c]);
    b.lines(red.to_vector<double>(), n::select(g, 3, c).to_vector<double>(),
            std::string("RGB")[c] + std::string(" derivative"), colors[c]);
  }
  a.title("ImageNet-centered BGR input")
      .x_label("observed red value,blue=1-red")
      .y_label("pretrained feature input units")
      .y_limits(-130, 200);
  b.title("Fixed channel-permutation adjoint")
      .x_label("observed red value")
      .y_label("weighted sum derivative")
      .y_limits(-110, 240);
  auto layout = dm::graphics::RLayout::create(1, 2);
  layout.add(a).add(b).size(1100, 500).fit_panels().save_svg(
      "build/gatys_style_transfer_preprocess.svg");
}
```
