> Shared features, symmetric score

The two branches call the same encoder with the same parameter store. If
\(h_a=f_\theta(a)\) and \(h_b=f_\theta(b)\),the learned similarity logit is

$$z(a,b)=b_0+\sum_jw_j|h_{aj}-h_{bj}|,\qquad p(\text{same}\mid a,b)=\sigma(z).$$
\alttext(The logit adds a bias to a learned weighted absolute embedding difference;sigmoid gives the same-class probability.)

Swapping inputs preserves every absolute difference. Identical embeddings
produce the bias,regardless of their values. The weights are unconstrained,
so this score need not define a mathematical distance metric.
For target y,the stable binary cross entropy has derivative
\(\partial\ell/\partial z=\sigma(z)-y\). Our zero-logit derivative is exactly
.5-y;equal embedding coordinates use the zero subgradient of absolute value.
The native independent hand oracle verifies all input,weight and bias
derivatives,including logits +/-1000 and zero.

```{cpp, results="markdown", file="figures/siamese_objective.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

#include <print>
int main() {
  namespace n = dm::nn;
  n::ParameterStore p(0);
  const auto a = n::tensor({.1, .8, -.2, .4, -.5, .7}, {2, 3}),
             b = n::tensor({-.4, .2, .9, .4, .6, -.3}, {2, 3});
  n::models::SiameseLogit(p, a, b, 3);
  p.set("similarity/W", n::tensor({-.7, .4, 1.2}, {3, 1}));
  p.set("similarity/b", n::tensor({-.2}));
  const auto z = n::models::SiameseLogit(p, a, b, 3);
  if (n::sum(n::abs(z - n::models::SiameseLogit(p, b, a, 3))).item() != 0)
    return 1;
  auto logits = n::linspace(-6, 6, 121).requires_grad_();
  const auto same = n::models::SiameseBinaryCrossEntropy(logits, n::ones_like(logits));
  const auto different = n::models::SiameseBinaryCrossEntropy(logits, n::zeros_like(logits));
  const auto derivative = n::grad(n::sum(same), {logits})[0];
  auto loss = dm::graphics::RPlot::create(), grad = dm::graphics::RPlot::create();
  const auto x = logits.to_vector<double>();
  loss.lines(x, same.to_vector<double>(), "same", {37, 99, 235})
      .lines(x, different.to_vector<double>(), "different", {220, 38, 38})
      .title("Verification cross entropy")
      .x_label("similarity logit")
      .y_label("per-pair BCE")
      .y_limits(0, 7.5);
  grad.lines(x, derivative.to_vector<double>(), "same gradient", {22, 163, 74})
      .title("Same-pair logit derivative")
      .x_label("similarity logit")
      .y_label("sigmoid(z)-1")
      .y_limits(-1.15, .2);
  std::filesystem::create_directories("build");
  auto layout = dm::graphics::RLayout::create(1, 2);
  layout.add(loss).add(grad).size(1100, 480).fit_panels().save_svg(
      "build/siamese_objective.svg");
  std::print("Controlled logits {:.6f},{:.6f};swap difference exactly0;identical score=-.2. "
             "Stable BCE and every hand derivative checked in native fixtures. No fitting.\n",
             z.to_vector<float>()[0], z.to_vector<float>()[1]);
}
```
