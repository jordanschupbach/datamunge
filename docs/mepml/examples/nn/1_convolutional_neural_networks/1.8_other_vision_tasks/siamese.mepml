> Visible Adam and one-shot checkpoint selection

The complete compact model fits96 explicit Adam(.001) updates:three epochs
of1024 newly sampled balanced pairs,batch32. Every shared leaf is created
before the optimizer. The objective is mean BCE plus`.00005*sum(kernel²)`;
this is the equivalent half-coefficient form of an L2 strength.0001.
Bilinear28→48 resizing retains the source coordinate convention.

Checkpoint selection maximizes128 fixed2-way validation tasks,breaking ties
with256 fixed validation pair BCE. Restoration must reproduce both before
512 fixed test pairs and256 fixed3-way tasks are scored. The pixel baseline
uses negative squared byte-pixel distance with no learning. An untrained
network uses the same held-out tasks;its scores are measured before fitting.

```{cpp, results="markdown", file="figures/siamese_training.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

#include <print>
int main() {
  namespace n = dm::nn;
  namespace m = n::models;
  n::set_num_threads(2);

  std::filesystem::path cache;
  if (const auto *p = std::getenv("DATAMUNGE_DATA_DIR"))
    cache = p;
  else if (const auto *p = std::getenv("XDG_CACHE_HOME"))
    cache = std::filesystem::path(p) / "datamunge/datasets";
  else
    cache = std::filesystem::path(std::getenv("HOME")) / ".cache/datamunge/datasets";
  dm::datasets::fetch("mnist", (cache / "mnist").string());

  const auto train = n::load_mnist((cache / "mnist").string(), "train"),
             test = n::load_mnist((cache / "mnist").string(), "test");
  if (train.images.shape()[0] != 60000 || test.images.shape()[0] != 10000)
    return 1;
  const auto fitting = m::SiameseBuckets(train, {0, 1, 2, 3, 4}),
             validation = m::SiameseBuckets(train, {5, 6}),
             testing = m::SiameseBuckets(test, {7, 8, 9});
  const auto validation_pairs = m::SiamesePairs(validation, 256, 41),
             test_pairs = m::SiamesePairs(testing, 512, 43),
             probe = m::SiamesePairs(fitting, 256, 47);
  const auto validation_tasks = m::SiameseTasks(validation, 128, 53),
             test_tasks = m::SiameseTasks(testing, 256, 59);
  n::ParameterStore p(17);
  const auto c = m::SiameseConfig::Compact();
  const auto forward = [&](const n::Tensor &left, const n::Tensor &right) {
    const auto a = m::SiameseEncoder(p, n::resize_bilinear(left, {48, 48}), c),
               b = m::SiameseEncoder(p, n::resize_bilinear(right, {48, 48}), c);
    return m::SiameseLogit(p, a.embedding, b.embedding, c.embedding);
  };
  // Warm all twelve leaves before constructing Adam;there is no BN or other state.
  {
    n::NoGradGuard guard;
    forward(n::zeros({1, 28, 28, 1}), n::zeros({1, 28, 28, 1}));
  }
  const auto score_pairs = [&](const n::ImageDataset &data,
                               const std::vector<m::VerificationPair> &pairs) {
    n::NoGradGuard guard;
    std::vector<n::Tensor> logits;
    for (std::size_t start = 0; start < pairs.size(); start += 64) {
      const auto end = std::min(pairs.size(), start + 64);
      const auto b = m::MakeSiameseBatch(data, {pairs.begin() + start, pairs.begin() + end});
      logits.push_back(forward(b.left, b.right));
    }
    return n::concat(logits, 0);
  };
  const auto pair_metrics = [&](const n::ImageDataset &data,
                                const std::vector<m::VerificationPair> &pairs) {
    return m::SiameseVerificationMetrics(score_pairs(data, pairs),
                                         m::MakeSiameseBatch(data, pairs).labels);
  };
  const auto episode_scores = [&](const n::ImageDataset &data,
                                  const std::vector<m::OneShotTask> &tasks) {
    std::vector<m::VerificationPair> pairs;
    for (const auto &task : tasks)
      for (const auto row : task.support)
        pairs.push_back({task.query, row, 0});
    return score_pairs(data, pairs)
        .reshape({std::int64_t(tasks.size()), std::int64_t(tasks.front().support.size())});
  };
  const auto targets = [](const std::vector<m::OneShotTask> &tasks) {
    std::vector<std::int64_t> ids;
    for (const auto &task : tasks)
      ids.push_back(task.correct);
    return n::from_vector(ids);
  };
  const auto val_targets = targets(validation_tasks), test_targets = targets(test_tasks);
  const double
      initial = pair_metrics(train, probe).to_vector<double>()[0],
      untrained =
          m::SiameseOneShotAccuracy(episode_scores(test, test_tasks), test_targets).item(),
      pixel = m::SiameseOneShotAccuracy(m::SiamesePixelScores(test, test_tasks), test_targets)
                  .item();
  std::vector<n::Tensor> kernels;
  for (const auto &leaf : p.parameters())
    if (leaf.dim() > 1)
      kernels.push_back(leaf);
  n::OptimizerConfig config;
  config.kind = n::OptimizerKind::Adam;
  n::Optimizer adam(p, .001, config);
  std::filesystem::create_directories("build");
  std::filesystem::create_directories("figures");
  std::vector<double> epochs, losses, val_loss, val_accuracy;
  double best = -1, best_loss = INFINITY;
  int selected = 0, steps = 0;
  std::print(
      "| epoch | fitting BCE | validation BCE | validation2-way |\n|---:|---:|---:|---:|\n");
  for (int epoch = 1; epoch <= 3; ++epoch) {
    const auto pairs = m::SiamesePairs(fitting, 1024, 100 + epoch);
    double total = 0;
    for (std::size_t start = 0; start < pairs.size(); start += 32) {
      const auto batch =
          m::MakeSiameseBatch(train, {pairs.begin() + start, pairs.begin() + start + 32});
      const auto logits = forward(batch.left, batch.right);
      const auto bce = n::mean(m::SiameseBinaryCrossEntropy(logits, batch.labels));
      auto penalty = n::zeros({});
      for (const auto &w : kernels)
        penalty = penalty + n::sum(n::square(w));
      if (!std::isfinite(bce.item()))
        return 1;
      total += bce.item();
      adam.minimize(bce + .00005 * penalty);
      ++steps;
    }
    const double loss = pair_metrics(train, validation_pairs).to_vector<double>()[0],
                 accuracy = m::SiameseOneShotAccuracy(episode_scores(train, validation_tasks),
                                                      val_targets)
                                .item();
    epochs.push_back(epoch);
    losses.push_back(total / 32);
    val_loss.push_back(loss);
    val_accuracy.push_back(accuracy);
    if (accuracy > best || (accuracy == best && loss < best_loss)) {
      best = accuracy;
      best_loss = loss;
      selected = epoch;
      p.save("build/siamese_best.npz");
    }
    std::print("| {} | {:.6f} | {:.6f} | {:.6f} |\n", epoch, losses.back(), loss, accuracy);
  }
  p.load("build/siamese_best.npz");
  if (std::abs(pair_metrics(train, validation_pairs).to_vector<double>()[0] - best_loss) >
          1e-7 ||
      m::SiameseOneShotAccuracy(episode_scores(train, validation_tasks), val_targets).item() !=
          best)
    return 1;
  const auto metrics = pair_metrics(test, test_pairs).to_vector<double>();
  const auto scores = episode_scores(test, test_tasks);
  const auto accuracy = m::SiameseOneShotAccuracy(scores, test_targets).item();
  const auto final = pair_metrics(train, probe).to_vector<double>()[0];
  n::save_image_grid(m::SiameseEpisodeGallery(test, test_tasks, scores),
                     "build/siamese_episodes.png", 1, 0, 1, 2, 1, 2);
  std::filesystem::copy_file("build/siamese_episodes.png", "figures/siamese_episodes.png",
                             std::filesystem::copy_options::overwrite_existing);
  std::print(
      "{} explicit Adam updates;selected epoch{};restored validation2-way {:.6f}/BCE "
      "{:.6f};fixed fitting BCE {:.6f}->{:.6f}.\n512 balanced unseen-class test pairs:BCE "
      "{:.6f},accuracy {:.6f},TP/FP/FN/TN {:.0f}/{:.0f}/{:.0f}/{:.0f};same/different "
      "probabilities {:.6f}/{:.6f}.\n256 unseen-class3-way tasks:trained {:.6f},untrained "
      "{:.6f},byte-pixel nearest {:.6f},chance1/3.\n",
      steps, selected, best, best_loss, initial, final, metrics[0], metrics[1], metrics[4],
      metrics[5], metrics[6], metrics[7], metrics[2], metrics[3], accuracy, untrained, pixel);
  std::print(
      "| episode | correct support column | selected support column |\n|---:|---:|---:|\n");
  const auto choices = n::argmax(scores, 1).to_vector<std::int64_t>();
  for (int i = 0; i < 8; ++i)
    std::print("| {} | {} | {} |\n", i, test_tasks[i].correct, choices[i]);
  auto a = dm::graphics::RPlot::create(), b = dm::graphics::RPlot::create();
  a.lines(epochs, losses, "fitting BCE", {37, 99, 235})
      .lines(epochs, val_loss, "validation BCE", {220, 38, 38})
      .title("Fitting and unseen-class BCE")
      .x_label("epoch")
      .y_label("mean pair BCE")
      .y_limits(0, 1.05);
  b.lines(epochs, val_accuracy, "validation2way", {22, 163, 74})
      .title("Validation one-shot selection")
      .x_label("epoch")
      .y_label("fraction correct;2-way tasks")
      .y_limits(0, 1.2);
  auto layout = dm::graphics::RLayout::create(1, 2);
  layout.add(a).add(b).size(1100, 480).fit_panels().save_svg("build/siamese_training.svg");
}
```
