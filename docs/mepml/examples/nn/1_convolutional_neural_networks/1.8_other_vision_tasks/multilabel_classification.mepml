> Visible weighted Adam,paired BN restore and separate calibration

The complete compact model fits30 visible Adam(.001) updates:three epochs,
batch8,all80 fitting images once per epoch,shuffle263. Every learned leaf is
created before Adam. Training uses weighted BCE and updates moving moments;
training-mode probe losses use current batch moments **without updates**.
Validation uses frozen moving moments and unweighted probability BCE. These
losses have different weighting policies and are labelled separately.

Minimum validation BCE selects **both** learned parameters and BN state.
Restoring both must reproduce that score before threshold calibration. Learned,
untrained and saved SGD-prior probabilities each receive their own global
validation micro-F1 cutoff. The all-negative reference has no fitted parameters.
No test targets select a checkpoint,weight or cutoff.

Independent deployment constructs no optimizer or class weights. It accepts
observed RGB with restored learned/BN stores;cloned snapshots verify all102
tensors remain unchanged. Repeated inference is exact,single/batch predictions
agree,and different images must produce different probabilities. All24 held-out
images and their annotation/decision bitmaps are displayed after those checks.

```{cpp, results="markdown", file="figures/multilabel_classification_training.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

#include <print>
int main() {
  namespace n = dm::nn;
  namespace m = n::models;
  n::set_num_threads(2);

  std::filesystem::path cache;
  if (const auto *p = std::getenv("DATAMUNGE_DATA_DIR"))
    cache = p;
  else if (const auto *p = std::getenv("XDG_CACHE_HOME"))
    cache = std::filesystem::path(p) / "datamunge/datasets";
  else
    cache = std::filesystem::path(std::getenv("HOME")) / ".cache/datamunge/datasets";

  std::filesystem::path root = cache / "multilabel";
  if (const auto *p = std::getenv("DATAMUNGE_MULTILABEL_DIR"))
    root = p;
  else
    dm::datasets::prepare_example_data("multilabel", root.string());

  const auto data = m::LoadMultilabel(root);
  const auto weights = m::MultilabelWeights(data.fit.labels);
  n::ParameterStore p(251), state(257);
  const auto base = m::MultilabelConfig();
  const auto forward = [&](n::ParameterStore &learned, n::ParameterStore &moving,
                           const n::Tensor &images, bool training, bool update) {
    auto cfg = base;
    cfg.update_stats = update;
    return m::ResNet(learned, moving, images - .5, cfg, training).logits;
  };
  // Warm all62 learned leaves and40 moving-moment tensors before Adam.
  {
    n::NoGradGuard guard;
    forward(p, state, n::zeros({1, 64, 64, 3}), false, false);
  }
  const auto predict = [&](n::ParameterStore &learned, n::ParameterStore &moving,
                           const m::MultilabelData &batch) {
    n::NoGradGuard guard;
    std::vector<n::Tensor> parts;
    for (std::int64_t row = 0; row < batch.rgb.shape()[0]; row += 8)
      parts.push_back(n::sigmoid(
          forward(learned, moving,
                  n::slice_axis(batch.rgb, 0, row, std::min(row + 8, batch.rgb.shape()[0])),
                  false, false)));
    return n::concat(parts, 0);
  };
  const auto probe = m::MultilabelRows(data.fit, {0, 1, 2, 3, 4, 5, 6, 7});
  double initial;
  {
    n::NoGradGuard guard;
    initial = m::MultilabelObjective(forward(p, state, probe.rgb, true, false), probe.labels,
                                     weights)
                  .item();
  }
  const auto untrained_validation = predict(p, state, data.validation),
             untrained = predict(p, state, data.test);
  n::OptimizerConfig config;
  config.kind = n::OptimizerKind::Adam;
  n::Optimizer adam(p, .001, config);
  n::BatchOrder order(80, 8, 263);
  std::filesystem::create_directories("build");
  std::filesystem::create_directories("figures");
  std::vector<double> epochs, fit_loss, val_loss, val_ap;
  double best = INFINITY;
  int selected = 0, steps = 0;
  std::print(
      "{} learned/{} BN moving scalars;62 learned/40 moving tensors.\n| epoch | weighted "
      "fitting BCE | plain validation BCE | validation mAP |\n|---:|---:|---:|---:|\n",
      p.count(), state.count());
  for (int epoch = 1; epoch <= 3; ++epoch) {
    order.begin_epoch();
    double total = 0;
    int seen = 0;
    for (auto rows = order.next(); !rows.empty(); rows = order.next()) {
      const auto batch =
          m::MultilabelRows(data.fit, std::vector<std::size_t>(rows.begin(), rows.end()));
      const auto logits = forward(p, state, batch.rgb, true, true);
      const auto loss = m::MultilabelObjective(logits, batch.labels, weights);
      if (!std::isfinite(loss.item()))
        return 1;
      total += loss.item() * rows.size();
      seen += rows.size();
      adam.minimize(loss);
      ++steps;
    }
    if (seen != 80)
      return 1;
    const auto score =
        m::ScoreMultilabel(predict(p, state, data.validation), data.validation.labels);
    epochs.push_back(epoch);
    fit_loss.push_back(total / seen);
    val_loss.push_back(score.nll.item());
    val_ap.push_back(score.map.item());
    if (score.nll.item() < best) {
      best = score.nll.item();
      selected = epoch;
      p.save("build/multilabel_classification_best.npz");
      state.save("build/multilabel_classification_state.npz");
    }
    std::print("| {} | {:.6f} | {:.6f} | {:.6f} |\n", epoch, fit_loss.back(), val_loss.back(),
               val_ap.back());
  }
  p.load("build/multilabel_classification_best.npz");
  state.load("build/multilabel_classification_state.npz");
  const auto validation = predict(p, state, data.validation);
  if (std::abs(m::ScoreMultilabel(validation, data.validation.labels).nll.item() - best) >
      1e-8)
    return 1;
  double learned;
  {
    n::NoGradGuard guard;
    learned = m::MultilabelObjective(forward(p, state, probe.rgb, true, false), probe.labels,
                                     weights)
                  .item();
  }
  const double threshold = m::CalibrateMultilabel(validation, data.validation.labels).item(),
               untrained_threshold =
                   m::CalibrateMultilabel(untrained_validation, data.validation.labels).item();
  const auto fitted_prior =
      n::load_npz("build/multilabel_classification_prior.npz").at(0).second;
  const auto prior = n::ones({24, 80}) * fitted_prior.reshape({1, 80});
  const double prior_threshold = m::CalibrateMultilabel(prior, data.validation.labels).item();
  // Separate deployment stores:RGB and checkpoints only;no class weights or optimizer.
  n::ParameterStore deployed(991), moving(997);
  {
    n::NoGradGuard guard;
    forward(deployed, moving, n::zeros({1, 64, 64, 3}), false, false);
  }
  deployed.load("build/multilabel_classification_best.npz");
  moving.load("build/multilabel_classification_state.npz");
  std::vector<n::Tensor> snapshot;
  for (const auto *store : {&deployed, &moving})
    for (const auto &value : store->parameters())
      snapshot.push_back(value.clone());
  const auto probability = predict(deployed, moving, data.test),
             reference = predict(p, state, data.test),
             repeat = predict(deployed, moving, data.test);
  const double parity = n::max(n::abs(probability - reference)).item();
  if (parity > 1e-7 || n::max(n::abs(probability - repeat)).item() != 0)
    return 1;
  double sensitivity;
  {
    n::NoGradGuard guard;
    const auto one = n::sigmoid(
        forward(deployed, moving, m::MultilabelRows(data.test.rgb, {3}), false, false));
    if (n::max(n::abs(one - n::slice_axis(probability, 0, 3, 4))).item() > 2e-6)
      return 1;
    sensitivity = n::mean(n::abs(n::slice_axis(probability, 0, 0, 1) -
                                 n::slice_axis(probability, 0, 1, 2)))
                      .item();
    if (sensitivity <= 1e-6)
      return 1;
  }
  std::size_t i = 0;
  for (const auto *store : {&deployed, &moving})
    for (const auto &value : store->parameters())
      if (n::max(n::abs(value - snapshot[i++])).item() != 0)
        return 1;
  const auto fixed = m::ScoreMultilabel(probability, data.test.labels, .5),
             calibrated = m::ScoreMultilabel(probability, data.test.labels, threshold),
             before = m::ScoreMultilabel(untrained, data.test.labels, untrained_threshold),
             constant = m::ScoreMultilabel(prior, data.test.labels, prior_threshold),
             negative = m::ScoreMultilabel(n::zeros({24, 80}), data.test.labels, .5);
  std::print(
      "{} explicit Adam updates;selected epoch{},paired restored validation BCE {:.6f};fixed "
      "training-mode weighted BCE {:.6f}->{:.6f}. Learned/untrained/prior validation cutoffs "
      "{:.6f}/{:.6f}/{:.6f}.\nIndependent deployment parity {:.3g};repeat exact,single/batch "
      "agree,all62 learned+40 moving tensors immutable;mean image-pair probability difference "
      "{:.6f}.\nTest support:{} positive-support/{} absent classes,{} positive bits/1920.\n| "
      "model | mAP | microAP | mean bit NLL | mean bit Brier |\n|---|---:|---:|---:|---:|\n",
      steps, selected, best, initial, learned, threshold, untrained_threshold, prior_threshold,
      parity, sensitivity, calibrated.ap_classes.item<std::int64_t>(),
      calibrated.absent_classes.item<std::int64_t>(),
      (calibrated.tp + calibrated.fn).item<std::int64_t>());
  const auto ranking = [](const char *name, const m::TensorMultilabelMetrics &s) {
    std::print("| {} | {:.6f} | {:.6f} | {:.6f} | {:.6f} |\n", name, s.map.item(),
               s.micro_ap.item(), s.nll.item(), s.brier.item());
  };
  ranking("CNN fixed.5", fixed);
  ranking("CNN calibrated", calibrated);
  ranking("untrained calibrated", before);
  ranking("SGD prior calibrated", constant);
  ranking("all negative", negative);
  std::print("\nThresholded decisions.\n\n| model | cutoff | microF1 | macroF1 | Hamming | "
             "exact | TP/FP/FN/TN "
             "|\n|---|---:|---:|---:|---:|---:|---|\n");
  const auto decisions = [](const char *name, const m::TensorMultilabelMetrics &s, double t) {
    std::print("| {} | {:.2f} | {:.6f} | {:.6f} | {:.6f} | {:.6f} | {}/{}/{}/{} |\n", name, t,
               s.micro_f1.item(), s.macro_f1.item(), s.hamming.item(), s.exact.item(),
               s.tp.item<std::int64_t>(), s.fp.item<std::int64_t>(), s.fn.item<std::int64_t>(),
               s.tn.item<std::int64_t>());
  };
  decisions("CNN fixed.5", fixed, .5);
  decisions("CNN calibrated", calibrated, threshold);
  decisions("untrained calibrated", before, untrained_threshold);
  decisions("SGD prior calibrated", constant, prior_threshold);
  decisions("all negative", negative, .5);
  n::save_image_grid(m::MultilabelPreviewTiles(data.test, probability, threshold),
                     "build/multilabel_classification_predictions.png", 2, 0, 1, 2, 0, 2);
  std::filesystem::copy_file("build/multilabel_classification_predictions.png",
                             "figures/multilabel_classification_predictions.png",
                             std::filesystem::copy_options::overwrite_existing);
  std::vector<double> maps, f1;
  for (const auto *s : {&calibrated, &before, &constant, &negative}) {
    maps.push_back(s->map.item());
    f1.push_back(s->micro_f1.item());
  }
  auto a = dm::graphics::RPlot::create(), b = dm::graphics::RPlot::create();
  a.bars({0, 1, 2, 3}, maps, "class mAP", {37, 99, 235}, .6)
      .title("Present-class ranking performance")
      .x_label("0 CNN,1 init,2 prior,3 none")
      .y_label("mean grouped-tie class AP")
      .y_limits(0, 1.25);
  b.bars({0, 1, 2, 3}, f1, "micro F1", {22, 163, 74}, .6)
      .title("Thresholded held-out bit decisions")
      .x_label("0 CNN,1 init,2 prior,3 none")
      .y_label("micro F1 at validation cutoff")
      .y_limits(0, 1.25);
  auto metrics = dm::graphics::RLayout::create(1, 2);
  metrics.add(a).add(b).size(1100, 480).fit_panels().save_svg(
      "build/multilabel_classification_metrics.svg");
  std::filesystem::copy_file("build/multilabel_classification_metrics.svg",
                             "figures/multilabel_classification_metrics.svg",
                             std::filesystem::copy_options::overwrite_existing);
  a = dm::graphics::RPlot::create();
  b = dm::graphics::RPlot::create();
  a.lines(epochs, fit_loss, "weighted fit", {37, 99, 235})
      .lines(epochs, val_loss, "plain validation", {220, 38, 38})
      .title("Visible complete ResNet Adam fitting")
      .x_label("epoch")
      .y_label("mean BCE;different weight policies")
      .y_limits(0, 1.4);
  b.lines(epochs, val_ap, "validation mAP", {22, 163, 74})
      .title("Validation ranking is also reported")
      .x_label("epoch")
      .y_label("positive-support class mAP")
      .y_limits(0, 1.2);
  auto curves = dm::graphics::RLayout::create(1, 2);
  curves.add(a).add(b).size(1100, 480).fit_panels().save_svg(
      "build/multilabel_classification_training.svg");
}
```
