> Group score ties before computing average precision

AP weights precision by recall increments at **distinct score groups**.
A constant score therefore gives the positive prevalence,independent of row
order. This avoids treating arbitrary order within a tie as model discrimination.
Classes with no positive truth are reported and excluded from mAP;macro F1
still averages all80 classes,using zero when its class denominator is zero.

For the tiny probability/target matrices
\(P=[[.9,.8,.1],[.2,.8,.4]]\),\(Y=[[1,0,0],[0,1,0]]\),class APs are1 and.5;
the third class has no positive support. Thus mAP=.75,micro AP=5/6.
At cutoff.5,TP/FP/FN/TN=2/1/0/3,micro F1=.8,Hamming=1/6,and exact-image
match=.5. One **global validation** threshold is selected from.05 through.95
in.05 steps plus1.01(predict none). F1 ties within1e-12 take the highest cutoff.
Threshold selection changes decisions;it does not change ranking AP.

```{cpp, results="markdown", file="figures/multilabel_classification_ties.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

#include <print>
int main() {
  namespace n = dm::nn;
  namespace m = n::models;
  const auto p = n::tensor({.9, .8, .1, .2, .8, .4}, {2, 3}),
             y = n::tensor({1., 0., 0., 0., 1., 0.}, {2, 3});
  const auto score = m::ScoreMultilabel(p, y, .5);
  const auto selected = m::CalibrateMultilabel(p, y);
  if (std::abs(score.map.item() - .75) > 1e-12 ||
      std::abs(score.micro_ap.item() - 5. / 6) > 1e-12)
    return 1;
  const auto constant = m::MultilabelAP(n::full({4}, .5), n::tensor({1., 0., 1., 0.}));
  if (constant.item() != .5)
    return 1;
  const auto thresholds = n::arange(1, 20, 1, n::DType::Float64) * .05;
  std::vector<double> f1;
  for (const auto t : thresholds.to_vector<double>())
    f1.push_back(m::ScoreMultilabel(p, y, t).micro_f1.item());
  auto a = dm::graphics::RPlot::create(), b = dm::graphics::RPlot::create();
  a.bars({0, 1},
         {m::MultilabelAP(n::select(p, 1, 0), n::select(y, 1, 0)).item(),
          m::MultilabelAP(n::select(p, 1, 1), n::select(y, 1, 1)).item()},
         "present-class AP", {37, 99, 235}, .6)
      .title("Group ties before class AP")
      .x_label("present categories0 and1")
      .y_label("average precision")
      .y_limits(0, 1.3);
  b.lines(thresholds.to_vector<double>(), f1, "global micro F1", {22, 163, 74})
      .title("One validation threshold for all bits")
      .x_label("global probability cutoff")
      .y_label("micro F1 on the tiny fixture")
      .y_limits(0, 1.3);
  std::filesystem::create_directories("build");
  auto layout = dm::graphics::RLayout::create(1, 2);
  layout.add(a).add(b).size(1100, 480).fit_panels().save_svg(
      "build/multilabel_classification_ties.svg");
  std::print("Tiny fixture:mAP {:.6f},microAP {:.6f},microF1 {:.6f},macroF1 {:.6f},Hamming "
             "{:.6f},exact {:.6f};TP/FP/FN/TN {}/{}/{}/{};2 supported/1 absent class. "
             "Selected cutoff {:.6f};constant-score AP=.5. Native float32/double-cutoff and "
             "highest-tie tests pass.\n",
             score.map.item(), score.micro_ap.item(), score.micro_f1.item(),
             score.macro_f1.item(), score.hamming.item(), score.exact.item(),
             score.tp.item<std::int64_t>(), score.fp.item<std::int64_t>(),
             score.fn.item<std::int64_t>(), score.tn.item<std::int64_t>(), selected.item());
}
```
