> Fit the smoothed constant prior with visible SGD

A constant per-class reference should also show its fitted coordinates. Let
q_c be a free probability coordinate. Add one positive and one negative
pseudobit per class and minimize

$$L(q)=\frac1{N+2}\sum_c\left[\sum_i(q_c-y_{ic})^2+q_c^2+(q_c-1)^2\right].$$
\alttext(A smoothed per-class Brier objective adds one zero and one one to the fitting target bits.)

Its gradient is2(q_c-(pos_c+1)/(N+2)). Starting at zero,one explicit SGD(.5)
step reaches the Laplace-smoothed probability exactly. This is a Brier fit;
its optimum also gives the familiar smoothed Bernoulli prior. The code verifies
parity with the tensor count formula,saves the fitted probability vector,and
calibrates its global threshold using only validation targets.

```{cpp, results="markdown", file="figures/multilabel_classification_prior.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

#include <print>
int main() {
  namespace n = dm::nn;
  namespace m = n::models;

  std::filesystem::path cache;
  if (const auto *p = std::getenv("DATAMUNGE_DATA_DIR"))
    cache = p;
  else if (const auto *p = std::getenv("XDG_CACHE_HOME"))
    cache = std::filesystem::path(p) / "datamunge/datasets";
  else
    cache = std::filesystem::path(std::getenv("HOME")) / ".cache/datamunge/datasets";

  std::filesystem::path root = cache / "multilabel";
  if (const auto *p = std::getenv("DATAMUNGE_MULTILABEL_DIR"))
    root = p;
  else
    dm::datasets::prepare_example_data("multilabel", root.string());

  const auto data = m::LoadMultilabel(root);
  const auto labels = data.fit.labels.to(n::DType::Float64);
  n::ParameterStore prior(271, n::DType::Float64);
  const auto probability = prior.get("probability", {80}, n::init::zeros());
  n::OptimizerConfig config;
  config.kind = n::OptimizerKind::Sgd;
  n::Optimizer sgd(prior, .5, config);
  for (int step = 0; step < 1; ++step) {
    const auto objective = n::sum(n::sum(n::square(labels - probability), {0}) +
                                  n::square(probability) + n::square(probability - 1.)) /
                           double(labels.shape()[0] + 2);
    sgd.minimize(objective);
  }
  const auto fitted = probability.to(n::DType::Float32);
  const auto validation = n::ones({24, 80}) * fitted.reshape({1, 80});
  const double error =
      n::max(n::abs(validation - m::MultilabelPrior(data.fit.labels, 24))).item();
  if (error > 1e-7)
    return 1;
  const auto threshold = m::CalibrateMultilabel(validation, data.validation.labels);
  const auto test_prior = n::ones({data.test.labels.shape()[0], 80}) * fitted.reshape({1, 80});
  const auto metric = m::ScoreMultilabel(test_prior, data.test.labels, threshold.item());
  std::filesystem::create_directories("build");
  n::save_npz("build/multilabel_classification_prior.npz", {{"probability", fitted}});
  auto p = dm::graphics::RPlot::create();
  p.bars(n::arange(0, 80).to_vector<double>(), fitted.to_vector<double>(), "fitted prior",
         {147, 51, 234}, .8)
      .title("SGD-fitted constant category priors")
      .x_label("COCO128 category0..79")
      .y_label("independent presence probability")
      .y_limits(0, 1.2)
      .size(900, 600);
  p.save_svg("build/multilabel_classification_prior.svg");
  std::print("One visible SGD(.5) step fits80 independent probability coordinates;formula "
             "parity {:.3g}. Validation-only prior cutoff {:.6f};held-out microF1 {:.6f},NLL "
             "{:.6f}. Fitted vector saved for the later comparison.\n",
             error, threshold.item(), metric.micro_f1.item(), metric.nll.item());
}
```
