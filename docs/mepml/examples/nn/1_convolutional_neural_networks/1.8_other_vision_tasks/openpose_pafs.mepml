> Every stage sees a safe masked objective

For each field,average squared error over each image's observed coordinates,
then average the supported images equally. Select missing predictions and
truth out before subtracting,so unknown NaNs and their gradients disappear.
Empty images are excluded;an entirely empty batch has a graph-connected0.
The two supported images below have errors2 and3:loss=(4+9)/2=6.5.
```{cpp, results="markdown", file="figures/openpose_pafs_loss.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

#include <print>
int main() {
  namespace n = dm::nn;
  namespace m = n::models;
  const auto mask = n::tensor({1., 1., 1., 0., 0., 0.}, {3, 1, 1, 2});
  const auto active = n::greater(mask, .5);
  const auto values = n::tensor({2., 2., 3., NAN, NAN, NAN}, {3, 1, 1, 2});
  const auto x = (n::ones({3, 2, 2, 2}) * values).requires_grad_();
  const auto truth = n::where(active, n::zeros_like(x), n::full(x.shape(), NAN));
  const auto loss = m::PafMaskedMSE(x, truth, mask * n::ones_like(x));
  const auto g = n::grad(loss, {x})[0];
  std::print("Loss {:.6f};finite every adjoint:{};unknown adjoint max {:.3g};Double "
             "evaluation {:.6f}.\n",
             loss.item(), n::all(n::is_finite(g)).item<bool>(),
             n::max(n::where(active, 0., n::abs(g))).item(),
             m::PafFieldMSE(x, truth, mask * n::ones_like(x)).item());
  auto a = n::plot_tensor_map(n::reverse(mask.reshape({3, 2}), {0}), 0, 1),
       b = n::plot_tensor_map(n::reverse(n::mean(g, {1, 2}), {0}), 0, .75);
  a.title("Image/channel annotation support")
      .x_label("field channel")
      .y_label("source image0 at bottom");
  b.title("Observed-coordinate derivatives")
      .x_label("field channel")
      .y_label("source image0 at bottom");
  auto layout = dm::graphics::RLayout::create(1, 2);
  layout.add(a).add(b).size(1100, 500).fit_panels().save_svg("build/openpose_pafs_loss.svg");
}
```
