// Prepared genuine COCO8-Pose:12/1/14 oracle person crops and6/1/4 full-image observations,source-image-disjoint;fitting-only anatomical mirrors.
// result_end

Fit19+38 spatial reference channels with one visible Double SGD(.5) update
on summed per-coordinate supported MSE. Unsupported coordinates get0.
The closed-form masked mean serves only as a parity oracle. Its labels
come exclusively from the fitting partition. All6 fitting inputs are shown.
```{cpp, results="markdown", file="figures/openpose_pafs_data.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

#include <print>
int main() {
  namespace n = dm::nn;
  namespace m = n::models;
  n::set_num_threads(2);

  std::filesystem::path cache;
  if (const auto *p = std::getenv("DATAMUNGE_DATA_DIR"))
    cache = p;
  else if (const auto *p = std::getenv("XDG_CACHE_HOME"))
    cache = std::filesystem::path(p) / "datamunge/datasets";
  else
    cache = std::filesystem::path(std::getenv("HOME")) / ".cache/datamunge/datasets";

  std::filesystem::path root = cache / "human_pose";
  if (const auto *p = std::getenv("DATAMUNGE_POSE_DIR"))
    root = p;
  else
    dm::datasets::prepare_example_data("pose", root.string());
  const auto split = m::LoadPafImages(root);

  const auto fitting = m::PreparePafTargets(split.fit);
  n::ParameterStore prior(199, n::DType::Float64);
  const auto h = prior.get("heat", {1, 16, 16, 19}, n::init::zeros());
  const auto f = prior.get("paf", {1, 16, 16, 38}, n::init::zeros());
  n::OptimizerConfig options;
  options.kind = n::OptimizerKind::Sgd;
  n::Optimizer sgd(prior, .5, options);
  std::vector<n::Tensor> terms;
  for (const auto &item : std::vector<std::array<n::Tensor,3>>{
           {h, fitting.heatmap, fitting.heatmask}, {f, fitting.paf, fitting.pafmask}}) {
    const auto active = n::greater(item[2].to(n::DType::Float64), .5);
    const auto count = n::sum(active.to(n::DType::Float64), {0}, true);
    const auto diff =
        n::where(active, item[0], 0.) - n::where(active, item[1].to(n::DType::Float64), 0.);
    terms.push_back(
        n::sum(n::sum(n::square(diff), {0}, true) / n::maximum(count, n::ones_like(count))));
  }
  sgd.minimize(terms[0] + terms[1]);
  const auto heat = h.detach().to(n::DType::Float32);
  const auto paf = f.detach().to(n::DType::Float32);
  const auto parity =
      n::maximum(n::max(n::abs(heat - m::PafMeanField(fitting.heatmap, fitting.heatmask, 1))),
                 n::max(n::abs(paf - m::PafMeanField(fitting.paf, fitting.pafmask, 1))));
  if (parity.item() > 1e-7)
    return 1;
  std::print(
      "One explicit SGD(.5) update,{} learned reference values;closed-form parity {:.3g}.\n",
      prior.count(), parity.item());
  std::filesystem::create_directories("build");
  std::filesystem::create_directories("figures");
  n::save_npz("build/openpose_pafs_sgd_prior.npz", {{"heat", heat}, {"paf", paf}});
  std::vector<m::PafDecoded> empty(6);
  const auto tiles = m::PafPreviewTiles(split.fit, empty, fitting.heatmap, fitting.paf);
  n::save_image_grid(n::slice_axis(tiles, 2, 0, 256), "figures/openpose_pafs_inputs.png", 2, 0,
                     1, 2, 0, 1);
  auto a = dm::graphics::RPlot::create(), b = dm::graphics::RPlot::create();
  const auto people =
      n::concat({split.fit.counts, split.validation.counts, split.test.counts}, 0)
          .to(n::DType::Float64);
  const auto support = n::mean(fitting.heatmask.to(n::DType::Float64), {0, 1, 2});
  a.bars(n::arange(0, 11).to_vector<double>(), people.to_vector<double>(), "original people",
         {37, 99, 235})
      .title("Actual full-image person counts")
      .x_label("6 fitting /1 validation /4 test rows")
      .y_label("annotated people")
      .y_limits(0, 10);
  b.bars(n::arange(0, 19).to_vector<double>(), support.to_vector<double>(),
         "observed fraction", {22, 163, 74})
      .title("Conservative fitting-channel masks")
      .x_label("COCO18 plus background channel")
      .y_label("supported field-coordinate fraction")
      .y_limits(0, 1.25);
  auto layout = dm::graphics::RLayout::create(1, 2);
  layout.add(a).add(b).size(1100, 500).fit_panels().save_svg("build/openpose_pafs_data.svg");
}
```
