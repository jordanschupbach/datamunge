> Twelve supervised losses and every Adam update are visible

Warm all184 learned leaves before constructing Adam(.001). Each of9
updates receives2 whole fitting images,with all6 confidence and6 PAF heads
supervised. There is no BN state. Validation alone selects the checkpoint.
Restore a separate learned store,and pass only RGB to the network. Verify
repeat/checkpoint parity,single/batch agreement,all184 leaves immutable,
and different predictions for different observed photos.

Grouped-joint precision/recall/F1 exclude the derived neck and use greedy
one-to-one person matching at inclusive.2*max(original box width,height).
This custom teaching diagnostic is not COCO OKS/AP. Compare the unchanged
SGD field prior and empty/background predictor on the same held-out images.
All continuous evaluation and plotted values use tensors.
```{cpp, results="markdown", file="figures/openpose_pafs_training.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

#include <print>
int main() {
  namespace n = dm::nn;
  namespace m = n::models;
  n::set_num_threads(2);

  std::filesystem::path cache;
  if (const auto *p = std::getenv("DATAMUNGE_DATA_DIR"))
    cache = p;
  else if (const auto *p = std::getenv("XDG_CACHE_HOME"))
    cache = std::filesystem::path(p) / "datamunge/datasets";
  else
    cache = std::filesystem::path(std::getenv("HOME")) / ".cache/datamunge/datasets";

  std::filesystem::path root = cache / "human_pose";
  if (const auto *p = std::getenv("DATAMUNGE_POSE_DIR"))
    root = p;
  else
    dm::datasets::prepare_example_data("pose", root.string());
  const auto split = m::LoadPafImages(root);

  n::ParameterStore p(197);
  {
    n::NoGradGuard guard;
    m::OpenPose(p, n::zeros({1, 128, 128, 3}), 8);
  }
  n::OptimizerConfig options;
  options.kind = n::OptimizerKind::Adam;
  n::Optimizer adam(p, .001, options);
  n::BatchOrder order(6, 2, 199);
  auto losses = [&](const m::OpenPoseResult &out, const m::PafTargets &target) {
    std::vector<n::Tensor> terms;
    for (int s = 0; s < 6; ++s) {
      terms.push_back(m::PafMaskedMSE(out.heatmaps[s], target.heatmap, target.heatmask));
      terms.push_back(m::PafMaskedMSE(out.pafs[s], target.paf, target.pafmask));
    }
    return n::stack(terms, 0);
  };
  const auto probe = m::PafBatch(split.fit, {0, 1});
  const auto probe_target = m::PreparePafTargets(probe);
  const auto validation_target = m::PreparePafTargets(split.validation);
  double initial;
  {
    n::NoGradGuard guard;
    initial = n::sum(losses(m::OpenPose(p, probe.rgb, 8), probe_target)).item();
  }
  std::vector<n::Tensor> history;
  double best = INFINITY;
  int selected = 0, updates = 0;
  std::print("| epoch | fitting sum12 | validation sum12 |\n|---:|---:|---:|\n");
  for (int epoch = 1; epoch <= 3; ++epoch) {
    order.begin_epoch();
    auto average = n::zeros({12}, n::DType::Float64);
    for (;;) {
      const auto ids = order.next();
      if (ids.empty())
        break;
      const auto batch =
          m::PafBatch(split.fit, std::vector<std::size_t>(ids.begin(), ids.end()));
      const auto target = m::PreparePafTargets(batch);
      const auto out = m::OpenPose(p, batch.rgb, 8);
      const auto terms = losses(out, target);
      const auto total = n::sum(terms);
      average = average + terms.detach().to(n::DType::Float64) / 3.;
      adam.step(n::grad(total, p.parameters()));
      ++updates;
    }
    n::NoGradGuard guard;
    const auto val =
        n::sum(losses(m::OpenPose(p, split.validation.rgb, 8), validation_target));
    const double value = val.item();
    if (value < best) {
      best = value;
      selected = epoch;
      n::NamedTensors save;
      for (std::size_t i = 0; i < p.size(); ++i)
        save.push_back({p.names()[i], p.parameters()[i]});
      n::save_npz("build/openpose_pafs_best.npz", save);
    }
    history.push_back(n::concat(
        {n::sum(average).reshape({1}), val.to(n::DType::Float64).reshape({1}), average}, 0));
    std::print("| {} | {:.6f} | {:.6f} |\n", epoch, n::sum(average).item(), value);
  }
  const auto checkpoint = n::load_npz("build/openpose_pafs_best.npz");
  n::ParameterStore deployed(197);
  {
    n::NoGradGuard guard;
    m::OpenPose(deployed, n::zeros({1, 128, 128, 3}), 8);
    for (const auto &[name, value] : checkpoint) {
      p.set(name, value);
      deployed.set(name, value.clone());
    }
  }
  std::vector<n::Tensor> before;
  for (const auto &v : deployed.parameters())
    before.push_back(v.clone());
  auto predict = [&](n::ParameterStore &store,const n::Tensor &rgb) {
    n::NoGradGuard guard;
    std::vector<n::Tensor> heat, paf;
    for (std::int64_t row = 0; row < rgb.size(0); row += 2) {
      const auto out = m::OpenPose(
          store, n::slice_axis(rgb, 0, row, std::min<std::int64_t>(row + 2, rgb.size(0))), 8);
      heat.push_back(out.heatmaps[5]);
      paf.push_back(out.pafs[5]);
    }
    return std::pair{n::concat(heat, 0), n::concat(paf, 0)};
  };
  const auto output = predict(deployed, split.test.rgb);
  const auto reference = predict(p, split.test.rgb);
  const auto repeat = predict(deployed, split.test.rgb);
  const auto parity = n::max(n::stack({n::max(n::abs(output.first - reference.first)),
                                       n::max(n::abs(output.second - reference.second)),
                                       n::max(n::abs(output.first - repeat.first)),
                                       n::max(n::abs(output.second - repeat.second))},
                                      0));
  const auto single = predict(deployed, n::slice_axis(split.test.rgb, 0, 3, 4));
  const auto batch_error =
      n::maximum(n::max(n::abs(single.first - n::slice_axis(output.first, 0, 3, 4))),
                 n::max(n::abs(single.second - n::slice_axis(output.second, 0, 3, 4))));
  const auto sensitivity =
      n::mean(n::abs(n::select(output.first, 0, 0) - n::select(output.first, 0, 1)));
  bool immutable = true;
  for (std::size_t i = 0; i < before.size(); ++i)
    immutable =
        immutable && n::all(n::equal(before[i], deployed.parameters()[i])).item<bool>();
  if (parity.item() > 1e-6 || batch_error.item() > 2e-6 || !immutable ||
      sensitivity.item() <= 1e-6)
    return 1;
  n::NoGradGuard guard;
  const double fitted = n::sum(losses(m::OpenPose(p, probe.rgb, 8), probe_target)).item();
  std::print("{} Adam updates;selected epoch {};fixed probe {:.6f}->{:.6f};validation "
             "{:.6f}.\nRGB-only parity {:.3g},single/batch {:.9g} within2e-6;{} learned "
             "leaves unchanged:{};image sensitivity {:.6f}.\n",
             updates, selected, initial, fitted, best, parity.item(), batch_error.item(),
             deployed.size(), immutable, sensitivity.item());
  const auto saved = n::load_npz("build/openpose_pafs_sgd_prior.npz");
  n::Tensor mean_heat, mean_paf;
  for (const auto &[name, value] : saved) {
    if (name == "heat")
      mean_heat = value + n::zeros({4, 16, 16, 19});
    else
      mean_paf = value + n::zeros({4, 16, 16, 38});
  }
  const auto empty_heat =
      n::equal(n::arange(0, 19), 18.).to(n::DType::Float32).reshape({1, 1, 1, 19}) +
      n::zeros({4, 16, 16, 19});
  const auto empty_paf = n::zeros({4, 16, 16, 38});
  const auto target = m::PreparePafTargets(split.test);
  std::vector<n::Tensor> metrics;
  std::vector<m::PafDecoded> learned;
  std::print("| predictor | heat MSE | PAF MSE | precision | recall | F1 | people | "
             "correct/predicted/GT |\n|---|---:|---:|---:|---:|---:|---:|---|\n");
  const std::array<std::string, 3> labels = {"learned", "SGD prior", "empty"};
  int index = 0;
  for (const auto &fields : std::vector<std::pair<n::Tensor,n::Tensor>>{
           output, {mean_heat, mean_paf}, {empty_heat, empty_paf}}) {
    std::vector<m::PafDecoded> decoded;
    for (int row = 0; row < 4; ++row)
      decoded.push_back(m::DecodePafs(fields.first, fields.second, row));
    if (index == 0)
      learned = decoded;
    const auto score = m::ScorePafs(decoded, split.test);
    const auto precision = n::full({}, score.precision(), n::DType::Float64);
    const auto recall = n::full({}, score.recall(), n::DType::Float64);
    const auto f1 =
        n::where(n::greater(precision + recall, 0.),
                 2. * precision * recall /
                     n::maximum(precision + recall, n::full({}, 1e-30, n::DType::Float64)),
                 0.);
    const auto hm = m::PafFieldMSE(fields.first, target.heatmap, target.heatmask);
    const auto pm = m::PafFieldMSE(fields.second, target.paf, target.pafmask);
    metrics.push_back(n::stack({hm, pm, precision, recall, f1}, 0));
    std::print("| {} | {:.6f} | {:.6f} | {:.6f} | {:.6f} | {:.6f} | {} | {}/{}/{} |\n",
               labels[index++], hm.item(), pm.item(), precision.item(), recall.item(),
               f1.item(), score.people, score.correct, score.predicted, score.annotated);
  }
  const auto tiles = m::PafPreviewTiles(split.test, learned, output.first, output.second);
  n::save_image_grid(tiles, "figures/openpose_pafs_test.png", 1, 0, 1, 2, 0, 1);
  const auto measured = n::stack(metrics, 0);
  const auto xs = n::arange(0, 3).to_vector<double>();
  auto a = dm::graphics::RPlot::create(), b = dm::graphics::RPlot::create();
  a.points(xs, n::select(measured, 1, 0).to_vector<double>(), "confidence", {37, 99, 235})
      .points(xs, n::select(measured, 1, 1).to_vector<double>(), "directed PAF", {220, 38, 38})
      .title("Held-out supported field error")
      .x_label("0learned /1SGD prior /2empty")
      .y_label("equal-image masked MSE")
      .y_limits(0, .06);
  b.points(xs, n::select(measured, 1, 2).to_vector<double>(), "precision", {37, 99, 235})
      .points(xs, n::select(measured, 1, 3).to_vector<double>(), "recall", {220, 38, 38})
      .points(xs, n::select(measured, 1, 4).to_vector<double>(), "F1", {22, 163, 74})
      .title("Custom grouped-joint diagnostics")
      .x_label("0learned /1SGD prior /2empty")
      .y_label("fraction;not COCO AP")
      .y_limits(-.01, .2);
  auto metric_layout = dm::graphics::RLayout::create(1, 2);
  metric_layout.add(a).add(b).size(1100, 500).fit_panels().save_svg(
      "build/openpose_pafs_metrics.svg");
  std::filesystem::copy_file("build/openpose_pafs_metrics.svg",
                             "figures/openpose_pafs_metrics.svg",
                             std::filesystem::copy_options::overwrite_existing);
  const auto hist = n::stack(history, 0);
  const auto epochs = n::arange(1, 4);
  a = dm::graphics::RPlot::create();
  b = dm::graphics::RPlot::create();
  a.lines(epochs.to_vector<double>(), n::select(hist, 1, 0).to_vector<double>(),
          "fitting sum12", {37, 99, 235})
      .lines(epochs.to_vector<double>(), n::select(hist, 1, 1).to_vector<double>(),
             "validation", {220, 38, 38})
      .title("Nine visible Adam updates")
      .x_label("epoch")
      .y_label("sum of twelve field losses")
      .y_limits(0, 1.6);
  b.lines(epochs.to_vector<double>(), n::select(hist, 1, 12).to_vector<double>(),
          "final confidence", {37, 99, 235})
      .lines(epochs.to_vector<double>(), n::select(hist, 1, 13).to_vector<double>(),
             "final PAF", {22, 163, 74})
      .title("Final heads keep direct supervision")
      .x_label("epoch")
      .y_label("masked fitting MSE")
      .y_limits(0, .18);
  auto curves = dm::graphics::RLayout::create(1, 2);
  curves.add(a).add(b).size(1100, 500).fit_panels().save_svg(
      "build/openpose_pafs_training.svg");
}
```
