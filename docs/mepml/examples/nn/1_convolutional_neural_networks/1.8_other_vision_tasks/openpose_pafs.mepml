> Local peaks become conflict-safe person groups

Find3x3 local maxima above.05,keeping the first raster position for plateaus
and the best20 per joint type. Candidate limbs use10 clamped bilinear samples.
Require projections>.05 at at least80% of samples;add the source distance
prior min(0,.5*field_height/length-1),and require positive score. Stable greedy
matching enforces one endpoint per limb type. Person assembly refuses
conflicting same-type peaks and retains at least3 joints with sufficient
mean confidence/link score. Every numerical rank,sample,projection and score
uses tensors;C++ containers manage joint identities and subset membership.
These fixed decoder thresholds are not tuned on this four-image test.
```{cpp, results="markdown", file="figures/openpose_pafs_decoder.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

#include <print>
int main() {
  namespace n = dm::nn;
  namespace m = n::models;
  const auto x = n::arange(0, 4).reshape({1, 1, 4, 1});
  const auto y = n::arange(0, 4).reshape({1, 4, 1, 1});
  const auto channels = n::arange(0, 38).reshape({1, 1, 1, 38});
  const m::PafTensorField field(x + 2. * y + channels);
  std::print("Affine field x+2y+c:interior(1.25,2.5,c0) {:.6f},clamped(-3,9,c0) {:.6f}.\n",
             m::PafSample(field, 0, 1.25, 2.5, 0), m::PafSample(field, 0, -3, 9, 0));
  const auto positions = n::arange(-1, 4.001, .02);
  const auto fixed = n::full(positions.shape(), 2.5);
  const auto samples = m::PafSamples(field, 0, positions, fixed, 0);
  auto a = dm::graphics::RPlot::create(), b = dm::graphics::RPlot::create();
  a.lines(positions.to_vector<double>(), samples.to_vector<double>(), "field sample",
          {37, 99, 235})
      .title("Bilinear samples clamp at borders")
      .x_label("sample x at y2.5")
      .y_label("x+2y");
  const auto fraction = n::arange(0, 1.001, .01);
  const auto accepted = n::greater_equal(fraction, .8).to(n::DType::Float64);
  b.lines(fraction.to_vector<double>(), accepted.to_vector<double>(), "80% support",
          {220, 38, 38})
      .title("Directed-support acceptance rule")
      .x_label("fraction with positive projection")
      .y_label("passes fraction criterion")
      .y_limits(-.1, 1.4);
  auto layout = dm::graphics::RLayout::create(1, 2);
  layout.add(a).add(b).size(1100, 500).fit_panels().save_svg(
      "build/openpose_pafs_decoder.svg");
}
