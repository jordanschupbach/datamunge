> Execute the full convolution/recurrent graph

Seven convolutions and two projected bidirectional LSTMs retain the source
CRNN. Two2x2 stride2 pools reduce both axes. Two asymmetric pools add a
column on **both** sides before2x2 pooling at stride(2,1). A final2x2 VALID
convolution gives height1,width26. The sequence has26 time steps and37
logits per step,with blank36. Compact divisor8,H32 retains every stage.
The reference divisor1,H256 is also executed forward/backward.
```{cpp, results="markdown", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

#include <print>
int main() {
  namespace n = dm::nn;
  namespace m = n::models;
  n::set_num_threads(2);
  std::print("| graph | learned scalars | learned tensors | BN scalars/tensors | logits T,N,C "
             "|\n|---|---:|---:|---|---|\n");
  for (bool compact : {false, true}) {
    n::ParameterStore p(317), state(319);
    const auto config = compact ? m::CrnnConfig{8, 32} : m::CrnnConfig{};
    const auto pixels = (.5 + .4 * n::sin(n::arange(0, 32 * 100, 1, n::DType::Float64) * .17))
                            .to(n::DType::Float32)
                            .reshape({1, 32, 100, 1})
                            .requires_grad_();
    const auto out = m::Crnn(p, state, pixels, config, false);
    auto leaves = p.parameters();
    leaves.push_back(pixels);
    const auto gradients = n::grad(n::sum(n::square(out.logits)), leaves);
    for (const auto &g : gradients)
      if (!n::all(n::less(n::abs(g), INFINITY)).item<bool>() ||
          n::sum(n::square(g.to(n::DType::Float64))).item() <= 0)
        return 1;
    std::print("| {} | {} | {} | {}/{} | 26,1,37 |\n",
               compact ? "compact8/H32" : "reference1/H256", p.count(), p.size(),
               state.count(), state.size());
    if (out.stages.size() != 7 || out.logits.shape() != n::Shape{26, 1, 37})
      return 1;
  }
}
```
