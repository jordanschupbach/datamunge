> Visible full-model CTC Adam and image-only restoration

Warm36 learned leaves and six BN tensors before constructing Adam(.001).
Fit three seeded epochs,batch8,with mean CTC negative log likelihood.
True target lengths exclude-1 padding;all input lengths are26. CTC gradients
flow through every convolution,BN affine tensor,LSTM direction and projection.
Validation CTC selects a paired learned/BN checkpoint. Greedy word decoding
uses tensor argmax,then class-metadata repeat/blank collapse.

Independent restored deployment receives only observed word images. It must
match the selected logits,remain immutable and agree for single/batch inference.
Compare trained and initial greedy words with the empty-string reference,which
has no parameters or optimizer. Word exactness and character edit rate are
reported separately from CTC;all edit costs/reductions use tensor dynamic
programming. Empty greedy predictions are printed explicitly.
```{cpp, results="markdown", file="figures/crnn_ctc_training.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

#include <print>
int main() {
  namespace n = dm::nn;
  namespace m = n::models;
  n::set_num_threads(2);

  std::filesystem::path cache;
  if (const auto *p = std::getenv("DATAMUNGE_DATA_DIR"))
    cache = p;
  else if (const auto *p = std::getenv("XDG_CACHE_HOME"))
    cache = std::filesystem::path(p) / "datamunge/datasets";
  else
    cache = std::filesystem::path(std::getenv("HOME")) / ".cache/datamunge/datasets";

  std::filesystem::path root = cache / "ocr";
  if (const auto *p = std::getenv("DATAMUNGE_OCR_DIR"))
    root = p;
  else
    dm::datasets::prepare_example_data("ocr", root.string());
  const auto data = m::LoadOcr(root);
  const auto &fit = data[0];
  const auto &validation = data[1];
  const auto &test = data[2];

  const m::CrnnConfig cfg{8, 32};
  n::ParameterStore p(307), state(311);
  {
    n::NoGradGuard guard;
    m::Crnn(p, state, n::zeros({1, 32, 100, 1}), cfg, false);
  }
  n::OptimizerConfig opt;
  opt.kind = n::OptimizerKind::Adam;
  n::Optimizer adam(p, .001, opt);
  auto predict = [&](n::ParameterStore &weights, n::ParameterStore &moving,
                     const n::Tensor &pixels) {
    n::NoGradGuard guard;
    return m::Crnn(weights, moving, pixels, cfg, false).logits;
  };
  auto loss = [&](const m::OcrData &d) {
    return n::mean(n::ctc_loss(predict(p, state, d.pixels), d.labels, d.lengths,
                               n::full({d.pixels.size(0)}, 26, n::DType::Int32)))
        .item();
  };
  const auto initial_test = predict(p, state, test.pixels);
  const auto initial_words = m::OcrDecode(initial_test);
  const double initial = loss(fit);
  std::vector<double> epochs, training, valid;
  double best = INFINITY;
  int selected = 0, updates = 0;
  n::BatchOrder order(fit.pixels.size(0), 8, 313);
  std::filesystem::create_directories("build");
  std::filesystem::create_directories("figures");
  std::print("{} learned scalars/36 tensors;{} BN scalars/6 tensors.\n| epoch | mean fitting "
             "CTC | validation CTC |\n|---:|---:|---:|\n",
             p.count(), state.count());
  for (int epoch = 1; epoch <= 3; ++epoch) {
    order.begin_epoch();
    double total = 0;
    int seen = 0;
    for (auto ids = order.next(); !ids.empty(); ids = order.next()) {
      const auto batch = m::OcrRows(fit, std::vector<std::int64_t>(ids.begin(), ids.end()));
      const auto forward = m::Crnn(p, state, batch.pixels, cfg, true, true);
      const auto objective =
          n::mean(n::ctc_loss(forward.logits, batch.labels, batch.lengths,
                              n::full({batch.pixels.size(0)}, 26, n::DType::Int32)));
      if (!std::isfinite(objective.item()))
        return 1;
      total += objective.item() * ids.size();
      seen += ids.size();
      adam.minimize(objective);
      ++updates;
    }
    if (seen != 43)
      return 1;
    epochs.push_back(epoch);
    training.push_back(total / seen);
    valid.push_back(loss(validation));
    if (valid.back() < best) {
      best = valid.back();
      selected = epoch;
      p.save("build/crnn_ctc_best.npz");
      state.save("build/crnn_ctc_bn.npz");
    }
    std::print("| {} | {:.6f} | {:.6f} |\n", epoch, training.back(), valid.back());
  }
  p.load("build/crnn_ctc_best.npz");
  state.load("build/crnn_ctc_bn.npz");
  const double restored = loss(validation), fitted = loss(fit);
  if (std::abs(restored - best) > 1e-6 || fitted >= initial)
    return 1;
  n::ParameterStore deployed(991), moving(997);
  {
    n::NoGradGuard guard;
    m::Crnn(deployed, moving, n::zeros({1, 32, 100, 1}), cfg, false);
  }
  deployed.load("build/crnn_ctc_best.npz");
  moving.load("build/crnn_ctc_bn.npz");
  std::vector<n::Tensor> snapshot;
  for (const auto *store : {&deployed, &moving})
    for (const auto &v : store->parameters())
      snapshot.push_back(v.clone());
  const auto logits = predict(deployed, moving, test.pixels),
             reference = predict(p, state, test.pixels),
             repeat = predict(deployed, moving, test.pixels);
  const double parity = n::max(n::abs(logits - reference)).item();
  if (parity > 1e-7 || !n::all(n::equal(logits, repeat)).item<bool>())
    return 1;
  const auto single = predict(deployed, moving, m::OcrRows(test, {0}).pixels);
  if (n::max(n::abs(single - n::slice_axis(logits, 1, 0, 1))).item() > 1e-6)
    return 1;
  std::size_t k = 0;
  for (const auto *store : {&deployed, &moving})
    for (const auto &v : store->parameters())
      if (!n::all(n::equal(snapshot[k++], v)).item<bool>())
        return 1;
  const auto inverted = predict(deployed, moving, 1. - test.pixels);
  const double sensitivity = n::mean(n::abs(logits - inverted)).item();
  if (sensitivity < 1e-7)
    return 1;
  const auto words = m::OcrDecode(logits);
  const auto trained = m::ScoreTensorOcr(test, words),
             untrained = m::ScoreTensorOcr(test, initial_words),
             empty = m::ScoreTensorOcr(test, std::vector<std::string>(6, ""));
  std::print(
      "{} visible Adam updates;selected epoch{},paired restored validation CTC {:.6f};fixed "
      "fitting CTC {:.6f}->{:.6f}.\nImage-only deployment parity {:.3g},all36 learned+6 "
      "moving tensors immutable,repeat exact,single/batch agree;image inversion changes mean "
      "logit {:.6f}.\n| predictor | exact words | total words | character edits | reference "
      "characters | character error rate |\n|---|---:|---:|---:|---:|---:|\n",
      updates, selected, restored, initial, fitted, parity, sensitivity);
  for (const auto &item : std::vector<std::pair<std::string, m::TensorOcrMetrics>>{
           {"trained greedy", trained}, {"initial greedy", untrained}, {"empty", empty}})
    std::print("| {} | {} | {} | {} | {} | {:.6f} |\n", item.first,
               item.second.exact.item<std::int64_t>(), item.second.words.item<std::int64_t>(),
               item.second.errors.item<std::int64_t>(),
               item.second.characters.item<std::int64_t>(),
               item.second.character_error_rate.item());
  std::print("\nHeld-out word predictions.\n\n| crop | image ID | human text | predicted text "
             "|\n|---:|---:|---|---|\n");
  for (int i = 0; i < 6; ++i)
    std::print("| {} | {} | {} | {} |\n", i + 1, n::select(test.image_ids, 0, i).item<int>(),
               m::OcrText(test, i), words[i].empty() ? "[empty]" : words[i]);
  n::save_image_grid(test.pixels, "figures/crnn_ctc_predictions.png", 2, 0, 1, 2, 0, 4);
  n::save_npz("build/crnn_ctc_test.npz", {{"observed_word_crops", test.pixels},
                                          {"logits", logits},
                                          {"labels", test.labels},
                                          {"lengths", test.lengths}});
  const auto probabilities = n::softmax(n::select(logits, 1, 0), 1),
             blank_probability = n::select(probabilities, 1, 36);
  auto a = dm::graphics::RPlot::create();
  a.lines(n::arange(0, 26).to_vector<double>(), blank_probability.to_vector<double>(),
          "blank probability", {220, 38, 38})
      .title("First held-out crop:blank class")
      .x_label("CTC time step")
      .y_label("blank probability")
      .y_limits(0, 1.25)
      .size(950, 480);
  a.save_svg("build/crnn_ctc_blank.svg");
  std::filesystem::copy_file("build/crnn_ctc_blank.svg", "figures/crnn_ctc_blank.svg",
                             std::filesystem::copy_options::overwrite_existing);
  a = dm::graphics::RPlot::create();
  a.lines(epochs, training, "fitting CTC", {37, 99, 235})
      .lines(epochs, valid, "validation CTC", {220, 38, 38})
      .title("Visible complete CRNN Adam fitting")
      .x_label("epoch")
      .y_label("mean unnormalized target NLL")
      .y_limits(0, 100)
      .size(950, 480);
  a.save_svg("build/crnn_ctc_training.svg");
}
