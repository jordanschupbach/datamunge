> Explicit optimization for every model

Each model gets its own seeded ParameterStore. Warm all leaves before
constructing its optimizer. SRCNN,ESPCN,EDSR and RCAN use Adam(.001).
VDSR uses momentum(.9) SGD(.1) with explicit theta/rate derivative clipping.
Y models minimize raw MSE;RGB EDSR/RCAN minimize raw RGB L1. No training
prediction is clipped. The loop shows all48 updates per model,240 overall.

Validation loss selects a separate checkpoint for each architecture. A new
store restores it and predicts from observed input alone. Check restoration,
repeatability,immutable leaves and single/batch agreement. Common evaluation
uses HR coordinates6..25,a20x20 Y crop. Convert RGB to studio-range BT.601 Y,
then clamp predictions/reference only for metrics;retain raw training outputs.
PSNR is averaged per image,as is Gaussian11x11/sigma1.5 valid-window SSIM.
These small source-specific crops are not published SR benchmarks.
```{cpp, results="markdown", file="figures/super_resolution_training.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

#include <print>
int main() {
  namespace n = dm::nn;
  namespace m = n::models;
  n::set_num_threads(2);

  std::filesystem::path cache;
  if (const auto *p = std::getenv("DATAMUNGE_DATA_DIR"))
    cache = p;
  else if (const auto *p = std::getenv("XDG_CACHE_HOME"))
    cache = std::filesystem::path(p) / "datamunge/datasets";
  else
    cache = std::filesystem::path(std::getenv("HOME")) / ".cache/datamunge/datasets";
  dm::datasets::fetch("cifar10", (cache / "cifar10").string());

  const auto train =
                 n::data::LoadCifar({cache / "cifar10/data_batch_1.bin"}, n::data::Cifar::k10),
             test =
                 n::data::LoadCifar({cache / "cifar10/test_batch.bin"}, n::data::Cifar::k10);
  std::vector<std::int64_t> fit_rows, val_rows, test_rows;
  for (int i = 0; i < 128; ++i)
    fit_rows.push_back(i);
  for (int i = 128; i < 160; ++i)
    val_rows.push_back(i);
  for (int i = 64; i < 96; ++i)
    test_rows.push_back(i);
  const auto fitting = m::SRPairs(train.images, fit_rows),
             validation = m::SRPairs(train.images, val_rows),
             testing = m::SRPairs(test.images, test_rows);

  std::filesystem::create_directories("build");
  std::filesystem::create_directories("figures");
  const std::vector<m::SRKind> kinds = {m::SRKind::kSrcnn, m::SRKind::kEspcn, m::SRKind::kVdsr,
                                        m::SRKind::kEdsr, m::SRKind::kRcan};
  const std::array<dm::graphics::RGB, 5> colors = {
      {{37, 99, 235}, {220, 38, 38}, {22, 163, 74}, {147, 51, 234}, {234, 88, 12}}};
  auto yplot = dm::graphics::RPlot::create(), rgbplot = dm::graphics::RPlot::create();
  std::vector<double> psnr, ssim;
  const auto bicubic = m::ScoreTensorSR(testing.bicubic, testing);
  int index = 0;
  std::print("| model | selected | initial fit | restored fit | validation | test PSNR dB | "
             "SSIM | pooled PSNR dB |\n|---|---:|---:|---:|---:|---:|---:|---:|\n");
  for (auto kind : kinds) {
    const auto cfg = m::SRConfig::Compact(kind);
    const auto fit = m::PrepareSR(fitting, cfg), val = m::PrepareSR(validation, cfg),
               test = m::PrepareSR(testing, cfg);
    const auto name = std::string(m::SRName(kind));
    n::ParameterStore p(17);
    {
      n::NoGradGuard guard;
      m::SuperResolution(p, n::slice_axis(fit.x, 0, 0, 1), cfg);
    }
    n::OptimizerConfig options;
    options.kind =
        kind == m::SRKind::kVdsr ? n::OptimizerKind::Momentum : n::OptimizerKind::Adam;
    options.momentum = .9;
    const double rate = kind == m::SRKind::kVdsr ? .1 : .001;
    n::Optimizer optimizer(p, rate, options);
    auto objective = [&](n::ParameterStore &store, const n::Tensor &x, const n::Tensor &y) {
      const auto diff = m::SuperResolution(store, x, cfg).image - y;
      return cfg.Channels() == 3 ? n::mean(n::abs(diff)) : n::mean(n::square(diff));
    };
    auto evaluate = [&](const m::SRPrepared &data) {
      n::NoGradGuard guard;
      n::Tensor sum = n::full({}, 0., n::DType::Float64);
      for (std::int64_t i = 0; i < data.x.size(0); i += 8) {
        const auto end = std::min(i + 8, data.x.size(0));
        sum = sum +
              objective(p, n::slice_axis(data.x, 0, i, end), n::slice_axis(data.y, 0, i, end))
                      .to(n::DType::Float64) *
                  double(end - i);
      }
      return (sum / double(data.x.size(0))).item();
    };
    const m::SRPrepared probe{n::slice_axis(fit.x, 0, 0, 8), n::slice_axis(fit.y, 0, 0, 8)};
    const double initial = evaluate(probe);
    double best = INFINITY, peak = 0;
    std::int64_t clipped = 0;
    int selected = 0, updates = 0;
    n::BatchOrder order(128, 8, 29);
    std::vector<double> epochs, history, validation_history;
    const auto checkpoint = "build/super_resolution_" + name + "_best.npz";
    for (int epoch = 1; epoch <= 3; ++epoch) {
      order.begin_epoch();
      n::Tensor total = n::full({}, 0., n::DType::Float64);
      int seen = 0;
      for (auto rows = order.next(); !rows.empty(); rows = order.next()) {
        const auto loss = objective(p, m::SRBatch(fit.x, rows), m::SRBatch(fit.y, rows));
        if (!std::isfinite(loss.item()))
          return 1;
        total = total + loss.detach().to(n::DType::Float64) * double(rows.size());
        seen += rows.size();
        auto gradients = n::grad(loss, p.parameters());
        if (kind == m::SRKind::kVdsr) {
          for (auto &g : gradients) {
            peak = std::max(peak, n::max(n::abs(g)).item());
            clipped += n::count_nonzero(n::greater(n::abs(g), double(.01f / float(rate))))
                           .item<std::int64_t>();
            g = m::VdsrClippedGradient(g, rate);
          }
        }
        optimizer.step(gradients);
        ++updates;
      }
      if (seen != 128)
        return 1;
      epochs.push_back(epoch);
      history.push_back((total / 128.).item());
      validation_history.push_back(evaluate(val));
      if (validation_history.back() < best) {
        best = validation_history.back();
        selected = epoch;
        p.save(checkpoint);
      }
    }
    p.load(checkpoint);
    const double learned = evaluate(probe);
    if (std::abs(evaluate(val) - best) > 1e-8 || learned >= initial ||
        history.back() >= history.front() || updates != 48)
      return 1;
    n::ParameterStore deployed(991);
    {
      n::NoGradGuard guard;
      m::SuperResolution(deployed, n::slice_axis(test.x, 0, 0, 1), cfg);
    }
    deployed.load(checkpoint);
    std::vector<n::Tensor> snapshot;
    for (const auto &w : deployed.parameters())
      snapshot.push_back(w.clone());
    auto predict = [&](n::ParameterStore &store, const n::Tensor &x) {
      n::NoGradGuard guard;
      std::vector<n::Tensor> parts;
      for (std::int64_t i = 0; i < x.size(0); i += 8)
        parts.push_back(
            m::SuperResolution(store, n::slice_axis(x, 0, i, std::min(i + 8, x.size(0))), cfg)
                .image);
      return n::concat(parts, 0);
    };
    const auto prediction = predict(deployed, test.x), reference = predict(p, test.x),
               repeat = predict(deployed, test.x),
               single = predict(deployed, n::slice_axis(test.x, 0, 3, 4));
    const double parity = n::max(n::abs(prediction - reference)).item(),
                 batch_error =
                     n::max(n::abs(single - n::slice_axis(prediction, 0, 3, 4))).item();
    if (parity > 1e-7 || batch_error > 1e-5 ||
        !n::all(n::equal(prediction, repeat)).item<bool>())
      return 1;
    for (std::size_t i = 0; i < snapshot.size(); ++i)
      if (!n::all(n::equal(snapshot[i], deployed.parameters()[i])).item<bool>())
        return 1;
    const auto score = m::ScoreTensorSR(prediction, testing);
    psnr.push_back(score.psnr.item());
    ssim.push_back(score.ssim.item());
    std::print("| {} | {} | {:.6f} | {:.6f} | {:.6f} | {:.6f} | {:.6f} | {:.6f} |\n", name,
               selected, initial, learned, best, score.psnr.item(), score.ssim.item(),
               m::SRPSNRTensor(score.mse).item());
    std::print("{}:{} explicit updates,{} immutable leaves,restore parity {:.3g},single/batch "
               "max {:.3g};VDSR-only raw-gradient tracker {:.6f},clipped coordinates {}.\n",
               name, updates, p.size(), parity, batch_error, peak, clipped);
    n::save_image_grid(m::SRPreviewTiles(testing, prediction),
                       "figures/super_resolution_" + name + "_predictions.png", 4, 0, 1, 2, 0,
                       3);
    n::save_npz("build/super_resolution_" + name + "_outputs.npz",
                {{"observed", test.x},
                 {"raw_prediction", prediction},
                 {"original_hr", testing.hr},
                 {"bicubic", testing.bicubic}});
    auto &plot = cfg.Channels() == 1 ? yplot : rgbplot;
    plot.lines(epochs, history, name + " fit", colors[index]);
    plot.points(epochs, validation_history, name + " val", colors[index]);
    ++index;
  }
  std::print(
      "Unchanged bicubic:mean PSNR {:.6f}dB,SSIM {:.6f};all32 test images,central20x20 Y.\n",
      bicubic.psnr.item(), bicubic.ssim.item());
  auto a = dm::graphics::RPlot::create(), b = dm::graphics::RPlot::create();
  const std::vector<double> x = {0, 1, 2, 3, 4};
  a.bars(x, psnr, "learned", {37, 99, 235})
      .lines({-.5, 4.5}, {bicubic.psnr.item(), bicubic.psnr.item()}, "bicubic", {220, 38, 38})
      .title("All32 test images:Y PSNR")
      .x_label("0 SRCNN,1 ESPCN,2 VDSR,3 EDSR,4 RCAN")
      .y_label("mean per-image PSNR in dB")
      .y_limits(0, 35);
  b.bars(x, ssim, "learned", {22, 163, 74})
      .lines({-.5, 4.5}, {bicubic.ssim.item(), bicubic.ssim.item()}, "bicubic", {220, 38, 38})
      .title("Same crop:Gaussian SSIM")
      .x_label("0 SRCNN,1 ESPCN,2 VDSR,3 EDSR,4 RCAN")
      .y_label("mean per-image valid SSIM")
      .y_limits(-.1, 1.2);
  auto metrics = dm::graphics::RLayout::create(1, 2);
  metrics.add(a).add(b).size(1200, 500).fit_panels().save_svg(
      "build/super_resolution_metrics.svg");
  std::filesystem::copy_file("build/super_resolution_metrics.svg",
                             "figures/super_resolution_metrics.svg",
                             std::filesystem::copy_options::overwrite_existing);
  yplot.title("Y networks:raw MSE")
      .x_label("epoch")
      .y_label("fitting lines,validation points");
  rgbplot.title("RGB networks:raw L1")
      .x_label("epoch")
      .y_label("fitting lines,validation points");
  auto curves = dm::graphics::RLayout::create(1, 2);
  curves.add(yplot).add(rgbplot).size(1200, 550).fit_panels().save_svg(
      "build/super_resolution_training.svg");
}
```
