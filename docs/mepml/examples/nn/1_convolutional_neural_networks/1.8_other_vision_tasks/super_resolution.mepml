> Channel attention sees global spatial context

RCAN averages every residual feature channel over H and W,learns a1x1
bottleneck with ReLU,expands back to the feature width and applies sigmoid
gates. The gates multiply the residual branch before its short skip. Group
and body skips carry lower-frequency features around deeper transformations.
The spatial mean remains differentiable:it is not an estimated host statistic.
```{cpp, results="markdown", file="figures/super_resolution_attention.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

#include <print>
int main() {
  namespace n = dm::nn;
  namespace m = n::models;
  n::ParameterStore p(17);
  const auto x = (n::arange(0, 48).reshape({1, 3, 4, 4}) * .02 + .1).requires_grad_();
  const auto gate = m::SRChannelAttention(p, "attention", x, 4, 2);
  const auto gradients = n::grad(n::sum(gate.output), {x});
  std::print("Four sigmoid gates:{};all input derivatives finite:{};{} learned tensors.\n",
             gate.gates, n::all(n::is_finite(gradients[0])).item<bool>(), p.size());
  auto a = dm::graphics::RPlot::create(), b = dm::graphics::RPlot::create();
  a.bars({0., 1., 2., 3.}, gate.gates.to_vector<double>(), "channel gate", {37, 99, 235})
      .title("Learned global channel gates")
      .x_label("feature channel")
      .y_label("sigmoid weight")
      .y_limits(0, 1.3);
  b.bars({0., 1., 2., 3.}, n::mean(n::abs(gradients[0]), {0, 1, 2}).to_vector<double>(),
         "input adjoint", {22, 163, 74})
      .title("Gradients include pooled context")
      .x_label("feature channel")
      .y_label("mean absolute input derivative")
      .y_limits(0, 1.1);
  auto layout = dm::graphics::RLayout::create(1, 2);
  layout.add(a).add(b).size(1100, 500).fit_panels().save_svg(
      "build/super_resolution_attention.svg");
}
```
