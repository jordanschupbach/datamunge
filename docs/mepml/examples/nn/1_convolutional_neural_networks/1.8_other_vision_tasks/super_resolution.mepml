Four sigmoid gates:float32[1, 1, 1, 4] [[[[0.513881, 0.496246, 0.51306, 0.478391]]]] (grad_fn=Sigmoid);all input derivatives finite:true;4 learned tensors.
\image(figures/super_resolution_attention.svg)
// result_end
\caption(RCAN gates and input derivatives on a rectangular feature fixture. Independent native checks also verify attention weight/input derivatives and nested residual structure.)
\alttext(RCAN gates and input derivatives on a rectangular feature fixture. Independent native checks also verify attention weight/input derivatives and nested residual structure.)

> VDSR bounds each update before momentum

The clipping bound is theta/learning_rate. With theta=.01,the raw derivative
is clipped to+/- .1 at learning rate.1. The report computes derivatives,
clips them as tensors and explicitly calls the momentum optimizer’s step.
This bounds the fresh gradient contribution;momentum can accumulate updates.
VDSR alone adds an image-space bicubic skip and uses20 convolutional layers.
Its final residual kernel starts at normal(.001),as in this source experiment.
```{cpp, results="markdown", file="figures/super_resolution_clipping.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

#include <print>
int main() {
  namespace n = dm::nn;
  namespace m = n::models;
  const auto raw = n::arange(-.3, .3001, .002, n::DType::Float64),
             clipped = m::VdsrClippedGradient(raw, .1),
             other = m::VdsrClippedGradient(raw, .01);
  std::print(
      "rate.1 bound {:.9f};clipped coordinates {}/{}.\n", double(.01f / .1f),
      n::count_nonzero(n::greater(n::abs(raw), double(.01f / .1f))).item<std::int64_t>(),
      raw.numel());
  auto a = dm::graphics::RPlot::create(), b = dm::graphics::RPlot::create();
  a.lines(raw.to_vector<double>(), clipped.to_vector<double>(), "rate .1", {37, 99, 235})
      .lines(raw.to_vector<double>(), other.to_vector<double>(), "rate .01", {220, 38, 38})
      .title("Adjustable derivative clipping")
      .x_label("raw derivative")
      .y_label("derivative sent to optimizer")
      .y_limits(-.4, .5);
  b.lines(raw.to_vector<double>(), (.1 * clipped).to_vector<double>(), "fresh step .1",
          {37, 99, 235})
      .lines(raw.to_vector<double>(), (.01 * other).to_vector<double>(), "fresh step .01",
             {220, 38, 38})
      .title("Fresh update before momentum")
      .x_label("raw derivative")
      .y_label("rate times clipped derivative")
      .y_limits(-.013, .018);
  auto layout = dm::graphics::RLayout::create(1, 2);
  layout.add(a).add(b).size(1100, 500).fit_panels().save_svg(
      "build/super_resolution_clipping.svg");
}
```
