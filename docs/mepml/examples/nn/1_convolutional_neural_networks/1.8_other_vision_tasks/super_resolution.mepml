> Actual CIFAR data and an unchanged bicubic reference

Read the original CIFAR-10 binaries from the dataset cache. Fitting uses
training rows0..127;validation128..159;test uses original test rows64..95.
Each split retains128/32/32 original RGB images. The input preview shows
original HR RGB,true LR enlarged only for display,and raw bicubic32.
The histogram shows fitting-image studio-range Y and the central reconstruction
error of bicubic;all numeric preprocessing and plot data use tensors.
```{cpp, results="markdown", file="figures/super_resolution_data.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

#include <print>
int main() {
  namespace n = dm::nn;
  namespace m = n::models;
  n::set_num_threads(2);

  std::filesystem::path cache;
  if (const auto *p = std::getenv("DATAMUNGE_DATA_DIR"))
    cache = p;
  else if (const auto *p = std::getenv("XDG_CACHE_HOME"))
    cache = std::filesystem::path(p) / "datamunge/datasets";
  else
    cache = std::filesystem::path(std::getenv("HOME")) / ".cache/datamunge/datasets";
  dm::datasets::fetch("cifar10", (cache / "cifar10").string());

  const auto train =
                 n::data::LoadCifar({cache / "cifar10/data_batch_1.bin"}, n::data::Cifar::k10),
             test =
                 n::data::LoadCifar({cache / "cifar10/test_batch.bin"}, n::data::Cifar::k10);
  std::vector<std::int64_t> fit_rows, val_rows, test_rows;
  for (int i = 0; i < 128; ++i)
    fit_rows.push_back(i);
  for (int i = 128; i < 160; ++i)
    val_rows.push_back(i);
  for (int i = 64; i < 96; ++i)
    test_rows.push_back(i);
  const auto fitting = m::SRPairs(train.images, fit_rows),
             validation = m::SRPairs(train.images, val_rows),
             testing = m::SRPairs(test.images, test_rows);

  const auto original = n::slice_axis(fitting.hr, 0, 0, 8),
             lr = n::resize_nearest(n::slice_axis(fitting.lr, 0, 0, 8), {32, 32}),
             bicubic = n::slice_axis(fitting.bicubic, 0, 0, 8);
  std::filesystem::create_directories("figures");
  n::save_image_grid(n::concat({original, lr, n::clip(bicubic, 0., 1.)}, 2),
                     "figures/super_resolution_inputs.png", 2, 0, 1, 2, 0, 3);
  const auto y = m::SRLumaTensor(fitting.hr),
             edges = n::arange(0., 1.0001, .02, n::DType::Float64),
             left = n::slice_axis(edges, 0, 0, 50), right = n::slice_axis(edges, 0, 1, 51),
             centers = (left + right) / 2.;
  const auto values = y.reshape({-1, 1}),
             hits = n::logical_and(n::greater_equal(values, left.reshape({1, 50})),
                                   n::less(values, right.reshape({1, 50}))),
             density = n::sum(hits.to(n::DType::Float64), {0}) / (y.numel() * .02);
  const auto aligned = m::SRScoreImages(fitting.bicubic, fitting);
  const auto errors = n::mean(n::square(aligned[0] - aligned[1]), {1, 2, 3});
  const auto score = m::ScoreTensorSR(testing.bicubic, testing);
  std::print("128 fitting/32 validation/32 original test images;HR32/LR16 x2. Test bicubic "
             "mean Y PSNR {:.6f}dB,SSIM {:.6f};pooled PSNR {:.6f}dB.\n",
             score.psnr.item(), score.ssim.item(), m::SRPSNRTensor(score.mse).item());
  auto a = dm::graphics::RPlot::create(), b = dm::graphics::RPlot::create();
  a.bars(centers.to_vector<double>(), density.to_vector<double>(), "original HR Y",
         {37, 99, 235}, .018)
      .title("Actual fitting-image luminance")
      .x_label("studio-range BT.601 Y")
      .y_label("pixel density")
      .y_limits(0, n::max(density).item() * 1.4);
  b.points(n::arange(0, 128).to_vector<double>(), m::SRPSNRTensor(errors).to_vector<double>(),
           "bicubic fit PSNR", {147, 51, 234})
      .title("Bicubic preserves different detail")
      .x_label("original fitting image row")
      .y_label("central Y PSNR in dB")
      .y_limits(0, 50);
  auto layout = dm::graphics::RLayout::create(1, 2);
  layout.add(a).add(b).size(1100, 500).fit_panels().save_svg(
      "build/super_resolution_data.svg");
}
```
