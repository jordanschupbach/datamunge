> Five distinct complete graphs

SRCNN consumes bicubic Y and applies VALID9-1-5 convolutions with64/32 hidden
channels,so its32 input becomes20 output. ESPCN works on LR Y with SAME5-3-3,
tanh64/32 channels and CRD shuffle. VDSR reconstructs residual Y. EDSR and
RCAN learn RGB in LR space with fixed mean shift,feature skips and learned
upsampling;they do not add the bicubic image. Every architecture omits BN.

Full models execute on small rectangular inputs. Training keeps full
SRCNN/ESPCN;VDSR uses16 channels/20 layers,EDSR16 channels/8 blocks,and
RCAN16 channels/2 groups/3 blocks/reduction4. Full EDSR is256 channels/32
blocks;full RCAN is64 channels/10 groups/20 blocks/reduction16. Native
checks execute full backward passes and verify every declared parameter
and stage;inactive attention ReLU branches can legitimately have zero gradients.
```{cpp, results="markdown", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

#include <print>
int main() {
  namespace n = dm::nn;
  namespace m = n::models;
  n::set_num_threads(2);
  std::print("| model | full scalars | full leaves | compact scalars | compact leaves | "
             "compact stages |\n|---|---:|---:|---:|---:|---:|\n");
  for (auto kind : {m::SRKind::kSrcnn, m::SRKind::kEspcn, m::SRKind::kVdsr, m::SRKind::kEdsr,
                    m::SRKind::kRcan}) {
    std::int64_t full = 0;
    std::size_t leaves = 0;
    {
      n::NoGradGuard guard;
      n::ParameterStore p(17);
      const auto cfg = m::SRConfig::Full(kind);
      const int side = cfg.PreUpsampled() ? 17 : 3;
      const auto out =
          m::SuperResolution(p, n::full({1, side, side + 2, cfg.Channels()}, .4), cfg);
      if (!n::all(n::is_finite(out.image)).item<bool>())
        return 1;
      full = p.count();
      leaves = p.size();
    }
    n::NoGradGuard guard;
    n::ParameterStore p(17);
    const auto cfg = m::SRConfig::Compact(kind);
    const int side = cfg.PreUpsampled() ? 17 : 3;
    const auto out =
        m::SuperResolution(p, n::full({1, side, side + 2, cfg.Channels()}, .4), cfg);
    std::print("| {} | {} | {} | {} | {} | {} |\n", m::SRName(kind), full, leaves, p.count(),
               p.size(), out.stages.size());
  }
}
```
