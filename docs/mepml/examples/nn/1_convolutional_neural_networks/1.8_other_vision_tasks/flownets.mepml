> Keep displacement units separate from spatial resolution

Every FlowNetS pyramid field stores **input-image pixels divided by20**.
Resizing such a field changes its sampling lattice,not its values. Multiply
the finest resized field by20 to recover input-pixel dx/dy. A separate
helper rescales components only when values are expressed in their own
source-grid pixels. Confusing these conventions scales predictions incorrectly.
```{cpp, results="markdown", file="figures/flownets_units.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

#include <print>
int main() {
  namespace n = dm::nn;
  namespace m = n::models;
  const auto field = n::ones({1, 2, 3, 2}) * n::tensor({2., -3.}).reshape({1, 1, 1, 2});
  const auto unchanged = m::FlowResizeValues(field, 4, 9),
             relative = m::FlowResizeVectors(field, 2, 3, 4, 9),
             level = m::FlowPyramidPixels(field, 2);
  auto a = dm::graphics::RPlot::create(), b = dm::graphics::RPlot::create();
  a.bars({-.18, .82}, n::select(unchanged.reshape({-1, 2}), 0, 0).to_vector<double>(),
         "fixed input units", {37, 99, 235}, .3)
      .bars({.18, 1.18}, n::select(relative.reshape({-1, 2}), 0, 0).to_vector<double>(),
            "grid-relative", {220, 38, 38}, .3)
      .title("Resize values versus grid vectors")
      .x_label("0 horizontal,1 vertical")
      .y_label("component in declared units")
      .y_limits(-8, 8);
  b.bars({0., 1.}, n::select(level.reshape({-1, 2}), 0, 0).to_vector<double>(),
         "level2 pixels", {22, 163, 74})
      .title("Input pixels/20 to level2 pixels")
      .x_label("0 horizontal,1 vertical")
      .y_label("component multiplied by20/4")
      .y_limits(-20, 15);
  std::filesystem::create_directories("build");
  auto layout = dm::graphics::RLayout::create(1, 2);
  layout.add(a).add(b).size(1100, 500).fit_panels().save_svg("build/flownets_units.svg");
  std::print("Resize keeps(2,-3);grid-relative resize to4x9 gives(6,-6);level2 conversion "
             "gives(10,-15).\n");
}
