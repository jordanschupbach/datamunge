> Execute full and compact six-scale FlowNetS

Concatenate the jointly centered RGB frames into six channels. Encoder
kernels7/5/5/3/3/3 use stride2 with explicit symmetric padding;extra
conv3_1 through6_1 retain the deepest features. Four decoder levels use
learned feature transposes,learned bias-free flow transposes,encoder skips
and new flow predictions. Glorot kernels,zero biases and LeakyReLU(.1) follow
the teaching source. There is no BN or target input. FlowNetS directly
concatenates images;the local correlation primitive is used by PWC-Net later.
```{cpp, results="markdown", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

#include <print>
int main() {
  namespace n = dm::nn;
  namespace m = n::models;
  n::set_num_threads(2);
  std::print("| base | learned scalars | learned tensors | stages | both-image gradients "
             "|\n|---:|---:|---:|---:|---|\n");
  for (int base : {64, 8}) {
    n::ParameterStore p(163);
    const auto first = (.5 +
                        .4 * n::sin(n::arange(0, 2 * 64 * 64 * 3, 1, n::DType::Float64) * .17))
                           .to(n::DType::Float32)
                           .reshape({2, 64, 64, 3})
                           .requires_grad_(),
               second = (.5 + .4 * n::cos(n::arange(0, 2 * 64 * 64 * 3, 1, n::DType::Float64) *
                                          .13))
                            .to(n::DType::Float32)
                            .reshape({2, 64, 64, 3})
                            .requires_grad_();
    const auto out = m::FlowNetS(p, first, second, 64, 64, base);
    n::Tensor loss;
    for (const auto &level : out.pyramid)
      loss = loss.defined() ? loss + n::mean(n::square(level)) : n::mean(n::square(level));
    auto leaves = p.parameters();
    leaves.push_back(first);
    leaves.push_back(second);
    const auto gradients = n::grad(loss, leaves);
    for (const auto &g : gradients)
      if (!n::all(n::less(n::abs(g), INFINITY)).item<bool>() ||
          (base == 8 && n::sum(n::square(g.to(n::DType::Float64))).item() <= 0))
        return 1;
    if (p.size() != 42 || out.stages.size() != 27 ||
        out.flow.shape() != n::Shape{2, 64, 64, 2})
      return 1;
    std::print("| {} | {} | {} | {} | finite,compact nonzero |\n", base, p.count(), p.size(),
               out.stages.size());
  }
}
```
