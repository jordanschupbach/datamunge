> A smooth masked endpoint objective

For vector residual d,pixel loss is
\(\sqrt{\lVert d\rVert^2+\epsilon^2}-\epsilon\),with epsilon.001.
The implementation preserves the source Float32 representations of1e-6 and
.001. Its derivative is d/sqrt(norm²+epsilon²),finite and zero at d=0.
Each supported image averages its valid pixels;unsupported images are excluded.
Invalid target/prediction locations are selected out **before** arithmetic.

Five target levels use valid-block mean GT divided by20. Weighted losses
have coefficients .005,.01,.02,.08,.32 from levels2 through6. Empty blocks
have zero targets/masks,not an invented flow vector with positive supervision.
Endpoint/augmented-angular metrics use input pixels,and strict bad-pixel
thresholds include the3px and5% boundary cases in native tests.
```{cpp, results="markdown", file="figures/flownets_loss.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

#include <print>
int main() {
  namespace n = dm::nn;
  namespace m = n::models;
  const auto dx = n::arange(-1., 1.001, .01, n::DType::Float64).reshape({1, 1, 201, 1});
  const auto p = n::concat({dx, n::zeros_like(dx)}, 3).requires_grad_();
  const auto objective = m::FlowEndpointLoss(p, n::zeros_like(p), n::ones({1, 1, 201, 1}));
  const auto gradient = n::grad(objective, {p})[0] * 201.;
  const auto values = n::sqrt(n::square(dx) + double(1e-6f)) - double(.001f);
  const auto fine =
      n::arange(-.006, .006001, .0001, n::DType::Float64).reshape({1, 1, 121, 1});
  const auto fine_field = n::concat({fine, n::zeros_like(fine)}, 3).requires_grad_();
  const auto fine_loss =
      m::FlowEndpointLoss(fine_field, n::zeros_like(fine_field), n::ones({1, 1, 121, 1}));
  const auto fine_gradient = n::grad(fine_loss, {fine_field})[0] * 121.;
  auto a = dm::graphics::RPlot::create(), b = dm::graphics::RPlot::create();
  a.lines(dx.reshape({201}).to_vector<double>(), values.reshape({201}).to_vector<double>(),
          "smooth endpoint", {37, 99, 235})
      .title("Smooth endpoint norm near zero")
      .x_label("horizontal residual;vertical zero")
      .y_label("smooth vector endpoint loss")
      .y_limits(-.05, 1.3);
  b.lines(fine.reshape({121}).to_vector<double>(),
          n::select(fine_gradient, 3, 0).reshape({121}).to_vector<double>(),
          "local derivative", {220, 38, 38})
      .title("Finite gradient near perfect flow")
      .x_label("horizontal residual near zero")
      .y_label("local horizontal derivative")
      .y_limits(-1.2, 1.4);
  std::filesystem::create_directories("build");
  auto layout = dm::graphics::RLayout::create(1, 2);
  layout.add(a).add(b).size(1100, 480).fit_panels().save_svg("build/flownets_loss.svg");
  const auto score = m::ScoreTensorFlow(
      n::zeros({1, 1, 1, 2}), n::tensor({3., 4.}, {1, 1, 1, 2}), n::ones({1, 1, 1, 1}));
  std::print(
      "Hand3/4/5 endpoint error {},augmented angular error {:.6f}deg,bad3/Fl-all {}/{}.\n",
      score.epe.item(), score.aae.item(), score.bad3.item(), score.fl_all.item());
}
```
