\caption(For two opposite chroma targets with the same lightness,the neutral conditional mean minimizes squared error and cancels the shared prediction gradient.)
\alttext(For two opposite chroma targets with the same lightness,the neutral conditional mean minimizes squared error and cancels the shared prediction gradient.)

> Complete encoder,global context and spatial skips

Ten learned convolutions retain the source architecture. After two stride2
reductions,the context branch pools globally and projects to32 channels.
Bilinear resizing broadcasts this context back into spatial fusion. Two
skip-connected decoder levels recover the original image size and a final
biased1x1/tanh predicts two chroma channels. Half-pixel bilinear geometry
preserves odd rectangular inputs too;there is no BN state or color shortcut.
```{cpp, results="markdown", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

#include <print>
int main() {
  namespace n = dm::nn;
  namespace m = n::models;
  n::set_num_threads(2);
  n::ParameterStore p(31);
  const auto lightness = (.8 * n::sin(n::arange(0, 2 * 33 * 35, 1, n::DType::Float64) * .17))
                             .to(n::DType::Float32)
                             .reshape({2, 33, 35, 1})
                             .requires_grad_();
  const auto target = (.3 * n::cos(n::arange(0, 2 * 33 * 35 * 2, 1, n::DType::Float64) * .13))
                          .to(n::DType::Float32)
                          .reshape({2, 33, 35, 2});
  const auto out = m::Colorization(p, lightness);
  const auto loss = m::ColorizationLoss(out.chroma, target);
  auto leaves = p.parameters();
  leaves.push_back(lightness);
  const auto gradient = n::grad(loss, leaves);
  double minimum = INFINITY;
  for (const auto &g : gradient) {
    if (!n::all(n::less(n::abs(g), INFINITY)).item<bool>())
      return 1;
    minimum = std::min(minimum, n::sqrt(n::sum(n::square(g.to(n::DType::Float64)))).item());
  }
  if (minimum <= 0 || p.count() != 140082 || p.size() != 20)
    return 1;
  std::print(
      "140082 learned scalars/20 tensors;all20 plus lightness gradients finite/nonzero,min "
      "norm {:.3g}.\n| stage | height | width | channels |\n|---:|---:|---:|---:|\n",
      minimum);
  for (std::size_t i = 0; i < out.stages.size(); ++i) {
    const auto &v = out.stages[i];
    std::print("| {} | {} | {} | {} |\n", i + 1, v.size(1), v.size(2), v.size(3));
  }
}
```
