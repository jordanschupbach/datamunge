> Real images and a visible SGD constant-chroma fit

CIFAR fitting rows0–255 and validation256–287 come from the first official
training binary;held-out images are official-test rows96–127. Read the existing
`DATAMUNGE_DATA_DIR/cifar10` or standard XDG/home dataset cache. Original32px
RGB is converted to Lab without cropping,augmentation or class-label inputs.

A constant two-coordinate chroma is a fitted baseline. To show its optimization,
minimize the **sum of the two coordinate MSEs**. Its gradient is2(q-mean);
one explicit SGD step with learning rate .5 from zero reaches the mean.
The tensor mean helper is only an independent closed-form check. The saved
fitted tensor is later used unchanged on validation and test images.
```{cpp, results="markdown", file="figures/image_colorization_prior.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

#include <numeric>
#include <print>
int main() {
  namespace n = dm::nn;
  namespace m = n::models;
  n::set_num_threads(2);

  std::filesystem::path cache;
  if (const auto *p = std::getenv("DATAMUNGE_DATA_DIR"))
    cache = p;
  else if (const auto *p = std::getenv("XDG_CACHE_HOME"))
    cache = std::filesystem::path(p) / "datamunge/datasets";
  else
    cache = std::filesystem::path(std::getenv("HOME")) / ".cache/datamunge/datasets";
  dm::datasets::fetch("cifar10", (cache / "cifar10").string());

  const auto raw =
                 n::data::LoadCifar({cache / "cifar10/data_batch_1.bin"}, n::data::Cifar::k10),
             testing =
                 n::data::LoadCifar({cache / "cifar10/test_batch.bin"}, n::data::Cifar::k10);
  std::vector<std::size_t> fi(256), vi(32), ti(32);
  std::iota(fi.begin(), fi.end(), 0);
  std::iota(vi.begin(), vi.end(), 256);
  std::iota(ti.begin(), ti.end(), 96);
  const auto fit = m::ColorPairs(raw.images, fi), validation = m::ColorPairs(raw.images, vi),
             test = m::ColorPairs(testing.images, ti);

  n::ParameterStore prior(41, n::DType::Float64);
  const auto q = prior.get("chroma", {2}, n::init::zeros());
  n::OptimizerConfig config;
  config.kind = n::OptimizerKind::Sgd;
  n::Optimizer sgd(prior, .5, config);
  const auto target = fit.chroma.to(n::DType::Float64);
  for (int step = 0; step < 1; ++step) {
    const auto loss = n::sum(n::mean(n::square(q.reshape({1, 1, 1, 2}) - target), {0, 1, 2}));
    sgd.minimize(loss);
  }
  const auto fitted = q.detach().to(n::DType::Float32);
  const auto closed = m::ColorMeanChroma(fit);
  const auto expected =
      n::from_vector(std::vector<double>{closed[0], closed[1]}, {2}).to(n::DType::Float32);
  const double error = n::max(n::abs(fitted - expected)).item();
  if (error > 1e-8)
    return 1;
  const auto gray = m::ScoreTensorColor(fit, n::zeros_like(fit.chroma));
  const auto mean =
      m::ScoreTensorColor(fit, n::ones(fit.chroma.shape()) * fitted.reshape({1, 1, 1, 2}));
  const m::ColorData first{m::ColorBatch(fit.lightness, {0, 1, 2, 3, 4, 5, 6, 7}),
                           m::ColorBatch(fit.chroma, {0, 1, 2, 3, 4, 5, 6, 7}),
                           m::ColorBatch(fit.rgb, {0, 1, 2, 3, 4, 5, 6, 7})};
  std::filesystem::create_directories("build");
  std::filesystem::create_directories("figures");
  n::save_npz("build/image_colorization_prior.npz", {{"chroma", fitted}});
  n::save_image_grid(m::ColorPreviewTiles(first,
                                          m::ColorBatch(mean.rgb, {0, 1, 2, 3, 4, 5, 6, 7}),
                                          m::ColorBatch(gray.rgb, {0, 1, 2, 3, 4, 5, 6, 7}),
                                          m::ColorBatch(mean.rgb, {0, 1, 2, 3, 4, 5, 6, 7})),
                     "figures/image_colorization_inputs.png", 1, 0, 1, 0, 0, 3);
  auto p = dm::graphics::RPlot::create();
  p.bars({0., 1.}, (128. * fitted).to_vector<double>(), "SGD-fitted chroma", {147, 51, 234})
      .title("One visible SGD step fits mean chroma")
      .x_label("0 a,1 b")
      .y_label("physical Lab coordinate")
      .y_limits(-1, 8)
      .size(900, 480);
  p.save_svg("build/image_colorization_prior.svg");
  std::print("Fit/validation/test images {}/{}/{};one explicit SGD(.5) update,mean parity "
             "{:.3g};physical a/b {:.6f}/{:.6f}.\n",
             fit.rgb.size(0), validation.rgb.size(0), test.rgb.size(0), error,
             128 * fitted.to_vector<double>()[0], 128 * fitted.to_vector<double>()[1]);
}
```
