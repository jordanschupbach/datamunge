> Identical lightness can imply opposite colors

Suppose the same lightness is paired with normalized chroma(.25,-.5) and
(-.25,.5). A shared prediction q minimizes the average squared residual.
For each coordinate its optimum is the conditional mean,here zero. The loss
at zero is .15625 and its gradient is exactly zero. This is an irreducible
ambiguity in the observation,not a missing optimizer step. Squared-error
regression can therefore desaturate colors even when fitting succeeds.
```{cpp, results="markdown", file="figures/image_colorization_ambiguity.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

#include <print>
int main() {
  namespace n = dm::nn;
  namespace m = n::models;
  const auto target = n::tensor({.25, -.5, -.25, .5}, {2, 1, 1, 2});
  auto neutral = n::zeros({1, 1, 1, 2}).requires_grad_();
  const auto loss = m::ColorizationLoss(n::tile(neutral, {2, 1, 1, 1}), target);
  const auto gradient = n::grad(loss, {neutral})[0];
  const auto q = n::arange(-.75, .7501, .01, n::DType::Float64);
  const auto risk = ((n::square(q - .25) + n::square(q + .25)) * .5 + .25) * .5;
  auto a = dm::graphics::RPlot::create(), b = dm::graphics::RPlot::create();
  a.lines(q.to_vector<double>(), risk.to_vector<double>(), "opposite-color MSE", {37, 99, 235})
      .title("Ambiguity has a neutral optimum")
      .x_label("predicted a/128;b prediction zero")
      .y_label("two-channel mean squared error")
      .y_limits(0, .55);
  b.lines(q.to_vector<double>(), q.to_vector<double>(), "risk derivative", {220, 38, 38})
      .title("Opposite targets cancel at zero")
      .x_label("predicted a/128")
      .y_label("d risk / d predicted a")
      .y_limits(-.9, 1.1);
  std::filesystem::create_directories("build");
  auto layout = dm::graphics::RLayout::create(1, 2);
  layout.add(a).add(b).size(1100, 480).fit_panels().save_svg(
      "build/image_colorization_ambiguity.svg");
  std::print("Shared neutral loss {:.5f};max gradient {:.3g}.\n", loss.item(),
             n::max(n::abs(gradient)).item());
  if (loss.item() != .15625 || n::max(n::abs(gradient)).item() != 0)
    return 1;
}
```
