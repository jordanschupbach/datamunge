> Complete-model Adam and lightness-only deployment

The CNN minimizes mean squared normalized ab residuals over all image,pixel
and two-channel entries. Warm all20 learned leaves,then use Adam(.001),batch8,
three epochs and the source seeded batch order. Validation chroma MSE selects
the checkpoint. Restore independent inference parameters and supply only L;
there are no targets,labels,optimizer or extra color inputs in its forward call.

RGB scores decode the given lightness and predicted ab. Report normalized ab
MSE,mean DeltaE76,mean per-image RGB PSNR,mean physical chroma and raw
out-of-gamut **pixel** fraction. Only decoded RGB is clipped for PSNR/display.
Gray has no fitted parameters;the other baseline loads the earlier SGD result.
```{cpp, results="markdown", file="figures/image_colorization_training.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

#include <numeric>
#include <print>
int main() {
  namespace n = dm::nn;
  namespace m = n::models;
  n::set_num_threads(2);

  std::filesystem::path cache;
  if (const auto *p = std::getenv("DATAMUNGE_DATA_DIR"))
    cache = p;
  else if (const auto *p = std::getenv("XDG_CACHE_HOME"))
    cache = std::filesystem::path(p) / "datamunge/datasets";
  else
    cache = std::filesystem::path(std::getenv("HOME")) / ".cache/datamunge/datasets";
  dm::datasets::fetch("cifar10", (cache / "cifar10").string());

  const auto raw =
                 n::data::LoadCifar({cache / "cifar10/data_batch_1.bin"}, n::data::Cifar::k10),
             testing =
                 n::data::LoadCifar({cache / "cifar10/test_batch.bin"}, n::data::Cifar::k10);
  std::vector<std::size_t> fi(256), vi(32), ti(32);
  std::iota(fi.begin(), fi.end(), 0);
  std::iota(vi.begin(), vi.end(), 256);
  std::iota(ti.begin(), ti.end(), 96);
  const auto fit = m::ColorPairs(raw.images, fi), validation = m::ColorPairs(raw.images, vi),
             test = m::ColorPairs(testing.images, ti);

  n::ParameterStore p(31);
  {
    n::NoGradGuard guard;
    m::Colorization(p, n::zeros({1, 32, 32, 1}));
  }
  n::OptimizerConfig opt;
  opt.kind = n::OptimizerKind::Adam;
  n::Optimizer adam(p, .001, opt);
  auto predict = [](n::ParameterStore &store, const n::Tensor &lightness) {
    n::NoGradGuard guard;
    std::vector<n::Tensor> parts;
    for (std::int64_t i = 0; i < lightness.size(0); i += 8)
      parts.push_back(m::Colorization(store, n::slice_axis(lightness, 0, i,
                                                           std::min(i + 8, lightness.size(0))))
                          .chroma);
    return n::concat(parts, 0);
  };
  const auto probe_l = m::ColorBatch(fit.lightness, {0, 1, 2, 3, 4, 5, 6, 7}),
             probe_ab = m::ColorBatch(fit.chroma, {0, 1, 2, 3, 4, 5, 6, 7});
  const double initial = m::ColorizationLoss(predict(p, probe_l), probe_ab).item();
  n::BatchOrder order(256, 8, 37);
  std::vector<double> epochs, training, valid;
  double best = INFINITY;
  int selected = 0, updates = 0;
  std::filesystem::create_directories("build");
  std::filesystem::create_directories("figures");
  std::print("140082 learned scalars/20 warmed tensors.\n| epoch | fitting ab MSE | "
             "validation ab MSE |\n|---:|---:|---:|\n");
  for (int epoch = 1; epoch <= 3; ++epoch) {
    order.begin_epoch();
    double total = 0;
    int seen = 0;
    for (auto ids = order.next(); !ids.empty(); ids = order.next()) {
      const std::vector<std::size_t> rows(ids.begin(), ids.end());
      const auto lightness = m::ColorBatch(fit.lightness, rows),
                 truth = m::ColorBatch(fit.chroma, rows);
      const auto prediction = m::Colorization(p, lightness).chroma;
      const auto loss = m::ColorizationLoss(prediction, truth);
      if (!std::isfinite(loss.item()))
        return 1;
      total += loss.item() * rows.size();
      seen += rows.size();
      adam.minimize(loss);
      ++updates;
    }
    if (seen != 256)
      return 1;
    epochs.push_back(epoch);
    training.push_back(total / seen);
    valid.push_back(
        m::ColorizationLoss(predict(p, validation.lightness), validation.chroma).item());
    if (valid.back() < best) {
      best = valid.back();
      selected = epoch;
      p.save("build/image_colorization_best.npz");
    }
    std::print("| {} | {:.6f} | {:.6f} |\n", epoch, training.back(), valid.back());
  }
  p.load("build/image_colorization_best.npz");
  const double restored =
                   m::ColorizationLoss(predict(p, validation.lightness), validation.chroma)
                       .item(),
               learned = m::ColorizationLoss(predict(p, probe_l), probe_ab).item();
  if (std::abs(restored - best) > 1e-8 || learned >= initial ||
      training.back() >= training.front())
    return 1;
  n::ParameterStore deployed(991);
  {
    n::NoGradGuard guard;
    m::Colorization(deployed, n::zeros({1, 32, 32, 1}));
  }
  deployed.load("build/image_colorization_best.npz");
  std::vector<n::Tensor> snapshot;
  for (const auto &v : deployed.parameters())
    snapshot.push_back(v.clone());
  const auto prediction = predict(deployed, test.lightness),
             reference = predict(p, test.lightness),
             repeat = predict(deployed, test.lightness);
  const double parity = n::max(n::abs(prediction - reference)).item();
  if (parity > 1e-7 || !n::all(n::equal(prediction, repeat)).item<bool>())
    return 1;
  const auto single = predict(deployed, m::ColorBatch(test.lightness, {3}));
  if (n::max(n::abs(single - n::slice_axis(prediction, 0, 3, 4))).item() > 1e-6)
    return 1;
  for (std::size_t i = 0; i < snapshot.size(); ++i)
    if (!n::all(n::equal(snapshot[i], deployed.parameters()[i])).item<bool>())
      return 1;
  const double variation =
      n::mean(n::abs(n::select(prediction, 0, 0) - n::select(prediction, 0, 1))).item();
  if (variation <= 1e-6)
    return 1;
  const auto fitted = n::load_npz("build/image_colorization_prior.npz").at(0).second;
  const auto mean = n::ones(test.chroma.shape()) * fitted.reshape({1, 1, 1, 2});
  const auto score = m::ScoreTensorColor(test, prediction),
             gray = m::ScoreTensorColor(test, n::zeros_like(test.chroma)),
             prior = m::ScoreTensorColor(test, mean);
  std::print("{} visible Adam updates;selected epoch{},restored validation {:.6f};fixed "
             "fitting {:.6f}->{:.6f}.\nLightness-only deployment parity {:.3g},all20 tensors "
             "immutable,repeat exact,single/batch agree;image-pair chroma difference "
             "{:.6f}.\n| model | ab MSE | DeltaE76 | RGB PSNR dB | mean chroma | gamut pixel "
             "fraction |\n|---|---:|---:|---:|---:|---:|\n",
             updates, selected, restored, initial, learned, parity, variation);
  for (const auto &item : std::vector<std::pair<std::string, m::TensorColorMetrics>>{
           {"learned", score}, {"grayscale", gray}, {"SGD mean", prior}})
    std::print("| {} | {:.6f} | {:.6f} | {:.6f} | {:.6f} | {:.6f} |\n", item.first,
               item.second.ab_mse.item(), item.second.delta_e76.item(),
               item.second.rgb_psnr.item(), item.second.chroma.item(),
               item.second.clipped_pixels.item());
  n::save_image_grid(m::ColorPreviewTiles(test, score.rgb, gray.rgb, prior.rgb),
                     "figures/image_colorization_predictions.png", 2, 0, 1, 0, 0, 3);
  n::save_npz("build/image_colorization_test.npz", {{"lightness", test.lightness},
                                                    {"predicted_chroma", prediction},
                                                    {"rgb", score.rgb},
                                                    {"target_rgb", test.rgb}});
  auto a = dm::graphics::RPlot::create(), b = dm::graphics::RPlot::create();
  a.bars({0., 1., 2.}, {score.ab_mse.item(), gray.ab_mse.item(), prior.ab_mse.item()},
         "normalized ab MSE", {37, 99, 235})
      .title("Chroma regression error")
      .x_label("0 CNN,1 gray,2 SGD mean")
      .y_label("two-channel normalized MSE")
      .y_limits(0, .018);
  b.bars({0., 1., 2.}, {score.rgb_psnr.item(), gray.rgb_psnr.item(), prior.rgb_psnr.item()},
         "RGB PSNR", {22, 163, 74})
      .title("RGB scores can favor grayscale")
      .x_label("0 CNN,1 gray,2 SGD mean")
      .y_label("mean per-image PSNR in dB")
      .y_limits(0, 34);
  auto metrics = dm::graphics::RLayout::create(1, 2);
  metrics.add(a).add(b).size(1100, 480).fit_panels().save_svg(
      "build/image_colorization_metrics.svg");
  std::filesystem::copy_file("build/image_colorization_metrics.svg",
                             "figures/image_colorization_metrics.svg",
                             std::filesystem::copy_options::overwrite_existing);
  a = dm::graphics::RPlot::create();
  a.lines(epochs, training, "fitting ab MSE", {37, 99, 235})
      .lines(epochs, valid, "validation ab MSE", {220, 38, 38})
      .title("Visible complete-model Adam fitting")
      .x_label("epoch")
      .y_label("mean squared normalized ab error")
      .y_limits(0, .016)
      .size(950, 480);
  a.save_svg("build/image_colorization_training.svg");
}
```
