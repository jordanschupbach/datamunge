> Explicit Adam training and paired validation checkpoints

Warm all62 learned and30 BN tensors before Adam(.001). Cache fixed VGG
content targets and four painting Grams with no graph. Set content/style/TV
denominators once from the initial training-mode output. Show all36 two-image
minibatch updates over three epochs. Training uses batch moments and updates
moving BN once per step;validation uses moving statistics without mutation.
Save learned parameters and BN state together when validation improves.

Restore a separate generator-only model. Its prediction call receives observed
RGB only;there is no VGG,painting,target or optimizer in deployment. Prove
paired checkpoint parity,repeated output,immutable weights/BN and single/batch
agreement. Compare all eight held-out contents with initialization using the
same frozen perceptual objectives. Report actual outputs,content sensitivity
and measured small-image CPU latency without a real-time claim.
```{cpp, results="markdown", file="figures/johnson_fast_style_training.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

#include <chrono>
#include <print>
int main() {
  namespace n = dm::nn;
  namespace m = n::models;
  n::set_num_threads(2);

  std::filesystem::path cache;
  if (const auto *p = std::getenv("DATAMUNGE_DATA_DIR"))
    cache = p;
  else if (const auto *p = std::getenv("XDG_CACHE_HOME"))
    cache = std::filesystem::path(p) / "datamunge/datasets";
  else
    cache = std::filesystem::path(std::getenv("HOME")) / ".cache/datamunge/datasets";
  dm::datasets::fetch("cifar10", (cache / "cifar10").string());

  std::filesystem::path assets = cache / "style_transfer";
  if (const auto *p = std::getenv("DATAMUNGE_STYLE_DIR"))
    assets = p;
  else
    dm::datasets::prepare_example_data("style", assets.string());

  const auto original_train =
                 n::data::LoadCifar({cache / "cifar10/data_batch_1.bin"}, n::data::Cifar::k10),
             original_test =
                 n::data::LoadCifar({cache / "cifar10/test_batch.bin"}, n::data::Cifar::k10);
  std::vector<std::size_t> fit_rows, val_rows, test_rows;
  for (int i = 0; i < 24; ++i)
    fit_rows.push_back(i);
  for (int i = 24; i < 32; ++i)
    val_rows.push_back(i);
  for (int i = 8; i < 16; ++i)
    test_rows.push_back(i);
  const auto fitting = m::FastStyleImages(original_train.images, fit_rows),
             validation = m::FastStyleImages(original_train.images, val_rows),
             testing = m::FastStyleImages(original_test.images, test_rows),
             painting = m::LoadStyleImage(assets / "style.jpg", 64);

  const auto weights = m::LoadTensorMap((assets / "vgg16.npz").string());
  m::FrozenVgg16 vgg(weights);
  std::array<n::Tensor, 4> style_targets;
  {
    n::NoGradGuard guard;
    const auto f = vgg.Extract(painting);
    for (int i = 0; i < 4; ++i)
      style_targets[i] = m::JohnsonGram(f.style[i]);
  }
  auto cache_content = [&](const n::Tensor &images) {
    n::NoGradGuard guard;
    std::vector<n::Tensor> parts;
    for (std::int64_t i = 0; i < images.size(0); i += 2)
      parts.push_back(
          vgg.Extract(n::slice_axis(images, 0, i, std::min(i + 2, images.size(0)))).content);
    return n::concat(parts, 0);
  };
  const auto fit_targets = cache_content(fitting), val_targets = cache_content(validation),
             test_targets = cache_content(testing);
  const auto cached_fit = fit_targets.clone(), cached_val = val_targets.clone(),
             cached_test = test_targets.clone();
  std::array<n::Tensor, 4> gram_snapshots;
  for (int i = 0; i < 4; ++i)
    gram_snapshots[i] = style_targets[i].clone();
  n::ParameterStore p(17), state(18);
  {
    n::NoGradGuard guard;
    m::JohnsonTransform(p, state, n::zeros({1, 64, 64, 3}), 8, false);
  }
  n::OptimizerConfig config;
  config.kind = n::OptimizerKind::Adam;
  n::Optimizer adam(p, .001, config);
  double content_denominator = 1, style_denominator = 1, tv_denominator = 1;
  auto objective = [&](const n::Tensor &x, const n::Tensor &target, bool training,
                       bool update) {
    const auto output = m::JohnsonTransform(p, state, x, 8, training, update).image;
    const auto f = vgg.Extract(output);
    const auto c = m::JohnsonContent(f.content, target),
               s = m::JohnsonStyle(f.style, style_targets), tv = m::JohnsonTV(output);
    return std::array<n::Tensor, 4>{
        c / content_denominator + s / style_denominator + tv / tv_denominator, c, s, tv};
  };
  const auto probe = n::slice_axis(fitting, 0, 0, 2),
             probe_target = n::slice_axis(fit_targets, 0, 0, 2);
  {
    n::NoGradGuard guard;
    const auto raw = objective(probe, probe_target, true, false);
    content_denominator = double(float(raw[1].item()));
    style_denominator = double(float(raw[2].item()));
    tv_denominator = double(float(raw[3].item()));
  }
  if (content_denominator <= 0 || style_denominator <= 0 || tv_denominator <= 1e-12)
    return 1;
  auto score = [&](const n::Tensor &images, const n::Tensor &targets) {
    n::NoGradGuard guard;
    std::vector<n::Tensor> values;
    for (std::int64_t i = 0; i < images.size(0); i += 2) {
      const auto losses = objective(n::slice_axis(images, 0, i, i + 2),
                                    n::slice_axis(targets, 0, i, i + 2), false, false);
      values.push_back(
          n::stack({losses[0], losses[1], losses[2], losses[3]}, 0).to(n::DType::Float64));
    }
    return n::mean(n::stack(values, 0), {0});
  };
  std::array<double, 4> initial;
  {
    n::NoGradGuard guard;
    const auto loss = objective(probe, probe_target, true, false);
    for (int i = 0; i < 4; ++i)
      initial[i] = loss[i].item();
  }
  const auto untrained = score(testing, test_targets);
  n::BatchOrder order(24, 2, 29);
  double best = INFINITY;
  int selected = 0, updates = 0;
  std::vector<double> epochs, history, validation_history, val_content, val_style, val_tv;
  std::filesystem::create_directories("build");
  std::filesystem::create_directories("figures");
  std::print(
      "62 learned/30 moving-BN tensors warmed before Adam(.001).\nFixed content/style/TV "
      "denominators {:.6f}/{:.6f}/{:.6f}.\n| epoch | mean fitting | validation | relative "
      "content | relative style | relative TV |\n|---:|---:|---:|---:|---:|---:|\n",
      content_denominator, style_denominator, tv_denominator);
  for (int epoch = 1; epoch <= 3; ++epoch) {
    order.begin_epoch();
    auto total = n::full({}, 0., n::DType::Float64);
    int seen = 0;
    for (auto rows = order.next(); !rows.empty(); rows = order.next()) {
      const std::vector<std::size_t> ids(rows.begin(), rows.end());
      const auto losses = objective(m::FastStyleBatch(fitting, ids),
                                    m::FastStyleBatch(fit_targets, ids), true, true);
      if (!std::isfinite(losses[0].item()))
        return 1;
      total = total + losses[0].detach().to(n::DType::Float64) * double(rows.size());
      seen += rows.size();
      adam.step(n::grad(losses[0], p.parameters()));
      ++updates;
    }
    if (seen != 24)
      return 1;
    const auto val = score(validation, val_targets);
    const double value = n::select(val, 0, 0).item();
    epochs.push_back(epoch);
    history.push_back((total / 24.).item());
    validation_history.push_back(value);
    val_content.push_back(n::select(val, 0, 1).item() / content_denominator);
    val_style.push_back(n::select(val, 0, 2).item() / style_denominator);
    val_tv.push_back(n::select(val, 0, 3).item() / tv_denominator);
    if (value < best) {
      best = value;
      selected = epoch;
      m::SaveJohnson(p, state, "build/johnson_fast_style_best.npz");
    }
    std::print("| {} | {:.6f} | {:.6f} | {:.6f} | {:.6f} | {:.6f} |\n", epoch, history.back(),
               value, val_content.back(), val_style.back(), val_tv.back());
  }
  m::RestoreJohnson(p, state, "build/johnson_fast_style_best.npz");
  if (std::abs(n::select(score(validation, val_targets), 0, 0).item() - best) > 1e-6 ||
      updates != 36 || history.back() >= history.front())
    return 1;
  std::array<double, 4> learned;
  {
    n::NoGradGuard guard;
    const auto l = objective(probe, probe_target, true, false);
    for (int i = 0; i < 4; ++i)
      learned[i] = l[i].item();
  }
  if (learned[0] >= initial[0] || learned[2] >= initial[2] * .999)
    return 1;
  const auto heldout = score(testing, test_targets);
  n::ParameterStore deployed(991), moving(997);
  {
    n::NoGradGuard guard;
    m::JohnsonTransform(deployed, moving, n::zeros({1, 64, 64, 3}), 8, false);
  }
  m::RestoreJohnson(deployed, moving, "build/johnson_fast_style_best.npz");
  std::vector<n::Tensor> snapshots;
  for (const auto &w : deployed.parameters())
    snapshots.push_back(w.clone());
  for (const auto &w : moving.parameters())
    snapshots.push_back(w.clone());
  auto predict = [&](n::ParameterStore &store, n::ParameterStore &statistics,
                     const n::Tensor &rgb) {
    n::NoGradGuard guard;
    return m::JohnsonTransform(store, statistics, rgb, 8, false, false).image;
  };
  const auto prediction = predict(deployed, moving, testing),
             reference = predict(p, state, testing),
             repeat = predict(deployed, moving, testing),
             single = predict(deployed, moving, n::slice_axis(testing, 0, 0, 1));
  const double parity = n::max(n::abs(prediction - reference)).item(),
               batch_error =
                   n::max(n::abs(single - n::slice_axis(prediction, 0, 0, 1))).item(),
               sensitivity = n::mean(n::abs(n::slice_axis(prediction, 0, 1, 8) -
                                            n::slice_axis(prediction, 0, 0, 1)))
                                 .item();
  if (parity > 2e-6 || batch_error > 1e-5 ||
      !n::all(n::equal(prediction, repeat)).item<bool>() || sensitivity <= 1e-4)
    return 1;
  const auto one = n::slice_axis(testing, 0, 0, 1);
  predict(deployed, moving, one);
  const auto started = std::chrono::steady_clock::now();
  for (int i = 0; i < 3; ++i)
    predict(deployed, moving, one);
  const double milliseconds =
      std::chrono::duration<double, std::milli>(std::chrono::steady_clock::now() - started)
          .count() /
      3.;
  std::size_t at = 0;
  for (const auto &w : deployed.parameters())
    if (!n::all(n::equal(w, snapshots[at++])).item<bool>())
      return 1;
  for (const auto &w : moving.parameters())
    if (!n::all(n::equal(w, snapshots[at++])).item<bool>())
      return 1;
  vgg.CheckFrozen();
  for (int i = 0; i < 4; ++i)
    if (!n::all(n::equal(style_targets[i], gram_snapshots[i])).item<bool>())
      return 1;
  if (!n::all(n::equal(cached_fit, fit_targets)).item<bool>() ||
      !n::all(n::equal(cached_val, val_targets)).item<bool>() ||
      !n::all(n::equal(cached_test, test_targets)).item<bool>())
    return 1;
  std::print("{} visible updates;selected epoch{},restored validation {:.6f};fixed "
             "training-mode fit {:.6f}->{:.6f}.\n| evaluation | combined | relative content | "
             "relative style | relative TV |\n|---|---:|---:|---:|---:|\n",
             updates, selected, best, initial[0], learned[0]);
  for (const auto &item : std::vector<std::pair<std::string, n::Tensor>>{
           {"initial generator", untrained}, {"restored generator", heldout}})
    std::print("| {} | {:.6f} | {:.6f} | {:.6f} | {:.6f} |\n", item.first,
               n::select(item.second, 0, 0).item(),
               n::select(item.second, 0, 1).item() / content_denominator,
               n::select(item.second, 0, 2).item() / style_denominator,
               n::select(item.second, 0, 3).item() / tv_denominator);
  std::print("Generator-only RGB prediction:checkpoint parity {:.3g},single/batch max "
             "{:.3g},repeat exact;all62 learned/30 BN tensors immutable. All26 VGG tensors "
             "and cached feature targets unchanged.\nDistinct-content mean difference "
             "{:.6f};three-call64x64 CPU mean {:.6f}ms. No real-time claim.\n",
             parity, batch_error, sensitivity, milliseconds);
  n::save_image_grid(m::JohnsonPreviewTiles(testing, painting, prediction),
                     "figures/johnson_fast_style_predictions.png", 2, 0, 1, 2, 0, 3);
  n::save_npz("build/johnson_fast_style_outputs.npz",
              {{"observed", testing}, {"stylized", prediction}});
  auto a = dm::graphics::RPlot::create(), b = dm::graphics::RPlot::create();
  a.bars({0., 1.}, {n::select(untrained, 0, 0).item(), n::select(heldout, 0, 0).item()},
         "eight contents", {37, 99, 235})
      .title("Held-out frozen perceptual objective")
      .x_label("0 initial,1 restored generator")
      .y_label("fixed-scale combined objective")
      .y_limits(0, 16);
  const auto errors =
      n::mean(n::abs(n::slice_axis(prediction, 0, 1, 8) - n::slice_axis(prediction, 0, 0, 1)),
              {1, 2, 3});
  b.bars(n::arange(1, 8).to_vector<double>(), errors.to_vector<double>(), "RGB difference",
         {22, 163, 74})
      .title("Outputs respond to observed content")
      .x_label("test row compared with test row0")
      .y_label("mean absolute encoded RGB difference")
      .y_limits(0, .4);
  auto diagnostics = dm::graphics::RLayout::create(1, 2);
  diagnostics.add(a).add(b).size(1100, 500).fit_panels().save_svg(
      "build/johnson_fast_style_evaluation.svg");
  std::filesystem::copy_file("build/johnson_fast_style_evaluation.svg",
                             "figures/johnson_fast_style_evaluation.svg",
                             std::filesystem::copy_options::overwrite_existing);
  a = dm::graphics::RPlot::create();
  b = dm::graphics::RPlot::create();
  a.lines(epochs, history, "fitting total", {37, 99, 235})
      .lines(epochs, validation_history, "validation", {220, 38, 38})
      .title("Thirty-six explicit Adam steps")
      .x_label("epoch")
      .y_label("fixed-scale combined objective")
      .y_limits(0, 3.2);
  b.lines(epochs, val_content, "content", {37, 99, 235})
      .lines(epochs, val_style, "style", {220, 38, 38})
      .lines(epochs, val_tv, "TV", {22, 163, 74})
      .title("Validation fixed-weight contributions")
      .x_label("epoch")
      .y_label("loss / initial training denominator")
      .y_limits(0, 2.2);
  auto curves = dm::graphics::RLayout::create(1, 2);
  curves.add(a).add(b).size(1100, 500).fit_panels().save_svg(
      "build/johnson_fast_style_training.svg");
}
```
