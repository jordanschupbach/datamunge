> Complete transformation and genuine frozen VGG16

Full base32 has1,679,235 learned values in62 tensors and3,200 moving BN
values in30 tensors. Compact base8 retains every stage with108,771 learned
and800 BN values. Reflection,three encoders,five cropped residuals and two
learned upsamplers produce11 retained stages. Native tests execute full
256x256 forward/backward and exact compact64/80 geometry.

VGG16 imports all26 genuine Keras Float32 arrays/14,714,688 values. Frozen
features use max pools;the selected last ReLUs differ from Gatys VGG19.
Independent Keras fixtures verify all selected activations,all four losses
and every batched input gradient. Preparation reuses the pinned official
sources and dm::datasets::prepare_example_data("style"),with the separate CPU reference
requirements in scripts/cnn_style_reference_requirements.txt. Tensor reports
perform their own image preprocessing and optimizer updates.
```{cpp, results="markdown", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

#include <print>
int main() {
  namespace n = dm::nn;
  namespace m = n::models;
  n::set_num_threads(2);

  std::filesystem::path cache;
  if (const auto *p = std::getenv("DATAMUNGE_DATA_DIR"))
    cache = p;
  else if (const auto *p = std::getenv("XDG_CACHE_HOME"))
    cache = std::filesystem::path(p) / "datamunge/datasets";
  else
    cache = std::filesystem::path(std::getenv("HOME")) / ".cache/datamunge/datasets";

  std::filesystem::path assets = cache / "style_transfer";
  if (const auto *p = std::getenv("DATAMUNGE_STYLE_DIR"))
    assets = p;
  else
    dm::datasets::prepare_example_data("style", assets.string());

  std::print("| base width | learned scalars | learned leaves | BN values | BN leaves | "
             "stages |\n|---:|---:|---:|---:|---:|---:|\n");
  for (int base : {32, 8}) {
    n::ParameterStore p(17), state(18);
    n::NoGradGuard guard;
    const auto net = m::JohnsonTransform(p, state, n::full({1, 64, 80, 3}, .4), base);
    std::print("| {} | {} | {} | {} | {} | {} |\n", base, p.count(), p.size(), state.count(),
               state.size(), net.stages.size());
    if (net.image.shape() != n::Shape{1, 64, 80, 3})
      return 1;
  }
  const auto weights = m::LoadTensorMap((assets / "vgg16.npz").string());
  m::FrozenVgg16 vgg(weights);
  n::NoGradGuard guard;
  const auto features = vgg.Extract(m::LoadStyleImage(assets / "style.jpg", 64));
  std::print("26 genuine imported VGG16 arrays,14714688 values,zero optimizer leaves.\n| "
             "selected style block | H | W | C |\n|---:|---:|---:|---:|\n");
  for (int i = 0; i < 4; ++i)
    std::print("| {} | {} | {} | {} |\n", i + 1, features.style[i].size(1),
               features.style[i].size(2), features.style[i].size(3));
  vgg.CheckFrozen();
}
