> Fixed perceptual targets and quadratic total variation

Johnson content is mean squared relu2_2 error. Each style Gram divides by
H*W*C,and style sums the batch-mean squared Frobenius distances over
relu1_2,2_2,3_3 and4_3. These coefficients differ from Gatys pixel optimization.
Quadratic TV is.5*mean(right_difference²+down_difference²) over the common
(H-1)x(W-1) interior. The amplitude sweep calls the actual tensor TV helper
and differentiates every point. The real fit fixes content/style/TV scaling
once from the initial training-mode output.
```{cpp, results="markdown", file="figures/johnson_fast_style_tv.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

#include <print>
int main() {
  namespace n = dm::nn;
  namespace m = n::models;
  const auto alpha = n::arange(-2., 2.001, .05, n::DType::Float64).requires_grad_(),
             base = n::arange(0, 4 * 5 * 3, 1, n::DType::Float64).reshape({1, 4, 5, 3}) / 60.;
  std::vector<n::Tensor> values;
  for (std::int64_t i = 0; i < alpha.numel(); ++i)
    values.push_back(m::JohnsonTV(base * n::select(alpha, 0, i)));
  const auto tv = n::stack(values, 0), gradient = n::grad(n::sum(tv), {alpha})[0];
  const auto x = n::ones({2, 3, 4, 5});
  std::print("Gatys/Johnson Gram entry ratio {:.6f},equal to5 channels;constant TV {:.3g}.\n",
             (n::mean(m::StyleGram(x)) / n::mean(m::JohnsonGram(x))).item(),
             m::JohnsonTV(x).item());
  auto a = dm::graphics::RPlot::create(), b = dm::graphics::RPlot::create();
  a.lines(alpha.detach().to_vector<double>(), tv.to_vector<double>(), "quadratic TV",
          {37, 99, 235})
      .title("Actual joint-interior quadratic TV")
      .x_label("signed ramp amplitude")
      .y_label("raw quadratic TV")
      .y_limits(0, .2);
  b.lines(alpha.detach().to_vector<double>(), gradient.to_vector<double>(), "TV derivative",
          {220, 38, 38})
      .title("Signed tensor TV derivative")
      .x_label("signed ramp amplitude")
      .y_label("d TV / d amplitude")
      .y_limits(-.2, .25);
  auto layout = dm::graphics::RLayout::create(1, 2);
  layout.add(a).add(b).size(1100, 500).fit_panels().save_svg(
      "build/johnson_fast_style_tv.svg");
}
