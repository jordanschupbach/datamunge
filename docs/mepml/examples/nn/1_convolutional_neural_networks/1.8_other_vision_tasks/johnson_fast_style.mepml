> Reflection and cropped residuals preserve exact coordinates

Reflect padding excludes the boundary sample. The transformation pads40
pixels around the observed content,then applies two stride2 encoders and
five residual blocks. Each block has two VALID3x3 convolutions,so its
shortcut drops two pixels on every side. Residual additions have no ReLU:
negative shortcut values survive. BN follows the two convolutions,with ReLU
only after the first. The fixture displays actual padded indices and the
exact crop-only input adjoint when the residual convolutions are zero.
```{cpp, results="markdown", file="figures/johnson_fast_style_reflect.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

#include <print>
int main() {
  namespace n = dm::nn;
  namespace m = n::models;
  n::set_num_threads(2);
  const auto source = n::arange(0, 12).reshape({1, 3, 4, 1}),
             reflected = m::JohnsonReflect(source, 2);
  const auto x = (n::arange(0, 9 * 11 * 2).reshape({1, 9, 11, 2}) * .01 - 1.).requires_grad_();
  n::ParameterStore p(17), state(18);
  {
    n::NoGradGuard guard;
    m::JohnsonResidual(p, state, "r", x, true, false);
    for (const auto &name : p.names())
      if (name.find("/conv") != std::string::npos)
        p.set(name, n::zeros(p.at(name).shape()));
  }
  const auto out = m::JohnsonResidual(p, state, "r", x, true, false),
             gradient = n::grad(n::sum(out), {x})[0];
  std::print("9x11 residual ->5x7;minimum signed output {:.6f};crop adjoint has{} nonzeros.\n",
             n::min(out).item(), n::count_nonzero(gradient).item<std::int64_t>());
  auto a = n::plot_tensor_map(n::reverse(reflected.reshape({7, 8}), {0}), 0, 11),
       b = n::plot_tensor_map(n::reverse(n::select(n::select(gradient, 0, 0), 2, 0), {0}), 0,
                              1);
  a.title("REFLECT source pixel indices")
      .x_label("padded column")
      .y_label("original row order0 at bottom");
  b.title("Cropped shortcut exact adjoint")
      .x_label("original input column")
      .y_label("original input row0 at bottom");
  auto layout = dm::graphics::RLayout::create(1, 2);
  layout.add(a).add(b).size(1100, 500).fit_panels().save_svg(
      "build/johnson_fast_style_reflect.svg");
}
```
