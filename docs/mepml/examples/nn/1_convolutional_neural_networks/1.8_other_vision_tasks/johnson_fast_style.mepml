> Actual content data and the fixed painting

Read original CIFAR-10 training rows0..23 for fitting and24..31 for
validation. Original test rows8..15 provide eight held-out contents;test0..7
remain development diagnostics. Normalize raw bytes and legacy-resize32->64
with tensors. Fixed Kandinsky painting pixels come from the original pinned
JPEG and tensor center-square preparation. No generated replacement data is
used. This tiny24/8/8 split is a teaching fit,not the paper’s COCO experiment.
The painting and its source attribution are retained in the shared asset manifest.
```{cpp, results="markdown", file="figures/johnson_fast_style_data.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

#include <print>
int main() {
  namespace n = dm::nn;
  namespace m = n::models;
  n::set_num_threads(2);

  std::filesystem::path cache;
  if (const auto *p = std::getenv("DATAMUNGE_DATA_DIR"))
    cache = p;
  else if (const auto *p = std::getenv("XDG_CACHE_HOME"))
    cache = std::filesystem::path(p) / "datamunge/datasets";
  else
    cache = std::filesystem::path(std::getenv("HOME")) / ".cache/datamunge/datasets";
  dm::datasets::fetch("cifar10", (cache / "cifar10").string());

  std::filesystem::path assets = cache / "style_transfer";
  if (const auto *p = std::getenv("DATAMUNGE_STYLE_DIR"))
    assets = p;
  else
    dm::datasets::prepare_example_data("style", assets.string());

  const auto original_train =
                 n::data::LoadCifar({cache / "cifar10/data_batch_1.bin"}, n::data::Cifar::k10),
             original_test =
                 n::data::LoadCifar({cache / "cifar10/test_batch.bin"}, n::data::Cifar::k10);
  std::vector<std::size_t> fit_rows, val_rows, test_rows;
  for (int i = 0; i < 24; ++i)
    fit_rows.push_back(i);
  for (int i = 24; i < 32; ++i)
    val_rows.push_back(i);
  for (int i = 8; i < 16; ++i)
    test_rows.push_back(i);
  const auto fitting = m::FastStyleImages(original_train.images, fit_rows),
             validation = m::FastStyleImages(original_train.images, val_rows),
             testing = m::FastStyleImages(original_test.images, test_rows),
             painting = m::LoadStyleImage(assets / "style.jpg", 64);

  std::filesystem::create_directories("figures");
  const auto first = n::slice_axis(fitting, 0, 0, 8),
             tiles = n::concat({first, n::ones_like(first) * painting}, 2);
  n::save_image_grid(tiles, "figures/johnson_fast_style_inputs.png", 2, 0, 1, 2, 0, 3);
  auto a = dm::graphics::RPlot::create(), b = dm::graphics::RPlot::create();
  const std::array<dm::graphics::RGB, 3> colors = {
      {{220, 38, 38}, {22, 163, 74}, {37, 99, 235}}};
  const auto mean = n::mean(fitting.to(n::DType::Float64), {1, 2});
  for (int c = 0; c < 3; ++c)
    a.points(n::arange(0, 24).to_vector<double>(), n::select(mean, 1, c).to_vector<double>(),
             std::string(1, std::string("RGB")[c]), colors[c]);
  a.title("Actual fitting-content RGB means")
      .x_label("original fitting source row")
      .y_label("mean encoded unit value")
      .y_limits(0, 1.3);
  const auto painting_means = n::mean(painting.to(n::DType::Float64), {0, 1, 2});
  b.bars({0., 1., 2.}, painting_means.to_vector<double>(), "fixed painting", {147, 51, 234})
      .title("One unchanged style source")
      .x_label("0 red,1 green,2 blue")
      .y_label("mean encoded unit value")
      .y_limits(0, 1.3);
  auto layout = dm::graphics::RLayout::create(1, 2);
  layout.add(a).add(b).size(1100, 500).fit_panels().save_svg(
      "build/johnson_fast_style_data.svg");
  std::print(
      "24 fitting/8 validation/8 held-out original contents,64x64;painting mean RGB:{}\n",
      painting_means);
}
