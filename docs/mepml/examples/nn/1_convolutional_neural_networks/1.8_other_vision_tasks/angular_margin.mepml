> Actual seen and unseen digits

Closed-set fitting uses1280 MNIST training images(digits0–4,first256/class).
The next64 images per class supply320 disjoint validation rows. Testing uses
640 official test images from the same five classes,128/class. Separate
verification calibration uses only training digits5–6;unseen verification and
one-support retrieval use only official test digits7–9,128/class. The actual
fitting preview is class-balanced and uses tensor image gathering throughout.

```{cpp, results="markdown", file="figures/angular_margin_data.png", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

#include <print>
int main() {
  namespace n = dm::nn;

  std::filesystem::path cache;
  if (const auto *p = std::getenv("DATAMUNGE_DATA_DIR"))
    cache = p;
  else if (const auto *p = std::getenv("XDG_CACHE_HOME"))
    cache = std::filesystem::path(p) / "datamunge/datasets";
  else
    cache = std::filesystem::path(std::getenv("HOME")) / ".cache/datamunge/datasets";
  dm::datasets::fetch("mnist", (cache / "mnist").string());

  const auto train = n::load_mnist((cache / "mnist").string(), "train");
  const auto b = n::models::SiameseBuckets(train, {0, 1, 2, 3, 4}, 256);
  auto rows = n::models::MetricBatchRows(b, 8, 107);
  const auto labels = n::models::MetricDatasetLabels(train);
  std::stable_sort(rows.begin(), rows.end(), [&](auto a, auto b) {
    return labels[a] < labels[b];
  });
  std::filesystem::create_directories("build");
  n::save_image_grid(n::models::SiameseImages(train, rows), "build/angular_margin_data.png", 8,
                     0, 1, 2, 1, 3);
  std::print("Actual40-row fixed fitting probe,grouped by digits0–4;8 distinct images/class. "
             "Validation rows are later images of seen classes;unseen calibration/test "
             "classes stay separate.\n");
}
