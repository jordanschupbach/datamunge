> Normalize rows and columns,then optimize all leaves

The bias-free head normalizes each128D feature row and each classifier weight
column. Its squared-norm floor is1e-12. Positive independent row/column scaling
cancels above that floor;the native independent Jacobian and central-difference
oracles verify every raw feature and weight derivative,including a nearly
aligned target. Inference has no target-label argument in the workflow:the
head receives an undefined tensor and leaves its training output undefined.

Compact NN1 plus a128x5 head has108,680 learned scalars in29 tensors. Full
NN1 plus a128x1000 head has140,153,664 scalars. Both ArcFace and CosFace full
220pxRGB graphs below execute on one image;the compact versions check every
parameter gradient is nonzero. NN1 keeps eleven convolutions,two LRN stages,
four pools,two maxouts and a linear128D projection. There is no BN state.

```{cpp, results="markdown", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

#include <print>
int main() {
  namespace n = dm::nn;
  namespace m = n::models;
  n::set_num_threads(2);
  for (bool compact : {false, true})
    for (bool cosface : {false, true}) {
      const auto c = compact ? m::FaceNetConfig::Compact() : m::FaceNetConfig{};
      const int classes = compact ? 5 : 1000, batch = compact ? 2 : 1;
      n::ParameterStore p(17);
      m::AngularMarginConfig margin;
      margin.kind = cosface ? m::AngularMarginKind::kCosFace : m::AngularMarginKind::kArcFace;
      margin.margin = cosface ? .2f : .3f;
      margin.scale = 16;
      const auto images = .5 + .45 * n::sin(n::arange(0, batch * c.side * c.side * c.input)
                                                .reshape({batch, c.side, c.side, c.input}) *
                                            .113);
      const auto y = n::zeros({batch}, n::DType::Int64);
      const auto net = m::FaceNetNN1(p, images, c);
      const auto head = m::NormalizedAngularHead(p, net.raw, y, 128, classes, margin);
      const auto loss = m::AngularCrossEntropy(head.training, y, classes);
      const auto gradient = n::grad(loss, p.parameters());
      if (p.count() != (compact ? 108680 : 140153664) || gradient.size() != 29)
        return 1;
      double smallest = INFINITY;
      for (const auto &g : gradient) {
        if (!g.defined())
          return 1;
        const double norm = n::norm(g).item();
        if (!std::isfinite(norm))
          return 1;
        smallest = std::min(smallest, norm);
      }
      if (compact && smallest <= 0)
        return 1;
      std::print("{} {}:{} learned scalars,29 finite gradients;minimum gradient norm "
                 "{:.6g};training CE {:.6f}.\n",
                 compact ? "Compact28" : "Full220RGB", cosface ? "CosFace" : "ArcFace",
                 p.count(), smallest, loss.item());
    }
}
```
