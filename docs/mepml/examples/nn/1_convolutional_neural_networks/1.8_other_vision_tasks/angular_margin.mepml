> Explicit complete-model Adam for both margins

Each model fits120 visible Adam(.001) updates:three complete passes over1280
images,batch32,shuffle seed29. ArcFace uses margin.3 radians;CosFace margin.2
cosine units;both use scale16. The objective is mean target-margin CE plus
`.00005*sum(kernel²)`. The bias-free head and every NN1 leaf are warmed before
the optimizer. The epoch table labels margin fitting CE and plain validation
CE separately;they use different logits and are not interchangeable losses.

Minimum plain320-row validation CE selects the checkpoint. Restoring must
reproduce that score before640 seen-class test rows are scored. Separate256
unseen validation pairs(digits5–6) calibrate a distance threshold;512 unseen
test pairs(digits7–9) then measure verification,AUC and confusion. Finally,256
unseen3-way tasks compare trained and untrained embeddings with no fine-tuning.
Both models use the same splits/seeds but different margins;these bounded
MNIST runs do not reproduce the papers’ face datasets,backbones or training.

```{cpp, results="markdown", file="figures/angular_margin_training.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <map>
#include <print>
int main() {
  int rendered_confusions = 0;
  namespace n             = dm::nn;
  namespace m             = n::models;
  n::set_num_threads(2);

  std::filesystem::path cache;
  if (const auto* p = std::getenv("DATAMUNGE_DATA_DIR"))
    cache = p;
  else if (const auto* p = std::getenv("XDG_CACHE_HOME"))
    cache = std::filesystem::path(p) / "datamunge/datasets";
  else
    cache = std::filesystem::path(std::getenv("HOME")) / ".cache/datamunge/datasets";
  dm::datasets::fetch("mnist", (cache / "mnist").string());

  const auto train       = n::load_mnist((cache / "mnist").string(), "train"),
             test        = n::load_mnist((cache / "mnist").string(), "test");
  const auto fitting     = m::SiameseBuckets(train, {0, 1, 2, 3, 4}, 256),
             combined    = m::SiameseBuckets(train, {0, 1, 2, 3, 4}, 320),
             seen_test   = m::SiameseBuckets(test, {0, 1, 2, 3, 4}, 128),
             calibration = m::SiameseBuckets(train, {5, 6}, 128),
             unseen      = m::SiameseBuckets(test, {7, 8, 9}, 128);
  std::vector<std::size_t> fit_rows, val_rows, seen_rows, cal_rows, unseen_rows;
  for (int c = 0; c < 5; ++c) {
    fit_rows.insert(fit_rows.end(), fitting[c].begin(), fitting[c].end());
    val_rows.insert(val_rows.end(), combined[c].begin() + 256, combined[c].end());
    seen_rows.insert(seen_rows.end(), seen_test[c].begin(), seen_test[c].end());
  }
  for (const auto& bucket : calibration)
    cal_rows.insert(cal_rows.end(), bucket.begin(), bucket.end());
  for (const auto& bucket : unseen)
    unseen_rows.insert(unseen_rows.end(), bucket.begin(), bucket.end());
  const auto cal_pairs  = m::SiamesePairs(calibration, 256, 97),
             test_pairs = m::SiamesePairs(unseen, 512, 101);
  const auto tasks      = m::SiameseTasks(unseen, 256, 103);
  const auto probe      = m::MetricBatchRows(fitting, 8, 107);
  const auto probe_x = m::SiameseImages(train, probe), probe_y = m::AngularLabels(train, probe);
  std::filesystem::create_directories("build");
  std::filesystem::create_directories("figures");
  auto curves          = dm::graphics::RLayout::create(2, 2),
       confusions      = dm::graphics::RLayout::create(1, 2);
  const auto distances = [](const n::Tensor&                        features,
                            const std::vector<std::size_t>&         rows,
                            const std::vector<m::VerificationPair>& pairs) {
    std::map<std::size_t, std::int64_t> index;
    for (std::size_t i = 0; i < rows.size(); ++i)
      index[rows[i]] = i;
    std::vector<std::int64_t> left, right;
    for (const auto& pair : pairs) {
      left.push_back(index.at(pair.left));
      right.push_back(index.at(pair.right));
    }
    return m::MetricPairDistance(features, left, right);
  };
  const auto pair_labels = [](const std::vector<m::VerificationPair>& pairs) {
    std::vector<double> labels;
    for (const auto& pair : pairs)
      labels.push_back(pair.same);
    return n::from_vector(labels);
  };
  std::vector<m::VerificationPair> task_pairs;
  std::vector<std::int64_t>        correct;
  for (const auto& task : tasks) {
    correct.push_back(task.correct);
    for (const auto row : task.support)
      task_pairs.push_back({task.query, row, 0});
  }
  const auto correct_columns = n::from_vector(correct);
  for (bool cosface : {false, true}) {
    const std::string name = cosface ? "CosFace" : "ArcFace",
                      stem = cosface ? "cosface" : "arcface";
    n::ParameterStore      p(17);
    m::AngularMarginConfig cfg;
    cfg.kind        = cosface ? m::AngularMarginKind::kCosFace : m::AngularMarginKind::kArcFace;
    cfg.margin      = cosface ? .2f : .3f;
    cfg.scale       = 16;
    const auto head = [&](const n::Tensor& images, const n::Tensor& labels) {
      const auto net = m::FaceNetNN1(p, images, m::FaceNetConfig::Compact());
      return m::NormalizedAngularHead(p, net.raw, labels, 128, 5, cfg);
    };
    // Warm all29 leaves before Adam;no BN moving state is owned by NN1.
    {
      n::NoGradGuard guard;
      head(n::zeros({1, 28, 28, 1}), n::Tensor{});
    }
    const auto encode_rows =
        [&](const n::ImageDataset& data, const std::vector<std::size_t>& rows, bool logits) {
          n::NoGradGuard         guard;
          std::vector<n::Tensor> parts;
          for (std::size_t start = 0; start < rows.size(); start += 64) {
            const auto end = std::min(rows.size(), start + 64);
            const auto out = head(
                m::SiameseImages(data, {rows.begin() + start, rows.begin() + end}), n::Tensor{});
            if (out.training.defined())
              throw std::runtime_error("label-free inference generated training logits");
            parts.push_back(logits ? out.inference : out.embedding);
          }
          return n::concat(parts, 0);
        };
    const auto episode_scores = [&](const n::Tensor& features) {
      return (-distances(features, unseen_rows, task_pairs)).reshape({256, 3});
    };
    double initial;
    {
      n::NoGradGuard guard;
      initial = m::AngularCrossEntropy(head(probe_x, probe_y).training, probe_y, 5).item();
    }
    const auto untrained =
        m::SiameseOneShotAccuracy(
            episode_scores(encode_rows(test, unseen_rows, false)), correct_columns)
            .item();
    n::OptimizerConfig config;
    config.kind = n::OptimizerKind::Adam;
    n::Optimizer        adam(p, .001, config);
    n::BatchOrder       order(fit_rows.size(), 32, 29);
    std::vector<double> epochs, fit_loss, val_loss, val_accuracy;
    double              best     = INFINITY;
    int                 selected = 0, steps = 0;
    const auto          path  = "build/angular_margin_" + stem + ".npz";
    const auto          val_y = m::AngularLabels(train, val_rows);
    std::print(
        "{}:margin{:.1f},scale16;{} learned parameters.\n| epoch | margin fitting CE | "
        "plain validation CE | plain validation accuracy |\n|---:|---:|---:|---:|\n",
        name,
        cfg.margin,
        p.count());
    for (int epoch = 1; epoch <= 3; ++epoch) {
      order.begin_epoch();
      double total = 0;
      int    seen  = 0;
      for (auto ids = order.next(); !ids.empty(); ids = order.next()) {
        std::vector<std::size_t> rows;
        for (const auto id : ids)
          rows.push_back(fit_rows[std::size_t(id)]);
        const auto images = m::SiameseImages(train, rows), labels = m::AngularLabels(train, rows);
        const auto loss = m::AngularCrossEntropy(head(images, labels).training, labels, 5);
        if (!std::isfinite(loss.item()))
          return 1;
        total += loss.item() * rows.size();
        seen += rows.size();
        adam.minimize(loss + .00005 * m::WeightSquares(p));
        ++steps;
      }
      const auto   logits = encode_rows(train, val_rows, true);
      const double value  = m::AngularCrossEntropy(logits.to(n::DType::Float64), val_y, 5).item(),
                   accuracy =
                       n::mean(n::equal(n::argmax(logits, 1), val_y).to(n::DType::Float64)).item();
      epochs.push_back(epoch);
      fit_loss.push_back(total / seen);
      val_loss.push_back(value);
      val_accuracy.push_back(accuracy);
      if (value < best) {
        best     = value;
        selected = epoch;
        p.save(path);
      }
      std::print("| {} | {:.6f} | {:.6f} | {:.6f} |\n", epoch, fit_loss.back(), value, accuracy);
    }
    p.load(path);
    const double restored =
        m::AngularCrossEntropy(encode_rows(train, val_rows, true).to(n::DType::Float64), val_y, 5)
            .item();
    if (std::abs(restored - best) > 1e-10)
      return 1;
    double learned;
    {
      n::NoGradGuard guard;
      learned = m::AngularCrossEntropy(head(probe_x, probe_y).training, probe_y, 5).item();
    }
    const auto seen_logits = encode_rows(test, seen_rows, true),
               seen_y      = m::AngularLabels(test, seen_rows);
    const auto confusion   = m::AngularClassificationConfusion(seen_logits, seen_y);
    n::ConfusionMatrix::from_counts(confusion.to(n::DType::Int64))
        .save_svg(
            "build/angular_margin_confusion_api_" + std::to_string(rendered_confusions++) + ".svg",
            {.title = "Selected-checkpoint held-out class counts"});

    const double closed_loss =
                     m::AngularCrossEntropy(seen_logits.to(n::DType::Float64), seen_y, 5).item(),
                 closed_accuracy =
                     n::mean(n::equal(n::argmax(seen_logits, 1), seen_y).to(n::DType::Float64))
                         .item();
    const auto cal_features  = encode_rows(train, cal_rows, false),
               test_features = encode_rows(test, unseen_rows, false);
    const auto threshold     = m::CalibrateMetricDistanceThreshold(
        distances(cal_features, cal_rows, cal_pairs), pair_labels(cal_pairs));
    const auto metrics = m::MetricDistanceMetrics(
                             distances(test_features, unseen_rows, test_pairs),
                             pair_labels(test_pairs),
                             threshold.item())
                             .to_vector<double>();
    const auto scores    = episode_scores(test_features);
    const auto retrieval = m::SiameseOneShotAccuracy(scores, correct_columns).item();
    const auto png       = "build/angular_margin_" + stem + "_episodes.png";
    n::save_image_grid(m::SiameseEpisodeGallery(test, tasks, scores), png, 1, 0, 1, 2, 1, 2);
    std::filesystem::copy_file(
        png,
        "figures/angular_margin_" + stem + "_episodes.png",
        std::filesystem::copy_options::overwrite_existing);
    std::print(
        "{}:{} Adam steps;selected epoch{},restored plain validation CE {:.6f};fixed fitting "
        "margin CE {:.6f}->{:.6f}.\n640 seen test images:plain CE {:.6f},accuracy {:.6f}. "
        "Unseen validation-only threshold {:.6f};512 unseen pairs accuracy {:.6f}/AUC "
        "{:.6f},TP/FP/FN/TN {:.0f}/{:.0f}/{:.0f}/{:.0f}.\n256 unseen3-way tasks:trained "
        "{:.6f},untrained {:.6f},chance1/3. No test updates.\n",
        name,
        steps,
        selected,
        best,
        initial,
        learned,
        closed_loss,
        closed_accuracy,
        threshold.item(),
        metrics[0],
        metrics[3],
        metrics[4],
        metrics[5],
        metrics[6],
        metrics[7],
        retrieval,
        untrained);
    auto a = dm::graphics::RPlot::create(), b = dm::graphics::RPlot::create();
    a.lines(epochs, fit_loss, "margin fit CE", {37, 99, 235})
        .lines(epochs, val_loss, "plain val CE", {220, 38, 38})
        .title(name + " fitting and selection")
        .x_label("epoch")
        .y_label("mean CE;different logit policies")
        .y_limits(0, 1.25 * *std::max_element(fit_loss.begin(), fit_loss.end()));
    b.lines(epochs, val_accuracy, "plain val acc", {22, 163, 74})
        .title(name + " label-free validation")
        .x_label("epoch")
        .y_label("fraction correct")
        .y_limits(0, 1.2);
    curves.add(a).add(b);
    auto heat = n::plot_tensor_map(n::reverse(confusion.to(n::DType::Float64), {0}), 0, 128);
    heat.title(name + " held-out confusion");
    heat.x_label("predicted digit0..4");
    heat.y_label("true digit0..4 from bottom");
    confusions.add(heat);
  }
  confusions.size(1100, 500).fit_panels().save_svg("build/angular_margin_confusion.svg");
  std::filesystem::copy_file(
      "build/angular_margin_confusion.svg",
      "figures/angular_margin_confusion.svg",
      std::filesystem::copy_options::overwrite_existing);
  curves.size(1100, 950).fit_panels().save_svg("build/angular_margin_training.svg");
}
