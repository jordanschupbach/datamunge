> Full and compact shared-pyramid graphs

Both input frames pass through the same18 learned feature convolutions,not
two independently fitted extractors. Their branch gradients add into the same
leaves. Coarsest costs start at level6;levels5 through2 warp the second
features,then concatenate costs,first features,learned upflow and two-channel
upfeature. Five densely connected convolutions at every level predict flow.
The final dilated context is a residual correction to level2.

The graph has no BN or joint image centering. Explicit fan-in Gaussian
initialization uses9*Cin for3x3 and16*Cin for transposes,including their
[4,4,Cout,Cin] layout. Compact channels retain all67 exposed stages and126
learned tensors. The full teaching graph is executed too;no pretrained or
published-quality equivalence is implied by retaining its connectivity.
```{cpp, results="markdown", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

#include <print>
int main() {
  namespace n = dm::nn;
  namespace m = n::models;
  n::set_num_threads(2);
  std::print("| graph | learned scalars | learned tensors | stages | shared feature leaves "
             "|\n|---|---:|---:|---:|---:|\n");
  for (bool compact : {false, true}) {
    n::ParameterStore p(163);
    const auto first = (.5 +
                        .4 * n::sin(n::arange(0, 2 * 64 * 64 * 3, 1, n::DType::Float64) * .17))
                           .to(n::DType::Float32)
                           .reshape({2, 64, 64, 3})
                           .requires_grad_(),
               second = (.5 + .4 * n::cos(n::arange(0, 2 * 64 * 64 * 3, 1, n::DType::Float64) *
                                          .13))
                            .to(n::DType::Float32)
                            .reshape({2, 64, 64, 3})
                            .requires_grad_();
    const auto out = m::PWCNet(p, first, second, 64, 64, compact);
    n::Tensor loss;
    for (const auto &level : out.pyramid)
      loss = loss.defined() ? loss + n::mean(n::square(level)) : n::mean(n::square(level));
    auto leaves = p.parameters();
    leaves.push_back(first);
    leaves.push_back(second);
    const auto gradients = n::grad(loss, leaves, {true});
    for (const auto &g : gradients)
      if (!n::all(n::less(n::abs(g), INFINITY)).item<bool>() ||
          (compact && n::sum(n::square(g.to(n::DType::Float64))).item() <= 0))
        return 1;
    int shared = 0;
    for (const auto &name : p.names())
      shared += name.starts_with("pyramid/");
    if (p.size() != 126 || shared != 36 || out.stages.size() != 67)
      return 1;
    if (compact) {
      const auto weight = p.parameters()[0], a = n::mean(n::square(out.stages[5])),
                 b = n::mean(n::square(out.stages[11]));
      const auto ga = n::grad(a, {weight}, {true})[0], gb = n::grad(b, {weight}, {true})[0],
                 sum = n::grad(a + b, {weight})[0];
      if (n::max(n::abs(sum - ga - gb)).item() > 1e-8)
        return 1;
    }
    std::print("| {} | {} | {} | {} | {} |\n", compact ? "compact" : "full", p.count(),
               p.size(), out.stages.size(), shared);
  }
}
```
