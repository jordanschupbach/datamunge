> Warp in each pyramid’s own pixel coordinates

The current flow still stores **input-image pixels divided by20**. Before
warping second-image features at level l,convert it by20/2^l. A stored(.1,.2)
therefore means(2,4) input pixels,but only(.5,1) level2 pixels and
(.03125,.0625) level6 pixels. Learned transpose upflow preserves stored
input/20 values;it does not multiply displacement by2 when changing the grid.
```{cpp, results="markdown", file="figures/pwcnet_units.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

#include <print>
int main() {
  namespace n = dm::nn;
  namespace m = n::models;
  const auto field = n::tensor({.1, .2}, {1, 1, 1, 2});
  std::vector<double> levels, dx, dy;
  std::print(
      "| level | horizontal level pixels | vertical level pixels |\n|---:|---:|---:|\n");
  for (int level = 2; level <= 6; ++level) {
    const auto values = m::FlowPyramidPixels(field, level).to_vector<double>();
    levels.push_back(level);
    dx.push_back(values[0]);
    dy.push_back(values[1]);
    std::print("| {} | {:.6f} | {:.6f} |\n", level, values[0], values[1]);
  }
  const auto x = n::arange(-4., 4.01, .5).reshape({1, 1, 17, 1}) + n::zeros({1, 17, 1, 1}),
             y = n::arange(-4., 4.01, .5).reshape({1, 17, 1, 1}) + n::zeros({1, 1, 17, 1});
  std::filesystem::create_directories("build");
  std::filesystem::create_directories("figures");
  n::save_image_grid(m::FlowColors(n::concat({x, y}, 3)).to(n::DType::Float32),
                     "figures/pwcnet_direction.png", 1, 0, 1, 0, 0, 12);
  auto p = dm::graphics::RPlot::create();
  p.lines(levels, dx, "horizontal", {37, 99, 235})
      .lines(levels, dy, "vertical", {220, 38, 38})
      .title("One stored field,correct warp units")
      .x_label("feature-pyramid level")
      .y_label("displacement in that level's pixels")
      .y_limits(0, 1.3)
      .size(950, 480);
  p.save_svg("build/pwcnet_units.svg");
}
