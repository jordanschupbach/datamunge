> Local feature correlation is a cost volume

At one first-image location,the radius-r cost channel for offset(dy,dx) is
\(C=\operatorname{mean}_c[F_1(y,x,c)F_2(y+dy,x+dx,c)]\).
Channels enumerate dy first,then dx,from-r through r. Outside second-image
features are zero. PWC-Net uses r4,so each location has81 cost channels.
The hand example uses radius1 and a single query feature(2,-1).
Second features are neighboring pairs(0,1),(2,3),...,(16,17),so its3x3
costs are[-.5,.5,1.5;2.5,3.5,4.5;5.5,6.5,7.5]. Both feature branches
receive gradients;native tests check every coordinate at radius4 too.
```{cpp, results="markdown", file="figures/pwcnet_cost.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

#include <print>
int main() {
  namespace n = dm::nn;
  namespace m = n::models;
  const auto first =
      n::pad(n::tensor({2., -1.}, {1, 1, 1, 2}), {{0, 0}, {1, 1}, {1, 1}, {0, 0}})
          .requires_grad_();
  const auto second = n::arange(0, 18).reshape({1, 3, 3, 2}).requires_grad_();
  const auto cost = m::FlowCorrelation(first, second, 1);
  const auto query = n::select(n::select(n::select(cost, 0, 0), 0, 1), 0, 1).reshape({3, 3});
  const auto gradients = n::grad(n::sum(query), {first, second});
  auto a = n::plot_tensor_map(n::reverse(n::select(n::select(second, 0, 0), 2, 0), {0}), 0,
                              16),
       b = n::plot_tensor_map(n::reverse(query, {0}), -.5, 7.5);
  a.title("Second feature:channel0").x_label("column").y_label("original row0 at bottom");
  b.title("One query,dy-major offset costs")
      .x_label("dx=-1,0,1")
      .y_label("dy=-1,0,1 from bottom");
  std::filesystem::create_directories("build");
  auto layout = dm::graphics::RLayout::create(1, 2);
  layout.add(a).add(b).size(1100, 500).fit_panels().save_svg("build/pwcnet_cost.svg");
  const auto center =
      n::select(n::select(n::select(gradients[0], 0, 0), 0, 1), 0, 1).to_vector<double>();
  std::print("Query costs first/center/last {:.1f}/{:.1f}/{:.1f};query feature gradient "
             "{:.1f}/{:.1f};radius4 has81 channels.\n",
             query.to_vector<double>()[0], query.to_vector<double>()[4],
             query.to_vector<double>()[8], center[0], center[1]);
  if (center[0] != 36. || center[1] != 40.5)
    return 1;
}
```
