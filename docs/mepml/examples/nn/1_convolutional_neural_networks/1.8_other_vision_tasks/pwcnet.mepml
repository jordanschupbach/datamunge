> Visible complete-model Adam and pair-only restoration

Warm all126 leaves before Adam(.001). Three epochs,two-image batches and
source seed167 give48 explicit updates. Five mean valid-block GT levels
remain in input pixels/20. Smooth endpoint losses use weights
.005,.01,.02,.08,.32. Validation selects the parameter checkpoint;there is
no BN state. The inference call receives only first and second RGB frames.

Restore an independent store,check every leaf remains immutable and verify
single/batch and repeated predictions. Compare every test crop with initial
weights,zero and the saved SGD constant. Endpoint and augmented angular
metrics average supported images equally. Bad1/bad3 use strict>1/>3px,and
Fl-all also requires>5% of true magnitude. Report source-pair errors separately.
```{cpp, results="markdown", file="figures/pwcnet_training.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

#include <print>
int main() {
  namespace n = dm::nn;
  namespace m = n::models;
  n::set_num_threads(2);

  std::filesystem::path cache;
  if (const auto *p = std::getenv("DATAMUNGE_DATA_DIR"))
    cache = p;
  else if (const auto *p = std::getenv("XDG_CACHE_HOME"))
    cache = std::filesystem::path(p) / "datamunge/datasets";
  else
    cache = std::filesystem::path(std::getenv("HOME")) / ".cache/datamunge/datasets";

  std::filesystem::path root = cache / "optical_flow";
  if (const auto *p = std::getenv("DATAMUNGE_FLOW_DIR"))
    root = p;
  else
    dm::datasets::prepare_example_data("optical_flow", root.string());
  const auto split = m::LoadFlowPairs(root);

  const m::FlowPrepared fit{split.fit, m::PrepareFlowSupervision(split.fit)},
      validation{split.validation, m::PrepareFlowSupervision(split.validation)};
  n::ParameterStore p(163);
  {
    n::NoGradGuard guard;
    m::PWCNet(p, n::zeros({1, 64, 64, 3}), n::zeros({1, 64, 64, 3}), 64, 64, true);
  }
  n::OptimizerConfig config;
  config.kind = n::OptimizerKind::Adam;
  n::Optimizer adam(p, .001, config);
  auto predict = [](n::ParameterStore &weights, const m::FlowData &d) {
    n::NoGradGuard guard;
    std::vector<n::Tensor> parts;
    for (std::int64_t i = 0; i < d.first.size(0); i += 2)
      parts.push_back(
          m::PWCNet(weights, n::slice_axis(d.first, 0, i, std::min(i + 2, d.first.size(0))),
                    n::slice_axis(d.second, 0, i, std::min(i + 2, d.second.size(0))), 64, 64,
                    true)
              .flow);
    return n::concat(parts, 0);
  };
  auto objective = [&](const m::FlowPrepared &data) {
    n::NoGradGuard guard;
    double total = 0;
    for (std::int64_t i = 0; i < data.data.first.size(0); i += 2) {
      const auto batch = m::FlowBatch(data, {std::size_t(i), std::size_t(i + 1)});
      total +=
          m::FlowObjective(m::PWCNet(p, batch.data.first, batch.data.second, 64, 64, true),
                           batch.target.flow, batch.target.valid)[0]
              .item() *
          2.;
    }
    return total / data.data.first.size(0);
  };
  const auto initial_prediction = predict(p, split.test);
  const auto probe = m::FlowBatch(fit, {0, 1});
  const double initial = objective(probe);
  n::BatchOrder order(32, 2, 167);
  std::vector<double> epochs, training, valid;
  double best = INFINITY;
  int selected = 0, updates = 0;
  std::filesystem::create_directories("build");
  std::filesystem::create_directories("figures");
  std::print("410442 learned scalars/126 warmed leaves,no BN.\n| epoch | weighted fit | L2 | "
             "L3 | L4 | L5 | L6 | validation |\n|---:|---:|---:|---:|---:|---:|---:|---:|\n");
  for (int epoch = 1; epoch <= 3; ++epoch) {
    order.begin_epoch();
    std::array<double, 6> sums{};
    int seen = 0;
    for (auto ids = order.next(); !ids.empty(); ids = order.next()) {
      const auto batch = m::FlowBatch(fit, std::vector<std::size_t>(ids.begin(), ids.end()));
      const auto forward = m::PWCNet(p, batch.data.first, batch.data.second, 64, 64, true);
      const auto losses = m::FlowObjective(forward, batch.target.flow, batch.target.valid);
      for (std::size_t i = 0; i < 6; ++i) {
        if (!std::isfinite(losses[i].item()))
          return 1;
        sums[i] += losses[i].item() * ids.size();
      }
      seen += ids.size();
      adam.minimize(losses[0]);
      ++updates;
    }
    if (seen != 32)
      return 1;
    for (auto &value : sums)
      value /= seen;
    epochs.push_back(epoch);
    training.push_back(sums[0]);
    valid.push_back(objective(validation));
    if (valid.back() < best) {
      best = valid.back();
      selected = epoch;
      p.save("build/pwcnet_best.npz");
    }
    std::print("| {} | {:.6f} | {:.6f} | {:.6f} | {:.6f} | {:.6f} | {:.6f} | {:.6f} |\n",
               epoch, sums[0], sums[1], sums[2], sums[3], sums[4], sums[5], valid.back());
  }
  p.load("build/pwcnet_best.npz");
  const double restored = objective(validation), learned_probe = objective(probe);
  if (std::abs(restored - best) > 1e-8 || learned_probe >= initial ||
      training.back() >= training.front())
    return 1;
  n::ParameterStore deployed(991);
  {
    n::NoGradGuard guard;
    m::PWCNet(deployed, n::zeros({1, 64, 64, 3}), n::zeros({1, 64, 64, 3}), 64, 64, true);
  }
  deployed.load("build/pwcnet_best.npz");
  std::vector<n::Tensor> snapshot;
  for (const auto &v : deployed.parameters())
    snapshot.push_back(v.clone());
  const auto prediction = predict(deployed, split.test), reference = predict(p, split.test),
             repeat = predict(deployed, split.test);
  const double parity = n::max(n::abs(prediction - reference)).item();
  if (parity > 1e-7 || !n::all(n::equal(prediction, repeat)).item<bool>())
    return 1;
  const auto single = predict(deployed, m::FlowBatch(split.test, {3}));
  if (n::max(n::abs(single - n::slice_axis(prediction, 0, 3, 4))).item() > 1e-6)
    return 1;
  for (std::size_t i = 0; i < snapshot.size(); ++i)
    if (!n::all(n::equal(snapshot[i], deployed.parameters()[i])).item<bool>())
      return 1;
  auto changed = split.test;
  changed.second = n::zeros_like(changed.second);
  const double sensitivity = n::mean(n::abs(prediction - predict(deployed, changed))).item();
  if (sensitivity <= 1e-6)
    return 1;
  const auto fitted = n::load_npz("build/pwcnet_prior.npz").at(0).second;
  const auto constant = n::ones(split.test.flow.shape()) * fitted.reshape({1, 1, 1, 2});
  const auto learned = m::ScoreTensorFlow(prediction, split.test.flow, split.test.valid),
             untrained =
                 m::ScoreTensorFlow(initial_prediction, split.test.flow, split.test.valid),
             zero = m::ScoreTensorFlow(n::zeros_like(prediction), split.test.flow,
                                       split.test.valid),
             prior = m::ScoreTensorFlow(constant, split.test.flow, split.test.valid);
  std::print(
      "{} visible Adam updates;selected epoch{},restored validation {:.6f};fixed fitting "
      "weighted loss {:.6f}->{:.6f}.\nPair-only deployment parity {:.3g};all126 tensors "
      "immutable,repeat exact,single/batch agree;second-image sensitivity {:.6f}px.\n| model "
      "| EPE px | AAE degrees | bad1 | bad3 | Fl-all |\n|---|---:|---:|---:|---:|---:|\n",
      updates, selected, restored, initial, learned_probe, parity, sensitivity);
  for (const auto &item :
       std::vector<std::pair<std::string, m::TensorFlowMetrics>>{{"learned", learned},
                                                                 {"initial", untrained},
                                                                 {"zero", zero},
                                                                 {"SGD constant", prior}})
    std::print("| {} | {:.6f} | {:.6f} | {:.6f} | {:.6f} | {:.6f} |\n", item.first,
               item.second.epe.item(), item.second.aae.item(), item.second.bad1.item(),
               item.second.bad3.item(), item.second.fl_all.item());
  std::vector<double> scene_epe;
  std::print("\nErrors by held-out source pair.\n\n| test source pair | crops | learned EPE "
             "px |\n|---|---:|---:|\n");
  const std::vector<std::string> scene_names = {"Urban2", "Urban3", "Venus"};
  for (int scene = 0; scene < 3; ++scene) {
    const auto first = scene * 8;
    const auto metric =
        m::ScoreTensorFlow(n::slice_axis(prediction, 0, first, first + 8),
                           n::slice_axis(split.test.flow, 0, first, first + 8),
                           n::slice_axis(split.test.valid, 0, first, first + 8));
    scene_epe.push_back(metric.epe.item());
    std::print("| {} | 8 | {:.6f} |\n", scene_names[scene], metric.epe.item());
  }
  const auto warped = m::FlowWarp(split.test.second, prediction).value;
  n::save_image_grid(m::FlowPreviewTiles(split.test, prediction, warped),
                     "figures/pwcnet_predictions.png", 2, 0, 1, 0, 0, 2);
  n::save_npz("build/pwcnet_test.npz", {{"prediction", prediction},
                                        {"truth", split.test.flow},
                                        {"valid", split.test.valid},
                                        {"warped_second", warped}});
  auto a = dm::graphics::RPlot::create(), b = dm::graphics::RPlot::create();
  a.bars({0., 1., 2., 3.},
         {learned.epe.item(), untrained.epe.item(), zero.epe.item(), prior.epe.item()}, "EPE",
         {37, 99, 235})
      .title("All24 held-out crop errors")
      .x_label("0 CNN,1 init,2 zero,3 SGD")
      .y_label("mean per-image EPE in input pixels")
      .y_limits(0, 6);
  b.bars({0., 1., 2.}, scene_epe, "scene EPE", {22, 163, 74})
      .title("Three source pairs remain distinct")
      .x_label("0 Urban2,1 Urban3,2 Venus")
      .y_label("mean EPE over eight crops")
      .y_limits(0, 8);
  auto metrics = dm::graphics::RLayout::create(1, 2);
  metrics.add(a).add(b).size(1100, 480).fit_panels().save_svg("build/pwcnet_metrics.svg");
  std::filesystem::copy_file("build/pwcnet_metrics.svg", "figures/pwcnet_metrics.svg",
                             std::filesystem::copy_options::overwrite_existing);
  a = dm::graphics::RPlot::create();
  a.lines(epochs, training, "weighted fitting", {37, 99, 235})
      .lines(epochs, valid, "validation", {220, 38, 38})
      .title("Visible complete PWC-Net Adam fitting")
      .x_label("epoch")
      .y_label("weighted input-pixel/20 endpoint loss")
      .y_limits(0, .1)
      .size(950, 480);
  a.save_svg("build/pwcnet_training.svg");
}
```
