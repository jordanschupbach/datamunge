> A recurrent question encoder must ignore padding

Embed the24 observed token IDs and run one shared LSTM in i/f/g/o gate
order,with forget bias1 at initialization. Freeze both hidden and cell state
once each row reaches its observed length. Length0 retains the initial0.
Padding content receives no gradient;reordering real words can change the
answer. There is one learned embedding and one recurrent parameter set,
not24 independent LSTMs. The probe below displays actual hidden activations
and the padding token's exact zero embedding adjoint.
```{cpp, results="markdown", file="figures/vqa_baseline_masked_lstm.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

#include <print>
int main() {
  namespace n = dm::nn;
  namespace m = n::models;
  n::set_num_threads(2);
  m::VqaConfig c;
  c.vocabulary = 8;
  c.time = 4;
  c.embedding = 3;
  c.hidden = 3;
  n::ParameterStore p(283);
  const auto ids = n::tensor({2, 3, 0, 0, 4, 5, 6, 0}, {2, 4}).to(n::DType::Int32);
  const auto lengths = n::tensor({2, 3}, {2}).to(n::DType::Int32);
  const auto q = m::VqaLstm(p, ids, lengths, c);
  const auto derivatives = n::grad(n::sum(q.h), p.parameters());
  const auto states = n::stack(q.steps, 1);
  const auto pad_gradient = n::select(derivatives[0], 0, 0);
  n::NoGradGuard guard;
  const auto changed = n::tensor({2, 3, 7, 6, 4, 5, 6, 7}, {2, 4}).to(n::DType::Int32);
  const auto parity = n::max(n::abs(m::VqaLstm(p, changed, lengths, c).h - q.h));
  std::print("Changed padding parity {:.3g};padding-token embedding adjoint max {:.3g};all4 "
             "shared parameter leaves.\n",
             parity.item(), n::max(n::abs(pad_gradient)).item());
  const double scale = n::max(n::abs(states)).item();
  auto a = n::plot_tensor_map(n::reverse(n::select(states, 0, 0), {0}), -scale, scale),
       b = n::plot_tensor_map(n::reverse(n::select(states, 0, 1), {0}), -scale, scale);
  a.title("Length2 freezes after step2")
      .x_label("hidden coordinate")
      .y_label("time0 at bottom");
  b.title("Length3 freezes after step3")
      .x_label("hidden coordinate")
      .y_label("time0 at bottom");
  auto layout = dm::graphics::RLayout::create(1, 2);
  layout.add(a).add(b).size(1100, 500).fit_panels().save_svg(
      "build/vqa_baseline_masked_lstm.svg");
}
```
