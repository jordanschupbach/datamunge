> Three independent fits expose every Adam update

For each modality,warm its complete learned graph before Adam(.001).
Each batch computes the soft ten-answer CE and calls grad/step explicitly.
All254 fitting questions appear once per epoch,batch8,three epochs:96 updates
per model,288 total. Batch order seed281 and initialization277 are fixed.
Validation NLL alone selects the best checkpoint. The89 held-out questions
never enter the objective or checkpoint selection. There is no moving state.
The untrained and selected learned predictions are saved for diagnostics.
```{cpp, results="markdown", file="figures/vqa_baseline_training.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

#include <print>
int main() {
  namespace n = dm::nn;
  namespace m = n::models;
  n::set_num_threads(2);

  std::filesystem::path cache;
  if (const auto *p = std::getenv("DATAMUNGE_DATA_DIR"))
    cache = p;
  else if (const auto *p = std::getenv("XDG_CACHE_HOME"))
    cache = std::filesystem::path(p) / "datamunge/datasets";
  else
    cache = std::filesystem::path(std::getenv("HOME")) / ".cache/datamunge/datasets";

  std::filesystem::path root = cache / "vqa";
  if (const auto *p = std::getenv("DATAMUNGE_VQA_DIR"))
    root = p;
  else
    dm::datasets::prepare_example_data("vqa", root.string());
  const auto split = m::LoadVqa(root);

  const auto c = split.config;
  auto predict = [&](n::ParameterStore &p, const m::VqaData &d, m::VqaMode mode) {
    n::NoGradGuard guard;
    std::vector<n::Tensor> parts;
    for (std::int64_t start = 0; start < d.rgb.size(0); start += 8) {
      std::vector<std::size_t> rows;
      for (auto i = start; i < std::min<std::int64_t>(start + 8, d.rgb.size(0)); ++i)
        rows.push_back(i);
      const auto b = m::VqaRows(d, rows);
      parts.push_back(
          n::softmax(m::VqaBaseline(p, b.rgb, b.tokens, b.lengths, c, mode).logits, 1));
    }
    return n::concat(parts, 0);
  };
  std::vector<n::Tensor> histories;

  for (auto mode : {m::VqaMode::kJoint, m::VqaMode::kQuestion, m::VqaMode::kImage}) {
    const auto name = m::VqaModeName(mode);
    n::ParameterStore p(277);
    {
      n::NoGradGuard guard;
      m::VqaBaseline(p, n::zeros({1, 64, 64, 3}), n::zeros({1, c.time}, n::DType::Int32),
                     n::ones({1}, n::DType::Int32), c, mode);
    }
    n::OptimizerConfig options;
    options.kind = n::OptimizerKind::Adam;
    n::Optimizer adam(p, .001, options);
    n::BatchOrder order(split.fit.rgb.size(0), 8, 281);
    const auto probe = m::VqaRows(split.fit, {0, 1, 2, 3, 4, 5, 6, 7});
    double initial;
    {
      n::NoGradGuard guard;
      initial = m::VqaSoftCE(
                    m::VqaBaseline(p, probe.rgb, probe.tokens, probe.lengths, c, mode).logits,
                    probe.target)
                    .item();
    }
    const auto untrained = predict(p, split.test, mode);
    double best = INFINITY;
    int selected = 0, updates = 0;
    std::vector<n::Tensor> history;
    std::print(
        "\n| mode | epoch | fitting soft CE | validation NLL | validation mapped consensus "
        "|\n|---|---:|---:|---:|---:|\n");
    for (int epoch = 1; epoch <= 3; ++epoch) {
      order.begin_epoch();
      auto average = n::zeros({}, n::DType::Float64);
      for (;;) {
        const auto ids = order.next();
        if (ids.empty())
          break;
        const auto b = m::VqaRows(split.fit, std::vector<std::size_t>(ids.begin(), ids.end()));
        const auto out = m::VqaBaseline(p, b.rgb, b.tokens, b.lengths, c, mode);
        const auto loss = m::VqaSoftCE(out.logits, b.target);
        average = average + loss.detach().to(n::DType::Float64) * double(ids.size()) /
                                double(split.fit.rgb.size(0));
        adam.step(n::grad(loss, p.parameters()));
        ++updates;
      }
      const auto score = m::ScoreVqa(predict(p, split.validation, mode), split.validation);
      if (score.nll < best) {
        best = score.nll;
        selected = epoch;
        n::NamedTensors save;
        for (std::size_t i = 0; i < p.size(); ++i)
          save.push_back({p.names()[i], p.parameters()[i]});
        n::save_npz("build/vqa_baseline_" + name + "_best.npz", save);
      }
      history.push_back(n::stack({average, n::full({}, score.nll, n::DType::Float64),
                                  n::full({}, score.consensus, n::DType::Float64)},
                                 0));
      std::print("| {} | {} | {:.6f} | {:.6f} | {:.6f} |\n", name, epoch, average.item(),
                 score.nll, score.consensus);
    }
    const auto checkpoint = n::load_npz("build/vqa_baseline_" + name + "_best.npz");
    for (const auto &[key, value] : checkpoint)
      p.set(key, value);
    n::NoGradGuard guard;
    const auto fitted =
        m::VqaSoftCE(m::VqaBaseline(p, probe.rgb, probe.tokens, probe.lengths, c, mode).logits,
                     probe.target);
    const auto probability = predict(p, split.test, mode);
    n::save_npz("build/vqa_baseline_" + name + "_outputs.npz",
                {{"probability", probability},
                 {"untrained", untrained},
                 {"history", n::stack(history, 0)}});
    histories.push_back(n::stack(history, 0));
    std::print("{}:{} explicit Adam updates,selected epoch {},validation {:.6f};fixed fitting "
               "probe {:.6f}->{:.6f};{} learned leaves.\n",
               name, updates, selected, best, initial, fitted.item(), p.size());
  }
  const std::array<dm::graphics::RGB, 3> colors = {
      {{37, 99, 235}, {220, 38, 38}, {22, 163, 74}}};
  const std::array<std::string, 3> labels = {"joint", "question only", "image only"};
  auto a = dm::graphics::RPlot::create(), b = dm::graphics::RPlot::create();
  const auto epochs = n::arange(1, 4).to_vector<double>();
  for (int i = 0; i < 3; ++i) {
    a.lines(epochs, n::select(histories[i], 1, 0).to_vector<double>(), labels[i], colors[i]);
    b.lines(epochs, n::select(histories[i], 1, 1).to_vector<double>(), labels[i], colors[i]);
  }
  a.title("All 288 explicit Adam updates")
      .x_label("epoch;96 updates per model")
      .y_label("mean fitting soft-answer CE")
      .y_limits(0, 5);
  b.title("Separate validation model selection")
      .x_label("epoch")
      .y_label("mean validation soft-answer NLL")
      .y_limits(0, 5);
  auto layout = dm::graphics::RLayout::create(1, 2);
  layout.add(a).add(b).size(1100, 500).fit_panels().save_svg(
      "build/vqa_baseline_training.svg");
}
