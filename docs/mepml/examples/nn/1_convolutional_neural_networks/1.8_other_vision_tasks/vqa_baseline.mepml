> Restore observed-input predictors and examine actual human questions

The restored forward call accepts RGB,token IDs,lengths and architecture only.
Human answers,source IDs and question types are evaluation metadata. Restore
separate stores,compare saved/repeated probabilities,check single/batch
agreement and verify every learned leaf remains unchanged. Change only the
image or only the observed question to expose which active modality affects
each graph. Numerical sensitivity does not establish correct visual reasoning.

Evaluate learned and untrained models,the unchanged SGD global prior and
the unchanged SGD prefix prior. Report known-majority coverage and the
maximum mapped-string consensus attainable by any answer in the64-class
vocabulary. The type scores retain original yes/no,number and other groups.
Question-weighted results do not give each photograph equal weight.
```{cpp, results="markdown", file="figures/vqa_baseline_metrics.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

#include <print>
int main() {
  namespace n = dm::nn;
  namespace m = n::models;
  n::set_num_threads(2);

  std::filesystem::path cache;
  if (const auto *p = std::getenv("DATAMUNGE_DATA_DIR"))
    cache = p;
  else if (const auto *p = std::getenv("XDG_CACHE_HOME"))
    cache = std::filesystem::path(p) / "datamunge/datasets";
  else
    cache = std::filesystem::path(std::getenv("HOME")) / ".cache/datamunge/datasets";

  std::filesystem::path root = cache / "vqa";
  if (const auto *p = std::getenv("DATAMUNGE_VQA_DIR"))
    root = p;
  else
    dm::datasets::prepare_example_data("vqa", root.string());
  const auto split = m::LoadVqa(root);

  const auto c = split.config;
  const auto labels = m::VqaAnswers(root, c.answers);
  const auto text = m::VqaText(root);
  const auto ids = split.test.image_ids.to_vector<int>();
  std::size_t other = 1;
  while (other < ids.size() && ids[other] == ids[0])
    ++other;
  if (other == ids.size())
    return 1;
  auto predict = [&](n::ParameterStore &p, const m::VqaData &d, m::VqaMode mode) {
    n::NoGradGuard guard;
    std::vector<n::Tensor> parts;
    for (std::int64_t start = 0; start < d.rgb.size(0); start += 8) {
      std::vector<std::size_t> rows;
      for (auto i = start; i < std::min<std::int64_t>(start + 8, d.rgb.size(0)); ++i)
        rows.push_back(i);
      const auto b = m::VqaRows(d, rows);
      parts.push_back(
          n::softmax(m::VqaBaseline(p, b.rgb, b.tokens, b.lengths, c, mode).logits, 1));
    }
    return n::concat(parts, 0);
  };
  std::vector<std::pair<std::string, n::Tensor>> probabilities;
  std::print("| mode | restored/repeat error | single/batch error | immutable leaves | image "
             "change | question change |\n|---|---:|---:|---:|---:|---:|\n");
  for (auto mode : {m::VqaMode::kJoint, m::VqaMode::kQuestion, m::VqaMode::kImage}) {
    const auto name = m::VqaModeName(mode);
    n::ParameterStore p(277);
    {
      n::NoGradGuard guard;
      m::VqaBaseline(p, n::zeros({1, 64, 64, 3}), n::zeros({1, c.time}, n::DType::Int32),
                     n::ones({1}, n::DType::Int32), c, mode);
    }
    for (const auto &[key, value] : n::load_npz("build/vqa_baseline_" + name + "_best.npz"))
      p.set(key, value.clone());
    std::vector<n::Tensor> before;
    for (const auto &v : p.parameters())
      before.push_back(v.clone());
    const auto output = predict(p, split.test, mode);
    const auto repeat = predict(p, split.test, mode);
    n::Tensor saved, untrained;
    for (const auto &[key, value] :
         n::load_npz("build/vqa_baseline_" + name + "_outputs.npz")) {
      if (key == "probability")
        saved = value;
      else if (key == "untrained")
        untrained = value;
    }
    const auto parity =
        n::maximum(n::max(n::abs(output - saved)), n::max(n::abs(output - repeat)));
    const auto single = predict(p, m::VqaRows(split.test, {3}), mode);
    const auto batch_error = n::max(n::abs(single - n::slice_axis(output, 0, 3, 4)));
    const auto original = m::VqaRows(split.test, {0});
    auto changed_image = original;
    changed_image.rgb = m::VqaRows(split.test.rgb, {other});
    auto changed_question = original;
    changed_question.tokens = m::VqaRows(split.test.tokens, {1});
    changed_question.lengths = m::VqaRows(split.test.lengths, {1});
    const auto observed = predict(p, original, mode);
    const auto image_change = n::mean(n::abs(predict(p, changed_image, mode) - observed));
    const auto question_change =
        n::mean(n::abs(predict(p, changed_question, mode) - observed));
    bool immutable = true;
    for (std::size_t i = 0; i < before.size(); ++i)
      immutable = immutable && n::all(n::equal(before[i], p.parameters()[i])).item<bool>();
    if (parity.item() > 1e-7 || batch_error.item() > 2e-6 || !immutable)
      return 1;
    if ((mode == m::VqaMode::kQuestion && image_change.item() != 0) ||
        (mode == m::VqaMode::kImage && question_change.item() != 0))
      return 1;
    if ((mode != m::VqaMode::kQuestion && image_change.item() <= 1e-7) ||
        (mode != m::VqaMode::kImage && question_change.item() <= 1e-7))
      return 1;
    std::print("| {} | {:.3g} | {:.9g} | {} unchanged:{} | {:.9g} | {:.9g} |\n", name,
               parity.item(), batch_error.item(), p.size(), immutable, image_change.item(),
               question_change.item());
    probabilities.push_back({name, output});
    probabilities.push_back({name + " initial", untrained});
  }
  n::Tensor global, local, prefix;
  for (const auto &[name, value] : n::load_npz("build/vqa_baseline_sgd_prior.npz")) {
    if (name == "global")
      global = value;
    else if (name == "local")
      local = value;
    else
      prefix = value;
  }
  n::NoGradGuard guard;
  const auto g = global / n::sum(global, {1}, true);
  const auto matches =
      n::all(n::equal(n::expand_dims(split.test.prefix, 1), n::expand_dims(prefix, 0)), {2});
  const auto index = n::argmax(matches.to(n::DType::Int32), 1);
  const auto exists = n::any(matches, {1}, true);
  const auto numerator = g + n::where(exists, n::gather(local, index, 0), 0.);
  const auto gp =
      (g + n::zeros_like(split.test.target).to(n::DType::Float64)).to(n::DType::Float32);
  const auto pp =
      (numerator.to(n::DType::Float32).to(n::DType::Float64) / n::sum(numerator, {1}, true))
          .to(n::DType::Float32);
  probabilities.push_back({"SGD global", gp});
  probabilities.push_back({"SGD prefix", pp});
  std::vector<n::Tensor> metrics;
  std::vector<std::string> metric_labels;
  std::print("\n| predictor | soft NLL | mapped consensus | majority exact | known majority | "
             "vocabulary oracle | yes/no score | number score | other score "
             "|\n|---|---:|---:|---:|---:|---:|---:|---:|---:|\n");
  for (std::size_t i = 0; i < probabilities.size(); ++i) {
    const auto &item = probabilities[i];
    const auto score = m::ScoreVqa(item.second, split.test);
    std::print(
        "| {} | {:.6f} | {:.6f} | {:.6f} | {:.6f} | {:.6f} | {:.6f} | {:.6f} | {:.6f} |\n",
        item.first, score.nll, score.consensus, score.exact, score.coverage, score.oracle,
        score.type_score[0], score.type_score[1], score.type_score[2]);
    if (i % 2 == 0 || i >= 6) {
      metrics.push_back(
          n::from_vector(std::vector<double>{score.nll, score.consensus, score.type_score[0],
                                             score.type_score[1], score.type_score[2]},
                         {5}));
      metric_labels.push_back(item.first);
    }
  }
  const auto probability = probabilities[0].second;
  const auto tiles = m::VqaPreviewTiles(split.test, probability);
  n::save_image_grid(tiles, "figures/vqa_baseline_test.png", 4, 0, 1, 0, 0, 2);
  const auto predicted = m::VqaAnswerIds(probability).to_vector<std::int64_t>();
  const auto qids = split.test.question_ids.to_vector<std::int64_t>();
  const auto scores =
      n::sum(n::one_hot(m::VqaAnswerIds(probability), c.answers) * split.test.score, {1})
          .to_vector<float>();
  std::print("\nFirst16 original held-out questions,display order matches preview tiles.\n\n| "
             "question ID | COCO image | actual human question | mapped majority | joint "
             "answer | mapped score |\n|---:|---:|---|---|---|---:|\n");
  for (int i = 0; i < 16; ++i) {
    auto question = text.at(qids[i]).first;
    std::replace(question.begin(), question.end(), '|', '/');
    std::print("| {} | {} | {} | {} | {} | {:.3f} |\n", qids[i], ids[i], question,
               text.at(qids[i]).second, labels[predicted[i]], scores[i]);
  }
  const auto measured = n::stack(metrics, 0);
  auto a = dm::graphics::RPlot::create(), b = dm::graphics::RPlot::create();
  const auto x = n::arange(0, 5).to_vector<double>();
  a.points(x, n::select(measured, 1, 1).to_vector<double>(), "consensus", {37, 99, 235})
      .title("Held-out mapped human consensus")
      .x_label("predictor index (see caption)")
      .y_label("question-weighted score")
      .y_limits(0, .55);
  const std::array<dm::graphics::RGB, 3> colors = {
      {{37, 99, 235}, {220, 38, 38}, {22, 163, 74}}};
  const std::array<std::string, 3> names = {"yes/no", "number", "other"};
  for (int type = 0; type < 3; ++type)
    b.points(x, n::select(measured, 1, type + 2).to_vector<double>(), names[type],
             colors[type]);
  b.title("Original answer-type diagnostics")
      .x_label("predictor index (see caption)")
      .y_label("mapped consensus by type")
      .y_limits(0, 1.1);
  auto layout = dm::graphics::RLayout::create(1, 2);
  layout.add(a).add(b).size(1100, 500).fit_panels().save_svg("build/vqa_baseline_metrics.svg");
}
