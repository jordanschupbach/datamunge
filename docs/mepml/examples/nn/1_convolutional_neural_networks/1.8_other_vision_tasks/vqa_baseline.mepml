> Genuine human questions,source-disjoint photos and visible SGD priors

The pinned VQA-v2 training-question and ten-answer annotation archives
match85 original photographs from the pinned COCO128 cache. Exact COCO image
IDs overlap between the2014 question release and2017 photo cache;they are
not substituted images. All415 human questions remain attached to their
original source photo. Sorted image IDs shuffled with seed271 give55 fitting,
15 validation and15 held-out photos:254/72/89 questions respectively.
Questions of one photo always stay together. This is a custom teaching subset,
not the released VQA train/validation partition or benchmark accuracy.

Fitting-only token/answer frequency ranking gives417 tokens including PAD0/UNK1
and64 answers including UNK0. Lowercase question tokens retain apostrophes,
truncate to24 and right-pad0. Answer mapping lowercases,collapses whitespace,
converts number words none/zero..ten,and removes a/an/the. It does **not**
reprocess all official punctuation/contraction cases. Numeric targets retain
all10 mapped human answers;UNK consensus is forced0. RGB/255 followed by
legacy bilinear64px resizing uses tensors. The manifest retains archive SHA256,
source photos,all selected questions,ten original mapped answers and split IDs.

```{cpp, flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
  const std::filesystem::path cache = dm::datasets::data_home();
  dm::datasets::prepare_example_data("vqa", (cache / "vqa").string());
}
```
// result_begin:
// fit:254 original human questions.
// test:89 original human questions.
// validation:72 original human questions.
// Prepared415 human questions over85 original COCO photos;all RGB/soft targets/official leave-one-out consensus are tensors.
// result_end

Fit the global add-one answer counts and each observed two-token-prefix count
field using one explicit Double SGD(.5) step on summed squared count error.
Only fitting frequencies enter the count targets. Global counts normalize
first;known prefixes add their fitted local counts and renormalize. Unseen
prefixes use the global distribution. The tensor closed-form count helper
is a parity oracle only. This is a count-reference objective,not neural CE.
```{cpp, results="markdown", file="figures/vqa_baseline_data.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

#include <print>
int main() {
  namespace n = dm::nn;
  namespace m = n::models;
  n::set_num_threads(2);

  std::filesystem::path cache;
  if (const auto *p = std::getenv("DATAMUNGE_DATA_DIR"))
    cache = p;
  else if (const auto *p = std::getenv("XDG_CACHE_HOME"))
    cache = std::filesystem::path(p) / "datamunge/datasets";
  else
    cache = std::filesystem::path(std::getenv("HOME")) / ".cache/datamunge/datasets";

  std::filesystem::path root = cache / "vqa";
  if (const auto *p = std::getenv("DATAMUNGE_VQA_DIR"))
    root = p;
  else
    dm::datasets::prepare_example_data("vqa", root.string());
  const auto split = m::LoadVqa(root);

  const auto target = split.fit.target.to(n::DType::Float64);
  const auto matching = n::all(n::equal(n::expand_dims(split.fit.prefix, 1),
                                        n::expand_dims(split.fit.prefix, 0)),
                               {2})
                            .to(n::DType::Float64);
  const auto global_target = n::sum(target, {0}, true) + 1.;
  const auto local_target = n::matmul(matching, target);
  n::ParameterStore p(281, n::DType::Float64);
  const auto global = p.get("global_counts", global_target.shape(), n::init::zeros());
  const auto local = p.get("prefix_counts", local_target.shape(), n::init::zeros());
  n::OptimizerConfig options;
  options.kind = n::OptimizerKind::Sgd;
  n::Optimizer sgd(p, .5, options);
  sgd.minimize(n::sum(n::square(global - global_target)) +
               n::sum(n::square(local - local_target)));
  const auto matches = n::all(
      n::equal(n::expand_dims(split.test.prefix, 1), n::expand_dims(split.fit.prefix, 0)),
      {2});
  const auto indices = n::argmax(matches.to(n::DType::Int32), 1);
  const auto exists = n::any(matches, {1}, true);
  const auto g = global / n::sum(global, {1}, true);
  const auto numerator = g + n::where(exists, n::gather(local, indices, 0), 0.);
  const auto prior =
      (numerator.to(n::DType::Float32).to(n::DType::Float64) / n::sum(numerator, {1}, true))
          .to(n::DType::Float32);
  const auto parity = n::max(n::abs(prior - m::VqaPrior(split.fit, split.test, true)));
  if (parity.item() > 3e-8)
    return 1;
  std::filesystem::create_directories("build");
  std::filesystem::create_directories("figures");
  n::save_npz(
      "build/vqa_baseline_sgd_prior.npz",
      {{"global", global.detach()}, {"local", local.detach()}, {"prefix", split.fit.prefix}});
  n::save_image_grid(n::slice_axis(split.fit.rgb, 0, 0, 16), "figures/vqa_baseline_inputs.png",
                     4, 0, 1, 2, 0, 2);
  std::print("One visible SGD(.5) step,{} count leaves;count/parity max {:.3g};{} observed "
             "test prefixes.\n| split | questions | source photos | known-majority fraction | "
             "attainable mapped score |\n|---|---:|---:|---:|---:|\n",
             p.count(), parity.item(), n::sum(exists.to(n::DType::Int32)).item<int>());
  for (const auto &item : std::vector<std::pair<std::string, m::VqaData>>{
           {"fitting", split.fit}, {"validation", split.validation}, {"test", split.test}}) {
    const auto score = m::ScoreVqa(
        n::ones_like(item.second.target) / double(split.config.answers), item.second);
    std::set<int> images;
    for (auto id : item.second.image_ids.to_vector<int>())
      images.insert(id);
    std::print("| {} | {} | {} | {:.6f} | {:.6f} |\n", item.first, item.second.rgb.size(0),
               images.size(), score.coverage, score.oracle);
  }
  auto a = dm::graphics::RPlot::create(), b = dm::graphics::RPlot::create();
  a.bars(n::arange(0, split.config.answers).to_vector<double>(),
         g.reshape({split.config.answers}).to_vector<double>(), "SGD global", {37, 99, 235})
      .title("Fitting-only SGD answer frequencies")
      .x_label("fit answer ID;0isUNK")
      .y_label("add-one smoothed probability")
      .y_limits(0, .25);
  b.bars(n::arange(0, 3).to_vector<double>(),
         n::sum(n::one_hot(split.test.types, 3), {0}).to_vector<double>(), "test questions",
         {22, 163, 74})
      .title("Original held-out answer types")
      .x_label("0yes/no /1number /2other")
      .y_label("human question count")
      .y_limits(0, 55);
  auto layout = dm::graphics::RLayout::create(1, 2);
  layout.add(a).add(b).size(1100, 500).fit_panels().save_svg("build/vqa_baseline_data.svg");
}
```
