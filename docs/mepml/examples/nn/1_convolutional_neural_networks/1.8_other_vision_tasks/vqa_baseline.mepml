> Ten human answers define a soft target and a separate score

Train on mean human-answer frequencies,including out-of-vocabulary mass in
UNK0. Stable cross-entropy is -mean sum frequency*log_softmax(logits).
Its derivative keeps the observed target mass;it does not first collapse
the ten answers to one hard label.

Evaluation averages min(other_matching/3,1) across held-out annotators.
With ten answers,matching counts0/1/2/3/4 give0/.3/.6/.9/1.
This differs from min(matching/3,1). UNK predictions always score0,and
UNK-majority matches never count exact-correct. The score here applies to
the declared mapped answer strings,not the complete official evaluator.
```{cpp, results="markdown", file="figures/vqa_baseline_soft_answers.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

#include <print>
int main() {
  namespace n = dm::nn;
  namespace m = n::models;
  const auto z = n::tensor({1000., 999., 998., -2., 1., .5}, {2, 3}).requires_grad_();
  const auto target = n::tensor({.6, .3, .1, 0., .2, .8}, {2, 3});
  const auto loss = m::VqaSoftCE(z, target);
  const auto gradient = n::grad(loss, {z})[0];
  const auto exact = (n::softmax(z, 1) * n::sum(target, {1}, true) - target) / 2.;
  const auto matching = n::arange(0, 11, 1, n::DType::Float64);
  const auto consensus = (matching * n::clip((matching - 1.) / 3., 0., 1.) +
                          (10. - matching) * n::clip(matching / 3., 0., 1.)) /
                         10.;
  std::print("Large-logit soft CE {:.6f};every analytic adjoint max error {:.3g};2/10 "
             "matching consensus {:.6f}.\n",
             loss.item(), n::max(n::abs(gradient - exact)).item(), m::VqaConsensusCount(2));
  auto a = n::plot_tensor_map(n::reverse(gradient, {0}), -.4, .4),
       b = dm::graphics::RPlot::create();
  a.title("Soft-answer logit derivatives")
      .x_label("answer class")
      .y_label("question0 at bottom");
  b.lines(matching.to_vector<double>(), consensus.to_vector<double>(), "leave-one-out",
          {37, 99, 235})
      .lines(matching.to_vector<double>(), n::clip(matching / 3., 0., 1.).to_vector<double>(),
             "min(count/3,1)", {220, 38, 38})
      .title("Ten-annotator consensus formula")
      .x_label("matching normalized human answers")
      .y_label("answer score")
      .y_limits(0, 1.35);
  auto layout = dm::graphics::RLayout::create(1, 2);
  layout.add(a).add(b).size(1100, 500).fit_panels().save_svg(
      "build/vqa_baseline_soft_answers.svg");
}
```
