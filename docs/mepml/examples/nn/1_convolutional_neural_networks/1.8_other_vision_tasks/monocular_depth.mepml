> A positive metric head still has a derivative

The network predicts a raw logit z,then emits d=.1+softplus(z) in meters.
Its derivative is sigmoid(z). This gives positive depth without an upper
prediction clamp or GT-derived scale. Very negative Float32 logits can round
to the .1 floor;large positive logits remain unbounded. The color display
later saturates at10m,while losses and metrics retain the original prediction.
```{cpp, results="markdown", file="figures/monocular_depth_head.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

#include <print>
int main() {
  namespace n = dm::nn;
  namespace m = n::models;
  const auto z = n::arange(-8., 8.001, .05, n::DType::Float64).requires_grad_();
  const auto depth = m::PositiveMetricDepth(z);
  const auto gradient = n::grad(n::sum(depth), {z})[0];
  auto a = dm::graphics::RPlot::create(), b = dm::graphics::RPlot::create();
  a.lines(z.to_vector<double>(), depth.to_vector<double>(), "metric depth", {37, 99, 235})
      .title("Positive metric head")
      .x_label("raw logit z")
      .y_label("predicted meters")
      .y_limits(0, 10);
  b.lines(z.to_vector<double>(), gradient.to_vector<double>(), "sigmoid derivative",
          {220, 38, 38})
      .title("Depth-head derivative")
      .x_label("raw logit z")
      .y_label("d depth / dz")
      .y_limits(0, 1.3);
  std::filesystem::create_directories("build");
  std::filesystem::create_directories("figures");
  const auto legend =
      n::ones({1, 12, 1, 1}) * n::arange(.1, 10.0001, .05).reshape({1, 1, -1, 1});
  n::save_image_grid(m::DepthColors(legend).to(n::DType::Float32),
                     "figures/monocular_depth_legend.png", 1, 0, 1, 0, 0, 3);
  auto layout = dm::graphics::RLayout::create(1, 2);
  layout.add(a).add(b).size(1100, 480).fit_panels().save_svg("build/monocular_depth_head.svg");
  const auto extreme = m::PositiveMetricDepth(n::tensor({-80., 0., 80.}));
  std::print("Raw logits-80,0,80 -> depths {:.6f},{:.6f},{:.6f}m;no prediction maximum.\n",
             extreme.to_vector<double>()[0], extreme.to_vector<double>()[1],
             extreme.to_vector<double>()[2]);
}
```
