> A global coarse field and RGB local refinement

This small from-scratch network is inspired by coarse/fine depth prediction;
it is not the original Eigen backbone or a pretrained NYU model. Three stride2
RGB convolutions feed a128-unit global layer and12x16 logit map. Half-pixel
bilinear upsampling provides the coarse field. Three local RGB convolutions
predict a residual,then positive heads emit coarse and refined metric depth.
There are16 learned tensors,231745 scalars,11 exposed stages and no BN.
The total objective is refined log loss+.1 valid-neighbor loss+.2 coarse log
loss,with lambda.5 in both log terms. RGB is the only forward image input.
```{cpp, results="markdown", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

#include <print>
int main() {
  namespace n = dm::nn;
  namespace m = n::models;
  n::set_num_threads(2);
  n::ParameterStore p(139);
  const auto rgb =
      (.5 + .4 * n::sin(n::arange(0, 2 * 48 * 64 * 3, 1, n::DType::Float64) * .17))
          .to(n::DType::Float32)
          .reshape({2, 48, 64, 3})
          .requires_grad_();
  const auto out = m::MonocularDepth(p, rgb);
  const auto losses =
      m::DepthObjective(out, n::ones({2, 48, 64, 1}) * 2., n::ones({2, 48, 64, 1}));
  auto leaves = p.parameters();
  leaves.push_back(rgb);
  const auto gradients = n::grad(losses[0], leaves);
  double minimum = INFINITY;
  for (const auto &g : gradients) {
    if (!n::all(n::is_finite(g)).item<bool>())
      return 1;
    minimum = std::min(minimum, n::sqrt(n::sum(n::square(g.to(n::DType::Float64)))).item());
  }
  if (minimum <= 0 || p.count() != 231745 || p.size() != 16 || out.stages.size() != 11)
    return 1;
  std::print("231745 learned scalars/16 leaves,no BN;all16 plus RGB gradients "
             "finite/nonzero,min norm {:.3g}.\n| stage | sample shape |\n|---:|---|\n",
             minimum);
  for (std::size_t i = 0; i < out.stages.size(); ++i) {
    std::print("| {} |", i + 1);
    for (auto d : out.stages[i].shape())
      std::print(" {}", d);
    std::print(" |\n");
  }
}
```
