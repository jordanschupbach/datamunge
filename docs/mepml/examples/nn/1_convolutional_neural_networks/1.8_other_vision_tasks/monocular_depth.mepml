\alttext(Actual sensor coverage and valid fitting-depth distribution,with the visibly SGD-fitted geometric reference. Missing depth is excluded from the histogram and both baseline fits.)


\image(figures/monocular_depth_inputs.png)
\caption(Eight actual fitting rooms,one five-panel tile per row. Each tile is observed RGB,true raw sensor colors,SGD spatial-prior colors,valid absolute error/5 in red,and white sensor support. Black GT/error holes remain missing measurements.)
\alttext(Original NYU room images and sparse raw sensor depth,with a visibly fitted spatial reference and explicit validity masks.)

> Visible RGB-only Adam and immutable restored prediction

Warm all16 leaves before Adam(.001),then show every four-image minibatch
and objective. Three epochs give24 updates. Validation total loss selects
the checkpoint. The independent restored model receives **RGB only**;depth,
validity,priors and optimizer are absent from its forward call. Check exact
checkpoint parity,all learned values immutable,and single/batch agreement.

Compare refined/coarse predictions with both saved SGD references on all16
test rooms. Metrics use true sensor support and equal room weights:AbsRel,
SqRel,mean per-room RMSE,natural-log RMSE,absolute log10,SILog,and strict
ratio thresholds delta1/2/3. SILog uses a centered log-residual variance to
avoid cancellation. Predictions receive no GT median alignment or numeric
clipping. Depth colors are display-only.
```{cpp, results="markdown", file="figures/monocular_depth_training.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

#include <print>
int main() {
  namespace n = dm::nn;
  namespace m = n::models;
  n::set_num_threads(2);

  std::filesystem::path cache;
  if (const auto *p = std::getenv("DATAMUNGE_DATA_DIR"))
    cache = p;
  else if (const auto *p = std::getenv("XDG_CACHE_HOME"))
    cache = std::filesystem::path(p) / "datamunge/datasets";
  else
    cache = std::filesystem::path(std::getenv("HOME")) / ".cache/datamunge/datasets";

  std::filesystem::path root = cache / "monocular_depth";
  if (const auto *p = std::getenv("DATAMUNGE_DEPTH_DIR"))
    root = p;
  else
    dm::datasets::prepare_example_data("depth", root.string());
  const auto split = m::LoadDepthPairs(root);

  n::ParameterStore p(139);
  {
    n::NoGradGuard guard;
    m::MonocularDepth(p, n::zeros({1, 48, 64, 3}));
  }
  n::OptimizerConfig opt;
  opt.kind = n::OptimizerKind::Adam;
  n::Optimizer adam(p, .001, opt);
  auto predict = [](n::ParameterStore &store, const n::Tensor &rgb) {
    n::NoGradGuard guard;
    std::vector<n::Tensor> refined, coarse;
    for (std::int64_t i = 0; i < rgb.size(0); i += 4) {
      const auto out =
          m::MonocularDepth(store, n::slice_axis(rgb, 0, i, std::min(i + 4, rgb.size(0))));
      refined.push_back(out.depth);
      coarse.push_back(out.coarse);
    }
    return std::pair{n::concat(refined, 0), n::concat(coarse, 0)};
  };
  auto loss = [&](const m::DepthData &d) {
    n::NoGradGuard guard;
    return m::DepthObjective(m::MonocularDepth(p, d.rgb), d.depth, d.valid)[0].item();
  };
  const auto probe = m::DepthBatch(split.fit, {0, 1, 2, 3});
  const double initial = loss(probe);
  n::BatchOrder order(32, 4, 149);
  std::vector<double> epochs, training, valid, log_term, gradient_term, coarse_term;
  double best = INFINITY;
  int selected = 0, updates = 0;
  std::filesystem::create_directories("build");
  std::filesystem::create_directories("figures");
  std::print("231745 learned scalars/16 warmed leaves,no BN.\n| epoch | fit total | fit log | "
             "fit neighbor | fit coarse | validation |\n|---:|---:|---:|---:|---:|---:|\n");
  for (int epoch = 1; epoch <= 3; ++epoch) {
    order.begin_epoch();
    std::array<double, 4> totals{};
    int seen = 0;
    for (auto ids = order.next(); !ids.empty(); ids = order.next()) {
      const auto batch =
          m::DepthBatch(split.fit, std::vector<std::size_t>(ids.begin(), ids.end()));
      const auto prediction = m::MonocularDepth(p, batch.rgb);
      const auto objectives = m::DepthObjective(prediction, batch.depth, batch.valid);
      for (std::size_t i = 0; i < 4; ++i) {
        if (!std::isfinite(objectives[i].item()))
          return 1;
        totals[i] += objectives[i].item() * ids.size();
      }
      seen += ids.size();
      adam.minimize(objectives[0]);
      ++updates;
    }
    if (seen != 32)
      return 1;
    for (auto &t : totals)
      t /= seen;
    epochs.push_back(epoch);
    training.push_back(totals[0]);
    log_term.push_back(totals[1]);
    gradient_term.push_back(.1 * totals[2]);
    coarse_term.push_back(.2 * totals[3]);
    valid.push_back(loss(split.validation));
    if (valid.back() < best) {
      best = valid.back();
      selected = epoch;
      p.save("build/monocular_depth_best.npz");
    }
    std::print("| {} | {:.6f} | {:.6f} | {:.6f} | {:.6f} | {:.6f} |\n", epoch, totals[0],
               totals[1], totals[2], totals[3], valid.back());
  }
  p.load("build/monocular_depth_best.npz");
  const double restored = loss(split.validation), learned = loss(probe);
  if (std::abs(restored - best) > 1e-8 || learned >= initial ||
      training.back() >= training.front())
    return 1;
  n::ParameterStore deployed(991);
  {
    n::NoGradGuard guard;
    m::MonocularDepth(deployed, n::zeros({1, 48, 64, 3}));
  }
  deployed.load("build/monocular_depth_best.npz");
  std::vector<n::Tensor> snapshot;
  for (const auto &v : deployed.parameters())
    snapshot.push_back(v.clone());
  const auto prediction = predict(deployed, split.test.rgb),
             reference = predict(p, split.test.rgb),
             repeat = predict(deployed, split.test.rgb);
  const double parity = n::max(n::abs(prediction.first - reference.first)).item();
  if (parity > 1e-7 || !n::all(n::equal(prediction.first, repeat.first)).item<bool>())
    return 1;
  const auto single = predict(deployed, m::DepthBatch(split.test.rgb, {3}));
  const double batch_error =
      n::max(n::abs(single.first - n::slice_axis(prediction.first, 0, 3, 4))).item();
  std::print("Single/batch maximum absolute difference {:.9g} m.\n", batch_error);
  if (batch_error > 1e-5)
    return 1;
  for (std::size_t i = 0; i < snapshot.size(); ++i)
    if (!n::all(n::equal(snapshot[i], deployed.parameters()[i])).item<bool>())
      return 1;
  const double sensitivity =
      n::mean(n::abs(n::select(prediction.first, 0, 0) - n::select(prediction.first, 0, 1)))
          .item();
  if (sensitivity <= 1e-6)
    return 1;
  const auto priors = n::load_npz("build/monocular_depth_priors.npz");
  const auto geometric = n::ones(split.test.depth.shape()) * priors.at(0).second,
             map = n::ones(split.test.depth.shape()) * priors.at(1).second;
  const auto refined =
                 m::ScoreTensorDepth(prediction.first, split.test.depth, split.test.valid),
             coarse =
                 m::ScoreTensorDepth(prediction.second, split.test.depth, split.test.valid),
             global = m::ScoreTensorDepth(geometric, split.test.depth, split.test.valid),
             spatial = m::ScoreTensorDepth(map, split.test.depth, split.test.valid);
  std::print(
      "{} visible Adam updates;selected epoch{},restored validation {:.6f};fixed fit total "
      "{:.6f}->{:.6f}.\nRGB-only deployment parity {:.3g},all16 leaves immutable,repeat "
      "exact,single/batch agree;cross-room prediction difference {:.6f}m. No GT scale "
      "alignment or prediction clipping.\n{} held-out rooms,{} true sensor samples.\n| "
      "estimate | AbsRel | SqRel | RMSE m | log RMSE | log10 | SILog | delta1 | delta2 | "
      "delta3 |\n|---|---:|---:|---:|---:|---:|---:|---:|---:|---:|\n",
      updates, selected, restored, initial, learned, parity, sensitivity,
      refined.images.item<int>(), refined.pixels.item<std::int64_t>());
  for (const auto &item :
       std::vector<std::pair<std::string, m::TensorDepthMetrics>>{{"refined RGB", refined},
                                                                  {"coarse RGB", coarse},
                                                                  {"SGD geometric", global},
                                                                  {"SGD spatial", spatial}})
    std::print("| {} | {:.6f} | {:.6f} | {:.6f} | {:.6f} | {:.6f} | {:.6f} | {:.6f} | {:.6f} "
               "| {:.6f} |\n",
               item.first, item.second.abs_rel.item(), item.second.sq_rel.item(),
               item.second.rmse.item(), item.second.log_rmse.item(), item.second.log10.item(),
               item.second.silog.item(), item.second.delta1.item(), item.second.delta2.item(),
               item.second.delta3.item());
  n::save_image_grid(m::DepthPreviewTiles(split.test, prediction.first),
                     "figures/monocular_depth_predictions.png", 2, 0, 1, 0, 0, 2);
  n::save_npz("build/monocular_depth_test.npz", {{"rgb", split.test.rgb},
                                                 {"raw_sensor", split.test.depth},
                                                 {"valid", split.test.valid},
                                                 {"refined", prediction.first},
                                                 {"coarse", prediction.second}});
  auto a = dm::graphics::RPlot::create(), b = dm::graphics::RPlot::create();
  a.bars({0., 1., 2., 3.},
         {refined.rmse.item(), coarse.rmse.item(), global.rmse.item(), spatial.rmse.item()},
         "mean room RMSE", {37, 99, 235})
      .title("All16 held-out room depth errors")
      .x_label("0 refined,1 coarse,2 geo,3 map")
      .y_label("mean per-room RMSE in meters")
      .y_limits(0, 2.1);
  b.bars({0., 1., 2., 3.},
         {refined.abs_rel.item(), coarse.abs_rel.item(), global.abs_rel.item(),
          spatial.abs_rel.item()},
         "AbsRel", {22, 163, 74})
      .title("Fitted priors are strong references")
      .x_label("0 refined,1 coarse,2 geo,3 map")
      .y_label("mean absolute relative error")
      .y_limits(0, .65);
  auto metrics = dm::graphics::RLayout::create(1, 2);
  metrics.add(a).add(b).size(1100, 500).fit_panels().save_svg(
      "build/monocular_depth_metrics.svg");
  std::filesystem::copy_file("build/monocular_depth_metrics.svg",
                             "figures/monocular_depth_metrics.svg",
                             std::filesystem::copy_options::overwrite_existing);
  a = dm::graphics::RPlot::create();
  b = dm::graphics::RPlot::create();
  a.lines(epochs, training, "fitting total", {37, 99, 235})
      .lines(epochs, valid, "validation total", {220, 38, 38})
      .title("Visible RGB-only Adam fitting")
      .x_label("epoch")
      .y_label("masked total objective")
      .y_limits(0, 1.1);
  b.lines(epochs, log_term, "log", {37, 99, 235})
      .lines(epochs, gradient_term, ".1 neighbor", {22, 163, 74})
      .lines(epochs, coarse_term, ".2 coarse", {147, 51, 234})
      .title("Every fitted objective term")
      .x_label("epoch")
      .y_label("weighted fitting components")
      .y_limits(0, .9);
  auto curves = dm::graphics::RLayout::create(1, 2);
  curves.add(a).add(b).size(1100, 500).fit_panels().save_svg(
      "build/monocular_depth_training.svg");
}
```
