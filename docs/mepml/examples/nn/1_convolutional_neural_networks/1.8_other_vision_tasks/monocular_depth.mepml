> Original NYU RGB/raw sensor pairs and visible SGD priors

The official labeled Matlab/HDF5 archive includes aligned `images` and
`rawDepths`. Use **rawDepths**,not the separately inpainted `depths` array.
Sensor depth is already projected to RGB coordinates and measured in meters.
The report supplies a reproducible replacement for the old external archive.
Place official `nyu_depth_v2_labeled.mat` in
`build/cnn-datasets/monocular_depth` and run from the repository root:

```{cpp, flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
  const std::filesystem::path cache = dm::datasets::data_home();
  dm::datasets::prepare_example_data("depth", (cache / "monocular_depth").string());
}
```
// result_begin:
// Decoded464 original room identities and first-frame metadata.
// Validated32/8/16 source-room-disjoint RGB/rawDepth sensor pairs.
// result_end

The preparation needs C++23,pkg-config,datamunge and HDF5 C++ development
headers/libraries(`hdf5_cpp`,or `hdf5` plus the C++ library). The pinned file
has2972037809 bytes and SHA256
`2d724b0c0ab358aa1ce5df855e5bd14a2279ab7202efe22f32a30d612dcb86aa`.
HDF5 handles byte/metric ingress and room-name metadata. Tensor transpose
restores the original Matlab layout. Tensor gathers select the **same** source
rows/columns5,15,...475/635 from RGB and raw depth,giving48x64 samples.
No interpolation,depth filling,resize or estimated scale alignment occurs.
RGB is normalized/255;raw depths are valid only if finite,>.1f and<=10m.
Invalid values become explicit mask0/depth0.

Keep the first original aligned frame from each of464 canonical rooms,sort
room names,shuffle metadata with Python Random(137),then choose32 fitting,
eight validation and16 test rooms. All56 rooms and original source rows are
distinct. The manifest records each original name/ID/frame,split,fingerprint
and preprocessing. This is a small custom room split,not NYU benchmark accuracy.

Both references are fitted in **log-depth** with visible SGD. A pooled scalar
minimizes masked log MSE;one step at.5 reaches its log mean. A separate3072-leaf
image minimizes the sum of per-position masked log MSEs. Positions with no
fitting sensor support get an explicit squared-distance target equal to the
already fitted pooled log value. One step at.5 reaches each mean/fallback.
The source closed-form helper is only an independent parity oracle.
```{cpp, results="markdown", file="figures/monocular_depth_data.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

#include <print>
int main() {
  namespace n = dm::nn;
  namespace m = n::models;
  n::set_num_threads(2);

  std::filesystem::path cache;
  if (const auto *p = std::getenv("DATAMUNGE_DATA_DIR"))
    cache = p;
  else if (const auto *p = std::getenv("XDG_CACHE_HOME"))
    cache = std::filesystem::path(p) / "datamunge/datasets";
  else
    cache = std::filesystem::path(std::getenv("HOME")) / ".cache/datamunge/datasets";

  std::filesystem::path root = cache / "monocular_depth";
  if (const auto *p = std::getenv("DATAMUNGE_DEPTH_DIR"))
    root = p;
  else
    dm::datasets::prepare_example_data("depth", root.string());
  const auto split = m::LoadDepthPairs(root);

  const auto mask = split.fit.valid.to(n::DType::Float64),
             safe = n::where(n::greater(split.fit.valid, 0.), split.fit.depth, 1.)
                        .to(n::DType::Float64),
             target = n::log(safe), total = n::sum(mask), counts = n::sum(mask, {0}, true);
  n::OptimizerConfig config;
  config.kind = n::OptimizerKind::Sgd;
  n::ParameterStore pooled(151, n::DType::Float64);
  const auto global = pooled.get("log_depth", {1}, n::init::zeros());
  n::Optimizer global_sgd(pooled, .5, config);
  for (int step = 0; step < 1; ++step) {
    const auto objective = n::sum(mask * n::square(global - target)) / total;
    global_sgd.minimize(objective);
  }
  n::ParameterStore spatial(157, n::DType::Float64);
  const auto image = spatial.get("log_depth", {1, 48, 64, 1}, n::init::zeros());
  n::Optimizer image_sgd(spatial, .5, config);
  const auto absent = n::equal(counts, 0.).to(n::DType::Float64);
  for (int step = 0; step < 1; ++step) {
    const auto numerator = n::sum(mask * n::square(image - target), {0}, true) +
                           absent * n::square(image - global.detach());
    const auto objective = n::sum(numerator / n::maximum(counts, n::ones_like(counts)));
    image_sgd.minimize(objective);
  }
  const auto geometric = n::exp(global.detach()).to(n::DType::Float32),
             map = n::exp(image.detach()).to(n::DType::Float32);
  const auto oracle = m::FitDepthPriors(split.fit);
  const double a = n::max(n::abs(geometric - n::full({1}, oracle.geometric))).item(),
               b = n::max(n::abs(map - oracle.spatial)).item();
  if (a > 5e-7 || b > 5e-7)
    return 1;
  const auto first = m::DepthBatch(split.fit, {0, 1, 2, 3, 4, 5, 6, 7});
  const auto baseline = n::ones(first.depth.shape()) * map;
  std::filesystem::create_directories("build");
  std::filesystem::create_directories("figures");
  n::save_npz("build/monocular_depth_priors.npz",
              {{"geometric", geometric}, {"spatial", map}});
  n::save_image_grid(m::DepthPreviewTiles(first, baseline),
                     "figures/monocular_depth_inputs.png", 1, 0, 1, 0, 0, 2);
  auto coverage = dm::graphics::RPlot::create();
  const std::vector<std::pair<std::string, m::DepthData>> data = {
      {"fitting", split.fit}, {"validation", split.validation}, {"test", split.test}};
  const std::array<dm::graphics::RGB, 3> colors = {
      {{37, 99, 235}, {220, 38, 38}, {22, 163, 74}}};
  int offset = 0, index = 0;
  std::print(
      "Visible SGD(.5):one pooled scalar update and one3072-coordinate image update. "
      "Closed-form parity {:.3g}/{:.3g};pooled geometric depth {:.6f}m;unobserved fitting "
      "positions {}.\n| split | rooms | true sensor samples |\n|---|---:|---:|\n",
      a, b, geometric.item(), n::count_nonzero(absent).item<std::int64_t>());
  for (const auto &item : data) {
    const auto values = n::mean(item.second.valid.to(n::DType::Float64), {1, 2, 3});
    const auto x = n::arange(offset, offset + item.second.rgb.size(0));
    coverage.points(x.to_vector<double>(), values.to_vector<double>(), item.first,
                    colors[index++]);
    std::print("| {} | {} | {} |\n", item.first, item.second.rgb.size(0),
               n::count_nonzero(item.second.valid).item<std::int64_t>());
    offset += item.second.rgb.size(0);
  }
  coverage.title("Actual sensor coverage in56 rooms")
      .x_label("prepared source room order")
      .y_label("fraction of valid48x64 samples")
      .y_limits(0, 1.3);
  const auto edges = n::arange(0., 10.0001, .2, n::DType::Float64),
             left = n::slice_axis(edges, 0, 0, 50), right = n::slice_axis(edges, 0, 1, 51),
             centers = (left + right) / 2.;
  const auto values = split.fit.depth.to(n::DType::Float64).reshape({-1, 1}),
             present = n::greater(split.fit.valid.reshape({-1, 1}), 0.);
  const auto hits =
      n::logical_and(present, n::logical_and(n::greater_equal(values, left.reshape({1, 50})),
                                             n::less(values, right.reshape({1, 50}))));
  const auto density = n::sum(hits.to(n::DType::Float64), {0}) / (total * .2);
  const double high = n::max(density).item() * 1.4;
  auto distribution = dm::graphics::RPlot::create();
  distribution
      .bars(centers.to_vector<double>(), density.to_vector<double>(), "valid sensor",
            {147, 51, 234}, .18)
      .lines({geometric.item(), geometric.item()}, {0., high * .8}, "SGD geometric",
             {220, 38, 38})
      .title("Fitting raw depths and learned prior")
      .x_label("true observed sensor depth in meters")
      .y_label("valid-sample density")
      .y_limits(0, high);
  auto layout = dm::graphics::RLayout::create(1, 2);
  layout.add(coverage)
      .add(distribution)
      .size(1100, 500)
      .fit_panels()
      .save_svg("build/monocular_depth_data.svg");
}
```
