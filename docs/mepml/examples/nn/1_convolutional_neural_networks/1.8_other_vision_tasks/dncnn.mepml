> Visible Adam with paired BN restoration

Warm all48 learned leaves and30 moving tensors before constructing Adam(.001).
Each epoch draws fresh fitting corruption,then visits all256 images once in
8-image batches. The visible loss is residual half-MSE. Select the paired
learned/BN checkpoint by inference-mode validation half-MSE. A separate
restored graph receives only noisy images,and must preserve every stored
value and single/batch agreement. Raw output stays unclipped.

Compare all32 held-out images with the noisy input and the fixed reflected
mean filter. Both references have no fitted coefficients or optimizer.
Mean per-image raw/clipped PSNR and pooled MSE are reported separately.
```{cpp, results="markdown", file="figures/dncnn_training.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

#include <numeric>
#include <print>
int main() {
  namespace n = dm::nn;
  namespace m = n::models;
  n::set_num_threads(2);

  std::filesystem::path cache;
  if (const auto *p = std::getenv("DATAMUNGE_DATA_DIR"))
    cache = p;
  else if (const auto *p = std::getenv("XDG_CACHE_HOME"))
    cache = std::filesystem::path(p) / "datamunge/datasets";
  else
    cache = std::filesystem::path(std::getenv("HOME")) / ".cache/datamunge/datasets";
  dm::datasets::fetch("cifar10", (cache / "cifar10").string());

  constexpr double sigma = 25. / 255;
  const auto raw =
                 n::data::LoadCifar({cache / "cifar10/data_batch_1.bin"}, n::data::Cifar::k10),
             testing =
                 n::data::LoadCifar({cache / "cifar10/test_batch.bin"}, n::data::Cifar::k10);
  std::vector<std::size_t> fi(256), vi(32), ti(32);
  std::iota(fi.begin(), fi.end(), 0);
  std::iota(vi.begin(), vi.end(), 256);
  std::iota(ti.begin(), ti.end(), 128);
  const auto clean = m::DnImages(raw.images, fi);
  const auto fixed = m::DnCorrupt(clean, sigma, 41),
             validation = m::DnCorrupt(m::DnImages(raw.images, vi), sigma, 43),
             test = m::DnCorrupt(m::DnImages(testing.images, ti), sigma, 47);

  n::ParameterStore p(17), state(18);
  {
    n::NoGradGuard guard;
    m::DnCNN(p, state, n::zeros({1, 32, 32, 1}), 16);
  }
  n::OptimizerConfig config;
  config.kind = n::OptimizerKind::Adam;
  n::Optimizer adam(p, .001, config);
  auto predict = [](n::ParameterStore &weights, n::ParameterStore &moving,
                    const n::Tensor &noisy) {
    n::NoGradGuard guard;
    std::vector<n::Tensor> parts;
    for (std::int64_t i = 0; i < noisy.size(0); i += 8)
      parts.push_back(m::DnCNN(weights, moving,
                               n::slice_axis(noisy, 0, i, std::min(i + 8, noisy.size(0))), 16)
                          .clean);
    return n::concat(parts, 0);
  };
  auto infer_loss = [&](const m::DnData &data) {
    return m::DnResidualLoss(data.noisy - predict(p, state, data.noisy), data.noise).item();
  };
  const auto probe = m::DnBatch(fixed, {0, 1, 2, 3, 4, 5, 6, 7});
  double initial_train;
  {
    n::NoGradGuard guard;
    initial_train =
        m::DnResidualLoss(m::DnCNN(p, state, probe.noisy, 16, true, false).noise, probe.noise)
            .item();
  }
  const double initial_infer = infer_loss(probe);
  n::BatchOrder order(256, 8, 59);
  std::vector<double> epochs, training, valid;
  double best = INFINITY;
  int selected = 0, updates = 0;
  std::filesystem::create_directories("build");
  std::filesystem::create_directories("figures");
  std::print("35344 learned scalars/48 tensors;480 BN scalars/30 tensors.\n| epoch | fitting "
             "half-MSE | moving-BN validation half-MSE |\n|---:|---:|---:|\n");
  for (int epoch = 1; epoch <= 3; ++epoch) {
    const auto fresh = m::DnCorrupt(clean, sigma, 5300 + std::uint64_t(epoch));
    order.begin_epoch();
    double total = 0;
    int seen = 0;
    for (auto ids = order.next(); !ids.empty(); ids = order.next()) {
      const auto batch = m::DnBatch(fresh, std::vector<std::size_t>(ids.begin(), ids.end()));
      const auto network = m::DnCNN(p, state, batch.noisy, 16, true, true);
      const auto loss = m::DnResidualLoss(network.noise, batch.noise);
      if (!std::isfinite(loss.item()))
        return 1;
      total += loss.item() * ids.size();
      seen += ids.size();
      adam.minimize(loss);
      ++updates;
    }
    if (seen != 256)
      return 1;
    epochs.push_back(epoch);
    training.push_back(total / seen);
    valid.push_back(infer_loss(validation));
    if (valid.back() < best) {
      best = valid.back();
      selected = epoch;
      p.save("build/dncnn_best.npz");
      state.save("build/dncnn_bn.npz");
    }
    std::print("| {} | {:.6f} | {:.6f} |\n", epoch, training.back(), valid.back());
  }
  p.load("build/dncnn_best.npz");
  state.load("build/dncnn_bn.npz");
  const double restored = infer_loss(validation);
  if (std::abs(restored - best) > 1e-8)
    return 1;
  double learned_train;
  {
    n::NoGradGuard guard;
    learned_train =
        m::DnResidualLoss(m::DnCNN(p, state, probe.noisy, 16, true, false).noise, probe.noise)
            .item();
  }
  const double learned_infer = infer_loss(probe);
  if (learned_train >= initial_train || training.back() >= training.front())
    return 1;
  n::ParameterStore deployed(991), moving(997);
  {
    n::NoGradGuard guard;
    m::DnCNN(deployed, moving, n::zeros({1, 32, 32, 1}), 16);
  }
  deployed.load("build/dncnn_best.npz");
  moving.load("build/dncnn_bn.npz");
  std::vector<n::Tensor> snapshot;
  for (const auto *store : {&deployed, &moving})
    for (const auto &v : store->parameters())
      snapshot.push_back(v.clone());
  const auto prediction = predict(deployed, moving, test.noisy),
             reference = predict(p, state, test.noisy),
             repeat = predict(deployed, moving, test.noisy), box = m::DnBoxFilter(test.noisy);
  const double parity = n::max(n::abs(prediction - reference)).item();
  if (parity > 1e-7 || !n::all(n::equal(prediction, repeat)).item<bool>())
    return 1;
  std::size_t k = 0;
  for (const auto *store : {&deployed, &moving})
    for (const auto &v : store->parameters())
      if (!n::all(n::equal(snapshot[k++], v)).item<bool>())
        return 1;
  const auto single = predict(deployed, moving, m::DnBatch(test.noisy, {3}));
  if (n::max(n::abs(single - n::slice_axis(prediction, 0, 3, 4))).item() > 1e-6)
    return 1;
  const auto learned = m::ScoreTensorDn(prediction, test.clean),
             noisy = m::ScoreTensorDn(test.noisy, test.clean),
             filtered = m::ScoreTensorDn(box, test.clean);
  std::print(
      "{} visible Adam updates;selected epoch{},paired validation half-MSE {:.6f}. Fixed "
      "fitting train-mode {:.6f}->{:.6f},moving-BN inference {:.6f}->{:.6f}.\nNoisy-only "
      "independent deployment parity {:.3g};all48 learned+30 moving tensors immutable,repeat "
      "exact,single/batch agree.\n| estimate | raw MSE | mean raw PSNR dB | mean clipped PSNR "
      "dB | outside fraction |\n|---|---:|---:|---:|---:|\n",
      updates, selected, restored, initial_train, learned_train, initial_infer, learned_infer,
      parity);
  for (const auto &item : std::vector<std::pair<std::string, m::TensorDnMetrics>>{
           {"learned", learned}, {"noisy", noisy}, {"reflected mean", filtered}})
    std::print("| {} | {:.6f} | {:.6f} | {:.6f} | {:.6f} |\n", item.first,
               item.second.mse.item(), item.second.psnr.item(),
               item.second.clipped_psnr.item(), item.second.outside.item());
  n::save_image_grid(m::DnPreviewTiles(test, prediction, box), "figures/dncnn_predictions.png",
                     2, 0, 1, 0, 0, 3);
  n::save_npz(
      "build/dncnn_test.npz",
      {{"clean", test.clean}, {"noisy", test.noisy}, {"restored", prediction}, {"box", box}});
  auto a = dm::graphics::RPlot::create(), b = dm::graphics::RPlot::create();
  a.bars({0., 1., 2.}, {learned.psnr.item(), noisy.psnr.item(), filtered.psnr.item()},
         "raw PSNR", {37, 99, 235})
      .title("All32 held-out raw scores")
      .x_label("0 learned,1 noisy,2 fixed box")
      .y_label("mean per-image PSNR in dB")
      .y_limits(0, 32);
  b.bars(
       {0., 1., 2.},
       {learned.clipped_psnr.item(), noisy.clipped_psnr.item(), filtered.clipped_psnr.item()},
       "clipped PSNR", {22, 163, 74})
      .title("Clipping is scored separately")
      .x_label("0 learned,1 noisy,2 fixed box")
      .y_label("mean per-image PSNR in dB")
      .y_limits(0, 32);
  auto metrics = dm::graphics::RLayout::create(1, 2);
  metrics.add(a).add(b).size(1100, 480).fit_panels().save_svg("build/dncnn_metrics.svg");
  std::filesystem::copy_file("build/dncnn_metrics.svg", "figures/dncnn_metrics.svg",
                             std::filesystem::copy_options::overwrite_existing);
  a = dm::graphics::RPlot::create();
  a.lines(epochs, training, "fitting half-MSE", {37, 99, 235})
      .lines(epochs, valid, "validation half-MSE", {220, 38, 38})
      .title("Visible Adam with fresh fitting noise")
      .x_label("epoch")
      .y_label("residual half-MSE")
      .y_limits(0, std::max(*std::max_element(training.begin(), training.end()),
                            *std::max_element(valid.begin(), valid.end())) *
                       1.4)
      .size(950, 480);
  a.save_svg("build/dncnn_training.svg");
}
```
