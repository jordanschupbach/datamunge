> Check the actual Gaussian stream

The corruption helper draws source-order53-bit integers from mt19937_64.
All subsequent uniform scaling and Box–Muller operations use Float64 tensors:
\(u=(k+1)/2^{53}\),\(R=\sqrt{-2\log u}\),
\(z_1=R\cos(2\pi v),z_2=R\sin(2\pi v)\).
The noisy pixel is float32(clean+sigma*z),and the supervised residual is
that rounded noisy value minus clean. A repeated seed reproduces;fresh
fitting seeds change each epoch. No noisy-input clipping is applied.
```{cpp, results="markdown", file="figures/dncnn_noise.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

#include <print>
int main() {
  namespace n = dm::nn;
  namespace m = n::models;
  const auto clean = n::tile(n::tensor({0., 1.}), {65536}).reshape({128, 32, 32, 1});
  const auto sample = m::DnCorrupt(clean, 25. / 255, 101);
  const auto z = sample.noise.to(n::DType::Float64).reshape({-1}) / (25. / 255);
  const auto edges = n::arange(-4., 4.0001, .2, n::DType::Float64),
             left = n::slice_axis(edges, 0, 0, 40), right = n::slice_axis(edges, 0, 1, 41),
             centers = (left + right) / 2.;
  const auto hits = n::logical_and(n::greater_equal(z.reshape({-1, 1}), left.reshape({1, 40})),
                                   n::less(z.reshape({-1, 1}), right.reshape({1, 40})));
  const auto density = n::sum(hits.to(n::DType::Float64), {0}) / (double(z.numel()) * .2);
  const auto pdf = n::exp(-.5 * n::square(centers)) / std::sqrt(2 * std::numbers::pi);
  const auto metric = m::ScoreTensorDn(sample.noisy, clean);
  auto p = dm::graphics::RPlot::create();
  p.bars(centers.to_vector<double>(), density.to_vector<double>(), "sample density",
         {37, 99, 235}, .18)
      .lines(centers.to_vector<double>(), pdf.to_vector<double>(), "standard normal",
             {220, 38, 38})
      .title("131072 source-seeded Gaussian residuals")
      .x_label("actual rounded noise divided by sigma")
      .y_label("density;tails outside plot omitted")
      .y_limits(0, .55)
      .size(950, 480);
  std::filesystem::create_directories("build");
  p.save_svg("build/dncnn_noise.svg");
  std::print("Standardized residual mean {:.6f},second moment {:.6f},fourth moment "
             "{:.6f};unclipped boundary pixels outside[0,1] fraction {:.6f}.\n",
             n::mean(z).item(), n::mean(n::square(z)).item(), n::mean(n::pow(z, 4)).item(),
             metric.outside.item());
}
```
