> Simple intrinsic/cheap map example

Odd requested width makes the concatenation/trimming rule visible.

```{cpp, results="markdown", file="figures/ghostnet_module.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

int main() {
  namespace n = dm::nn;
  const auto type = n::DType::Float64;
  n::ParameterStore p(17, type), state(17, type);
  std::vector<n::models::MobileLayer> layers;
  n::models::MobileContext c{p, state, layers, false};
  const auto x = n::linspace(-1, 1, 75, type).reshape({1, 5, 5, 3}).detach().requires_grad_();
  {
    n::NoGradGuard guard;
    n::models::GhostModule(c, "g", x, 5, false);
  }
  p.set("g/primary/W", n::eye(3, type).reshape({1, 1, 3, 3}));
  const auto delta =
      n::one_hot(n::from_vector(std::vector<int64_t>{4}), 9, 1, 0, type).reshape({3, 3, 1, 1});
  p.set("g/cheap/W", 2 * delta * n::ones({1, 1, 3, 1}, type));
  for (const auto *part : {"primary", "cheap"})
    p.set(std::string("g/") + part + "/bn/gamma", n::full({3}, std::sqrt(1.00001), type));
  const auto out = n::models::GhostModule(c, "g", x, 5, false);
  const auto expected = n::slice_axis(n::concat({x, 2 * x}, 3), 3, 0, 5);
  const auto gradients = n::grad(n::sum(out.output), {x, p.at("g/cheap/W")});
  const auto target = n::from_vector(std::vector<double>{3, 3, 1});
  if (n::max(n::abs(out.intrinsic - x)).item() > 1e-12 ||
      n::max(n::abs(out.ghost - 2 * x)).item() > 1e-12 ||
      n::max(n::abs(out.output - expected)).item() > 1e-12 ||
      n::max(n::abs(gradients[0] - target)).item() > 1e-12 ||
      n::max(n::abs(n::slice_axis(gradients[1], 2, 2, 3))).item() != 0)
    return 1;
  auto channel = [](const auto &t, int64_t k) {
    return n::slice_axis(t, 3, k, k + 1).reshape({5, 5});
  };
  auto derivative = dm::graphics::RPlot::create();
  derivative.lines({0, 1, 2}, {3, 3, 1}, "input derivative", {147, 51, 234})
      .title("Trimmed output sum derivative")
      .x_label("input channel")
      .y_label("d sum(output) / dx")
      .y_limits(0, 4.5);
  auto layout = dm::graphics::RLayout::create(2, 2);
  layout
      .add(
          n::plot_tensor_map(channel(out.intrinsic, 0), -2, 2).title("Intrinsic channel zero"))
      .add(n::plot_tensor_map(channel(out.ghost, 0), -2, 2)
               .title("Cheap channel: twice intrinsic"))
      .add(n::plot_tensor_map(channel(out.output, 3), -2, 2)
               .title("First ghost output after concatenation"))
      .add(derivative);
  std::filesystem::create_directories("build");
  layout.size(1100, 920).fit_panels().save_svg("build/ghostnet_module.svg");
  std::print("Requested five channels: three intrinsic + three generated, concatenated then "
             "trimmed. Output is [x0,x1,x2,2x0,2x1]; input derivatives [3,3,1]. The discarded "
             "generated x2 filter has zero data gradient.\n");
}
```
