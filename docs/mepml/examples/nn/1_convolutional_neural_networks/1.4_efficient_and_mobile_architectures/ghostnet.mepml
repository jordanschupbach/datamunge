> Complete-model gradient checks

Topology determines which BN shifts are removed downstream.

```{cpp, results="markdown", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

int main() {
  namespace n = dm::nn;
  n::set_num_threads(2);
  n::ParameterStore p(17), state(17);
  n::models::GhostNetConfig cfg;
  cfg.keep_probability = 1;
  cfg.update_stats = false;
  const auto blocks = n::models::GhostNetBlocks();
  std::vector<bool> identity;
  int width = 16;
  for (const auto &b : blocks) {
    identity.push_back(b.stride == 1 && width == b.out);
    width = b.out;
  }
  std::set<std::string> removable;
  for (size_t j = 0; j < blocks.size(); ++j) {
    const auto prefix = "block" + std::to_string(j + 1);
    if (!identity[j])
      removable.insert(prefix + "/shortcut/depthwise/bn/beta");
    if (blocks[j].stride > 1 && blocks[j].se == 0)
      removable.insert(prefix + "/depthwise/bn/beta");
    bool pointwise = true;
    for (size_t k = j + 1; k < blocks.size(); ++k)
      if (!identity[k]) {
        pointwise = false;
        break;
      }
    if (pointwise) {
      removable.insert(prefix + "/ghost2/cheap/bn/beta");
      if (!identity[j])
        removable.insert(prefix + "/shortcut/pointwise/bn/beta");
    }
  }
  const auto x = n::sin(.37 * n::arange(0, 2 * 64 * 64 * 3).to(n::DType::Float32))
                     .reshape({2, 64, 64, 3});
  {
    n::NoGradGuard guard;
    n::models::GhostNet(p, state, x, cfg, true);
    for (const auto &name : p.names())
      if (name.ends_with("/beta") ||
          (name.find("/se/") != std::string::npos && name.ends_with("/b")))
        p.set(name, (.5 * n::sin(.37 * n::arange(0, p.at(name).numel()).to(n::DType::Float32) +
                                 double(name.size())))
                        .reshape(p.at(name).shape()));
  }
  const auto out = n::models::GhostNet(p, state, x, cfg, true);
  const auto gradients = n::grad(n::mean(n::square(out.logits)), p.parameters());
  double largest = 0, minimum = std::numeric_limits<double>::infinity(), removed = 0;
  size_t count = 0;
  for (size_t i = 0; i < gradients.size(); ++i) {
    const double norm = n::sqrt(n::sum(n::square(gradients[i]))).item();
    if (!std::isfinite(norm))
      return 1;
    largest = std::max(largest, norm);
    if (removable.count(p.names()[i])) {
      ++count;
      removed = std::max(removed, norm);
    } else
      minimum = std::min(minimum, norm);
  }
  if (count != removable.size() || removed > 1e-5 * largest || minimum <= 0)
    return 1;
  std::print("Complete full-width 16-block backward at 64 pixels: {} finite parameter-tensor "
             "gradients; {} redundant BN shifts max {:.9f}; other minimum {:.9f}, overall "
             "maximum {:.9f}.\n",
             gradients.size(), count, removed, minimum, largest);
}
```
// result_begin: markdown
Complete full-width 16-block backward at 64 pixels: 272 finite parameter-tensor gradients; 13 redundant BN shifts max 0.000000012; other minimum 0.001900218, overall maximum 3.001646042.
// result_end

> Dataset and explicit fitting

Original images precede the visible optimizer loop.

```{cpp, results="markdown", file="figures/ghostnet_inputs.png", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

int main() {
  namespace n = dm::nn;

  std::filesystem::path cache;
  if (const auto *p = std::getenv("DATAMUNGE_DATA_DIR"))
    cache = p;
  else if (const auto *p = std::getenv("XDG_CACHE_HOME"))
    cache = std::filesystem::path(p) / "datamunge/datasets";
  else
    cache = std::filesystem::path(std::getenv("HOME")) / ".cache/datamunge/datasets";
  dm::datasets::fetch("cifar10", (cache / "cifar10").string());

  const auto raw =
      n::data::LoadCifar({cache / "cifar10/data_batch_1.bin"}, n::data::Cifar::k10);
  const auto images = n::cast(raw.images, n::DType::Float32) / 255.;
  const auto labels = raw.labels;

  std::vector<int64_t> rows;
  for (int cls = 0; cls < 10; ++cls) {
    for (int64_t row = 0; row < labels.numel(); ++row)
      if (labels.at({row}) == cls) {
        rows.push_back(row);
        break;
      }
  }
  if (rows.size() != 10)
    return 1;
  std::filesystem::create_directories("build");
  n::save_image_grid(n::take_rows(images, rows), "build/ghostnet_inputs.png", 5, 0., 1., 4, 1.,
                     4);
  std::print("One original cached training image per class, IDs 0..4 then 5..9.\n");
}
```
