> Complete model and arithmetic budgets

Kernel ratios and complete learned counts answer different questions.

```{cpp, results="markdown", file="figures/ghostnet_budget.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

int main() {
  namespace n = dm::nn;
  n::set_num_threads(2);
  std::vector<double> widths, parameters, work;
  for (auto [width, count, moving, macs] :
       std::vector<std::tuple<double, int64_t, int64_t, int64_t>>{
           {.5, 2587292, 10984, 42328152},
           {1, 5182508, 21968, 141150512},
           {1.3, 7358820, 28536, 227003256}}) {
    n::NoGradGuard guard;
    n::ParameterStore p(17), state(17);
    n::models::GhostNetConfig cfg;
    cfg.width = width;
    const auto out = n::models::GhostNet(p, state, n::zeros({1, 224, 224, 3}), cfg);
    if (p.count() != count || state.count() != moving || out.Macs() != macs ||
        n::models::GhostNetBlocks().size() != 16 || out.features.size(1) != 7)
      return 1;
    widths.push_back(width);
    parameters.push_back(double(count) / 1e6);
    work.push_back(double(macs) / 1e6);
    std::print("GhostNet {}x: {} learned / {} moving scalars, {} kernel/SE/head/classifier "
               "MACs per image.\n",
               width, count, moving, macs);
  }
  {
    n::NoGradGuard guard;
    n::ParameterStore p(17), state(17);
    std::vector<n::models::MobileLayer> cheap, dense;
    n::models::MobileContext a{p, state, cheap, false}, b{p, state, dense, false};
    const auto x = n::zeros({1, 7, 7, 160});
    n::models::GhostModule(a, "ghost", x, 960, true);
    n::models::GhostConvBN(b, "plain", x, 960, 1, 1, false, true);
    int64_t gw = 0, dw = 0, gm = 0, dm = 0;
    for (const auto &l : cheap) {
      gw += p.at(l.name + "/W").numel();
      gm += l.Macs();
    }
    for (const auto &l : dense) {
      dw += p.at(l.name + "/W").numel();
      dm += l.Macs();
    }
    const double formula = 2. * 160 / (160 + 9);
    if (std::abs(double(dw) / gw - formula) > 1e-12 ||
        std::abs(double(dm) / gm - formula) > 1e-12)
      return 1;
    std::print("160->960 at 7x7: dense/ghost kernel and MAC ratio {:.9f}; excludes "
               "BN/bias/activation work. This is an arithmetic ratio, not measured speedup.\n",
               formula);
  }
  auto count = dm::graphics::RPlot::create(), macs = dm::graphics::RPlot::create();
  count.lines(widths, parameters, "learned", {37, 99, 235})
      .title("Complete GhostNet parameter budget")
      .x_label("width multiplier")
      .y_label("million learned scalars")
      .y_limits(0, 10);
  macs.lines(widths, work, "kernel MACs", {234, 88, 12})
      .title("Measured-shape arithmetic at 224")
      .x_label("width multiplier")
      .y_label("million MACs per image")
      .y_limits(0, 300);
  std::filesystem::create_directories("build");
  dm::graphics::RLayout::create(1, 2)
      .add(count)
      .add(macs)
      .size(1100, 470)
      .fit_panels()
      .save_svg("build/ghostnet_budget.svg");
}
```
