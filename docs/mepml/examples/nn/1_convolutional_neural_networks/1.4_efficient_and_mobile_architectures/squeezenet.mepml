> Simple Fire equivalence

The fixture preserves squeeze, biases, expand activation and every derivative.

```{cpp, results="markdown", file="figures/squeezenet_fire.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

int main() {
  namespace n = dm::nn;
  const auto type = n::DType::Float64;
  n::ParameterStore p(17, type);
  const auto x = n::sin(.37 * n::arange(0, 360).to(type) + .1)
                     .reshape({2, 6, 6, 5})
                     .detach()
                     .requires_grad_();
  {
    n::NoGradGuard guard;
    n::models::Fire(p, "f", x, 3, 4, 6);
    for (const auto &name : p.names())
      if (name.ends_with("/b"))
        p.set(name,
              .2 * n::sin(n::arange(0, p.at(name).numel()).to(type) + double(name.size())));
  }
  const auto out = n::models::Fire(p, "f", x, 3, 4, 6);
  const auto centred = n::pad(p.at("f/expand1x1/W"), {{1, 1}, {1, 1}, {0, 0}, {0, 0}});
  const auto kernel = n::concat({centred, p.at("f/expand3x3/W")}, 3),
             bias = n::concat({p.at("f/expand1x1/b"), p.at("f/expand3x3/b")}, 0);
  const auto merged =
      n::relu(n::conv2d(out.squeeze, kernel, n::conv_options(1, n::Padding::Same)) + bias);
  auto variables = p.parameters();
  variables.insert(variables.begin(), x);
  const auto weights =
      n::sin(.37 * n::arange(0, 720).to(type) + .3).reshape(out.output.shape());
  const auto a = n::grad(n::sum(out.output * weights), variables, {.retain_graph = true}),
             b = n::grad(n::sum(merged * weights), variables);
  double error = n::max(n::abs(out.output - merged)).item();
  for (size_t i = 0; i < a.size(); ++i)
    error = std::max(error, n::max(n::abs(a[i] - b[i])).item());
  if (error > 1e-11)
    return 1;
  auto first = [](const auto &t) {
    return n::slice_axis(n::slice_axis(t, 0, 0, 1), 3, 0, 1).reshape({6, 6});
  };
  const double high = std::max(1e-12, n::max(out.output).item());
  auto layout = dm::graphics::RLayout::create(1, 2);
  layout
      .add(n::plot_tensor_map(first(out.output), 0, high)
               .title("Fire: concatenated expand branches"))
      .add(n::plot_tensor_map(first(merged), 0, high)
               .title("Centre-embedded expand convolution"));
  std::filesystem::create_directories("build");
  layout.size(1100, 470).fit_panels().save_svg("build/squeezenet_fire.svg");
  std::print("Fire expand equivalence: outputs and all input/parameter derivatives agree to "
             "{:.12f}. Fire2 with Cin=96,S=16,E1=E3=64: 11920 learned scalars versus 110720 "
             "for a plain 3x3 to 128 channels, including biases.\n",
             error);
}
```
// result_begin: markdown
Fire expand equivalence: outputs and all input/parameter derivatives agree to 0.000000000000. Fire2 with Cin=96,S=16,E1=E3=64: 11920 learned scalars versus 110720 for a plain 3x3 to 128 channels, including biases.
\image(figures/squeezenet_fire.svg)
// result_end
\caption(The two expand filters share a nonlinear squeeze map. Centre embedding merges the expand operation, including biases and ReLU, while preserving all input/parameter derivatives. It does not remove the nonlinear squeeze or represent arbitrary dense input filters.)
\alttext(The two expand filters share a nonlinear squeeze map. Centre embedding merges the expand operation, including biases and ReLU, while preserving all input/parameter derivatives. It does not remove the nonlinear squeeze or represent arbitrary dense input filters.)

> Simple ceil-pooling example

All-negative data makes incorrect zero padding immediately visible.

```{cpp, results="markdown", file="figures/squeezenet_pooling.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

int main() {
  namespace n = dm::nn;
  const auto type = n::DType::Float64;
  const auto x = n::arange(-16, 0).to(type).reshape({1, 4, 4, 1}).detach().requires_grad_();
  int side = 4;
  const auto y = n::models::CeilMaxPool(x, side);
  const auto expected = n::from_vector(std::vector<double>{-6, -5, -2, -1}, {1, 2, 2, 1});
  if (side != 2 || n::max(n::abs(y - expected)).item() != 0)
    return 1;
  const auto dx = n::grad(n::sum(y), {x})[0];
  for (int r = 0; r < 4; ++r)
    for (int c = 0; c < 4; ++c)
      if (dx.at({0, r, c, 0}) != double(r >= 2 && c >= 2))
        return 1;
  auto layout = dm::graphics::RLayout::create(1, 2);
  layout.add(n::plot_tensor_map(x.reshape({4, 4}), -16, -1).title("Negative input: 4x4"))
      .add(n::plot_tensor_map(y.reshape({2, 2}), -16, -1).title("Ceil 3x3/2 pool: 2x2"));
  std::filesystem::create_directories("build");
  layout.size(1100, 470).fit_panels().save_svg("build/squeezenet_pooling.svg");
  std::print(
      "Ceil pooling retains the final row/column: [-6,-5;-2,-1], with derivatives at the four "
      "winning pixels. Negative-infinity padding cannot win over the negative data.\n");
}
```
// result_begin: markdown
Ceil pooling retains the final row/column: [-6,-5;-2,-1], with derivatives at the four winning pixels. Negative-infinity padding cannot win over the negative data.
\image(figures/squeezenet_pooling.svg)
// result_end
\caption(Padding is only at the bottom/right and uses negative infinity, preserving maxima for entirely negative images. Floor-rounded pooling would return one output and lose the edge windows. The four winning input derivatives are checked exactly.)
\alttext(Padding is only at the bottom/right and uses negative infinity, preserving maxima for entirely negative images. Floor-rounded pooling would return one output and lose the edge windows. The four winning input derivatives are checked exactly.)

> Complete released geometry and gradients

Full 224-pixel counts/shapes are separate from full-width backward probes at 64 pixels.

```{cpp, results="markdown", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

int main() {
  namespace n = dm::nn;
  n::set_num_threads(2);
  for (auto [version, bypass, count, sizes] :
       std::vector<std::tuple<int, bool, int64_t, std::vector<int>>>{
           {10, false, 1248424, {54, 54, 54, 27, 27, 27, 27, 13}},
           {10, true, 1248424, {54, 54, 54, 27, 27, 27, 27, 13}},
           {11, false, 1235496, {55, 55, 27, 27, 13, 13, 13, 13}}}) {
    {
      n::NoGradGuard guard;
      n::ParameterStore p(17);
      n::models::SqueezeNetConfig cfg;
      cfg.version = version;
      cfg.simple_bypass = bypass;
      const auto out = n::models::SqueezeNet(p, n::zeros({1, 224, 224, 3}), cfg);
      if (p.count() != count || out.sizes != sizes || out.fires.size() != 8 ||
          out.fires.back().shape() != n::Shape{1, 13, 13, 512} ||
          out.logits.shape() != n::Shape{1, 1000})
        return 1;
      std::print("SqueezeNet version {}, bypass {}: {} learned scalars; all eight 224-pixel "
                 "Fire shapes and ceil-pool stages verified.\n",
                 version, bypass, count);
    }
    n::ParameterStore p(17);
    n::models::SqueezeNetConfig cfg;
    cfg.version = version;
    cfg.simple_bypass = bypass;
    cfg.image_size = 64;
    cfg.keep_probability = 1;
    const auto x = n::sin(.37 * n::arange(0, 2 * 64 * 64 * 3).to(n::DType::Float32))
                       .reshape({2, 64, 64, 3});
    const auto out = n::models::SqueezeNet(p, x, cfg);
    const auto gradients = n::grad(n::mean(n::square(out.logits)), p.parameters());
    double minimum = std::numeric_limits<double>::infinity();
    for (const auto &g : gradients) {
      const double norm = n::sqrt(n::sum(n::square(g))).item();
      if (!std::isfinite(norm))
        return 1;
      minimum = std::min(minimum, norm);
    }
    if (minimum <= 0)
      return 1;
    std::print("Complete 64-pixel backward, same widths/modules: {} finite nonzero "
               "parameter-tensor gradients; minimum norm {:.9f}.\n",
               gradients.size(), minimum);
  }
}
```
