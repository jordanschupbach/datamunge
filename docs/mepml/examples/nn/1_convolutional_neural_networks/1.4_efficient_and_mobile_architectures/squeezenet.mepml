```{cpp, results="markdown", file="figures/squeezenet_training.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <chrono>

int main() {
  int rendered_confusions = 0;
  namespace n             = dm::nn;
  namespace c             = dm::compute;
  using clock             = std::chrono::steady_clock;
  n::set_num_threads(8);

  // Inference runs on the first CUDA GPU when this datamunge build has CUDA and
  // cuBLAS; otherwise the identical code runs on the CPU. Training stays on CPU.
  const c::Context host;
  c::Context       device = host;
  if (c::probe({c::Backend::CUDA, 0}).available) {
    const c::Context gpu({c::Backend::CUDA, 0});
    if (gpu.supports_matmul())
      device = gpu;
  }
  const auto device_name = device.device().backend == c::Backend::CUDA
                               ? "CUDA " + c::probe(device.device()).name
                               : std::string("CPU (no usable CUDA device in this build)");

  std::filesystem::path cache;
  if (const auto* p = std::getenv("DATAMUNGE_DATA_DIR"))
    cache = p;
  else if (const auto* p = std::getenv("XDG_CACHE_HOME"))
    cache = std::filesystem::path(p) / "datamunge/datasets";
  else
    cache = std::filesystem::path(std::getenv("HOME")) / ".cache/datamunge/datasets";
  dm::datasets::fetch("cifar10", (cache / "cifar10").string());

  constexpr std::int64_t fit = 8000, held = 2000, batch = 32, epochs = 10, warmup = 100;
  constexpr double       peak = .0005;
  const auto raw    = n::data::LoadCifar({cache / "cifar10/data_batch_1.bin"}, n::data::Cifar::k10);
  const auto images = n::cast(raw.images, n::DType::Float32) / 255.,
             labels = n::cast(raw.labels, n::DType::Int64);
  const auto tx = n::slice_axis(images, 0, 0, fit), ty = n::slice_axis(labels, 0, 0, fit);
  const auto vx = 2 * n::slice_axis(images, 0, fit, fit + held) - 1,
             vy = n::slice_axis(labels, 0, fit, fit + held);
  const auto official = n::load_cifar10((cache / "cifar10").string(), "test");
  const auto qx = 2 * official.images - 1, qy = official.labels;

  // Batched dropout-free inference on `device`; logits come back to the host.
  auto infer = [&](const n::ParameterStore& p, const n::models::SqueezeNetConfig& cfg,
                   const n::Tensor& x) {
    n::NoGradGuard         guard;
    auto                   dp = p.to(device);
    std::vector<n::Tensor> logits;
    for (std::int64_t i = 0; i < x.size(0); i += 1000) {
      const auto rows = n::slice_axis(x, 0, i, std::min(i + 1000, x.size(0)));
      logits.push_back(n::models::SqueezeNet(dp, rows.to(device), cfg, false).logits.to(host));
    }
    return n::concat(logits, 0);
  };

  auto   training_plot = dm::graphics::RPlot::create(),
         validation_plot = dm::graphics::RPlot::create();
  int    setting = 0;
  double inference_seconds = 0;
  std::vector<std::string> names;
  std::vector<double>      counts, selected, validation_nll, train_nll, test_nll, accuracy;
  std::filesystem::create_directories("build");
  for (auto [version, bypass] :
       std::vector<std::pair<int, bool>>{{10, false}, {10, true}, {11, false}}) {
    n::models::SqueezeNetConfig cfg;
    cfg.version       = version;
    cfg.simple_bypass = bypass;
    cfg.cifar_stem    = true;
    cfg.image_size    = 32;
    cfg.classes       = 10;
    n::Generator      dropout_rng(101);
    n::ParameterStore p(17);
    {
      n::NoGradGuard guard;
      n::models::SqueezeNet(p, n::zeros({1, 32, 32, 3}), cfg, false);
    }
    if (p.count() != (version == 10 ? 729034 : 727626))
      return 1;
    n::OptimizerConfig config;
    config.kind = n::OptimizerKind::Adam;
    n::Optimizer        optimizer(p, peak, config);
    n::BatchOrder       batches(fit, batch, 2026);
    n::Generator        augmentation(151);
    const std::int64_t  steps      = epochs * ((fit + batch - 1) / batch);
    const std::string   checkpoint = "build/squeezenet_best";
    double              best       = std::numeric_limits<double>::infinity(), seconds = 0;
    int                 best_epoch = 0;
    std::vector<double> epoch_axis, train, validation;
    for (int epoch = 1; epoch <= epochs; ++epoch) {
      const auto start = clock::now();
      batches.begin_epoch();
      n::WeightedMean average;
      for (auto rows = batches.next(); !rows.empty(); rows = batches.next()) {
        const auto             x = n::take_rows(tx, rows), target = n::take_rows(ty, rows);
        std::vector<n::Tensor> transformed;
        for (int64_t row = 0; row < x.size(0); ++row) {
          auto image =
              n::pad(n::slice_axis(x, 0, row, row + 1), {{0, 0}, {4, 4}, {4, 4}, {0, 0}});
          image = n::augment::random_crop(image, 32, 32, augmentation);
          transformed.push_back(n::augment::random_flip_left_right(image, augmentation));
        }
        const auto logits = n::models::SqueezeNet(p, 2 * n::concat(transformed, 0) - 1, cfg,
                                                  true, &dropout_rng)
                                .logits;
        const auto nll       = n::sparse_softmax_cross_entropy(logits, target);
        auto       objective = nll;
        for (const auto& w : p.parameters())
          if (w.dim() >= 2)
            objective = objective + .00005 * n::sum(n::square(w));
        optimizer.set_learning_rate(
            n::schedule::warmup_cosine(peak, 0, warmup, steps, optimizer.iterations()));
        optimizer.minimize(objective);
        average.add(nll.item(), rows.size());
      }
      seconds += std::chrono::duration<double>(clock::now() - start).count();
      const auto   inferred = clock::now();
      const double val = n::sparse_softmax_cross_entropy(infer(p, cfg, vx), vy).item();
      inference_seconds += std::chrono::duration<double>(clock::now() - inferred).count();
      if (!std::isfinite(val))
        return 1;
      epoch_axis.push_back(epoch);
      train.push_back(average.value());
      validation.push_back(val);
      if (val < best) {
        best       = val;
        best_epoch = epoch;
        p.save(checkpoint + "_params.npz");
      }
    }
    p.load(checkpoint + "_params.npz");
    const auto inferred     = clock::now();
    const auto prediction   = infer(p, cfg, qx);
    const auto training_out = infer(p, cfg, 2 * tx - 1);
    inference_seconds += std::chrono::duration<double>(clock::now() - inferred).count();
    n::NoGradGuard guard;
    const double   test = n::sparse_softmax_cross_entropy(prediction, qy).item();
    if (!std::isfinite(test))
      return 1;
    n::ConfusionMatrix confusion(10);
    confusion.add(qy, n::argmax(prediction, 1));
    confusion.save_svg(
        "build/squeezenet_confusion_api_" + std::to_string(rendered_confusions++) + ".svg",
        {.title = "squeezenet / selected-checkpoint test counts"});

    const std::string label = version == 11 ? "v1.1" : bypass ? "v1.0 + bypass" : "v1.0";
    const std::vector<dm::graphics::RGB> colours = {{37, 99, 235}, {234, 88, 12}, {22, 163, 74}};
    training_plot.lines(epoch_axis, train, label, colours[setting]);
    validation_plot.lines(epoch_axis, validation, label, colours[setting]);
    ++setting;
    names.push_back(label);
    counts.push_back(p.count());
    selected.push_back(best_epoch);
    validation_nll.push_back(best);
    train_nll.push_back(n::sparse_softmax_cross_entropy(training_out, ty).item());
    test_nll.push_back(test);
    accuracy.push_back(n::accuracy(prediction, qy));
    std::print("SqueezeNet {}: {} Adam updates in {:.0f} s of CPU training.\n", label,
               optimizer.iterations(), seconds);
  }
  dm::dstruct::DataFrame table;
  table.add_column("configuration", names);
  table.add_column("parameters", counts);
  table.add_column("best_epoch", selected);
  table.add_column("selected_train_NLL", train_nll);
  table.add_column("validation_NLL", validation_nll);
  table.add_column("test_NLL", test_nll);
  table.add_column("test_accuracy", accuracy);
  std::print("Inference device: {}; all inference took {:.1f} s.\n", device_name,
             inference_seconds);
  std::print("{} fit / {} validation / {} official-test rows per configuration.\n\n{}\n", fit,
             held, qx.size(0), table.to_md(4));
  training_plot.title("SqueezeNet: augmented training").x_label("epoch").y_label("mean NLL");
  validation_plot.title("SqueezeNet: validation").x_label("epoch").y_label("mean NLL");
  dm::graphics::RLayout::create(1, 2)
      .add(training_plot)
      .add(validation_plot)
      .size(1100, 470)
      .fit_panels()
      .save_svg("build/squeezenet_training.svg");
}
```
// result_begin: markdown
SqueezeNet v1.0: 2500 Adam updates in 273 s of CPU training.
SqueezeNet v1.0 + bypass: 2500 Adam updates in 75 s of CPU training.
SqueezeNet v1.1: 2500 Adam updates in 28 s of CPU training.
Inference device: CPU (no usable CUDA device in this build); all inference took 55.8 s.
8000 fit / 2000 validation / 10000 official-test rows per configuration.

| configuration | parameters | best_epoch | selected_train_NLL | validation_NLL | test_NLL | test_accuracy |
| :--- | ---: | ---: | ---: | ---: | ---: | ---: |
| v1.0 | 729034 | 10 | 1.4165 | 1.4807 | 1.4752 | 0.4479 |
| v1.0 + bypass | 729034 | 10 | 1.2352 | 1.2976 | 1.3097 | 0.5196 |
| v1.1 | 727626 | 10 | 1.3447 | 1.4005 | 1.4015 | 0.4782 |

\image(figures/squeezenet_training.svg)
// result_end
\caption(Three full-width models share the same CIFAR subsets, warmed-up cosine Adam schedule, ten epochs and checkpoint rule. The graph uses no BN state; inference disables dropout. All eight Fire modules and ceil pools remain present.)
\alttext(Three full-width models share the same CIFAR subsets, warmed-up cosine Adam schedule, ten epochs and checkpoint rule. The graph uses no BN state; inference disables dropout. All eight Fire modules and ceil pools remain present.)


All three configurations leave the chance NLL ln 10 ≈ 2.303 and select their final (tenth)
checkpoint, so none has started to overfit. Test accuracies on all 10,000 official test images
are 46.2% for v1.0, 53.4% with simple bypasses and 47.5% for v1.1 (chance is 10%), with test
NLLs 1.4407/1.2775/1.4138. The cosine schedule has decayed to zero by epoch ten, so the late
flattening of the curves reflects the vanishing step size as well as the model. The bypass gain
matches the motivation for residual shortcuts, but one seed and 2,500 updates do not establish
an architecture ranking. Dropout makes the augmented training trace differ from restored
inference training NLL even though there are no moving BN moments.

> Native confusion matrices

These matrices use the held-out predictions from the executed program above.
The native `ConfusionMatrix` SVG API labels exact counts with true classes
running from top to bottom and predicted classes from left to right.

\image(figures/squeezenet_confusion_api_0.svg)
\caption(Held-out classification confusion counts, evaluation 1. Exact cell counts are printed in the image.)
\alttext(Integer prediction counts with true classes as rows and predicted classes as columns.)

\image(figures/squeezenet_confusion_api_1.svg)
\caption(Held-out classification confusion counts, evaluation 2. Exact cell counts are printed in the image.)
\alttext(Integer prediction counts with true classes as rows and predicted classes as columns.)

\image(figures/squeezenet_confusion_api_2.svg)
\caption(Held-out classification confusion counts, evaluation 3. Exact cell counts are printed in the image.)
\alttext(Integer prediction counts with true classes as rows and predicted classes as columns.)


> Conclusion

Narrow squeeze layers reduce spatial-filter budgets; expand branches, ceil pooling and the
ReLU class-map head define the full released behavior. Exact value/gradient fixtures and visible
Adam loops make those choices and their small-data limitations reviewable.

> References

- [Iandola et al. (2016), SqueezeNet](https://arxiv.org/abs/1602.07360).
- [Authors' release](https://github.com/forresti/SqueezeNet).
- [CIFAR-10 dataset](https://www.cs.toronto.edu/~kriz/cifar.html).
