```{cpp, results="markdown", file="figures/squeezenet_training.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

int main() {
  int rendered_confusions = 0;
  namespace n             = dm::nn;
  auto training_plot      = dm::graphics::RPlot::create(),
       validation_plot    = dm::graphics::RPlot::create();
  int setting             = 0;
  for (auto [version, bypass] :
       std::vector<std::pair<int, bool>>{{10, false}, {10, true}, {11, false}}) {
    n::set_num_threads(2);

    std::filesystem::path cache;
    if (const auto* p = std::getenv("DATAMUNGE_DATA_DIR"))
      cache = p;
    else if (const auto* p = std::getenv("XDG_CACHE_HOME"))
      cache = std::filesystem::path(p) / "datamunge/datasets";
    else
      cache = std::filesystem::path(std::getenv("HOME")) / ".cache/datamunge/datasets";
  dm::datasets::fetch("cifar10", (cache / "cifar10").string());

    const auto raw = n::data::LoadCifar({cache / "cifar10/data_batch_1.bin"}, n::data::Cifar::k10);
    const auto images = n::cast(raw.images, n::DType::Float32) / 255.,
               labels = n::cast(raw.labels, n::DType::Int64);
    const auto tx = n::slice_axis(images, 0, 0, 64), ty = n::slice_axis(labels, 0, 0, 64);
    const auto vx       = 2 * n::slice_axis(images, 0, 64, 128) - 1,
               vy       = n::slice_axis(labels, 0, 64, 128);
    const auto official = n::load_cifar10((cache / "cifar10").string(), "test");
    const auto qx       = 2 * n::slice_axis(official.images, 0, 0, 64) - 1,
               qy       = n::slice_axis(official.labels, 0, 0, 64);
    n::models::SqueezeNetConfig cfg;
    cfg.version       = version;
    cfg.simple_bypass = bypass;
    cfg.cifar_stem    = true;
    cfg.image_size    = 32;
    cfg.classes       = 10;
    n::Generator      dropout_rng(101);
    n::ParameterStore p(17);
    auto              output = [&](const n::Tensor& image, bool training) {
      return n::models::SqueezeNet(p, image, cfg, training, &dropout_rng).logits;
    };
    {
      n::NoGradGuard guard;
      output(n::zeros({1, 32, 32, 3}), false);
    }
    if (p.count() != (version == 10 ? 729034 : 727626))
      return 1;
    n::OptimizerConfig config;
    config.kind = n::OptimizerKind::Adam;
    n::Optimizer  optimizer(p, .0001, config);
    n::BatchOrder batches(64, 8, 2026);
    n::Generator  augmentation(151);
    std::filesystem::create_directories("build");
    const std::string   checkpoint = "build/squeezenet_best";
    double              best       = std::numeric_limits<double>::infinity();
    int                 best_epoch = 0;
    std::vector<double> epochs, train, validation;
    for (int epoch = 1; epoch <= 4; ++epoch) {
      batches.begin_epoch();
      n::WeightedMean average;
      for (auto rows = batches.next(); !rows.empty(); rows = batches.next()) {
        const auto             batch = n::take_rows(tx, rows), target = n::take_rows(ty, rows);
        std::vector<n::Tensor> transformed;
        for (int64_t row = 0; row < batch.size(0); ++row) {
          auto image =
              n::pad(n::slice_axis(batch, 0, row, row + 1), {{0, 0}, {4, 4}, {4, 4}, {0, 0}});
          image = n::augment::random_crop(image, 32, 32, augmentation);
          transformed.push_back(n::augment::random_flip_left_right(image, augmentation));
        }
        const auto nll = n::sparse_softmax_cross_entropy(
            output(2 * n::concat(transformed, 0) - 1, true), target);
        auto objective = nll;
        for (const auto& w : p.parameters())
          if (w.dim() >= 2)
            objective = objective + .00005 * n::sum(n::square(w));
        optimizer.minimize(objective);
        average.add(nll.item(), rows.size());
      }
      n::NoGradGuard guard;
      const double   val = n::sparse_softmax_cross_entropy(output(vx, false), vy).item();
      if (!std::isfinite(val))
        return 1;
      epochs.push_back(epoch);
      train.push_back(average.value());
      validation.push_back(val);
      if (val < best) {
        best       = val;
        best_epoch = epoch;
        p.save(checkpoint + "_params.npz");
      }
    }
    p.load(checkpoint + "_params.npz");
    n::NoGradGuard guard;
    const auto     prediction = output(qx, false);
    const double   test_nll   = n::sparse_softmax_cross_entropy(prediction, qy).item();
    const double   training_nll =
        n::sparse_softmax_cross_entropy(output(2 * tx - 1, false), ty).item();
    if (!std::isfinite(test_nll))
      return 1;
    const auto truth = n::one_hot(qy, 10), predicted = n::one_hot(n::argmax(prediction, 1), 10);
    const auto confusion = n::matmul(n::transpose(truth, {1, 0}), predicted);
    n::ConfusionMatrix::from_counts(confusion.to(n::DType::Int64))
        .save_svg(
            "build/squeezenet_confusion_api_" + std::to_string(rendered_confusions++) + ".svg",
            {.title = "squeezenet / selected-checkpoint test counts"});

    if (n::sum(confusion).item() != 64)
      return 1;
    const std::string label = version == 11 ? "v1.1" : bypass ? "v1.0 + bypass" : "v1.0";
    const std::vector<dm::graphics::RGB> colours = {{37, 99, 235}, {234, 88, 12}, {22, 163, 74}};
    training_plot.lines(epochs, train, label, colours[setting]);
    validation_plot.lines(epochs, validation, label, colours[setting]);
    ++setting;
    std::print("SqueezeNet {}: ", label);
    std::print(
        "64 fit / 64 validation / 64 official-test rows; {} learned scalars; {} "
        "explicit Adam updates.\nSelected epoch {}; validation NLL {:.6f}; "
        "inference training NLL {:.6f}; test NLL {:.6f}; test accuracy {:.6f}.\n",
        p.count(),
        optimizer.iterations(),
        best_epoch,
        best,
        training_nll,
        test_nll,
        n::accuracy(prediction, qy));
  }
  training_plot.title("SqueezeNet: augmented training")
      .x_label("epoch")
      .y_label("mean NLL")
      .y_limits(1.9, 2.6);
  validation_plot.title("SqueezeNet: validation")
      .x_label("epoch")
      .y_label("mean NLL")
      .y_limits(2.1, 2.9);
  dm::graphics::RLayout::create(1, 2)
      .add(training_plot)
      .add(validation_plot)
      .size(1100, 470)
      .fit_panels()
      .save_svg("build/squeezenet_training.svg");
}
```
// result_begin: markdown
SqueezeNet v1.0: 64 fit / 64 validation / 64 official-test rows; 729034 learned scalars; 32 explicit Adam updates.
Selected epoch 1; validation NLL 2.337243; inference training NLL 2.268187; test NLL 2.341897; test accuracy 0.031250.
SqueezeNet v1.0 + bypass: 64 fit / 64 validation / 64 official-test rows; 729034 learned scalars; 32 explicit Adam updates.
Selected epoch 1; validation NLL 2.326770; inference training NLL 2.284855; test NLL 2.324991; test accuracy 0.093750.
SqueezeNet v1.1: 64 fit / 64 validation / 64 official-test rows; 727626 learned scalars; 32 explicit Adam updates.
Selected epoch 1; validation NLL 2.290393; inference training NLL 2.261639; test NLL 2.360393; test accuracy 0.046875.
\image(figures/squeezenet_training.svg)
// result_end
\caption(Three full-width models share the same CIFAR subsets, Adam(.0001), four epochs and checkpoint rule. The graph uses no BN state; inference disables dropout. All eight Fire modules and ceil pools remain present.)
\alttext(Three full-width models share the same CIFAR subsets, Adam(.0001), four epochs and checkpoint rule. The graph uses no BN state; inference disables dropout. All eight Fire modules and ceil pools remain present.)


| Configuration | Selected epoch | Validation NLL | Test NLL | Test accuracy |
|---|---|---|---|---|
| v1.0 | 1 | 2.337243 | 2.341897 | 0.031250 |
| v1.0 + bypass | 1 | 2.326770 | 2.324991 | 0.093750 |
| v1.1 | 1 | 2.290393 | 2.360393 | 0.046875 |

With only 32 small Adam(.0001) steps every model stays near the chance NLL ln 10 ≈ 2.303, and
all three select their first-epoch checkpoint because validation NLL does not improve
afterwards. Runs with four times as many updates, or with rate .001, also stayed at chance
within a 20-second budget; at .001 some models reached NLL exactly ln 10, the dead class-map ReLU
described above. Falling training loss does not establish an architecture benefit; these 64-image
test scores are small-data diagnostics of a working loop, not of accuracy. Dropout makes the augmented training trace differ from
restored inference training NLL even though there are no moving BN moments.

> Native confusion matrices

These matrices use the held-out predictions from the executed program above.
The native `ConfusionMatrix` SVG API labels exact counts with true classes
running from top to bottom and predicted classes from left to right.

