> Simple information-recovery example

The active-coordinate oracle makes the ReLU bottleneck argument visible.

```{cpp, results="markdown", file="figures/mobilenet_v2_manifold.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

int main() {
  namespace n = dm::nn;
  const auto type = n::DType::Float64;
  n::Generator gen(17);
  n::NoGradGuard guard;
  const auto angle = n::arange(0, 400).to(type) * (3 * std::acos(-1.) / 400),
             radius = .2 + angle;
  const auto x = n::stack({radius * n::cos(angle), radius * n::sin(angle)}, 0);
  std::vector<double> dimensions, errors;
  auto layout = dm::graphics::RLayout::create(1, 2);
  for (int width : {2, 3, 5, 15, 30}) {
    double total = 0;
    for (int trial = 0; trial < 20; ++trial) {
      const auto matrix = n::normal({width, 2}, 0, 1, gen, type), z = n::matmul(matrix, x);
      const auto active = n::expand_dims(n::transpose(n::greater(z, 0).to(type), {1, 0}), 2);
      const auto rows = n::expand_dims(matrix, 0) * active,
                 rhs = n::expand_dims(n::transpose(n::relu(z), {1, 0}), 2);
      const auto recovered =
          n::transpose(n::squeeze(n::matrix_solve_ls(rows, rhs, 1e-6), {2}), {1, 0});
      const double error = n::sqrt(n::sum(n::square(recovered - x))).item() /
                           n::sqrt(n::sum(n::square(x))).item();
      if (!std::isfinite(error))
        return 1;
      total += error;
      if (trial == 0 && (width == 2 || width == 30)) {
        auto plot = dm::graphics::RPlot::create();
        plot.lines(n::slice_axis(x, 0, 0, 1).reshape({400}).to_vector<double>(),
                   n::slice_axis(x, 0, 1, 2).reshape({400}).to_vector<double>(), "original",
                   {37, 99, 235})
            .lines(n::slice_axis(recovered, 0, 0, 1).reshape({400}).to_vector<double>(),
                   n::slice_axis(recovered, 0, 1, 2).reshape({400}).to_vector<double>(),
                   "recovered", {234, 88, 12})
            .title("ReLU embedding dimension " + std::to_string(width))
            .x_label("coordinate 1")
            .y_label("coordinate 2")
            .y_limits(-10, 16);
        layout.add(plot);
      }
    }
    dimensions.push_back(width);
    errors.push_back(total / 20);
    std::print(
        "Embedding dimension {}: mean relative reconstruction error {:.9f} over 20 draws.\n",
        width, total / 20);
  }
  if (errors.back() >= errors.front() || errors.back() > .01)
    return 1;
  std::filesystem::create_directories("build");
  layout.size(1100, 470).fit_panels().save_svg("build/mobilenet_v2_manifold.svg");
}
```
