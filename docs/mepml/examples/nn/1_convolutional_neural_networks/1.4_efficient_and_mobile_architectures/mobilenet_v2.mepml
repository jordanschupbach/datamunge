> Complete budgets and gradients

Parameter counts include BN; arithmetic excludes BN and elementwise work.

```{cpp, results="markdown", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

int main() {
  namespace n = dm::nn;
  n::set_num_threads(2);
  for (auto [a, size, count, moving, macs] :
       std::vector<std::tuple<double, int, int64_t, int64_t, int64_t>>{
           {1.4, 224, 6108776, 47936, 582195824},
           {1, 224, 3504872, 34112, 300774272},
           {.75, 224, 2636424, 26640, 209069792},
           {.5, 224, 1968680, 18544, 97131840},
           {.35, 224, 1677128, 14080, 59285808},
           {1, 192, 3504872, 34112, 221316608},
           {1, 160, 3504872, 34112, 154083200},
           {1, 128, 3504872, 34112, 99074048},
           {1, 96, 3504872, 34112, 56289152}}) {
    n::NoGradGuard guard;
    n::ParameterStore p(17), state(17);
    n::models::MobileNetV2Config cfg;
    cfg.alpha = a;
    const auto out = n::models::MobileNetV2(p, state, n::zeros({1, size, size, 3}), cfg);
    if (p.count() != count || state.count() != moving || out.Macs() != macs)
      return 1;
    std::print("alpha {}, resolution {}: {} learned / {} moving scalars, {} MACs/image; "
               "excluding BN affine {} scalars.\n",
               a, size, count, moving, macs, count - moving);
  }
  if (n::models::MakeDivisible(9) != 16 || n::models::MakeDivisible(17) != 16)
    return 1;
  std::print("Channel alignment: 9->16 due to 10% safeguard; 17->16. Final 1280-channel width "
             "does not shrink below alpha one.\n");
}
```
