```{cpp, results="markdown", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

int main() {
  namespace n = dm::nn;
  n::set_num_threads(2);
  {
    n::ParameterStore p(17), state(17);
    n::models::MobileNetV2Config cfg;
    cfg.update_stats = false;
    cfg.keep_probability = 1;
    const auto x = n::sin(.37 * n::arange(0, 2 * 64 * 64 * 3).to(n::DType::Float32))
                       .reshape({2, 64, 64, 3});
    {
      n::NoGradGuard guard;
      n::models::MobileNetV2(p, state, x, cfg, true);
      for (const auto &name : p.names())
        if (name.ends_with("/beta") || false) {
          const auto shape = p.at(name).shape();
          p.set(name,
                (.5 * n::sin(.37 * n::arange(0, p.at(name).numel()).to(n::DType::Float32) +
                             double(name.size())))
                    .reshape(shape));
        }
    }
    const auto out = n::models::MobileNetV2(p, state, x, cfg, true);
    const auto gradients = n::grad(n::mean(n::square(out.logits)), p.parameters());
    double maximum = 0, minimum = std::numeric_limits<double>::infinity(), removed = 0;
    int redundant = 0;
    for (size_t i = 0; i < gradients.size(); ++i) {
      const double norm = n::sqrt(n::sum(n::square(gradients[i]))).item();
      if (!std::isfinite(norm))
        return 1;
      maximum = std::max(maximum, norm);
      if (p.names()[i].ends_with("/project/bn/beta")) {
        ++redundant;
        removed = std::max(removed, norm);
      } else
        minimum = std::min(minimum, norm);
    }
    if (redundant != 17 || removed > 1e-5 * maximum || minimum <= 0)
      return 1;
    std::print(
        "MobileNet-v2: {} finite parameter-tensor gradients; nonredundant minimum {:.9f}, "
        "maximum {:.9f}; {} projection BN shifts removed downstream, max {:.9f}.\n",
        gradients.size(), minimum, maximum, redundant, removed);
  }
}
```
// result_begin: markdown
MobileNet-v2: 158 finite parameter-tensor gradients; nonredundant minimum 0.002606923, maximum 16.137609482; 17 projection BN shifts removed downstream, max 0.000000379.
// result_end

> Dataset and visible fitting

Original pixels precede the complete optimizer loop.

```{cpp, results="markdown", file="figures/mobilenet_v2_inputs.png", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

int main() {
  namespace n = dm::nn;

  std::filesystem::path cache;
  if (const auto *p = std::getenv("DATAMUNGE_DATA_DIR"))
    cache = p;
  else if (const auto *p = std::getenv("XDG_CACHE_HOME"))
    cache = std::filesystem::path(p) / "datamunge/datasets";
  else
    cache = std::filesystem::path(std::getenv("HOME")) / ".cache/datamunge/datasets";
  dm::datasets::fetch("cifar10", (cache / "cifar10").string());

  const auto raw =
      n::data::LoadCifar({cache / "cifar10/data_batch_1.bin"}, n::data::Cifar::k10);
  const auto images = n::cast(raw.images, n::DType::Float32) / 255.;
  const auto labels = raw.labels;

  std::vector<int64_t> rows;
  for (int cls = 0; cls < 10; ++cls) {
    for (int64_t row = 0; row < labels.numel(); ++row)
      if (labels.at({row}) == cls) {
        rows.push_back(row);
        break;
      }
  }
  if (rows.size() != 10)
    return 1;
  std::filesystem::create_directories("build");
  n::save_image_grid(n::take_rows(images, rows), "build/mobilenet_v2_inputs.png", 5, 0., 1., 4,
                     1., 4);
  std::print("One original cached training image per class, IDs 0..4 then 5..9.\n");
}
```
