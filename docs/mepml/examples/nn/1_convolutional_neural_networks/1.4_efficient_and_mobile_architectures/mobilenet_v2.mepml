> Signed bottleneck and strided projection

A zero correction preserves negative inputs exactly.

```{cpp, results="markdown", file="figures/mobilenet_v2_identity.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

int main() {
  namespace n = dm::nn;
  const auto type = n::DType::Float64;
  n::ParameterStore p(17, type), state(17, type);
  std::vector<n::models::MobileLayer> layers;
  n::models::MobileContext c{p, state, layers, false};
  const auto x = n::linspace(-1, 1, 256, type).reshape({1, 8, 8, 4}).detach().requires_grad_();
  {
    n::NoGradGuard guard;
    n::models::InvertedResidual(c, "b", x, 4, 6, 1);
  }
  p.set("b/project/bn/gamma", n::zeros({4}, type));
  p.set("b/project/bn/beta", n::zeros({4}, type));
  const auto out = n::models::InvertedResidual(c, "b", x, 4, 6, 1);
  const auto weights = n::linspace(.1, 1, 256, type).reshape(x.shape()),
             dx = n::grad(n::sum(out.output * weights), {x})[0];
  if (n::max(n::abs(out.output - x)).item() != 0 || n::max(n::abs(dx - weights)).item() != 0 ||
      out.expanded.size(3) != 24)
    return 1;
  const auto down = n::models::InvertedResidual(c, "down", x, 6, 6, 2);
  if (down.filtered.shape() != n::Shape{1, 4, 4, 24} ||
      down.output.shape() != n::Shape{1, 4, 4, 6})
    return 1;
  auto first = [](const auto &t) {
    return n::slice_axis(t, 3, 0, 1).reshape({8, 8});
  };
  auto layout = dm::graphics::RLayout::create(1, 2);
  layout.add(n::plot_tensor_map(first(x), -1, 1).title("Signed narrow input"))
      .add(n::plot_tensor_map(first(out.output), -1, 1)
               .title("Zero projection: signed identity"));
  std::filesystem::create_directories("build");
  layout.size(1100, 470).fit_panels().save_svg("build/mobilenet_v2_identity.svg");
  std::print(
      "Expansion 4->24; linear projection 24->4; exact signed identity and weighted input "
      "derivatives. Stride-two 8x8->4x4, output width six, has no shortcut addition.\n");
}
```
