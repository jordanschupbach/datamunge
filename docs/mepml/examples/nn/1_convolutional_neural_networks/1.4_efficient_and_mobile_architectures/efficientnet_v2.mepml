> All full-weight models and exact target budgets

```{cpp, results="markdown", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

int64_t target_macs(const dm::nn::models::MobileNetOutputs &out, int resolution) {
  int64_t total = out.classifier_macs;
  for (const auto &l : out.layers) {
    if (l.name.find("/se") != std::string::npos)
      total += l.Macs();
    else {
      if (l.shape[1] < 1 || 64 % l.shape[1] || 64 % l.shape[2])
        throw std::runtime_error("invalid power-of-two geometry");
      const int64_t hdiv = 64 / l.shape[1], wdiv = 64 / l.shape[2];
      total += ((resolution + hdiv - 1) / hdiv) * ((resolution + wdiv - 1) / wdiv) *
               l.macs_per_position;
    }
  }
  return total;
}

int main() {
  namespace n = dm::nn;
  n::set_num_threads(2);
  struct Case {
    const char *name;
    int64_t params, state, macs;
    int blocks;
  };
  for (const auto &expected : std::vector<Case>{{"s", 21458488, 153872, 8365617152, 40},
                                                {"m", 54139356, 292032, 24582460384, 57},
                                                {"l", 118515272, 512576, 56079699008, 79},
                                                {"b0", 7139704, 60608, 718086176, 21},
                                                {"b1", 8141052, 71072, 1196819360, 27},
                                                {"b2", 10096086, 82288, 1697542832, 28},
                                                {"b3", 14377062, 109312, 3213058816, 32}}) {
    n::NoGradGuard guard;
    n::ParameterStore p(17), state(17);
    n::models::EfficientNetV2Config cfg;
    cfg.variant = expected.name;
    const auto spec = n::models::EfficientNetV2Spec(cfg.variant);
    const auto out = n::models::EfficientNetV2(p, state, n::zeros({1, 64, 64, 3}), cfg);
    const int64_t macs = target_macs(out, spec.resolution);
    int blocks = 0, fused = 0;
    for (const auto &b : n::models::EfficientNetV2Blocks(spec)) {
      blocks += b.repeats;
      fused += b.fused ? b.repeats : 0;
    }
    if (p.count() != expected.params || state.count() != expected.state ||
        macs != expected.macs || blocks != expected.blocks)
      return 1;
    if (cfg.variant == "b0" &&
        n::models::EfficientNetV2(p, state, n::zeros({1, 224, 224, 3}), cfg).Macs() != macs)
      return 1;
    std::print("V2-{}: {} blocks ({} fused), {} learned / {} moving scalars; exact {}-pixel "
               "target budget {} MACs.\n",
               cfg.variant, blocks, fused, p.count(), state.count(), spec.resolution, macs);
  }
  std::print("All seven full-weight networks execute at 64 pixels for counts. SAME target "
             "geometry uses ceil(resolution/downsampling_divisor), with pooled SE and "
             "classifier costs fixed. B0 additionally executes at 224 pixels. Large "
             "full-resolution forwards/timings are not claimed.\n");
}
```
