> Fused and depthwise block arithmetic

```{cpp, results="markdown", file="figures/efficientnet_v2_fused.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

int main() {
  namespace n = dm::nn;
  n::set_num_threads(2);
  std::vector<double> index, params, macs;
  auto layout = dm::graphics::RLayout::create(1, 2);
  for (bool fused : {false, true}) {
    n::ParameterStore p(17), state(17);
    std::vector<n::models::MobileLayer> layers;
    n::models::MobileContext c{p, state, layers, false};
    auto b = n::models::DecodeBlock("r1_k3_s2_e4_i24_o48_c1");
    b.fused = fused;
    n::NoGradGuard guard;
    const auto x = n::sin(.13 * n::arange(0, 96 * 96 * 24).to(n::DType::Float32))
                       .reshape({1, 96, 96, 24});
    const auto out = n::models::MBConv(c, "block", x, 48, b, 2, true);
    n::models::MobileNetOutputs net;
    net.layers = layers;
    if (net.Macs() != (fused ? 58392576 : 33841152) || p.count() != (fused ? 25632 : 8256) ||
        out.output.shape() != n::Shape{1, 48, 48, 48})
      return 1;
    const auto map = n::slice_axis(out.output, 3, 0, 1).reshape({48, 48});
    layout.add(n::plot_tensor_map(map, n::min(map).item(), n::max(map).item())
                   .title(fused ? "Fused dense 3x3 expansion"
                                : "Pointwise plus depthwise expansion"));
    std::print("Fused={}: {} parameters, {} measured MACs, {} convolutions. These are "
               "different learned functions.\n",
               fused, p.count(), net.Macs(), layers.size());
  }
  std::filesystem::create_directories("build");
  layout.size(1100, 470).fit_panels().save_svg("build/efficientnet_v2_fused.svg");
}
```
