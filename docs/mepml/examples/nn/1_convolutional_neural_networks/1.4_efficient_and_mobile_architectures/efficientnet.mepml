> Released scaling metadata

```{cpp, results="markdown", file="figures/efficientnet_scaling.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

int main() {
  namespace n = dm::nn;
  std::vector<double> variants, width, depth, resolution;
  for (int v = 0; v < 8; ++v) {
    const auto s = n::models::EfficientNetCoefficients(v);
    int blocks = 0;
    for (const auto &b : n::models::EfficientNetBlocks(v))
      blocks += b.repeats;
    variants.push_back(v);
    width.push_back(s.width);
    depth.push_back(s.depth);
    resolution.push_back(s.resolution);
    std::print("B{}: width {}, depth {}, resolution {}, dropout {}, {} blocks, head {}.\n", v,
               s.width, s.depth, s.resolution, s.dropout, blocks,
               n::models::RoundFilters(1280, s.width));
  }
  auto multiplier = dm::graphics::RPlot::create(), side = dm::graphics::RPlot::create();
  multiplier.lines(variants, width, "width", {37, 99, 235})
      .lines(variants, depth, "depth", {234, 88, 12})
      .title("Released compound coefficients")
      .x_label("B variant index")
      .y_label("multiplier")
      .y_limits(0, 4);
  side.lines(variants, resolution, "input side", {147, 51, 234})
      .title("Reference resolution metadata")
      .x_label("B variant index")
      .y_label("pixels")
      .y_limits(0, 800);
  std::filesystem::create_directories("build");
  dm::graphics::RLayout::create(1, 2)
      .add(multiplier)
      .add(side)
      .size(1100, 470)
      .fit_panels()
      .save_svg("build/efficientnet_scaling.svg");
}
```
