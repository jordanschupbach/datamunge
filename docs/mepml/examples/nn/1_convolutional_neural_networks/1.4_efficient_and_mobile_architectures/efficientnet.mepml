> Full weights and exact target budgets

```{cpp, results="markdown", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

int64_t target_macs(const dm::nn::models::MobileNetOutputs &out, int resolution) {
  int64_t total = out.classifier_macs;
  for (const auto &l : out.layers) {
    if (l.name.find("/se") != std::string::npos)
      total += l.Macs();
    else {
      if (l.shape[1] < 1 || 64 % l.shape[1] || 64 % l.shape[2])
        throw std::runtime_error("invalid power-of-two geometry");
      const int64_t hdiv = 64 / l.shape[1], wdiv = 64 / l.shape[2];
      total += ((resolution + hdiv - 1) / hdiv) * ((resolution + wdiv - 1) / wdiv) *
               l.macs_per_position;
    }
  }
  return total;
}

int main() {
  namespace n = dm::nn;
  n::set_num_threads(2);
  struct Case {
    int64_t params, state, macs;
    int blocks, head;
  };
  const Case cases[] = {
      {5288548, 42016, 385814752, 16, 1280},     {7794184, 62048, 686802832, 23, 1280},
      {9109994, 67568, 993561872, 23, 1408},     {12233232, 87296, 1827141392, 26, 1536},
      {19341616, 125200, 4393771024, 32, 1792},  {30389784, 172736, 10266384752, 39, 2048},
      {43040704, 224432, 19067593536, 45, 2304}, {66347960, 310720, 37745884192, 55, 2560}};
  for (int v = 0; v < 8; ++v) {
    n::NoGradGuard guard;
    n::ParameterStore p(17), state(17);
    n::models::EfficientNetConfig cfg;
    cfg.variant = v;
    const auto out = n::models::EfficientNet(p, state, n::zeros({1, 64, 64, 3}), cfg);
    const auto scale = n::models::EfficientNetCoefficients(v);
    const int64_t macs = target_macs(out, scale.resolution);
    int blocks = 0;
    for (const auto &b : n::models::EfficientNetBlocks(v))
      blocks += b.repeats;
    const auto expected = cases[v];
    if (p.count() != expected.params || state.count() != expected.state ||
        macs != expected.macs || blocks != expected.blocks ||
        out.features.size(3) != expected.head)
      return 1;
    if (v == 0 &&
        n::models::EfficientNet(p, state, n::zeros({1, 224, 224, 3}), cfg).Macs() != macs)
      return 1;
    std::print("B{}: {} blocks, {} learned / {} moving scalars; exact {}-pixel target budget "
               "{} MACs.\n",
               v, blocks, p.count(), state.count(), scale.resolution, macs);
  }
  std::print("All eight full-weight networks execute at 64 pixels for counts. Target MACs use "
             "ceil(resolution/downsampling_divisor) at each SAME-padded map; pooled "
             "SE/classifier stay fixed. B0 also executes at actual 224 pixels to cross-check. "
             "Large target-resolution forwards are not claimed.\n");
}
```
