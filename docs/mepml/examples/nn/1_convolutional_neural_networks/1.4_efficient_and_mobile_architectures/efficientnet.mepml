> Residual masks and derivatives

```{cpp, results="markdown", file="figures/efficientnet_dropconnect.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

int main() {
  namespace n = dm::nn;
  n::Generator gen(77);
  const auto type = n::DType::Float64;
  const auto branch = n::ones({512, 2, 2, 3}, type).requires_grad_();
  const auto out = n::models::DropConnect(branch, .8, gen),
             dx = n::grad(n::sum(out), {branch})[0];
  if (n::max(n::abs(out - dx)).item() != 0)
    return 1;
  const auto rows = out.reshape({512, 12});
  if (n::max(n::abs(rows - n::slice_axis(rows, 1, 0, 1))).item() != 0)
    return 1;
  const int kept = n::count_nonzero(n::slice_axis(rows, 1, 0, 1)).item<int64_t>();
  if (std::abs(kept / 512. - .8) > .06)
    return 1;
  for (double p : {0., 1.})
    if (n::max(n::abs(n::models::DropConnect(branch, p, gen) - p)).item() != 0)
      return 1;
  auto curve = dm::graphics::RPlot::create();
  curve
      .lines(n::arange(0, 64).to_vector<double>(),
             n::slice_axis(n::slice_axis(rows, 0, 0, 64), 1, 0, 1)
                 .reshape({64})
                 .to_vector<double>(),
             "row multiplier", {37, 99, 235})
      .title("First 64 row masks, survival .8")
      .x_label("example index")
      .y_label("forward and derivative multiplier")
      .y_limits(0, 1.7);
  std::filesystem::create_directories("build");
  curve.save_svg("build/efficientnet_dropconnect.svg");
  std::print("{} of 512 rows retained; every element and input derivative in a row is either "
             "zero or 1.25. Endpoints zero/one avoid division and consume no randomness.\n",
             kept);
}
```
