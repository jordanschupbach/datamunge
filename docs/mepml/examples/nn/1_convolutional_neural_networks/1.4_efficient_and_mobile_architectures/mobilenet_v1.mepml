> Full arithmetic budgets

Output shapes determine MAC counts and layer-type shares.

```{cpp, results="markdown", file="figures/mobilenet_v1_budget.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

int main() {
  namespace n = dm::nn;
  n::set_num_threads(2);
  std::vector<double> alpha, parameters, work;
  for (auto [a, size, count, moving, macs] :
       std::vector<std::tuple<double, int, int64_t, int64_t, int64_t>>{
           {1, 224, 4231976, 21888, 568740352},
           {.75, 224, 2585560, 16416, 325400448},
           {.5, 224, 1331592, 10944, 149497088},
           {.25, 224, 470072, 5472, 41030272},
           {1, 192, 4231976, 21888, 418121728},
           {1, 160, 4231976, 21888, 290675200},
           {1, 128, 4231976, 21888, 186400768}}) {
    n::NoGradGuard guard;
    n::ParameterStore p(17), state(17);
    n::models::MobileNetV1Config cfg;
    cfg.alpha = a;
    const auto out = n::models::MobileNetV1(p, state, n::zeros({1, size, size, 3}), cfg);
    if (p.count() != count || state.count() != moving || out.Macs() != macs ||
        out.layers.size() != 27)
      return 1;
    std::print("alpha {}, resolution {}: {} learned / {} moving scalars, {} MACs/image.\n", a,
               size, count, moving, macs);
    if (size == 224) {
      alpha.push_back(a);
      parameters.push_back(double(count) / 1e6);
      work.push_back(double(macs) / 1e6);
    }
    if (a == 1 && size == 224) {
      std::map<std::string, int64_t> weights, ops;
      for (const auto &l : out.layers) {
        const std::string kind = l.name == "conv0" ? "stem 3x3"
                                 : l.name.find("depthwise") != std::string::npos
                                     ? "depthwise 3x3"
                                     : "pointwise 1x1";
        weights[kind] += p.at(l.name + "/W").numel();
        ops[kind] += l.Macs();
      }
      weights["classifier"] = p.at("output/W").numel();
      ops["classifier"] = out.classifier_macs;
      int64_t total = 0;
      for (const auto &[kind, value] : weights)
        total += value;
      for (const auto &[kind, value] : ops)
        std::print("{}: {:.2f}% MACs, {:.2f}% kernel weights.\n", kind,
                   100. * value / out.Macs(), 100. * weights[kind] / total);
    }
  }
  {
    n::NoGradGuard guard;
    n::ParameterStore p(17), state(17);
    n::models::MobileNetV1Config cfg;
    cfg.full_convolutions = true;
    const auto out = n::models::MobileNetV1(p, state, n::zeros({1, 224, 224, 3}), cfg);
    if (p.count() != 29294088 || out.Macs() - out.classifier_macs != 4866269184)
      return 1;
    std::print("Dense 3x3 baseline: {} learned scalars; {} convolution-only MACs.\n",
               p.count(), out.Macs() - out.classifier_macs);
  }
  auto count = dm::graphics::RPlot::create(), mac = dm::graphics::RPlot::create();
  count.lines(alpha, parameters, "learned", {37, 99, 235})
      .title("MobileNet-v1 at 224 pixels")
      .x_label("width multiplier alpha")
      .y_label("million learned scalars")
      .y_limits(0, 5.5);
  mac.lines(alpha, work, "kernel MACs", {234, 88, 12})
      .title("Measured-shape arithmetic budget")
      .x_label("width multiplier alpha")
      .y_label("million MACs per image")
      .y_limits(0, 750);
  std::filesystem::create_directories("build");
  dm::graphics::RLayout::create(1, 2)
      .add(count)
      .add(mac)
      .size(1100, 470)
      .fit_panels()
      .save_svg("build/mobilenet_v1_budget.svg");
}
```
