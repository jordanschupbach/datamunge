> Simple factorization example

A linear fixture isolates the separable kernel constraint before nonlinear model blocks.

```{cpp, results="markdown", file="figures/mobilenet_v1_separable.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

int main() {
  namespace n = dm::nn;
  const auto type = n::DType::Float64;
  const auto
      x = n::linspace(-1, 1, 98, type).reshape({1, 7, 7, 2}).detach().requires_grad_(),
      d = n::linspace(.01, .18, 18, type).reshape({3, 3, 2, 1}).detach().requires_grad_(),
      p = n::linspace(-.2, .3, 6, type).reshape({1, 1, 2, 3}).detach().requires_grad_();
  const auto same = n::conv_options(1, n::Padding::Same),
             valid = n::conv_options(1, n::Padding::Valid);
  const auto separated = n::conv2d(n::depthwise_conv2d(x, d, same), p, valid),
             dense = n::conv2d(x, n::compose_separable_kernel(d, p), same);
  const auto ga = n::grad(n::mean(n::square(separated)), {x, d, p}),
             gb = n::grad(n::mean(n::square(dense)), {x, d, p});
  double error = n::max(n::abs(separated - dense)).item();
  for (size_t i = 0; i < ga.size(); ++i)
    error = std::max(error, n::max(n::abs(ga[i] - gb[i])).item());
  if (error > 1e-12)
    return 1;
  auto channel = [](const auto &t) {
    return n::slice_axis(t, 3, 0, 1).reshape({7, 7});
  };
  const double low = std::min(n::min(separated).item(), n::min(dense).item()),
               high = std::max(n::max(separated).item(), n::max(dense).item());
  std::vector<double> outputs, ratio;
  for (int c = 2; c <= 128; ++c) {
    outputs.push_back(c);
    ratio.push_back(1. / c + 1. / 9);
  }
  auto budget = dm::graphics::RPlot::create();
  budget.lines(outputs, ratio, "K=3", {37, 99, 235})
      .title("Separable / dense kernel MAC ratio")
      .x_label("output channels")
      .y_label("1/Cout + 1/9")
      .y_limits(0, 1.1);
  auto layout = dm::graphics::RLayout::create(2, 2);
  layout.add(n::plot_tensor_map(channel(x), -1, 1).title("Input: first channel"))
      .add(budget)
      .add(n::plot_tensor_map(channel(separated), low, high)
               .title("Linear depthwise then pointwise"))
      .add(n::plot_tensor_map(channel(dense), low, high)
               .title("Equivalent constrained dense filter"));
  std::filesystem::create_directories("build");
  layout.size(1100, 920).fit_panels().save_svg("build/mobilenet_v1_separable.svg");
  std::print("Linear two-filter fixture: output/input/filter derivatives agree to {:.12f}; 24 "
             "separated versus 54 dense kernel scalars. BN/ReLU6 in a real block prevents "
             "this single-linear-filter collapse.\n",
             error);
}
```
// result_begin: markdown
Linear two-filter fixture: output/input/filter derivatives agree to 0.000000000000; 24 separated versus 54 dense kernel scalars. BN/ReLU6 in a real block prevents this single-linear-filter collapse.
\image(figures/mobilenet_v1_separable.svg)
// result_end
\caption(The no-BN/no-activation fixture isolates factorization and compares all input/filter derivatives. Output maps share a colour range. Real MobileNet-v1 pairs normalize and activate after each filter, so their complete functions are not a single dense linear convolution.)
