```{cpp, results="markdown", file="figures/mobilenet_v1_training.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

int main() {
  int rendered_confusions = 0;
  namespace n             = dm::nn;
  auto training_plot      = dm::graphics::RPlot::create(),
       validation_plot    = dm::graphics::RPlot::create();
  int setting             = 0;
  for (double alpha : std::vector<double>{1., .5}) {
    n::set_num_threads(2);

    std::filesystem::path cache;
    if (const auto* p = std::getenv("DATAMUNGE_DATA_DIR"))
      cache = p;
    else if (const auto* p = std::getenv("XDG_CACHE_HOME"))
      cache = std::filesystem::path(p) / "datamunge/datasets";
    else
      cache = std::filesystem::path(std::getenv("HOME")) / ".cache/datamunge/datasets";
  dm::datasets::fetch("cifar10", (cache / "cifar10").string());

    const auto raw = n::data::LoadCifar({cache / "cifar10/data_batch_1.bin"}, n::data::Cifar::k10);
    const auto images = n::cast(raw.images, n::DType::Float32) / 255.,
               labels = n::cast(raw.labels, n::DType::Int64);
    const auto tx = n::slice_axis(images, 0, 0, 64), ty = n::slice_axis(labels, 0, 0, 64);
    const auto vx       = 2 * n::slice_axis(images, 0, 64, 128) - 1,
               vy       = n::slice_axis(labels, 0, 64, 128);
    const auto official = n::load_cifar10((cache / "cifar10").string(), "test");
    const auto qx       = 2 * n::slice_axis(official.images, 0, 0, 64) - 1,
               qy       = n::slice_axis(official.labels, 0, 0, 64);
    n::models::MobileNetV1Config cfg;
    cfg.small_stem = true;
    cfg.classes    = 10;
    cfg.alpha      = alpha;
    n::ParameterStore p(17), state(17);
    auto              output = [&](const n::Tensor& image, bool training) {
      return n::models::MobileNetV1(p, state, image, cfg, training).logits;
    };
    {
      n::NoGradGuard guard;
      output(n::zeros({1, 32, 32, 3}), false);
    }
    if (p.count() != (alpha == 1 ? 3217226 : 823722) ||
        state.count() != (alpha == 1 ? 21888 : 10944))
      return 1;
    n::OptimizerConfig config;
    config.kind = n::OptimizerKind::Adam;
    n::Optimizer  optimizer(p, .001, config);
    n::BatchOrder batches(64, 8, 2026);
    n::Generator  augmentation(151);
    std::filesystem::create_directories("build");
    const std::string   checkpoint = "build/mobilenet_v1_best";
    double              best       = std::numeric_limits<double>::infinity();
    int                 best_epoch = 0;
    std::vector<double> epochs, train, validation;
    for (int epoch = 1; epoch <= 8; ++epoch) {
      batches.begin_epoch();
      n::WeightedMean average;
      for (auto rows = batches.next(); !rows.empty(); rows = batches.next()) {
        const auto             batch = n::take_rows(tx, rows), target = n::take_rows(ty, rows);
        std::vector<n::Tensor> transformed;
        for (int64_t row = 0; row < batch.size(0); ++row) {
          auto image =
              n::pad(n::slice_axis(batch, 0, row, row + 1), {{0, 0}, {4, 4}, {4, 4}, {0, 0}});
          image = n::augment::random_crop(image, 32, 32, augmentation);
          transformed.push_back(n::augment::random_flip_left_right(image, augmentation));
        }
        const auto nll = n::sparse_softmax_cross_entropy(
            output(2 * n::concat(transformed, 0) - 1, true), target);
        auto objective = nll;
        for (const auto& w : p.parameters())
          if (w.dim() >= 2)
            objective = objective + .00005 * n::sum(n::square(w));
        optimizer.minimize(objective);
        average.add(nll.item(), rows.size());
      }
      n::NoGradGuard guard;
      const double   val = n::sparse_softmax_cross_entropy(output(vx, false), vy).item();
      if (!std::isfinite(val))
        return 1;
      epochs.push_back(epoch);
      train.push_back(average.value());
      validation.push_back(val);
      if (val < best) {
        best       = val;
        best_epoch = epoch;
        p.save(checkpoint + "_params.npz");
        state.save(checkpoint + "_state.npz");
      }
    }
    p.load(checkpoint + "_params.npz");
    state.load(checkpoint + "_state.npz");
    n::NoGradGuard guard;
    const auto     prediction = output(qx, false);
    const double   test_nll   = n::sparse_softmax_cross_entropy(prediction, qy).item();
    const double   training_nll =
        n::sparse_softmax_cross_entropy(output(2 * tx - 1, false), ty).item();
    if (!std::isfinite(test_nll))
      return 1;
    const auto truth = n::one_hot(qy, 10), predicted = n::one_hot(n::argmax(prediction, 1), 10);
    const auto confusion = n::matmul(n::transpose(truth, {1, 0}), predicted);
    n::ConfusionMatrix::from_counts(confusion.to(n::DType::Int64))
        .save_svg(
            "build/mobilenet_v1_confusion_api_" + std::to_string(rendered_confusions++) + ".svg",
            {.title = "mobilenet v1 / selected-checkpoint test counts"});

    if (n::sum(confusion).item() != 64)
      return 1;
    const std::string                    label   = alpha == 1 ? "alpha 1" : "alpha .5";
    const std::vector<dm::graphics::RGB> colours = {{37, 99, 235}, {234, 88, 12}, {22, 163, 74}};
    training_plot.lines(epochs, train, label, colours[setting]);
    validation_plot.lines(epochs, validation, label, colours[setting]);
    ++setting;
    std::print("MobileNet-v1 alpha {}: ", alpha);
    std::print(
        "64 fit / 64 validation / 64 official-test rows; {} learned scalars, {} moving "
        "scalars; {} explicit Adam updates.\nSelected epoch {}; validation NLL {:.6f}; "
        "inference training NLL {:.6f}; test NLL {:.6f}; test accuracy {:.6f}.\n",
        p.count(),
        state.count(),
        optimizer.iterations(),
        best_epoch,
        best,
        training_nll,
        test_nll,
        n::accuracy(prediction, qy));
  }
  training_plot.title("MobileNet-v1: training").x_label("epoch").y_label("mean NLL");
  validation_plot.title("MobileNet-v1: validation").x_label("epoch").y_label("mean NLL");
  dm::graphics::RLayout::create(1, 2)
      .add(training_plot)
      .add(validation_plot)
      .size(1100, 470)
      .fit_panels()
      .save_svg("build/mobilenet_v1_training.svg");
}
```
// result_begin: markdown
MobileNet-v1 alpha 1: 64 fit / 64 validation / 64 official-test rows; 3217226 learned scalars, 21888 moving scalars; 64 explicit Adam updates.
Selected epoch 1; validation NLL 2.386431; inference training NLL 2.372851; test NLL 2.305152; test accuracy 0.125000.
MobileNet-v1 alpha 0.5: 64 fit / 64 validation / 64 official-test rows; 823722 learned scalars, 10944 moving scalars; 64 explicit Adam updates.
Selected epoch 1; validation NLL 2.338466; inference training NLL 2.261600; test NLL 2.352937; test accuracy 0.031250.
\image(figures/mobilenet_v1_training.svg)
// result_end
\caption(The two width multipliers share fixed CIFAR subsets, eight epochs, batch size and checkpoint rules. Moving BN state is restored alongside weights before scoring.)
\alttext(The two width multipliers share fixed CIFAR subsets, eight epochs, batch size and checkpoint rules. Moving BN state is restored alongside weights before scoring.)


Both fits select epoch 1 (alpha one: validation NLL 2.386431, test NLL 2.305152, 8/64
correct; alpha .5: validation NLL 2.338466, test NLL 2.352937, 2/64 correct). After 64
updates neither network has learned: validation NLL rises above the chance level
ln 10 ≈ 2.303 after the first epoch, and test accuracy (12.5% and 3.1%) is near the 10% of guessing.
Runs with 128 fit images and twelve epochs (15 seconds) were still at chance, so the loop
is kept short and demonstrates the paired fitting and checkpointing, not accuracy. These
runs do not establish a width ranking; the traces also show substantial variability in batch/moving BN moments.

> Native confusion matrices

These matrices use the held-out predictions from the executed program above.
The native `ConfusionMatrix` SVG API labels exact counts with true classes
running from top to bottom and predicted classes from left to right.

\image(figures/mobilenet_v1_confusion_api_0.svg)
\caption(Held-out classification confusion counts, evaluation 1. Exact cell counts are printed in the image.)
\alttext(Integer prediction counts with true classes as rows and predicted classes as columns.)

\image(figures/mobilenet_v1_confusion_api_1.svg)
\caption(Held-out classification confusion counts, evaluation 2. Exact cell counts are printed in the image.)
\alttext(Integer prediction counts with true classes as rows and predicted classes as columns.)


> Conclusion

Separable connectivity reduces spatial-filter cost while leaving pointwise mixing dominant.
Exact factorization/gradient checks and measured full-model budgets explain that tradeoff; the
visible paired optimizer shows how width choices become complete trainable tensor classifiers.

> References

- [Howard et al. (2017), MobileNets](https://arxiv.org/abs/1704.04861).
- [TensorFlow original v1 release](https://github.com/tensorflow/models/blob/master/research/slim/nets/mobilenet_v1.py).
- [CIFAR-10 dataset](https://www.cs.toronto.edu/~kriz/cifar.html).
