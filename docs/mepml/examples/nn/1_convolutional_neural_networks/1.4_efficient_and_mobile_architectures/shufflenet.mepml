> Simple channel mixing example

The derivative coefficients expose group connectivity exactly.

```{cpp, results="markdown", file="figures/shufflenet_channels.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

int main() {
  namespace n = dm::nn;
  const int channels = 12, groups = 3;
  const auto x = n::arange(0, channels)
                     .to(n::DType::Float64)
                     .reshape({1, 1, 1, channels})
                     .detach()
                     .requires_grad_();
  const auto release = n::models::ChannelShuffle(x, channels, groups),
             paper = n::models::PaperChannelShuffle(x, channels, groups);
  if (n::max(n::abs(n::models::ChannelShuffle(paper, channels, groups) - x)).item() != 0)
    return 1;
  for (int c = 0; c < channels; ++c)
    if (release.at({0, 0, 0, (c % groups) * (channels / groups) + c / groups}) != c ||
        paper.at({0, 0, 0, (c % (channels / groups)) * groups + c / (channels / groups)}) != c)
      return 1;
  const auto weights = n::arange(1, 13).to(n::DType::Float64).reshape(x.shape());
  const auto gradient = n::grad(n::sum(release * weights), {x})[0];
  for (int c = 0; c < channels; ++c)
    if (gradient.at({0, 0, 0, c}) != weights.at({0, 0, 0, (c % groups) * 4 + c / groups}))
      return 1;
  n::ParameterStore p(17, n::DType::Float64);
  n::ConvLayerOptions opts;
  opts.bias = false;
  auto build = [&](bool permute) {
    auto h = n::models::GroupedConv2D(p, "first", x, 12, 1, 3, opts);
    if (permute)
      h = n::models::ChannelShuffle(h, 12, 3);
    return n::models::GroupedConv2D(p, "second", h, 12, 1, 3, opts);
  };
  {
    n::NoGradGuard guard;
    build(false);
  }
  for (const auto &name : p.names())
    p.set(name, n::ones_like(p.at(name)));
  std::vector<n::Tensor> derivatives;
  for (bool permute : {false, true})
    derivatives.push_back(n::grad(n::sum(n::slice_axis(build(permute), 3, 0, 1)), {x})[0]);
  for (int c = 0; c < 12; ++c) {
    if (derivatives[0].at({0, 0, 0, c}) != (c < 4 ? 4 : 0) ||
        derivatives[1].at({0, 0, 0, c}) != (c < 4 ? 2 : 1))
      return 1;
  }
  auto order = dm::graphics::RPlot::create(), support = dm::graphics::RPlot::create();
  const auto index = n::arange(0, 12).to_vector<double>();
  order.lines(index, release.reshape({12}).to_vector<double>(), "release", {37, 99, 235})
      .lines(index, paper.reshape({12}).to_vector<double>(), "paper", {234, 88, 12})
      .title("Two inverse channel permutations")
      .x_label("output position")
      .y_label("original channel ID")
      .y_limits(0, 15);
  support
      .lines(index, derivatives[0].reshape({12}).to_vector<double>(), "no shuffle",
             {37, 99, 235})
      .lines(index, derivatives[1].reshape({12}).to_vector<double>(), "release shuffle",
             {234, 88, 12})
      .title("Output-zero derivative through two groups")
      .x_label("input channel")
      .y_label("derivative coefficient")
      .y_limits(0, 6);
  std::filesystem::create_directories("build");
  dm::graphics::RLayout::create(1, 2)
      .add(order)
      .add(support)
      .size(1100, 470)
      .fit_panels()
      .save_svg("build/shufflenet_channels.svg");
  std::print("Both 12-channel/3-group orders and inverse composition verified, including "
             "weighted permutation derivatives. Two all-one grouped filters: without shuffle "
             "four inputs have coefficient four; with shuffle all twelve contribute (first "
             "group coefficient two, others one).\n");
}
```
// result_begin: markdown
Both 12-channel/3-group orders and inverse composition verified, including weighted permutation derivatives. Two all-one grouped filters: without shuffle four inputs have coefficient four; with shuffle all twelve contribute (first group coefficient two, others one).
\image(figures/shufflenet_channels.svg)
// result_end
\caption(The release moves input c to (c mod g)*(C/g)+floor(c/g); the paper uses the inverse permutation. Both mix groups. The all-one linear fixture avoids accidental zero coefficients and verifies exact derivative connectivity, not learned accuracy.)
\alttext(The release moves input c to (c mod g)*(C/g)+floor(c/g); the paper uses the inverse permutation. Both mix groups. The all-one linear fixture avoids accidental zero coefficients and verifies exact derivative connectivity, not learned accuracy.)

> Unit shortcuts and pooling

Raw even channels and padded mean windows are checked separately.

```{cpp, results="markdown", file="figures/shufflenet_units.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

int main() {
  namespace n = dm::nn;
  const auto type = n::DType::Float64;
  n::ParameterStore p(17, type), state(17, type);
  n::models::ShuffleContext c{p, state, false};
  const auto x = n::linspace(-1, 1, 288, type).reshape({1, 6, 6, 8}).detach().requires_grad_();
  const auto out = n::models::ShuffleV2Unit(c, "v2", x, 8, 1);
  const auto even = n::slice_axis(x, 3, 0, 8, 2), carry = n::slice_axis(out, 3, 0, 4);
  if (n::max(n::abs(carry - even)).item() != 0)
    return 1;
  const auto dx = n::grad(n::sum(carry), {x})[0];
  for (int64_t ch = 0; ch < 8; ++ch)
    if (n::max(n::abs(n::slice_axis(dx, 3, ch, ch + 1) - (ch % 2 == 0 ? 1 : 0))).item() != 0)
      return 1;
  const auto pooled = n::models::AveragePoolWithPadding(n::ones({1, 6, 6, 8}, type));
  if (std::abs(pooled.at({0, 0, 0, 0}) - 4. / 9) > 1e-12 || pooled.at({0, 1, 1, 0}) != 1)
    return 1;
  const auto v1 =
      n::models::ShuffleV1Unit(c, "v1", n::ones({1, 6, 6, 8}, type), 32, 2, true, 2);
  if (v1.shape() != n::Shape{1, 3, 3, 32} ||
      n::max(n::abs(n::slice_axis(v1, 3, 0, 8) - pooled)).item() != 0)
    return 1;
  const auto down = n::models::ShuffleV2Unit(c, "v2down", x, 16, 2);
  if (down.shape() != n::Shape{1, 3, 3, 16})
    return 1;
  auto first = [](const auto &t) {
    return n::slice_axis(t, 3, 0, 1).reshape({t.size(1), t.size(2)});
  };
  auto layout = dm::graphics::RLayout::create(1, 2);
  layout.add(n::plot_tensor_map(first(even), -1, 1).title("V2 raw carry: first even channel"))
      .add(
          n::plot_tensor_map(first(pooled), 0, 1).title("V1 average shortcut, including pad"));
  std::filesystem::create_directories("build");
  layout.size(1100, 470).fit_panels().save_svg("build/shufflenet_units.svg");
  std::print("V2 even-channel carry values/derivatives are exact; odd input derivatives into "
             "the carry are zero. V1 3x3 mean counts padding (corner 4/9); strided v1/v2 "
             "shapes verified.\n");
}
```
// result_begin: markdown
V2 even-channel carry values/derivatives are exact; odd input derivatives into the carry are zero. V1 3x3 mean counts padding (corner 4/9); strided v1/v2 shapes verified.
\image(figures/shufflenet_units.svg)
// result_end
\caption(V2 stride-one carries even input channels directly, without a ReLU, so negative values survive. V1 stride-two shortcut pooling counts zero padding in its divisor. Separate strided checks retain both branches and the full output widths.)
