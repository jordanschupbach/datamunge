> Complete released budgets and gradients

All twelve presets and complete v1/v2 backward graphs retain the release topology.

```{cpp, results="markdown", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

int main() {
  namespace n = dm::nn;
  n::set_num_threads(2);
  for (auto [version, groups, size, count, moving, expected] :
       std::vector<std::tuple<int, int, std::string, int64_t, int64_t, int64_t>>{
           {1, 3, "0.5x", 717324, 12240, 37589856},
           {1, 3, "1.0x", 1864728, 24480, 137460672},
           {1, 3, "1.5x", 3441168, 36720, 292443552},
           {1, 3, "2.0x", 5449776, 48960, 524045184},
           {1, 8, "0.5x", 1010448, 19584, 40469760},
           {1, 8, "1.0x", 2433768, 39168, 138365952},
           {1, 8, "1.5x", 4268952, 58752, 290188800},
           {1, 8, "2.0x", 6521232, 78336, 521942016},
           {2, 1, "0.5x", 1365792, 7952, 40476448},
           {2, 1, "1.0x", 2278760, 16180, 145814296},
           {2, 1, "1.5x", 3506720, 23440, 298970656},
           {2, 1, "2.0x", 7402600, 33716, 590783000}}) {
    n::NoGradGuard guard;
    n::ParameterStore p(17), state(17);
    n::models::ShuffleNetConfig cfg;
    cfg.version = version;
    cfg.groups = groups;
    cfg.size = size;
    const auto out = n::models::ShuffleNet(p, state, n::zeros({1, 224, 224, 3}), cfg);
    int64_t macs = out.classifier_macs;
    for (const auto &[shape, per_position] : out.layers)
      macs += shape[1] * shape[2] * per_position;
    if (p.count() != count || state.count() != moving || macs != expected ||
        out.features.size(1) != 7 || out.stages.size() != 3)
      return 1;
    std::print("v{}, groups {}, {}: {} learned / {} moving scalars; {} kernel/classifier "
               "MACs/image, 7x7 features.\n",
               version, groups, size, count, moving, macs);
  }
  for (int version : {1, 2}) {
    n::ParameterStore p(17), state(17);
    n::models::ShuffleNetConfig cfg;
    cfg.version = version;
    cfg.update_stats = false;
    const auto x = n::sin(.37 * n::arange(0, 2 * 64 * 64 * 3).to(n::DType::Float32))
                       .reshape({2, 64, 64, 3});
    {
      n::NoGradGuard guard;
      n::models::ShuffleNet(p, state, x, cfg, true);
      for (const auto &name : p.names())
        if (name.ends_with("/beta"))
          p.set(name,
                (.5 * n::sin(.37 * n::arange(0, p.at(name).numel()).to(n::DType::Float32) +
                             double(name.size())))
                    .reshape(p.at(name).shape()));
    }
    const auto out = n::models::ShuffleNet(p, state, x, cfg, true);
    const auto gradients = n::grad(n::mean(n::square(out.logits)), p.parameters());
    double maximum = 0, minimum = std::numeric_limits<double>::infinity(), redundant = 0;
    int count = 0;
    for (size_t i = 0; i < gradients.size(); ++i) {
      const double norm = n::sqrt(n::sum(n::square(gradients[i]))).item();
      if (!std::isfinite(norm))
        return 1;
      maximum = std::max(maximum, norm);
      if (p.names()[i].ends_with("/depthwise/bn/beta")) {
        ++count;
        redundant = std::max(redundant, norm);
      } else
        minimum = std::min(minimum, norm);
    }
    if (count != (version == 1 ? 16 : 19) || redundant > 1e-5 * maximum || minimum <= 0)
      return 1;
    std::print(
        "Full-width v{} at 64 pixels: {} finite parameter-tensor gradients; {} redundant "
        "depthwise BN shifts max {:.9f}; other minimum {:.9f}, maximum {:.9f}.\n",
        version, gradients.size(), count, redundant, minimum, maximum);
  }
}
```
