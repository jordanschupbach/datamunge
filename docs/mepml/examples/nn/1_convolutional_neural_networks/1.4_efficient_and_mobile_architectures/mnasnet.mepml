> Five full forward budgets

```{cpp, results="markdown", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

int main() {
  namespace n = dm::nn;
  n::set_num_threads(2);
  struct Case {
    const char *name;
    double scale;
    int64_t params, state, macs;
  };
  for (const auto &c : std::vector<Case>{{"a1", 1, 3887038, 33488, 311579072},
                                         {"b1", 1, 4383312, 37920, 314415872},
                                         {"b1", .5, 2218512, -1, -1},
                                         {"b1", .75, 3170208, -1, -1},
                                         {"b1", 1.3, 6282256, -1, -1}}) {
    n::NoGradGuard guard;
    n::ParameterStore p(17), state(17);
    n::models::MnasNetConfig cfg;
    cfg.variant = c.name;
    cfg.multiplier = c.scale;
    const auto out = n::models::MnasNet(p, state, n::zeros({1, 224, 224, 3}), cfg);
    if (p.count() != c.params || (c.state >= 0 && state.count() != c.state) ||
        (c.macs >= 0 && out.Macs() != c.macs) ||
        out.features.shape() != n::Shape{1, 7, 7, 1280})
      return 1;
    std::print("MnasNet {} x{}: {} learned / {} moving scalars, {} MACs from actual 224-pixel "
               "forward; head 7x7x1280.\n",
               c.name, c.scale, p.count(), state.count(), out.Macs());
  }
}
```
