> Decoded tables and a small bottleneck

```{cpp, results="markdown", file="figures/mnasnet_blocks.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

int main() {
  namespace n = dm::nn;
  for (const auto &name : {"a1", "b1"}) {
    int total = 0, se = 0, skip = 0;
    for (const auto &b : n::models::MnasNetBlocks(name)) {
      const auto encoded = n::models::EncodeBlock(b);
      if (n::models::EncodeBlock(n::models::DecodeBlock(encoded)) != encoded)
        return 1;
      std::print("{}: {}\n", name, encoded);
      total += b.repeats;
      se += b.se_ratio > 0 ? b.repeats : 0;
      for (int r = 0; r < b.repeats; ++r)
        skip += b.skip && (r > 0 || (b.input == b.output && b.stride == 1));
    }
    if (total != (std::string(name) == "a1" ? 16 : 17))
      return 1;
    std::print("{}: {} blocks, {} SE blocks, {} raw identity shortcuts.\n", name, total, se,
               skip);
  }
  n::ParameterStore p(17), state(17);
  std::vector<n::models::MobileLayer> layers;
  n::models::MobileContext c{p, state, layers, false};
  const auto x = n::linspace(-2, 2, 2 * 7 * 7 * 8).reshape({2, 7, 7, 8});
  const auto b = n::models::DecodeBlock("r1_k5_s1_e3_i8_o8_se0.25");
  const auto out = n::models::MBConv(c, "example", x, 8, b, 1, false);
  if (out.expanded.size(3) != 24 || out.gate.shape() != n::Shape{2, 1, 1, 24} ||
      n::max(n::abs(out.output - x - out.projected)).item() > 1e-6)
    return 1;
  auto channel = [](const n::Tensor &t) {
    const int64_t selected = n::argmax(n::sum(n::abs(t), {0, 1, 2}), 0).item<int64_t>();
    return n::slice_axis(n::slice_axis(t, 0, 0, 1), 3, selected, selected + 1).reshape({7, 7});
  };
  std::filesystem::create_directories("build");
  dm::graphics::RLayout::create(1, 2)
      .add(n::plot_tensor_map(channel(out.filtered), 0, n::max(out.filtered).item())
               .title("Strongest 5x5 depthwise channel"))
      .add(n::plot_tensor_map(channel(out.output), n::min(out.output).item(),
                              n::max(out.output).item())
               .title("Linear projection plus raw shortcut"))
      .size(1100, 470)
      .fit_panels()
      .save_svg("build/mnasnet_blocks.svg");
}
```
