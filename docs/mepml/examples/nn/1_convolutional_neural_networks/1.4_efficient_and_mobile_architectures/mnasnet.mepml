> Complete backward probe

```{cpp, results="markdown", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

int main() {
  namespace n = dm::nn;
  n::set_num_threads(2);
  n::ParameterStore p(17), state(17);
  n::models::MnasNetConfig cfg;
  cfg.update_stats = false;
  const auto x = n::sin(.37 * n::arange(0, 2 * 64 * 64 * 3).to(n::DType::Float32))
                     .reshape({2, 64, 64, 3});
  {
    n::NoGradGuard guard;
    n::models::MnasNet(p, state, x, cfg, true);
    for (const auto &name : p.names())
      if (name.ends_with("/beta") ||
          (name.find("/se/") != std::string::npos && name.ends_with("/b")))
        p.set(name, (.5 * n::sin(.37 * n::arange(0, p.at(name).numel()).to(n::DType::Float32) +
                                 double(name.size())))
                        .reshape(p.at(name).shape()));
  }
  const auto before = state.flatten();
  const auto out = n::models::MnasNet(p, state, x, cfg, true);
  const auto gradients = n::grad(n::mean(n::square(out.logits)), p.parameters());
  double maximum = 0, smallest = std::numeric_limits<double>::infinity();
  int tiny = 0;
  for (const auto &g : gradients) {
    const double norm = n::sqrt(n::sum(n::square(g))).item();
    if (!std::isfinite(norm))
      return 1;
    maximum = std::max(maximum, norm);
    smallest = std::min(smallest, norm);
  }
  for (const auto &g : gradients)
    tiny += n::sqrt(n::sum(n::square(g))).item() < 1e-6 * maximum;
  if (maximum <= 0 || state.flatten() != before)
    return 1;
  std::print("Complete MnasNet at 64 pixels: {} finite parameter-tensor gradients; norm range "
             "[{:.12f},{:.9f}], {} below 1e-6 of maximum. Moving updates frozen; training "
             "head dropout retained. No claim that every tensor gradient is nonzero.\n",
             gradients.size(), smallest, maximum, tiny);
}
```
// result_begin: markdown
Complete MnasNet at 64 pixels: 181 finite parameter-tensor gradients; norm range [0.000000002585,14.630289078], 16 below 1e-6 of maximum. Moving updates frozen; training head dropout retained. No claim that every tensor gradient is nonzero.
