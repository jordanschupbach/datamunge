> Simple activation example

Piecewise formulas and derivatives are visible before the full network.

```{cpp, results="markdown", file="figures/mobilenet_v3_activations.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

int main() {
  namespace n = dm::nn;
  const auto type = n::DType::Float64;
  const auto x = n::linspace(-6, 6, 1201, type).detach().requires_grad_();
  const auto hs = n::models::HardSwish(x), gate = n::models::HardSigmoid(x),
             smooth = n::sigmoid(x);
  const auto derivative = n::grad(n::sum(hs), {x})[0];
  double error = 0;
  for (size_t i = 0; i < 1201; ++i) {
    const double value = x.at({int64_t(i)});
    if (std::abs(std::abs(value) - 3) < 1e-8)
      continue;
    const double expected = value < -3 ? 0 : value > 3 ? 1 : value / 3 + .5;
    error = std::max(error, std::abs(derivative.at({int64_t(i)}) - expected));
  }
  if (error > 1e-12 || n::models::HardSwish(n::scalar(-4, type)).item() != 0 ||
      n::models::HardSwish(n::scalar(4, type)).item() != 4)
    return 1;
  auto sigmoid = dm::graphics::RPlot::create(), swish = dm::graphics::RPlot::create();
  const auto xv = x.to_vector<double>();
  sigmoid.lines(xv, gate.to_vector<double>(), "hard sigmoid", {37, 99, 235})
      .lines(xv, smooth.to_vector<double>(), "sigmoid", {234, 88, 12})
      .title("Piecewise-linear channel gate")
      .x_label("x")
      .y_label("gate")
      .y_limits(0, 1.4);
  swish.lines(xv, hs.to_vector<double>(), "hard-swish", {37, 99, 235})
      .lines(xv, (x * smooth).to_vector<double>(), "swish", {234, 88, 12})
      .title("Hard-swish and smooth swish")
      .x_label("x")
      .y_label("activation")
      .y_limits(-1, 9);
  std::filesystem::create_directories("build");
  dm::graphics::RLayout::create(1, 2)
      .add(sigmoid)
      .add(swish)
      .size(1100, 470)
      .fit_panels()
      .save_svg("build/mobilenet_v3_activations.svg");
  std::print("Hard-swish derivatives away from hinges match the piecewise formula to {:.12f}; "
             "exact zero below -3 and identity above 3.\n",
             error);
}
```
// result_begin: markdown
Hard-swish derivatives away from hinges match the piecewise formula to 0.000000000000; exact zero below -3 and identity above 3.
\image(figures/mobilenet_v3_activations.svg)
// result_end
\caption(Hard sigmoid is relu6(x+3)/6; hard-swish multiplies that gate by x. Derivatives are checked away from the ±3 hinges. Distinct colours show the smooth functions these replace; negative interior slopes remain possible.)
