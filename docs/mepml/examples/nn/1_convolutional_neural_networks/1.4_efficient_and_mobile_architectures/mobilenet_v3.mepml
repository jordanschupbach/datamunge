> Controlled channel gating

The fixture isolates the gate range and its spatial broadcasting.

```{cpp, results="markdown", file="figures/mobilenet_v3_gates.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

int main() {
  namespace n = dm::nn;
  const auto type = n::DType::Float64;
  n::ParameterStore p(17, type);
  const auto x = n::linspace(-1, 1, 400, type).reshape({2, 5, 5, 8}).detach().requires_grad_();
  {
    n::NoGradGuard guard;
    n::models::SqueezeExcite(p, "se", x, 8);
  }
  p.set("se/expand/W", n::zeros_like(p.at("se/expand/W")));
  const auto bias = n::arange(-4, 4).to(type);
  p.set("se/expand/b", bias);
  const auto out = n::models::SqueezeExcite(p, "se", x, 8);
  const auto expected =
      n::minimum(n::maximum((bias + 3) / 6, n::zeros_like(bias)), n::ones_like(bias));
  const auto dx = n::grad(n::sum(out.output), {x})[0];
  if (n::max(n::abs(out.output - x * expected)).item() > 1e-12 ||
      n::max(n::abs(dx - n::ones_like(x) * expected)).item() > 1e-12)
    return 1;
  auto gates = dm::graphics::RPlot::create();
  gates
      .lines(n::arange(0, 8).to_vector<double>(), expected.to_vector<double>(),
             "controlled gate", {147, 51, 234})
      .title("SE gate with zero expansion kernel")
      .x_label("channel index")
      .y_label("hard sigmoid(bias)")
      .y_limits(0, 1.4);
  std::filesystem::create_directories("build");
  dm::graphics::RLayout::create(1, 1).add(gates).size(850, 460).fit_panels().save_svg(
      "build/mobilenet_v3_gates.svg");
  std::print("SE biases -4..3 give exact channelwise hard-sigmoid scaling and input "
             "derivatives. Gates broadcast over both spatial axes.\n");
}
```
// result_begin: markdown
SE biases -4..3 give exact channelwise hard-sigmoid scaling and input derivatives. Gates broadcast over both spatial axes.
\image(figures/mobilenet_v3_gates.svg)
// result_end
\caption(Zeroing the expansion kernel makes gates independent of the input, isolating channelwise value/derivative scaling. The general module retains the gate’s input derivative as well.)
\alttext(Zeroing the expansion kernel makes gates independent of the input, isolating channelwise value/derivative scaling. The general module retains the gate’s input derivative as well.)

> Complete searched models

Both released tables, counts and every parameter gradient are checked.

```{cpp, results="markdown", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

int main() {
  namespace n = dm::nn;
  n::set_num_threads(2);
  for (auto [large, count, moving, macs] :
       std::vector<std::tuple<bool, int64_t, int64_t, int64_t>>{
           {true, 5483032, 24400, 216589760}, {false, 2542856, 12112, 56510400}}) {
    n::NoGradGuard guard;
    n::ParameterStore p(17), state(17);
    n::models::MobileNetV3Config cfg;
    cfg.large = large;
    const auto out = n::models::MobileNetV3(p, state, n::zeros({1, 224, 224, 3}), cfg);
    if (p.count() != count || state.count() != moving || out.Macs() != macs ||
        n::models::MobileNetV3Blocks(large).size() != (large ? 15 : 11))
      return 1;
    std::print("MobileNet-v3 {}: {} learned / {} moving scalars, {} convolution/SE/dense "
               "MACs/image. Complete {}-block table retained.\n",
               large ? "Large" : "Small", count, moving, macs, large ? 15 : 11);
  }
}
```
// result_begin: markdown
MobileNet-v3 Large: 5483032 learned / 24400 moving scalars, 216589760 convolution/SE/dense MACs/image. Complete 15-block table retained.
MobileNet-v3 Small: 2542856 learned / 12112 moving scalars, 56510400 convolution/SE/dense MACs/image. Complete 11-block table retained.
// result_end

```{cpp, results="markdown", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

int main() {
  namespace n = dm::nn;
  n::set_num_threads(2);
  for (bool large : {true, false}) {
    n::ParameterStore p(17), state(17);
    n::models::MobileNetV3Config cfg;
    cfg.update_stats = false;
    cfg.keep_probability = 1;
    cfg.large = large;
    const auto x = n::sin(.37 * n::arange(0, 2 * 64 * 64 * 3).to(n::DType::Float32))
                       .reshape({2, 64, 64, 3});
    {
      n::NoGradGuard guard;
      n::models::MobileNetV3(p, state, x, cfg, true);
      for (const auto &name : p.names())
        if (name.ends_with("/beta") ||
            (name.find("/se/") != std::string::npos && name.ends_with("/b"))) {
          const auto shape = p.at(name).shape();
          p.set(name,
                (.5 * n::sin(.37 * n::arange(0, p.at(name).numel()).to(n::DType::Float32) +
                             double(name.size())))
                    .reshape(shape));
        }
    }
    const auto out = n::models::MobileNetV3(p, state, x, cfg, true);
    const auto gradients = n::grad(n::mean(n::square(out.logits)), p.parameters());
    double maximum = 0, minimum = std::numeric_limits<double>::infinity(), removed = 0;
    int redundant = 0;
    for (size_t i = 0; i < gradients.size(); ++i) {
      const double norm = n::sqrt(n::sum(n::square(gradients[i]))).item();
      if (!std::isfinite(norm))
        return 1;
      maximum = std::max(maximum, norm);
      if (p.names()[i].ends_with("/project/bn/beta")) {
        ++redundant;
        removed = std::max(removed, norm);
      } else
        minimum = std::min(minimum, norm);
    }
    if (redundant != (large ? 15 : 11) || removed > 1e-5 * maximum || minimum <= 0)
      return 1;
    std::print(
        "MobileNet-v3: {} finite parameter-tensor gradients; nonredundant minimum {:.9f}, "
        "maximum {:.9f}; {} projection BN shifts removed downstream, max {:.9f}.\n",
        gradients.size(), minimum, maximum, redundant, removed);
  }
}
```
// result_begin: markdown
MobileNet-v3: 174 finite parameter-tensor gradients; nonredundant minimum 0.000356697, maximum 0.356567681; 15 projection BN shifts removed downstream, max 0.000000015.
MobileNet-v3: 142 finite parameter-tensor gradients; nonredundant minimum 0.000308981, maximum 0.116251223; 11 projection BN shifts removed downstream, max 0.000000005.
// result_end

> Dataset and paired fitting

Original pixels precede both explicit optimizer runs.

```{cpp, results="markdown", file="figures/mobilenet_v3_inputs.png", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

int main() {
  namespace n = dm::nn;

  std::filesystem::path cache;
  if (const auto *p = std::getenv("DATAMUNGE_DATA_DIR"))
    cache = p;
  else if (const auto *p = std::getenv("XDG_CACHE_HOME"))
    cache = std::filesystem::path(p) / "datamunge/datasets";
  else
    cache = std::filesystem::path(std::getenv("HOME")) / ".cache/datamunge/datasets";
  dm::datasets::fetch("cifar10", (cache / "cifar10").string());

  const auto raw =
      n::data::LoadCifar({cache / "cifar10/data_batch_1.bin"}, n::data::Cifar::k10);
  const auto images = n::cast(raw.images, n::DType::Float32) / 255.;
  const auto labels = raw.labels;

  std::vector<int64_t> rows;
  for (int cls = 0; cls < 10; ++cls) {
    for (int64_t row = 0; row < labels.numel(); ++row)
      if (labels.at({row}) == cls) {
        rows.push_back(row);
        break;
      }
  }
  if (rows.size() != 10)
    return 1;
  std::filesystem::create_directories("build");
  n::save_image_grid(n::take_rows(images, rows), "build/mobilenet_v3_inputs.png", 5, 0., 1., 4,
                     1., 4);
  std::print("One original cached training image per class, IDs 0..4 then 5..9.\n");
}
```
