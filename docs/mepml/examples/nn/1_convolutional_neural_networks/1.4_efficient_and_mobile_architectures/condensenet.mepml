> Complete model and explicit budget assumptions

```{cpp, results="markdown", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

int main() {
  namespace n = dm::nn;
  n::set_num_threads(2);
  n::ParameterStore p(17), state(17);
  n::models::CondenseNetConfig cfg;
  cfg.update_stats = false;
  n::Generator gen(29);
  const auto x = n::normal({2, 32, 32, 3}, 0, .2, gen);
  {
    n::NoGradGuard guard;
    const auto out = n::models::CondenseNet(p, state, x, cfg);
    if (out.channels != 800)
      return 1;
  }
  if (p.count() != 1451594 || state.count() != 1273850)
    return 1;
  const auto out = n::models::CondenseNet(p, state, x, cfg, true, 100);
  if (out.penalties.size() != 42 || state.at("condense/step").item() != 0)
    return 1;
  auto objective = n::mean(n::square(out.logits));
  for (const auto &penalty : out.penalties)
    objective = objective + penalty;
  const auto gradients = n::grad(objective, p.parameters());
  for (const auto &g : gradients)
    if (!std::isfinite(n::sum(n::abs(g)).item()))
      return 1;
  const auto half = n::models::ConvertedCondenseNetCost(cfg, 32),
             whole = n::models::ConvertedCondenseNetCost(cfg, 32, false);
  if (half.parameters != 516202 || half.macs != 62377888 ||
      whole.parameters - half.parameters != 4000)
    return 1;
  std::print("Full CIFAR C86: {} learned / {} BN-mask-stage scalars before training; 42 dense "
             "layers, 800 final channels, {} finite parameter-tensor gradients.\n",
             p.count(), state.count() - 1, gradients.size());
  std::print(
      "Analytical fully converted CIFAR budget with assumed 400-feature classifier: {} "
      "parameters / {} MACs. Keeping all 800 classifier features: {} parameters / {} MACs.\n",
      half.parameters, half.macs, whole.parameters, whole.macs);
  for (int groups : {4, 8}) {
    n::models::CondenseNetConfig large;
    large.stages = {4, 6, 8, 10, 8};
    large.growth = {8, 16, 32, 64, 128};
    large.groups = large.condense = groups;
    large.classes = 1000;
    large.imagenet = true;
    const auto budget = n::models::ConvertedCondenseNetCost(large, 224);
    if (budget.parameters != (groups == 4 ? 4773944 : 2935416) ||
        budget.macs != (groups == 4 ? 516640576 : 261545792))
      return 1;
    std::print("Analytical ImageNet G=C={}: {} parameters / {} MACs, assuming half-width "
               "classifier; no full converted network is executed here.\n",
               groups, budget.parameters, budget.macs);
  }
}
```
// result_begin: markdown
Full CIFAR C86: 1451594 learned / 1273850 BN-mask-stage scalars before training; 42 dense layers, 800 final channels, 383 finite parameter-tensor gradients.
Analytical fully converted CIFAR budget with assumed 400-feature classifier: 516202 parameters / 62377888 MACs. Keeping all 800 classifier features: 520202 parameters / 62381888 MACs.
Analytical ImageNet G=C=4: 4773944 parameters / 516640576 MACs, assuming half-width classifier; no full converted network is executed here.
Analytical ImageNet G=C=8: 2935416 parameters / 261545792 MACs, assuming half-width classifier; no full converted network is executed here.
