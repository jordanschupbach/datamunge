> Pruning schedule and independent oracle

```{cpp, results="markdown", file="figures/condensenet_masks.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

int main() {
  namespace n = dm::nn;
  const auto type = n::DType::Float64;
  n::ParameterStore p(17, type), state(17, type);
  std::vector<n::models::MobileLayer> layers;
  n::models::CondenseContext c{p, state, layers, false};
  {
    n::NoGradGuard guard;
    n::models::LearnedGroupConv(c, "g", n::ones({2, 5, 5, 16}, type), 16, 4, 4);
  }
  // Independent host oracle only: production importance, ranking and masks stay tensors.
  const auto weights = p.at("g/W").reshape({16, 16}).to_vector<double>();
  std::vector<double> expected(256, 1), stages{0}, retained{16};
  for (int stage = 1; stage <= 3; ++stage) {
    for (int group = 0; group < 4; ++group) {
      std::vector<std::pair<double, int>> order;
      for (int i = 0; i < 16; ++i) {
        double score = 0;
        for (int k = 0; k < 4; ++k)
          score += std::abs(weights[i * 16 + k * 4 + group]);
        if (expected[i * 16 + group])
          order.push_back({score, i});
      }
      std::stable_sort(order.begin(), order.end());
      for (int j = 0; j < 4; ++j)
        for (int k = 0; k < 4; ++k)
          expected[order[j].second * 16 + k * 4 + group] = 0;
    }
    n::models::UpdateCondensation(p, state, "g", 4, 4, stage / 6.0 + .00001);
    const auto oracle = n::from_vector(expected, {16, 16});
    if (n::max(n::abs(state.at("g/mask") - oracle)).item() != 0)
      return 1;
    stages.push_back(stage);
    retained.push_back(n::sum(n::slice_axis(state.at("g/mask"), 1, 0, 1)).item());
  }
  auto curve = dm::graphics::RPlot::create();
  curve.lines(stages, retained, "inputs per group", {37, 99, 235})
      .title("Four inputs removed per stage")
      .x_label("condensation stage")
      .y_label("retained input channels")
      .y_limits(0, 20);
  auto mask =
      n::plot_tensor_map(state.at("g/mask"), 0, 1).title("Learned binary mask, 16 by 16");
  std::filesystem::create_directories("build");
  dm::graphics::RLayout::create(1, 2)
      .add(curve)
      .add(mask)
      .size(1100, 470)
      .fit_panels()
      .save_svg("build/condensenet_masks.svg");
  n::ParameterStore ties(19, type), ts(19, type);
  std::vector<n::models::MobileLayer> log;
  n::models::CondenseContext tc{ties, ts, log, false};
  {
    n::NoGradGuard guard;
    n::models::LearnedGroupConv(tc, "g", n::ones({2, 5, 5, 16}, type), 16, 4, 4);
  }
  ties.set("g/W", n::ones({1, 1, 16, 16}, type));
  n::models::UpdateCondensation(ties, ts, "g", 4, 4, .5);
  for (int i = 0; i < 16; ++i)
    for (int o = 0; o < 16; ++o)
      if (ts.at("g/mask").at({i, o}) != (i >= 12 ? 1 : 0))
        return 1;
  std::print("All three tensor pruning stages agree with an independent importance oracle: "
             "16/12/8/4 inputs per group. A jump to progress .5 catches up all stages; equal "
             "scores prune lower input indices first.\n");
}
```
