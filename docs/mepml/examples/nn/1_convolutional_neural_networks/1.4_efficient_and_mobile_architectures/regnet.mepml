> Complete-model backward

All Y-400MF blocks and learned tensors participate in the probe.

```{cpp, results="markdown", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

int main() {
  namespace n = dm::nn;
  n::set_num_threads(2);
  n::ParameterStore p(17), state(17);
  n::models::RegNetConfig cfg;
  cfg.update_stats = false;
  const auto x = n::sin(.37 * n::arange(0, 2 * 64 * 64 * 3).to(n::DType::Float32))
                     .reshape({2, 64, 64, 3});
  {
    n::NoGradGuard guard;
    n::models::RegNet(p, state, x, cfg, true);
    for (const auto &name : p.names())
      if (name.ends_with("/beta") ||
          (name.find("/se/") != std::string::npos && name.ends_with("/b")))
        p.set(name, (.5 * n::sin(.37 * n::arange(0, p.at(name).numel()).to(n::DType::Float32) +
                                 double(name.size())))
                        .reshape(p.at(name).shape()));
  }
  const auto out = n::models::RegNet(p, state, x, cfg, true);
  const auto gradients = n::grad(n::mean(n::square(out.logits)), p.parameters());
  double minimum = std::numeric_limits<double>::infinity(), maximum = 0;
  for (const auto &g : gradients) {
    const double norm = n::sqrt(n::sum(n::square(g))).item();
    if (!std::isfinite(norm))
      return 1;
    minimum = std::min(minimum, norm);
    maximum = std::max(maximum, norm);
  }
  if (minimum <= 1e-6 * maximum)
    return 1;
  std::print("Full-width Y-400MF at 64 pixels: {} finite nonzero parameter-tensor gradients, "
             "norms [{:.9f},{:.9f}]. All sixteen blocks, input-based SE and four stage "
             "downsamplings retained.\n",
             gradients.size(), minimum, maximum);
}
```
