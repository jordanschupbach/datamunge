> Packed grouped filters

Every input/filter/bias derivative is compared with independent groups.

```{cpp, results="markdown", file="figures/regnet_grouped.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

int main() {
  namespace n = dm::nn;
  const auto type = n::DType::Float64;
  auto layout = dm::graphics::RLayout::create(1, 2);
  double maximum = 0;
  for (bool bias : {false, true})
    for (auto activation : {n::Activation::None, n::Activation::Relu}) {
      n::ParameterStore p(17, type);
      const auto x = n::sin(.13 * n::arange(0, 2 * 7 * 6 * 12).to(type))
                         .reshape({2, 7, 6, 12})
                         .detach()
                         .requires_grad_();
      n::ConvLayerOptions cfg;
      cfg.bias = bias;
      cfg.activation = activation;
      cfg.stride = 2;
      cfg.dilation = 2;
      const auto split = n::models::GroupedConv2D(p, "f", x, 15, 3, 3, cfg);
      auto variables = p.parameters();
      variables.push_back(x);
      const auto a = n::grad(n::sum(n::square(split)), variables);
      const auto packed = n::models::FusedGroupedConv2D(p, "f", x, 15, 3, 3, cfg);
      const auto b = n::grad(n::sum(n::square(packed)), variables);
      double error = n::max(n::abs(split - packed)).item();
      for (size_t i = 0; i < a.size(); ++i)
        error = std::max(error, n::max(n::abs(a[i] - b[i])).item());
      if (error > 1e-11)
        return 1;
      maximum = std::max(maximum, error);
      if (bias && activation == n::Activation::Relu) {
        auto channel = [](const auto &t) {
          return n::slice_axis(n::slice_axis(t, 0, 0, 1), 3, 0, 1)
              .reshape({t.size(1), t.size(2)});
        };
        const double high = std::max(1e-12, n::max(split).item());
        layout
            .add(n::plot_tensor_map(channel(split), 0, high)
                     .title("Independent grouped filters"))
            .add(n::plot_tensor_map(channel(packed), 0, high)
                     .title("Packed core grouped convolution"));
      }
    }
  std::filesystem::create_directories("build");
  layout.size(1100, 470).fit_panels().save_svg("build/regnet_grouped.svg");
  std::print(
      "Split/packed grouped values and every input/filter/optional-bias derivative agree, "
      "stride 2/dilation 2, with/without bias and ReLU; maximum absolute error {:.12f}.\n",
      maximum);
}
```
