> Simple width design example

Stage metadata exposes the rounding/grouping rule before model allocation.

```{cpp, results="markdown", file="figures/regnet_design.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

int main() {
  namespace n = dm::nn;
  const auto m = n::models::RegNetModel("y400mf"), x = n::models::RegNetModel("x400mf");
  const auto d = n::models::RegNetDesign(m), dx = n::models::RegNetDesign(x);
  if (d.widths != std::vector<int>{48, 104, 208, 440} ||
      d.depths != std::vector<int>{1, 3, 6, 6} ||
      dx.widths != std::vector<int>{32, 64, 160, 400} ||
      dx.depths != std::vector<int>{1, 2, 7, 12})
    return 1;
  const int previous = std::fegetround();
  for (int mode : {FE_DOWNWARD, FE_UPWARD}) {
    std::fesetround(mode);
    const auto same = n::models::RegNetDesign(m);
    if (std::fegetround() != mode || same.quantized != d.quantized) {
      std::fesetround(previous);
      return 1;
    }
  }
  std::fesetround(previous);
  std::vector<double> index, continuous, quantized;
  for (size_t i = 0; i < d.continuous.size(); ++i) {
    index.push_back(i);
    continuous.push_back(d.continuous[i]);
    quantized.push_back(d.quantized[i]);
  }
  auto widths = dm::graphics::RPlot::create(), depths = dm::graphics::RPlot::create();
  widths.lines(index, continuous, "linear width", {37, 99, 235})
      .lines(index, quantized, "quantized", {234, 88, 12})
      .title("Y-400MF width rule")
      .x_label("block index j")
      .y_label("channels")
      .y_limits(0, 700);
  depths.lines({1, 2, 3, 4}, {1, 3, 6, 6}, "stage depth", {147, 51, 234})
      .title("Y-400MF grouped stages")
      .x_label("stage index")
      .y_label("number of blocks")
      .y_limits(0, 9);
  std::filesystem::create_directories("build");
  dm::graphics::RLayout::create(1, 2)
      .add(widths)
      .add(depths)
      .size(1100, 470)
      .fit_panels()
      .save_svg("build/regnet_design.svg");
  std::print("Y-400MF: widths [48,104,208,440], depths [1,3,6,6], group widths [8,8,8,8]. "
             "X-400MF: [32,64,160,400], depths [1,2,7,12]. Per-thread rounding mode is "
             "restored after design calls.\n");
}
```
