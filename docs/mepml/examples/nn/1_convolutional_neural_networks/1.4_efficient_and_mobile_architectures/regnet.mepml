> All released model budgets

Full weight counts and exact target-resolution arithmetic are distinguished explicitly.

```{cpp, results="markdown", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

int64_t target_macs(const dm::nn::models::MobileNetOutputs &out) {
  int64_t total = out.classifier_macs;
  for (const auto &l : out.layers) {
    if (l.name.find("/se") != std::string::npos)
      total += l.Macs();
    else {
      if ((l.shape[1] * 224) % 64 || (l.shape[2] * 224) % 64)
        throw std::runtime_error("nonintegral target shape");
      total += (l.shape[1] * 224 / 64) * (l.shape[2] * 224 / 64) * l.macs_per_position;
    }
  }
  return total;
}
int main() {
  namespace n = dm::nn;
  n::set_num_threads(2);
  struct Case {
    const char *name;
    std::int64_t params, state, macs;
    std::vector<int> widths, depths;
  };
  const std::vector<Case> cases = {
      {"x400mf", 5495976, 37856, 413812608, {32, 64, 160, 400}, {1, 2, 7, 12}},
      {"x800mf", 7259656, 37312, 799699712, {64, 128, 288, 672}, {1, 3, 7, 5}},
      {"x1.6gf", 9190136, 43504, 1602849792, {72, 168, 408, 912}, {2, 4, 10, 2}},
      {"x3.2gf", 15296552, 62560, 3176621952, {96, 192, 432, 1008}, {2, 6, 15, 2}},
      {"x8gf", 39572648, 90464, 7995132416, {80, 240, 720, 1920}, {2, 5, 15, 1}},
      {"x16gf", 54278536, 111168, 15940755456, {256, 512, 896, 2048}, {2, 6, 13, 1}},
      {"x32gf", 107811560, 162016, 31735929792, {336, 672, 1344, 2520}, {2, 7, 13, 1}},
      {"y400mf", 4344144, 27152, 401842848, {48, 104, 208, 440}, {1, 3, 6, 6}},
      {"y800mf", 6432512, 30432, 833856256, {64, 144, 320, 784}, {1, 3, 8, 2}},
      {"y1.6gf", 11202430, 52672, 1612076160, {48, 120, 336, 888}, {2, 6, 17, 2}},
      {"y3.2gf", 19436338, 66160, 3176482752, {72, 216, 576, 1512}, {2, 5, 13, 1}},
      {"y8gf", 39381472, 86528, 8473070592, {224, 448, 896, 2016}, {2, 4, 10, 1}},
      {"y16gf", 83590140, 122816, 15911510272, {224, 448, 1232, 3024}, {2, 4, 11, 1}},
      {"y32gf", 145046770, 158288, 32279552832, {232, 696, 1392, 3712}, {2, 5, 12, 1}}};

  for (const auto &c : cases) {
    const auto design = n::models::RegNetDesign(n::models::RegNetModel(c.name));
    if (design.widths != c.widths || design.depths != c.depths)
      return 1;
    n::NoGradGuard guard;
    n::ParameterStore p(17), state(17);
    n::models::RegNetConfig cfg;
    cfg.model = c.name;
    const auto out = n::models::RegNet(p, state, n::zeros({1, 64, 64, 3}), cfg);
    const int64_t macs = target_macs(out);
    if (p.count() != c.params || state.count() != c.state || macs != c.macs ||
        out.features.size(1) != 2)
      return 1;
    if (std::string(c.name) == "x400mf" || std::string(c.name) == "y400mf") {
      const auto full = n::models::RegNet(p, state, n::zeros({1, 224, 224, 3}), cfg);
      if (full.Macs() != macs || full.features.size(1) != 7)
        return 1;
    }
    std::print("{}: {} learned / {} moving scalars; exact 224-pixel kernel/SE/classifier "
               "budget {} MACs; all stage widths/depths verified.\n",
               c.name, p.count(), state.count(), macs);
  }
  std::print("Fourteen full-weight models use 64-pixel count-only forwards. Convolution "
             "output sides scale exactly by 224/64 for these divisible geometries; pooled SE "
             "and classifier costs stay fixed. X/Y-400MF additionally execute actual "
             "224-pixel forwards to cross-check this budget calculation.\n");
}
