> Explicit SGD fits unigram and transition references

Scored fitting targets define add-one256unigram and256x256transition count
targets using tensor segment reductions. Fit65792Double learned count fields
by one SGD(.5) step on summed squared count error,then take their logs.
This declared count objective differs from neural NLL. Compare every fitted
count with the sufficient-statistic target;the target helper is not an optimizer.
Test prediction uses unchanged fitted counts and observed input codes only.
```{cpp, results="markdown", file="figures/wavenet_stack_reference.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

#include <print>
int main() {
  namespace n = dm::nn;
  namespace m = n::models;
  n::set_num_threads(2);

  std::filesystem::path cache;
  if (const auto *p = std::getenv("DATAMUNGE_DATA_DIR"))
    cache = p;
  else if (const auto *p = std::getenv("XDG_CACHE_HOME"))
    cache = std::filesystem::path(p) / "datamunge/datasets";
  else
    cache = std::filesystem::path(std::getenv("HOME")) / ".cache/datamunge/datasets";

  std::filesystem::path root = cache / "wavenet";
  if (const auto *p = std::getenv("DATAMUNGE_WAVENET_DIR"))
    root = p;
  else
    dm::datasets::prepare_example_data("audio", root.string());
  const auto data = m::LoadWaveStack(root);
  const auto &fit = data.pools[0];
  const auto &validation = data.pools[1];
  const auto &test = data.pools[2];

  const auto target = m::WaveCountTargets(fit);
  n::ParameterStore p(1, n::DType::Float64);
  const auto unigram = p.get("unigram", {256}, n::init::zeros());
  const auto transition = p.get("transition", {256, 256}, n::init::zeros());
  n::OptimizerConfig config;
  config.kind = n::OptimizerKind::Sgd;
  n::Optimizer sgd(p, .5, config);
  sgd.minimize(n::sum(n::square(unigram - target.first)) +
               n::sum(n::square(transition - target.second)));
  const auto parity = n::maximum(n::max(n::abs(unigram - target.first)),
                                 n::max(n::abs(transition - target.second)));
  if (parity.item() != 0)
    return 1;
  const auto u = n::log(unigram).to(n::DType::Float32),
             t = n::log(transition).to(n::DType::Float32);
  n::save_npz("build/wavenet_stack_sgd_refs.npz", {{"unigram", u}, {"transition", t}});
  std::print("One visible SGD(.5) step fits{} count values,all count parity {:.3g}.\n",
             p.count(), parity.item());
  const auto conditional = n::softmax(t.to(n::DType::Float64));
  auto a = n::plot_tensor_map(n::reverse(n::log(conditional), {0}),
                              n::min(n::log(conditional)).item(), 0),
       b = dm::graphics::RPlot::create();
  a.title("Fitted transition log probabilities")
      .x_label("next mu-law code")
      .y_label("observed code0 at bottom");
  b.lines(n::arange(0, 256).to_vector<double>(),
          n::softmax(u.to(n::DType::Float64)).to_vector<double>(), "fitted unigram",
          {37, 99, 235})
      .title("Unchanged fitted unigram probabilities")
      .x_label("next mu-law code")
      .y_label("fitting probability");
  auto layout = dm::graphics::RLayout::create(1, 2);
  layout.add(a).add(b).size(1100, 500).fit_panels().save_svg(
      "build/wavenet_stack_reference.svg");
}
```
