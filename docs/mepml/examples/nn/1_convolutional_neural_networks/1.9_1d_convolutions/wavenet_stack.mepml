> Every Adam update, with teacher forcing and warmup masking

Warm all76 leaves,then construct tensor Adam(.001). Seed541 and batch-order557
match the source;batch8 over72windows gives9updates/epoch,27total.
Every forward observes original previous codes. The loss explicitly excludes
warmup0..126;its earlier logit adjoints are zero. Native checks verify the
stable loss and every logit derivative independently,including extreme scores.
Validation NLL alone selects the saved learned arrays;no optimizer state is
needed for restored inference. The full fitting loss is a separate probe.
```{cpp, results="markdown", file="figures/wavenet_stack_training.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

#include <print>
int main() {
  namespace n = dm::nn;
  namespace m = n::models;
  n::set_num_threads(2);

  std::filesystem::path cache;
  if (const auto *p = std::getenv("DATAMUNGE_DATA_DIR"))
    cache = p;
  else if (const auto *p = std::getenv("XDG_CACHE_HOME"))
    cache = std::filesystem::path(p) / "datamunge/datasets";
  else
    cache = std::filesystem::path(std::getenv("HOME")) / ".cache/datamunge/datasets";

  std::filesystem::path root = cache / "wavenet";
  if (const auto *p = std::getenv("DATAMUNGE_WAVENET_DIR"))
    root = p;
  else
    dm::datasets::prepare_example_data("audio", root.string());
  const auto data = m::LoadWaveStack(root);
  const auto &fit = data.pools[0];
  const auto &validation = data.pools[1];
  const auto &test = data.pools[2];

  const m::WaveStackConfig c{8, 16, 6, 2, 256};
  n::ParameterStore p(541);
  {
    n::NoGradGuard guard;
    m::WaveStack(p, n::one_hot(n::zeros({1, 2}, n::DType::Int32), 256), c);
  }
  auto predict = [&](const n::Tensor &codes) {
    n::NoGradGuard guard;
    return m::WaveStack(p, n::one_hot(codes, 256), c).logits.detach();
  };

  const auto initial = m::WaveNll(predict(fit.input), fit.target);
  const auto untrained = predict(test.input);
  const auto probe = m::WaveRows(fit, {0, 1, 2, 3, 4, 5, 6, 7});
  for (const auto &g : n::grad(
           m::WaveNll(m::WaveStack(p, n::one_hot(probe.input, 256), c).logits, probe.target),
           p.parameters()))
    if (!n::all(n::is_finite(g)).item<bool>() || n::sum(n::square(g)).item() <= 0)
      return 1;
  n::OptimizerConfig options;
  options.kind = n::OptimizerKind::Adam;
  n::Optimizer adam(p, .001, options);
  n::BatchOrder order(fit.size(), 8, 557);
  double best = INFINITY;
  int selected = 0, updates = 0;
  std::vector<n::Tensor> history;
  std::print("| epoch | teacher-forced fitting NLL | validation NLL |\n|---:|---:|---:|\n");
  for (int epoch = 1; epoch <= 3; ++epoch) {
    order.begin_epoch();
    auto average = n::zeros({}, n::DType::Float64);
    for (;;) {
      const auto rows = order.next();
      if (rows.empty())
        break;
      const auto d = m::WaveRows(fit, rows);
      const auto loss =
          m::WaveNll(m::WaveStack(p, n::one_hot(d.input, 256), c).logits, d.target);
      average = average +
                loss.detach().to(n::DType::Float64) * double(rows.size()) / double(fit.size());
      adam.step(n::grad(loss, p.parameters()));
      ++updates;
    }
    const auto val = m::WaveNll(predict(validation.input), validation.target);
    if (val.item() < best) {
      best = val.item();
      selected = epoch;
      n::NamedTensors arrays;
      for (std::size_t i = 0; i < p.size(); ++i)
        arrays.push_back({p.names()[i], p.parameters()[i]});
      n::save_npz("build/wavenet_stack_best.npz", arrays);
    }
    history.push_back(n::stack({average, val.to(n::DType::Float64)}, 0));
    std::print("| {} | {:.6f} | {:.6f} |\n", epoch, average.item(), val.item());
  }
  for (const auto &[name, value] : n::load_npz("build/wavenet_stack_best.npz"))
    p.set(name, value);
  const auto fitted = m::WaveNll(predict(fit.input), fit.target);
  n::save_npz("build/wavenet_stack_outputs.npz",
              {{"logits", predict(test.input)}, {"untrained", untrained}});
  std::print(
      "{} Adam updates;selected epoch {},val {:.6f};fixed fitting NLL {:.6f}->{:.6f}.\n",
      updates, selected, best, initial.item(), fitted.item());
  const auto h = n::stack(history, 0);
  auto plot = dm::graphics::RPlot::create();
  plot.lines(n::arange(1, 4).to_vector<double>(), n::select(h, 1, 0).to_vector<double>(),
             "fitting", {37, 99, 235})
      .lines(n::arange(1, 4).to_vector<double>(), n::select(h, 1, 1).to_vector<double>(),
             "validation", {220, 38, 38})
      .title("Twenty-seven explicit Adam updates")
      .x_label("epoch;nine fitting batches each")
      .y_label("scored next-code NLL");
  plot.save_svg("build/wavenet_stack_training.svg");
}
```
