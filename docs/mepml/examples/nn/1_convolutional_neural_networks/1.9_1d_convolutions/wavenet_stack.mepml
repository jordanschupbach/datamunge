> Tanh/sigmoid gates, residual paths and skip summation

A causal two-tap input convolution precedes12 gated two-tap blocks,dilations
1/2/4/8/16/32 repeated twice. Every gate is tanh(filter)*sigmoid(gate).
Each projects a skip path;all but the last also project a residual addition.
Sum skips,ReLU,1x1post/ReLU,linear256class head. Glorot kernels and zero
biases follow source initialization. No normalization,dropout or conditioning.

Full residual32/skip64 uses124096 values/76 leaves. Compact8/16 retains the
whole topology,76 leaves and RF128. Native tests check the full every-leaf
backward and all33 tiny host finite differences. Here actual fitting audio
shows initialized gates and a legal future-suffix intervention.
```{cpp, results="markdown", file="figures/wavenet_stack_gates.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

#include <print>
int main() {
  namespace n = dm::nn;
  namespace m = n::models;
  n::set_num_threads(2);

  std::filesystem::path cache;
  if (const auto *p = std::getenv("DATAMUNGE_DATA_DIR"))
    cache = p;
  else if (const auto *p = std::getenv("XDG_CACHE_HOME"))
    cache = std::filesystem::path(p) / "datamunge/datasets";
  else
    cache = std::filesystem::path(std::getenv("HOME")) / ".cache/datamunge/datasets";

  std::filesystem::path root = cache / "wavenet";
  if (const auto *p = std::getenv("DATAMUNGE_WAVENET_DIR"))
    root = p;
  else
    dm::datasets::prepare_example_data("audio", root.string());
  const auto data = m::LoadWaveStack(root);
  const auto &fit = data.pools[0];
  const auto &validation = data.pools[1];
  const auto &test = data.pools[2];

  const m::WaveStackConfig c{8, 16, 6, 2, 256};
  n::ParameterStore p(541);
  {
    n::NoGradGuard guard;
    m::WaveStack(p, n::one_hot(n::zeros({1, 2}, n::DType::Int32), 256), c);
  }
  auto predict = [&](const n::Tensor &codes) {
    n::NoGradGuard guard;
    return m::WaveStack(p, n::one_hot(codes, 256), c).logits.detach();
  };

  const auto d = m::WaveRows(fit, {0});
  const auto out = m::WaveStack(p, n::one_hot(d.input, 256), c);
  const auto times = n::arange(0, 256).reshape({1, 256});
  const auto changed = n::where(
      n::greater_equal(times, 128.),
      n::where(n::greater_equal(d.input, 219.), d.input - 219, d.input + 37), d.input);
  const auto difference = n::abs(predict(changed) - out.logits);
  const auto earlier = n::max(n::slice_axis(difference, 1, 0, 128));
  const auto later = n::sum(n::slice_axis(difference, 1, 128, 256).to(n::DType::Float64));
  if (earlier.item() != 0 || later.item() <= 0)
    return 1;
  std::print("Compact {}values/{}leaves,RF{};future intervention earlier maximum {:.3g},later "
             "total {:.6f}.\n",
             p.count(), p.size(), m::WaveStackField(c), earlier.item(), later.item());
  const auto bound =
      n::maximum(n::max(n::abs(out.gates[0])), n::max(n::abs(out.gates[11]))).item();
  auto a = n::plot_tensor_map(n::reverse(n::select(out.gates[0], 0, 0), {0}), -bound, bound),
       b = n::plot_tensor_map(n::reverse(n::select(out.gates[11], 0, 0), {0}), -bound, bound);
  a.title("Actual first causal gated layer")
      .x_label("residual channel")
      .y_label("time0 at bottom");
  b.title("Actual twelfth causal gated layer")
      .x_label("residual channel")
      .y_label("time0 at bottom");
  auto layout = dm::graphics::RLayout::create(1, 2);
  layout.add(a).add(b).size(1100, 500).fit_panels().save_svg("build/wavenet_stack_gates.svg");
}
```
