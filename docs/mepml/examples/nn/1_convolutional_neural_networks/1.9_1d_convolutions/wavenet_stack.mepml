> Genuine sampled feedback, without true continuation leakage

Each of three held-out clips supplies128real seed codes. For256steps,compute
the last causal logits from the current128-code context,sample with explicit
minstd_rand547 uniforms,and feed the sampled code back. Every CDF,code
selection,context update and decoded amplitude uses tensors;host draws are
random metadata. Save all768draws and196608step logits for independent audit.
The remaining actual256codes are a plotted reference only,never feedback.
Write original/continued48ms WAVs at8kHz. These short unconditional sounds
are not intelligible speech,voice cloning or a conditioned vocoder benchmark.
```{cpp, results="markdown", file="figures/wavenet_stack_generation.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

#include <print>
#include <random>
int main() {
  namespace n = dm::nn;
  namespace m = n::models;
  n::set_num_threads(2);

  std::filesystem::path cache;
  if (const auto *p = std::getenv("DATAMUNGE_DATA_DIR"))
    cache = p;
  else if (const auto *p = std::getenv("XDG_CACHE_HOME"))
    cache = std::filesystem::path(p) / "datamunge/datasets";
  else
    cache = std::filesystem::path(std::getenv("HOME")) / ".cache/datamunge/datasets";

  std::filesystem::path root = cache / "wavenet";
  if (const auto *p = std::getenv("DATAMUNGE_WAVENET_DIR"))
    root = p;
  else
    dm::datasets::prepare_example_data("audio", root.string());
  const auto data = m::LoadWaveStack(root);
  const auto &fit = data.pools[0];
  const auto &validation = data.pools[1];
  const auto &test = data.pools[2];

  const m::WaveStackConfig c{8, 16, 6, 2, 256};
  n::ParameterStore p(541);
  {
    n::NoGradGuard guard;
    m::WaveStack(p, n::one_hot(n::zeros({1, 2}, n::DType::Int32), 256), c);
  }
  auto predict = [&](const n::Tensor &codes) {
    n::NoGradGuard guard;
    return m::WaveStack(p, n::one_hot(codes, 256), c).logits.detach();
  };

  for (const auto &[name, value] : n::load_npz("build/wavenet_stack_best.npz"))
    p.set(name, value.clone());

  n::NoGradGuard guard;
  std::vector<n::Tensor> before;
  for (const auto &v : p.parameters())
    before.push_back(v.clone());
  auto context = n::slice_axis(data.prompts, 1, 0, 128);
  auto codes = context;
  std::vector<n::Tensor> step_logits, uniforms;
  std::minstd_rand rng(547);
  for (int step = 0; step < 256; ++step) {
    const auto next = n::select(predict(context), 1, 127);
    std::vector<double> draws(3);
    for (auto &u : draws)
      u = (double(rng()) - 1.) / 2147483646.;
    const auto u = n::from_vector(draws, {3, 1});
    const auto cdf = n::cumsum(n::softmax(next.to(n::DType::Float64)), 1);
    const auto sampled = n::minimum(n::sum(n::less_equal(cdf, u).to(n::DType::Int32), {1}),
                                    n::full({3}, 255., n::DType::Int32))
                             .reshape({3, 1});
    codes = n::concat({codes, sampled}, 1);
    context = n::concat({n::slice_axis(context, 1, 1, 128), sampled}, 1);
    step_logits.push_back(next);
    uniforms.push_back(u);
  }
  bool immutable = true;
  for (std::size_t i = 0; i < before.size(); ++i)
    immutable = immutable && n::all(n::equal(before[i], p.parameters()[i])).item<bool>();
  if (!immutable || !n::all(n::equal(n::slice_axis(codes, 1, 0, 128),
                                     n::slice_axis(data.prompts, 1, 0, 128)))
                         .item<bool>())
    return 1;
  n::save_npz("build/wavenet_stack_rollouts.npz", {{"codes", codes},
                                                   {"reference", data.prompts},
                                                   {"step_logits", n::stack(step_logits, 1)},
                                                   {"uniform_draws", n::concat(uniforms, 1)}});
  const auto generated = n::mu_law_decode(codes, 256, n::DType::Float64),
             reference = n::mu_law_decode(data.prompts, 256, n::DType::Float64);
  const auto seconds = n::arange(0, 384) / 8000.;
  for (int row = 0; row < 3; ++row) {
    n::write_wav("build/wavenet_stack_generated_" + std::to_string(row) + ".wav",
                 n::select(generated, 0, row).reshape({384, 1}), 8000);
    n::write_wav("build/wavenet_stack_reference_" + std::to_string(row) + ".wav",
                 n::select(reference, 0, row).reshape({384, 1}), 8000);
  }
  auto a = dm::graphics::RPlot::create(), b = dm::graphics::RPlot::create();
  a.lines(seconds.to_vector<double>(), n::select(reference, 0, 0).to_vector<double>(),
          "true continuation", {37, 99, 235})
      .lines(seconds.to_vector<double>(), n::select(generated, 0, 0).to_vector<double>(),
             "sampled", {220, 38, 38})
      .title("First genuine prompt and sampled rollout")
      .x_label("seconds;seed ends.016")
      .y_label("decoded amplitude")
      .y_limits(-1, 1);
  const auto difference = n::sum(
      n::not_equal(n::slice_axis(codes, 1, 128, 384), n::slice_axis(data.prompts, 1, 128, 384))
          .to(n::DType::Float64),
      {1});
  b.points(n::arange(0, 3).to_vector<double>(), difference.to_vector<double>(),
           "different codes", {147, 51, 234})
      .title("All three actual sampled continuations")
      .x_label("held-out original prompt index")
      .y_label("sampled vs true codes,out of256")
      .y_limits(0, 270);
  std::print("768 sampled-feedback steps;76leaves immutable:{};sourceIDs {};different future "
             "codes {}. Six48ms WAVs and full logits/draws saved locally.\n",
             immutable, data.prompt_source_ids, difference);
  auto layout = dm::graphics::RLayout::create(1, 2);
  layout.add(a).add(b).size(1100, 500).fit_panels().save_svg(
      "build/wavenet_stack_generation.svg");
}
