> Previous-code-only restoration and all held-out metrics

Restore a fresh76-leaf store;no labels,source IDs or optimizer enter prediction.
Check saved/repeated logits,all24windows at prefix lengths1/64/128/256,
future suffix isolation and all learned arrays unchanged. Compare NLL,
bits/sample,exact-code fraction and expected-decoded-amplitude MSE over all
3096scored held-out positions. Expected amplitude is sumP(code)*decode(code),
not decode(mean code). Persistence uses the previous actual amplitude.
These are teacher-forced metrics,not sampled audio quality.
```{cpp, results="markdown", file="figures/wavenet_stack_metrics.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

#include <print>
int main() {
  namespace n = dm::nn;
  namespace m = n::models;
  n::set_num_threads(2);

  std::filesystem::path cache;
  if (const auto *p = std::getenv("DATAMUNGE_DATA_DIR"))
    cache = p;
  else if (const auto *p = std::getenv("XDG_CACHE_HOME"))
    cache = std::filesystem::path(p) / "datamunge/datasets";
  else
    cache = std::filesystem::path(std::getenv("HOME")) / ".cache/datamunge/datasets";

  std::filesystem::path root = cache / "wavenet";
  if (const auto *p = std::getenv("DATAMUNGE_WAVENET_DIR"))
    root = p;
  else
    dm::datasets::prepare_example_data("audio", root.string());
  const auto data = m::LoadWaveStack(root);
  const auto &fit = data.pools[0];
  const auto &validation = data.pools[1];
  const auto &test = data.pools[2];

  const m::WaveStackConfig c{8, 16, 6, 2, 256};
  n::ParameterStore p(541);
  {
    n::NoGradGuard guard;
    m::WaveStack(p, n::one_hot(n::zeros({1, 2}, n::DType::Int32), 256), c);
  }
  auto predict = [&](const n::Tensor &codes) {
    n::NoGradGuard guard;
    return m::WaveStack(p, n::one_hot(codes, 256), c).logits.detach();
  };

  for (const auto &[name, value] : n::load_npz("build/wavenet_stack_best.npz"))
    p.set(name, value.clone());

  std::vector<n::Tensor> before;
  for (const auto &v : p.parameters())
    before.push_back(v.clone());
  n::Tensor saved, untrained;
  for (const auto &[name, value] : n::load_npz("build/wavenet_stack_outputs.npz")) {
    if (name == "logits")
      saved = value;
    else
      untrained = value;
  }
  const auto z = predict(test.input);
  const auto parity =
      n::maximum(n::max(n::abs(z - saved)), n::max(n::abs(z - predict(test.input))));
  auto prefix_error = n::zeros({});
  for (int length : {1, 64, 128, 256})
    prefix_error = n::maximum(
        prefix_error, n::max(n::abs(n::select(predict(n::slice_axis(test.input, 1, 0, length)),
                                              1, length - 1) -
                                    n::select(z, 1, length - 1))));
  const auto changed =
      n::where(n::greater_equal(n::arange(0, 256).reshape({1, 256}), 128.),
               n::where(n::greater_equal(test.input, 219.), test.input - 219, test.input + 37),
               test.input);
  const auto delta = n::abs(predict(changed) - z);
  const auto earlier = n::max(n::slice_axis(delta, 1, 0, 128));
  const auto later = n::sum(n::slice_axis(delta.to(n::DType::Float64), 1, 128, 256));
  bool immutable = true;
  for (std::size_t i = 0; i < before.size(); ++i)
    immutable = immutable && n::all(n::equal(before[i], p.parameters()[i])).item<bool>();
  if (parity.item() > 2e-6 || prefix_error.item() > 2e-6 || earlier.item() != 0 ||
      later.item() <= 0 || !immutable)
    return 1;
  std::print("Fresh restore/repeat {:.3g};all held-out prefixes maximum {:.9g} "
             "within2e-6;future earlier {:.3g},later {:.6f};76leaves immutable:{}.\n",
             parity.item(), prefix_error.item(), earlier.item(), later.item(), immutable);
  n::Tensor u, t;
  for (const auto &[name, value] : n::load_npz("build/wavenet_stack_sgd_refs.npz")) {
    if (name == "unigram")
      u = value;
    else
      t = value;
  }
  std::vector<n::Tensor> scores;
  std::print("\n| predictor | NLL | bits/sample | expected amplitude MSE | exact-code "
             "fraction |\n|---|---:|---:|---:|---:|\n");
  for (const auto &item : std::vector<std::pair<std::string, n::Tensor>>{
           {"learned stack", z},
           {"untrained", untrained},
           {"SGD unigram", m::WavePriorLogits(test, u)},
           {"SGD transition", m::WavePriorLogits(test, t)}}) {
    const auto score = m::ScoreWave(item.second, test);
    scores.push_back(score);
    std::print("| {} | {:.6f} | {:.6f} | {:.9f} | {:.6f} |\n", item.first, score.at({0}),
               score.at({0}) / std::log(2.), score.at({1}), score.at({2}));
  }
  const auto persistence = n::mean(n::square(
      n::mu_law_decode(n::slice_axis(test.target, 1, 127, 256), 256, n::DType::Float64) -
      n::mu_law_decode(n::slice_axis(test.input, 1, 127, 256), 256, n::DType::Float64)));
  std::print("Decoded true-previous-code persistence MSE {:.12f}.\n", persistence.item());
  const auto measured = n::stack(scores, 0);
  auto a = dm::graphics::RPlot::create(), b = dm::graphics::RPlot::create();
  a.points(n::arange(0, 4).to_vector<double>(), n::select(measured, 1, 0).to_vector<double>(),
           "NLL", {37, 99, 235})
      .title("All3096 held-out next-code losses")
      .x_label("0learned /1initial /2unigram /3transition")
      .y_label("mean scored categorical NLL")
      .y_limits(0, 6);
  b.points(n::arange(0, 4).to_vector<double>(),
           (n::select(measured, 1, 1) * 1e6).to_vector<double>(), "amplitude MSE",
           {220, 38, 38})
      .title("Teacher-forced amplitude errors")
      .x_label("0learned /1initial /2unigram /3transition")
      .y_label("amplitude MSE times one million");
  auto layout = dm::graphics::RLayout::create(1, 2);
  layout.add(a).add(b).size(1100, 500).fit_panels().save_svg(
      "build/wavenet_stack_metrics.svg");
}
```
