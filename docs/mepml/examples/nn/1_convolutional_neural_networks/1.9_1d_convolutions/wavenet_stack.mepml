> Genuine8kHz source recordings and strict next-sample shifts

Use the pinned Free Spoken Digit Dataset v1.0.10 release,16419872bytes,
SHA256c680098f5d2355ba7cc4bd8b0ca9e0a24c00ebe3b4c552208889a4d28d4fbc2b.
The retained27 original PCM16 mono clips contain digits0/1/2,at8kHz.
Take0/1 for george,jackson,yweweler and take0 for lucas,nicolas,theo.
Fit18clips/four speakers,validate3clips/theo,test6clips/yweweler.
This custom speaker-disjoint teaching split differs from official take-based
FSDD evaluation. Windows from a clip are dependent,not separate speakers.

```{cpp, flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
  const std::filesystem::path cache = dm::datasets::data_home();
  dm::datasets::prepare_example_data("audio", (cache / "wavenet").string());
}
```
// result_begin:
// Prepared genuine FSDD72/12/24speaker-disjoint windows and3original held-out prompts
// result_end

Keep the first1025 actual samples without resampling,peak normalization or
synthesized padding. Decode PCM16/32768,then tensor Double mu-law256 encode.
At starts0/256/512/768,inputs are256 codes and targets are the next256 codes.
There are72fit/12validation/24test windows. Original clips,hashes and source
identities remain local. Only time127..255 is scored:129samples/window after
127warmup samples,the complete RF128 history. Plot actual held-out samples
and all scored fitting code counts;this is next-audio prediction,not digit classification.
```{cpp, results="markdown", file="figures/wavenet_stack_data.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

#include <print>
int main() {
  namespace n = dm::nn;
  namespace m = n::models;
  n::set_num_threads(2);

  std::filesystem::path cache;
  if (const auto *p = std::getenv("DATAMUNGE_DATA_DIR"))
    cache = p;
  else if (const auto *p = std::getenv("XDG_CACHE_HOME"))
    cache = std::filesystem::path(p) / "datamunge/datasets";
  else
    cache = std::filesystem::path(std::getenv("HOME")) / ".cache/datamunge/datasets";

  std::filesystem::path root = cache / "wavenet";
  if (const auto *p = std::getenv("DATAMUNGE_WAVENET_DIR"))
    root = p;
  else
    dm::datasets::prepare_example_data("audio", root.string());
  const auto data = m::LoadWaveStack(root);
  const auto &fit = data.pools[0];
  const auto &validation = data.pools[1];
  const auto &test = data.pools[2];

  const auto x = n::select(test.input, 0, 0);
  const auto amplitude = n::mu_law_decode(x, 256, n::DType::Float64);
  const auto seconds = n::arange(0, 256) / 8000.;
  const auto counts = m::WaveCountTargets(fit);
  auto a = dm::graphics::RPlot::create(), b = dm::graphics::RPlot::create();
  a.lines(seconds.to_vector<double>(), amplitude.to_vector<double>(), "real audio",
          {37, 99, 235})
      .title("Actual held-out32ms audio window")
      .x_label("seconds")
      .y_label("mu-law decoded amplitude");
  b.lines(n::arange(0, 256).to_vector<double>(), (counts.first - 1.).to_vector<double>(),
          "fit counts", {147, 51, 234})
      .title("Every scored fitting target code")
      .x_label("mu-law categorical code")
      .y_label("original sample count;warmup excluded");
  std::print("| pool | windows | scored samples |\n|---|---:|---:|\n");
  for (int i = 0; i < 3; ++i)
    std::print("| {} | {} | {} |\n",
               i == 0   ? "fit"
               : i == 1 ? "validation"
                        : "test",
               data.pools[i].size(), data.pools[i].size() * 129);
  std::print("Real prompt source IDs {},shape {};first256code range {}..{}.\n",
             data.prompt_source_ids, data.prompts.shape(), n::min(x), n::max(x));
  auto layout = dm::graphics::RLayout::create(1, 2);
  layout.add(a).add(b).size(1100, 500).fit_panels().save_svg("build/wavenet_stack_data.svg");
}
