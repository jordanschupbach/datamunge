  const auto ecg = m::LoadSensor(root / "ECG200");
  const auto motion = m::LoadSensor(root / "BasicMotions");

  for (const auto &name : {"ECG200", "BasicMotions"}) {
    std::print(
        "\n| dataset | split | records | original class counts |\n|---|---|---:|---|\n");
    const auto d = m::LoadSensor(root / name);
    for (int i = 0; i < 3; ++i)
      std::print("| {} | {} | {} | {} |\n", name,
                 i == 0   ? "fitting"
                 : i == 1 ? "validation"
                          : "test",
                 d.pools[i].size(),
                 n::sum(n::one_hot(d.pools[i].labels, d.config.classes), {0}));
    std::print("{} fitting channel mean {},std {},class weights {}.\n", name, d.mean, d.stddev,
               d.weights);
  }
  auto a = dm::graphics::RPlot::create(), b = dm::graphics::RPlot::create();
  const auto time = n::arange(0, 96).to_vector<double>();
  const auto labels = ecg.pools[0].labels.to_vector<int>();
  int shown[2] = {0, 0};
  for (int row = 0; row < ecg.pools[0].size(); ++row) {
    const int c = labels[row];
    if (shown[c] >= 2)
      continue;
    a.lines(time, n::select(ecg.pools[0].signals, 0, row).reshape({96}).to_vector<double>(),
            std::string(c ? "code+1 " : "code-1 ") + std::to_string(++shown[c]),
            c ? dm::graphics::RGB{220, 38, 38} : dm::graphics::RGB{37, 99, 235});
  }
  a.title("Four genuine fitting ECG records")
      .x_label("released source sample index")
      .y_label("original released value");
  const auto observed = n::select(motion.pools[0].signals, 0, 0);
  const std::array<dm::graphics::RGB, 6> colors = {{{37, 99, 235},
                                                    {220, 38, 38},
                                                    {22, 163, 74},
                                                    {147, 51, 234},
                                                    {217, 119, 6},
                                                    {8, 145, 178}}};
  for (int c = 0; c < 6; ++c)
    b.lines(n::arange(0, 100).to_vector<double>(),
            n::select(observed, 1, c).to_vector<double>(), "channel" + std::to_string(c),
            colors[c]);
  b.title("One actual six-channel motion record")
      .x_label("original sample index")
      .y_label("released channel value");
  auto examples = dm::graphics::RLayout::create(1, 2);
  examples.add(a).add(b).size(1100, 500).fit_panels().save_svg(
      "build/ecg_sensor_cnn_inputs.svg");
  std::filesystem::create_directories("figures");
  std::filesystem::copy_file("build/ecg_sensor_cnn_inputs.svg",
                             "figures/ecg_sensor_cnn_inputs.svg",
                             std::filesystem::copy_options::overwrite_existing);
  const auto e =
      n::concat({ecg.pools[0].signals, ecg.pools[1].signals, ecg.pools[2].signals}, 0)
          .reshape({200, 96});
  const auto s =
      n::concat({motion.pools[0].signals, motion.pools[1].signals, motion.pools[2].signals}, 0)
          .reshape({80, 600});
  a = n::plot_tensor_map(n::reverse(e, {0}), n::min(e).item(), n::max(e).item());
  b = n::plot_tensor_map(n::reverse(s, {0}), n::min(s).item(), n::max(s).item());
