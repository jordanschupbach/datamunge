> Restore raw-signal-only predictors and report every source class

Restore fresh stores with neutral channel normalization and copy the paired
checkpoint. Forward receives only the observed raw waveform and architecture.
Check saved/repeated logits,single/batch agreement and all20 learned plus2
normalization arrays unchanged. Replace one observed channel at a time with
its unchanged fitting mean,and reverse the time axis. These controls show
computation sensitivity,not causal feature importance or an accuracy test.

Report original class recall,balanced accuracy,macroF1,full confusion and
unweighted NLL,plus source-class0 AUROC only for ECG. Class weights do not
alter the evaluation denominator. Compare the saved SGD centroid and class-count
prior,parameter-free standardized1NN,and untrained model on the same official
test rows. No held-out input changes any fitted reference or normalization.
```{cpp, results="markdown", file="figures/ecg_sensor_cnn_metrics.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

#include <print>
int main() {
  namespace n = dm::nn;
  namespace m = n::models;
  n::set_num_threads(2);

  std::filesystem::path cache;
  if (const auto *p = std::getenv("DATAMUNGE_DATA_DIR"))
    cache = p;
  else if (const auto *p = std::getenv("XDG_CACHE_HOME"))
    cache = std::filesystem::path(p) / "datamunge/datasets";
  else
    cache = std::filesystem::path(std::getenv("HOME")) / ".cache/datamunge/datasets";

  std::filesystem::path root = cache / "ecg_sensor";
  if (const auto *p = std::getenv("DATAMUNGE_SENSOR_DIR"))
    root = p;
  else {
    dm::datasets::prepare_example_data("signals", cache.string());
    root = cache / "ecg_sensor";
  }

  auto metric_layout = dm::graphics::RLayout::create(1, 2);
  auto confusion_layout = dm::graphics::RLayout::create(1, 2);
  auto control_layout = dm::graphics::RLayout::create(1, 2);
  auto recall_layout = dm::graphics::RLayout::create(1, 2);

  for (const std::string name : {"ECG200", "BasicMotions"}) {
    const auto d = m::LoadSensor(root / name);
    const auto &fit = d.pools[0];
    const auto &test = d.pools[2];
    const int k = d.config.classes, c = d.config.channels;
    n::ParameterStore p(587), state(593);
    {
      n::NoGradGuard guard;
      m::SensorCnn(p, state, n::zeros({1, 8, c}), d.config);
    }
    const auto checkpoint = n::load_npz("build/ecg_sensor_cnn_" + name + "_best.npz");
    if (checkpoint.size() != p.size() + state.size())
      return 1;
    for (const auto &[key, value] : checkpoint) {
      if (key.starts_with("p/"))
        p.set(key.substr(2), value.clone());
      else if (key.starts_with("s/"))
        state.set(key.substr(2), value.clone());
      else
        return 1;
    }
    std::vector<n::Tensor> before;
    for (const auto *store : {&p, &state})
      for (const auto &v : store->parameters())
        before.push_back(v.clone());
    auto infer = [&](const n::Tensor &raw) {
      n::NoGradGuard guard;
      return m::SensorCnn(p, state, raw, d.config).logits;
    };
    n::Tensor saved, untrained;
    for (const auto &[key, value] :
         n::load_npz("build/ecg_sensor_cnn_" + name + "_outputs.npz")) {
      if (key == "logits")
        saved = value;
      else if (key == "untrained")
        untrained = value;
    }
    const auto logits = infer(test.signals);
    const auto repeat = infer(test.signals);
    const auto parity =
        n::maximum(n::max(n::abs(logits - saved)), n::max(n::abs(logits - repeat)));
    const auto one = n::slice_axis(test.signals, 0, 0, 1);
    const auto single = infer(one);
    const auto batch_error = n::max(n::abs(single - n::slice_axis(logits, 0, 0, 1)));
    std::vector<n::Tensor> channel_changes;
    for (int channel = 0; channel < c; ++channel) {
      const auto mask = n::equal(n::arange(0, c), double(channel)).reshape({1, 1, c});
      const auto changed =
          n::where(mask, state.at("normalization/mean").reshape({1, 1, c}), one);
      const auto delta =
          n::mean(n::abs(infer(changed).to(n::DType::Float64) - single.to(n::DType::Float64)));
      channel_changes.push_back(delta);
      if (delta.item() <= 1e-7)
        return 1;
    }
    const auto changes = n::stack(channel_changes, 0);
    const auto reversal = n::sum(n::abs(infer(n::reverse(one, {1})).to(n::DType::Float64) -
                                        single.to(n::DType::Float64)));
    bool unchanged = true;
    std::size_t index = 0;
    for (const auto *store : {&p, &state})
      for (const auto &v : store->parameters())
        unchanged = unchanged && n::all(n::equal(before[index++], v)).item<bool>();
    if (parity.item() > 2e-6 || batch_error.item() > 2e-6 || reversal.item() <= 1e-7 ||
        !unchanged)
      return 1;
    std::print("\n{}:restore/repeat error {:.3g};single/batch {:.9g} within2e-6;{} "
               "learned/state arrays unchanged:{};reversal change {:.9f}.\n",
               name, parity.item(), batch_error.item(), before.size(), unchanged,
               reversal.item());
    std::print("{} observed-channel replacement changes:{}\n", name, changes);
    n::Tensor centers, counts;
    for (const auto &[key, value] : n::load_npz("build/ecg_sensor_cnn_" + name + "_sgd.npz")) {
      if (key == "centers")
        centers = value;
      else
        counts = value;
    }
    n::NoGradGuard guard;
    const auto diff =
        (n::expand_dims(test.signals.to(n::DType::Float64), 1) - n::expand_dims(centers, 0)) /
        d.stddev.to(n::DType::Float64);
    const auto centroid = (-n::mean(n::square(diff), {2, 3})).to(n::DType::Float32);
    const auto prior =
        n::log(counts / n::sum(counts)).to(n::DType::Float32) + n::zeros({test.size(), k});
    const auto nearest = m::SensorReference(fit, test, d.stddev, k, false);
    std::vector<n::Tensor> metrics;
    std::vector<m::SensorScore> scores;
    std::print(
        "\n{}:source indices ECG[-1,+1] or "
        "Basic[Standing,Running,Walking,Badminton].\n\n| predictor | accuracy | balanced "
        "| macroF1 | unweighted NLL | source0AUROC | every source recall | every "
        "true-row confusion cell |\n|---|---:|---:|---:|---:|---|---|---|\n",
        name);
    for (const auto &item :
         std::vector<std::pair<std::string, n::Tensor>>{{"learned", logits},
                                                        {"untrained", untrained},
                                                        {"standard1NN", nearest},
                                                        {"SGD centroid", centroid},
                                                        {"SGD counts", prior}}) {
      const auto score = m::ScoreSensor(item.second, test.labels, k);
      scores.push_back(score);
      const auto recall = n::from_vector(score.recall);
      const auto cm = n::from_vector(score.confusion, {k, k});
      if (k == 2)
        std::print("| {} | {:.6f} | {:.6f} | {:.6f} | {:.6f} | {:.6f} | {} | {} |\n",
                   item.first, score.accuracy, score.balanced, score.macro_f1, score.nll,
                   score.auc0, recall, cm);
      else
        std::print("| {} | {:.6f} | {:.6f} | {:.6f} | {:.6f} | unavailable | {} | {} |\n",
                   item.first, score.accuracy, score.balanced, score.macro_f1, score.nll,
                   recall, cm);
      metrics.push_back(n::from_vector(
          std::vector<double>{score.accuracy, score.balanced, score.macro_f1}, {3}));
    }
    const auto measured = n::stack(metrics, 0);
    const auto x = n::arange(0, 5).to_vector<double>();
    auto plot = dm::graphics::RPlot::create();
    plot.points(x, n::select(measured, 1, 0).to_vector<double>(), "accuracy", {37, 99, 235})
        .points(x, n::select(measured, 1, 1).to_vector<double>(), "balanced", {220, 38, 38})
        .points(x, n::select(measured, 1, 2).to_vector<double>(), "macroF1", {22, 163, 74})
        .title(name + " held-out classification")
        .x_label("predictor index (see caption)")
        .y_label("equal-record/class fractions")
        .y_limits(0, 1.2);
    metric_layout.add(plot);
    auto cm = n::plot_tensor_map(
        n::reverse(n::from_vector(scores[0].confusion, {k, k}).to(n::DType::Float64), {0}), 0,
        k == 2 ? 100 : 10);
    cm.title(name + " learned confusion")
        .x_label("predicted source class index")
        .y_label("true source class0 at bottom");
    confusion_layout.add(cm);
    plot = dm::graphics::RPlot::create();
    plot.bars(n::arange(0, c).to_vector<double>(), changes.to_vector<double>(),
              "channel replaced", {147, 51, 234})
        .title(name + " channel interventions")
        .x_label("source channel replaced by fit mean")
        .y_label("mean absolute logit change");
    control_layout.add(plot);
    plot = dm::graphics::RPlot::create();
    plot.points(n::arange(0, k).to_vector<double>(), scores[0].recall, "learned recall",
                {37, 99, 235})
        .points(n::arange(0, k).to_vector<double>(), scores[3].recall, "SGD centroid",
                {220, 38, 38})
        .title(name + " original class recalls")
        .x_label("source index (see caption)")
        .y_label("true-class correct fraction")
        .y_limits(0, 1.2);
    recall_layout.add(plot);
  }
  std::filesystem::create_directories("figures");
  confusion_layout.size(1100, 500).fit_panels().save_svg("build/ecg_sensor_cnn_confusion.svg");
  std::filesystem::copy_file("build/ecg_sensor_cnn_confusion.svg",
                             "figures/ecg_sensor_cnn_confusion.svg",
                             std::filesystem::copy_options::overwrite_existing);
  control_layout.size(1100, 500).fit_panels().save_svg("build/ecg_sensor_cnn_controls.svg");
  std::filesystem::copy_file("build/ecg_sensor_cnn_controls.svg",
                             "figures/ecg_sensor_cnn_controls.svg",
                             std::filesystem::copy_options::overwrite_existing);
  recall_layout.size(1100, 500).fit_panels().save_svg("build/ecg_sensor_cnn_recalls.svg");
  std::filesystem::copy_file("build/ecg_sensor_cnn_recalls.svg",
                             "figures/ecg_sensor_cnn_recalls.svg",
                             std::filesystem::copy_options::overwrite_existing);
  metric_layout.size(1100, 500).fit_panels().save_svg("build/ecg_sensor_cnn_metrics.svg");
}
