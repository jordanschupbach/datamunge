> Both datasets show every weighted-loss Adam update

Initialize learned stores587 and normalization state593. Warm all20 learned
leaves,then explicitly copy fitting channel mean/std before Adam(.001).
Use batch order599,batch8,three epochs:30 updates for ECG80fit and12 for
BasicMotions32fit,42 total. For every batch,raw signal forward,weighted CE,
tensor grad and optimizer step are visible. There is no BN/dropout state.
Validation weighted CE alone selects a paired learned/normalization checkpoint.
Save untrained and selected held-out logits for later immutable restoration checks.
```{cpp, results="markdown", file="figures/ecg_sensor_cnn_training.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

#include <print>
int main() {
  namespace n = dm::nn;
  namespace m = n::models;
  n::set_num_threads(2);

  std::filesystem::path cache;
  if (const auto *p = std::getenv("DATAMUNGE_DATA_DIR"))
    cache = p;
  else if (const auto *p = std::getenv("XDG_CACHE_HOME"))
    cache = std::filesystem::path(p) / "datamunge/datasets";
  else
    cache = std::filesystem::path(std::getenv("HOME")) / ".cache/datamunge/datasets";

  std::filesystem::path root = cache / "ecg_sensor";
  if (const auto *p = std::getenv("DATAMUNGE_SENSOR_DIR"))
    root = p;
  else {
    dm::datasets::prepare_example_data("signals", cache.string());
    root = cache / "ecg_sensor";
  }

  auto layout = dm::graphics::RLayout::create(1, 2);

  for (const std::string name : {"ECG200", "BasicMotions"}) {
    const auto d = m::LoadSensor(root / name);
    const auto &fit = d.pools[0];
    const auto &validation = d.pools[1];
    const auto &test = d.pools[2];
    n::ParameterStore p(587), state(593);
    {
      n::NoGradGuard guard;
      m::SensorCnn(p, state, n::zeros({1, 8, d.config.channels}), d.config);
      state.set("normalization/mean", d.mean);
      state.set("normalization/std", d.stddev);
    }
    auto infer = [&](const n::Tensor &raw) {
      n::NoGradGuard guard;
      return m::SensorCnn(p, state, raw, d.config).logits;
    };
    const double initial =
        m::SensorCE(infer(fit.signals), fit.labels, d.weights, d.config.classes).item();
    const auto untrained = infer(test.signals);
    n::OptimizerConfig options;
    options.kind = n::OptimizerKind::Adam;
    n::Optimizer adam(p, .001, options);
    n::BatchOrder order(fit.size(), 8, 599);
    std::vector<n::Tensor> history;
    double best = INFINITY;
    int selected = 0, updates = 0;
    std::print("\n| dataset | epoch | fitting weighted CE | validation weighted CE "
               "|\n|---|---:|---:|---:|\n");
    for (int epoch = 1; epoch <= 3; ++epoch) {
      order.begin_epoch();
      auto average = n::zeros({}, n::DType::Float64);
      for (;;) {
        const auto rows = order.next();
        if (rows.empty())
          break;
        const auto batch = m::SeriesRows(fit, rows);
        const auto out = m::SensorCnn(p, state, batch.signals, d.config);
        const auto loss = m::SensorCE(out.logits, batch.labels, d.weights, d.config.classes);
        average = average + loss.detach().to(n::DType::Float64) * double(rows.size()) /
                                double(fit.size());
        adam.step(n::grad(loss, p.parameters()));
        ++updates;
      }
      const auto val = m::SensorCE(infer(validation.signals), validation.labels, d.weights,
                                   d.config.classes);
      if (val.item() < best) {
        best = val.item();
        selected = epoch;
        n::NamedTensors arrays;
        for (std::size_t i = 0; i < p.size(); ++i)
          arrays.push_back({"p/" + p.names()[i], p.parameters()[i]});
        for (std::size_t i = 0; i < state.size(); ++i)
          arrays.push_back({"s/" + state.names()[i], state.parameters()[i]});
        n::save_npz("build/ecg_sensor_cnn_" + name + "_best.npz", arrays);
      }
      history.push_back(n::stack({average, val.to(n::DType::Float64)}, 0));
      std::print("| {} | {} | {:.6f} | {:.6f} |\n", name, epoch, average.item(), val.item());
    }
    for (const auto &[key, value] :
         n::load_npz("build/ecg_sensor_cnn_" + name + "_best.npz")) {
      if (key.starts_with("p/"))
        p.set(key.substr(2), value);
      else
        state.set(key.substr(2), value);
    }
    const auto fitted =
        m::SensorCE(infer(fit.signals), fit.labels, d.weights, d.config.classes);
    const auto output = infer(test.signals);
    const auto hist = n::stack(history, 0);
    n::save_npz("build/ecg_sensor_cnn_" + name + "_outputs.npz",
                {{"logits", output}, {"untrained", untrained}, {"history", hist}});
    std::print(
        "{}:{} explicit Adam updates,selected epoch {},validation {:.6f};fixed weighted "
        "fitting CE {:.6f}->{:.6f};{} learned leaves plus2normalization arrays.\n",
        name, updates, selected, best, initial, fitted.item(), p.size());
    auto plot = dm::graphics::RPlot::create();
    const auto epochs = n::arange(1, 4).to_vector<double>();
    plot.lines(epochs, n::select(hist, 1, 0).to_vector<double>(), "weighted fit",
               {37, 99, 235})
        .lines(epochs, n::select(hist, 1, 1).to_vector<double>(), "weighted val",
               {220, 38, 38})
        .title(name + " explicit Adam updates")
        .x_label("epoch;all fitting records once")
        .y_label("raw-row weighted cross-entropy");
    layout.add(plot);
  }
  layout.size(1100, 500).fit_panels().save_svg("build/ecg_sensor_cnn_training.svg");
}
