> Weighted CE uses the record count denominator

Each record contributes its source class weight times negative log-softmax.
Average over N original rows,not the sum of selected weights. The weights
N/(K*class_count) come only from fitting labels. Stable log-softmax retains
large finite logits. Class weighting enters the training objective and is
absent from raw-signal inference and the unweighted evaluation NLL.

Binary source-class0 AUROC counts a positive/negative pair correct when its
margin logit0-logit1 is larger,with half credit for exact ties. The declared
.8/.8/.2/.1 score fixture with labels0/1/0/1 has AUROC.625. For multiclass
BasicMotions,the binary auc0 field is unused;report it as unavailable.
```{cpp, results="markdown", file="figures/ecg_sensor_cnn_objective.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

#include <print>
int main() {
  namespace n = dm::nn;
  namespace m = n::models;
  const auto z = n::tensor({1000., 999., -2., 1.}, {2, 2}).requires_grad_();
  const auto labels = n::tensor({0, 1}).to(n::DType::Int32);
  const auto weights = n::tensor({2., .5});
  const auto loss = m::SensorCE(z, labels, weights, 2);
  const auto gradient = n::grad(loss, {z})[0];
  const auto expected = (n::softmax(z, 1) - n::one_hot(labels, 2)) *
                        n::gather(weights, labels, 0).reshape({2, 1}) / 2.;
  const auto scores = n::tensor({.8, .8, .2, .1}).to(n::DType::Float64);
  const auto truth = n::tensor({0, 1, 0, 1}).to(n::DType::Int32);
  const auto positive = n::equal(truth, 0.);
  const auto pairs =
      n::logical_and(n::expand_dims(positive, 1), n::expand_dims(n::logical_not(positive), 0));
  const auto a = n::expand_dims(scores, 1);
  const auto b = n::expand_dims(scores, 0);
  const auto credit = n::where(
      pairs,
      n::greater(a, b).to(n::DType::Float64) + .5 * n::equal(a, b).to(n::DType::Float64), 0.);
  std::print("Weighted raw-row CE {:.6f};every analytic adjoint max error {:.3g};tie-aware "
             "sourceclass0AUROC {:.6f}.\n",
             loss.item(), n::max(n::abs(gradient - expected)).item(),
             m::TensorSensorAuc0(scores, truth));
  auto p = n::plot_tensor_map(n::reverse(gradient, {0}), -.3, .3),
       q = n::plot_tensor_map(n::reverse(credit, {0}), 0, 1);
  p.title("Weighted per-record logit derivatives")
      .x_label("source class index")
      .y_label("record0 at bottom");
  q.title("Class0-versus-rest pairwise credit")
      .x_label("other source-record index")
      .y_label("class0 record index0 at bottom");
  auto layout = dm::graphics::RLayout::create(1, 2);
  layout.add(p).add(q).size(1100, 500).fit_panels().save_svg(
      "build/ecg_sensor_cnn_objective.svg");
}
```
