> Explicitly fit centroid and count references with SGD

One visible Double SGD(.5) step fits every class/time/channel centroid under
summed per-coordinate class-balanced MSE,and fits add-one class-count fields
under a count-regression objective. Warm both leaf arrays before constructing
SGD. Save the learned centroid/count tensors. Closed-form tensor centroids
are parity oracles only. Evaluation divides distances by unchanged fitting
channel std;centering cancels between observations and centroids.

The standardized1NN reference stores original fitting observations and has
no optimized numeric leaves. Its Float32 subtraction/division precede Double
squared-distance reduction,matching the source;first fitting row wins ties.
Distance and onehot scores are explicitly pseudo-logits,not probability calibration.
```{cpp, results="markdown", file="figures/ecg_sensor_cnn_references.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

#include <print>
int main() {
  namespace n = dm::nn;
  namespace m = n::models;
  n::set_num_threads(2);

  std::filesystem::path cache;
  if (const auto *p = std::getenv("DATAMUNGE_DATA_DIR"))
    cache = p;
  else if (const auto *p = std::getenv("XDG_CACHE_HOME"))
    cache = std::filesystem::path(p) / "datamunge/datasets";
  else
    cache = std::filesystem::path(std::getenv("HOME")) / ".cache/datamunge/datasets";

  std::filesystem::path root = cache / "ecg_sensor";
  if (const auto *p = std::getenv("DATAMUNGE_SENSOR_DIR"))
    root = p;
  else {
    dm::datasets::prepare_example_data("signals", cache.string());
    root = cache / "ecg_sensor";
  }

  std::filesystem::create_directories("build");
  auto layout = dm::graphics::RLayout::create(1, 2);
  for (const std::string name : {"ECG200", "BasicMotions"}) {
    const auto d = m::LoadSensor(root / name);
    const auto &fit = d.pools[0];
    const auto &test = d.pools[2];
    const int k = d.config.classes;
    const auto weight =
        n::one_hot(fit.labels, k, 1., 0., n::DType::Float64).reshape({fit.size(), k, 1, 1});
    const auto count = n::sum(weight, {0});
    const auto count_target = count.reshape({k}) + 1.;
    n::ParameterStore p(599, n::DType::Float64);
    const auto centers = p.get("centers", {k, d.time, d.config.channels}, n::init::zeros());
    const auto counts = p.get("counts", {k}, n::init::zeros());
    n::OptimizerConfig options;
    options.kind = n::OptimizerKind::Sgd;
    n::Optimizer sgd(p, .5, options);
    const auto error =
        n::sum(n::sum(weight * n::square(centers -
                                         n::expand_dims(fit.signals.to(n::DType::Float64), 1)),
                      {0}) /
               count) +
        n::sum(n::square(counts - count_target));
    sgd.minimize(error);
    const auto difference =
        (n::expand_dims(test.signals.to(n::DType::Float64), 1) - n::expand_dims(centers, 0)) /
        d.stddev.to(n::DType::Float64);
    const auto logits = (-n::mean(n::square(difference), {2, 3})).to(n::DType::Float32);
    const auto parity =
        n::max(n::abs(logits - m::SensorReference(fit, test, d.stddev, k, true)));
    if (parity.item() != 0)
      return 1;
    n::save_npz("build/ecg_sensor_cnn_" + name + "_sgd.npz",
                {{"centers", centers.detach()}, {"counts", counts.detach()}});
    std::print("{}:one visible SGD(.5) update,{} learned centroid/count values,every held-out "
               "distance parity {:.3g}.\n",
               name, p.count(), parity.item());
    auto plot = dm::graphics::RPlot::create();
    const auto time = n::arange(0, d.time).to_vector<double>();
    const std::array<dm::graphics::RGB, 4> colors = {
        {{37, 99, 235}, {220, 38, 38}, {22, 163, 74}, {147, 51, 234}}};
    for (int c = 0; c < k; ++c)
      plot.lines(time, n::select(n::select(centers, 0, c), 1, 0).to_vector<double>(),
                 "source class" + std::to_string(c), colors[c]);
    plot.title(name + " SGD centroids,channel0")
        .x_label("original temporal sample")
        .y_label("class-balanced raw channel0 mean");
    layout.add(plot);
  }
  layout.size(1100, 500).fit_panels().save_svg("build/ecg_sensor_cnn_references.svg");
}
```
