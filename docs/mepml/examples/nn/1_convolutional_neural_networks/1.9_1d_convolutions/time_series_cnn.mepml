> Fit the centroid reference with visible tensor SGD

Fit two150-sample centroid fields by one Double SGD(.5) step on the summed
per-coordinate class-balanced MSE. Each class divides by its own fitting
count. Compare the resulting negative mean squared distances with the
closed-form source helper as a parity oracle only. Save the fitted fields
for evaluation after neural training. The1NN reference stores original
fitting observations and has no optimized numeric leaves;its first fitting
row wins equal-distance ties. Its onehot scores are pseudo-logits,so their
CE is a declared diagnostic rather than calibrated likelihood.
```{cpp, results="markdown", file="figures/time_series_cnn_references.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

#include <print>
int main() {
  namespace n = dm::nn;
  namespace m = n::models;
  n::set_num_threads(2);

  std::filesystem::path cache;
  if (const auto *p = std::getenv("DATAMUNGE_DATA_DIR"))
    cache = p;
  else if (const auto *p = std::getenv("XDG_CACHE_HOME"))
    cache = std::filesystem::path(p) / "datamunge/datasets";
  else
    cache = std::filesystem::path(std::getenv("HOME")) / ".cache/datamunge/datasets";

  std::filesystem::path root = cache / "time_series";
  if (const auto *p = std::getenv("DATAMUNGE_SERIES_DIR"))
    root = p;
  else {
    dm::datasets::prepare_example_data("signals", cache.string());
    root = cache / "time_series";
  }
  const auto split = m::LoadSeries(root);
  const auto &fit = split.pools[0];
  const auto &validation = split.pools[1];
  const auto &test = split.pools[2];

  const auto weights =
      n::one_hot(fit.labels, 2, 1., 0., n::DType::Float64).reshape({fit.size(), 2, 1, 1});
  const auto count = n::sum(weights, {0});
  const auto target = n::expand_dims(fit.signals.to(n::DType::Float64), 1);
  n::ParameterStore prior(431, n::DType::Float64);
  const auto centers = prior.get("centroids", {2, 150, 1}, n::init::zeros());
  n::OptimizerConfig options;
  options.kind = n::OptimizerKind::Sgd;
  n::Optimizer sgd(prior, .5, options);
  const auto loss = n::sum(n::sum(weights * n::square(centers - target), {0}) / count);
  sgd.minimize(loss);
  const auto logits =
      (-n::mean(n::square(n::expand_dims(test.signals.to(n::DType::Float64), 1) -
                          n::expand_dims(centers, 0)),
                {2, 3}))
          .to(n::DType::Float32);
  const auto parity = n::max(n::abs(logits - m::SeriesReference(fit, test, true)));
  if (parity.item() != 0)
    return 1;
  std::filesystem::create_directories("build");
  n::save_npz("build/time_series_cnn_sgd_centroids.npz", {{"centers", centers.detach()}});
  std::print("One explicit SGD(.5) update,{} centroid values;every held-out source-oracle "
             "logit parity {:.3g}.\n",
             prior.count(), parity.item());
  auto a = dm::graphics::RPlot::create(), b = dm::graphics::RPlot::create();
  const auto time = n::arange(0, 150).to_vector<double>();
  a.lines(time, n::select(centers, 0, 0).reshape({150}).to_vector<double>(), "gun centroid",
          {37, 99, 235})
      .lines(time, n::select(centers, 0, 1).reshape({150}).to_vector<double>(),
             "point centroid", {220, 38, 38})
      .title("Explicitly SGD-fitted raw centroids")
      .x_label("source sample index")
      .y_label("class-balanced raw mean");
  const auto difference =
      (fit.signals - n::slice_axis(test.signals, 0, 0, 1)).to(n::DType::Float64);
  const auto distances = n::sum(n::square(difference), {1, 2});
  const auto closest = n::argmin(distances).item<std::int64_t>();
  b.points(n::arange(0, fit.size()).to_vector<double>(), distances.to_vector<double>(),
           "raw distances", {37, 99, 235})
      .points({double(closest)}, {n::select(distances, 0, closest).item()}, "first nearest",
              {220, 38, 38})
      .title("First test signal versus fitting rows")
      .x_label("retained fitting row")
      .y_label("sum of raw squared differences");
  auto layout = dm::graphics::RLayout::create(1, 2);
  layout.add(a).add(b).size(1100, 500).fit_panels().save_svg(
      "build/time_series_cnn_references.svg");
}
```
