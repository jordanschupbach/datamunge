> BN calibration is a fitting-data operation

Training uses minibatch statistics and updates moving moments with momentum.99
and epsilon.001. After each epoch,an explicit fitting-only calibration pass
sets each layer's population moments from all40 fitting sequences. The next
layer receives the already calibrated previous layer. This is sequential
calibration,not averaging minibatch variances. It uses no labels.

Frozen inference uses the saved global normalization and calibrated BN
moments. No validation/test recalibration is allowed. A separate TrainNoUpdate
policy uses batch statistics without mutating state for derivative probes.
The following actual-data calibration leaves every learned value unchanged.
```{cpp, results="markdown", file="figures/time_series_cnn_calibration.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

#include <print>
int main() {
  namespace n = dm::nn;
  namespace m = n::models;
  n::set_num_threads(2);

  std::filesystem::path cache;
  if (const auto *p = std::getenv("DATAMUNGE_DATA_DIR"))
    cache = p;
  else if (const auto *p = std::getenv("XDG_CACHE_HOME"))
    cache = std::filesystem::path(p) / "datamunge/datasets";
  else
    cache = std::filesystem::path(std::getenv("HOME")) / ".cache/datamunge/datasets";

  std::filesystem::path root = cache / "time_series";
  if (const auto *p = std::getenv("DATAMUNGE_SERIES_DIR"))
    root = p;
  else {
    dm::datasets::prepare_example_data("signals", cache.string());
    root = cache / "time_series";
  }
  const auto split = m::LoadSeries(root);
  const auto &fit = split.pools[0];
  const auto &validation = split.pools[1];
  const auto &test = split.pools[2];

  n::ParameterStore p(419), state(421);
  std::vector<n::Tensor> before;
  {
    n::NoGradGuard guard;
    m::SeriesCnn(p, state, fit.signals, split.config);
    for (const auto &v : p.parameters())
      before.push_back(v.clone());
    m::SeriesCnn(p, state, fit.signals, split.config, m::BnMode::Calibrate);
  }
  bool unchanged = true;
  for (std::size_t i = 0; i < before.size(); ++i)
    unchanged = unchanged && n::all(n::equal(before[i], p.parameters()[i])).item<bool>();
  std::vector<n::Tensor> means, variances;
  for (int i = 1; i <= 3; ++i) {
    means.push_back(state.at("bn" + std::to_string(i) + "/moving_mean"));
    variances.push_back(state.at("bn" + std::to_string(i) + "/moving_var"));
  }
  std::print("Calibration:all{} learned leaves unchanged:{};{} state leaves include global "
             "mean/std plus three BN mean/variance pairs.\n",
             p.size(), unchanged, state.size());
  const auto mean = n::concat(means, 0);
  const auto variance = n::concat(variances, 0);
  const auto positions = n::arange(0, mean.numel()).to_vector<double>();
  auto a = dm::graphics::RPlot::create(), b = dm::graphics::RPlot::create();
  a.points(positions, mean.to_vector<double>(), "population mean", {37, 99, 235})
      .title("Sequential fitting-only BN means")
      .x_label("16 /32 /16 ordered layer channels")
      .y_label("raw convolution mean");
  b.points(positions, variance.to_vector<double>(), "population var", {220, 38, 38})
      .title("Sequential fitting-only BN variance")
      .x_label("16 /32 /16 ordered layer channels")
      .y_label("population convolution variance");
  auto layout = dm::graphics::RLayout::create(1, 2);
  layout.add(a).add(b).size(1100, 500).fit_panels().save_svg(
      "build/time_series_cnn_calibration.svg");
}
```
