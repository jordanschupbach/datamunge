> Original hand-motion signals and fitting-only normalization

GunPoint tracks the right hand's x-coordinate for two actors performing gun-draw
or pointing motions. Original class1 means gun-draw,class2 means pointing;
prepared metadata maps them to0/1. Each record has150 source samples. Retain
all150 official test rows unchanged. Seed407 shuffles each official training
class,holds out20% for validation,then shuffles the retained rows:40fit,10val.
Source-record IDs are disjoint;this is **not actor-disjoint** evaluation.

The official435,433-byte archive is pinned by SHA256 in the saved manifest.
Raw numeric strings become Float32 tensors once,with no synthesized signals
or per-record feature processing. Fitting Double population mean/std round
once to Float32 and become detached scalar checkpoint state. Held-out values
never estimate this normalization. All200 original signals are shown below.

```{cpp, flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
  const std::filesystem::path cache = dm::datasets::data_home();
  dm::datasets::prepare_example_data("signals", cache);
}
```
// result_begin:
// result_end
```{cpp, results="markdown", file="figures/time_series_cnn_data.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

#include <print>
int main() {
  namespace n = dm::nn;
  namespace m = n::models;
  n::set_num_threads(2);

  std::filesystem::path cache;
  if (const auto *p = std::getenv("DATAMUNGE_DATA_DIR"))
    cache = p;
  else if (const auto *p = std::getenv("XDG_CACHE_HOME"))
    cache = std::filesystem::path(p) / "datamunge/datasets";
  else
    cache = std::filesystem::path(std::getenv("HOME")) / ".cache/datamunge/datasets";

  std::filesystem::path root = cache / "time_series";
  if (const auto *p = std::getenv("DATAMUNGE_SERIES_DIR"))
    root = p;
  else {
    dm::datasets::prepare_example_data("signals", cache.string());
    root = cache / "time_series";
  }
  const auto split = m::LoadSeries(root);
  const auto &fit = split.pools[0];
  const auto &validation = split.pools[1];
  const auto &test = split.pools[2];

  std::print("| split | original records | gun-draw | pointing |\n|---|---:|---:|---:|\n");
  for (const auto &item : std::vector<std::pair<std::string, m::SeriesData>>{
           {"fitting", fit}, {"validation", validation}, {"test", test}}) {
    const auto counts = n::sum(n::one_hot(item.second.labels, 2), {0}).to_vector<int>();
    std::print("| {} | {} | {} | {} |\n", item.first, item.second.size(), counts[0],
               counts[1]);
  }
  std::print("Fitting-only population mean {:.9f},std {:.9f};no per-test normalization.\n",
             split.config.mean, split.config.standard_deviation);
  auto a = dm::graphics::RPlot::create();
  const auto labels = fit.labels.to_vector<int>();
  int shown[2] = {0, 0};
  const auto time = n::arange(0, 150).to_vector<double>();
  for (int row = 0; row < fit.size(); ++row) {
    const int c = labels[row];
    if (shown[c] >= 2)
      continue;
    const auto values = n::select(fit.signals, 0, row).reshape({150});
    a.lines(time, values.to_vector<double>(),
            std::string(c ? "point " : "gun ") + std::to_string(++shown[c]),
            c ? dm::graphics::RGB{220, 38, 38} : dm::graphics::RGB{37, 99, 235});
  }
  a.title("Four genuine fitting hand motions")
      .x_label("source sample index")
      .y_label("original released x-coordinate");
  const auto all =
      n::concat({fit.signals, validation.signals, test.signals}, 0).reshape({200, 150});
  auto b = n::plot_tensor_map(n::reverse(all, {0}), n::min(all).item(), n::max(all).item());
  b.title("All200 original source sequences")
      .x_label("source sample index")
      .y_label("40fit /10validation /150test rows");
  auto layout = dm::graphics::RLayout::create(1, 2);
  layout.add(a).add(b).size(1100, 500).fit_panels().save_svg("build/time_series_cnn_data.svg");
}
