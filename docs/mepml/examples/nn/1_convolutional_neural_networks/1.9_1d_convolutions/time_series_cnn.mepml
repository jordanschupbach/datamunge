> Every Adam update and the selected calibration state are explicit

Warm all14 learned and8 state leaves before Adam(.001). Calibrate once on
fitting inputs for the untrained reference. Each of15 updates uses8 fitting
signals,training BN,hard-label CE,and explicit tensor gradients. After each
epoch,calibrate on all40 fitting signals again before validation. Validation
NLL alone selects the **paired** learned/normalization/BN checkpoint.
Restore fresh stores with neutral normalization defaults;all actual saved
normalization and BN values must come from the checkpoint.

Compare exact restored/repeated logits,single/batch agreement and immutable
learned/state leaves. A time-reversed raw observed signal tests sensitivity to
order without changing labels or fitting anything. Reversal sensitivity
alone does not prove useful classification. Evaluate the saved SGD centroids,
parameter-free1NN,untrained FCN and declared class0 majority tie rule on the
same original held-out rows. All scored/confusion/plot values use tensors.
```{cpp, results="markdown", file="figures/time_series_cnn_training.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

#include <print>
int main() {
  namespace n = dm::nn;
  namespace m = n::models;
  n::set_num_threads(2);

  std::filesystem::path cache;
  if (const auto *p = std::getenv("DATAMUNGE_DATA_DIR"))
    cache = p;
  else if (const auto *p = std::getenv("XDG_CACHE_HOME"))
    cache = std::filesystem::path(p) / "datamunge/datasets";
  else
    cache = std::filesystem::path(std::getenv("HOME")) / ".cache/datamunge/datasets";

  std::filesystem::path root = cache / "time_series";
  if (const auto *p = std::getenv("DATAMUNGE_SERIES_DIR"))
    root = p;
  else {
    dm::datasets::prepare_example_data("signals", cache.string());
    root = cache / "time_series";
  }
  const auto split = m::LoadSeries(root);
  const auto &fit = split.pools[0];
  const auto &validation = split.pools[1];
  const auto &test = split.pools[2];

  n::ParameterStore p(419), state(421);
  const auto config = split.config;
  {
    n::NoGradGuard guard;
    m::SeriesCnn(p, state, fit.signals, config, m::BnMode::Calibrate);
  }
  auto infer = [&](n::ParameterStore &learned, n::ParameterStore &moving,
                   const n::Tensor &raw) {
    n::NoGradGuard guard;
    return m::SeriesCnn(learned, moving, raw, config).logits;
  };
  const auto initial = m::ScoreSequenceClassifier(infer(p, state, fit.signals), fit.labels);
  const auto untrained = infer(p, state, test.signals);
  n::OptimizerConfig options;
  options.kind = n::OptimizerKind::Adam;
  n::Optimizer adam(p, .001, options);
  n::BatchOrder order(fit.size(), 8, 431);
  std::vector<n::Tensor> history;
  double best = INFINITY;
  int selected = 0, updates = 0;
  std::print(
      "| epoch | minibatch-BN fitting CE | calibrated validation NLL |\n|---:|---:|---:|\n");
  for (int epoch = 1; epoch <= 3; ++epoch) {
    order.begin_epoch();
    auto average = n::zeros({}, n::DType::Float64);
    for (;;) {
      const auto rows = order.next();
      if (rows.empty())
        break;
      const auto batch = m::SeriesRows(fit, rows);
      const auto out = m::SeriesCnn(p, state, batch.signals, config, m::BnMode::Train);
      const auto loss = m::SequenceCrossEntropy(out.logits, batch.labels);
      average = average +
                loss.detach().to(n::DType::Float64) * double(rows.size()) / double(fit.size());
      adam.step(n::grad(loss, p.parameters()));
      ++updates;
    }
    n::NoGradGuard guard;
    m::SeriesCnn(p, state, fit.signals, config, m::BnMode::Calibrate);
    const auto val =
        m::ScoreSequenceClassifier(infer(p, state, validation.signals), validation.labels).nll;
    if (val.item() < best) {
      best = val.item();
      selected = epoch;
      n::NamedTensors arrays;
      for (std::size_t i = 0; i < p.size(); ++i)
        arrays.push_back({"p/" + p.names()[i], p.parameters()[i]});
      for (std::size_t i = 0; i < state.size(); ++i)
        arrays.push_back({"s/" + state.names()[i], state.parameters()[i]});
      n::save_npz("build/time_series_cnn_best.npz", arrays);
    }
    history.push_back(n::stack({average, val}, 0));
    std::print("| {} | {:.6f} | {:.6f} |\n", epoch, average.item(), val.item());
  }
  n::ParameterStore deployed(419), frozen(421);
  {
    n::NoGradGuard guard;
    m::SeriesCnn(deployed, frozen, n::zeros({1, 150, 1}), m::SeriesConfig{16, 0, 1});
  }
  const auto checkpoint = n::load_npz("build/time_series_cnn_best.npz");
  if (checkpoint.size() != p.size() + state.size())
    return 1;
  for (const auto &[name, value] : checkpoint) {
    if (name.starts_with("p/")) {
      p.set(name.substr(2), value);
      deployed.set(name.substr(2), value.clone());
    } else if (name.starts_with("s/")) {
      state.set(name.substr(2), value);
      frozen.set(name.substr(2), value.clone());
    } else
      return 1;
  }
  std::vector<n::Tensor> before;
  for (const auto &v : deployed.parameters())
    before.push_back(v.clone());
  for (const auto &v : frozen.parameters())
    before.push_back(v.clone());
  const auto logits = infer(deployed, frozen, test.signals);
  const auto reference = infer(p, state, test.signals);
  const auto repeat = infer(deployed, frozen, test.signals);
  const auto parity =
      n::maximum(n::max(n::abs(logits - reference)), n::max(n::abs(logits - repeat)));
  const auto first = n::slice_axis(test.signals, 0, 0, 1);
  const auto single = infer(deployed, frozen, first);
  const auto batch_error = n::max(n::abs(single - n::slice_axis(logits, 0, 0, 1)));
  const auto reversal =
      n::sum(n::abs(single.to(n::DType::Float64) -
                    infer(deployed, frozen, n::reverse(first, {1})).to(n::DType::Float64)));
  bool immutable = true;
  std::size_t index = 0;
  for (const auto *store : {&deployed, &frozen})
    for (const auto &v : store->parameters())
      immutable = immutable && n::all(n::equal(before[index++], v)).item<bool>();
  if (parity.item() > 1e-6 || batch_error.item() > 1e-6 || !immutable ||
      reversal.item() <= 1e-7)
    return 1;
  const auto fitted =
      m::ScoreSequenceClassifier(infer(deployed, frozen, fit.signals), fit.labels);
  std::print(
      "{} explicit Adam updates;selected epoch {},validation {:.6f};fixed calibrated fitting "
      "CE {:.6f}->{:.6f}.\nRaw-signal-only restore/repeat parity {:.3g};single/batch {:.9g} "
      "within1e-6;{} learned+state leaves immutable:{};reversal logit change {:.9f}.\n",
      updates, selected, best, initial.nll.item(), fitted.nll.item(), parity.item(),
      batch_error.item(), before.size(), immutable, reversal.item());
  const auto centers = n::load_npz("build/time_series_cnn_sgd_centroids.npz")[0].second;
  const auto centroid =
      (-n::mean(n::square(n::expand_dims(test.signals.to(n::DType::Float64), 1) -
                          n::expand_dims(centers, 0)),
                {2, 3}))
          .to(n::DType::Float32);
  const auto nearest = m::SeriesReference(fit, test, false);
  std::vector<n::Tensor> metrics, confusions;
  std::print(
      "| predictor | accuracy | stable NLL | true-row confusion |\n|---|---:|---:|---|\n");
  for (const auto &item :
       std::vector<std::pair<std::string, n::Tensor>>{{"learned", logits},
                                                      {"untrained", untrained},
                                                      {"raw1NN", nearest},
                                                      {"SGD centroid", centroid},
                                                      {"class0 tie", n::zeros_like(logits)}}) {
    const auto score = m::ScoreSequenceClassifier(item.second, test.labels);
    std::print("| {} | {:.6f} | {:.6f} | {} |\n", item.first, score.accuracy.item(),
               score.nll.item(), score.confusion);
    metrics.push_back(n::stack({score.accuracy, score.nll}, 0));
    confusions.push_back(score.confusion.to(n::DType::Float64));
  }
  const auto measured = n::stack(metrics, 0);
  const auto xs = n::arange(0, 5).to_vector<double>();
  auto a = dm::graphics::RPlot::create(), b = dm::graphics::RPlot::create();
  a.points(xs, n::select(measured, 1, 0).to_vector<double>(), "accuracy", {37, 99, 235})
      .title("Original held-out sequence accuracy")
      .x_label("predictor index (see caption)")
      .y_label("equal-record correct fraction")
      .y_limits(0, 1.2);
  b.points(xs, n::select(measured, 1, 1).to_vector<double>(), "stable NLL", {220, 38, 38})
      .title("Declared raw-score likelihood")
      .x_label("predictor index (see caption)")
      .y_label("stable mean categorical NLL")
      .y_limits(0, 1.1);
  auto scores = dm::graphics::RLayout::create(1, 2);
  scores.add(a).add(b).size(1100, 500).fit_panels().save_svg(
      "build/time_series_cnn_metrics.svg");
  std::filesystem::create_directories("figures");
  std::filesystem::copy_file("build/time_series_cnn_metrics.svg",
                             "figures/time_series_cnn_metrics.svg",
                             std::filesystem::copy_options::overwrite_existing);
  a = n::plot_tensor_map(n::reverse(confusions[0], {0}), 0, 80);
  b = n::plot_tensor_map(n::reverse(confusions[3], {0}), 0, 80);
  a.title("Learned FCN test confusion")
      .x_label("predicted0gun /1point")
      .y_label("true0gun at bottom /1point");
  b.title("SGD centroid test confusion")
      .x_label("predicted0gun /1point")
      .y_label("true0gun at bottom /1point");
  auto cm = dm::graphics::RLayout::create(1, 2);
  cm.add(a).add(b).size(1100, 500).fit_panels().save_svg(
      "build/time_series_cnn_confusion.svg");
  std::filesystem::copy_file("build/time_series_cnn_confusion.svg",
                             "figures/time_series_cnn_confusion.svg",
                             std::filesystem::copy_options::overwrite_existing);
  const auto hist = n::stack(history, 0);
  const auto epochs = n::arange(1, 4).to_vector<double>();
  a = dm::graphics::RPlot::create();
  b = dm::graphics::RPlot::create();
  a.lines(epochs, n::select(hist, 1, 0).to_vector<double>(), "batch BN fit", {37, 99, 235})
      .lines(epochs, n::select(hist, 1, 1).to_vector<double>(), "frozen val", {220, 38, 38})
      .title("Fifteen explicit Adam updates")
      .x_label("epoch;5 minibatches each")
      .y_label("categorical cross-entropy")
      .y_limits(0, 1.);
  const auto norm = n::concat({frozen.at("normalization/mean").reshape({1}),
                               frozen.at("normalization/std").reshape({1})},
                              0);
  b.bars({0., 1.}, norm.to_vector<double>(), "restored values", {22, 163, 74})
      .title("Restored fitting-only normalization")
      .x_label("0global mean /1population std")
      .y_label("saved Float32 scalar value");
  auto curves = dm::graphics::RLayout::create(1, 2);
  curves.add(a).add(b).size(1100, 500).fit_panels().save_svg(
      "build/time_series_cnn_training.svg");
}
```
