> Original review bytes, aligned with the word CNN

The official Pang/Lee MR v1.0 archive contains5331 negative and5331 positive
snippets. Retain the exact same original source IDs and binary labels as the
word CNN:1000 fitting,200 validation,200 test,balanced within every pool.
Fitting-only ASCII word vocabulary and duplicate-group selection use source
std::mt19937seed337. This is a custom holdout,not published cross-validation
and not verified movie/author independence. Original Latin1 bytes remain in
the source archive and manifest;the UTF8 reviews.tsv is presentation metadata.

```{cpp, flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
  const std::filesystem::path cache = dm::datasets::data_home();
  dm::datasets::prepare_example_data("text", cache);
}
```
// result_begin:
// Original MR fit:1000 aligned word/character observations
// Original MR validation:200 aligned word/character observations
// Original MR test:200 aligned word/character observations
// result_end

Take the last256 source bytes,reverse them,and lowercase ASCII letters only.
The source alphabet has69 slots,including a repeated hyphen;the last matching
slot wins. Unknown bytes,spaces and padding have ID-1 and all-zero onehot
vectors. This is byte preprocessing,not Unicode grapheme tokenization.
The word reference observes the first64 tokens while this CNN observes the
last256 bytes,so their comparison changes both representation and model.
```{cpp, results="markdown", file="figures/character_cnn_data.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

#include <print>
int main() {
  namespace n = dm::nn;
  namespace m = n::models;
  n::set_num_threads(2);

  std::filesystem::path cache;
  if (const auto *p = std::getenv("DATAMUNGE_DATA_DIR"))
    cache = p;
  else if (const auto *p = std::getenv("XDG_CACHE_HOME"))
    cache = std::filesystem::path(p) / "datamunge/datasets";
  else
    cache = std::filesystem::path(std::getenv("HOME")) / ".cache/datamunge/datasets";

  std::filesystem::path root = cache / "character";
  if (const auto *p = std::getenv("DATAMUNGE_CHARACTER_DIR"))
    root = p;
  else {
    dm::datasets::prepare_example_data("text", cache.string());
    root = cache / "character";
  }
  const auto split = m::LoadCharacters(root);
  const auto &fit = split.pools[0];
  const auto &validation = split.pools[1];
  const auto &test = split.pools[2];

  const auto words = m::LoadSentences(root.parent_path() / "sentence");
  auto a = dm::graphics::RPlot::create(), b = dm::graphics::RPlot::create();
  int index = 0;
  const std::array<dm::graphics::RGB, 3> colors = {
      {{37, 99, 235}, {220, 38, 38}, {22, 163, 74}}};
  std::print("| pool | original rows | mean retained bytes | unknown-byte fraction "
             "|\n|---|---:|---:|---:|\n");
  for (int pool = 0; pool < 3; ++pool) {
    const auto &d = split.pools[pool];
    if (!n::all(n::equal(d.source_ids, words.pools[pool].source_ids)).item<bool>() ||
        !n::all(n::equal(d.labels, words.pools[pool].labels)).item<bool>())
      return 1;
    const auto active = m::LengthMask(d.lengths, 256, n::DType::Bool);
    const auto unknown =
        n::sum(n::logical_and(active, n::less(d.tokens, 0.)).to(n::DType::Float64)) /
        n::sum(active.to(n::DType::Float64));
    const auto lengths = n::unsorted_segment_sum(n::ones({d.size()}, n::DType::Float64),
                                                 d.lengths.to(n::DType::Int64), 257);
    const std::string name = pool == 0 ? "fit" : pool == 1 ? "validation" : "test";
    a.lines(n::arange(0, 257).to_vector<double>(), lengths.to_vector<double>(), name,
            colors[index++]);
    std::print("| {} | {} | {:.6f} | {:.6f} |\n", name, d.size(),
               n::mean(d.lengths.to(n::DType::Float64)).item(), unknown.item());
  }
  const auto counts = n::sum(m::CharacterCounts(fit), {0});
  b.lines(n::arange(0, 69).to_vector<double>(), counts.to_vector<double>(),
          "all69 source slots", {147, 51, 234})
      .title("Actual fitting character counts")
      .x_label("original alphabet slot")
      .y_label("known observed source bytes");
  a.title("Every original retained byte length")
      .x_label("retained bytes;cap256")
      .y_label("original review count");
  auto layout = dm::graphics::RLayout::create(1, 2);
  layout.add(a).add(b).size(1100, 500).fit_panels().save_svg("build/character_cnn_data.svg");
}
```
