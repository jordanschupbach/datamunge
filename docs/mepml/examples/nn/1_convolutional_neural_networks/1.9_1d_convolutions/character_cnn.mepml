> Onehot ingress and six valid convolutions

No embedding table learns:known byte IDs select a fixed69-dimensional onehot.
Observed lengths mask all later positions,including legally substituted IDs.
Six VALID convolutions have kernels7/7/3/3/3/3,He-uniform weights and ReLU.
VALID width3/stride3 max pools follow convolutions1,2,6. Flatten the surviving
sequence,then apply two Glorot dense/ReLU layers,dropout after each,and a
Glorot linear binary head. Biases initialize to zero. There is no batch norm.

These maps use the first actual fitting review at initialization. Unknown
holes can subsequently acquire nonzero convolution responses through nearby
known input and learned biases;zero ingress does not mean zero whole network.
```{cpp, results="markdown", file="figures/character_cnn_features.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

#include <print>
int main() {
  namespace n = dm::nn;
  namespace m = n::models;
  n::set_num_threads(2);

  std::filesystem::path cache;
  if (const auto *p = std::getenv("DATAMUNGE_DATA_DIR"))
    cache = p;
  else if (const auto *p = std::getenv("XDG_CACHE_HOME"))
    cache = std::filesystem::path(p) / "datamunge/datasets";
  else
    cache = std::filesystem::path(std::getenv("HOME")) / ".cache/datamunge/datasets";

  std::filesystem::path root = cache / "character";
  if (const auto *p = std::getenv("DATAMUNGE_CHARACTER_DIR"))
    root = p;
  else {
    dm::datasets::prepare_example_data("text", cache.string());
    root = cache / "character";
  }
  const auto split = m::LoadCharacters(root);
  const auto &fit = split.pools[0];
  const auto &validation = split.pools[1];
  const auto &test = split.pools[2];

  const auto d = m::SentenceRows(fit, {0});
  n::ParameterStore p(2);
  const auto out = m::CharacterCnn(p, d.tokens, d.lengths, split.config);
  const auto active = m::LengthMask(d.lengths, 256, n::DType::Bool);
  const auto changed = n::where(active, d.tokens, 0.);
  const auto parity =
      n::max(n::abs(m::CharacterCnn(p, changed, d.lengths, split.config).logits - out.logits));
  if (parity.item() != 0)
    return 1;
  std::print("Onehot shape {},flatten {},nine stage shapes:", out.quantized.shape(),
             out.flat.shape());
  for (const auto &stage : out.stages)
    std::print(" {}", stage.shape());
  std::print(";out-of-length parity {:.3g}.\n", parity.item());
  auto a = n::plot_tensor_map(n::reverse(n::select(out.quantized, 0, 0), {0}), 0, 1),
       b = n::plot_tensor_map(n::reverse(n::select(out.stages[0], 0, 0), {0}), 0,
                              n::max(out.stages[0]).item());
  a.title("Original first review:fixed onehot")
      .x_label("alphabet slot0..68")
      .y_label("reversed byte position0 at bottom");
  b.title("Actual first width7 convolution")
      .x_label("initialized learned channel")
      .y_label("valid time position0 at bottom");
  auto layout = dm::graphics::RLayout::create(1, 2);
  layout.add(a).add(b).size(1100, 500).fit_panels().save_svg(
      "build/character_cnn_features.svg");
}
```
