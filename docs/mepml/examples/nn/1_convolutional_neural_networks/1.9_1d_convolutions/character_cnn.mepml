> Independent character-only restoration and complete errors

A fresh store restores18 learned arrays with no optimizer or labels in the
forward. Check repeated/saved logits,single/batch agreement,legal padding
substitutions and all arrays unchanged. Replace observed bytes with the known
slot0 to show input dependence,without claiming semantic feature importance.
All five predictors use every held-out review;the original text excerpts are
presentation metadata and are escaped before Markdown/HTML export.
```{cpp, results="markdown", file="figures/character_cnn_confusion.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

#include <fstream>
#include <print>
#include <sstream>
int main() {
  namespace n = dm::nn;
  namespace m = n::models;
  n::set_num_threads(2);

  std::filesystem::path cache;
  if (const auto *p = std::getenv("DATAMUNGE_DATA_DIR"))
    cache = p;
  else if (const auto *p = std::getenv("XDG_CACHE_HOME"))
    cache = std::filesystem::path(p) / "datamunge/datasets";
  else
    cache = std::filesystem::path(std::getenv("HOME")) / ".cache/datamunge/datasets";

  std::filesystem::path root = cache / "character";
  if (const auto *p = std::getenv("DATAMUNGE_CHARACTER_DIR"))
    root = p;
  else {
    dm::datasets::prepare_example_data("text", cache.string());
    root = cache / "character";
  }
  const auto split = m::LoadCharacters(root);
  const auto &fit = split.pools[0];
  const auto &validation = split.pools[1];
  const auto &test = split.pools[2];

  const auto c = split.config;
  n::ParameterStore p(2);
  {
    n::NoGradGuard guard;
    m::CharacterCnn(p, n::zeros({1, c.time}, n::DType::Int32), n::ones({1}, n::DType::Int32),
                    c);
  }
  for (const auto &[name, value] : n::load_npz("build/character_cnn_best.npz"))
    p.set(name, value.clone());
  std::vector<n::Tensor> before;
  for (const auto &value : p.parameters())
    before.push_back(value.clone());
  auto infer = [&](const m::SentenceData &d) {
    n::NoGradGuard guard;
    std::vector<n::Tensor> parts;
    for (std::int64_t start = 0; start < d.size(); start += 50) {
      std::vector<std::int64_t> rows;
      for (auto i = start; i < std::min<std::int64_t>(start + 50, d.size()); ++i)
        rows.push_back(i);
      const auto b = m::SentenceRows(d, rows);
      parts.push_back(m::CharacterCnn(p, b.tokens, b.lengths, c).logits);
    }
    return n::concat(parts, 0);
  };
  n::Tensor saved, untrained;
  for (const auto &[name, value] : n::load_npz("build/character_cnn_outputs.npz")) {
    if (name == "logits")
      saved = value;
    else
      untrained = value;
  }
  const auto logits = infer(test);
  const auto repeat = infer(test);
  const auto parity =
      n::maximum(n::max(n::abs(logits - saved)), n::max(n::abs(logits - repeat)));
  const auto one = m::SentenceRows(test, {0});
  const auto single = infer(one);
  const auto batch_error = n::max(n::abs(single - n::slice_axis(logits, 0, 0, 1)));
  const auto active = m::LengthMask(one.lengths, 256, n::DType::Bool);
  auto padded = one;
  padded.tokens = n::where(active, one.tokens, 0.);
  auto unknown = one;
  unknown.tokens = n::where(active, 0., one.tokens);
  const auto pad_error = n::max(n::abs(infer(padded) - single));
  const auto sensitivity =
      n::sum(n::abs(infer(unknown).to(n::DType::Float64) - single.to(n::DType::Float64)));
  bool immutable = true;
  for (std::size_t i = 0; i < before.size(); ++i)
    immutable = immutable && n::all(n::equal(before[i], p.parameters()[i])).item<bool>();
  if (parity.item() > 1e-6 || batch_error.item() > 1e-6 || pad_error.item() != 0 ||
      sensitivity.item() <= 1e-7 || !immutable)
    return 1;
  std::print("Character-only restore/repeat parity {:.3g};single/batch {:.9g} "
             "within1e-6;out-of-length change {:.3g};18 learned leaves immutable:{};observed "
             "replacement change {:.6f}.\n",
             parity.item(), batch_error.item(), pad_error.item(), immutable,
             sensitivity.item());
  n::Tensor word_counts, class_counts, char_counts;
  for (const auto &[name, value] : n::load_npz("build/character_cnn_sgd_refs.npz")) {
    if (name == "word_counts")
      word_counts = value;
    else if (name == "character_counts")
      char_counts = value;
    else
      class_counts = value;
  }
  n::NoGradGuard guard;
  const auto words = m::LoadSentences(root.parent_path() / "sentence");
  const auto nb =
      (n::matmul(m::SentenceWordCounts(words.pools[2], words.config.vocabulary),
                 n::transpose(n::log(word_counts / n::sum(word_counts, {1}, true)), {1, 0})) +
       n::log(class_counts / n::sum(class_counts)))
          .to(n::DType::Float32);
  const auto char_nb =
      (n::matmul(m::CharacterCounts(test),
                 n::transpose(n::log(char_counts / n::sum(char_counts, {1}, true)), {1, 0})) +
       n::log(class_counts / n::sum(class_counts)))
          .to(n::DType::Float32);
  std::vector<n::Tensor> metrics, confusions;
  std::print("\n| predictor | accuracy | stable NLL | all true-row confusion counts "
             "|\n|---|---:|---:|---|\n");
  for (const auto &item :
       std::vector<std::pair<std::string, n::Tensor>>{{"learned CNN", logits},
                                                      {"untrained", untrained},
                                                      {"SGD character", char_nb},
                                                      {"SGD word", nb},
                                                      {"class0 tie", n::zeros_like(logits)}}) {
    const auto score = m::ScoreSequenceClassifier(item.second, test.labels);
    metrics.push_back(n::stack({score.accuracy, score.nll}, 0));
    confusions.push_back(score.confusion);
    std::print("| {} | {:.6f} | {:.6f} | {} |\n", item.first, score.accuracy.item(),
               score.nll.item(), score.confusion);
  }
  const auto predicted = n::argmax(logits, 1).to_vector<std::int64_t>();
  const auto truth = test.labels.to_vector<int>();
  const auto source_ids = test.source_ids.to_vector<int>();
  std::map<int, std::string> text;
  std::ifstream reviews(root.parent_path() / "sentence/reviews.tsv");
  std::string line;
  std::getline(reviews, line);
  while (std::getline(reviews, line)) {
    const auto a = line.find('\t'), b = line.find('\t', a + 1);
    text.emplace(std::stoi(line.substr(0, a)), line.substr(b + 1));
  }
  auto escape = [](const std::string &input) {
    std::string out;
    for (char ch : input) {
      if (ch == '&')
        out += "&amp;";
      else if (ch == '<')
        out += "&lt;";
      else if (ch == '>')
        out += "&gt;";
      else if (ch == '|')
        out += "&#124;";
      else
        out += ch;
    }
    return out;
  };
  std::print("\n| original source ID | original text excerpt,first12 whitespace words | true "
             "| CNN |\n|---:|---|---|---|\n");
  for (int row = 0; row < 6; ++row) {
    std::istringstream input(text.at(source_ids[row]));
    std::string excerpt, word;
    for (int i = 0; i < 12 && input >> word; ++i)
      excerpt += (i ? " " : "") + word;
    std::print("| {} | {} | {} | {} |\n", source_ids[row], escape(excerpt),
               truth[row] ? "positive" : "negative", predicted[row] ? "positive" : "negative");
  }
  const auto measured = n::stack(metrics, 0);
  const auto positions = n::arange(0, 5).to_vector<double>();
  auto a = dm::graphics::RPlot::create(), b = dm::graphics::RPlot::create();
  a.points(positions, n::select(measured, 1, 0).to_vector<double>(), "accuracy", {37, 99, 235})
      .title("Original held-out review accuracy")
      .x_label("0CNN /1initial /2char /3word /4tie0")
      .y_label("equal-review correct fraction")
      .y_limits(0, 1.1);
  b.points(positions, n::select(measured, 1, 1).to_vector<double>(), "stable NLL",
           {220, 38, 38})
      .title("All200 held-out review likelihoods")
      .x_label("0CNN /1initial /2char /3word /4tie0")
      .y_label("mean categorical NLL")
      .y_limits(0, 1.1);
  auto summary = dm::graphics::RLayout::create(1, 2);
  summary.add(a).add(b).size(1100, 500).fit_panels().save_svg(
      "build/character_cnn_metrics.svg");
  std::filesystem::create_directories("figures");
  std::filesystem::copy_file("build/character_cnn_metrics.svg",
                             "figures/character_cnn_metrics.svg",
                             std::filesystem::copy_options::overwrite_existing);
  a = n::plot_tensor_map(n::reverse(confusions[0].to(n::DType::Float64), {0}), 0, 100);
  b = n::plot_tensor_map(n::reverse(confusions[2].to(n::DType::Float64), {0}), 0, 100);
  a.title("Learned CNN held-out confusion")
      .x_label("predicted0negative /1positive")
      .y_label("true negative0 at bottom");
  b.title("SGD character held-out confusion")
      .x_label("predicted0negative /1positive")
      .y_label("true negative0 at bottom");
  auto confusion = dm::graphics::RLayout::create(1, 2);
  confusion.add(a).add(b).size(1100, 500).fit_panels().save_svg(
      "build/character_cnn_confusion.svg");
}
