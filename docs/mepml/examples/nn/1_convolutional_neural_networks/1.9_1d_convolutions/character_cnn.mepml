> Explicit tensor SGD fits both count references

Fit the add-one character,word and class counts with one Double SGD(.5)
step on summed squared count error. Normalize the fitted fields into the
usual multinomial NB scores. These count objectives are explicitly declared,
separate from neural categorical CE. Closed-form helpers are parity oracles
only. The word reference uses the same IDs/labels but the first64 token view;
characters use last256 raw bytes. No held-out text estimates these fields.
```{cpp, results="markdown", file="figures/character_cnn_reference.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

#include <print>
int main() {
  namespace n = dm::nn;
  namespace m = n::models;
  n::set_num_threads(2);

  std::filesystem::path cache;
  if (const auto *p = std::getenv("DATAMUNGE_DATA_DIR"))
    cache = p;
  else if (const auto *p = std::getenv("XDG_CACHE_HOME"))
    cache = std::filesystem::path(p) / "datamunge/datasets";
  else
    cache = std::filesystem::path(std::getenv("HOME")) / ".cache/datamunge/datasets";

  std::filesystem::path root = cache / "character";
  if (const auto *p = std::getenv("DATAMUNGE_CHARACTER_DIR"))
    root = p;
  else {
    dm::datasets::prepare_example_data("text", cache.string());
    root = cache / "character";
  }
  const auto split = m::LoadCharacters(root);
  const auto &fit = split.pools[0];
  const auto &validation = split.pools[1];
  const auto &test = split.pools[2];

  const auto words = m::LoadSentences(root.parent_path() / "sentence");
  const int v = words.config.vocabulary;
  const auto labels = n::one_hot(fit.labels, 2, 1., 0., n::DType::Float64);
  const auto char_target =
      n::matmul(n::transpose(labels, {1, 0}), m::CharacterCounts(fit)) + 1.;
  const auto word_target =
      n::matmul(n::transpose(labels, {1, 0}), m::SentenceWordCounts(words.pools[0], v)) + 1.;
  const auto prior_target = n::sum(labels, {0}) + 1.;
  n::ParameterStore p(331, n::DType::Float64);
  const auto chars = p.get("character_counts", {2, 69}, n::init::zeros());
  const auto tokens = p.get("word_counts", {2, v}, n::init::zeros());
  const auto classes = p.get("class_counts", {2}, n::init::zeros());
  n::OptimizerConfig options;
  options.kind = n::OptimizerKind::Sgd;
  n::Optimizer sgd(p, .5, options);
  sgd.minimize(n::sum(n::square(chars - char_target)) +
               n::sum(n::square(tokens - word_target)) +
               n::sum(n::square(classes - prior_target)));
  const auto log_chars = n::log(chars / n::sum(chars, {1}, true));
  const auto log_words = n::log(tokens / n::sum(tokens, {1}, true));
  const auto prior = n::log(classes / n::sum(classes));
  const auto c = (n::matmul(m::CharacterCounts(test), n::transpose(log_chars, {1, 0})) + prior)
                     .to(n::DType::Float32);
  const auto w =
      (n::matmul(m::SentenceWordCounts(words.pools[2], v), n::transpose(log_words, {1, 0})) +
       prior)
          .to(n::DType::Float32);
  const auto ce = n::max(n::abs(c - m::CharacterNB(fit, test)));
  const auto we = n::max(n::abs(w - m::SentenceNB(words.pools[0], words.pools[2], v)));
  if (ce.item() != 0 || we.item() != 0)
    return 1;
  n::save_npz(
      "build/character_cnn_sgd_refs.npz",
      {{"character_counts", chars}, {"word_counts", tokens}, {"class_counts", classes}});
  std::print("One explicit SGD(.5) step fits{} values;all200 character/word score parities "
             "{:.3g}/{:.3g}.\n",
             p.count(), ce.item(), we.item());
  const auto ratio = n::select(log_chars, 0, 1) - n::select(log_chars, 0, 0);
  auto a = dm::graphics::RPlot::create(), b = dm::graphics::RPlot::create();
  a.lines(n::arange(0, 69).to_vector<double>(), ratio.to_vector<double>(),
          "character log ratio", {147, 51, 234})
      .title("All fitted character log ratios")
      .x_label("original alphabet slot")
      .y_label("log P(slot|positive)/P(slot|negative)");
  const auto measured = n::stack({m::ScoreSequenceClassifier(c, test.labels).accuracy,
                                  m::ScoreSequenceClassifier(w, test.labels).accuracy},
                                 0);
  b.points(n::arange(0, 2).to_vector<double>(), measured.to_vector<double>(),
           "held-out accuracy", {37, 99, 235})
      .title("Unchanged fitted count references")
      .x_label("0last256bytes /1first64words")
      .y_label("correct original review fraction")
      .y_limits(0, 1);
  auto layout = dm::graphics::RLayout::create(1, 2);
  layout.add(a).add(b).size(1100, 500).fit_panels().save_svg(
      "build/character_cnn_reference.svg");
}
```
