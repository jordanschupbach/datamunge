> Every momentum SGD update and both dropout layers

Warm all18 leaves before constructing tensor Momentum SGD(.01,.9).
Use the declared source seed2,dropout367,batch-order383,keep.5 after each
dense layer,batch50 and three epochs. A balanced first25 fitting rows per
class derivative probe advances the same dropout generator before training.
The old probe assumed2000 rows and has been corrected for the actual1000-row
pool. Seeds are declared in advance;no held-out seed search is performed here.
Validation CE chooses the checkpoint;held-out labels never select it.
```{cpp, results="markdown", file="figures/character_cnn_training.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

#include <print>
int main() {
  namespace n = dm::nn;
  namespace m = n::models;
  n::set_num_threads(2);

  std::filesystem::path cache;
  if (const auto *p = std::getenv("DATAMUNGE_DATA_DIR"))
    cache = p;
  else if (const auto *p = std::getenv("XDG_CACHE_HOME"))
    cache = std::filesystem::path(p) / "datamunge/datasets";
  else
    cache = std::filesystem::path(std::getenv("HOME")) / ".cache/datamunge/datasets";

  std::filesystem::path root = cache / "character";
  if (const auto *p = std::getenv("DATAMUNGE_CHARACTER_DIR"))
    root = p;
  else {
    dm::datasets::prepare_example_data("text", cache.string());
    root = cache / "character";
  }
  const auto split = m::LoadCharacters(root);
  const auto &fit = split.pools[0];
  const auto &validation = split.pools[1];
  const auto &test = split.pools[2];

  const auto c = split.config;
  n::ParameterStore p(2);
  n::Generator dropout(367);
  {
    n::NoGradGuard guard;
    m::CharacterCnn(p, n::zeros({1, c.time}, n::DType::Int32), n::ones({1}, n::DType::Int32),
                    c);
  }
  auto infer = [&](const m::CharacterData &d) {
    n::NoGradGuard guard;
    std::vector<n::Tensor> parts;
    for (std::int64_t start = 0; start < d.size(); start += 50) {
      std::vector<std::int64_t> rows;
      for (auto i = start; i < std::min<std::int64_t>(start + 50, d.size()); ++i)
        rows.push_back(i);
      const auto b = m::SentenceRows(d, rows);
      parts.push_back(m::CharacterCnn(p, b.tokens, b.lengths, c).logits);
    }
    return n::concat(parts, 0);
  };
  std::vector<std::int64_t> probe_ids;
  int seen[2] = {0, 0};
  const auto label_ids = fit.labels.to_vector<int>();
  for (std::int64_t row = 0; row < fit.size() && probe_ids.size() < 50; ++row)
    if (seen[label_ids[row]] < 25) {
      probe_ids.push_back(row);
      ++seen[label_ids[row]];
    }
  const auto probe = m::SentenceRows(fit, probe_ids);
  const auto initial = m::SequenceCrossEntropy(infer(probe), probe.labels);
  const auto untrained = infer(test);
  const auto checked = m::CharacterCnn(p, probe.tokens, probe.lengths, c, true, .5, &dropout);
  for (const auto &g :
       n::grad(m::SequenceCrossEntropy(checked.logits, probe.labels), p.parameters()))
    if (!n::all(n::is_finite(g)).item<bool>() || n::sum(n::square(g)).item() <= 0)
      return 1;
  n::OptimizerConfig options;
  options.kind = n::OptimizerKind::Momentum;
  options.momentum = .9;
  n::Optimizer sgd(p, .01, options);
  n::BatchOrder order(fit.size(), 50, 383);
  double best = INFINITY;
  int selected = 0, updates = 0;
  std::vector<n::Tensor> history;
  std::print("| epoch | dropout fitting CE | validation CE |\n|---:|---:|---:|\n");
  for (int epoch = 1; epoch <= 3; ++epoch) {
    order.begin_epoch();
    auto average = n::zeros({}, n::DType::Float64);
    for (;;) {
      const auto rows = order.next();
      if (rows.empty())
        break;
      const auto batch = m::SentenceRows(fit, rows);
      const auto out = m::CharacterCnn(p, batch.tokens, batch.lengths, c, true, .5, &dropout);
      const auto loss = m::SequenceCrossEntropy(out.logits, batch.labels);
      average = average +
                loss.detach().to(n::DType::Float64) * double(rows.size()) / double(fit.size());
      sgd.step(n::grad(loss, p.parameters()));
      ++updates;
    }
    const auto val = m::SequenceCrossEntropy(infer(validation), validation.labels);
    if (val.item() < best) {
      best = val.item();
      selected = epoch;
      n::NamedTensors arrays;
      for (std::size_t i = 0; i < p.size(); ++i)
        arrays.push_back({p.names()[i], p.parameters()[i]});
      n::save_npz("build/character_cnn_best.npz", arrays);
    }
    history.push_back(n::stack({average, val.to(n::DType::Float64)}, 0));
    std::print("| {} | {:.6f} | {:.6f} |\n", epoch, average.item(), val.item());
  }
  for (const auto &[name, value] : n::load_npz("build/character_cnn_best.npz"))
    p.set(name, value);
  const auto fitted = m::SequenceCrossEntropy(infer(probe), probe.labels);
  n::save_npz("build/character_cnn_outputs.npz",
              {{"logits", infer(test)}, {"untrained", untrained}});
  std::print("{} explicit momentum SGD updates;selected epoch {},validation {:.6f};balanced "
             "fitting probe {:.6f}->{:.6f}.\n",
             updates, selected, best, initial.item(), fitted.item());
  const auto hist = n::stack(history, 0);
  auto plot = dm::graphics::RPlot::create();
  plot.lines(n::arange(1, 4).to_vector<double>(), n::select(hist, 1, 0).to_vector<double>(),
             "dropout fit", {37, 99, 235})
      .lines(n::arange(1, 4).to_vector<double>(), n::select(hist, 1, 1).to_vector<double>(),
             "inference validation", {220, 38, 38})
      .title("Sixty explicit momentum SGD updates")
      .x_label("epoch;20 batches each")
      .y_label("categorical cross-entropy")
      .y_limits(.66, .74);
  plot.save_svg("build/character_cnn_training.svg");
}
```
