> All60 Adadelta updates and every head projection are visible

Warm all9 learned leaves before constructing the tensor Adadelta optimizer.
Initialize317,dropout generator313,batch-order331. An explicit50-review
dropout derivative probe checks all9 leaves before training and advances
that same generator,matching the source. Every batch of50 fitting reviews
uses keep.5 dropout,stable categorical CE,grad,Adadelta step and a separate
head-column projection. Three epochs use all1000 fitting reviews once each:
60 updates. There is no BN or learned input normalization.

Validation dropout-free CE selects the learned checkpoint. Save the selected
and untrained held-out logits for the independent observed-input restore test.
Only the nine learned tensors are needed for deployment;no optimizer histories,
labels or dropout generator enter inference.
```{cpp, results="markdown", file="figures/kim_sentence_cnn_training.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

#include <print>
int main() {
  namespace n = dm::nn;
  namespace m = n::models;
  n::set_num_threads(2);

  std::filesystem::path cache;
  if (const auto *p = std::getenv("DATAMUNGE_DATA_DIR"))
    cache = p;
  else if (const auto *p = std::getenv("XDG_CACHE_HOME"))
    cache = std::filesystem::path(p) / "datamunge/datasets";
  else
    cache = std::filesystem::path(std::getenv("HOME")) / ".cache/datamunge/datasets";

  std::filesystem::path root = cache / "sentence";
  if (const auto *p = std::getenv("DATAMUNGE_SENTENCE_DIR"))
    root = p;
  else {
    dm::datasets::prepare_example_data("text", cache.string());
    root = cache / "sentence";
  }
  const auto split = m::LoadSentences(root);
  const auto &fit = split.pools[0];
  const auto &validation = split.pools[1];
  const auto &test = split.pools[2];

  const auto c = split.config;
  n::ParameterStore p(317);
  n::Generator dropout(313);
  {
    n::NoGradGuard guard;
    m::KimCnn(p, n::zeros({1, c.time}, n::DType::Int32), n::ones({1}, n::DType::Int32), c);
  }
  auto infer = [&](const m::SentenceData &d) {
    n::NoGradGuard guard;
    std::vector<n::Tensor> parts;
    for (std::int64_t start = 0; start < d.size(); start += 50) {
      std::vector<std::int64_t> rows;
      for (auto i = start; i < std::min<std::int64_t>(start + 50, d.size()); ++i)
        rows.push_back(i);
      const auto b = m::SentenceRows(d, rows);
      parts.push_back(m::KimCnn(p, b.tokens, b.lengths, c).logits);
    }
    return n::concat(parts, 0);
  };
  std::vector<std::int64_t> first50;
  for (int i = 0; i < 50; ++i)
    first50.push_back(i);
  const auto probe = m::SentenceRows(fit, first50);
  const double initial = m::SequenceCrossEntropy(infer(probe), probe.labels).item();
  const auto untrained = infer(test);
  const auto checked = m::KimCnn(p, probe.tokens, probe.lengths, c, true, .5, &dropout);
  const auto probe_gradients =
      n::grad(m::SequenceCrossEntropy(checked.logits, probe.labels), p.parameters());
  for (const auto &g : probe_gradients)
    if (!n::all(n::is_finite(g)).item<bool>() || n::sum(n::square(g)).item() <= 0)
      return 1;
  n::OptimizerConfig options;
  options.kind = n::OptimizerKind::Adadelta;
  options.rho = .95;
  options.epsilon = 1e-6;
  n::Optimizer adadelta(p, 1., options);
  n::BatchOrder order(fit.size(), 50, 331);
  std::vector<n::Tensor> history, head_norms;
  double best = INFINITY;
  int selected = 0, updates = 0;
  std::print("| epoch | dropout fitting CE | validation CE | maximum projected head norm "
             "|\n|---:|---:|---:|---:|\n");
  for (int epoch = 1; epoch <= 3; ++epoch) {
    order.begin_epoch();
    auto average = n::zeros({}, n::DType::Float64);
    for (;;) {
      const auto rows = order.next();
      if (rows.empty())
        break;
      const auto batch = m::SentenceRows(fit, rows);
      const auto out = m::KimCnn(p, batch.tokens, batch.lengths, c, true, .5, &dropout);
      const auto loss = m::SequenceCrossEntropy(out.logits, batch.labels);
      average = average +
                loss.detach().to(n::DType::Float64) * double(rows.size()) / double(fit.size());
      adadelta.step(n::grad(loss, p.parameters()));
      {
        n::NoGradGuard guard;
        auto head = p.at("classifier/W");
        head.copy_(m::KimMaxNorm(head));
        head_norms.push_back(n::sqrt(n::sum(n::square(head), {0})).detach());
      }
      ++updates;
    }
    const auto val = m::SequenceCrossEntropy(infer(validation), validation.labels);
    if (val.item() < best) {
      best = val.item();
      selected = epoch;
      n::NamedTensors arrays;
      for (std::size_t i = 0; i < p.size(); ++i)
        arrays.push_back({p.names()[i], p.parameters()[i]});
      n::save_npz("build/kim_sentence_cnn_best.npz", arrays);
    }
    history.push_back(n::stack({average, val.to(n::DType::Float64)}, 0));
    std::print("| {} | {:.6f} | {:.6f} | {:.6f} |\n", epoch, average.item(), val.item(),
               n::max(head_norms.back()).item());
  }
  for (const auto &[name, value] : n::load_npz("build/kim_sentence_cnn_best.npz"))
    p.set(name, value);
  const auto fitted = m::SequenceCrossEntropy(infer(probe), probe.labels);
  const auto logits = infer(test);
  n::save_npz("build/kim_sentence_cnn_outputs.npz",
              {{"logits", logits}, {"untrained", untrained}});
  int slots = 0;
  for (const auto &[name, value] : adadelta.state())
    slots += name.starts_with("accum/") || name.starts_with("accum_update/");
  std::print("{} explicit Adadelta+projection updates;{} actual RMS-history arrays;selected "
             "epoch {},validation {:.6f};fixed inference probe {:.6f}->{:.6f}.\n",
             updates, slots, selected, best, initial, fitted.item());
  const auto hist = n::stack(history, 0);
  const auto norms = n::stack(head_norms, 0);
  auto a = dm::graphics::RPlot::create(), b = dm::graphics::RPlot::create();
  const auto epochs = n::arange(1, 4).to_vector<double>();
  a.lines(epochs, n::select(hist, 1, 0).to_vector<double>(), "dropout fit", {37, 99, 235})
      .lines(epochs, n::select(hist, 1, 1).to_vector<double>(), "inference val", {220, 38, 38})
      .title("Sixty explicit Adadelta updates")
      .x_label("epoch;20 minibatches each")
      .y_label("categorical cross-entropy")
      .y_limits(.5, .85);
  const auto steps = n::arange(1, updates + 1).to_vector<double>();
  b.lines(steps, n::select(norms, 1, 0).to_vector<double>(), "negative head", {220, 38, 38})
      .lines(steps, n::select(norms, 1, 1).to_vector<double>(), "positive head", {37, 99, 235})
      .title("Every explicit head projection")
      .x_label("optimizer update")
      .y_label("projected column Euclidean norm")
      .y_limits(0, 3.5);
  auto layout = dm::graphics::RLayout::create(1, 2);
  layout.add(a).add(b).size(1100, 500).fit_panels().save_svg(
      "build/kim_sentence_cnn_training.svg");
}
```
