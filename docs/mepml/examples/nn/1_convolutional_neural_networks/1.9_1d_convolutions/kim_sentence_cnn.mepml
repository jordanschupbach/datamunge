> Structural PAD0 and wide3/4/5 convolution

Only rows1..V-1 of the embedding table learn;row0 is a structural zero.
Observed lengths mask gathered embeddings before padding4 zeros on each side.
Parallel VALID kernels3/4/5 produce lengthsT+6/T+5/T+4,then ReLU and maximum
over all branch times. Wide boundary windows remain candidates and can carry
learned bias;this is the source wide-convolution policy,not masked-window
pooling. Concatenate the three pooled vectors,apply optional dropout,and
use a linear binary head. Source initializers are U(-.25,.25) embeddings and
Glorot-uniform convolution/head weights,with zero biases.

The following actual fitting observations show initialized features,not
interpretations of a trained predictor. Replacing legal token IDs beyond
observed length has exact zero effect. PAD0's full-table input adjoint is0.
```{cpp, results="markdown", file="figures/kim_sentence_cnn_features.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

#include <print>
int main() {
  namespace n = dm::nn;
  namespace m = n::models;
  n::set_num_threads(2);

  std::filesystem::path cache;
  if (const auto *p = std::getenv("DATAMUNGE_DATA_DIR"))
    cache = p;
  else if (const auto *p = std::getenv("XDG_CACHE_HOME"))
    cache = std::filesystem::path(p) / "datamunge/datasets";
  else
    cache = std::filesystem::path(std::getenv("HOME")) / ".cache/datamunge/datasets";

  std::filesystem::path root = cache / "sentence";
  if (const auto *p = std::getenv("DATAMUNGE_SENTENCE_DIR"))
    root = p;
  else {
    dm::datasets::prepare_example_data("text", cache.string());
    root = cache / "sentence";
  }
  const auto split = m::LoadSentences(root);
  const auto &fit = split.pools[0];
  const auto &validation = split.pools[1];
  const auto &test = split.pools[2];

  const auto d = m::SentenceRows(fit, {0, 1});
  n::ParameterStore p(317);
  const auto out = m::KimCnn(p, d.tokens, d.lengths, split.config);
  const auto gradient = n::grad(n::sum(n::square(out.logits)), {out.embedding})[0];
  n::NoGradGuard guard;
  const auto active = m::LengthMask(d.lengths, 64, n::DType::Bool);
  const auto changed = n::where(active, d.tokens, 1.);
  const auto parity =
      n::max(n::abs(m::KimCnn(p, changed, d.lengths, split.config).logits - out.logits));
  std::print("Wide branch lengths {}/{}/{};{} pooled channels;structural PAD0 norm {:.3g},PAD "
             "adjoint {:.3g},padding-substitution parity {:.3g}.\n",
             out.maps[0].size(1), out.maps[1].size(1), out.maps[2].size(1),
             out.features.size(1), n::max(n::abs(n::select(out.embedding, 0, 0))).item(),
             n::max(n::abs(n::select(gradient, 0, 0))).item(), parity.item());
  auto a = n::plot_tensor_map(n::reverse(n::select(out.maps[0], 0, 0), {0}), 0,
                              n::max(out.maps[0]).item()),
       b = n::plot_tensor_map(n::reverse(n::select(out.features, 0, 0).reshape({3, 32}), {0}),
                              0, n::max(out.features).item());
  a.title("Actual first review:wide3 ReLU map")
      .x_label("initialized filter channel")
      .y_label("wide position0 at bottom");
  b.title("All three max-pooled branches")
      .x_label("filter channel")
      .y_label("kernel3 at bottom,4,5");
  auto layout = dm::graphics::RLayout::create(1, 2);
  layout.add(a).add(b).size(1100, 500).fit_panels().save_svg(
      "build/kim_sentence_cnn_features.svg");
}
```
