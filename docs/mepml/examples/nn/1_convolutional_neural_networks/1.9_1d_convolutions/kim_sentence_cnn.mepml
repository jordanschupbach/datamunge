> Adadelta and the head constraint stay explicit

Use the library tensor optimizer,OptimizerKind::Adadelta,learning-rate multiplier1,
rho.95,epsilon1e-6 and zero history. After each update,project only the head
kernel's columns to norm<=3 under NoGradGuard. Biases,embeddings and word filters
are not projected. The ordinary optimizer captures warmed learned leaves;
its history remains internal and inspectable through state(). A legacy naming
adapter delegates to this same optimizer and preserves the old slot fixture API.

The declared signed-gradient fixture exposes both RMS histories and the head
projection. Native checks compare all three steps,every state coordinate and
both head column norms against an independent literal Adadelta oracle.
```{cpp, results="markdown", file="figures/kim_sentence_cnn_adadelta.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

#include <print>
int main() {
  namespace n = dm::nn;
  namespace m = n::models;
  n::ParameterStore p(347);
  auto w = p.get("classifier/W", {2, 2}, n::init::zeros());
  {
    n::NoGradGuard guard;
    w.copy_(n::tensor({3., .1, 4., .2}, {2, 2}));
  }
  n::OptimizerConfig options;
  options.kind = n::OptimizerKind::Adadelta;
  options.rho = .95;
  options.epsilon = 1e-6;
  n::Optimizer adadelta(p, 1., options);
  std::vector<n::Tensor> norms;
  std::print("| step | pre-projection column norms | post-projection column norms "
             "|\n|---:|---|---|\n");
  for (int step = 0; step < 3; ++step) {
    const auto gradient = (n::arange(1, 5) * .2 * (step == 1 ? -1. : 1.)).reshape({2, 2});
    adadelta.step({gradient});
    n::NoGradGuard guard;
    const auto before = n::sqrt(n::sum(n::square(w), {0}));
    w.copy_(m::KimMaxNorm(w));
    const auto after = n::sqrt(n::sum(n::square(w), {0}));
    norms.push_back(n::stack({before, after}, 0));
    std::print("| {} | {} | {} |\n", step + 1, before, after);
  }
  n::Tensor gradient_history, update_history;
  for (const auto &[name, value] : adadelta.state()) {
    if (name == "accum/0")
      gradient_history = value;
    else if (name == "accum_update/0")
      update_history = value;
  }

  const auto gh = gradient_history.reshape({4}), uh = update_history.reshape({4}) * 1e6;
  std::print("Gradient history {},update history {} (unscaled values).\n", gradient_history,
             update_history);
  auto a = dm::graphics::RPlot::create(), b = dm::graphics::RPlot::create();
  const auto coordinates = n::arange(0, 4).to_vector<double>();
  a.bars(coordinates, gh.to_vector<double>(), "gradient RMS2", {37, 99, 235})
      .title("Actual squared-gradient history")
      .x_label("feature-major weight coordinate")
      .y_label("exponential squared-gradient history")
      .y_limits(0, (n::max(gh) * 1.25).item());
  b.bars(coordinates, uh.to_vector<double>(), "update RMS2", {220, 38, 38})
      .title("Nearly equal adaptive update history")
      .x_label("feature-major weight coordinate")
      .y_label("squared-update history times1e6")
      .y_limits(0, (n::max(uh) * 1.25).item());
  auto layout = dm::graphics::RLayout::create(1, 2);
  layout.add(a).add(b).size(1100, 500).fit_panels().save_svg(
      "build/kim_sentence_cnn_adadelta.svg");
}
```
