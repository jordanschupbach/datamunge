> Full and compact CNN-rand keep all word windows

The original full metadata usesV8000,T64,E300,F100. The actual compact
fit usesV5161,E32,F32. Both retain9 learned leaves and parallel3/4/5 branches.
The full graph executes every learned derivative in the native suite;all80
tiny-model parameter coordinates also match independent host finite differences.
No pretrained embeddings or paper cross-validation accuracy are implied.

For the unigram reference,fit2*V token-count fields and2 class-count fields
with one explicit Double SGD(.5) step on summed squared count error. Targets
are add-one fitting class-token/class-frequency counts. Normalize and score
those learned fields;the closed-form tensor NB helper is only a parity oracle.
The count objective is declared separately from the neural CE objective.
```{cpp, results="markdown", file="figures/kim_sentence_cnn_reference.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

#include <fstream>
#include <print>
int main() {
  namespace n = dm::nn;
  namespace m = n::models;
  n::set_num_threads(2);

  std::filesystem::path cache;
  if (const auto *p = std::getenv("DATAMUNGE_DATA_DIR"))
    cache = p;
  else if (const auto *p = std::getenv("XDG_CACHE_HOME"))
    cache = std::filesystem::path(p) / "datamunge/datasets";
  else
    cache = std::filesystem::path(std::getenv("HOME")) / ".cache/datamunge/datasets";

  std::filesystem::path root = cache / "sentence";
  if (const auto *p = std::getenv("DATAMUNGE_SENTENCE_DIR"))
    root = p;
  else {
    dm::datasets::prepare_example_data("text", cache.string());
    root = cache / "sentence";
  }
  const auto split = m::LoadSentences(root);
  const auto &fit = split.pools[0];
  const auto &validation = split.pools[1];
  const auto &test = split.pools[2];

  std::print("| graph | vocabulary | embedding | filters/branch | learned values | leaves | "
             "maps | pooled |\n|---|---:|---:|---:|---:|---:|---|---|\n");
  for (bool compact : {false, true}) {
    const auto c = compact ? split.config : m::KimConfig{};
    n::ParameterStore p(317);
    n::NoGradGuard guard;
    const auto out =
        m::KimCnn(p, n::ones({2, 64}, n::DType::Int32), n::full({2}, 3., n::DType::Int32), c);
    std::print("| {} | {} | {} | {} | {} | {} | {}/{}/{} | {} |\n",
               compact ? "actual compact" : "full", c.vocabulary, c.embedding, c.filters,
               p.count(), p.size(), out.maps[0].shape(), out.maps[1].shape(),
               out.maps[2].shape(), out.features.shape());
  }
  const int v = split.config.vocabulary;
  const auto x = m::SentenceWordCounts(fit, v);
  const auto y = m::SentenceWordCounts(test, v);
  const auto labels = n::one_hot(fit.labels, 2, 1., 0., n::DType::Float64);
  const auto target = n::matmul(n::transpose(labels, {1, 0}), x) + 1.;
  const auto prior_target = n::sum(labels, {0}) + 1.;
  n::ParameterStore counts(331, n::DType::Float64);
  const auto words = counts.get("word_counts", {2, v}, n::init::zeros());
  const auto classes = counts.get("class_counts", {2}, n::init::zeros());
  n::OptimizerConfig options;
  options.kind = n::OptimizerKind::Sgd;
  n::Optimizer sgd(counts, .5, options);
  sgd.minimize(n::sum(n::square(words - target)) + n::sum(n::square(classes - prior_target)));
  const auto log_words = n::log(words / n::sum(words, {1}, true));
  const auto log_prior = n::log(classes / n::sum(classes));
  const auto logits =
      (n::matmul(y, n::transpose(log_words, {1, 0})) + log_prior).to(n::DType::Float32);
  const auto parity = n::max(n::abs(logits - m::SentenceNB(fit, test, v)));
  if (parity.item() != 0)
    return 1;
  std::filesystem::create_directories("build");
  n::save_npz("build/kim_sentence_cnn_sgd_nb.npz",
              {{"word_counts", words.detach()}, {"class_counts", classes.detach()}});
  std::print(
      "One explicit SGD(.5) step fits{} count values;every held-out NB score parity {:.3g}.\n",
      counts.count(), parity.item());
  const auto relative = n::select(log_words, 0, 1) - n::select(log_words, 0, 0);
  const auto ordered = n::argsort(relative, true);
  const auto positive = n::slice_axis(ordered, 0, 0, 12);
  const auto negative = n::slice_axis(n::argsort(relative), 0, 0, 12);

  std::vector<std::string> vocabulary_words;
  std::ifstream vocabulary_file(root / "vocabulary.txt");
  std::string term;
  while (std::getline(vocabulary_file, term))
    vocabulary_words.push_back(term);
  const auto negative_ids = negative.to_vector<std::int64_t>(),
             positive_ids = positive.to_vector<std::int64_t>();
  const auto negative_values = n::gather(relative, negative, 0).to_vector<double>(),
             positive_values = n::gather(relative, positive, 0).to_vector<double>();
  std::print("\n| tail rank | negative word | fitted log ratio | positive word | fitted log "
             "ratio |\n|---:|---|---:|---|---:|\n");
  for (int i = 0; i < 12; ++i)
    std::print("| {} | {} | {:.6f} | {} | {:.6f} |\n", i, vocabulary_words[negative_ids[i]],
               negative_values[i], vocabulary_words[positive_ids[i]], positive_values[i]);

  auto a = dm::graphics::RPlot::create(), b = dm::graphics::RPlot::create();
  a.bars(n::arange(0, 12).to_vector<double>(),
         n::gather(relative, negative, 0).to_vector<double>(), "negative words", {220, 38, 38})
      .title("Fitted negative word log ratios")
      .x_label("rank within negative tail")
      .y_label("log P(word|positive)/P(word|negative)")
      .y_limits((n::min(n::gather(relative, negative, 0)) * 1.15).item(), .4);
  b.bars(n::arange(0, 12).to_vector<double>(),
         n::gather(relative, positive, 0).to_vector<double>(), "positive words", {37, 99, 235})
      .title("Fitted positive word log ratios")
      .x_label("rank within positive tail")
      .y_label("log P(word|positive)/P(word|negative)");
  auto layout = dm::graphics::RLayout::create(1, 2);
  layout.add(a).add(b).size(1100, 500).fit_panels().save_svg(
      "build/kim_sentence_cnn_reference.svg");
}
