> Genuine movie-review words and a fitting-only vocabulary

Use the official Pang/Lee MR sentence-polarity v1.0 archive,487,770bytes,
SHA256a05befe52aafda71d458d188a1c54506a998b1308613ba76bbda2e5029409ce9.
There are5331 negative and5331 positive source snippets. ASCII lowercase
word/digit/apostrophe tokenization retains the first64 tokens. Group identical
truncated word sequences,exclude conflicting-label groups,then select balanced
500fit/100validation/100test per class with source std::mt19937seed337.
Final pool order is shuffled:1000fit,200validation,200test. Original source
line IDs remain disjoint. This is a custom holdout,not published cross-validation.

Only fitting words rank the vocabulary by frequency then lexical ties,max7998
plus PAD0/UNK1. The actual inventory has5161 classes;there are no pretrained
embeddings. Unknown held-out words use1,right padding0. Both the token matrix
and the original source text/labels remain in the manifest and reviews.tsv.
Word and later raw-character examples share exactly these original source rows.

```{cpp, flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
  const std::filesystem::path cache = dm::datasets::data_home();
  dm::datasets::prepare_example_data("text", cache);
}
```
// result_begin:
// result_end

All numerical counts use tensor segment reductions,avoiding a huge[N,T,V]
onehot cube. The plots show every original sequence length and actual fitting
word frequencies. String dictionaries/rank labels are presentation metadata.
```{cpp, results="markdown", file="figures/kim_sentence_cnn_data.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

#include <fstream>
#include <print>
int main() {
  namespace n = dm::nn;
  namespace m = n::models;
  n::set_num_threads(2);

  std::filesystem::path cache;
  if (const auto *p = std::getenv("DATAMUNGE_DATA_DIR"))
    cache = p;
  else if (const auto *p = std::getenv("XDG_CACHE_HOME"))
    cache = std::filesystem::path(p) / "datamunge/datasets";
  else
    cache = std::filesystem::path(std::getenv("HOME")) / ".cache/datamunge/datasets";

  std::filesystem::path root = cache / "sentence";
  if (const auto *p = std::getenv("DATAMUNGE_SENTENCE_DIR"))
    root = p;
  else {
    dm::datasets::prepare_example_data("text", cache.string());
    root = cache / "sentence";
  }
  const auto split = m::LoadSentences(root);
  const auto &fit = split.pools[0];
  const auto &validation = split.pools[1];
  const auto &test = split.pools[2];

  std::vector<std::string> words;
  std::ifstream vocabulary(root / "vocabulary.txt");
  std::string word;
  while (std::getline(vocabulary, word))
    words.push_back(word);
  if (words.size() != std::size_t(split.config.vocabulary))
    return 1;
  auto a = dm::graphics::RPlot::create(), b = dm::graphics::RPlot::create();
  const std::array<dm::graphics::RGB, 3> colors = {
      {{37, 99, 235}, {220, 38, 38}, {22, 163, 74}}};
  std::print("| split | source snippets | negative/positive | mean observed words | "
             "unknown-word fraction |\n|---|---:|---|---:|---:|\n");
  int index = 0;
  for (const auto &item : std::vector<std::pair<std::string, m::SentenceData>>{
           {"fitting", fit}, {"validation", validation}, {"test", test}}) {
    const auto active = m::LengthMask(item.second.lengths, 64, n::DType::Bool);
    const auto unknown =
        n::sum(
            n::logical_and(active, n::equal(item.second.tokens, 1.)).to(n::DType::Float64)) /
        n::sum(active.to(n::DType::Float64));
    const auto counts =
        n::unsorted_segment_sum(n::ones({item.second.size()}, n::DType::Float64),
                                item.second.lengths.to(n::DType::Int64), 65);
    a.lines(n::arange(0, 65).to_vector<double>(), counts.to_vector<double>(), item.first,
            colors[index++]);
    std::print("| {} | {} | {} | {:.6f} | {:.6f} |\n", item.first, item.second.size(),
               n::sum(n::one_hot(item.second.labels, 2), {0}),
               n::mean(item.second.lengths.to(n::DType::Float64)).item(), unknown.item());
  }
  a.title("Every original observed word length")
      .x_label("retained word count,cap64")
      .y_label("source snippets at that length");
  const auto counts = n::sum(m::SentenceWordCounts(fit, split.config.vocabulary), {0});
  const auto top = n::slice_axis(n::argsort(counts, true), 0, 0, 20);
  const auto values = n::gather(counts, top, 0);
  b.bars(n::arange(0, 20).to_vector<double>(), values.to_vector<double>(), "fitting words",
         {147, 51, 234})
      .title("Top20 actual fitting word counts")
      .x_label("frequency rank (see table)")
      .y_label("observed fitting occurrences");
  std::print("\n| rank | fitting word | count |\n|---:|---|---:|\n");
  const auto ids = top.to_vector<std::int64_t>();
  const auto numeric = values.to_vector<std::int64_t>();
  for (int i = 0; i < 20; ++i)
    std::print("| {} | {} | {} |\n", i, words[ids[i]], numeric[i]);
  auto layout = dm::graphics::RLayout::create(1, 2);
  layout.add(a).add(b).size(1100, 500).fit_panels().save_svg(
      "build/kim_sentence_cnn_data.svg");
}
```
