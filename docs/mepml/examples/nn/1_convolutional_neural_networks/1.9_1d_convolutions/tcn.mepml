> Weight normalization separates direction and gain

Each convolution stores v,g,b. The effective kernel per output channel is
W=g*v/sqrt(sum(v*v)+1e-12). v initializes N(0,.01),g=sqrt(2.f),b0.
Scaling v changes its raw norm while leaving the effective direction/gain
approximately invariant;the epsilon and Float32 rounding prevent an exact
mathematical scale-invariance claim. Both v and g remain learned leaves.
The report explicitly computes their gradients and the actual forward change
under a declared v-scale intervention. No optimization hides inside the layer.
```{cpp, results="markdown", file="figures/tcn_weight_normalization.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

#include <print>
int main() {
  namespace n = dm::nn;
  namespace m = n::models;
  n::set_num_threads(2);
  n::ParameterStore p(461);
  const auto input = (.5 + .2 * n::sin(n::arange(0, 2 * 20 * 2) * .13)).reshape({2, 20, 2});
  const auto y = m::TcnCausalConv(p, "probe", input, 4, 3, 2);
  const auto gradients = n::grad(n::sum(n::square(y)), p.parameters());
  const auto v = p.at("probe/v").clone();
  const auto g = p.at("probe/g");
  const auto raw = n::sqrt(n::sum(n::square(v), {0, 1, 2}));
  const auto weight = v * g / n::sqrt(n::sum(n::square(v), {0, 1, 2}) + 1e-12);
  const auto effective = n::sqrt(n::sum(n::square(weight), {0, 1, 2}));
  n::NoGradGuard guard;
  p.set("probe/v", v * 3.);
  const auto scaled = m::TcnCausalConv(p, "probe", input, 4, 3, 2);
  std::print("All v/g/b adjoint norms {:.6f}/{:.6f}/{:.6f};v*=3 forward max change {:.9g} "
             "including epsilon/Float32 rounding.\n",
             n::sqrt(n::sum(n::square(gradients[0]))).item(),
             n::sqrt(n::sum(n::square(gradients[1]))).item(),
             n::sqrt(n::sum(n::square(gradients[2]))).item(),
             n::max(n::abs(scaled - y)).item());
  auto a = dm::graphics::RPlot::create(), b = dm::graphics::RPlot::create();
  const auto channels = n::arange(0, 4).to_vector<double>();
  a.points(channels, raw.to_vector<double>(), "raw v norm", {37, 99, 235})
      .points(channels, (raw * 3.).to_vector<double>(), "scaled v norm", {220, 38, 38})
      .title("Raw direction vectors change norm")
      .x_label("output channel")
      .y_label("v kernel Euclidean norm");
  b.points(channels, effective.to_vector<double>(), "effective norm", {37, 99, 235})
      .points(channels, g.to_vector<double>(), "learned gain", {22, 163, 74})
      .title("Effective kernels retain their gain")
      .x_label("output channel")
      .y_label("effective W norm and g")
      .y_limits(0, 1.8);
  auto layout = dm::graphics::RLayout::create(1, 2);
  layout.add(a).add(b).size(1100, 500).fit_panels().save_svg(
      "build/tcn_weight_normalization.svg");
}
```
