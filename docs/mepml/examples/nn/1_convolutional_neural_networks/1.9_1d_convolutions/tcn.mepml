> Clip tensor gradients and show all15 Adam updates

Warm all40 learned and2 normalization leaves before Adam(.001). Keep.8
training dropout uses generator457;initial learned/state stores use461/463.
One visible full-fitting dropout derivative probe checks every leaf before
training and advances that same generator,matching the source workflow.
Batch order seed467 uses all40 fitting records,batch8,three epochs.

For each update,reduce squared gradient norms with tensors,then apply the
source Float32 scale min(1,1/(sqrt(sum_squared)+1e-6)). Scale all gradient
tensors before Adam. The plot shows log10 of actual unclipped and scaled norms;0 means norm1.
Validation uses dropout-free inference and selects the paired learned and
normalization checkpoint. No gradient clip,BN,normalization estimation or
optimizer hides inside forward. Compare all held-out rows with the unchanged
SGD centroid and parameter-free raw1NN references.
```{cpp, results="markdown", file="figures/tcn_training.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

#include <print>
int main() {
  namespace n = dm::nn;
  namespace m = n::models;
  n::set_num_threads(2);

  std::filesystem::path cache;
  if (const auto *p = std::getenv("DATAMUNGE_DATA_DIR"))
    cache = p;
  else if (const auto *p = std::getenv("XDG_CACHE_HOME"))
    cache = std::filesystem::path(p) / "datamunge/datasets";
  else
    cache = std::filesystem::path(std::getenv("HOME")) / ".cache/datamunge/datasets";

  std::filesystem::path root = cache / "time_series";
  if (const auto *p = std::getenv("DATAMUNGE_SERIES_DIR"))
    root = p;
  else {
    dm::datasets::prepare_example_data("signals", cache.string());
    root = cache / "time_series";
  }
  const auto split = m::LoadSeries(root);
  const auto &fit = split.pools[0];
  const auto &validation = split.pools[1];
  const auto &test = split.pools[2];

  m::TcnConfig config{8, 6, 3, split.config.mean, split.config.standard_deviation};
  n::ParameterStore p(461), state(463);
  n::Generator dropout(457);
  {
    n::NoGradGuard guard;
    m::Tcn(p, state, n::zeros({1, 4, 1}), config);
  }
  auto infer = [&](n::ParameterStore &learned, n::ParameterStore &frozen,
                   const n::Tensor &raw) {
    n::NoGradGuard guard;
    return m::Tcn(learned, frozen, raw, config);
  };
  const auto initial =
      m::ScoreSequenceClassifier(infer(p, state, fit.signals).logits, fit.labels);
  const auto untrained = infer(p, state, test.signals).logits;
  const auto probe = m::Tcn(p, state, fit.signals, config, true, .8, &dropout);
  const auto probe_gradients =
      n::grad(m::SequenceCrossEntropy(probe.logits, fit.labels), p.parameters());
  for (const auto &g : probe_gradients)
    if (!n::all(n::is_finite(g)).item<bool>() || n::sum(n::square(g)).item() <= 0)
      return 1;
  std::print("Visible dropout derivative probe:all{} learned leaves finite/nonzero before "
             "optimizer updates.\n",
             probe_gradients.size());
  n::OptimizerConfig options;
  options.kind = n::OptimizerKind::Adam;
  n::Optimizer adam(p, .001, options);
  n::BatchOrder order(fit.size(), 8, 467);
  std::vector<n::Tensor> history, clip_history;
  double best = INFINITY;
  int selected = 0, updates = 0;
  std::print("| epoch | dropout fitting CE | validation NLL |\n|---:|---:|---:|\n");
  for (int epoch = 1; epoch <= 3; ++epoch) {
    order.begin_epoch();
    auto average = n::zeros({}, n::DType::Float64);
    for (;;) {
      const auto rows = order.next();
      if (rows.empty())
        break;
      const auto batch = m::SeriesRows(fit, rows);
      const auto out = m::Tcn(p, state, batch.signals, config, true, .8, &dropout);
      const auto loss = m::SequenceCrossEntropy(out.logits, batch.labels);
      auto gradients = n::grad(loss, p.parameters());
      std::vector<n::Tensor> terms;
      for (const auto &g : gradients)
        terms.push_back(n::sum(n::square(g)).to(n::DType::Float64));
      const auto norm = n::sqrt(n::sum(n::stack(terms, 0))).to(n::DType::Float32);
      const auto scale = n::minimum(n::ones({}), 1. / (norm + 1e-6));
      for (auto &g : gradients)
        g = g * scale;
      adam.step(gradients);
      clip_history.push_back(
          n::stack({norm.detach(), (norm * scale).detach(), scale.detach()}, 0));
      average = average +
                loss.detach().to(n::DType::Float64) * double(rows.size()) / double(fit.size());
      ++updates;
    }
    const auto val = m::ScoreSequenceClassifier(infer(p, state, validation.signals).logits,
                                                validation.labels)
                         .nll;
    if (val.item() < best) {
      best = val.item();
      selected = epoch;
      n::NamedTensors arrays;
      for (std::size_t i = 0; i < p.size(); ++i)
        arrays.push_back({"p/" + p.names()[i], p.parameters()[i]});
      for (std::size_t i = 0; i < state.size(); ++i)
        arrays.push_back({"s/" + state.names()[i], state.parameters()[i]});
      n::save_npz("build/tcn_best.npz", arrays);
    }
    history.push_back(n::stack({average, val}, 0));
    std::print("| {} | {:.6f} | {:.6f} |\n", epoch, average.item(), val.item());
  }
  n::ParameterStore deployed(461), frozen(463);
  {
    n::NoGradGuard guard;
    m::Tcn(deployed, frozen, n::zeros({1, 4, 1}), m::TcnConfig{8, 6, 3, 0, 1});
  }
  const auto saved = n::load_npz("build/tcn_best.npz");
  if (saved.size() != p.size() + state.size())
    return 1;
  for (const auto &[name, value] : saved) {
    if (name.starts_with("p/")) {
      p.set(name.substr(2), value);
      deployed.set(name.substr(2), value.clone());
    } else if (name.starts_with("s/")) {
      state.set(name.substr(2), value);
      frozen.set(name.substr(2), value.clone());
    } else
      return 1;
  }
  std::vector<n::Tensor> before;
  for (const auto *store : {&deployed, &frozen})
    for (const auto &v : store->parameters())
      before.push_back(v.clone());
  const auto out = infer(deployed, frozen, test.signals);
  const auto logits = out.logits;
  const auto reference = infer(p, state, test.signals);
  const auto repeat = infer(deployed, frozen, test.signals);
  const auto parity = n::maximum(n::max(n::abs(logits - reference.logits)),
                                 n::max(n::abs(logits - repeat.logits)));
  auto prefix_error = n::zeros({});
  for (int length : {1, 17, 75, 150}) {
    const auto prefix = m::TcnPrefix(test, length);
    prefix_error =
        n::maximum(prefix_error, n::max(n::abs(infer(deployed, frozen, prefix.signals).logits -
                                               n::select(out.sequence, 1, length - 1))));
  }
  const auto raw = n::slice_axis(test.signals, 0, 0, 1);
  const auto single = infer(deployed, frozen, raw);
  const auto batch_error = n::max(n::abs(single.logits - n::slice_axis(logits, 0, 0, 1)));
  const auto time = n::arange(0, 150, 1, n::DType::Float64).reshape({1, 150, 1});
  const auto changed =
      raw +
      n::where(n::greater_equal(time, 75.), 3. * n::sin(time * .3), 0.).to(n::DType::Float32);
  const auto altered = infer(deployed, frozen, changed);
  const auto difference = n::abs(altered.sequence - single.sequence);
  const auto earlier = n::max(n::slice_axis(difference, 1, 0, 75));
  const auto later = n::sum(n::slice_axis(difference.to(n::DType::Float64), 1, 75, 150));
  bool immutable = true;
  std::size_t index = 0;
  for (const auto *store : {&deployed, &frozen})
    for (const auto &v : store->parameters())
      immutable = immutable && n::all(n::equal(before[index++], v)).item<bool>();
  if (parity.item() > 1e-5 || prefix_error.item() > 1e-5 || batch_error.item() > 1e-5 ||
      earlier.item() != 0 || later.item() <= 1e-5 || !immutable)
    return 1;
  const auto fitted =
      m::ScoreSequenceClassifier(infer(deployed, frozen, fit.signals).logits, fit.labels);
  const auto clips = n::stack(clip_history, 0);
  std::print("{} visible Adam updates,{} clipped;selected epoch {},validation {:.6f};fixed "
             "fitting CE {:.6f}->{:.6f}.\nRestored/repeat parity {:.3g},all150-row prefixes "
             "max {:.9g},single/batch {:.9g} within1e-5;{} learned/state leaves "
             "unchanged:{}.\nFuture-only observed perturbation:prefix max {:.3g},later "
             "absolute change {:.6f}.\n",
             updates,
             n::sum(n::less(n::select(clips, 1, 2), 1.).to(n::DType::Int32)).item<int>(),
             selected, best, initial.nll.item(), fitted.nll.item(), parity.item(),
             prefix_error.item(), batch_error.item(), before.size(), immutable, earlier.item(),
             later.item());
  const auto centers = n::load_npz("build/tcn_sgd_centroids.npz")[0].second;
  const auto centroid =
      (-n::mean(n::square(n::expand_dims(test.signals.to(n::DType::Float64), 1) -
                          n::expand_dims(centers, 0)),
                {2, 3}))
          .to(n::DType::Float32);
  const auto nearest = m::SeriesReference(fit, test, false);
  std::vector<n::Tensor> metrics, confusions;
  std::print(
      "| predictor | accuracy | raw-score NLL | true-row confusion |\n|---|---:|---:|---|\n");
  for (const auto &item :
       std::vector<std::pair<std::string, n::Tensor>>{{"learned", logits},
                                                      {"untrained", untrained},
                                                      {"raw1NN", nearest},
                                                      {"SGD centroid", centroid},
                                                      {"class0 tie", n::zeros_like(logits)}}) {
    const auto score = m::ScoreSequenceClassifier(item.second, test.labels);
    metrics.push_back(n::stack({score.accuracy, score.nll}, 0));
    confusions.push_back(score.confusion);
    std::print("| {} | {:.6f} | {:.6f} | {} |\n", item.first, score.accuracy.item(),
               score.nll.item(), score.confusion);
  }
  auto a = dm::graphics::RPlot::create(), b = dm::graphics::RPlot::create();
  const auto measured = n::stack(metrics, 0);
  const auto positions = n::arange(0, 5).to_vector<double>();
  a.points(positions, n::select(measured, 1, 0).to_vector<double>(), "accuracy", {37, 99, 235})
      .title("Original held-out sequence accuracy")
      .x_label("predictor index (see caption)")
      .y_label("equal-record correct fraction")
      .y_limits(0, 1.15);
  b.points(positions, n::select(measured, 1, 1).to_vector<double>(), "raw-score NLL",
           {220, 38, 38})
      .title("Declared held-out raw-score NLL")
      .x_label("predictor index (see caption)")
      .y_label("stable categorical negative log likelihood")
      .y_limits(0, 5.2);
  auto scores = dm::graphics::RLayout::create(1, 2);
  scores.add(a).add(b).size(1100, 500).fit_panels().save_svg("build/tcn_metrics.svg");
  std::filesystem::create_directories("figures");
  std::filesystem::copy_file("build/tcn_metrics.svg", "figures/tcn_metrics.svg",
                             std::filesystem::copy_options::overwrite_existing);
  a = n::plot_tensor_map(n::reverse(confusions[0].to(n::DType::Float64), {0}), 0, 80);
  b = n::plot_tensor_map(n::reverse(confusions[3].to(n::DType::Float64), {0}), 0, 80);
  a.title("Learned TCN held-out confusion")
      .x_label("predicted0gun /1point")
      .y_label("true0gun at bottom /1point");
  b.title("SGD centroid held-out confusion")
      .x_label("predicted0gun /1point")
      .y_label("true0gun at bottom /1point");
  auto cm = dm::graphics::RLayout::create(1, 2);
  cm.add(a).add(b).size(1100, 500).fit_panels().save_svg("build/tcn_confusion.svg");
  std::filesystem::copy_file("build/tcn_confusion.svg", "figures/tcn_confusion.svg",
                             std::filesystem::copy_options::overwrite_existing);
  a = dm::graphics::RPlot::create();
  b = dm::graphics::RPlot::create();
  const auto xs = time.reshape({150}).to_vector<double>();
  a.lines(xs, raw.reshape({150}).to_vector<double>(), "original", {37, 99, 235})
      .lines(xs, changed.reshape({150}).to_vector<double>(), "future changed", {220, 38, 38})
      .title("Actual held-out future perturbation")
      .x_label("source time;change begins at75")
      .y_label("observed raw signal");
  b.lines(xs,
          n::select(n::select(n::softmax(single.sequence, 2), 0, 0), 1, 1).to_vector<double>(),
          "original", {37, 99, 235})
      .lines(xs,
             n::select(n::select(n::softmax(altered.sequence, 2), 0, 0), 1, 1)
                 .to_vector<double>(),
             "future changed", {220, 38, 38})
      .title("Earlier causal predictions coincide")
      .x_label("observed prefix endpoint time")
      .y_label("pointing softmax probability")
      .y_limits(0, 1.2);
  auto control = dm::graphics::RLayout::create(1, 2);
  control.add(a).add(b).size(1100, 500).fit_panels().save_svg("build/tcn_future.svg");
  std::filesystem::copy_file("build/tcn_future.svg", "figures/tcn_future.svg",
                             std::filesystem::copy_options::overwrite_existing);
  const auto hist = n::stack(history, 0);
  const auto epochs = n::arange(1, 4).to_vector<double>();
  a = dm::graphics::RPlot::create();
  b = dm::graphics::RPlot::create();
  a.lines(epochs, n::select(hist, 1, 0).to_vector<double>(), "dropout fit", {37, 99, 235})
      .lines(epochs, n::select(hist, 1, 1).to_vector<double>(), "frozen val", {220, 38, 38})
      .title("Fifteen visible clipped Adam updates")
      .x_label("epoch;5 minibatches each")
      .y_label("categorical cross-entropy")
      .y_limits(0, 5.5);
  const auto steps = n::arange(1, updates + 1).to_vector<double>();
  b.lines(steps, (n::log(n::select(clips, 1, 0)) / std::log(10.)).to_vector<double>(),
          "before clip", {37, 99, 235})
      .lines(steps, (n::log(n::select(clips, 1, 1)) / std::log(10.)).to_vector<double>(),
             "after clip", {22, 163, 74})
      .title("Clipping caps actual norm near1")
      .x_label("explicit optimizer update")
      .y_label("log10 global norm;0means1")
      .y_limits(-.2, 4.);
  auto training = dm::graphics::RLayout::create(1, 2);
  training.add(a).add(b).size(1100, 500).fit_panels().save_svg("build/tcn_training.svg");
}
```
