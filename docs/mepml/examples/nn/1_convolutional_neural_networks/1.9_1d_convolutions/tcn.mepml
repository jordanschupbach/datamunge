> Left-only padding gives an exact causal Jacobian

Each residual level has two weight-normalized convolutions at dilation2^level,
each followed by ReLU and optional dropout. Explicit left padding equals
(kernel-1)*dilation;VALID convolution preserves the observed time axis.
Add an identity or1x1 projected skip,then ReLU. A shared linear head predicts
at every time and classification selects the last observed output.

The exact graph receptive field is1+2*(kernel-1)*(2^levels-1):six levels,
kernel3 give253 samples. A controlled positive two-tap/three-level fixture
has field15. Its final time19 has zero derivative for times0..4 and nonzero
derivatives for5..19. Perturbing inputs only from time8 leaves all earlier
outputs exactly unchanged. These are declared connectivity fixtures,not
learned motion explanations.
```{cpp, results="markdown", file="figures/tcn_causality.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

#include <print>
int main() {
  namespace n = dm::nn;
  namespace m = n::models;
  n::set_num_threads(2);
  n::ParameterStore p(461), state(463);
  m::TcnConfig c{1, 3, 2, 0, 1};
  {
    n::NoGradGuard guard;
    m::Tcn(p, state, n::ones({1, 20, 1}), c);
    for (const auto &name : p.names()) {
      const auto value = p.at(name);
      p.set(name, n::full(value.shape(),
                          name.ends_with("/b")   ? 0.
                          : name.ends_with("/g") ? double(std::sqrt(2.f))
                                                 : 1.,
                          value.dtype()));
    }
  }
  const auto raw = n::full({1, 20, 1}, 2.).requires_grad_();
  const auto out = m::Tcn(p, state, raw, c);
  const auto g = n::grad(n::sum(n::select(out.sequence, 1, 19)), {raw})[0].reshape({20});
  n::NoGradGuard guard;
  const auto time = n::arange(0, 20).reshape({1, 20, 1});
  const auto changed = raw + n::where(n::greater_equal(time, 8.), 3. + n::sin(time * .7), 0.);
  const auto alternate = m::Tcn(p, state, changed, c);
  const auto difference = n::max(n::abs(alternate.sequence - out.sequence), {0, 2});
  std::print("Controlled exact RF{};outside-support derivative max {:.3g};future perturbation "
             "before8 output error {:.3g};later change {:.6f}.\n",
             m::TcnReceptiveField(c), n::max(n::abs(n::slice_axis(g, 0, 0, 5))).item(),
             n::max(n::slice_axis(difference, 0, 0, 8)).item(),
             n::max(n::slice_axis(difference, 0, 8, 20)).item());
  auto a = dm::graphics::RPlot::create(), b = dm::graphics::RPlot::create();
  const auto positions = time.reshape({20}).to_vector<double>();
  a.bars(positions, g.to_vector<double>(), "input adjoint", {37, 99, 235})
      .title("Exact15-sample causal support")
      .x_label("input position;last output at19")
      .y_label("sum-final-logit input derivative");
  b.bars(positions, difference.to_vector<double>(), "future change", {220, 38, 38})
      .title("Future-only perturbation starts at8")
      .x_label("shared-head output time")
      .y_label("maximum absolute logit change");
  auto layout = dm::graphics::RLayout::create(1, 2);
  layout.add(a).add(b).size(1100, 500).fit_panels().save_svg("build/tcn_causality.svg");
}
```
