> Checking the architecture

A zero input verifies full-width geometry and parameter count without a backward graph. A separate compact random-input graph checks gradients and dropout modes.

```{cpp, results="markdown", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

int main() {
  namespace n = dm::nn;
  n::set_num_threads(2);
  const auto type = n::DType::Float64;
  n::ParameterStore grouped(17, type);
  n::Generator rng(23);
  const auto image = n::normal({1, 5, 6, 4}, 0, .2, rng, type).requires_grad_();
  const auto split = n::models::GroupedConv2D(grouped, "g", image, 6, 3, 2);
  const auto fused = n::models::FusedGroupedConv2D(grouped, "g", image, 6, 3, 2);
  auto leaves = grouped.parameters();
  leaves.push_back(image);
  const auto a = n::grad(n::sum(split), leaves), b = n::grad(n::sum(fused), leaves);
  double gradient_error = 0;
  for (size_t i = 0; i < a.size(); ++i)
    gradient_error = std::max(gradient_error, n::max(n::abs(a[i] - b[i])).item());
  const auto first_group =
      n::slice_axis(n::models::GroupedConv2D(grouped, "g", image, 6, 3, 2), 3, 0, 3);
  const auto dx = n::grad(n::sum(first_group), {image})[0];
  const double disconnected = n::max(n::abs(n::slice_axis(dx, 3, 2, 4))).item();
  if (n::max(n::abs(split - fused)).item() > 1e-12 || gradient_error > 1e-12 ||
      disconnected != 0)
    return 1;
  std::print(
      "Split/fused grouped derivative error {:.12f}; disconnected-input derivative {:.1f}.\n",
      gradient_error, disconnected);
  {
    n::NoGradGuard guard;
    n::ParameterStore full(17);
    const auto net = n::models::AlexNet(full, n::zeros({1, 227, 227, 3}));
    const std::array<int64_t, 5> spatial{55, 27, 13, 13, 13}, widths{96, 256, 384, 384, 256};
    for (int i = 0; i < 5; ++i)
      if (net.convolution[i].shape() != n::Shape{1, spatial[i], spatial[i], widths[i]})
        return 1;
    if (full.count() != 60965224 || net.pooling[2].shape() != n::Shape{1, 6, 6, 256} ||
        net.logits.shape() != n::Shape{1, 1000})
      return 1;
    std::print("Full model: {} learned scalars; five convolution stages and final 6x6x256 "
               "geometry verified.\n",
               full.count());
  }
  n::ParameterStore compact(29);
  n::models::AlexNetConfig cfg;
  cfg.image_size = 67;
  cfg.width_divisor = 8;
  cfg.classes = 3;
  cfg.dense_width = 16;
  const auto x = n::normal({2, 67, 67, 3}, 0, .2, rng);
  const auto net = n::models::AlexNet(compact, x, cfg);
  for (const auto &g : n::grad(n::sum(net.logits), compact.parameters()))
    if (!std::isfinite(n::sum(n::abs(g)).item()))
      return 1;
  n::NoGradGuard guard;
  const auto first = n::models::AlexNet(compact, x, cfg).logits,
             second = n::models::AlexNet(compact, x, cfg).logits;
  const auto draw1 = n::models::AlexNet(compact, x, cfg, true).logits,
             draw2 = n::models::AlexNet(compact, x, cfg, true).logits;
  if (n::max(n::abs(first - second)).item() != 0 || n::max(n::abs(draw1 - draw2)).item() == 0)
    return 1;
  std::print("Compact topology: all parameter gradients finite; inference repeats exactly and "
             "training dropout changes logits.\n");
}
```
