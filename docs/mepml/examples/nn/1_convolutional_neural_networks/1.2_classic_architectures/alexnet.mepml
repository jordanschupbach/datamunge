```{cpp, results="markdown", file="figures/alexnet_lrn.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

int main() {
  namespace n = dm::nn;
  const auto x = n::tensor({1., 2., 3.}).to(n::DType::Float64).detach().requires_grad_();
  const auto normalised = n::models::LocalResponseNorm(x, 1, 2., .1, .75);
  const auto denominator = n::from_vector(std::vector<double>{2.5, 3.4, 3.3}, {3});
  const auto expected = x * n::pow(denominator, -.75);
  const double error = n::max(n::abs(normalised - expected)).item();
  const auto gradient = n::grad(n::sum(normalised), {x})[0];
  const auto direction = n::tensor({1., 0., 0.}).to(x.dtype());
  const double h = 1e-5;
  const auto plus = n::models::LocalResponseNorm(x.detach() + h * direction, 1, 2., .1, .75);
  const auto minus = n::models::LocalResponseNorm(x.detach() - h * direction, 1, 2., .1, .75);
  const double numerical = (n::sum(plus).item() - n::sum(minus).item()) / (2 * h);
  if (error > 1e-12 || std::abs(numerical - gradient.at({0})) > 1e-8)
    return 1;
  auto plot = dm::graphics::RPlot::create();
  plot.lines({0, 1, 2}, x.to_vector<double>(), "input", {37, 99, 235})
      .lines({0, 1, 2}, normalised.to_vector<double>(), "LRN output", {234, 88, 12})
      .title("LRN: neighbouring channels share a denominator")
      .x_label("channel index")
      .y_label("activation");
  std::filesystem::create_directories("build");
  plot.size(900, 430).save_svg("build/alexnet_lrn.svg");
  std::print("Denominators {}.\nNormalised activations {}.\nValue error {:.12f}; input "
             "derivative {:.9f}, finite difference {:.9f}.\n",
             denominator.to_vector<double>(), normalised.to_vector<double>(), error,
             gradient.at({0}), numerical);
}
```
