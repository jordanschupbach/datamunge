The optimization loop captures only learnable parameters. Batch moments update the separate state eagerly, and each validation improvement saves both stores.

```{cpp, results="markdown", file="figures/xception_training.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

int main() {
  int rendered_confusions = 0;
  namespace n             = dm::nn;
  n::set_num_threads(2);

  std::filesystem::path cache;
  if (const auto* p = std::getenv("DATAMUNGE_DATA_DIR"))
    cache = p;
  else if (const auto* p = std::getenv("XDG_CACHE_HOME"))
    cache = std::filesystem::path(p) / "datamunge/datasets";
  else
    cache = std::filesystem::path(std::getenv("HOME")) / ".cache/datamunge/datasets";
  dm::datasets::fetch("cifar10", (cache / "cifar10").string());

  const auto raw    = n::data::LoadCifar({cache / "cifar10/data_batch_1.bin"}, n::data::Cifar::k10);
  const auto images = n::cast(raw.images, n::DType::Float32) / 255.;
  const auto labels = n::cast(raw.labels, n::DType::Int64);
  const auto tx = n::slice_axis(images, 0, 0, 128), ty = n::slice_axis(labels, 0, 0, 128);
  const auto vx       = 2 * n::slice_axis(images, 0, 128, 192) - 1,
             vy       = n::slice_axis(labels, 0, 128, 192);
  const auto official = n::load_cifar10((cache / "cifar10").string(), "test");
  const auto qx       = 2 * n::slice_axis(official.images, 0, 0, 64) - 1,
             qy       = n::slice_axis(official.labels, 0, 0, 64);
  n::models::XceptionConfig cfg;
  cfg.image_size    = 71;
  cfg.classes       = 10;
  cfg.width_divisor = 4;
  cfg.momentum      = .9;
  n::ParameterStore p(17), state(17);
  auto              output = [&](const n::Tensor& image, bool training) {
    const auto resized = n::resize_bilinear(image, {cfg.image_size, cfg.image_size});
    return n::models::Xception(p, state, resized, cfg, training);
  };
  // Materialise every learned leaf before capturing optimizer parameters.
  {
    n::NoGradGuard guard;
    output(n::zeros({1, 32, 32, 3}), false);
  }
  n::OptimizerConfig config;
  config.kind = n::OptimizerKind::Adam;
  n::Optimizer  optimizer(p, .001, config);
  n::BatchOrder batches(128, 8, 2026);
  n::Generator  augmentation(151);
  std::filesystem::create_directories("build");
  const std::string   checkpoint = "build/xception_best.npz";
  double              best       = std::numeric_limits<double>::infinity();
  int                 best_epoch = 0;
  std::vector<double> epochs, train, validation;
  for (int epoch = 1; epoch <= 20; ++epoch) {
    batches.begin_epoch();
    n::WeightedMean average;
    for (auto rows = batches.next(); !rows.empty(); rows = batches.next()) {
      const auto             batch = n::take_rows(tx, rows), target = n::take_rows(ty, rows);
      std::vector<n::Tensor> transformed;
      for (int64_t row = 0; row < batch.size(0); ++row) {
        auto image =
            n::pad(n::slice_axis(batch, 0, row, row + 1), {{0, 0}, {4, 4}, {4, 4}, {0, 0}});
        image = n::augment::random_crop(image, 32, 32, augmentation);
        transformed.push_back(n::augment::random_flip_left_right(image, augmentation));
      }
      const auto net       = output(2 * n::concat(transformed, 0) - 1, true);
      const auto primary   = n::sparse_softmax_cross_entropy(net.logits, target);
      auto       objective = primary;

      // L2 coefficient .0001/2, kernels only; coupled penalty is explicit in the objective.
      for (const auto& w : p.parameters())
        if (w.dim() >= 2)
          objective = objective + .00005 * n::sum(n::square(w));
      optimizer.minimize(objective);
      average.add(primary.item(), rows.size());
    }
    n::NoGradGuard guard;
    const double   val = n::sparse_softmax_cross_entropy(output(vx, false).logits, vy).item();
    if (!std::isfinite(val))
      return 1;
    epochs.push_back(epoch);
    train.push_back(average.value());
    validation.push_back(val);
    if (val < best) {
      best       = val;
      best_epoch = epoch;
      p.save(checkpoint);
      state.save("build/xception_best_state.npz");
    }
  }
  p.load(checkpoint);
  state.load("build/xception_best_state.npz");
  n::NoGradGuard     guard;
  const auto         test = output(qx, false).logits;
  n::ConfusionMatrix native_confusion(10);
  native_confusion.add(qy, n::argmax(test, 1));
  native_confusion.save_svg(
      "build/xception_confusion_api_" + std::to_string(rendered_confusions++) + ".svg",
      {.title = "xception / selected-checkpoint test counts"});

  const double train_nll =
      n::sparse_softmax_cross_entropy(output(2 * tx - 1, false).logits, ty).item();
  const double test_nll = n::sparse_softmax_cross_entropy(test, qy).item();
  if (!std::isfinite(test_nll))
    return 1;
  auto plot = dm::graphics::RPlot::create();
  plot.lines(epochs, train, "training", {37, 99, 235})
      .lines(epochs, validation, "validation", {234, 88, 12})
      .title("xception: compact CIFAR-10 primary NLL")
      .x_label("epoch")
      .y_label("mean NLL")
      .size(1000, 470)
      .save_svg("build/xception_training.svg");
  std::print(
      "128 fit / 64 validation / 64 official-test rows; {} learned scalars; {} Adam "
      "updates.\nBest validation epoch {}; NLL {:.6f}.\nSelected inference training "
      "NLL {:.6f}; test NLL {:.6f}; test accuracy {:.6f}.\n",
      p.count(),
      optimizer.iterations(),
      best_epoch,
      best,
      train_nll,
      test_nll,
      n::accuracy(test, qy));
}
```
// result_begin: markdown
128 fit / 64 validation / 64 official-test rows; 1354844 learned scalars; 320 Adam updates.
Best validation epoch 4; NLL 2.288906.
Selected inference training NLL 1.517208; test NLL 2.243028; test accuracy 0.234375.
\image(figures/xception_training.svg)
// result_end
\caption(Primary cross entropy from the visible Adam loop. Training uses augmentation and batch moments; validation is deterministic. Both use fixed, small subsets.)
\alttext(Primary cross entropy from the visible Adam loop. Training uses augmentation and batch moments; validation is deterministic. Both use fixed, small subsets.)


The checkpoint selected at epoch 4 has inference training NLL 1.517208,
validation NLL 2.288906 and test-subset NLL 2.243028, with 23.4375% accuracy.
The steadily improving training trace contrasts with worsening later validation NLL,
so restoring both early parameter and BN-state checkpoints matters.
These small, separately fitted subsets do not establish a model ranking.

> Native confusion matrices

These matrices use the held-out predictions from the executed program above.
The native `ConfusionMatrix` SVG API labels exact counts with true classes
running from top to bottom and predicted classes from left to right.

\image(figures/xception_confusion_api_0.svg)
\caption(Held-out classification confusion counts, evaluation 1. Exact cell counts are printed in the image.)
\alttext(Integer prediction counts with true classes as rows and predicted classes as columns.)


> Conclusion

The absence of an intervening activation is part of Xception's separable operation, not a
cosmetic ordering choice. Full-depth residual blocks, learned BN scales and separately saved
moving moments complete the model. The arithmetic, gradients, stage checks and short CIFAR-10
fit demonstrate those details without relying on pretrained weights or hidden training code.

> References

- [Chollet (2017), Xception: Deep Learning with Depthwise Separable Convolutions](https://arxiv.org/abs/1610.02357).
- [Keras Xception reference implementation](https://github.com/keras-team/keras/blob/master/keras/src/applications/xception.py).
- [CIFAR-10 dataset and binary layout](https://www.cs.toronto.edu/~kriz/cifar.html).
