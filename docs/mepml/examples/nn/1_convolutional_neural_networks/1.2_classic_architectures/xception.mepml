> Checking the architecture and state

Full-width stage counts and compact training gradients test separate claims. Inference must leave every moving statistic unchanged.

```{cpp, results="markdown", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

int main() {
  namespace n = dm::nn;
  n::set_num_threads(2);
  {
    n::NoGradGuard guard;
    n::ParameterStore p(17), state(17);
    const auto out = n::models::Xception(p, state, n::zeros({1, 299, 299, 3}));
    std::vector<std::pair<int64_t, int64_t>> expected{
        {149, 32}, {147, 64}, {74, 128}, {37, 256}, {19, 728}};
    expected.insert(expected.end(), 8, {19, 728});
    expected.emplace_back(10, 1024);
    expected.emplace_back(10, 1536);
    expected.emplace_back(10, 2048);
    if (p.count() != 22855952 || state.count() != 54528 || out.stages.size() != 16)
      return 1;
    for (size_t i = 0; i < expected.size(); ++i)
      if (out.stages[i].second.shape() !=
          n::Shape{1, expected[i].first, expected[i].first, expected[i].second})
        return 1;
    std::print("Full Xception: {} learned scalars, {} moving-statistic scalars; all sixteen "
               "stage maps verified.\n",
               p.count(), state.count());
  }
  n::models::XceptionConfig cfg;
  cfg.image_size = 71;
  cfg.classes = 3;
  cfg.width_divisor = 8;
  cfg.momentum = .9;
  n::ParameterStore p(17), state(17);
  n::Generator rng(29);
  const auto x = n::normal({2, 71, 71, 3}, 0, .2, rng);
  const auto net = n::models::Xception(p, state, x, cfg, true);
  if (net.stages[12].first != "middle8")
    return 1;
  const auto gradients = n::grad(n::mean(n::square(net.logits)), p.parameters());
  for (const auto &g : gradients)
    if (!std::isfinite(n::sum(n::abs(g)).item()))
      return 1;
  const auto saved = state.flatten();
  n::NoGradGuard guard;
  const auto inference = n::models::Xception(p, state, x, cfg, false).logits;
  if (state.flatten() != saved || !std::isfinite(n::sum(inference).item()))
    return 1;
  std::print("Compact topology retains middle8; {} parameter tensors have finite gradients. "
             "Inference leaves moving state exactly unchanged.\n",
             gradients.size());
}
```
// result_begin: markdown
Full Xception: 22855952 learned scalars, 54528 moving-statistic scalars; all sixteen stage maps verified.
Compact topology retains middle8; 156 parameter tensors have finite gradients. Inference leaves moving state exactly unchanged.
// result_end

> Dataset example

The preview contains one original image per class in CIFAR-10 order, before any transformation.

```{cpp, results="markdown", file="figures/xception_inputs.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

int main() {
  namespace n = dm::nn;

  std::filesystem::path cache;
  if (const auto *p = std::getenv("DATAMUNGE_DATA_DIR"))
    cache = p;
  else if (const auto *p = std::getenv("XDG_CACHE_HOME"))
    cache = std::filesystem::path(p) / "datamunge/datasets";
  else
    cache = std::filesystem::path(std::getenv("HOME")) / ".cache/datamunge/datasets";
  dm::datasets::fetch("cifar10", (cache / "cifar10").string());

  const auto raw =
      n::data::LoadCifar({cache / "cifar10/data_batch_1.bin"}, n::data::Cifar::k10);
  const auto images = n::cast(raw.images, n::DType::Float32) / 255.;
  const auto labels = raw.labels;

  std::vector<int64_t> rows;
  for (int cls = 0; cls < 10; ++cls) {
    for (int64_t row = 0; row < labels.numel(); ++row)
      if (labels.at({row}) == cls) {
        rows.push_back(row);
        break;
      }
  }
  if (rows.size() != 10)
    return 1;
  std::filesystem::create_directories("build");
  n::plot_tensor_images(n::take_rows(images, rows), 5)
      .title("CIFAR-10: one RGB image per class")
      .size(1000, 530)
      .save_svg("build/xception_inputs.svg");
  std::print("One original cached training image per class, IDs 0..4 then 5..9.\n");
}
```
