```{cpp, results="markdown", file="figures/xception_ordering.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

int main() {
  namespace n = dm::nn;
  const auto type = n::DType::Float64;
  n::ParameterStore p(17, type), state(17, type);
  n::models::ConvNormConfig cfg;
  const auto x = n::tensor({-2., 1., 3., -4., 2., -1., 4., -3., 1.}, {1, 3, 3, 1})
                     .to(type)
                     .detach()
                     .requires_grad_();
  {
    n::NoGradGuard guard;
    n::models::XceptionSeparable(p, state, "sep", x, 1, cfg);
  }
  p.set("sep/depthwise/W",
        n::tensor({0., 0., 0., 0., 1., 0., 0., 0., 0.}, {3, 3, 1, 1}).to(type));
  p.set("sep/pointwise/W", n::full({1, 1, 1, 1}, -2., type));
  const auto output = n::models::XceptionSeparable(p, state, "sep", x, 1, cfg);
  const auto expected = -2 * x / std::sqrt(1.001);
  const auto derivative = n::grad(n::sum(output), {x})[0];
  const auto wrong = n::conv2d(n::relu(n::depthwise_conv2d(x, p.at("sep/depthwise/W"))),
                               p.at("sep/pointwise/W")) /
                     std::sqrt(1.001);
  const double error = n::max(n::abs(output - expected)).item();
  const double gradient_error = n::max(n::abs(derivative + 2 / std::sqrt(1.001))).item();
  const double changed = n::sum(n::abs(output - wrong)).item();
  if (error > 1e-12 || gradient_error > 1e-12 || changed < 10)
    return 1;
  auto layout = dm::graphics::RLayout::create(1, 2);
  layout.add(n::plot_tensor_map(output.reshape({3, 3}), -8, 8).title("Linear factors then BN"))
      .add(n::plot_tensor_map(wrong.reshape({3, 3}), -8, 8)
               .title("Extra ReLU between factors"));
  std::filesystem::create_directories("build");
  layout.size(1100, 470).fit_panels().save_svg("build/xception_ordering.svg");
  std::print("Identity depthwise, pointwise -2; inference gamma=1, beta=0, mean=0, "
             "variance=1, epsilon=.001.\nOutput error {:.12f}, input-gradient error {:.12f}; "
             "extra-ReLU output L1 difference {:.6f}.\n",
             error, gradient_error, changed);
}
```
