> Inspecting a learned feature

This block uses the validation-selected checkpoint from the visible loop above. The two pixel-space maps share the same unit feature seed but different backward rules. Their absolute channel means show response magnitude; independent colour scales do not imply equal amplitudes.

```{cpp, results="markdown", file="figures/zfnet_projection.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

int main() {
  namespace n = dm::nn;
  n::set_num_threads(2);

  std::filesystem::path cache;
  if (const auto *p = std::getenv("DATAMUNGE_DATA_DIR"))
    cache = p;
  else if (const auto *p = std::getenv("XDG_CACHE_HOME"))
    cache = std::filesystem::path(p) / "datamunge/datasets";
  else
    cache = std::filesystem::path(std::getenv("HOME")) / ".cache/datamunge/datasets";
  dm::datasets::fetch("cifar10", (cache / "cifar10").string());

  const auto data = n::load_cifar10((cache / "cifar10").string(), "test");
  const auto original = n::slice_axis(data.images, 0, 0, 1);
  const auto resized = n::resize_bilinear(2 * original - 1, {67, 67});
  n::models::ZFNetConfig cfg;
  cfg.image_size = 67;
  cfg.classes = 10;
  cfg.width_divisor = 4;
  cfg.dense_width = 256;
  n::ParameterStore p(17);
  {
    n::NoGradGuard guard;
    n::models::ZFNet(p, resized, cfg);
  }
  p.load("build/zfnet_best.npz");
  const auto image = resized.detach().requires_grad_();
  const auto net = n::models::ZFNet(p, image, cfg);
  const auto feature = net.convolution[4];
  const auto index = n::argmax(feature.reshape({-1}), 0);
  const auto unit = n::one_hot(index, feature.numel()).reshape(feature.shape());
  const auto ordinary = n::grad(n::sum(feature * unit), {image})[0];
  const auto reconstructed = n::models::ZFNetDeconvolution(p, net, unit);
  const int64_t channel = index.item<int64_t>() % feature.size(3);
  const auto active = n::slice_axis(feature.detach(), 3, channel, channel + 1)
                          .reshape({feature.size(1), feature.size(2)});
  const auto deconv_energy = n::mean(n::abs(reconstructed), {3}).reshape({67, 67});
  const auto gradient_energy = n::mean(n::abs(ordinary), {3}).reshape({67, 67});
  const double difference = n::max(n::abs(reconstructed - ordinary)).item();
  if (!std::isfinite(difference) || difference == 0)
    return 1;
  auto layout = dm::graphics::RLayout::create(2, 2);
  layout.add(n::plot_tensor_images(original, 1).title("First test image"))
      .add(n::plot_tensor_map(active).title("Conv5: selected channel"))
      .add(n::plot_tensor_map(deconv_energy).title("Deconvnet: absolute RGB mean"))
      .add(n::plot_tensor_map(gradient_energy).title("Gradient: absolute RGB mean"));
  layout.size(1100, 920).fit_panels().save_svg("build/zfnet_projection.svg");
  std::print("Selected flat conv5 index {}, channel {}; activation {:.6f}.\nBoth projections "
             "use a unit signal at this feature. Maximum signed RGB difference {:.6f}.\n",
             index.item<int64_t>(), channel, n::max(feature).item(), difference);
}
```
