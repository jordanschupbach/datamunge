```{cpp, results="markdown", file="figures/zfnet_switches.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

int main() {
  namespace n = dm::nn;
  const auto x = n::tensor({1., 9., 2., 3., 4., 5., 6., 10., 7., 8., 12., 0., 11., 2., 1., 4.},
                           {1, 4, 4, 1});
  const auto signal = n::tensor({1., 2., 3., 4.}, {1, 2, 2, 1});
  const auto unpooled = n::models::UnpoolAtSwitches(x, signal, 2, 2, "VALID");
  const auto expected = n::tensor(
      {0., 1., 0., 0., 0., 0., 0., 2., 0., 0., 4., 0., 3., 0., 0., 0.}, {1, 4, 4, 1});
  if (n::max(n::abs(unpooled - expected)).item() != 0)
    return 1;
  auto signed_input = n::tensor({-1., 2.}, {1, 1, 1, 2}).requires_grad_();
  const auto backward = n::tensor({3., -4.}, {1, 1, 1, 2}),
             identity = n::tensor({1., 0., 0., 1.}, {1, 1, 2, 2});
  const auto ordinary = n::grad(n::sum(n::relu(signed_input) * backward), {signed_input})[0];
  const auto deconv = n::models::DeconvLayer(signed_input, identity, backward, 1, "VALID");
  if (ordinary.to_vector<int>() != std::vector<int>{0, -4} ||
      deconv.to_vector<int>() != std::vector<int>{3, 0})
    return 1;
  auto layout = dm::graphics::RLayout::create(1, 2);
  layout
      .add(n::plot_tensor_map(x.reshape({4, 4}), 0, 12)
               .title("Forward values determine switches"))
      .add(n::plot_tensor_map(unpooled.reshape({4, 4}), 0, 4)
               .title("Pooled signals return at the maxima"));
  std::filesystem::create_directories("build");
  layout.size(1100, 470).fit_panels().save_svg("build/zfnet_switches.svg");
  std::print("Switch unpooling agrees exactly. Ordinary ReLU derivative {}; deconvnet "
             "backward gate {}.\n",
             ordinary.to_vector<int>(), deconv.to_vector<int>());
}
```
