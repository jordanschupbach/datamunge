> Checking the architecture

Full reference forward geometry and compact parameter gradients are separate checks.

```{cpp, results="markdown", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

int main() {
  namespace n = dm::nn;
  n::set_num_threads(2);
  {
    n::NoGradGuard guard;
    n::ParameterStore p(17);
    const auto out = n::models::ZFNet(p, n::zeros({1, 224, 224, 3}));
    const std::array<int64_t, 5> spatial{110, 26, 13, 13, 13},
        channels{96, 256, 384, 384, 256};
    for (int i = 0; i < 5; ++i)
      if (out.convolution[i].shape() != n::Shape{1, spatial[i], spatial[i], channels[i]})
        return 1;
    if (p.count() != 62357608 || out.pooling[2].shape() != n::Shape{1, 6, 6, 256} ||
        out.logits.shape() != n::Shape{1, 1000})
      return 1;
    std::print("Full ZFNet: {} learned scalars; all five conv maps, final 6x6x256 pool and "
               "1000 logits verified.\n",
               p.count());
  }
  n::models::ZFNetConfig cfg;
  cfg.image_size = 67;
  cfg.classes = 3;
  cfg.width_divisor = 8;
  cfg.dense_width = 16;
  n::ParameterStore p(17);
  n::Generator rng(23);
  const auto x = n::normal({2, 67, 67, 3}, 0, .2, rng);
  const auto out = n::models::ZFNet(p, x, cfg);
  const auto gradients = n::grad(n::sum(out.logits), p.parameters());
  for (const auto &g : gradients)
    if (!std::isfinite(n::sum(n::abs(g)).item()))
      return 1;
  std::print("Compact topology: {} parameter tensors have finite gradients.\n",
             gradients.size());
  n::NoGradGuard guard;
  const auto reconstruction =
      n::models::ZFNetDeconvolution(p, out, n::ones_like(out.convolution[4]));
  if (reconstruction.shape() != x.shape() || !std::isfinite(n::sum(reconstruction).item()))
    return 1;
  std::print("Backprojection returns the exact input grid after removing only the explicit "
             "stem padding.\n");
}
```
// result_begin: markdown
Full ZFNet: 62357608 learned scalars; all five conv maps, final 6x6x256 pool and 1000 logits verified.
Compact topology: 16 parameter tensors have finite gradients.
Backprojection returns the exact input grid after removing only the explicit stem padding.
