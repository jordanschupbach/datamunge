> Checking the theory

Explicit patch extraction followed by three tensor matrix products must match the spatial/pointwise block in both values and parameter gradients.

```{cpp, results="markdown", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

int main() {
  namespace n = dm::nn;
  const auto type = n::DType::Float64;
  n::Generator rng(31);
  n::ParameterStore p(31, type);
  const auto image = n::normal({2, 5, 4, 3}, 0, .4, rng, type);
  const auto convolution = n::models::MlpConv(p, "mlp", image, 4, 5, 2, 3);
  auto h = n::im2col2d(image, 3, 3);
  const std::array<std::string, 3> names{"spatial", "mix1", "mix2"};
  const std::array<int, 3> in{27, 4, 5}, out{4, 5, 2};
  for (int layer = 0; layer < 3; ++layer) {
    const auto W = p.at("mlp/" + names[layer] + "/W").reshape({in[layer], out[layer]});
    h = n::relu(n::matmul(h, W) + p.at("mlp/" + names[layer] + "/b"));
  }
  const auto a = n::grad(n::mean(n::square(convolution)), p.parameters());
  const auto b = n::grad(n::mean(n::square(h)), p.parameters());
  double error = n::max(n::abs(convolution.reshape(h.shape()) - h)).item();
  for (size_t i = 0; i < a.size(); ++i)
    error = std::max(error, n::max(n::abs(a[i] - b[i])).item());
  if (error > 1e-10)
    return 1;
  n::NoGradGuard guard;
  n::ParameterStore full(17);
  const auto model = n::models::NetworkInNetwork(full, n::zeros({1, 32, 32, 3}));
  if (full.count() != 966986 || model.blocks[2].shape() != n::Shape{1, 8, 8, 10})
    return 1;
  std::print("Maximum patch-MLP value/gradient discrepancy {:.12f}; full parameters {}.\n",
             error, full.count());
}
```
// result_begin: markdown
Maximum patch-MLP value/gradient discrepancy 0.000000000000; full parameters 966986.
// result_end

> A dataset example

The preview selects one original training image of every class. The loop fits a separate fixed subset.

```{cpp, results="markdown", file="figures/network_in_network_inputs.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

int main() {
  namespace n = dm::nn;

  std::filesystem::path cache;
  if (const auto *p = std::getenv("DATAMUNGE_DATA_DIR"))
    cache = p;
  else if (const auto *p = std::getenv("XDG_CACHE_HOME"))
    cache = std::filesystem::path(p) / "datamunge/datasets";
  else
    cache = std::filesystem::path(std::getenv("HOME")) / ".cache/datamunge/datasets";
  dm::datasets::fetch("cifar10", (cache / "cifar10").string());

  const auto raw =
      n::data::LoadCifar({cache / "cifar10/data_batch_1.bin"}, n::data::Cifar::k10);
  const auto images = n::cast(raw.images, n::DType::Float32) / 255.;
  const auto labels = raw.labels;

  std::vector<int64_t> rows;
  for (int cls = 0; cls < 10; ++cls) {
    for (int64_t row = 0; row < labels.numel(); ++row)
      if (labels.at({row}) == cls) {
        rows.push_back(row);
        break;
      }
  }
  if (rows.size() != 10)
    return 1;
  std::filesystem::create_directories("build");
  n::plot_tensor_images(n::take_rows(images, rows), 5)
      .title("CIFAR-10: one RGB image per class")
      .size(1000, 530)
      .save_svg("build/network_in_network_inputs.svg");
  std::print("One original cached training image per class, IDs 0..4 then 5..9.\n");
}
```
