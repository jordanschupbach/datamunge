```{cpp, results="markdown", file="figures/network_in_network_xor.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

int main() {
  namespace n = dm::nn;
  n::ParameterStore p(0);
  p.set("mlp/spatial/W", n::ones({1, 1, 2, 2}));
  p.set("mlp/spatial/b", n::tensor({0, -1}));
  p.set("mlp/mix1/W", n::tensor({1, 0, 0, 1}, {1, 1, 2, 2}));
  p.set("mlp/mix1/b", n::zeros({2}));
  p.set("mlp/mix2/W", n::tensor({1, -2}, {1, 1, 2, 1}));
  p.set("mlp/mix2/b", n::zeros({1}));
  const auto input = n::tensor({0, 0, 0, 1, 1, 0, 1, 1}, {1, 2, 2, 2});
  const auto output = n::models::MlpConv(p, "mlp", input, 2, 2, 1, 1).reshape({2, 2});
  if (output.to_vector<int>() != std::vector<int>{0, 1, 1, 0})
    return 1;
  std::filesystem::create_directories("build");
  n::plot_tensor_map(output, 0, 1)
      .title("A shared pointwise MLP represents XOR")
      .size(700, 500)
      .save_svg("build/network_in_network_xor.svg");
  std::print("XOR outputs {}.\n", output.to_vector<int>());
}
```
