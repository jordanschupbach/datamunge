```{cpp, results="markdown", file="figures/network_in_network_training.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

int main() {
  int rendered_confusions = 0;
  namespace n             = dm::nn;
  n::set_num_threads(2);

  std::filesystem::path cache;
  if (const auto* p = std::getenv("DATAMUNGE_DATA_DIR"))
    cache = p;
  else if (const auto* p = std::getenv("XDG_CACHE_HOME"))
    cache = std::filesystem::path(p) / "datamunge/datasets";
  else
    cache = std::filesystem::path(std::getenv("HOME")) / ".cache/datamunge/datasets";
  dm::datasets::fetch("cifar10", (cache / "cifar10").string());

  const auto raw    = n::data::LoadCifar({cache / "cifar10/data_batch_1.bin"}, n::data::Cifar::k10);
  const auto images = n::cast(raw.images, n::DType::Float32) / 255.;
  const auto labels = n::cast(raw.labels, n::DType::Int64);
  const auto tx = 2 * n::slice_axis(images, 0, 0, 128) - 1, ty = n::slice_axis(labels, 0, 0, 128);
  const auto vx   = 2 * n::slice_axis(images, 0, 128, 192) - 1,
             vy   = n::slice_axis(labels, 0, 128, 192);
  const auto test = n::load_cifar10((cache / "cifar10").string(), "test");
  const auto qx   = 2 * n::slice_axis(test.images, 0, 0, 64) - 1,
             qy   = n::slice_axis(test.labels, 0, 0, 64);
  std::filesystem::create_directories("build");
  auto                learning = dm::graphics::RPlot::create();
  std::vector<double> variants, counts, accuracy, nll, training_nll;
  n::Tensor           selected_map;
  int                 selected_class = 0;
  for (int variant : {8}) {
    n::ParameterStore    p(17);
    n::models::NinConfig cfg;
    cfg.width_divisor    = 8;
    cfg.keep_probability = .5;
    auto output          = [&](const n::Tensor& x, bool training) {
      return n::models::NetworkInNetwork(p, x, cfg, training);
    };
    {
      n::NoGradGuard guard;
      output(n::zeros({1, 32, 32, 3}), false);
    }
    n::OptimizerConfig options;
    options.kind = n::OptimizerKind::Adam;
    n::Optimizer        optimizer(p, .001, options);
    n::BatchOrder       batches(128, 16, 2026);
    const std::string   path = "build/network_in_network_" + std::to_string(variant) + "_best.npz";
    double              best = std::numeric_limits<double>::infinity();
    std::vector<double> epochs, validation;
    for (int epoch = 0; epoch < 30; ++epoch) {
      batches.begin_epoch();
      for (auto rows = batches.next(); !rows.empty(); rows = batches.next()) {
        const auto logits = output(n::take_rows(tx, rows), true).logits;
        auto       loss   = n::sparse_softmax_cross_entropy(logits, n::take_rows(ty, rows));
        for (const auto& w : p.parameters())
          if (w.dim() >= 2)
            loss = loss + .00005 * n::sum(n::square(w));
        optimizer.minimize(loss);
      }
      n::NoGradGuard guard;
      const double   val = n::sparse_softmax_cross_entropy(output(vx, false).logits, vy).item();
      if (!std::isfinite(val))
        return 1;
      epochs.push_back(epoch + 1);
      validation.push_back(val);
      if (val < best) {
        best = val;
        p.save(path);
      }
    }
    p.load(path);
    n::NoGradGuard     guard;
    const auto         predicted = output(qx, false);
    n::ConfusionMatrix native_confusion(10);
    native_confusion.add(qy, n::argmax(predicted.logits, 1));
    native_confusion.save_svg(
        "build/network_in_network_confusion_api_" + std::to_string(rendered_confusions++) + ".svg",
        {.title = "network in network / selected-checkpoint test counts"});

    variants.push_back(variant);
    counts.push_back(p.count());
    accuracy.push_back(n::accuracy(predicted.logits, qy));
    training_nll.push_back(n::sparse_softmax_cross_entropy(output(tx, false).logits, ty).item());
    nll.push_back(n::sparse_softmax_cross_entropy(predicted.logits, qy).item());
    learning.lines(
        epochs,
        validation,
        "NiN, width divisor 8",
        variant == 11   ? dm::graphics::RGB{37, 99, 235}
        : variant == 16 ? dm::graphics::RGB{234, 88, 12}
                        : dm::graphics::RGB{22, 163, 74});

    const auto maps          = predicted.blocks[2];
    selected_class           = int(n::argmax(predicted.logits, 1).at({0}));
    selected_map             = n::select(n::select(maps, 0, 0), 2, selected_class);
    const double discrepancy = n::max(n::abs(n::global_avg_pool2d(maps) - predicted.logits)).item();
    if (discrepancy > 1e-6)
      return 1;
    std::print("Final class-map/logit identity discrepancy {:.9f}.\n", discrepancy);
  }
  learning.title("Validation NLL from explicit compact-model Adam loops")
      .x_label("epoch")
      .y_label("mean NLL");
  learning.title("Compact NiN: validation NLL");
  auto map = n::plot_tensor_map(selected_map)
                 .title("Predicted-class score map: " + std::to_string(selected_class));
  dm::graphics::RLayout::create(1, 2).add(learning).add(map).size(1100, 470).fit_panels().save_svg(
      "build/network_in_network_training.svg");
  dm::dstruct::DataFrame table;
  table.add_column("variant", variants);
  table.add_column("parameters", counts);
  table.add_column("test_subset_accuracy", accuracy);
  table.add_column("test_subset_NLL", nll);
  table.add_column("selected_training_NLL", training_nll);
  std::print(
      "128 fitted rows, 64 validation rows, 64 official-test rows; thirty epochs.\n\n{}\n",
      table.to_md(6));
}
```
