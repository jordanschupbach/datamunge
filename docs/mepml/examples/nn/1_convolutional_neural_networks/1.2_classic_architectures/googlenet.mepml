```{cpp, results="markdown", file="figures/googlenet_branches.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

int main() {
  namespace n = dm::nn;
  n::ParameterStore p(17, n::DType::Float64);
  const n::models::InceptionWidths widths{1, 1, 1, 1, 1, 1};
  const auto x = n::ones({1, 5, 5, 1}, p.dtype());
  {
    n::NoGradGuard guard;
    n::models::InceptionV1(p, "i", x, widths);
  }
  for (const auto &name : p.names())
    p.set(name, name.ends_with("/W") ? n::ones(p.at(name).shape(), p.dtype())
                                     : n::zeros(p.at(name).shape(), p.dtype()));
  const auto out = n::models::InceptionV1(p, "i", x, widths);
  const auto centre =
      n::slice(out.concatenated, {0, 2, 2, 0}, {1, 1, 1, 4}).to_vector<double>();
  const auto corner =
      n::slice(out.concatenated, {0, 0, 0, 0}, {1, 1, 1, 4}).to_vector<double>();
  if (centre != std::vector<double>{1, 9, 25, 1} || corner != std::vector<double>{1, 4, 9, 1})
    return 1;
  auto layout = dm::graphics::RLayout::create(2, 2);
  const std::array<std::string, 4> titles{"1x1 branch", "reduced 3x3 branch",
                                          "reduced 5x5 branch", "max-pool projection"};
  for (int i = 0; i < 4; ++i)
    layout.add(n::plot_tensor_map(out.branches[i].reshape({5, 5}), 0, 25).title(titles[i]));
  std::filesystem::create_directories("build");
  layout.size(1100, 920).fit_panels().save_svg("build/googlenet_branches.svg");
  std::print("Concatenation order: direct, reduced 3x3, reduced 5x5, pool projection.\nCentre "
             "{}; corner {}.\n",
             centre, corner);
  const auto w = n::models::GoogLeNetWidths()[0];
  const int64_t reduced = w.KernelWeights(192);
  const int64_t direct = 192LL * (w.one + 9 * w.three + 25 * w.five + w.pool);
  if (reduced != 163328 || direct != 393216)
    return 1;
  std::print("Inception 3a kernel MACs per spatial position: reduced {}, direct {}; ratio "
             "{:.6f}. Biases and pool comparisons excluded.\n",
             reduced, direct, double(reduced) / direct);
}
```
