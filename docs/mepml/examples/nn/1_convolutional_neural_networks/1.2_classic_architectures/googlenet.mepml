> Checking the architecture

The full model verifies main/auxiliary parameter counts. The compact graph then differentiates the weighted objective and checks that auxiliary parameter changes leave main inference untouched.

```{cpp, results="markdown", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

int main() {
  namespace n = dm::nn;
  n::set_num_threads(2);
  {
    n::NoGradGuard guard;
    n::ParameterStore full(17);
    const auto main = n::models::GoogLeNet(full, n::zeros({1, 224, 224, 3}));
    if (full.count() != 6998552 || main.inception[8].shape() != n::Shape{1, 7, 7, 1024})
      return 1;
    const auto all = n::models::GoogLeNet(full, n::zeros({1, 224, 224, 3}), {}, false, true);
    if (full.count() != 13378280 || all.auxiliary.size() != 2 ||
        all.logits.shape() != n::Shape{1, 1000})
      return 1;
    std::print("Full main parameters 6998552; auxiliaries add 6379728; final feature map "
               "7x7x1024.\n");
  }
  n::models::GoogLeNetConfig cfg;
  cfg.image_size = 65;
  cfg.classes = 3;
  cfg.width_divisor = 8;
  cfg.auxiliary_hidden = 16;
  n::ParameterStore p(17);
  n::Generator rng(23);
  const auto x = n::normal({2, 65, 65, 3}, 0, .2, rng);
  const auto labels = n::tensor({0, 2}).to(n::DType::Int64);
  const auto net = n::models::GoogLeNet(p, x, cfg, false, true);
  auto objective = n::sparse_softmax_cross_entropy(net.logits, labels);
  for (const auto &a : net.auxiliary)
    objective = objective + .3 * n::sparse_softmax_cross_entropy(a, labels);
  const auto gradients = n::grad(objective, p.parameters());
  double auxiliary_gradient = 0;
  for (size_t i = 0; i < gradients.size(); ++i) {
    const double magnitude = n::sum(n::abs(gradients[i])).item();
    if (!std::isfinite(magnitude))
      return 1;
    if (p.names()[i].starts_with("aux"))
      auxiliary_gradient += magnitude;
  }
  if (auxiliary_gradient <= 0)
    return 1;
  n::NoGradGuard guard;
  const auto before = n::models::GoogLeNet(p, x, cfg).logits;
  p.set("aux1/output/b", p.at("aux1/output/b") + n::tensor({3., -2., 1.}));
  const auto after = n::models::GoogLeNet(p, x, cfg).logits;
  const double difference = n::max(n::abs(before - after)).item();
  if (difference != 0)
    return 1;
  std::print("Compact weighted loss {:.6f}; auxiliary gradient L1 {:.6f}; main inference "
             "change after auxiliary perturbation {:.1f}.\n",
             objective.item(), auxiliary_gradient, difference);
}
```
// result_begin: markdown
Full main parameters 6998552; auxiliaries add 6379728; final feature map 7x7x1024.
Compact weighted loss 2.039011; auxiliary gradient L1 17.150945; main inference change after auxiliary perturbation 0.0.
// result_end

> Dataset example

The input sheet shows one unmodified original image per class, IDs 0–4 then 5–9 in CIFAR-10 order.

```{cpp, results="markdown", file="figures/googlenet_inputs.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

int main() {
  namespace n = dm::nn;

  std::filesystem::path cache;
  if (const auto *p = std::getenv("DATAMUNGE_DATA_DIR"))
    cache = p;
  else if (const auto *p = std::getenv("XDG_CACHE_HOME"))
    cache = std::filesystem::path(p) / "datamunge/datasets";
  else
    cache = std::filesystem::path(std::getenv("HOME")) / ".cache/datamunge/datasets";
  dm::datasets::fetch("cifar10", (cache / "cifar10").string());

  const auto raw =
      n::data::LoadCifar({cache / "cifar10/data_batch_1.bin"}, n::data::Cifar::k10);
  const auto images = n::cast(raw.images, n::DType::Float32) / 255.;
  const auto labels = raw.labels;

  std::vector<int64_t> rows;
  for (int cls = 0; cls < 10; ++cls) {
    for (int64_t row = 0; row < labels.numel(); ++row)
      if (labels.at({row}) == cls) {
        rows.push_back(row);
        break;
      }
  }
  if (rows.size() != 10)
    return 1;
  std::filesystem::create_directories("build");
  n::plot_tensor_images(n::take_rows(images, rows), 5)
      .title("CIFAR-10: one RGB image per class")
      .size(1000, 530)
      .save_svg("build/googlenet_inputs.svg");
  std::print("One original cached training image per class, IDs 0..4 then 5..9.\n");
}
```
