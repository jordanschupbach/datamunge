> Checking full topology

The full forward and compact backward checks cover different resource budgets and are labelled accordingly.

```{cpp, results="markdown", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

int main() {
  namespace n = dm::nn;
  n::set_num_threads(2);
  for (bool residual : {false, true}) {
    n::NoGradGuard guard;
    n::ParameterStore p(17), state(17);
    n::models::Inception4Config cfg;
    cfg.residual = residual;
    const auto out =
        n::models::Inception4(p, state, n::zeros({1, 299, 299, 3}), cfg, false, true);
    int64_t aux = 0;
    for (size_t i = 0; i < p.size(); ++i)
      if (p.names()[i].starts_with("aux/"))
        aux += p.parameters()[i].numel();
    std::vector<std::pair<int64_t, int64_t>> expected{{149, 32}, {147, 32}, {147, 64}};
    if (residual) {
      for (auto x : std::vector<std::pair<int64_t, int64_t>>{
               {73, 64}, {73, 80}, {71, 192}, {35, 192}, {35, 320}})
        expected.push_back(x);
      expected.insert(expected.end(), 10, {35, 320});
      expected.emplace_back(17, 1088);
      expected.insert(expected.end(), 20, {17, 1088});
      expected.emplace_back(8, 2080);
      expected.insert(expected.end(), 10, {8, 2080});
      expected.emplace_back(8, 1536);
    } else {
      expected.emplace_back(73, 160);
      expected.emplace_back(71, 192);
      expected.emplace_back(35, 384);
      expected.insert(expected.end(), 4, {35, 384});
      expected.emplace_back(17, 1024);
      expected.insert(expected.end(), 7, {17, 1024});
      expected.emplace_back(8, 1536);
      expected.insert(expected.end(), 3, {8, 1536});
    }
    if (p.count() - aux != (residual ? 55813192 : 42648232) ||
        aux != (residual ? 3366760 : 3358568) || state.count() != (residual ? 62336 : 64960) ||
        out.stages.size() != expected.size())
      return 1;
    for (size_t i = 0; i < expected.size(); ++i)
      if (out.stages[i].second.shape() !=
          n::Shape{1, expected[i].first, expected[i].first, expected[i].second})
        return 1;
    std::print("{}: {} main parameters, {} auxiliary parameters, {} BN moving scalars; {} "
               "full-width forward stage shapes verified.\n",
               residual ? "Inception-ResNet-v2" : "Inception v4", p.count() - aux, aux,
               state.count(), out.stages.size());
  }
  for (bool residual : {false, true}) {
    n::ParameterStore p(17), state(17);
    n::Generator rng(29);
    n::models::Inception4Config cfg;
    cfg.residual = residual;
    cfg.image_size = 107;
    cfg.classes = 3;
    cfg.width_divisor = 8;
    cfg.momentum = .9;
    const auto x = n::normal({2, 107, 107, 3}, 0, .2, rng);
    const auto out = n::models::Inception4(p, state, x, cfg, true, true);
    auto loss = n::mean(n::square(out.logits));
    for (const auto &a : out.auxiliary)
      loss = loss + .4 * n::mean(n::square(a));
    const auto gradients = n::grad(loss, p.parameters());
    for (const auto &g : gradients)
      if (!std::isfinite(n::sum(n::abs(g)).item()))
        return 1;
    const auto saved = state.flatten();
    n::NoGradGuard guard;
    n::models::Inception4(p, state, x, cfg);
    if (state.flatten() != saved)
      return 1;
    std::print("Compact residual={}: {} parameter-tensor gradients finite; all blocks "
               "retained and inference BN state unchanged.\n",
               residual, gradients.size());
  }
}
```
