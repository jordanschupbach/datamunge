```{cpp, results="markdown", file="figures/inception_v4_resnet_scaling.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

int main() {
  namespace n = dm::nn;
  const auto type = n::DType::Float64;
  auto values = dm::graphics::RPlot::create(), derivatives = dm::graphics::RPlot::create();
  const std::array<char, 3> kinds{'A', 'B', 'C'};
  const std::array<double, 3> scales{.17, .10, .20};
  const std::array<dm::graphics::RGB, 3> colours{
      {{37, 99, 235}, {234, 88, 12}, {22, 163, 74}}};
  for (int k = 0; k < 3; ++k) {
    n::ParameterStore p(17, type), state(17, type);
    n::models::Inception23Config cfg;
    cfg.width_divisor = 8;
    n::models::Inception23Outputs out;
    n::models::InceptionBuilder b(p, state, out, cfg, false);
    const auto x =
        n::linspace(.1, 1, 200, type).reshape({1, 5, 5, 8}).detach().requires_grad_();
    const n::models::ConvFeature feature{x, 8};
    const char kind = kinds[k];
    const double s = scales[k];
    const auto zero = n::models::InceptionResidual(b, "r", feature, kind, 0, false).value;
    const auto first = n::models::InceptionResidual(b, "r", feature, kind, s, false).value;
    const auto twice = n::models::InceptionResidual(b, "r", feature, kind, 2 * s, false).value;
    auto variables = p.parameters();
    variables.push_back(x);
    const auto a = n::grad(n::sum(first), variables), c = n::grad(n::sum(twice), variables);
    double parameter_error = 0, g1 = 0, g2 = 0;
    for (size_t i = 0; i + 1 < variables.size(); ++i) {
      parameter_error = std::max(parameter_error, n::max(n::abs(c[i] - 2 * a[i])).item());
      g1 += n::sum(n::square(a[i])).item();
      g2 += n::sum(n::square(c[i])).item();
    }
    const double output_error = n::max(n::abs(twice - x - 2 * (first - x))).item();
    const double input_error = n::max(n::abs(c.back() - 1 - 2 * (a.back() - 1))).item();
    if (n::max(n::abs(zero - x)).item() != 0 ||
        std::max({parameter_error, output_error, input_error}) > 1e-10 ||
        p.contains("r/project/bn/beta") || !p.contains("r/project/b"))
      return 1;
    const std::string label = std::string(1, kind) + ", s=" + std::to_string(s).substr(0, 4);
    values.lines({0, 1, 2},
                 {0, std::sqrt(n::sum(n::square(first - x)).item()),
                  std::sqrt(n::sum(n::square(twice - x)).item())},
                 label, colours[k]);
    derivatives.lines({0, 1, 2}, {0, std::sqrt(g1), std::sqrt(g2)}, label, colours[k]);
    std::print("Block {}: exact zero-scale identity; output, parameter and input-gradient "
               "errors below {:.12f}; linear biased projection has no BN.\n",
               kind, std::max({parameter_error, output_error, input_error}));
  }
  values.title("Residual signal scales with s")
      .x_label("multiplier of block base scale")
      .y_label("residual L2 norm")
      .y_limits(0, 7);
  derivatives.title("Parameter gradient scales with s")
      .x_label("multiplier of block base scale")
      .y_label("gradient L2 norm")
      .y_limits(0, 200);
  std::filesystem::create_directories("build");
  dm::graphics::RLayout::create(1, 2)
      .add(values)
      .add(derivatives)
      .size(1100, 470)
      .fit_panels()
      .save_svg("build/inception_v4_resnet_scaling.svg");
}
```
