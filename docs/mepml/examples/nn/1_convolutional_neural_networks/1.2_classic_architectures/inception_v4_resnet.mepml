```{cpp, results="markdown", file="figures/inception_v4_resnet_training.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

int main() {
  int rendered_confusions = 0;
  namespace n             = dm::nn;
  n::set_num_threads(2);

  std::filesystem::path cache;
  if (const auto* p = std::getenv("DATAMUNGE_DATA_DIR"))
    cache = p;
  else if (const auto* p = std::getenv("XDG_CACHE_HOME"))
    cache = std::filesystem::path(p) / "datamunge/datasets";
  else
    cache = std::filesystem::path(std::getenv("HOME")) / ".cache/datamunge/datasets";
  dm::datasets::fetch("cifar10", (cache / "cifar10").string());

  const auto raw    = n::data::LoadCifar({cache / "cifar10/data_batch_1.bin"}, n::data::Cifar::k10);
  const auto images = n::cast(raw.images, n::DType::Float32) / 255.,
             labels = n::cast(raw.labels, n::DType::Int64);
  const auto tx = n::slice_axis(images, 0, 0, 128), ty = n::slice_axis(labels, 0, 0, 128);
  const auto vx       = 2 * n::slice_axis(images, 0, 128, 192) - 1,
             vy       = n::slice_axis(labels, 0, 128, 192);
  const auto official = n::load_cifar10((cache / "cifar10").string(), "test");
  const auto qx       = 2 * n::slice_axis(official.images, 0, 0, 64) - 1,
             qy       = n::slice_axis(official.labels, 0, 0, 64);
  std::filesystem::create_directories("build");
  auto                     layout = dm::graphics::RLayout::create(1, 2);
  dm::dstruct::DataFrame   table;
  std::vector<std::string> names;
  std::vector<double> parameters, moments, selected, validation_nll, train_nll, test_nll, accuracy;
  for (bool residual : {false, true}) {
    n::models::Inception4Config cfg;
    cfg.residual                 = residual;
    cfg.image_size               = 107;
    cfg.classes                  = 10;
    cfg.width_divisor            = 8;
    cfg.momentum                 = .9;
    const double      smoothing  = .1;
    const std::string model_name = cfg.residual ? "Inception-ResNet-v2" : "Inception v4";
    n::ParameterStore p(17), state(17);
    auto              output = [&](const n::Tensor& image, bool training) {
      const auto resized = n::resize_bilinear(image, {cfg.image_size, cfg.image_size});
      return n::models::Inception4(p, state, resized, cfg, training, training);
    };
    // Construct every leaf and auxiliary head before the optimizer captures p.
    {
      n::NoGradGuard guard;
      n::models::Inception4(
          p, state, n::zeros({1, cfg.image_size, cfg.image_size, 3}), cfg, false, true);
    }
    n::OptimizerConfig config;
    config.kind = n::OptimizerKind::Adam;
    n::Optimizer        optimizer(p, .001, config);
    n::BatchOrder       batches(128, 8, 2026);
    n::Generator        augmentation(151);
    const std::string   checkpoint = "build/inception_v4_resnet_" + std::to_string(residual);
    double              best       = std::numeric_limits<double>::infinity();
    int                 best_epoch = 0;
    std::vector<double> epochs, train, validation;
    for (int epoch = 1; epoch <= 10; ++epoch) {
      batches.begin_epoch();
      n::WeightedMean average;
      for (auto rows = batches.next(); !rows.empty(); rows = batches.next()) {
        const auto             batch = n::take_rows(tx, rows), target = n::take_rows(ty, rows);
        std::vector<n::Tensor> transformed;
        for (int64_t row = 0; row < batch.size(0); ++row) {
          auto image =
              n::pad(n::slice_axis(batch, 0, row, row + 1), {{0, 0}, {4, 4}, {4, 4}, {0, 0}});
          image = n::augment::random_crop(image, 32, 32, augmentation);
          transformed.push_back(n::augment::random_flip_left_right(image, augmentation));
        }
        const auto net     = output(2 * n::concat(transformed, 0) - 1, true);
        const auto primary = n::sparse_softmax_cross_entropy(net.logits, target);
        auto       objective =
            n::sparse_softmax_cross_entropy(net.logits, target, n::Reduction::Mean, smoothing);
        for (const auto& auxiliary : net.auxiliary)
          objective = objective + .4 * n::sparse_softmax_cross_entropy(
                                           auxiliary, target, n::Reduction::Mean, smoothing);
        for (const auto& w : p.parameters())
          if (w.dim() >= 2)
            objective = objective + .00005 * n::sum(n::square(w));
        optimizer.minimize(objective);
        average.add(primary.item(), rows.size());
      }
      n::NoGradGuard guard;
      // Selection is unsmoothed main NLL, without auxiliary heads, augmentation or dropout.
      const double val = n::sparse_softmax_cross_entropy(output(vx, false).logits, vy).item();
      if (!std::isfinite(val))
        return 1;
      epochs.push_back(epoch);
      train.push_back(average.value());
      validation.push_back(val);
      if (val < best) {
        best       = val;
        best_epoch = epoch;
        p.save(checkpoint + "_params.npz");
        state.save(checkpoint + "_state.npz");
      }
    }
    p.load(checkpoint + "_params.npz");
    state.load(checkpoint + "_state.npz");
    n::NoGradGuard     guard;
    const auto         prediction = output(qx, false).logits;
    n::ConfusionMatrix native_confusion(10);
    native_confusion.add(qy, n::argmax(prediction, 1));
    native_confusion.save_svg(
        "build/inception_v4_resnet_confusion_api_" + std::to_string(rendered_confusions++) + ".svg",
        {.title = "inception v4 resnet / selected-checkpoint test counts"});

    const double test_loss = n::sparse_softmax_cross_entropy(prediction, qy).item();
    if (!std::isfinite(test_loss))
      return 1;
    names.push_back(model_name);
    parameters.push_back(p.count());
    moments.push_back(state.count());
    selected.push_back(best_epoch);
    validation_nll.push_back(best);
    train_nll.push_back(
        n::sparse_softmax_cross_entropy(output(2 * tx - 1, false).logits, ty).item());
    test_nll.push_back(test_loss);
    accuracy.push_back(n::accuracy(prediction, qy));
    auto plot = dm::graphics::RPlot::create();
    plot.lines(epochs, train, "training", {37, 99, 235})
        .lines(epochs, validation, "validation", {234, 88, 12})
        .title(model_name)
        .x_label("epoch")
        .y_label("unsmoothed primary NLL");
    layout.add(plot);
    std::print("{}: {} explicit Adam updates.\n", model_name, optimizer.iterations());
  }
  table.add_column("model", names);
  table.add_column("parameters", parameters);
  table.add_column("moving_state", moments);
  table.add_column("best_epoch", selected);
  table.add_column("validation_NLL", validation_nll);
  table.add_column("selected_train_NLL", train_nll);
  table.add_column("test_NLL", test_nll);
  table.add_column("test_accuracy", accuracy);
  std::print(
      "128 fit / 64 validation / 64 official-test rows per variant.\n\n{}\n", table.to_md(6));
  layout.size(1100, 470).fit_panels().save_svg("build/inception_v4_resnet_training.svg");
}
```
// result_begin: markdown
Inception v4: 160 explicit Adam updates.
Inception-ResNet-v2: 160 explicit Adam updates.
128 fit / 64 validation / 64 official-test rows per variant.

| model | parameters | moving_state | best_epoch | validation_NLL | selected_train_NLL | test_NLL | test_accuracy |
| :--- | ---: | ---: | ---: | ---: | ---: | ---: | ---: |
| Inception v4 | 652508 | 8120 | 1 | 2.347312 | 2.300811 | 2.348314 | 0.156250 |
| Inception-ResNet-v2 | 863200 | 7792 | 10 | 2.161477 | 1.718614 | 2.064205 | 0.328125 |

\image(figures/inception_v4_resnet_training.svg)
// result_end
\caption(Unsmoothed primary NLL traces from explicit Adam updates. Training uses augmentation, dropout and batch moments; inference validation selects paired parameter/state checkpoints. The fitted objective additionally includes smoothing, auxiliary terms where present, and L2.)
\alttext(Unsmoothed primary NLL traces from explicit Adam updates. Training uses augmentation, dropout and batch moments; inference validation selects paired parameter/state checkpoints. The fitted objective additionally includes smoothing, auxiliary terms where present, and L2.)


Inception v4 selects epoch 1 (validation NLL 2.347312, test NLL 2.348314,
accuracy 15.625%): its training NLL stays near \(\ln 10=2.30\) and its validation NLL
swings up to about 4.6 at epoch 6, so in 160 updates it learns almost nothing.
Inception-ResNet-v2 selects its last epoch, 10 (2.161477, 2.064205, 32.8125%), with
validation NLL still falling. The variable validation curves and the short schedule
limit what these runs establish. Different widths and very small held-out subsets
prevent attributing the score difference specifically to residual connections.

> Native confusion matrices

These matrices use the held-out predictions from the executed program above.
The native `ConfusionMatrix` SVG API labels exact counts with true classes
running from top to bottom and predicted classes from left to right.

\image(figures/inception_v4_resnet_confusion_api_0.svg)
\caption(Held-out classification confusion counts, evaluation 1. Exact cell counts are printed in the image.)
\alttext(Integer prediction counts with true classes as rows and predicted classes as columns.)

\image(figures/inception_v4_resnet_confusion_api_1.svg)
\caption(Held-out classification confusion counts, evaluation 2. Exact cell counts are printed in the image.)
\alttext(Integer prediction counts with true classes as rows and predicted classes as columns.)


> Conclusion

Scaled residual branches preserve an identity contribution to input derivatives while scaling
the learned correction and its parameter derivatives. Full block counts and the final C-block
exception remain explicit. The short dataset fits demonstrate smoothed objectives, auxiliary
supervision and paired checkpoints; their small subsets cannot establish a residual-learning advantage.

> References

- [Szegedy et al. (2017), Inception-v4, Inception-ResNet and the Impact of Residual Connections on Learning](https://arxiv.org/abs/1602.07261).
