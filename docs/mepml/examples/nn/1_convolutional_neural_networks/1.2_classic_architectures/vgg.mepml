```{cpp, results="markdown", file="figures/vgg_counts.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

int main() {
  namespace n = dm::nn;
  std::vector<double> depth, reference, compact;
  for (int d : {11, 16, 19}) {
    const auto schedule = n::models::VggBlockDepths(d);
    int64_t count = 0, in = 3;
    const std::array<int, 5> widths{64, 128, 256, 512, 512};
    for (int block = 0; block < 5; ++block)
      for (int layer = 0; layer < schedule[block]; ++layer) {
        count += 9 * in * widths[block] + widths[block];
        in = widths[block];
      }
    count += (7 * 7 * 512LL + 1) * 4096 + (4096LL + 1) * 4096 + (4096LL + 1) * 1000;
    n::models::VggConfig cfg;
    cfg.depth = d;
    cfg.image_size = 32;
    cfg.classes = 10;
    cfg.width_divisor = 8;
    cfg.dense_width = 32;
    n::ParameterStore p(17);
    n::NoGradGuard guard;
    const auto output = n::models::Vgg(p, n::zeros({1, 32, 32, 3}), cfg);
    if (output.convolution.size() + 3 != size_t(d) ||
        output.pooling[4].shape() != n::Shape{1, 1, 1, 64})
      return 1;
    depth.push_back(d);
    reference.push_back(count);
    compact.push_back(p.count());
  }
  auto plot = dm::graphics::RPlot::create();
  plot.lines(depth, compact, "instantiated compact", {37, 99, 235})
      .title("Preserve depth while reducing widths and head size")
      .x_label("learned depth")
      .y_label("compact parameters");
  std::filesystem::create_directories("build");
  plot.size(850, 420).save_svg("build/vgg_counts.svg");
  dm::dstruct::DataFrame table;
  table.add_column("depth", depth);
  table.add_column("full_shape_count", reference);
  table.add_column("instantiated_compact_count", compact);
  std::print("{}\n", table.to_md(0));
}
