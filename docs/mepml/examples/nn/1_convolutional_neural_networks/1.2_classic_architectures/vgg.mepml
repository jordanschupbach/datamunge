> Checking the theory

A larger feature map produces six sliding classifier outputs. Every output is checked against the dense head applied to its corresponding 2×2 feature window.

```{cpp, results="markdown", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

int main() {
  namespace n = dm::nn;
  const auto type = n::DType::Float64;
  n::models::VggConfig cfg;
  cfg.depth = 11;
  cfg.image_size = 64;
  cfg.classes = 3;
  cfg.width_divisor = 8;
  cfg.dense_width = 16;
  n::ParameterStore p(9, type);
  n::NoGradGuard guard;
  n::models::Vgg(p, n::zeros({1, 64, 64, 3}, type), cfg);
  n::Generator rng(9);
  const auto feature = n::normal({1, 3, 4, 64}, 0, .2, rng, type);
  const auto convolution = n::models::VggConvolutionalHead(p, feature, cfg);
  std::vector<n::Tensor> windows;
  for (int row = 0; row < 2; ++row)
    for (int column = 0; column < 3; ++column) {
      auto h = n::slice(feature, {0, row, column, 0}, {1, 2, 2, 64}).reshape({1, 256});
      h = n::dense(p, "fc6", h, 16, n::Activation::Relu);
      h = n::dense(p, "fc7", h, 16, n::Activation::Relu);
      windows.push_back(n::dense(p, "fc8", h, 3));
    }
  const double error =
      n::max(n::abs(convolution.reshape({6, 3}) - n::concat(windows, 0))).item();
  if (error > 1e-12)
    return 1;
  std::print("Six sliding feature windows; maximum dense/convolutional score error {:.12f}.\n",
             error);
}
```
// result_begin: markdown
Six sliding feature windows; maximum dense/convolutional score error 0.000000000000.
// result_end

> A dataset example

All three compact models use the same original CIFAR-10 fitting, validation and official-test subsets.

```{cpp, results="markdown", file="figures/vgg_inputs.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

int main() {
  namespace n = dm::nn;

  std::filesystem::path cache;
  if (const auto *p = std::getenv("DATAMUNGE_DATA_DIR"))
    cache = p;
  else if (const auto *p = std::getenv("XDG_CACHE_HOME"))
    cache = std::filesystem::path(p) / "datamunge/datasets";
  else
    cache = std::filesystem::path(std::getenv("HOME")) / ".cache/datamunge/datasets";
  dm::datasets::fetch("cifar10", (cache / "cifar10").string());

  const auto raw =
      n::data::LoadCifar({cache / "cifar10/data_batch_1.bin"}, n::data::Cifar::k10);
  const auto images = n::cast(raw.images, n::DType::Float32) / 255.;
  const auto labels = raw.labels;

  std::vector<int64_t> rows;
  for (int cls = 0; cls < 10; ++cls) {
    for (int64_t row = 0; row < labels.numel(); ++row)
      if (labels.at({row}) == cls) {
        rows.push_back(row);
        break;
      }
  }
  if (rows.size() != 10)
    return 1;
  std::filesystem::create_directories("build");
  n::plot_tensor_images(n::take_rows(images, rows), 5)
      .title("CIFAR-10: one RGB image per class")
      .size(1000, 530)
      .save_svg("build/vgg_inputs.svg");
  std::print("One original cached training image per class, IDs 0..4 then 5..9.\n");
}
```
