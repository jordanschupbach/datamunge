> Checking normalisation and smoothing

The batch-state fixture and three-step logit optimization isolate two mechanisms that would otherwise be hidden inside a larger network.

```{cpp, results="markdown", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

int main() {
  namespace n = dm::nn;
  const auto type = n::DType::Float64;
  n::ParameterStore p(17, type), state(17, type);
  n::models::ConvNormConfig cfg;
  cfg.momentum = .5;
  const auto x = n::linspace(1, 6, 6, type).reshape({1, 2, 3, 1});
  {
    n::NoGradGuard guard;
    n::models::NormalizedConv(p, state, "rect", x, 2, 1, 3, cfg, 1, "SAME", false);
  }
  p.set("rect/W", n::tensor({1., -1., 1., -1., 1., -1.}, {1, 3, 1, 2}).to(type));
  const auto raw = n::conv2d(x, p.at("rect/W"));
  const auto mean = n::mean(raw, {0, 1, 2}, true);
  const auto variance = n::mean(n::square(raw - mean), {0, 1, 2}, true);
  cfg.training = true;
  const auto y =
      n::models::NormalizedConv(p, state, "rect", x, 2, 1, 3, cfg, 1, "SAME", false);
  const double error = n::max(n::abs(y - (raw - mean) / n::sqrt(variance + .001))).item();
  const double mean_error =
      n::max(n::abs(state.at("rect/bn/moving_mean") - .5 * mean.reshape({2}))).item();
  const double variance_error = n::max(n::abs(state.at("rect/bn/moving_var") -
                                              (.5 + .5 * variance.reshape({2}) * 6. / 5.)))
                                    .item();
  if (p.count() != 8 || state.count() != 4 || p.contains("rect/bn/gamma") ||
      std::max({error, mean_error, variance_error}) > 1e-12)
    return 1;
  std::print("Rectangular beta-only BN: {} learned scalars, {} moving scalars; output and "
             "one-step moving moments match to {:.12f}.\n",
             p.count(), state.count(), std::max({error, mean_error, variance_error}));
  n::ParameterStore scores(17, type);
  scores.set("logits", n::tensor({10., 0., 0.}, {1, 3}).to(type));
  const auto labels = n::tensor({0}).to(n::DType::Int64);
  const double nll = n::sparse_softmax_cross_entropy(scores.at("logits"), labels).item();
  const double smoothed =
      n::sparse_softmax_cross_entropy(scores.at("logits"), labels, n::Reduction::Mean, .1)
          .item();
  if (std::abs(smoothed - nll - 2. / 3) > 1e-12)
    return 1;
  n::OptimizerConfig options;
  options.kind = n::OptimizerKind::Adam;
  n::Optimizer optimizer(scores, .01, options);
  for (int step = 0; step < 3; ++step)
    optimizer.minimize(
        n::sparse_softmax_cross_entropy(scores.at("logits"), labels, n::Reduction::Mean, .1));
  if (scores.at("logits").at({0, 0}) >= 10)
    return 1;
  std::print(
      "Before updates: unsmoothed NLL {:.9f}, smoothed CE {:.9f}=NLL+2/3.\nThree explicit "
      "Adam updates reduce the overconfident true-class logit from 10 to {:.6f}.\n",
      nll, smoothed, scores.at("logits").at({0, 0}));
}
```
// result_begin: markdown
Rectangular beta-only BN: 8 learned scalars, 4 moving scalars; output and one-step moving moments match to 0.000000000000.
Before updates: unsmoothed NLL 0.000090796, smoothed CE 0.666757462=NLL+2/3.
Three explicit Adam updates reduce the overconfident true-class logit from 10 to 9.970000.
// result_end

> Checking full topology

Reference counts and every forward stage are checked without a backward graph; all learned-tensor derivatives are checked separately at compact widths with unchanged depth.

```{cpp, results="markdown", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

int main() {
  namespace n = dm::nn;
  n::set_num_threads(2);
  for (int version : {2, 3}) {
    n::NoGradGuard guard;
    n::ParameterStore p(17), state(17);
    n::models::Inception23Config cfg;
    cfg.version = version;
    cfg.image_size = version == 2 ? 224 : 299;
    const auto out = n::models::Inception23(
        p, state, n::zeros({1, cfg.image_size, cfg.image_size, 3}), cfg, false, true);
    int64_t aux = 0;
    for (size_t i = 0; i < p.size(); ++i)
      if (p.names()[i].starts_with("aux/"))
        aux += p.parameters()[i].numel();
    const auto main = p.count() - aux;
    const std::vector<std::pair<int64_t, int64_t>> expected =
        version == 2
            ? std::vector<std::pair<int64_t, int64_t>>{{112, 64}, {56, 64},  {56, 64},
                                                       {56, 192}, {28, 192}, {28, 256},
                                                       {28, 320}, {14, 576}, {14, 576},
                                                       {14, 576}, {14, 576}, {14, 576},
                                                       {7, 1024}, {7, 1024}, {7, 1024}}
            : std::vector<std::pair<int64_t, int64_t>>{
                  {149, 32}, {147, 32}, {147, 64}, {73, 64},  {73, 80},  {71, 192},
                  {35, 192}, {35, 256}, {35, 288}, {35, 288}, {17, 768}, {17, 768},
                  {17, 768}, {17, 768}, {17, 768}, {8, 1280}, {8, 2048}, {8, 2048}};
    if (main != (version == 2 ? 11178336 : 23817352) || aux != (version == 2 ? 0 : 3325800) ||
        state.count() != (version == 2 ? 19776 : 36224) ||
        out.stages.size() != expected.size())
      return 1;
    for (size_t i = 0; i < expected.size(); ++i)
      if (out.stages[i].second.shape() !=
          n::Shape{1, expected[i].first, expected[i].first, expected[i].second})
        return 1;
    std::print("Full v{}: {} main parameters, {} auxiliary parameters, {} moving scalars; {} "
               "stage shapes verified.\n",
               version, main, aux, state.count(), expected.size());
  }
  for (int version : {2, 3}) {
    n::ParameterStore p(17), state(17);
    n::Generator rng(29);
    n::models::Inception23Config cfg;
    cfg.version = version;
    cfg.image_size = version == 2 ? 64 : 107;
    cfg.classes = 3;
    cfg.width_divisor = 8;
    cfg.momentum = .9;
    const auto x = n::normal({2, cfg.image_size, cfg.image_size, 3}, 0, .2, rng);
    const auto net = n::models::Inception23(p, state, x, cfg, true, true);
    auto loss = n::mean(n::square(net.logits));
    for (const auto &a : net.auxiliary)
      loss = loss + .4 * n::mean(n::square(a));
    const auto gradients = n::grad(loss, p.parameters());
    for (const auto &g : gradients)
      if (!std::isfinite(n::sum(n::abs(g)).item()))
        return 1;
    const auto saved = state.flatten();
    n::NoGradGuard guard;
    n::models::Inception23(p, state, x, cfg);
    if (state.flatten() != saved)
      return 1;
    std::print("Compact v{}: all {} parameter-tensor gradients finite; inference leaves BN "
               "state unchanged.\n",
               version, gradients.size());
  }
}
```
