```{cpp, results="markdown", file="figures/inception_v2_v3_factorisation.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

int main() {
  namespace n = dm::nn;
  const auto type = n::DType::Float64;
  const auto x =
      (n::linspace(1, 121, 121, type).reshape({1, 11, 11, 1}) / 121).detach().requires_grad_();
  const auto vertical = (n::linspace(1, 7, 7, type) / 7).detach().requires_grad_();
  const auto horizontal = (n::linspace(1, 7, 7, type) / 7).detach().requires_grad_();
  const auto v = vertical.reshape({7, 1, 1, 1}), h = horizontal.reshape({1, 7, 1, 1});
  const auto valid = n::conv_options(1, n::Padding::Valid);
  const auto factored = n::conv2d(n::conv2d(x, h, valid), v, valid);
  const auto dense = n::conv2d(x, v * h, valid);
  const auto a =
      n::grad(n::mean(n::square(factored)), {x, vertical, horizontal}, {.retain_graph = true});
  const auto b = n::grad(n::mean(n::square(dense)), {x, vertical, horizontal});
  double gradient_error = 0;
  for (size_t i = 0; i < a.size(); ++i)
    gradient_error = std::max(gradient_error, n::max(n::abs(a[i] - b[i])).item());
  const double value_error = n::max(n::abs(factored - dense)).item();
  if (value_error > 1e-12 || gradient_error > 1e-10 ||
      std::abs(factored.at({0, 0, 0, 0}) - 38416. / 5929) > 1e-12)
    return 1;
  auto layout = dm::graphics::RLayout::create(1, 2);
  layout
      .add(n::plot_tensor_map((v * h).reshape({7, 7})).title("Rank-one 7x7 kernel: v times h"))
      .add(n::plot_tensor_map(factored.reshape({5, 5}))
               .title("Two factors equal one dense VALID filter"));
  std::filesystem::create_directories("build");
  layout.size(1100, 470).fit_panels().save_svg("build/inception_v2_v3_factorisation.svg");
  std::print("First output {:.9f}, expected 38416/5929. Value error {:.12f}; maximum "
             "input/factor gradient error {:.12f}.\nVALID geometry uses 11x5x7 + 5x5x7 = 560 "
             "factored MACs versus 5x5x49 = 1225 dense MACs.\n",
             factored.at({0, 0, 0, 0}), value_error, gradient_error);
}
```
