> Executable original graph and compact alignment

The full31,030,658-parameter grayscale/two-class graph executes all46 learned
tensor gradients at188->4 pixels below. This is a graph check with initialized
weights,not a biomedical training result. Native checks also require every
compact learned gradient to be nonzero and verify96/112/128-pixel alignment.
The compact SAME model retains all four encoder/decoder levels.

```{cpp, results="markdown", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

#include <print>
int main() {
  namespace n = dm::nn;
  n::set_num_threads(2);
  {
    n::ParameterStore p(17);
    const auto net =
        n::models::Unet(p, n::sin(.13 * n::arange(0, 188 * 188)).reshape({1, 188, 188, 1}));
    const auto g = n::grad(n::mean(n::square(net.logits)), p.parameters());
    if (p.count() != 31030658 || g.size() != 46 || net.logits.shape() != n::Shape{1, 4, 4, 2})
      return 1;
    for (const auto &v : g)
      if (!v.defined() || !std::isfinite(n::sum(n::square(v.to(n::DType::Float64))).item()))
        return 1;
    std::print("Full valid U-Net:{} learned scalars,all{} finite defined tensor "
               "gradients,188->4 output.\n",
               p.count(), g.size());
  }
  n::ParameterStore p(17);
  n::models::UnetConfig c;
  c.classes = 4;
  c.input_channels = 3;
  c.base_width = 8;
  c.valid = false;
  c.dropout = 0;
  for (int side : {96, 112, 128}) {
    const auto net = n::models::Unet(p, n::zeros({1, side, side, 3}), c);
    if (net.logits.shape() != n::Shape{1, side, side, 4})
      return 1;
  }
  std::print("Compact SAME U-Net:{} learned scalars,exact96/112/128px output alignment,no BN "
             "state.\n",
             p.count());
}
```
