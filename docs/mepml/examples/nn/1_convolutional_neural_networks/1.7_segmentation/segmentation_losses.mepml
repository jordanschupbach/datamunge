> Four visible Adam fits to a known circle

This example optimizes four independent24x24 probability fields for one known
circle. It tests loss optimization, with no CNN, dataset split or held-out
segmentation claim. All four logit fields are created before Adam(.1), seeded17
with normal standard deviation.25. Each of200 visible steps sums Dice,
Tversky, foreground-only Lovász and Dice plus.1 times boundary loss. Only this
illustration normalizes the distance map by24. No fitting loop is hidden in a
helper. The target, initial fields and final fields appear in matching columns.

```{cpp, results="markdown", file="figures/segmentation_losses_training.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

#include <print>
int main() {
  namespace n = dm::nn;
  namespace m = n::models;
  n::set_num_threads(2);
  constexpr int side = 24;
  const auto y = n::arange(0, side).reshape({side, 1}),
             x = n::arange(0, side).reshape({1, side});
  const auto target = n::less(n::square(y - 12.) + n::square(x - 12.), 49.)
                          .to(n::DType::Int64)
                          .reshape({1, side, side}),
             distance = m::SignedBoundaryDistances(target, 2) / double(side);
  n::ParameterStore p(17);
  for (int i = 0; i < 4; ++i)
    p.get("field" + std::to_string(i), {1, side, side, 2}, n::init::normal(.25));
  n::OptimizerConfig config;
  config.kind = n::OptimizerKind::Adam;
  n::Optimizer adam(p, .1, config);
  const auto probabilities = [&]() {
    std::vector<n::Tensor> out;
    for (int i = 0; i < 4; ++i)
      out.push_back(n::softmax(p.at("field" + std::to_string(i)), -1));
    return out;
  };
  const auto terms = [&](const std::vector<n::Tensor> &prob) {
    return std::vector<n::Tensor>{
        m::SoftDiceLoss(prob[0], target, 2), m::SoftTverskyLoss(prob[1], target, 2),
        m::LovaszSoftmaxLoss(prob[2], target, 2, 1),
        m::SoftDiceLoss(prob[3], target, 2) +
            .1 * m::BoundaryLoss(n::slice_axis(prob[3], 3, 1, 2), distance)};
  };
  std::vector<n::Tensor> initial_images;
  {
    n::NoGradGuard guard;
    for (const auto &v : probabilities())
      initial_images.push_back(n::slice_axis(v, 3, 1, 2));
  }
  const auto initial = terms(probabilities());
  std::array<double, 4> first;
  for (int i = 0; i < 4; ++i)
    first[i] = initial[i].item();
  std::vector<double> steps;
  std::array<std::vector<double>, 4> trace, iou;
  for (int step = 0; step <= 200; ++step) {
    const auto prob = probabilities(), losses = terms(prob);
    steps.push_back(step);
    for (int i = 0; i < 4; ++i) {
      trace[i].push_back(losses[i].item());
      const auto predicted = n::equal(n::argmax(prob[i], 3), 1.), truth = n::equal(target, 1.);
      iou[i].push_back(n::sum(n::logical_and(predicted, truth).to(n::DType::Float32)).item() /
                       n::sum(n::logical_or(predicted, truth).to(n::DType::Float32)).item());
    }
    if (step == 200)
      break;
    adam.minimize(losses[0] + losses[1] + losses[2] + losses[3]);
  }
  const std::array<std::string, 4> names = {"Dice", "Tversky", "Lovasz", "Dice+boundary"};
  const std::array<dm::graphics::RGB, 4> colors = {
      {{37, 99, 235}, {22, 163, 74}, {147, 51, 234}, {220, 38, 38}}};
  auto a = dm::graphics::RPlot::create(), b = dm::graphics::RPlot::create();
  std::print("| field | initial loss | final loss | foreground IoU |\n|---|---:|---:|---:|\n");
  for (int i = 0; i < 4; ++i) {
    if (trace[i].back() >= first[i] || iou[i].back() < .98)
      return 1;
    a.lines(steps, trace[i], names[i], colors[i]);
    b.lines(steps, iou[i], names[i], colors[i]);
    std::print("| {} | {:.9f} | {:.9f} | {:.6f} |\n", names[i], first[i], trace[i].back(),
               iou[i].back());
  }
  a.title("Four fitted field objectives")
      .x_label("Adam update")
      .y_label("loss, including signed boundary")
      .y_limits(-.04, .95);
  b.title("Known-mask foreground IoU")
      .x_label("Adam update")
      .y_label("foreground intersection over union")
      .y_limits(0, 1.3);
  std::filesystem::create_directories("build");
  std::vector<n::Tensor> gallery;
  for (int i = 0; i < 4; ++i)
    gallery.push_back(target.to(n::DType::Float32).reshape({1, side, side, 1}));
  gallery.insert(gallery.end(), initial_images.begin(), initial_images.end());
  for (const auto &v : probabilities())
    gallery.push_back(n::slice_axis(v, 3, 1, 2));
  n::save_image_grid(n::concat(gallery, 0), "build/segmentation_losses_fields.png", 4, 0., 1.,
                     8, 1., 2);
  std::filesystem::create_directories("figures");
  std::filesystem::copy_file("build/segmentation_losses_fields.png",
                             "figures/segmentation_losses_fields.png",
                             std::filesystem::copy_options::overwrite_existing);
  dm::graphics::RLayout::create(1, 2).add(a).add(b).size(1200, 540).fit_panels().save_svg(
      "build/segmentation_losses_training.svg");
  std::print("200 explicit Adam(.1) updates fit4608 logit scalars across four independent "
             "fields. Every field reconstructs the same known circle; this is in-sample "
             "optimization only.\n");
}
```
