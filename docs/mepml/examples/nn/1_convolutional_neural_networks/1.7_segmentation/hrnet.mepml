> Persistent streams and full W32 graph

Two stride2 stems and four64-width bottlenecks precede2/3/4 parallel streams
of widths32/64/128/256. Stage module counts1/4/3 give eight all-to-all exchanges;
each module has four basic blocks per branch. Every stream remains active.
Final branches resize to the stride4 grid,concatenate480 channels,project
1x1/BN/ReLU and classify linearly before restoring image size.

The full W32/21-class graph executes29,546,997 learned/58,304 moving-state
scalars and all920 learned tensor gradients at33px below. This is an initialized
graph check,not a pretrained benchmark. Compact W8 uses stem16,stage1width16/
two bottlenecks,two basic blocks per branch and one module per stage. It
retains all four resolutions with382,580 learned scalars. Native96/97px
checks require every compact derivative finite and nonzero.

```{cpp, results="markdown", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

#include <print>
int main() {
  namespace n = dm::nn;
  namespace m = n::models;
  n::set_num_threads(2);
  {
    n::ParameterStore p(17), state(18);
    const auto net = m::HRNet(
        p, state, n::sin(.13 * n::arange(0, 33 * 33 * 3)).reshape({1, 33, 33, 3}), {}, true);
    const auto g = n::grad(n::mean(n::square(net.logits)), p.parameters());
    if (p.count() != 29546997 || state.count() != 58304 || g.size() != 920 ||
        net.fusion_modules != 8 || net.branches.size() != 4 ||
        p.at("head/project/W").shape() != n::Shape{1, 1, 480, 480})
      return 1;
    for (const auto &v : g)
      if (!v.defined() || !std::isfinite(n::sum(n::square(v.to(n::DType::Float64))).item()))
        return 1;
    std::print("Full HRNetV2 W32:{} learned/{} BN state scalars,all{} finite defined "
               "gradients at33px,eight exchanges/four branches.\n",
               p.count(), state.count(), g.size());
  }
  n::ParameterStore p(17), state(18);
  m::HRNetConfig c;
  c.classes = 4;
  c.width = 8;
  c.stem_width = 16;
  c.stage1_width = 16;
  c.stage1_blocks = 2;
  c.blocks = 2;
  c.modules = {1, 1, 1};
  for (int side : {96, 97}) {
    const auto net = m::HRNet(p, state, n::zeros({1, side, side, 3}), c);
    if (p.count() != 382580 || net.logits.shape() != n::Shape{1, side, side, 4} ||
        net.fusion_modules != 3)
      return 1;
    std::print("Compact{}px:{} learned/{} state scalars,branches", side, p.count(),
               state.count());
    for (const auto &branch : net.branches)
      std::print(" {}x{}x{}", branch.shape()[1], branch.shape()[2], branch.shape()[3]);
    std::print(";exact input-aligned logits.\n");
  }
}
```
