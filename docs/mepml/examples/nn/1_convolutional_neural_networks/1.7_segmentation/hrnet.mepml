> A controlled odd-grid exchange with exact route arithmetic

HRNet keeps several resolutions active in parallel. Every exchange module
routes each source into each target stream. Low-to-high routes project1x1/BN
then use corner-aligned bilinear resize. High-to-low routes chain3x3 stride2
convolutions,with ReLU except after the final step. Identity routes retain
their stream. Each target sums all routes,then ReLU.

The following fixed-weight example has a5x7 high stream containing1..35
and a3x4 low stream containing2. Identity1x1 projection and centre-tap3x3
downsampling yield high+2 and low+high[::2,::2]. Their sums are700 and240.
The two source-gradient sums are47 each:35 identity plus12 subsampled terms
for high,and12 identity plus35 resized terms for low. Positive values keep
ReLU derivatives unambiguous. Native independent interpolation/subsampling
checks also verify every source value and derivative on these odd grids.

```{cpp, results="markdown", file="figures/hrnet_exchange.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

#include <print>
int main() {
  namespace n = dm::nn;
  namespace m = n::models;
  n::ParameterStore p(17), state(18);
  m::ResNetNormConfig norm;
  norm.scale = true;
  norm.epsilon = 1e-5;
  auto high = n::arange(1, 36).reshape({1, 5, 7, 1}).requires_grad_(),
       low = n::full({1, 3, 4, 1}, 2.).requires_grad_();
  {
    n::NoGradGuard guard;
    m::HRFuse(p, state, "fuse", {high, low}, {1, 1}, norm);
  }
  for (const auto &name : p.names()) {
    const auto shape = p.at(name).shape();
    if (name.ends_with("/W")) {
      if (shape[0] == 1)
        p.set(name, n::ones(shape));
      else
        p.set(name, n::equal(n::arange(0, 9), 4.).to(n::DType::Float32).reshape(shape));
    } else if (name.ends_with("/gamma"))
      p.set(name, n::full(shape, std::sqrt(1. + norm.epsilon)));
  }
  const auto output = m::HRFuse(p, state, "fuse", {high, low}, {1, 1}, norm);
  const auto gradient = n::grad(n::sum(output[0]) + n::sum(output[1]), {high, low});
  if (std::abs(n::sum(output[0]).item() - 700) > 1e-4 ||
      std::abs(n::sum(output[1]).item() - 240) > 1e-4 ||
      std::abs(n::sum(gradient[0]).item() - 47) > 1e-5 ||
      std::abs(n::sum(gradient[1]).item() - 47) > 1e-5)
    return 1;
  auto a = n::plot_tensor_map(n::reverse(output[0].reshape({5, 7}), {0}), 0, 40),
       b = n::plot_tensor_map(n::reverse(output[1].reshape({3, 4}), {0}), 0, 40),
       c = n::plot_tensor_map(n::reverse(gradient[0].reshape({5, 7}), {0}), 0, 6),
       d = n::plot_tensor_map(n::reverse(gradient[1].reshape({3, 4}), {0}), 0, 6);
  a.title("High target: identity plus low");
  b.title("Low target: identity plus sampled high");
  c.title("High input gradient footprint");
  d.title("Low input gradient footprint");
  std::filesystem::create_directories("build");
  dm::graphics::RLayout::create(2, 2)
      .add(a)
      .add(b)
      .add(c)
      .add(d)
      .size(1200, 1000)
      .fit_panels()
      .save_svg("build/hrnet_exchange.svg");
  std::print("Fixed odd-grid exchange sums700/240;input gradient sums47/47. Native "
             "independent all-value/interpolation/subsample derivatives pass. No optimizer or "
             "fitting in this fixture.\n");
}
```
