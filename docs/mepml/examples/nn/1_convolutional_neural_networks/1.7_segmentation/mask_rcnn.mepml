> Visible optimization of every branch

Warm all learned leaves before Adam(.001). The full compact model fits32epochs,
batch4,512 updates. Each update shares one backbone evaluation across the RPN,
box and mask objectives. Detached RPN proposals plus truth/random regions supply
64 sampled RoIs/image,at most one-quarter foreground. Only positive regions
train masks. The joint objective is RPN logistic/Smooth-L1 + box CE/selected-class
Smooth-L1 + selected sigmoid mask BCE,with explicit`.00005*sum(kernel²)`.
All learned biases remain optimized outside that kernel penalty.

As in the source,the highest validation **box AP50** selects learned weights;
there is no BN state to pair. The restored score is checked before testing.
Test decoding uses learned proposals only,strict class score>.05 and per-class
NMS.3;selected sigmoid28px masks paste at decoded boxes with bilinear border
sampling and inclusive threshold.5. The printed mask metric uses integral
all-point precision-envelope AP,averaged over classes with truth and optionally
over ten IoU thresholds. It is **not official COCO mask AP**:there is no101-point
recall sampling,crowd/area handling or official evaluator protocol.

```{cpp, results="markdown", file="figures/mask_rcnn_training.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

#include <print>
int main() {
  namespace n = dm::nn;
  namespace m = n::models;
  n::set_num_threads(2);

  std::filesystem::path cache;
  if (const auto *p = std::getenv("DATAMUNGE_DATA_DIR"))
    cache = p;
  else if (const auto *p = std::getenv("XDG_CACHE_HOME"))
    cache = std::filesystem::path(p) / "datamunge/datasets";
  else
    cache = std::filesystem::path(std::getenv("HOME")) / ".cache/datamunge/datasets";
  dm::datasets::fetch("mnist", (cache / "mnist").string());

  const auto train = n::load_mnist((cache / "mnist").string(), "train");
  m::DetectionSceneConfig cfg;
  cfg.scenes = 80;
  cfg.seed = 11;
  cfg.max_overlap = 0;
  const auto scenes = m::MakeTensorInstanceScenes(
      n::slice_axis(train.images, 0, 0, 2048), n::slice_axis(train.labels, 0, 0, 2048), cfg);
  const auto anchors = n::anchor_grid(16, 16, 4, {12, 20, 30}, {.5, 1, 2});
  std::vector<std::int64_t> fit_rows(64), val_rows(16);
  std::iota(fit_rows.begin(), fit_rows.end(), 0);
  std::iota(val_rows.begin(), val_rows.end(), 64);
  n::ParameterStore p(17);
  // Warm every backbone,RPN,box and mask leaf before constructing Adam.
  {
    n::NoGradGuard guard;
    const auto net = m::CompactMaskRcnnForward(p, n::zeros({1, 64, 64, 1}));
    const auto boxes = n::tensor({0., 0., 16., 16.}, {1, 4}),
               ids = n::zeros({1}, n::DType::Int64);
    m::PooledDetectionRoiHead(p, m::MaskRoiAlign(net.features, boxes, ids, 4, 7));
    m::MaskRcnnHead(p, m::MaskRoiAlign(net.features, boxes, ids, 4, 14), 32, 10);
  }
  const auto truth_records = [](const m::TensorDetectionScenes &data,
                                const std::vector<std::int64_t> &rows) {
    std::vector<m::DetectionEvaluationTruth> truth;
    for (const auto i : rows) {
      const auto boxes = n::boxes_to_vector(data.boxes[i]);
      const auto labels = data.labels[i].to_vector<int>();
      for (std::size_t k = 0; k < boxes.size(); ++k)
        truth.push_back({int(i), labels[k], boxes[k]});
    }
    return truth;
  };
  // Box-only validation composes tensor inference calls;mask metrics are held for test.
  const auto detect_boxes = [&](const m::TensorDetectionScenes &data,
                                const std::vector<std::int64_t> &rows) {
    n::NoGradGuard guard;
    const auto net =
        m::CompactMaskRcnnForward(p, 2. * n::gather(data.images, n::from_vector(rows)) - 1.);
    const auto proposals = m::ComputeDetectionProposals(net.rpn, anchors, 64, 64);
    const auto regions = m::PackDetectionRois(proposals);
    if (!regions.indices.numel())
      return m::TensorDetections{n::zeros({0, 4}), n::zeros({0}),
                                 n::zeros({0}, n::DType::Int64),
                                 n::zeros({0}, n::DType::Int64)};
    const auto head = m::PooledDetectionRoiHead(
        p, m::MaskRoiAlign(net.features, regions.pixels, regions.indices, 4, 7));
    return m::DecodeDetectionRoiOutputs(head, regions.pixels,
                                        n::gather(n::from_vector(rows), regions.indices));
  };
  const auto val_truth = truth_records(scenes, val_rows);
  const std::vector<int> val_ids(val_rows.begin(), val_rows.end());
  n::OptimizerConfig config;
  config.kind = n::OptimizerKind::Adam;
  n::Optimizer adam(p, .001, config);
  n::BatchOrder order(64, 4, 29);
  n::Generator sampling(7);
  std::vector<n::Tensor> kernels;
  for (const auto &leaf : p.parameters())
    if (leaf.dim() >= 2)
      kernels.push_back(leaf);
  std::filesystem::create_directories("build");
  const std::string checkpoint = "build/mask_rcnn_best.npz";
  double best = -1;
  int selected = 0, steps = 0;
  std::int64_t positive_count = 0;
  std::vector<double> epochs, losses, rpn_trace, box_trace, mask_trace, validation;
  std::print("| epoch | joint loss | RPN | box | mask | val box AP50 "
             "|\n|---:|---:|---:|---:|---:|---:|\n");
  for (int epoch = 1; epoch <= 32; ++epoch) {
    order.begin_epoch();
    double total = 0, pr = 0, br = 0, mr = 0;
    std::size_t seen = 0;
    for (auto rows = order.next(); !rows.empty(); rows = order.next()) {
      const auto net = m::CompactMaskRcnnForward(
          p, 2. * n::gather(scenes.images, n::from_vector(rows)) - 1.);
      const auto proposals = m::ComputeDetectionProposals(net.rpn, anchors, 64, 64);
      const auto batch = m::SampleDetectionRois(scenes, rows, proposals, sampling);
      const auto target = m::MakeDetectionRpnTargets(anchors, scenes, rows, sampling);
      const auto head = m::PooledDetectionRoiHead(
          p, m::MaskRoiAlign(net.features, batch.pixels, batch.indices, 4, 7));
      const auto masks = m::PositiveInstanceMaskTargets(scenes, rows, batch);
      if (!masks.indices.numel())
        return 1;
      const auto logits = m::MaskRcnnHead(
          p, m::MaskRoiAlign(net.features, masks.boxes, masks.indices, 4, 14), 32, 10);
      const auto rpn_loss =
          m::RpnLoss(net.rpn, target.labels, target.weights, target.targets, target.positives);
      const auto box_loss = m::DetectionRoiLoss(head, batch.labels, batch.targets, batch.mask);
      const auto mask_loss = m::SelectedInstanceMaskLoss(logits, masks.labels, masks.targets);
      const auto joint = rpn_loss + box_loss + mask_loss;
      auto penalty = n::zeros({});
      for (const auto &kernel : kernels)
        penalty = penalty + n::sum(n::square(kernel));
      if (!std::isfinite(joint.item()))
        return 1;
      total += joint.item() * rows.size();
      pr += rpn_loss.item() * rows.size();
      br += box_loss.item() * rows.size();
      mr += mask_loss.item() * rows.size();
      seen += rows.size();
      positive_count += masks.indices.numel();
      adam.minimize(joint + .00005 * penalty);
      ++steps;
    }
    const auto metric = m::EvaluateDetectionDataset(
        m::DetectionEvaluationRecords(detect_boxes(scenes, val_rows)), val_truth, val_ids,
        false, true);
    epochs.push_back(epoch);
    losses.push_back(total / seen);
    rpn_trace.push_back(pr / seen);
    box_trace.push_back(br / seen);
    mask_trace.push_back(mr / seen);
    validation.push_back(metric.ap50.item());
    if (validation.back() > best) {
      best = validation.back();
      selected = epoch;
      p.save(checkpoint);
    }
    std::print("| {} | {:.6f} | {:.6f} | {:.6f} | {:.6f} | {:.6f} |\n", epoch, losses.back(),
               rpn_trace.back(), box_trace.back(), mask_trace.back(), validation.back());
  }
  p.load(checkpoint);
  const auto restored = m::EvaluateDetectionDataset(
      m::DetectionEvaluationRecords(detect_boxes(scenes, val_rows)), val_truth, val_ids, false,
      true);
  if (std::abs(restored.ap50.item() - best) > 1e-12)
    return 1;
  const auto digits = n::load_mnist((cache / "mnist").string(), "test");
  cfg.scenes = 8;
  cfg.seed = 22;
  const auto test = m::MakeTensorInstanceScenes(n::slice_axis(digits.images, 0, 0, 512),
                                                n::slice_axis(digits.labels, 0, 0, 512), cfg);
  std::vector<std::int64_t> rows(8);
  std::iota(rows.begin(), rows.end(), 0);
  const std::vector<int> image_ids(rows.begin(), rows.end());
  const auto output = m::DetectCompactMaskRcnn(p, test, rows);
  const auto truth = truth_records(test, rows);
  const auto box_metric = m::EvaluateDetectionDataset(
      m::DetectionEvaluationRecords(output.objects), truth, image_ids, false, true);
  const auto mask50 = m::InstanceMaskAveragePrecision(output, test, 10, .5),
             mask75 = m::InstanceMaskAveragePrecision(output, test, 10, .75);
  auto mask_average = n::zeros({}, n::DType::Float64);
  for (int k = 0; k < 10; ++k)
    mask_average =
        mask_average + m::InstanceMaskAveragePrecision(output, test, 10, .5 + .05 * k) / 10.;
  n::save_image_grid(m::InstanceMaskPreview(test, &output), "build/mask_rcnn_predictions.png",
                     1, 0, 1, 4, 1., 3);
  std::filesystem::create_directories("figures");
  std::filesystem::copy_file("build/mask_rcnn_predictions.png",
                             "figures/mask_rcnn_predictions.png",
                             std::filesystem::copy_options::overwrite_existing);
  auto a = dm::graphics::RPlot::create(), b = dm::graphics::RPlot::create();
  a.lines(epochs, rpn_trace, "RPN", {220, 38, 38})
      .lines(epochs, box_trace, "box", {37, 99, 235})
      .lines(epochs, mask_trace, "mask", {147, 51, 234})
      .title("All three fitted tasks")
      .x_label("epoch")
      .y_label("unregularized mean loss")
      .y_limits(0, 1.3 * std::max({*std::max_element(rpn_trace.begin(), rpn_trace.end()),
                                   *std::max_element(box_trace.begin(), box_trace.end()),
                                   *std::max_element(mask_trace.begin(), mask_trace.end())}));
  b.lines(epochs, validation, "box AP50", {22, 163, 74})
      .title("Validation box selection")
      .x_label("epoch")
      .y_label("inclusive VOC AP50")
      .y_limits(0, 1.25);
  dm::graphics::RLayout::create(1, 2).add(a).add(b).size(1100, 480).fit_panels().save_svg(
      "build/mask_rcnn_training.svg");
  std::print("{} learned scalars,{} Adam updates,{} positive mask training regions;selected "
             "epoch{},validation box AP50 {:.6f}. Test eight scenes/{} digits/{} "
             "detections:box AP50 {:.6f};integral mask AP50 {:.6f},AP75 {:.6f},mean50:95 "
             "{:.6f}. Mask AP is not the official COCO101-point protocol. No moving state.\n",
             p.count(), steps, positive_count, selected, best, truth.size(),
             output.objects.scores.numel(), box_metric.ap50.item(), mask50.item(),
             mask75.item(), mask_average.item());
}
```
