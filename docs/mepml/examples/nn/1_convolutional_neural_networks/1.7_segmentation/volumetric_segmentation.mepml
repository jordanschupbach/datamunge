> Visible whole-model Adam and orthogonal held-out slices

Each complete compact model fits192 visible Adam(.001) updates,eight epochs,
batch one volume. U-Net uses the masked,fit-weighted CE;V-Net uses dense
squared-denominator Dice. Kernel L2 adds`.00005*sum(kernel²)` explicitly.
Every learned bias,BN affine leaf or PReLU slope is still optimized. The two
models have different annotation/objective protocols,so the plots are not a
controlled architecture ranking.

The best dense validation mean-volume Dice selects learned/BN stores together.
Restoration must reproduce that score before held-out scoring. V-Net has no BN
and an empty moving store. U-Net retains the source's **current-volume BN at
inference**,without test moment updates;predictions are therefore evaluated
one volume at a time rather than silently changing the inference batch policy.
Dice/IoU average volumes equally;voxel accuracy uses global confusion counts.
Both-empty foreground scores one. No fitting loop or inference is hidden in
the metric helper.

```{cpp, results="markdown", file="figures/volumetric_segmentation_training.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <print>
int main() {
  int rendered_confusions = 0;
  namespace n             = dm::nn;
  namespace m             = n::models;
  n::set_num_threads(2);
  const auto fit        = m::MakeTensorEllipsoidVolumes(24, 16, 11),
             validation = m::MakeTensorEllipsoidVolumes(8, 16, 22),
             test       = m::MakeTensorEllipsoidVolumes(8, 16, 33);
  std::filesystem::create_directories("build");
  std::filesystem::create_directories("figures");
  auto layout = dm::graphics::RLayout::create(2, 2);
  for (bool vnet : {false, true}) {
    const std::string name = vnet ? "vnet" : "unet3d";
    n::ParameterStore p(17), state(18);
    m::Unet3DConfig   uc;
    uc.base           = 2;
    uc.input_channels = 1;
    uc.classes        = 2;
    uc.valid          = false;
    m::VNetConfig vc;
    vc.base            = 2;
    const auto forward = [&](const n::Tensor& images, bool training, bool update) {
      return vnet ? m::VNet(p, images, vc).logits
                  : m::Unet3D(p, state, images, uc, training, update).logits;
    };
    // Warm every learned leaf before Adam;diagnostics never update BN moments.
    {
      n::NoGradGuard guard;
      forward(n::slice_axis(fit.images, 0, 0, 1), true, false);
    }
    std::vector<std::int64_t> fit_rows(24);
    std::iota(fit_rows.begin(), fit_rows.end(), 0);
    const auto fitting   = m::TensorVolumeBatch(fit, fit_rows, !vnet);
    const auto weights   = m::SparseVolumeClassWeights(fitting.second);
    const auto objective = [&](const std::pair<n::Tensor, n::Tensor>& batch, bool update) {
      const auto logits = forward(batch.first, true, update);
      return vnet
                 ? m::SquaredVolumeDice(
                       n::squeeze(n::slice_axis(n::softmax(logits, 4), 4, 1, 2), {4}), batch.second)
                 : m::SparseVolumeCE(logits, batch.second, 2, weights);
    };
    // Score one volume at a time:U-Net uses current-volume test BN,without updates.
    const auto predict = [&](const m::TensorVolumeData& data) {
      n::NoGradGuard         guard;
      std::vector<n::Tensor> found;
      for (std::int64_t row = 0; row < data.images.shape()[0]; ++row)
        found.push_back(
            n::argmax(forward(n::slice_axis(data.images, 0, row, row + 1), false, false), 4));
      return n::concat(found, 0);
    };
    const auto probe = m::TensorVolumeBatch(fit, {0}, !vnet);
    double     initial;
    {
      n::NoGradGuard guard;
      initial = objective(probe, false).item();
    }
    std::vector<n::Tensor> kernels;
    for (const auto& leaf : p.parameters())
      if (leaf.dim() > 1)
        kernels.push_back(leaf);
    n::OptimizerConfig config;
    config.kind = n::OptimizerKind::Adam;
    n::Optimizer        adam(p, .001, config);
    n::BatchOrder       order(24, 1, 29);
    std::vector<double> epochs, losses, validation_dice;
    double              best     = -1;
    int                 selected = 0, steps = 0;
    const auto          learned = "build/volumetric_segmentation_" + name + ".npz",
               moving           = "build/volumetric_segmentation_" + name + "_state.npz";
    std::print(
        "{}:{} learned/{} moving-state scalars;{} annotations;Adam(.001),batch1.\n",
        name,
        p.count(),
        state.count(),
        vnet ? "dense" : "25% axial");
    std::print("| epoch | mean fitting objective | validation Dice |\n|---:|---:|---:|\n");
    for (int epoch = 1; epoch <= 8; ++epoch) {
      order.begin_epoch();
      double total = 0;
      int    seen  = 0;
      for (auto rows = order.next(); !rows.empty(); rows = order.next()) {
        const auto batch   = m::TensorVolumeBatch(fit, rows, !vnet);
        const auto loss    = objective(batch, true);
        auto       penalty = n::zeros({});
        for (const auto& kernel : kernels)
          penalty = penalty + n::sum(n::square(kernel));
        if (!std::isfinite(loss.item()))
          return 1;
        total += loss.item();
        ++seen;
        adam.minimize(loss + .00005 * penalty);
        ++steps;
      }
      const auto metric = m::VolumePredictionMetrics(predict(validation), validation.labels);
      epochs.push_back(epoch);
      losses.push_back(total / seen);
      validation_dice.push_back(metric.dice.item());
      if (validation_dice.back() > best) {
        best     = validation_dice.back();
        selected = epoch;
        p.save(learned);
        state.save(moving);
      }
      std::print("| {} | {:.6f} | {:.6f} |\n", epoch, losses.back(), validation_dice.back());
    }
    p.load(learned);
    state.load(moving);
    const auto restored = m::VolumePredictionMetrics(predict(validation), validation.labels);
    if (std::abs(restored.dice.item() - best) > 1e-10)
      return 1;
    double learned_probe;
    {
      n::NoGradGuard guard;
      learned_probe = objective(probe, false).item();
    }
    const auto prediction   = predict(test);
    const auto result       = m::VolumePredictionMetrics(prediction, test.labels);
    const auto count_matrix = n::ConfusionMatrix::from_counts(
        n::stack({result.tn, result.fp, result.fn, result.tp}).reshape({2, 2}));
    const auto index = std::to_string(rendered_confusions++);
    count_matrix.save_svg(
        "build/volumetric_segmentation_confusion_api_" + index + ".svg",
        {.title = "Selected-checkpoint voxel counts"});
    count_matrix.save_svg(
        "build/volumetric_segmentation_confusion_api_" + index + "_normalized.svg",
        {.title         = "Selected-checkpoint voxel recall",
         .normalization = n::ConfusionMatrixNormalization::True});

    const auto path = "build/volumetric_segmentation_" + name + "_predictions.png";
    n::save_image_grid(m::VolumeSlicePreview(test, prediction), path, 1, 0, 1, 3, 1., 5);
    std::filesystem::copy_file(
        path,
        "figures/volumetric_segmentation_" + name + "_predictions.png",
        std::filesystem::copy_options::overwrite_existing);
    std::print(
        "{}:{} Adam updates;selected epoch{},validation Dice {:.6f};fixed fitting "
        "objective {:.6f}->{:.6f}. Dense held-out8-volume mean Dice {:.6f},IoU "
        "{:.6f},voxel accuracy {:.6f};TP/FP/FN/TN {}/{}/{}/{}. Both stores "
        "restored;test BN has no moving updates.\n",
        name,
        steps,
        selected,
        best,
        initial,
        learned_probe,
        result.dice.item(),
        result.iou.item(),
        result.accuracy.item(),
        result.tp.item<std::int64_t>(),
        result.fp.item<std::int64_t>(),
        result.fn.item<std::int64_t>(),
        result.tn.item<std::int64_t>());
    auto a = dm::graphics::RPlot::create(), b = dm::graphics::RPlot::create();
    a.lines(epochs, losses, vnet ? "squared Dice" : "weighted CE", {37, 99, 235})
        .title(vnet ? "V-Net dense fitting objective" : "3D U-Net sparse fitting objective")
        .x_label("epoch")
        .y_label("unregularized mean loss")
        .y_limits(0, 1.3 * *std::max_element(losses.begin(), losses.end()));
    b.lines(epochs, validation_dice, "validation Dice", {22, 163, 74})
        .title(vnet ? "V-Net paired restoration" : "3D U-Net paired BN restoration")
        .x_label("epoch")
        .y_label("mean volume foreground Dice")
        .y_limits(0, 1.25);
    layout.add(a).add(b);
  }
  layout.size(1100, 950).fit_panels().save_svg("build/volumetric_segmentation_training.svg");
}
```
