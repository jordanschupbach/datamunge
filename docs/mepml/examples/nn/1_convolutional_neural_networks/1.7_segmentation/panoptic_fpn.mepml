> Route each aligned region to its own feature scale

The instance heads choose level \(\operatorname{clip}(\lfloor4+\log_2(\sqrt{wh}/s_0)\rfloor,2,5)\).
With canonical side32,boxes of side8/16/32/64 route to P2/P3/P4/P5. Constant
feature maps expose this choice exactly. Batch0 maps contain1/2/3/4;batch1
contains11/12/13/14. Regions from batch indices0/0/1/1 must return1/2/13/14.
Every3x3 pooled region has total derivative9 only on its selected image/level,
and zero on the other image. The report shows mean outputs;native checks verify
every pooled value and image/level derivative sum.

```{cpp, results="markdown", file="figures/panoptic_fpn_routing.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

#include <print>
int main() {
  namespace n = dm::nn;
  namespace m = n::models;
  std::vector<n::Tensor> features;
  for (int level = 0; level < 4; ++level) {
    const int side = 16 >> level;
    features.push_back(n::concat({n::full({1, side, side, 1}, double(level + 1)),
                                  n::full({1, side, side, 1}, double(level + 11))},
                                 0)
                           .requires_grad_());
  }
  const auto boxes = n::tensor(
                 {0., 0., 8., 8., 0., 0., 16., 16., 0., 0., 32., 32., 0., 0., 64., 64.},
                 {4, 4}),
             indices = n::from_vector(std::vector<std::int64_t>{0, 0, 1, 1});
  const auto output = m::PanopticRoiAlign(features, boxes, indices, 64, 3, 32);
  const auto mean = n::mean(output, {1, 2, 3});
  const auto g = n::grad(n::sum(output), features);
  std::vector<double> first, second;
  for (const auto &v : g) {
    const auto sums = n::sum(v, {1, 2, 3}).to_vector<double>();
    first.push_back(sums[0]);
    second.push_back(sums[1]);
  }
  auto a = dm::graphics::RPlot::create(), b = dm::graphics::RPlot::create();
  a.bars({2, 3, 4, 5}, mean.to_vector<double>(), "pooled mean", {37, 99, 235}, .6)
      .title("Known level/image routing")
      .x_label("selected P level")
      .y_label("pooled feature mean")
      .y_limits(0, 18);
  b.lines({2, 3, 4, 5}, first, "image0", {22, 163, 74})
      .lines({2, 3, 4, 5}, second, "image1", {220, 38, 38})
      .title("Gradient mass per image/level")
      .x_label("P level")
      .y_label("sum of source derivatives")
      .y_limits(0, 12);
  std::filesystem::create_directories("build");
  dm::graphics::RLayout::create(1, 2).add(a).add(b).size(1100, 480).fit_panels().save_svg(
      "build/panoptic_fpn_routing.svg");
  std::print("P2/P3/P4/P5 means1/2/13/14;selected-image derivative mass9 per "
             "region,other-image mass0. No fitting.\n");
}
```
