> Explicit four-task optimization and paired restoration

Warm all leaves before Adam(.001),then fit512 visible updates,32epochs/batch4.
Each training forward updates ResNet BN once. Shared FPN features supply
1023-anchor RPN proposals,32 sampled RoIs/image(at most one-quarter positive),
aligned box/mask losses and three-class semantic CE. The objective is
RPN logistic/Smooth-L1 + box CE/selected Smooth-L1 + positive selected-mask BCE
+ .5 semantic CE with unit class weights,plus explicit`.00005*sum(kernel²)`.
Every bias,GN/BN affine parameter and learned head remains optimized.

Validation box AP50 selects paired learned/BN stores,as in the source. Both
restore and reproduce the selected validation score before testing. No truth
region is inserted at test time. Predicted semantic stuff and learned masks
merge at instance score>=.5,overlap<=.5 and minimum stuff area32. Dataset PQ
adds per-category IoU/TP/FP/FN before macro averaging;things/stuff scores stay
separate. Integral mask AP remains distinct from official COCO mask AP.

```{cpp, results="markdown", file="figures/panoptic_fpn_training.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

#include <print>
int main() {
  namespace n = dm::nn;
  namespace m = n::models;
  n::set_num_threads(2);

  std::filesystem::path cache;
  if (const auto *p = std::getenv("DATAMUNGE_DATA_DIR"))
    cache = p;
  else if (const auto *p = std::getenv("XDG_CACHE_HOME"))
    cache = std::filesystem::path(p) / "datamunge/datasets";
  else
    cache = std::filesystem::path(std::getenv("HOME")) / ".cache/datamunge/datasets";
  dm::datasets::fetch("mnist", (cache / "mnist").string());

  const auto digits = n::load_mnist((cache / "mnist").string(), "train");
  const auto data =
      m::MakeTensorPanopticScenes(n::slice_axis(digits.images, 0, 0, 2048),
                                  n::slice_axis(digits.labels, 0, 0, 2048), 80, 11);
  const auto &scenes = data.instances;
  const auto anchors = m::CompactPanopticAnchors();
  m::PanopticConfig cfg;
  cfg.size = 64;
  cfg.depth = 18;
  cfg.divisor = 8;
  cfg.width = 32;
  cfg.semantic_width = 16;
  cfg.groups = 8;
  cfg.semantic_classes = 3;
  cfg.grayscale = true;
  std::vector<std::int64_t> val_rows(16);
  std::iota(val_rows.begin(), val_rows.end(), 64);
  n::ParameterStore p(17), state(18);
  // Warm every backbone,FPN,semantic,RPN,box and mask leaf before Adam.
  {
    n::NoGradGuard guard;
    const auto f = m::PanopticBackbone(p, state, n::zeros({2, 64, 64, 1}), cfg);
    m::BuildPanopticRpn(p, f, 32);
    const auto boxes = n::tensor({0., 0., 16., 16.}, {1, 4}),
               ids = n::zeros({1}, n::DType::Int64);
    m::PooledDetectionRoiHead(p, m::PanopticRoiAlign(f.pyramid, boxes, ids, 64, 7, 32), 11,
                              128);
    m::MaskRcnnHead(p, m::PanopticRoiAlign(f.pyramid, boxes, ids, 64, 14, 32), 16, 10);
  }
  if (p.count() != 489751)
    return 1;
  const auto truth_records = [](const m::TensorInstanceScenes &scenes,
                                const std::vector<std::int64_t> &rows) {
    std::vector<m::DetectionEvaluationTruth> result;
    for (const auto row : rows) {
      const auto boxes = n::boxes_to_vector(scenes.boxes[row]);
      const auto labels = scenes.labels[row].to_vector<int>();
      for (std::size_t k = 0; k < boxes.size(); ++k)
        result.push_back({int(row), labels[k], boxes[k]});
    }
    return result;
  };
  const auto predict = [&](const m::TensorInstanceScenes &scenes,
                           const std::vector<std::int64_t> &rows) {
    n::NoGradGuard guard;
    const auto f = m::PanopticBackbone(
        p, state, 2. * n::gather(scenes.images, n::from_vector(rows)) - 1., cfg, false);
    const auto rpn = m::BuildPanopticRpn(p, f, 32);
    return std::make_pair(m::DecodeCompactPanopticInstances(p, f, rpn, anchors, rows),
                          n::argmax(f.semantic, 3));
  };
  const auto val_truth = truth_records(scenes, val_rows);
  const std::vector<int> val_ids(val_rows.begin(), val_rows.end());
  n::OptimizerConfig config;
  config.kind = n::OptimizerKind::Adam;
  n::Optimizer adam(p, .001, config);
  n::BatchOrder order(64, 4, 29);
  n::Generator sampling(7);
  std::vector<n::Tensor> kernels;
  for (const auto &leaf : p.parameters())
    if (leaf.dim() >= 2)
      kernels.push_back(leaf);
  std::filesystem::create_directories("build");
  const std::string learned = "build/panoptic_fpn_best.npz",
                    moving = "build/panoptic_fpn_state.npz";
  double best = -1;
  int selected = 0, steps = 0;
  std::int64_t mask_count = 0;
  std::vector<double> epochs, rpns, boxes, masks, semantics, validation;
  std::print("| epoch | RPN | box | mask | .5 semantic | val box AP50 "
             "|\n|---:|---:|---:|---:|---:|---:|\n");
  for (int epoch = 1; epoch <= 32; ++epoch) {
    order.begin_epoch();
    double r = 0, b = 0, mask = 0, sem = 0;
    std::size_t seen = 0;
    for (auto rows = order.next(); !rows.empty(); rows = order.next()) {
      const auto f = m::PanopticBackbone(
          p, state, 2. * n::gather(scenes.images, n::from_vector(rows)) - 1., cfg, true);
      const auto rpn = m::BuildPanopticRpn(p, f, 32);
      const auto proposals = m::ComputeDetectionProposals(rpn, anchors, 64, 64);
      const auto batch = m::SampleDetectionRois(scenes, rows, proposals, sampling, 32);
      const auto target = m::MakeDetectionRpnTargets(anchors, scenes, rows, sampling);
      const auto head = m::PooledDetectionRoiHead(
          p, m::PanopticRoiAlign(f.pyramid, batch.pixels, batch.indices, 64, 7, 32), 11, 128);
      const auto support = m::PositiveInstanceMaskTargets(scenes, rows, batch);
      if (!support.indices.numel())
        return 1;
      const auto logits = m::MaskRcnnHead(
          p, m::PanopticRoiAlign(f.pyramid, support.boxes, support.indices, 64, 14, 32), 16,
          10);
      const auto rpn_loss =
          m::RpnLoss(rpn, target.labels, target.weights, target.targets, target.positives);
      const auto box_loss = m::DetectionRoiLoss(head, batch.labels, batch.targets, batch.mask);
      const auto mask_loss =
          m::SelectedInstanceMaskLoss(logits, support.labels, support.targets);
      const auto semantic_loss = m::SegmentationCrossEntropy(
          f.semantic, n::gather(data.semantic, n::from_vector(rows)), 3, n::ones({3}));
      const auto joint = rpn_loss + box_loss + mask_loss + .5 * semantic_loss;
      auto penalty = n::zeros({});
      for (const auto &kernel : kernels)
        penalty = penalty + n::sum(n::square(kernel));
      if (!std::isfinite(joint.item()))
        return 1;
      r += rpn_loss.item() * rows.size();
      b += box_loss.item() * rows.size();
      mask += mask_loss.item() * rows.size();
      sem += .5 * semantic_loss.item() * rows.size();
      seen += rows.size();
      mask_count += support.indices.numel();
      adam.minimize(joint + .00005 * penalty);
      ++steps;
    }
    const auto output = predict(scenes, val_rows);
    const auto metric = m::EvaluateDetectionDataset(
        m::DetectionEvaluationRecords(output.first.objects), val_truth, val_ids, false, true);
    epochs.push_back(epoch);
    rpns.push_back(r / seen);
    boxes.push_back(b / seen);
    masks.push_back(mask / seen);
    semantics.push_back(sem / seen);
    validation.push_back(metric.ap50.item());
    if (validation.back() > best) {
      best = validation.back();
      selected = epoch;
      p.save(learned);
      state.save(moving);
    }
    std::print("| {} | {:.6f} | {:.6f} | {:.6f} | {:.6f} | {:.6f} |\n", epoch, rpns.back(),
               boxes.back(), masks.back(), semantics.back(), validation.back());
  }
  p.load(learned);
  state.load(moving);
  const auto restored = m::EvaluateDetectionDataset(
      m::DetectionEvaluationRecords(predict(scenes, val_rows).first.objects), val_truth,
      val_ids, false, true);
  if (std::abs(restored.ap50.item() - best) > 1e-12)
    return 1;
  const auto test_digits = n::load_mnist((cache / "mnist").string(), "test");
  const auto test =
      m::MakeTensorPanopticScenes(n::slice_axis(test_digits.images, 0, 0, 512),
                                  n::slice_axis(test_digits.labels, 0, 0, 512), 8, 22);
  std::vector<std::int64_t> rows(8);
  std::iota(rows.begin(), rows.end(), 0);
  const std::vector<int> ids(rows.begin(), rows.end());
  const auto output = predict(test.instances, rows);
  const auto &detected = output.first;
  const auto predicted_semantic = output.second;
  const auto box_quality =
      m::EvaluateDetectionDataset(m::DetectionEvaluationRecords(detected.objects),
                                  truth_records(test.instances, rows), ids, false, true);
  const auto mask_ap = m::InstanceMaskAveragePrecision(detected, test.instances, 10, .5);
  auto statistics = n::zeros({12, 4}, n::DType::Float64);
  std::vector<n::Tensor> preview;
  const auto image_ids = detected.objects.images.to_vector<std::int64_t>();
  for (int row = 0; row < 8; ++row) {
    std::vector<std::int64_t> index;
    for (std::size_t k = 0; k < image_ids.size(); ++k)
      if (image_ids[k] == row)
        index.push_back(k);
    const auto selected = n::from_vector(index);
    m::TensorMaskDetections local{{n::gather(detected.objects.boxes, selected),
                                   n::gather(detected.objects.scores, selected),
                                   n::gather(detected.objects.labels, selected),
                                   n::gather(detected.objects.images, selected)},
                                  n::gather(detected.masks, selected)};
    const auto semantic = n::slice_axis(predicted_semantic, 0, row, row + 1).reshape({64, 64});
    const auto map = m::MergeTensorPanoptic(semantic, local, {-1, 10, 11}, .5, .5, 32);
    statistics = statistics + m::PanopticStatistics(test.panoptic[row], map, 12);
    if (row < 4) {
      const auto input =
          n::slice_axis(test.instances.images, 0, row, row + 1) * n::ones({1, 1, 1, 3});
      const auto categories =
          n::where(n::equal(semantic, 0.), n::full({}, -1., n::DType::Int64),
                   semantic + n::full({}, 9., n::DType::Int64));
      preview.push_back(
          n::concat({input, m::ColorPanopticCategories(categories).reshape({1, 64, 64, 3}),
                     m::ColorPanopticMap(test.panoptic[row]).reshape({1, 64, 64, 3}),
                     m::ColorPanopticMap(map).reshape({1, 64, 64, 3})},
                    2));
    }
  }
  const auto things = n::less(n::arange(0, 12), 10.);
  const auto all = m::PanopticQuality(statistics, things),
             object = m::PanopticQuality(statistics, things, 1),
             stuff = m::PanopticQuality(statistics, things, 0);
  const auto semantic_quality =
      m::SegmentationPredictionMetrics(predicted_semantic, test.semantic, 3);
  n::save_image_grid(n::concat(preview, 0), "build/panoptic_fpn_predictions.png", 1, 0, 1, 4,
                     1., 3);
  std::filesystem::create_directories("figures");
  std::filesystem::copy_file("build/panoptic_fpn_predictions.png",
                             "figures/panoptic_fpn_predictions.png",
                             std::filesystem::copy_options::overwrite_existing);
  auto a = dm::graphics::RPlot::create(), b = dm::graphics::RPlot::create();
  const double high = std::max({*std::max_element(rpns.begin(), rpns.end()),
                                *std::max_element(boxes.begin(), boxes.end()),
                                *std::max_element(masks.begin(), masks.end()),
                                *std::max_element(semantics.begin(), semantics.end())});
  a.lines(epochs, rpns, "RPN", {220, 38, 38})
      .lines(epochs, boxes, "box", {37, 99, 235})
      .lines(epochs, masks, "mask", {147, 51, 234})
      .lines(epochs, semantics, ".5 semantic", {22, 163, 74})
      .title("Every fitted task")
      .x_label("epoch")
      .y_label("unregularized objective term")
      .y_limits(0, 1.4 * high);
  b.lines(epochs, validation, "box AP50", {22, 163, 74})
      .title("Paired BN selection")
      .x_label("epoch")
      .y_label("inclusive VOC AP50")
      .y_limits(0, 1.25);
  dm::graphics::RLayout::create(1, 2).add(a).add(b).size(1100, 480).fit_panels().save_svg(
      "build/panoptic_fpn_training.svg");
  std::print(
      "{} learned/{} BN state scalars,{} Adam updates/{} positive mask regions;selected "
      "epoch{},validation box AP50 {:.6f}. Test box AP50 {:.6f},integral mask AP50 "
      "{:.6f},semantic mean IoU {:.6f};dataset category-macro PQ {:.6f},SQ {:.6f},RQ "
      "{:.6f},things PQ {:.6f},stuff PQ {:.6f}. Counts aggregate before macro "
      "averaging;custom integral mask AP is not official COCO.\n",
      p.count(), state.count(), steps, mask_count, selected, best, box_quality.ap50.item(),
      mask_ap.item(), semantic_quality.mean_iou.item(), all.pq.item(), all.sq.item(),
      all.rq.item(), object.pq.item(), stuff.pq.item());
}
```
