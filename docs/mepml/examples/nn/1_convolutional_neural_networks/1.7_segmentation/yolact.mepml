\image(figures/yolact_data.png)
// result_end
\caption(Actual first four fitting MNIST scenes and their individual truth supports. Colours identify digit labels;supports remain paired with the same object boxes used by tensor matching.)
\alttext(Actual first four fitting MNIST scenes and their individual truth supports. Colours identify digit labels;supports remain paired with the same object boxes used by tensor matching.)

Each of512 visible Adam(.001) updates trains every backbone,FPN,prediction,
protonet and semantic branch,32epochs/batch4. Per-image3:1 hard-negative mining
uses detached CE with stable lower-index ties;ignored anchors contribute no
classification/regression. Detection sums CE+1.5 Smooth-L1 over anchors and
divides by total positives,floored at one. The full objective adds6.125 times
crop-normalized mask BCE and mean semantic sigmoid BCE;explicit kernel L2
adds`.00005*sum(kernel²)`. No positive anchors leaves semantic BCE only.

Training BN updates once per forward. The highest validation **box AP50** saves
learned and BN stores together;both restore and reproduce that score before
testing. As for the source,mask metrics use integral all-point precision-envelope
AP,not the official COCO101-point/crowd/area protocol. There are no speed or
paper-accuracy claims. Decode clips boxes,retains scores>.05,uses Fast NMS.5,
assembles and crops prototype masks,then bilinearly pastes and thresholds>=.5.

```{cpp, results="markdown", file="figures/yolact_training.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

#include <print>
int main() {
  namespace n = dm::nn;
  namespace m = n::models;
  n::set_num_threads(2);

  std::filesystem::path cache;
  if (const auto *p = std::getenv("DATAMUNGE_DATA_DIR"))
    cache = p;
  else if (const auto *p = std::getenv("XDG_CACHE_HOME"))
    cache = std::filesystem::path(p) / "datamunge/datasets";
  else
    cache = std::filesystem::path(std::getenv("HOME")) / ".cache/datamunge/datasets";
  dm::datasets::fetch("mnist", (cache / "mnist").string());

  const auto train = n::load_mnist((cache / "mnist").string(), "train");
  m::DetectionSceneConfig scene_cfg;
  scene_cfg.scenes = 80;
  scene_cfg.seed = 11;
  scene_cfg.max_overlap = 0;
  const auto scenes =
      m::MakeTensorInstanceScenes(n::slice_axis(train.images, 0, 0, 2048),
                                  n::slice_axis(train.labels, 0, 0, 2048), scene_cfg);
  m::YolactConfig cfg;
  cfg.size = 64;
  cfg.classes = 10;
  cfg.depth = 18;
  cfg.divisor = 8;
  cfg.width = 32;
  cfg.prototypes = 8;
  cfg.grayscale = true;
  std::vector<std::int64_t> val_rows(16);
  std::iota(val_rows.begin(), val_rows.end(), 64);
  n::ParameterStore p(17), state(18);
  n::Tensor anchors;
  // Every model branch and BN affine leaf exists before Adam captures leaves.
  {
    n::NoGradGuard guard;
    const auto net = m::Yolact(p, state, n::zeros({2, 64, 64, 1}), cfg);
    anchors = m::YolactAnchors(net, 64, true);
  }
  const auto truth_records = [](const m::TensorInstanceScenes &data,
                                const std::vector<std::int64_t> &rows) {
    std::vector<m::DetectionEvaluationTruth> truth;
    for (const auto row : rows) {
      const auto boxes = n::boxes_to_vector(data.boxes[row]);
      const auto labels = data.labels[row].to_vector<int>();
      for (std::size_t k = 0; k < boxes.size(); ++k)
        truth.push_back({int(row), labels[k], boxes[k]});
    }
    return truth;
  };
  const auto detect = [&](const m::TensorInstanceScenes &data,
                          const std::vector<std::int64_t> &rows) {
    n::NoGradGuard guard;
    const auto net = m::Yolact(
        p, state, 2. * n::gather(data.images, n::from_vector(rows)) - 1., cfg, false);
    return m::DecodeTensorYolact(net, anchors, rows, 64, 64);
  };
  const auto val_truth = truth_records(scenes, val_rows);
  const std::vector<int> val_ids(val_rows.begin(), val_rows.end());
  n::OptimizerConfig config;
  config.kind = n::OptimizerKind::Adam;
  n::Optimizer adam(p, .001, config);
  n::BatchOrder order(64, 4, 29);
  n::Generator sampling(41);
  std::vector<n::Tensor> kernels;
  for (const auto &leaf : p.parameters())
    if (leaf.dim() >= 2)
      kernels.push_back(leaf);
  std::filesystem::create_directories("build");
  const std::string learned = "build/yolact_best.npz", moving = "build/yolact_state.npz";
  double best = -1;
  int selected = 0, steps = 0;
  std::int64_t selected_masks = 0;
  std::vector<double> epochs, losses, masks, validation;
  std::print("| epoch | joint objective | weighted mask term | val box AP50 "
             "|\n|---:|---:|---:|---:|\n");
  for (int epoch = 1; epoch <= 32; ++epoch) {
    order.begin_epoch();
    double total = 0, mask_total = 0;
    std::size_t seen = 0;
    for (auto rows = order.next(); !rows.empty(); rows = order.next()) {
      const auto net = m::Yolact(
          p, state, 2. * n::gather(scenes.images, n::from_vector(rows)) - 1., cfg, true);
      const auto target = m::MakeTensorYolactTargets(net, anchors, scenes, rows, 10, sampling);
      const auto objective = m::BuildTensorYolactLoss(net, target);
      auto penalty = n::zeros({});
      for (const auto &kernel : kernels)
        penalty = penalty + n::sum(n::square(kernel));
      if (!std::isfinite(objective.loss.item()))
        return 1;
      total += objective.loss.item() * rows.size();
      mask_total += 6.125 * objective.mask_loss.item() * rows.size();
      seen += rows.size();
      selected_masks += target.pairs.shape()[0];
      adam.minimize(objective.loss + .00005 * penalty);
      ++steps;
    }
    const auto output = detect(scenes, val_rows);
    const auto metric = m::EvaluateDetectionDataset(
        m::DetectionEvaluationRecords(output.objects), val_truth, val_ids, false, true);
    epochs.push_back(epoch);
    losses.push_back(total / seen);
    masks.push_back(mask_total / seen);
    validation.push_back(metric.ap50.item());
    if (validation.back() > best) {
      best = validation.back();
      selected = epoch;
      p.save(learned);
      state.save(moving);
    }
    std::print("| {} | {:.6f} | {:.6f} | {:.6f} |\n", epoch, losses.back(), masks.back(),
               validation.back());
  }
  p.load(learned);
  state.load(moving);
  const auto restored = m::EvaluateDetectionDataset(
      m::DetectionEvaluationRecords(detect(scenes, val_rows).objects), val_truth, val_ids,
      false, true);
  if (std::abs(restored.ap50.item() - best) > 1e-12)
    return 1;
  const auto digits = n::load_mnist((cache / "mnist").string(), "test");
  scene_cfg.scenes = 8;
  scene_cfg.seed = 22;
  const auto test =
      m::MakeTensorInstanceScenes(n::slice_axis(digits.images, 0, 0, 512),
                                  n::slice_axis(digits.labels, 0, 0, 512), scene_cfg);
  std::vector<std::int64_t> test_rows(8);
  std::iota(test_rows.begin(), test_rows.end(), 0);
  const std::vector<int> ids(test_rows.begin(), test_rows.end());
  const auto output = detect(test, test_rows);
  const auto truth = truth_records(test, test_rows);
  const auto boxes = m::EvaluateDetectionDataset(m::DetectionEvaluationRecords(output.objects),
                                                 truth, ids, false, true);
  const auto mask50 = m::InstanceMaskAveragePrecision(output, test, 10, .5),
             mask75 = m::InstanceMaskAveragePrecision(output, test, 10, .75);
  auto average = n::zeros({}, n::DType::Float64);
  for (int k = 0; k < 10; ++k)
    average = average + m::InstanceMaskAveragePrecision(output, test, 10, .5 + .05 * k) / 10.;
  n::save_image_grid(m::InstanceMaskPreview(test, &output), "build/yolact_predictions.png", 1,
                     0, 1, 4, 1., 3);
  std::filesystem::create_directories("figures");
  std::filesystem::copy_file("build/yolact_predictions.png", "figures/yolact_predictions.png",
                             std::filesystem::copy_options::overwrite_existing);
  {
    n::NoGradGuard guard;
    const auto net =
        m::Yolact(p, state, 2. * n::slice_axis(test.images, 0, 0, 1) - 1., cfg, false);
    const auto maps = n::transpose(net.prototypes, {0, 3, 1, 2}).reshape({8, 16, 16, 1});
    const double high = n::max(maps).item();
    n::save_image_grid(n::resize_nearest(maps, {64, 64}), "build/yolact_prototypes.png", 4, 0.,
                       std::max(high, 1e-12), 3, 1., 2);
    std::filesystem::copy_file("build/yolact_prototypes.png", "figures/yolact_prototypes.png",
                               std::filesystem::copy_options::overwrite_existing);
    std::print(
        "Restored first test image:eight16px ReLU prototype maps,nearest-expanded64px,shared "
        "intensity range[0,{:.6f}]. These are learned basis activations,not class masks.\n",
        high);
  }
  auto a = dm::graphics::RPlot::create(), b = dm::graphics::RPlot::create();
  a.lines(epochs, losses, "joint", {37, 99, 235})
      .lines(epochs, masks, "6.125 mask", {147, 51, 234})
      .title("Whole-model training objective")
      .x_label("epoch")
      .y_label("unregularized mean loss")
      .y_limits(0, 1.3 * *std::max_element(losses.begin(), losses.end()));
  b.lines(epochs, validation, "box AP50", {22, 163, 74})
      .title("Paired BN checkpoint selection")
      .x_label("epoch")
      .y_label("inclusive VOC AP50")
      .y_limits(0, 1.25);
  dm::graphics::RLayout::create(1, 2).add(a).add(b).size(1100, 480).fit_panels().save_svg(
      "build/yolact_training.svg");
  std::print("{} learned/{} BN state scalars,{} Adam updates/{} selected positive "
             "masks;selected epoch{},validation box AP50 {:.6f}. Held-out{} digits/{} "
             "detections:box AP50 {:.6f};integral mask AP50 {:.6f},AP75 {:.6f},mean50:95 "
             "{:.6f}. Custom integral mask AP is not official COCO.\n",
             p.count(), state.count(), steps, selected_masks, selected, best, truth.size(),
             output.objects.scores.numel(), boxes.ap50.item(), mask50.item(), mask75.item(),
             average.item());
}
```
