\caption(Actual first four fitting RGB images and aligned shape masks. Identical appearance distributions across classes prevent a fixed-colour shortcut.)
\alttext(Actual first four fitting RGB images and aligned shape masks. Identical appearance distributions across classes prevent a fixed-colour shortcut.)

Fit-only inverse-square-root class weights use pseudocount1. Weighted CE is
normalized by selected pixel-weight sum. Each model warms all leaves before
Adam(.001),then fits12 epochs,batch4,192 visible updates with explicit
`.00005*sum(kernel²)` penalty. Every learned parameter is optimized. V1 has
no BN state; V2 moving moments are saved/restored with learned parameters.
Strict validation mean IoU selects each checkpoint,then restoration reproduces
the selected score before test evaluation.

Fixed CRF refinement is evaluated separately on the first four test images
sampled32x32 at pixel centres. At96->32,this selects coordinates1,4,7,...,94
for images,logits and labels alike. Its before/after mIoU is a distinct subset/
resolution measurement from the full16-image96px test metric. The CRF's fixed
settings see no fitting or validation tuning and need not improve every result.

```{cpp, results="markdown", file="figures/deeplab_v1_v2_training.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <print>
int main() {
  int rendered_confusions = 0;
  namespace n             = dm::nn;
  namespace m             = n::models;
  n::set_num_threads(2);
  const auto fit               = m::TensorSegmentationShapes(64, 96, 11),
             validation        = m::TensorSegmentationShapes(16, 96, 22),
             test              = m::TensorSegmentationShapes(16, 96, 33);
  const auto          weights  = m::SegmentationClassWeights(fit.labels, 4);
  const int           n_epochs = 12; // 16 batches of four per epoch
  std::vector<double> epochs;
  for (int epoch = 1; epoch <= n_epochs; ++epoch)
    epochs.push_back(epoch);
  auto loss_plot = dm::graphics::RPlot::create(), score_plot = dm::graphics::RPlot::create();
  const std::array<dm::graphics::RGB, 3> colors = {{{37, 99, 235}, {22, 163, 74}, {220, 38, 38}}};
  int                                    color_index = 0;
  double                                 max_loss    = 0;
  std::filesystem::create_directories("build");
  std::filesystem::create_directories("figures");
  for (int variant : {1, 2}) {
    n::ParameterStore  p(17), state(17);
    m::DeepLabV1Config v1;
    v1.classes          = 4;
    v1.width_divisor    = 8;
    v1.fc_width         = 128;
    v1.fc_rate          = 4;
    v1.keep_probability = 1;
    m::DeepLabV2Config v2;
    v2.classes         = 4;
    v2.backbone_depth  = 18;
    v2.width_divisor   = 8;
    v2.rates           = {1, 2, 3, 4};
    const auto forward = [&](const n::Tensor& images, bool training) {
      return variant == 1 ? m::DeepLabV1(p, images, v1, training).logits
                          : m::DeepLabV2(p, state, images, v2, training).logits;
    };
    // Create every learnable convolution/score leaf before Adam captures the store.
    {
      n::NoGradGuard guard;
      forward(n::slice_axis(fit.images, 0, 0, 1), false);
    }
    n::OptimizerConfig adam_config;
    adam_config.kind = n::OptimizerKind::Adam;
    n::Optimizer           adam(p, .001, adam_config);
    n::BatchOrder          batches(64, 4, 29);
    std::vector<n::Tensor> kernels;
    for (const auto& leaf : p.parameters())
      if (leaf.dim() > 1)
        kernels.push_back(leaf);
    const std::string   prefix   = "build/deeplab_v1_v2_" + std::to_string(variant);
    double              best     = -1;
    int                 selected = 0, updates = 0;
    std::vector<double> losses, miou;
    const auto          evaluate = [&](const m::TensorSegmentationData& data) {
      n::NoGradGuard guard;
      auto           confusion = n::zeros({4, 4}, n::DType::Int64);
      for (int first = 0; first < data.images.shape()[0]; first += 8) {
        const auto end    = std::min<std::int64_t>(first + 8, data.images.shape()[0]);
        const auto logits = forward(n::slice_axis(data.images, 0, first, end), false);
        confusion =
            confusion + m::SegmentationPredictionMetrics(
                            n::argmax(logits, 3), n::slice_axis(data.labels, 0, first, end), 4)
                            .confusion;
      }
      return m::SegmentationConfusionMetrics(confusion);
    };
    std::print(
        "Variant{}: {} learned scalars. Fit-only weights "
        "{:.6f}/{:.6f}/{:.6f}/{:.6f}.\n",
        variant,
        p.count(),
        weights.at({0}),
        weights.at({1}),
        weights.at({2}),
        weights.at({3}));
    std::print(
        "| variant | epoch | weighted pixel CE | validation mIoU |\n|---:|---:|---:|---:|\n");
    for (int epoch = 1; epoch <= n_epochs; ++epoch) {
      batches.begin_epoch();
      double      total = 0;
      std::size_t seen  = 0;
      for (auto rows = batches.next(); !rows.empty(); rows = batches.next()) {
        const auto batch   = m::TensorSegmentationBatch(fit, n::from_vector(rows));
        const auto logits  = forward(batch.first, true);
        const auto ce      = m::SegmentationCrossEntropy(logits, batch.second, 4, weights);
        n::Tensor  penalty = n::zeros({});
        for (const auto& kernel : kernels)
          penalty = penalty + n::sum(n::square(kernel));
        if (!std::isfinite(ce.item()))
          return 1;
        total += ce.item() * rows.size();
        seen += rows.size();
        adam.minimize(ce + .00005 * penalty);
        ++updates;
      }
      const auto metric = evaluate(validation);
      losses.push_back(total / double(seen));
      miou.push_back(metric.mean_iou.item());
      if (miou.back() > best) {
        best     = miou.back();
        selected = epoch;
        p.save(prefix + "_best.npz");
        state.save(prefix + "_best_state.npz");
      }
      std::print("| {} | {} | {:.6f} | {:.6f} |\n", variant, epoch, losses.back(), miou.back());
    }
    p.load(prefix + "_best.npz");
    state.load(prefix + "_best_state.npz");
    const auto restored = evaluate(validation), metric = evaluate(test);
    const auto count_matrix = n::ConfusionMatrix::from_counts(metric.confusion);
    const auto index        = std::to_string(rendered_confusions++);
    count_matrix.save_svg(
        "build/deeplab_v1_v2_confusion_api_" + index + ".svg",
        {.title = "Selected-checkpoint pixel counts"});
    count_matrix.save_svg(
        "build/deeplab_v1_v2_confusion_api_" + index + "_normalized.svg",
        {.title         = "Selected-checkpoint pixel recall",
         .normalization = n::ConfusionMatrixNormalization::True});

    if (std::abs(restored.mean_iou.item() - best) > 1e-12 || updates != 16 * n_epochs)
      return 1;
    n::NoGradGuard         guard;
    std::vector<n::Tensor> gallery;
    const auto prediction = n::argmax(forward(n::slice_axis(test.images, 0, 0, 4), false), 3);
    const auto truth      = m::ColorSegmentationLabels(n::slice_axis(test.labels, 0, 0, 4)),
               colored    = m::ColorSegmentationLabels(prediction);
    for (int i = 0; i < 4; ++i) {
      gallery.push_back(n::slice_axis(test.images, 0, i, i + 1));
      gallery.push_back(n::slice_axis(truth, 0, i, i + 1));
      gallery.push_back(n::slice_axis(colored, 0, i, i + 1));
    }
    const auto image_name = "deeplab_v1_v2_predictions_" + std::to_string(variant) + ".png";
    n::save_image_grid(n::concat(gallery, 0), "build/" + image_name, 3, 0., 1., 3, 1., 2);
    std::filesystem::copy_file(
        "build/" + image_name,
        "figures/" + image_name,
        std::filesystem::copy_options::overwrite_existing);
    // Fixed CRF inference is evaluated separately on32px pixel-centre samples.
    auto before = n::zeros({4, 4}, n::DType::Int64), after = n::zeros({4, 4}, n::DType::Int64);
    std::vector<n::Tensor> crf_gallery;
    for (int i = 0; i < 4; ++i) {
      const auto image = m::SampleSegmentationGrid(n::slice_axis(test.images, 0, i, i + 1)),
                 unary = m::SampleSegmentationGrid(
                             forward(n::slice_axis(test.images, 0, i, i + 1), false))
                             .reshape({1024, 4}),
                 truth = m::SampleSegmentationGrid(
                             n::slice_axis(test.labels, 0, i, i + 1).reshape({1, 96, 96, 1}))
                             .reshape({1, 32, 32}),
                 raw = n::argmax(unary, 1).reshape({1, 32, 32}),
                 refined =
                     n::argmax(
                         m::DenseCrfMeanField(unary, m::DenseCrfKernel(image.reshape({32, 32, 3}))),
                         1)
                         .reshape({1, 32, 32});
      before = before + m::SegmentationPredictionMetrics(raw, truth, 4).confusion;
      after  = after + m::SegmentationPredictionMetrics(refined, truth, 4).confusion;
      crf_gallery.push_back(image);
      crf_gallery.push_back(m::ColorSegmentationLabels(truth));
      crf_gallery.push_back(m::ColorSegmentationLabels(raw));
      crf_gallery.push_back(m::ColorSegmentationLabels(refined));
    }
    const auto crf_name = "deeplab_v1_v2_crf_" + std::to_string(variant) + ".png";
    n::save_image_grid(n::concat(crf_gallery, 0), "build/" + crf_name, 4, 0., 1., 3, 1., 3);
    std::filesystem::copy_file(
        "build/" + crf_name,
        "figures/" + crf_name,
        std::filesystem::copy_options::overwrite_existing);
    std::print(
        "Variant{} fixed five-step CRF on first four32px sampled test scenes: mIoU "
        "{:.6f} -> {:.6f}. This subset/resolution score is separate from the "
        "full16-scene96px test metric.\n",
        variant,
        m::SegmentationConfusionMetrics(before).mean_iou.item(),
        m::SegmentationConfusionMetrics(after).mean_iou.item());
    const auto color = colors[color_index++];
    const auto name  = "DeepLab v" + std::to_string(variant);
    loss_plot.lines(epochs, losses, name, color);
    score_plot.lines(epochs, miou, name, color);
    max_loss = std::max(max_loss, *std::max_element(losses.begin(), losses.end()));
    std::print(
        "Variant{} restored epoch{}: validation mIoU {:.6f}; test pixel accuracy "
        "{:.6f}, mean IoU {:.6f}; per-class IoU(background,circle,rectangle,triangle) "
        "{:.6f}/{:.6f}/{:.6f}/{:.6f}. {} explicit Adam updates.\n",
        variant,
        selected,
        best,
        metric.pixel_accuracy.item(),
        metric.mean_iou.item(),
        metric.iou.at({0}),
        metric.iou.at({1}),
        metric.iou.at({2}),
        metric.iou.at({3}),
        updates);
  }
  loss_plot.title("DeepLab weighted pixel loss")
      .x_label("epoch")
      .y_label("unregularized weighted CE")
      .y_limits(0, max_loss * 1.3);
  score_plot.title("Validation mean IoU selection")
      .x_label("epoch")
      .y_label("present-class mIoU")
      .y_limits(0, 1.3);
  dm::graphics::RLayout::create(1, 2)
      .add(loss_plot)
      .add(score_plot)
      .size(1200, 550)
      .fit_panels()
      .save_svg("build/deeplab_v1_v2_training.svg");
}
