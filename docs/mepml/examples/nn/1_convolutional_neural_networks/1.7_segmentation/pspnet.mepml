> Overlapping adaptive bins on a known rectangular grid

PSPNet summarizes dense features at1/2/3/6 spatial bin scales,projects each,
resizes them to the encoder grid and concatenates them with the original
features. Adaptive-bin starts are `floor(i*H/bins)` and ends are
`ceil((i+1)*H/bins)`. Odd-grid bins overlap: repeated source pixels receive
the sum of every contributing mean derivative. Bins may exceed an input axis;
a1x1 image copied into6x6 bins has derivative36 per channel for a summed output.

On the known5x7 grid containing0..34,three-bin row ranges are[0,2),[1,4),[3,5)
and column ranges[0,3),[2,5),[4,7). The centre mean is17. The following
code checks every mean and derivative with independent loop arithmetic.

```{cpp, results="markdown", file="figures/pspnet_bins.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

#include <print>
int main() {
  namespace n = dm::nn;
  namespace m = n::models;
  auto x = n::arange(0, 35, 1, n::DType::Float64).reshape({1, 5, 7, 1}).requires_grad_();
  const auto pool = m::AdaptiveAveragePool(x, 3), g = n::grad(n::sum(pool), {x})[0];
  std::vector<double> expected(35);
  double error = 0;
  for (int by = 0; by < 3; ++by)
    for (int bx = 0; bx < 3; ++bx) {
      const int y0 = by * 5 / 3, y1 = ((by + 1) * 5 + 2) / 3, x0 = bx * 7 / 3,
                x1 = ((bx + 1) * 7 + 2) / 3;
      double mean = 0;
      for (int y = y0; y < y1; ++y)
        for (int c = x0; c < x1; ++c) {
          mean += (y * 7 + c) / double((y1 - y0) * (x1 - x0));
          expected[y * 7 + c] += 1. / double((y1 - y0) * (x1 - x0));
        }
      error = std::max(error, std::abs(pool.at({0, by, bx, 0}) - mean));
    }
  for (int i = 0; i < 35; ++i)
    error = std::max(error, std::abs(g.reshape({35}).at({i}) - expected[i]));
  if (error > 1e-12)
    return 1;
  auto a = n::plot_tensor_map(n::reverse(pool.reshape({3, 3}), {0}), 0, 34),
       b = n::plot_tensor_map(n::reverse(g.reshape({5, 7}), {0}), 0, 1);
  a.title("Known3 by3 adaptive means").x_label("bin column").y_label("bin row");
  b.title("Overlapping source derivatives").x_label("source column").y_label("source row");
  std::filesystem::create_directories("build");
  dm::graphics::RLayout::create(1, 2).add(a).add(b).size(1200, 550).fit_panels().save_svg(
      "build/pspnet_bins.svg");
  std::print("All nine means and35 source derivatives match independent bin loops,max error "
             "{:.12f};centre mean {:.6f}. Native "
             "rectangular/multibatch/channel/bin-larger-than-grid tests also pass.\n",
             error, pool.at({0, 1, 1, 0}));
}
```
