> Full released and compact graph checks

The full32s/16s/8s models have134,346,581/134,357,354/134,362,751 learned
scalars and32/34/36 learned tensor gradients. All three full backwards execute
below on an8x8 RGB image with released padding/crops; this checks the graph
and does not train a full benchmark model. Compact counts are271,916/272,176/
272,308 with every learned gradient nonzero in the96-pixel native probe.

```{cpp, results="markdown", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

#include <print>
int main() {
  namespace n = dm::nn;
  n::set_num_threads(2);
  const std::array<int, 3> strides = {32, 16, 8};
  const std::array<std::int64_t, 3> counts = {134346581, 134357354, 134362751};
  for (int i = 0; i < 3; ++i) {
    n::ParameterStore p(17);
    n::models::FcnConfig c;
    c.stride = strides[i];
    const auto net = n::models::Fcn(
        p, n::sin(.13 * n::arange(0, 8 * 8 * 3)).reshape({1, 8, 8, 3}), c, true);
    const auto g = n::grad(n::mean(n::square(net.logits)), p.parameters());
    if (p.count() != counts[i] || g.size() != std::size_t(32 + 2 * i) ||
        net.logits.shape() != n::Shape{1, 8, 8, 21})
      return 1;
    for (const auto &v : g)
      if (!v.defined() || !std::isfinite(n::sum(n::square(v.to(n::DType::Float64))).item()))
        return 1;
    std::print("Full FCN-{}s: {} learned scalars,all{} finite gradients;8x8 logits with "
               "released padding/crops.\n",
               strides[i], p.count(), g.size());
  }
  for (int stride : strides) {
    n::ParameterStore p(17);
    n::models::FcnConfig c;
    c.stride = stride;
    c.compact = true;
    c.width_divisor = 8;
    c.fc_width = 64;
    c.classes = 4;
    c.keep_probability = 1;
    for (int side : {95, 96, 97}) {
      const auto net = n::models::Fcn(p, n::zeros({1, side, side, 3}), c);
      if (net.logits.shape() != n::Shape{1, side, side, 4})
        return 1;
    }
    std::print("Compact FCN-{}s:{} learned scalars; exact95/96/97px grids.\n", stride,
               p.count());
  }
}
```
