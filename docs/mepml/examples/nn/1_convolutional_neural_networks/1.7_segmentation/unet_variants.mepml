> An additive gate with hand-checkable derivatives

An attention gate projects the encoder skip and decoder context into a hidden
space,adds them,applies ReLU,then a1x1 projection and sigmoid. The coefficient
multiplies every skip channel at that location. Both input paths receive
gradients; the coefficient is not a hard crop or a ground-truth mask.

This fixture sets all projections explicitly. With skip x and context g=.4,
`z=2*x-g+.3`, `a=sigmoid(1.5*ReLU(z)-.2)` and output `x*a`.
Its skip derivative is `a+x*a*(1-a)*3` when z>0,and a otherwise;
its context derivative is `-1.5*x*a*(1-a)` when z>0,and zero otherwise.
The following61 points avoid the ReLU kink; the native fixtures also check
negative projections and sigmoid saturation.

```{cpp, results="markdown", file="figures/unet_variants_gate.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

#include <print>
int main() {
  namespace n = dm::nn;
  namespace m = n::models;
  const auto type = n::DType::Float64;
  n::ParameterStore p(17, type);
  p.set("gate/x/W", n::full({1, 1, 1, 1}, 2., type));
  p.set("gate/x/b", n::full({1}, .1, type));
  p.set("gate/g/W", n::full({1, 1, 1, 1}, -1., type));
  p.set("gate/g/b", n::full({1}, .2, type));
  p.set("gate/psi/W", n::full({1, 1, 1, 1}, 1.5, type));
  p.set("gate/psi/b", n::full({1}, -.2, type));
  auto x = n::linspace(-3, 3, 61, type).reshape({1, 1, 61, 1}).requires_grad_(),
       g = n::full({1, 1, 61, 1}, .4, type).requires_grad_();
  const auto net = m::AttentionGate(p, "gate", x, g, 1);
  const auto derivatives = n::grad(n::sum(net.output), {x, g});
  double error = 0;
  for (int i = 0; i < 61; ++i) {
    const double value = x.reshape({61}).at({i}), z = 2 * value - .1,
                 a = 1 / (1 + std::exp(-(1.5 * std::max(z, 0.) - .2))),
                 dx = a + (z > 0 ? value * a * (1 - a) * 3 : 0),
                 dg = z > 0 ? -1.5 * value * a * (1 - a) : 0;
    error = std::max({error, std::abs(net.coefficients.reshape({61}).at({i}) - a),
                      std::abs(net.output.reshape({61}).at({i}) - value * a),
                      std::abs(derivatives[0].reshape({61}).at({i}) - dx),
                      std::abs(derivatives[1].reshape({61}).at({i}) - dg)});
  }
  if (error > 1e-12)
    return 1;
  const auto axis = x.to_vector<double>();
  auto a = dm::graphics::RPlot::create(), b = dm::graphics::RPlot::create();
  a.lines(axis, net.coefficients.to_vector<double>(), "coefficient", {37, 99, 235})
      .title("Explicit additive sigmoid gate")
      .x_label("skip input")
      .y_label("shared channel coefficient")
      .y_limits(0, 1.3);
  b.lines(axis, derivatives[0].to_vector<double>(), "skip derivative", {22, 163, 74})
      .lines(axis, derivatives[1].to_vector<double>(), "context derivative", {220, 38, 38})
      .title("Both gated-output derivatives")
      .x_label("skip input")
      .y_label("derivative of gated output")
      .y_limits(-.5, 1.7);
  std::filesystem::create_directories("build");
  dm::graphics::RLayout::create(1, 2).add(a).add(b).size(1200, 550).fit_panels().save_svg(
      "build/unet_variants_gate.svg");
  std::print("All61 gate values,outputs and both input derivatives match independent "
             "formulas,max error {:.12f}. Native tests additionally cover negative ReLU "
             "branches and saturated sigmoid.\n",
             error);
}
```
