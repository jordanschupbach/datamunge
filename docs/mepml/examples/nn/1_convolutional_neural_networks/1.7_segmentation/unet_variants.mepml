\caption(Actual first four fitting image/mask pairs,with shared photometry distributions across classes and aligned occlusion labels.)
\alttext(Actual first four fitting image/mask pairs,with shared photometry distributions across classes and aligned occlusion labels.)

Every learned leaf and every nested head is created before Adam(.001).
Both compact models separately fit24 epochs,batch4,192 visible updates using
fit-only inverse-square-root pixel weights with pseudocount1. UNet++ averages
weighted CE across all four heads; attention U-Net has one head. Explicit
kernel L2 adds `.00005*sum(kernel²)` after that average. All learned leaves
are optimized; no BN state exists. Strict validation mean IoU selects a learned
checkpoint,restored and checked before test evaluation. Validation/test do
not fit weights or choose augmentation. These are procedural demonstrations,
not medical-image training or an architecture benchmark ranking.

```{cpp, results="markdown", file="figures/unet_variants_training.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <print>
int main() {
  int rendered_confusions = 0;
  namespace n             = dm::nn;
  namespace m             = n::models;
  n::set_num_threads(2);
  const auto fit              = m::TensorSegmentationShapes(32, 48, 11),
             validation       = m::TensorSegmentationShapes(16, 48, 22),
             test             = m::TensorSegmentationShapes(16, 48, 33);
  const auto          weights = m::SegmentationClassWeights(fit.labels, 4);
  std::vector<double> epochs;
  for (int epoch = 1; epoch <= 24; ++epoch)
    epochs.push_back(epoch);
  auto loss_plot = dm::graphics::RPlot::create(), score_plot = dm::graphics::RPlot::create();
  const std::array<dm::graphics::RGB, 3> colors = {{{37, 99, 235}, {22, 163, 74}, {220, 38, 38}}};
  int                                    color_index = 0;
  double                                 max_loss    = 0;
  std::filesystem::create_directories("build");
  std::filesystem::create_directories("figures");
  for (int variant : {0, 1}) {
    n::ParameterStore   p(17);
    m::NestedUnetConfig nested_config;
    nested_config.classes    = 4;
    nested_config.base_width = 8;
    m::AttentionUnetConfig attention_config;
    attention_config.classes    = 4;
    attention_config.base_width = 8;
    const auto forward          = [&](const n::Tensor& images, bool) {
      if (variant == 0)
        return m::NestedUnet(p, images, nested_config).heads;
      return std::vector<n::Tensor>{m::AttentionUnet(p, images, attention_config).logits};
    };
    // Create every learnable convolution/score leaf before Adam captures the store.
    {
      n::NoGradGuard guard;
      forward(n::slice_axis(fit.images, 0, 0, 1), false);
    }
    n::OptimizerConfig adam_config;
    adam_config.kind = n::OptimizerKind::Adam;
    n::Optimizer           adam(p, .001, adam_config);
    n::BatchOrder          batches(32, 4, 29);
    std::vector<n::Tensor> kernels;
    for (const auto& leaf : p.parameters())
      if (leaf.dim() > 1)
        kernels.push_back(leaf);
    const std::string   prefix   = "build/unet_variants_" + std::to_string(variant);
    double              best     = -1;
    int                 selected = 0, updates = 0;
    std::vector<double> losses, miou;
    const auto          evaluate = [&](const m::TensorSegmentationData& data) {
      n::NoGradGuard guard;
      auto           confusion = n::zeros({4, 4}, n::DType::Int64);
      for (int first = 0; first < data.images.shape()[0]; first += 8) {
        const auto end    = std::min<std::int64_t>(first + 8, data.images.shape()[0]);
        const auto logits = forward(n::slice_axis(data.images, 0, first, end), false);
        confusion         = confusion +
                    m::SegmentationPredictionMetrics(
                        n::argmax(logits.back(), 3), n::slice_axis(data.labels, 0, first, end), 4)
                        .confusion;
      }
      return m::SegmentationConfusionMetrics(confusion);
    };
    std::print(
        "Variant{}: {} learned scalars, no BN state. Fit-only weights "
        "{:.6f}/{:.6f}/{:.6f}/{:.6f}.\n",
        variant,
        p.count(),
        weights.at({0}),
        weights.at({1}),
        weights.at({2}),
        weights.at({3}));
    std::print(
        "| variant | epoch | weighted pixel CE | validation mIoU |\n|---:|---:|---:|---:|\n");
    for (int epoch = 1; epoch <= 24; ++epoch) {
      batches.begin_epoch();
      double      total = 0;
      std::size_t seen  = 0;
      for (auto rows = batches.next(); !rows.empty(); rows = batches.next()) {
        const auto batch  = m::TensorSegmentationBatch(fit, n::from_vector(rows));
        const auto logits = forward(batch.first, true);
        n::Tensor  ce     = n::zeros({});
        for (const auto& head : logits)
          ce = ce + m::SegmentationCrossEntropy(head, batch.second, 4, weights);
        ce                = ce / double(logits.size());
        n::Tensor penalty = n::zeros({});
        for (const auto& kernel : kernels)
          penalty = penalty + n::sum(n::square(kernel));
        if (!std::isfinite(ce.item()))
          return 1;
        total += ce.item() * rows.size();
        seen += rows.size();
        adam.minimize(ce + .00005 * penalty);
        ++updates;
      }
      const auto metric = evaluate(validation);
      losses.push_back(total / double(seen));
      miou.push_back(metric.mean_iou.item());
      if (miou.back() > best) {
        best     = miou.back();
        selected = epoch;
        p.save(prefix + "_best.npz");
      }
      std::print("| {} | {} | {:.6f} | {:.6f} |\n", variant, epoch, losses.back(), miou.back());
    }
    p.load(prefix + "_best.npz");
    const auto restored = evaluate(validation), metric = evaluate(test);
    const auto count_matrix = n::ConfusionMatrix::from_counts(metric.confusion);
    const auto index        = std::to_string(rendered_confusions++);
    count_matrix.save_svg(
        "build/unet_variants_confusion_api_" + index + ".svg",
        {.title = "Selected-checkpoint pixel counts"});
    count_matrix.save_svg(
        "build/unet_variants_confusion_api_" + index + "_normalized.svg",
        {.title         = "Selected-checkpoint pixel recall",
         .normalization = n::ConfusionMatrixNormalization::True});

    if (std::abs(restored.mean_iou.item() - best) > 1e-12 || updates != 192)
      return 1;
    n::NoGradGuard         guard;
    std::vector<n::Tensor> gallery;
    const auto             prediction =
        n::argmax(forward(n::slice_axis(test.images, 0, 0, 4), false).back(), 3);
    const auto truth   = m::ColorSegmentationLabels(n::slice_axis(test.labels, 0, 0, 4)),
               colored = m::ColorSegmentationLabels(prediction);
    for (int i = 0; i < 4; ++i) {
      gallery.push_back(n::slice_axis(test.images, 0, i, i + 1));
      gallery.push_back(n::slice_axis(truth, 0, i, i + 1));
      gallery.push_back(n::slice_axis(colored, 0, i, i + 1));
    }
    const auto image_name = "unet_variants_predictions_" + std::to_string(variant) + ".png";
    n::save_image_grid(n::concat(gallery, 0), "build/" + image_name, 3, 0., 1., 3, 1., 2);
    std::filesystem::copy_file(
        "build/" + image_name,
        "figures/" + image_name,
        std::filesystem::copy_options::overwrite_existing);
    if (variant == 1) {
      const auto gates =
          m::AttentionUnet(p, n::slice_axis(test.images, 0, 0, 1), attention_config).coefficients;
      std::vector<n::Tensor> maps;
      for (std::size_t i = 0; i < gates.size(); ++i) {
        maps.push_back(n::resize_nearest(gates[i], {48, 48}));
        std::print(
            "Restored attention gate{}:{}x{},coefficient range[{:.6f},{:.6f}].\n",
            i + 1,
            gates[i].shape()[1],
            gates[i].shape()[2],
            n::min(gates[i]).item(),
            n::max(gates[i]).item());
      }
      n::save_image_grid(n::concat(maps, 0), "build/unet_variants_gates.png", 2, 0., 1., 3, 1., 2);
      std::filesystem::copy_file(
          "build/unet_variants_gates.png",
          "figures/unet_variants_gates.png",
          std::filesystem::copy_options::overwrite_existing);
    }
    const auto        color = colors[color_index++];
    const std::string name  = variant == 0 ? "UNet++" : "attention";
    loss_plot.lines(epochs, losses, name, color);
    score_plot.lines(epochs, miou, name, color);
    max_loss = std::max(max_loss, *std::max_element(losses.begin(), losses.end()));
    std::print(
        "Variant{} restored epoch{}: validation mIoU {:.6f}; test pixel accuracy "
        "{:.6f}, mean IoU {:.6f}; per-class IoU(background,circle,rectangle,triangle) "
        "{:.6f}/{:.6f}/{:.6f}/{:.6f}. {} explicit Adam updates.\n",
        variant,
        selected,
        best,
        metric.pixel_accuracy.item(),
        metric.mean_iou.item(),
        metric.iou.at({0}),
        metric.iou.at({1}),
        metric.iou.at({2}),
        metric.iou.at({3}),
        updates);
  }
  loss_plot.title("Nested and attention field losses")
      .x_label("epoch")
      .y_label("unregularized weighted CE")
      .y_limits(0, max_loss * 1.3);
  score_plot.title("Validation mean IoU selection")
      .x_label("epoch")
      .y_label("present-class mIoU")
      .y_limits(0, 1.3);
  dm::graphics::RLayout::create(1, 2)
      .add(loss_plot)
      .add(score_plot)
      .size(1200, 550)
      .fit_panels()
      .save_svg("build/unet_variants_training.svg");
}
```
