> Fit-only IoU dimension priors

YOLO v2 replaces YOLO v1's direct root-size outputs with dimension priors.
Centres are sigmoid cell offsets; sizes exponentiate log ratios from priors.
Prior dimensions are in feature-grid units. The source's IoU-distance
clustering starts from sample0, repeatedly selects the farthest sample from
existing centres, then alternates highest-IoU assignment and arithmetic means.
It retains empty centres, stops below1e-5 change or100 iterations and sorts by
area. All arithmetic, assignment and updates use tensors; this preprocessing
algorithm has no gradient optimizer. It sees **only fitting boxes**.

The report uses64 fit/16 validation scenes from the first2048 official MNIST
training digits(seed11), plus eight test scenes from the first512 official test
digits(seed22). Five priors serve flat10-class detection; three serve the
joint12-node hierarchy. The entire set of fit-box dimension samples is plotted.
Validation/test boxes never influence clustering.

```{cpp, results="markdown", file="figures/yolo_v2_priors.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

#include <print>
int main() {
  namespace n = dm::nn;
  namespace m = n::models;

  std::filesystem::path cache;
  if (const auto *p = std::getenv("DATAMUNGE_DATA_DIR"))
    cache = p;
  else if (const auto *p = std::getenv("XDG_CACHE_HOME"))
    cache = std::filesystem::path(p) / "datamunge/datasets";
  else
    cache = std::filesystem::path(std::getenv("HOME")) / ".cache/datamunge/datasets";
  dm::datasets::fetch("mnist", (cache / "mnist").string());

  const auto digits = n::load_mnist((cache / "mnist").string(), "train");
  m::DetectionSceneConfig cfg;
  cfg.scenes = 80;
  cfg.seed = 11;
  const auto scenes = m::MakeTensorDetectionScenes(
      n::slice_axis(digits.images, 0, 0, 2048), n::slice_axis(digits.labels, 0, 0, 2048), cfg);
  std::vector<n::Tensor> samples;
  for (int row = 0; row < 64; ++row)
    samples.push_back((n::slice_axis(scenes.boxes[row], 1, 2, 4) -
                       n::slice_axis(scenes.boxes[row], 1, 0, 2)) /
                      8.);
  const auto dimensions = n::concat(samples, 0),
             five = m::ClusterYoloDimensions(dimensions, 5),
             three = m::ClusterYoloDimensions(dimensions, 3);
  const auto xy = n::unstack(dimensions, 1);
  auto plot = [&](const n::Tensor &priors, const std::string &title) {
    const auto p = n::unstack(priors, 1);
    auto a = dm::graphics::RPlot::create();
    a.points(xy[1].to_vector<double>(), xy[0].to_vector<double>(), "fit dimensions",
             {100, 116, 139})
        .points(p[1].to_vector<double>(), p[0].to_vector<double>(), "cluster centres",
                {220, 38, 38})
        .title(title)
        .x_label("width in stride8 cells")
        .y_label("height in stride8 cells")
        .x_limits(0, 5)
        .y_limits(0, 5);
    return a;
  };
  std::filesystem::create_directories("build");
  dm::graphics::RLayout::create(1, 2)
      .add(plot(five, "Five flat-head priors"))
      .add(plot(three, "Three hierarchy priors"))
      .size(1200, 650)
      .fit_panels()
      .save_svg("build/yolo_v2_priors.svg");
  std::print("{} fit-only box dimensions.\n| head | height | width |\n|---|---:|---:|\n",
             dimensions.shape()[0]);
  for (bool joint : {false, true}) {
    const auto p = joint ? three : five;
    for (std::int64_t i = 0; i < p.shape()[0]; ++i)
      std::print("| {} | {:.6f} | {:.6f} |\n", joint ? "joint" : "flat", p.at({i, 0}),
                 p.at({i, 1}));
    const auto overlap = m::YoloDimensionIoU(dimensions.reshape({dimensions.shape()[0], 1, 2}),
                                             p.reshape({1, p.shape()[0], 2}));
    std::print("{} mean best shape IoU{:.6f}.\n", joint ? "Joint" : "Flat",
               n::mean(n::max(overlap, {1})).item());
  }
  const auto known =
      m::ClusterYoloDimensions(n::tensor({2., 4., 8., 4., 2., 4., 8., 4.}, {4, 2}), 2);
  if (known.to_vector<int>() != std::vector<int>{2, 4, 8, 4})
    return 1;
}
