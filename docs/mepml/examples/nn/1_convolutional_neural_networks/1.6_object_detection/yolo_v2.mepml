> Full Darknet graphs and compact multiscale inputs

YOLO v2 retains all18 Darknet feature convolutions, two extra convolutions, a
reduced fine route with2x2 space-to-depth passthrough, a fusion convolution and
biased linear head. Other convolutions have BN gamma/beta,epsilon1e-5,
momentum.9 and leaky-ReLU.1. No pretrained ImageNet weights are loaded.

The next block executes full-width20-class/five-prior and9418-node/three-prior
heads at128 pixels, computing all68 learned tensor gradients in each.
Counts are50,655,389 and79,502,989 learned scalars, with20,672 BN-state scalars.
These are initialized graph checks; no9418-class dataset accuracy is claimed.
Compact width-divisor8 grayscale models skip the first two pools, giving
stride8 grids8/10/12 at64/80/96 input pixels. Five-prior flat count is801,447;
three-prior12-node joint count is798,351; each has2,584 state scalars.

```{cpp, results="markdown", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

#include <print>
int main() {
  namespace n = dm::nn;
  n::set_num_threads(2);
  for (bool large : {false, true}) {
    n::ParameterStore p(17), state(17);
    n::models::YoloV2Config c;
    c.update_stats = false;
    if (large) {
      c.classes = 9418;
      c.anchors = 3;
    }
    const auto net = n::models::YoloV2(
        p, state, n::sin(.13 * n::arange(0, 128 * 128 * 3)).reshape({1, 128, 128, 3}), c,
        true);
    const auto gradients = n::grad(n::mean(n::square(net.raw)), p.parameters());
    if (p.count() != (large ? 79502989 : 50655389) || state.count() != 20672 ||
        gradients.size() != 68)
      return 1;
    for (const auto &g : gradients)
      if (!g.defined() || !std::isfinite(n::sum(n::square(g)).item()))
        return 1;
    std::print("Full{}-class/{}-prior model:{} learned/{} state scalars, all{} finite defined "
               "tensor derivatives at128px.\n",
               c.classes, c.anchors, p.count(), state.count(), gradients.size());
  }
  n::ParameterStore p(17), state(17);
  n::models::YoloV2Config c;
  c.classes = 10;
  c.compact = true;
  c.width_divisor = 8;
  c.update_stats = false;
  for (int side : {64, 80, 96}) {
    n::NoGradGuard guard;
    const auto net = n::models::YoloV2(p, state, n::ones({1, side, side, 1}), c, false);
    if (net.raw.shape() != n::Shape{1, side / 8, side / 8, 5, 15} ||
        net.passthrough.shape()[3] != 32)
      return 1;
    std::print("Compact{}px: grid{}, reorg32 channels,{} learned/{} state scalars.\n", side,
               side / 8, p.count(), state.count());
  }
}
```
