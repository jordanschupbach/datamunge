> Actual detection and classification-only inputs

The first gallery shows the common64-pixel training scene split and its true
boxes. The second uses separate seed33,one-object scenes from the same fit-only
digit pool for classification-only supervision. Their labels remain available,
but their boxes are deliberately removed from the classification-only loss.
This is a tiny parity/digit hierarchy demonstration, not COCO/ImageNet joint
training or a supplied9418-node semantic hierarchy.

```{cpp, results="markdown", file="figures/yolo_v2_scenes.png", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

#include <print>
int main() {
  namespace n = dm::nn;
  n::set_num_threads(2);

  std::filesystem::path cache;
  if (const auto *p = std::getenv("DATAMUNGE_DATA_DIR"))
    cache = p;
  else if (const auto *p = std::getenv("XDG_CACHE_HOME"))
    cache = std::filesystem::path(p) / "datamunge/datasets";
  else
    cache = std::filesystem::path(std::getenv("HOME")) / ".cache/datamunge/datasets";
  dm::datasets::fetch("mnist", (cache / "mnist").string());

  const auto train = n::load_mnist((cache / "mnist").string(), "train");
  n::models::DetectionSceneConfig cfg;
  cfg.scenes = 80;
  cfg.seed = 11;
  const auto scenes = n::models::MakeTensorDetectionScenes(
      n::slice_axis(train.images, 0, 0, 2048), n::slice_axis(train.labels, 0, 0, 2048), cfg);

  auto class_cfg = cfg;
  class_cfg.scenes = 64;
  class_cfg.max_objects = 1;
  class_cfg.seed = 33;
  const auto classification =
      n::models::MakeTensorDetectionScenes(n::slice_axis(train.images, 0, 0, 2048),
                                           n::slice_axis(train.labels, 0, 0, 2048), class_cfg);
  std::filesystem::create_directories("build");
  std::filesystem::create_directories("figures");
  n::save_image_grid(n::slice_axis(classification.images, 0, 0, 8),
                     "build/yolo_v2_classification.png", 4, 0., 1., 4, 1., 2);
  std::filesystem::copy_file("build/yolo_v2_classification.png",
                             "figures/yolo_v2_classification.png",
                             std::filesystem::copy_options::overwrite_existing);
  std::vector<n::Tensor> boxes(scenes.boxes.begin(), scenes.boxes.begin() + 8);
  const auto preview = n::models::DrawDetectionBoxes(n::slice_axis(scenes.images, 0, 0, 8),
                                                     boxes, {.1, 1., .2});
  std::filesystem::create_directories("build");
  n::save_image_grid(preview, "build/yolo_v2_scenes.png", 4, 0., 1., 4, 1., 2);
  std::int64_t objects = 0;
  for (const auto &b : scenes.boxes)
    objects += b.shape()[0];
  std::print("80 generated training/validation scenes; {} accepted digits. Preview: first "
             "eight training scenes with tight green boxes.\n",
             objects);
}
