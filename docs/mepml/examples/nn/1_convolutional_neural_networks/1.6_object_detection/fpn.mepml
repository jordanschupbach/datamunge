// result_begin: markdown
80 generated training/validation scenes; 195 accepted digits. Preview: first eight training scenes with tight green boxes.
\image(figures/fpn_scenes.png)
// result_end
\caption(The actual first eight training digit scenes with green tight boxes. All image preprocessing and composition use tensor operations; the learned FPN/RPN replaces classical proposals.)
\alttext(The actual first eight training digit scenes with green tight boxes. All image preprocessing and composition use tensor operations; the learned FPN/RPN replaces classical proposals.)

The source four-convolution stride-four backbone is extended with stride-two
3x3 ReLU stages of widths 128/256/256. Lateral/smoothing projections give
64-channel P2..P5 maps; pooled P6 adds a fifth RPN level. One shared 128-channel
RPN head sees three ratios and one anchor side per level. Strides 4/8/16/32/64
use sides 8/16/32/64/128, giving 1023 anchors in concatenated level order.
The shared 256-unit box head pools P2..P5 by the scale rule with canonical side 32.
The complete model has 2174882 learned scalars, all fitted here. This is the source
compact convolutional pyramid, not a pretrained ResNet. There is no batch norm,
dropout, moving model state or hidden fitting.

> Explicit joint tensor Adam loop

The code creates every backbone/FPN/RPN/box-head leaf before constructing Adam.
It then makes 384 updates over twelve epochs, batch two images, learning rate
.001. The objective is RPN logistic/Smooth-L1 plus RoI CE/selected-class Smooth-L1,
with `.00005*sum(kernel²)` added explicitly and biases excluded. The proposal
path is detached from the same forward pass; gradients reach shared pyramid
features through both task losses. Training appends target/random RoIs, while
validation/test proposals come solely from the RPN. The best validation inclusive
VOC AP50 checkpoint is restored for the held-out evaluation.

```{cpp, results="markdown", file="figures/fpn_training.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

#include <print>
int main() {
  namespace n = dm::nn;
  namespace m = n::models;
  n::set_num_threads(2);

  std::filesystem::path cache;
  if (const auto *p = std::getenv("DATAMUNGE_DATA_DIR"))
    cache = p;
  else if (const auto *p = std::getenv("XDG_CACHE_HOME"))
    cache = std::filesystem::path(p) / "datamunge/datasets";
  else
    cache = std::filesystem::path(std::getenv("HOME")) / ".cache/datamunge/datasets";
  dm::datasets::fetch("mnist", (cache / "mnist").string());

  const auto train = n::load_mnist((cache / "mnist").string(), "train");
  m::DetectionSceneConfig cfg;
  cfg.scenes = 80;
  cfg.seed = 11;
  const auto scenes = m::MakeTensorDetectionScenes(
      n::slice_axis(train.images, 0, 0, 2048), n::slice_axis(train.labels, 0, 0, 2048), cfg);

  const auto anchors = m::FpnDigitAnchors();
  std::vector<std::int64_t> fit_rows(64), val_rows(16);
  std::iota(fit_rows.begin(), fit_rows.end(), 0);
  std::iota(val_rows.begin(), val_rows.end(), 64);
  n::ParameterStore p(17);
  {
    n::NoGradGuard guard;
    const auto f = m::FpnDigitDetectorForward(p, n::zeros({1, 64, 64, 1}));
    const auto pooled =
        m::PyramidDetectionRoiPool(f.roi_levels, n::tensor({0., 0., 8., 8.}, {1, 4}),
                                   n::from_vector(std::vector<std::int64_t>{0}), 32);
    m::PooledDetectionRoiHead(p, pooled);
  }
  if (p.count() != 2174882)
    return 1;
  // Inference borrows p/anchors and uses one FPN/RPN forward for proposal and box heads.
  const auto detect = [&](const m::TensorDetectionScenes &data,
                          const std::vector<std::int64_t> &rows) {
    n::NoGradGuard guard;
    const auto f =
        m::FpnDigitDetectorForward(p, 2. * n::gather(data.images, n::from_vector(rows)) - 1.);
    const auto proposals = m::ComputeDetectionProposals(f.rpn, anchors, 64, 64);
    const auto packed = m::PackDetectionRois(proposals);
    if (!packed.indices.numel())
      return std::make_pair(m::SuppressDetectionCandidates(n::zeros({0, 4}), n::zeros({0}),
                                                           n::zeros({0}, n::DType::Int64),
                                                           n::zeros({0}, n::DType::Int64)),
                            proposals);
    const auto head = m::PooledDetectionRoiHead(
        p, m::PyramidDetectionRoiPool(f.roi_levels, packed.pixels, packed.indices, 32));
    return std::make_pair(
        m::DecodeDetectionRoiOutputs(head, packed.pixels,
                                     n::gather(n::from_vector(rows), packed.indices)),
        proposals);
  };
  // Record conversion only presents existing tensor annotations; it performs no box arithmetic.
  const auto truth_records = [](const m::TensorDetectionScenes &data,
                                const std::vector<std::int64_t> &rows) {
    std::vector<m::DetectionEvaluationTruth> truth;
    for (auto i : rows) {
      const auto boxes = n::boxes_to_vector(data.boxes[i]);
      const auto labels = data.labels[i].to_vector<int>();
      for (std::size_t j = 0; j < boxes.size(); ++j)
        truth.push_back({int(i), labels[j], boxes[j]});
    }
    return truth;
  };
  const auto val_truth = truth_records(scenes, val_rows);
  std::vector<int> val_ids(val_rows.begin(), val_rows.end());
  n::OptimizerConfig config;
  config.kind = n::OptimizerKind::Adam;
  n::Optimizer adam(p, .001, config);
  n::BatchOrder order(64, 2, 29);
  n::Generator sampling(7);
  std::vector<n::Tensor> kernels;
  for (const auto &v : p.parameters())
    if (v.dim() >= 2)
      kernels.push_back(v);
  std::filesystem::create_directories("build");
  const std::string checkpoint = "build/fpn_best.npz";
  std::vector<double> epochs, losses, validation, rpn_losses, roi_losses, recall50_trace,
      recall70_trace;
  double best = -1;
  int selected = 0, steps = 0;
  std::print("| epoch | joint loss | RPN loss | RoI loss | val AP50 | val RPN recall .5 "
             "|\n|---:|---:|---:|---:|---:|---:|\n");
  for (int epoch = 1; epoch <= 12; ++epoch) {
    order.begin_epoch();
    double total = 0, total_rpn = 0, total_roi = 0;
    std::size_t seen = 0;
    for (auto rows = order.next(); !rows.empty(); rows = order.next()) {
      const auto f = m::FpnDigitDetectorForward(
          p, 2. * n::gather(scenes.images, n::from_vector(rows)) - 1.);
      const auto rpn = f.rpn;
      const auto proposals = m::ComputeDetectionProposals(rpn, anchors, 64, 64);
      const auto batch = m::SampleDetectionRois(scenes, rows, proposals, sampling);
      const auto targets = m::MakeDetectionRpnTargets(anchors, scenes, rows, sampling);
      const auto head = m::PooledDetectionRoiHead(
          p, m::PyramidDetectionRoiPool(f.roi_levels, batch.pixels, batch.indices, 32));
      const auto region_loss =
          m::DetectionRoiLoss(head, batch.labels, batch.targets, batch.mask);
      const auto proposal_loss =
          m::RpnLoss(rpn, targets.labels, targets.weights, targets.targets, targets.positives);
      const auto joint = region_loss + proposal_loss;
      n::Tensor penalty = n::zeros({});
      for (const auto &kernel : kernels)
        penalty = penalty + n::sum(n::square(kernel));
      if (!std::isfinite(joint.item()))
        return 1;
      total += joint.item() * rows.size();
      total_rpn += proposal_loss.item() * rows.size();
      total_roi += region_loss.item() * rows.size();
      seen += rows.size();
      adam.minimize(joint + .00005 * penalty);
      ++steps;
    }
    const auto diagnostic = detect(scenes, val_rows);
    const auto prediction = diagnostic.first;
    const auto metric = m::EvaluateDetectionDataset(m::DetectionEvaluationRecords(prediction),
                                                    val_truth, val_ids, false, true);
    epochs.push_back(epoch);
    losses.push_back(total / double(seen));
    validation.push_back(metric.ap50.item());
    rpn_losses.push_back(total_rpn / double(seen));
    roi_losses.push_back(total_roi / double(seen));
    double val50 = 0, val70 = 0;
    for (std::size_t i = 0; i < val_rows.size(); ++i)
      if (diagnostic.second[i].shape()[0] && scenes.boxes[val_rows[i]].shape()[0]) {
        const auto overlap =
            n::max(n::box_iou(diagnostic.second[i], scenes.boxes[val_rows[i]]), {0});
        val50 += n::count_nonzero(n::greater_equal(overlap, .5)).item();
        val70 += n::count_nonzero(n::greater_equal(overlap, .7)).item();
      }
    recall50_trace.push_back(val50 / val_truth.size());
    recall70_trace.push_back(val70 / val_truth.size());
    if (metric.ap50.item() > best) {
      best = metric.ap50.item();
      selected = epoch;
      p.save(checkpoint);
    }
    std::print("| {} | {:.6f} | {:.6f} | {:.6f} | {:.6f} | {:.6f} |\n", epoch, losses.back(),
               rpn_losses.back(), roi_losses.back(), validation.back(), recall50_trace.back());
  }
  p.load(checkpoint);
  const auto restored = m::EvaluateDetectionDataset(
      m::DetectionEvaluationRecords(detect(scenes, val_rows).first), val_truth, val_ids, false,
      true);
  if (std::abs(restored.ap50.item() - best) > 1e-12)
    return 1;
  const auto digits = n::load_mnist((cache / "mnist").string(), "test");
  cfg.scenes = 8;
  cfg.seed = 22;
  const auto test = m::MakeTensorDetectionScenes(n::slice_axis(digits.images, 0, 0, 512),
                                                 n::slice_axis(digits.labels, 0, 0, 512), cfg);
  std::vector<std::int64_t> test_rows(8);
  std::iota(test_rows.begin(), test_rows.end(), 0);
  std::vector<int> test_ids(test_rows.begin(), test_rows.end());
  const auto diagnostic = detect(test, test_rows);
  const auto output = diagnostic.first;
  double covered50 = 0, covered70 = 0;
  std::int64_t count = 0;
  for (int i = 0; i < 8; ++i) {
    const auto &boxes = diagnostic.second[i];
    count += boxes.shape()[0];
    if (boxes.shape()[0] && test.boxes[i].shape()[0]) {
      const auto overlap = n::max(n::box_iou(boxes, test.boxes[i]), {0});
      covered50 += n::count_nonzero(n::greater_equal(overlap, .5)).item();
      covered70 += n::count_nonzero(n::greater_equal(overlap, .7)).item();
    }
  }
  const auto records = m::DetectionEvaluationRecords(output);
  const auto truth = truth_records(test, test_rows);
  const auto voc = m::EvaluateDetectionDataset(records, truth, test_ids, false, true),
             coco = m::EvaluateDetectionDataset(records, truth, test_ids, true);
  // Group integer output row indices to draw the actual selected predictions.
  std::vector<n::Tensor> predicted_boxes;
  const auto image_ids = output.images.to_vector<int>();
  for (int image = 0; image < 8; ++image) {
    std::vector<std::int64_t> index;
    for (std::size_t j = 0; j < image_ids.size(); ++j)
      if (image_ids[j] == image)
        index.push_back(std::int64_t(j));
    predicted_boxes.push_back(n::gather(output.boxes, n::from_vector(index)));
  }
  const auto green = m::DrawDetectionBoxes(test.images, test.boxes, {.1, 1., .2}),
             red = m::DrawDetectionBoxes(test.images, predicted_boxes, {1., .1, .1}),
             raw = test.images * n::ones({1, 1, 1, 3});
  const auto sheet = n::where(n::any(n::not_equal(green, raw), {3}, true), green, red);
  n::save_image_grid(sheet, "build/fpn_detections.png", 4, 0., 1., 4, 1., 2);
  std::filesystem::create_directories("figures");
  std::filesystem::copy_file("build/fpn_detections.png", "figures/fpn_detections.png",
                             std::filesystem::copy_options::overwrite_existing);
  std::vector<n::Tensor> top;
  for (const auto &boxes : diagnostic.second)
    top.push_back(n::slice_axis(boxes, 0, 0, std::min<std::int64_t>(10, boxes.shape()[0])));
  const auto proposal_sheet = m::DrawDetectionBoxes(test.images, top, {1., .1, .1});
  const auto proposal_preview =
      n::where(n::any(n::not_equal(green, raw), {3}, true), green, proposal_sheet);
  n::save_image_grid(proposal_preview, "build/fpn_proposals.png", 4, 0., 1., 4, 1., 2);
  std::filesystem::copy_file("build/fpn_proposals.png", "figures/fpn_proposals.png",
                             std::filesystem::copy_options::overwrite_existing);
  auto a = dm::graphics::RPlot::create();
  a.lines(epochs, losses, "RPN plus RoI", {37, 99, 235})
      .title("FPN detector joint objective")
      .x_label("epoch")
      .y_label("unregularized joint loss")
      .y_limits(0, 1.3 * *std::max_element(losses.begin(), losses.end()));
  auto parts = dm::graphics::RPlot::create();
  parts.lines(epochs, rpn_losses, "RPN", {220, 38, 38})
      .lines(epochs, roi_losses, "RoI", {37, 99, 235})
      .title("Both fitted loss components")
      .x_label("epoch")
      .y_label("mean sampled objective")
      .y_limits(0, 1.3 * std::max(*std::max_element(rpn_losses.begin(), rpn_losses.end()),
                                  *std::max_element(roi_losses.begin(), roi_losses.end())));
  auto b = dm::graphics::RPlot::create();
  b.lines(epochs, validation, "validation AP50", {22, 163, 74})
      .title("Validation detection selection")
      .x_label("epoch")
      .y_label("AP50")
      .y_limits(0, 1.3);
  auto coverage = dm::graphics::RPlot::create();
  coverage.lines(epochs, recall50_trace, "recall at .5", {37, 99, 235})
      .lines(epochs, recall70_trace, "recall at .7", {220, 38, 38})
      .title("Validation proposal coverage")
      .x_label("epoch")
      .y_label("fraction of true boxes covered")
      .y_limits(0, 1.35);
  dm::graphics::RLayout::create(2, 2)
      .add(a)
      .add(parts)
      .add(b)
      .add(coverage)
      .size(1200, 1000)
      .fit_panels()
      .save_svg("build/fpn_training.svg");
  std::print("{} learned scalars, {} Adam updates; selected epoch {}, validation AP50 {:.6f}. "
             "Test: {} scenes, {} digits, {:.3f} proposals/image, proposal recall .5/.7 "
             "{:.6f}/{:.6f}; inclusive VOC AP50 {:.6f}, COCO AP75 {:.6f}, AP50:95 {:.6f}; {} "
             "detections. One shared backbone evaluation per image; no moving state.\n",
             p.count(), steps, selected, best, 8, truth.size(), double(count) / 8.,
             covered50 / truth.size(), covered70 / truth.size(), voc.ap50.item(),
             coco.ap75.item(), coco.ap.item(), records.size());
}
