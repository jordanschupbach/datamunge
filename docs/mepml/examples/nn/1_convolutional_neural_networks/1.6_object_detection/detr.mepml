> Set objective, no-object weighting and disjoint-box gradients

No-object is the final class. Matched queries have classification weight1,
unmatched queries .1; weighted CE divides by total class weights. Matched
`5*L1+2*(1-GIoU)` divides by total objects floored at one. Empty images retain
background classification and zero box gradients. GIoU can be negative for
disjoint boxes and uses1e-7 denominator floors.

Every decoder layer is independently matched and supervised in this source
port. The visible fitting loop below shows that sum explicitly. Matching uses
Float64 costs; source host Float32 corner rounding may differ near exact ties.
The independent fixture checks analytic class derivatives and disjoint-box
central differences, including masked unmatched boxes.

```{cpp, results="markdown", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

#include <print>
int main() {
  namespace n = dm::nn;
  const auto type = n::DType::Float64;
  const auto x = n::zeros({1, 2, 3}, type).requires_grad_(),
             b = n::from_vector(std::vector<double>{.25, .3, .2, .2, .2, .3, .4, .5},
                                {1, 2, 4})
                     .requires_grad_();
  n::models::DetrTargets t{
      n::from_vector(std::vector<double>{1, 0, 0, 0, 0, 1}, {1, 2, 3}),
      n::from_vector(std::vector<double>{.7, .65, .25, .3, 0, 0, 0, 0}, {1, 2, 4}),
      n::from_vector(std::vector<double>{1, 0}, {1, 2})};
  const auto loss = n::models::DetrLayerLoss(x, b, t);
  const auto g = n::grad(loss, {x, b});
  double error = 0;
  for (int q = 0; q < 2; ++q)
    for (int c = 0; c < 3; ++c)
      error = std::max(error, std::abs(g[0].at({0, q, c}) -
                                       (1. / 3. - ((q == 0 && c == 0) || (q == 1 && c == 2))) *
                                           (q ? .1 : 1.) / 1.1));
  for (int k = 0; k < 8; ++k) {
    auto plus = b.to_vector<double>(), minus = plus;
    const double step = 1e-6;
    plus[k] += step;
    minus[k] -= step;
    const double expected =
        (n::models::DetrLayerLoss(x, n::from_vector(plus, {1, 2, 4}), t).item() -
         n::models::DetrLayerLoss(x, n::from_vector(minus, {1, 2, 4}), t).item()) /
        (2 * step);
    error = std::max(error, std::abs(g[1].reshape({8}).at({k}) - expected));
  }
  if (error > 1e-8)
    return 1;
  t.labels = n::one_hot(n::full({1, 2}, 2., n::DType::Int64), 3, 1, 0, type);
  t.positive = n::zeros({1, 2}, type);
  t.boxes = n::zeros({1, 2, 4}, type);
  const auto empty = n::models::DetrLayerLoss(x, b, t);
  if (std::abs(empty.item() - std::log(3.)) > 1e-12 ||
      n::count_nonzero(n::grad(empty, {b})[0]).item() != 0)
    return 1;
  std::print(
      "Disjoint-box set loss{:.12f}; all class analytic/box finite-difference derivatives "
      "pass, max error{:.12f}. Empty-target CE{:.12f} and exact zero box gradients.\n",
      loss.item(), error, empty.item());
}
```
