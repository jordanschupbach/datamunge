> Rectangular assignment with tensor potentials

DETR assigns each truth to a different learned query. Its detached cost is
`-class probability +5*L1 -2*GIoU`, using normalized cy/cx/height/width boxes.
There must be at least as many queries as objects. The rectangular Hungarian
solver uses Float64 tensors for reduced costs, potentials, distances and
minima; host arrays hold only discrete augmenting-path ownership and visited
indices. Strict improvements/first minima give deterministic ties. No
numerical host solver or optimizer is hidden in this assignment.

The following compares100 small random rectangular problems to exhaustive
one-to-one enumeration, including negative costs, and plots an explicit cost
matrix and its selected assignment. Empty truth requires no assignment.

```{cpp, results="markdown", file="figures/detr_assignment.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

#include <print>
#include <random>
int main() {
  namespace n = dm::nn;
  std::mt19937 generator(17);
  std::uniform_real_distribution<double> draw(-10, 10);
  double error = 0;
  for (int trial = 0; trial < 100; ++trial) {
    const int R = 1 + trial % 4, C = R + trial % 3;
    std::vector<double> cost(R * C);
    for (auto &v : cost)
      v = draw(generator);
    const auto chosen =
        n::models::TensorHungarianAssignment(n::from_vector(cost, {R, C})).to_vector<int>();
    std::vector<bool> used(C);
    double actual = 0;
    for (int r = 0; r < R; ++r) {
      if (chosen[r] < 0 || chosen[r] >= C || used[chosen[r]])
        return 1;
      used[chosen[r]] = true;
      actual += cost[r * C + chosen[r]];
    }
    std::fill(used.begin(), used.end(), false);
    double best = INFINITY;
    std::function<void(int, double)> enumerate = [&](int r, double sum) {
      if (r == R) {
        best = std::min(best, sum);
        return;
      }
      for (int c = 0; c < C; ++c)
        if (!used[c]) {
          used[c] = true;
          enumerate(r + 1, sum + cost[r * C + c]);
          used[c] = false;
        }
    };
    enumerate(0, 0);
    error = std::max(error, std::abs(actual - best));
  }
  if (error > 1e-10)
    return 1;
  const auto cost = n::from_vector(std::vector<double>{4, 1, 3, 2, 0, 5}, {2, 3}),
             chosen = n::models::TensorHungarianAssignment(cost),
             mask = n::one_hot(chosen, 3, 1, 0, n::DType::Float64);
  auto a = n::plot_tensor_map(n::reverse(cost, {0}), 0, 5);
  a.title("Explicit matching cost")
      .x_label("query column")
      .y_label("truth row")
      .x_limits(-.5, 2.5)
      .y_limits(-.5, 1.5);
  auto b = n::plot_tensor_map(n::reverse(mask, {0}), 0, 1);
  b.title("One-to-one selected assignment")
      .x_label("query column")
      .y_label("truth row")
      .x_limits(-.5, 2.5)
      .y_limits(-.5, 1.5);
  std::filesystem::create_directories("build");
  dm::graphics::RLayout::create(1, 2).add(a).add(b).size(1200, 500).fit_panels().save_svg(
      "build/detr_assignment.svg");
  std::print("100 rectangular Hungarian solutions match exhaustive minima; max error{:.12f}. "
             "Fixture columns[{},{}], total cost{:.6f}. This is detached matching, not fitted "
             "model output.\n",
             error, chosen.at({0}), chosen.at({1}), n::sum(cost * mask).item());
}
```
