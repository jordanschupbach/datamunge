> Eight-node bidirectional pyramid and full D0 graph

Top-down P6/P5/P4/P3 nodes precede bottom-up P4/P5/P6/P7, for eight nodes and
nineteen learned incoming edges. Middle bottom-up nodes also retain their
original input. Mismatched-width input edges get independent1x1+BN projections.
Nearest upsampling and3x3 SAME max-pooling preserve odd grid sizes. Each node
applies fusion, Swish, depthwise3x3/pointwise1x1 and BN.

The D0–D7 table below is architecture metadata, not measured model quality.
The initialized full D0 probe executes all493 learned tensor gradients using
128-pixel input: 3,874,217 learned/47,136 state scalars. Its default512-pixel
geometry has49,104 anchors. It does not fit a full-resolution COCO benchmark.

```{cpp, results="markdown", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

#include <print>
int main() {
  namespace n = dm::nn;
  namespace m = n::models;
  n::set_num_threads(2);
  {
    n::ParameterStore p(17), state(17);
    std::vector<n::Tensor> x;
    for (int side : {17, 9, 5, 3, 2})
      x.push_back(n::ones({2, side, side, 4}));
    const auto y = m::BiFpnCell(p, state, "cell", x, 4);
    if (p.count() != 531 || state.count() != 64)
      return 1;
    for (int i = 0; i < 5; ++i)
      if (y[i].shape() != x[i].shape())
        return 1;
    std::print("Odd17/9/5/3/2 grids retained; eight nodes/nineteen edges: {} learned/{} state "
               "scalars.\n",
               p.count(), state.count());
  }
  std::print("| variant | backbone | width | cells | head layers | side "
             "|\n|---|---:|---:|---:|---:|---:|\n");
  for (int i = 0; i < 8; ++i) {
    const auto c = m::EfficientDetScaling(i);
    std::print("| D{} | B{} | {} | {} | {} | {} |\n", i, c.backbone, c.width, c.repeats,
               c.head_repeats, c.resolution);
  }
  n::ParameterStore p(17), state(17);
  m::EfficientDetConfig c;
  c.image_size = 128;
  c.update_stats = false;
  const auto net = m::EfficientDet(
      p, state, n::sin(.13 * n::arange(0, 128 * 128 * 3)).reshape({1, 128, 128, 3}), c, true);
  const auto grads =
      n::grad(n::mean(n::square(net.logits)) + n::mean(n::square(net.deltas)), p.parameters());
  if (p.count() != 3874217 || state.count() != 47136 || grads.size() != 493 ||
      net.anchors != 3069)
    return 1;
  for (const auto &g : grads)
    if (!g.defined() || !std::isfinite(n::sum(n::square(g)).item()))
      return 1;
  std::print("Initialized full D0/80: {} learned/{} state scalars, all{} finite defined "
             "learned gradients; {} anchors at128, {} at512.\n",
             p.count(), state.count(), grads.size(), net.anchors,
             m::RetinaAnchors({64, 32, 16, 8, 4}).shape()[0]);
}
```
