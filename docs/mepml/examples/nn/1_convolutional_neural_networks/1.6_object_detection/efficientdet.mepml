> Fast-normalized fusion with learned edges

BiFPN fuses each node's incoming features with
`sum(relu(w_i)*x_i)/(sum(relu(w_i))+.0001)`. Negative edges are disabled.
An all-zero set produces exact zero values and derivatives, because this
library defines ReLU's zero derivative as zero. Epsilon means normalized
weights sum slightly below one. Weights are learned scalar parameters and
appear in the visible whole-model Adam loop below.

The independent fixture checks every output, input gradient and scalar-weight
gradient, including a disabled negative edge. It is a numerical check, with
no optimizer invocation needed to verify the formula.

```{cpp, results="markdown", file="figures/efficientdet_fusion.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

#include <print>
int main() {
  namespace n = dm::nn;
  const auto type = n::DType::Float64;
  std::vector<n::Tensor> x, w, leaves;
  const double values[3][2] = {{1, -2}, {3, 5}, {7, 11}}, initial[] = {2, -1, 3};
  for (int i = 0; i < 3; ++i) {
    x.push_back(
        n::from_vector(std::vector<double>{values[i][0], values[i][1]}).requires_grad_());
    w.push_back(n::full({}, initial[i], type).requires_grad_());
  }
  leaves = x;
  leaves.insert(leaves.end(), w.begin(), w.end());
  const auto y = n::models::FastFeatureFusion(x, w);
  const auto g = n::grad(n::sum(y), leaves);
  const double den = 5.0001;
  double error = 0;
  for (int k = 0; k < 2; ++k)
    error = std::max(error, std::abs(y.at({k}) - (2 * values[0][k] + 3 * values[2][k]) / den));
  std::vector<double> expected_weight_grad;
  for (int i = 0; i < 3; ++i) {
    double expected = 0;
    for (int k = 0; k < 2; ++k) {
      error = std::max(error, std::abs(g[i].at({k}) - std::max(0., initial[i]) / den));
      expected += (values[i][k] * den - 2 * values[0][k] - 3 * values[2][k]) / (den * den);
    }
    expected_weight_grad.push_back(initial[i] > 0 ? expected : 0);
    error = std::max(error, std::abs(g[i + 3].item() - expected_weight_grad.back()));
  }
  if (error > 1e-12)
    return 1;
  auto a = dm::graphics::RPlot::create();
  a.bars({0, 1, 2}, std::vector<double>{2, -1, 3}, "raw edge weights", {37, 99, 235})
      .title("Positive and disabled edges")
      .x_label("edge index")
      .y_label("scalar weight")
      .y_limits(-2, 4.5);
  auto b = dm::graphics::RPlot::create();
  b.bars({0, 1, 2}, expected_weight_grad, "edge gradient", {22, 163, 74})
      .title("Checked edge derivatives")
      .x_label("edge index")
      .y_label("scalar derivative")
      .y_limits(-3, 2.5);
  std::filesystem::create_directories("build");
  dm::graphics::RLayout::create(1, 2).add(a).add(b).size(1200, 500).fit_panels().save_svg(
      "build/efficientdet_fusion.svg");
  for (auto &v : w)
    v = n::zeros({}, type).requires_grad_();
  leaves = x;
  leaves.insert(leaves.end(), w.begin(), w.end());
  const auto zero = n::models::FastFeatureFusion(x, w);
  for (const auto &v : n::grad(n::sum(zero), leaves))
    if (n::count_nonzero(v).item() != 0)
      return 1;
  std::print("Every fusion value/input/weight derivative passes independent oracle; max "
             "error{:.12f}. Outputs[{:.9f},{:.9f}]. All-zero edge weights have exact zero "
             "outputs/gradients.\n",
             error, y.at({0}), y.at({1}));
}
```
