> Explicit tensor optimization

Both detection methods share one patch CNN: biased SAME 3x3 ReLU convolutions
of widths 32 and 64, 2x2 pools, a 128-unit dense ReLU and eleven linear logits.
It has 421771 learned scalars and no moving model state. Preprocessing to `[-1,1]`
is visible below. Adam uses learning rate .001, batch 32 and twelve epochs.
The objective is mean sparse cross-entropy plus `.00005*sum(kernel²)`; biases
are excluded from L2. Every leaf is created before the optimizer captures it.
The best validation patch NLL selects a parameter checkpoint; no test scenes
enter training or selection. The graph below reports epoch mean unregularized
training NLL, validation NLL and the selected validation patch confusion matrix.

```{cpp, results="markdown", file="figures/detection_baselines_training.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

#include <print>
int main() {
  namespace n = dm::nn;
  n::set_num_threads(2);

  std::filesystem::path cache;
  if (const auto *p = std::getenv("DATAMUNGE_DATA_DIR"))
    cache = p;
  else if (const auto *p = std::getenv("XDG_CACHE_HOME"))
    cache = std::filesystem::path(p) / "datamunge/datasets";
  else
    cache = std::filesystem::path(std::getenv("HOME")) / ".cache/datamunge/datasets";
  dm::datasets::fetch("mnist", (cache / "mnist").string());

  const auto train = n::load_mnist((cache / "mnist").string(), "train");
  n::models::DetectionSceneConfig cfg;
  cfg.scenes = 80;
  cfg.seed = 11;
  const auto scenes = n::models::MakeTensorDetectionScenes(
      n::slice_axis(train.images, 0, 0, 2048), n::slice_axis(train.labels, 0, 0, 2048), cfg);

  std::vector<std::int64_t> fit_rows(64), validation_rows(16);
  std::iota(fit_rows.begin(), fit_rows.end(), 0);
  std::iota(validation_rows.begin(), validation_rows.end(), 64);
  const auto fit = n::models::MakeDetectionPatches(scenes, fit_rows, 3),
             validation = n::models::MakeDetectionPatches(scenes, validation_rows, 4);
  const auto x = 2. * fit.images - 1., vx = 2. * validation.images - 1.;
  n::ParameterStore p(17);
  {
    n::NoGradGuard guard;
    n::models::PatchDetectorLogits(p, n::zeros({1, 28, 28, 1}));
  }
  if (p.count() != 421771)
    return 1;
  n::OptimizerConfig config;
  config.kind = n::OptimizerKind::Adam;
  n::Optimizer adam(p, .001, config);
  n::BatchOrder order(std::size_t(fit.labels.numel()), 32, 29);
  std::vector<n::Tensor> kernels;
  for (const auto &value : p.parameters())
    if (value.dim() >= 2)
      kernels.push_back(value);
  std::filesystem::create_directories("build");
  const std::string checkpoint = "build/detection_baselines_best.npz";
  std::vector<double> epochs, training, validation_nll;
  double best = std::numeric_limits<double>::infinity();
  int selected = 0, steps = 0;
  std::print("| epoch | fit NLL | validation NLL |\n|---:|---:|---:|\n");
  for (int epoch = 1; epoch <= 12; ++epoch) {
    order.begin_epoch();
    double total = 0;
    std::size_t seen = 0;
    for (auto rows = order.next(); !rows.empty(); rows = order.next()) {
      const auto index = n::from_vector(rows),
                 logits = n::models::PatchDetectorLogits(p, n::gather(x, index));
      const auto ce = n::sparse_softmax_cross_entropy(logits, n::gather(fit.labels, index));
      n::Tensor penalty = n::zeros({});
      for (const auto &kernel : kernels)
        penalty = penalty + n::sum(n::square(kernel));
      total += ce.item() * rows.size();
      seen += rows.size();
      adam.minimize(ce + .00005 * penalty);
      ++steps;
    }
    n::NoGradGuard guard;
    const auto loss = n::sparse_softmax_cross_entropy(n::models::PatchDetectorLogits(p, vx),
                                                      validation.labels);
    epochs.push_back(epoch);
    training.push_back(total / double(seen));
    validation_nll.push_back(loss.item());
    if (loss.item() < best) {
      best = loss.item();
      selected = epoch;
      p.save(checkpoint);
    }
    std::print("| {} | {:.6f} | {:.6f} |\n", epoch, training.back(), validation_nll.back());
  }
  p.load(checkpoint);
  n::NoGradGuard guard;
  const auto logits = n::models::PatchDetectorLogits(p, vx);
  const auto restored = n::sparse_softmax_cross_entropy(logits, validation.labels);
  if (!std::isfinite(best) || std::abs(restored.item() - best) > 1e-6 ||
      training.back() >= training.front())
    return 1;
  const auto predicted = n::argmax(logits, 1);
  const double accuracy =
      n::mean(n::equal(predicted, validation.labels).to(n::DType::Float32)).item();
  const auto confusion = n::matmul(n::transpose(n::one_hot(validation.labels, 11), {1, 0}),
                                   n::one_hot(predicted, 11));
  auto curve = dm::graphics::RPlot::create();
  curve.lines(epochs, training, "training", {37, 99, 235})
      .lines(epochs, validation_nll, "validation", {220, 38, 38})
      .title("Patch classifier NLL")
      .x_label("epoch")
      .y_label("mean cross-entropy")
      .y_limits(
          0, 1.3 * std::max(*std::max_element(training.begin(), training.end()),
                            *std::max_element(validation_nll.begin(), validation_nll.end())));
  auto counts = n::plot_tensor_map(n::reverse(confusion, {0}), 0, n::max(confusion).item());
  counts.title("Selected validation patches")
      .x_label("predicted class (10=background)")
      .y_label("true class (10=background)")
      .x_limits(-.5, 10.5)
      .y_limits(-.5, 10.5);
  dm::graphics::RLayout::create(1, 2)
      .add(curve)
      .add(counts)
      .size(1200, 550)
      .fit_panels()
      .save_svg("build/detection_baselines_training.svg");
  std::print("{} learned scalars, {} Adam updates; selected epoch {}, validation NLL {:.6f}, "
             "patch accuracy {:.6f} on {} patches. No moving model state.\n",
             p.count(), steps, selected, best, accuracy, validation.labels.numel());
}
```
