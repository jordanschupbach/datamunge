> Centerness and the complete objective

Centerness is `sqrt(min(l,r)/max(l,r)*min(t,b)/max(t,b))`: one at the box
centre and zero on/outside a boundary. Classification uses alpha .25/gamma 2
sigmoid focal loss. Positive centerness BCE and classification divide by batch
positive count floored at one. Regression is `-log((I+1)/(U+1))`, weighted by
target centerness and divided by total centerness (floor 1e-6). The **plus one**
is area smoothing, not an epsilon. An all-background batch keeps focal learning
but has exact zero regression and centerness gradients.

```{cpp, results="markdown", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

#include <print>
int main() {
  namespace n = dm::nn;
  const auto type = n::DType::Float64;
  const auto l = n::zeros({1, 2, 2}, type).requires_grad_(),
             d = n::from_vector(std::vector<double>{.8, 1.3, 2.1, 2.7, 2, 3, 4, 5}, {1, 2, 4})
                     .requires_grad_(),
             c = n::zeros({1, 2}, type).requires_grad_();
  n::models::FcosTargets t{
      n::from_vector(std::vector<double>{1, 0, 0, 0}, {1, 2, 2}),
      n::from_vector(std::vector<double>{1, 2, 3, 4, 0, 0, 0, 0}, {1, 2, 4}),
      n::from_vector(std::vector<double>{1, 0}, {1, 2}),
      n::from_vector(std::vector<double>{.6, 0}, {1, 2})};
  const auto loss = n::models::FcosLoss(l, d, c, t);
  const auto g = n::grad(loss, {l, d, c});
  if (std::abs(loss.item() - (1.625 * std::log(2.) + std::log(25. / 12.6))) > 1e-12)
    return 1;
  const double a = .125 + .25 * std::log(2.);
  double error = 0;
  for (int i = 0; i < 4; ++i)
    error = std::max(error, std::abs(g[0].reshape({4}).at({i}) - (i ? .75 * a : -.25 * a)));
  for (int i = 0; i < 8; ++i)
    error = std::max(error, std::abs(g[1].reshape({8}).at({i}) - (i >= 4  ? 0
                                                                  : i % 2 ? -2.9 / 12.6
                                                                          : -4. / 12.6)));
  error = std::max(error, std::abs(g[2].at({0, 0}) + .1));
  if (error > 1e-12)
    return 1;
  t.classes = n::zeros({1, 2, 2}, type);
  t.positive = n::zeros({1, 2}, type);
  t.centerness = n::zeros({1, 2}, type);
  const auto bg = n::models::FcosLoss(l, d, c, t);
  if (std::abs(bg.item() - .75 * std::log(2.)) > 1e-12)
    return 1;
  for (const auto &v : n::grad(bg, {d, c}))
    if (n::count_nonzero(v).item() != 0)
      return 1;
  std::print("Full focal/BCE/IoU fixture loss{:.12f}; every analytic derivative maximum "
             "error{:.12f}. All-background loss{:.12f}, exact zero centre/box derivatives.\n",
             loss.item(), error, bg.item());
}
```
