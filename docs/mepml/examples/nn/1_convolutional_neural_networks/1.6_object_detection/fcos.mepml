> Points, ranges and smallest-area assignment

FCOS predicts once at each point, without anchor shapes. Points are at
stride/2 + integer*stride on P3–P7 (strides 8/16/32/64/128). Full level ranges
are [0,64], [64,128], [128,256], [256,512], [512,infinity], with inclusive
endpoints. A point must be **strictly** inside a box, its largest l/t/r/b
distance must be in the level range, and optional centre sampling requires
both centre distances strictly below 1.5*stride. The smallest eligible area
wins, with first-truth ties. There is no forced positive for a missed object.

The fixture distinguishes strict interior, inclusive boundaries, overlapping
objects, centre sampling and out-of-range points. Colour shows assigned class;
grey points mark background. All assignment arithmetic is tensor based.

```{cpp, results="markdown", file="figures/fcos_points.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

#include <print>
int main() {
  namespace n = dm::nn;
  namespace m = n::models;
  m::TensorDetectionScenes data;
  data.images = n::zeros({1, 64, 64, 1});
  data.boxes = {n::tensor({0., 0., 24., 24., 4., 4., 12., 12.}, {2, 4})};
  data.labels = {n::from_vector(std::vector<std::int64_t>{0, 1})};
  const auto points = n::tensor({8.,  8.,  8., 0., 16., 4., 8.,  8., 0., 24., 8.,  8., 8.,
                                 16., 32., 2., 2., 1.,  0., 32., 8., 8., 8.,  17., 32.},
                                {5, 5});
  const auto t = m::MakeFcosTargets(points, data, {0}, 2);
  if (t.positive.to_vector<int>() != std::vector<int>{1, 1, 1, 0, 0} ||
      t.classes.to_vector<int>() != std::vector<int>{0, 1, 1, 0, 1, 0, 0, 0, 0, 0})
    return 1;
  if (m::MakeFcosTargets(points, data, {0}, 2, 0).positive.at({0, 3}) != 1)
    return 1;
  data.boxes[0] = n::tensor({0., 0., 24., 24., 8., 8., 16., 16.}, {2, 4});
  const auto grid = m::FcosPoints({8, 4, 2, 1, 1});
  const auto target = m::MakeFcosTargets(grid, data, {0}, 2);
  const auto values = grid.to_vector<double>();
  const auto mask = target.positive.to_vector<int>(),
             labels = n::argmax(target.classes, 2).to_vector<int>();
  auto plot = dm::graphics::RPlot::create();
  plot.lines({0, 24, 24, 0, 0}, {0, 0, 24, 24, 0}, "large class0", {37, 99, 235})
      .lines({8, 16, 16, 8, 8}, {8, 8, 16, 16, 8}, "small class1", {22, 163, 74});
  std::vector<double> bx, by, ax, ay, cx, cy;
  for (int i = 0; i < 64; ++i) {
    if (!mask[i]) {
      bx.push_back(values[i * 5 + 1]);
      by.push_back(values[i * 5]);
    } else if (labels[i] == 0) {
      ax.push_back(values[i * 5 + 1]);
      ay.push_back(values[i * 5]);
    } else {
      cx.push_back(values[i * 5 + 1]);
      cy.push_back(values[i * 5]);
    }
  }
  plot.points(bx, by, "background", {160, 160, 160})
      .points(ax, ay, "class0", {37, 99, 235})
      .points(cx, cy, "class1", {22, 163, 74})
      .title("FCOS finest-grid assignments")
      .x_label("pixel x")
      .y_label("pixel y")
      .x_limits(-4, 68)
      .y_limits(-4, 68)
      .size(900, 900)
      .margins(90, 30, 60, 60);
  std::filesystem::create_directories("build");
  plot.save_svg("build/fcos_points.svg");
  std::print("Fixture5 point assignments pass, including strict interior and inclusive range "
             "boundary. Compact64 has{} points; full640 has{}. Centerness[2,3,8,12]={:.6f}.\n",
             grid.shape()[0], m::FcosPoints({80, 40, 20, 10, 5}).shape()[0],
             m::FcosCenterness(n::tensor({2., 3., 8., 12.})).item());
}
