The fit has 938 regions: 664 foreground labels and 596 regression-eligible
examples. Sixteen epochs make 480 Adam updates. Validation selects epoch 6
with combined loss 2.293463 and region accuracy 0.583756 on 197 regions.
The checkpoint criterion is joint loss, so it need not select the epoch with
best detection AP. Later epochs do not replace this selected checkpoint.

> Held-out localization with and without learned regression

Both evaluations use exactly the same proposals, crop probabilities, selected
checkpoint and score/NMS settings. The first reports original candidate boxes;
the second decodes each class's learned offsets before NMS. Neither boxes nor
offsets are clipped, preserving the source. Every digit class scoring above .05
is considered. NMS uses .3 within each image/class, then a budget of 100 per image.
The synthetic inclusive VOC AP50 convention is requested explicitly; AP75 and
AP50:95 use the COCO-style 101-point rule. No real VOC/COCO images are involved.

```{cpp, results="markdown", file="figures/rcnn_detections.png", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

#include <print>
int main() {
  namespace n = dm::nn;
  namespace m = n::models;
  n::set_num_threads(2);
  n::NoGradGuard guard;

  std::filesystem::path cache;
  if (const auto *p = std::getenv("DATAMUNGE_DATA_DIR"))
    cache = p;
  else if (const auto *p = std::getenv("XDG_CACHE_HOME"))
    cache = std::filesystem::path(p) / "datamunge/datasets";
  else
    cache = std::filesystem::path(std::getenv("HOME")) / ".cache/datamunge/datasets";
  dm::datasets::fetch("mnist", (cache / "mnist").string());

  const auto digits = n::load_mnist((cache / "mnist").string(), "test");
  m::DetectionSceneConfig cfg;
  cfg.scenes = 8;
  cfg.seed = 22;
  const auto scenes = m::MakeTensorDetectionScenes(
      n::slice_axis(digits.images, 0, 0, 512), n::slice_axis(digits.labels, 0, 0, 512), cfg);
  n::ParameterStore p(17);
  m::RcnnPatchHead(p, n::zeros({1, 28, 28, 1}));
  p.load("build/rcnn_best.npz");
  std::vector<m::DetectionEvaluationTruth> truth;
  std::vector<int> ids(8);
  std::iota(ids.begin(), ids.end(), 0);
  for (int image : ids) {
    const auto b = n::boxes_to_vector(scenes.boxes[image]);
    const auto labels = scenes.labels[image].to_vector<int>();
    for (std::size_t j = 0; j < b.size(); ++j)
      truth.push_back({image, labels[j], b[j]});
  }
  std::vector<double> ap50, ap75, coco_ap, candidates, recall50, recall70;
  std::vector<double> class_x, before, after;
  for (bool regression : {false, true}) {
    std::vector<n::Tensor> cropped, reported;
    std::vector<std::int64_t> rows;
    double covered50 = 0, covered70 = 0;
    for (int image : ids) {
      const auto boxes = m::ComponentDetectionProposals(
          n::slice_axis(scenes.images, 0, image, image + 1).reshape({64, 64, 1}),
          {48, 64, 96, 128, 160, 200, 230}, 3);
      cropped.push_back(m::PadDetectionBoxes(boxes, .07));
      reported.push_back(boxes);
      for (std::int64_t j = 0; j < boxes.shape()[0]; ++j)
        rows.push_back(image);
      if (scenes.boxes[image].shape()[0] && boxes.shape()[0]) {
        const auto best = n::max(n::box_iou(boxes, scenes.boxes[image]), {0});
        covered50 += n::count_nonzero(n::greater_equal(best, .5)).item();
        covered70 += n::count_nonzero(n::greater_equal(best, .7)).item();
      }
    }
    const auto boxes = n::concat(reported, 0), crop_boxes = n::concat(cropped, 0),
               source = n::from_vector(rows);
    std::vector<n::Tensor> probabilities, deltas;
    for (std::int64_t start = 0; start < source.numel(); start += 128) {
      const auto end = std::min(start + 128, source.numel());
      const auto patch =
          m::CropDetectionPatches(scenes.images, n::slice_axis(source, 0, start, end),
                                  n::slice_axis(crop_boxes, 0, start, end));
      const auto head = m::RcnnPatchHead(p, 2. * patch - 1.);
      probabilities.push_back(head.probabilities);
      deltas.push_back(head.deltas);
    }
    const auto prob = n::concat(probabilities, 0);
    const auto B = source.numel();
    const auto scores = n::slice_axis(prob, 1, 0, 10).reshape({B * 10});
    const auto all_boxes =
        (regression ? n::decode_boxes(boxes.reshape({B, 1, 4}), n::concat(deltas, 0))
                    : (boxes.reshape({B, 1, 4}) * n::ones({B, 10, 1})))
            .reshape({B * 10, 4});
    const auto classes = (n::arange(0, 10).to(n::DType::Int64).reshape({1, 10}) *
                          n::ones({B, 10}, n::DType::Int64))
                             .reshape({B * 10});
    const auto images =
        (source.reshape({B, 1}) * n::ones({B, 10}, n::DType::Int64)).reshape({B * 10});
    const auto detections =
        m::SuppressDetectionCandidates(all_boxes, scores, classes, images, .3, .05, 100);
    const auto records = m::DetectionEvaluationRecords(detections);
    const auto voc = m::EvaluateDetectionDataset(records, truth, ids, false, true),
               coco = m::EvaluateDetectionDataset(records, truth, ids, true);
    for (const auto &[label, ap] : voc.per_class50) {
      if (regression)
        after.push_back(ap.item());
      else {
        class_x.push_back(label);
        before.push_back(ap.item());
      }
    }
    ap50.push_back(voc.ap50.item());
    ap75.push_back(coco.ap75.item());
    coco_ap.push_back(coco.ap.item());
    candidates.push_back(double(B) / 8.);
    recall50.push_back(covered50 / truth.size());
    recall70.push_back(covered70 / truth.size());
    std::print("{}: {:.3f} candidates/image, proposal recall .5/.7 {:.6f}/{:.6f}; inclusive "
               "VOC AP50 {:.6f}, COCO AP75 {:.6f}, AP50:95 {:.6f}; {} retained detections.\n",
               regression ? "refined" : "unrefined", candidates.back(), recall50.back(),
               recall70.back(), ap50.back(), ap75.back(), coco_ap.back(), records.size());
    if (regression) {
      std::vector<n::Tensor> boxes_by_image;
      const auto image_ids = detections.images.to_vector<int>();
      for (int image = 0; image < 8; ++image) {
        std::vector<std::int64_t> selected;
        for (std::size_t j = 0; j < image_ids.size(); ++j)
          if (image_ids[j] == image)
            selected.push_back(std::int64_t(j));
        boxes_by_image.push_back(n::gather(detections.boxes, n::from_vector(selected)));
      }
      const auto annotated = m::DrawDetectionBoxes(scenes.images, scenes.boxes, {.1, 1., .2});
      // Drawing accepts grayscale; compose predicted red outlines on the raw image,
      // then keep green truth outlines where they differ from grayscale.
      const auto predicted =
          m::DrawDetectionBoxes(scenes.images, boxes_by_image, {1., .1, .1});
      const auto raw = scenes.images * n::ones({1, 1, 1, 3});
      const auto truth_mask = n::any(n::not_equal(annotated, raw), {3}, true);
      n::save_image_grid(n::where(truth_mask, annotated, predicted),
                         "build/rcnn_detections.png", 4, 0., 1., 4, 1., 2);
    }
  }
  auto metrics = dm::graphics::RPlot::create();
  metrics.lines({0, 1}, ap50, "inclusive VOC AP50", {37, 99, 235})
      .lines({0, 1}, ap75, "COCO AP75", {220, 38, 38})
      .lines({0, 1}, coco_ap, "COCO AP50:95", {22, 163, 74})
      .title("Held-out detection AP")
      .x_label("0=unrefined, 1=refined")
      .y_label("average precision")
      .x_limits(-.1, 1.1)
      .y_limits(0, 1.4);
  auto coverage = dm::graphics::RPlot::create();
  coverage.lines(class_x, before, "unrefined", {220, 38, 38})
      .lines(class_x, after, "refined", {37, 99, 235})
      .title("Per-class inclusive VOC AP50")
      .x_label("digit class with test truth")
      .y_label("AP50")
      .x_limits(-.5, 9.5)
      .y_limits(0, 1.35);
  dm::graphics::RLayout::create(1, 2)
      .add(metrics)
      .add(coverage)
      .size(1200, 550)
      .fit_panels()
      .save_svg("build/rcnn_comparison.svg");
  std::filesystem::create_directories("figures");
  std::filesystem::copy_file("build/rcnn_comparison.svg", "figures/rcnn_comparison.svg",
                             std::filesystem::copy_options::overwrite_existing);
  std::print(
      "Eight official-test-derived scenes contain {} target digits. Green outlines are truth; "
      "red outlines are refined detections, regardless of confidence/class "
      "correctness. Overlapping red boxes may belong to different predicted classes.\n",
      truth.size());
}
```
