> Explicit joint classifier and box-regressor optimization

The compact patch network has two 3x3 ReLU convolutions of widths 32/64 with
2x2 pools, a 128-unit dense ReLU, eleven class scores and ten class-specific
four-offset regressors: 426931 learned scalars. It computes a CNN pass per region.
There is no batch norm, moving state or hidden pretraining. The source adaptation
uses softmax and a jointly learned box head in place of the paper's SVMs and
separate ridge regression.

For label y, mask m and target offsets t, the loss is mean class cross-entropy
plus `sum(m*sum(SmoothL1(delta_y-t)))/max(sum(m),1)`. Background has no selected
regressor. Smooth-L1 is `.5*d²` for absolute error below one and `abs(d)-.5`
otherwise. The loop adds `.00005*sum(kernel²)`, excluding biases. Adam uses .001,
batch 32 and sixteen epochs. All leaves are created before constructing Adam.
Validation selects the lowest **combined** classification/regression loss; the
original short source run reports its final epoch, so validation selection is an
explicit teaching-run addition. No test scenes enter selection.

```{cpp, results="markdown", file="figures/rcnn_training.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

#include <print>
int main() {
  namespace n = dm::nn;
  n::set_num_threads(2);

  std::filesystem::path cache;
  if (const auto *p = std::getenv("DATAMUNGE_DATA_DIR"))
    cache = p;
  else if (const auto *p = std::getenv("XDG_CACHE_HOME"))
    cache = std::filesystem::path(p) / "datamunge/datasets";
  else
    cache = std::filesystem::path(std::getenv("HOME")) / ".cache/datamunge/datasets";
  dm::datasets::fetch("mnist", (cache / "mnist").string());

  const auto train = n::load_mnist((cache / "mnist").string(), "train");
  n::models::DetectionSceneConfig cfg;
  cfg.scenes = 80;
  cfg.seed = 11;
  const auto scenes = n::models::MakeTensorDetectionScenes(
      n::slice_axis(train.images, 0, 0, 2048), n::slice_axis(train.labels, 0, 0, 2048), cfg);

  std::vector<std::int64_t> fit_rows(64), validation_rows(16);
  std::iota(fit_rows.begin(), fit_rows.end(), 0);
  std::iota(validation_rows.begin(), validation_rows.end(), 64);
  const auto fit = n::models::MakeRcnnTrainingSamples(scenes, fit_rows),
             validation = n::models::MakeRcnnTrainingSamples(scenes, validation_rows);
  const auto x = 2. * fit.images - 1., vx = 2. * validation.images - 1.;
  n::ParameterStore p(17);
  {
    n::NoGradGuard guard;
    n::models::RcnnPatchHead(p, n::zeros({1, 28, 28, 1}));
  }
  if (p.count() != 426931)
    return 1;
  n::OptimizerConfig config;
  config.kind = n::OptimizerKind::Adam;
  n::Optimizer adam(p, .001, config);
  n::BatchOrder order(std::size_t(fit.labels.numel()), 32, 29);
  std::vector<n::Tensor> kernels;
  for (const auto &value : p.parameters())
    if (value.dim() >= 2)
      kernels.push_back(value);
  std::filesystem::create_directories("build");
  const std::string checkpoint = "build/rcnn_best.npz";
  std::vector<double> epochs, training, validation_nll;
  double best = std::numeric_limits<double>::infinity();
  int selected = 0, steps = 0;
  std::print("| epoch | fit joint loss | validation joint loss |\n|---:|---:|---:|\n");
  for (int epoch = 1; epoch <= 16; ++epoch) {
    order.begin_epoch();
    double total = 0;
    std::size_t seen = 0;
    for (auto rows = order.next(); !rows.empty(); rows = order.next()) {
      const auto index = n::from_vector(rows);
      const auto logits = n::models::RcnnPatchHead(p, n::gather(x, index));
      const auto ce = n::models::DetectionRoiLoss(logits, n::gather(fit.labels, index),
                                                  n::gather(fit.targets, index),
                                                  n::gather(fit.mask, index));
      n::Tensor penalty = n::zeros({});
      for (const auto &kernel : kernels)
        penalty = penalty + n::sum(n::square(kernel));
      total += ce.item() * rows.size();
      seen += rows.size();
      adam.minimize(ce + .00005 * penalty);
      ++steps;
    }
    n::NoGradGuard guard;
    const auto loss =
        n::models::DetectionRoiLoss(n::models::RcnnPatchHead(p, vx), validation.labels,
                                    validation.targets, validation.mask);
    epochs.push_back(epoch);
    training.push_back(total / double(seen));
    validation_nll.push_back(loss.item());
    if (loss.item() < best) {
      best = loss.item();
      selected = epoch;
      p.save(checkpoint);
    }
    std::print("| {} | {:.6f} | {:.6f} |\n", epoch, training.back(), validation_nll.back());
  }
  p.load(checkpoint);
  n::NoGradGuard guard;
  const auto logits = n::models::RcnnPatchHead(p, vx);
  const auto restored = n::models::DetectionRoiLoss(logits, validation.labels,
                                                    validation.targets, validation.mask);
  if (!std::isfinite(best) || std::abs(restored.item() - best) > 1e-6 ||
      training.back() >= training.front())
    return 1;
  const auto predicted = n::argmax(logits.logits, 1);
  const double accuracy =
      n::mean(n::equal(predicted, validation.labels).to(n::DType::Float32)).item();
  const auto confusion = n::matmul(n::transpose(n::one_hot(validation.labels, 11), {1, 0}),
                                   n::one_hot(predicted, 11));
  auto curve = dm::graphics::RPlot::create();
  curve.lines(epochs, training, "training", {37, 99, 235})
      .lines(epochs, validation_nll, "validation", {220, 38, 38})
      .title("R-CNN joint region loss")
      .x_label("epoch")
      .y_label("CE plus masked Smooth-L1")
      .y_limits(
          0, 1.3 * std::max(*std::max_element(training.begin(), training.end()),
                            *std::max_element(validation_nll.begin(), validation_nll.end())));
  auto counts = n::plot_tensor_map(n::reverse(confusion, {0}), 0, n::max(confusion).item());
  counts.title("Selected validation regions")
      .x_label("predicted class (10=background)")
      .y_label("true class (10=background)")
      .x_limits(-.5, 10.5)
      .y_limits(-.5, 10.5);
  dm::graphics::RLayout::create(1, 2)
      .add(curve)
      .add(counts)
      .size(1200, 550)
      .fit_panels()
      .save_svg("build/rcnn_training.svg");
  std::print(
      "{} learned scalars, {} Adam updates; selected epoch {}, validation joint loss {:.6f}, "
      "region accuracy {:.6f} on {} patches. No moving model state.\n",
      p.count(), steps, selected, best, accuracy, validation.labels.numel());
}
