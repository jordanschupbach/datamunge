> Penalty-reduced focal and masked L1 objective

The heatmap loss uses `sigmoid(-x)²*softplus(-x)` at targets exactly one;
other pixels use `(1-target)^4*sigmoid(x)²*softplus(x)`. There is no RetinaNet
alpha factor. Summed heatmap focal plus `.1*size L1 + offset L1` divides by
retained centres floored at one. L1 applies only at retained cells; background
images still train heatmap negatives. The independent fixture checks every
derivative, including the Gaussian .5 shoulder's factor of1/16.

```{cpp, results="markdown", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

#include <print>
int main() {
  namespace n = dm::nn;
  const auto type = n::DType::Float64;
  const auto l = n::zeros({1, 1, 3, 1}, type).requires_grad_(),
             s = n::from_vector(std::vector<double>{.2, 4, 2, 3, 4, 5}, {1, 1, 3, 2})
                     .requires_grad_(),
             o = n::from_vector(std::vector<double>{.1, .8, 2, 3, 4, 5}, {1, 1, 3, 2})
                     .requires_grad_();
  const auto heat = n::from_vector(std::vector<double>{1, .5, 0}, {1, 1, 3, 1}),
             ts = n::from_vector(std::vector<double>{1, 3, 0, 0, 0, 0}, {1, 1, 3, 2}),
             to = n::from_vector(std::vector<double>{.3, .5, 0, 0, 0, 0}, {1, 1, 3, 2}),
             mask = n::from_vector(std::vector<double>{1, 0, 0}, {1, 1, 3, 1});
  const auto loss = n::models::CenterLoss(l, s, o, heat, ts, to, mask);
  if (std::abs(loss.item() - (.515625 * std::log(2.) + .68)) > 1e-12)
    return 1;
  const auto g = n::grad(loss, {l, s, o});
  const double a = .125 + .25 * std::log(2.), expected[] = {-a, a / 16, a};
  double error = 0;
  for (int i = 0; i < 3; ++i)
    error = std::max(error, std::abs(g[0].reshape({3}).at({i}) - expected[i]));
  for (int i = 0; i < 6; ++i) {
    error = std::max(error, std::abs(g[1].reshape({6}).at({i}) - (i == 0   ? -.1
                                                                  : i == 1 ? .1
                                                                           : 0.)));
    error = std::max(error, std::abs(g[2].reshape({6}).at({i}) - (i == 0   ? -1.
                                                                  : i == 1 ? 1.
                                                                           : 0.)));
  }
  if (error > 1e-12)
    return 1;
  const auto bg = n::models::CenterLoss(l, s, o, n::zeros({1, 1, 3, 1}, type), ts, to,
                                        n::zeros({1, 1, 3, 1}, type));
  for (const auto &v : n::grad(bg, {s, o}))
    if (n::count_nonzero(v).item() != 0)
      return 1;
  std::print("Heatmap/size/offset fixture loss{:.12f}; every analytic derivative "
             "error{:.12f}. Background heatmap loss{:.12f} retains learning with exact zero "
             "size/offset derivatives.\n",
             loss.item(), error, bg.item());
}
```
