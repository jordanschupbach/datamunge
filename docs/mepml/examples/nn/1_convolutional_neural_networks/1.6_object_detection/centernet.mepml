> Adaptive Gaussian heatmaps and centre collisions

CenterNet represents each object at `floor(pixel centre/4)` on a stride-four
class heatmap, with height/width and subpixel dy/dx heads. The authors' radius
formula takes the minimum of three quadratic expressions at overlap .7.
This port preserves their code, including division by two in the second and
third expressions. It floors the radius and uses sigma=(2*radius+1)/6 inside
a finite square support. White pixels represent target1 and green pixels target0 in the heatmap figure. Same-class kernels combine by **maximum** and clip
at image edges. Gaussian shoulders are negative targets with reduced penalty,
not soft positive class labels.

When several objects share a centre cell, this source keeps the largest area
across classes, first truth on exact area ties. Only that winner draws a
Gaussian; each discarded object counts as a collision. The fixture below
checks a clipped radius-two kernel and three colliding objects.

```{cpp, results="markdown", file="figures/centernet_targets.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

#include <print>
int main() {
  namespace n = dm::nn;
  namespace m = n::models;
  const auto centres = n::from_vector(std::vector<std::int64_t>{3, 3, 0, 0, 3, 4}, {3, 2});
  const auto heat =
      m::CenterGaussianHeatmap(7, 7, 1, centres, n::zeros({3}, n::DType::Int64),
                               n::full({3}, 2., n::DType::Int64), n::DType::Float64);
  double error = 0;
  for (int y = 0; y < 7; ++y)
    for (int x = 0; x < 7; ++x) {
      double expected = 0;
      for (const auto &point : std::vector<std::array<int, 2>>{{3, 3}, {0, 0}, {3, 4}}) {
        const int dy = y - point[0], dx = x - point[1];
        if (std::abs(dy) <= 2 && std::abs(dx) <= 2)
          expected =
              std::max(expected, std::exp(-(dy * dy + dx * dx) / (2. * std::pow(5. / 6., 2))));
      }
      error = std::max(error, std::abs(heat.at({y, x, 0}) - expected));
    }
  if (error > 1e-15)
    return 1;
  m::TensorDetectionScenes data;
  data.images = n::zeros({1, 64, 64, 1});
  data.boxes = {n::tensor({8., 12., 24., 28., 9., 13., 25., 29., 7., 11., 27., 31.}, {3, 4})};
  data.labels = {n::from_vector(std::vector<std::int64_t>{1, 2, 3})};
  const auto t = m::MakeCenterTargets(data, {0}, 4);
  if (t.collisions != 2 || t.heatmap.at({0, 4, 5, 3}) != 1 ||
      t.heatmap.at({0, 4, 5, 1}) != 0 || n::sum(t.mask).item() != 1)
    return 1;
  auto a = n::plot_tensor_map(n::reverse(heat.reshape({7, 7}), {0}), 0, 1);
  a.title("Clipped max-combined Gaussians")
      .x_label("grid column")
      .y_label("grid row")
      .x_limits(-.5, 6.5)
      .y_limits(-.5, 6.5);
  const auto classes = n::unstack(t.heatmap, 3);
  auto b = n::plot_tensor_map(n::reverse(classes[3].reshape({16, 16}), {0}), 0, 1);
  b.title("Retained largest-object target")
      .x_label("grid column")
      .y_label("grid row")
      .x_limits(-.5, 15.5)
      .y_limits(-.5, 15.5);
  std::filesystem::create_directories("build");
  dm::graphics::RLayout::create(1, 2).add(a).add(b).size(1200, 600).fit_panels().save_svg(
      "build/centernet_targets.svg");
  std::print("Every Gaussian pixel matches independent oracle, max error{:.16f}; "
             "radius(10,10)={:.12f}. Two collisions retain class3 at row4,column5, size5/5, "
             "offset.25/.25.\n",
             error,
             m::CenterGaussianRadius(n::full({}, 10., n::DType::Float64),
                                     n::full({}, 10., n::DType::Float64))
                 .item());
}
```
