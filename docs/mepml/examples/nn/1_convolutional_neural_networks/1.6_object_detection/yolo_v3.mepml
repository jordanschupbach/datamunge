> Nine fit-only pixel priors and one global assignment

Nine priors are clustered from all boxes in the64 fitting scenes only, using
tensor IoU clustering. They are in **input-pixel** units at the base64-pixel
scene size, unlike YOLO v2's grid-unit priors. Sorted by area, the smallest
three belong to the fine stride8 head, middle three to stride16 and largest
three to coarse stride32. Each truth chooses exactly one best prior globally,
first on IoU ties, then its centre cell at that scale. Same-slot collisions
keep the largest target area, first on ties.

Unassigned predictions overlapping **any** truth at current decoded IoU>.5
are ignored for objectness, across every scale. Positives restore weight1.
The source-compatible fixture assigns8/16/32-pixel objects once each to
fine/middle/coarse heads and checks the resulting area weights. Fitting uses
actual cached MNIST scenes, with no validation/test contribution to priors.

```{cpp, results="markdown", file="figures/yolo_v3_priors.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

#include <print>
int main() {
  namespace n = dm::nn;
  namespace m = n::models;

  std::filesystem::path cache;
  if (const auto *p = std::getenv("DATAMUNGE_DATA_DIR"))
    cache = p;
  else if (const auto *p = std::getenv("XDG_CACHE_HOME"))
    cache = std::filesystem::path(p) / "datamunge/datasets";
  else
    cache = std::filesystem::path(std::getenv("HOME")) / ".cache/datamunge/datasets";
  dm::datasets::fetch("mnist", (cache / "mnist").string());

  const auto digits = n::load_mnist((cache / "mnist").string(), "train");
  m::DetectionSceneConfig cfg;
  cfg.scenes = 80;
  cfg.seed = 11;
  const auto scenes = m::MakeTensorDetectionScenes(
      n::slice_axis(digits.images, 0, 0, 2048), n::slice_axis(digits.labels, 0, 0, 2048), cfg);
  std::vector<n::Tensor> samples;
  for (int row = 0; row < 64; ++row)
    samples.push_back(n::slice_axis(scenes.boxes[row], 1, 2, 4) -
                      n::slice_axis(scenes.boxes[row], 1, 0, 2));
  const auto dimensions = n::concat(samples, 0),
             priors = m::ClusterYoloDimensions(dimensions, 9);
  const auto d = n::unstack(dimensions, 1);
  auto plot = dm::graphics::RPlot::create();
  plot.points(d[1].to_vector<double>(), d[0].to_vector<double>(), "fit dimensions",
              {100, 116, 139});
  const std::array<dm::graphics::RGB, 3> colors = {
      {{22, 163, 74}, {37, 99, 235}, {220, 38, 38}}};
  const std::array<std::string, 3> names = {"fine priors", "middle priors", "coarse priors"};
  std::print("| scale | prior height | prior width |\n|---|---:|---:|\n");
  for (int group = 0; group < 3; ++group) {
    const auto p = n::unstack(n::slice_axis(priors, 0, 3 * group, 3 * group + 3), 1);
    plot.points(p[1].to_vector<double>(), p[0].to_vector<double>(), names[group],
                colors[group]);
    for (int a = 0; a < 3; ++a)
      std::print("| {} | {:.6f} | {:.6f} |\n", names[group], p[0].at({a}), p[1].at({a}));
  }
  plot.title("Nine fitting-box pixel priors")
      .x_label("width in input pixels")
      .y_label("height in input pixels")
      .x_limits(0, 40)
      .y_limits(0, 40);
  std::filesystem::create_directories("build");
  plot.size(900, 700).save_svg("build/yolo_v3_priors.svg");
  std::array<n::Tensor, 3> raw;
  for (int l = 0; l < 3; ++l)
    raw[l] = n::zeros({1, 2 << l, 2 << l, 3, 8});
  m::TensorDetectionScenes fixture;
  fixture.images = n::zeros({1, 64, 64, 1});
  fixture.boxes = {
      n::tensor({24., 24., 32., 32., 16., 16., 32., 32., 0., 0., 32., 32.}, {3, 4})};
  fixture.labels = {n::from_vector(std::vector<std::int64_t>{0, 1, 2})};
  const auto t = m::MakeYoloV3Targets(raw,
                                      n::tensor({4., 4., 6., 6., 8., 8., 12., 12., 16., 16.,
                                                 20., 20., 24., 24., 32., 32., 48., 48.},
                                                {9, 2}),
                                      fixture, {0});
  if (t.collisions != 0)
    return 1;
  int ignored = 0;
  for (int l = 0; l < 3; ++l) {
    if (n::sum(t.levels[l].positive).item() != 1)
      return 1;
    const double side = 32 >> l;
    const double weight = n::sum(t.levels[l].geometry_weight).item();
    if (std::abs(weight - (2. - side * side / 4096.)) > 1e-6)
      return 1;
    ignored += n::count_nonzero(n::logical_and(n::equal(t.levels[l].positive, 0.),
                                               n::equal(t.levels[l].objectness_weight, 0.)))
                   .item<int>();
    std::print("Fixture stride{}: one positive, relative-area coordinate weight {:.6f}.\n",
               32 >> l, weight);
  }
  if (ignored < 3)
    return 1;
  std::print("{} actual fit-box samples; fixture has{} ignored nonresponsible overlaps. No "
             "held-out box fits priors.\n",
             dimensions.shape()[0], ignored);
}
