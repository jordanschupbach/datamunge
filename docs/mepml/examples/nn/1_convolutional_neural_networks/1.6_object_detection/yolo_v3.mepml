> Full residual/top-down graphs and compact widths

Darknet53 stages contain1/2/8/8/4 residual units after padded stride-two
convolutions. Three top-down routes use five alternating1x1/3x3 convolutions,
then3x3/linear prediction heads. Reduced routes nearest-upsample and join finer
backbone features. There are75 convolutions total, with BN/leaky-ReLU.1 on
feature convolutions and biased linear prediction layers.

The initialized full80/20-class models have61,949,149/61,626,049 learned scalars,
52,608 state scalars and222 learned tensor gradients each. Both full128-pixel
backward probes execute below. No pretrained weights, COCO/VOC training or
benchmark accuracy is implied. The complete compact10-class, width-divisor8,
grayscale model has976,795 learned/6,576 state scalars and supports64/96/128px
multiscale inputs without changing learned shapes.

```{cpp, results="markdown", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

#include <print>
int main() {
  namespace n = dm::nn;
  n::set_num_threads(2);
  for (int classes : {80, 20}) {
    n::ParameterStore p(17), state(17);
    n::models::YoloV3Config cfg;
    cfg.classes = classes;
    cfg.update_stats = false;
    const auto net = n::models::YoloV3(
        p, state, n::sin(.13 * n::arange(0, 128 * 128 * 3)).reshape({1, 128, 128, 3}), cfg,
        true);
    const auto g = n::grad(n::mean(n::square(net.raw[0])) + n::mean(n::square(net.raw[1])) +
                               n::mean(n::square(net.raw[2])),
                           p.parameters());
    if (p.count() != (classes == 80 ? 61949149 : 61626049) || state.count() != 52608 ||
        g.size() != 222)
      return 1;
    for (const auto &v : g)
      if (!v.defined() || !std::isfinite(n::sum(n::square(v)).item()))
        return 1;
    std::print("Full{}-class YOLO v3: {} learned/{} state scalars, all{} finite defined "
               "tensor gradients at128px. Heads4/8/16, three priors each.\n",
               classes, p.count(), state.count(), g.size());
  }
}
