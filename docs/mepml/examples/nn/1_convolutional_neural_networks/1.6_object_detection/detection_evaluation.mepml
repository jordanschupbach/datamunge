> Difficult objects, crowds and threshold equality

VOC uses **IoU strictly greater** than its threshold. A detection chooses its
maximum-overlap truth even if already matched: duplicates count as false
positives. Hits on difficult objects are ignored. COCO uses **IoU greater than
or equal** to the threshold, prefers eligible regular truths before crowds and
allows a crowd region to absorb repeated detections. Crowd overlap divides
intersection by detection area, so a small detection fully inside a crowd can
be ignored even though ordinary IoU is small. Entirely ignored categories have
AP `-1` internally and are excluded from dataset means.

The flags are dataset-specific: a VOC difficult flag does not itself imply
COCO crowd. The evaluator reports all-area box metrics only; it does not implement
area ranges, segmentation AP or the full official COCO summary.

```{cpp, results="markdown", file="figures/detection_evaluation_thresholds.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

#include <print>
int main() {
  namespace n = dm::nn;
  namespace m = n::models;
  const std::vector<m::DetectionEvaluationTruth> difficult = {
      {1, 1, {0, 0, 10, 10}}, {1, 1, {20, 20, 40, 40}, true, false}};
  const std::vector<m::DetectionEvaluationPrediction> d = {{1, 1, .99f, {20, 20, 40, 40}},
                                                           {1, 1, .9f, {0, 0, 10, 10}},
                                                           {1, 1, .8f, {0, 0, 10, 10}}};
  const auto v = m::EvaluateDetectionClass(d, difficult, {1}, 1, .5, false);
  const std::vector<m::DetectionEvaluationTruth> crowd = {{1, 1, {0, 0, 20, 20}, false, true},
                                                          {1, 1, {30, 30, 40, 40}}};
  const std::vector<m::DetectionEvaluationPrediction> c = {
      {1, 1, .99f, {1, 1, 3, 3}}, {1, 1, .98f, {4, 4, 8, 8}}, {1, 1, .9f, {30, 30, 40, 40}}};
  const auto k = m::EvaluateDetectionClass(c, crowd, {1}, 1, .5, true);
  if (v.interpolated.item() != 1 || k.interpolated.item() != 1 || k.recall.numel() != 1)
    return 1;
  const std::vector<m::DetectionEvaluationTruth> one = {{1, 1, {0, 0, 10, 10}}};
  const std::vector<m::DetectionEvaluationPrediction> half = {{1, 1, .9f, {0, 0, 10, 20}}};
  const auto inclusive = m::EvaluateDetectionClass(half, one, {1}, 1, .5, true),
             strict = m::EvaluateDetectionClass(half, one, {1}, 1, .5, false);
  if (inclusive.interpolated.item() != 1 || strict.interpolated.item() != 0)
    return 1;
  const auto all = m::EvaluateDetectionDataset(half, one, {1}, true);
  if (std::abs(all.ap.item() - .1) > 1e-12 || all.ap75.item() != 0)
    return 1;
  std::vector<double> thresholds, ap;
  for (int i = 0; i < 10; ++i) {
    const double t = .5 + .05 * i;
    thresholds.push_back(t);
    ap.push_back(m::EvaluateDetectionClass(half, one, {1}, 1, t, true).interpolated.item());
  }
  auto q = dm::graphics::RPlot::create();
  q.lines(thresholds, ap, "one half-overlap box", {37, 99, 235})
      .title("COCO AP across IoU cutoffs")
      .x_label("IoU cutoff")
      .y_label("101-point AP")
      .x_limits(.48, .97)
      .y_limits(0, 1.3);
  std::filesystem::create_directories("build");
  q.size(900, 500).save_svg("build/detection_evaluation_thresholds.svg");
  std::print("| fixture | AP |\n|---|---:|\n| difficult hit before true positive, VOC07 | "
             "{:.6f} |\n| repeated crowd hits before true positive, COCO | {:.6f} |\n| exact "
             ".5 overlap, strict VOC | {:.6f} |\n| exact .5 overlap, inclusive COCO | {:.6f} "
             "|\n| COCO mean of ten IoU cutoffs | {:.6f} |\n",
             v.interpolated.item(), k.interpolated.item(), strict.interpolated.item(),
             inclusive.interpolated.item(), all.ap.item());
}
```
