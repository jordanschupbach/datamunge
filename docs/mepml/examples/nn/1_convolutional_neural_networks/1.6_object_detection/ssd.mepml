> Data and explicit compact SSD fitting

The bounded split uses 64 fit/16 validation scenes from the first 2048 official
MNIST training digits, seed 11, and eight test scenes from the first 512 official
test digits, seed 22. The actual first training scenes are shown below. The
compact network has stride-two 32/64 convolutions and five 128-channel feature
stages, with grids 16/8/4/2/1/1. Its first L2 scale initializes to ten. Default
sides are 8/16/24/32/48/64 with a next side 80 for the final geometric-mean box.
This is an explicit 64-pixel adaptation with 1167362 learned scalars and 1536
predictions, not a width-scaled or pretrained SSD300.

```{cpp, results="markdown", file="figures/ssd_scenes.png", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

#include <print>
int main() {
  namespace n = dm::nn;
  n::set_num_threads(2);

  std::filesystem::path cache;
  if (const auto *p = std::getenv("DATAMUNGE_DATA_DIR"))
    cache = p;
  else if (const auto *p = std::getenv("XDG_CACHE_HOME"))
    cache = std::filesystem::path(p) / "datamunge/datasets";
  else
    cache = std::filesystem::path(std::getenv("HOME")) / ".cache/datamunge/datasets";
  dm::datasets::fetch("mnist", (cache / "mnist").string());

  const auto train = n::load_mnist((cache / "mnist").string(), "train");
  n::models::DetectionSceneConfig cfg;
  cfg.scenes = 80;
  cfg.seed = 11;
  const auto scenes = n::models::MakeTensorDetectionScenes(
      n::slice_axis(train.images, 0, 0, 2048), n::slice_axis(train.labels, 0, 0, 2048), cfg);

  std::vector<n::Tensor> boxes(scenes.boxes.begin(), scenes.boxes.begin() + 8);
  const auto preview = n::models::DrawDetectionBoxes(n::slice_axis(scenes.images, 0, 0, 8),
                                                     boxes, {.1, 1., .2});
  std::filesystem::create_directories("build");
  n::save_image_grid(preview, "build/ssd_scenes.png", 4, 0., 1., 4, 1., 2);
  std::int64_t objects = 0;
  for (const auto &b : scenes.boxes)
    objects += b.shape()[0];
  std::print("80 generated training/validation scenes; {} accepted digits. Preview: first "
             "eight training scenes with tight green boxes.\n",
             objects);
}
```
// result_begin: markdown
80 generated training/validation scenes; 195 accepted digits. Preview: first eight training scenes with tight green boxes.
\image(figures/ssd_scenes.png)
// result_end
\caption(Actual first eight training scenes with green target boxes. The compact SSD receives whole normalized scenes and predicts all default boxes in one forward pass.)
\alttext(Actual first eight training scenes with green target boxes. The compact SSD receives whole normalized scenes and predicts all default boxes in one forward pass.)

All six prediction heads and the learned L2 scale are created before Adam.
The visible loop uses learning rate .001, batch four and 32 epochs (512 updates),
with the multibox objective plus `.00005*sum(kernel²)`. Biases and the rank-one
scale vector are excluded from L2; the optimizer still fits both. This bounded
batch/epoch schedule differs explicitly from the full source run. There is no
batch norm, dropout or moving model state. Validation inclusive VOC AP50 selects
the parameter checkpoint, with strict improvement; test scenes are used only
after restoration.

Inference considers every foreground class independently. Per image/class it
keeps the top 200 scores strictly above .05, decodes class-agnostic offsets,
clips boxes to the image and removes zero-area boxes, then applies IoU .45 NMS
and a cap of 100 detections/image. Pre-NMS score ties prefer the **higher**
default index, preserving the source pair-sort convention; this differs from
mining's lower-index tie rule. The native tests cover both choices.

```{cpp, results="markdown", file="figures/ssd_training.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

#include <print>
int main() {
  namespace n = dm::nn;
  namespace m = n::models;
  n::set_num_threads(2);

  std::filesystem::path cache;
  if (const auto *p = std::getenv("DATAMUNGE_DATA_DIR"))
    cache = p;
  else if (const auto *p = std::getenv("XDG_CACHE_HOME"))
    cache = std::filesystem::path(p) / "datamunge/datasets";
  else
    cache = std::filesystem::path(std::getenv("HOME")) / ".cache/datamunge/datasets";
  dm::datasets::fetch("mnist", (cache / "mnist").string());

  const auto digits = n::load_mnist((cache / "mnist").string(), "train");
  m::DetectionSceneConfig cfg;
  cfg.scenes = 80;
  cfg.seed = 11;
  const auto scenes = m::MakeTensorDetectionScenes(
      n::slice_axis(digits.images, 0, 0, 2048), n::slice_axis(digits.labels, 0, 0, 2048), cfg);
  const auto anchors = m::SsdDefaultBoxes({16, 8, 4, 2, 1, 1}, {8, 16, 24, 32, 48, 64, 80},
                                          {4, 8, 16, 32, 64, 64}, {4, 6, 6, 6, 4, 4});
  std::vector<std::int64_t> val_rows(16);
  std::iota(val_rows.begin(), val_rows.end(), 64);
  std::vector<int> val_ids(val_rows.begin(), val_rows.end());
  n::ParameterStore p(17);
  {
    n::NoGradGuard guard;
    const auto warm = m::SSD(p, n::zeros({1, 64, 64, 1}), 11, true);
    if (warm.anchors != anchors.shape()[0])
      return 1;
  }
  if (p.count() != 1167362)
    return 1;
  // Inference borrows this scope's p/anchors; every class and default is handled by tensor kernels.
  const auto detect = [&](const m::TensorDetectionScenes &data,
                          const std::vector<std::int64_t> &rows) {
    n::NoGradGuard guard;
    const auto net =
        m::SSD(p, 2. * n::gather(data.images, n::from_vector(rows)) - 1., 11, true);
    return m::DecodeSsdDetections(net.probabilities, net.deltas, anchors, n::from_vector(rows),
                                  64, 64);
  };
  // Annotation conversion is presentation of existing tensor boxes/IDs, with no box arithmetic.
  const auto truth_records = [](const m::TensorDetectionScenes &data,
                                const std::vector<std::int64_t> &rows) {
    std::vector<m::DetectionEvaluationTruth> out;
    for (auto row : rows) {
      const auto boxes = n::boxes_to_vector(data.boxes[row]);
      const auto labels = data.labels[row].to_vector<int>();
      for (std::size_t i = 0; i < boxes.size(); ++i)
        out.push_back({int(row), labels[i], boxes[i]});
    }
    return out;
  };
  const auto validation_truth = truth_records(scenes, val_rows);
  n::OptimizerConfig adam_config;
  adam_config.kind = n::OptimizerKind::Adam;
  n::Optimizer adam(p, .001, adam_config);
  n::BatchOrder batches(64, 4, 29);
  std::vector<n::Tensor> kernels;
  for (const auto &leaf : p.parameters())
    if (leaf.dim() >= 2)
      kernels.push_back(leaf);
  std::filesystem::create_directories("build");
  const std::string checkpoint = "build/ssd_best.npz";
  std::vector<double> epochs, losses, ce_trace, reg_trace, ap_trace, scale_trace;
  double best = -1;
  int selected = 0, steps = 0;
  std::print(
      "| epoch | multibox loss | CE | regression | val AP50 |\n|---:|---:|---:|---:|---:|\n");
  for (int epoch = 1; epoch <= 32; ++epoch) {
    batches.begin_epoch();
    double total = 0, total_ce = 0, total_reg = 0;
    std::size_t seen = 0;
    for (auto rows = batches.next(); !rows.empty(); rows = batches.next()) {
      const auto net =
          m::SSD(p, 2. * n::gather(scenes.images, n::from_vector(rows)) - 1., 11, true);
      const auto targets = m::MakeSsdTargets(anchors, scenes, rows, 10);
      const auto objective =
          m::SsdMultiboxLoss(net.logits, net.deltas, targets.labels, targets.targets);
      n::Tensor penalty = n::zeros({});
      for (const auto &kernel : kernels)
        penalty = penalty + n::sum(n::square(kernel));
      if (!std::isfinite(objective.loss.item()))
        return 1;
      total += objective.loss.item() * rows.size();
      total_ce += objective.classification.item() * rows.size();
      total_reg += objective.regression.item() * rows.size();
      seen += rows.size();
      adam.minimize(objective.loss + .00005 * penalty);
      ++steps;
    }
    const auto metric =
        m::EvaluateDetectionDataset(m::DetectionEvaluationRecords(detect(scenes, val_rows)),
                                    validation_truth, val_ids, false, true);
    epochs.push_back(epoch);
    losses.push_back(total / double(seen));
    ce_trace.push_back(total_ce / double(seen));
    reg_trace.push_back(total_reg / double(seen));
    ap_trace.push_back(metric.ap50.item());
    scale_trace.push_back(n::mean(p.at("normalize/scale")).item());
    if (metric.ap50.item() > best) {
      best = metric.ap50.item();
      selected = epoch;
      p.save(checkpoint);
    }
    std::print("| {} | {:.6f} | {:.6f} | {:.6f} | {:.6f} |\n", epoch, losses.back(),
               ce_trace.back(), reg_trace.back(), ap_trace.back());
  }
  p.load(checkpoint);
  const auto restored =
      m::EvaluateDetectionDataset(m::DetectionEvaluationRecords(detect(scenes, val_rows)),
                                  validation_truth, val_ids, false, true);
  if (std::abs(restored.ap50.item() - best) > 1e-12)
    return 1;
  const auto test_digits = n::load_mnist((cache / "mnist").string(), "test");
  cfg.scenes = 8;
  cfg.seed = 22;
  const auto test =
      m::MakeTensorDetectionScenes(n::slice_axis(test_digits.images, 0, 0, 512),
                                   n::slice_axis(test_digits.labels, 0, 0, 512), cfg);
  std::vector<std::int64_t> test_rows(8);
  std::iota(test_rows.begin(), test_rows.end(), 0);
  std::vector<int> test_ids(test_rows.begin(), test_rows.end());
  const auto output = detect(test, test_rows);
  const auto records = m::DetectionEvaluationRecords(output);
  const auto truth = truth_records(test, test_rows);
  const auto voc = m::EvaluateDetectionDataset(records, truth, test_ids, false, true),
             coco = m::EvaluateDetectionDataset(records, truth, test_ids, true);
  std::vector<n::Tensor> predicted;
  const auto image_ids = output.images.to_vector<int>();
  for (int image = 0; image < 8; ++image) {
    std::vector<std::int64_t> index;
    for (std::size_t j = 0; j < image_ids.size(); ++j)
      if (image_ids[j] == image)
        index.push_back(std::int64_t(j));
    predicted.push_back(n::gather(output.boxes, n::from_vector(index)));
  }
  const auto green = m::DrawDetectionBoxes(test.images, test.boxes, {.1, 1., .2}),
             red = m::DrawDetectionBoxes(test.images, predicted, {1., .1, .1}),
             raw = test.images * n::ones({1, 1, 1, 3});
  n::save_image_grid(n::where(n::any(n::not_equal(green, raw), {3}, true), green, red),
                     "build/ssd_detections.png", 4, 0., 1., 4, 1., 2);
  std::filesystem::create_directories("figures");
  std::filesystem::copy_file("build/ssd_detections.png", "figures/ssd_detections.png",
                             std::filesystem::copy_options::overwrite_existing);
  auto a = dm::graphics::RPlot::create();
  a.lines(epochs, losses, "multibox", {37, 99, 235})
      .title("Compact SSD training objective")
      .x_label("epoch")
      .y_label("unregularized multibox loss")
      .y_limits(0, 1.3 * *std::max_element(losses.begin(), losses.end()));
  auto b = dm::graphics::RPlot::create();
  b.lines(epochs, ce_trace, "classification", {37, 99, 235})
      .lines(epochs, reg_trace, "regression", {220, 38, 38})
      .title("Both fitted loss terms")
      .x_label("epoch")
      .y_label("normalized loss")
      .y_limits(0, 1.3 * std::max(*std::max_element(ce_trace.begin(), ce_trace.end()),
                                  *std::max_element(reg_trace.begin(), reg_trace.end())));
  auto c = dm::graphics::RPlot::create();
  c.lines(epochs, ap_trace, "validation AP50", {22, 163, 74})
      .title("Validation detection selection")
      .x_label("epoch")
      .y_label("inclusive VOC AP50")
      .y_limits(0, 1.3);
  auto d = dm::graphics::RPlot::create();
  d.lines(epochs, scale_trace, "mean gamma", {147, 51, 234})
      .title("Fitted channel rescaling")
      .x_label("epoch")
      .y_label("mean learned first-map scale")
      .y_limits(*std::min_element(scale_trace.begin(), scale_trace.end()) - .1,
                *std::max_element(scale_trace.begin(), scale_trace.end()) + .2);
  dm::graphics::RLayout::create(2, 2)
      .add(a)
      .add(b)
      .add(c)
      .add(d)
      .size(1200, 1000)
      .fit_panels()
      .save_svg("build/ssd_training.svg");
  std::print(
      "{} learned scalars, {} Adam updates; selected epoch {}, validation AP50 {:.6f}. Test: "
      "{} digits in eight scenes, inclusive VOC AP50 {:.6f}, COCO AP75 {:.6f}, AP50:95 "
      "{:.6f}, {} detections. Selected mean learned L2 scale {:.6f}; no moving model state.\n",
      p.count(), steps, selected, best, truth.size(), voc.ap50.item(), coco.ap75.item(),
      coco.ap.item(), records.size(), n::mean(p.at("normalize/scale")).item());
}
