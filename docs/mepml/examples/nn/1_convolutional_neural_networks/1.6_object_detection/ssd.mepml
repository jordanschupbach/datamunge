> Hard-negative mining, the objective and its derivatives

Distinct greedy SSD matching first gives every target a different default box,
even when targets prefer the same box; remaining defaults match at IoU at least
.5. Background is the **last** class. For each image, mining ranks detached
background cross-entropies and keeps at most three negatives per positive.
Ties prefer the lower default index. The selected CE plus positive-anchor summed
Smooth-L1 is divided by the **total batch positive count**, floored at one.
Mining is per image, while normalization is across the batch.

The fixture has one positive in image 0 and two in image 1, so it selects three
and six negatives. An independent softmax/Smooth-L1 oracle checks the complete
loss and every logits/delta derivative. No optimizer runs in this check.
An all-background batch has zero selected negatives, zero objective and exact
zero gradients; it does not perform background-only learning.

```{cpp, results="markdown", file="figures/ssd_mining.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

#include <print>
int main() {
  namespace n = dm::nn;
  namespace m = n::models;
  const auto type = n::DType::Float64;
  const int A = 8, C = 3;
  const auto raw = .8 * n::sin(.7 * n::arange(0, 2 * A * C).to(type)),
             logits = raw.reshape({2, A, C}).detach().requires_grad_(),
             deltas = n::full({2, A, 4}, .3, type).requires_grad_();
  std::vector<std::int64_t> labels(2 * A, 2);
  labels[0] = 0;
  labels[A] = labels[A + 1] = 1;
  const auto target = n::from_vector(labels, {2, A});
  const auto out = m::SsdMultiboxLoss(logits, deltas, target, n::zeros({2, A, 4}, type));
  const auto g = n::grad(out.loss, {logits, deltas});
  const auto selected = out.selected_negatives.to_vector<bool>();
  const auto values = raw.to_vector<double>();
  double expected_loss = 0, error = 0;
  // Independent bounded-logit host reference for the tensor objective and its derivatives.
  for (int row = 0; row < 2; ++row) {
    std::vector<double> ce(A);
    std::vector<std::array<double, 3>> prob(A);
    std::vector<int> bg;
    int positives = 0;
    for (int a = 0; a < A; ++a) {
      double total = 0;
      for (int c = 0; c < C; ++c) {
        prob[a][c] = std::exp(values[(row * A + a) * C + c]);
        total += prob[a][c];
      }
      for (int c = 0; c < C; ++c)
        prob[a][c] /= total;
      ce[a] = -std::log(prob[a][labels[row * A + a]]);
      if (labels[row * A + a] == 2)
        bg.push_back(a);
      else
        ++positives;
    }
    std::stable_sort(bg.begin(), bg.end(), [&](int a, int b) {
      return ce[a] > ce[b];
    });
    bg.resize(std::min(int(bg.size()), 3 * positives));
    for (int a = 0; a < A; ++a) {
      const bool positive = labels[row * A + a] != 2,
                 negative = std::find(bg.begin(), bg.end(), a) != bg.end();
      if (selected[row * A + a] != negative)
        return 1;
      if (positive || negative)
        expected_loss += ce[a] / 3.;
      if (positive)
        expected_loss += 4 * .5 * .3 * .3 / 3.;
      for (int c = 0; c < C; ++c)
        error = std::max(error, std::abs(g[0].at({row, a, c}) -
                                         ((positive || negative)
                                              ? (prob[a][c] - (c == labels[row * A + a])) / 3.
                                              : 0.)));
      for (int c = 0; c < 4; ++c)
        error = std::max(error, std::abs(g[1].at({row, a, c}) - (positive ? .1 : 0.)));
    }
  }
  if (std::abs(out.loss.item() - expected_loss) > 1e-12 || error > 1e-12)
    return 1;
  const auto all_bg = m::SsdMultiboxLoss(logits, deltas, n::full({2, A}, 2., n::DType::Int64),
                                         n::zeros({2, A, 4}, type));
  const auto zero = n::grad(all_bg.loss, {logits, deltas});
  if (all_bg.loss.item() != 0 || n::max(n::abs(zero[0])).item() != 0 ||
      n::max(n::abs(zero[1])).item() != 0)
    return 1;
  const auto ce = -n::sum(n::one_hot(target, C, 1, 0, type) * n::log_softmax(logits, -1), {2});
  auto a = n::plot_tensor_map(n::reverse(ce, {0}), 0, n::max(ce).item());
  a.title("Per-default cross-entropy")
      .x_label("default index")
      .y_label("image index")
      .x_limits(-.5, 7.5)
      .y_limits(-.5, 1.5);
  auto b = n::plot_tensor_map(n::reverse(out.selected_negatives.to(type), {0}), 0, 1);
  b.title("Mined background mask")
      .x_label("default index")
      .y_label("image index")
      .x_limits(-.5, 7.5)
      .y_limits(-.5, 1.5);
  std::filesystem::create_directories("build");
  dm::graphics::RLayout::create(1, 2).add(a).add(b).size(1200, 500).fit_panels().save_svg(
      "build/ssd_mining.svg");
  std::print(
      "Per-image positives1/2 select3/6 backgrounds. CE{:.12f}+regression{:.12f}=loss{:.12f}; "
      "analytic derivative maximum error{:.12f}. All-background objective and both gradient "
      "tensors are exact zero.\n",
      out.classification.item(), out.regression.item(), out.loss.item(), error);
}
```
