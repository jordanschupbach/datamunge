> Full SSD300 architecture and gradient check

The complete source model uses VGG16 convolution blocks, normalized conv4_3,
dilation-six fc6, fc7 and four extra blocks. Six independent convolutional heads
produce 8732 predictions across grids 38/19/10/5/3/1. The following executes the
full 300-pixel, 21-class forward and backward pass and checks every learned
tensor. It validates initialized architecture and gradients; it does not fit a
VOC detector or load pretrained weights. The actual optimizer demonstration
below fits the complete compact source architecture on digit scenes.

```{cpp, results="markdown", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

#include <print>
int main() {
  namespace n = dm::nn;
  n::set_num_threads(2);
  n::ParameterStore p(17);
  const auto image = n::sin(.13 * n::arange(0, 300 * 300 * 3)).reshape({1, 300, 300, 3});
  const auto net = n::models::SSD(p, image);
  if (p.count() != 26285486 || net.anchors != 8732)
    return 1;
  std::print("| level | grid | channels | defaults/cell | predictions "
             "|\n|---:|---:|---:|---:|---:|\n");
  for (int l = 0; l < 6; ++l) {
    if (net.features[l].shape() != n::Shape{1, net.cells[l], net.cells[l], net.channels[l]})
      return 1;
    std::print("| {} | {}x{} | {} | {} | {} |\n", l + 1, net.cells[l], net.cells[l],
               net.channels[l], net.boxes_per_cell[l],
               net.cells[l] * net.cells[l] * net.boxes_per_cell[l]);
  }
  const auto gradients =
      n::grad(n::mean(n::square(net.logits)) + n::mean(n::square(net.deltas)), p.parameters());
  double minimum = std::numeric_limits<double>::infinity(), maximum = 0;
  for (const auto &g : gradients) {
    const double norm = n::sqrt(n::sum(n::square(g))).item();
    if (!std::isfinite(norm) || norm <= 0)
      return 1;
    minimum = std::min(minimum, norm);
    maximum = std::max(maximum, norm);
  }
  std::print("Full SSD300: {} learned scalars, {} predictions, {} learned tensor gradients "
             "all finite/nonzero; L2 norms[{:.9f},{:.9f}]. This is an initialized "
             "architecture check, not a fitted benchmark.\n",
             p.count(), net.anchors, gradients.size(), minimum, maximum);
}
```
