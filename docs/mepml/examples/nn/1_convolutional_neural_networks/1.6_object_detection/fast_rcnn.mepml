> Explicit end-to-end tensor optimization

The source backbone has four SAME 3x3 ReLU convolutions, widths 32/32/64/64,
with two 2x2 pools, giving 16x16x64 features and 64992 learned scalars. Each pooled
7x7x64 region passes through two 256-unit ReLU dense layers, then eleven class
scores and ten four-offset regressors. The complete model has 946963 learned
scalars and no moving state, normalization layers, dropout or pretrained weights.

The visible loop constructs all leaves before Adam, uses .001 learning rate,
two images per minibatch and eight epochs (256 updates, kept short so the report runs
quickly). Each step samples at most 128 RoIs, computes the backbone once for each image,
and minimizes mean region CE plus masked summed-coordinate Smooth-L1, with `.00005*sum(kernel²)` added explicitly.
Biases are excluded from L2. The best validation inclusive VOC AP50 selects the
checkpoint; ties keep the earlier epoch. Validation/test inference uses every
classical proposal and no appended truth or random sampling.

```{cpp, results="markdown", file="figures/fast_rcnn_training.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

#include <print>
int main() {
  namespace n = dm::nn;
  namespace m = n::models;
  n::set_num_threads(2);

  std::filesystem::path cache;
  if (const auto *p = std::getenv("DATAMUNGE_DATA_DIR"))
    cache = p;
  else if (const auto *p = std::getenv("XDG_CACHE_HOME"))
    cache = std::filesystem::path(p) / "datamunge/datasets";
  else
    cache = std::filesystem::path(std::getenv("HOME")) / ".cache/datamunge/datasets";
  dm::datasets::fetch("mnist", (cache / "mnist").string());

  const auto train = n::load_mnist((cache / "mnist").string(), "train");
  m::DetectionSceneConfig cfg;
  cfg.scenes = 80;
  cfg.seed = 11;
  const auto scenes = m::MakeTensorDetectionScenes(
      n::slice_axis(train.images, 0, 0, 2048), n::slice_axis(train.labels, 0, 0, 2048), cfg);

  std::vector<n::Tensor> candidates;
  for (int i = 0; i < 80; ++i)
    candidates.push_back(m::ComponentDetectionProposals(
        n::slice_axis(scenes.images, 0, i, i + 1).reshape({64, 64, 1}),
        {48, 64, 96, 128, 160, 200, 230}, 3));
  std::vector<std::int64_t> fit_rows(64), val_rows(16);
  std::iota(fit_rows.begin(), fit_rows.end(), 0);
  std::iota(val_rows.begin(), val_rows.end(), 64);
  n::ParameterStore p(17);
  {
    n::NoGradGuard guard;
    const auto f = m::StrideFourDetectionBackbone(p, n::zeros({1, 64, 64, 1}));
    m::DetectionRoiHead(p, f, n::tensor({0., 0., 1., 1.}, {1, 4}),
                        n::from_vector(std::vector<std::int64_t>{0}));
  }
  if (p.count() != 946963)
    return 1;
  // Model inference borrows p for this main scope; every numerical stage is tensor based.
  const auto detect = [&](const m::TensorDetectionScenes &data,
                          const std::vector<std::int64_t> &rows,
                          const std::vector<n::Tensor> &boxes) {
    n::NoGradGuard guard;
    const auto features = m::StrideFourDetectionBackbone(
        p, 2. * n::gather(data.images, n::from_vector(rows)) - 1.);
    const auto packed = m::PackDetectionRois(boxes);
    if (!packed.indices.numel())
      return m::SuppressDetectionCandidates(n::zeros({0, 4}), n::zeros({0}),
                                            n::zeros({0}, n::DType::Int64),
                                            n::zeros({0}, n::DType::Int64));
    const auto head = m::DetectionRoiHead(p, features, packed.rois, packed.indices);
    return m::DecodeDetectionRoiOutputs(head, packed.pixels,
                                        n::gather(n::from_vector(rows), packed.indices));
  };
  // Record conversion only presents existing tensor annotations; it performs no box arithmetic.
  const auto truth_records = [](const m::TensorDetectionScenes &data,
                                const std::vector<std::int64_t> &rows) {
    std::vector<m::DetectionEvaluationTruth> truth;
    for (auto i : rows) {
      const auto boxes = n::boxes_to_vector(data.boxes[i]);
      const auto labels = data.labels[i].to_vector<int>();
      for (std::size_t j = 0; j < boxes.size(); ++j)
        truth.push_back({int(i), labels[j], boxes[j]});
    }
    return truth;
  };
  std::vector<n::Tensor> val_candidates;
  for (auto row : val_rows)
    val_candidates.push_back(candidates[row]);
  const auto val_truth = truth_records(scenes, val_rows);
  std::vector<int> val_ids(val_rows.begin(), val_rows.end());
  n::OptimizerConfig config;
  config.kind = n::OptimizerKind::Adam;
  n::Optimizer adam(p, .001, config);
  n::BatchOrder order(64, 2, 29);
  n::Generator sampling(7);
  std::vector<n::Tensor> kernels;
  for (const auto &v : p.parameters())
    if (v.dim() >= 2)
      kernels.push_back(v);
  std::filesystem::create_directories("build");
  const std::string checkpoint = "build/fast_rcnn_best.npz";
  std::vector<double> epochs, losses, validation;
  double best = -1;
  int selected = 0, steps = 0;
  std::print("| epoch | sampled training joint loss | validation AP50 |\n|---:|---:|---:|\n");
  for (int epoch = 1; epoch <= 8; ++epoch) {
    order.begin_epoch();
    double total = 0;
    std::size_t seen = 0;
    for (auto rows = order.next(); !rows.empty(); rows = order.next()) {
      std::vector<n::Tensor> boxes;
      for (auto row : rows)
        boxes.push_back(candidates[row]);
      const auto batch = m::SampleDetectionRois(scenes, rows, boxes, sampling);
      const auto features = m::StrideFourDetectionBackbone(
          p, 2. * n::gather(scenes.images, n::from_vector(rows)) - 1.);
      const auto head = m::DetectionRoiHead(p, features, batch.rois, batch.indices);
      const auto joint = m::DetectionRoiLoss(head, batch.labels, batch.targets, batch.mask);
      n::Tensor penalty = n::zeros({});
      for (const auto &kernel : kernels)
        penalty = penalty + n::sum(n::square(kernel));
      if (!std::isfinite(joint.item()))
        return 1;
      total += joint.item() * rows.size();
      seen += rows.size();
      adam.minimize(joint + .00005 * penalty);
      ++steps;
    }
    const auto prediction = detect(scenes, val_rows, val_candidates);
    const auto metric = m::EvaluateDetectionDataset(m::DetectionEvaluationRecords(prediction),
                                                    val_truth, val_ids, false, true);
    epochs.push_back(epoch);
    losses.push_back(total / double(seen));
    validation.push_back(metric.ap50.item());
    if (metric.ap50.item() > best) {
      best = metric.ap50.item();
      selected = epoch;
      p.save(checkpoint);
    }
    std::print("| {} | {:.6f} | {:.6f} |\n", epoch, losses.back(), validation.back());
  }
  p.load(checkpoint);
  const auto restored = m::EvaluateDetectionDataset(
      m::DetectionEvaluationRecords(detect(scenes, val_rows, val_candidates)), val_truth,
      val_ids, false, true);
  if (std::abs(restored.ap50.item() - best) > 1e-12)
    return 1;
  const auto digits = n::load_mnist((cache / "mnist").string(), "test");
  cfg.scenes = 8;
  cfg.seed = 22;
  const auto test = m::MakeTensorDetectionScenes(n::slice_axis(digits.images, 0, 0, 512),
                                                 n::slice_axis(digits.labels, 0, 0, 512), cfg);
  std::vector<std::int64_t> test_rows(8);
  std::iota(test_rows.begin(), test_rows.end(), 0);
  std::vector<int> test_ids(test_rows.begin(), test_rows.end());
  std::vector<n::Tensor> test_candidates;
  double covered50 = 0, covered70 = 0;
  std::int64_t count = 0;
  for (int i = 0; i < 8; ++i) {
    const auto boxes = m::ComponentDetectionProposals(
        n::slice_axis(test.images, 0, i, i + 1).reshape({64, 64, 1}),
        {48, 64, 96, 128, 160, 200, 230}, 3);
    test_candidates.push_back(boxes);
    count += boxes.shape()[0];
    if (boxes.shape()[0] && test.boxes[i].shape()[0]) {
      const auto overlap = n::max(n::box_iou(boxes, test.boxes[i]), {0});
      covered50 += n::count_nonzero(n::greater_equal(overlap, .5)).item();
      covered70 += n::count_nonzero(n::greater_equal(overlap, .7)).item();
    }
  }
  const auto output = detect(test, test_rows, test_candidates);
  const auto records = m::DetectionEvaluationRecords(output);
  const auto truth = truth_records(test, test_rows);
  const auto voc = m::EvaluateDetectionDataset(records, truth, test_ids, false, true),
             coco = m::EvaluateDetectionDataset(records, truth, test_ids, true);
  // Group integer output row indices to draw the actual selected predictions.
  std::vector<n::Tensor> predicted_boxes;
  const auto image_ids = output.images.to_vector<int>();
  for (int image = 0; image < 8; ++image) {
    std::vector<std::int64_t> index;
    for (std::size_t j = 0; j < image_ids.size(); ++j)
      if (image_ids[j] == image)
        index.push_back(std::int64_t(j));
    predicted_boxes.push_back(n::gather(output.boxes, n::from_vector(index)));
  }
  const auto green = m::DrawDetectionBoxes(test.images, test.boxes, {.1, 1., .2}),
             red = m::DrawDetectionBoxes(test.images, predicted_boxes, {1., .1, .1}),
             raw = test.images * n::ones({1, 1, 1, 3});
  const auto sheet = n::where(n::any(n::not_equal(green, raw), {3}, true), green, red);
  n::save_image_grid(sheet, "build/fast_rcnn_detections.png", 4, 0., 1., 4, 1., 2);
  std::filesystem::create_directories("figures");
  std::filesystem::copy_file("build/fast_rcnn_detections.png",
                             "figures/fast_rcnn_detections.png",
                             std::filesystem::copy_options::overwrite_existing);
  auto a = dm::graphics::RPlot::create();
  a.lines(epochs, losses, "joint loss", {37, 99, 235})
      .title("Fast R-CNN training objective")
      .x_label("epoch")
      .y_label("CE plus masked Smooth-L1")
      .y_limits(0, 1.3 * *std::max_element(losses.begin(), losses.end()));
  auto b = dm::graphics::RPlot::create();
  b.lines(epochs, validation, "validation AP50", {22, 163, 74})
      .title("Validation detection selection")
      .x_label("epoch")
      .y_label("AP50")
      .y_limits(0, 1.3);
  dm::graphics::RLayout::create(1, 2).add(a).add(b).size(1200, 550).fit_panels().save_svg(
      "build/fast_rcnn_training.svg");
  std::print("{} learned scalars, {} Adam updates; selected epoch {}, validation AP50 {:.6f}. "
             "Test: {} scenes, {} digits, {:.3f} proposals/image, proposal recall .5/.7 "
             "{:.6f}/{:.6f}; inclusive VOC AP50 {:.6f}, COCO AP75 {:.6f}, AP50:95 {:.6f}; {} "
             "detections. One shared backbone evaluation per image; no moving state.\n",
             p.count(), steps, selected, best, 8, truth.size(), double(count) / 8.,
             covered50 / truth.size(), covered70 / truth.size(), voc.ap50.item(),
             coco.ap75.item(), coco.ap.item(), records.size());
}
```
