> Optional digit-crop prefix pretraining, with its own visible Adam loop

This source adaptation optionally pretrains the first20 convolutions as a
10-class digit-crop classifier. Crops use square aspect-preserving28x28 samples
centred on56x56 black canvases. Only the64 fit scenes produce fitting crops;
the16 validation scenes produce a separate validation set. No test pixels enter
pretraining. The compact BN classifier has353,714 learned/2,272 state scalars.

The visible loop uses Adam(.001),batch16,eight epochs, mean digit cross-entropy
plus `.00005*sum(kernel²)`. Caller-owned seed73 draws tensor augmentation scale
[.8,1.2), shifts±.2*56 and log-uniform exposure[1/1.5,1.5); its RNG stream differs
from source std RNG while the transform semantics are checked independently.
Unaugmented validation NLL selects paired learned/BN checkpoints. Crop training
is an explicit MNIST adaptation, not ImageNet pretraining.

```{cpp, results="markdown", file="figures/yolo_v1_pretraining.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

#include <print>
int main() {
  namespace n = dm::nn;
  namespace m = n::models;
  n::set_num_threads(2);

  std::filesystem::path cache;
  if (const auto *p = std::getenv("DATAMUNGE_DATA_DIR"))
    cache = p;
  else if (const auto *p = std::getenv("XDG_CACHE_HOME"))
    cache = std::filesystem::path(p) / "datamunge/datasets";
  else
    cache = std::filesystem::path(std::getenv("HOME")) / ".cache/datamunge/datasets";
  dm::datasets::fetch("mnist", (cache / "mnist").string());

  const auto digits = n::load_mnist((cache / "mnist").string(), "train");
  m::DetectionSceneConfig cfg;
  cfg.scenes = 80;
  cfg.height = cfg.width = 56;
  cfg.seed = 11;
  const auto scenes = m::MakeTensorDetectionScenes(
      n::slice_axis(digits.images, 0, 0, 2048), n::slice_axis(digits.labels, 0, 0, 2048), cfg);
  std::vector<std::int64_t> fitting(64), validation(16);
  std::iota(fitting.begin(), fitting.end(), 0);
  std::iota(validation.begin(), validation.end(), 64);
  const auto fit = m::YoloV1PretrainingCrops(scenes, fitting),
             val = m::YoloV1PretrainingCrops(scenes, validation);
  const auto fit_labels = n::concat(fit.labels, 0), val_labels = n::concat(val.labels, 0);
  const auto count = fit.images.shape()[0];
  std::filesystem::create_directories("build");
  n::save_image_grid(n::slice_axis(fit.images, 0, 0, std::min<std::int64_t>(16, count)),
                     "build/yolo_v1_crops.png", 4, 0., 1., 4, 1., 2);
  std::filesystem::create_directories("figures");
  std::filesystem::copy_file("build/yolo_v1_crops.png", "figures/yolo_v1_crops.png",
                             std::filesystem::copy_options::overwrite_existing);
  m::YoloV1Config model;
  model.classes = 10;
  model.compact = true;
  model.width_divisor = 8;
  model.dense_width = 256;
  model.batch_norm = true;
  model.keep_probability = 1;
  n::ParameterStore p(17), state(17);
  {
    n::NoGradGuard guard;
    m::YoloV1PretrainingLogits(p, state, n::zeros({1, 56 * 56}), model, false);
  }
  if (p.count() != 353714 || state.count() != 2272)
    return 1;
  n::OptimizerConfig config;
  config.kind = n::OptimizerKind::Adam;
  n::Optimizer adam(p, .001, config);
  n::BatchOrder batches(std::size_t(count), 16, 29);
  n::Generator augmentation(73);
  std::vector<n::Tensor> kernels;
  for (const auto &leaf : p.parameters())
    if (leaf.dim() >= 2)
      kernels.push_back(leaf);
  std::vector<double> epochs, training, nll, accuracy;
  double best = INFINITY;
  int selected = 0, steps = 0;
  std::print("| epoch | train NLL | val NLL | val accuracy |\n|---:|---:|---:|---:|\n");
  for (int epoch = 1; epoch <= 8; ++epoch) {
    batches.begin_epoch();
    double total = 0;
    std::size_t seen = 0;
    for (auto rows = batches.next(); !rows.empty(); rows = batches.next()) {
      const auto B = std::int64_t(rows.size());
      const auto transforms =
          n::concat({n::uniform({B, 1}, .8, 1.2, augmentation),
                     56. * n::uniform({B, 1}, -.2, .2, augmentation),
                     56. * n::uniform({B, 1}, -.2, .2, augmentation),
                     n::exp(n::uniform({B, 1}, -std::log(1.5), std::log(1.5), augmentation))},
                    1);
      const auto augmented = m::TransformTensorDetectionScenes(fit, rows, transforms);
      const auto logits = m::YoloV1PretrainingLogits(
          p, state, 2. * augmented.images.reshape({B, 56 * 56}) - 1., model, true);
      const auto objective =
          n::sparse_softmax_cross_entropy(logits, n::gather(fit_labels, n::from_vector(rows)));
      n::Tensor penalty = n::zeros({});
      for (const auto &kernel : kernels)
        penalty = penalty + n::sum(n::square(kernel));
      if (!std::isfinite(objective.item()))
        return 1;
      total += objective.item() * rows.size();
      seen += rows.size();
      adam.minimize(objective + .00005 * penalty);
      ++steps;
    }
    n::NoGradGuard guard;
    const auto logits = m::YoloV1PretrainingLogits(
        p, state, 2. * val.images.reshape({val.images.shape()[0], 56 * 56}) - 1., model,
        false);
    const double loss = n::sparse_softmax_cross_entropy(logits, val_labels).item(),
                 correct =
                     n::mean(n::equal(n::argmax(logits, 1), val_labels).to(n::DType::Float32))
                         .item();
    epochs.push_back(epoch);
    training.push_back(total / double(seen));
    nll.push_back(loss);
    accuracy.push_back(correct);
    if (loss < best) {
      best = loss;
      selected = epoch;
      p.save("build/yolo_v1_pretrain_params.npz");
      state.save("build/yolo_v1_pretrain_state.npz");
    }
    std::print("| {} | {:.6f} | {:.6f} | {:.6f} |\n", epoch, training.back(), loss, correct);
  }
  p.load("build/yolo_v1_pretrain_params.npz");
  state.load("build/yolo_v1_pretrain_state.npz");
  n::NoGradGuard guard;
  const auto restored = m::YoloV1PretrainingLogits(
      p, state, 2. * val.images.reshape({val.images.shape()[0], 56 * 56}) - 1., model, false);
  if (std::abs(n::sparse_softmax_cross_entropy(restored, val_labels).item() - best) > 1e-6)
    return 1;
  auto a = dm::graphics::RPlot::create();
  a.lines(epochs, training, "train NLL", {37, 99, 235})
      .lines(epochs, nll, "val NLL", {220, 38, 38})
      .title("Prefix crop-classifier fitting")
      .x_label("epoch")
      .y_label("unregularized NLL")
      .y_limits(0, 1.3 * std::max(*std::max_element(training.begin(), training.end()),
                                  *std::max_element(nll.begin(), nll.end())));
  auto b = dm::graphics::RPlot::create();
  b.lines(epochs, accuracy, "val accuracy", {22, 163, 74})
      .title("Held-out crop classification")
      .x_label("epoch")
      .y_label("accuracy")
      .y_limits(0, 1.3);
  dm::graphics::RLayout::create(1, 2).add(a).add(b).size(1200, 500).fit_panels().save_svg(
      "build/yolo_v1_pretraining.svg");
  std::print(
      "Prefix pretraining:{} fit/{} validation crops,{} learned/{} state scalars,{} visible "
      "Adam(.001) updates. Selected epoch{} by validation NLL{:.6f}; restored accuracy{:.6f}. "
      "Detector fitting below transfers only conv1–20 and their BN state.\n",
      count, val.images.shape()[0], p.count(), state.count(), steps, selected, best,
      n::mean(n::equal(n::argmax(restored, 1), val_labels).to(n::DType::Float32)).item());
}
```
