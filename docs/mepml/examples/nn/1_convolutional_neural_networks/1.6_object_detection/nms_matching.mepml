> Matching and box coordinates

An RPN assigns a target when maximum IoU reaches .7, background below .3, and
ignore (`-2`) between them. Forced best-anchor matches can rescue a low-overlap
target but can collide: later targets overwrite earlier claims. SSD instead first
gives every target a distinct anchor by greedily selecting the largest available
pair, then adds remaining matches at IoU .5. This is a greedy assignment, not a
maximum-total-IoU Hungarian solution. Even zero-overlap pairs can be forced by
SSD; empty targets leave every anchor as background (`-1`).

For anchor centre/size `(ay,ax,ah,aw)` and target `(by,bx,bh,bw)`, coding uses
`dy=(by-ay)/(.1*ah)`, `dx=(bx-ax)/(.1*aw)`, `dh=log(bh/ah)/.2`, and similarly
for `dw`. Decoding reverses these operations, clipping log scales above 4.
The round-trip check keeps scales inside that clipping region.

```{cpp, results="markdown", file="figures/nms_matching_assignment.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

#include <print>
int main() {
  namespace n = dm::nn;
  const auto anchors = n::tensor(
      {0., 0., 10., 10., 0., 0., 10., 20., 30., 30., 40., 40., 60., 60., 70., 70.}, {4, 4});
  const auto truth = n::tensor({0., 0., 10., 10., 30., 30., 45., 45.}, {2, 4});
  const auto iou = n::box_iou(anchors, truth);
  const auto rpn = n::match_boxes(iou, .7, .3, true);
  if (rpn.to_vector<int>() != std::vector<int>{0, -2, 1, -1})
    return 1;
  const auto collision = n::box_iou(
      anchors, n::concat({n::slice_axis(truth, 0, 0, 1), n::slice_axis(truth, 0, 0, 1)}, 0));
  const auto ssd = n::models::MatchSsd(collision);
  if (ssd.to_vector<int>() != std::vector<int>{0, 1, -1, -1})
    return 1;
  const auto grid = n::anchor_grid(2, 3, 4, {8, 16}, {.5, 1, 2});
  const auto centers = n::boxes_to_center(grid);
  if (grid.shape() != n::Shape{36, 4} || std::abs(centers.at({0, 0}) - 2) > 1e-6 ||
      std::abs(centers.at({35, 1}) - 10) > 1e-6)
    return 1;
  const auto type = n::DType::Float64;
  const auto t = n::arange(0, 1000).to(type);
  const auto cy = 20 + 100 * n::abs(n::sin(t * .37)), cx = 20 + 100 * n::abs(n::cos(t * .23));
  const auto h = 2 + 78 * n::abs(n::sin(t * .17)), w = 2 + 78 * n::abs(n::cos(t * .19));
  const auto a = n::boxes_from_center(n::stack({cy, cx, h, w}, 1));
  const auto offsets = n::sin(n::arange(0, 4000).to(type) * .13).reshape({1000, 4});
  const auto b = n::decode_boxes(a, offsets);
  const auto encoded = n::encode_boxes(a, b), recovered = n::decode_boxes(a, encoded);
  const double error = n::max(n::abs(recovered - b)).item();
  if (error > 1e-10 || n::max(n::abs(encoded - offsets)).item() > 1e-11)
    return 1;
  const auto known = n::encode_boxes(n::tensor({10., 20., 30., 60.}, {1, 4}),
                                     n::tensor({12., 16., 36., 64.}, {1, 4}));
  if (std::abs(known.at({0, 0}) - 2) > 1e-6 ||
      std::abs(known.at({0, 2}) - std::log(1.2) / .2) > 1e-6)
    return 1;
  auto p = n::plot_tensor_map(n::reverse(iou, {0}), 0, 1);
  p.title("RPN anchor overlaps")
      .x_label("target index")
      .y_label("anchor index")
      .x_limits(-.5, 1.5)
      .y_limits(-.5, 3.5);
  auto q = n::plot_tensor_map(n::reverse(collision, {0}), 0, 1);
  q.title("Colliding SSD targets")
      .x_label("target index")
      .y_label("anchor index")
      .x_limits(-.5, 1.5)
      .y_limits(-.5, 3.5);
  std::filesystem::create_directories("build");
  dm::graphics::RLayout::create(1, 2).add(p).add(q).size(1200, 550).fit_panels().save_svg(
      "build/nms_matching_assignment.svg");
  std::print(
      "RPN assignments: 0, -2, 1, -1; colliding SSD assignments: 0, 1, -1, -1. Checked 36 "
      "anchors and 1000 Float64 coding round trips; maximum coordinate error {:.12f}.\n",
      error);
}
```
