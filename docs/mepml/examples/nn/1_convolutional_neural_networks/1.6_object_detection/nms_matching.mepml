> Stable objectness and explicit optimization

The RPN objective is weighted binary cross-entropy plus positive-anchor Smooth-L1.
Using `softplus(z)-z*y` gives derivative `sigmoid(z)-y`, including at `z=0`.
Each term divides by its own weight count, floored at one. At two zero logits,
labels `[1,0]` give bias gradients `[-.25,+.25]`. With no positive anchors the
regression contribution is exactly zero. Smooth-L1 transitions continuously at
absolute error one, with bounded slope.

```{cpp, results="markdown", file="figures/nms_matching_loss.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

#include <print>
int main() {
  namespace n = dm::nn;
  n::ParameterStore p(17, n::DType::Float64);
  const auto r = n::models::BuildRpn(p, {{n::zeros({1, 1, 1, 4}, p.dtype()), 4, 1, 2}}, 8);
  const auto loss = n::models::RpnLoss(
      r, n::from_vector(std::vector<double>{1, 0}, {1, 2}), n::ones({1, 2}, p.dtype()),
      n::zeros({1, 2, 4}, p.dtype()), n::zeros({1, 2}, p.dtype()));
  const auto g = n::grad(loss, {p.at("rpn/objectness/b")})[0];
  if (std::abs(loss.item() - std::log(2.)) > 1e-12 || std::abs(g.at({0}) + .25) > 1e-12 ||
      std::abs(g.at({1}) - .25) > 1e-12)
    return 1;
  const auto d = (n::arange(0, 121).to(p.dtype()) * .05 - 3).detach().requires_grad_();
  const auto huber = n::models::DetectorSmoothL1(d);
  const auto derivative = n::grad(n::sum(huber), {d})[0];
  auto q = dm::graphics::RPlot::create();
  q.lines(d.to_vector<double>(), huber.to_vector<double>(), "loss", {37, 99, 235})
      .lines(d.to_vector<double>(), derivative.to_vector<double>(), "derivative",
             {220, 38, 38})
      .title("Unit-transition Smooth-L1")
      .x_label("box offset error")
      .y_label("loss or slope")
      .y_limits(-1.4, 3.4);
  std::filesystem::create_directories("build");
  q.size(850, 500).save_svg("build/nms_matching_loss.svg");
  std::print(
      "Mean zero-logit BCE {:.12f}; foreground/background gradients {:.12f}, {:.12f}.\n",
      loss.item(), g.at({0}), g.at({1}));
}
```
// result_begin: markdown
Mean zero-logit BCE 0.693147180560; foreground/background gradients -0.250000000000, 0.250000000000.
\image(figures/nms_matching_loss.svg)
// result_end
\caption(Smooth-L1 is quadratic near zero and linear outside absolute error one; the plotted derivative remains between -1 and 1.)
\alttext(Smooth-L1 is quadratic near zero and linear outside absolute error one; the plotted derivative remains between -1 and 1.)

> Checkpoint and warm-start fixture

The source also tests the detector training lifecycle. This small fixture shows
its optimizer and checkpoint decisions directly. The single learned scalar
starts at .3; a separate moving-state scalar starts at 7. One Adam step on its
squared value gives about .299 while state becomes 8. A perfect one-object
validation detection has AP 1 before and after further fitting, so the strict
improvement rule retains the restored baseline. This tests checkpoint logic,
not detection learning. Warm starts restore learned parameters and model state;
Adam moments intentionally start fresh. Source and output prefixes must differ.

```{cpp, results="markdown", file="figures/nms_matching_checkpoint.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

#include <print>
int main() {
  namespace n = dm::nn;
  std::filesystem::create_directories("build/nms_checkpoints");
  const std::string initial = "build/nms_checkpoints/initial",
                    continued = "build/nms_checkpoints/continued";
  n::ParameterStore p(17), state(17);
  p.get("weight", {}, n::init::constant(.3));
  state.get("moving", {}, n::init::constant(7));
  n::OptimizerConfig cfg;
  cfg.kind = n::OptimizerKind::Adam;
  std::vector<double> values{p.at("weight").item()}, moving{state.at("moving").item()};
  {
    n::Optimizer adam(p, .001, cfg);
    for (int step = 0; step < 1; ++step) {
      const auto objective = n::square(p.at("weight"));
      adam.minimize(objective);
      n::NoGradGuard guard;
      state.at("moving").add_(n::scalar(1.));
    }
  }
  p.save(initial + "_params.npz");
  state.save(initial + "_state.npz");
  values.push_back(p.at("weight").item());
  moving.push_back(state.at("moving").item());
  if (std::abs(values.back() - .299) > 2e-6 || moving.back() != 8)
    return 1;
  // Restore both stores, then create a NEW optimizer with fresh moments.
  p.load(initial + "_params.npz");
  state.load(initial + "_state.npz");
  if (std::filesystem::absolute(initial).lexically_normal() ==
      std::filesystem::absolute(continued).lexically_normal())
    throw std::invalid_argument("warm start requires a separate output prefix");
  p.save(continued + "_params.npz");
  state.save(continued + "_state.npz");
  const auto box = n::tensor({1., 1., 5., 5.}, {1, 4});
  double best = n::box_iou(box, box).item(); // One perfect detection: precision=recall=AP=1.
  n::Optimizer fresh_adam(p, .001, cfg);
  for (int epoch = 1; epoch <= 2; ++epoch) {
    const auto objective = n::square(p.at("weight"));
    fresh_adam.minimize(objective);
    {
      n::NoGradGuard guard;
      state.at("moving").add_(n::scalar(1.));
    }
    values.push_back(p.at("weight").item());
    moving.push_back(state.at("moving").item());
    const double validation_ap = n::box_iou(box, box).item();
    if (validation_ap > best) {
      best = validation_ap;
      p.save(continued + "_params.npz");
      state.save(continued + "_state.npz");
    }
  }
  p.load(continued + "_params.npz");
  state.load(continued + "_state.npz");
  values.push_back(p.at("weight").item());
  moving.push_back(state.at("moving").item());
  if (std::abs(values.back() - .299) > 2e-6 || moving.back() != 8)
    return 1;
  auto a = dm::graphics::RPlot::create();
  a.lines({0, 1, 2, 3, 4}, values, "learned scalar", {37, 99, 235})
      .title("Parameters restore on tied AP")
      .x_label("initial / steps / restore")
      .y_label("weight")
      .y_limits(.295, .302);
  auto b = dm::graphics::RPlot::create();
  b.lines({0, 1, 2, 3, 4}, moving, "moving state", {22, 163, 74})
      .title("State restores with parameters")
      .x_label("initial / steps / restore")
      .y_label("moving value")
      .y_limits(6, 12);
  dm::graphics::RLayout::create(1, 2).add(a).add(b).size(1200, 500).fit_panels().save_svg(
      "build/nms_matching_checkpoint.svg");
  std::print(
      "Explicit initial and fresh-Adam loops passed. Strict AP ties retain baseline: restored "
      "weight {:.6f}, moving state {:.0f}, validation/test one-object AP {:.1f}.\n",
      values.back(), moving.back(), best);
}
```
