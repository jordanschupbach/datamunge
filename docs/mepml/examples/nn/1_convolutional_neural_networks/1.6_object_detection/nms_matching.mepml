> Simple examples: suppression and threshold equality

Boxes use continuous half-open `(ymin,xmin,ymax,xmax)` coordinates. Their area is
`(ymax-ymin)*(xmax-xmin)`, with no pixel `+1`. Greedy NMS visits scores in descending
order and suppresses overlap **strictly greater** than the threshold. Thus a half-box
at IoU .5 survives beside its full box when the threshold is .5. Ties prefer the
lower input index. A zero-area box has IoU zero, even with itself.

The source records TensorFlow selections; this report checks the same recorded
answers rather than running TensorFlow. Core NMS normalizes reversed corners;
the old example wrapper additionally rejects them. The code below calls the core
API directly. Selection is discrete and has no fitted parameters.

```{cpp, results="markdown", file="figures/nms_matching_suppression.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

#include <print>
int main() {
  namespace n = dm::nn;
  n::set_num_threads(2);
  const auto boxes = n::tensor({0.,  0., 10., 10., 0.,  0.,  10., 10., 0.,  0.,
                                10., 5., 20., 20., 30., 30., 40., 40., 40., 40.},
                               {5, 4});
  const auto scores = n::tensor({.9, .8, .7, .6, .5});
  const std::vector<std::vector<std::int64_t>> expected = {
      {},        {0},          {0, 3, 4}, {0, 3, 4}, {},        {0},
      {0, 2, 3}, {0, 2, 3, 4}, {},        {0},       {0, 1, 2}, {0, 1, 2, 3, 4}};
  int fixture = 0;
  std::print("| IoU threshold | limit | kept indices |\n|---:|---:|---|\n");
  for (double threshold : {0., .5, 1.})
    for (int limit : {0, 1, 3, 10}) {
      const auto selected = n::non_max_suppression(boxes, scores, limit, threshold)
                                .indices.to_vector<std::int64_t>();
      if (selected != expected[fixture++])
        return 1;
      std::print("| {:.1f} | {} |", threshold, limit);
      for (auto i : selected)
        std::print(" {}", i);
      std::print(" |\n");
    }
  if (n::non_max_suppression(boxes, n::ones({5}) * .8, 100, .5).indices.to_vector<int>() !=
      std::vector<int>{0, 2, 3, 4})
    return 1;
  if (n::non_max_suppression(n::zeros({0, 4}), n::zeros({0}), 10, .5).valid != 0)
    return 1;
  const auto groups = n::from_vector(std::vector<std::int64_t>{0, 0, 1, 2, 2});
  const auto kept = n::batched_non_max_suppression(boxes, scores, groups, .5).to_vector<int>();
  if (kept != std::vector<int>{0, 2, 3, 4})
    return 1;
  // A group identifies an (image,class) pair. The global cap here differs from
  // a detector's per-image cap, which must be applied separately for each image.
  const auto iou = n::box_iou(boxes, boxes);
  auto heat = n::plot_tensor_map(n::reverse(iou, {0}), 0, 1);
  heat.title("Pairwise IoU")
      .x_label("box index")
      .y_label("box index")
      .x_limits(-.5, 4.5)
      .y_limits(-.5, 4.5);
  auto trace = dm::graphics::RPlot::create();
  trace.lines({0, 1, 2, 3, 4}, scores.to_vector<double>(), "input score", {37, 99, 235})
      .title("Descending score order")
      .x_label("box index")
      .y_label("score")
      .y_limits(0, 1.25);
  std::filesystem::create_directories("build");
  dm::graphics::RLayout::create(1, 2)
      .add(heat)
      .add(trace)
      .size(1200, 500)
      .fit_panels()
      .save_svg("build/nms_matching_suppression.svg");
  std::print(
      "Fourteen recorded selection fixtures passed, plus group separation. Rows/columns 0 and "
      "1 are duplicates; box 2 overlaps them by exactly .5; box 4 has zero area.\n");
}
```
