> Actual digit-scene data

The bounded split matches the preceding detector reports: 64 fit and 16 validation
scenes from the first 2048 official MNIST training digits, seed 11; eight test
scenes from the first 512 official test digits, seed 22. Tensor bilinear sampling,
byte quantization, tight-box reductions and maximum compositing generate 64x64
images. Green boxes below are actual training annotations. Neither classical
component proposals nor test targets enter the learned proposal model.

```{cpp, results="markdown", file="figures/faster_rcnn_scenes.png", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

#include <print>
int main() {
  namespace n = dm::nn;
  n::set_num_threads(2);

  std::filesystem::path cache;
  if (const auto *p = std::getenv("DATAMUNGE_DATA_DIR"))
    cache = p;
  else if (const auto *p = std::getenv("XDG_CACHE_HOME"))
    cache = std::filesystem::path(p) / "datamunge/datasets";
  else
    cache = std::filesystem::path(std::getenv("HOME")) / ".cache/datamunge/datasets";
  dm::datasets::fetch("mnist", (cache / "mnist").string());

  const auto train = n::load_mnist((cache / "mnist").string(), "train");
  n::models::DetectionSceneConfig cfg;
  cfg.scenes = 80;
  cfg.seed = 11;
  const auto scenes = n::models::MakeTensorDetectionScenes(
      n::slice_axis(train.images, 0, 0, 2048), n::slice_axis(train.labels, 0, 0, 2048), cfg);

  std::vector<n::Tensor> boxes(scenes.boxes.begin(), scenes.boxes.begin() + 8);
  const auto preview = n::models::DrawDetectionBoxes(n::slice_axis(scenes.images, 0, 0, 8),
                                                     boxes, {.1, 1., .2});
  std::filesystem::create_directories("build");
  n::save_image_grid(preview, "build/faster_rcnn_scenes.png", 4, 0., 1., 4, 1., 2);
  std::int64_t objects = 0;
  for (const auto &b : scenes.boxes)
    objects += b.shape()[0];
  std::print("80 generated training/validation scenes; {} accepted digits. Preview: first "
             "eight training scenes with tight green boxes.\n",
             objects);
}
```
