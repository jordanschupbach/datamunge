> Sigmoid focal modulation and gradients

RetinaNet uses independent foreground sigmoid channels and no background column.
With target y and p=sigmoid(x), the loss is `alpha_t*(1-p_t)^gamma*BCE(x,y)`.
Alpha is .25 for positives and .75 for negatives; gamma is two. Gamma zero
recovers weighted BCE. The stable tensor expression uses Softplus for the
modulator and BCE. Confident correctly classified examples may round to zero;
incorrect logits at magnitude 80 remain finite. The following checks 42 values
and central-difference gradients against an independent scalar oracle.

```{cpp, results="markdown", file="figures/retinanet_focal.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

#include <print>
int main() {
  namespace n = dm::nn;
  const auto reference = [](double x, double y, double gamma) {
    const auto sp = [](double z) {
      return std::max(z, 0.) + std::log1p(std::exp(-std::abs(z)));
    };
    return (y ? .25 : .75) * std::exp(-gamma * sp((2 * y - 1) * x)) *
           (std::max(x, 0.) - x * y + std::log1p(std::exp(-std::abs(x))));
  };
  double error = 0;
  std::vector<double> xs, bce, focal;
  for (double gamma : {0., .5, 2.})
    for (double x : {-80., -10., -2., 0., 2., 10., 80.})
      for (double y : {0., 1.}) {
        const auto v = n::full({}, x, n::DType::Float64).requires_grad_();
        const auto loss =
            n::models::SigmoidFocalLoss(v, n::full({}, y, n::DType::Float64), .25, gamma);
        if (std::abs(loss.item() - reference(x, y, gamma)) > 1e-12)
          return 1;
        const double eps = 1e-4,
                     expected = (reference(x + eps, y, gamma) - reference(x - eps, y, gamma)) /
                                (2 * eps);
        error = std::max(error, std::abs(n::grad(loss, {v})[0].item() - expected));
      }
  if (error > 1e-9)
    return 1;
  const auto logits = n::linspace(-8, 8, 161, n::DType::Float64);
  xs = logits.to_vector<double>();
  const auto target = n::ones({}, n::DType::Float64);
  bce = n::models::SigmoidFocalLoss(logits, target, .25, 0).to_vector<double>();
  focal = n::models::SigmoidFocalLoss(logits, target, .25, 2).to_vector<double>();
  auto a = dm::graphics::RPlot::create();
  a.lines(xs, bce, "weighted BCE", {37, 99, 235})
      .lines(xs, focal, "focal gamma 2", {220, 38, 38})
      .title("Positive-target focal loss")
      .x_label("logit")
      .y_label("loss")
      .y_limits(0, 2.6);
  const auto negative = n::zeros({}, n::DType::Float64);
  auto b = dm::graphics::RPlot::create();
  b.lines(xs, n::models::SigmoidFocalLoss(logits, negative, .25, 0).to_vector<double>(),
          "weighted BCE", {37, 99, 235})
      .lines(xs, n::models::SigmoidFocalLoss(logits, negative, .25, 2).to_vector<double>(),
             "focal gamma 2", {220, 38, 38})
      .title("Negative-target focal loss")
      .x_label("logit")
      .y_label("loss")
      .y_limits(0, 7.8);
  std::filesystem::create_directories("build");
  dm::graphics::RLayout::create(1, 2).add(a).add(b).size(1200, 500).fit_panels().save_svg(
      "build/retinanet_focal.svg");
  std::print("42 focal values and central differences pass; maximum derivative error {:.12f}. "
             "Curves are tensor evaluations, not a fitted model.\n",
             error);
}
```
