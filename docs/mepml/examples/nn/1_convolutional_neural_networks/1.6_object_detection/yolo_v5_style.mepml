> CIoU geometry and stopped aspect weighting

Boxes use normalized centre coordinates `(cy,cx,height,width)`. CIoU subtracts
normalized squared centre distance and an aspect-ratio term from IoU.
The aspect coefficient `alpha` is detached, so derivative checks freeze it.
This matters when comparing automatic differentiation with finite differences.
Disjoint boxes still receive a centre-directed gradient. Sizes clamp at1e-7.
The following curves use tensor calculations; the native fixture separately
checks an independent scalar reference and all four frozen-alpha derivatives.

```{cpp, results="markdown", file="figures/yolo_v5_style_quality.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

#include <print>
int main() {
  namespace n = dm::nn;
  namespace m = n::models;
  const auto type = n::DType::Float64;
  const auto offsets = n::linspace(-.6, .6, 121, type), zero = n::zeros({121}, type);
  const auto prediction = n::stack({.5 + offsets, .5 + zero, .3 + zero, .2 + zero}, 1),
             target = n::tensor({.5, .5, .4, .32}, {1, 4}).to(type);
  const auto q = m::CompleteBoxQuality(prediction, target);
  auto plot = dm::graphics::RPlot::create();
  plot.lines(offsets.to_vector<double>(), q.iou.to_vector<double>(), "IoU", {37, 99, 235})
      .lines(offsets.to_vector<double>(), q.diou.to_vector<double>(), "DIoU", {22, 163, 74})
      .lines(offsets.to_vector<double>(), q.ciou.to_vector<double>(), "CIoU", {220, 38, 38})
      .title("Overlap and centre displacement")
      .x_label("vertical centre offset")
      .y_label("box quality")
      .y_limits(-.7, 1.3);
  std::filesystem::create_directories("build");
  plot.size(1000, 650).save_svg("build/yolo_v5_style_quality.svg");
  auto input = n::tensor({.53, .48, .3, .2}, {1, 4}).to(type).requires_grad_();
  const auto quality = m::CompleteBoxQuality(input, target);
  const auto g = n::grad(n::sum(1. - quality.ciou), {input})[0];
  if (quality.alpha.requires_grad() || !std::isfinite(n::sum(n::square(g)).item()))
    return 1;
  std::print("CIoU {:.9f}, stopped alpha {:.9f}; four finite geometry derivatives. Native "
             "independent frozen-alpha differences also pass.\n",
             quality.ciou.item(), quality.alpha.item());
}
```
