> Complete CSP/SPPF/PAN graph

This is the v6.0 YOLOv5s-style width.5/depth.33 architecture: a6x6 stride2,
pad2 stem; C3 backbone repeat counts1/2/3/1; serial5x5 SPPF; and C3 blocks in
both top-down and bottom-up PAN paths. Backbone bottlenecks have identity
shortcuts; neck bottlenecks disable them. BN uses epsilon.001/momentum.97,
followed by SiLU. The original fixtures check known CSP values/derivatives
and serial versus parallel5/9/13 pooling, including negative borders.

The full80-class graph executes at128 pixels with7,235,389 learned and19,008
state scalars and all177 tensor gradients. This graph check uses initialized
weights. The fitted10-class grayscale/divisor4 model retains every stage with
451,735 learned and4,752 state scalars. No pretrained weights are used.

```{cpp, results="markdown", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

#include <print>
int main() {
  namespace n = dm::nn;
  n::set_num_threads(2);
  for (bool compact : {false, true}) {
    n::ParameterStore p(17), state(17);
    n::models::YoloV5Config c;
    c.update_stats = false;
    if (compact) {
      c.classes = 10;
      c.width_divisor = 4;
      c.grayscale = true;
      c.reference_size = 64;
      c.expected_objects = 3;
    }
    const int side = compact ? 64 : 128, channels = compact ? 1 : 3;
    const auto net = n::models::YoloV5(p, state,
                                       n::sin(.13 * n::arange(0, 2 * side * side * channels))
                                           .reshape({2, side, side, channels}),
                                       c, true);
    const auto g = n::grad(n::mean(n::square(net.raw[0])) + n::mean(n::square(net.raw[1])) +
                               n::mean(n::square(net.raw[2])),
                           p.parameters());
    if (p.count() != (compact ? 451735 : 7235389) ||
        state.count() != (compact ? 4752 : 19008) || g.size() != 177)
      return 1;
    for (const auto &v : g)
      if (!v.defined() || !std::isfinite(n::sum(n::square(v)).item()))
        return 1;
    std::print("{} model: {} learned/{} BN state scalars, all{} finite defined gradients.\n",
               compact ? "compact" : "full", p.count(), state.count(), g.size());
    if (compact)
      for (int size : {96, 128}) {
        const auto o = n::models::YoloV5(p, state, n::zeros({1, size, size, 1}), c);
        if (o.raw[0].shape()[1] != size / 32)
          return 1;
        std::print("Dynamic{}px forward: head grids{}/{}/{}.\n", size, size / 32, size / 16,
                   size / 8);
      }
  }
}
```
