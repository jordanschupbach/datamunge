> Fit-only priors and ratio/axial-neighbour assignment

Nine ascending-area pixel priors are fitted only to boxes from64 fitting scenes.
Every prior whose maximum reciprocal dimension ratio is strictly below4 matches;
if none match, the first best-IoU prior is used. A matched prior selects its
base cell plus one vertical and one horizontal neighbour when its fractional
centre lies below or above.5. There are no diagonal copies, and exact.5 adds
no neighbour on that axis. Slot conflicts keep higher shape IoU, first on ties.
The fixture below gives21 positives from seven matched priors and three cells
per prior. Current input resolution changes normalized truth dimensions in
pixel prior space during multiscale fitting.

```{cpp, results="markdown", file="figures/yolo_v5_style_priors.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

#include <print>
int main() {
  namespace n = dm::nn;
  namespace m = n::models;

  std::filesystem::path cache;
  if (const auto *p = std::getenv("DATAMUNGE_DATA_DIR"))
    cache = p;
  else if (const auto *p = std::getenv("XDG_CACHE_HOME"))
    cache = std::filesystem::path(p) / "datamunge/datasets";
  else
    cache = std::filesystem::path(std::getenv("HOME")) / ".cache/datamunge/datasets";
  dm::datasets::fetch("mnist", (cache / "mnist").string());

  const auto digits = n::load_mnist((cache / "mnist").string(), "train");
  m::DetectionSceneConfig cfg;
  cfg.scenes = 80;
  cfg.seed = 11;
  const auto scenes = m::MakeTensorDetectionScenes(
      n::slice_axis(digits.images, 0, 0, 2048), n::slice_axis(digits.labels, 0, 0, 2048), cfg);
  std::vector<n::Tensor> samples;
  for (int row = 0; row < 64; ++row)
    samples.push_back(n::slice_axis(scenes.boxes[row], 1, 2, 4) -
                      n::slice_axis(scenes.boxes[row], 1, 0, 2));
  const auto dimensions = n::concat(samples, 0),
             priors = m::ClusterYoloDimensions(dimensions, 9);
  const auto d = n::unstack(dimensions, 1);
  auto plot = dm::graphics::RPlot::create();
  plot.points(d[1].to_vector<double>(), d[0].to_vector<double>(), "fit dimensions",
              {100, 116, 139});
  const std::array<dm::graphics::RGB, 3> colors = {
      {{22, 163, 74}, {37, 99, 235}, {220, 38, 38}}};
  const std::array<std::string, 3> names = {"fine priors", "middle priors", "coarse priors"};
  std::print("| scale | prior height | prior width |\n|---|---:|---:|\n");
  for (int group = 0; group < 3; ++group) {
    const auto p = n::unstack(n::slice_axis(priors, 0, 3 * group, 3 * group + 3), 1);
    plot.points(p[1].to_vector<double>(), p[0].to_vector<double>(), names[group],
                colors[group]);
    for (int a = 0; a < 3; ++a)
      std::print("| {} | {:.6f} | {:.6f} |\n", names[group], p[0].at({a}), p[1].at({a}));
  }
  plot.title("Nine fitting-box pixel priors")
      .x_label("width in input pixels")
      .y_label("height in input pixels")
      .x_limits(0, 40)
      .y_limits(0, 40);
  std::filesystem::create_directories("build");
  plot.size(900, 700).save_svg("build/yolo_v5_style_priors.svg");
  std::array<n::Tensor, 3> raw;
  for (int l = 0; l < 3; ++l)
    raw[l] = n::zeros({1, 2 << l, 2 << l, 3, 7});
  m::TensorDetectionScenes data;
  data.images = n::zeros({1, 64, 64, 1});
  data.boxes = {n::tensor({22., 22., 30., 30.}, {1, 4})};
  data.labels = {n::ones({1}, n::DType::Int64)};
  const auto t = m::MakeYoloV5Targets(raw,
                                      n::tensor({4., 4., 6., 6., 8., 8., 12., 12., 16., 16.,
                                                 20., 20., 24., 24., 32., 32., 48., 48.},
                                                {9, 2}),
                                      data, {0});
  int count = 0;
  for (int l = 0; l < 3; ++l) {
    count += n::sum(t.levels[l].positive).item<int>();
    std::print("Stride{}: {} positive slots.\n", 32 >> l,
               n::sum(t.levels[l].positive).item<int>());
  }
  if (count != 21 || t.collisions != 0)
    return 1;
  std::print("Seven ratio-matched priors each select a base and two axial neighbours:21 "
             "positive slots. Fit priors use{} boxes only.\n",
             dimensions.shape()[0]);
}
