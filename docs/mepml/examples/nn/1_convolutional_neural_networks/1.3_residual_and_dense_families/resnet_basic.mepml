> Simple shortcut examples

The fixtures isolate the output gate and the projection geometry using a zero residual. Neither fixed diagnostic fits parameters.

```{cpp, results="markdown", file="figures/resnet_basic_shortcuts.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

int main() {
  namespace n = dm::nn;
  const auto type = n::DType::Float64;
  n::models::ResNetNormConfig cfg;
  cfg.scale = true;
  cfg.epsilon = 1e-5;
  n::ParameterStore identity(17, type), identity_state(17, type);
  const auto x = n::linspace(-1, 1, 18, type).reshape({1, 3, 3, 2}).detach().requires_grad_();
  {
    n::NoGradGuard guard;
    n::models::ResNetBlock(identity, identity_state, "b", x, 2, cfg);
  }
  identity.set("b/conv2/bn/gamma", n::zeros({2}, type));
  const auto block = n::models::ResNetBlock(identity, identity_state, "b", x, 2, cfg);
  const auto derivative = n::grad(n::sum(block.output), {x})[0];
  if (n::max(n::abs(block.residual)).item() != 0 ||
      n::max(n::abs(block.output - n::relu(x))).item() != 0 ||
      n::max(n::abs(derivative - n::greater(x, 0).to(type))).item() != 0)
    return 1;
  n::ParameterStore projected(17, type), projected_state(17, type);
  const auto image =
      n::linspace(-1, 1, 50, type).reshape({1, 5, 5, 2}).detach().requires_grad_();
  {
    n::NoGradGuard guard;
    n::models::ResNetBlock(projected, projected_state, "b", image, 4, cfg, 2);
  }
  projected.set("b/conv2/bn/gamma", n::zeros({4}, type));
  projected.set("b/shortcut/W",
                n::tensor({1., 0., 1., 0., 0., 1., 0., 1.}, {1, 1, 2, 4}).to(type));
  projected.set("b/shortcut/bn/gamma", n::full({4}, std::sqrt(1 + cfg.epsilon), type));
  const auto result =
      n::models::ResNetBlock(projected, projected_state, "b", image, 4, cfg, 2);
  const auto sampled = n::slice_axis(n::slice_axis(image, 1, 0, 5, 2), 2, 0, 5, 2);
  const auto expected = n::relu(n::concat({sampled, sampled}, 3));
  const auto actual_gradient = n::grad(n::sum(result.output), {image})[0],
             expected_gradient = n::grad(n::sum(expected), {image})[0];
  const double error = std::max(n::max(n::abs(result.output - expected)).item(),
                                n::max(n::abs(actual_gradient - expected_gradient)).item());
  if (error > 1e-12)
    return 1;
  auto channel = [](const n::Tensor &t) {
    return n::slice_axis(t, 3, 0, 1).reshape({t.size(1), t.size(2)});
  };
  auto layout = dm::graphics::RLayout::create(2, 2);
  layout.add(n::plot_tensor_map(channel(x), -1, 1).title("Signed identity-path input"))
      .add(n::plot_tensor_map(channel(block.output), 0, 1)
               .title("Zero residual: post-add ReLU"))
      .add(n::plot_tensor_map(channel(result.output), 0, 1)
               .title("Projection: sampled channels"))
      .add(n::plot_tensor_map(channel(actual_gradient), 0, 2)
               .title("Shortcut input derivative"));
  std::filesystem::create_directories("build");
  layout.size(1100, 920).fit_panels().save_svg("build/resnet_basic_shortcuts.svg");
  std::print(
      "Identity fixture exactly equals ReLU(x), with derivative 1 on positive entries and 0 "
      "on negative entries.\nStride-two projection gives a 3x3x4 map; value/gradient error "
      "versus tensor subsampling and channel duplication {:.12f}.\n",
      error);
}
```
// result_begin: markdown
Identity fixture exactly equals ReLU(x), with derivative 1 on positive entries and 0 on negative entries.
Stride-two projection gives a 3x3x4 map; value/gradient error versus tensor subsampling and channel duplication 0.000000000000.
\image(figures/resnet_basic_shortcuts.svg)
// result_end
\caption(Zero final BN gamma removes the residual branch. The controlled projection copies two input channels into four outputs at rows/columns 0,2,4. Thus positive sampled inputs have derivative two; unsampled or negative inputs have derivative zero.)
\alttext(Zero final BN gamma removes the residual branch. The controlled projection copies two input channels into four outputs at rows/columns 0,2,4. Thus positive sampled inputs have derivative two; unsampled or negative inputs have derivative zero.)

> Checking full topology

Full-width forward checks and complete compact backward checks have separate purposes and resource budgets.

```{cpp, results="markdown", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

int main() {
  namespace n = dm::nn;
  n::set_num_threads(2);
  const std::vector<std::tuple<int, int64_t, int64_t>> settings{{18, 11689512, 9600},
                                                                {34, 21797672, 17024}};
  for (auto [depth, expected_count, expected_state] : settings) {
    n::NoGradGuard guard;
    n::ParameterStore p(17), state(17);
    n::models::ResNetConfig cfg;
    cfg.depth = depth;
    const auto out = n::models::ResNet(p, state, n::zeros({1, 224, 224, 3}), cfg);
    const bool bottleneck = depth >= 50;
    if (p.count() != expected_count || state.count() != expected_state ||
        out.stem.shape() != n::Shape{1, 56, 56, 64} || out.logits.shape() != n::Shape{1, 1000})
      return 1;
    for (int i = 0; i < 4; ++i) {
      const int64_t side = 56 / (1 << i), channels = (64 << i) * (bottleneck ? 4 : 1);
      if (out.stages[i].shape() != n::Shape{1, side, side, channels})
        return 1;
    }
    if ((bottleneck ? 3 : 2) * int(out.blocks.size()) + 2 != depth)
      return 1;
    std::print("Full ResNet-{}: {} learned scalars, {} moving scalars; {} blocks and all "
               "stage shapes verified.\n",
               depth, p.count(), state.count(), out.blocks.size());
  }
  for (auto [depth, expected_count, expected_state] : settings) {
    n::ParameterStore p(17), state(17);
    n::Generator rng(29);
    n::models::ResNetConfig cfg;
    cfg.depth = depth;
    cfg.classes = 3;
    cfg.width_divisor = 8;
    cfg.small_stem = true;
    cfg.update_stats = false;
    const auto x = n::normal({2, 32, 32, 3}, 0, .2, rng);
    const auto out = n::models::ResNet(p, state, x, cfg, true);
    const auto saved = state.flatten();
    const auto gradients = n::grad(n::mean(n::square(out.logits)), p.parameters());
    for (const auto &g : gradients)
      if (!std::isfinite(n::sum(n::abs(g)).item()))
        return 1;
    n::NoGradGuard guard;
    n::models::ResNet(p, state, x, cfg, false);
    if (state.flatten() != saved)
      return 1;
    std::print("Compact ResNet-{}: every one of {} parameter-tensor gradients is finite; "
               "inference leaves moving state unchanged.\n",
               depth, gradients.size());
  }
}
```
// result_begin: markdown
Full ResNet-18: 11689512 learned scalars, 9600 moving scalars; 8 blocks and all stage shapes verified.
Full ResNet-34: 21797672 learned scalars, 17024 moving scalars; 16 blocks and all stage shapes verified.
Compact ResNet-18: every one of 62 parameter-tensor gradients is finite; inference leaves moving state unchanged.
Compact ResNet-34: every one of 110 parameter-tensor gradients is finite; inference leaves moving state unchanged.
