> Complete topology and budgets

Full forward counts and compact full-depth backward checks establish separate claims.

```{cpp, results="markdown", file="figures/resnext_budget.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

int main() {
  namespace n = dm::nn;
  n::set_num_threads(2);
  {
    n::NoGradGuard guard;
    n::ParameterStore p(17), state(17);
    const auto out = n::models::ResNeXt(p, state, n::zeros({1, 224, 224, 3}));
    if (p.count() != 25028904 || state.count() != 68224 || out.blocks.size() != 16 ||
        out.stages.size() != 4 || out.stem.shape() != n::Shape{1, 56, 56, 64} ||
        out.logits.shape() != n::Shape{1, 1000})
      return 1;
    for (int i = 0; i < 4; ++i)
      if (out.stages[i].shape() != n::Shape{1, 56 / (1 << i), 56 / (1 << i), 256 << i})
        return 1;
    std::print("Full ResNeXt-50 32x4d: {} learned / {} moving scalars; all 224-pixel stage "
               "shapes verified.\n",
               p.count(), state.count());
  }
  n::ParameterStore p(17), state(17);
  n::Generator rng(29);
  n::models::ResNeXtConfig cfg;
  cfg.cifar_layout = true;
  cfg.depth = 29;
  cfg.cardinality = 8;
  cfg.base_width = 16;
  cfg.stage_width = 16;
  cfg.classes = 10;
  cfg.update_stats = false;
  const auto out =
      n::models::ResNeXt(p, state, n::normal({2, 16, 16, 3}, 0, .2, rng), cfg, true);
  if (p.count() != 359898 || state.count() != 6304 || out.blocks.size() != 9)
    return 1;
  for (const auto &g : n::grad(n::mean(n::square(out.logits)), p.parameters()))
    if (!std::isfinite(n::sum(n::abs(g)).item()))
      return 1;
  std::vector<double> c = {1, 2, 4, 8, 16, 32}, budget;
  for (double groups : c) {
    const double d = 64 / groups;
    budget.push_back(2 * 256 * groups * d + 9 * groups * d * d);
  }
  auto plot = dm::graphics::RPlot::create();
  plot.lines(c, budget, "fixed middle width 64", {37, 99, 235})
      .title("Grouped kernels at fixed middle width")
      .x_label("cardinality")
      .y_label("branch kernel scalars")
      .y_limits(0, 85000);
  std::filesystem::create_directories("build");
  dm::graphics::RLayout::create(1, 1).add(plot).size(850, 460).fit_panels().save_svg(
      "build/resnext_budget.svg");
  std::print("Complete compact 29-layer model: {} learned / {} moving scalars; nine blocks "
             "and all parameter gradients finite.\nAt 256 input/output channels, 1x64d costs "
             "69632 branch kernels; 32x4d costs 70144. BN/projections excluded.\n",
             p.count(), state.count());
}
```
