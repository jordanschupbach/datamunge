> Complete geometry and arithmetic

Full configurations retain the released stage topology.

```{cpp, results="markdown", file="figures/wide_resnet_budget.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

int64_t macs(int depth, int k) {
  int64_t total = 32 * 32 * 9 * 3 * 16, in = 16, side = 32;
  for (int s = 0; s < 3; ++s) {
    const int64_t out = (16 << s) * k;
    if (s)
      side /= 2;
    for (int b = 0; b < (depth - 4) / 6; ++b) {
      total += side * side * (9 * in * out + 9 * out * out + (in != out ? in * out : 0));
      in = out;
    }
  }
  return total + in * 10;
}
int main() {
  namespace n = dm::nn;
  n::set_num_threads(2);
  std::vector<double> width, parameters, work;
  for (auto [depth, k, count, moving] : std::vector<std::tuple<int, int, int64_t, int64_t>>{
           {16, 1, 175066, 928}, {16, 2, 691674, 1824}, {28, 10, 36479194, 17952}}) {
    n::NoGradGuard guard;
    n::ParameterStore p(17), state(17);
    n::Generator gen(17);
    n::models::WideResNetConfig cfg;
    cfg.depth = depth;
    cfg.widen_factor = k;
    cfg.dropout = 0;
    const auto out =
        n::models::WideResNet(p, state, n::zeros({1, 32, 32, 3}), cfg, false, gen);
    if (p.count() != count || state.count() != moving ||
        out.stem.shape() != n::Shape{1, 32, 32, 16} || out.logits.shape() != n::Shape{1, 10} ||
        out.blocks.size() != size_t((depth - 4) / 2))
      return 1;
    for (int i = 0; i < 3; ++i)
      if (out.stages[i].shape() != n::Shape{1, 32 / (1 << i), 32 / (1 << i), (16 << i) * k})
        return 1;
    std::print("WRN-{}-{}: {} learned / {} moving scalars; {} convolution/classifier MACs per "
               "32x32 image; all stage shapes verified.\n",
               depth, k, count, moving, macs(depth, k));
  }
  for (int k : {1, 2}) {
    n::ParameterStore p(17), state(17);
    n::Generator gen(17), rng(29);
    n::models::WideResNetConfig cfg;
    cfg.depth = 16;
    cfg.widen_factor = k;
    cfg.update_stats = false;
    const auto out =
        n::models::WideResNet(p, state, n::normal({2, 16, 16, 3}, 0, .2, rng), cfg, true, gen);
    for (const auto &g : n::grad(n::mean(n::square(out.logits)), p.parameters()))
      if (!std::isfinite(n::sum(n::abs(g)).item()))
        return 1;
  }
  for (int k = 1; k <= 10; ++k) {
    width.push_back(k);
    work.push_back(double(macs(16, k)) / 1e6);
    n::NoGradGuard guard;
    n::ParameterStore p(17), state(17);
    n::Generator gen(17);
    n::models::WideResNetConfig cfg;
    cfg.depth = 16;
    cfg.widen_factor = k;
    n::models::WideResNet(p, state, n::zeros({1, 8, 8, 3}), cfg, false, gen);
    parameters.push_back(double(p.count()) / 1e6);
  }
  auto count = dm::graphics::RPlot::create(), ops = dm::graphics::RPlot::create();
  count.lines(width, parameters, "learned", {37, 99, 235})
      .title("WRN-16 parameter growth")
      .x_label("widening k")
      .y_label("million learned scalars")
      .y_limits(0, 20);
  ops.lines(width, work, "convolution + classifier", {234, 88, 12})
      .title("WRN-16 arithmetic at 32 pixels")
      .x_label("widening k")
      .y_label("million MACs/image")
      .y_limits(0, 3000);
  std::filesystem::create_directories("build");
  dm::graphics::RLayout::create(1, 2)
      .add(count)
      .add(ops)
      .size(1100, 470)
      .fit_panels()
      .save_svg("build/wide_resnet_budget.svg");
  std::print(
      "Complete WRN-16-1 and WRN-16-2 backward graphs: every parameter gradient finite. MACs "
      "exclude BN, activations, additions and pooling; no latency is measured.\n");
}
```
