> Simple dropout and identity example

Mask scaling, fresh samples and deterministic inference are checked explicitly.

```{cpp, results="markdown", file="figures/wide_resnet_dropout.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

int main() {
  namespace n = dm::nn;
  n::set_num_threads(2);
  n::ParameterStore p(17), state(17);
  n::Generator gen(17);
  const auto x = n::sin(.17 * n::arange(0, 2048).to(n::DType::Float32))
                     .reshape({8, 8, 8, 4})
                     .detach()
                     .requires_grad_();
  const n::models::PreactivationNormConfig train{true, false, .9, 1e-5},
      infer{false, false, .9, 1e-5};
  auto block = [&](const auto &norm, double rate) {
    return n::models::WideBasicBlock(p, state, "b", x, 4, 1, norm, rate, gen);
  };
  const auto first = block(train, .3);
  const auto before = first.before_dropout.to_vector<float>(),
             after = first.after_dropout.to_vector<float>();
  const auto dx =
      n::grad(n::sum(first.after_dropout), {first.before_dropout})[0].to_vector<float>();
  int positive = 0, removed = 0;
  for (size_t i = 0; i < before.size(); ++i) {
    const bool dropped = after[i] == 0;
    if (before[i] > 1e-6) {
      ++positive;
      removed += dropped;
      if (std::abs(after[i] - (dropped ? 0 : before[i] / .7)) > 2e-6 ||
          std::abs(dx[i] - (dropped ? 0 : 1 / .7)) > 2e-6)
        return 1;
    }
  }
  const auto repeated = block(train, .3);
  if (n::sum(n::abs(repeated.after_dropout - first.after_dropout)).item() < 1)
    return 1;
  const auto prediction = block(infer, .3).output;
  if (n::max(n::abs(prediction - block(infer, 0).output)).item() != 0 ||
      n::max(n::abs(prediction - block(infer, .3).output)).item() != 0)
    return 1;
  if (positive < 500 || std::abs(double(removed) / positive - .3) > .06)
    return 1;
  p.set("b/conv2/W", n::zeros_like(p.at("b/conv2/W")));
  const auto identity = block(train, .3);
  if (n::max(n::abs(identity.output - x)).item() != 0 ||
      n::max(n::abs(n::grad(n::sum(identity.output), {x})[0] - 1)).item() != 0)
    return 1;
  auto first_channel = [](const auto &t) {
    return n::slice_axis(n::slice_axis(t, 0, 0, 1), 3, 0, 1).reshape({8, 8});
  };
  const double hi = n::max(first.before_dropout).item() / .7;
  auto layout = dm::graphics::RLayout::create(2, 2);
  layout
      .add(n::plot_tensor_map(first_channel(first.before_dropout), 0, hi)
               .title("Second preactivation, before dropout"))
      .add(n::plot_tensor_map(first_channel(first.after_dropout), 0, hi)
               .title("Branch-only inverted dropout, p=.3"))
      .add(n::plot_tensor_map(first_channel(x), -1, 1).title("Signed raw shortcut input"))
      .add(n::plot_tensor_map(first_channel(identity.output), -1, 1)
               .title("Zero branch: exact signed identity"));
  std::filesystem::create_directories("build");
  layout.size(1100, 920).fit_panels().save_svg("build/wide_resnet_dropout.svg");
  std::print("{} positive preactivations: removed fraction {:.6f}. Retained "
             "values/derivatives scale by 1/.7, training masks change, inference repeats, and "
             "zero residual gives exact identity values/derivatives.\n",
             positive, double(removed) / positive);
}
```
