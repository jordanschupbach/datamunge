> Checking full topology

Full reference counts and stage dimensions use a zero-input inference pass without backward storage. Separate compact graphs verify finite derivatives through every learned tensor with complete depth.

```{cpp, results="markdown", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

int main() {
  namespace n = dm::nn;
  n::set_num_threads(2);
  const std::vector<std::tuple<int, int64_t, int64_t>> settings{
      {50, 25557032, 53120}, {101, 44549160, 105344}, {152, 60192808, 151424}};
  for (auto [depth, expected_count, expected_state] : settings) {
    n::NoGradGuard guard;
    n::ParameterStore p(17), state(17);
    n::models::ResNetConfig cfg;
    cfg.depth = depth;
    const auto out = n::models::ResNet(p, state, n::zeros({1, 224, 224, 3}), cfg);
    const bool bottleneck = depth >= 50;
    if (p.count() != expected_count || state.count() != expected_state ||
        out.stem.shape() != n::Shape{1, 56, 56, 64} || out.logits.shape() != n::Shape{1, 1000})
      return 1;
    for (int i = 0; i < 4; ++i) {
      const int64_t side = 56 / (1 << i), channels = (64 << i) * (bottleneck ? 4 : 1);
      if (out.stages[i].shape() != n::Shape{1, side, side, channels})
        return 1;
    }
    if ((bottleneck ? 3 : 2) * int(out.blocks.size()) + 2 != depth)
      return 1;
    std::print("Full ResNet-{}: {} learned scalars, {} moving scalars; {} blocks and all "
               "stage shapes verified.\n",
               depth, p.count(), state.count(), out.blocks.size());
  }
  for (auto [depth, expected_count, expected_state] : settings) {
    n::ParameterStore p(17), state(17);
    n::Generator rng(29);
    n::models::ResNetConfig cfg;
    cfg.depth = depth;
    cfg.classes = 3;
    cfg.width_divisor = 8;
    cfg.small_stem = true;
    cfg.update_stats = false;
    const auto x = n::normal({2, 32, 32, 3}, 0, .2, rng);
    const auto out = n::models::ResNet(p, state, x, cfg, true);
    const auto saved = state.flatten();
    const auto gradients = n::grad(n::mean(n::square(out.logits)), p.parameters());
    for (const auto &g : gradients)
      if (!std::isfinite(n::sum(n::abs(g)).item()))
        return 1;
    n::NoGradGuard guard;
    n::models::ResNet(p, state, x, cfg, false);
    if (state.flatten() != saved)
      return 1;
    std::print("Compact ResNet-{}: every one of {} parameter-tensor gradients is finite; "
               "inference leaves moving state unchanged.\n",
               depth, gradients.size());
  }
}
```
// result_begin: markdown
Full ResNet-50: 25557032 learned scalars, 53120 moving scalars; 16 blocks and all stage shapes verified.
Full ResNet-101: 44549160 learned scalars, 105344 moving scalars; 33 blocks and all stage shapes verified.
Full ResNet-152: 60192808 learned scalars, 151424 moving scalars; 50 blocks and all stage shapes verified.
Compact ResNet-50: every one of 161 parameter-tensor gradients is finite; inference leaves moving state unchanged.
Compact ResNet-101: every one of 314 parameter-tensor gradients is finite; inference leaves moving state unchanged.
