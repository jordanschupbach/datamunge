> Simple sampling example

A one-pixel input and shared all-one branch filters make the stride-placement difference hand-checkable.

```{cpp, results="markdown", file="figures/resnet_bottleneck_stride.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

int main() {
  namespace n = dm::nn;
  const auto type = n::DType::Float64;
  n::ParameterStore p(17, type), state(17, type);
  n::models::ResNetNormConfig cfg;
  cfg.scale = true;
  cfg.epsilon = 1e-5;
  const auto x =
      n::one_hot(n::tensor({48}).to(n::DType::Int64), 200, 1, 0, type).reshape({1, 5, 5, 8});
  {
    n::NoGradGuard guard;
    n::models::ResNetBlock(p, state, "b", x, 2, cfg, 2, true);
  }
  for (const auto &name : p.names()) {
    const auto shape = p.at(name).shape();
    if (name.ends_with("/W"))
      p.set(name,
            name.starts_with("b/shortcut") ? n::zeros(shape, type) : n::ones(shape, type));
    if (name.ends_with("/gamma"))
      p.set(name, n::full(shape, std::sqrt(1 + cfg.epsilon), type));
  }
  const auto early = n::models::ResNetBlock(p, state, "b", x, 2, cfg, 2, true, false);
  const auto later = n::models::ResNetBlock(p, state, "b", x, 2, cfg, 2, true, true);
  if (n::max(early.output).item() != 0 || std::abs(n::max(later.output).item() - 4) > 1e-12 ||
      std::abs(n::sum(later.output).item() - 128) > 1e-10)
    return 1;
  if (p.at("b/conv1/W").shape() != n::Shape{1, 1, 8, 2} ||
      p.at("b/conv3/W").shape() != n::Shape{1, 1, 2, 8})
    return 1;
  auto first_channel = [](const n::Tensor &t) {
    return n::slice_axis(t, 3, 0, 1).reshape({3, 3});
  };
  auto layout = dm::graphics::RLayout::create(1, 2);
  layout
      .add(n::plot_tensor_map(first_channel(early.output), 0, 4)
               .title("Stride in 1x1: impulse missed"))
      .add(n::plot_tensor_map(first_channel(later.output), 0, 4)
               .title("Stride in 3x3: impulse retained"));
  std::filesystem::create_directories("build");
  layout.size(1100, 470).fit_panels().save_svg("build/resnet_bottleneck_stride.svg");
  std::print(
      "Width-two bottleneck: 8 -> 2 -> 2 -> 8 channels, kernels contain 8*2+9*2*2+2*8=68 "
      "weights.\nStride in 1x1 gives zero; stride in 3x3 gives four on a 2x2 patch in each of "
      "eight output channels, total 128. Shortcut is zeroed only for this fixture.\n");
}
```
