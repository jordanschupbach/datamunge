> Simple inverse example

The fixture changes the input nontrivially before reconstructing it in both BN modes.

```{cpp, results="markdown", file="figures/revnet_inverse.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

int main() {
  namespace n = dm::nn;
  const auto type = n::DType::Float64;
  auto layout = dm::graphics::RLayout::create(2, 2);
  for (bool bottle : {false, true})
    for (bool training : {false, true}) {
      n::ParameterStore p(1, type), state(1, type);
      const n::models::RevContext c{p, state, training, .9, bottle, false};
      const auto value = n::sin(.37 * n::arange(0, 800).to(type) + .2).reshape({4, 5, 5, 8});
      const auto halves = n::split(value, 2, 3);
      const n::models::RevPair x{halves[0], halves[1]};
      {
        n::NoGradGuard guard;
        n::models::RevBlockForward(c, "u", x, 8, 8, 1, false);
        for (const auto &name : state.names()) {
          auto v = .3 * n::sin(.37 * n::arange(0, state.at(name).numel()).to(type) +
                               double(name.size()));
          if (name.find("moving_var") != std::string::npos)
            v = v + .8;
          state.set(name, v);
        }
      }
      n::NoGradGuard guard;
      const auto y = n::models::RevBlockForward(c, "u", x, 8, 8, 1, false);
      const auto recovered = n::models::RevBlockInverse(c, "u", y, 8);
      const auto restored = n::concat({recovered.first, recovered.second}, 3);
      const double error = n::max(n::abs(restored - value)).item(),
                   change = n::max(n::abs(y.first - x.first)).item();
      if (error > 1e-11 || change < .01)
        return 1;
      std::print(
          "{} / {} BN: changed input by {:.6f}, inversion max absolute error {:.12f}.\n",
          bottle ? "bottleneck" : "basic", training ? "training" : "inference", change, error);
      if (!bottle && !training) {
        auto channel = [](const auto &t) {
          return n::slice_axis(n::slice_axis(t, 0, 0, 1), 3, 0, 1).reshape({5, 5});
        };
        const auto output = n::concat({y.first, y.second}, 3);
        const double low = std::min(n::min(value).item(), n::min(output).item()),
                     high = std::max(n::max(value).item(), n::max(output).item());
        layout
            .add(n::plot_tensor_map(channel(value), low, high)
                     .title("Input half: first channel"))
            .add(n::plot_tensor_map(channel(output), low, high)
                     .title("Nontrivial additive coupling"))
            .add(n::plot_tensor_map(channel(restored), low, high).title("Reconstructed input"))
            .add(n::plot_tensor_map(channel(n::abs(restored - value)), 0,
                                    std::max(error, 1e-15))
                     .title("Absolute roundoff error, auto range"));
      }
    }
  std::filesystem::create_directories("build");
  layout.size(1100, 920).fit_panels().save_svg("build/revnet_inverse.svg");
}
```
