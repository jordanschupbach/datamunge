> Measuring live tensor memory

The warmed baseline and counted buffers are explicit.

```{cpp, results="markdown", file="figures/revnet_memory.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

#include <datamunge/nn/memory.hpp>
double peak(const dm::nn::models::RevNetConfig &cfg, dm::nn::models::RevNetMode mode) {
  namespace n = dm::nn;
  n::ParameterStore p(17), state(17);
  const auto x = n::sin(.37 * n::arange(0, 16 * 32 * 32 * 3).to(n::DType::Float32))
                     .reshape({16, 32, 32, 3});
  const auto labels = n::arange(0, 16).to(n::DType::Int64);
  const auto target = labels - 10 * n::cast(n::greater_equal(labels, 10), n::DType::Int64);
  auto step = [&]() {
    const auto out = n::models::RevNet(p, state, x, cfg, true, mode, false);
    return n::grad(n::sparse_softmax_cross_entropy(out.logits, target), p.parameters());
  };
  step();
  n::PeakMemoryScope scope;
  step();
  return scope.peak_above_baseline() / 1048576.;
}
int main() {
  namespace n = dm::nn;
  using Mode = n::models::RevNetMode;
  n::set_num_threads(2);
  std::vector<double> units, ordinary, reversible, stored, ratio;
  for (int count : {3, 9, 18}) {
    auto cfg = n::models::RevNetConfig::Cifar(38);
    cfg.units = {count, count, count};
    units.push_back(count);
    ordinary.push_back(peak(cfg, Mode::Ordinary));
    reversible.push_back(peak(cfg, Mode::Reversible));
    stored.push_back(peak(cfg, Mode::StoredUnits));
    ratio.push_back(ordinary.back() / reversible.back());
    if (ordinary.back() <= 0 || reversible.back() <= 0 || stored.back() <= 0)
      return 1;
    std::print("{} units/stage, batch 16 at 32 pixels: ordinary {:.3f} MiB, reversible {:.3f} "
               "MiB, stored-input {:.3f} MiB, ordinary/reversible {:.3f}.\n",
               count, ordinary.back(), reversible.back(), stored.back(), ratio.back());
  }
  auto bytes = dm::graphics::RPlot::create(), saving = dm::graphics::RPlot::create();
  bytes.lines(units, ordinary, "ordinary", {37, 99, 235})
      .lines(units, reversible, "reversible", {234, 88, 12})
      .lines(units, stored, "stored inputs", {22, 163, 74})
      .title("Measured live tensor peak above baseline")
      .x_label("units per stage")
      .y_label("MiB above warmed baseline");
  bytes.y_limits(0, 1.4 * (*std::max_element(ordinary.begin(), ordinary.end())));
  saving.lines(units, ratio, "ordinary / reversible", {147, 51, 234})
      .title("Measured peak-memory ratio")
      .x_label("units per stage")
      .y_label("ordinary / reversible")
      .y_limits(0, 1.4 * (*std::max_element(ratio.begin(), ratio.end())));
  std::filesystem::create_directories("build");
  dm::graphics::RLayout::create(1, 2)
      .add(bytes)
      .add(saving)
      .size(1100, 470)
      .fit_panels()
      .save_svg("build/revnet_memory.svg");
}
```
