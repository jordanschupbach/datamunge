> Complete presets and gradient comparison

Every learned tensor is compared with ordinary backpropagation, with reconstruction drift reported separately.

```{cpp, results="markdown", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

double relative(const dm::nn::Tensor &a, const dm::nn::Tensor &b) {
  namespace n = dm::nn;
  return std::sqrt(n::sum(n::square(a - b)).item() /
                   std::max(n::sum(n::square(b)).item(), 1e-30));
}
int main() {
  namespace n = dm::nn;
  using Mode = n::models::RevNetMode;
  n::set_num_threads(2);
  for (auto [large, depth, count, moving] :
       std::vector<std::tuple<bool, int, int64_t, int64_t>>{{false, 38, 464890, 2672},
                                                            {false, 110, 1729194, 8256},
                                                            {false, 164, 1748778, 24768},
                                                            {true, 56, 27553128, 51200},
                                                            {true, 104, 45428072, 100352}}) {
    n::NoGradGuard guard;
    n::ParameterStore p(17), state(17);
    const auto cfg = large ? n::models::RevNetConfig::ImageNet(depth)
                           : n::models::RevNetConfig::Cifar(depth);
    const int side = large ? 64 : 32;
    const auto out = n::models::RevNet(p, state, n::zeros({1, side, side, 3}), cfg);
    int stored = 0;
    for (const auto &u : out.units)
      stored += u.stored;
    if (p.count() != count || state.count() != moving || stored != int(cfg.units.size()) ||
        out.logits.shape() != n::Shape{1, cfg.classes})
      return 1;
    std::print(
        "{} RevNet-{}: {} learned / {} moving scalars, {} units, {} stored stage entries.\n",
        large ? "ImageNet" : "CIFAR", depth, count, moving, out.units.size(), stored);
  }
  for (int depth : {38, 164}) {
    n::ParameterStore p(17), state(17);
    const auto cfg = n::models::RevNetConfig::Cifar(depth);
    const auto x = n::sin(.37 * n::arange(0, 8 * 32 * 32 * 3).to(n::DType::Float32) + .5)
                       .reshape({8, 32, 32, 3});
    const auto labels = n::from_vector(std::vector<int64_t>{3, 0, 7, 4, 1, 8, 5, 2});
    const auto ordinary = n::models::RevNet(p, state, x, cfg, true, Mode::Ordinary, false);
    const auto expected =
        n::grad(n::sparse_softmax_cross_entropy(ordinary.logits, labels), p.parameters());
    double stored_error = 0, reversible_error = 0, drift = 0;
    for (Mode mode : {Mode::StoredUnits, Mode::Reversible}) {
      const auto out = n::models::RevNet(p, state, x, cfg, true, mode, false);
      if (relative(out.logits, ordinary.logits) > 1e-6)
        return 1;
      const auto gradients =
          n::grad(n::sparse_softmax_cross_entropy(out.logits, labels), p.parameters());
      for (size_t i = 0; i < gradients.size(); ++i) {
        if (!std::isfinite(n::sum(n::abs(gradients[i])).item()))
          return 1;
        auto &error = mode == Mode::StoredUnits ? stored_error : reversible_error;
        error = std::max(error, relative(gradients[i], expected[i]));
      }
    }
    {
      n::NoGradGuard guard;
      const n::models::RevContext c{p, state, true, cfg.momentum, cfg.bottleneck, false};
      auto y = ordinary.units.back().output;
      for (size_t i = ordinary.units.size(); i-- > 0;) {
        const auto &u = ordinary.units[i];
        if (u.stored) {
          y = u.input;
          continue;
        }
        y = n::models::RevBlockInverse(c, u.name, y, u.out);
        drift = std::max(drift, relative(n::concat({y.first, y.second}, 3),
                                         n::concat({u.input.first, u.input.second}, 3)));
      }
    }
    if (stored_error > 1e-6 || reversible_error > .05 || drift > 1e-4)
      return 1;
    std::print("RevNet-{}: {} parameter derivatives; stored-input relative error {:.9f}; "
               "reconstructed-input relative error {:.9f}; max reconstruction relative drift "
               "{:.9f}.\n",
               depth, expected.size(), stored_error, reversible_error, drift);
  }
}
```
