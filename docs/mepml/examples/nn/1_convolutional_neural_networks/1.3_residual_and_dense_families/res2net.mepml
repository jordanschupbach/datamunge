> Simple internal-scale example

The controlled positive fixture avoids ReLU boundaries and exposes exact spatial supports.

```{cpp, results="markdown", file="figures/res2net_scales.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

int main() {
  namespace n = dm::nn;
  const auto type = n::DType::Float64;
  auto layout = dm::graphics::RLayout::create(2, 2);
  for (auto [scale, stage, stride] : std::vector<std::tuple<int, bool, int>>{
           {4, false, 1}, {4, true, 1}, {4, true, 2}, {1, false, 1}}) {
    n::ParameterStore p(17, type), state(17, type);
    n::models::ResNetNormConfig cfg;
    cfg.scale = true;
    cfg.epsilon = 1e-5;
    const auto x = (n::ones({1, 11, 11, scale}, type) * n::arange(1, scale + 1).to(type))
                       .detach()
                       .requires_grad_();
    const int processed = scale == 1 ? 1 : scale - 1, side = (11 + stride - 1) / stride;
    {
      n::NoGradGuard guard;
      n::models::Res2ScaleTransform(p, state, "s", x, 1, scale, cfg, stage, stride);
    }
    for (int i = 0; i < processed; ++i) {
      const std::string name = "s/group" + std::to_string(i);
      p.set(name + "/W", n::full({3, 3, 1, 1}, 1. / 9, type));
      p.set(name + "/bn/gamma", n::full({1}, std::sqrt(1.00001), type));
    }
    const auto out =
        n::models::Res2ScaleTransform(p, state, "s", x, 1, scale, cfg, stage, stride);
    if (out.mixed.shape() != n::Shape{1, side, side, scale})
      return 1;
    // Independent scalar spatial recurrence, used only as a numerical oracle.
    std::vector<std::vector<double>> reference(scale, std::vector<double>(side * side));
    double error = 0;
    for (int g = 0; g < scale; ++g)
      for (int r = 0; r < side; ++r)
        for (int c = 0; c < side; ++c) {
          double value = 0;
          const bool bypass = scale > 1 && g == scale - 1;
          if (bypass && !stage)
            value = g + 1;
          else
            for (int dr = -1; dr <= 1; ++dr)
              for (int dc = -1; dc <= 1; ++dc) {
                const int ir = r * stride + dr, ic = c * stride + dc;
                if (ir < 0 || ir >= 11 || ic < 0 || ic >= 11)
                  continue;
                value += (g + 1 + (!stage && g > 0 ? reference[g - 1][ir * 11 + ic] : 0)) / 9.;
              }
          reference[g][r * side + c] = value;
          error = std::max(error, std::abs(out.mixed.at({0, r, c, g}) - value));
        }
    if (error > 1e-12)
      return 1;
    for (int g = 0; g < scale; ++g) {
      const auto centre = n::slice(out.groups[g], {0, side / 2, side / 2, 0}, {1, 1, 1, 1});
      const auto dx = n::grad(n::sum(centre), {x}, {.retain_graph = true})[0];
      for (int ch = 0; ch < scale; ++ch) {
        const auto map = n::slice_axis(dx, 3, ch, ch + 1).reshape({11, 11});
        int diameter = 0;
        if (stage || scale == 1)
          diameter = ch == g ? 3 : 0;
        else if (g == scale - 1)
          diameter = ch == g ? 1 : 0;
        else if (ch <= g)
          diameter = 2 * (g - ch + 1) + 1;
        const double support = n::sum(n::greater(n::abs(map), 1e-12).to(type)).item(),
                     mass = n::sum(map).item();
        if (support != diameter * diameter || std::abs(mass - (diameter ? 1 : 0)) > 1e-12)
          return 1;
        if (scale == 4 && !stage && ch == (g == 3 ? 3 : 0))
          layout.add(n::plot_tensor_map(n::greater(n::abs(map), 1e-12).to(type), 0, 1).title(
              "Split " + std::to_string(g) + ": support " + std::to_string(diameter) + "x" +
              std::to_string(diameter)));
      }
    }
    std::print("scale {}, stage {}, stride {}: scalar recurrence max error {:.12f}; every "
               "centre-output/channel derivative support and mass verified.\n",
               scale, stage, stride, error);
    if (scale == 4 && stage && std::abs(out.groups.back().at({0, 0, 0, 0}) - 16. / 9) > 1e-12)
      return 1;
  }
  std::filesystem::create_directories("build");
  layout.size(1100, 920).fit_panels().save_svg("build/res2net_scales.svg");
}
```
