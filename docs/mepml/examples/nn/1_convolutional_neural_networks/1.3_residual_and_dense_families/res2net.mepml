\alttext(Ordinary four-split centre derivatives have 3x3, 5x5 and 7x7 support with respect to input split zero; the last split has a direct 1x1 path from itself. Stage-entry groups instead remain independent, including at stride one. Binary support maps use one for a nonzero derivative and zero elsewhere; colour range is [0,1].)

> Complete model checks

Full ImageNet count/geometry and compact complete backward graphs are verified separately.

```{cpp, results="markdown", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

int main() {
  namespace n = dm::nn;
  n::set_num_threads(2);
  {
    n::NoGradGuard guard;
    n::ParameterStore p(17), state(17);
    const auto out = n::models::Res2Net(p, state, n::zeros({1, 224, 224, 3}));
    if (p.count() != 25699120 || state.count() != 59492 || out.blocks.size() != 16 ||
        out.stem.shape() != n::Shape{1, 56, 56, 64} || out.logits.shape() != n::Shape{1, 1000})
      return 1;
    for (int i = 0; i < 4; ++i)
      if (out.stages[i].shape() != n::Shape{1, 56 / (1 << i), 56 / (1 << i), 256 << i})
        return 1;
    std::print("Full Res2Net-50 26w/4s: {} learned / {} moving scalars; 16 blocks and all "
               "224-pixel stages verified.\n",
               p.count(), state.count());
  }
  n::ParameterStore p(17), state(17);
  n::Generator rng(29);
  n::models::Res2NetConfig cfg;
  cfg.stage_width = 16;
  cfg.small_stem = true;
  cfg.classes = 10;
  cfg.update_stats = false;
  const auto out =
      n::models::Res2Net(p, state, n::normal({2, 16, 16, 3}, 0, .2, rng), cfg, true);
  if (p.count() != 1493062 || state.count() != 14852 || out.blocks.size() != 16)
    return 1;
  const auto gradients = n::grad(n::mean(n::square(out.logits)), p.parameters());
  for (const auto &g : gradients)
    if (!std::isfinite(n::sum(n::abs(g)).item()))
      return 1;
  std::print(
      "Compact complete Res2Net-50: {} learned / {} moving scalars; {} finite "
      "parameter-tensor gradients. Stage split widths 6/13/26/52 use floor(planes*26/64).\n",
      p.count(), state.count(), gradients.size());
}
```
// result_begin: markdown
Full Res2Net-50 26w/4s: 25699120 learned / 59492 moving scalars; 16 blocks and all 224-pixel stages verified.
Compact complete Res2Net-50: 1493062 learned / 14852 moving scalars; 257 finite parameter-tensor gradients. Stage split widths 6/13/26/52 use floor(planes*26/64).
