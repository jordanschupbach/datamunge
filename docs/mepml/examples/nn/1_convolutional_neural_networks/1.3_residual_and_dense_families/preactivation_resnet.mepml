Projection consumes the first BN/ReLU, not raw input: value error 0.000000000000.
Nonzero branch centre-input derivative: autograd 1.287995680, finite difference 1.287995680; includes the identity contribution.
// result_end

> Checking complete topology

Full-width forward counts/shapes and full-depth compact gradients establish separate claims.

```{cpp, results="markdown", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

int main() {
  namespace n = dm::nn;
  n::set_num_threads(2);
  for (auto [depth, count, moving] : std::vector<std::tuple<int, int64_t, int64_t>>{
           {164, 1703258, 24224}, {1001, 10327706, 149216}}) {
    n::NoGradGuard guard;
    n::ParameterStore p(17), state(17);
    n::models::PreActResNetConfig cfg;
    cfg.depth = depth;
    const auto out = n::models::PreActResNet(p, state, n::zeros({1, 32, 32, 3}), cfg);
    if (p.count() != count || state.count() != moving ||
        out.stem.shape() != n::Shape{1, 32, 32, 16} || out.logits.shape() != n::Shape{1, 10} ||
        3 * int(out.blocks.size()) + 2 != depth)
      return 1;
    for (int i = 0; i < 3; ++i)
      if (out.stages[i].shape() != n::Shape{1, 32 / (1 << i), 32 / (1 << i), 64 << i})
        return 1;
    std::print("Full pre-activation ResNet-{}: {} learned scalars, {} moving scalars; {} "
               "complete bottleneck blocks and all stage shapes verified.\n",
               depth, count, moving, out.blocks.size());
  }
  for (int depth : {164, 1001}) {
    n::ParameterStore p(17), state(17);
    n::Generator rng(29);
    n::models::PreActResNetConfig cfg;
    cfg.depth = depth;
    cfg.base_width = 4;
    cfg.update_stats = false;
    const auto x = n::normal({2, 16, 16, 3}, 0, .2, rng);
    const auto out = n::models::PreActResNet(p, state, x, cfg, true);
    const auto gradients = n::grad(n::mean(n::square(out.logits)), p.parameters());
    for (const auto &g : gradients)
      if (!std::isfinite(n::sum(n::abs(g)).item()))
        return 1;
    const auto saved = state.flatten();
    n::NoGradGuard guard;
    n::models::PreActResNet(p, state, x, cfg);
    if (state.flatten() != saved)
      return 1;
    std::print("Compact depth {} keeps all blocks: {} finite parameter-tensor gradients; "
               "inference leaves moving state unchanged.\n",
               depth, gradients.size());
  }
}
```
// result_begin: markdown
Full pre-activation ResNet-164: 1703258 learned scalars, 24224 moving scalars; 54 complete bottleneck blocks and all stage shapes verified.
Full pre-activation ResNet-1001: 10327706 learned scalars, 149216 moving scalars; 333 complete bottleneck blocks and all stage shapes verified.
Compact depth 164 keeps all blocks: 494 finite parameter-tensor gradients; inference leaves moving state unchanged.
Compact depth 1001 keeps all blocks: 3005 finite parameter-tensor gradients; inference leaves moving state unchanged.
// result_end

> Dataset example

Original images appear in CIFAR-10 class order before any augmentation.

```{cpp, results="markdown", file="figures/preactivation_resnet_inputs.png", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

int main() {
  namespace n = dm::nn;

  std::filesystem::path cache;
  if (const auto *p = std::getenv("DATAMUNGE_DATA_DIR"))
    cache = p;
  else if (const auto *p = std::getenv("XDG_CACHE_HOME"))
    cache = std::filesystem::path(p) / "datamunge/datasets";
  else
    cache = std::filesystem::path(std::getenv("HOME")) / ".cache/datamunge/datasets";
  dm::datasets::fetch("cifar10", (cache / "cifar10").string());

  const auto raw =
      n::data::LoadCifar({cache / "cifar10/data_batch_1.bin"}, n::data::Cifar::k10);
  const auto images = n::cast(raw.images, n::DType::Float32) / 255.;
  const auto labels = raw.labels;

  std::vector<int64_t> rows;
  for (int cls = 0; cls < 10; ++cls) {
    for (int64_t row = 0; row < labels.numel(); ++row)
      if (labels.at({row}) == cls) {
        rows.push_back(row);
        break;
      }
  }
  if (rows.size() != 10)
    return 1;
  std::filesystem::create_directories("build");
  n::save_image_grid(n::take_rows(images, rows), "build/preactivation_resnet_inputs.png", 5,
                     0., 1., 4, 1., 4);
  std::print("One original cached training image per class, IDs 0..4 then 5..9.\n");
}
```
