> Projection and nonzero-branch checks

Dimension-changing shortcuts are tested separately from raw identity paths. The finite-difference fixture uses positive activations to avoid a ReLU boundary.

```{cpp, results="markdown", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

int main() {
  namespace n = dm::nn;
  const auto type = n::DType::Float64;
  n::ParameterStore p(17, type), state(17, type);
  const auto x = n::linspace(-1, 1, 50, type).reshape({1, 5, 5, 2});
  {
    n::NoGradGuard guard;
    n::models::PreActBottleneck(p, state, "b", x, 1, 2);
  }
  p.set("b/conv3/W", n::zeros({1, 1, 1, 4}, type));
  p.set("b/shortcut/W", n::tensor({1., 0., 1., 0., 0., 1., 0., 1.}, {1, 1, 2, 4}).to(type));
  p.set("b/bn1/gamma", n::full({2}, std::sqrt(1.00001), type));
  const auto actual = n::models::PreActBottleneck(p, state, "b", x, 1, 2).output;
  const auto sampled = n::slice_axis(n::slice_axis(n::relu(x), 1, 0, 5, 2), 2, 0, 5, 2);
  const double error = n::max(n::abs(actual - n::concat({sampled, sampled}, 3))).item();
  if (error > 1e-12)
    return 1;
  n::ParameterStore q(19, type), moments(19, type);
  const auto positive = n::full({1, 3, 3, 4}, .5, type).requires_grad_();
  {
    n::NoGradGuard guard;
    n::models::PreActBottleneck(q, moments, "b", positive, 1);
  }
  for (const auto &name : q.names())
    if (name.ends_with("/W"))
      q.set(name, n::full(q.at(name).shape(), .2, type));
  const auto y = n::models::PreActBottleneck(q, moments, "b", positive, 1).output;
  const auto dx = n::grad(n::sum(y), {positive})[0];
  const auto direction = n::one_hot(n::tensor({16}).to(n::DType::Int64), 36, 1, 0, type)
                             .reshape(positive.shape());
  n::NoGradGuard guard;
  const double h = 1e-6;
  const double plus =
      n::sum(n::models::PreActBottleneck(q, moments, "b", positive.detach() + h * direction, 1)
                 .output)
          .item();
  const double minus =
      n::sum(n::models::PreActBottleneck(q, moments, "b", positive.detach() - h * direction, 1)
                 .output)
          .item();
  const double numerical = (plus - minus) / (2 * h), analytic = dx.at({0, 1, 1, 0});
  if (std::abs(numerical - analytic) > 1e-7)
    return 1;
  std::print("Projection consumes the first BN/ReLU, not raw input: value error "
             "{:.12f}.\nNonzero branch centre-input derivative: autograd {:.9f}, finite "
             "difference {:.9f}; includes the identity contribution.\n",
             error, analytic, numerical);
}
```
