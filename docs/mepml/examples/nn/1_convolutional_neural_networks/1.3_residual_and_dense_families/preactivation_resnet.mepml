> Simple identity example

The fixture removes every learned correction but retains all BN/ReLU/filter operations.

```{cpp, results="markdown", file="figures/preactivation_resnet_identity.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

int main() {
  namespace n = dm::nn;
  const auto type = n::DType::Float64;
  n::ParameterStore p(17, type), state(17, type);
  const auto x = n::linspace(-1, 1, 100, type).reshape({1, 5, 5, 4}).detach().requires_grad_();
  auto build = [&](const n::Tensor &input) {
    auto h = input;
    for (int i = 0; i < 50; ++i)
      h = n::models::PreActBottleneck(p, state, "b" + std::to_string(i), h, 1).output;
    return h;
  };
  {
    n::NoGradGuard guard;
    build(x);
  }
  for (int i = 0; i < 50; ++i)
    p.set("b" + std::to_string(i) + "/conv3/W", n::zeros({1, 1, 1, 4}, type));
  const auto output = build(x);
  const auto derivative = n::grad(n::sum(output), {x})[0];
  if (n::max(n::abs(output - x)).item() != 0 || n::max(n::abs(derivative - 1)).item() != 0)
    return 1;
  auto channel = [](const n::Tensor &t) {
    return n::slice_axis(t, 3, 0, 1).reshape({5, 5});
  };
  auto gradient = dm::graphics::RPlot::create();
  gradient
      .lines(n::arange(0, 100).to_vector<double>(),
             derivative.reshape({100}).to_vector<double>(), "input derivative", {37, 99, 235})
      .title("Derivative through fifty zero branches")
      .x_label("input scalar index")
      .y_label("d sum(output) / dx")
      .y_limits(0, 1.5);
  auto layout = dm::graphics::RLayout::create(2, 2);
  layout.add(n::plot_tensor_map(channel(x), -1, 1).title("Signed input, first channel"))
      .add(n::plot_tensor_map(channel(output), -1, 1)
               .title("Fifty pre-activation identity units"))
      .add(n::plot_tensor_map(channel(n::relu(x)), -1, 1)
               .title("Post-add ReLU formula would clip negatives"))
      .add(gradient);
  std::filesystem::create_directories("build");
  layout.size(1100, 920).fit_panels().save_svg("build/preactivation_resnet_identity.svg");
  std::print("Fifty equal-width zero-residual units: bitwise-equal signed values and "
             "derivative one for every input scalar.\n");
}
```
