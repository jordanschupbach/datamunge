```{cpp, results="markdown", file="figures/highway_networks_training.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

int main() {
  int rendered_confusions = 0;
  namespace n             = dm::nn;
  n::set_num_threads(2);

  std::filesystem::path cache;
  if (const auto* p = std::getenv("DATAMUNGE_DATA_DIR"))
    cache = p;
  else if (const auto* p = std::getenv("XDG_CACHE_HOME"))
    cache = std::filesystem::path(p) / "datamunge/datasets";
  else
    cache = std::filesystem::path(std::getenv("HOME")) / ".cache/datamunge/datasets";
  dm::datasets::fetch("mnist", (cache / "mnist").string());

  const auto train = n::load_mnist((cache / "mnist").string(), "train"),
             test  = n::load_mnist((cache / "mnist").string(), "test");
  const auto tx    = n::slice_axis(train.images, 0, 0, 512).reshape({512, 784}),
             ty    = n::slice_axis(train.labels, 0, 0, 512);
  const auto vx    = n::slice_axis(train.images, 0, 512, 640).reshape({128, 784}),
             vy    = n::slice_axis(train.labels, 0, 512, 640);
  const auto qx    = n::slice_axis(test.images, 0, 0, 128).reshape({128, 784}),
             qy    = n::slice_axis(test.labels, 0, 0, 128);
  n::ParameterStore p(17);
  auto              output = [&](const n::Tensor& x) {
    return n::models::HighwayClassifier(p, x, 20, 50, 10, -2).logits;
  };
  {
    n::NoGradGuard guard;
    output(n::zeros({1, 784}));
  }
  if (p.count() != 136660)
    return 1;
  n::OptimizerConfig config;
  config.kind = n::OptimizerKind::Adam;
  n::Optimizer        optimizer(p, .001, config);
  n::BatchOrder       batches(512, 32, 2026);
  std::vector<double> epochs, training, validation;
  std::filesystem::create_directories("build");
  const std::string checkpoint = "build/highway_networks_best.npz";
  double            best       = std::numeric_limits<double>::infinity();
  int               best_epoch = 0;
  for (int epoch = 1; epoch <= 10; ++epoch) {
    batches.begin_epoch();
    n::WeightedMean average;
    for (auto rows = batches.next(); !rows.empty(); rows = batches.next()) {
      const auto nll =
          n::sparse_softmax_cross_entropy(output(n::take_rows(tx, rows)), n::take_rows(ty, rows));
      auto objective = nll;
      for (const auto& w : p.parameters())
        if (w.dim() >= 2)
          objective = objective + .00005 * n::sum(n::square(w));
      optimizer.minimize(objective);
      average.add(nll.item(), rows.size());
    }
    n::NoGradGuard guard;
    const double   val = n::sparse_softmax_cross_entropy(output(vx), vy).item();
    if (!std::isfinite(val))
      return 1;
    epochs.push_back(epoch);
    training.push_back(average.value());
    validation.push_back(val);
    if (val < best) {
      best       = val;
      best_epoch = epoch;
      p.save(checkpoint);
    }
  }
  p.load(checkpoint);
  n::NoGradGuard guard;
  const auto     prediction   = output(qx);
  const double   training_nll = n::sparse_softmax_cross_entropy(output(tx), ty).item(),
               test_nll       = n::sparse_softmax_cross_entropy(prediction, qy).item();
  if (!std::isfinite(test_nll))
    return 1;
  const auto confusion =
      n::matmul(n::transpose(n::one_hot(qy, 10), {1, 0}), n::one_hot(n::argmax(prediction, 1), 10));
  n::ConfusionMatrix::from_counts(confusion.to(n::DType::Int64))
      .save_svg(
          "build/highway_networks_confusion_api_" + std::to_string(rendered_confusions++) + ".svg",
          {.title = "highway networks / selected-checkpoint test counts"});

  if (n::sum(confusion).item() != 128)
    return 1;
  auto learning = dm::graphics::RPlot::create();
  learning.lines(epochs, training, "training", {37, 99, 235})
      .lines(epochs, validation, "validation", {234, 88, 12})
      .title("Twenty hidden layers, explicit Adam")
      .x_label("epoch")
      .y_label("mean primary NLL");
  auto counts = n::plot_tensor_map(n::reverse(confusion, {0}), 0, n::max(confusion).item());
  counts
      .title(
          "Test counts, range [0," + std::to_string(static_cast<int>(n::max(confusion).item())) +
          "]")
      .x_label("predicted digit")
      .y_label("true digit")
      .x_limits(-.5, 9.5)
      .y_limits(-.5, 9.5);
  dm::graphics::RLayout::create(1, 2)
      .add(learning)
      .add(counts)
      .size(1100, 470)
      .fit_panels()
      .save_svg("build/highway_networks_training.svg");
  std::print(
      "512 fit / 128 validation / 128 official-test digits; {} learned scalars; {} "
      "explicit Adam updates.\nSelected epoch {}, validation NLL {:.6f}, training NLL "
      "{:.6f}, test NLL {:.6f}, test accuracy {:.6f}.\n",
      p.count(),
      optimizer.iterations(),
      best_epoch,
      best,
      training_nll,
      test_nll,
      n::accuracy(prediction, qy));
}
```
// result_begin: markdown
512 fit / 128 validation / 128 official-test digits; 136660 learned scalars; 160 explicit Adam updates.
Selected epoch 9, validation NLL 0.962916, training NLL 0.126805, test NLL 0.759486, test accuracy 0.765625.
\image(figures/highway_networks_training.svg)
// result_end
\caption(Visible Adam updates train all twenty hidden layers and both terms of every coupled gate. The checkpoint uses validation NLL; the test count matrix sums to 128 and its title gives the colour limits.)
\alttext(Visible Adam updates train all twenty hidden layers and both terms of every coupled gate. The checkpoint uses validation NLL; the test count matrix sums to 128 and its title gives the colour limits.)


Validation selects epoch nine. The restored model has training NLL 0.126805,
validation NLL 0.962916 and test NLL 0.759486, with 76.5625% accuracy on 128
official-test digits. The gap shows that strong fitting on 512 digits does not
translate to equally low held-out loss. The count matrix exposes the selected
model's class pattern; this small run establishes the explicit training workflow.

> Native confusion matrices

These matrices use the held-out predictions from the executed program above.
The native `ConfusionMatrix` SVG API labels exact counts with true classes
running from top to bottom and predicted classes from left to right.

\image(figures/highway_networks_confusion_api_0.svg)
\caption(Held-out classification confusion counts, evaluation 1. Exact cell counts are printed in the image.)
\alttext(Integer prediction counts with true classes as rows and predicted classes as columns.)


> Conclusion

The carry path and transform path are coupled by a learned sigmoid gate, whose input
derivative must be included. Controlled deep-stack gains explain one attenuation mechanism;
the full MNIST architecture then exposes every optimizer step and validation-selected
checkpoint. The fixed-gate algebra and the learned-model experiment answer different questions.

