> Checking the complete classifier

The first plain projection counts as one of twenty hidden layers. A changed initializer must preserve existing learned biases.

```{cpp, results="markdown", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

int main() {
  namespace n = dm::nn;
  n::ParameterStore p(17);
  n::Generator rng(29);
  const auto x = n::normal({2, 784}, 0, .3, rng);
  const auto net = n::models::HighwayClassifier(p, x, 20, 50, 10, -2);
  if (p.count() != 136660 || net.layers.size() != 19 ||
      net.projection.shape() != n::Shape{2, 50} || net.logits.shape() != n::Shape{2, 10})
    return 1;
  const auto gradients = n::grad(
      n::sparse_softmax_cross_entropy(net.logits, n::tensor({0, 1}).to(n::DType::Int64)),
      p.parameters());
  for (const auto &g : gradients)
    if (!std::isfinite(n::sum(n::abs(g)).item()))
      return 1;
  n::NoGradGuard guard;
  const auto a = n::models::HighwayClassifier(p, x).logits,
             b = n::models::HighwayClassifier(p, x).logits;
  if (n::max(n::abs(a - b)).item() != 0)
    return 1;
  p.set("highway0/gate/b", n::full({50}, .25));
  n::models::HighwayClassifier(p, x, 20, 50, 10, -10);
  if (n::max(n::abs(p.at("highway0/gate/b") - .25)).item() != 0)
    return 1;
  std::print("Complete classifier: {} learned scalars; projection plus 19 highway layers; {} "
             "finite parameter-tensor gradients.\nEvaluation is deterministic. Changing the "
             "bias initializer does not reset an existing learned gate bias.\n",
             p.count(), gradients.size());
}
```
// result_begin: markdown
Complete classifier: 136660 learned scalars; projection plus 19 highway layers; 80 finite parameter-tensor gradients.
Evaluation is deterministic. Changing the bias initializer does not reset an existing learned gate bias.
// result_end

> Dataset example

The contact sheet shows one original 28×28 training image per digit, ordered 0–4 then 5–9, with integer pixel enlargement for visibility.

```{cpp, results="markdown", file="figures/highway_networks_inputs.png", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

int main() {
  namespace n = dm::nn;

  std::filesystem::path cache;
  if (const auto *p = std::getenv("DATAMUNGE_DATA_DIR"))
    cache = p;
  else if (const auto *p = std::getenv("XDG_CACHE_HOME"))
    cache = std::filesystem::path(p) / "datamunge/datasets";
  else
    cache = std::filesystem::path(std::getenv("HOME")) / ".cache/datamunge/datasets";
  dm::datasets::fetch("mnist", (cache / "mnist").string());

  const auto data = n::load_mnist((cache / "mnist").string(), "train");
  const auto images = data.images, labels = data.labels;

  std::vector<int64_t> rows;
  for (int cls = 0; cls < 10; ++cls) {
    for (int64_t row = 0; row < labels.numel(); ++row)
      if (labels.at({row}) == cls) {
        rows.push_back(row);
        break;
      }
  }
  if (rows.size() != 10)
    return 1;
  std::filesystem::create_directories("build");
  n::save_image_grid(n::take_rows(images, rows), "build/highway_networks_inputs.png", 5, 0.,
                     1., 4, 1., 4);
  std::print("One original cached training image per class, IDs 0..4 then 5..9.\n");
}
