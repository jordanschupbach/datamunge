> Simple coupled-gate example

The signed two-channel fixture includes an inactive transform component and a nonzero gate derivative.

```{cpp, results="markdown", file="figures/highway_networks_gates.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

int main() {
  namespace n = dm::nn;
  const auto type = n::DType::Float64;
  n::ParameterStore p(17, type), q(17, type);
  const auto x = n::from_vector(std::vector<double>{.8, -.5}, {1, 2}).requires_grad_();
  {
    n::NoGradGuard guard;
    n::models::HighwayDense(p, "h", x, -1);
    n::models::HighwayConv2D(q, "h", x.reshape({1, 1, 1, 2}), 1, -1);
  }
  const std::vector<std::pair<std::string, std::vector<double>>> values{
      {"transform/W", {.7, -.2, .3, .8}},
      {"transform/b", {.2, .1}},
      {"gate/W", {.4, -.1, -.2, .3}},
      {"gate/b", {-1, -1}}};
  for (const auto &[part, value] : values) {
    p.set("h/" + part, n::from_vector(value, p.at("h/" + part).shape()));
    q.set("h/" + part, n::from_vector(value, q.at("h/" + part).shape()));
  }
  const auto net = n::models::HighwayDense(p, "h", x, -1);
  const auto jac = n::jacobian(
                       [&](const n::Tensor &z) {
                         return n::models::HighwayDense(p, "h", z, -1).output;
                       },
                       x)
                       .reshape({2, 2});
  const auto t = net.gate, active = n::greater(net.transformed, 0).to(type);
  const auto carry = (1 - t).reshape({2, 1}) * n::eye(2, type);
  const auto transform =
      (t * active).reshape({2, 1}) * n::transpose(p.at("h/transform/W"), {1, 0});
  const auto gate_term = ((net.transformed - x) * t * (1 - t)).reshape({2, 1}) *
                         n::transpose(p.at("h/gate/W"), {1, 0});
  const double error = n::max(n::abs(jac - carry - transform - gate_term)).item();
  if (error > 1e-12 || n::max(n::abs(gate_term)).item() == 0)
    return 1;
  const auto conv = n::models::HighwayConv2D(q, "h", x.reshape({1, 1, 1, 2}), 1, -1);
  const auto conv_jac = n::jacobian(
                            [&](const n::Tensor &z) {
                              return n::models::HighwayConv2D(q, "h", z, 1, -1).output;
                            },
                            x.reshape({1, 1, 1, 2}))
                            .reshape({2, 2});
  if (n::max(n::abs(conv.output.reshape({1, 2}) - net.output)).item() > 1e-12 ||
      n::max(n::abs(conv_jac - jac)).item() > 1e-12)
    return 1;
  if (n::max(n::abs(n::models::HighwayMix(x, net.transformed, n::scalar(0, type)) - x))
              .item() != 0 ||
      n::max(n::abs(n::models::HighwayMix(x, net.transformed, n::scalar(1, type)) -
                    net.transformed))
              .item() != 0)
    return 1;
  for (const auto &g : n::grad(n::sum(net.output), p.parameters()))
    if (!std::isfinite(n::sum(n::abs(g)).item()))
      return 1;
  auto activation = dm::graphics::RPlot::create();
  activation.lines({0, 1}, x.to_vector<double>(), "input", {37, 99, 235})
      .lines({0, 1}, net.transformed.to_vector<double>(), "transform H", {234, 88, 12})
      .lines({0, 1}, net.output.to_vector<double>(), "output", {22, 163, 74})
      .title("One two-channel highway evaluation")
      .x_label("component index")
      .y_label("signed activation")
      .y_limits(-.7, 1.3);
  auto layout = dm::graphics::RLayout::create(1, 2);
  layout.add(activation)
      .add(n::plot_tensor_map(jac, -.05, 1).title("Complete input Jacobian"));
  std::filesystem::create_directories("build");
  layout.size(1100, 470).fit_panels().save_svg("build/highway_networks_gates.svg");
  dm::dstruct::DataFrame table;
  table.add_column("output_component", std::vector<double>{0, 1});
  table.add_column("d_y_d_x0", n::slice_axis(jac, 1, 0, 1).reshape({2}).to_vector<double>());
  table.add_column("d_y_d_x1", n::slice_axis(jac, 1, 1, 2).reshape({2}).to_vector<double>());
  std::print("Transform {}, gates {}, output {}.\n\n{}\n\nFull Jacobian error {:.12f}; "
             "omitting the gate term would change an entry by {:.9f}. Dense/1x1-conv values "
             "and Jacobians agree.\n",
             net.transformed.to_vector<double>(), net.gate.to_vector<double>(),
             net.output.to_vector<double>(), table.to_md(9), error,
             n::max(n::abs(gate_term)).item());
}
```
