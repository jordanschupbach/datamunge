> Checking depth attenuation

All scalar coefficients are fixed explicitly; no optimization is hidden in this comparison.

```{cpp, results="markdown", file="figures/highway_networks_depth.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

int main() {
  namespace n = dm::nn;
  const auto type = n::DType::Float64;
  const auto input = n::ones({1, 1}, type).requires_grad_();
  std::vector<double> layers{0}, plain_trace{0};
  auto plain = input;
  for (int i = 1; i <= 100; ++i) {
    plain = .5 * plain;
    layers.push_back(i);
    plain_trace.push_back(n::log(plain).item() / std::log(10.));
  }
  const double plain_expected = std::pow(.5, 100),
               plain_gradient = n::grad(plain, {input})[0].item();
  if (std::abs(plain.item() / plain_expected - 1) > 1e-11 ||
      std::abs(plain_gradient / plain_expected - 1) > 1e-11)
    return 1;
  auto plot = dm::graphics::RPlot::create();
  plot.lines(layers, plain_trace, "plain, gain .5", {37, 99, 235});
  std::print("Plain 100-layer response and input derivative {:.12e}.\n", plain.item());
  for (double bias : {0., -3.}) {
    n::ParameterStore p(17, type);
    auto h = input;
    std::vector<double> trace{0};
    for (int i = 1; i <= 100; ++i) {
      const auto name = "b" + std::to_string(i);
      p.set(name + "/transform/W", n::full({1, 1}, .5, type));
      p.set(name + "/transform/b", n::zeros({1}, type));
      p.set(name + "/gate/W", n::zeros({1, 1}, type));
      p.set(name + "/gate/b", n::full({1}, bias, type));
      h = n::models::HighwayDense(p, name, h, bias).output;
      trace.push_back(n::log(h).item() / std::log(10.));
    }
    const double expected = std::pow(1 - .5 / (1 + std::exp(-bias)), 100),
                 gradient = n::grad(h, {input})[0].item();
    if (std::abs(h.item() / expected - 1) > 1e-11 || std::abs(gradient / expected - 1) > 1e-11)
      return 1;
    plot.lines(layers, trace, bias == 0 ? "gate bias 0" : "gate bias -3",
               bias == 0 ? dm::graphics::RGB{234, 88, 12} : dm::graphics::RGB{22, 163, 74});
    std::print("Bias {:.0f}: response {:.12e}, input derivative {:.12e}; exact constant-gate "
               "formula verified.\n",
               bias, h.item(), gradient);
  }
  plot.title("One hundred scalar layers with fixed transforms and gates")
      .x_label("layers")
      .y_label("log10 response")
      .y_limits(-32, 10);
  std::filesystem::create_directories("build");
  plot.size(1000, 470).save_svg("build/highway_networks_depth.svg");
}
```
