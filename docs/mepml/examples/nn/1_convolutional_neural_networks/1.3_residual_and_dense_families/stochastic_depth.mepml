```{cpp, results="markdown", file="figures/stochastic_depth_training.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

int main() {
  int rendered_confusions = 0;
  namespace n             = dm::nn;
  auto training_plot      = dm::graphics::RPlot::create(),
       validation_plot    = dm::graphics::RPlot::create();
  int setting             = 0;
  for (double survival : std::vector<double>{1., .5}) {
    n::set_num_threads(2);

    std::filesystem::path cache;
    if (const auto* p = std::getenv("DATAMUNGE_DATA_DIR"))
      cache = p;
    else if (const auto* p = std::getenv("XDG_CACHE_HOME"))
      cache = std::filesystem::path(p) / "datamunge/datasets";
    else
      cache = std::filesystem::path(std::getenv("HOME")) / ".cache/datamunge/datasets";
  dm::datasets::fetch("cifar10", (cache / "cifar10").string());

    const auto raw = n::data::LoadCifar({cache / "cifar10/data_batch_1.bin"}, n::data::Cifar::k10);
    const auto images = n::cast(raw.images, n::DType::Float32) / 255.,
               labels = n::cast(raw.labels, n::DType::Int64);
    const auto tx = n::slice_axis(images, 0, 0, 128), ty = n::slice_axis(labels, 0, 0, 128);
    const auto vx       = 2 * n::slice_axis(images, 0, 128, 192) - 1,
               vy       = n::slice_axis(labels, 0, 128, 192);
    const auto official = n::load_cifar10((cache / "cifar10").string(), "test");
    const auto qx       = 2 * n::slice_axis(official.images, 0, 0, 64) - 1,
               qy       = n::slice_axis(official.labels, 0, 0, 64);
    n::models::StochasticCifarConfig cfg;
    cfg.depth         = 20;
    cfg.last_survival = survival;
    n::Generator      mask_rng(71);
    n::ParameterStore p(17), state(17);
    auto              output = [&](const n::Tensor& image, bool training) {
      return n::models::StochasticCifarResNet(p, state, image, cfg, training, mask_rng).logits;
    };
    {
      n::NoGradGuard guard;
      output(n::zeros({1, 32, 32, 3}), false);
    }
    if (p.count() != 269722 || state.count() != 1376)
      return 1;
    n::OptimizerConfig config;
    config.kind = n::OptimizerKind::Adam;
    n::Optimizer  optimizer(p, .001, config);
    n::BatchOrder batches(128, 8, 2026);
    n::Generator  augmentation(151);
    std::filesystem::create_directories("build");
    const std::string   checkpoint = "build/stochastic_depth_best";
    double              best       = std::numeric_limits<double>::infinity();
    int                 best_epoch = 0;
    std::vector<double> epochs, train, validation;
    for (int epoch = 1; epoch <= 10; ++epoch) {
      batches.begin_epoch();
      n::WeightedMean average;
      for (auto rows = batches.next(); !rows.empty(); rows = batches.next()) {
        const auto             batch = n::take_rows(tx, rows), target = n::take_rows(ty, rows);
        std::vector<n::Tensor> transformed;
        for (int64_t row = 0; row < batch.size(0); ++row) {
          auto image =
              n::pad(n::slice_axis(batch, 0, row, row + 1), {{0, 0}, {4, 4}, {4, 4}, {0, 0}});
          image = n::augment::random_crop(image, 32, 32, augmentation);
          transformed.push_back(n::augment::random_flip_left_right(image, augmentation));
        }
        const auto nll = n::sparse_softmax_cross_entropy(
            output(2 * n::concat(transformed, 0) - 1, true), target);
        auto objective = nll;
        for (const auto& w : p.parameters())
          if (w.dim() >= 2)
            objective = objective + .00005 * n::sum(n::square(w));
        optimizer.minimize(objective);
        average.add(nll.item(), rows.size());
      }
      n::NoGradGuard guard;
      const double   val = n::sparse_softmax_cross_entropy(output(vx, false), vy).item();
      if (!std::isfinite(val))
        return 1;
      epochs.push_back(epoch);
      train.push_back(average.value());
      validation.push_back(val);
      if (val < best) {
        best       = val;
        best_epoch = epoch;
        p.save(checkpoint + "_params.npz");
        state.save(checkpoint + "_state.npz");
      }
    }
    p.load(checkpoint + "_params.npz");
    state.load(checkpoint + "_state.npz");
    n::NoGradGuard guard;
    const auto     prediction = output(qx, false);
    const double   test_nll   = n::sparse_softmax_cross_entropy(prediction, qy).item();
    const double   training_nll =
        n::sparse_softmax_cross_entropy(output(2 * tx - 1, false), ty).item();
    if (!std::isfinite(test_nll))
      return 1;
    const auto truth = n::one_hot(qy, 10), predicted = n::one_hot(n::argmax(prediction, 1), 10);
    const auto confusion = n::matmul(n::transpose(truth, {1, 0}), predicted);
    n::ConfusionMatrix::from_counts(confusion.to(n::DType::Int64))
        .save_svg(
            "build/stochastic_depth_confusion_api_" + std::to_string(rendered_confusions++) +
                ".svg",
            {.title = "stochastic depth / selected-checkpoint test counts"});

    if (n::sum(confusion).item() != 64)
      return 1;
    const std::string label = survival == 1 ? "constant depth" : "last survival .5";
    const std::vector<dm::graphics::RGB> colours = {{37, 99, 235}, {234, 88, 12}, {22, 163, 74}};
    training_plot.lines(epochs, train, label, colours[setting]);
    validation_plot.lines(epochs, validation, label, colours[setting]);
    ++setting;
    std::print("CIFAR-20 last survival {}: ", survival);
    std::print(
        "128 fit / 64 validation / 64 official-test rows; {} learned scalars, {} moving "
        "scalars; {} explicit Adam updates.\nSelected epoch {}; validation NLL {:.6f}; "
        "inference training NLL {:.6f}; test NLL {:.6f}; test accuracy {:.6f}.\n",
        p.count(),
        state.count(),
        optimizer.iterations(),
        best_epoch,
        best,
        training_nll,
        test_nll,
        n::accuracy(prediction, qy));
  }
  training_plot.title("CIFAR-20: augmented training").x_label("epoch").y_label("mean NLL");
  validation_plot.title("CIFAR-20: inference validation").x_label("epoch").y_label("mean NLL");
  dm::graphics::RLayout::create(1, 2)
      .add(training_plot)
      .add(validation_plot)
      .size(1100, 470)
      .fit_panels()
      .save_svg("build/stochastic_depth_training.svg");
}
```
// result_begin: markdown
CIFAR-20 last survival 1: 128 fit / 64 validation / 64 official-test rows; 269722 learned scalars, 1376 moving scalars; 160 explicit Adam updates.
Selected epoch 8; validation NLL 2.329446; inference training NLL 1.319105; test NLL 2.225254; test accuracy 0.265625.
CIFAR-20 last survival 0.5: 128 fit / 64 validation / 64 official-test rows; 269722 learned scalars, 1376 moving scalars; 160 explicit Adam updates.
Selected epoch 7; validation NLL 2.278336; inference training NLL 1.780219; test NLL 2.191659; test accuracy 0.265625.
\image(figures/stochastic_depth_training.svg)
// result_end
\caption(Two complete CIFAR-20 fits compare constant depth with a linear schedule ending at survival .5. Both compute every branch and select paired parameter/moving-state checkpoints by validation NLL.)
\alttext(Two complete CIFAR-20 fits compare constant depth with a linear schedule ending at survival .5. Both compute every branch and select paired parameter/moving-state checkpoints by validation NLL.)


The constant-depth fit selects epoch 8 (validation NLL 2.329446, test NLL 2.225254,
accuracy 0.265625); the .5-survival fit selects epoch 7 (validation NLL 2.278336,
test NLL 2.191659, accuracy 0.265625). The .5-survival fit has slightly lower
validation and test NLL at the same test accuracy, and a smaller gap to its
inference training NLL (1.780219 against 1.319105). These 64-image, single-seed
results do not establish a regularization advantage. Training traces
use augmentation/batch moments and differ from restored inference training NLL.

> Native confusion matrices

These matrices use the held-out predictions from the executed program above.
The native `ConfusionMatrix` SVG API labels exact counts with true classes
running from top to bottom and predicted classes from left to right.

\image(figures/stochastic_depth_confusion_api_0.svg)
\caption(Held-out classification confusion counts, evaluation 1. Exact cell counts are printed in the image.)
\alttext(Integer prediction counts with true classes as rows and predicted classes as columns.)

\image(figures/stochastic_depth_confusion_api_1.svg)
\caption(Held-out classification confusion counts, evaluation 2. Exact cell counts are printed in the image.)
\alttext(Integer prediction counts with true classes as rows and predicted classes as columns.)


> Conclusion

Stochastic masks alter residual contributions and their derivatives according to an explicit
scaling convention. Boundary, schedule and topology checks explain those choices; the paired
optimizer loop makes the regularization experiment and its limited evidence reproducible.

> References

- [Huang et al. (2016), Deep Networks with Stochastic Depth](https://arxiv.org/abs/1603.09382).
- [Torchvision inverted stochastic depth](https://github.com/pytorch/vision/blob/main/torchvision/ops/stochastic_depth.py).
- [CIFAR-10 dataset](https://www.cs.toronto.edu/~kriz/cifar.html).
