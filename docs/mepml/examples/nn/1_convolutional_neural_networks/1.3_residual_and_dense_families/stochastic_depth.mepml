> Schedule, shortcut and complete model

Expected mask-active depth is distinct from executed work.

```{cpp, results="markdown", file="figures/stochastic_depth_schedule.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

int main() {
  namespace n = dm::nn;
  const auto p = n::models::SurvivalProbabilities(54, .5f);
  double expected = 0;
  std::vector<double> index, probabilities;
  for (size_t i = 0; i < p.size(); ++i) {
    expected += p[i];
    index.push_back(i + 1);
    probabilities.push_back(p[i]);
  }
  if (std::abs(expected - 40.25) > 2e-6 || p.back() != .5f)
    return 1;
  const auto x =
      n::arange(1, 33).to(n::DType::Float32).reshape({1, 4, 4, 2}).detach().requires_grad_();
  const auto shortcut = n::models::CifarIdentityShortcut(x, 4, 2);
  const auto a = n::slice_axis(n::slice_axis(x, 1, 0, 4, 2), 2, 0, 4, 2),
             b = n::slice_axis(n::slice_axis(x, 1, 0, 4, 2), 2, 1, 4, 2),
             c = n::slice_axis(n::slice_axis(x, 1, 1, 4, 2), 2, 0, 4, 2),
             d = n::slice_axis(n::slice_axis(x, 1, 1, 4, 2), 2, 1, 4, 2);
  const auto reference = n::concat({(a + b + c + d) / 4, n::zeros({1, 2, 2, 2})}, 3);
  if (n::max(n::abs(shortcut - reference)).item() != 0 ||
      n::max(n::abs(n::grad(n::sum(shortcut), {x})[0] - .25)).item() != 0)
    return 1;
  auto schedule = dm::graphics::RPlot::create();
  schedule.lines(index, probabilities, "linear survival", {37, 99, 235})
      .title("54 residual blocks: expected active 40.25")
      .x_label("block index, 1..54")
      .y_label("survival probability")
      .y_limits(0, 1.2);
  auto pooled = n::plot_tensor_map(n::slice_axis(shortcut, 3, 0, 1).reshape({2, 2}))
                    .title("Option-A shortcut: first pooled channel");
  std::filesystem::create_directories("build");
  dm::graphics::RLayout::create(1, 2)
      .add(schedule)
      .add(pooled)
      .size(1100, 470)
      .fit_panels()
      .save_svg("build/stochastic_depth_schedule.svg");
  n::set_num_threads(2);
  n::ParameterStore params(17), state(17);
  n::Generator gen(71), rng(29);
  n::models::StochasticCifarConfig cfg;
  cfg.last_survival = 1;
  cfg.update_stats = false;
  const auto out = n::models::StochasticCifarResNet(
      params, state, n::normal({2, 16, 16, 3}, 0, .2, rng), cfg, true, gen);
  if (params.count() != 1727962 || state.count() != 8096 || out.gates.size() != 54 ||
      out.logits.shape() != n::Shape{2, 10})
    return 1;
  for (int i = 0; i < 3; ++i)
    if (out.stages[i].shape() != n::Shape{2, 16 / (1 << i), 16 / (1 << i), 16 << i})
      return 1;
  const auto gradients = n::grad(n::mean(n::square(out.logits)), params.parameters());
  for (const auto &g : gradients)
    if (!std::isfinite(n::sum(n::abs(g)).item()))
      return 1;
  std::print("54-block expected mask-active depth {:.6f}; shortcut values and .25 pooling "
             "derivatives verified.\nComplete CIFAR-110: {} learned / {} moving scalars, {} "
             "finite parameter-tensor gradients with all gates open. Every branch is computed "
             "even when its gate is zero.\n",
             expected, params.count(), state.count(), gradients.size());
}
```
