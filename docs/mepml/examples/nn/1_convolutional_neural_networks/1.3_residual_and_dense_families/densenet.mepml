> Simple feature-reuse example

The signed original channels retain their position before and after every concatenation. Random added features test ordering first; zero additions then isolate the full-output direct derivative.

```{cpp, results="markdown", file="figures/densenet_growth.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

int main() {
  namespace n = dm::nn;
  const auto type = n::DType::Float64;
  const auto x = n::linspace(-1, 1, 75, type).reshape({1, 5, 5, 3}).detach().requires_grad_();
  for (bool bottleneck : {false, true}) {
    n::ParameterStore p(17, type), state(17, type);
    std::vector<double> widths;
    auto build = [&]() {
      auto h = x;
      widths = {3};
      for (int layer = 0; layer < 4; ++layer) {
        const auto previous = h;
        const auto out = n::models::DenseGrowthLayer(p, state, "g" + std::to_string(layer), h,
                                                     2, bottleneck);
        if (n::max(n::abs(n::slice_axis(out.output, 3, 0, previous.size(3)) - previous))
                    .item() != 0 ||
            n::max(
                n::abs(n::slice_axis(out.output, 3, previous.size(3), previous.size(3) + 2) -
                       out.added))
                    .item() != 0)
          throw std::runtime_error("feature order changed");
        h = out.output;
        widths.push_back(h.size(3));
      }
      return h;
    };
    const auto all = build();
    const auto direct = n::grad(n::sum(n::slice_axis(all, 3, 0, 3)), {x})[0];
    if (n::max(n::abs(direct - 1)).item() != 0 ||
        widths != std::vector<double>{3, 5, 7, 9, 11})
      return 1;
    for (const auto &name : p.names())
      if (name.ends_with("/conv2/W"))
        p.set(name, n::zeros_like(p.at(name)));
    const auto zero_added = build();
    const auto derivative = n::grad(n::sum(zero_added), {x})[0];
    if (n::max(n::abs(derivative - 1)).item() != 0 ||
        n::max(n::abs(n::slice_axis(zero_added, 3, 3, 11))).item() != 0)
      return 1;
    if (bottleneck) {
      auto channel = [](const n::Tensor &t) {
        return n::slice_axis(t, 3, 0, 1).reshape({5, 5});
      };
      auto growth = dm::graphics::RPlot::create();
      growth.lines({0, 1, 2, 3, 4}, widths, "observed channels", {234, 88, 12})
          .title("Channels grow as 3 + 2L")
          .x_label("dense layers L")
          .y_label("channels")
          .y_limits(0, 12);
      auto gradient = dm::graphics::RPlot::create();
      gradient
          .lines(n::arange(0, 75).to_vector<double>(),
                 derivative.reshape({75}).to_vector<double>(), "input derivative",
                 {37, 99, 235})
          .title("Direct derivative with zero additions")
          .x_label("input scalar index")
          .y_label("d sum(output) / dx")
          .y_limits(0, 1.5);
      auto layout = dm::graphics::RLayout::create(2, 2);
      layout.add(n::plot_tensor_map(channel(x), -1, 1).title("Signed original channel"))
          .add(n::plot_tensor_map(channel(zero_added), -1, 1)
                   .title("Same channel after four concatenations"))
          .add(growth)
          .add(gradient);
      std::filesystem::create_directories("build");
      layout.size(1100, 920).fit_panels().save_svg("build/densenet_growth.svg");
    }
    std::print("Bottleneck={}: old/new channel order exact; widths 3,5,7,9,11; direct "
               "derivative one, including signed original features.\n",
               bottleneck);
  }
}
```
// result_begin: markdown
Bottleneck=false: old/new channel order exact; widths 3,5,7,9,11; direct derivative one, including signed original features.
Bottleneck=true: old/new channel order exact; widths 3,5,7,9,11; direct derivative one, including signed original features.
\image(figures/densenet_growth.svg)
// result_end
\caption(Both basic and bottleneck layers retain old channels verbatim and append two new ones. The displayed bottleneck stack then has its added features zeroed to isolate the full-output identity derivative.)
\alttext(Both basic and bottleneck layers retain old channels verbatim and append two new ones. The displayed bottleneck stack then has its added features zeroed to isolate the full-output identity derivative.)

> Hand-checking a transition

The transition example separates pointwise channel compression from spatial averaging.

```{cpp, results="markdown", file="figures/densenet_transition.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

int main() {
  namespace n = dm::nn;
  const auto type = n::DType::Float64;
  n::ParameterStore p(17, type), state(17, type);
  const auto a = n::linspace(1, 16, 16, type).reshape({1, 4, 4, 1});
  const auto x = n::concat({a, 2 * a}, 3).detach().requires_grad_();
  {
    n::NoGradGuard guard;
    n::models::DenseTransition(p, state, "t", x, 1);
  }
  p.set("t/bn/gamma", n::full({2}, std::sqrt(1.00001), type));
  p.set("t/conv/W", n::tensor({.25, .75}, {1, 1, 2, 1}).to(type));
  const auto y = n::models::DenseTransition(p, state, "t", x, 1);
  const auto dx = n::grad(n::sum(y), {x})[0];
  const auto expected = n::tensor({6.125, 9.625, 20.125, 23.625}, {1, 2, 2, 1}).to(type);
  if (n::max(n::abs(y - expected)).item() > 1e-12 ||
      n::max(n::abs(dx - n::tensor({.0625, .1875}, {1, 1, 1, 2}).to(type))).item() > 1e-12)
    return 1;
  auto layout = dm::graphics::RLayout::create(1, 2);
  layout.add(n::plot_tensor_map(a.reshape({4, 4}), 1, 24).title("Input channel 0: values a"))
      .add(n::plot_tensor_map(y.reshape({2, 2}), 1, 24)
               .title("Compress, then average 2x2 windows"));
  std::filesystem::create_directories("build");
  layout.size(1100, 470).fit_panels().save_svg("build/densenet_transition.svg");
  std::print("Inputs (a,2a), weights (.25,.75): pointwise output 1.75a.\nPooled values {}; "
             "input derivatives .25/4=.0625 and .75/4=.1875.\n",
             y.to_vector<double>());
}
```
// result_begin: markdown
Inputs (a,2a), weights (.25,.75): pointwise output 1.75a.
Pooled values [6.125, 9.625, 20.125, 23.625]; input derivatives .25/4=.0625 and .75/4=.1875.
\image(figures/densenet_transition.svg)
// result_end
\caption(Positive inputs and compensated inference BN expose the transition arithmetic. Both panels share colour limits [1,24]. Each pooled value averages four projected pixels; channel and spatial compression are separate steps.)
\alttext(Positive inputs and compensated inference BN expose the transition arithmetic. Both panels share colour limits [1,24]. Each pooled value averages four projected pixels; channel and spatial compression are separate steps.)

> Checking complete topology

Full BC-121/BC-100 forward checks use reference shapes. Growth-four backward graphs retain the same layer counts while bounding memory.

```{cpp, results="markdown", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

int main() {
  namespace n = dm::nn;
  n::set_num_threads(2);
  for (bool cifar : {false, true}) {
    n::NoGradGuard guard;
    n::ParameterStore p(17), state(17);
    n::models::DenseNetConfig cfg;
    cfg.cifar_layout = cifar;
    cfg.depth = cifar ? 100 : 121;
    cfg.growth_rate = cifar ? 12 : 32;
    cfg.classes = cifar ? 10 : 1000;
    const int64_t side = cifar ? 32 : 224, first = cifar ? 32 : 56;
    const std::vector<int64_t> channels = cifar ? std::vector<int64_t>{216, 300, 342}
                                                : std::vector<int64_t>{256, 512, 1024, 1024};
    const auto out = n::models::DenseNet(p, state, n::zeros({1, side, side, 3}), cfg);
    if (p.count() != (cifar ? 769162 : 7978856) || state.count() != (cifar ? 23988 : 83648) ||
        out.layers.size() != (cifar ? 48 : 58) || out.stages.size() != channels.size())
      return 1;
    for (size_t i = 0; i < channels.size(); ++i) {
      const int64_t spatial = first / (1LL << i);
      if (out.stages[i].shape() != n::Shape{1, spatial, spatial, channels[i]})
        return 1;
      if (i + 1 < channels.size() &&
          out.transitions[i].shape() != n::Shape{1, spatial / 2, spatial / 2, channels[i] / 2})
        return 1;
    }
    std::print("Full DenseNet-BC-{} k={}: {} learned scalars, {} moving scalars; {} layers "
               "and every block/transition shape verified.\n",
               cfg.depth, cfg.growth_rate, p.count(), state.count(), out.layers.size());
  }
  for (bool cifar : {false, true}) {
    n::ParameterStore p(17), state(17);
    n::Generator rng(29);
    n::models::DenseNetConfig cfg;
    cfg.cifar_layout = cifar;
    cfg.depth = cifar ? 100 : 121;
    cfg.growth_rate = 4;
    cfg.classes = 3;
    cfg.update_stats = false;
    const auto x = n::normal({2, 32, 32, 3}, 0, .2, rng);
    const auto out = n::models::DenseNet(p, state, x, cfg, true);
    const auto gradients = n::grad(n::mean(n::square(out.logits)), p.parameters());
    for (const auto &g : gradients)
      if (!std::isfinite(n::sum(n::abs(g)).item()))
        return 1;
    const auto saved = state.flatten();
    n::NoGradGuard guard;
    n::models::DenseNet(p, state, x, cfg);
    if (state.flatten() != saved)
      return 1;
    std::print("Compact complete depth {}: all {} parameter-tensor gradients finite; "
               "inference state unchanged.\n",
               cfg.depth, gradients.size());
  }
}
```
// result_begin: markdown
Full DenseNet-BC-121 k=32: 7978856 learned scalars, 83648 moving scalars; 58 layers and every block/transition shape verified.
Full DenseNet-BC-100 k=12: 769162 learned scalars, 23988 moving scalars; 48 layers and every block/transition shape verified.
Compact complete depth 121: all 364 parameter-tensor gradients finite; inference state unchanged.
Compact complete depth 100: all 299 parameter-tensor gradients finite; inference state unchanged.
// result_end

> Dataset example

One original image per class appears before tensor augmentation.

```{cpp, results="markdown", file="figures/densenet_inputs.png", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

int main() {
  namespace n = dm::nn;

  std::filesystem::path cache;
  if (const auto *p = std::getenv("DATAMUNGE_DATA_DIR"))
    cache = p;
  else if (const auto *p = std::getenv("XDG_CACHE_HOME"))
    cache = std::filesystem::path(p) / "datamunge/datasets";
  else
    cache = std::filesystem::path(std::getenv("HOME")) / ".cache/datamunge/datasets";
  dm::datasets::fetch("cifar10", (cache / "cifar10").string());

  const auto raw =
      n::data::LoadCifar({cache / "cifar10/data_batch_1.bin"}, n::data::Cifar::k10);
  const auto images = n::cast(raw.images, n::DType::Float32) / 255.;
  const auto labels = raw.labels;

  std::vector<int64_t> rows;
  for (int cls = 0; cls < 10; ++cls) {
    for (int64_t row = 0; row < labels.numel(); ++row)
      if (labels.at({row}) == cls) {
        rows.push_back(row);
        break;
      }
  }
  if (rows.size() != 10)
    return 1;
  std::filesystem::create_directories("build");
  n::save_image_grid(n::take_rows(images, rows), "build/densenet_inputs.png", 5, 0., 1., 4, 1.,
                     4);
  std::print("One original cached training image per class, IDs 0..4 then 5..9.\n");
}
```
