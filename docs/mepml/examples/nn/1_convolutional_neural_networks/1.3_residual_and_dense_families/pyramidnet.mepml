> Simple shortcut example

Four cases isolate basic/bottleneck and stride-one/two behavior.

```{cpp, results="markdown", file="figures/pyramidnet_shortcuts.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

int main() {
  namespace n = dm::nn;
  const auto type = n::DType::Float64;
  auto layout = dm::graphics::RLayout::create(2, 2);
  for (bool bottle : {false, true})
    for (int stride : {1, 2}) {
      n::ParameterStore p(17, type), state(17, type);
      const auto x =
          n::linspace(-1, 1, 108, type).reshape({1, 6, 6, 3}).detach().requires_grad_();
      const int planes = bottle ? 2 : 5, out = bottle ? 8 : 5, side = 6 / stride;
      {
        n::NoGradGuard guard;
        n::models::PyramidBlock(p, state, "b", x, planes, bottle, stride);
      }
      const std::string last = bottle ? "b/bn4/" : "b/bn3/";
      p.set(last + "gamma", n::zeros({out}, type));
      p.set(last + "beta", n::zeros({out}, type));
      const auto y = n::models::PyramidBlock(p, state, "b", x, planes, bottle, stride).output;
      const auto weights =
          n::linspace(.2, 1, side * side * out, type).reshape({1, side, side, out});
      const auto dx = n::grad(n::sum(y * weights), {x})[0];
      // Independent sum of strided slices, rather than calling the pooling helper.
      auto mean = n::zeros({1, side, side, 3}, type);
      for (int r = 0; r < stride; ++r)
        for (int c = 0; c < stride; ++c)
          mean = mean + n::slice_axis(n::slice_axis(x, 1, r, 6, stride), 2, c, 6, stride) /
                            double(stride * stride);
      const auto expected = n::concat({mean, n::zeros({1, side, side, out - 3}, type)}, 3);
      const auto reference = n::grad(n::sum(expected * weights), {x})[0];
      if (n::max(n::abs(y - expected)).item() > 1e-12 ||
          n::max(n::abs(dx - reference)).item() > 1e-12 || n::min(y).item() >= 0)
        return 1;
      auto first = n::slice_axis(y, 3, 0, 1).reshape({side, side});
      layout.add(n::plot_tensor_map(first, -1, 1)
                     .title(std::string(bottle ? "Bottleneck" : "Basic") + ", stride " +
                            std::to_string(stride) + ": zero branch"));
      std::print("{} stride {}: signed pooled/padded values and weighted input derivatives "
                 "match independent strided sums; {} output channels.\n",
                 bottle ? "bottleneck" : "basic", stride, out);
    }
  std::filesystem::create_directories("build");
  layout.size(1100, 920).fit_panels().save_svg("build/pyramidnet_shortcuts.svg");
}
```
