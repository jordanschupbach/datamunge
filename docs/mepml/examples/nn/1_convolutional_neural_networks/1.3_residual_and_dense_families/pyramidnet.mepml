> Complete schedules and derivatives

Count checks cover the original ten presets; the deepest backward probe explicitly checks redundant BN shifts.

```{cpp, results="markdown", file="figures/pyramidnet_widths.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

int main() {
  namespace n = dm::nn;
  n::set_num_threads(2);
  n::models::PyramidNetConfig cfg;
  const auto widths = cfg.UnitWidths();
  if (widths.size() != 54 || widths[0] != 17 || widths[1] != 18 || widths[2] != 19 ||
      widths.back() != 64)
    return 1;
  auto plot = dm::graphics::RPlot::create();
  std::vector<double> index, w;
  for (size_t i = 0; i < widths.size(); ++i) {
    index.push_back(i + 1);
    w.push_back(widths[i]);
  }
  plot.lines(index, w, "alpha 48", {37, 99, 235})
      .title("Additive width at every unit")
      .x_label("unit index")
      .y_label("basic channels")
      .y_limits(0, 85);
  std::filesystem::create_directories("build");
  dm::graphics::RLayout::create(1, 1).add(plot).size(850, 460).fit_panels().save_svg(
      "build/pyramidnet_widths.svg");
  for (auto [depth, alpha, bottle, large, count, moving] :
       std::vector<std::tuple<int, double, bool, bool, int64_t, int64_t>>{
           {110, 48, false, false, 1772706, 13168},
           {110, 84, false, false, 3904446, 19108},
           {110, 270, false, false, 28485477, 49798},
           {164, 48, true, false, 1715442, 43744},
           {164, 270, true, false, 27216021, 165844},
           {200, 240, true, false, 26752702, 181984},
           {236, 220, true, false, 26969046, 198824},
           {272, 200, true, false, 26210842, 210864},
           {200, 300, true, true, 62368168, 285736},
           {200, 450, true, true, 116775213, 386236}}) {
    n::NoGradGuard guard;
    n::ParameterStore p(17), state(17);
    n::models::PyramidNetConfig c;
    c.depth = depth;
    c.alpha = alpha;
    c.bottleneck = bottle;
    c.imagenet = large;
    c.classes = large ? 1000 : 10;
    const int side = large ? 64 : 32;
    const auto out = n::models::PyramidNet(p, state, n::zeros({1, side, side, 3}), c);
    if (p.count() != count || state.count() != moving ||
        out.logits.shape() != n::Shape{1, c.classes})
      return 1;
    std::print("{} PyramidNet-{}, alpha {}, {}: {} learned / {} moving scalars; excluding BN "
               "scale/shift {:.3f} million.\n",
               large ? "ImageNet" : "CIFAR", depth, alpha, bottle ? "bottleneck" : "basic",
               count, moving, double(count - moving) / 1e6);
  }
  n::ParameterStore p(17), state(17);
  n::Generator rng(29);
  cfg.depth = 272;
  cfg.alpha = 200;
  cfg.bottleneck = true;
  cfg.update_stats = false;
  const auto net =
      n::models::PyramidNet(p, state, n::normal({2, 16, 16, 3}, 0, .2, rng), cfg, true);
  if (net.channels.back() != 864 || net.blocks.size() != 90)
    return 1;
  for (int i = 0; i < 3; ++i)
    if (net.stages[i].shape() !=
        n::Shape{2, 16 / (1 << i), 16 / (1 << i), net.channels[(i + 1) * 30 - 1]})
      return 1;
  const auto gradients = n::grad(n::mean(n::square(net.logits)), p.parameters());
  double largest = 0, redundant = 0, minimum = std::numeric_limits<double>::infinity();
  int count = 0;
  for (size_t i = 0; i < gradients.size(); ++i) {
    const double norm = n::sqrt(n::sum(n::square(gradients[i]))).item();
    if (!std::isfinite(norm))
      return 1;
    largest = std::max(largest, norm);
    const auto name = p.names()[i];
    if (name == "stem/bn/beta" || name.ends_with("/bn1/beta") || name.ends_with("/bn4/beta")) {
      ++count;
      redundant = std::max(redundant, norm);
    } else
      minimum = std::min(minimum, norm);
  }
  if (count != 181 || redundant > 1e-5 * largest || minimum <= 0)
    return 1;
  std::print("Full-width/depth PyramidNet-272 alpha 200 backward: {} finite parameter-tensor "
             "gradients; {} analytically redundant BN shifts, max norm {:.9f}; other minimum "
             "{:.9f}, overall maximum {:.9f}.\n",
             gradients.size(), count, redundant, minimum, largest);
}
```
