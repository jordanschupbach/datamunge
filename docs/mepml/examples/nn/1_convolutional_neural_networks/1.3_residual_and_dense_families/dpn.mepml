> Simple dual-path units

Zero updates expose the signed direct paths. A separate controlled projection changes both resolution and channel allocation.

```{cpp, results="markdown", file="figures/dpn_units.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

int main() {
  namespace n = dm::nn;
  const auto type = n::DType::Float64;
  n::ParameterStore p(17, type), state(17, type);
  const auto r = n::linspace(-1, 1, 100, type).reshape({1, 5, 5, 4}).detach().requires_grad_();
  const auto d =
      n::linspace(-.7, .8, 50, type).reshape({1, 5, 5, 2}).detach().requires_grad_();
  const n::models::DPNPaths x{r, d, 4, 2};
  {
    n::NoGradGuard guard;
    n::models::DPNBlock(p, state, "normal", x, 4, 4, 1, 2, false);
    n::models::DPNBlock(p, state, "down", x, 6, 4, 1, 2, true, 2);
  }
  for (const auto *name : {"normal/conv3/W", "down/conv3/W"})
    p.set(name, n::zeros_like(p.at(name)));
  const auto identity = n::eye(6, type);
  p.set("down/projection/W",
        n::concat({identity, n::slice_axis(identity, 1, 0, 2)}, 1).reshape({1, 1, 6, 8}));
  p.set("down/projection/bn/gamma", n::full({6}, std::sqrt(1.001), type));
  const auto normal = n::models::DPNBlock(p, state, "normal", x, 4, 4, 1, 2, false);
  if (n::max(n::abs(normal.output.residual - r)).item() != 0 ||
      n::max(n::abs(n::slice_axis(normal.output.dense, 3, 0, 2) - d)).item() != 0 ||
      n::max(n::abs(n::slice_axis(normal.output.dense, 3, 2, 3))).item() != 0)
    return 1;
  for (const auto &g : n::grad(n::sum(n::models::DPNJoin(normal.output)), {r, d}))
    if (n::max(n::abs(g - 1)).item() != 0)
      return 1;
  const auto down = n::models::DPNBlock(p, state, "down", x, 6, 4, 1, 2, true, 2);
  const auto sampled =
      n::slice_axis(n::slice_axis(n::relu(n::models::DPNJoin(x)), 1, 0, 5, 2), 2, 0, 5, 2);
  const auto expected =
      n::concat({sampled, n::slice_axis(sampled, 3, 0, 2), n::zeros({1, 3, 3, 1}, type)}, 3);
  const auto actual_gradient = n::grad(n::sum(n::models::DPNJoin(down.output)), {r, d});
  const auto reference_gradient = n::grad(n::sum(expected), {r, d});
  double error = n::max(n::abs(n::models::DPNJoin(down.output) - expected)).item();
  for (size_t i = 0; i < 2; ++i)
    error = std::max(error, n::max(n::abs(actual_gradient[i] - reference_gradient[i])).item());
  if (error > 1e-12 || down.input.residual_channels != 6 || down.input.dense_channels != 2 ||
      down.output.dense_channels != 3)
    return 1;
  auto first = [](const n::Tensor &t) {
    return n::slice_axis(t, 3, 0, 1).reshape({t.size(1), t.size(2)});
  };
  auto layout = dm::graphics::RLayout::create(2, 2);
  layout.add(n::plot_tensor_map(first(r), -1, 1).title("Signed incoming residual channel"))
      .add(n::plot_tensor_map(first(normal.output.residual), -1, 1)
               .title("Zero update preserves the residual"))
      .add(n::plot_tensor_map(first(down.output.residual), 0, 1)
               .title("Stage projection consumes BN/ReLU"))
      .add(n::plot_tensor_map(first(actual_gradient[0]), 0, 2)
               .title("Projected first-channel derivative"));
  std::filesystem::create_directories("build");
  layout.size(1100, 920).fit_panels().save_svg("build/dpn_units.svg");
  std::print(
      "Ordinary unit: signed residual and old dense channels exact; summed-output derivatives "
      "one.\nControlled projection: 5x5x6 joined inputs -> 3x3x8 projected channels -> "
      "residual 6, dense 2+1.\nProjection/reference value and input-gradient error {:.12f}.\n",
      error);
}
```
