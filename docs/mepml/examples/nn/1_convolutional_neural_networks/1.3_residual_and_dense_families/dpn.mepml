Controlled projection: 5x5x6 joined inputs -> 3x3x8 projected channels -> residual 6, dense 2+1.
Projection/reference value and input-gradient error 0.000000000000.
\image(figures/dpn_units.svg)
// result_end
\caption(Zero final bottleneck filters isolate direct paths. The projection selects the six joined channels, then copies the first two into its initial dense path; BN gamma cancels epsilon .001. ReLU and stride-two sampling therefore gate projected input derivatives.)
\alttext(Zero final bottleneck filters isolate direct paths. The projection selects the six joined channels, then copies the first two into its initial dense path; BN gamma cancels epsilon .001. ReLU and stride-two sampling therefore gate projected input derivatives.)

> Checking full preset counts

The full-width count checks and the 224-pixel geometry check use inference without backward storage.

```{cpp, results="markdown", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

int main() {
  namespace n = dm::nn;
  n::set_num_threads(2);
  const std::vector<std::tuple<int, int64_t, int64_t>> settings{{68, 12611602, 65116},
                                                                {92, 37668392, 125216},
                                                                {98, 61570728, 164896},
                                                                {107, 86917800, 213824},
                                                                {131, 79254504, 223360}};
  for (auto [depth, count, moving] : settings) {
    n::NoGradGuard guard;
    n::ParameterStore p(17), state(17);
    n::models::DPNConfig cfg;
    cfg.depth = depth;
    const auto out = n::models::DPN(p, state, n::zeros({1, 64, 64, 3}), cfg);
    int blocks = 0;
    for (const auto &stage : out.blocks)
      blocks += stage.size();
    if (p.count() != count || state.count() != moving || 3 * blocks + 2 != depth ||
        out.logits.shape() != n::Shape{1, 1000})
      return 1;
    std::print("DPN-{} on 64-pixel count-only inputs: {} learned scalars, {} moving scalars, "
               "{} complete units.\n",
               depth, count, moving, blocks);
  }
  {
    n::NoGradGuard guard;
    n::ParameterStore p(17), state(17);
    const auto out = n::models::DPN(p, state, n::zeros({1, 224, 224, 3}));
    if (out.stem.shape() != n::Shape{1, 56, 56, 64})
      return 1;
    const std::array<int64_t, 4> spatial{56, 28, 14, 7}, channels{336, 704, 1552, 2688};
    for (size_t i = 0; i < 4; ++i)
      if (n::models::DPNJoin(out.stages[i]).shape() !=
          n::Shape{1, spatial[i], spatial[i], channels[i]})
        return 1;
    std::print(
        "Full-width DPN-92 at 224 pixels: stem and all four joined stage shapes verified.\n");
  }
}
```
