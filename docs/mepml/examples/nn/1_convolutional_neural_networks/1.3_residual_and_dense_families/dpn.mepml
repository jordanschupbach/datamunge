> Checking stage algebra and gradients

The compact graph retains all 92 learned-depth layers. Its exact ordered path values, actual tensor channel widths and every parameter-tensor derivative are checked before fitting.

```{cpp, results="markdown", file="figures/dpn_paths.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

int main() {
  namespace n = dm::nn;
  n::set_num_threads(2);
  n::ParameterStore p(17), state(17);
  n::Generator rng(29);
  n::models::DPNConfig cfg;
  cfg.classes = 10;
  cfg.width_divisor = 4;
  cfg.groups = 8;
  cfg.small_stem = true;
  cfg.update_stats = false;
  const auto x = n::normal({2, 32, 32, 3}, 0, .2, rng);
  const auto out = n::models::DPN(p, state, x, cfg, true);
  if (p.count() != 2474330 || state.count() != 31304)
    return 1;
  std::vector<double> stage_ids, residual_widths, dense_widths, joined_widths, unit_ids{0},
      unit_r, unit_d, unit_joined;
  {
    n::NoGradGuard guard;
    for (size_t stage = 0; stage < 4; ++stage) {
      const auto &blocks = out.blocks[stage];
      auto residual = blocks[0].input.residual;
      std::vector<n::Tensor> dense{blocks[0].input.dense};
      if (stage == 0) {
        unit_r.push_back(residual.size(3));
        unit_d.push_back(dense[0].size(3));
        unit_joined.push_back(unit_r.back() + unit_d.back());
      }
      for (size_t i = 0; i < blocks.size(); ++i) {
        residual = residual + blocks[i].residual_update;
        dense.push_back(blocks[i].dense_update);
        if (stage == 0) {
          unit_ids.push_back(i + 1);
          unit_r.push_back(blocks[i].output.residual.size(3));
          unit_d.push_back(blocks[i].output.dense.size(3));
          unit_joined.push_back(unit_r.back() + unit_d.back());
        }
      }
      if (n::max(n::abs(out.stages[stage].residual - residual)).item() != 0 ||
          n::max(n::abs(out.stages[stage].dense - n::concat(dense, 3))).item() != 0)
        return 1;
      stage_ids.push_back(stage + 1);
      residual_widths.push_back(out.stages[stage].residual.size(3));
      dense_widths.push_back(out.stages[stage].dense.size(3));
      joined_widths.push_back(n::models::DPNJoin(out.stages[stage]).size(3));
    }
  }
  if (residual_widths != std::vector<double>{64, 128, 256, 512} ||
      dense_widths != std::vector<double>{20, 48, 132, 160} ||
      joined_widths != std::vector<double>{84, 176, 388, 672})
    return 1;
  const auto gradients = n::grad(n::mean(n::square(out.logits)), p.parameters());
  for (const auto &g : gradients)
    if (!std::isfinite(n::sum(n::abs(g)).item()))
      return 1;
  const auto saved = state.flatten();
  n::NoGradGuard guard;
  n::models::DPN(p, state, x, cfg, false);
  if (state.flatten() != saved)
    return 1;
  auto first = dm::graphics::RPlot::create(), last = dm::graphics::RPlot::create();
  first.lines(unit_ids, unit_r, "residual", {37, 99, 235})
      .lines(unit_ids, unit_d, "dense", {234, 88, 12})
      .lines(unit_ids, unit_joined, "joined", {22, 163, 74})
      .title("Stage 1: fixed and growing widths")
      .x_label("units after projection")
      .y_label("channels")
      .y_limits(0, 120);
  last.lines(stage_ids, residual_widths, "residual", {37, 99, 235})
      .lines(stage_ids, dense_widths, "dense", {234, 88, 12})
      .lines(stage_ids, joined_widths, "joined", {22, 163, 74})
      .title("End of each compact stage")
      .x_label("stage")
      .y_label("channels")
      .y_limits(0, 1000);
  std::filesystem::create_directories("build");
  dm::graphics::RLayout::create(1, 2)
      .add(first)
      .add(last)
      .size(1100, 470)
      .fit_panels()
      .save_svg("build/dpn_paths.svg");
  std::print(
      "All four stages: exact ordered residual folds and dense concatenations.\nCompact count "
      "{} learned / {} moving scalars; {} finite parameter-tensor gradients.\nFinal path "
      "widths R={}, D={}, joined={}. Inference state remains unchanged.\n",
      p.count(), state.count(), gradients.size(), residual_widths, dense_widths,
      joined_widths);
}
```
