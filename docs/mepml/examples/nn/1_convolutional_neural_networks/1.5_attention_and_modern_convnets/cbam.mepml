> Complete network counts and backward

```{cpp, results="markdown", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

int main() {
  namespace n = dm::nn;
  n::set_num_threads(2);
  struct Case {
    int cardinality, base;
    int64_t count;
  };
  for (const auto &c : std::vector<Case>{{1, 64, 28089624}}) {
    n::ParameterStore p(17), state(17);
    n::models::AttentionResNetConfig cfg;
    cfg.attention = n::models::ChannelAttention::kCbam;
    cfg.cardinality = c.cardinality;
    cfg.base_width = c.base;
    cfg.update_stats = false;
    {
      n::NoGradGuard guard;
      const auto out = n::models::AttentionResNet(p, state, n::zeros({1, 64, 64, 3}), cfg);
      if (p.count() != c.count || out.blocks.size() != 16 ||
          out.features.shape() != n::Shape{1, 2, 2, 2048})
        return 1;
      std::print("Full-width cbam groups {}: {} learned / {} moving scalars; sixteen blocks, "
                 "64-pixel forward.\n",
                 c.cardinality, p.count(), state.count());
      for (const auto &name : p.names())
        if (name.ends_with("/beta"))
          p.set(name,
                (.5 * n::sin(.37 * n::arange(0, p.at(name).numel()).to(n::DType::Float32) +
                             double(name.size())))
                    .reshape(p.at(name).shape()));
    }
    const auto x = n::sin(.37 * n::arange(0, 2 * 64 * 64 * 3).to(n::DType::Float32))
                       .reshape({2, 64, 64, 3});
    const auto before = state.flatten();
    const auto out = n::models::AttentionResNet(p, state, x, cfg, true);
    const auto gradients = n::grad(n::mean(n::square(out.logits)), p.parameters());
    double low = std::numeric_limits<double>::infinity(), high = 0;
    for (const auto &g : gradients) {
      const double norm = n::sqrt(n::sum(n::square(g))).item();
      if (!std::isfinite(norm))
        return 1;
      low = std::min(low, norm);
      high = std::max(high, norm);
    }
    if (high == 0 || before != state.flatten())
      return 1;
    std::print("Every {} parameter-tensor gradient finite; norm range [{:.12f},{:.9f}], "
               "moving state frozen.\n",
               gradients.size(), low, high);
  }
}
```
// result_begin: markdown
Full-width cbam groups 1: 28089624 learned / 53152 moving scalars; sixteen blocks, 64-pixel forward.
Every 273 parameter-tensor gradient finite; norm range [0.000046657678,4.647744179], moving state frozen.
// result_end

> Original pixels and explicit optimization

```{cpp, results="markdown", file="figures/cbam_inputs.png", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

int main() {
  namespace n = dm::nn;

  std::filesystem::path cache;
  if (const auto *p = std::getenv("DATAMUNGE_DATA_DIR"))
    cache = p;
  else if (const auto *p = std::getenv("XDG_CACHE_HOME"))
    cache = std::filesystem::path(p) / "datamunge/datasets";
  else
    cache = std::filesystem::path(std::getenv("HOME")) / ".cache/datamunge/datasets";
  dm::datasets::fetch("cifar10", (cache / "cifar10").string());

  const auto raw =
      n::data::LoadCifar({cache / "cifar10/data_batch_1.bin"}, n::data::Cifar::k10);
  const auto images = n::cast(raw.images, n::DType::Float32) / 255.;
  const auto labels = raw.labels;

  std::vector<int64_t> rows;
  for (int cls = 0; cls < 10; ++cls) {
    for (int64_t row = 0; row < labels.numel(); ++row)
      if (labels.at({row}) == cls) {
        rows.push_back(row);
        break;
      }
  }
  if (rows.size() != 10)
    return 1;
  std::filesystem::create_directories("build");
  n::save_image_grid(n::take_rows(images, rows), "build/cbam_inputs.png", 5, 0., 1., 4, 1., 4);
  std::print("One original cached training image per class, IDs 0..4 then 5..9.\n");
}
