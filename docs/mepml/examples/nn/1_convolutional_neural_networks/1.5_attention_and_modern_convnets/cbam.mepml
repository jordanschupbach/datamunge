> Small module and visible gates

```{cpp, results="markdown", file="figures/cbam_gates.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

int main() {
  namespace n = dm::nn;
  const auto type = n::DType::Float64;
  n::ParameterStore p(17, type), state(17, type);
  const auto x =
      n::sin(.37 * n::arange(0, 2 * 9 * 9 * 16).to(type) + .2).reshape({2, 9, 9, 16});
  {
    n::NoGradGuard guard;
    n::models::Cbam(p, state, "cb", x, 4, false, .9);
    state.set("cb/spatial/bn/moving_mean", n::full({1}, .2, type));
    state.set("cb/spatial/bn/moving_var", n::full({1}, 1.3, type));
    p.set("cb/spatial/bn/gamma", n::full({1}, .7, type));
    p.set("cb/spatial/bn/beta", n::full({1}, -.1, type));
  }
  const auto out = n::models::Cbam(p, state, "cb", x, 4, false, .9);
  auto mlp = [&](const auto &h) {
    return n::matmul(n::relu(n::matmul(h, p.at("cb/mlp1/W")) + p.at("cb/mlp1/b")),
                     p.at("cb/mlp2/W")) +
           p.at("cb/mlp2/b");
  };
  const auto channel = n::sigmoid(mlp(n::mean(x, {1, 2})) + mlp(n::max(x, {1, 2})))
                           .reshape({2, 1, 1, 16}),
             refined = x * channel;
  const auto maps = n::concat({n::max(refined, {3}, true), n::mean(refined, {3}, true)}, 3);
  auto opts = n::conv_options(1, n::Padding::Explicit);
  opts.explicit_paddings = {3, 3, 3, 3};
  const auto filtered = n::conv2d(maps, p.at("cb/spatial/W"), opts);
  const auto spatial = n::sigmoid((filtered - state.at("cb/spatial/bn/moving_mean")) *
                                      n::rsqrt(state.at("cb/spatial/bn/moving_var") + 1e-5) *
                                      p.at("cb/spatial/bn/gamma") +
                                  p.at("cb/spatial/bn/beta"));
  if (n::max(n::abs(out.output - refined * spatial)).item() > 1e-12 || p.count() != 248)
    return 1;
  auto curve = dm::graphics::RPlot::create();
  curve
      .lines(n::arange(0, 16).to_vector<double>(),
             n::slice_axis(channel, 0, 0, 1).reshape({16}).to_vector<double>(), "channel gate",
             {37, 99, 235})
      .title("Shared mean/max MLP gate")
      .x_label("channel")
      .y_label("gate")
      .y_limits(0, 1.2);
  const auto map = n::slice_axis(out.spatial_gate, 0, 0, 1).reshape({9, 9});
  std::filesystem::create_directories("build");
  dm::graphics::RLayout::create(1, 2)
      .add(curve)
      .add(n::plot_tensor_map(map, 0, 1).title("Spatial gate after channel refinement"))
      .size(1100, 470)
      .fit_panels()
      .save_svg("build/cbam_gates.svg");
  std::print("Shared 16-to-4-to-16 MLP plus spatial gate: 248 learned scalars. Explicit "
             "channel/max-mean/spatial/BN composition agrees to 1e-12 with nontrivial saved "
             "BN state.\n");
}
```
