> Small module and visible gates

```{cpp, results="markdown", file="figures/senet_gate.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

int main() {
  namespace n = dm::nn;
  const auto type = n::DType::Float64;
  n::ParameterStore p(17, type);
  const auto x =
      n::sin(.17 * n::arange(0, 2 * 7 * 7 * 32).to(type) + .2).reshape({2, 7, 7, 32});
  {
    n::NoGradGuard guard;
    n::models::SqueezeExcitationModule(p, "se", x, 4);
    p.set("se/reduce/b", n::full({8}, .3, type));
  }
  const auto out = n::models::SqueezeExcitationModule(p, "se", x, 4);
  const auto hidden =
      n::relu(n::matmul(n::mean(x, {1, 2}), p.at("se/reduce/W").reshape({32, 8})) +
              p.at("se/reduce/b"));
  const auto gate =
      n::sigmoid(n::matmul(hidden, p.at("se/expand/W").reshape({8, 32})) + p.at("se/expand/b"))
          .reshape({2, 1, 1, 32});
  const double error = n::max(n::abs(out.output - x * gate)).item();
  if (error > 1e-12 || p.count() != 552)
    return 1;
  auto curve = dm::graphics::RPlot::create();
  curve
      .lines(n::arange(0, 32).to_vector<double>(),
             n::slice_axis(out.gate, 0, 0, 1).reshape({32}).to_vector<double>(),
             "sample 0 gate", {37, 99, 235})
      .title("SE channel weights, logistic gate")
      .x_label("channel")
      .y_label("gate")
      .y_limits(0, 1.2);
  const auto map = n::slice_axis(n::slice_axis(out.output, 0, 0, 1), 3, 0, 1).reshape({7, 7});
  std::filesystem::create_directories("build");
  dm::graphics::RLayout::create(1, 2)
      .add(curve)
      .add(n::plot_tensor_map(map, -1, 1).title("Gated signed channel 0"))
      .size(1100, 470)
      .fit_panels()
      .save_svg("build/senet_gate.svg");
  std::print("32-channel SE, reduction four: 552 learned scalars; independent tensor dense "
             "composition agrees within {:.12f}. Gate range [{:.6f},{:.6f}].\n",
             error, n::min(gate).item(), n::max(gate).item());
}
```
