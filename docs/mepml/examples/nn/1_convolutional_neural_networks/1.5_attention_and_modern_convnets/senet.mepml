```{cpp, results="markdown", file="figures/senet_training.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

int main() {
  int rendered_confusions = 0;
  namespace n             = dm::nn;
  n::set_num_threads(2);

  std::filesystem::path cache;
  if (const auto* p = std::getenv("DATAMUNGE_DATA_DIR"))
    cache = p;
  else if (const auto* p = std::getenv("XDG_CACHE_HOME"))
    cache = std::filesystem::path(p) / "datamunge/datasets";
  else
    cache = std::filesystem::path(std::getenv("HOME")) / ".cache/datamunge/datasets";
  dm::datasets::fetch("cifar10", (cache / "cifar10").string());

  const auto raw    = n::data::LoadCifar({cache / "cifar10/data_batch_1.bin"}, n::data::Cifar::k10);
  const auto images = n::cast(raw.images, n::DType::Float32) / 255.,
             labels = n::cast(raw.labels, n::DType::Int64);
  const auto tx = n::slice_axis(images, 0, 0, 128), ty = n::slice_axis(labels, 0, 0, 128);
  const auto vx       = 2 * n::slice_axis(images, 0, 128, 192) - 1,
             vy       = n::slice_axis(labels, 0, 128, 192);
  const auto official = n::load_cifar10((cache / "cifar10").string(), "test");
  const auto qx       = 2 * n::slice_axis(official.images, 0, 0, 64) - 1,
             qy       = n::slice_axis(official.labels, 0, 0, 64);
  n::models::AttentionResNetConfig cfg;
  cfg.classes       = 10;
  cfg.width_divisor = 4;
  cfg.small_stem    = true;
  cfg.stride_on_3x3 = false;
  cfg.attention     = n::models::ChannelAttention::kSqueezeExcitation;
  n::ParameterStore p(17), state(17);
  auto              output = [&](const n::Tensor& image, bool training) {
    return n::models::AttentionResNet(p, state, image, cfg, training).logits;
  };
  {
    n::NoGradGuard guard;
    output(n::zeros({1, 32, 32, 3}), false);
  }
  if (p.count() != 1645382)
    return 1;
  n::OptimizerConfig config;
  config.kind = n::OptimizerKind::Adam;
  n::Optimizer  optimizer(p, .001, config);
  n::BatchOrder batches(128, 8, 2026);
  n::Generator  augmentation(151);
  std::filesystem::create_directories("build");
  const std::string   checkpoint = "build/senet_best";
  double              best       = std::numeric_limits<double>::infinity();
  int                 best_epoch = 0;
  std::vector<double> epochs, train, validation;
  for (int epoch = 1; epoch <= 11; ++epoch) {
    batches.begin_epoch();
    n::WeightedMean average;
    for (auto rows = batches.next(); !rows.empty(); rows = batches.next()) {
      const auto             batch = n::take_rows(tx, rows), target = n::take_rows(ty, rows);
      std::vector<n::Tensor> transformed;
      for (int64_t row = 0; row < batch.size(0); ++row) {
        auto image =
            n::pad(n::slice_axis(batch, 0, row, row + 1), {{0, 0}, {4, 4}, {4, 4}, {0, 0}});
        image = n::augment::random_crop(image, 32, 32, augmentation);
        transformed.push_back(n::augment::random_flip_left_right(image, augmentation));
      }
      const auto nll =
          n::sparse_softmax_cross_entropy(output(2 * n::concat(transformed, 0) - 1, true), target);
      auto objective = nll;
      for (const auto& w : p.parameters())
        if (w.dim() >= 2)
          objective = objective + .00005 * n::sum(n::square(w));
      optimizer.minimize(objective);
      average.add(nll.item(), rows.size());
    }
    n::NoGradGuard guard;
    const double   val = n::sparse_softmax_cross_entropy(output(vx, false), vy).item();
    if (!std::isfinite(val))
      return 1;
    epochs.push_back(epoch);
    train.push_back(average.value());
    validation.push_back(val);
    if (val < best) {
      best       = val;
      best_epoch = epoch;
      p.save(checkpoint + "_params.npz");
      state.save(checkpoint + "_state.npz");
    }
  }
  p.load(checkpoint + "_params.npz");
  state.load(checkpoint + "_state.npz");
  n::NoGradGuard guard;
  const auto     prediction = output(qx, false);
  const double   test_nll   = n::sparse_softmax_cross_entropy(prediction, qy).item();
  const double training_nll = n::sparse_softmax_cross_entropy(output(2 * tx - 1, false), ty).item();
  if (!std::isfinite(test_nll))
    return 1;
  const auto truth = n::one_hot(qy, 10), predicted = n::one_hot(n::argmax(prediction, 1), 10);
  const auto confusion = n::matmul(n::transpose(truth, {1, 0}), predicted);
  n::ConfusionMatrix::from_counts(confusion.to(n::DType::Int64))
      .save_svg(
          "build/senet_confusion_api_" + std::to_string(rendered_confusions++) + ".svg",
          {.title = "senet / selected-checkpoint test counts"});

  if (n::sum(confusion).item() != 64)
    return 1;
  auto trace = dm::graphics::RPlot::create();
  trace.lines(epochs, train, "training", {37, 99, 235})
      .lines(epochs, validation, "validation", {234, 88, 12})
      .title("senet quarter-width ResNet-50")
      .x_label("epoch")
      .y_label("mean primary NLL");
  // Flip before the image helper so its vertical tick is the actual true-class ID.
  auto counts = n::plot_tensor_map(n::reverse(confusion, {0}), 0, n::max(confusion).item());
  counts
      .title(
          "Test counts, range [0," + std::to_string(static_cast<int>(n::max(confusion).item())) +
          "]")
      .x_label("predicted class")
      .y_label("true class")
      .x_limits(-.5, 9.5)
      .y_limits(-.5, 9.5);
  dm::graphics::RLayout::create(1, 2).add(trace).add(counts).size(1100, 470).fit_panels().save_svg(
      "build/senet_training.svg");
  std::print(
      "128 fit / 64 validation / 64 official-test rows; {} learned scalars, {} moving "
      "scalars; {} explicit Adam updates.\nSelected epoch {}; validation NLL {:.6f}; "
      "inference training NLL {:.6f}; test NLL {:.6f}; test accuracy {:.6f}.\n",
      p.count(),
      state.count(),
      optimizer.iterations(),
      best_epoch,
      best,
      training_nll,
      test_nll,
      n::accuracy(prediction, qy));
}
```
// result_begin: markdown
128 fit / 64 validation / 64 official-test rows; 1645382 learned scalars, 13280 moving scalars; 176 explicit Adam updates.
Selected epoch 11; validation NLL 2.296753; inference training NLL 1.454913; test NLL 2.520617; test accuracy 0.250000.
\image(figures/senet_training.svg)
// result_end
\caption(Explicit 11-epoch Adam fit and a tensor-computed true/predicted-class count matrix at the selected checkpoint. Training uses augmentation and batch BN moments; validation/test use saved moving moments. Counts sum to 64; IDs follow the original CIFAR-10 order.)
\alttext(Explicit 11-epoch Adam fit and a tensor-computed true/predicted-class count matrix at the selected checkpoint. Training uses augmentation and batch BN moments; validation/test use saved moving moments. Counts sum to 64; IDs follow the original CIFAR-10 order.)


> Observed subset result

validation selects epoch 11, the last epoch, with validation NLL 2.296753, inference training NLL
1.454913, test NLL 2.520617 and 25.0000% test accuracy on 64 images. Sixteen correct test images
are well above the roughly six expected by chance, but the test NLL above ln 10 ≈ 2.303 shows that
the wrong predictions are confident ones.

These fixed-seed subset results do not establish a ranking of attention mechanisms or
deformable variants. Validation selection and training/inference BN differences matter;
the small test split is not a published benchmark.

> Native confusion matrices

These matrices use the held-out predictions from the executed program above.
The native `ConfusionMatrix` SVG API labels exact counts with true classes
running from top to bottom and predicted classes from left to right.

\image(figures/senet_confusion_api_0.svg)
\caption(Held-out classification confusion counts, evaluation 1. Exact cell counts are printed in the image.)
\alttext(Integer prediction counts with true classes as rows and predicted classes as columns.)


> Conclusion

The gate definition, complete topology and visible optimizer loop connect attention to executable
tensor computation. The subset fit and diagnostic gate maps do not establish published accuracy
or make the gates causal explanations of image content.

> References

- [Hu et al., Squeeze-and-Excitation Networks](https://arxiv.org/abs/1709.01507).
- [CIFAR-10 dataset](https://www.cs.toronto.edu/~kriz/cifar.html).
