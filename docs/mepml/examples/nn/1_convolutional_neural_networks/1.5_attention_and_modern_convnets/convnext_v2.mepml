> Small block and derivatives

```{cpp, results="markdown", file="figures/convnext_v2_grn.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

int main() {
  namespace n = dm::nn;
  const auto type = n::DType::Float64;
  n::ParameterStore p(17, type);
  const auto x =
      n::concat({n::zeros({2, 5, 5, 1}, type),
                 n::sin(.17 * n::arange(0, 2 * 5 * 5 * 7).to(type)).reshape({2, 5, 5, 7})},
                3)
          .detach()
          .requires_grad_();
  const auto initial = n::models::GlobalResponseNorm(p, "g", x);
  const auto derivative = n::grad(n::sum(initial.output), {x})[0];
  if (n::max(n::abs(initial.output - x)).item() != 0 ||
      n::max(n::abs(derivative - 1)).item() != 0)
    return 1;
  const auto scaled = n::models::GlobalResponseNorm(p, "g", 7 * x);
  const double difference = n::max(n::abs(initial.response - scaled.response)).item();
  if (difference > 1e-5)
    return 1;
  {
    n::NoGradGuard guard;
    p.set("g/gamma", n::linspace(.1, .3, 8, type));
    p.set("g/beta", n::linspace(-.1, .1, 8, type));
  }
  const auto active = n::models::GlobalResponseNorm(p, "g", x);
  const auto norm = n::sqrt(n::sum(n::square(x), {1, 2}, true));
  const auto ref =
      p.at("g/gamma") * x * norm / (n::mean(norm, {3}, true) + 1e-6) + p.at("g/beta") + x;
  const double error = n::max(n::abs(active.output - ref)).item();
  if (error > 1e-12)
    return 1;
  for (bool all_zero : {false, true}) {
    n::ParameterStore q(19, type);
    const auto input = (all_zero ? n::zeros({2, 5, 5, 8}, type) : x.detach()).requires_grad_();
    const auto out = n::models::GlobalResponseNorm(q, "safe", input);
    const auto dx = n::grad(n::sum(out.output), {input})[0];
    if (n::max(n::abs(dx - 1)).item() != 0)
      return 1;
  }
  auto response = dm::graphics::RPlot::create(), identity = dm::graphics::RPlot::create();
  response
      .lines(n::arange(0, 8).to_vector<double>(),
             n::slice_axis(initial.response, 0, 0, 1).reshape({8}).to_vector<double>(),
             "original", {37, 99, 235})
      .lines(n::arange(0, 8).to_vector<double>(),
             n::slice_axis(scaled.response, 0, 0, 1).reshape({8}).to_vector<double>(),
             "input times seven", {234, 88, 12})
      .title("GRN response; dead channel is zero")
      .x_label("channel")
      .y_label("normalized spatial L2 response")
      .y_limits(0, 1.7);
  identity
      .lines(n::arange(0, 8).to_vector<double>(),
             n::slice(derivative, {0, 0, 0, 0}, {1, 1, 1, 8}).reshape({8}).to_vector<double>(),
             "initial derivative", {147, 51, 234})
      .title("Zero affine initialization: identity gradient")
      .x_label("channel")
      .y_label("d sum(output) / dx at one pixel")
      .y_limits(0, 1.5);
  std::filesystem::create_directories("build");
  dm::graphics::RLayout::create(1, 2)
      .add(response)
      .add(identity)
      .size(1200, 500)
      .fit_panels()
      .save_svg("build/convnext_v2_grn.svg");
  std::print(
      "Initial GRN is exact identity including all-zero/dead channels, with finite unit input "
      "derivatives. Active affine formula error {:.12f}; response difference after scaling "
      "input by seven {:.12f}. Fixed epsilon prevents exact scale invariance.\n",
      error, difference);
}
```
