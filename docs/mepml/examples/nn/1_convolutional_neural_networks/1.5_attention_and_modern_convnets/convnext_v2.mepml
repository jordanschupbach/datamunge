> Analytical budgets and executed cross-checks

```{cpp, results="markdown", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

int64_t target_macs(const dm::nn::models::ConvNeXtSize &layout) {
  int64_t result = int64_t(layout.dims.back()) * 1000, side = 56;
  for (int stage = 0; stage < 4; ++stage, side /= 2) {
    const int64_t d = layout.dims[stage];
    result += layout.depths[stage] * side * side * (49 * d + 8 * d * d) +
              (stage ? side * side * 4 * layout.dims[stage - 1] * d : side * side * 48 * d);
  }
  return result;
}
int main() {
  namespace n = dm::nn;
  n::set_num_threads(2);
  struct Case {
    const char *name;
    int64_t parameters, macs;
  };
  for (const auto &expected : std::vector<Case>{{"atto", 3708400, 547332480},
                                                {"femto", 5233240, 779629824},
                                                {"pico", 9066280, 1367055360},
                                                {"nano", 15623800, 2445528320},
                                                {"tiny", 28635496, 4455531264},
                                                {"base", 88717800, 15354729472},
                                                {"large", 197956840, 34361433600},
                                                {"huge", 660289640, 114922100480}}) {
    const auto layout = n::models::ConvNeXtLayout(expected.name);
    const auto count = n::models::ConvNeXtParameters(layout, 1000, 4, true);
    const auto macs = target_macs(layout);
    if (count != expected.parameters || macs != expected.macs)
      return 1;
    std::print("ConvNeXt V2 {}: analytical {} parameters / {} reference-224 MACs.\n",
               expected.name, count, macs);
  }
  for (const std::string name : {"atto", "tiny"}) {
    n::NoGradGuard guard;
    n::ParameterStore p(17);
    n::models::ConvNeXtConfig cfg;
    cfg.size = name;
    cfg.v2 = true;
    const auto layout = n::models::ConvNeXtLayout(name);
    const auto out = n::models::ConvNeXt(p, n::zeros({1, 64, 64, 3}), cfg);
    if (p.count() != n::models::ConvNeXtParameters(layout, 1000, 4, true))
      return 1;
    const auto extrapolated =
        (n::models::ConvNeXtMacs(out, layout, 1000, 4) - int64_t(layout.dims.back()) * 1000) *
            49 / 4 +
        int64_t(layout.dims.back()) * 1000;
    if (extrapolated != target_macs(layout))
      return 1;
    if (name == "tiny") {
      const auto full = n::models::ConvNeXt(p, n::zeros({1, 224, 224, 3}), cfg);
      if (n::models::ConvNeXtMacs(full, layout, 1000, 4) != target_macs(layout))
        return 1;
    }
    std::print("Actual full-weight {} 64-pixel count agrees; Tiny additionally executes at "
               "224 pixels.\n",
               name);
  }
  std::print("Other table entries are analytical counts, not allocated networks. In "
             "particular Huge is not allocated. MACs count convolution/classifier products, "
             "excluding LayerNorm/GELU/GRN/dropout/addition and memory traffic; they are not "
             "runtime measurements.\n");
}
```
