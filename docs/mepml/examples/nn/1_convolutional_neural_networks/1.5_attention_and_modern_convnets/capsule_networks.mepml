> Small routing example and independent oracle

```{cpp, results="markdown", file="figures/capsule_networks_routing.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

int main() {
  namespace n = dm::nn;
  const auto type = n::DType::Float64;
  const auto u = (1.3 * n::sin(.37 * n::arange(0, 12).to(type) + .2)).reshape({1, 6, 2}),
             weights = n::sin(.37 * n::arange(0, 108).to(type) + .7).reshape({6, 9, 2});
  const auto actual = n::models::DynamicRouting(u, weights, 6, 3, 2, 3, 3);
  const auto input = u.to_vector<double>(), w = weights.to_vector<double>();
  std::vector<double> votes(6 * 3 * 3), logits(6 * 3), couplings(6 * 3), capsules(3 * 3);
  for (int i = 0; i < 6; ++i)
    for (int j = 0; j < 3; ++j)
      for (int d = 0; d < 3; ++d)
        for (int k = 0; k < 2; ++k)
          votes[(i * 3 + j) * 3 + d] += w[(i * 9 + j * 3 + d) * 2 + k] * input[i * 2 + k];
  double error = 0;
  // Independent host oracle only; model votes and routing use tensor operations.
  for (int t = 0; t < 3; ++t) {
    for (int i = 0; i < 6; ++i) {
      double high = -std::numeric_limits<double>::infinity(), total = 0;
      for (int j = 0; j < 3; ++j)
        high = std::max(high, logits[i * 3 + j]);
      for (int j = 0; j < 3; ++j) {
        couplings[i * 3 + j] = std::exp(logits[i * 3 + j] - high);
        total += couplings[i * 3 + j];
      }
      for (int j = 0; j < 3; ++j)
        couplings[i * 3 + j] /= total;
    }
    for (int i = 0; i < 18; ++i)
      error =
          std::max(error, std::abs(actual.history[t].reshape({18}).at({i}) - couplings[i]));
    std::fill(capsules.begin(), capsules.end(), 0);
    for (int i = 0; i < 6; ++i)
      for (int j = 0; j < 3; ++j)
        for (int d = 0; d < 3; ++d)
          capsules[j * 3 + d] += couplings[i * 3 + j] * votes[(i * 3 + j) * 3 + d];
    for (int j = 0; j < 3; ++j) {
      double norm2 = 0;
      for (int d = 0; d < 3; ++d)
        norm2 += capsules[j * 3 + d] * capsules[j * 3 + d];
      const double scale = norm2 / (1 + norm2) / std::sqrt(norm2 + 1e-9);
      for (int d = 0; d < 3; ++d)
        capsules[j * 3 + d] *= scale;
    }
    if (t < 2)
      for (int i = 0; i < 6; ++i)
        for (int j = 0; j < 3; ++j)
          for (int d = 0; d < 3; ++d)
            logits[i * 3 + j] += votes[(i * 3 + j) * 3 + d] * capsules[j * 3 + d];
  }
  for (int i = 0; i < 9; ++i)
    error = std::max(error, std::abs(actual.capsules.reshape({9}).at({i}) - capsules[i]));
  if (error > 1e-12)
    return 1;
  auto layout = dm::graphics::RLayout::create(2, 2);
  std::vector<double> peak;
  for (int t = 0; t < 3; ++t) {
    const auto c = actual.history[t];
    if (n::max(n::abs(n::sum(c, {2}) - 1)).item() > 1e-12)
      return 1;
    peak.push_back(n::mean(n::max(c, {2})).item());
    layout.add(n::plot_tensor_map(n::reverse(c.reshape({6, 3}), {0}), 0, 1)
                   .title("Routing iteration " + std::to_string(t + 1))
                   .x_label("output capsule j")
                   .y_label("input capsule i")
                   .x_limits(-.5, 2.5)
                   .y_limits(-.5, 5.5));
  }
  auto concentration = dm::graphics::RPlot::create();
  concentration.lines({1, 2, 3}, peak, "mean row maximum", {37, 99, 235})
      .title("Observed coupling concentration")
      .x_label("routing iteration")
      .y_label("mean strongest output weight")
      .y_limits(0, 1.3);
  layout.add(concentration);
  std::filesystem::create_directories("build");
  layout.size(1200, 960).fit_panels().save_svg("build/capsule_networks_routing.svg");
  std::print("Three tensor routing iterations agree with stable host vote/squash/agreement "
             "oracle; maximum error {:.12f}. Couplings normalize over output capsules; this "
             "fixture's mean maxima are {:.6f}, {:.6f}, {:.6f}. Concentration is an "
             "observation, not a universal monotonicity guarantee.\n",
             error, peak[0], peak[1], peak[2]);
}
```
