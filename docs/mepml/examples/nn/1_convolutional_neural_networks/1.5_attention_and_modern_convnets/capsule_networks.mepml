```{cpp, results="markdown", file="figures/capsule_networks_training.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

int main() {
  int rendered_confusions = 0;
  namespace n             = dm::nn;
  n::set_num_threads(2);

  std::filesystem::path cache;
  if (const auto* p = std::getenv("DATAMUNGE_DATA_DIR"))
    cache = p;
  else if (const auto* p = std::getenv("XDG_CACHE_HOME"))
    cache = std::filesystem::path(p) / "datamunge/datasets";
  else
    cache = std::filesystem::path(std::getenv("HOME")) / ".cache/datamunge/datasets";
  dm::datasets::fetch("mnist", (cache / "mnist").string());

  const auto raw      = n::load_mnist((cache / "mnist").string(), "train"),
             official = n::load_mnist((cache / "mnist").string(), "test");
  const auto tx = n::slice_axis(raw.images, 0, 0, 64), ty = n::slice_axis(raw.labels, 0, 0, 64),
             vx = n::slice_axis(raw.images, 0, 64, 96), vy = n::slice_axis(raw.labels, 0, 64, 96),
             qx = n::slice_axis(official.images, 0, 0, 32),
             qy = n::slice_axis(official.labels, 0, 0, 32);
  n::ParameterStore p(17);
  {
    n::NoGradGuard guard;
    n::models::CapsNet(p, n::zeros({1, 28, 28, 1}), 3, true);
  }
  if (p.count() != 8215568)
    return 1;
  n::OptimizerConfig options;
  options.kind = n::OptimizerKind::Adam;
  n::Optimizer  optimizer(p, .001, options);
  n::BatchOrder batches(64, 8, 2026);
  std::filesystem::create_directories("build");
  const std::string   checkpoint = "build/capsule_networks_best_params.npz";
  double              best       = std::numeric_limits<double>::infinity();
  int                 best_epoch = 0;
  std::vector<double> epochs, train_nll, validation, margin_trace, reconstruction_trace;
  for (int epoch = 1; epoch <= 5; ++epoch) {
    batches.begin_epoch();
    n::WeightedMean nll_average, margin_average, reconstruction_average;
    for (auto rows = batches.next(); !rows.empty(); rows = batches.next()) {
      const auto images = n::take_rows(tx, rows), target = n::take_rows(ty, rows),
                 mask           = n::one_hot(target, 10);
      const auto out            = n::models::CapsNet(p, images, 3, true);
      const auto margin         = n::models::MarginLoss(out.lengths, mask);
      const auto reconstruction = n::mean(
          n::sum(n::square(out.reconstruct(mask) - images.reshape({images.size(0), 784})), {1}));
      // Fit margin + summed-pixel reconstruction + explicit kernel L2. NLL is monitoring/selection
      // only.
      auto objective = margin + .0005 * reconstruction;
      for (const auto& w : p.parameters())
        if (w.dim() >= 2)
          objective = objective + .00005 * n::sum(n::square(w));
      const double nll = n::sparse_softmax_cross_entropy(out.logits, target).item();
      optimizer.minimize(objective);
      nll_average.add(nll, rows.size());
      margin_average.add(margin.item(), rows.size());
      reconstruction_average.add(reconstruction.item(), rows.size());
    }
    n::NoGradGuard guard;
    const double   val =
        n::sparse_softmax_cross_entropy(n::models::CapsNet(p, vx, 3, true).logits, vy).item();
    if (!std::isfinite(val))
      return 1;
    epochs.push_back(epoch);
    train_nll.push_back(nll_average.value());
    validation.push_back(val);
    margin_trace.push_back(margin_average.value());
    reconstruction_trace.push_back(.0005 * reconstruction_average.value());
    if (val < best) {
      best       = val;
      best_epoch = epoch;
      p.save(checkpoint);
    }
  }
  p.load(checkpoint);
  n::NoGradGuard guard;
  const auto     selected = n::models::CapsNet(p, qx, 3, true);
  const double   test_nll = n::sparse_softmax_cross_entropy(selected.logits, qy).item(),
               fit_nll =
                   n::sparse_softmax_cross_entropy(n::models::CapsNet(p, tx, 3, true).logits, ty)
                       .item(),
               test_margin = n::models::MarginLoss(selected.lengths, n::one_hot(qy, 10)).item();
  if (!std::isfinite(test_nll))
    return 1;
  const auto   predicted_mask = n::one_hot(n::argmax(selected.logits, 1), 10);
  const double test_sse =
      n::mean(n::sum(n::square(selected.reconstruct(predicted_mask) - qx.reshape({32, 784})), {1}))
          .item();
  const auto confusion = n::matmul(n::transpose(n::one_hot(qy, 10), {1, 0}), predicted_mask);
  n::ConfusionMatrix::from_counts(confusion.to(n::DType::Int64))
      .save_svg(
          "build/capsule_networks_confusion_api_" + std::to_string(rendered_confusions++) + ".svg",
          {.title = "capsule networks / selected-checkpoint test counts"});

  if (n::sum(confusion).item() != 32)
    return 1;
  auto         score = dm::graphics::RPlot::create(), terms = dm::graphics::RPlot::create();
  const double score_high = 1.3 * std::max(
                                      *std::max_element(train_nll.begin(), train_nll.end()),
                                      *std::max_element(validation.begin(), validation.end()));
  score.lines(epochs, train_nll, "training NLL monitor", {37, 99, 235})
      .lines(epochs, validation, "validation NLL", {234, 88, 12})
      .title("Normalized capsule-length NLL")
      .x_label("epoch")
      .y_label("mean NLL")
      .y_limits(0, score_high);
  const double term_high =
      1.3 * std::max(
                *std::max_element(margin_trace.begin(), margin_trace.end()),
                *std::max_element(reconstruction_trace.begin(), reconstruction_trace.end()));
  terms.lines(epochs, margin_trace, "margin", {147, 51, 234})
      .lines(epochs, reconstruction_trace, ".0005 times pixel SSE", {16, 185, 129})
      .title("Optimized data terms; L2 additional")
      .x_label("epoch")
      .y_label("mean loss contribution")
      .y_limits(0, term_high);
  auto counts = n::plot_tensor_map(n::reverse(confusion, {0}), 0, n::max(confusion).item());
  counts.title("Test counts [0," + std::to_string(static_cast<int>(n::max(confusion).item())) + "]")
      .x_label("predicted class")
      .y_label("true class")
      .x_limits(-.5, 9.5)
      .y_limits(-.5, 9.5);
  auto magnitudes = dm::graphics::RPlot::create();
  magnitudes
      .lines(
          n::arange(0, 10).to_vector<double>(),
          n::mean(selected.lengths, {0}).to_vector<double>(),
          "mean test capsule length",
          {37, 99, 235})
      .title("Selected model: class capsule lengths")
      .x_label("digit capsule")
      .y_label("mean stabilized length")
      .y_limits(0, 1.3);
  dm::graphics::RLayout::create(2, 2)
      .add(score)
      .add(terms)
      .add(counts)
      .add(magnitudes)
      .size(1200, 980)
      .fit_panels()
      .save_svg("build/capsule_networks_training.svg");
  std::print(
      "64 fit /32 validation /32 official-test rows, {} learned scalars, {} explicit "
      "Adam updates. Selected epoch {}; validation NLL {:.6f}, inference fit NLL "
      "{:.6f}, test NLL {:.6f}, test accuracy {:.6f}, test margin {:.6f}, "
      "predicted-mask reconstruction SSE {:.6f}.\n",
      p.count(),
      optimizer.iterations(),
      best_epoch,
      best,
      fit_nll,
      test_nll,
      n::accuracy(selected.logits, qy),
      test_margin,
      test_sse);
}
```
// result_begin: markdown
64 fit /32 validation /32 official-test rows, 8215568 learned scalars, 40 explicit Adam updates. Selected epoch 5; validation NLL 1.166203, inference fit NLL 0.947312, test NLL 1.491150, test accuracy 0.750000, test margin 0.259784, predicted-mask reconstruction SSE 53.478485.
