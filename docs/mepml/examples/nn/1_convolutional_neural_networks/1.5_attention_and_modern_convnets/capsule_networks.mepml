> Regularized squash, margin and full topology

```{cpp, results="markdown", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

int main() {
  namespace n = dm::nn;
  const auto type = n::DType::Float64;
  const auto zero = n::zeros({2, 3, 4}, type).requires_grad_();
  const auto squashed = n::models::Squash(zero);
  if (n::max(n::abs(squashed)).item() != 0 ||
      n::max(n::abs(n::grad(n::sum(squashed), {zero})[0])).item() != 0)
    return 1;
  const auto lengths =
                 n::from_vector(std::vector<double>{.8, .2, .05}, {1, 3}).requires_grad_(),
             target = n::from_vector(std::vector<double>{1, 0, 0}, {1, 3});
  const auto loss = n::models::MarginLoss(lengths, target);
  const auto derivative = n::grad(loss, {lengths})[0];
  if (std::abs(loss.item() - .015) > 1e-15 || std::abs(derivative.at({0, 0}) + .2) > 1e-15 ||
      std::abs(derivative.at({0, 1}) - .1) > 1e-15 || derivative.at({0, 2}) != 0)
    return 1;
  n::set_num_threads(2);
  const auto x = (.5 + .5 * n::sin(.37 * n::arange(0, 2 * 28 * 28).to(n::DType::Float32)))
                     .reshape({2, 28, 28, 1});
  for (bool decoder : {false, true}) {
    n::ParameterStore p(17);
    const auto out = n::models::CapsNet(p, x, 3, decoder);
    if (p.count() != (decoder ? 8215568 : 6804224) ||
        out.primary.shape() != n::Shape{2, 1152, 8} ||
        out.digits.shape() != n::Shape{2, 10, 16})
      return 1;
    const auto mask = n::one_hot(n::tensor({1, 2}).to(n::DType::Int64), 10);
    auto objective = n::models::MarginLoss(out.lengths, mask);
    if (decoder) {
      const auto reconstructed = out.reconstruct(mask);
      if (reconstructed.shape() != n::Shape{2, 784})
        return 1;
      objective = objective +
                  .0005 * n::mean(n::sum(n::square(reconstructed - x.reshape({2, 784})), {1}));
    }
    const auto derivatives = n::grad(objective, p.parameters());
    for (const auto &d : derivatives)
      if (!std::isfinite(n::sum(n::abs(d)).item()))
        return 1;
    std::print(
        "Decoder={}: {} complete learned scalars, {} finite parameter-tensor gradients; "
        "primary1152x8, digit10x16, all three routing iterations retained.\n",
        decoder, p.count(), derivatives.size());
  }
  std::print("Zero-vector squash and its derivative are finite zero. Known margin .015 has "
             "length derivatives [-.2,.1,0]. Native finite differences verify both input "
             "capsules and vote weights through agreement iterations.\n");
}
```
// result_begin: markdown
Decoder=false: 6804224 complete learned scalars, 5 finite parameter-tensor gradients; primary1152x8, digit10x16, all three routing iterations retained.
Decoder=true: 8215568 complete learned scalars, 11 finite parameter-tensor gradients; primary1152x8, digit10x16, all three routing iterations retained.
Zero-vector squash and its derivative are finite zero. Known margin .015 has length derivatives [-.2,.1,0]. Native finite differences verify both input capsules and vote weights through agreement iterations.
// result_end

> Original digits and explicit optimization

```{cpp, results="markdown", file="figures/capsule_networks_inputs.png", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

int main() {
  namespace n = dm::nn;

  std::filesystem::path cache;
  if (const auto *p = std::getenv("DATAMUNGE_DATA_DIR"))
    cache = p;
  else if (const auto *p = std::getenv("XDG_CACHE_HOME"))
    cache = std::filesystem::path(p) / "datamunge/datasets";
  else
    cache = std::filesystem::path(std::getenv("HOME")) / ".cache/datamunge/datasets";
  dm::datasets::fetch("mnist", (cache / "mnist").string());

  const auto data = n::load_mnist((cache / "mnist").string(), "train");
  const auto images = data.images, labels = data.labels;

  std::vector<int64_t> rows;
  for (int cls = 0; cls < 10; ++cls) {
    for (int64_t row = 0; row < labels.numel(); ++row)
      if (labels.at({row}) == cls) {
        rows.push_back(row);
        break;
      }
  }
  if (rows.size() != 10)
    return 1;
  std::filesystem::create_directories("build");
  n::save_image_grid(n::take_rows(images, rows), "build/capsule_networks_inputs.png", 5, 0.,
                     1., 4, 1., 4);
  std::print("One original cached training image per class, IDs 0..4 then 5..9.\n");
}
```
