> Coordinate values and derivatives

```{cpp, results="markdown", file="figures/spatial_transformer_sampling.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

int main() {
  namespace n = dm::nn;
  const auto type = n::DType::Float64;
  const auto x = n::sin(.37 * n::arange(0, 9 * 9 * 2).to(type) + .2).reshape({1, 9, 9, 2});
  auto layout = dm::graphics::RLayout::create(2, 2);
  auto channel = [](const n::Tensor &t) {
    return n::slice_axis(t, 3, 0, 1).reshape({9, 9});
  };
  layout.add(n::plot_tensor_map(channel(x), -1, 1).title("Signed input channel 0"));
  for (int transform = 0; transform < 3; ++transform) {
    const auto theta =
        n::from_vector(transform == 0   ? std::vector<double>{1, 0, 0, 0, 1, 0}
                       : transform == 1 ? std::vector<double>{1, 0, .25, 0, 1, 0}
                                        : std::vector<double>{0, -1, 0, 1, 0, 0},
                       {1, 6});
    const auto y = n::models::AffineSample(x, theta, 9, 9);
    for (int row = 0; row < 9; ++row)
      for (int col = 0; col < 9; ++col)
        for (int ch = 0; ch < 2; ++ch) {
          const int r = transform == 2 ? col : row,
                    c = transform == 2 ? 8 - row : col + (transform == 1);
          const double expected =
              (r >= 0 && r < 9 && c >= 0 && c < 9) ? x.at({0, r, c, ch}) : 0;
          if (std::abs(y.at({0, row, col, ch}) - expected) > 1e-12)
            return 1;
        }
    layout.add(n::plot_tensor_map(channel(y), -1, 1)
                   .title(transform == 0   ? "Identity map"
                          : transform == 1 ? "Positive x map: sample one column right"
                                           : "Quarter-turn output-to-input map"));
  }
  const auto weights = n::sin(.31 * n::arange(0, 9 * 9 * 2).to(type) + .4).reshape(x.shape());
  const auto original =
      n::from_vector(std::vector<double>{.93, .11, .047, -.083, 1.06, -.031}, {1, 6});
  const auto theta = original.detach().requires_grad_();
  const auto derivative =
      n::grad(n::sum(n::models::AffineSample(x, theta, 9, 9) * weights), {theta})[0];
  double error = 0;
  {
    n::NoGradGuard guard;
    const double h = 1e-6;
    for (int i = 0; i < 6; ++i) {
      const auto direction =
          n::one_hot(n::from_vector(std::vector<int64_t>{i}), 6, 1, 0, type).reshape({1, 6});
      const double plus = n::sum(n::models::AffineSample(x, original + h * direction, 9, 9) *
                                 weights)
                              .item(),
                   minus = n::sum(n::models::AffineSample(x, original - h * direction, 9, 9) *
                                  weights)
                               .item();
      error = std::max(error, std::abs(derivative.at({0, i}) - (plus - minus) / (2 * h)));
    }
  }
  if (error > 1e-7)
    return 1;
  std::filesystem::create_directories("build");
  layout.size(1200, 960).fit_panels().save_svg("build/spatial_transformer_sampling.svg");
  std::print("Aligned-corners identity/one-pixel translation/quarter turn match pixel oracles "
             "to 1e-12. All six generic affine derivatives match central differences; max "
             "absolute error {:.12f}. Fractional test points avoid integer boundaries.\n",
             error);
}
```
