> Full topology and initialization gradients

```{cpp, results="markdown", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

int main() {
  namespace n = dm::nn;
  const auto type = n::DType::Float64;
  n::ParameterStore p(17, type);
  const auto x =
      (.5 + .3 * n::sin(.37 * n::arange(0, 2 * 42 * 42).to(type))).reshape({2, 42, 42, 1});
  const auto initial = n::models::SpatialTransformer(p, "stn", x);
  const auto identity = n::from_vector(std::vector<double>{1, 0, 0, 0, 1, 0}, {1, 6});
  if (p.count() != 131896 || n::max(n::abs(initial.theta - identity)).item() != 0 ||
      n::max(n::abs(initial.output - x)).item() > 1e-12)
    return 1;
  const auto gradients = n::grad(n::mean(n::square(initial.output)), p.parameters());
  const auto names = p.names();
  double head = 0;
  for (size_t i = 0; i < gradients.size(); ++i) {
    const double norm = n::sum(n::abs(gradients[i])).item();
    if (names[i].find("/theta/") == std::string::npos && norm != 0)
      return 1;
    if (names[i].find("/theta/") != std::string::npos)
      head += norm;
  }
  if (head == 0)
    return 1;
  n::set_num_threads(2);
  for (bool transformer : {false, true}) {
    n::ParameterStore model(17);
    const auto out =
        n::models::StnMnistClassifier(model, x.to(n::DType::Float32), transformer);
    if (model.count() != (transformer ? 1176642 : 1044746) ||
        out.logits.shape() != n::Shape{2, 10})
      return 1;
    const auto derivatives = n::grad(n::mean(n::square(out.logits)), model.parameters());
    for (const auto &d : derivatives)
      if (!std::isfinite(n::sum(n::abs(d)).item()))
        return 1;
    std::print(
        "Transformer={}: {} full learned scalars, {} finite parameter-tensor gradients.\n",
        transformer, model.count(), derivatives.size());
  }
  std::print(
      "Localization has 131896 scalars at 42 pixels. Its zero-weight identity head initially "
      "blocks interior localization gradients; head derivatives are nonzero, and native tests "
      "activate the head to check interior gradients. No moving BN state exists.\n");
}
```
// result_begin: markdown
Transformer=false: 1044746 full learned scalars, 8 finite parameter-tensor gradients.
Transformer=true: 1176642 full learned scalars, 16 finite parameter-tensor gradients.
Localization has 131896 scalars at 42 pixels. Its zero-weight identity head initially blocks interior localization gradients; head derivatives are nonzero, and native tests activate the head to check interior gradients. No moving BN state exists.
// result_end

> Original and tensor-distorted data

```{cpp, results="markdown", file="figures/spatial_transformer_inputs.png", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

int main() {
  namespace n = dm::nn;

  std::filesystem::path cache;
  if (const auto *p = std::getenv("DATAMUNGE_DATA_DIR"))
    cache = p;
  else if (const auto *p = std::getenv("XDG_CACHE_HOME"))
    cache = std::filesystem::path(p) / "datamunge/datasets";
  else
    cache = std::filesystem::path(std::getenv("HOME")) / ".cache/datamunge/datasets";
  dm::datasets::fetch("mnist", (cache / "mnist").string());

  const auto data = n::load_mnist((cache / "mnist").string(), "train");
  const auto images = data.images, labels = data.labels;

  std::vector<int64_t> rows;
  for (int cls = 0; cls < 10; ++cls) {
    for (int64_t row = 0; row < labels.numel(); ++row)
      if (labels.at({row}) == cls) {
        rows.push_back(row);
        break;
      }
  }
  if (rows.size() != 10)
    return 1;
  std::filesystem::create_directories("build");
  n::save_image_grid(n::take_rows(images, rows), "build/spatial_transformer_inputs.png", 5, 0.,
                     1., 4, 1., 4);
  std::print("One original cached training image per class, IDs 0..4 then 5..9.\n");
}
```
