> Visible paired optimization

```{cpp, results="markdown", file="figures/spatial_transformer_training.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

int main() {
  int rendered_confusions = 0;
  namespace n             = dm::nn;
  n::set_num_threads(2);

  std::filesystem::path cache;
  if (const auto* p = std::getenv("DATAMUNGE_DATA_DIR"))
    cache = p;
  else if (const auto* p = std::getenv("XDG_CACHE_HOME"))
    cache = std::filesystem::path(p) / "datamunge/datasets";
  else
    cache = std::filesystem::path(std::getenv("HOME")) / ".cache/datamunge/datasets";
  dm::datasets::fetch("mnist", (cache / "mnist").string());

  const auto raw      = n::load_mnist((cache / "mnist").string(), "train"),
             official = n::load_mnist((cache / "mnist").string(), "test");
  n::Generator development_rng(101), test_rng(202);
  const auto   development =
      n::models::DistortMnist(n::slice_axis(raw.images, 0, 0, 192), development_rng).images;
  const auto test =
      n::models::DistortMnist(n::slice_axis(official.images, 0, 0, 64), test_rng).images;
  const auto tx = n::slice_axis(development, 0, 0, 128), ty = n::slice_axis(raw.labels, 0, 0, 128),
             vx                           = n::slice_axis(development, 0, 128, 192),
             vy                           = n::slice_axis(raw.labels, 0, 128, 192),
             qy                           = n::slice_axis(official.labels, 0, 0, 64);
  auto                             layout = dm::graphics::RLayout::create(2, 2);
  std::vector<dm::graphics::RPlot> counts;
  for (bool transformer : {false, true}) {
    n::ParameterStore p(17);
    auto              forward = [&](const n::Tensor& images) {
      return n::models::StnMnistClassifier(p, images, transformer);
    };
    {
      n::NoGradGuard guard;
      forward(n::zeros({1, 42, 42, 1}));
    }
    if (p.count() != (transformer ? 1176642 : 1044746))
      return 1;
    n::OptimizerConfig options;
    options.kind = n::OptimizerKind::Adam;
    n::Optimizer  optimizer(p, .001, options);
    n::BatchOrder batches(128, 8, 2026);
    std::filesystem::create_directories("build");
    const std::string   checkpoint = transformer ? "build/spatial_transformer_stn_best.npz"
                                                 : "build/spatial_transformer_base_best.npz";
    double              best       = std::numeric_limits<double>::infinity();
    int                 best_epoch = 0;
    std::vector<double> epochs, train, validation;
    for (int epoch = 1; epoch <= 6; ++epoch) {
      batches.begin_epoch();
      n::WeightedMean average;
      for (auto rows = batches.next(); !rows.empty(); rows = batches.next()) {
        const auto input = n::take_rows(tx, rows), target = n::take_rows(ty, rows);
        const auto nll       = n::sparse_softmax_cross_entropy(forward(input).logits, target);
        auto       objective = nll;
        for (const auto& w : p.parameters())
          if (w.dim() >= 2)
            objective = objective + .00005 * n::sum(n::square(w));
        optimizer.minimize(objective);
        average.add(nll.item(), rows.size());
      }
      n::NoGradGuard guard;
      const double   val = n::sparse_softmax_cross_entropy(forward(vx).logits, vy).item();
      if (!std::isfinite(val))
        return 1;
      epochs.push_back(epoch);
      train.push_back(average.value());
      validation.push_back(val);
      if (val < best) {
        best       = val;
        best_epoch = epoch;
        p.save(checkpoint);
      }
    }
    p.load(checkpoint);
    n::NoGradGuard guard;
    const auto     predicted = forward(test);
    const double   test_nll  = n::sparse_softmax_cross_entropy(predicted.logits, qy).item(),
                 fit_nll     = n::sparse_softmax_cross_entropy(forward(tx).logits, ty).item();
    if (!std::isfinite(test_nll))
      return 1;
    const auto confusion = n::matmul(
        n::transpose(n::one_hot(qy, 10), {1, 0}), n::one_hot(n::argmax(predicted.logits, 1), 10));
    n::ConfusionMatrix::from_counts(confusion.to(n::DType::Int64))
        .save_svg(
            "build/spatial_transformer_confusion_api_" + std::to_string(rendered_confusions++) +
                ".svg",
            {.title = "spatial transformer / selected-checkpoint test counts"});

    if (n::sum(confusion).item() != 64)
      return 1;
    auto         trace = dm::graphics::RPlot::create();
    const double high  = 1.3 * std::max(
                                  *std::max_element(train.begin(), train.end()),
                                  *std::max_element(validation.begin(), validation.end()));
    trace.lines(epochs, train, "training NLL", {37, 99, 235})
        .lines(epochs, validation, "validation NLL", {234, 88, 12})
        .title(transformer ? "Learned transformer plus full CNN" : "Baseline full CNN")
        .x_label("epoch")
        .y_label("mean NLL")
        .y_limits(0, high);
    layout.add(trace);
    counts.push_back(
        n::plot_tensor_map(n::reverse(confusion, {0}), 0, n::max(confusion).item())
            .title(
                std::string(transformer ? "STN" : "Baseline") + " test counts [0," +
                std::to_string(static_cast<int>(n::max(confusion).item())) + "]")
            .x_label("predicted class")
            .y_label("true class")
            .x_limits(-.5, 9.5)
            .y_limits(-.5, 9.5));
    std::print(
        "Transformer={}: {} learned scalars, {} explicit Adam updates; selected epoch "
        "{}, validation NLL {:.6f}, inference fit NLL {:.6f}, test NLL {:.6f}, test "
        "accuracy {:.6f}.\n",
        transformer,
        p.count(),
        optimizer.iterations(),
        best_epoch,
        best,
        fit_nll,
        test_nll,
        n::accuracy(predicted.logits, qy));
    if (transformer) {
      const double blank =
          n::mean(
              n::less_equal(n::mean(n::abs(predicted.transformed), {1, 2, 3}), 1e-5)
                  .to(n::DType::Float32))
              .item();
      std::print(
          "Selected STN fraction of64 test images with mean absolute warped intensity "
          "<=1e-5: {:.6f}.\n",
          blank);
    }
  }
  for (const auto& count : counts)
    layout.add(count);
  layout.size(1200, 980).fit_panels().save_svg("build/spatial_transformer_training.svg");
}
```
// result_begin: markdown
