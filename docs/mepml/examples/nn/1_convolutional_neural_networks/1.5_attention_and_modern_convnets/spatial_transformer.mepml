```{cpp, results="markdown", file="figures/spatial_transformer_distorted.png", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

int main() {
  namespace n = dm::nn;

  std::filesystem::path cache;
  if (const auto *p = std::getenv("DATAMUNGE_DATA_DIR"))
    cache = p;
  else if (const auto *p = std::getenv("XDG_CACHE_HOME"))
    cache = std::filesystem::path(p) / "datamunge/datasets";
  else
    cache = std::filesystem::path(std::getenv("HOME")) / ".cache/datamunge/datasets";
  dm::datasets::fetch("mnist", (cache / "mnist").string());

  const auto data = n::load_mnist((cache / "mnist").string(), "train");
  const auto source = n::slice_axis(data.images, 0, 0, 192),
             labels = n::slice_axis(data.labels, 0, 0, 192);
  n::Generator generator(101);
  const auto distorted = n::models::DistortMnist(source, generator);
  std::vector<int64_t> rows;
  for (int digit = 0; digit < 10; ++digit) {
    bool found = false;
    for (int row = 0; row < 192; ++row)
      if (labels.at({row}) == digit) {
        rows.push_back(row);
        found = true;
        break;
      }
    if (!found)
      return 1;
  }
  std::filesystem::create_directories("build");
  n::save_image_grid(n::take_rows(distorted.images, rows),
                     "build/spatial_transformer_distorted.png", 5, 0., 1., 4, 1., 3);
  std::print("Tensor-generated 42x42 distorted MNIST, seed101 on the same first192 "
             "development rows as fitting. Class IDs0-4 then5-9. Angles +/-45 degrees, zoom "
             ".7-1.2, room-limited translations; normalized uint8-like output. Tensor RNG "
             "differs from the legacy interleaved host sequence.\n");
}
```
