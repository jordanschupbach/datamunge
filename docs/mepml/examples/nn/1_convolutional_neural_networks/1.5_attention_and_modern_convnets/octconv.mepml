> Arithmetic and feature storage

```{cpp, results="markdown", file="figures/octconv_ratios.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

int main() {
  namespace n = dm::nn;
  std::vector<double> alpha, measured, theory, storage;
  for (double a : {0., .125, .25, .5, .75}) {
    n::NoGradGuard guard;
    n::ParameterStore p(17);
    const int low = n::models::LowChannels(16, a), high = 16 - low;
    n::models::OctaveMaps x{n::ones({1, 8, 8, high}),
                            low ? n::ones({1, 4, 4, low}) : n::Tensor(), high, low};
    n::models::OctaveCost cost;
    const auto y = n::models::OctaveConv(p, "o", x, 16, a, 3, 1, 8, &cost);
    const double fraction = double(cost.macs) / (8 * 8 * 9 * 16 * 16),
                 bytes = double(y.high.numel() + (low ? y.low.numel() : 0)) / (8 * 8 * 16);
    if (std::abs(fraction - (1 - .75 * a * (2 - a))) > 1e-12 ||
        std::abs(bytes - (1 - .75 * a)) > 1e-12 || p.count() != 2304)
      return 1;
    alpha.push_back(a);
    measured.push_back(fraction);
    theory.push_back(1 - .75 * a * (2 - a));
    storage.push_back(bytes);
  }
  auto work = dm::graphics::RPlot::create(), memory = dm::graphics::RPlot::create();
  work.lines(alpha, measured, "logged path MACs", {37, 99, 235})
      .lines(alpha, theory, "analytic ratio", {234, 88, 12})
      .title("Equal input/output split: spatial work")
      .x_label("low-channel fraction alpha")
      .y_label("MAC ratio")
      .y_limits(0, 1.35);
  memory.lines(alpha, storage, "feature scalars", {147, 51, 234})
      .title("High plus low feature storage")
      .x_label("low-channel fraction alpha")
      .y_label("scalar ratio")
      .y_limits(0, 1.35);
  std::filesystem::create_directories("build");
  dm::graphics::RLayout::create(1, 2)
      .add(work)
      .add(memory)
      .size(1200, 500)
      .fit_panels()
      .save_svg("build/octconv_ratios.svg");
  std::print("For integer-exact splits at stride one, logged MAC ratio = "
             "1-.75*alpha*(2-alpha), feature-scalar ratio = 1-.75*alpha; kernel count stays "
             "2304. These are arithmetic/storage counts, not measured runtime.\n");
}
```
