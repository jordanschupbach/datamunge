> Corrected merge and full-width budgets

```{cpp, results="markdown", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

int main() {
  namespace n = dm::nn;
  const auto type = n::DType::Float64;
  n::ParameterStore p(17, type);
  const n::models::OctaveMaps x{
      n::sin(.1 * n::arange(0, 14 * 14 * 6).to(type)).reshape({1, 14, 14, 6}),
      n::sin(.2 * n::arange(0, 7 * 7 * 2).to(type)).reshape({1, 7, 7, 2}), 6, 2};
  n::models::OctaveCost cost;
  const auto out = n::models::OctaveConv(p, "merge", x, 8, 0, 1, 2, 14, &cost);
  const auto ref =
      n::conv2d(n::avg_pool2d(x.high, 2, 2, n::Padding::Valid), p.at("merge/hh/W")) +
      n::conv2d(x.low, p.at("merge/lh/W"));
  if (out.high.shape() != n::Shape{1, 7, 7, 8} || out.low.defined() ||
      n::max(n::abs(out.high - ref)).item() > 1e-12 || cost.macs != 3136)
    return 1;
  std::print("Corrected high-only stride-two merge: 14x14 high and 7x7 low become one 7x7 "
             "map. LH reads unpooled low features directly; no pooling/upsampling mismatch. "
             "3136 MACs for this 1x1 eight-to-eight fixture.\n");
  n::set_num_threads(2);
  n::NoGradGuard guard;
  for (double a : {0., .125, .25, .5, .75}) {
    n::ParameterStore full(19), state(19);
    n::models::OctResNetConfig cfg;
    cfg.alpha = a;
    const auto net = n::models::OctResNet(full, state, n::zeros({1, 64, 64, 3}), cfg);
    if (full.count() != 25557032 || net.features.shape() != n::Shape{1, 2, 2, 2048} ||
        (a == 0 && net.macs != 4089184256))
      return 1;
    std::print("Full Oct-ResNet-50 alpha {}: {} actual parameters at 64 pixels; corrected "
               "nominal 224-pixel budget {} MACs.\n",
               a, full.count(), net.macs);
    if (a == .25) {
      const auto actual = n::models::OctResNet(full, state, n::zeros({1, 224, 224, 3}), cfg);
      if (actual.features.shape() != n::Shape{1, 7, 7, 2048})
        return 1;
      std::print("Alpha .25 also executes a real 224-pixel forward, including the corrected "
                 "final shortcut.\n");
    }
  }
}
```
