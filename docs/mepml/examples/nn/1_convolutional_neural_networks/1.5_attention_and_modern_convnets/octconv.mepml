> Complete compact backward

```{cpp, results="markdown", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

int main() {
  namespace n = dm::nn;
  n::set_num_threads(2);
  n::ParameterStore p(17), state(17);
  n::models::OctResNetConfig cfg;
  cfg.classes = 10;
  cfg.width_divisor = 4;
  cfg.small_stem = true;
  cfg.image_size = 32;
  cfg.update_stats = false;
  const auto x = n::sin(.37 * n::arange(0, 2 * 32 * 32 * 3).to(n::DType::Float32))
                     .reshape({2, 32, 32, 3});
  {
    n::NoGradGuard guard;
    n::models::OctResNet(p, state, x, cfg);
  }
  const auto before = state.flatten();
  const auto out = n::models::OctResNet(p, state, x, cfg, true);
  if (p.count() != 1484186 || out.features.shape() != n::Shape{2, 4, 4, 512})
    return 1;
  const auto gradients = n::grad(n::mean(n::square(out.logits)), p.parameters());
  double low = std::numeric_limits<double>::infinity(), high = 0;
  for (const auto &g : gradients) {
    const double norm = n::sqrt(n::sum(n::square(g))).item();
    if (!std::isfinite(norm))
      return 1;
    low = std::min(low, norm);
    high = std::max(high, norm);
  }
  if (high == 0 || before != state.flatten())
    return 1;
  std::print("All sixteen compact Oct-ResNet-50 bottlenecks retained: {} finite "
             "parameter-tensor gradients, norms [{:.12f},{:.9f}], both stream moving moments "
             "frozen; nominal 32-pixel budget {} MACs.\n",
             gradients.size(), low, high, out.macs);
}
```
// result_begin: markdown
All sixteen compact Oct-ResNet-50 bottlenecks retained: 369 finite parameter-tensor gradients, norms [0.043716400862,87.430145264], both stream moving moments frozen; nominal 32-pixel budget 60081152 MACs.
