> Isolating the sampling geometry

```{cpp, results="markdown", file="figures/deformable_conv_sampling.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

int main() {
  namespace n = dm::nn;
  const auto type = n::DType::Float64;
  const auto x = n::arange(0, 49).to(type).reshape({1, 7, 7, 1});
  auto layout = dm::graphics::RLayout::create(2, 2);
  n::ParameterStore p(17, type);
  {
    n::NoGradGuard guard;
    n::models::DeformableConv2D(p, "d", x, 1, 3, 1, false);
    p.set("d/W",
          n::one_hot(n::tensor({4}).to(n::DType::Int64), 9, 1, 0, type).reshape({3, 3, 1, 1}));
  }
  const auto plain = n::models::DeformableConv2D(p, "d", x, 1, 3, 1, false).output;
  if (n::max(n::abs(plain - x)).item() != 0)
    return 1;
  layout.add(n::plot_tensor_map(plain.reshape({7, 7}), 0, 48)
                 .title("Zero offset: centre-tap identity"));
  n::ParameterStore q(17, type);
  {
    n::NoGradGuard guard;
    n::models::DeformableConv2D(q, "m", x, 1, 3, 1, true);
    q.set("m/W", p.at("d/W"));
  }
  const auto half = n::models::DeformableConv2D(q, "m", x, 1, 3, 1, true).output;
  if (n::max(n::abs(half - .5 * x)).item() != 0)
    return 1;
  layout.add(n::plot_tensor_map(half.reshape({7, 7}), 0, 48)
                 .title("V2 initial mask: half amplitude"));
  for (auto [dy, dx] : std::vector<std::pair<double, double>>{{1, 0}, {.4, -.3}}) {
    p.set("d/offset/b",
          (n::ones({9, 2}, type) * n::from_vector(std::vector<double>{dy, dx})).reshape({18}));
    const auto shifted = n::models::DeformableConv2D(p, "d", x, 1, 3, 1, false).output;
    layout.add(
        n::plot_tensor_map(shifted.reshape({7, 7}), 0, 48)
            .title(dy==1?"Integer shift (1,0)":"Fractional shift (.4,-.3)"));
  }
  std::filesystem::create_directories("build");
  layout.size(1200, 960).fit_panels().save_svg("build/deformable_conv_sampling.svg");
  std::print("Centre-only kernel isolates sampling. V1 starts at identity; v2 starts at half "
             "amplitude. Bias-predicted integer/fractional shifts use dy/dx order and "
             "bilinear zero-extension.\n");
}
```
