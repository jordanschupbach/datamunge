> Independent oracle and fractional derivatives

```{cpp, results="markdown", file="figures/deformable_conv_derivatives.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

int main() {
  namespace n = dm::nn;
  const auto type = n::DType::Float64;
  n::ParameterStore p(17, type);
  const auto x = n::sin(.37 * n::arange(0, 7 * 7 * 2).to(type)).reshape({1, 7, 7, 2});
  {
    n::NoGradGuard guard;
    n::models::DeformableConv2D(p, "d", x, 3, 3, 1, false);
    const auto pattern = .37 + .9 * n::sin(1.7 * n::arange(0, 18).to(type));
    p.set("d/offset/b", n::floor(pattern) + .2 + .6 * (pattern - n::floor(pattern)));
  }
  const auto out = n::models::DeformableConv2D(p, "d", x, 3, 3, 1, false);
  const auto values = x.to_vector<double>(), weights = p.at("d/W").to_vector<double>(),
             offsets = p.at("d/offset/b").to_vector<double>();
  // Independent host bilinear oracle; production sampling and offset prediction are tensors.
  auto sample = [&](double y, double z, int c) {
    const int y0 = int(std::floor(y)), x0 = int(std::floor(z));
    double result = 0;
    for (int dy = 0; dy < 2; ++dy)
      for (int dx = 0; dx < 2; ++dx) {
        const int yy = y0 + dy, xx = x0 + dx;
        if (yy >= 0 && yy < 7 && xx >= 0 && xx < 7)
          result += (dy ? y - y0 : 1 - y + y0) * (dx ? z - x0 : 1 - z + x0) *
                    values[(yy * 7 + xx) * 2 + c];
      }
    return result;
  };
  double value_error = 0;
  for (int y = 0; y < 7; ++y)
    for (int z = 0; z < 7; ++z)
      for (int o = 0; o < 3; ++o) {
        double ref = 0;
        for (int k = 0; k < 9; ++k)
          for (int c = 0; c < 2; ++c)
            ref +=
                sample(y - 1 + k / 3 + offsets[2 * k], z - 1 + k % 3 + offsets[2 * k + 1], c) *
                weights[(k * 2 + c) * 3 + o];
        value_error = std::max(value_error, std::abs(out.output.at({0, y, z, o}) - ref));
      }
  const auto derivative =
      n::grad(n::sum(n::square(out.output)), {p.at("d/offset/b")})[0].to_vector<double>();
  std::vector<double> numeric;
  n::NoGradGuard guard;
  const double h = 1e-5;
  double error = 0;
  for (int k = 0; k < 18; ++k) {
    auto plus = offsets, minus = offsets;
    plus[k] += h;
    minus[k] -= h;
    p.set("d/offset/b", n::from_vector(plus));
    const double a =
        n::sum(n::square(n::models::DeformableConv2D(p, "d", x, 3, 3, 1, false).output))
            .item();
    p.set("d/offset/b", n::from_vector(minus));
    const double b =
        n::sum(n::square(n::models::DeformableConv2D(p, "d", x, 3, 3, 1, false).output))
            .item();
    numeric.push_back((a - b) / (2 * h));
    error = std::max(error, std::abs(derivative[k] - numeric.back()));
  }
  if (value_error > 1e-12 || error > 1e-7)
    return 1;
  auto plot = dm::graphics::RPlot::create();
  plot.lines(n::arange(0, 18).to_vector<double>(), derivative, "autograd", {37, 99, 235})
      .lines(n::arange(0, 18).to_vector<double>(), numeric, "central differences",
             {234, 88, 12})
      .title("All eighteen offset-bias derivatives")
      .x_label("dy/dx tap coordinate index")
      .y_label("d sum(output squared) / db");
  std::filesystem::create_directories("build");
  dm::graphics::RLayout::create(1, 1).add(plot).size(1050, 520).fit_panels().save_svg(
      "build/deformable_conv_derivatives.svg");
  std::print("Float64 fractional sampling: maximum independent-oracle value error {:.12f}; "
             "all eighteen offset derivatives match central differences, maximum absolute "
             "error {:.12f}. Coordinates stay away from integer boundaries.\n",
             value_error, error);
}
```
