> All blocks and deformable predictors

```{cpp, results="markdown", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

int main() {
  namespace n = dm::nn;
  n::set_num_threads(2);
  for (bool modulated : {false, true}) {
    n::ParameterStore p(17), state(17);
    n::models::AttentionResNetConfig cfg;
    cfg.classes = 10;
    cfg.width_divisor = 4;
    cfg.small_stem = true;
    cfg.stride_on_3x3 = false;
    cfg.deformable_from = 3;
    cfg.modulated = modulated;
    cfg.update_stats = false;
    const auto x = n::sin(.37 * n::arange(0, 2 * 32 * 32 * 3).to(n::DType::Float32))
                       .reshape({2, 32, 32, 3});
    const auto out = n::models::AttentionResNet(p, state, x, cfg, true);
    const int64_t maps = modulated ? 27 : 18, expected = 1484186 + 6 * (9 * 64 * maps + maps) +
                                                         3 * (9 * 128 * maps + maps);
    if (p.count() != expected || out.blocks.size() != 16 ||
        out.features.shape() != n::Shape{2, 4, 4, 512})
      return 1;
    const auto gradients = n::grad(n::mean(n::square(out.logits)), p.parameters());
    for (const auto &g : gradients)
      if (!std::isfinite(n::sum(n::abs(g)).item()))
        return 1;
    std::print("Quarter-width ResNet-50, deformable v{} in all nine stage-3/4 spatial "
               "filters: {} learned scalars, {} finite parameter-tensor gradients; all "
               "sixteen blocks and final 4x4x512 geometry retained.\n",
               modulated ? 2 : 1, p.count(), gradients.size());
  }
}
```
