> Complete full-width topology

```{cpp, results="markdown", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

int main() {
  namespace n = dm::nn;
  n::set_num_threads(2);
  n::ParameterStore p(17), state(17);
  n::models::AttentionResNetConfig cfg;
  cfg.update_stats = false;
  cfg.after_block = n::models::NonLocalResNetHook(.9, false);
  {
    n::NoGradGuard guard;
    const auto out = n::models::AttentionResNet(p, state, n::zeros({1, 64, 64, 3}), cfg);
    if (p.count() != 32915496 || out.blocks.size() != 16)
      return 1;
    int modules = 0;
    for (const auto &name : p.names()) {
      if (name.ends_with("non_local/bn/gamma")) {
        ++modules;
        p.set(name, n::full(p.at(name).shape(), .2));
      } else if (name.ends_with("/beta"))
        p.set(name, (.5 * n::sin(.37 * n::arange(0, p.at(name).numel()).to(n::DType::Float32) +
                                 double(name.size())))
                        .reshape(p.at(name).shape()));
    }
    if (modules != 5)
      return 1;
  }
  const auto x = n::sin(.37 * n::arange(0, 2 * 64 * 64 * 3).to(n::DType::Float32))
                     .reshape({2, 64, 64, 3});
  const auto before = state.flatten();
  const auto out = n::models::AttentionResNet(p, state, x, cfg, true);
  const auto gradients = n::grad(n::mean(n::square(out.logits)), p.parameters());
  double low = std::numeric_limits<double>::infinity(), high = 0;
  for (const auto &g : gradients) {
    const double norm = n::sqrt(n::sum(n::square(g))).item();
    if (!std::isfinite(norm))
      return 1;
    low = std::min(low, norm);
    high = std::max(high, norm);
  }
  if (high == 0 || state.flatten() != before)
    return 1;
  std::print(
      "Full-width ResNet-50 plus five active non-local blocks at 64 pixels: {} learned "
      "scalars, {} finite parameter-tensor derivatives, norm range [{:.12f},{:.9f}], all "
      "moving state frozen. No claim that bias-shift invariances have nonzero gradients.\n",
      p.count(), gradients.size(), low, high);
}
```
