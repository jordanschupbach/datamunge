> Identity start and global support

```{cpp, results="markdown", file="figures/non_local_support.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

int main() {
  namespace n = dm::nn;
  const auto type = n::DType::Float64;
  auto layout = dm::graphics::RLayout::create(1, 2);
  for (auto mode : {n::models::Pairwise::kGaussian, n::models::Pairwise::kEmbeddedGaussian,
                    n::models::Pairwise::kDotProduct}) {
    n::ParameterStore p(17, type), state(17, type);
    const auto x = n::sin(.37 * n::arange(0, 5 * 5 * 4).to(type) + .2)
                       .reshape({1, 5, 5, 4})
                       .detach()
                       .requires_grad_();
    const auto fresh = n::models::NonLocalBlock(p, state, "nl", x, mode, false, false);
    if (n::max(n::abs(fresh.output - x)).item() != 0 ||
        n::max(n::abs(n::grad(n::sum(fresh.output), {x})[0] - 1)).item() != 0)
      return 1;
    p.set("nl/bn/gamma", n::ones({4}, type));
    const auto active = n::models::NonLocalBlock(p, state, "nl", x, mode, false, false);
    const auto picked = n::slice(active.output, {0, 2, 2, 0}, {1, 1, 1, 4});
    const auto derivative = n::grad(n::sum(picked), {x})[0];
    const auto mass = n::sum(n::abs(derivative), {0, 3}),
               support = n::greater(mass, 1e-14).to(type);
    if (n::count_nonzero(support).item() != 25)
      return 1;
    if (mode == n::models::Pairwise::kEmbeddedGaussian) {
      layout
          .add(n::plot_tensor_map(mass, 0, n::max(mass).item())
                   .title("One output pixel: derivative mass"))
          .add(n::plot_tensor_map(support, 0, 1).title("Binary support: 25 of 25 sites"));
    }
  }
  std::filesystem::create_directories("build");
  layout.size(1200, 500).fit_panels().save_svg("build/non_local_support.svg");
  std::print("Fresh zero-gamma blocks preserve signed input and exact identity derivatives. "
             "Active Gaussian/embedded/dot fixtures each reach every one of 25 sites. Max "
             "pooling and concatenation ReLU need separate sparsity reasoning.\n");
}
```
