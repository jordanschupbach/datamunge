> Full Tiny backward

```{cpp, results="markdown", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

int main() {
  namespace n = dm::nn;
  n::set_num_threads(2);
  n::ParameterStore p(17);
  n::models::ConvNeXtConfig cfg;
  cfg.v2 = false;
  {
    n::NoGradGuard guard;
    n::models::ConvNeXt(p, n::zeros({1, 32, 32, 3}), cfg);
    for (const auto &name : p.names()) {
      if (name.ends_with("/layer_scale"))
        p.set(name, n::ones(p.at(name).shape()));
      if (name.find("/grn/") != std::string::npos)
        p.set(name,
              (.1 + .1 * n::sin(.37 * n::arange(0, p.at(name).numel()).to(n::DType::Float32)))
                  .reshape(p.at(name).shape()));
    }
  }
  const auto input = n::sin(.37 * n::arange(0, 2 * 64 * 64 * 3).to(n::DType::Float32))
                         .reshape({2, 64, 64, 3});
  const auto out = n::models::ConvNeXt(p, input, cfg, true);
  const auto gradients = n::grad(n::mean(n::square(out.logits)), p.parameters());
  double low = std::numeric_limits<double>::infinity(), high = 0;
  for (const auto &g : gradients) {
    const double norm = n::sqrt(n::sum(n::square(g))).item();
    if (!std::isfinite(norm))
      return 1;
    low = std::min(low, norm);
    high = std::max(high, norm);
  }
  if (low <= 1e-7 * high)
    return 1;
  std::print("Full-width Tiny V1, all eighteen blocks at 64 pixels: {} finite "
             "parameter-tensor gradients, norm range [{:.12f},{:.9f}]. V1 probe uses unit "
             "layer scales.\n",
             gradients.size(), low, high);
}
```
