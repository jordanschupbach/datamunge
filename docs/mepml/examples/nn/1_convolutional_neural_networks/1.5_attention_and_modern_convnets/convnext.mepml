> Small block and derivatives

```{cpp, results="markdown", file="figures/convnext_block.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

int main() {
  namespace n = dm::nn;
  const auto type = n::DType::Float64;
  n::ParameterStore p(17, type);
  const auto x = n::sin(.17 * n::arange(0, 11 * 11 * 8).to(type) + .2)
                     .reshape({1, 11, 11, 8})
                     .detach()
                     .requires_grad_();
  const auto initial = n::models::ConvNeXtBlock(p, "b", x, false, false);
  const double change = n::max(n::abs(initial.output - x)).item();
  if (change > 1e-4)
    return 1;
  const auto correction = 1e6 * (initial.output - x);
  {
    n::NoGradGuard guard;
    p.set("b/layer_scale", n::ones({8}, type));
  }
  const auto active = n::models::ConvNeXtBlock(p, "b", x, false, false);
  const auto picked = n::slice(active.branch, {0, 5, 5, 0}, {1, 1, 1, 8});
  const auto support =
      n::greater(n::sum(n::abs(n::grad(n::sum(picked), {x})[0]), {0, 3}), 1e-15).to(type);
  if (n::count_nonzero(support).item() != 49)
    return 1;
  {
    n::NoGradGuard guard;
    p.set("b/layer_scale", n::zeros({8}, type));
  }
  const auto identity = n::models::ConvNeXtBlock(p, "b", x, false, false);
  if (n::max(n::abs(identity.output - x)).item() != 0 ||
      n::max(n::abs(n::grad(n::sum(identity.output), {x})[0] - 1)).item() != 0)
    return 1;
  auto map = [](const n::Tensor &t) {
    return n::slice_axis(t, 3, 0, 1).reshape({11, 11});
  };
  const double high = std::max(1e-12, n::max(n::abs(correction)).item());
  auto curve = dm::graphics::RPlot::create();
  curve
      .lines(n::arange(0, 8).to_vector<double>(), p.at("b/layer_scale").to_vector<double>(),
             "controlled layer scale", {37, 99, 235})
      .title("Zero scale isolates exact signed identity")
      .x_label("channel")
      .y_label("scale")
      .y_limits(0, 1.2);
  std::filesystem::create_directories("build");
  dm::graphics::RLayout::create(2, 2)
      .add(n::plot_tensor_map(map(x), -1, 1).title("Signed input channel 0"))
      .add(n::plot_tensor_map(map(correction), -high, high)
               .title("Initial residual correction times 1e6"))
      .add(n::plot_tensor_map(support, 0, 1).title("Branch-only derivative reaches 7 by 7"))
      .add(curve)
      .size(1200, 960)
      .fit_panels()
      .save_svg("build/convnext_block.svg");
  std::print("Initial scale 1e-6: max input change {:.12f}. Setting scale one reveals 49 "
             "derivative sites in a 7x7 window. Setting scale zero gives exact signed "
             "identity and unit input derivatives.\n",
             change);
}
```
