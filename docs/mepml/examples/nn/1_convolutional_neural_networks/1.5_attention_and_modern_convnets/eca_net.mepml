> Small module and visible gates

```{cpp, results="markdown", file="figures/eca_net_gates.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

int main() {
  namespace n = dm::nn;
  const auto type = n::DType::Float64;
  n::ParameterStore p(17, type);
  const auto x =
      n::sin(.37 * n::arange(0, 2 * 4 * 4 * 24).to(type) + .2).reshape({2, 4, 4, 24}) +
      .5 * n::linspace(-1, 1, 24, type).reshape({1, 1, 1, 24});
  const auto out = n::models::Eca(p, "eca", x, 5);
  const auto pooled = n::mean(x, {1, 2}).to_vector<double>(),
             w = p.at("eca/W").to_vector<double>();
  double error = 0;
  for (int batch = 0; batch < 2; ++batch)
    for (int ch = 0; ch < 24; ++ch) {
      double logit = 0;
      for (int j = 0; j < 5; ++j) {
        const int source = ch + j - 2;
        if (source >= 0 && source < 24)
          logit += pooled[batch * 24 + source] * w[j];
      }
      error = std::max(error,
                       std::abs(out.gate.at({batch, 0, 0, ch}) - 1 / (1 + std::exp(-logit))));
    }
  if (error > 1e-12 || p.count() != 5)
    return 1;
  std::vector<double> channels, kernels;
  for (int c : {64, 128, 256, 512, 1024, 2048}) {
    channels.push_back(c);
    kernels.push_back(n::models::EcaKernel(c));
  }
  if (kernels != std::vector<double>{3, 5, 5, 5, 5, 7})
    return 1;
  auto weights = dm::graphics::RPlot::create(), sizes = dm::graphics::RPlot::create();
  weights
      .lines(n::arange(0, 24).to_vector<double>(),
             n::slice_axis(out.gate, 0, 0, 1).reshape({24}).to_vector<double>(),
             "channel gate", {37, 99, 235})
      .title("Five learned local channel weights")
      .x_label("channel")
      .y_label("logistic gate")
      .y_limits(0, 1.2);
  sizes.lines(channels, kernels, "adaptive kernel", {234, 88, 12})
      .title("Adaptive odd kernel metadata")
      .x_label("channel count C")
      .y_label("k")
      .y_limits(0, 9);
  std::filesystem::create_directories("build");
  dm::graphics::RLayout::create(1, 2)
      .add(weights)
      .add(sizes)
      .size(1100, 470)
      .fit_panels()
      .save_svg("build/eca_net_gates.svg");
  std::print("24-channel ECA has exactly five weights; independent host channel-convolution "
             "oracle error {:.12f}. Adaptive k for 64/128/256/512/1024/2048 is 3/5/5/5/5/7.\n",
             error);
}
```
