#include <dm/dm.hpp>

int main() {
  namespace n = dm::nn;
  n::ParameterStore p(17), state(17);
  n::models::AttentionResNetConfig cfg;
  cfg.attention = n::models::ChannelAttention::kEca;
  n::NoGradGuard guard;
  n::models::AttentionResNet(p, state, n::zeros({1, 64, 64, 3}), cfg);
  if (p.count() != 25557080)
    return 1;
  std::print("Fixed k=3: {} learned scalars, 48 above plain ResNet-50.\n", p.count());
