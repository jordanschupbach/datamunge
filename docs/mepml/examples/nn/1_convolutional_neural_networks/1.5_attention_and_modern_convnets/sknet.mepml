> Small module and visible gates

```{cpp, results="markdown", file="figures/sknet_support.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

int main() {
  namespace n = dm::nn;
  auto layout = dm::graphics::RLayout::create(2, 2);
  for (int stride : {1, 2}) {
    n::ParameterStore p(17), state(17);
    const auto x = n::ones({1, 9, 9, 8}).requires_grad_();
    {
      n::NoGradGuard guard;
      n::models::SelectiveKernel(p, state, "sk", x, 8, 2, stride, 2, 4, false, .9);
      p.set("sk/branch1/W", n::full({3, 3, 4, 8}, .01));
      p.set("sk/branch2/W", n::full({3, 3, 4, 8}, .01));
    }
    const auto out =
        n::models::SelectiveKernel(p, state, "sk", x, 8, 2, stride, 2, 4, false, .9);
    if (n::max(n::abs(out.weights[0] + out.weights[1] - 1)).item() > 1e-6 ||
        n::max(n::abs(out.output - out.branches[0] * out.weights[0] -
                      out.branches[1] * out.weights[1]))
                .item() > 1e-5)
      return 1;
    const int centre = int(out.output.size(1)) / 2;
    for (int branch = 0; branch < 2; ++branch) {
      const auto fresh =
          n::models::SelectiveKernel(p, state, "sk", x, 8, 2, stride, 2, 4, false, .9);
      const auto picked =
          n::slice(fresh.branches[branch], {0, centre, centre, 0}, {1, 1, 1, 8});
      const auto support =
          n::greater(n::sum(n::abs(n::grad(n::sum(picked), {x})[0]), {0, 3}), 0)
              .to(n::DType::Float32);
      if (n::count_nonzero(support).item() != 9)
        return 1;
      layout.add(n::plot_tensor_map(support, 0, 1)
                     .title("Stride " + std::to_string(stride) + ", dilation " +
                            std::to_string(branch + 1)));
    }
    std::print(
        "Stride {}: positive per-channel softmax branch weights sum to one; weighted sum "
        "exact within 1e-5; both branches have nine derivative taps at a common centre.\n",
        stride);
  }
  std::filesystem::create_directories("build");
  layout.size(1100, 920).fit_panels().save_svg("build/sknet_support.svg");
}
```
