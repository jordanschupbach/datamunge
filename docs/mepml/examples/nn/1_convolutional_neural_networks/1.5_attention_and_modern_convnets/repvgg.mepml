> Four block fusion and derivative checks

```{cpp, results="markdown", file="figures/repvgg_fusion.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

void perturb(dm::nn::ParameterStore &p, dm::nn::ParameterStore &state) {
  namespace n = dm::nn;
  n::NoGradGuard guard;
  for (const auto &name : p.names())
    if (name.find("/bn/") != std::string::npos) {
      const auto pattern = .2 * n::sin(.37 * n::arange(0, p.at(name).numel()).to(p.dtype()) +
                                       double(name.size()));
      p.set(name, pattern + (name.ends_with("gamma") ? 1. : .3));
    }
  for (const auto &name : state.names()) {
    const auto pattern =
        .2 * n::sin(.37 * n::arange(0, state.at(name).numel()).to(state.dtype()) +
                    double(name.size()));
    state.set(name, pattern + (name.ends_with("moving_var") ? 1. : 0.));
  }
}

int main() {
  namespace n = dm::nn;
  const auto type = n::DType::Float64;
  auto layout = dm::graphics::RLayout::create(1, 2);
  double maximum = 0;
  for (const auto &b :
       std::vector<n::models::RepVGGBlockSpec>{{"identity", 8, 8, 1, 1, true},
                                               {"stride", 8, 12, 2, 1, false},
                                               {"grouped", 8, 8, 1, 2, true},
                                               {"group_stride", 8, 12, 2, 2, false}}) {
    n::ParameterStore p(17, type), state(17, type);
    const auto x = n::sin(.17 * n::arange(0, 2 * 7 * 6 * 8).to(type) + .3)
                       .reshape({2, 7, 6, 8})
                       .detach()
                       .requires_grad_();
    {
      n::NoGradGuard guard;
      n::models::RepVGGBlock(p, state, b, x, false, false);
    }
    perturb(p, state);
    const auto out = n::models::RepVGGBlock(p, state, b, x, false, false);
    auto vars = p.parameters();
    vars.insert(vars.begin(), x);
    const auto expected = n::grad(n::mean(n::square(out)), vars);
    const auto fused = n::models::FuseRepVGGBlock(b, p, state);
    if (fused.bias.dtype() != type)
      return 1;
    auto options = n::conv_options(b.stride, n::Padding::Explicit);
    options.explicit_paddings = {1, 1, 1, 1};
    options.groups = b.groups;
    const auto packed =
        n::relu(n::bias_add(n::conv2d(x, n::concat(fused.kernels, 3), options), fused.bias));
    double error = n::max(n::abs(out - packed)).item();
    const auto actual = n::grad(n::mean(n::square(packed)), vars);
    for (size_t i = 0; i < vars.size(); ++i)
      error = std::max(error, n::max(n::abs(actual[i] - expected[i])).item());
    if (error > 1e-10)
      return 1;
    maximum = std::max(maximum, error);
    std::print("{}: outputs and all input/filter/BN affine derivatives agree; absolute max "
               "error {:.12f}.\n",
               b.name, error);
    if (b.name == "grouped") {
      auto map = [](const n::Tensor &h) {
        return n::slice_axis(n::slice_axis(h, 0, 0, 1), 3, 0, 1).reshape({7, 6});
      };
      const double high = std::max(1e-12, n::max(out).item());
      layout
          .add(n::plot_tensor_map(map(out), 0, high)
                   .title("Three aligned branches, grouped identity"))
          .add(
              n::plot_tensor_map(map(packed), 0, high).title("One tensor-folded grouped 3x3"));
    }
  }
  std::filesystem::create_directories("build");
  layout.size(1200, 500).fit_panels().save_svg("build/repvgg_fusion.svg");
  std::print("Tensor folding preserves Float64 without host weight arrays; maximum "
             "derivative/value error across four cases {:.12f}. Equivalence uses saved BN "
             "moments, not training batch moments.\n",
             maximum);
}
```
