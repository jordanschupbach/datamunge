```{cpp, results="markdown", file="figures/repvgg_training.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

int main() {
  int rendered_confusions = 0;
  namespace n             = dm::nn;
  n::set_num_threads(2);

  std::filesystem::path cache;
  if (const auto* p = std::getenv("DATAMUNGE_DATA_DIR"))
    cache = p;
  else if (const auto* p = std::getenv("XDG_CACHE_HOME"))
    cache = std::filesystem::path(p) / "datamunge/datasets";
  else
    cache = std::filesystem::path(std::getenv("HOME")) / ".cache/datamunge/datasets";
  dm::datasets::fetch("cifar10", (cache / "cifar10").string());

  const auto raw    = n::data::LoadCifar({cache / "cifar10/data_batch_1.bin"}, n::data::Cifar::k10);
  const auto images = n::cast(raw.images, n::DType::Float32) / 255.,
             labels = n::cast(raw.labels, n::DType::Int64);
  const auto tx = n::slice_axis(images, 0, 0, 64), ty = n::slice_axis(labels, 0, 0, 64);
  const auto vx = 2 * n::slice_axis(images, 0, 64, 128) - 1, vy = n::slice_axis(labels, 0, 64, 128);
  const auto official = n::load_cifar10((cache / "cifar10").string(), "test");
  const auto qx       = 2 * n::slice_axis(official.images, 0, 0, 64) - 1,
             qy       = n::slice_axis(official.labels, 0, 0, 64);
  n::models::RepVGGConfig cfg;
  cfg.classes    = 10;
  cfg.small_stem = true;
  n::ParameterStore p(17), state(17);
  auto              output = [&](const n::Tensor& image, bool training) {
    return n::models::RepVGG(p, state, image, cfg, training).logits;
  };
  {
    n::NoGradGuard guard;
    output(n::zeros({1, 32, 32, 3}), false);
  }
  if (p.count() != 7840778)
    return 1;
  n::OptimizerConfig config;
  config.kind = n::OptimizerKind::Adam;
  n::Optimizer  optimizer(p, .001, config);
  n::BatchOrder batches(64, 8, 2026);
  n::Generator  augmentation(151);
  std::filesystem::create_directories("build");
  const std::string   checkpoint = "build/repvgg_best";
  double              best       = std::numeric_limits<double>::infinity();
  int                 best_epoch = 0;
  std::vector<double> epochs, train, validation;
  for (int epoch = 1; epoch <= 6; ++epoch) {
    batches.begin_epoch();
    n::WeightedMean average;
    for (auto rows = batches.next(); !rows.empty(); rows = batches.next()) {
      const auto             batch = n::take_rows(tx, rows), target = n::take_rows(ty, rows);
      std::vector<n::Tensor> transformed;
      for (int64_t row = 0; row < batch.size(0); ++row) {
        auto image =
            n::pad(n::slice_axis(batch, 0, row, row + 1), {{0, 0}, {4, 4}, {4, 4}, {0, 0}});
        image = n::augment::random_crop(image, 32, 32, augmentation);
        transformed.push_back(n::augment::random_flip_left_right(image, augmentation));
      }
      const auto nll =
          n::sparse_softmax_cross_entropy(output(2 * n::concat(transformed, 0) - 1, true), target);
      auto objective = nll;
      for (const auto& w : p.parameters())
        if (w.dim() >= 2)
          objective = objective + .00005 * n::sum(n::square(w));
      optimizer.minimize(objective);
      average.add(nll.item(), rows.size());
    }
    n::NoGradGuard guard;
    const double   val = n::sparse_softmax_cross_entropy(output(vx, false), vy).item();
    if (!std::isfinite(val))
      return 1;
    epochs.push_back(epoch);
    train.push_back(average.value());
    validation.push_back(val);
    if (val < best) {
      best       = val;
      best_epoch = epoch;
      p.save(checkpoint + "_params.npz");
      state.save(checkpoint + "_state.npz");
    }
  }
  p.load(checkpoint + "_params.npz");
  state.load(checkpoint + "_state.npz");
  n::NoGradGuard    guard;
  const auto        selected = n::models::RepVGG(p, state, qx, cfg, false);
  n::ParameterStore deployed(19), unused(19);
  n::models::DeployRepVGG(deployed, selected.blocks, p, state);
  auto deploy_cfg           = cfg;
  deploy_cfg.deploy         = true;
  const auto   packed       = n::models::RepVGG(deployed, unused, qx, deploy_cfg, false);
  const double fusion_error = n::max(n::abs(selected.logits - packed.logits)).item() /
                              std::max(1., n::max(n::abs(selected.logits)).item());
  const int64_t disagreements =
      n::count_nonzero(n::not_equal(n::argmax(selected.logits, 1), n::argmax(packed.logits, 1)))
          .item<int64_t>();
  if (fusion_error > 1e-4 || deployed.count() != 7041194 || unused.count() != 0)
    return 1;
  std::print(
      "Selected trained checkpoint: 22 blocks fused into {} deployed scalars, no BN state; "
      "test-logit relative max error {:.9f}, {} of 64 prediction disagreements.\n",
      deployed.count(),
      fusion_error,
      disagreements);
  const auto   prediction   = selected.logits;
  const double test_nll     = n::sparse_softmax_cross_entropy(prediction, qy).item();
  const double training_nll = n::sparse_softmax_cross_entropy(output(2 * tx - 1, false), ty).item();
  if (!std::isfinite(test_nll))
    return 1;
  const auto truth = n::one_hot(qy, 10), predicted = n::one_hot(n::argmax(prediction, 1), 10);
  const auto confusion = n::matmul(n::transpose(truth, {1, 0}), predicted);
  n::ConfusionMatrix::from_counts(confusion.to(n::DType::Int64))
      .save_svg(
          "build/repvgg_confusion_api_" + std::to_string(rendered_confusions++) + ".svg",
          {.title = "repvgg / selected-checkpoint test counts"});

  if (n::sum(confusion).item() != 64)
    return 1;
  auto trace = dm::graphics::RPlot::create();
  trace.lines(epochs, train, "training", {37, 99, 235})
      .lines(epochs, validation, "validation", {234, 88, 12})
      .title("All epochs, including initial BN transient")
      .x_label("epoch")
      .y_label("mean primary NLL");
  // Flip before the image helper so its vertical tick is the actual true-class ID.
  auto counts = n::plot_tensor_map(n::reverse(confusion, {0}), 0, n::max(confusion).item());
  counts
      .title(
          "Test counts, range [0," + std::to_string(static_cast<int>(n::max(confusion).item())) +
          "]")
      .x_label("predicted class")
      .y_label("true class")
      .x_limits(-.5, 9.5)
      .y_limits(-.5, 9.5);
  const std::vector<double> later_epochs(epochs.begin() + 1, epochs.end()),
      later_train(train.begin() + 1, train.end()),
      later_validation(validation.begin() + 1, validation.end());
  const double detail_high =
      1.35 * std::max(
                 *std::max_element(later_train.begin(), later_train.end()),
                 *std::max_element(later_validation.begin(), later_validation.end()));
  auto detail = dm::graphics::RPlot::create();
  detail.lines(later_epochs, later_train, "training", {37, 99, 235})
      .lines(later_epochs, later_validation, "validation", {234, 88, 12})
      .title("Epochs 2 to 6: NLL detail")
      .x_label("epoch")
      .y_label("mean primary NLL")
      .y_limits(0, detail_high);
  auto agreement = dm::graphics::RPlot::create();
  agreement
      .lines(
          n::arange(0, 64).to_vector<double>(),
          n::max(selected.logits, {1}).to_vector<double>(),
          "training form",
          {37, 99, 235})
      .lines(
          n::arange(0, 64).to_vector<double>(),
          n::max(packed.logits, {1}).to_vector<double>(),
          "fused",
          {234, 88, 12})
      .title("Selected checkpoint: maximum test logits")
      .x_label("test image index")
      .y_label("maximum class score");
  dm::graphics::RLayout::create(2, 2)
      .add(trace)
      .add(detail)
      .add(counts)
      .add(agreement)
      .size(1200, 980)
      .fit_panels()
      .save_svg("build/repvgg_training.svg");
  std::print(
      "64 fit / 64 validation / 64 official-test rows; {} learned scalars, {} moving "
      "scalars; {} explicit Adam updates.\nSelected epoch {}; validation NLL {:.6f}; "
      "inference training NLL {:.6f}; test NLL {:.6f}; test accuracy {:.6f}.\n",
      p.count(),
      state.count(),
      optimizer.iterations(),
      best_epoch,
      best,
      training_nll,
      test_nll,
      n::accuracy(prediction, qy));
}
```
// result_begin: markdown
Selected trained checkpoint: 22 blocks fused into 7041194 deployed scalars, no BN state; test-logit relative max error 0.000000304, 0 of 64 prediction disagreements.
64 fit / 64 validation / 64 official-test rows; 7840778 learned scalars, 23648 moving scalars; 48 explicit Adam updates.
Selected epoch 4; validation NLL 5.823770; inference training NLL 8.677364; test NLL 7.034867; test accuracy 0.062500.
\image(figures/repvgg_training.svg)
// result_end
\caption(Explicit six-epoch Adam fit and a tensor-computed true/predicted-class count matrix at the selected checkpoint. Training uses augmentation and batch BN moments; validation/test use saved moving moments. Counts sum to 64; IDs follow the original CIFAR-10 order.)
\alttext(Explicit six-epoch Adam fit and a tensor-computed true/predicted-class count matrix at the selected checkpoint. Training uses augmentation and batch BN moments; validation/test use saved moving moments. Counts sum to 64; IDs follow the original CIFAR-10 order.)


> Observed fitting and deployment result

Validation selected epoch 4: validation NLL 5.823770, inference training NLL
8.677364, test NLL 7.034867 and 4/64 correct test predictions (6.25%). After 48 updates
the network has not learned: all three NLLs are well above the chance level ln 10 ≈ 2.303,
and the inference NLLs, which use the saved moving BN moments, lie far above the
batch-moment training trace (about 3), so those moments have not yet settled. Runs with 128 fit images
and ten epochs (15 seconds) were still at chance, so the loop is kept short; it demonstrates
fitting, checkpointing and conversion, not accuracy. The converted selected checkpoint has
relative maximum logit error 0.000000304 and zero test-prediction disagreements. The full
trace retains its large first-epoch BN transient; the second panel shows epochs 2–6 on a
detail scale. Fusion preserves this model's predictions;
it does not improve its poor small-data generalization or measure latency.

> Native confusion matrices

These matrices use the held-out predictions from the executed program above.
The native `ConfusionMatrix` SVG API labels exact counts with true classes
running from top to bottom and predicted classes from left to right.

\image(figures/repvgg_confusion_api_0.svg)
\caption(Held-out classification confusion counts, evaluation 1. Exact cell counts are printed in the image.)
\alttext(Integer prediction counts with true classes as rows and predicted classes as columns.)


> Conclusion

Fixed inference BN turns aligned branches into one equivalent biased 3×3 filter. Tensor
folding preserves dtype and source derivatives, while explicit deployment creates independent
leaves. The visible optimizer and selected-checkpoint conversion connect that algebra to a
fitted complete A0 network, with bounded-data accuracy and arithmetic claims kept explicit.

> References

- [Ding et al. (2021), RepVGG: Making VGG-style ConvNets Great Again](https://arxiv.org/abs/2101.03697).
- [RepVGG release](https://github.com/DingXiaoH/RepVGG).
- [CIFAR-10 dataset](https://www.cs.toronto.edu/~kriz/cifar.html).
