> Complete A0 conversion

```{cpp, results="markdown", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

void perturb(dm::nn::ParameterStore &p, dm::nn::ParameterStore &state) {
  namespace n = dm::nn;
  n::NoGradGuard guard;
  for (const auto &name : p.names())
    if (name.find("/bn/") != std::string::npos) {
      const auto pattern = .2 * n::sin(.37 * n::arange(0, p.at(name).numel()).to(p.dtype()) +
                                       double(name.size()));
      p.set(name, pattern + (name.ends_with("gamma") ? 1. : .3));
    }
  for (const auto &name : state.names()) {
    const auto pattern =
        .2 * n::sin(.37 * n::arange(0, state.at(name).numel()).to(state.dtype()) +
                    double(name.size()));
    state.set(name, pattern + (name.ends_with("moving_var") ? 1. : 0.));
  }
}

int main() {
  namespace n = dm::nn;
  n::set_num_threads(2);
  n::NoGradGuard guard;
  n::ParameterStore p(17), state(17);
  const auto x = n::sin(.37 * n::arange(0, 64 * 64 * 3).to(n::DType::Float32) + .1)
                     .reshape({1, 64, 64, 3});
  n::models::RepVGG(p, state, x);
  perturb(p, state);
  const auto out = n::models::RepVGG(p, state, x);
  if (p.count() != 9108968 || state.count() != 23648 || out.blocks.size() != 22)
    return 1;
  n::ParameterStore deployed(19), empty(19);
  n::models::DeployRepVGG(deployed, out.blocks, p, state);
  n::models::RepVGGConfig cfg;
  cfg.deploy = true;
  const auto converted = n::models::RepVGG(deployed, empty, x, cfg);
  if (deployed.count() != 8309384 || empty.count() != 0)
    return 1;
  const double error = n::max(n::abs(converted.logits - out.logits)).item() /
                       std::max(1., n::max(n::abs(out.logits)).item());
  if (error > 1e-4)
    return 1;
  std::print("Complete ImageNet-classifier A0 at 64 pixels: 22 blocks fused, {} training + {} "
             "BN-state scalars become {} deployed scalars; relative max-logit error {:.9f}.\n",
             p.count(), state.count(), deployed.count(), error);
}
```
// result_begin: markdown
Complete ImageNet-classifier A0 at 64 pixels: 22 blocks fused, 9108968 training + 23648 BN-state scalars become 8309384 deployed scalars; relative max-logit error 0.000000602.
// result_end

> Ten full-weight budgets

```{cpp, results="markdown", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

int main() {
  namespace n = dm::nn;
  n::set_num_threads(2);
  struct Case {
    const char *name;
    int64_t train, deploy, macs;
  };
  for (const auto &c : std::vector<Case>{{"A0", 9108968, 8309384, 1361451008},
                                         {"A1", 14092264, 12789864, 2363967488},
                                         {"A2", 28210600, 25499944, 5116951552},
                                         {"B0", 15817960, 14339048, 3057600512},
                                         {"B1", 57415016, 51829480, 11815485440},
                                         {"B1g2", 45782376, 41360104, 8809742336},
                                         {"B1g4", 39966056, 36125416, 7306870784},
                                         {"B2", 89022376, 80315112, 18376609792},
                                         {"B2g4", 61758376, 55777512, 11331899392},
                                         {"B3", 123085288, 110960872, 26208882688}}) {
    n::NoGradGuard guard;
    n::models::RepVGGConfig cfg;
    cfg.model = c.name;
    int64_t learned;
    {
      n::ParameterStore p(17), state(17);
      n::models::RepVGG(p, state, n::zeros({1, 32, 32, 3}), cfg);
      learned = p.count();
    }
    n::ParameterStore p(17), state(17);
    cfg.deploy = true;
    const auto out = n::models::RepVGG(p, state, n::zeros({1, 32, 32, 3}), cfg);
    const int64_t classifier = int64_t(out.blocks.back().out) * 1000;
    int64_t macs = classifier;
    for (size_t i = 0; i < out.blocks.size(); ++i) {
      const auto &b = out.blocks[i];
      macs +=
          out.outputs[i].size(1) * out.outputs[i].size(2) * 49 * 9 * b.in * b.out / b.groups;
    }
    if (learned != c.train || p.count() != c.deploy || macs != c.macs || state.count() != 0)
      return 1;
    if (std::string(c.name) == "A0") {
      const auto actual = n::models::RepVGG(p, state, n::zeros({1, 224, 224, 3}), cfg);
      int64_t check = classifier;
      for (size_t i = 0; i < actual.blocks.size(); ++i) {
        const auto &b = actual.blocks[i];
        check += actual.outputs[i].size(1) * actual.outputs[i].size(2) * 9 * b.in * b.out /
                 b.groups;
      }
      if (check != macs)
        return 1;
    }
    std::print("{}: {} actual training / {} actual deployed parameters; exact 224-pixel "
               "deployed budget {} MACs.\n",
               c.name, learned, p.count(), macs);
  }
  std::print("All ten full-weight forms execute at 32 pixels for counts, releasing training "
             "weights before allocating deployment form. Every strided map scales exactly "
             "sevenfold per side at 224 pixels, so convolution work scales by 49; classifier "
             "stays fixed. A0 additionally executes an actual 224-pixel cross-check. No "
             "runtime or all-model full-resolution execution is claimed.\n");
}
```
