> A saturated score with exact midpoint attributions

ForF(x)=clip(x0,0,1)+2*x1and baseline0,the first observed row[2,3,9]has
attributions[1,6,0]. Its first endpoint derivative is0but its integrated
attribution is1;the third coordinate is a dummy. The second row[.5,-1,4]
has[.5,-2,0],summing-1.5. Equivalent ReLU implementations and callback batches
1versus7give the same results. Equal input/baseline gives exactzero.
```{cpp, results="markdown", file="figures/integrated_gradients_fixture.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

#include <print>
int main() {
  namespace n = dm::nn;
  namespace m = n::models;
  const auto input = n::from_vector(std::vector<float>{2, 3, 9, .5f, -1, 4}, {2, 3}),
             base = n::zeros({2, 3}), targets = n::zeros({2}, n::DType::Int32);
  auto score = [](const n::Tensor &x) {
    return n::clip(n::slice_axis(x, 1, 0, 1), 0., 1.) + n::slice_axis(x, 1, 1, 2) * 2.;
  };
  auto derivative = [&](const n::Tensor &p, const n::Tensor &) {
    auto x = p.detach().clone().requires_grad_();
    return n::grad(n::sum(score(x)), {x})[0].detach();
  };
  const auto out = m::IntegratedGradients(input, base, targets, 64, 7, derivative);
  std::print("Declared exact attributions {},sums {},endpoint derivatives {}.\n",
             out.attribution, n::sum(out.attribution, {1}), derivative(input, targets));
  auto a = dm::graphics::RPlot::create(), b = dm::graphics::RPlot::create();
  a.points(n::arange(0, 3).to_vector<double>(),
           n::select(out.attribution, 0, 0).to_vector<double>(), "IG", {37, 99, 235})
      .points(n::arange(0, 3).to_vector<double>(),
              n::select(derivative(input, targets), 0, 0).to_vector<double>(),
              "endpoint derivative", {220, 38, 38})
      .title("Saturation,linear coordinate,dummy")
      .x_label("declared input coordinate")
      .y_label("attribution/endpoint derivative");
  b.lines(out.nodes.to_vector<double>(),
          n::select(n::select(out.path_gradient, 1, 0), 1, 0).to_vector<double>(),
          "saturated coordinate", {37, 99, 235})
      .title("Every actual midpoint derivative")
      .x_label("alpha from baseline to input")
      .y_label("ordinary derivative at path node");
  auto layout = dm::graphics::RLayout::create(1, 2);
  layout.add(a).add(b).size(1100, 500).fit_panels().save_svg(
      "build/integrated_gradients_fixture.svg");
}
```
