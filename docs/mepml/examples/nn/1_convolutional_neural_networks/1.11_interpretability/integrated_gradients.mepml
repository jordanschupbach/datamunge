> Every completeness residual and the coarse reference

For each actual path,compare sum of signed attributions with its own fixed-target
raw-score difference F(x)-F(x0). Completeness measures integration accuracy;it
does not establish causal importance. The baseline changes both the integral
and the right-hand side,so controls must use their own endpoint difference.
All40case/path rows remain visible,alongside the unrefined32node primary residual.
All four controls pass at64nodes;the maximum primary residual falls from
.0401768225at32to.0196272538at64. It remains nonzero. The primary attribution
L1difference from endpoint-gradient-times-input is8.06342411;runner,grey-baseline
and actual-initial controls change it by83.9826889,55.5069809and73.4423523.
These are measured dependencies of this classifier and baseline choice.
```{cpp, results="markdown", file="figures/integrated_gradients_completeness.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

#include <print>
int main() {
  namespace n = dm::nn;
  std::map<std::string, n::Tensor> a;
  for (const auto &[key, value] : n::load_npz("build/integrated_gradients_maps.npz"))
    a.emplace(key, value);
  const auto coarse = n::sum(a.at("coarse_attribution").to(n::DType::Float64), {1, 2, 3}) -
                      a.at("primary_delta");
  std::print("| path | true digit | original source ID | raw score change | sum attribution | "
             "residual | declared tolerance |\n|---|---:|---:|---:|---:|---:|---:|\n");
  auto plot = dm::graphics::RPlot::create();
  const std::vector<std::string> names{"primary", "runner", "gray", "initial"};
  const std::vector<dm::graphics::RGB> colors{
      {37, 99, 235}, {220, 38, 38}, {22, 163, 74}, {147, 51, 234}};
  for (int path = 0; path < 4; ++path) {
    const auto delta = a.at(names[path] + "_delta"),
               residual = a.at(names[path] + "_residual"),
               tolerance = .01 + n::abs(delta) * .01;
    for (int i = 0; i < 10; ++i)
      std::print("| {} | {} | {} | {:.9g} | {:.9g} | {:.9g} | {:.9g} |\n", names[path], i,
                 a.at("source_ids").at({i}), delta.at({i}), delta.at({i}) + residual.at({i}),
                 residual.at({i}), tolerance.at({i}));
    plot.lines(n::arange(0, 10).to_vector<double>(),
               (n::abs(residual) / tolerance).to_vector<double>(), names[path], colors[path]);
  }
  std::print(
      "Coarse32node max primary residual {:.9g};selected{}node max primary residual {:.9g}.\n",
      n::max(n::abs(coarse)).item(), a.at("nodes").numel(),
      n::max(n::abs(a.at("primary_residual"))).item());
  plot.title("All forty actual completeness checks")
      .x_label("true digit0..9")
      .y_label("absolute residual / declared tolerance")
      .y_limits(0, 1.2);
  plot.save_svg("build/integrated_gradients_completeness.svg");
}
