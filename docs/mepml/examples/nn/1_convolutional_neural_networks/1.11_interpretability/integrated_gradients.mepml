> Real midpoint quadrature and all baseline/target/weight controls

Tensor Double arithmetic constructs path points at alpha=(k+.5)/steps,then
Float32model evaluation yields ordinary gradients. All actual path derivatives
are retained in step-major/case-minor order. Double means produce Float32final
attributions. The callback batches at most32path points;its gradient sums fixed
raw scores to preserve per-observation scale.

Start64nodes;check all40case/control completeness residuals against the declared
numerical tolerance.01+.01*abs(scorechange). Double the quadrature until all
pass or512nodes,then fail explicitly if the tolerance is still unmet. This is
a numerical verification rule,not a new fitting or model-selection process.
The32node primary result remains a fixed coarse reference. Refinement need not
improve every individual residual monotonically at ReLU boundaries.
```{cpp, results="markdown", file="figures/integrated_gradients_maps.png", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

#include <print>
int main() {
  namespace n = dm::nn;
  namespace m = n::models;
  n::set_num_threads(2);

  std::filesystem::path cache;
  if (const auto *p = std::getenv("DATAMUNGE_DATA_DIR"))
    cache = p;
  else if (const auto *p = std::getenv("XDG_CACHE_HOME"))
    cache = std::filesystem::path(p) / "datamunge/datasets";
  else
    cache = std::filesystem::path(std::getenv("HOME")) / ".cache/datamunge/datasets";

  dm::datasets::prepare_example_data("mnist-assets", cache.string());
  const auto pools = m::LoadSaliency(cache / "saliency");
  const auto &fit = pools[0];
  const auto &validation = pools[1];
  const auto &test = pools[2];

  n::ParameterStore p(1103);
  {
    n::NoGradGuard guard;
    m::SaliencyCnn(p, n::zeros({1, 28, 28, 1}));
  }
  auto predict = [&](const n::Tensor &images) {
    n::NoGradGuard guard;
    std::vector<n::Tensor> parts;
    for (std::int64_t start = 0; start < images.size(0); start += 32)
      parts.push_back(
          m::SaliencyCnn(p, n::slice_axis(images, 0, start,
                                          std::min<std::int64_t>(start + 32, images.size(0))))
              .logits);
    return n::concat(parts, 0);
  };

  for (const auto &[key, value] : n::load_npz("build/vanilla_saliency_best.npz"))
    p.set(key, value.clone());

  std::vector<std::int64_t> chosen;
  const auto labels = test.labels.to_vector<int>();
  for (int digit = 0; digit < 10; ++digit) {
    const auto it = std::find(labels.begin(), labels.end(), digit);
    chosen.push_back(it - labels.begin());
  }
  const auto examples = m::SaliencyRows(test, chosen);
  const auto z = predict(examples.images);
  const auto sorted = n::argsort(z, true);
  const auto targets = n::select(sorted, 1, 0).to(n::DType::Int32),
             runners = n::select(sorted, 1, 1).to(n::DType::Int32);

  const auto before = p.flatten();
  n::ParameterStore random(1103);
  {
    n::NoGradGuard guard;
    m::SaliencyCnn(random, n::zeros({1, 28, 28, 1}));
  }
  for (const auto &[key, value] : n::load_npz("build/vanilla_saliency_initial.npz"))
    random.set(key, value.clone());
  const auto random_before = random.flatten();
  auto gradient = [&](const n::Tensor &points, const n::Tensor &classes) {
    return m::VanillaInputGradient(
        [&](const n::Tensor &x) {
          return m::SaliencyCnn(p, x).logits;
        },
        points, classes);
  };
  auto initial_gradient = [&](const n::Tensor &points, const n::Tensor &classes) {
    return m::VanillaInputGradient(
        [&](const n::Tensor &x) {
          return m::SaliencyCnn(random, x).logits;
        },
        points, classes);
  };
  const auto black = n::zeros(examples.images.shape()),
             gray = n::full(examples.images.shape(), double(.1f));
  const auto coarse =
      m::IntegratedGradients(examples.images, black, targets, 32, 32, gradient);
  std::vector<m::IntegratedResult> values;
  std::vector<n::Tensor> deltas, residuals;
  const std::vector<std::string> names{"primary", "runner", "gray", "initial"};
  int steps = 64;
  for (;;) {
    values.clear();
    deltas.clear();
    residuals.clear();
    bool complete = true;
    for (int control = 0; control < 4; ++control) {
      const auto base = control == 2 ? gray : black,
                 classes = control == 1 ? runners : targets;
      const auto fn = control == 3 ? m::InputGradientFunction(initial_gradient)
                                   : m::InputGradientFunction(gradient);
      const auto integral =
          m::IntegratedGradients(examples.images, base, classes, steps, 32, fn);
      n::Tensor scores, baseline_scores;
      {
        n::NoGradGuard guard;
        auto &store = control == 3 ? random : p;
        scores = m::SaliencyScore(m::SaliencyCnn(store, examples.images).logits, classes)
                     .to(n::DType::Float64);
        baseline_scores = m::SaliencyScore(m::SaliencyCnn(store, base).logits, classes)
                              .to(n::DType::Float64);
      }
      const auto delta = scores - baseline_scores,
                 residual =
                     n::sum(integral.attribution.to(n::DType::Float64), {1, 2, 3}) - delta;
      const auto tolerance = .01 + n::abs(delta) * .01;
      complete = complete && n::all(n::less_equal(n::abs(residual), tolerance)).item<bool>();
      values.push_back(integral);
      deltas.push_back(delta);
      residuals.push_back(residual);
    }
    if (complete)
      break;
    if (steps == 512)
      return 1;
    steps = std::min(512, steps * 2);
  }
  const auto endpoint = gradient(examples.images, targets) * examples.images;
  const auto single = m::IntegratedGradients(
      n::slice_axis(examples.images, 0, 0, 1), n::slice_axis(black, 0, 0, 1),
      n::slice_axis(targets, 0, 0, 1), steps, 1, gradient);
  const auto batching =
      n::max(n::abs(single.attribution - n::slice_axis(values[0].attribution, 0, 0, 1)));
  if (batching.item() > 2e-6 || before != p.flatten() || random_before != random.flatten())
    return 1;
  std::print("Selected{}midpoints for all40paths;single/batch "
             "{:.9g};all16learned/controlarrays unchanged.\n",
             steps, batching.item());
  n::NamedTensors arrays{{"images", examples.images},
                         {"source_ids", examples.source},
                         {"targets", targets},
                         {"runners", runners},
                         {"black", black},
                         {"gray_baseline", gray},
                         {"endpoint_times_input", endpoint},
                         {"coarse_attribution", coarse.attribution},
                         {"coarse_path_gradient", coarse.path_gradient},
                         {"nodes", values[0].nodes}};
  auto peak = n::max(n::abs(endpoint));
  for (const auto &v : values)
    peak = n::maximum(peak, n::max(n::abs(v.attribution)));
  std::vector<n::Tensor> display{examples.images};
  for (int i = 0; i < 4; ++i) {
    const auto prefix = names[i] + "_";
    arrays.push_back({prefix + "attribution", values[i].attribution});
    arrays.push_back({prefix + "mean_gradient", values[i].mean_gradient});
    arrays.push_back({prefix + "path_gradient", values[i].path_gradient});
    arrays.push_back({prefix + "delta", deltas[i]});
    arrays.push_back({prefix + "residual", residuals[i]});
    display.push_back(values[i].attribution / (peak * 2) + .5);
  }
  display.push_back(endpoint / (peak * 2) + .5);
  n::save_npz("build/integrated_gradients_maps.npz", arrays);
  std::print("Original case IDs {},fixed target/runner {}/{}.\n", examples.source, targets,
             runners);
  std::print(
      "Primary L1changes vs endpoint/runner/gray/initial {:.9g}/{:.9g}/{:.9g}/{:.9g}.\n",
      n::sum(n::abs(values[0].attribution - endpoint)).item(),
      n::sum(n::abs(values[0].attribution - values[1].attribution)).item(),
      n::sum(n::abs(values[0].attribution - values[2].attribution)).item(),
      n::sum(n::abs(values[0].attribution - values[3].attribution)).item());
  n::save_image_grid(n::concat(display, 0), "build/integrated_gradients_maps.png", 10, 0, 1, 2,
                     .8, 4);
}
```
