> Hand-checkable bounded step and half-pixel resize

On negative mean squared distance to.7,an image filled.6has gradient.05per
pixel for four pixels. A rate2RMS-normalized proposal overshoots;four halvings
accept rate.125and pixels.725. Zero rate and zero RMS produce exact no-ops.
The declared2x2to3x3fixture retains all nine exact half-pixel values. The native
oracle also compares every octave coordinate with the independent Doublehost
interpolation convention,including rectangular sizes and identity resize.
```{cpp, results="markdown", file="figures/deepdream_fixture.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

#include <print>
int main() {
  namespace n = dm::nn;
  namespace m = n::models;
  auto evaluate = [](const n::Tensor &image) {
    auto x = image.detach().clone().requires_grad_();
    const auto score = -n::mean(n::square(x - double(.7f)));
    return m::DreamEvaluation{score.item(), n::grad(score, {x})[0].detach()};
  };
  const auto step = m::DreamAscent(n::full({1, 2, 2, 1}, double(.6f)), 2., evaluate);
  const auto corners = n::from_vector(std::vector<float>{0, 1, .5f, .25f}, {1, 2, 2, 1}),
             resized = m::DreamResize(corners, 3, 3);
  std::print("Declared quadratic before/after {:.9g}/{:.9g},RMS {:.9g},rate {},halvings "
             "{},pixels {};all9half-pixelvalues {}.\n",
             step.before, step.after, step.rms, step.step, step.backtracks, step.image,
             resized);
  auto plot = n::plot_tensor_map(n::reverse(resized.reshape({3, 3}), {0}), 0, 1);
  plot.title("Declared exact half-pixel octave")
      .x_label("resized pixel x")
      .y_label("resized pixel y");
  plot.save_svg("build/deepdream_fixture.svg");
}
