> Every input TensorSGD step,projection and backtracking trial

Warm one Doubleimage leaf per octave before constructing plain tensorSGD.
Evaluate ordinary Float32feature gradients,compute their RMS inDouble,and pass
the NEGATIVE normalized gradient to a minimizing SGD step. Clip every proposal
to[0,1]inDouble,round toFloat32,then evaluate its actual frozen feature score.
Reject decreases,reset the original leaf and halve the rate,up to12trials.
If all proposals fail,retain the original image explicitly. The optimizer has
no momentum or fitted model state;rejected trials never alter classifier arrays.

Controls:conv1instead ofconv2,actual initial weights,one28pxoctave with15steps,
and zero-rate20/24/28resizing. The zero-rate result is the resize-only image,
which can differ from the original pixels. Every iteration and accepted rate
is retained. All image transformations and numerical updates use tensors.
```{cpp, results="markdown", file="figures/deepdream_images.png", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

#include <print>
int main() {
  namespace n = dm::nn;
  namespace m = n::models;
  n::set_num_threads(2);

  std::filesystem::path cache;
  if (const auto *p = std::getenv("DATAMUNGE_DATA_DIR"))
    cache = p;
  else if (const auto *p = std::getenv("XDG_CACHE_HOME"))
    cache = std::filesystem::path(p) / "datamunge/datasets";
  else
    cache = std::filesystem::path(std::getenv("HOME")) / ".cache/datamunge/datasets";

  dm::datasets::prepare_example_data("mnist-assets", cache.string());
  const auto pools = m::LoadSaliency(cache / "saliency");
  const auto &fit = pools[0];
  const auto &validation = pools[1];
  const auto &test = pools[2];

  n::ParameterStore p(1103);
  {
    n::NoGradGuard guard;
    m::SaliencyCnn(p, n::zeros({1, 28, 28, 1}));
  }
  auto predict = [&](const n::Tensor &images) {
    n::NoGradGuard guard;
    std::vector<n::Tensor> parts;
    for (std::int64_t start = 0; start < images.size(0); start += 32)
      parts.push_back(
          m::SaliencyCnn(p, n::slice_axis(images, 0, start,
                                          std::min<std::int64_t>(start + 32, images.size(0))))
              .logits);
    return n::concat(parts, 0);
  };

  for (const auto &[key, value] : n::load_npz("build/vanilla_saliency_best.npz"))
    p.set(key, value.clone());

  std::vector<std::int64_t> chosen;
  const auto labels = test.labels.to_vector<int>();
  for (int digit = 0; digit < 10; ++digit) {
    const auto it = std::find(labels.begin(), labels.end(), digit);
    chosen.push_back(it - labels.begin());
  }
  const auto examples = m::SaliencyRows(test, chosen);
  const auto z = predict(examples.images);
  const auto sorted = n::argsort(z, true);
  const auto targets = n::select(sorted, 1, 0).to(n::DType::Int32),
             runners = n::select(sorted, 1, 1).to(n::DType::Int32);

  const auto before = p.flatten();
  n::ParameterStore random(1103);
  {
    n::NoGradGuard guard;
    m::SaliencyCnn(random, n::zeros({1, 28, 28, 1}));
  }
  for (const auto &[key, value] : n::load_npz("build/vanilla_saliency_initial.npz"))
    random.set(key, value.clone());
  const auto random_before = random.flatten();
  n::NamedTensors arrays{{"images", examples.images}, {"source_ids", examples.source}};
  std::vector<n::Tensor> displays{examples.images};
  std::print("| variant | octave side | step | before | after | accepted rate | halvings "
             "|\n|---|---:|---:|---:|---:|---:|---:|\n");
  const std::vector<std::string> names{"main", "conv1", "initial", "single", "zero"};
  for (const auto &name : names) {
    auto current = examples.images;
    const std::vector<int> sizes =
        name == "single" ? std::vector<int>{28} : std::vector<int>{20, 24, 28};
    const int iterations = name == "single" ? 15 : 5;
    const int layer = name == "conv1" ? 0 : 1;
    const double base_rate = name == "zero" ? 0. : .02;
    auto &store = name == "initial" ? random : p;
    int ordinal = 0;
    for (std::size_t octave = 0; octave < sizes.size(); ++octave) {
      current = m::DreamResize(current, sizes[octave], sizes[octave]);
      n::ParameterStore input(0, n::DType::Float64);
      input.get("image", current.shape(), n::init::zeros());
      input.set("image", current.to(n::DType::Float64));
      n::OptimizerConfig config;
      config.kind = n::OptimizerKind::Sgd;
      n::Optimizer sgd(input, base_rate, config);
      for (int iteration = 0; iteration < iterations; ++iteration) {
        auto x = current.detach().clone().requires_grad_();
        const auto features = m::SaliencyConvFeatures(store, x);
        const auto objective = n::mean(layer ? features.conv2 : features.conv1);
        const auto gradient = n::grad(objective, {x})[0].detach();
        const auto wide = gradient.to(n::DType::Float64),
                   rms = n::sqrt(n::mean(n::square(wide)));
        auto accepted = current;
        double after = objective.item(), rate = 0;
        int halvings = 0;
        if (base_rate > 0 && rms.item() > 0) {
          rate = base_rate;
          bool found = false;
          for (int trial = 0; trial < 12; ++trial) {
            input.set("image", current.to(n::DType::Float64));
            sgd.set_learning_rate(rate);
            sgd.step({-wide / (rms + 1e-12)});
            const auto candidate = n::clip(input.at("image"), 0., 1.).to(n::DType::Float32);
            n::Tensor score;
            {
              n::NoGradGuard guard;
              const auto f = m::SaliencyConvFeatures(store, candidate);
              score = n::mean(layer ? f.conv2 : f.conv1);
            }
            if (score.item() >= objective.item()) {
              accepted = candidate;
              after = score.item();
              halvings = trial;
              found = true;
              break;
            }
            rate *= .5;
          }
          if (!found) {
            rate = 0;
            halvings = 12;
          }
        }
        if (after < objective.item())
          return 1;
        std::print("| {} | {} | {} | {:.9g} | {:.9g} | {:.9g} | {} |\n", name, sizes[octave],
                   iteration, objective.item(), after, rate, halvings);
        const auto prefix =
            name + "_o" + std::to_string(octave) + "_s" + std::to_string(iteration);
        arrays.push_back({prefix + "_image", accepted});
        arrays.push_back({prefix + "_gradient", gradient});
        arrays.push_back({prefix + "_before", objective.detach()});
        arrays.push_back({prefix + "_after", n::full({},after,n::DType::Float64)});
        arrays.push_back({prefix + "_rate", n::full({},rate,n::DType::Float64)});
        arrays.push_back({prefix + "_backtracks", n::full({},halvings,n::DType::Int32)});
        current = accepted;
        ++ordinal;
      }
    }
    arrays.push_back({name + "_final", current});
    displays.push_back(current);
  }
  auto resized = examples.images;
  for (int side : {20, 24, 28})
    resized = m::DreamResize(resized, side, side);
  if (n::max(n::abs(resized - displays.back())).item() != 0 || before != p.flatten() ||
      random_before != random.flatten())
    return 1;
  std::print("Every75image iterations recorded;zero-rate EXACTresize-only,all16frozen arrays "
             "unchanged;source IDs {}.\n",
             examples.source);
  n::save_npz("build/deepdream_outputs.npz", arrays);
  n::save_image_grid(n::concat(displays, 0), "build/deepdream_images.png", 10, 0, 1, 2, .8, 4);
}
```
