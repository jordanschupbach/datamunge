> Objective traces and every cross-channel response

Report all sixteen regularized objective traces and the full16x16final response
matrix. Rows select the optimized channel;columns are all measured conv2channels.
A large off-diagonal response is not a coding failure:the objective rewards its
selected channel without penalizing other channels. The largest-response count
is measured after optimization and never used to choose which images to show.
In the actual run,the selected target is the largest final response in only
1of16images. All16main objectives improve;that gain does not mean the target
becomes exclusive or defines the entire visible pattern.
```{cpp, results="markdown", file="figures/feature_visualization_responses.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

#include <print>
int main() {
  namespace n = dm::nn;
  std::map<std::string, n::Tensor> a;
  for (const auto &[key, value] : n::load_npz("build/feature_visualization_outputs.npz"))
    a.emplace(key, value);
  std::vector<n::Tensor> rows;
  auto left = dm::graphics::RPlot::create();
  int strongest = 0;
  std::print("| selected channel | objective gain | final strongest channel | all16responses "
             "|\n|---:|---:|---:|---|\n");
  for (int channel = 0; channel < 16; ++channel) {
    const auto prefix = "main_c" + std::to_string(channel);
    const auto response = a.at(prefix + "_final_responses").reshape({16});
    rows.push_back(response);
    const int best = n::argmax(response, 0).item<int>();
    strongest += best == channel;
    const auto terms = a.at(prefix + "_terms");
    std::print("| {} | {:.9g} | {} | {} |\n", channel, terms.at({12, 0}) - terms.at({0, 0}),
               best, response.to_vector<float>());
    const dm::graphics::RGB color{std::uint8_t(30 + channel * 11),
                                  std::uint8_t(60 + (channel * 37) % 160),
                                  std::uint8_t(220 - channel * 10)};
    left.lines(n::arange(0, 13).to_vector<double>(),
               n::select(terms, 1, 0).to_vector<double>(), "", color);
  }
  const auto responses = n::stack(rows, 0);
  std::print("Selected target is final strongest channel in{}/16images;all256responses {}.\n",
             strongest, responses);
  auto right = n::plot_tensor_map(n::reverse(responses, {0}), 0, n::max(responses).item());
  left.title("All sixteen complete objective traces")
      .x_label("bounded input iteration0..12")
      .y_label("selected feature minus explicit priors");
  right.title("All final cross-channel responses")
      .x_label("measured response channel0..15")
      .y_label("optimized target channel0at bottom");
  auto layout = dm::graphics::RLayout::create(1, 2);
  layout.add(left).add(right).size(1100, 500).fit_panels().save_svg(
      "build/feature_visualization_responses.svg");
}
```
