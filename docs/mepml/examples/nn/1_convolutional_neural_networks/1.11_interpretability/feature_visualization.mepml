> Every selected-channel TensorSGD loop and bounded proposal

For each of all16channels,warm one Doubleimage leaf before plain tensorSGD.
Show all twelve ordinary objective gradients,RMSnormalization,negative-gradient
ascent step,projection to[0,1],Float32candidate evaluation and monotonic12trial
backtracking. Rejected proposals reset the image leaf;the frozen classifier
arrays are excluded from the image optimizer. Each channel is optimized as
one independent image,matching the source per-image RMS convention.

Five variants retain every channel:regularized main,unregularized,actual initial
weights,second seed,and zero rate. Zero-rate controls keep every starting pixel
unchanged. All960channel/iteration records,all initial/final16channel response
vectors and every gradient/proposal are saved;the table reports every final
selected response and objective gain rather than hiding weak or confusing cases.
```{cpp, results="markdown", file="figures/feature_visualization_images.png", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

#include <print>
int main() {
  namespace n = dm::nn;
  namespace m = n::models;
  n::set_num_threads(2);

  n::ParameterStore p(1103);
  {
    n::NoGradGuard guard;
    m::SaliencyCnn(p, n::zeros({1, 28, 28, 1}));
  }
  auto predict = [&](const n::Tensor &images) {
    n::NoGradGuard guard;
    std::vector<n::Tensor> parts;
    for (std::int64_t start = 0; start < images.size(0); start += 32)
      parts.push_back(
          m::SaliencyCnn(p, n::slice_axis(images, 0, start,
                                          std::min<std::int64_t>(start + 32, images.size(0))))
              .logits);
    return n::concat(parts, 0);
  };

  for (const auto &[key, value] : n::load_npz("build/vanilla_saliency_best.npz"))
    p.set(key, value.clone());

  const auto before = p.flatten();
  n::ParameterStore random(1103);
  {
    n::NoGradGuard guard;
    m::SaliencyCnn(random, n::zeros({1, 28, 28, 1}));
  }
  for (const auto &[key, value] : n::load_npz("build/vanilla_saliency_initial.npz"))
    random.set(key, value.clone());
  const auto random_before = random.flatten();
  const auto noise = m::FeatureNoise(16, 1423), second = m::FeatureNoise(16, 1429);
  n::NamedTensors arrays{{"noise", noise}, {"noise_second", second}};
  std::vector<n::Tensor> gallery{noise};
  std::print(
      "| variant | selected channel | initial objective | final objective | final selected "
      "feature | final L2 | final squaredTV |\n|---|---:|---:|---:|---:|---:|---:|\n");
  for (const std::string name : {"main", "unregularized", "initial", "second_seed", "zero"}) {
    const auto starts = name == "second_seed" ? second : noise;
    auto &store = name == "initial" ? random : p;
    const float l2 = name == "unregularized" ? 0.f : .01f,
                tv = name == "unregularized" ? 0.f : .2f;
    const double base_rate = name == "zero" ? 0. : .05;
    std::vector<n::Tensor> final_images;
    for (int channel = 0; channel < 16; ++channel) {
      auto current = n::slice_axis(starts, 0, channel, channel + 1);
      const auto selected = n::full({1}, channel, n::DType::Int32);
      n::ParameterStore input(0, n::DType::Float64);
      input.get("image", current.shape(), n::init::zeros());
      input.set("image", current.to(n::DType::Float64));
      n::OptimizerConfig config;
      config.kind = n::OptimizerKind::Sgd;
      n::Optimizer sgd(input, base_rate, config);
      std::vector<n::Tensor> images, gradients, terms;
      double first = 0;
      for (int step = 0; step <= 12; ++step) {
        auto x = current.detach().clone().requires_grad_();
        const auto features = m::SaliencyConvFeatures(store, x).conv2;
        const auto value = m::VisualizeFeature(x, features, selected, 16, l2, tv);
        const auto term = n::stack({value.mean, value.feature.reshape({}),
                                    value.l2.reshape({}), value.tv.reshape({})},
                                   0)
                              .to(n::DType::Float64);
        images.push_back(current);
        terms.push_back(term);
        if (step == 0) {
          first = value.mean.item();
          arrays.push_back({name + "_c" + std::to_string(channel) + "_initial_responses",
                            n::mean(features, {1, 2}).detach()});
        }
        if (step == 12) {
          arrays.push_back({name + "_c" + std::to_string(channel) + "_final_responses",
                            n::mean(features, {1, 2}).detach()});
          std::print("| {} | {} | {:.9g} | {:.9g} | {:.9g} | {:.9g} | {:.9g} |\n", name,
                     channel, first, value.mean.item(), value.feature.item(), value.l2.item(),
                     value.tv.item());
          break;
        }
        const auto gradient = n::grad(value.mean, {x})[0].detach();
        gradients.push_back(gradient);
        const auto wide = gradient.to(n::DType::Float64),
                   rms = n::sqrt(n::mean(n::square(wide)));
        auto accepted = current;
        double rate = 0, after = value.mean.item();
        int backtracks = 0;
        if (base_rate > 0 && rms.item() > 0) {
          rate = base_rate;
          bool found = false;
          for (int trial = 0; trial < 12; ++trial) {
            input.set("image", current.to(n::DType::Float64));
            sgd.set_learning_rate(rate);
            sgd.step({-wide / (rms + 1e-12)});
            const auto candidate = n::clip(input.at("image"), 0., 1.).to(n::DType::Float32);
            n::Tensor score;
            {
              n::NoGradGuard guard;
              const auto f = m::SaliencyConvFeatures(store, candidate).conv2;
              score = m::VisualizeFeature(candidate, f, selected, 16, l2, tv).mean;
            }
            if (score.item() >= value.mean.item()) {
              accepted = candidate;
              after = score.item();
              backtracks = trial;
              found = true;
              break;
            }
            rate *= .5;
          }
          if (!found) {
            rate = 0;
            backtracks = 12;
          }
        }
        if (after < value.mean.item())
          return 1;
        const auto key = name + "_c" + std::to_string(channel) + "_s" + std::to_string(step);
        arrays.push_back({key + "_rms", rms});
        arrays.push_back({key + "_rate", n::full({}, rate, n::DType::Float64)});
        arrays.push_back({key + "_backtracks", n::full({}, backtracks, n::DType::Int32)});
        current = accepted;
      }
      const auto prefix = name + "_c" + std::to_string(channel);
      arrays.push_back({prefix + "_images", n::concat(images, 0)});
      arrays.push_back({prefix + "_gradients", n::concat(gradients, 0)});
      arrays.push_back({prefix + "_terms", n::stack(terms, 0)});
      final_images.push_back(current);
    }
    const auto final = n::concat(final_images, 0);
    arrays.push_back({name + "_final", final});
    if (name == "zero" && n::max(n::abs(final - noise)).item() != 0)
      return 1;
    gallery.push_back(final);
  }
  if (before != p.flatten() || random_before != random.flatten())
    return 1;
  std::print("All16selected/control classifier arrays unchanged;all960channel iterations "
             "retained;zero-rate pixels exact.\n");
  n::save_npz("build/feature_visualization_outputs.npz", arrays);
  n::save_image_grid(n::concat(gallery, 0), "build/feature_visualization_images.png", 16, 0, 1,
                     2, .8, 3);
}
```
