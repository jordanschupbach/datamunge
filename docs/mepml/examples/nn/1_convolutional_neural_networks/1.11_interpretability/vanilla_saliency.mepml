> A hand-checkable signed raw-score derivative

For a linear raw score s=2*x0-3*x1,the gradient is[2,-3]regardless of pixel
values. A SUM across two independent images reproduces that derivative in
each row;a batch MEAN would halve it. Switching the fixed target switches the
head coefficients. Softmax gradients,loss gradients,gradient-times-input and
guided gates are different quantities;none enters vanilla saliency here.
```{cpp, results="markdown", file="figures/vanilla_saliency_fixture.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

#include <print>
int main() {
  namespace n = dm::nn;
  namespace m = n::models;
  const auto x = n::from_vector(std::vector<float>{.2f, .7f, .6f, .1f}, {2, 1, 2, 1});
  const auto w = n::from_vector(std::vector<float>{2, -1, -3, 4}, {2, 2});
  auto forward = [&](const n::Tensor &a) {
    return n::matmul(a.reshape({2, 2}), w);
  };
  const auto targets = n::zeros({2}, n::DType::Int32);
  const auto gradient = m::VanillaInputGradient(forward, x, targets, 2);
  const auto alternative =
      m::VanillaInputGradient(forward, x, n::ones({2}, n::DType::Int32), 2);
  std::print("Declared input {},raw target0gradient {},target1gradient {}.\n",
             x.reshape({2, 2}), gradient.reshape({2, 2}), alternative.reshape({2, 2}));
  auto plot = dm::graphics::RPlot::create();
  plot.points({0, 1}, n::select(gradient.reshape({2, 2}), 0, 0).to_vector<double>(), "target0",
              {37, 99, 235})
      .points({0, 1}, n::select(alternative.reshape({2, 2}), 0, 0).to_vector<double>(),
              "target1", {220, 38, 38})
      .title("Declared signed raw-score derivatives")
      .x_label("pixel coordinate")
      .y_label("raw logit sensitivity")
      .y_limits(-4, 5);
  plot.save_svg("build/vanilla_saliency_fixture.svg");
}
```
