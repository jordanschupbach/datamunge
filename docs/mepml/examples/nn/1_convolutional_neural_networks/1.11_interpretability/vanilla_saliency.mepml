> Fresh restoration and complete held-out classifier errors

Check all200held-out logits against the saved selected model,repeated inference,
a single-image query(with5e-6Float32logit tolerance)and all eight immutable learned arrays. The coarse7x7
intensity memory1NN reference has no learned parameters and no optimizer;
its descriptor and pairwise distances use Double tensors. Report every class
recall and complete confusion counts,not only aggregate accuracy.
```{cpp, results="markdown", file="figures/vanilla_saliency_confusion.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <print>
int main() {
  namespace n = dm::nn;
  namespace m = n::models;
  n::set_num_threads(2);

  std::filesystem::path cache;
  if (const auto* p = std::getenv("DATAMUNGE_DATA_DIR"))
    cache = p;
  else if (const auto* p = std::getenv("XDG_CACHE_HOME"))
    cache = std::filesystem::path(p) / "datamunge/datasets";
  else
    cache = std::filesystem::path(std::getenv("HOME")) / ".cache/datamunge/datasets";

  dm::datasets::prepare_example_data("mnist-assets", cache.string());
  const auto  pools      = m::LoadSaliency(cache / "saliency");
  const auto& fit        = pools[0];
  const auto& validation = pools[1];
  const auto& test       = pools[2];

  n::ParameterStore p(1103);
  {
    n::NoGradGuard guard;
    m::SaliencyCnn(p, n::zeros({1, 28, 28, 1}));
  }
  auto predict = [&](const n::Tensor& images) {
    n::NoGradGuard         guard;
    std::vector<n::Tensor> parts;
    for (std::int64_t start = 0; start < images.size(0); start += 32)
      parts.push_back(
          m::SaliencyCnn(
              p,
              n::slice_axis(images, 0, start, std::min<std::int64_t>(start + 32, images.size(0))))
              .logits);
    return n::concat(parts, 0);
  };

  for (const auto& [key, value] : n::load_npz("build/vanilla_saliency_best.npz"))
    p.set(key, value.clone());

  const auto before = p.flatten();
  n::Tensor  saved, untrained;
  for (const auto& [key, value] : n::load_npz("build/vanilla_saliency_outputs.npz")) {
    if (key == "logits")
      saved = value;
    if (key == "untrained")
      untrained = value;
  }
  const auto logits = predict(test.images), single = predict(n::slice_axis(test.images, 0, 0, 1));
  const auto parity = n::max(n::abs(logits - saved)),
             batch  = n::max(n::abs(single - n::slice_axis(logits, 0, 0, 1)));
  if (parity.item() != 0 || n::max(n::abs(logits - predict(test.images))).item() != 0 ||
      batch.item() > 5e-6 || before != p.flatten())
    return 1;
  std::print(
      "Fresh restore/repeat {},single/batch {:.9g}within5e-6;all8learned arrays immutable.\n",
      parity.item(),
      batch.item());
  const auto nearest = m::SaliencyNearest(fit, test);
  std::print(
      "| predictor | accuracy | macroF1 | NLL | all ten recalls "
      "|\n|---|---:|---:|---:|---|\n");
  for (const auto& [name, z] : std::vector<std::pair<std::string, n::Tensor>>{
           {"learned", logits}, {"initial", untrained}, {"coarse1NN", nearest}}) {
    const auto score = m::ScoreSensor(z, test.labels, 10);
    std::print(
        "| {} | {:.6f} | {:.6f} | {:.6f} | {} |\n",
        name,
        score.accuracy,
        score.macro_f1,
        score.nll,
        score.recall);
  }
  // confusion_api_ replacement of the earlier generic heatmap.
  const auto count = m::ScoreSequenceClassifier(logits, test.labels).confusion;
  std::print("All100learned confusion counts {}.\n", count);
  n::ConfusionMatrix::from_counts(count).save_svg(
      "build/vanilla_saliency_confusion.svg", {.title = "All 200 held-out MNIST predictions"});
}
```
