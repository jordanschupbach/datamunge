its errors;they do not validate the correctness of those scores.

> Fixed targets,signed maps and actual initial-weight controls

Choose the first held-out observation of each true digit0..9without examining
its gradient. The selected target is the learned top raw logit;the runner-up
is fixed separately. Differentiate the SUM of selected raw logits with ordinary
backpropagation,keeping target IDs fixed. The image scale is[0,1],so these are
derivatives per unit normalized pixel,not per integer byte. No absolute-value,
softmax or loss transform occurs before differentiation.

The gallery shares one absolute gradient peak across selected,runner and
initial-weight derivatives. Signed values map negative-to-black,zero-to-grey,
positive-to-white;the absolute map uses0black/peakwhite. Report all case IDs,
true/target/runner classes,repeat/single-batch checks and a real-image central
finite difference at the largest-magnitude first-image gradient coordinate.
```{cpp, results="markdown", file="figures/vanilla_saliency_maps.png", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

#include <print>
int main() {
  namespace n = dm::nn;
  namespace m = n::models;
  n::set_num_threads(2);

  std::filesystem::path cache;
  if (const auto *p = std::getenv("DATAMUNGE_DATA_DIR"))
    cache = p;
  else if (const auto *p = std::getenv("XDG_CACHE_HOME"))
    cache = std::filesystem::path(p) / "datamunge/datasets";
  else
    cache = std::filesystem::path(std::getenv("HOME")) / ".cache/datamunge/datasets";

  dm::datasets::prepare_example_data("mnist-assets", cache.string());
  const auto pools = m::LoadSaliency(cache / "saliency");
  const auto &fit = pools[0];
  const auto &validation = pools[1];
  const auto &test = pools[2];

  n::ParameterStore p(1103);
  {
    n::NoGradGuard guard;
    m::SaliencyCnn(p, n::zeros({1, 28, 28, 1}));
  }
  auto predict = [&](const n::Tensor &images) {
    n::NoGradGuard guard;
    std::vector<n::Tensor> parts;
    for (std::int64_t start = 0; start < images.size(0); start += 32)
      parts.push_back(
          m::SaliencyCnn(p, n::slice_axis(images, 0, start,
                                          std::min<std::int64_t>(start + 32, images.size(0))))
              .logits);
    return n::concat(parts, 0);
  };

  for (const auto &[key, value] : n::load_npz("build/vanilla_saliency_best.npz"))
    p.set(key, value.clone());

  std::vector<std::int64_t> chosen;
  const auto labels = test.labels.to_vector<int>();
  for (int digit = 0; digit < 10; ++digit) {
    const auto it = std::find(labels.begin(), labels.end(), digit);
    chosen.push_back(it - labels.begin());
  }
  const auto examples = m::SaliencyRows(test, chosen);
  const auto z = predict(examples.images);
  const auto sorted = n::argsort(z, true);
  const auto targets = n::select(sorted, 1, 0).to(n::DType::Int32),
             runners = n::select(sorted, 1, 1).to(n::DType::Int32);

  const auto before = p.flatten();
  auto forward = [&](const n::Tensor &x) {
    return m::SaliencyCnn(p, x).logits;
  };
  const auto gradient = m::VanillaInputGradient(forward, examples.images, targets),
             runner = m::VanillaInputGradient(forward, examples.images, runners);
  n::ParameterStore random(1103);
  {
    n::NoGradGuard guard;
    m::SaliencyCnn(random, n::zeros({1, 28, 28, 1}));
  }
  for (const auto &[key, value] : n::load_npz("build/vanilla_saliency_initial.npz"))
    random.set(key, value.clone());
  const auto initial_before = random.flatten();
  const auto initial = m::VanillaInputGradient(
      [&](const n::Tensor &x) {
        return m::SaliencyCnn(random, x).logits;
      },
      examples.images, targets);
  const auto repeated = m::VanillaInputGradient(forward, examples.images, targets),
             single = m::VanillaInputGradient(forward, n::slice_axis(examples.images, 0, 0, 1),
                                              n::slice_axis(targets, 0, 0, 1));
  const auto repeat = n::max(n::abs(gradient - repeated)),
             batch = n::max(n::abs(single - n::slice_axis(gradient, 0, 0, 1))),
             target_delta = n::sum(n::abs(gradient - runner)),
             weight_delta = n::sum(n::abs(gradient - initial));
  const auto peak = n::max(n::stack({n::max(n::abs(gradient)), n::max(n::abs(runner)),
                                     n::max(n::abs(initial))},
                                    0))
                        .item();
  const auto positive = n::sum(n::greater(gradient, 0.).to(n::DType::Int32)).item(),
             negative = n::sum(n::less(gradient, 0.).to(n::DType::Int32)).item();
  const int coordinate = n::argmax(n::abs(single).reshape({784}), 0).item<int>();
  const auto axis = n::arange(0, 784, 1, n::DType::Int64);
  const auto perturb =
      n::equal(axis, coordinate).to(n::DType::Float32).reshape({1, 28, 28, 1}) * .001;
  const auto image = n::slice_axis(examples.images, 0, 0, 1),
             target = n::slice_axis(targets, 0, 0, 1);
  const auto fd = (m::SaliencyScore(forward(image + perturb), target) -
                   m::SaliencyScore(forward(image - perturb), target)) /
                  .002;
  const auto fd_error = n::abs(fd - single.reshape({784}).at({coordinate}));
  if (repeat.item() != 0 || batch.item() > 2e-6 || target_delta.item() <= 1e-4 ||
      weight_delta.item() <= 1e-4 || positive <= 0 || negative <= 0 ||
      fd_error.item() > .02 + .02 * std::abs(single.reshape({784}).at({coordinate})) ||
      before != p.flatten() || initial_before != random.flatten())
    return 1;
  std::print("All7840selected input derivatives:positive {},negative {};repeat "
             "{},single/batch {:.9g};target/initial-weight L1 {:.9g}/{:.9g};real "
             "FDcoordinate{}error {:.9g};all16learned/control arrays immutable.\n",
             positive, negative, repeat.item(), batch.item(), target_delta.item(),
             weight_delta.item(), coordinate, fd_error.item());
  std::print("| true digit | original source ID | fixed target | fixed runner "
             "|\n|---:|---:|---:|---:|\n");
  for (int i = 0; i < 10; ++i)
    std::print("| {} | {} | {} | {} |\n", examples.labels.at({i}), examples.source.at({i}),
               targets.at({i}), runners.at({i}));
  n::save_npz("build/vanilla_saliency_maps.npz", {{"images", examples.images},
                                                  {"labels", examples.labels},
                                                  {"source_ids", examples.source},
                                                  {"targets", targets},
                                                  {"runners", runners},
                                                  {"logits", z},
                                                  {"gradient", gradient},
                                                  {"runner_gradient", runner},
                                                  {"initial_gradient", initial}});
  const auto display =
      n::concat({examples.images, gradient / (2 * peak) + .5, n::abs(gradient) / peak,
                 runner / (2 * peak) + .5, initial / (2 * peak) + .5},
                0);
  n::save_image_grid(display, "build/vanilla_saliency_maps.png", 10, 0, 1, 2, .8, 4);
}
```
