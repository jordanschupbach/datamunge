> All96explicit tensor Adam updates

Warm all eight learned tensors before Adam(.001). Parameter seed1103,batch
order1109,three epochs,batch32,including the last eight fitting records per
epoch:96updates. The visible initial eight-record gradient probe performs no
update. Validation NLL selects weights;test observations never choose the epoch.
Save both initial and selected arrays for fixed-weight explanation controls.
```{cpp, results="markdown", file="figures/vanilla_saliency_training.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

#include <print>
int main() {
  namespace n = dm::nn;
  namespace m = n::models;
  n::set_num_threads(2);

  std::filesystem::path cache;
  if (const auto *p = std::getenv("DATAMUNGE_DATA_DIR"))
    cache = p;
  else if (const auto *p = std::getenv("XDG_CACHE_HOME"))
    cache = std::filesystem::path(p) / "datamunge/datasets";
  else
    cache = std::filesystem::path(std::getenv("HOME")) / ".cache/datamunge/datasets";

  dm::datasets::prepare_example_data("mnist-assets", cache.string());
  const auto pools = m::LoadSaliency(cache / "saliency");
  const auto &fit = pools[0];
  const auto &validation = pools[1];
  const auto &test = pools[2];

  n::ParameterStore p(1103);
  {
    n::NoGradGuard guard;
    m::SaliencyCnn(p, n::zeros({1, 28, 28, 1}));
  }
  auto predict = [&](const n::Tensor &images) {
    n::NoGradGuard guard;
    std::vector<n::Tensor> parts;
    for (std::int64_t start = 0; start < images.size(0); start += 32)
      parts.push_back(
          m::SaliencyCnn(p, n::slice_axis(images, 0, start,
                                          std::min<std::int64_t>(start + 32, images.size(0))))
              .logits);
    return n::concat(parts, 0);
  };

  n::NamedTensors initial_arrays;
  for (std::size_t i = 0; i < p.size(); ++i)
    initial_arrays.push_back({p.names()[i], p.parameters()[i].clone()});
  n::save_npz("build/vanilla_saliency_initial.npz", initial_arrays);
  const auto initial = m::ScoreSequenceClassifier(predict(fit.images), fit.labels).nll;
  const auto untrained = predict(test.images);
  const auto probe = m::SaliencyRows(fit, {0, 1, 2, 3, 4, 5, 6, 7});
  const auto gradients = n::grad(
      n::sparse_softmax_cross_entropy(m::SaliencyCnn(p, probe.images).logits, probe.labels),
      p.parameters());
  for (const auto &g : gradients)
    if (!n::all(n::is_finite(g)).item<bool>() || n::sum(n::square(g)).item() <= 0)
      return 1;
  n::OptimizerConfig config;
  config.kind = n::OptimizerKind::Adam;
  n::Optimizer adam(p, .001, config);
  n::BatchOrder order(1000, 32, 1109);
  double best = INFINITY;
  int selected = 0, updates = 0;
  std::vector<n::Tensor> history;
  std::print("| epoch | fitting CE | validation NLL |\n|---:|---:|---:|\n");
  for (int epoch = 1; epoch <= 3; ++epoch) {
    order.begin_epoch();
    auto average = n::zeros({}, n::DType::Float64);
    for (;;) {
      const auto rows = order.next();
      if (rows.empty())
        break;
      const auto d = m::SaliencyRows(fit, rows);
      const auto loss =
          n::sparse_softmax_cross_entropy(m::SaliencyCnn(p, d.images).logits, d.labels);
      average = average + loss.detach().to(n::DType::Float64) * double(rows.size()) / 1000.;
      adam.step(n::grad(loss, p.parameters()));
      ++updates;
    }
    const auto val =
        m::ScoreSequenceClassifier(predict(validation.images), validation.labels).nll;
    if (val.item() < best) {
      best = val.item();
      selected = epoch;
      n::NamedTensors arrays;
      for (std::size_t i = 0; i < p.size(); ++i)
        arrays.push_back({p.names()[i], p.parameters()[i]});
      n::save_npz("build/vanilla_saliency_best.npz", arrays);
    }
    history.push_back(n::stack({average, val}, 0));
    std::print("| {} | {:.6f} | {:.6f} |\n", epoch, average.item(), val.item());
  }

  for (const auto &[key, value] : n::load_npz("build/vanilla_saliency_best.npz"))
    p.set(key, value.clone());

  const auto fitted = m::ScoreSequenceClassifier(predict(fit.images), fit.labels).nll;
  n::save_npz("build/vanilla_saliency_outputs.npz",
              {{"logits", predict(test.images)}, {"untrained", untrained}});
  std::print(
      "{}explicit Adam updates;selected {},validation {:.6f};fixed fitNLL {:.9f}->{:.9f}.\n",
      updates, selected, best, initial.item(), fitted.item());
  const auto h = n::stack(history, 0);
  auto plot = dm::graphics::RPlot::create();
  plot.lines(n::arange(1, 4).to_vector<double>(), n::select(h, 1, 0).to_vector<double>(),
             "fit CE", {37, 99, 235})
      .lines(n::arange(1, 4).to_vector<double>(), n::select(h, 1, 1).to_vector<double>(),
             "validation", {220, 38, 38})
      .title("Ninety-six explicit tensor Adam updates")
      .x_label("epoch;32fitting batches each")
      .y_label("categorical CE/NLL");
  plot.save_svg("build/vanilla_saliency_training.svg");
}
```
