> Every full-width tap, all 2,944 channel maps and all 64 learned first filters

Tap `block1_conv1`, `block2_conv2`, `block3_conv4`, `block4_conv4`, `block5_conv4`:
spatial sides 64/32/16/8/4, widths 64/128/256/512/512. All 16 convolutions and intervening
max pools actually execute; these are not analytical shapes. Single-image versus
batched Float32 feature values use the original example's absolute 0.005 tolerance;
repeat execution and all learned constants must remain exact. Preserve all 2,944
channel maps across two images. For each layer, show every channel with one
shared maximum across both images and all channels of that layer, and then with a
separate observation/channel maximum. Different layers have different units.

Each mosaic is observation-major: all dog channels first, then all painting
channels. Sixteen tiles per row; channel c occupies row floor(c/16), column c mod 16
inside that observation's block. Low-resolution deep maps use explicit integer
pixel enlargement. All original raw maps and exact normalizing peaks remain
saved. Across both observations, the final block has 708 all-zero channels out of 1,024;
black deep-map tiles are actual zero responses, not omitted observations. The
third-block shared peak is 15,109.4736, so weak channels can look dim under the
honest shared scale and vivid under local scaling.

The learned first-layer filter display has 64 kernels, three-by-three RGB
weights, one shared signed absolute scale and grey zero; it is not an optimized
input or attribution map.
```{cpp, results="markdown", file="figures/filter_activations_filters.png", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

#include <print>
int main() {
  namespace n = dm::nn;
  namespace m = n::models;
  n::set_num_threads(2);

  std::filesystem::path cache;
  if (const auto *p = std::getenv("DATAMUNGE_DATA_DIR"))
    cache = p;
  else if (const auto *p = std::getenv("XDG_CACHE_HOME"))
    cache = std::filesystem::path(p) / "datamunge/datasets";
  else
    cache = std::filesystem::path(std::getenv("HOME")) / ".cache/datamunge/datasets";

  std::filesystem::path assets = cache / "style_transfer";
  if (const auto *v = std::getenv("DATAMUNGE_STYLE_DIR"))
    assets = v;
  else
    dm::datasets::prepare_example_data("style", assets.string());

  const auto tensors = m::LoadTensorMap((assets / "vgg19.npz").string());
  const m::FrozenVgg19 model(tensors);
  std::vector<std::pair<std::string, n::Tensor>> before;
  for (const auto &[key, value] : model.constants)
    before.push_back({key, value.clone()});
  n::Tensor rgb;
  for (const auto &[key, value] : n::load_npz("build/filter_activations_inputs.npz"))
    if (key == "rgb")
      rgb = value;
  n::NoGradGuard guard;
  const auto features = m::VggVisualFeatures(model, rgb),
             repeat = m::VggVisualFeatures(model, rgb),
             single = m::VggVisualFeatures(model, n::slice_axis(rgb, 0, 0, 1));
  n::NamedTensors arrays{{"rgb", rgb},
                         {"centered", features.centered},
                         {"first_pre", features.first_pre},
                         {"first_kernel", tensors.at("block1_conv1_W")},
                         {"first_bias", tensors.at("block1_conv1_b")}};
  auto max_repeat = n::zeros({}), max_single = n::zeros({});
  int channels = 0;
  std::print("| canonical tap | actual shape | shared maximum | allzero channels across both "
             "images |\n|---|---|---:|---:|\n");
  for (int layer = 0; layer < 5; ++layer) {
    const auto &x = features.activation[layer];
    channels += 2 * x.size(3);
    max_repeat = n::maximum(max_repeat, n::max(n::abs(x - repeat.activation[layer])));
    max_single = n::maximum(
        max_single, n::max(n::abs(n::slice_axis(x, 0, 0, 1) - single.activation[layer])));
    const auto maxima = n::max(x, {1, 2});
    std::print("| {} | {} | {:.9g} | {} |\n", features.names[layer], x.shape(),
               n::max(x).item(), n::sum(n::equal(maxima, 0.).to(n::DType::Int32)).item());
    arrays.push_back({features.names[layer], x});
    arrays.push_back({features.names[layer] + "_channel_maxima", maxima});
    arrays.push_back(
        {features.names[layer] + "_mean", n::mean(x.to(n::DType::Float64), {1, 2})});
    arrays.push_back({features.names[layer] + "_positive",
                      n::mean(n::greater(x, 0.).to(n::DType::Float64), {1, 2})});
    for (bool local : {false, true}) {
      const auto maps = m::VisualChannelImages(x, local);
      const auto name = "filter_activations_layer" + std::to_string(layer) +
                        (local ? "_local" : "_shared") + ".png";
      n::save_image_grid(maps, "build/" + name, 16, 0, 1, 2, .1,
                         std::max(1, 32 / int(x.size(1))));
      std::filesystem::copy_file("build/" + name, "figures/" + name,
                                 std::filesystem::copy_options::overwrite_existing);
    }
  }
  bool immutable = true;
  for (const auto &[key, value] : before)
    immutable = immutable && n::all(n::equal(value, model.constants.at(key))).item<bool>();
  if (max_repeat.item() != 0 || max_single.item() > .005 || !immutable || channels != 2944)
    return 1;
  std::print("All{}actual channel maps;repeat {},single/batch max "
             "{:.9g}within.005;all32official constants immutable.\n",
             channels, max_repeat.item(), max_single.item());
  n::save_npz("build/filter_activations_features.npz", arrays);
  const auto kernel =
      n::transpose(n::reverse(tensors.at("block1_conv1_W"), {2}), {3, 0, 1, 2});
  const auto peak = n::max(n::abs(kernel));
  n::save_image_grid(kernel / (peak * 2) + .5, "build/filter_activations_filters.png", 8, 0, 1,
                     3, .8, 12);
  std::print("All64learnedRGBdisplay filters share signed absolute peak {:.9g};BGRinputweight "
             "channels reversed ONLYforRGBdisplay.\n",
             peak.item());
}
```
