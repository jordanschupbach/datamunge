> Both actual observed inputs

The original source archive and JPEGs are already prepared by the style reports.
The following program directly decodes those JPEGs through the canonical tensor
image loader and shows the exact 64 px observations used by VGG19. The independent
original-example run uses the same serialized inputs and includes 640 host first-
convolution corner/center probes across both images and all 64 first-layer channel.
```{cpp, results="markdown", file="figures/filter_activations_inputs.png", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

#include <print>
int main() {
  namespace n = dm::nn;
  namespace m = n::models;

  std::filesystem::path cache;
  if (const auto *p = std::getenv("DATAMUNGE_DATA_DIR"))
    cache = p;
  else if (const auto *p = std::getenv("XDG_CACHE_HOME"))
    cache = std::filesystem::path(p) / "datamunge/datasets";
  else
    cache = std::filesystem::path(std::getenv("HOME")) / ".cache/datamunge/datasets";

  std::filesystem::path assets = cache / "style_transfer";
  if (const auto *v = std::getenv("DATAMUNGE_STYLE_DIR"))
    assets = v;
  else
    dm::datasets::prepare_example_data("style", assets.string());

  const auto dog = m::LoadStyleImage(assets / "content.jpg", 64),
             painting = m::LoadStyleImage(assets / "style.jpg", 64);
  const auto rgb = n::concat({dog, painting}, 0);
  n::save_npz("build/filter_activations_inputs.npz", {{"rgb", rgb}});
  std::print("Actual RGB shape {},original JPEG source {} and {};unit-channel means {}.\n",
             rgb.shape(), (assets / "content.jpg").string(), (assets / "style.jpg").string(),
             n::mean(rgb, {1, 2}));
  n::save_image_grid(rgb, "build/filter_activations_inputs.png", 2, 0, 1, 2, .8, 4);
}
```
