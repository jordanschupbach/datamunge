> Every per-channel response and sparsity summary

Plot every channel's actual mean activation and positive-pixel fraction for
both observations. Shared display contrast preserves within-layer amplitude;
local display contrast exposes patterns while discarding that amplitude.
Neither response size nor visual texture identifies a class explanation.
The first-convolution independent host probes, all original input/preprocessing
values and every layer are also checked against an independent TensorFlow model.
```{cpp, results="markdown", file="figures/filter_activations_statistics.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

#include <print>
int main() {
  namespace n = dm::nn;
  std::map<std::string, n::Tensor> a;
  for (const auto &[key, value] : n::load_npz("build/filter_activations_features.npz"))
    a.emplace(key, value);
  auto left = dm::graphics::RPlot::create(), right = dm::graphics::RPlot::create();
  const std::vector<std::string> names{"block1_conv1", "block2_conv2", "block3_conv4",
                                       "block4_conv4", "block5_conv4"};
  const std::vector<dm::graphics::RGB> colors{
      {37, 99, 235}, {220, 38, 38}, {22, 163, 74}, {147, 51, 234}, {234, 88, 12}};
  std::print("| layer | dog mean positive fraction | painting mean positive fraction | "
             "dog/painting mean response |\n|---|---:|---:|---|\n");
  int offset = 0;
  for (int layer = 0; layer < 5; ++layer) {
    const auto mean = a.at(names[layer] + "_mean"),
               positive = a.at(names[layer] + "_positive");
    std::print("| {} | {:.9g} | {:.9g} | {:.9g}/{:.9g} |\n", names[layer],
               n::mean(n::select(positive, 0, 0)).item(),
               n::mean(n::select(positive, 0, 1)).item(),
               n::mean(n::select(mean, 0, 0)).item(), n::mean(n::select(mean, 0, 1)).item());
    const auto index = n::arange(offset, offset + mean.size(1)).to_vector<double>();
    left.lines(index, n::select(positive, 0, 0).to_vector<double>(), names[layer],
               colors[layer]);
    right.lines(index, n::select(positive, 0, 1).to_vector<double>(), names[layer],
                colors[layer]);
    offset += mean.size(1);
  }
  left.title("Every dog channel positive fraction")
      .x_label("all1472channels,layer-concatenated")
      .y_label("positive spatial fraction")
      .y_limits(0, 1.15);
  right.title("Every painting channel positive fraction")
      .x_label("same channel ordinal and layer order")
      .y_label("positive spatial fraction")
      .y_limits(0, 1.15);
  auto layout = dm::graphics::RLayout::create(1, 2);
  layout.add(left).add(right).size(1100, 500).fit_panels().save_svg(
      "build/filter_activations_statistics.svg");
}
```
