> Complete per-case roughness and uncertainty diagnostics

Measure local absolute first differences divided by total absolute map magnitude.
This dimensionless roughness is a descriptive statistic,not a quality score.
Compare signed means and ordinary derivatives for all ten cases. Also retain
pixelwise MonteCarloSE and meanabsolute-minus-absmean,which measures cancellation
in the signed sample mean. Larger sample count does not guarantee every finite-
bank comparison improves;independent-seed and clipping controls remain visible.
```{cpp, results="markdown", file="figures/smoothgrad_diagnostics.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

#include <print>
int main() {
  namespace n = dm::nn;
  std::map<std::string, n::Tensor> a;
  for (const auto &[key, value] : n::load_npz("build/smoothgrad_maps.npz"))
    a.emplace(key, value);
  std::vector<n::Tensor> curves;
  std::print("| summary | per-case roughness0..9 |\n|---|---|\n");
  for (const std::string key : {"ordinary", "main_mean", "prefix_mean", "second_seed_mean",
                                "large_sigma_mean", "clipped_mean"}) {
    const auto x = a.at(key).to(n::DType::Float64);
    const auto dy = n::sum(n::abs(n::slice_axis(x, 1, 1, 28) - n::slice_axis(x, 1, 0, 27)),
                           {1, 2, 3}),
               dx = n::sum(n::abs(n::slice_axis(x, 2, 1, 28) - n::slice_axis(x, 2, 0, 27)),
                           {1, 2, 3}),
               scale = n::sum(n::abs(x), {1, 2, 3});
    const auto rough = (dy + dx) / n::maximum(scale, n::full({10}, 1e-30, n::DType::Float64));
    curves.push_back(rough);
    std::print("| {} | {} |\n", key, rough);
  }
  std::print("All7840meanabs-minus-absmean sum {:.9g};mean primary MonteCarloSE "
             "{:.9g};independent-seed signed-mean L1 {:.9g}.\n",
             n::sum(a.at("main_mean_absolute") - n::abs(a.at("main_mean"))).item(),
             n::mean(a.at("main_standard_error")).item(),
             n::sum(n::abs(a.at("main_mean") - a.at("second_seed_mean"))).item());
  auto left = dm::graphics::RPlot::create(), right = dm::graphics::RPlot::create();
  const std::vector<std::string> labels{"ordinary",    "main32",   "prefix8",
                                        "second seed", "sigma.30", "clipped"};
  const std::vector<dm::graphics::RGB> colors{{37, 99, 235}, {220, 38, 38}, {22, 163, 74}};
  for (int i = 0; i < 3; ++i) {
    left.lines(n::arange(0, 10).to_vector<double>(), curves[i].to_vector<double>(), labels[i],
               colors[i]);
    right.lines(n::arange(0, 10).to_vector<double>(), curves[i + 3].to_vector<double>(),
                labels[i + 3], colors[i]);
  }
  left.title("Ordinary and sample-count roughness")
      .x_label("true digit0..9")
      .y_label("absolute TV / map L1");
  right.title("Seed,noise scale and clipping controls")
      .x_label("true digit0..9")
      .y_label("same descriptive roughness");
  auto layout = dm::graphics::RLayout::create(1, 2);
  layout.add(left).add(right).size(1100, 500).fit_panels().save_svg(
      "build/smoothgrad_diagnostics.svg");
}
```
