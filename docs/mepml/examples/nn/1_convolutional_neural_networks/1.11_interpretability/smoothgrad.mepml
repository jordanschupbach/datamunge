> Explicit banks and complete real-image controls

Tensor Box–Muller transformations use source-compatible mt19937raw draws,
seed1171. Keep32replicas,an exact eight-replica prefix,an independent seed1173,
double sigma.30,clipped sigma.15,runner-up,actual-initial weights and sigma0.
Paired controls reuse the same standardized bank. Float64tensor arithmetic
forms noisy points,then Float32rounds before optional clipping;ordinary gradients
are evaluated at those points. Double reductions produce signed/magnitude
means,unbiased sample variance and sqrt(variance/samplecount)standard errors.
No learned parameter,optimizer or hidden random draw enters these summaries.
The primary bank places114211of250880noisy coordinates outside[0,1],about45.5%.
Its signed mean differs from the ordinary gradient by L1 132.801926;switching
to the independent seed changes it by33.9671936. Meanabsolute-minus-absmean
sums29.6115341,and mean primary coordinateSEis.00376360933. These measured
finite-bank effects remain visible alongside the image gallery.
```{cpp, results="markdown", file="figures/smoothgrad_maps.png", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

#include <print>
int main() {
  namespace n = dm::nn;
  namespace m = n::models;
  n::set_num_threads(2);

  std::filesystem::path cache;
  if (const auto *p = std::getenv("DATAMUNGE_DATA_DIR"))
    cache = p;
  else if (const auto *p = std::getenv("XDG_CACHE_HOME"))
    cache = std::filesystem::path(p) / "datamunge/datasets";
  else
    cache = std::filesystem::path(std::getenv("HOME")) / ".cache/datamunge/datasets";

  dm::datasets::prepare_example_data("mnist-assets", cache.string());
  const auto pools = m::LoadSaliency(cache / "saliency");
  const auto &fit = pools[0];
  const auto &validation = pools[1];
  const auto &test = pools[2];

  n::ParameterStore p(1103);
  {
    n::NoGradGuard guard;
    m::SaliencyCnn(p, n::zeros({1, 28, 28, 1}));
  }
  auto predict = [&](const n::Tensor &images) {
    n::NoGradGuard guard;
    std::vector<n::Tensor> parts;
    for (std::int64_t start = 0; start < images.size(0); start += 32)
      parts.push_back(
          m::SaliencyCnn(p, n::slice_axis(images, 0, start,
                                          std::min<std::int64_t>(start + 32, images.size(0))))
              .logits);
    return n::concat(parts, 0);
  };

  for (const auto &[key, value] : n::load_npz("build/vanilla_saliency_best.npz"))
    p.set(key, value.clone());

  std::vector<std::int64_t> chosen;
  const auto labels = test.labels.to_vector<int>();
  for (int digit = 0; digit < 10; ++digit) {
    const auto it = std::find(labels.begin(), labels.end(), digit);
    chosen.push_back(it - labels.begin());
  }
  const auto examples = m::SaliencyRows(test, chosen);
  const auto z = predict(examples.images);
  const auto sorted = n::argsort(z, true);
  const auto targets = n::select(sorted, 1, 0).to(n::DType::Int32),
             runners = n::select(sorted, 1, 1).to(n::DType::Int32);

  const auto before = p.flatten();
  n::ParameterStore random(1103);
  {
    n::NoGradGuard guard;
    m::SaliencyCnn(random, n::zeros({1, 28, 28, 1}));
  }
  for (const auto &[key, value] : n::load_npz("build/vanilla_saliency_initial.npz"))
    random.set(key, value.clone());
  const auto random_before = random.flatten();
  m::InputGradientFunction gradient = [&](const n::Tensor &points, const n::Tensor &classes) {
    return m::VanillaInputGradient(
        [&](const n::Tensor &x) {
          return m::SaliencyCnn(p, x).logits;
        },
        points, classes);
  };
  m::InputGradientFunction initial_gradient = [&](const n::Tensor &points,
                                                  const n::Tensor &classes) {
    return m::VanillaInputGradient(
        [&](const n::Tensor &x) {
          return m::SaliencyCnn(random, x).logits;
        },
        points, classes);
  };
  const auto bank = m::SmoothGradNoise(examples.images.shape(), 32, 1171),
             second = m::SmoothGradNoise(examples.images.shape(), 32, 1173),
             prefix = n::slice_axis(bank, 0, 0, 8);
  const auto ordinary = gradient(examples.images, targets);
  std::vector<std::pair<std::string, m::SmoothGradResult>> groups;
  groups.push_back(
      {"main", m::SmoothGrad(examples.images, targets, bank, .15f, false, 32, gradient)});
  groups.push_back(
      {"prefix", m::SmoothGrad(examples.images, targets, prefix, .15f, false, 32, gradient)});
  groups.push_back({"second_seed", m::SmoothGrad(examples.images, targets, second, .15f, false,
                                                 32, gradient)});
  groups.push_back({"large_sigma",
                    m::SmoothGrad(examples.images, targets, bank, .30f, false, 32, gradient)});
  groups.push_back(
      {"clipped", m::SmoothGrad(examples.images, targets, bank, .15f, true, 32, gradient)});
  groups.push_back(
      {"runner", m::SmoothGrad(examples.images, runners, bank, .15f, false, 32, gradient)});
  groups.push_back({"initial", m::SmoothGrad(examples.images, targets, bank, .15f, false, 32,
                                             initial_gradient)});
  groups.push_back(
      {"zero", m::SmoothGrad(examples.images, targets, n::slice_axis(bank, 0, 0, 2), 0.f,
                             false, 32, gradient)});
  const auto repeat = m::SmoothGrad(examples.images, targets, bank, .15f, false, 32, gradient);
  const auto replay = n::max(n::abs(groups[0].second.mean - repeat.mean)),
             zero = n::max(n::abs(groups.back().second.mean - ordinary));
  if (replay.item() != 0 || zero.item() > 2e-6 || before != p.flatten() ||
      random_before != random.flatten() ||
      n::max(n::abs(prefix - m::SmoothGradNoise(examples.images.shape(), 8, 1171))).item() !=
          0)
    return 1;
  std::print("Exact replay {},sigma0vanilla max {:.9g};all16selected/controlarrays "
             "unchanged;actual source IDs {},targets {},runners {}.\n",
             replay.item(), zero.item(), examples.source, targets, runners);
  n::NamedTensors arrays{{"images", examples.images},
                         {"source_ids", examples.source},
                         {"targets", targets},
                         {"runners", runners},
                         {"ordinary", ordinary}};
  auto peak = n::max(n::abs(ordinary));
  for (const auto &[name, result] : groups)
    peak = n::maximum(peak, n::max(n::abs(result.mean)));
  std::vector<n::Tensor> display{examples.images, ordinary / (peak * 2) + .5};
  std::print("| group | samples | total L1change from ordinary | mean MonteCarloSE | "
             "off-domain noisy coordinates |\n|---|---:|---:|---:|---:|\n");
  for (const auto &[name, result] : groups) {
    for (const auto &[key, value] : std::vector<std::pair<std::string, n::Tensor>>{
             {"mean", result.mean},
             {"mean_absolute", result.mean_absolute},
             {"mean_square", result.mean_square},
             {"sample_variance", result.sample_variance},
             {"standard_error", result.standard_error},
             {"standard_noise", result.standard_noise},
             {"noisy_input", result.noisy_input},
             {"sample_gradient", result.sample_gradient}})
      arrays.push_back({name + "_" + key, value});
    display.push_back(result.mean / (peak * 2) + .5);
    const auto outside = n::sum(
        n::logical_or(n::less(result.noisy_input, 0.), n::greater(result.noisy_input, 1.))
            .to(n::DType::Int32));
    std::print("| {} | {} | {:.9g} | {:.9g} | {} |\n", name, result.standard_noise.size(0),
               n::sum(n::abs(result.mean - ordinary)).item(),
               n::mean(result.standard_error).item(), outside.item());
  }
  n::save_npz("build/smoothgrad_maps.npz", arrays);
  n::save_image_grid(n::select(n::slice_axis(groups[0].second.noisy_input, 0, 0, 8), 1, 0),
                     "build/smoothgrad_noisy.png", 4, 0, 1, 2, .8, 4);
  std::filesystem::copy_file("build/smoothgrad_noisy.png", "figures/smoothgrad_noisy.png",
                             std::filesystem::copy_options::overwrite_existing);
  n::save_image_grid(n::concat(display, 0), "build/smoothgrad_maps.png", 10, 0, 1, 2, .8, 4);
}
