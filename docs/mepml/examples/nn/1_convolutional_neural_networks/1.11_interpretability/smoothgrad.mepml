> A finite-bank hand check

A linear score with gradient[1,-2,0]has the same mean gradient under any noise
bank and zero sample variance. A quadratic score with ordinary derivative c*x
has a finite-bank mean c*mean(noisy x),which need not equal c*original x.
Sigma0recovers the ordinary derivative. Meanabsolute generally exceeds abs(mean).
All these facts are tested with fixed explicit noise and different callback batches.
```{cpp, results="markdown", file="figures/smoothgrad_fixture.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

#include <print>
int main() {
  namespace n = dm::nn;
  namespace m = n::models;
  const auto x = n::from_vector(std::vector<float>{.1f, .3f, .5f, -.2f, .7f, 1.2f}, {2, 3}),
             t = n::zeros({2}, n::DType::Int32),
             c = n::from_vector(std::vector<float>{1, -2, 0}, {3});
  const auto bank = m::SmoothGradNoise(x.shape(), 32, 1171);
  const auto linear =
      m::SmoothGrad(x, t, bank, .5f, false, 7, [&](const n::Tensor &p, const n::Tensor &) {
        return n::ones(p.shape()) * c;
      });
  const auto quadratic =
      m::SmoothGrad(x, t, bank, .5f, false, 1, [&](const n::Tensor &p, const n::Tensor &) {
        return p * c;
      });
  const auto expected =
      (n::mean(quadratic.noisy_input.to(n::DType::Float64), {0}) * c.to(n::DType::Float64))
          .to(n::DType::Float32);
  std::print("Linear mean {},variance {};quadratic finite-bank maxparity "
             "{:.9g};meanabs-minus-absmean {}.\n",
             linear.mean, linear.sample_variance,
             n::max(n::abs(quadratic.mean - expected)).item(),
             quadratic.mean_absolute - n::abs(quadratic.mean));
  auto plot = dm::graphics::RPlot::create();
  plot.points(n::arange(0, 6).to_vector<double>(),
              quadratic.mean.reshape({6}).to_vector<double>(), "signed mean", {37, 99, 235})
      .points(n::arange(0, 6).to_vector<double>(),
              quadratic.mean_absolute.reshape({6}).to_vector<double>(), "mean absolute",
              {220, 38, 38})
      .title("Declared finite-bank gradient summaries")
      .x_label("two cases,three coordinates each")
      .y_label("gradient summary");
  plot.save_svg("build/smoothgrad_fixture.svg");
}
```
