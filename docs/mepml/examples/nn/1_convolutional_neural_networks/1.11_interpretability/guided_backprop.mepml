> Guided,ordinary,target and weight controls

Use the same selected store for ordinary and guided execution,and restore two
independent controls:actual initial weights,and selected weights with only the
categorical head reset to its actual initial arrays. Compute fixed selected-target and runner-up signals.
Cosine similarity is a sensitivity control,not an explanation-quality score.
Guided input signals can still contain both signs because convolution weights
remain signed;the positive gate acts at hidden ReLUs,not at the final input.
All signals use one global absolute display peak,with signed zero grey.
The actual mean guided cosine is.817330223for the runner-up,.758817072for
full initialization,and.997573187for the initial-head control. The latter
remains visually very similar despite the changed head,so a sharp-looking
gallery alone does not demonstrate dependence on the learned class head.
```{cpp, results="markdown", file="figures/guided_backprop_maps.png", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

#include <print>
int main() {
  namespace n = dm::nn;
  namespace m = n::models;
  n::set_num_threads(2);

  std::filesystem::path cache;
  if (const auto *p = std::getenv("DATAMUNGE_DATA_DIR"))
    cache = p;
  else if (const auto *p = std::getenv("XDG_CACHE_HOME"))
    cache = std::filesystem::path(p) / "datamunge/datasets";
  else
    cache = std::filesystem::path(std::getenv("HOME")) / ".cache/datamunge/datasets";

  dm::datasets::prepare_example_data("mnist-assets", cache.string());
  const auto pools = m::LoadSaliency(cache / "saliency");
  const auto &fit = pools[0];
  const auto &validation = pools[1];
  const auto &test = pools[2];

  n::ParameterStore p(1103);
  {
    n::NoGradGuard guard;
    m::SaliencyCnn(p, n::zeros({1, 28, 28, 1}));
  }
  auto predict = [&](const n::Tensor &images) {
    n::NoGradGuard guard;
    std::vector<n::Tensor> parts;
    for (std::int64_t start = 0; start < images.size(0); start += 32)
      parts.push_back(
          m::SaliencyCnn(p, n::slice_axis(images, 0, start,
                                          std::min<std::int64_t>(start + 32, images.size(0))))
              .logits);
    return n::concat(parts, 0);
  };

  for (const auto &[key, value] : n::load_npz("build/vanilla_saliency_best.npz"))
    p.set(key, value.clone());

  std::vector<std::int64_t> chosen;
  const auto labels = test.labels.to_vector<int>();
  for (int digit = 0; digit < 10; ++digit) {
    const auto it = std::find(labels.begin(), labels.end(), digit);
    chosen.push_back(it - labels.begin());
  }
  const auto examples = m::SaliencyRows(test, chosen);
  const auto z = predict(examples.images);
  const auto sorted = n::argsort(z, true);
  const auto targets = n::select(sorted, 1, 0).to(n::DType::Int32),
             runners = n::select(sorted, 1, 1).to(n::DType::Int32);

  const auto before = p.flatten();
  n::ParameterStore fresh(1103), head(1103);
  {
    n::NoGradGuard guard;
    m::SaliencyCnn(fresh, n::zeros({1, 28, 28, 1}));
    m::SaliencyCnn(head, n::zeros({1, 28, 28, 1}));
  }
  for (const auto &[key, value] : n::load_npz("build/vanilla_saliency_best.npz"))
    head.set(key, value.clone());
  for (const auto &[key, value] : n::load_npz("build/vanilla_saliency_initial.npz")) {
    fresh.set(key, value.clone());
    if (key.starts_with("head/"))
      head.set(key, value.clone());
  }
  const auto fresh_before = fresh.flatten(), head_before = head.flatten();
  auto ordinary = [&](const n::Tensor &x) {
    return m::SaliencyCnn(p, x).logits;
  };
  auto guided = [&](const n::Tensor &x) {
    return m::GuidedSaliencyCnn(p, x).logits;
  };
  const auto vanilla = m::VanillaInputGradient(ordinary, examples.images, targets),
             signal = m::VanillaInputGradient(guided, examples.images, targets),
             runner = m::VanillaInputGradient(guided, examples.images, runners),
             initial = m::VanillaInputGradient(
                 [&](const n::Tensor &x) {
                   return m::GuidedSaliencyCnn(fresh, x).logits;
                 },
                 examples.images, targets),
             head_reset = m::VanillaInputGradient(
                 [&](const n::Tensor &x) {
                   return m::GuidedSaliencyCnn(head, x).logits;
                 },
                 examples.images, targets);
  const auto repeat = m::VanillaInputGradient(guided, examples.images, targets),
             single = m::VanillaInputGradient(guided, n::slice_axis(examples.images, 0, 0, 1),
                                              n::slice_axis(targets, 0, 0, 1));
  const auto repeated = n::max(n::abs(signal - repeat)),
             batch = n::max(n::abs(single - n::slice_axis(signal, 0, 0, 1)));
  if (repeated.item() != 0 || batch.item() > 2e-6 || before != p.flatten() ||
      fresh_before != fresh.flatten() || head_before != head.flatten())
    return 1;
  std::print(
      "Repeat {},single/batch {:.9g};all24selected/initial/head-reset arrays immutable.\n",
      repeated.item(), batch.item());
  std::vector<n::Tensor> cosines;
  std::print("| control | total guided L1change | mean case cosine |\n|---|---:|---:|\n");
  for (const auto &[name, value] :
       std::vector<std::pair<std::string, n::Tensor>>{{"ordinary", vanilla},
                                                      {"runner", runner},
                                                      {"actual initial", initial},
                                                      {"head reset", head_reset}}) {
    const auto a = signal.to(n::DType::Float64).reshape({10, 784}),
               b = value.to(n::DType::Float64).reshape({10, 784});
    const auto denominator = n::sqrt(n::sum(n::square(a), {1}) * n::sum(n::square(b), {1}));
    const auto cosine =
        n::sum(a * b, {1}) / n::maximum(denominator, n::full({10}, 1e-30, n::DType::Float64));
    cosines.push_back(cosine);
    std::print("| {} | {:.9g} | {:.9g} |\n", name, n::sum(n::abs(signal - value)).item(),
               n::mean(cosine).item());
  }
  const auto peak =
      n::max(n::stack({n::max(n::abs(signal)), n::max(n::abs(vanilla)), n::max(n::abs(runner)),
                       n::max(n::abs(initial)), n::max(n::abs(head_reset))},
                      0))
          .item();
  const auto display = n::concat({examples.images, vanilla / (2 * peak) + .5,
                                  signal / (2 * peak) + .5, runner / (2 * peak) + .5,
                                  initial / (2 * peak) + .5, head_reset / (2 * peak) + .5},
                                 0);
  auto plot = dm::graphics::RPlot::create();
  for (int i = 0; i < 4; ++i)
    plot.lines(n::arange(0, 10).to_vector<double>(), cosines[i].to_vector<double>(),
               std::vector<std::string>{"ordinary", "runner", "initial", "head reset"}[i],
               std::vector<dm::graphics::RGB>{
                   {37, 99, 235}, {220, 38, 38}, {22, 163, 74}, {147, 51, 234}}[i]);
  plot.title("Every case target and weight control")
      .x_label("true digit0..9")
      .y_label("guided-map cosine")
      .y_limits(-1.1, 1.2);
  plot.save_svg("build/guided_backprop_similarity.svg");
  std::filesystem::copy_file("build/guided_backprop_similarity.svg",
                             "figures/guided_backprop_similarity.svg",
                             std::filesystem::copy_options::overwrite_existing);
  n::save_npz("build/guided_backprop_maps.npz", {{"images", examples.images},
                                                 {"targets", targets},
                                                 {"runners", runners},
                                                 {"vanilla", vanilla},
                                                 {"guided", signal},
                                                 {"runner", runner},
                                                 {"initial", initial},
                                                 {"head_reset", head_reset}});
  n::save_image_grid(display, "build/guided_backprop_maps.png", 10, 0, 1, 2, .8, 4);
}
```
