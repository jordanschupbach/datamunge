> Hand-checkable positive/negative/zero gates

Ordinary ReLU reverse propagation is g*1[x>0]. Guided propagation additionally
requires g>0. Incoming-only deconvolution gating omits the forward x>0test.
Atx2,the true derivative of a weighted ReLU with incoming-3is-3,but guided
returns0. For incoming-3and4,separate guided signals sum to4while the guided
signal of their sum1is1. A derivative VJP must be linear in the incoming vector;
this rule is not. Finite differences therefore check the ordinary derivative
and expose the difference;they do not certify guided propagation as a derivative.
```{cpp, results="markdown", file="figures/guided_backprop_gates.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

#include <print>
int main() {
  namespace n = dm::nn;
  namespace m = n::models;
  const auto x =
      n::from_vector(std::vector<float>{-2, -2, -2, 0, 0, 0, 2, 2, 2}, {9}).requires_grad_();
  const auto upstream = n::from_vector(std::vector<float>{-3, 0, 4, -3, 0, 4, -3, 0, 4}, {9});
  const auto guided = n::grad(n::sum(m::GuidedRelu(x) * upstream), {x})[0],
             ordinary = n::grad(n::sum(n::relu(x) * upstream), {x})[0];
  std::print(
      "| x | incoming | ordinary | guided | incoming-only |\n|---:|---:|---:|---:|---:|\n");
  const auto incoming_only = upstream * n::greater(upstream, 0.).to(n::DType::Float32);
  for (int i = 0; i < 9; ++i)
    std::print("| {} | {} | {} | {} | {} |\n", x.at({i}), upstream.at({i}), ordinary.at({i}),
               guided.at({i}), incoming_only.at({i}));
  const auto separate = m::GuidedReluBackward(n::ones({1}), n::full({1}, -3)) +
                        m::GuidedReluBackward(n::ones({1}), n::full({1}, 4));
  const auto together = m::GuidedReluBackward(n::ones({1}), n::ones({1}));
  std::print("Guided separate sum {},combined incoming result {}:NOT a linear VJP.\n",
             separate.item(), together.item());
  auto plot = dm::graphics::RPlot::create();
  plot.points(n::arange(0, 9).to_vector<double>(), ordinary.to_vector<double>(), "ordinary",
              {37, 99, 235})
      .points(n::arange(0, 9).to_vector<double>(), guided.to_vector<double>(), "guided",
              {220, 38, 38})
      .title("All nine sign and zero combinations")
      .x_label("fixture row ordinal")
      .y_label("backward signal")
      .y_limits(-4, 5);
  plot.save_svg("build/guided_backprop_gates.svg");
}
```
