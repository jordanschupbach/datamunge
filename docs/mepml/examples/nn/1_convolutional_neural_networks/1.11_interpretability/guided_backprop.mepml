> Every held-out forward score and all three replacements

The diagnostic count verifies exactly three guided calls per full forward.
Compare all2000held-out raw logits with ordinary execution on the same batch.
Source classifier arrays remain unchanged;this isolates the visualization rule.
Show the same first actual held-out observation of each true digit as before.
```{cpp, results="markdown", file="figures/guided_backprop_data.png", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

#include <print>
int main() {
  namespace n = dm::nn;
  namespace m = n::models;
  n::set_num_threads(2);

  std::filesystem::path cache;
  if (const auto *p = std::getenv("DATAMUNGE_DATA_DIR"))
    cache = p;
  else if (const auto *p = std::getenv("XDG_CACHE_HOME"))
    cache = std::filesystem::path(p) / "datamunge/datasets";
  else
    cache = std::filesystem::path(std::getenv("HOME")) / ".cache/datamunge/datasets";

  dm::datasets::prepare_example_data("mnist-assets", cache.string());
  const auto pools = m::LoadSaliency(cache / "saliency");
  const auto &fit = pools[0];
  const auto &validation = pools[1];
  const auto &test = pools[2];

  n::ParameterStore p(1103);
  {
    n::NoGradGuard guard;
    m::SaliencyCnn(p, n::zeros({1, 28, 28, 1}));
  }
  auto predict = [&](const n::Tensor &images) {
    n::NoGradGuard guard;
    std::vector<n::Tensor> parts;
    for (std::int64_t start = 0; start < images.size(0); start += 32)
      parts.push_back(
          m::SaliencyCnn(p, n::slice_axis(images, 0, start,
                                          std::min<std::int64_t>(start + 32, images.size(0))))
              .logits);
    return n::concat(parts, 0);
  };

  for (const auto &[key, value] : n::load_npz("build/vanilla_saliency_best.npz"))
    p.set(key, value.clone());

  std::vector<std::int64_t> chosen;
  const auto labels = test.labels.to_vector<int>();
  for (int digit = 0; digit < 10; ++digit) {
    const auto it = std::find(labels.begin(), labels.end(), digit);
    chosen.push_back(it - labels.begin());
  }
  const auto examples = m::SaliencyRows(test, chosen);
  const auto z = predict(examples.images);
  const auto sorted = n::argsort(z, true);
  const auto targets = n::select(sorted, 1, 0).to(n::DType::Int32),
             runners = n::select(sorted, 1, 1).to(n::DType::Int32);

  const auto before = p.flatten();
  n::NoGradGuard guard;
  const auto ordinary = m::SaliencyCnn(p, test.images).logits;
  const auto count = m::GuidedReluCount().load();
  const auto guided = m::GuidedSaliencyCnn(p, test.images).logits;
  const auto parity = n::max(n::abs(ordinary - guided));
  if (parity.item() != 0 || m::GuidedReluCount().load() - count != 3 || before != p.flatten())
    return 1;
  std::print(
      "All{}held-out raw logits unchanged,max{};exactly3guided gates,all8weights immutable.\n",
      ordinary.numel(), parity.item());
  std::print("Original case IDs {},true digits {},fixed targets {},runners {}.\n",
             examples.source, examples.labels, targets, runners);
  n::save_image_grid(examples.images, "build/guided_backprop_data.png", 10, 0, 1, 2, .8, 4);
}
```
