> Every case and patch remains inspectable

Compare each actual control's projected map with the primary map and retain
all490primary patch/case score drops,all modified images and source identities.
The following plots show all ten per-case L1changes and positive/negative drop
counts. Changes with replacement,patch geometry,target or weights establish
dependence of the experiment;they do not establish causal pixel importance.
```{cpp, results="markdown", file="figures/occlusion_sensitivity_controls.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

#include <print>
int main() {
  namespace n = dm::nn;
  std::map<std::string, n::Tensor> a;
  for (const auto &[key, value] : n::load_npz("build/occlusion_sensitivity_maps.npz"))
    a.emplace(key, value);
  auto left = dm::graphics::RPlot::create(), right = dm::graphics::RPlot::create();
  const std::vector<std::string> names{"gray", "runner", "initial", "small", "stride"};
  const std::vector<dm::graphics::RGB> colors{
      {37, 99, 235}, {220, 38, 38}, {22, 163, 74}, {147, 51, 234}, {234, 88, 12}};
  std::print("| control | all ten per-case projected-map L1changes |\n|---|---|\n");
  for (int i = 0; i < 5; ++i) {
    const auto delta =
        n::sum(n::abs(a.at("main_pixel_mean") - a.at(names[i] + "_pixel_mean")), {1, 2});
    std::print("| {} | {} |\n", names[i], delta);
    left.lines(n::arange(0, 10).to_vector<double>(), delta.to_vector<double>(), names[i],
               colors[i]);
  }
  const auto positive = n::sum(n::greater(a.at("main_drops"), 0.).to(n::DType::Int32), {0}),
             negative = n::sum(n::less(a.at("main_drops"), 0.).to(n::DType::Int32), {0});
  right
      .points(n::arange(0, 10).to_vector<double>(), positive.to_vector<double>(), "positive",
              {37, 99, 235})
      .points(n::arange(0, 10).to_vector<double>(), negative.to_vector<double>(), "negative",
              {220, 38, 38});
  std::print("\n| primary patch | top,left,height,width | all ten fixed-category drops "
             "|\n|---:|---|---|\n");
  for (int patch = 0; patch < 49; ++patch)
    std::print("| {} | {} | {} |\n", patch,
               n::select(a.at("main_rectangles"), 0, patch).to_vector<int>(),
               n::select(a.at("main_drops"), 0, patch).to_vector<double>());
  left.title("Every replacement and model control")
      .x_label("true digit0..9")
      .y_label("overlap-mean map L1change");
  right.title("Both signs of actual patch effects")
      .x_label("true digit0..9")
      .y_label("number of49actual patches")
      .y_limits(0, 52);
  auto layout = dm::graphics::RLayout::create(1, 2);
  layout.add(left).add(right).size(1100, 500).fit_panels().save_svg(
      "build/occlusion_sensitivity_controls.svg");
}
