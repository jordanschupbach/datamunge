> Rectangular edge anchors and exact overlap accounting

For a4x5image,2x2patch and2x2stride,the horizontal starts are0,2,3:append3to
cover the otherwise missed right edge. Six rectangles cover every pixel;some
pixels belong to two rectangles. The reported pixel map averages signed drops
of all covering patches. It is a projection of patch measurements,not an
additive decomposition of the score into individual pixel contributions.
```{cpp, results="markdown", file="figures/occlusion_sensitivity_fixture.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

#include <print>
int main() {
  namespace n = dm::nn;
  namespace m = n::models;
  const auto x = (n::arange(0, 40) * .02 + .1).reshape({2, 4, 5, 1}),
             replacement = n::full(x.shape(), .2),
             kernel = (n::sin(n::arange(0, 20) * .7) * .1).reshape({1, 4, 5, 1});
  const auto target = n::from_vector(std::vector<int>{0, 1});
  auto predict = [&](const n::Tensor &p) {
    const auto s = n::sum(p * kernel, {1, 2, 3}) + .3;
    return n::stack({s, -s}, 1);
  };
  const auto out = m::OcclusionSensitivity(x, replacement, target, {2, 2, 2, 2}, 3, predict);
  std::print(
      "Every actual rectangle {},coverage {},all12signed drops {},all40overlap means {}.\n",
      out.rectangles, out.coverage, out.drops, out.pixel_mean);
  const auto peak = n::max(n::abs(out.pixel_mean)).item();
  auto a = n::plot_tensor_map(n::reverse(out.coverage, {0}), 0, 2),
       b = n::plot_tensor_map(n::reverse(n::select(out.pixel_mean, 0, 0), {0}), -peak, peak);
  a.title("Declared rectangular-patch coverage").x_label("pixel x").y_label("pixel y");
  b.title("Actual overlap-mean signed drops").x_label("pixel x").y_label("pixel y");
  auto layout = dm::graphics::RLayout::create(1, 2);
  layout.add(a).add(b).size(1100, 500).fit_panels().save_svg(
      "build/occlusion_sensitivity_fixture.svg");
}
```
