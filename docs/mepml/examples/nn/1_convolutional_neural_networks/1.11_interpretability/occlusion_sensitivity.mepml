> All eight real-image intervention configurations

Primary7x7patches with stride4append the21pixel edge anchor,forming49windows.
Compare grey.5replacement,runner-up category,actual-initial weights,5x5/stride3,
7x7/stride7,identity replacement and full-image black replacement. Each variant
runs actual predictions on all its modified images. A larger window count is
not more independent data;overlapping windows share original pixels.

All model inputs,replacements,masks,score subtraction and overlap averaging
use tensors. RawFloat32scores subtract inDouble. Identity replacement has
ideal zero drop;small nonzero Float32differences from different prediction
batch sizes are reported with1e-5tolerance. Full replacement must match the
actual replacement-image prediction. The actual primary experiment gives276positive,154negative and60zero drops.
Identity maximum2.86102295e-6and single/batch maximum3.81469727e-6remain
within the stated numerical tolerance;full replacement agrees exactly with
its actual baseline prediction.

No synthetic noise or derivative proxy
substitutes for the actual counterfactual inputs.
```{cpp, results="markdown", file="figures/occlusion_sensitivity_maps.png", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

#include <print>
int main() {
  namespace n = dm::nn;
  namespace m = n::models;
  n::set_num_threads(2);

  std::filesystem::path cache;
  if (const auto *p = std::getenv("DATAMUNGE_DATA_DIR"))
    cache = p;
  else if (const auto *p = std::getenv("XDG_CACHE_HOME"))
    cache = std::filesystem::path(p) / "datamunge/datasets";
  else
    cache = std::filesystem::path(std::getenv("HOME")) / ".cache/datamunge/datasets";

  dm::datasets::prepare_example_data("mnist-assets", cache.string());
  const auto pools = m::LoadSaliency(cache / "saliency");
  const auto &fit = pools[0];
  const auto &validation = pools[1];
  const auto &test = pools[2];

  n::ParameterStore p(1103);
  {
    n::NoGradGuard guard;
    m::SaliencyCnn(p, n::zeros({1, 28, 28, 1}));
  }
  auto predict = [&](const n::Tensor &images) {
    n::NoGradGuard guard;
    std::vector<n::Tensor> parts;
    for (std::int64_t start = 0; start < images.size(0); start += 32)
      parts.push_back(
          m::SaliencyCnn(p, n::slice_axis(images, 0, start,
                                          std::min<std::int64_t>(start + 32, images.size(0))))
              .logits);
    return n::concat(parts, 0);
  };

  for (const auto &[key, value] : n::load_npz("build/vanilla_saliency_best.npz"))
    p.set(key, value.clone());

  std::vector<std::int64_t> chosen;
  const auto labels = test.labels.to_vector<int>();
  for (int digit = 0; digit < 10; ++digit) {
    const auto it = std::find(labels.begin(), labels.end(), digit);
    chosen.push_back(it - labels.begin());
  }
  const auto examples = m::SaliencyRows(test, chosen);
  const auto z = predict(examples.images);
  const auto sorted = n::argsort(z, true);
  const auto targets = n::select(sorted, 1, 0).to(n::DType::Int32),
             runners = n::select(sorted, 1, 1).to(n::DType::Int32);

  const auto before = p.flatten();
  n::ParameterStore random(1103);
  {
    n::NoGradGuard guard;
    m::SaliencyCnn(random, n::zeros({1, 28, 28, 1}));
  }
  for (const auto &[key, value] : n::load_npz("build/vanilla_saliency_initial.npz"))
    random.set(key, value.clone());
  const auto random_before = random.flatten();
  auto initial_predict = [&](const n::Tensor &x) {
    n::NoGradGuard guard;
    return m::SaliencyCnn(random, x).logits;
  };
  const auto black = n::zeros(examples.images.shape()),
             gray = n::full(examples.images.shape(), .5);
  std::vector<std::pair<std::string, m::OcclusionOutput>> groups;
  groups.push_back({"main", m::OcclusionSensitivity(examples.images, black, targets,
                                                    {7, 7, 4, 4}, 32, predict)});
  groups.push_back({"gray", m::OcclusionSensitivity(examples.images, gray, targets,
                                                    {7, 7, 4, 4}, 32, predict)});
  groups.push_back({"runner", m::OcclusionSensitivity(examples.images, black, runners,
                                                      {7, 7, 4, 4}, 32, predict)});
  groups.push_back({"initial", m::OcclusionSensitivity(examples.images, black, targets,
                                                       {7, 7, 4, 4}, 32, initial_predict)});
  groups.push_back({"small", m::OcclusionSensitivity(examples.images, black, targets,
                                                     {5, 5, 3, 3}, 32, predict)});
  groups.push_back({"stride", m::OcclusionSensitivity(examples.images, black, targets,
                                                      {7, 7, 7, 7}, 32, predict)});
  groups.push_back({"identity", m::OcclusionSensitivity(examples.images, examples.images,
                                                        targets, {7, 7, 4, 4}, 32, predict)});
  groups.push_back({"full", m::OcclusionSensitivity(examples.images, black, targets,
                                                    {28, 28, 28, 28}, 32, predict)});
  const auto repeat = m::OcclusionSensitivity(examples.images, black, targets, {7, 7, 4, 4},
                                              32, predict),
             single = m::OcclusionSensitivity(
                 n::slice_axis(examples.images, 0, 0, 1), n::slice_axis(black, 0, 0, 1),
                 n::slice_axis(targets, 0, 0, 1), {7, 7, 4, 4}, 1, predict);
  const auto replay =
                 n::max(n::abs(groups[0].second.occluded_logits - repeat.occluded_logits)),
             batch = n::max(
                 n::abs(n::select(groups[0].second.drops, 1, 0) - single.drops.reshape({49}))),
             identity = n::max(n::abs(groups[6].second.drops));
  const auto baseline = m::SaliencyScore(predict(black), targets),
             full = n::max(n::abs(groups[7].second.occluded_score.reshape({10}) - baseline));
  if (replay.item() != 0 || batch.item() > 1e-5 || identity.item() > 1e-5 ||
      full.item() > 1e-6 || before != p.flatten() || random_before != random.flatten())
    return 1;
  std::print("Replay {},single/batch {:.9g},identity {:.9g},full-baseline "
             "{:.9g};all16selected/controlarrays unchanged.\n",
             replay.item(), batch.item(), identity.item(), full.item());
  n::NamedTensors arrays{{"images", examples.images},
                         {"source_ids", examples.source},
                         {"targets", targets},
                         {"runners", runners}};
  auto peak = n::zeros({}, n::DType::Float64);
  for (int i = 0; i < 6; ++i)
    peak = n::maximum(peak, n::max(n::abs(groups[i].second.pixel_mean)));
  std::vector<n::Tensor> display{examples.images};
  std::print("| variant | actual patches | coverage min/max | positive drops | negative drops "
             "|\n|---|---:|---|---:|---:|\n");
  for (const auto &[name, value] : groups) {
    for (const auto &[key, tensor] : std::vector<std::pair<std::string, n::Tensor>>{
             {"rectangles", value.rectangles},
             {"coverage", value.coverage},
             {"original_logits", value.original_logits},
             {"occluded_logits", value.occluded_logits},
             {"original_score", value.original_score},
             {"occluded_score", value.occluded_score},
             {"drops", value.drops},
             {"pixel_mean", value.pixel_mean},
             {"occluded_inputs", value.occluded_inputs}})
      arrays.push_back({name + "_" + key, tensor});
    if (name != "identity" && name != "full")
      display.push_back(
          n::expand_dims(value.pixel_mean.to(n::DType::Float32) / (peak.item() * 2) + .5, 3));
    std::print("| {} | {} | {}..{} | {} | {} |\n", name, value.patches,
               n::min(value.coverage).item(), n::max(value.coverage).item(),
               n::sum(n::greater(value.drops, 0.).to(n::DType::Int32)).item(),
               n::sum(n::less(value.drops, 0.).to(n::DType::Int32)).item());
  }
  std::print("Actual source IDs {},fixed targets {},runners {}.\n", examples.source, targets,
             runners);
  n::save_npz("build/occlusion_sensitivity_maps.npz", arrays);
  auto plot = n::plot_tensor_map(n::reverse(groups[0].second.coverage, {0}), 0, 9);
  plot.title("Every actual primary patch coverage")
      .x_label("original pixel x")
      .y_label("original pixel y");
  plot.save_svg("build/occlusion_sensitivity_coverage.svg");
  std::filesystem::copy_file("build/occlusion_sensitivity_coverage.svg",
                             "figures/occlusion_sensitivity_coverage.svg",
                             std::filesystem::copy_options::overwrite_existing);
  n::save_image_grid(n::concat(display, 0), "build/occlusion_sensitivity_maps.png", 10, 0, 1,
                     2, .8, 4);
}
