> Every actual last-conv derivative and immutable restoration

Compute both methods for the fixed selected category,runner-up,full actual
initialization,and selected model with only its categorical head reset. The
classifier weights stay unchanged. Per-map maximum normalization is used for
display only;it discards absolute amplitude,so raw peaks and all intermediates
are also retained. A weak random-model response can look strong after this
normalization. All ten original images remain visible above the method maps.

Check repeated outputs,single/batch coarse-map agreement,and a central finite
difference of the actual frozen classifier tail at its largest first-image
feature derivative. The native original workflow additionally checks all320
hidden pre-activations stay away from ReLU boundaries at the evaluation point.
```{cpp, results="markdown", file="figures/grad_cam_maps.png", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

#include <print>
int main() {
  namespace n = dm::nn;
  namespace m = n::models;
  n::set_num_threads(2);

  std::filesystem::path cache;
  if (const auto *p = std::getenv("DATAMUNGE_DATA_DIR"))
    cache = p;
  else if (const auto *p = std::getenv("XDG_CACHE_HOME"))
    cache = std::filesystem::path(p) / "datamunge/datasets";
  else
    cache = std::filesystem::path(std::getenv("HOME")) / ".cache/datamunge/datasets";

  dm::datasets::prepare_example_data("mnist-assets", cache.string());
  const auto pools = m::LoadSaliency(cache / "saliency");
  const auto &fit = pools[0];
  const auto &validation = pools[1];
  const auto &test = pools[2];

  n::ParameterStore p(1103);
  {
    n::NoGradGuard guard;
    m::SaliencyCnn(p, n::zeros({1, 28, 28, 1}));
  }
  auto predict = [&](const n::Tensor &images) {
    n::NoGradGuard guard;
    std::vector<n::Tensor> parts;
    for (std::int64_t start = 0; start < images.size(0); start += 32)
      parts.push_back(
          m::SaliencyCnn(p, n::slice_axis(images, 0, start,
                                          std::min<std::int64_t>(start + 32, images.size(0))))
              .logits);
    return n::concat(parts, 0);
  };

  for (const auto &[key, value] : n::load_npz("build/vanilla_saliency_best.npz"))
    p.set(key, value.clone());

  std::vector<std::int64_t> chosen;
  const auto labels = test.labels.to_vector<int>();
  for (int digit = 0; digit < 10; ++digit) {
    const auto it = std::find(labels.begin(), labels.end(), digit);
    chosen.push_back(it - labels.begin());
  }
  const auto examples = m::SaliencyRows(test, chosen);
  const auto z = predict(examples.images);
  const auto sorted = n::argsort(z, true);
  const auto targets = n::select(sorted, 1, 0).to(n::DType::Int32),
             runners = n::select(sorted, 1, 1).to(n::DType::Int32);

  const auto before = p.flatten();
  n::ParameterStore fresh(1103), head(1103);
  {
    n::NoGradGuard guard;
    m::SaliencyCnn(fresh, n::zeros({1, 28, 28, 1}));
    m::SaliencyCnn(head, n::zeros({1, 28, 28, 1}));
  }
  for (const auto &[key, value] : n::load_npz("build/vanilla_saliency_best.npz"))
    head.set(key, value.clone());
  for (const auto &[key, value] : n::load_npz("build/vanilla_saliency_initial.npz")) {
    fresh.set(key, value.clone());
    if (key.starts_with("head/"))
      head.set(key, value.clone());
  }
  const auto fresh_before = fresh.flatten(), head_before = head.flatten();
  const auto trained = m::SaliencyCam(p, examples.images, targets),
             runner = m::SaliencyCam(p, examples.images, runners),
             initial = m::SaliencyCam(fresh, examples.images, targets),
             reset = m::SaliencyCam(head, examples.images, targets),
             repeat = m::SaliencyCam(p, examples.images, targets),
             single = m::SaliencyCam(p, n::slice_axis(examples.images, 0, 0, 1),
                                     n::slice_axis(targets, 0, 0, 1));
  const auto parity = n::max(n::abs(trained.logits - z)),
             deterministic = n::max(n::abs(trained.gradient - repeat.gradient)),
             batch = n::max(n::abs(single.plus_normalized -
                                   n::slice_axis(trained.plus_normalized, 0, 0, 1)));
  const auto feature = n::slice_axis(trained.activation, 0, 0, 1);
  const int coordinate = n::argmax(n::abs(single.gradient).reshape({3136}), 0).item<int>();
  const auto delta = n::equal(n::arange(0, 3136, 1, n::DType::Int64), coordinate)
                         .to(n::DType::Float32)
                         .reshape({1, 14, 14, 16}) *
                     .001;
  const auto target = n::slice_axis(targets, 0, 0, 1);
  const auto fd = (m::SaliencyScore(m::SaliencyCamTail(p, feature + delta), target) -
                   m::SaliencyScore(m::SaliencyCamTail(p, feature - delta), target)) /
                  .002;
  const auto error = n::abs(fd - single.gradient.reshape({3136}).at({coordinate}));
  if (parity.item() != 0 || deterministic.item() != 0 || batch.item() > 2e-6 ||
      error.item() > .01 + .01 * std::abs(single.gradient.reshape({3136}).at({coordinate})) ||
      before != p.flatten() || fresh_before != fresh.flatten() ||
      head_before != head.flatten())
    return 1;
  std::print("Actual{}lastconvfeature derivatives;logit/repeat {}/{},single/batch "
             "{:.9g};FDcoordinate{}error {:.9g};all24selected/controlarrays unchanged.\n",
             trained.gradient.numel(), parity.item(), deterministic.item(), batch.item(),
             coordinate, error.item());
  n::NamedTensors arrays{{"images", examples.images},
                         {"targets", targets},
                         {"runners", runners},
                         {"source_ids", examples.source}};
  std::vector<n::Tensor> displays{examples.images};
  std::print(
      "| control | actual raw classic peaks | actual raw plus peaks |\n|---|---|---|\n");
  for (const auto &[name, value] :
       std::vector<std::pair<std::string, m::SaliencyCamOutput>>{{"trained", trained},
                                                                 {"runner", runner},
                                                                 {"initial", initial},
                                                                 {"head_initial", reset}}) {
    std::vector<std::pair<std::string, n::Tensor>> values = {
        {"activation", value.activation},
        {"gradient", value.gradient},
        {"cam_weights", value.maps.grad_weights},
        {"cam_signed", value.maps.grad_signed},
        {"cam", value.maps.grad_map},
        {"positive_alpha", value.maps.positive_alpha},
        {"plus_weights", value.maps.plus_weights},
        {"plus", value.maps.plus_map},
        {"cam_normalized", value.normalized},
        {"plus_normalized", value.plus_normalized},
        {"cam_resized", value.resized},
        {"plus_resized", value.plus_resized},
        {"logits", value.logits}};
    for (const auto &[key, tensor] : values)
      arrays.push_back({name + "_" + key, tensor});
    displays.push_back(n::expand_dims(value.resized, 3));
    displays.push_back(n::expand_dims(value.plus_resized, 3));
    std::print("| {} | {} | {} |\n", name, n::max(value.maps.grad_map, {1, 2}),
               n::max(value.maps.plus_map, {1, 2}));
  }
  std::print("\n| true digit | original source ID | fixed target | fixed runner "
             "|\n|---:|---:|---:|---:|\n");
  for (int i = 0; i < 10; ++i)
    std::print("| {} | {} | {} | {} |\n", examples.labels.at({i}), examples.source.at({i}),
               targets.at({i}), runners.at({i}));
  n::save_npz("build/grad_cam_maps.npz", arrays);
  n::save_image_grid(n::concat(displays, 0), "build/grad_cam_maps.png", 10, 0, 1, 2, .8, 4);
}
