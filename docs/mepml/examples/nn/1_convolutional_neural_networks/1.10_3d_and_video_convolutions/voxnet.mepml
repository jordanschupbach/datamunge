> Full original-width graph and explicit weight penalty

The complete model uses conv5/stride2/32LeakyReLU.1,dropout.2,
conv3/stride1/32LeakyReLU.1,maxpool2,dropout.3,flatten6912,FC128ReLU,
dropout.4,linear categorical head. Convolutions are VALID with HeNormal weights;
dense weights are Normal.01,biases0. There is no BN. Changing40classes to3only
changes the head:921736versus916963learned scalars,eight tensor leaves in each.
Native tests actually execute the full40class graph and all learned derivatives
on real occupancy,not just an analytical reference census.

For the source weight-only objective L=CE+.001*sum(W squared),the gradient is
CEgrad+.002W on named weights;biases remain unregularized. This is a coupled
sum-of-squares penalty,not decoupled optimizer decay or mean weight-square loss.
```{cpp, results="markdown", file="figures/voxnet_gradients.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

#include <print>
int main() {
  namespace n = dm::nn;
  namespace m = n::models;
  n::set_num_threads(2);

  std::filesystem::path cache;
  if (const auto *p = std::getenv("DATAMUNGE_DATA_DIR"))
    cache = p;
  else if (const auto *p = std::getenv("XDG_CACHE_HOME"))
    cache = std::filesystem::path(p) / "datamunge/datasets";
  else
    cache = std::filesystem::path(std::getenv("HOME")) / ".cache/datamunge/datasets";

  std::filesystem::path root = cache / "voxnet";
  if (const auto *v = std::getenv("DATAMUNGE_VOXNET_DIR"))
    root = v;
  else {
    dm::datasets::prepare_example_data("voxel", (cache / "modelnet").string());
    root = cache / "voxnet";
  }
  const auto pools = m::LoadVoxnet(root);
  const auto &fit = pools[0];
  const auto &validation = pools[1];
  const auto &test = pools[2];

  n::ParameterStore p(907);
  m::VoxnetDropout dropout;
  {
    n::NoGradGuard guard;
    m::Voxnet(p, n::zeros({1, 32, 32, 32, 1}), 3);
  }
  auto predict = [&](const n::Tensor &input, bool vote = true) {
    n::NoGradGuard guard;
    std::vector<n::Tensor> parts;
    for (std::int64_t start = 0; start < input.size(0); start += 4) {
      const auto x =
          n::slice_axis(input, 0, start, std::min<std::int64_t>(start + 4, input.size(0)));
      auto y = m::Voxnet(p, x, 3).logits;
      if (vote) {
        for (int k = 1; k < 4; ++k)
          y = y + m::Voxnet(p, m::VoxnetRotate(x, k), 3).logits;
        y = y / 4.;
      }
      parts.push_back(y);
    }
    return n::concat(parts, 0);
  };

  const auto d = m::VoxnetRows(fit, {0, 8, 16, 1});
  const auto out = m::Voxnet(p, d.voxels, 3, true, &dropout);
  const auto loss = n::sparse_softmax_cross_entropy(out.logits, d.labels);
  const auto gs = n::grad(loss, p.parameters()), regularized = m::VoxnetRegularized(p, gs);
  std::vector<n::Tensor> norms;
  std::print(
      "| learned tensor | shape | CE gradient L2 | regularized L2 |\n|---|---|---:|---:|\n");
  for (std::size_t i = 0; i < p.size(); ++i) {
    const auto norm = n::sqrt(n::sum(n::square(gs[i])));
    if (!n::all(n::is_finite(gs[i])).item<bool>() || norm.item() <= 0)
      return 1;
    norms.push_back(norm);
    std::print("| {} | {} | {:.6g} | {:.6g} |\n", p.names()[i], p.parameters()[i].shape(),
               norm.item(), n::sqrt(n::sum(n::square(regularized[i]))).item());
  }
  std::print("Actual916963values/{}learned leaves;conv1 {},conv2 {},pool {},flat {},FC {}.\n",
             p.size(), out.conv1.shape(), out.conv2.shape(), out.pool.shape(),
             out.flat.shape(), out.fc1.shape());
  auto plot = dm::graphics::RPlot::create();
  plot.points(n::arange(0, 8).to_vector<double>(), n::stack(norms, 0).to_vector<double>(),
              "all8leaves", {37, 99, 235})
      .title("Every actual VoxNet CE derivative")
      .x_label("W/b pairs:conv1,conv2,FC128,head")
      .y_label("categorical gradient L2 norm");
  plot.save_svg("build/voxnet_gradients.svg");
}
```
