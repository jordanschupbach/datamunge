Show all12held-out objects as axis projections,then inspect genuine fitting
occupancy counts. Max projections visualize surface occupancy,not photographs.
```{cpp, results="markdown", file="figures/voxnet_data.png", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

#include <print>
int main() {
  namespace n = dm::nn;
  namespace m = n::models;
  n::set_num_threads(2);

  std::filesystem::path cache;
  if (const auto *p = std::getenv("DATAMUNGE_DATA_DIR"))
    cache = p;
  else if (const auto *p = std::getenv("XDG_CACHE_HOME"))
    cache = std::filesystem::path(p) / "datamunge/datasets";
  else
    cache = std::filesystem::path(std::getenv("HOME")) / ".cache/datamunge/datasets";

  std::filesystem::path root = cache / "voxnet";
  if (const auto *v = std::getenv("DATAMUNGE_VOXNET_DIR"))
    root = v;
  else {
    dm::datasets::prepare_example_data("voxel", (cache / "modelnet").string());
    root = cache / "voxnet";
  }
  const auto pools = m::LoadVoxnet(root);
  const auto &fit = pools[0];
  const auto &validation = pools[1];
  const auto &test = pools[2];

  const auto xy = n::max(test.voxels, {3});
  const auto xz = n::max(test.voxels, {2});
  n::save_image_grid(n::concat({xy, xz}, 0), "build/voxnet_data.png", 4, 0, 1, 2, 0, 4);
  const auto counts = n::sum(fit.voxels, {1, 2, 3, 4});
  std::print(
      "| held-out source ID | class0chair1sofa2table | occupied voxels |\n|---:|---:|---:|\n");
  const auto occupied = n::sum(test.voxels, {1, 2, 3, 4});
  for (int i = 0; i < 12; ++i)
    std::print("| {} | {} | {} |\n", test.source.at({i}), test.labels.at({i}),
               occupied.at({i}));
  auto plot = dm::graphics::RPlot::create();
  plot.points(n::arange(0, 24).to_vector<double>(), counts.to_vector<double>(),
              "fitting objects", {37, 99, 235})
      .title("Actual sampled-surface occupancy")
      .x_label("fitting row:8chair,8sofa,8table")
      .y_label("occupied32cube voxels");
  plot.save_svg("build/voxnet_occupancy.svg");
  std::filesystem::copy_file("build/voxnet_occupancy.svg", "figures/voxnet_occupancy.svg",
                             std::filesystem::copy_options::overwrite_existing);
}
