> Every tensor MomentumSGD update and C4 vote

Warm all eight learned tensors before MomentumSGD(.001,momentum.9). Parameter
seed907,independent dropout seeds881/883/887. The source first-four-object CE
probe advances all three RNG streams before fitting. Order919,batch4,three
epochs give18updates;mt19937seed929 draws one quarter turn per entire batch.
All numeric image transformation,loss,regularization,gradients and updates
remain tensor operations. Validation averages the four rotated LOGITS before
computing NLL;averaging softmax probabilities would be a different rule.
```{cpp, results="markdown", file="figures/voxnet_training.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

#include <print>
#include <random>
int main() {
  namespace n = dm::nn;
  namespace m = n::models;
  n::set_num_threads(2);

  std::filesystem::path cache;
  if (const auto *p = std::getenv("DATAMUNGE_DATA_DIR"))
    cache = p;
  else if (const auto *p = std::getenv("XDG_CACHE_HOME"))
    cache = std::filesystem::path(p) / "datamunge/datasets";
  else
    cache = std::filesystem::path(std::getenv("HOME")) / ".cache/datamunge/datasets";

  std::filesystem::path root = cache / "voxnet";
  if (const auto *v = std::getenv("DATAMUNGE_VOXNET_DIR"))
    root = v;
  else {
    dm::datasets::prepare_example_data("voxel", (cache / "modelnet").string());
    root = cache / "voxnet";
  }
  const auto pools = m::LoadVoxnet(root);
  const auto &fit = pools[0];
  const auto &validation = pools[1];
  const auto &test = pools[2];

  n::ParameterStore p(907);
  m::VoxnetDropout dropout;
  {
    n::NoGradGuard guard;
    m::Voxnet(p, n::zeros({1, 32, 32, 32, 1}), 3);
  }
  auto predict = [&](const n::Tensor &input, bool vote = true) {
    n::NoGradGuard guard;
    std::vector<n::Tensor> parts;
    for (std::int64_t start = 0; start < input.size(0); start += 4) {
      const auto x =
          n::slice_axis(input, 0, start, std::min<std::int64_t>(start + 4, input.size(0)));
      auto y = m::Voxnet(p, x, 3).logits;
      if (vote) {
        for (int k = 1; k < 4; ++k)
          y = y + m::Voxnet(p, m::VoxnetRotate(x, k), 3).logits;
        y = y / 4.;
      }
      parts.push_back(y);
    }
    return n::concat(parts, 0);
  };

  const auto initial = m::ScoreSequenceClassifier(predict(fit.voxels), fit.labels).nll;
  const auto untrained = predict(test.voxels);
  const auto probe = m::VoxnetRows(fit, {0, 8, 16, 1});
  const auto gs =
      n::grad(n::sparse_softmax_cross_entropy(
                  m::Voxnet(p, probe.voxels, 3, true, &dropout).logits, probe.labels),
              p.parameters());
  for (const auto &g : gs)
    if (!n::all(n::is_finite(g)).item<bool>() || n::sum(n::square(g)).item() <= 0)
      return 1;
  n::OptimizerConfig options;
  options.kind = n::OptimizerKind::Momentum;
  options.momentum = .9;
  n::Optimizer sgd(p, .001, options);
  n::BatchOrder order(24, 4, 919);
  std::mt19937 turns(929);
  double best = INFINITY;
  int selected = 0, updates = 0;
  std::vector<n::Tensor> history;
  std::print("| epoch | dropout CE+L2 | validation C4-logit NLL |\n|---:|---:|---:|\n");
  for (int epoch = 1; epoch <= 3; ++epoch) {
    order.begin_epoch();
    auto average = n::zeros({}, n::DType::Float64);
    for (;;) {
      const auto rows = order.next();
      if (rows.empty())
        break;
      auto batch = m::VoxnetRows(fit, rows);
      batch.voxels =
          m::VoxnetRotate(batch.voxels, std::uniform_int_distribution<int>(0, 3)(turns));
      const auto ce = n::sparse_softmax_cross_entropy(
          m::Voxnet(p, batch.voxels, 3, true, &dropout).logits, batch.labels);
      auto penalty = n::zeros({}, n::DType::Float64);
      {
        n::NoGradGuard guard;
        for (const auto &name : p.names())
          if (name.ends_with("/W"))
            penalty = penalty + n::sum(n::square(p.at(name))).to(n::DType::Float64) * .001;
      }
      average = average + (ce.detach().to(n::DType::Float64) + penalty) / 6.;
      sgd.step(m::VoxnetRegularized(p, n::grad(ce, p.parameters()), .001));
      ++updates;
    }
    const auto val =
        m::ScoreSequenceClassifier(predict(validation.voxels), validation.labels).nll;
    if (val.item() < best) {
      best = val.item();
      selected = epoch;
      n::NamedTensors arrays;
      for (std::size_t i = 0; i < p.size(); ++i)
        arrays.push_back({p.names()[i], p.parameters()[i]});
      n::save_npz("build/voxnet_best.npz", arrays);
    }
    history.push_back(n::stack({average, val}, 0));
    std::print("| {} | {:.6f} | {:.6f} |\n", epoch, average.item(), val.item());
  }
  for (const auto &[key, value] : n::load_npz("build/voxnet_best.npz"))
    p.set(key, value);
  const auto fitted = m::ScoreSequenceClassifier(predict(fit.voxels), fit.labels).nll;
  n::save_npz("build/voxnet_outputs.npz",
              {{"logits", predict(test.voxels)}, {"untrained", untrained}});
  std::print("{}explicit MomentumSGD updates,selected {},validation {:.6f};fixed C4fit NLL "
             "{:.9f}->{:.9f}.\n",
             updates, selected, best, initial.item(), fitted.item());
  const auto h = n::stack(history, 0);
  auto plot = dm::graphics::RPlot::create();
  plot.lines(n::arange(1, 4).to_vector<double>(), n::select(h, 1, 0).to_vector<double>(),
             "fit CE+L2", {37, 99, 235})
      .lines(n::arange(1, 4).to_vector<double>(), n::select(h, 1, 1).to_vector<double>(),
             "C4validation", {220, 38, 38})
      .title("Eighteen explicit MomentumSGD updates")
      .x_label("epoch;six fitting batches each")
      .y_label("declared objective/NLL");
  plot.save_svg("build/voxnet_training.svg");
}
```
// result_begin: markdown
ModelNet10 fit:24 distinct objects,balanced chair/sofa/table
ModelNet10 validation:6 distinct objects,balanced chair/sofa/table
ModelNet10 test:12 distinct objects,balanced chair/sofa/table
| epoch | dropout CE+L2 | validation C4-logit NLL |
|---:|---:|---:|
| 1 | 1.321908 | 1.099104 |
| 2 | 1.315848 | 1.098456 |
| 3 | 1.275253 | 1.092044 |
18explicit MomentumSGD updates,selected 3,validation 1.092044;fixed C4fit NLL 1.106853194->1.065721723.
\image(figures/voxnet_training.svg)
// result_end
\caption(All18actual optimizer updates show CE gradients,weight-only L2,random quarter turns and three independent dropout streams. Validation selects on four-rotated-logit NLL;the fitting objective additionally contains L2.)
\alttext(All18actual optimizer updates show CE gradients,weight-only L2,random quarter turns and three independent dropout streams. Validation selects on four-rotated-logit NLL;the fitting objective additionally contains L2.)

The selected third epoch has validation NLL1.092044. Fixed fitting C4NLL
improves1.106853194to1.065721723. Held-out accuracy is7/12,NLL1.097433,
with zero recall on all four sofas. Coarse1NN also reaches7/12but has lower
NLL.968111 and detects one sofa. Full class errors matter more than a tied
overall accuracy on this tiny custom split.

> Fresh occupancy-only restoration and every held-out error

Restore into a fresh eight-leaf store. Verify saved/repeated logits,single/batch
parity,all parameters unchanged and C4vote invariance under orbit permutation.
Single-view logits may change with orientation even when the vote stays fixed.
The coarse occupancy1NN reference has no learned parameters;fitting-only
population standardization and pairwise distances are tensor operations.
```{cpp, results="markdown", file="figures/voxnet_confusion.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

#include <print>
int main() {
  namespace n = dm::nn;
  namespace m = n::models;
  n::set_num_threads(2);

  std::filesystem::path cache;
  if (const auto *p = std::getenv("DATAMUNGE_DATA_DIR"))
    cache = p;
  else if (const auto *p = std::getenv("XDG_CACHE_HOME"))
    cache = std::filesystem::path(p) / "datamunge/datasets";
  else
    cache = std::filesystem::path(std::getenv("HOME")) / ".cache/datamunge/datasets";

  std::filesystem::path root = cache / "voxnet";
  if (const auto *v = std::getenv("DATAMUNGE_VOXNET_DIR"))
    root = v;
  else {
    dm::datasets::prepare_example_data("voxel", (cache / "modelnet").string());
    root = cache / "voxnet";
  }
  const auto pools = m::LoadVoxnet(root);
  const auto &fit = pools[0];
  const auto &validation = pools[1];
  const auto &test = pools[2];

  n::ParameterStore p(907);
  m::VoxnetDropout dropout;
  {
    n::NoGradGuard guard;
    m::Voxnet(p, n::zeros({1, 32, 32, 32, 1}), 3);
  }
  auto predict = [&](const n::Tensor &input, bool vote = true) {
    n::NoGradGuard guard;
    std::vector<n::Tensor> parts;
    for (std::int64_t start = 0; start < input.size(0); start += 4) {
      const auto x =
          n::slice_axis(input, 0, start, std::min<std::int64_t>(start + 4, input.size(0)));
      auto y = m::Voxnet(p, x, 3).logits;
      if (vote) {
        for (int k = 1; k < 4; ++k)
          y = y + m::Voxnet(p, m::VoxnetRotate(x, k), 3).logits;
        y = y / 4.;
      }
      parts.push_back(y);
    }
    return n::concat(parts, 0);
  };

  for (const auto &[key, value] : n::load_npz("build/voxnet_best.npz"))
    p.set(key, value);
  const auto before = p.flatten();
  n::Tensor saved, untrained;
  for (const auto &[key, value] : n::load_npz("build/voxnet_outputs.npz")) {
    if (key == "logits")
      saved = value;
    if (key == "untrained")
      untrained = value;
  }
  const auto logits = predict(test.voxels),
             single = predict(n::slice_axis(test.voxels, 0, 0, 1)),
             canonical = predict(test.voxels, false),
             rotated = predict(m::VoxnetRotate(test.voxels, 1)),
             rotated_single = predict(m::VoxnetRotate(test.voxels, 1), false);
  const auto parity = n::max(n::abs(logits - saved)),
             batch = n::max(n::abs(single - n::slice_axis(logits, 0, 0, 1))),
             orbit = n::max(n::abs(logits - rotated)),
             change = n::sum(n::abs(canonical - rotated_single));
  if (parity.item() != 0 || n::max(n::abs(logits - predict(test.voxels))).item() != 0 ||
      batch.item() > 1e-6 || orbit.item() > 1e-6 || change.item() <= 1e-7 ||
      before != p.flatten())
    return 1;
  std::print("Fresh restore/repeat {},single/batch {:.9g},C4orbit {:.9g};single-view rotation "
             "L1 {:.9g};all8leaves immutable.\n",
             parity.item(), batch.item(), orbit.item(), change.item());
  const auto nearest = m::VoxnetNearest(fit, test);
  std::vector<std::pair<std::string, n::Tensor>> predictions = {
      {"C4voted", logits},
      {"single view", canonical},
      {"initial C4", untrained},
      {"coarse1NN", nearest},
      {"rotated single", rotated_single},
      {"balanced tie", n::zeros({12, 3})}};
  std::print("| predictor | accuracy | macroF1 | NLL | all recalls | all confusion counts "
             "|\n|---|---:|---:|---:|---|---|\n");
  for (const auto &[name, z] : predictions) {
    const auto score = m::ScoreSensor(z, test.labels, 3);
    std::print("| {} | {:.6f} | {:.6f} | {:.6f} | {} | {} |\n", name, score.accuracy,
               score.macro_f1, score.nll, score.recall, score.confusion);
  }
  const auto labels = n::argmax(logits, 1);
  std::print("\n| source ID | true class | learned class |\n|---:|---:|---:|\n");
  for (int i = 0; i < 12; ++i)
    std::print("| {} | {} | {} |\n", test.source.at({i}), test.labels.at({i}), labels.at({i}));
  auto a = n::plot_tensor_map(
           n::reverse(m::ScoreSequenceClassifier(logits, test.labels).confusion, {0}), 0, 4),
       b = n::plot_tensor_map(
           n::reverse(m::ScoreSequenceClassifier(nearest, test.labels).confusion, {0}), 0, 4);
  a.title("Complete VoxNet confusion")
      .x_label("predicted chair0/sofa1/table2")
      .y_label("true class0at bottom");
  b.title("Complete coarse1NN confusion")
      .x_label("predicted chair0/sofa1/table2")
      .y_label("true class0at bottom");
  auto layout = dm::graphics::RLayout::create(1, 2);
  layout.add(a).add(b).size(1100, 500).fit_panels().save_svg("build/voxnet_confusion.svg");
}
```
