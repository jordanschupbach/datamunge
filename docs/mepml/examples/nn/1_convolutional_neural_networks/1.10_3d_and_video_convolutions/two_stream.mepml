Show all six genuine middle RGB observations and every ten-field magnitude map.
```{cpp, results="markdown", file="figures/two_stream_data.png", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

#include <print>
int main() {
  namespace n = dm::nn;
  namespace m = n::models;
  n::set_num_threads(2);

  std::filesystem::path cache;
  if (const auto *p = std::getenv("DATAMUNGE_DATA_DIR"))
    cache = p;
  else if (const auto *p = std::getenv("XDG_CACHE_HOME"))
    cache = std::filesystem::path(p) / "datamunge/datasets";
  else
    cache = std::filesystem::path(std::getenv("HOME")) / ".cache/datamunge/datasets";

  std::filesystem::path root = cache / "two_stream";
  if (const auto *v = std::getenv("DATAMUNGE_TWO_STREAM_DIR"))
    root = v;
  else
    dm::datasets::prepare_example_data("two_stream", root.string());
  const auto pools = m::LoadTwoStream(root);
  const auto &fit = pools[0];
  const auto &validation = pools[1];
  const auto &test = pools[2];

  const auto magnitude = n::sqrt(n::sum(n::square(test.at("flow")), {4}, true));
  const auto peak = n::max(magnitude).item();
  n::save_image_grid(n::sqrt(magnitude / peak).reshape({60, 96, 96, 1}),
                     "build/two_stream_flow.png", 10, 0, 1, 2, 0, 1);
  std::filesystem::copy_file("build/two_stream_flow.png", "figures/two_stream_flow.png",
                             std::filesystem::copy_options::overwrite_existing);
  n::save_image_grid(test.at("rgb"), "build/two_stream_data.png", 3, 0, 1, 2, 0, 3);
  std::print("| held-out row | action | person | video | segment | mean flow magnitude(px) "
             "|\n|---:|---:|---:|---:|---:|---:|\n");
  for (int i = 0; i < 6; ++i)
    std::print("| {} | {} | {} | {} | {} | {:.6f} |\n", i, test.at("label").at({i}),
               test.at("person").at({i}), test.at("video_id").at({i}),
               test.at("segment").at({i}), n::mean(n::select(magnitude, 0, i)).item());
  std::print("Shared magnitude display range0..{:.6f}px across ALL60fields.\n", peak);
}
