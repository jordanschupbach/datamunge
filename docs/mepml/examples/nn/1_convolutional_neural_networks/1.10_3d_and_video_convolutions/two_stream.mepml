KTH validation:6 RGB+flow pairs,1 people,3 source AVIs
KTH test:6 RGB+flow pairs,1 people,3 source AVIs
| epoch | dropout branch CE sum | validation fused NLL |
|---:|---:|---:|
| 1 | 2.772806 | 1.114867 |
| 2 | 2.249606 | 1.088412 |
| 3 | 2.238553 | 1.089211 |
36explicit joint Adam updates;selected 2,validation 1.088412;fixed fused fitNLL 1.122472737->1.074159313.
\image(figures/two_stream_training.svg)
// result_end
\caption(Both independent stream CE losses appear explicitly before each joint tensor Adam step. The summed fitting objective differs in scale and semantics from validation fused NLL;all32leaves are selected together.)
\alttext(Both independent stream CE losses appear explicitly before each joint tensor Adam step. The summed fitting objective differs in scale and semantics from validation fused NLL;all32leaves are selected together.)

The selected second epoch has validation fusedNLL1.088412. Fixed fitting fusedNLL
improves1.122472737to1.074159313,but held-out accuracy stays1/3,NLL1.097883.
All boxing and handwaving clips are misclassified;both clapping clips are correct.
The unchanged absolute-flow1NN reaches.5accuracy,NLL1.051445. These six clips
from one person do not establish benchmark action quality.

> Fresh restoration and modality interventions

Restore a fresh store and check saved/repeated logits,single/batch agreement
and all32leaves unchanged. The spatial and temporal branch predictions,RGB and
absolute-flow memory1NN references,initialization and three interventions are
all scored on every held-out clip. Memory1NN has no learned parameters and
uses fitting-only tensor population standardization. Zero flow,neutral RGB and
reversed stack order are inference controls,not retrained ablation studies.
```{cpp, results="markdown", file="figures/two_stream_confusion.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

#include <print>
int main() {
  namespace n = dm::nn;
  namespace m = n::models;
  n::set_num_threads(2);

  std::filesystem::path cache;
  if (const auto *p = std::getenv("DATAMUNGE_DATA_DIR"))
    cache = p;
  else if (const auto *p = std::getenv("XDG_CACHE_HOME"))
    cache = std::filesystem::path(p) / "datamunge/datasets";
  else
    cache = std::filesystem::path(std::getenv("HOME")) / ".cache/datamunge/datasets";

  std::filesystem::path root = cache / "two_stream";
  if (const auto *v = std::getenv("DATAMUNGE_TWO_STREAM_DIR"))
    root = v;
  else
    dm::datasets::prepare_example_data("two_stream", root.string());
  const auto pools = m::LoadTwoStream(root);
  const auto &fit = pools[0];
  const auto &validation = pools[1];
  const auto &test = pools[2];

  const m::TwoStreamConfig c{96, 16, 64, 32, 3};
  n::ParameterStore p(853);
  std::vector<n::Generator> drops{n::Generator(823), n::Generator(827), n::Generator(829),
                                  n::Generator(839)};
  {
    n::NoGradGuard guard;
    m::TwoStream(p, n::zeros({1, 96, 96, 3}), n::zeros({1, 10, 96, 96, 2}), c);
  }
  auto predict = [&](const m::TwoStreamData &d) {
    n::NoGradGuard guard;
    std::vector<n::Tensor> parts;
    for (std::int64_t start = 0; start < d.at("rgb").size(0); start += 2) {
      const auto end = std::min<std::int64_t>(start + 2, d.at("rgb").size(0));
      parts.push_back(m::TwoStream(p, n::slice_axis(d.at("rgb"), 0, start, end),
                                   n::slice_axis(d.at("flow"), 0, start, end), c)
                          .log_scores);
    }
    return n::concat(parts, 0);
  };
  auto rows = [](const m::TwoStreamData &d, const std::vector<std::int64_t> &ids) {
    m::TwoStreamData out;
    for (const auto &[key, value] : d)
      out.emplace(key, n::take_rows(value, ids));
    return out;
  };

  for (const auto &[key, value] : n::load_npz("build/two_stream_best.npz"))
    p.set(key, value);
  const auto before = p.flatten();
  n::Tensor saved, untrained;
  for (const auto &[key, value] : n::load_npz("build/two_stream_outputs.npz")) {
    if (key == "logits")
      saved = value;
    if (key == "untrained")
      untrained = value;
  }
  const auto logits = predict(test), single = predict(rows(test, {0}));
  auto zero = test, neutral = test, reverse = test;
  zero["flow"] = n::zeros(test.at("flow").shape());
  neutral["rgb"] = n::full(test.at("rgb").shape(), .5);
  reverse["flow"] = n::reverse(test.at("flow"), {1});
  const auto z = predict(zero), gray = predict(neutral), rev = predict(reverse);
  const auto parity = n::max(n::abs(logits - saved)),
             batch = n::max(n::abs(single - n::slice_axis(logits, 0, 0, 1))),
             dz = n::sum(n::abs(logits - z)), drgb = n::sum(n::abs(logits - gray)),
             dorder = n::sum(n::abs(logits - rev));
  if (parity.item() != 0 || n::max(n::abs(logits - predict(test))).item() != 0 ||
      batch.item() > 1e-6 || dz.item() <= 1e-7 || drgb.item() <= 1e-7 ||
      dorder.item() <= 1e-7 || before != p.flatten())
    return 1;
  std::print(
      "Fresh restore/repeat {},single/batch "
      "{:.9g},all32immutable;zero-flow/neutral-RGB/reverse-order L1 {:.9g}/{:.9g}/{:.9g}.\n",
      parity.item(), batch.item(), dz.item(), drgb.item(), dorder.item());
  n::NoGradGuard guard;
  const auto branch = m::TwoStream(p, test.at("rgb"), test.at("flow"), c);
  std::vector<std::pair<std::string, n::Tensor>> predictions = {
      {"fused", logits},
      {"RGB", branch.rgb.logits},
      {"flow", branch.flow.logits},
      {"initial", untrained},
      {"RGB1NN", m::TwoStreamNearest(fit, test, false)},
      {"flow1NN", m::TwoStreamNearest(fit, test, true)},
      {"zero flow", z},
      {"neutral RGB", gray},
      {"reversed stack", rev}};
  std::print("| predictor | accuracy | macroF1 | NLL | all recalls | all confusion counts "
             "|\n|---|---:|---:|---:|---|---|\n");
  for (const auto &[name, value] : predictions) {
    const auto score = m::ScoreSensor(value, test.at("label"), 3);
    std::print("| {} | {:.6f} | {:.6f} | {:.6f} | {} | {} |\n", name, score.accuracy,
               score.macro_f1, score.nll, score.recall, score.confusion);
  }
  const auto labels = n::argmax(logits, 1);
  std::print(
      "\n| source video | segment | true action | fused action |\n|---:|---:|---:|---:|\n");
  for (int i = 0; i < 6; ++i)
    std::print("| {} | {} | {} | {} |\n", test.at("video_id").at({i}),
               test.at("segment").at({i}), test.at("label").at({i}), labels.at({i}));
  auto a = n::plot_tensor_map(
           n::reverse(m::ScoreSequenceClassifier(logits, test.at("label")).confusion, {0}), 0,
           2),
       b = n::plot_tensor_map(
           n::reverse(m::ScoreSequenceClassifier(m::TwoStreamNearest(fit, test, true),
                                                 test.at("label"))
                          .confusion,
                      {0}),
           0, 2);
  a.title("Complete fused confusion")
      .x_label("predicted boxing0/clap1/wave2")
      .y_label("true action0at bottom");
  b.title("Complete flow1NN confusion")
      .x_label("predicted boxing0/clap1/wave2")
      .y_label("true action0at bottom");
  auto layout = dm::graphics::RLayout::create(1, 2);
  layout.add(a).add(b).size(1100, 500).fit_panels().save_svg("build/two_stream_confusion.svg");
}
