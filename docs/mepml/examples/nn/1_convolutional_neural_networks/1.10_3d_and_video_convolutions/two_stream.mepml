> Complete streams,centered channel order and probability fusion

Each CNN-M branch retains five conv/ReLU layers,three pools,two hidden ReLU
layers and a linear categorical head. Kernels7/5/3/3/3,strides2/2/1/1/1,widths
96/256/512/512/512divided16in compact execution. Explicit borders and the
second-pool bottom/right negative-infinity padding match source geometry.
RGB has LRN after conv1/2;flow only after conv1. Two keep.5hidden dropouts per
stream have four independent RNGs. All32leaves/78748values actually execute.
Full224px/FC4096/2048/101classes census181335594is ANALYTICAL in the source,
not an allocated full-reference run.

Flow is centered independently per field/component over spatial pixels,clipped
[-10,10]/10and stacked dx0,dy0,...,dx9,dy9. Fusion averages separate SOFTMAX
probabilities,not logits. The fitting objective is the SUM of two branch mean
cross-entropies;validation uses log of the fused probabilities with1e-8floor.
```{cpp, results="markdown", file="figures/two_stream_gradients.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

#include <print>
int main() {
  namespace n = dm::nn;
  namespace m = n::models;
  n::set_num_threads(2);

  std::filesystem::path cache;
  if (const auto *p = std::getenv("DATAMUNGE_DATA_DIR"))
    cache = p;
  else if (const auto *p = std::getenv("XDG_CACHE_HOME"))
    cache = std::filesystem::path(p) / "datamunge/datasets";
  else
    cache = std::filesystem::path(std::getenv("HOME")) / ".cache/datamunge/datasets";

  std::filesystem::path root = cache / "two_stream";
  if (const auto *v = std::getenv("DATAMUNGE_TWO_STREAM_DIR"))
    root = v;
  else
    dm::datasets::prepare_example_data("two_stream", root.string());
  const auto pools = m::LoadTwoStream(root);
  const auto &fit = pools[0];
  const auto &validation = pools[1];
  const auto &test = pools[2];

  const m::TwoStreamConfig c{96, 16, 64, 32, 3};
  n::ParameterStore p(853);
  std::vector<n::Generator> drops{n::Generator(823), n::Generator(827), n::Generator(829),
                                  n::Generator(839)};
  {
    n::NoGradGuard guard;
    m::TwoStream(p, n::zeros({1, 96, 96, 3}), n::zeros({1, 10, 96, 96, 2}), c);
  }
  auto predict = [&](const m::TwoStreamData &d) {
    n::NoGradGuard guard;
    std::vector<n::Tensor> parts;
    for (std::int64_t start = 0; start < d.at("rgb").size(0); start += 2) {
      const auto end = std::min<std::int64_t>(start + 2, d.at("rgb").size(0));
      parts.push_back(m::TwoStream(p, n::slice_axis(d.at("rgb"), 0, start, end),
                                   n::slice_axis(d.at("flow"), 0, start, end), c)
                          .log_scores);
    }
    return n::concat(parts, 0);
  };
  auto rows = [](const m::TwoStreamData &d, const std::vector<std::int64_t> &ids) {
    m::TwoStreamData out;
    for (const auto &[key, value] : d)
      out.emplace(key, n::take_rows(value, ids));
    return out;
  };

  const auto d = rows(fit, {0, 1});
  const auto out = m::TwoStream(p, d.at("rgb"), d.at("flow"), c, true, &drops);
  const auto loss = n::sparse_softmax_cross_entropy(out.rgb.logits, d.at("label")) +
                    n::sparse_softmax_cross_entropy(out.flow.logits, d.at("label"));
  const auto gradients = n::grad(loss, p.parameters());
  std::vector<n::Tensor> norms;
  for (const auto &g : gradients) {
    if (!n::all(n::is_finite(g)).item<bool>() || n::sum(n::square(g)).item() <= 0)
      return 1;
    norms.push_back(n::sqrt(n::sum(n::square(g))));
  }
  std::print("{}values/{}learned leaves,all32finite/nonzero derivatives;stack {},flat "
             "RGB/flow {}/{}.\n",
             p.count(), p.size(), out.stack.shape(), out.rgb.flat.shape(),
             out.flow.flat.shape());
  std::print("| convolution | RGB shape | flow shape |\n|---:|---|---|\n");
  for (int i = 0; i < 5; ++i)
    std::print("| {} | {} | {} |\n", i + 1, out.rgb.conv[i].shape(), out.flow.conv[i].shape());
  auto plot = dm::graphics::RPlot::create();
  plot.points(n::arange(0, 32).to_vector<double>(), n::stack(norms, 0).to_vector<double>(),
              "all32leaves", {37, 99, 235})
      .title("Both actual streams receive gradients")
      .x_label("source learned tensor ordinal")
      .y_label("CE-sum gradient L2");
  plot.save_svg("build/two_stream_gradients.svg");
}
```
