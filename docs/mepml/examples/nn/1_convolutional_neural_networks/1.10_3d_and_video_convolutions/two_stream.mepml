> Every explicit joint Adam update

Parameter seed853,dropout823/827/829/839,order857,batch2. The first-two-clip
CE-sum gradient probe consumes all four dropout streams before fitting,matching
the original workflow. Three epochs give36joint updates;both disjoint streams
receive their own CE gradient in each update. No learned fusion weight exists.
Select all32parameters together by validation fused NLL,then restore.
```{cpp, results="markdown", file="figures/two_stream_training.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

#include <print>
int main() {
  namespace n = dm::nn;
  namespace m = n::models;
  n::set_num_threads(2);

  std::filesystem::path cache;
  if (const auto *p = std::getenv("DATAMUNGE_DATA_DIR"))
    cache = p;
  else if (const auto *p = std::getenv("XDG_CACHE_HOME"))
    cache = std::filesystem::path(p) / "datamunge/datasets";
  else
    cache = std::filesystem::path(std::getenv("HOME")) / ".cache/datamunge/datasets";

  std::filesystem::path root = cache / "two_stream";
  if (const auto *v = std::getenv("DATAMUNGE_TWO_STREAM_DIR"))
    root = v;
  else
    dm::datasets::prepare_example_data("two_stream", root.string());
  const auto pools = m::LoadTwoStream(root);
  const auto &fit = pools[0];
  const auto &validation = pools[1];
  const auto &test = pools[2];

  const m::TwoStreamConfig c{96, 16, 64, 32, 3};
  n::ParameterStore p(853);
  std::vector<n::Generator> drops{n::Generator(823), n::Generator(827), n::Generator(829),
                                  n::Generator(839)};
  {
    n::NoGradGuard guard;
    m::TwoStream(p, n::zeros({1, 96, 96, 3}), n::zeros({1, 10, 96, 96, 2}), c);
  }
  auto predict = [&](const m::TwoStreamData &d) {
    n::NoGradGuard guard;
    std::vector<n::Tensor> parts;
    for (std::int64_t start = 0; start < d.at("rgb").size(0); start += 2) {
      const auto end = std::min<std::int64_t>(start + 2, d.at("rgb").size(0));
      parts.push_back(m::TwoStream(p, n::slice_axis(d.at("rgb"), 0, start, end),
                                   n::slice_axis(d.at("flow"), 0, start, end), c)
                          .log_scores);
    }
    return n::concat(parts, 0);
  };
  auto rows = [](const m::TwoStreamData &d, const std::vector<std::int64_t> &ids) {
    m::TwoStreamData out;
    for (const auto &[key, value] : d)
      out.emplace(key, n::take_rows(value, ids));
    return out;
  };

  const auto initial = m::ScoreSequenceClassifier(predict(fit), fit.at("label")).nll;
  const auto untrained = predict(test);
  const auto probe = rows(fit, {0, 1});
  const auto out = m::TwoStream(p, probe.at("rgb"), probe.at("flow"), c, true, &drops);
  const auto checked =
      n::grad(n::sparse_softmax_cross_entropy(out.rgb.logits, probe.at("label")) +
                  n::sparse_softmax_cross_entropy(out.flow.logits, probe.at("label")),
              p.parameters());
  for (const auto &g : checked)
    if (!n::all(n::is_finite(g)).item<bool>() || n::sum(n::square(g)).item() <= 0)
      return 1;
  n::OptimizerConfig options;
  options.kind = n::OptimizerKind::Adam;
  n::Optimizer adam(p, .001, options);
  n::BatchOrder order(24, 2, 857);
  double best = INFINITY;
  int selected = 0, updates = 0;
  std::vector<n::Tensor> history;
  std::print("| epoch | dropout branch CE sum | validation fused NLL |\n|---:|---:|---:|\n");
  for (int epoch = 1; epoch <= 3; ++epoch) {
    order.begin_epoch();
    auto average = n::zeros({}, n::DType::Float64);
    for (;;) {
      const auto ids = order.next();
      if (ids.empty())
        break;
      const auto batch = rows(fit, ids);
      const auto path = m::TwoStream(p, batch.at("rgb"), batch.at("flow"), c, true, &drops);
      const auto loss = n::sparse_softmax_cross_entropy(path.rgb.logits, batch.at("label")) +
                        n::sparse_softmax_cross_entropy(path.flow.logits, batch.at("label"));
      average = average + loss.detach().to(n::DType::Float64) / 12.;
      adam.step(n::grad(loss, p.parameters()));
      ++updates;
    }
    const auto val =
        m::ScoreSequenceClassifier(predict(validation), validation.at("label")).nll;
    if (val.item() < best) {
      best = val.item();
      selected = epoch;
      n::NamedTensors arrays;
      for (std::size_t i = 0; i < p.size(); ++i)
        arrays.push_back({p.names()[i], p.parameters()[i]});
      n::save_npz("build/two_stream_best.npz", arrays);
    }
    history.push_back(n::stack({average, val}, 0));
    std::print("| {} | {:.6f} | {:.6f} |\n", epoch, average.item(), val.item());
  }
  for (const auto &[key, value] : n::load_npz("build/two_stream_best.npz"))
    p.set(key, value);
  const auto fitted = m::ScoreSequenceClassifier(predict(fit), fit.at("label")).nll;
  n::save_npz("build/two_stream_outputs.npz",
              {{"logits", predict(test)}, {"untrained", untrained}});
  std::print("{}explicit joint Adam updates;selected {},validation {:.6f};fixed fused fitNLL "
             "{:.9f}->{:.9f}.\n",
             updates, selected, best, initial.item(), fitted.item());
  const auto h = n::stack(history, 0);
  auto plot = dm::graphics::RPlot::create();
  plot.lines(n::arange(1, 4).to_vector<double>(), n::select(h, 1, 0).to_vector<double>(),
             "branch CE sum", {37, 99, 235})
      .lines(n::arange(1, 4).to_vector<double>(), n::select(h, 1, 1).to_vector<double>(),
             "fused validation", {220, 38, 38})
      .title("Thirty-six explicit joint Adam updates")
      .x_label("epoch;twelve fitting batches")
      .y_label("declared two-loss sum/fused NLL");
  plot.save_svg("build/two_stream_training.svg");
}
```
