> Visible tensor optimization of a real adjacent-frame field

LetIx,Iy,Itbe2x2brightness derivatives. Spatial derivative kernels divide by4
and apply to first+second;the temporal2x2mean applies to second-first.
Symmetric bottom/right borders keep original pixel dimensions. The objective
is a half SUM,so each independent pixel receives an unaveraged gradient:

$$ E(u,v)=\tfrac12\sum_p(I_xu+I_yv+I_t)^2+\tfrac{\alpha^2}{2}\sum_{(p,q)\in\mathcal E}[(u_p-u_q)^2+(v_p-v_q)^2]. $$
\alttext(Half summed brightness residual squared plus alpha squared times half the summed horizontal and vertical displacement differences.)

Below repeat the exact400step preparation on the first genuine fitting clip,
using all ten adjacent pairs,and compare every resulting displacement value
against the prepared archive. The optimizer leaves are the actual dx/dy fields;
no learned flow model or hidden solver is used.
```{cpp, results="markdown", file="figures/two_stream_flow_fit.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

#include <print>
int main() {
  namespace n = dm::nn;
  namespace m = n::models;
  n::set_num_threads(2);

  std::filesystem::path cache;
  if (const auto *p = std::getenv("DATAMUNGE_DATA_DIR"))
    cache = p;
  else if (const auto *p = std::getenv("XDG_CACHE_HOME"))
    cache = std::filesystem::path(p) / "datamunge/datasets";
  else
    cache = std::filesystem::path(std::getenv("HOME")) / ".cache/datamunge/datasets";

  std::filesystem::path root = cache / "two_stream";
  if (const auto *v = std::getenv("DATAMUNGE_TWO_STREAM_DIR"))
    root = v;
  else
    dm::datasets::prepare_example_data("two_stream", root.string());
  const auto pools = m::LoadTwoStream(root);
  const auto &fit = pools[0];
  const auto &validation = pools[1];
  const auto &test = pools[2];

  n::Tensor frames;
  const auto prefix = std::to_string(int(fit.at("video_id").at({0}))) + "/" +
                      std::to_string(int(fit.at("segment").at({0}))) + "/rgb";
  for (const auto &[key, value] : n::load_npz((root / "flow_audit.npz").string()))
    if (key == prefix)
      frames = value;
  if (!frames.defined())
    return 1;
  const auto gray =
      n::sum(frames * n::from_vector(std::vector<float>{.299f, .587f, .114f}, {1, 1, 1, 3}),
             {3}, true);
  const auto d = m::TwoStreamFlowDerivatives(n::slice_axis(gray, 0, 0, 10),
                                             n::slice_axis(gray, 0, 1, 11));
  n::ParameterStore flow;
  const auto u = flow.get("u", {10, 96, 96, 1}, n::init::zeros()),
             v = flow.get("v", {10, 96, 96, 1}, n::init::zeros());
  n::OptimizerConfig options;
  options.kind = n::OptimizerKind::Sgd;
  n::Optimizer sgd(flow, .2, options);
  std::vector<n::Tensor> energy;
  for (int step = 0; step < 400; ++step) {
    const auto loss = m::TwoStreamFlowEnergy(u, v, d, .05);
    energy.push_back(loss.detach());
    sgd.step(n::grad(loss, flow.parameters()));
  }
  energy.push_back(m::TwoStreamFlowEnergy(u, v, d, .05).detach());
  const auto actual = n::concat({u.detach(), v.detach()}, 3);
  const auto parity = n::max(n::abs(actual - n::select(fit.at("flow"), 0, 0)));
  if (parity.item() != 0)
    return 1;
  std::print("All{}actual dx/dy values replay exactly;energy {:.9g}->{:.9g}.\n",
             actual.numel(), energy.front().item(), energy.back().item());
  auto plot = dm::graphics::RPlot::create();
  plot.lines(n::arange(0, 401).to_vector<double>(), n::stack(energy, 0).to_vector<double>(),
             "actual first clip", {37, 99, 235})
      .title("400explicit tensorSGD flow steps")
      .x_label("field optimization step")
      .y_label("summed variational energy");
  plot.save_svg("build/two_stream_flow_fit.svg");
}
```
