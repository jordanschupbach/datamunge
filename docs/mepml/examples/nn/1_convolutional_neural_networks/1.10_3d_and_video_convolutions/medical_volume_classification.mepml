```{cpp, results="markdown", file="figures/medical_volume_classification_data.png", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

#include <print>
int main() {
  namespace n = dm::nn;
  namespace m = n::models;
  n::set_num_threads(2);

  std::filesystem::path cache;
  if (const auto *p = std::getenv("DATAMUNGE_DATA_DIR"))
    cache = p;
  else if (const auto *p = std::getenv("XDG_CACHE_HOME"))
    cache = std::filesystem::path(p) / "datamunge/datasets";
  else
    cache = std::filesystem::path(std::getenv("HOME")) / ".cache/datamunge/datasets";

  std::filesystem::path root = cache / "medical_volume";
  if (const auto *p = std::getenv("DATAMUNGE_MEDICAL_DIR"))
    root = p;
  else
    dm::datasets::prepare_example_data("medical", root.string());
  const auto pools = m::LoadMedical(root);
  const auto &fit = pools[0];
  const auto &validation = pools[1];
  const auto &test = pools[2];

  std::print("| pool | original cubes | source0/source1 counts |\n|---|---:|---|\n");
  for (int i = 0; i < 3; ++i)
    std::print("| {} | {} | {} |\n",
               i == 0   ? "fit"
               : i == 1 ? "validation"
                        : "test",
               pools[i].size(), n::sum(n::one_hot(pools[i].labels, 2), {0}));
  std::print("Gallery row-major source IDs {};labels {}.\n", test.source, test.labels);
  n::save_image_grid(n::select(test.voxels, 1, 14),
                     "build/medical_volume_classification_data.png", 8, 0, 1, 2, 0, 3);
}
