> All48tensor Adam updates and fixed source dropout

Warm20learned leaves and the two separate moment scalars. Set fitting-only
moments before inference/training,then create tensor Adam(.001). Seeds1049/
1051,dropout1031,batch-order1061,batch4,three epochs over64cubes give48updates.
An explicit first-four-cube dropout gradient probe advances the same RNG
before training and checks every learned tensor. Every minibatch shows the
entire forward,CE,gradient and Adam step. Validation NLL selects the paired
checkpoint;normalization scalars remain constant throughout fitting.
```{cpp, results="markdown", file="figures/medical_volume_classification_training.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

#include <print>
int main() {
  namespace n = dm::nn;
  namespace m = n::models;
  n::set_num_threads(2);

  std::filesystem::path cache;
  if (const auto *p = std::getenv("DATAMUNGE_DATA_DIR"))
    cache = p;
  else if (const auto *p = std::getenv("XDG_CACHE_HOME"))
    cache = std::filesystem::path(p) / "datamunge/datasets";
  else
    cache = std::filesystem::path(std::getenv("HOME")) / ".cache/datamunge/datasets";

  std::filesystem::path root = cache / "medical_volume";
  if (const auto *p = std::getenv("DATAMUNGE_MEDICAL_DIR"))
    root = p;
  else
    dm::datasets::prepare_example_data("medical", root.string());
  const auto pools = m::LoadMedical(root);
  const auto &fit = pools[0];
  const auto &validation = pools[1];
  const auto &test = pools[2];

  n::ParameterStore p(1049), state(1051);
  n::Generator dropout(1031);
  {
    n::NoGradGuard guard;
    m::MedicalVolume(p, state, n::zeros({1, 28, 28, 28, 1}));
  }
  auto predict = [&](const n::Tensor &voxels) {
    n::NoGradGuard guard;
    std::vector<n::Tensor> parts;
    for (std::int64_t start = 0; start < voxels.size(0); start += 4)
      parts.push_back(
          m::MedicalVolume(p, state,
                           n::slice_axis(voxels, 0, start,
                                         std::min<std::int64_t>(start + 4, voxels.size(0))))
              .logits);
    return n::concat(parts, 0);
  };

  for (const auto &[key, value] :
       n::load_npz("build/medical_volume_classification_moments.npz"))
    state.set(key, value);
  const auto initial = m::ScoreSequenceClassifier(predict(fit.voxels), fit.labels).nll;
  const auto untrained = predict(test.voxels);
  const auto probe = m::MedicalRows(fit, {0, 1, 2, 3});
  const auto checked = m::MedicalVolume(p, state, probe.voxels, 4, true, &dropout);
  for (const auto &g :
       n::grad(n::sparse_softmax_cross_entropy(checked.logits, probe.labels), p.parameters()))
    if (!n::all(n::is_finite(g)).item<bool>() || n::sum(n::square(g)).item() <= 0)
      return 1;
  n::OptimizerConfig options;
  options.kind = n::OptimizerKind::Adam;
  n::Optimizer adam(p, .001, options);
  n::BatchOrder order(fit.size(), 4, 1061);
  double best = INFINITY;
  int selected = 0, updates = 0;
  std::vector<n::Tensor> history;
  std::print("| epoch | dropout fitting CE | validation NLL |\n|---:|---:|---:|\n");
  for (int epoch = 1; epoch <= 3; ++epoch) {
    order.begin_epoch();
    auto average = n::zeros({}, n::DType::Float64);
    for (;;) {
      const auto rows = order.next();
      if (rows.empty())
        break;
      const auto d = m::MedicalRows(fit, rows);
      const auto out = m::MedicalVolume(p, state, d.voxels, 4, true, &dropout);
      const auto loss = n::sparse_softmax_cross_entropy(out.logits, d.labels);
      average = average +
                loss.detach().to(n::DType::Float64) * double(rows.size()) / double(fit.size());
      adam.step(n::grad(loss, p.parameters()));
      ++updates;
    }
    const auto val =
        m::ScoreSequenceClassifier(predict(validation.voxels), validation.labels).nll;
    if (val.item() < best) {
      best = val.item();
      selected = epoch;
      n::NamedTensors learned, moments;
      for (std::size_t i = 0; i < p.size(); ++i)
        learned.push_back({p.names()[i], p.parameters()[i]});
      for (std::size_t i = 0; i < state.size(); ++i)
        moments.push_back({state.names()[i], state.parameters()[i]});
      n::save_npz("build/medical_volume_classification_best.npz", learned);
      n::save_npz("build/medical_volume_classification_state.npz", moments);
    }
    history.push_back(n::stack({average, val}, 0));
    std::print("| {} | {:.6f} | {:.6f} |\n", epoch, average.item(), val.item());
  }
  for (const auto &[key, value] : n::load_npz("build/medical_volume_classification_best.npz"))
    p.set(key, value);
  for (const auto &[key, value] : n::load_npz("build/medical_volume_classification_state.npz"))
    state.set(key, value);
  const auto fitted = m::ScoreSequenceClassifier(predict(fit.voxels), fit.labels).nll;
  n::save_npz("build/medical_volume_classification_outputs.npz",
              {{"logits", predict(test.voxels)}, {"untrained", untrained}});
  std::print("{}explicitAdam updates;selected epoch {},val {:.6f};fixed fitting inference NLL "
             "{:.6f}->{:.6f}.\n",
             updates, selected, best, initial.item(), fitted.item());
  const auto h = n::stack(history, 0);
  auto plot = dm::graphics::RPlot::create();
  plot.lines(n::arange(1, 4).to_vector<double>(), n::select(h, 1, 0).to_vector<double>(),
             "dropout fit", {37, 99, 235})
      .lines(n::arange(1, 4).to_vector<double>(), n::select(h, 1, 1).to_vector<double>(),
             "validation", {220, 38, 38})
      .title("Forty-eight explicit tensor Adam updates")
      .x_label("epoch;sixteen fitting batches each")
      .y_label("categorical CE/NLL");
  plot.save_svg("build/medical_volume_classification_training.svg");
}
