> Complete custom residual3Dgraph and every stage

This source model is a custom teaching CNN,not a named published medical
architecture. Three stages use widths4/8/16. Each has a3x3x3stride2/ReLU,
a3x3x3linear convolution,and a1x1x1stride2projection before summed ReLU.
SAME borders preserve28->14->7->4. He-uniform kernels and zero biases,
globalD/H/Waverage,headkeep.8dropout and Glorot linear2class head give
13782learned values/20tensors plus two fitting-normalization scalars. No BN.
Native odd/even fixtures independently check all646kernel/projection/bias/
input derivatives. Below actual initialized source-cube stages remain visible.
```{cpp, results="markdown", file="figures/medical_volume_classification_features.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

#include <print>
int main() {
  namespace n = dm::nn;
  namespace m = n::models;
  n::set_num_threads(2);

  std::filesystem::path cache;
  if (const auto *p = std::getenv("DATAMUNGE_DATA_DIR"))
    cache = p;
  else if (const auto *p = std::getenv("XDG_CACHE_HOME"))
    cache = std::filesystem::path(p) / "datamunge/datasets";
  else
    cache = std::filesystem::path(std::getenv("HOME")) / ".cache/datamunge/datasets";

  std::filesystem::path root = cache / "medical_volume";
  if (const auto *p = std::getenv("DATAMUNGE_MEDICAL_DIR"))
    root = p;
  else
    dm::datasets::prepare_example_data("medical", root.string());
  const auto pools = m::LoadMedical(root);
  const auto &fit = pools[0];
  const auto &validation = pools[1];
  const auto &test = pools[2];

  n::ParameterStore p(1049), state(1051);
  n::Generator dropout(1031);
  {
    n::NoGradGuard guard;
    m::MedicalVolume(p, state, n::zeros({1, 28, 28, 28, 1}));
  }
  auto predict = [&](const n::Tensor &voxels) {
    n::NoGradGuard guard;
    std::vector<n::Tensor> parts;
    for (std::int64_t start = 0; start < voxels.size(0); start += 4)
      parts.push_back(
          m::MedicalVolume(p, state,
                           n::slice_axis(voxels, 0, start,
                                         std::min<std::int64_t>(start + 4, voxels.size(0))))
              .logits);
    return n::concat(parts, 0);
  };

  for (const auto &[key, value] :
       n::load_npz("build/medical_volume_classification_moments.npz"))
    state.set(key, value);
  const auto out = m::MedicalVolume(p, state, n::slice_axis(fit.voxels, 0, 0, 1));
  std::print(
      "{}learned values/{}leaves+{}normalization scalars;input {},global {},head {};stages",
      p.count(), p.size(), state.count(), out.normalized.shape(), out.global.shape(),
      out.logits.shape());
  for (const auto &stage : out.stages)
    std::print(" {}", stage.shape());
  std::print("\n");
  const auto normalized = n::select(n::select(n::select(out.normalized, 0, 0), 0, 14), 2, 0);
  const auto feature = n::mean(n::select(n::select(out.stages[0], 0, 0), 0, 7), {2});
  auto a = n::plot_tensor_map(normalized, n::min(normalized).item(),
                              n::max(normalized).item()),
       b = n::plot_tensor_map(feature, 0, n::max(feature).item());
  a.title("Actual fitting-normalized input slice")
      .x_label("released width")
      .y_label("released height");
  b.title("Initialized first residual stage mean")
      .x_label("stage width")
      .y_label("stage height;depth7");
  auto layout = dm::graphics::RLayout::create(1, 2);
  layout.add(a).add(b).size(1100, 500).fit_panels().save_svg(
      "build/medical_volume_classification_features.svg");
}
```
