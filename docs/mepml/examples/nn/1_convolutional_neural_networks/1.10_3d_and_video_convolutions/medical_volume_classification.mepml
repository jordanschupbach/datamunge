> Fit-only intensity moments and actual orthogonal volume views

Compute Double population mean/std over all fitting voxels,then store those
two scalars as Float32. Validation/test never estimate normalization.
The scalar state is separate from20learned tensors and is checkpointed with
them;no population fitting is hidden in forward. Original byte intensities
and standardized intensities are different display scales,clearly labeled.
Show depth14and height14planes from the first original fitting cube.
```{cpp, results="markdown", file="figures/medical_volume_classification_views.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

#include <print>
int main() {
  namespace n = dm::nn;
  namespace m = n::models;
  n::set_num_threads(2);

  std::filesystem::path cache;
  if (const auto *p = std::getenv("DATAMUNGE_DATA_DIR"))
    cache = p;
  else if (const auto *p = std::getenv("XDG_CACHE_HOME"))
    cache = std::filesystem::path(p) / "datamunge/datasets";
  else
    cache = std::filesystem::path(std::getenv("HOME")) / ".cache/datamunge/datasets";

  std::filesystem::path root = cache / "medical_volume";
  if (const auto *p = std::getenv("DATAMUNGE_MEDICAL_DIR"))
    root = p;
  else
    dm::datasets::prepare_example_data("medical", root.string());
  const auto pools = m::LoadMedical(root);
  const auto &fit = pools[0];
  const auto &validation = pools[1];
  const auto &test = pools[2];

  const auto fitting = fit.voxels.to(n::DType::Float64);
  const auto mean = n::mean(fitting).to(n::DType::Float32);
  const auto stddev = n::sqrt(n::variance(fitting)).to(n::DType::Float32);
  n::save_npz("build/medical_volume_classification_moments.npz",
              {{"normalization/mean", mean}, {"normalization/stddev", stddev}});
  const auto volume = n::select(n::select(fit.voxels, 0, 0), 3, 0);
  const auto axial = n::select(volume, 0, 14);
  const auto coronal = n::select(volume, 1, 14);
  std::print("Fitting-only Float32 mean {},stddev {},all{}fitting voxels;source ID{}.\n", mean,
             stddev, fitting.numel(), n::select(fit.source, 0, 0));
  auto a = n::plot_tensor_map(axial, 0, 1), b = n::plot_tensor_map(coronal, 0, 1);
  a.title("Original fitting cube:depth14plane")
      .x_label("released array width")
      .y_label("released array height");
  b.title("Same original cube:height14plane")
      .x_label("released array width")
      .y_label("released array depth");
  auto layout = dm::graphics::RLayout::create(1, 2);
  layout.add(a).add(b).size(1100, 500).fit_panels().save_svg(
      "build/medical_volume_classification_views.svg");
}
