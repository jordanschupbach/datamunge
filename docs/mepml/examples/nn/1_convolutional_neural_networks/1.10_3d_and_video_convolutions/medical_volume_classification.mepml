> Parameter-free volumetric intensity memory reference

Split each original28cube into4x4x4blocks of7cubed voxels. Preserve source
Float32 division by343before Double block summation. These64block means
feed squared-distance1NN over the64fitting records,first fitting row winning
equal distances. No learned model leaves,optimizer or held-out population
statistics enter this retained-memory reference. Native tests independently
check every fitting feature and held-out score against literal source host code.
```{cpp, results="markdown", file="figures/medical_volume_classification_reference.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

#include <print>
int main() {
  namespace n = dm::nn;
  namespace m = n::models;
  n::set_num_threads(2);

  std::filesystem::path cache;
  if (const auto *p = std::getenv("DATAMUNGE_DATA_DIR"))
    cache = p;
  else if (const auto *p = std::getenv("XDG_CACHE_HOME"))
    cache = std::filesystem::path(p) / "datamunge/datasets";
  else
    cache = std::filesystem::path(std::getenv("HOME")) / ".cache/datamunge/datasets";

  std::filesystem::path root = cache / "medical_volume";
  if (const auto *p = std::getenv("DATAMUNGE_MEDICAL_DIR"))
    root = p;
  else
    dm::datasets::prepare_example_data("medical", root.string());
  const auto pools = m::LoadMedical(root);
  const auto &fit = pools[0];
  const auto &validation = pools[1];
  const auto &test = pools[2];

  const auto features = m::MedicalFeatures(fit.voxels);
  const auto z = m::MedicalBaseline(fit, test);
  const auto score = m::ScoreSensor(z, test.labels, 2);
  std::print("Parameter-free64feature1NN:accuracy {:.6f},macroF1 {:.6f},NLL {:.6f},all "
             "recalls {},complete confusion {}.\n",
             score.accuracy, score.macro_f1, score.nll, n::from_vector(score.recall),
             n::from_vector(score.confusion, {2, 2}));
  auto plot = n::plot_tensor_map(n::reverse(features, {0}), 0, n::max(features).item());
  plot.title("Every retained fitting volume feature")
      .x_label("all64depth/height/width block means")
      .y_label("original fitting record0 at bottom");
  plot.save_svg("build/medical_volume_classification_reference.svg");
}
```
