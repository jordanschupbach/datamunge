> Independent intensity-only restore and volumetric controls

Restore a fresh20learned+2normalization pair,then predict from intensities
only. Check saved/repeated/single-batch logits and all22arrays unchanged.
Reverse depth and repeat the mean-depth projection as explicit controls;
neither supplies additional measured data. Compare every one of64held-out
records with the unchanged1NNmemory,initialization and balanced tie0.
Print every source ID,true dataset label and learned prediction,plus complete
confusions and per-class recall. Tensor metrics use every original test record.
```{cpp, results="markdown", file="figures/medical_volume_classification_confusion.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

#include <print>
int main() {
  namespace n = dm::nn;
  namespace m = n::models;
  n::set_num_threads(2);

  std::filesystem::path cache;
  if (const auto *p = std::getenv("DATAMUNGE_DATA_DIR"))
    cache = p;
  else if (const auto *p = std::getenv("XDG_CACHE_HOME"))
    cache = std::filesystem::path(p) / "datamunge/datasets";
  else
    cache = std::filesystem::path(std::getenv("HOME")) / ".cache/datamunge/datasets";

  std::filesystem::path root = cache / "medical_volume";
  if (const auto *p = std::getenv("DATAMUNGE_MEDICAL_DIR"))
    root = p;
  else
    dm::datasets::prepare_example_data("medical", root.string());
  const auto pools = m::LoadMedical(root);
  const auto &fit = pools[0];
  const auto &validation = pools[1];
  const auto &test = pools[2];

  n::ParameterStore p(1049), state(1051);
  n::Generator dropout(1031);
  {
    n::NoGradGuard guard;
    m::MedicalVolume(p, state, n::zeros({1, 28, 28, 28, 1}));
  }
  auto predict = [&](const n::Tensor &voxels) {
    n::NoGradGuard guard;
    std::vector<n::Tensor> parts;
    for (std::int64_t start = 0; start < voxels.size(0); start += 4)
      parts.push_back(
          m::MedicalVolume(p, state,
                           n::slice_axis(voxels, 0, start,
                                         std::min<std::int64_t>(start + 4, voxels.size(0))))
              .logits);
    return n::concat(parts, 0);
  };

  for (const auto &[key, value] : n::load_npz("build/medical_volume_classification_best.npz"))
    p.set(key, value.clone());
  for (const auto &[key, value] : n::load_npz("build/medical_volume_classification_state.npz"))
    state.set(key, value.clone());
  std::vector<n::Tensor> before, moments;
  for (const auto &v : p.parameters())
    before.push_back(v.clone());
  for (const auto &v : state.parameters())
    moments.push_back(v.clone());
  n::Tensor saved, untrained;
  for (const auto &[key, value] :
       n::load_npz("build/medical_volume_classification_outputs.npz")) {
    if (key == "logits")
      saved = value;
    else
      untrained = value;
  }
  const auto z = predict(test.voxels);
  const auto parity =
      n::maximum(n::max(n::abs(z - saved)), n::max(n::abs(z - predict(test.voxels))));
  const auto single =
      n::max(n::abs(predict(n::slice_axis(test.voxels, 0, 0, 1)) - n::slice_axis(z, 0, 0, 1)));
  const auto reversed = predict(n::reverse(test.voxels, {1}).contiguous());
  const auto collapsed = predict(n::tile(n::mean(test.voxels, {1}, true), {1, 28, 1, 1, 1}));
  const auto reverse_change =
      n::sum(n::abs(z.to(n::DType::Float64) - reversed.to(n::DType::Float64)));
  const auto collapse_change =
      n::sum(n::abs(z.to(n::DType::Float64) - collapsed.to(n::DType::Float64)));
  bool immutable = true;
  for (std::size_t i = 0; i < before.size(); ++i)
    immutable = immutable && n::all(n::equal(before[i], p.parameters()[i])).item<bool>();
  for (std::size_t i = 0; i < moments.size(); ++i)
    immutable = immutable && n::all(n::equal(moments[i], state.parameters()[i])).item<bool>();
  if (parity.item() > 1e-6 || single.item() > 1e-6 || reverse_change.item() <= 1e-6 ||
      collapse_change.item() <= 1e-6 || !immutable)
    return 1;
  std::print("Intensity-only restore/repeat {:.3g};single/batch {:.9g} "
             "within1e-6;all22learned/moment arrays immutable:{};depth-reverse/collapse "
             "changes {:.9f}/{:.9f}.\n",
             parity.item(), single.item(), immutable, reverse_change.item(),
             collapse_change.item());
  const auto nearest = m::MedicalBaseline(fit, test);
  std::vector<n::Tensor> accuracy, nll;
  std::print("\n| predictor | accuracy | macroF1 | NLL | source0/1recall | complete true-row "
             "confusion |\n|---|---:|---:|---:|---|---|\n");
  for (const auto &item :
       std::vector<std::pair<std::string, n::Tensor>>{{"learned CNN", z},
                                                      {"untrained", untrained},
                                                      {"block1NN", nearest},
                                                      {"tie0", n::zeros_like(z)},
                                                      {"depth reverse control", reversed},
                                                      {"depth collapse control", collapsed}}) {
    const auto score = m::ScoreSensor(item.second, test.labels, 2);
    std::print("| {} | {:.6f} | {:.6f} | {:.6f} | {} | {} |\n", item.first, score.accuracy,
               score.macro_f1, score.nll, n::from_vector(score.recall),
               n::from_vector(score.confusion, {2, 2}));
    const auto base = m::ScoreSequenceClassifier(item.second, test.labels);
    accuracy.push_back(base.accuracy);
    nll.push_back(base.nll);
  }
  const auto ids = test.source.to_vector<int>(), truth = test.labels.to_vector<int>(),
             prediction = n::argmax(z, 1).to_vector<int>();
  std::print(
      "\n| released source ID | true dataset class | CNN prediction |\n|---:|---:|---:|\n");
  for (int row = 0; row < 64; ++row)
    std::print("| {} | {} | {} |\n", ids[row], truth[row], prediction[row]);
  auto a = dm::graphics::RPlot::create(), b = dm::graphics::RPlot::create();
  a.points(n::arange(0, 6).to_vector<double>(), n::stack(accuracy, 0).to_vector<double>(),
           "accuracy", {37, 99, 235})
      .title("All64held-out CT record accuracies")
      .x_label("0CNN/1initial/2NN/3tie/4reverse/5collapse")
      .y_label("correct original record fraction")
      .y_limits(0, 1.1);
  b.points(n::arange(0, 6).to_vector<double>(), n::stack(nll, 0).to_vector<double>(), "NLL",
           {220, 38, 38})
      .title("Every held-out dataset-label likelihood")
      .x_label("same six predictor/control ordinals")
      .y_label("mean categorical NLL")
      .y_limits(0, 1);
  auto metrics = dm::graphics::RLayout::create(1, 2);
  metrics.add(a).add(b).size(1100, 500).fit_panels().save_svg(
      "build/medical_volume_classification_metrics.svg");
  std::filesystem::create_directories("figures");
  std::filesystem::copy_file("build/medical_volume_classification_metrics.svg",
                             "figures/medical_volume_classification_metrics.svg",
                             std::filesystem::copy_options::overwrite_existing);
  a = n::plot_tensor_map(
      n::reverse(m::ScoreSequenceClassifier(z, test.labels).confusion.to(n::DType::Float64),
                 {0}),
      0, 32);
  b = n::plot_tensor_map(
      n::reverse(
          m::ScoreSequenceClassifier(nearest, test.labels).confusion.to(n::DType::Float64),
          {0}),
      0, 32);
  a.title("Learned CT CNN complete confusion")
      .x_label("predicted source class0/1")
      .y_label("true source0benign at bottom");
  b.title("Block1NN complete confusion")
      .x_label("predicted source class0/1")
      .y_label("true source0benign at bottom");
  auto confusion = dm::graphics::RLayout::create(1, 2);
  confusion.add(a).add(b).size(1100, 500).fit_panels().save_svg(
      "build/medical_volume_classification_confusion.svg");
}
