> Duplicate feature adjoints and centroid subtraction

PointGather uses tensor batch offsets and gather,so repeated identities
scatter-add adjoints into the same source point. PointGroup freezes FPS/ball
choices on detached XYZ,then gathers live XYZ and subtracts each live center.
Thus the center receives the negative sum of its local-coordinate adjoints.
No derivative is claimed through a change in discrete membership.

Use declared tensor feature values and signed coefficients to show all source
adjoints. The XYZ objective is a signed linear function of local coordinates;
its per-cloud translation adjoint sums to zero. Plot the first cloud's full
6x2 feature and6x3 coordinate adjoints,not selected favorable coordinates.
```{cpp, results="markdown", file="figures/point_geometry_gradients.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

#include <print>
int main() {
  namespace n = dm::nn;
  namespace m = n::models;

  const auto xyz = n::tensor({0.,  0.,  0., 1.,  0.,  0., 0.,    1., 0., -1., 0., 0.,
                              0.,  -1., 0., .25, .25, 0., 10.,   0., 0., 11., 0., 0.,
                              13., 0.,  0., 12., 0.,  0., 10.25, 0., 0., 9.,  0., 0.},
                             {2, 6, 3});

  auto x = xyz.clone();
  x.requires_grad_(true);
  auto features = n::arange(0, 24).reshape({2, 6, 2});
  features.requires_grad_(true);
  const auto grouped = m::PointGroup(x, 4, 1., 4);
  const auto gathered = m::PointGather(features, grouped.indices);
  const auto coefficients = (n::cos(n::arange(0, 64) * .31) * .1).reshape({2, 4, 4, 2});
  const auto coordinate_coefficients =
      (n::sin(n::arange(0, 96) * .29) * .1).reshape({2, 4, 4, 3});
  const auto fg = n::grad(n::sum(gathered * coefficients), {features})[0];
  const auto xg = n::grad(n::sum(grouped.relative * coordinate_coefficients), {x})[0];
  const auto translation = n::max(n::abs(n::sum(xg, {1})));
  if (translation.item() > 3e-7 || grouped.indices.requires_grad() ||
      grouped.counts.requires_grad())
    return 1;
  std::print("All feature adjoints {};all XYZ adjoints {};maximum translation adjoint "
             "{:.9g};discrete choices detached.\n",
             fg, xg, translation.item());
  auto a = n::plot_tensor_map(n::reverse(n::select(fg, 0, 0), {0}), -n::max(n::abs(fg)).item(),
                              n::max(n::abs(fg)).item()),
       b = n::plot_tensor_map(n::reverse(n::select(xg, 0, 0), {0}), -n::max(n::abs(xg)).item(),
                              n::max(n::abs(xg)).item());
  a.title("Every cloud0 source feature adjoint")
      .x_label("feature channel0/1")
      .y_label("original point0 at bottom");
  b.title("Every cloud0 coordinate adjoint")
      .x_label("x/y/z coordinate")
      .y_label("original point0 at bottom");
  auto layout = dm::graphics::RLayout::create(1, 2);
  layout.add(a).add(b).size(1100, 500).fit_panels().save_svg(
      "build/point_geometry_gradients.svg");
}
```
