> Strict-radius membership and first-hit padding

For each sampled center,retain the first four input-order points with squared
distance strictly below1. The radius boundary is excluded. If fewer than
four points qualify,repeat the first hit;counts exclude repeated padding and
are capped at four. These are source policies,not nearest-distance ordering.
An empty neighborhood throws rather than inventing an index.

The matrices below show every neighbor identity. Point0's neighbors are0,5
plus repeated0;points1/2 at distance exactly1 are excluded. Repeated slots
are intentional and later receive duplicate gradient contributions.
```{cpp, results="markdown", file="figures/point_geometry_neighbors.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

#include <print>
int main() {
  namespace n = dm::nn;
  namespace m = n::models;

  const auto xyz = n::tensor({0.,  0.,  0., 1.,  0.,  0., 0.,    1., 0., -1., 0., 0.,
                              0.,  -1., 0., .25, .25, 0., 10.,   0., 0., 11., 0., 0.,
                              13., 0.,  0., 12., 0.,  0., 10.25, 0., 0., 9.,  0., 0.},
                             {2, 6, 3});

  const auto fps = m::PointFps(xyz, 4);
  const auto ball = m::PointBall(xyz, m::PointGather(xyz, fps), 1., 4);
  std::print(
      "| cloud | FPS centers | capped counts | all4x4neighbor IDs |\n|---:|---|---|---|\n");
  for (int row = 0; row < 2; ++row)
    std::print("| {} | {} | {} | {} |\n", row, n::select(fps, 0, row),
               n::select(ball.counts, 0, row), n::select(ball.indices, 0, row));
  auto a = n::plot_tensor_map(
           n::reverse(n::select(ball.indices, 0, 0).to(n::DType::Float64), {0}), 0, 5),
       b = n::plot_tensor_map(
           n::reverse(n::select(ball.indices, 0, 1).to(n::DType::Float64), {0}), 0, 5);
  a.title("Every cloud0 neighbor identity")
      .x_label("slot0..3;unused slots repeat first")
      .y_label("FPS center ordinal0 at bottom");
  b.title("Every cloud1 neighbor identity")
      .x_label("slot0..3;unused slots repeat first")
      .y_label("FPS center ordinal0 at bottom");
  auto layout = dm::graphics::RLayout::create(1, 2);
  layout.add(a).add(b).size(1100, 500).fit_panels().save_svg(
      "build/point_geometry_neighbors.svg");
}
