> Frozen-choice derivatives, translation and explicit errors

Finite differences must hold discrete identities fixed:the declared fixture
has radius-boundary points,so perturbing geometry and recomputing membership
would evaluate a different piecewise function. Freeze FPS/neighbor IDs,then
use Double tensor perturbations to check all36 XYZ coordinate derivatives.
Native tests independently check all60feature/XYZ coordinates with literal
host topology and repeat the comparison across108additional radius/slot
settings. They also verify oversize padding beyondN and collapsed-cloud ties.
```{cpp, results="markdown", file="figures/point_geometry_checks.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

#include <print>
int main() {
  namespace n = dm::nn;
  namespace m = n::models;

  const auto xyz = n::tensor({0.,  0.,  0., 1.,  0.,  0., 0.,    1., 0., -1., 0., 0.,
                              0.,  -1., 0., .25, .25, 0., 10.,   0., 0., 11., 0., 0.,
                              13., 0.,  0., 12., 0.,  0., 10.25, 0., 0., 9.,  0., 0.},
                             {2, 6, 3});

  const auto ids = m::PointFps(xyz, 4);
  const auto ball = m::PointBall(xyz, m::PointGather(xyz, ids), 1., 4);
  const auto coefficients =
      (n::sin(n::arange(0, 96, 1, n::DType::Float64) * .29) * .1).reshape({2, 4, 4, 3});
  auto objective = [&](const n::Tensor &x) {
    return n::sum(
        (m::PointGather(x, ball.indices) - n::expand_dims(m::PointGather(x, ids), 2)) *
        coefficients);
  };
  auto x = xyz.to(n::DType::Float64);
  x.requires_grad_(true);
  const auto gradient = n::grad(objective(x), {x})[0].reshape({36});
  std::vector<n::Tensor> errors;
  for (int coordinate = 0; coordinate < 36; ++coordinate) {
    const auto basis =
        n::one_hot(n::full({1}, coordinate, n::DType::Int32), 36, 1., 0., n::DType::Float64)
            .reshape({2, 6, 3});
    const auto fd =
        (objective(x.detach() + basis * 1e-5) - objective(x.detach() - basis * 1e-5)) / 2e-5;
    errors.push_back(n::abs(fd - n::select(gradient, 0, coordinate)));
  }
  const auto error = n::stack(errors, 0);
  const auto moved = m::PointGroup(xyz + 2., 4, 1., 4);
  const auto original = m::PointGroup(xyz, 4, 1., 4);
  if (n::max(error).item() > 1e-9 ||
      !n::all(n::equal(moved.indices, original.indices)).item<bool>() ||
      n::max(n::abs(moved.relative - original.relative)).item() != 0)
    return 1;
  int rejected = 0;
  try {
    m::PointBall(xyz, n::full({2, 1, 3}, 100.), .1, 4);
  } catch (const std::invalid_argument &) {
    ++rejected;
  }
  try {
    m::PointFps(n::zeros({2, 3, 3}), 4);
  } catch (const std::invalid_argument &) {
    ++rejected;
  }
  if (rejected != 2 || n::sum(m::PointFps(n::zeros({2, 6, 3}), 4)).item() != 0)
    return 1;
  std::print("All36frozen-choice Double coordinate derivatives,max error {:.12g};exact "
             "translation,collapsed seed ties and both declared invalid cases pass.\n",
             n::max(error).item());
  auto plot = dm::graphics::RPlot::create();
  plot.points(n::arange(0, 36).to_vector<double>(), (error * 1e12).to_vector<double>(),
              "all coordinates", {37, 99, 235})
      .title("Every frozen-choice coordinate derivative")
      .x_label("all36 source XYZ coordinates")
      .y_label("absolute error times one trillion");
  plot.save_svg("build/point_geometry_checks.svg");
}
```
