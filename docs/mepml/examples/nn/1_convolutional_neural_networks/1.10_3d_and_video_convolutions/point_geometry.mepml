> Plot every point in the declared geometry fixture

These two six-point clouds are the original hand-checkable source fixture,
not measured CAD surfaces. Every z coordinate is zero,so the XY plots show
all coordinates without projection loss. The first cloud tests symmetric
distance ties;the second is collinear and translated. FPS starts with index0
and chooses the first maximum of distance to the nearest selected center.
All numeric distance updates use tensors:Float32 source ingress,then Double
squared distances. Output identities are detached integer metadata. There
are no fitted parameters or optimizer in these supporting primitives.
```{cpp, results="markdown", file="figures/point_geometry_data.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

#include <print>
int main() {
  namespace n = dm::nn;
  namespace m = n::models;

  const auto xyz = n::tensor({0.,  0.,  0., 1.,  0.,  0., 0.,    1., 0., -1., 0., 0.,
                              0.,  -1., 0., .25, .25, 0., 10.,   0., 0., 11., 0., 0.,
                              13., 0.,  0., 12., 0.,  0., 10.25, 0., 0., 9.,  0., 0.},
                             {2, 6, 3});

  const auto ids = m::PointFps(xyz, 4);
  const auto centers = m::PointGather(xyz, ids);
  std::print("All original cloud coordinates {};FPS identities {}.\n", xyz, ids);
  auto a = dm::graphics::RPlot::create(), b = dm::graphics::RPlot::create();
  for (int row = 0; row < 2; ++row) {
    const auto points = n::select(xyz, 0, row);
    const auto selected = n::select(centers, 0, row);
    auto &plot = row == 0 ? a : b;
    plot.points(n::select(points, 1, 0).to_vector<double>(),
                n::select(points, 1, 1).to_vector<double>(), "all six points", {37, 99, 235})
        .points(n::select(selected, 1, 0).to_vector<double>(),
                n::select(selected, 1, 1).to_vector<double>(), "four FPS centers",
                {220, 38, 38})
        .title(row == 0 ? "Cloud0:symmetric distance ties"
                        : "Cloud1:collinear original points")
        .x_label("source x;all z=0")
        .y_label("source y")
        .y_limits(-1.3, 1.3);
  }
  auto layout = dm::graphics::RLayout::create(1, 2);
  layout.add(a).add(b).size(1100, 500).fit_panels().save_svg("build/point_geometry_data.svg");
}
```
