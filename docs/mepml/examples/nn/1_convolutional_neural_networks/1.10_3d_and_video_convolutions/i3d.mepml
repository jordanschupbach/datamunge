> All57units,nine Mixed modules and16endpoints

The RGB I3D graph retains three stem convolutions,four pools and nine four-branch
Mixed modules. Each module combines1x1x1,reduced3x3x3,reduced3x3x3 and pooled
projection branches. Temporal2/final-spatial average pool,keep.5head dropout,
linear1x1x1head and mean remaining temporal logits complete the source graph.
Full64frame224px400class uses12689984values/116learned+114moving tensors.
Compact16frame32px/divisor8/threeclass uses200261values with identical leaf,
unit and block counts. Native tests ACTUALLY execute full64x224x224forward
and every116learned derivative;reference shape tables alone are not the check.

Here every initialized actual fitting-clip endpoint is measured,and every
coordinate of all57initialized kernels is checked for equal temporal slices.
```{cpp, results="markdown", file="figures/i3d_features.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

#include <print>
int main() {
  namespace n = dm::nn;
  namespace m = n::models;
  n::set_num_threads(2);

  std::filesystem::path cache;
  if (const auto *p = std::getenv("DATAMUNGE_DATA_DIR"))
    cache = p;
  else if (const auto *p = std::getenv("XDG_CACHE_HOME"))
    cache = std::filesystem::path(p) / "datamunge/datasets";
  else
    cache = std::filesystem::path(std::getenv("HOME")) / ".cache/datamunge/datasets";

  std::filesystem::path root = cache / "action_video";
  if (const auto *p = std::getenv("DATAMUNGE_VIDEO_DIR"))
    root = p;
  else
    dm::datasets::prepare_example_data("video", root.string());
  const auto pools = m::LoadVideo(root);
  const auto &fit = pools[0];
  const auto &validation = pools[1];
  const auto &test = pools[2];

  const m::I3dConfig c{8, 3, 16, 32};
  n::ParameterStore p(677), state(679);
  n::Generator dropout(673);
  {
    n::NoGradGuard guard;
    m::I3d(p, state, n::zeros({1, 16, 32, 32, 3}), c);
  }
  auto predict = [&](const n::Tensor &rgb) {
    n::NoGradGuard guard;
    std::vector<n::Tensor> parts;
    for (std::int64_t start = 0; start < rgb.size(0); start += 2)
      parts.push_back(
          m::I3d(p, state,
                 n::slice_axis(rgb, 0, start, std::min<std::int64_t>(start + 2, rgb.size(0))),
                 c)
              .logits);
    return n::concat(parts, 0);
  };

  const auto out = m::I3d(p, state, n::slice_axis(fit.rgb, 0, 0, 1), c);
  int units = 0;
  auto error = n::zeros({});
  for (const auto &name : p.names())
    if (name.ends_with("/W") && name != "Logits/W") {
      const auto w = p.at(name);
      error = n::maximum(error, n::max(n::abs(w - n::expand_dims(n::select(w, 0, 0), 0))));
      ++units;
    }
  if (units != 57 || error.item() != 0)
    return 1;
  std::vector<n::Tensor> means;
  std::print("| source endpoint | actual compact shape |\n|---:|---|\n");
  for (std::size_t i = 0; i < out.stages.size(); ++i) {
    std::print("| {} | {} |\n", i, out.stages[i].shape());
    means.push_back(n::mean(out.stages[i].to(n::DType::Float64)));
  }
  std::print("{}values/{}learned+{}moving leaves,all{}inflated kernels slice error "
             "{:.3g};pooled {}.\n",
             p.count(), p.size(), state.size(), units, error.item(), out.pooled.shape());
  auto a = dm::graphics::RPlot::create(),
       b = n::plot_tensor_map(n::mean(n::select(n::select(out.stages[0], 0, 0), 0, 0), {2}), 0,
                              n::max(out.stages[0]).item());
  a.lines(n::arange(0, 16).to_vector<double>(), n::stack(means, 0).to_vector<double>(),
          "every endpoint", {37, 99, 235})
      .title("All16 initialized I3D endpoints")
      .x_label("stem/pool/Mixed source ordinal")
      .y_label("actual mean ReLU activation");
  b.title("Actual first-frame initialized stem map")
      .x_label("source spatial x")
      .y_label("source spatial y");
  auto layout = dm::graphics::RLayout::create(1, 2);
  layout.add(a).add(b).size(1100, 500).fit_panels().save_svg("build/i3d_features.svg");
}
```
