> Temporal inflation and repeated-image borders

Inflate a Float32 HWIO spatial kernel intoTidentical slices,W3D[t]=W2D/T.
All57normalized units initialize from RANDOM spatial Glorot filters;there is
no ImageNet/Kinetics weight loading. Repeated-image interior response matches
the spatial convolution. Temporal zero-padding edges receive fewer taps;
for a three-tap filter the first/last response is2/3of the interior response.
The original native fixture verifies every196source-kernel/input derivative.

Below repeat the first real fitting frame as an explicitly declared control,
apply a three-tap inflated kernel,and compare all outputs with a2Dconvolution
scaled by the actual temporal tap fraction. Repeated images are not training data.
```{cpp, results="markdown", file="figures/i3d_inflation.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

#include <print>
int main() {
  namespace n = dm::nn;
  namespace m = n::models;
  n::set_num_threads(2);

  std::filesystem::path cache;
  if (const auto *p = std::getenv("DATAMUNGE_DATA_DIR"))
    cache = p;
  else if (const auto *p = std::getenv("XDG_CACHE_HOME"))
    cache = std::filesystem::path(p) / "datamunge/datasets";
  else
    cache = std::filesystem::path(std::getenv("HOME")) / ".cache/datamunge/datasets";

  std::filesystem::path root = cache / "action_video";
  if (const auto *p = std::getenv("DATAMUNGE_VIDEO_DIR"))
    root = p;
  else
    dm::datasets::prepare_example_data("video", root.string());
  const auto pools = m::LoadVideo(root);
  const auto &fit = pools[0];
  const auto &validation = pools[1];
  const auto &test = pools[2];

  const auto frame = n::slice_axis(n::select(fit.rgb, 1, 0), 0, 0, 1);
  const auto spatial = (n::sin(n::arange(0, 108) * .23) * .07).reshape({3, 3, 3, 4});
  const auto inflated = m::InflateI3d(spatial, 3);
  const auto video = n::tile(n::expand_dims(frame, 1), {1, 16, 1, 1, 1});
  const auto y = n::conv3d(video, inflated, n::conv3d_options(1, n::Padding::Same));
  const auto two_d = n::conv2d(frame, spatial, n::Conv2DOptions{.padding = n::Padding::Same});
  const auto fraction =
      n::conv1d(n::ones({1, 16, 1}), n::ones({3, 1, 1}) / 3., 1, n::Padding::Same)
          .reshape({1, 16, 1, 1, 1});
  const auto error = n::abs(y - n::expand_dims(two_d, 1) * fraction);
  const auto max_error = n::max(error);
  if (max_error.item() > 2e-6)
    return 1;
  std::print("All{}repeated-original-frame outputs,max2D/tap-fraction parity "
             "{:.9g};edge/interior fractions {}.\n",
             y.numel(), max_error.item(), fraction.reshape({16}));
  const auto filter = n::select(n::select(inflated, 3, 0), 3, 0).reshape({3, 9});
  auto a = n::plot_tensor_map(n::reverse(filter, {0}), -n::max(n::abs(filter)).item(),
                              n::max(n::abs(filter)).item()),
       b = dm::graphics::RPlot::create();
  a.title("Declared equal temporal filter slices")
      .x_label("spatial3x3coordinate")
      .y_label("temporal tap0 at bottom");
  b.lines(n::arange(0, 16).to_vector<double>(),
          (n::mean(error.to(n::DType::Float64), {0, 2, 3, 4}) * 1e9).to_vector<double>(),
          "all output values", {37, 99, 235})
      .title("Repeated real-frame inflation parity")
      .x_label("all16time positions,including borders")
      .y_label("mean absolute error times one billion");
  auto layout = dm::graphics::RLayout::create(1, 2);
  layout.add(a).add(b).size(1100, 500).fit_panels().save_svg("build/i3d_inflation.svg");
}
```
