// result_begin:
// Tensor area/barycentric sampling and unit-ball normalization saved42original surfaces.
// result_end

Fan triangulation is topology metadata. Double tensors compute triangle areas,
sample1024faces proportional to area with generator941+sourceID,and use
square-root-uniform barycentric draws. Subtract sampled mean,divide by maximum
sampled Euclidean radius,then round Float32. Retain all face IDs,uniforms,
centers/radii. Independent NumPy/OFF/RNG replay matches all129024XYZ values,
43008face choices and86016barycentric uniforms exactly. Full graphs use1024
points;compact fits use the first256without creating new points.

Plot every1024sampled point of one actual fitting mesh per source class,in
XY/XZprojections. Each point is an observation sampled from original CAD
triangles;occlusion/depth is not reconstructed by these simple scatter plots.
```{cpp, results="markdown", file="figures/point_models_checks_data.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

#include <print>
int main() {
  namespace n = dm::nn;
  namespace m = n::models;
  n::set_num_threads(2);

  std::filesystem::path cache;
  if (const auto *p = std::getenv("DATAMUNGE_DATA_DIR"))
    cache = p;
  else if (const auto *p = std::getenv("XDG_CACHE_HOME"))
    cache = std::filesystem::path(p) / "datamunge/datasets";
  else
    cache = std::filesystem::path(std::getenv("HOME")) / ".cache/datamunge/datasets";

  std::filesystem::path root = cache / "modelnet";
  if (const auto *p = std::getenv("DATAMUNGE_POINT_DIR"))
    root = p;
  else
    dm::datasets::prepare_example_data("mesh", root.string());
  const auto pools = m::LoadPoints(root);
  const auto &fit = pools[0];
  const auto &validation = pools[1];
  const auto &test = pools[2];
  std::map<std::string, n::Tensor> original;
  for (const auto &[key, value] : n::load_npz((root / "point_clouds.npz").string()))
    original[key] = value;

  std::filesystem::create_directories("figures");
  for (int label : {1, 2, 0}) {
    const int row = label * 8;
    const auto xyz = n::select(original.at("fit_xyz"), 0, row);
    const std::string kind = label == 0 ? "chair" : label == 1 ? "sofa" : "table";
    auto a = dm::graphics::RPlot::create(), b = dm::graphics::RPlot::create();
    a.points(n::select(xyz, 1, 0).to_vector<double>(),
             n::select(xyz, 1, 1).to_vector<double>(), "all1024points", {37, 99, 235})
        .title("Original " + kind + ":XYprojection")
        .x_label("normalized source x")
        .y_label("normalized source y")
        .x_limits(-1.1, 1.1)
        .y_limits(-1.1, 1.1);
    b.points(n::select(xyz, 1, 0).to_vector<double>(),
             n::select(xyz, 1, 2).to_vector<double>(), "all1024points", {37, 99, 235})
        .title("Same original " + kind + ":XZprojection")
        .x_label("normalized source x")
        .y_label("normalized source z")
        .x_limits(-1.1, 1.1)
        .y_limits(-1.1, 1.1);
    const auto name = label == 0 ? "point_models_checks_data"
                                 : "point_models_checks_data_class" + std::to_string(label);
    auto layout = dm::graphics::RLayout::create(1, 2);
    layout.add(a).add(b).size(1100, 500).fit_panels().save_svg("build/" + name + ".svg");
    if (label != 0)
      std::filesystem::copy_file("build/" + name + ".svg", "figures/" + name + ".svg",
                                 std::filesystem::copy_options::overwrite_existing);
    std::print("Actual {}sourceID {},1024points,maxradius {:.9f};compact first256 retained.\n",
               kind, n::select(fit.source, 0, row),
               n::max(n::sqrt(n::sum(n::square(xyz.to(n::DType::Float64)), {1}))).item());
  }
  std::print(
      "Original selected class counts:{}/{}/{}.\n", n::sum(n::one_hot(fit.labels, 3), {0}),
      n::sum(n::one_hot(validation.labels, 3), {0}), n::sum(n::one_hot(test.labels, 3), {0}));
}
