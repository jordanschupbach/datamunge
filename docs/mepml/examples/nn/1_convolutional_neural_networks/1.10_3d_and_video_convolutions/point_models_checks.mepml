> PointNet permutation invariance and PointNet++selection dependence

Reverse the point order of every actual held-out compact cloud. PointNet's
shared layers/max pooling preserve logits up to floating tolerance. PointNet++
uses first-index FPS and first input-order radius hits,so its neighborhoods can
change under a permutation;do not claim the same invariance. Both remain
unchanged under repeated inference with fixed observed XYZ and moving state.
Replace one original cloud by zeros only as an explicit sensitivity control.
No labels or object identities enter either forward.
```{cpp, results="markdown", file="figures/point_models_checks_permutation.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

#include <print>
int main() {
  namespace n = dm::nn;
  namespace m = n::models;
  n::set_num_threads(2);

  std::filesystem::path cache;
  if (const auto *p = std::getenv("DATAMUNGE_DATA_DIR"))
    cache = p;
  else if (const auto *p = std::getenv("XDG_CACHE_HOME"))
    cache = std::filesystem::path(p) / "datamunge/datasets";
  else
    cache = std::filesystem::path(std::getenv("HOME")) / ".cache/datamunge/datasets";

  std::filesystem::path root = cache / "modelnet";
  if (const auto *p = std::getenv("DATAMUNGE_POINT_DIR"))
    root = p;
  else
    dm::datasets::prepare_example_data("mesh", root.string());
  const auto pools = m::LoadPoints(root);
  const auto &fit = pools[0];
  const auto &validation = pools[1];
  const auto &test = pools[2];
  std::map<std::string, n::Tensor> original;
  for (const auto &[key, value] : n::load_npz((root / "point_clouds.npz").string()))
    original[key] = value;

  auto a = dm::graphics::RPlot::create(), b = dm::graphics::RPlot::create();
  std::print("| model | maximum reverse-order logit change | repeat error | zero-cloud change "
             "| all arrays immutable |\n|---|---:|---:|---:|---|\n");
  for (bool plus : {false, true}) {
    n::ParameterStore p(971), state(977);
    const m::PointConfig c{4, 3, 256, 64, 16, 16, 32};
    auto infer = [&](const n::Tensor &xyz) {
      n::NoGradGuard guard;
      return plus ? m::PointNetPlusPlus(p, state, xyz, c).logits
                  : m::PointNet(p, state, xyz, c).logits;
    };
    const auto z = infer(test.xyz);
    const auto before = p.flatten(), moving = state.flatten();
    const auto reversed = infer(n::reverse(test.xyz, {1}));
    const auto repeat = n::max(n::abs(z - infer(test.xyz)));
    const auto change = n::max(n::abs(z - reversed), {1});
    const auto one = n::slice_axis(test.xyz, 0, 0, 1);
    const auto blank = n::sum(n::abs(infer(one) - infer(n::zeros_like(one))));
    const bool immutable = before == p.flatten() && moving == state.flatten();
    if (repeat.item() != 0 || !immutable || blank.item() <= 1e-7 ||
        (!plus && n::max(change).item() > 2e-6))
      return 1;
    std::print("| {} | {:.9g} | {:.3g} | {:.9g} | {} |\n", plus ? "PointNet++" : "PointNet",
               n::max(change).item(), repeat.item(), blank.item(), immutable);
    auto &plot = plus ? b : a;
    plot.points(n::arange(0, test.xyz.size(0)).to_vector<double>(),
                (change.to(n::DType::Float64) * (plus ? 1. : 1e9)).to_vector<double>(),
                "all12source objects", {37, 99, 235})
        .title(plus ? "PointNet++source-order sensitivity" : "PointNet permutation roundoff")
        .x_label("all original held-out object rows")
        .y_label(plus ? "maximum absolute logit change"
                      : "max absolute change times one billion");
  }
  auto layout = dm::graphics::RLayout::create(1, 2);
  layout.add(a).add(b).size(1100, 500).fit_panels().save_svg(
      "build/point_models_checks_permutation.svg");
}
```
