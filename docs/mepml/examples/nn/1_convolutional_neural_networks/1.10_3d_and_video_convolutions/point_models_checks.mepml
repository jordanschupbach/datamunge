> Both complete networks,with no training hidden in the checks

This supporting example initializes and checks graphs;it does not fit a
classifier. The subsequent PointNet and PointNet++reports show their explicit
optimizer loops. Both full40class1024point and compact threeclass256point
configurations retain every source layer. Full heads are random40column
fixtures and are not interpreted as predictions of the three selected classes.

PointNet has both3x3input and64x64feature T-Nets,shared64/64then64/128/1024
MLPs,point max and512/256classifier. PointNet++SSG has radius.2/.4FPS/ball
abstractions,shared64/64/128then128/128/256then256/512/1024global layers,
max pools and512/256classifier. Every unit is Glorotdense/bias plus source
population BN(gamma/beta,eps.001,EMA.9). Classifier training keep.7/.5dropout
follows BOTH hidden layers. Inference freezes all moving arrays.
```{cpp, results="markdown", file="figures/point_models_checks_graphs.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

#include <print>
int main() {
  namespace n = dm::nn;
  namespace m = n::models;
  n::set_num_threads(2);

  std::filesystem::path cache;
  if (const auto *p = std::getenv("DATAMUNGE_DATA_DIR"))
    cache = p;
  else if (const auto *p = std::getenv("XDG_CACHE_HOME"))
    cache = std::filesystem::path(p) / "datamunge/datasets";
  else
    cache = std::filesystem::path(std::getenv("HOME")) / ".cache/datamunge/datasets";

  std::filesystem::path root = cache / "modelnet";
  if (const auto *p = std::getenv("DATAMUNGE_POINT_DIR"))
    root = p;
  else
    dm::datasets::prepare_example_data("mesh", root.string());
  const auto pools = m::LoadPoints(root);
  const auto &fit = pools[0];
  const auto &validation = pools[1];
  const auto &test = pools[2];
  std::map<std::string, n::Tensor> original;
  for (const auto &[key, value] : n::load_npz((root / "point_clouds.npz").string()))
    original[key] = value;

  auto a = dm::graphics::RPlot::create(), b = dm::graphics::RPlot::create();
  std::print("| graph | original input points | values | learned leaves | moving leaves | "
             "global shape | head shape | finite gradients | nonzero gradients "
             "|\n|---|---:|---:|---:|---:|---|---|---:|---:|\n");
  for (bool plus : {false, true})
    for (bool compact : {false, true}) {
      const auto c = compact ? m::PointConfig{4, 3, 256, 64, 16, 16, 32} : m::PointConfig{};
      n::ParameterStore p(989), state(991);
      const auto xyz =
          n::slice_axis(n::slice_axis(original.at("fit_xyz"), 0, 0, 1), 1, 0, c.points);
      const auto out =
          plus ? m::PointNetPlusPlus(p, state, xyz, c) : m::PointNet(p, state, xyz, c);
      int finite = 0, nonzero = 0;
      for (const auto &g : n::grad(n::mean(n::square(out.logits)), p.parameters())) {
        if (!n::all(n::is_finite(g)).item<bool>())
          return 1;
        ++finite;
        nonzero += n::sum(n::square(g.to(n::DType::Float64))).item() > 0;
      }
      std::print("| {}{} | {} | {} | {} | {} | {} | {} | {} | {} |\n",
                 plus ? "PointNet++" : "PointNet", compact ? " compact" : " full", c.points,
                 p.count(), p.size(), state.size(), out.global.shape(), out.logits.shape(),
                 finite, nonzero);
      if (compact) {
        auto &plot = plus ? b : a;
        plot.lines(n::arange(0, out.global.size(1)).to_vector<double>(),
                   out.global.reshape({-1}).to_vector<double>(), "all global channels",
                   {37, 99, 235})
            .title(plus ? "Actual compact PointNet++global" : "Actual compact PointNet global")
            .x_label("all256global channels")
            .y_label("initialized max-pooled feature");
      }
    }
  auto layout = dm::graphics::RLayout::create(1, 2);
  layout.add(a).add(b).size(1100, 500).fit_panels().save_svg(
      "build/point_models_checks_graphs.svg");
}
```
