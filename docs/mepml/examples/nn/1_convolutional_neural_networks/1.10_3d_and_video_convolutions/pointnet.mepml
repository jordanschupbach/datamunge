> Both learned T-Nets and the explicit feature-transform penalty

The complete graph keeps input3x3T-Net,shared64/64,feature64x64T-Net,
shared64/128/1024,max overpoints and512/256classifier. Width/4givesfeature
transform16x16and256global channels,171836values/74learned+34moving tensors.
Full40class1024point retains3480049values and the same leaf counts. Every
shared unit is Glorotdense/bias,population BN(gamma/beta,eps.001,EMA.9),ReLU.
Classifier training useskeep.7dropout after BOTH hidden layers.

T-Net finalW/bstart0plusidentity,so both initial transforms are exactlyI.
Upstream T-Net gradients initially vanish until the transform head moves;
pre-BN biases can also have zero adjoints. The source fitting objective is mean
CE+.0005*SUM((AA^T-I)^2) on feature transforms. It sums across the minibatch,
not a per-record mean. Show the penalty directly in every optimizer update.
```{cpp, results="markdown", file="figures/pointnet_mechanism.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

#include <print>
int main() {
  namespace n = dm::nn;
  namespace m = n::models;
  n::set_num_threads(2);

  std::filesystem::path cache;
  if (const auto *p = std::getenv("DATAMUNGE_DATA_DIR"))
    cache = p;
  else if (const auto *p = std::getenv("XDG_CACHE_HOME"))
    cache = std::filesystem::path(p) / "datamunge/datasets";
  else
    cache = std::filesystem::path(std::getenv("HOME")) / ".cache/datamunge/datasets";

  std::filesystem::path root = cache / "modelnet";
  if (const auto *p = std::getenv("DATAMUNGE_POINT_DIR"))
    root = p;
  else
    dm::datasets::prepare_example_data("mesh", root.string());
  const auto pools = m::LoadPoints(root);
  const auto &fit = pools[0];
  const auto &validation = pools[1];
  const auto &test = pools[2];

  const m::PointConfig c{4, 3, 256, 64, 16, 16, 32};
  n::ParameterStore p(971), state(977);
  n::Generator dropout(971);
  {
    n::NoGradGuard guard;
    m::PointNet(p, state, n::zeros({1, 256, 3}), c);
  }
  auto predict = [&](const n::Tensor &xyz) {
    n::NoGradGuard guard;
    std::vector<n::Tensor> parts;
    for (std::int64_t start = 0; start < xyz.size(0); start += 4)
      parts.push_back(
          m::PointNet(
              p, state,
              n::slice_axis(xyz, 0, start, std::min<std::int64_t>(start + 4, xyz.size(0))), c)
              .logits);
    return n::concat(parts, 0);
  };

  const auto out = m::PointNet(p, state, n::slice_axis(fit.xyz, 0, 0, 1), c);
  const auto input = n::select(out.input_transform, 0, 0),
             feature = n::select(out.feature_transform, 0, 0);
  const auto input_error = n::max(n::abs(input - n::eye(3))),
             feature_error = n::max(n::abs(feature - n::eye(16)));
  if (input_error.item() != 0 || feature_error.item() != 0)
    return 1;
  std::print("Complete model{}values/{}learned+{}moving;input/feature identity errors "
             "{:.3g}/{:.3g},penalty {:.3g}.\n",
             p.count(), p.size(), state.size(), input_error.item(), feature_error.item(),
             m::PointTransformPenalty(out.feature_transform, 16).item());
  auto a = n::plot_tensor_map(input, 0, 1), b = n::plot_tensor_map(feature, 0, 1);
  a.title("Exact initial3x3input T-Net").x_label("matrix column").y_label("matrix row");
  b.title("Exact initial16x16feature T-Net").x_label("matrix column").y_label("matrix row");
  auto layout = dm::graphics::RLayout::create(1, 2);
  layout.add(a).add(b).size(1100, 500).fit_panels().save_svg("build/pointnet_mechanism.svg");
}
