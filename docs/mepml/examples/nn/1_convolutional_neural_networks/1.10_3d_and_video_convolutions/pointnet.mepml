> Every one of18Adam updates,with paired moving state

Warm all learned and moving leaves before tensor Adam(.001). Source seeds971/
state977,dropout971,batch-order983,batch4,three epochs over24original fitting
objects give18updates. Every fitting forward uses batch population moments
and updates moving state once. Validation inference selects learned AND moving
arrays together. No separate population calibration or test selection is hidden.
A final batch-moment/no-state-update gradient probe reports finite/nonzero
leaf counts;zeros are allowed for mathematically inactive initialized paths.
```{cpp, results="markdown", file="figures/pointnet_training.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

#include <print>
int main() {
  namespace n = dm::nn;
  namespace m = n::models;
  n::set_num_threads(2);

  std::filesystem::path cache;
  if (const auto *p = std::getenv("DATAMUNGE_DATA_DIR"))
    cache = p;
  else if (const auto *p = std::getenv("XDG_CACHE_HOME"))
    cache = std::filesystem::path(p) / "datamunge/datasets";
  else
    cache = std::filesystem::path(std::getenv("HOME")) / ".cache/datamunge/datasets";

  std::filesystem::path root = cache / "modelnet";
  if (const auto *p = std::getenv("DATAMUNGE_POINT_DIR"))
    root = p;
  else
    dm::datasets::prepare_example_data("mesh", root.string());
  const auto pools = m::LoadPoints(root);
  const auto &fit = pools[0];
  const auto &validation = pools[1];
  const auto &test = pools[2];

  const m::PointConfig c{4, 3, 256, 64, 16, 16, 32};
  n::ParameterStore p(971), state(977);
  n::Generator dropout(971);
  {
    n::NoGradGuard guard;
    m::PointNet(p, state, n::zeros({1, 256, 3}), c);
  }
  auto predict = [&](const n::Tensor &xyz) {
    n::NoGradGuard guard;
    std::vector<n::Tensor> parts;
    for (std::int64_t start = 0; start < xyz.size(0); start += 4)
      parts.push_back(
          m::PointNet(
              p, state,
              n::slice_axis(xyz, 0, start, std::min<std::int64_t>(start + 4, xyz.size(0))), c)
              .logits);
    return n::concat(parts, 0);
  };

  const auto untrained = predict(test.xyz);
  const auto initial = m::ScoreSequenceClassifier(predict(fit.xyz), fit.labels).nll;
  n::OptimizerConfig options;
  options.kind = n::OptimizerKind::Adam;
  n::Optimizer adam(p, .001, options);
  n::BatchOrder order(fit.xyz.size(0), 4, 983);
  double best = INFINITY;
  int selected = 0, updates = 0;
  std::vector<n::Tensor> history;
  std::print("| epoch | dropout fitting objective | moving-moment validation NLL "
             "|\n|---:|---:|---:|\n");
  for (int epoch = 1; epoch <= 3; ++epoch) {
    order.begin_epoch();
    auto average = n::zeros({}, n::DType::Float64);
    for (;;) {
      const auto rows = order.next();
      if (rows.empty())
        break;
      const auto d = m::PointRows(fit, rows);
      const auto out = m::PointNet(p, state, d.xyz, c, true, true, &dropout);
      const auto ce = n::sparse_softmax_cross_entropy(out.logits, d.labels);
      const auto loss = ce + m::PointTransformPenalty(out.feature_transform, 16);
      average = average + loss.detach().to(n::DType::Float64) * double(rows.size()) /
                              double(fit.xyz.size(0));
      adam.step(n::grad(loss, p.parameters()));
      ++updates;
    }
    const auto val =
        m::ScoreSequenceClassifier(predict(validation.xyz), validation.labels).nll;
    if (val.item() < best) {
      best = val.item();
      selected = epoch;
      n::NamedTensors learned, moving;
      for (std::size_t i = 0; i < p.size(); ++i)
        learned.push_back({p.names()[i], p.parameters()[i]});
      for (std::size_t i = 0; i < state.size(); ++i)
        moving.push_back({state.names()[i], state.parameters()[i]});
      n::save_npz("build/pointnet_best.npz", learned);
      n::save_npz("build/pointnet_state.npz", moving);
    }
    history.push_back(n::stack({average, val}, 0));
    std::print("| {} | {:.6f} | {:.6f} |\n", epoch, average.item(), val.item());
  }
  const auto d = m::PointRows(fit, {0, 1, 2, 3});
  const auto out = m::PointNet(p, state, d.xyz, c, true, false, &dropout);
  const auto ce = n::sparse_softmax_cross_entropy(out.logits, d.labels);
  const auto loss = ce + m::PointTransformPenalty(out.feature_transform, 16);
  int finite = 0, nonzero = 0;
  for (const auto &g : n::grad(loss, p.parameters())) {
    if (!n::all(n::is_finite(g)).item<bool>())
      return 1;
    ++finite;
    nonzero += n::sum(n::square(g.to(n::DType::Float64))).item() > 0;
  }
  for (const auto &[key, value] : n::load_npz("build/pointnet_best.npz"))
    p.set(key, value);
  for (const auto &[key, value] : n::load_npz("build/pointnet_state.npz"))
    state.set(key, value);
  const auto fitted = m::ScoreSequenceClassifier(predict(fit.xyz), fit.labels).nll;
  n::save_npz("build/pointnet_outputs.npz",
              {{"logits", predict(test.xyz)}, {"untrained", untrained}});
  std::print("{}explicitAdam updates;{}finite/{}nonzero actual learned gradients;selected "
             "epoch {},val {:.6f};fixed inference fitting NLL {:.9f}->{:.9f}.\n",
             updates, finite, nonzero, selected, best, initial.item(), fitted.item());
  const auto h = n::stack(history, 0);
  auto plot = dm::graphics::RPlot::create();
  plot.lines(n::arange(1, 4).to_vector<double>(), n::select(h, 1, 0).to_vector<double>(),
             "batch objective", {37, 99, 235})
      .lines(n::arange(1, 4).to_vector<double>(), n::select(h, 1, 1).to_vector<double>(),
             "moving val", {220, 38, 38})
      .title("PointNet:18 explicit tensor Adam updates")
      .x_label("epoch;six fitting batches each")
      .y_label("declared objective /categorical NLL");
  plot.save_svg("build/pointnet_training.svg");
}
```
