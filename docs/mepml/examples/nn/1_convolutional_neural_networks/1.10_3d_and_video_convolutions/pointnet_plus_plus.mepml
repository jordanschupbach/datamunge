> All three set abstractions and disclosed source ordering

The complete SSG graph keeps firstFPS64/radius.2/16slots shared64/64/128,
secondFPS16/radius.4/32slots shared128/128/256,global256/512/1024abstraction,
max pools and512/256classifier. Width/4 gives93907values/46learned+22moving
tensors;full40class/1024point/512then128centers uses1475688values,same leaves.
Every shared unit is Glorotdense/bias,population BN(gamma/beta,eps.001,EMA.9),
ReLU;classifierkeep.5dropout follows BOTH hidden layers. No T-Net penalty.

Numeric FPS/radius geometry uses tensors;choices are detached and coordinate/
feature gathers retain gradients. First point seeds FPS,lowest index wins
ties,and strict-radius first input-order hits fill slots,repeating the first
hit for padding. Thus source PointNet++is order dependent. Counts exclude
padding and cap at the requested slots. Show both levels on actual observed XYZ.
```{cpp, results="markdown", file="figures/pointnet_plus_plus_mechanism.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

#include <print>
int main() {
  namespace n = dm::nn;
  namespace m = n::models;
  n::set_num_threads(2);

  std::filesystem::path cache;
  if (const auto *p = std::getenv("DATAMUNGE_DATA_DIR"))
    cache = p;
  else if (const auto *p = std::getenv("XDG_CACHE_HOME"))
    cache = std::filesystem::path(p) / "datamunge/datasets";
  else
    cache = std::filesystem::path(std::getenv("HOME")) / ".cache/datamunge/datasets";

  std::filesystem::path root = cache / "modelnet";
  if (const auto *p = std::getenv("DATAMUNGE_POINT_DIR"))
    root = p;
  else
    dm::datasets::prepare_example_data("mesh", root.string());
  const auto pools = m::LoadPoints(root);
  const auto &fit = pools[0];
  const auto &validation = pools[1];
  const auto &test = pools[2];

  const m::PointConfig c{4, 3, 256, 64, 16, 16, 32};
  n::ParameterStore p(971), state(977);
  n::Generator dropout(971);
  {
    n::NoGradGuard guard;
    m::PointNetPlusPlus(p, state, n::zeros({1, 256, 3}), c);
  }
  auto predict = [&](const n::Tensor &xyz) {
    n::NoGradGuard guard;
    std::vector<n::Tensor> parts;
    for (std::int64_t start = 0; start < xyz.size(0); start += 4)
      parts.push_back(
          m::PointNetPlusPlus(
              p, state,
              n::slice_axis(xyz, 0, start, std::min<std::int64_t>(start + 4, xyz.size(0))), c)
              .logits);
    return n::concat(parts, 0);
  };

  const auto xyz = n::slice_axis(fit.xyz, 0, 0, 1);
  const auto out = m::PointNetPlusPlus(p, state, xyz, c);
  std::print("Complete model{}values/{}learned+{}moving;first/second groups {}/{},count "
             "ranges{}..{}/{}..{}.\n",
             p.count(), p.size(), state.size(), out.neighbors1.shape(), out.neighbors2.shape(),
             n::min(out.counts1), n::max(out.counts1), n::min(out.counts2),
             n::max(out.counts2));
  const auto all = n::select(xyz, 0, 0), first = n::select(out.centroids1, 0, 0),
             second = n::select(out.centroids2, 0, 0);
  auto a = dm::graphics::RPlot::create(), b = dm::graphics::RPlot::create();
  a.points(n::select(all, 1, 0).to_vector<double>(), n::select(all, 1, 2).to_vector<double>(),
           "all256input points", {148, 163, 184})
      .points(n::select(first, 1, 0).to_vector<double>(),
              n::select(first, 1, 2).to_vector<double>(), "64first centers", {37, 99, 235})
      .title("Actual first set-abstraction centers")
      .x_label("normalized source x")
      .y_label("normalized source z");
  b.points(n::select(first, 1, 0).to_vector<double>(),
           n::select(first, 1, 2).to_vector<double>(), "64first centers", {148, 163, 184})
      .points(n::select(second, 1, 0).to_vector<double>(),
              n::select(second, 1, 2).to_vector<double>(), "16second centers", {220, 38, 38})
      .title("Actual second set-abstraction centers")
      .x_label("normalized source x")
      .y_label("normalized source z");
  auto layout = dm::graphics::RLayout::create(1, 2);
  layout.add(a).add(b).size(1100, 500).fit_panels().save_svg(
      "build/pointnet_plus_plus_mechanism.svg");
}
