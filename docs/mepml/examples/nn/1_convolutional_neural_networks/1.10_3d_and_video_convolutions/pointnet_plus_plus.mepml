> Independent XYZ-only restore and every held-out object

Restore a fresh learned/moving pair with no optimizer,labels or source IDs in
forward. Check saved/repeated inference,single/batch tolerance2e-6 and every
array unchanged. Reverse point order for every original held-out cloud and
substitute zeros for one cloud only as a declared sensitivity control. Report
all12original source IDs,true classes,predictions and complete confusion.
The balanced tie0reference has no learned parameters or hidden fitting.
Source PointNet++first-seed/input-order grouping remains order dependent;the reverse-order difference is reported rather than asserted zero.
```{cpp, results="markdown", file="figures/pointnet_plus_plus_confusion.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

#include <print>
int main() {
  namespace n = dm::nn;
  namespace m = n::models;
  n::set_num_threads(2);

  std::filesystem::path cache;
  if (const auto *p = std::getenv("DATAMUNGE_DATA_DIR"))
    cache = p;
  else if (const auto *p = std::getenv("XDG_CACHE_HOME"))
    cache = std::filesystem::path(p) / "datamunge/datasets";
  else
    cache = std::filesystem::path(std::getenv("HOME")) / ".cache/datamunge/datasets";

  std::filesystem::path root = cache / "modelnet";
  if (const auto *p = std::getenv("DATAMUNGE_POINT_DIR"))
    root = p;
  else
    dm::datasets::prepare_example_data("mesh", root.string());
  const auto pools = m::LoadPoints(root);
  const auto &fit = pools[0];
  const auto &validation = pools[1];
  const auto &test = pools[2];

  const m::PointConfig c{4, 3, 256, 64, 16, 16, 32};
  n::ParameterStore p(971), state(977);
  n::Generator dropout(971);
  {
    n::NoGradGuard guard;
    m::PointNetPlusPlus(p, state, n::zeros({1, 256, 3}), c);
  }
  auto predict = [&](const n::Tensor &xyz) {
    n::NoGradGuard guard;
    std::vector<n::Tensor> parts;
    for (std::int64_t start = 0; start < xyz.size(0); start += 4)
      parts.push_back(
          m::PointNetPlusPlus(
              p, state,
              n::slice_axis(xyz, 0, start, std::min<std::int64_t>(start + 4, xyz.size(0))), c)
              .logits);
    return n::concat(parts, 0);
  };

  for (const auto &[key, value] : n::load_npz("build/pointnet_plus_plus_best.npz"))
    p.set(key, value.clone());
  for (const auto &[key, value] : n::load_npz("build/pointnet_plus_plus_state.npz"))
    state.set(key, value.clone());
  std::vector<n::Tensor> learned_before, moving_before;
  for (const auto &v : p.parameters())
    learned_before.push_back(v.clone());
  for (const auto &v : state.parameters())
    moving_before.push_back(v.clone());
  n::Tensor saved, untrained;
  for (const auto &[key, value] : n::load_npz("build/pointnet_plus_plus_outputs.npz")) {
    if (key == "logits")
      saved = value;
    else
      untrained = value;
  }
  const auto z = predict(test.xyz);
  const auto parity =
      n::maximum(n::max(n::abs(z - saved)), n::max(n::abs(z - predict(test.xyz))));
  const auto single =
      n::max(n::abs(predict(n::slice_axis(test.xyz, 0, 0, 1)) - n::slice_axis(z, 0, 0, 1)));
  const auto reversed = predict(n::reverse(test.xyz, {1}));
  const auto reverse_error = n::max(n::abs(z - reversed));
  const auto one = n::slice_axis(test.xyz, 0, 0, 1);
  const auto zero_change = n::sum(n::abs(predict(one) - predict(n::zeros_like(one))));
  bool immutable = true;
  for (std::size_t i = 0; i < learned_before.size(); ++i)
    immutable =
        immutable && n::all(n::equal(learned_before[i], p.parameters()[i])).item<bool>();
  for (std::size_t i = 0; i < moving_before.size(); ++i)
    immutable =
        immutable && n::all(n::equal(moving_before[i], state.parameters()[i])).item<bool>();
  if (parity.item() > 1e-6 || single.item() > 2e-6 || zero_change.item() <= 1e-7 || !immutable)
    return 1;
  std::print(
      "XYZ-only restore/repeat {:.3g};single/batch {:.9g} within2e-6;all{}/{}learned/moving "
      "immutable:{};reverse max {:.9g};zero-cloud change {:.9g}.\n",
      parity.item(), single.item(), p.size(), state.size(), immutable, reverse_error.item(),
      zero_change.item());
  std::vector<n::Tensor> accuracy, nll;
  std::print("\n| predictor | accuracy | macroF1 | NLL | all class recalls | complete "
             "true-row confusion |\n|---|---:|---:|---:|---|---|\n");
  for (const auto &item :
       std::vector<std::pair<std::string, n::Tensor>>{{"learned", z},
                                                      {"untrained", untrained},
                                                      {"tie0", n::zeros_like(z)},
                                                      {"reversed-point control", reversed}}) {
    const auto score = m::ScoreSensor(item.second, test.labels, 3);
    std::print("| {} | {:.6f} | {:.6f} | {:.6f} | {} | {} |\n", item.first, score.accuracy,
               score.macro_f1, score.nll, n::from_vector(score.recall),
               n::from_vector(score.confusion, {3, 3}));
    const auto base = m::ScoreSequenceClassifier(item.second, test.labels);
    accuracy.push_back(base.accuracy);
    nll.push_back(base.nll);
  }
  const auto source = test.source.to_vector<int>(), truth = test.labels.to_vector<int>(),
             predicted = n::argmax(z, 1).to_vector<int>();
  std::print("\n| original OFF source ID | true class0chair/1sofa/2table | learned class "
             "|\n|---:|---:|---:|\n");
  for (int row = 0; row < 12; ++row)
    std::print("| {} | {} | {} |\n", source[row], truth[row], predicted[row]);
  auto a = dm::graphics::RPlot::create(), b = dm::graphics::RPlot::create();
  a.points(n::arange(0, 4).to_vector<double>(), n::stack(accuracy, 0).to_vector<double>(),
           "accuracy", {37, 99, 235})
      .title("Every original held-out object accuracy")
      .x_label("0learned/1initial/2tie0/3reversed")
      .y_label("correct fraction of12source meshes")
      .y_limits(0, 1.1);
  b.points(n::arange(0, 4).to_vector<double>(), n::stack(nll, 0).to_vector<double>(), "NLL",
           {220, 38, 38})
      .title("All12held-out object likelihoods")
      .x_label("same four predictor/control ordinals")
      .y_label("ordinary categorical NLL")
      .y_limits(0, 1.5);
  auto metrics = dm::graphics::RLayout::create(1, 2);
  metrics.add(a).add(b).size(1100, 500).fit_panels().save_svg(
      "build/pointnet_plus_plus_metrics.svg");
  std::filesystem::create_directories("figures");
  std::filesystem::copy_file("build/pointnet_plus_plus_metrics.svg",
                             "figures/pointnet_plus_plus_metrics.svg",
                             std::filesystem::copy_options::overwrite_existing);
  a = n::plot_tensor_map(
      n::reverse(m::ScoreSequenceClassifier(z, test.labels).confusion.to(n::DType::Float64),
                 {0}),
      0, 4);
  b = n::plot_tensor_map(
      n::reverse(
          m::ScoreSequenceClassifier(untrained, test.labels).confusion.to(n::DType::Float64),
          {0}),
      0, 4);
  a.title("Learned complete object confusion")
      .x_label("predicted chair0/sofa1/table2")
      .y_label("true chair0 at bottom");
  b.title("Untrained complete object confusion")
      .x_label("predicted chair0/sofa1/table2")
      .y_label("true chair0 at bottom");
  auto confusion = dm::graphics::RLayout::create(1, 2);
  confusion.add(a).add(b).size(1100, 500).fit_panels().save_svg(
      "build/pointnet_plus_plus_confusion.svg");
}
