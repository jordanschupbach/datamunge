```{cpp, results="markdown", file="figures/pointnet_plus_plus_data.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

#include <print>
int main() {
  namespace n = dm::nn;
  namespace m = n::models;
  n::set_num_threads(2);

  std::filesystem::path cache;
  if (const auto *p = std::getenv("DATAMUNGE_DATA_DIR"))
    cache = p;
  else if (const auto *p = std::getenv("XDG_CACHE_HOME"))
    cache = std::filesystem::path(p) / "datamunge/datasets";
  else
    cache = std::filesystem::path(std::getenv("HOME")) / ".cache/datamunge/datasets";

  std::filesystem::path root = cache / "modelnet";
  if (const auto *p = std::getenv("DATAMUNGE_POINT_DIR"))
    root = p;
  else
    dm::datasets::prepare_example_data("mesh", root.string());
  const auto pools = m::LoadPoints(root);
  const auto &fit = pools[0];
  const auto &validation = pools[1];
  const auto &test = pools[2];

  std::filesystem::create_directories("figures");
  for (int label : {1, 2, 0}) {
    const int row = label * 8;
    const auto xyz = n::select(fit.xyz, 0, row);
    const std::string kind = label == 0 ? "chair" : label == 1 ? "sofa" : "table";
    auto a = dm::graphics::RPlot::create(), b = dm::graphics::RPlot::create();
    a.points(n::select(xyz, 1, 0).to_vector<double>(),
             n::select(xyz, 1, 1).to_vector<double>(), "all256observed points", {37, 99, 235})
        .title("Observed " + kind + ":XY")
        .x_label("normalized source x")
        .y_label("normalized source y")
        .x_limits(-1.1, 1.1)
        .y_limits(-1.1, 1.1);
    b.points(n::select(xyz, 1, 0).to_vector<double>(),
             n::select(xyz, 1, 2).to_vector<double>(), "all256observed points", {37, 99, 235})
        .title("Same original " + kind + ":XZ")
        .x_label("normalized source x")
        .y_label("normalized source z")
        .x_limits(-1.1, 1.1)
        .y_limits(-1.1, 1.1);
    const auto name = label == 0 ? "pointnet_plus_plus_data"
                                 : "pointnet_plus_plus_data_class" + std::to_string(label);
    auto layout = dm::graphics::RLayout::create(1, 2);
    layout.add(a).add(b).size(1100, 500).fit_panels().save_svg("build/" + name + ".svg");
    if (label != 0)
      std::filesystem::copy_file("build/" + name + ".svg", "figures/" + name + ".svg",
                                 std::filesystem::copy_options::overwrite_existing);
    std::print("Original {}sourceID {},all256observed points,maximum norm {:.9f}.\n", kind,
               n::select(fit.source, 0, row),
               n::max(n::sqrt(n::sum(n::square(xyz.to(n::DType::Float64)), {1}))).item());
  }
}
