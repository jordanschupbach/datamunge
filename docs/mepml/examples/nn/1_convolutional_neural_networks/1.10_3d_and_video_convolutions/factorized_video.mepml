> Independent paired restoration and every held-out/control result

A fresh learned/moving pair restores each selected checkpoint. Inference takes
only RGB,checks every learned/moving array unchanged,saved/repeated logits and
single/batch parity. Reverse order and repeat-first-frame controls change
observations only. Static/motion1NN memories have no learned leaves and stay
unchanged;all reference numerical computations use tensors as in C3D.

Print every held-out confusion and all six predictions for both models.
A log10NLL plot includes the very large uncalibrated P3D initialization rather
than clipping it;the table retains ordinary NLL values. Both learned models
remain below the motion reference in held-out accuracy on this tiny split.
```{cpp, results="markdown", file="figures/factorized_video_confusion.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

#include <print>
int main() {
  namespace n = dm::nn;
  namespace m = n::models;
  n::set_num_threads(2);

  std::filesystem::path cache;
  if (const auto *p = std::getenv("DATAMUNGE_DATA_DIR"))
    cache = p;
  else if (const auto *p = std::getenv("XDG_CACHE_HOME"))
    cache = std::filesystem::path(p) / "datamunge/datasets";
  else
    cache = std::filesystem::path(std::getenv("HOME")) / ".cache/datamunge/datasets";

  std::filesystem::path root = cache / "action_video";
  if (const auto *p = std::getenv("DATAMUNGE_VIDEO_DIR"))
    root = p;
  else
    dm::datasets::prepare_example_data("video", root.string());
  const auto pools = m::LoadVideo(root);
  const auto &fit = pools[0];
  const auto &validation = pools[1];
  const auto &test = pools[2];

  auto a = dm::graphics::RPlot::create(), b = dm::graphics::RPlot::create();
  std::vector<n::Tensor> confusions;
  for (bool p3d : {false, true}) {

    const m::FactorVideoConfig c{p3d, 4, 3};
    const std::string name = p3d ? "P3D-199" : "R(2+1)D-18";
    const std::string prefix =
        p3d ? "build/factorized_video_p3d" : "build/factorized_video_r2";
    n::ParameterStore p(727), state(729);
    n::Generator dropout(719);
    {
      n::NoGradGuard guard;
      m::FactorVideo(p, state, n::zeros({1, 16, 32, 32, 3}), c);
    }
    auto predict = [&](const n::Tensor &rgb) {
      n::NoGradGuard guard;
      std::vector<n::Tensor> parts;
      for (std::int64_t start = 0; start < rgb.size(0); start += 2)
        parts.push_back(
            m::FactorVideo(
                p, state,
                n::slice_axis(rgb, 0, start, std::min<std::int64_t>(start + 2, rgb.size(0))),
                c)
                .logits);
      return n::concat(parts, 0);
    };

    for (const auto &[key, value] : n::load_npz(prefix + "_best.npz"))
      p.set(key, value.clone());
    for (const auto &[key, value] : n::load_npz(prefix + "_state.npz"))
      state.set(key, value.clone());
    std::vector<n::Tensor> learned_before, moving_before;
    for (const auto &v : p.parameters())
      learned_before.push_back(v.clone());
    for (const auto &v : state.parameters())
      moving_before.push_back(v.clone());
    n::Tensor saved, untrained;
    for (const auto &[key, value] : n::load_npz(prefix + "_outputs.npz")) {
      if (key == "logits")
        saved = value;
      else
        untrained = value;
    }
    const auto z = predict(test.rgb);
    const auto parity =
        n::maximum(n::max(n::abs(z - saved)), n::max(n::abs(z - predict(test.rgb))));
    const auto single =
        n::max(n::abs(predict(n::slice_axis(test.rgb, 0, 0, 1)) - n::slice_axis(z, 0, 0, 1)));
    const auto reversed = predict(n::reverse(test.rgb, {1}).contiguous());
    const auto still = predict(n::tile(n::slice_axis(test.rgb, 1, 0, 1), {1, 16, 1, 1, 1}));
    const auto order =
                   n::sum(n::abs(z.to(n::DType::Float64) - reversed.to(n::DType::Float64))),
               motion = n::sum(n::abs(z.to(n::DType::Float64) - still.to(n::DType::Float64)));
    bool immutable = true;
    for (std::size_t i = 0; i < learned_before.size(); ++i)
      immutable =
          immutable && n::all(n::equal(learned_before[i], p.parameters()[i])).item<bool>();
    for (std::size_t i = 0; i < moving_before.size(); ++i)
      immutable =
          immutable && n::all(n::equal(moving_before[i], state.parameters()[i])).item<bool>();
    if (parity.item() > 1e-6 || single.item() > 1e-6 || order.item() <= 1e-7 ||
        motion.item() <= 1e-7 || !immutable)
      return 1;
    std::print(
        "{}:RGB-only restore/repeat {:.3g};single/batch {:.9g} within1e-6;{}/{}learned/moving "
        "leaves immutable:{};reverse/repeat changes {:.9f}/{:.9f}.\n",
        name, parity.item(), single.item(), p.size(), state.size(), immutable, order.item(),
        motion.item());
    std::vector<n::Tensor> accuracy, nll;
    std::print("\n| {} predictor | accuracy | macroF1 | ordinary NLL | all recalls | complete "
               "true-row confusion |\n|---|---:|---:|---:|---|---|\n",
               name);
    for (const auto &item : std::vector<std::pair<std::string, n::Tensor>>{
             {"learned", z},
             {"untrained", untrained},
             {"static1NN", m::VideoNearest(fit, test, false)},
             {"motion1NN", m::VideoNearest(fit, test, true)},
             {"tie0", n::zeros_like(z)},
             {"reverse control", reversed},
             {"still control", still}}) {
      const auto score = m::ScoreSensor(item.second, test.labels, 3);
      std::print("| {} | {:.6f} | {:.6f} | {:.6f} | {} | {} |\n", item.first, score.accuracy,
                 score.macro_f1, score.nll, n::from_vector(score.recall),
                 n::from_vector(score.confusion, {3, 3}));
      const auto base = m::ScoreSequenceClassifier(item.second, test.labels);
      accuracy.push_back(base.accuracy);
      nll.push_back(base.nll);
    }
    const auto predicted = n::argmax(z, 1).to_vector<int>(),
               truth = test.labels.to_vector<int>();
    std::print("\n| {} held-out row | true | predicted |\n|---:|---:|---:|\n", name);
    for (int row = 0; row < 6; ++row)
      std::print("| {} | {} | {} |\n", row, truth[row], predicted[row]);
    const dm::graphics::RGB color =
        p3d ? dm::graphics::RGB{220, 38, 38} : dm::graphics::RGB{37, 99, 235};
    a.points(n::arange(0, 7).to_vector<double>(), n::stack(accuracy, 0).to_vector<double>(),
             p3d ? "P3D" : "R2", color);
    b.points(n::arange(0, 7).to_vector<double>(),
             (n::log(n::stack(nll, 0)) / std::log(10.)).to_vector<double>(),
             p3d ? "P3D" : "R2", color);
    confusions.push_back(
        m::ScoreSequenceClassifier(z, test.labels).confusion.to(n::DType::Float64));
  }
  a.title("Complete held-out clip accuracy")
      .x_label("0learned/1initial/2static/3motion/4tie/5rev/6still")
      .y_label("correct fraction of six clips")
      .y_limits(0, 1.1);
  b.title("All NLLs,including deep initialization")
      .x_label("same seven predictor ordinals")
      .y_label("log10 of ordinary mean NLL");
  auto metrics = dm::graphics::RLayout::create(1, 2);
  metrics.add(a).add(b).size(1100, 500).fit_panels().save_svg(
      "build/factorized_video_metrics.svg");
  std::filesystem::create_directories("figures");
  std::filesystem::copy_file("build/factorized_video_metrics.svg",
                             "figures/factorized_video_metrics.svg",
                             std::filesystem::copy_options::overwrite_existing);
  a = n::plot_tensor_map(n::reverse(confusions[0], {0}), 0, 2);
  b = n::plot_tensor_map(n::reverse(confusions[1], {0}), 0, 2);
  a.title("R(2+1)D complete held-out confusion")
      .x_label("predicted action0/1/2")
      .y_label("true boxing0 at bottom");
  b.title("P3D complete held-out confusion")
      .x_label("predicted action0/1/2")
      .y_label("true boxing0 at bottom");
  auto confusion = dm::graphics::RLayout::create(1, 2);
  confusion.add(a).add(b).size(1100, 500).fit_panels().save_svg(
      "build/factorized_video_confusion.svg");
}
