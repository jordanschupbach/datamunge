> Two visible Adam loops and paired validation checkpoints

For each complete compact model,warm all learned AND moving leaves before
constructing tensor Adam(.001). Use source seeds727/729,dropout719 and order647.
An explicit first-two-clip batch-moment/no-state-update derivative probe
advances the P3D dropout generator and checks every learned gradient. Train
batch2 over24clips for three epochs:36updates/model,72total. Every fitting
forward updates BN moving moments once. Validation inference selects a paired
learned/moving checkpoint. No test metric enters the selection.
```{cpp, results="markdown", file="figures/factorized_video_training.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

#include <print>
int main() {
  namespace n = dm::nn;
  namespace m = n::models;
  n::set_num_threads(2);

  std::filesystem::path cache;
  if (const auto *p = std::getenv("DATAMUNGE_DATA_DIR"))
    cache = p;
  else if (const auto *p = std::getenv("XDG_CACHE_HOME"))
    cache = std::filesystem::path(p) / "datamunge/datasets";
  else
    cache = std::filesystem::path(std::getenv("HOME")) / ".cache/datamunge/datasets";

  std::filesystem::path root = cache / "action_video";
  if (const auto *p = std::getenv("DATAMUNGE_VIDEO_DIR"))
    root = p;
  else
    dm::datasets::prepare_example_data("video", root.string());
  const auto pools = m::LoadVideo(root);
  const auto &fit = pools[0];
  const auto &validation = pools[1];
  const auto &test = pools[2];

  auto a = dm::graphics::RPlot::create(), b = dm::graphics::RPlot::create();
  for (bool p3d : {false, true}) {

    const m::FactorVideoConfig c{p3d, 4, 3};
    const std::string name = p3d ? "P3D-199" : "R(2+1)D-18";
    const std::string prefix =
        p3d ? "build/factorized_video_p3d" : "build/factorized_video_r2";
    n::ParameterStore p(727), state(729);
    n::Generator dropout(719);
    {
      n::NoGradGuard guard;
      m::FactorVideo(p, state, n::zeros({1, 16, 32, 32, 3}), c);
    }
    auto predict = [&](const n::Tensor &rgb) {
      n::NoGradGuard guard;
      std::vector<n::Tensor> parts;
      for (std::int64_t start = 0; start < rgb.size(0); start += 2)
        parts.push_back(
            m::FactorVideo(
                p, state,
                n::slice_axis(rgb, 0, start, std::min<std::int64_t>(start + 2, rgb.size(0))),
                c)
                .logits);
      return n::concat(parts, 0);
    };

    const auto initial = m::ScoreSequenceClassifier(predict(fit.rgb), fit.labels).nll;
    const auto untrained = predict(test.rgb);
    const auto probe = m::VideoRows(fit, {0, 1});
    const auto checked = m::FactorVideo(p, state, probe.rgb, c, true, false, &dropout);
    for (const auto &g : n::grad(n::sparse_softmax_cross_entropy(checked.logits, probe.labels),
                                 p.parameters()))
      if (!n::all(n::is_finite(g)).item<bool>() || n::sum(n::square(g)).item() <= 0)
        return 1;
    n::OptimizerConfig options;
    options.kind = n::OptimizerKind::Adam;
    n::Optimizer adam(p, .001, options);
    n::BatchOrder order(fit.size(), 2, 647);
    double best = INFINITY;
    int selected = 0, updates = 0;
    std::vector<n::Tensor> history;
    std::print("\n| {} epoch | batch-moment fitting CE | moving-moment validation NLL "
               "|\n|---:|---:|---:|\n",
               name);
    for (int epoch = 1; epoch <= 3; ++epoch) {
      order.begin_epoch();
      auto average = n::zeros({}, n::DType::Float64);
      for (;;) {
        const auto rows = order.next();
        if (rows.empty())
          break;
        const auto d = m::VideoRows(fit, rows);
        const auto out = m::FactorVideo(p, state, d.rgb, c, true, true, &dropout);
        const auto loss = n::sparse_softmax_cross_entropy(out.logits, d.labels);
        average = average + loss.detach().to(n::DType::Float64) * double(rows.size()) /
                                double(fit.size());
        adam.step(n::grad(loss, p.parameters()));
        ++updates;
      }
      const auto val =
          m::ScoreSequenceClassifier(predict(validation.rgb), validation.labels).nll;
      if (val.item() < best) {
        best = val.item();
        selected = epoch;
        n::NamedTensors learned, moving;
        for (std::size_t i = 0; i < p.size(); ++i)
          learned.push_back({p.names()[i], p.parameters()[i]});
        for (std::size_t i = 0; i < state.size(); ++i)
          moving.push_back({state.names()[i], state.parameters()[i]});
        n::save_npz(prefix + "_best.npz", learned);
        n::save_npz(prefix + "_state.npz", moving);
      }
      history.push_back(n::stack({average, val}, 0));
      std::print("| {} | {:.6f} | {:.6f} |\n", epoch, average.item(), val.item());
    }
    for (const auto &[key, value] : n::load_npz(prefix + "_best.npz"))
      p.set(key, value);
    for (const auto &[key, value] : n::load_npz(prefix + "_state.npz"))
      state.set(key, value);
    const auto fitted = m::ScoreSequenceClassifier(predict(fit.rgb), fit.labels).nll;
    n::save_npz(prefix + "_outputs.npz",
                {{"logits", predict(test.rgb)}, {"untrained", untrained}});
    std::print("{}:{} explicit Adam updates;selected epoch {},val {:.6f};fixed inference "
               "fitting NLL {:.6f}->{:.6f}.\n",
               name, updates, selected, best, initial.item(), fitted.item());
    const auto h = n::stack(history, 0);
    auto &plot = p3d ? b : a;
    plot.lines(n::arange(1, 4).to_vector<double>(), n::select(h, 1, 0).to_vector<double>(),
               "batch fit", {37, 99, 235})
        .lines(n::arange(1, 4).to_vector<double>(), n::select(h, 1, 1).to_vector<double>(),
               "moving val", {220, 38, 38})
        .title(p3d ? "P3D:36 explicit Adam updates" : "R(2+1)D:36 explicit Adam updates")
        .x_label("epoch;twelve batches each")
        .y_label("categorical CE/NLL");
  }
  auto layout = dm::graphics::RLayout::create(1, 2);
  layout.add(a).add(b).size(1100, 500).fit_panels().save_svg(
      "build/factorized_video_training.svg");
}
```
