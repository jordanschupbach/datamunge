> Full-depth networks and every residual endpoint

R(2+1)D-18 retains a spatial7/temporal3 stem and2/2/2/2 basic blocks.
P3D-199 retains3/8/36/3 bottleneck blocks,cyclesA/B/C through the first three
stages,and uses the released final spatial-only stage. Temporal pooling
between P3D stages and the source ceil stem pool remain intact. Width scaling
does not shorten either graph. All units use bias-free fan-out Kaiming-normal
convolution and BN;head weights N(0,.01),bias0. Input RGB scales to[-1,1].

The full networks have31505325/66492240learned values and113/608leaves,
plus74/404moving tensors. Actual compact base4/classes3 has123457/267567values
with the same leaf/state/block counts. Native tests execute BOTH full graphs
at reference16x112x112/16x160x160,all endpoints and every learned derivative.
Below every initialized residual endpoint uses an actual fitting clip at32px.
```{cpp, results="markdown", file="figures/factorized_video_features.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

#include <print>
int main() {
  namespace n = dm::nn;
  namespace m = n::models;
  n::set_num_threads(2);

  std::filesystem::path cache;
  if (const auto *p = std::getenv("DATAMUNGE_DATA_DIR"))
    cache = p;
  else if (const auto *p = std::getenv("XDG_CACHE_HOME"))
    cache = std::filesystem::path(p) / "datamunge/datasets";
  else
    cache = std::filesystem::path(std::getenv("HOME")) / ".cache/datamunge/datasets";

  std::filesystem::path root = cache / "action_video";
  if (const auto *p = std::getenv("DATAMUNGE_VIDEO_DIR"))
    root = p;
  else
    dm::datasets::prepare_example_data("video", root.string());
  const auto pools = m::LoadVideo(root);
  const auto &fit = pools[0];
  const auto &validation = pools[1];
  const auto &test = pools[2];

  auto a = dm::graphics::RPlot::create(), b = dm::graphics::RPlot::create();
  for (bool p3d : {false, true}) {
    n::ParameterStore p(727), s(729);
    n::NoGradGuard guard;
    const auto out = m::FactorVideo(p, s, n::slice_axis(fit.rgb, 0, 0, 1), {p3d, 4, 3});
    std::vector<n::Tensor> values;
    std::print("\n| {} endpoint | actual shape |\n|---:|---|\n", p3d ? "P3D" : "R2");
    for (std::size_t i = 0; i < out.stages.size(); ++i) {
      std::print("| {} | {} |\n", i, out.stages[i].shape());
      values.push_back(n::mean(n::abs(out.stages[i]).to(n::DType::Float64)));
    }
    std::print("{} values/{} learned leaves/{} moving leaves,pooled {}.\n", p.count(),
               p.size(), s.size(), out.pooled.shape());
    auto &plot = p3d ? b : a;
    plot.lines(n::arange(0, double(out.stages.size())).to_vector<double>(),
               n::stack(values, 0).to_vector<double>(), "every endpoint", {37, 99, 235})
        .title(p3d ? "All51 initialized P3D endpoints" : "All9 initialized R(2+1)D endpoints")
        .x_label("stem0,then every residual block")
        .y_label("actual mean absolute activation");
  }
  auto layout = dm::graphics::RLayout::create(1, 2);
  layout.add(a).add(b).size(1100, 500).fit_panels().save_svg(
      "build/factorized_video_features.svg");
}
