> Batch moments,moving state and paired checkpoint semantics

Each BN uses eps1e-5,momentum.9,gamma1/beta0 and initial moving mean0/variance1.
Training normalizes with population variance;the library fused-BN moving
variance uses its unbiased sample correction. An independent four-value
fixture checks moving mean.25/variance1.0666667 and every normalized output.
Inference uses moving moments without mutation. Training uses batch moments;
update_stats=false leaves moving arrays unchanged,while true updates them.
No separate population calibration is hidden here. P3D training additionally
uses keep.5head dropout with an explicit generator. The same source policy
is used in both the original workflow and the visible fit below.

For a single real fitting minibatch,check every moving leaf in both modes.
This demonstrates mutation policy,not a useful fit. Validation must use the
moving arrays belonging to its matching learned checkpoint. Initial deep
P3D inference can have extremely large NLL before moving moments adapt;
its later NLL change combines learning and state adaptation.
```{cpp, results="markdown", file="figures/factorized_video_state.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

#include <print>
int main() {
  namespace n = dm::nn;
  namespace m = n::models;
  n::set_num_threads(2);

  std::filesystem::path cache;
  if (const auto *p = std::getenv("DATAMUNGE_DATA_DIR"))
    cache = p;
  else if (const auto *p = std::getenv("XDG_CACHE_HOME"))
    cache = std::filesystem::path(p) / "datamunge/datasets";
  else
    cache = std::filesystem::path(std::getenv("HOME")) / ".cache/datamunge/datasets";

  std::filesystem::path root = cache / "action_video";
  if (const auto *p = std::getenv("DATAMUNGE_VIDEO_DIR"))
    root = p;
  else
    dm::datasets::prepare_example_data("video", root.string());
  const auto pools = m::LoadVideo(root);
  const auto &fit = pools[0];
  const auto &validation = pools[1];
  const auto &test = pools[2];

  std::vector<n::Tensor> changes;
  std::print("| model | no-update moving change | update moving change | repeated inference "
             "error |\n|---|---:|---:|---:|\n");
  for (bool p3d : {false, true}) {

    const m::FactorVideoConfig c{p3d, 4, 3};
    const std::string name = p3d ? "P3D-199" : "R(2+1)D-18";
    const std::string prefix =
        p3d ? "build/factorized_video_p3d" : "build/factorized_video_r2";
    n::ParameterStore p(727), state(729);
    n::Generator dropout(719);
    {
      n::NoGradGuard guard;
      m::FactorVideo(p, state, n::zeros({1, 16, 32, 32, 3}), c);
    }
    auto predict = [&](const n::Tensor &rgb) {
      n::NoGradGuard guard;
      std::vector<n::Tensor> parts;
      for (std::int64_t start = 0; start < rgb.size(0); start += 2)
        parts.push_back(
            m::FactorVideo(
                p, state,
                n::slice_axis(rgb, 0, start, std::min<std::int64_t>(start + 2, rgb.size(0))),
                c)
                .logits);
      return n::concat(parts, 0);
    };

    std::vector<n::Tensor> before;
    for (const auto &v : state.parameters())
      before.push_back(v.clone());
    n::NoGradGuard guard;
    m::FactorVideo(p, state, n::slice_axis(fit.rgb, 0, 0, 2), c, true, false, &dropout);
    auto unchanged = n::zeros({}, n::DType::Float64);
    for (std::size_t i = 0; i < before.size(); ++i)
      unchanged = unchanged + n::sum(n::abs(before[i].to(n::DType::Float64) -
                                            state.parameters()[i].to(n::DType::Float64)));
    m::FactorVideo(p, state, n::slice_axis(fit.rgb, 0, 0, 2), c, true, true, &dropout);
    auto moved = n::zeros({}, n::DType::Float64);
    for (std::size_t i = 0; i < before.size(); ++i)
      moved = moved + n::sum(n::abs(before[i].to(n::DType::Float64) -
                                    state.parameters()[i].to(n::DType::Float64)));
    const auto repeated = n::max(n::abs(predict(n::slice_axis(fit.rgb, 0, 0, 2)) -
                                        predict(n::slice_axis(fit.rgb, 0, 0, 2))));
    if (unchanged.item() != 0 || moved.item() <= 0 || repeated.item() != 0)
      return 1;
    std::print("| {} | {:.3g} | {:.6f} | {:.3g} |\n", name, unchanged.item(), moved.item(),
               repeated.item());
    changes.push_back(moved);
  }
  auto plot = dm::graphics::RPlot::create();
  plot.points(n::arange(0, 2).to_vector<double>(), n::stack(changes, 0).to_vector<double>(),
              "all moving leaves", {147, 51, 234})
      .title("Explicit fitting-batch BN state changes")
      .x_label("0R(2+1)D /1P3D")
      .y_label("sum absolute moving-array change");
  plot.save_svg("build/factorized_video_state.svg");
}
