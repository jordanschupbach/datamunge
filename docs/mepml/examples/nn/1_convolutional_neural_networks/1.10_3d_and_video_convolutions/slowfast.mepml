> Every explicit Adam update and paired checkpoint

Warm332learned/220moving arrays before Adam(.001),seeds751/753,dropout743,
order647. The visible first-two-clip gradient probe consumes dropout but does
not update moving moments. Fit three epochs,batch2,36updates;each fitting
forward updates moving moments once. Select learned and moving arrays together
by validation NLL,then restore both before fixed fitting and held-out inference.
```{cpp, results="markdown", file="figures/slowfast_training.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

#include <print>
int main() {
  namespace n = dm::nn;
  namespace m = n::models;
  n::set_num_threads(2);

  std::filesystem::path cache;
  if (const auto *p = std::getenv("DATAMUNGE_DATA_DIR"))
    cache = p;
  else if (const auto *p = std::getenv("XDG_CACHE_HOME"))
    cache = std::filesystem::path(p) / "datamunge/datasets";
  else
    cache = std::filesystem::path(std::getenv("HOME")) / ".cache/datamunge/datasets";

  std::filesystem::path root = cache / "action_video";
  if (const auto *p = std::getenv("DATAMUNGE_VIDEO_DIR"))
    root = p;
  else
    dm::datasets::prepare_example_data("video", root.string());
  const auto pools = m::LoadVideo(root);
  const auto &fit = pools[0];
  const auto &validation = pools[1];
  const auto &test = pools[2];

  const m::SlowFastConfig c{8, 3, 16};
  n::ParameterStore p(751), state(753);
  n::Generator dropout(743);
  {
    n::NoGradGuard guard;
    m::SlowFast(p, state, n::zeros({1, 16, 32, 32, 3}), c);
  }
  auto predict = [&](const n::Tensor &rgb) {
    n::NoGradGuard guard;
    std::vector<n::Tensor> parts;
    for (std::int64_t start = 0; start < rgb.size(0); start += 2)
      parts.push_back(
          m::SlowFast(
              p, state,
              n::slice_axis(rgb, 0, start, std::min<std::int64_t>(start + 2, rgb.size(0))), c)
              .logits);
    return n::concat(parts, 0);
  };
  const auto initial = m::ScoreSequenceClassifier(predict(fit.rgb), fit.labels).nll;
  const auto untrained = predict(test.rgb);
  const auto probe = m::VideoRows(fit, {0, 1});
  const auto checked = m::SlowFast(p, state, probe.rgb, c, true, false, &dropout);
  int blocked = 0;
  const auto gs =
      n::grad(n::sparse_softmax_cross_entropy(checked.logits, probe.labels), p.parameters());
  for (std::size_t i = 0; i < gs.size(); ++i) {
    if (!n::all(n::is_finite(gs[i])).item<bool>())
      return 1;
    const auto &name = p.names()[i];
    if (name.ends_with("/reduce/W") || name.ends_with("/spatial/W") ||
        name.ends_with("/expand/W")) {
      if (n::max(n::abs(gs[i])).item() != 0)
        return 1;
      ++blocked;
    }
  }
  if (blocked != 96)
    return 1;
  n::OptimizerConfig options;
  options.kind = n::OptimizerKind::Adam;
  n::Optimizer adam(p, .001, options);
  n::BatchOrder order(fit.size(), 2, 647);
  double best = INFINITY;
  int selected = 0, updates = 0;
  std::vector<n::Tensor> history;
  std::print("| epoch | batch-moment dropout fit CE | moving-moment validation NLL "
             "|\n|---:|---:|---:|\n");
  for (int epoch = 1; epoch <= 3; ++epoch) {
    order.begin_epoch();
    auto average = n::zeros({}, n::DType::Float64);
    for (;;) {
      const auto rows = order.next();
      if (rows.empty())
        break;
      const auto d = m::VideoRows(fit, rows);
      const auto out = m::SlowFast(p, state, d.rgb, c, true, true, &dropout);
      const auto loss = n::sparse_softmax_cross_entropy(out.logits, d.labels);
      average = average +
                loss.detach().to(n::DType::Float64) * double(rows.size()) / double(fit.size());
      adam.step(n::grad(loss, p.parameters()));
      ++updates;
    }
    const auto val =
        m::ScoreSequenceClassifier(predict(validation.rgb), validation.labels).nll;
    if (val.item() < best) {
      best = val.item();
      selected = epoch;
      n::NamedTensors learned, moving;
      for (std::size_t i = 0; i < p.size(); ++i)
        learned.push_back({p.names()[i], p.parameters()[i]});
      for (std::size_t i = 0; i < state.size(); ++i)
        moving.push_back({state.names()[i], state.parameters()[i]});
      n::save_npz("build/slowfast_best.npz", learned);
      n::save_npz("build/slowfast_state.npz", moving);
    }
    history.push_back(n::stack({average, val}, 0));
    std::print("| {} | {:.6f} | {:.6f} |\n", epoch, average.item(), val.item());
  }
  for (const auto &[key, value] : n::load_npz("build/slowfast_best.npz"))
    p.set(key, value);
  for (const auto &[key, value] : n::load_npz("build/slowfast_state.npz"))
    state.set(key, value);
  const auto fitted = m::ScoreSequenceClassifier(predict(fit.rgb), fit.labels).nll;
  n::save_npz("build/slowfast_outputs.npz",
              {{"logits", predict(test.rgb)}, {"untrained", untrained}});
  std::print("{}explicit Adam updates;selected epoch {},validation {:.6f};fixed inference "
             "fitting NLL {:.9f}->{:.9f}.\n",
             updates, selected, best, initial.item(), fitted.item());
  const auto h = n::stack(history, 0);
  auto plot = dm::graphics::RPlot::create();
  plot.lines(n::arange(1, 4).to_vector<double>(), n::select(h, 1, 0).to_vector<double>(),
             "batch fit", {37, 99, 235})
      .lines(n::arange(1, 4).to_vector<double>(), n::select(h, 1, 1).to_vector<double>(),
             "moving val", {220, 38, 38})
      .title("Thirty-six explicit SlowFast Adam updates")
      .x_label("epoch;twelve fitting batches each")
      .y_label("categorical CE/NLL");
  plot.save_svg("build/slowfast_training.svg");
}
```
// result_begin: markdown
| epoch | batch-moment dropout fit CE | moving-moment validation NLL |
|---:|---:|---:|
| 1 | 1.125773 | 1.101417 |
| 2 | 1.055330 | 1.123988 |
| 3 | 1.083929 | 1.200249 |
36explicit Adam updates;selected epoch 1,validation 1.101417;fixed inference fitting NLL 1.098741081->1.097462405.
