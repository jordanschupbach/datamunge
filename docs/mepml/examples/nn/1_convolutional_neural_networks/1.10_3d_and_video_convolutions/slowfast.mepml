> Complete two-path graph and zero-final gates

The full reference census gives34480216learned scalars;the actual compact graph
has533524. Both pathways retain R50 bottleneck depths3/4/6/3. Slow width is base,Fast
base/8. Stem and three subsequent temporal5/stride8 fusions project to twice
Fast width and concatenate into Slow. GAP of both paths gives36*base features;
keep.5dropout and a linear head complete the graph. All110normalized units
use fan-out normal weights,fused BN eps1e-5/decay.9 and separately saved moments.
Batch normalization uses population variance;moving variance receives the fused
operator's unbiased correction. The32final expansion gammas start exactly0.
Thus their96upstream branch kernels initially have zero derivatives while
projection paths,head and normalization offsets/scales can learn. This is an
intentional residual gate,not evidence of a disconnected model.

The full32frame224px/base64/400class census is analytical in the source;
the compact16frame32px/base8/3class graph actually executes all32blocks and
four fusions. Do not interpret a reference census as a full-reference run.
```{cpp, results="markdown", file="figures/slowfast_features.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

#include <print>
int main() {
  namespace n = dm::nn;
  namespace m = n::models;
  n::set_num_threads(2);
  std::filesystem::path cache;
  if (const auto *p = std::getenv("DATAMUNGE_DATA_DIR"))
    cache = p;
  else if (const auto *p = std::getenv("XDG_CACHE_HOME"))
    cache = std::filesystem::path(p) / "datamunge/datasets";
  else
    cache = std::filesystem::path(std::getenv("HOME")) / ".cache/datamunge/datasets";

  std::filesystem::path root = cache / "action_video";
  if (const auto *p = std::getenv("DATAMUNGE_VIDEO_DIR"))
    root = p;
  else
    dm::datasets::prepare_example_data("video", root.string());
  const auto pools = m::LoadVideo(root);
  const auto &fit = pools[0];
  const auto &validation = pools[1];
  const auto &test = pools[2];

  const m::SlowFastConfig c{8, 3, 16};
  n::ParameterStore p(751), state(753);
  n::Generator dropout(743);
  {
    n::NoGradGuard guard;
    m::SlowFast(p, state, n::zeros({1, 16, 32, 32, 3}), c);
  }
  auto predict = [&](const n::Tensor &rgb) {
    n::NoGradGuard guard;
    std::vector<n::Tensor> parts;
    for (std::int64_t start = 0; start < rgb.size(0); start += 2)
      parts.push_back(
          m::SlowFast(
              p, state,
              n::slice_axis(rgb, 0, start, std::min<std::int64_t>(start + 2, rgb.size(0))), c)
              .logits);
    return n::concat(parts, 0);
  };
  const auto d = m::VideoRows(fit, {0, 1});
  const auto out = m::SlowFast(p, state, d.rgb, c, true, false, &dropout);
  const auto gs =
      n::grad(n::sparse_softmax_cross_entropy(out.logits, d.labels), p.parameters());
  int gates = 0, blocked = 0, active = 0;
  for (std::size_t i = 0; i < p.size(); ++i) {
    const auto &name = p.names()[i];
    if (!n::all(n::is_finite(gs[i])).item<bool>())
      return 1;
    if (n::sum(n::square(gs[i])).item() > 0)
      ++active;
    if (name.ends_with("/expand/bn/gamma")) {
      if (n::max(n::abs(p.at(name))).item() != 0)
        return 1;
      ++gates;
    }
    if (name.ends_with("/reduce/W") || name.ends_with("/spatial/W") ||
        name.ends_with("/expand/W")) {
      if (n::max(n::abs(gs[i])).item() != 0)
        return 1;
      ++blocked;
    }
  }
  if (gates != 32 || blocked != 96)
    return 1;
  std::print("{}parameters,{}learned+{}moving arrays;{}zero gates,{}blocked branch "
             "kernels,{}active learned tensors.\n",
             p.count(), p.size(), state.size(), gates, blocked, active);
  std::print("| stage | Slow shape | Fast shape | lateral shape |\n|---:|---|---|---|\n");
  std::vector<n::Tensor> slow, fast;
  for (int i = 0; i < 5; ++i) {
    std::print("| {} | {} | {} | {} |\n", i, out.slow_stages[i].shape(),
               out.fast_stages[i].shape(), i < 4 ? out.lateral[i].shape() : n::Shape{});
    slow.push_back(n::mean(out.slow_stages[i].to(n::DType::Float64)));
    fast.push_back(n::mean(out.fast_stages[i].to(n::DType::Float64)));
  }
  auto plot = dm::graphics::RPlot::create();
  plot.lines(n::arange(0, 5).to_vector<double>(), n::stack(slow, 0).to_vector<double>(),
             "Slow", {37, 99, 235})
      .lines(n::arange(0, 5).to_vector<double>(), n::stack(fast, 0).to_vector<double>(),
             "Fast", {220, 38, 38})
      .title("Both actual initialized pathways")
      .x_label("stem,then stages0..3")
      .y_label("mean batch-moment ReLU activation");
  plot.save_svg("build/slowfast_features.svg");
}
```
