> Hand-checkable temporal sampling and lateral adjoints

ForFobservations and alpha8,indices are floor(i*(F-1)/(F/8-1)). Hence16gives
0,15 and32gives0,10,20,31. This source adaptation uses endpoint-inclusive
sampling;it is not simply every eighth frame. Tensor gather adjoints scatter
only to those original indices. Fast lateral convolutions use temporal5,stride8,
explicit two-frame padding on both sides,then concatenate channels with Slow.
All56fixture outputs and192kernel/Fast/Slow derivatives have independent host
convolution and central finite-difference checks in the native tests.
```{cpp, results="markdown", file="figures/slowfast_sampling.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

#include <print>
int main() {
  namespace n = dm::nn;
  namespace m = n::models;
  auto x = n::arange(0, 32).reshape({1, 32, 1, 1, 1}).requires_grad_();
  const auto y = m::SlowFastSample(x, 32);
  const auto g = n::grad(n::sum(y), {x})[0];
  std::print("32-frame samples {};all32 input adjoints {}.\n", y.reshape({4}),
             g.reshape({32}));
  const auto kernel = n::ones({5, 1, 1, 1, 1}) / 5.;
  const auto lateral = m::FactorConv(x, kernel, 8);
  const auto joined = m::SlowFastJoin(y, lateral);
  std::print("Actual stride8 lateral {};joined {}.\n", lateral.reshape({4}),
             joined.reshape({4, 2}));
  auto a = dm::graphics::RPlot::create(), b = dm::graphics::RPlot::create();
  a.points(n::arange(0, 32).to_vector<double>(), g.reshape({32}).to_vector<double>(),
           "gather adjoint", {37, 99, 235})
      .title("Declared32-frame sampling fixture")
      .x_label("original frame index")
      .y_label("sum-of-samples input derivative");
  b.lines(n::arange(0, 4).to_vector<double>(), y.reshape({4}).to_vector<double>(),
          "Slow samples", {37, 99, 235})
      .lines(n::arange(0, 4).to_vector<double>(), lateral.reshape({4}).to_vector<double>(),
             "Fast lateral", {220, 38, 38})
      .title("Distinct sampling and lateral windows")
      .x_label("Slow/lateral time coordinate")
      .y_label("declared scalar ramp response");
  auto layout = dm::graphics::RLayout::create(1, 2);
  layout.add(a).add(b).size(1100, 500).fit_panels().save_svg("build/slowfast_sampling.svg");
}
