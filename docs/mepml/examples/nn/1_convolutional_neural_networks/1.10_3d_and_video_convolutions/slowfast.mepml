> Fresh restoration and every held-out prediction

Fresh paired restoration must reproduce saved and repeated logits,agree for a
single clip and leave all552arrays unchanged. Every held-out prediction,class
recall/confusion and fixed reference is visible. The retained-memory static and
motion1NN references have no fitted parameters;all their feature normalization
and distance arithmetic use tensors and fitting observations only.
```{cpp, results="markdown", file="figures/slowfast_confusion.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

#include <print>
int main() {
  namespace n = dm::nn;
  namespace m = n::models;
  n::set_num_threads(2);

  std::filesystem::path cache;
  if (const auto *p = std::getenv("DATAMUNGE_DATA_DIR"))
    cache = p;
  else if (const auto *p = std::getenv("XDG_CACHE_HOME"))
    cache = std::filesystem::path(p) / "datamunge/datasets";
  else
    cache = std::filesystem::path(std::getenv("HOME")) / ".cache/datamunge/datasets";

  std::filesystem::path root = cache / "action_video";
  if (const auto *p = std::getenv("DATAMUNGE_VIDEO_DIR"))
    root = p;
  else
    dm::datasets::prepare_example_data("video", root.string());
  const auto pools = m::LoadVideo(root);
  const auto &fit = pools[0];
  const auto &validation = pools[1];
  const auto &test = pools[2];

  const m::SlowFastConfig c{8, 3, 16};
  n::ParameterStore p(751), state(753);
  n::Generator dropout(743);
  {
    n::NoGradGuard guard;
    m::SlowFast(p, state, n::zeros({1, 16, 32, 32, 3}), c);
  }
  auto predict = [&](const n::Tensor &rgb) {
    n::NoGradGuard guard;
    std::vector<n::Tensor> parts;
    for (std::int64_t start = 0; start < rgb.size(0); start += 2)
      parts.push_back(
          m::SlowFast(
              p, state,
              n::slice_axis(rgb, 0, start, std::min<std::int64_t>(start + 2, rgb.size(0))), c)
              .logits);
    return n::concat(parts, 0);
  };
  for (const auto &[name, value] : n::load_npz("build/slowfast_best.npz"))
    p.set(name, value.clone());
  for (const auto &[name, value] : n::load_npz("build/slowfast_state.npz"))
    state.set(name, value.clone());
  std::vector<n::Tensor> before;
  for (const auto &v : p.parameters())
    before.push_back(v.clone());
  std::vector<n::Tensor> moving_before;
  for (const auto &v : state.parameters())
    moving_before.push_back(v.clone());
  n::Tensor saved, untrained;
  for (const auto &[name, value] : n::load_npz("build/slowfast_outputs.npz")) {
    if (name == "logits")
      saved = value;
    else
      untrained = value;
  }
  const auto z = predict(test.rgb);
  const auto parity =
      n::maximum(n::max(n::abs(z - saved)), n::max(n::abs(z - predict(test.rgb))));
  const auto single =
      n::max(n::abs(predict(n::slice_axis(test.rgb, 0, 0, 1)) - n::slice_axis(z, 0, 0, 1)));
  const auto reversed = predict(n::reverse(test.rgb, {1}).contiguous());
  const auto still = predict(n::tile(n::slice_axis(test.rgb, 1, 0, 1), {1, 16, 1, 1, 1}));
  const auto order = n::sum(n::abs(z.to(n::DType::Float64) - reversed.to(n::DType::Float64)));
  const auto motion = n::sum(n::abs(z.to(n::DType::Float64) - still.to(n::DType::Float64)));
  bool immutable = true;
  for (std::size_t i = 0; i < before.size(); ++i)
    immutable = immutable && n::all(n::equal(before[i], p.parameters()[i])).item<bool>();
  for (std::size_t i = 0; i < moving_before.size(); ++i)
    immutable =
        immutable && n::all(n::equal(moving_before[i], state.parameters()[i])).item<bool>();
  if (parity.item() > 1e-6 || single.item() > 1e-6 || order.item() <= 1e-7 ||
      motion.item() <= 1e-7 || !immutable)
    return 1;
  std::print("Fresh RGB restore/repeat {:.3g};single/batch {:.9g} "
             "within1e-6;332learned+220moving leaves "
             "immutable:{};reverse/repeat-first changes {:.9f}/{:.9f}.\n",
             parity.item(), single.item(), immutable, order.item(), motion.item());
  const auto static_nn = m::VideoNearest(fit, test, false),
             motion_nn = m::VideoNearest(fit, test, true);
  std::vector<n::Tensor> accuracy, nll;
  std::print("\n| predictor | accuracy | macroF1 | NLL | all recalls | all true-row confusion "
             "counts |\n|---|---:|---:|---:|---|---|\n");
  for (const auto &item :
       std::vector<std::pair<std::string, n::Tensor>>{{"learned SlowFast", z},
                                                      {"untrained", untrained},
                                                      {"static1NN", static_nn},
                                                      {"motion1NN", motion_nn},
                                                      {"class0 tie", n::zeros_like(z)},
                                                      {"reversed control", reversed},
                                                      {"still control", still}}) {
    const auto score = m::ScoreSensor(item.second, test.labels, 3);
    std::print("| {} | {:.6f} | {:.6f} | {:.6f} | {} | {} |\n", item.first, score.accuracy,
               score.macro_f1, score.nll, n::from_vector(score.recall),
               n::from_vector(score.confusion, {3, 3}));
    const auto base = m::ScoreSequenceClassifier(item.second, test.labels);
    accuracy.push_back(base.accuracy);
    nll.push_back(base.nll);
  }
  const auto predicted = n::argmax(z, 1).to_vector<int>(),
             truth = test.labels.to_vector<int>();
  std::print("\n| held-out row | true action | learned action |\n|---:|---:|---:|\n");
  for (int row = 0; row < 6; ++row)
    std::print("| {} | {} | {} |\n", row, truth[row], predicted[row]);
  auto a = dm::graphics::RPlot::create(), b = dm::graphics::RPlot::create();
  a.points(n::arange(0, 7).to_vector<double>(), n::stack(accuracy, 0).to_vector<double>(),
           "accuracy", {37, 99, 235})
      .title("Every held-out clip accuracy")
      .x_label("0CNN/1initial/2static/3motion/4tie/5reverse/6still")
      .y_label("correct clip fraction")
      .y_limits(0, 1.1);
  b.points(n::arange(0, 7).to_vector<double>(), n::stack(nll, 0).to_vector<double>(), "NLL",
           {220, 38, 38})
      .title("Every held-out clip likelihood")
      .x_label("same seven predictor ordinals")
      .y_label("mean categorical NLL")
      .y_limits(0, 1.4);
  auto metrics = dm::graphics::RLayout::create(1, 2);
  metrics.add(a).add(b).size(1100, 500).fit_panels().save_svg("build/slowfast_metrics.svg");
  std::filesystem::create_directories("figures");
  std::filesystem::copy_file("build/slowfast_metrics.svg", "figures/slowfast_metrics.svg",
                             std::filesystem::copy_options::overwrite_existing);
  a = n::plot_tensor_map(
      n::reverse(m::ScoreSequenceClassifier(z, test.labels).confusion.to(n::DType::Float64),
                 {0}),
      0, 2);
  b = n::plot_tensor_map(
      n::reverse(
          m::ScoreSequenceClassifier(motion_nn, test.labels).confusion.to(n::DType::Float64),
          {0}),
      0, 2);
  a.title("Learned SlowFast confusion")
      .x_label("predicted action0/1/2")
      .y_label("true boxing0 at bottom");
  b.title("Motion1NN confusion")
      .x_label("predicted action0/1/2")
      .y_label("true boxing0 at bottom");
  auto confusion = dm::graphics::RLayout::create(1, 2);
  confusion.add(a).add(b).size(1100, 500).fit_panels().save_svg(
      "build/slowfast_confusion.svg");
}
```
