The selected first-epoch model predicts handwaving for all six held-out clips,
accuracy1/3,NLL1.099577,below motion1NN accuracy2/3. Its fixed fitting inference
NLL improves1.098741081to1.097462405;later validation NLL worsens,so those later
arrays are not deployed. These results do not establish action recognition
quality beyond this tiny held-out person.

> Does Fast information reach Slow?

Keep raw first/last frames fixed,replace intermediate selected frames with the
first frame,and compare the final Slow body. Raw Slow samples remain exactly
unchanged. Any Slow-body difference must pass through the four lateral links.
A second declared ablation sets all lateral multipliers0 with the same learned
and moving arrays;this is inference intervention,not a retrained comparison.
```{cpp, results="markdown", file="figures/slowfast_transfer.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

#include <print>
int main() {
  namespace n = dm::nn;
  namespace m = n::models;
  n::set_num_threads(2);
  std::filesystem::path cache;
  if (const auto *p = std::getenv("DATAMUNGE_DATA_DIR"))
    cache = p;
  else if (const auto *p = std::getenv("XDG_CACHE_HOME"))
    cache = std::filesystem::path(p) / "datamunge/datasets";
  else
    cache = std::filesystem::path(std::getenv("HOME")) / ".cache/datamunge/datasets";

  std::filesystem::path root = cache / "action_video";
  if (const auto *p = std::getenv("DATAMUNGE_VIDEO_DIR"))
    root = p;
  else
    dm::datasets::prepare_example_data("video", root.string());
  const auto pools = m::LoadVideo(root);
  const auto &fit = pools[0];
  const auto &validation = pools[1];
  const auto &test = pools[2];

  const m::SlowFastConfig c{8, 3, 16};
  n::ParameterStore p(751), state(753);
  n::Generator dropout(743);
  {
    n::NoGradGuard guard;
    m::SlowFast(p, state, n::zeros({1, 16, 32, 32, 3}), c);
  }
  auto predict = [&](const n::Tensor &rgb) {
    n::NoGradGuard guard;
    std::vector<n::Tensor> parts;
    for (std::int64_t start = 0; start < rgb.size(0); start += 2)
      parts.push_back(
          m::SlowFast(
              p, state,
              n::slice_axis(rgb, 0, start, std::min<std::int64_t>(start + 2, rgb.size(0))), c)
              .logits);
    return n::concat(parts, 0);
  };
  for (const auto &[key, value] : n::load_npz("build/slowfast_best.npz"))
    p.set(key, value);
  for (const auto &[key, value] : n::load_npz("build/slowfast_state.npz"))
    state.set(key, value);
  const auto learned = p.flatten(), moving = state.flatten();
  n::NoGradGuard guard;
  const auto changed = n::concat({n::slice_axis(test.rgb, 1, 0, 1),
                                  n::tile(n::slice_axis(test.rgb, 1, 0, 1), {1, 14, 1, 1, 1}),
                                  n::slice_axis(test.rgb, 1, 15, 16)},
                                 1);
  const auto raw =
      n::max(n::abs(m::SlowFastSample(test.rgb, 16) - m::SlowFastSample(changed, 16)));
  const auto original = m::SlowFast(p, state, test.rgb, c),
             altered = m::SlowFast(p, state, changed, c);
  const auto disabled = m::SlowFast(p, state, test.rgb, {8, 3, 16, 0});
  const auto transfer = n::sum(n::abs(original.slow_final - altered.slow_final)),
             effect = n::sum(n::abs(original.logits - disabled.logits));
  if (raw.item() != 0 || transfer.item() <= 1e-7 || effect.item() <= 1e-7 ||
      learned != p.flatten() || moving != state.flatten())
    return 1;
  std::print("Raw Slow difference {};Fast-to-Slow body L1 {:.9g};zero-lateral logit L1 "
             "{:.9g};all552arrays unchanged.\n",
             raw.item(), transfer.item(), effect.item());
  std::vector<n::Tensor> changes;
  for (int i = 0; i < 5; ++i)
    changes.push_back(n::mean(n::abs(original.slow_stages[i] - altered.slow_stages[i])));
  auto plot = dm::graphics::RPlot::create();
  plot.lines(n::arange(0, 5).to_vector<double>(), n::stack(changes, 0).to_vector<double>(),
             "Fast-only change", {37, 99, 235})
      .title("Fast-only intervention reaches Slow")
      .x_label("Slow stem,then stages0..3")
      .y_label("actual mean absolute Slow activation change");
  plot.save_svg("build/slowfast_transfer.svg");
}
```
