> Original annotated KTH video frames and person separation

The original KTH action videos/00sequences.txt are preserved through the pinned
public mirror revision7076149bdbeff8d70003a68d6291fd080db44683 because the
original server is unavailable. Classes0/1/2 are boxing/handclapping/handwaving.
Use scenario1,people1..4fit,5validation,6test:18original AVI videos. Keep the
first two annotated inclusive segments per video and16unique integer frames
evenly spaced across each segment. This gives24fit/6validation/6test clips,
balanced within each pool. A segment is not an independent person.

```{cpp, flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
  const std::filesystem::path cache = dm::datasets::data_home();
  dm::datasets::prepare_example_data("video", (cache / "action_video").string());
}
```
// result_begin:
// Tensor RGB ingress/32x32bilinear/scaling saved for36original clips.
// result_end

FFmpeg only decodes source frames;the tensor helper performs Float32 legacy
bilinear32px resize and/255. Original160x120 RGB PNGs,AVI hashes,source frame
indices,segment bounds and person/video identities stay in the manifest.
Grayscale KTH recordings have three replicated decoded RGB channels. These
are real observed frames,not synthesized motion. The custom six-person,
one-test-person protocol is not a KTH/Sports1M benchmark result.

Show every frame of all six held-out clips below,one clip per row,16frames
left to right. Source identities and true actions are printed for every row.
```{cpp, results="markdown", file="figures/c3d_data.png", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

#include <print>
int main() {
  namespace n = dm::nn;
  namespace m = n::models;
  n::set_num_threads(2);

  std::filesystem::path cache;
  if (const auto *p = std::getenv("DATAMUNGE_DATA_DIR"))
    cache = p;
  else if (const auto *p = std::getenv("XDG_CACHE_HOME"))
    cache = std::filesystem::path(p) / "datamunge/datasets";
  else
    cache = std::filesystem::path(std::getenv("HOME")) / ".cache/datamunge/datasets";

  std::filesystem::path root = cache / "action_video";
  if (const auto *p = std::getenv("DATAMUNGE_VIDEO_DIR"))
    root = p;
  else
    dm::datasets::prepare_example_data("video", root.string());
  const auto pools = m::LoadVideo(root);
  const auto &fit = pools[0];
  const auto &validation = pools[1];
  const auto &test = pools[2];

  std::print("| gallery row | action0boxing/1clapping/2waving | person | original video | "
             "original segment |\n|---:|---:|---:|---:|---:|\n");
  const auto labels = test.labels.to_vector<int>(), people = test.person.to_vector<int>(),
             videos = test.video.to_vector<int>(), segments = test.segment.to_vector<int>();
  for (int row = 0; row < test.size(); ++row)
    std::print("| {} | {} | {} | {} | {} |\n", row, labels[row], people[row], videos[row],
               segments[row]);
  const auto delta =
      n::mean(n::abs(n::slice_axis(fit.rgb, 1, 1, 16) - n::slice_axis(fit.rgb, 1, 0, 15))
                  .to(n::DType::Float64),
              {2, 3, 4});
  auto plot = dm::graphics::RPlot::create();
  plot.lines(n::arange(1, 16).to_vector<double>(), n::mean(delta, {0}).to_vector<double>(),
             "all fitting clips", {37, 99, 235})
      .title("Actual mean selected-frame change")
      .x_label("successive selected-frame pair")
      .y_label("mean absolute RGB difference");
  plot.save_svg("build/c3d_data_motion.svg");
  std::filesystem::create_directories("figures");
  std::filesystem::copy_file("build/c3d_data_motion.svg", "figures/c3d_data_motion.svg",
                             std::filesystem::copy_options::overwrite_existing);
  n::save_image_grid(test.rgb.reshape({96, 32, 32, 3}), "build/c3d_data.png", 16, 0, 1, 2, 0,
                     2);
}
