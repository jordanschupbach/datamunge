> Complete eight-convolution graph, scaled only in width and image size

Scale RGB to[-1,1]. Eight SAME3x3x3 He-uniform/ReLU convolutions use width
multiples1/2/4/4/8/8/8/8,pools after1/2/4/6/8,then two Glorot dense/ReLU
layers with keep.5dropout and a linear classifier. No batch normalization.
Compact base4/FC64/image32/classes3 has114963values and22learned tensors.
Full base64/FC4096/image112/classes487 has79991015values and22tensors;
the native suite actually executes its forward and all gradients at full size.
These are source initialization/input/head adaptations,without pretraining.

Actual initialized fitting-clip activations below show stage geometry and
mean activation magnitude. They are not trained action explanations.
```{cpp, results="markdown", file="figures/c3d_features.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

#include <print>
int main() {
  namespace n = dm::nn;
  namespace m = n::models;
  n::set_num_threads(2);

  std::filesystem::path cache;
  if (const auto *p = std::getenv("DATAMUNGE_DATA_DIR"))
    cache = p;
  else if (const auto *p = std::getenv("XDG_CACHE_HOME"))
    cache = std::filesystem::path(p) / "datamunge/datasets";
  else
    cache = std::filesystem::path(std::getenv("HOME")) / ".cache/datamunge/datasets";

  std::filesystem::path root = cache / "action_video";
  if (const auto *p = std::getenv("DATAMUNGE_VIDEO_DIR"))
    root = p;
  else
    dm::datasets::prepare_example_data("video", root.string());
  const auto pools = m::LoadVideo(root);
  const auto &fit = pools[0];
  const auto &validation = pools[1];
  const auto &test = pools[2];

  const m::C3dConfig c{4, 64, 3, 32};
  n::ParameterStore p(643);
  {
    n::NoGradGuard guard;
    m::C3d(p, n::zeros({1, 16, 32, 32, 3}), c);
  }
  auto predict = [&](const n::Tensor &rgb) {
    n::NoGradGuard guard;
    std::vector<n::Tensor> parts;
    for (std::int64_t start = 0; start < rgb.size(0); start += 2)
      parts.push_back(
          m::C3d(p,
                 n::slice_axis(rgb, 0, start, std::min<std::int64_t>(start + 2, rgb.size(0))),
                 c)
              .logits);
    return n::concat(parts, 0);
  };

  const auto out = m::C3d(p, n::slice_axis(fit.rgb, 0, 0, 1), c);
  std::vector<n::Tensor> energy;
  std::print("| layer | actual compact convolution shape |\n|---:|---|\n");
  for (int i = 0; i < 8; ++i) {
    std::print("| {} | {} |\n", i + 1, out.conv[i].shape());
    energy.push_back(n::mean(out.conv[i].to(n::DType::Float64)));
  }
  std::print("Flatten {},dense {}/{},head {},{}values/{}leaves.\n", out.flat.shape(),
             out.fc6.shape(), out.fc7.shape(), out.logits.shape(), p.count(), p.size());
  const auto map = n::mean(n::select(out.conv[0], 0, 0), {3});
  auto a = n::plot_tensor_map(n::select(map, 0, 0), 0, n::max(map).item()),
       b = dm::graphics::RPlot::create();
  a.title("Actual first-frame mean conv1 activation").x_label("image x").y_label("image y");
  b.lines(n::arange(1, 9).to_vector<double>(), n::stack(energy, 0).to_vector<double>(),
          "all stage means", {37, 99, 235})
      .title("Every initialized3D convolution stage")
      .x_label("source convolution ordinal1..8")
      .y_label("mean post-ReLU activation");
  auto layout = dm::graphics::RLayout::create(1, 2);
  layout.add(a).add(b).size(1100, 500).fit_panels().save_svg("build/c3d_features.svg");
}
