> Every one of36Adam updates is visible

Warm22learned leaves before tensor Adam(.001). Use source initialization643,
dropout631,batch-order647,batch2,three epochs over24fitting clips:36updates.
An explicit two-clip dropout derivative probe advances the same generator
before training and checks every learned leaf. Every batch displays the full
forward,categorical CE,gradient and optimizer step. Validation Double NLL
selects the saved arrays;the complete fitting inference loss is a separate probe.
```{cpp, results="markdown", file="figures/c3d_training.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

#include <print>
int main() {
  namespace n = dm::nn;
  namespace m = n::models;
  n::set_num_threads(2);

  std::filesystem::path cache;
  if (const auto *p = std::getenv("DATAMUNGE_DATA_DIR"))
    cache = p;
  else if (const auto *p = std::getenv("XDG_CACHE_HOME"))
    cache = std::filesystem::path(p) / "datamunge/datasets";
  else
    cache = std::filesystem::path(std::getenv("HOME")) / ".cache/datamunge/datasets";

  std::filesystem::path root = cache / "action_video";
  if (const auto *p = std::getenv("DATAMUNGE_VIDEO_DIR"))
    root = p;
  else
    dm::datasets::prepare_example_data("video", root.string());
  const auto pools = m::LoadVideo(root);
  const auto &fit = pools[0];
  const auto &validation = pools[1];
  const auto &test = pools[2];

  const m::C3dConfig c{4, 64, 3, 32};
  n::ParameterStore p(643);
  {
    n::NoGradGuard guard;
    m::C3d(p, n::zeros({1, 16, 32, 32, 3}), c);
  }
  auto predict = [&](const n::Tensor &rgb) {
    n::NoGradGuard guard;
    std::vector<n::Tensor> parts;
    for (std::int64_t start = 0; start < rgb.size(0); start += 2)
      parts.push_back(
          m::C3d(p,
                 n::slice_axis(rgb, 0, start, std::min<std::int64_t>(start + 2, rgb.size(0))),
                 c)
              .logits);
    return n::concat(parts, 0);
  };

  n::Generator dropout(631);
  const auto initial = m::ScoreSequenceClassifier(predict(fit.rgb), fit.labels).nll;
  const auto untrained = predict(test.rgb);
  const auto probe = m::VideoRows(fit, {0, 1});
  const auto checked = m::C3d(p, probe.rgb, c, true, &dropout, .5);
  for (const auto &g :
       n::grad(n::sparse_softmax_cross_entropy(checked.logits, probe.labels), p.parameters()))
    if (!n::all(n::is_finite(g)).item<bool>() || n::sum(n::square(g)).item() <= 0)
      return 1;
  n::OptimizerConfig options;
  options.kind = n::OptimizerKind::Adam;
  n::Optimizer adam(p, .001, options);
  n::BatchOrder order(fit.size(), 2, 647);
  double best = INFINITY;
  int selected = 0, updates = 0;
  std::vector<n::Tensor> history;
  std::print("| epoch | dropout fitting CE | validation NLL |\n|---:|---:|---:|\n");
  for (int epoch = 1; epoch <= 3; ++epoch) {
    order.begin_epoch();
    auto average = n::zeros({}, n::DType::Float64);
    for (;;) {
      const auto rows = order.next();
      if (rows.empty())
        break;
      const auto d = m::VideoRows(fit, rows);
      const auto out = m::C3d(p, d.rgb, c, true, &dropout, .5);
      const auto loss = n::sparse_softmax_cross_entropy(out.logits, d.labels);
      average = average +
                loss.detach().to(n::DType::Float64) * double(rows.size()) / double(fit.size());
      adam.step(n::grad(loss, p.parameters()));
      ++updates;
    }
    const auto val =
        m::ScoreSequenceClassifier(predict(validation.rgb), validation.labels).nll;
    if (val.item() < best) {
      best = val.item();
      selected = epoch;
      n::NamedTensors arrays;
      for (std::size_t i = 0; i < p.size(); ++i)
        arrays.push_back({p.names()[i], p.parameters()[i]});
      n::save_npz("build/c3d_best.npz", arrays);
    }
    history.push_back(n::stack({average, val}, 0));
    std::print("| {} | {:.6f} | {:.6f} |\n", epoch, average.item(), val.item());
  }
  for (const auto &[name, value] : n::load_npz("build/c3d_best.npz"))
    p.set(name, value);
  const auto fitted = m::ScoreSequenceClassifier(predict(fit.rgb), fit.labels).nll;
  n::save_npz("build/c3d_outputs.npz",
              {{"logits", predict(test.rgb)}, {"untrained", untrained}});
  std::print("{} explicit Adam updates;selected epoch {},validation {:.6f};fixed fitting "
             "inference NLL {:.6f}->{:.6f}.\n",
             updates, selected, best, initial.item(), fitted.item());
  const auto h = n::stack(history, 0);
  auto plot = dm::graphics::RPlot::create();
  plot.lines(n::arange(1, 4).to_vector<double>(), n::select(h, 1, 0).to_vector<double>(),
             "dropout fit", {37, 99, 235})
      .lines(n::arange(1, 4).to_vector<double>(), n::select(h, 1, 1).to_vector<double>(),
             "inference validation", {220, 38, 38})
      .title("Thirty-six explicit video Adam updates")
      .x_label("epoch;twelve fitting batches each")
      .y_label("categorical CE/NLL");
  plot.save_svg("build/c3d_training.svg");
}
```
