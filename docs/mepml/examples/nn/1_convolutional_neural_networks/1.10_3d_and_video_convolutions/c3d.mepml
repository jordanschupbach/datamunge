> Caffe-ceil pooling keeps negative odd-edge samples

Equal kernel/stride2 SAME pooling pads only the trailing odd edge and ignores
padded values,matching explicit negative-infinity trailing padding followed by
VALID pooling. The first pool uses1x2x2 to preserve all16time steps;later pools
use2x2x2. A signed fixture makes accidental zero-padding maxima visible.
Its exact maximum and every input adjoint are checked in the native suite.
```{cpp, results="markdown", file="figures/c3d_pool.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

#include <print>
int main() {
  namespace n = dm::nn;
  namespace m = n::models;
  auto x = (-n::arange(1, 76)).reshape({1, 3, 5, 5, 1});
  x.requires_grad_(true);
  const auto y = m::C3dPool(x, false);
  const auto gradient = n::grad(n::sum(y), {x})[0];
  const auto explicit_pad =
      n::pad(x, {{0, 0}, {0, 1}, {0, 1}, {0, 1}, {0, 0}}, n::PadMode::Constant, -INFINITY);
  const auto oracle = n::max_pool3d(explicit_pad, 2, 2, n::Padding::Valid);
  const auto parity = n::max(n::abs(y - oracle));
  if (parity.item() != 0 || n::max(y).item() >= 0)
    return 1;
  std::print("Signed3x5x5 input->{},all pooled parity {:.3g};first-pool shape {};all selected "
             "input adjoints sum {}.\n",
             y.shape(), parity.item(), m::C3dPool(x, true).shape(), n::sum(gradient));
  auto a = n::plot_tensor_map(n::select(n::select(n::select(x, 0, 0), 0, 2), 2, 0), -75, 0),
       b = n::plot_tensor_map(n::select(n::select(n::select(y, 0, 0), 0, 1), 2, 0), -75, 0);
  a.title("Declared negative odd-edge input")
      .x_label("source x")
      .y_label("source y;last time slice");
  b.title("Real-only final ceil-pool slice")
      .x_label("pooled x")
      .y_label("pooled y;last time slice");
  auto layout = dm::graphics::RLayout::create(1, 2);
  layout.add(a).add(b).size(1100, 500).fit_panels().save_svg("build/c3d_pool.svg");
}
```
