> Parameter-free static and motion nearest-neighbor references

Each reference retains24fitting observations. Compute4x4spatial cell means
of either all16colors or15absolute selected-frame differences,48features.
Accumulate in Double,round each feature to Float32 as the source does,then
use fitting-population Double standard deviations clamped1e-6. A shared mean
cancels in pairwise distances. First fitting row wins equal distances.

These references have no learned leaves or optimizer. Numeric preprocessing
and distances are tensors;query labels do not enter prediction. The native
suite compares every fitting feature and every held-out reference prediction
with retained literal source host code. Print complete held-out class counts.
```{cpp, results="markdown", file="figures/c3d_reference.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

#include <print>
int main() {
  namespace n = dm::nn;
  namespace m = n::models;
  n::set_num_threads(2);

  std::filesystem::path cache;
  if (const auto *p = std::getenv("DATAMUNGE_DATA_DIR"))
    cache = p;
  else if (const auto *p = std::getenv("XDG_CACHE_HOME"))
    cache = std::filesystem::path(p) / "datamunge/datasets";
  else
    cache = std::filesystem::path(std::getenv("HOME")) / ".cache/datamunge/datasets";

  std::filesystem::path root = cache / "action_video";
  if (const auto *p = std::getenv("DATAMUNGE_VIDEO_DIR"))
    root = p;
  else
    dm::datasets::prepare_example_data("video", root.string());
  const auto pools = m::LoadVideo(root);
  const auto &fit = pools[0];
  const auto &validation = pools[1];
  const auto &test = pools[2];

  std::print("| reference | accuracy | stable NLL | all true-row confusion counts "
             "|\n|---|---:|---:|---|\n");
  std::vector<n::Tensor> maps;
  for (bool motion : {false, true}) {
    const auto features = m::VideoFeatures(fit, motion);
    const auto z = m::VideoNearest(fit, test, motion);
    const auto score = m::ScoreSequenceClassifier(z, test.labels);
    std::print("| {} | {:.6f} | {:.6f} | {} |\n",
               motion ? "absolute motion1NN" : "static color1NN", score.accuracy.item(),
               score.nll.item(), score.confusion);
    maps.push_back(features.to(n::DType::Float64));
  }
  auto a = n::plot_tensor_map(n::reverse(maps[0], {0}), 0, n::max(maps[0]).item()),
       b = n::plot_tensor_map(n::reverse(maps[1], {0}), 0, n::max(maps[1]).item());
  a.title("All24fitting static reference features")
      .x_label("all48 spatial cell/color features")
      .y_label("original fitting row0 at bottom");
  b.title("All24fitting motion reference features")
      .x_label("all48 spatial cell/color features")
      .y_label("original fitting row0 at bottom");
  auto layout = dm::graphics::RLayout::create(1, 2);
  layout.add(a).add(b).size(1100, 500).fit_panels().save_svg("build/c3d_reference.svg");
}
