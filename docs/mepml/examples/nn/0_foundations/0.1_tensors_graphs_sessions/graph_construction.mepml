By hand: \(h_2=1+2+3=6\), \(h_2k=30\), \((30,30)\,I=(30,30)\) and \(y=60\). The derivative \(\partial y/\partial a\) is \(k\) times the sum of the entries of \(w\), \(5\cdot2=10\).
Likewise \(\partial y/\partial k=h_2\cdot2=12\), and \(\partial y/\partial w_{ij}=30\) for every entry. The second `get("block/k")` returned the first tensor, with value 5, so its initialiser 7
was ignored. The tape lists ten nodes, output first. The constants 2, 3 and the ones matrix appear as `const` inputs, and the leaves carry their
parameter names, in place of TensorFlow's scoped op names. The counter reads 0, 0, 0, 1, 2, 3, 3, the sequence TensorFlow's example produces
with and without its control dependencies. The failing `matmul` names both shapes, and the next operation runs.

> Checking the theory

>> Sharing, ordering, loops and Newton's method

The program checks four predictions:

1. The gradient of a tied function equals the sum of the gradients of two untied copies set to the same values.
2. The tape is in topological order.
3. An unrolled recurrence records \(3T+1\) operations (with the final sum), and none under `NoGradGuard`.
4. Differentiating through a converged Newton loop gives \(1/(2\sqrt a)\), with the derivative converging quadratically.

```{cpp, results="markdown", file="figures/graph_construction_loops.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

namespace nn = dm::nn;
using nn::Tensor;

int main() {
  std::filesystem::create_directories("build");
  const auto F64 = nn::DType::Float64;
  // 1. A parameter used twice gets the sum of the gradients of its uses.
  //    f(W) = sum(tanh(x W) W^T): W appears in the encoder and, transposed, in the decoder.
  nn::Generator gen(3);
  const Tensor x = nn::normal({5, 4}, 0, 1, gen, F64);
  const Tensor W0 = nn::normal({4, 2}, 0, 1, gen, F64);
  auto W = W0.clone().requires_grad_();
  const Tensor tied = nn::grad(nn::sum(nn::matmul(nn::tanh(nn::matmul(x, W)), nn::transpose(W))), {W})[0];
  auto We = W0.clone().requires_grad_(), Wd = W0.clone().requires_grad_();  // two copies, equal values
  const auto split = nn::grad(nn::sum(nn::matmul(nn::tanh(nn::matmul(x, We)), nn::transpose(Wd))), {We, Wd});
  const double diff = nn::max(nn::abs(tied - (split[0] + split[1]))).item();
  std::print("- tied gradient against encoder-copy + decoder-copy gradients: largest difference {:.1e}\n", diff);

  // 2. The tape is in topological order: every node's inputs come after it.
  const auto t = nn::tape({nn::sum(nn::matmul(nn::tanh(nn::matmul(x, W)), nn::transpose(W)))}, {{W, "W"}});
  bool ordered = true;
  for (const auto& node : t.nodes)
    for (const auto& in : node.inputs) ordered = ordered && (!in || *in > node.id);
  std::print("- tape of the tied function: {} ops, {} leaf; every input listed after its user: {}\n\n", t.op_count(), t.leaf_count(), ordered);

  // 3. Unrolled loops: h_{s+1} = tanh(U h_s + x) for T steps records T copies of the step.
  const Tensor U = nn::normal({8, 8}, 0, 0.3, gen, F64), xin = nn::normal({8, 1}, 0, 1, gen, F64);
  std::vector<double> Ts, ops;
  std::print("| steps T | ops on the tape | ops per step | ops with NoGradGuard |\n| ---: | ---: | ---: | ---: |\n");
  for (int T : {1, 2, 4, 8, 16, 32, 64}) {
    auto h = nn::zeros({8, 1}, F64).requires_grad_();
    Tensor s = h;
    for (int k = 0; k < T; ++k) s = nn::tanh(nn::matmul(U, s) + xin);
    const auto tt = nn::tape({nn::sum(s)});
    std::size_t guarded = 0;
    {
      nn::NoGradGuard g;
      Tensor r = h;
      for (int k = 0; k < T; ++k) r = nn::tanh(nn::matmul(U, r) + xin);
      guarded = nn::tape({nn::sum(r)}).op_count();
    }
    Ts.push_back(T), ops.push_back(static_cast<double>(tt.op_count()));
    std::print("| {} | {} | {:.2f} | {} |\n", T, tt.op_count(), (tt.op_count() - 1.0) / T, guarded);
  }

  // 4. Data-dependent control flow: Newton's iteration for sqrt(a), run until converged.
  //    The tape's length depends on a, and the gradient through the loop is d sqrt(a)/da.
  std::print("\n| a | Newton steps | ops on the tape | d/da through the loop | 1/(2 sqrt a) | difference |\n| ---: | ---: | ---: | ---: | ---: | ---: |\n");
  std::vector<double> ks, derr;
  for (double av : {0.5, 2.0, 100.0, 1e6}) {
    auto a = nn::scalar(av, F64).requires_grad_();
    Tensor r = nn::scalar(1.0, F64) + 0.0 * a;  // start at 1, attached to the tape
    int steps = 0;
    while (std::abs(r.item() * r.item() - av) > 1e-12 * av && steps < 100) r = 0.5 * (r + a / r), ++steps;
    const double g = nn::grad(r, {a})[0].item(), exact = 0.5 / std::sqrt(av);
    std::print("| {:g} | {} | {} | {:.15f} | {:.15f} | {:.1e} |\n", av, steps, nn::tape({r}).op_count(), g, exact, std::abs(g - exact));
  }
  // Error of the derivative after k Newton steps, for a = 2.
  for (int k = 1; k <= 7; ++k) {
    auto a = nn::scalar(2.0, F64).requires_grad_();
    Tensor r = nn::scalar(1.0, F64) + 0.0 * a;
    for (int j = 0; j < k; ++j) r = 0.5 * (r + a / r);
    const double ev = std::abs(r.item() - std::sqrt(2.0));
    const double ed = std::abs(nn::grad(r, {a})[0].item() - 0.5 / std::sqrt(2.0));
    ks.push_back(k);
    derr.push_back(std::log10(std::max(ed, 1e-17)));
    std::print("{}k = {}: |r_k - sqrt 2| = {:.1e}, |dr_k/da - 1/(2 sqrt 2)| = {:.1e}\n", k == 1 ? "\n" : "", k, ev, ed);
  }

  auto left = dm::graphics::RPlot::create();
  left.lines(Ts, ops, "", dm::graphics::RGB{37, 99, 235}, 2.0).points(Ts, ops, "", dm::graphics::RGB{37, 99, 235}, 6.0);
  left.x_limits(0, 66).y_limits(0, 270).title("Unrolled loop: tape length").x_label("steps T").y_label("ops on the tape");
  std::vector<double> vk, verr;
  for (int k = 1; k <= 7; ++k) {
    vk.push_back(k);
    double r = 1;
    for (int j = 0; j < k; ++j) r = 0.5 * (r + 2 / r);
    verr.push_back(std::log10(std::max(std::abs(r - std::sqrt(2.0)), 1e-17)));
  }
  auto right = dm::graphics::RPlot::create();
  right.lines(vk, verr, "value |r_k - √2|", dm::graphics::RGB{17, 24, 39}, 2.0).points(vk, verr, "", dm::graphics::RGB{17, 24, 39}, 6.0);
  right.lines(ks, derr, "derivative error", dm::graphics::RGB{220, 38, 38}, 2.0).points(ks, derr, "", dm::graphics::RGB{220, 38, 38}, 6.0);
  right.x_limits(0.5, 7.5).y_limits(-17.5, 1).title("Differentiating through Newton's method").x_label("Newton steps k").y_label("log10 error");
  auto fig = dm::graphics::RLayout::create(1, 2);
  fig.add(left);
  fig.add(right);
  fig.size(1100, 440).fit_panels();
  fig.save_svg("build/graph_construction_loops.svg");
}
```
