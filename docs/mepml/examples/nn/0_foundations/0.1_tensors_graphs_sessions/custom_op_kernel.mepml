// result_end

By hand: \(2x+0.5\) gives \((2.5,4.5,6.5)\) and \((8.5,10.5,12.5)\), with row sums 13.5 and 31.5. For \(L=\sum y^2\), \(\bar x=2y\cdot s=4y\), which is \((10,18,26)\)
and \((34,42,50)\). For \(L=\sum_i(\text{row sum}_i)^2\), \(\bar x_{ij}=2\cdot\text{row sum}_i\), so 12 across the first row and 30 across the second. All of these match.
The float64 instantiation was used when the input was float64, with no extra code. The composition passes both checks, and on
the tape each custom operation is one node, between built-in ones. The rank and dtype checks reject bad inputs with a message before any
memory is read.

> Checking the theory

>> Summation error against the bounds

The program sums the first \(n\) of \(10^7\) float32 values drawn uniformly from \((0,1)\) by each method, for \(n\) from 10 to \(10^7\). The
reference is the exact sum, from compensated summation in long double. All terms are positive, so \(\sum\lvert x_i\rvert=s\) and the bounds apply to the relative error directly.

```{cpp, results="markdown", file="figures/custom_op_kernel_sum.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

namespace nn = dm::nn;
using nn::Tensor;

int main() {
  std::filesystem::create_directories("build");
  // Rows of n float32 values drawn uniformly from (0, 1), for n from 10 to 10^7.
  // Reference: the exact sum, from long double Kahan summation of the exactly converted values.
  nn::Generator gen(11);
  const std::int64_t N = 10'000'000;
  const auto all = nn::uniform({N}, 0.0, 1.0, gen).to_vector<float>();
  const nn::Summation methods[] = {nn::Summation::Naive, nn::Summation::Pairwise, nn::Summation::Kahan, nn::Summation::WideAccumulator};
  std::vector<double> lns;
  std::vector<std::vector<double>> errs(4), bounds(4);
  std::print("| n | exact sum | naive | pairwise | Kahan | wide accumulator | naive bound | pairwise bound |\n");
  std::print("| ---: | ---: | ---: | ---: | ---: | ---: | ---: | ---: |\n");
  for (double e = 1.0; e <= 7.0 + 1e-9; e += 0.25) {
    const auto n = static_cast<std::int64_t>(std::llround(std::pow(10.0, e)));
    long double s = 0, c = 0;
    for (std::int64_t i = 0; i < n; ++i) {
      const long double yv = static_cast<long double>(all[i]) - c, t = s + yv;
      c = (t - s) - yv;
      s = t;
    }
    lns.push_back(e);
    std::vector<double> rel(4);
    for (int m = 0; m < 4; ++m) {
      const float got = nn::sum_with(all.data(), n, methods[m]);
      rel[m] = std::abs(static_cast<long double>(got) - s) / s;  // all terms positive: sum |x| = s
      errs[m].push_back(std::log10(std::max(rel[m], 1e-10)));
      bounds[m].push_back(std::log10(nn::summation_error_bound(methods[m], n, nn::DType::Float32)));
    }
    if (std::abs(e - std::round(e)) < 1e-9)
      std::print("| 10^{:.0f} | {:.1f} | {:.1e} | {:.1e} | {:.1e} | {:.1e} | {:.1e} | {:.1e} |\n", e, static_cast<double>(s), rel[0], rel[1], rel[2], rel[3],
                 nn::summation_error_bound(nn::Summation::Naive, n, nn::DType::Float32),
                 nn::summation_error_bound(nn::Summation::Pairwise, n, nn::DType::Float32));
  }
  std::print("\nUnit roundoff of float32: u = 2^-24 = {:.2e}. \n", std::ldexp(1.0, -24));
  // nn::sum agrees with the wide accumulator.
  const float lib = nn::sum(nn::from_vector(all, {})).item<float>();
  std::print("nn::sum of all 10^7 values = {:.1f}, wide accumulator = {:.1f}\n", lib, nn::sum_with(all.data(), N, nn::Summation::WideAccumulator));

  auto plot = dm::graphics::RPlot::create();
  const dm::graphics::RGB col[] = {{220, 38, 38}, {234, 140, 0}, {37, 99, 235}, {22, 163, 74}};
  const dm::graphics::RGB light[] = {{252, 165, 165}, {253, 205, 140}, {147, 197, 253}, {134, 239, 172}};
  for (int m = 0; m < 2; ++m) {
    std::vector<double> bx, by;
    for (std::size_t i = 0; i < lns.size(); ++i)
      if (bounds[m][i] <= 0) bx.push_back(lns[i]), by.push_back(bounds[m][i]);
    plot.lines(bx, by, nn::summation_name(methods[m]) + " bound", light[m], 1.5);
  }
  std::vector<double> rx{1, 7}, ry{std::log10(std::sqrt(10.0) * std::ldexp(1.0, -24)), std::log10(std::sqrt(1e7) * std::ldexp(1.0, -24))};
  plot.lines(rx, ry, "√n u", dm::graphics::RGB{148, 163, 184}, 1.5);
  for (int m = 0; m < 4; ++m) plot.lines(lns, errs[m], nn::summation_name(methods[m]), col[m], 2.0).points(lns, errs[m], "", col[m], 4.0);
  plot.x_limits(1, 7).y_limits(-10, 1).title("Relative error of a float32 sum of n uniform(0, 1) values")
      .x_label("log10 n").y_label("log10 relative error");
  plot.size(1100, 500);
  plot.save_svg("build/custom_op_kernel_sum.svg");
}
```
