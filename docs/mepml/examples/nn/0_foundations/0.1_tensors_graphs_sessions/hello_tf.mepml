// result_end

The table is `nn::build_info().to_markdown()`. This build calls a CBLAS for float GEMM and LAPACK for dense linear algebra, and may use
the number of threads shown. The first operations need no session: \(a+b\) and \(ab\) have values as soon as the calls return. By hand,
\(ab=\begin{pmatrix}1\cdot5+2\cdot7&1\cdot6+2\cdot8\\3\cdot5+4\cdot7&3\cdot6+4\cdot8\end{pmatrix}=\begin{pmatrix}19&22\\43&50\end{pmatrix}\), which takes eight multiplications and eight additions, \(2\cdot2^3=16\) flops.

> Checking the theory

>> Throughput: arithmetic-bound against memory-bound

The program times `nn::matmul` in float32 and float64, two triple loops in float32, and an elementwise addition, for square matrices from
\(n=32\) to 1024. Each time is the best of several runs.

```{cpp, results="markdown", file="figures/hello_tf_gemm.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

namespace nn = dm::nn;
using nn::Tensor;

// Textbook triple loops over row-major float32 matrices: C = A B.
void matmul_ijk(const float* A, const float* B, float* C, int n) {  // inner loop strides down a column of B
  for (int i = 0; i < n; ++i)
    for (int j = 0; j < n; ++j) {
      float s = 0;
      for (int k = 0; k < n; ++k) s += A[i * n + k] * B[k * n + j];
      C[i * n + j] = s;
    }
}
void matmul_ikj(const float* A, const float* B, float* C, int n) {  // inner loop walks rows: unit stride
  std::fill(C, C + n * n, 0.0f);
  for (int i = 0; i < n; ++i)
    for (int k = 0; k < n; ++k) {
      const float a = A[i * n + k];
      for (int j = 0; j < n; ++j) C[i * n + j] += a * B[k * n + j];
    }
}

int main() {
  std::filesystem::create_directories("build");
  nn::NoGradGuard guard;
  nn::Generator gen(1);
  auto best_seconds = [](auto&& body, double budget) {
    double best = 1e300, spent = 0;
    for (int r = 0; r < 50 && (r < 3 || spent < budget); ++r) {
      const auto t0 = std::chrono::steady_clock::now();
      body();
      const double s = std::chrono::duration<double>(std::chrono::steady_clock::now() - t0).count();
      best = std::min(best, s), spent += s;
    }
    return best;
  };
  std::print("| n | flops 2n³ | nn::matmul float32 (GFLOP/s) | nn::matmul float64 | triple loop i-k-j | triple loop i-j-k | elementwise add (GFLOP/s) |\n");
  std::print("| ---: | ---: | ---: | ---: | ---: | ---: | ---: |\n");
  std::vector<double> ln, g32, g64, gikj, gijk, gadd;
  for (int n : {32, 64, 128, 256, 512, 1024}) {
    const Tensor A = nn::normal({n, n}, 0, 1, gen), B = nn::normal({n, n}, 0, 1, gen);
    const Tensor A64 = nn::cast(A, nn::DType::Float64), B64 = nn::cast(B, nn::DType::Float64);
    const double f = nn::matmul_flops(n, n, n);
    const double t32 = best_seconds([&] { (void)nn::matmul(A, B); }, 0.3);
    const double t64 = best_seconds([&] { (void)nn::matmul(A64, B64); }, 0.3);
    const double tadd = best_seconds([&] { (void)(A + B); }, 0.2);
    const auto av = A.to_vector<float>(), bv = B.to_vector<float>();
    std::vector<float> cv(static_cast<std::size_t>(n) * n);
    const double tikj = n <= 1024 ? best_seconds([&] { matmul_ikj(av.data(), bv.data(), cv.data(), n); }, 0.3) : 0;
    const double tijk = n <= 512 ? best_seconds([&] { matmul_ijk(av.data(), bv.data(), cv.data(), n); }, 0.3) : 0;
    ln.push_back(std::log2(n));
    g32.push_back(f / t32 / 1e9), g64.push_back(f / t64 / 1e9), gikj.push_back(f / tikj / 1e9), gadd.push_back(double(n) * n / tadd / 1e9);
    if (n <= 512) gijk.push_back(f / tijk / 1e9);
    std::print("| {} | {:.2e} | {:.1f} | {:.1f} | {:.2f} | {} | {:.2f} |\n", n, f, g32.back(), g64.back(), gikj.back(),
               n <= 512 ? std::format("{:.2f}", gijk.back()) : std::string("not run"), gadd.back());
  }
  std::print("\nArithmetic intensity at n = 1024: matmul {:.0f} flops per byte of its inputs and output, elementwise add {:.3f}.\n",
             nn::matmul_flops(1024, 1024, 1024) / (3.0 * 1024 * 1024 * 4), 1.0 / 12.0);

  auto plot = dm::graphics::RPlot::create();
  auto lg = [](std::vector<double> v) { for (auto& e : v) e = std::log10(e); return v; };
  std::vector<double> ln5(ln.begin(), ln.begin() + 5);
  plot.lines(ln, lg(g32), "nn::matmul float32", dm::graphics::RGB{37, 99, 235}, 2.0).points(ln, lg(g32), "", dm::graphics::RGB{37, 99, 235}, 5.0);
  plot.lines(ln, lg(g64), "nn::matmul float64", dm::graphics::RGB{22, 163, 74}, 2.0).points(ln, lg(g64), "", dm::graphics::RGB{22, 163, 74}, 5.0);
  plot.lines(ln, lg(gikj), "loop i-k-j", dm::graphics::RGB{234, 140, 0}, 2.0).points(ln, lg(gikj), "", dm::graphics::RGB{234, 140, 0}, 5.0);
  plot.lines(ln5, lg(gijk), "loop i-j-k", dm::graphics::RGB{220, 38, 38}, 2.0).points(ln5, lg(gijk), "", dm::graphics::RGB{220, 38, 38}, 5.0);
  plot.lines(ln, lg(gadd), "elementwise add", dm::graphics::RGB{148, 163, 184}, 2.0).points(ln, lg(gadd), "", dm::graphics::RGB{148, 163, 184}, 5.0);
  plot.x_limits(5, 10).y_limits(0, 3.8).title("Throughput against matrix size").x_label("log2 n").y_label("log10 GFLOP/s");
  plot.size(1100, 480);
  plot.save_svg("build/hello_tf_gemm.svg");
}
```
