> Simple examples

A two-pixel grayscale ramp 0,255 enlarged to four columns becomes 0,.25,.75,1. The same channel value is repeated into R, G and B.

```{cpp, results="markdown", file="figures/image_folder_loader_resize.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <datamunge/image/png.hpp>
int main(){
 namespace n=dm::nn;namespace im=dm::image;
 std::filesystem::create_directories("build/images/ant");std::filesystem::create_directories("build/images/zebra");
 std::filesystem::create_directories("build/validation/zebra");
 im::Image ramp(2,1,im::ImageMode::Grayscale);ramp.data()[0]=0;ramp.data()[1]=255;
 im::write_png(ramp,"build/images/ant/ramp.png");im::write_png(ramp,"build/images/zebra/ramp.png");im::write_png(ramp,"build/validation/zebra/ramp.png");
 const auto folder=n::scan_image_folder("build/images"),val=n::scan_image_folder("build/validation",folder.class_names);
 const auto x=n::load_image_batch(folder.images,{1,0},1,4);
 std::vector<double> red;for(int i=0;i<4;++i)red.push_back(x.images.at({0,0,i,0}));
 auto p=dm::graphics::RPlot::create();p.lines({0,1,2,3},red,"resized grayscale")
 .title("Half-pixel interpolation with clamped borders").x_label("output column").y_label("normalised value");
 p.size(820,420).save_svg("build/image_folder_loader_resize.svg");
 if(std::abs(red[0])+std::abs(red[1]-.25)+std::abs(red[2]-.75)+std::abs(red[3]-1)>1e-6||val.images[0].label!=1||x.labels.at({0})!=1)return 1;
 dm::dstruct::DataFrame t;t.add_column("column",std::vector<double>{0,1,2,3});t.add_column("R_equals_G_equals_B",red);
 std::print("{}\n\nTraining labels: ant=0, zebra=1; validation zebra label: {}.\n",t.to_md(),val.images[0].label);
}
```
// result_begin: markdown
| column | R_equals_G_equals_B |
| ---: | ---: |
| 0 | 0.000 |
| 1 | 0.250 |
| 2 | 0.750 |
| 3 | 1.000 |


Training labels: ant=0, zebra=1; validation zebra label: 1.
\image(figures/image_folder_loader_resize.svg)
