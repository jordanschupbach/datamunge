> Simple examples

One generated record has fine label 7 and constant red, green and blue planes 0, 127 and 254. CIFAR-100 adds coarse label 3 without changing the image.

```{cpp, results="markdown", file="figures/cifar_loader_channels.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
  namespace d=dm::nn::data; namespace n=dm::nn;
  dm::dstruct::DataFrame table; std::vector<double> format,coarse,fine,red,green,blue;
  for(auto kind:{d::Cifar::k10,d::Cifar::k100}) {
    d::Bytes bytes; if(kind==d::Cifar::k100) bytes.push_back(3); bytes.push_back(7);
    for(int c=0;c<3;++c) bytes.insert(bytes.end(),1024,static_cast<unsigned char>(127*c));
    const auto decoded=d::ParseCifar({bytes},kind);
    const auto x=n::cast(decoded.images,n::DType::Float64)/255.;
    format.push_back(kind==d::Cifar::k10?10:100);coarse.push_back(decoded.coarse_labels.defined()?decoded.coarse_labels.item():-1);
    fine.push_back(decoded.labels.item());red.push_back(x.at({0,0,0,0}));green.push_back(x.at({0,0,0,1}));blue.push_back(x.at({0,0,0,2}));
  }
  table.add_column("format",format);table.add_column("coarse_or_minus_one",coarse);table.add_column("fine",fine);
  table.add_column("red",red);table.add_column("green",green);table.add_column("blue",blue);
  auto p=dm::graphics::RPlot::create();p.bars({0,1,2},{red[0],green[0],blue[0]},"normalised channel",{37,99,235},.5)
    .title("Planar bytes become RGB coordinates").x_label("channel: red=0, green=1, blue=2").y_label("value").y_limits(0,1.2);
  std::filesystem::create_directories("build");p.size(820,420).save_svg("build/cifar_loader_channels.svg");
  std::print("{}\n",table.to_md(6));
}
```
// result_begin: markdown
| format | coarse_or_minus_one | fine | red | green | blue |
| ---: | ---: | ---: | ---: | ---: | ---: |
| 10 | -1 | 7 | 0 | 0.498039 | 0.996078 |
| 100 | 3 | 7 | 0 | 0.498039 | 0.996078 |

