> Checking the theory

A varying byte pattern tests all 6144 image coordinates, not just three means. We then damage one property at a time.

```{cpp, results="markdown", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
 namespace d=dm::nn::data; namespace n=dm::nn;
 dm::dstruct::DataFrame table;std::vector<double> formats,checked,rejected;
 for(auto kind:{d::Cifar::k10,d::Cifar::k100}) {
   std::vector<d::Bytes> files;
   for(int r=0;r<2;++r) {
     d::Bytes b;if(kind==d::Cifar::k100)b.push_back(4+r);b.push_back(3+r);
     for(int c=0;c<3;++c)for(int p=0;p<1024;++p)b.push_back((17*r+61*c+p)%256);
     files.push_back(b);
   }
   const auto batch=d::ParseCifar(files,kind);int count=0,bad=0;
   for(int r=0;r<2;++r)for(int p=0;p<1024;++p)for(int c=0;c<3;++c) {
     if(batch.images.at({r,p/32,p%32,c})!=(17*r+61*c+p)%256)return 1;++count;
   }
   for(int mode=0;mode<4;++mode) {
     auto b=files[0];if(mode==0)b.clear();if(mode==1)b.pop_back();if(mode==2)b.push_back(0);if(mode==3)b[0]=255;
     try{d::ParseCifar({b},kind);}catch(const std::invalid_argument&){++bad;}
   }
   const auto images=n::take_rows(batch.images,{1,0}),labels=n::take_rows(batch.labels,{1,0});
   if(labels.at({0})!=4 || images.at({0,0,0,0})!=17 || bad!=4)return 1;
   formats.push_back(kind==d::Cifar::k10?10:100);checked.push_back(count);rejected.push_back(bad);
 }
 table.add_column("format",formats);table.add_column("coordinates_checked",checked);table.add_column("malformed_rejected",rejected);
 std::print("{}\n",table.to_md());
}
```
// result_begin: markdown
| format | coordinates_checked | malformed_rejected |
| ---: | ---: | ---: |
| 10 | 6144 | 4 |
| 100 | 6144 | 4 |
// result_end


> Conclusion

Every raw coordinate follows the documented permutation, and paired gathering preserves row labels.
The fixtures establish decoding and error detection, not performance on the real CIFAR images.
Use the authors' binary archive, rather than the Python pickle archive, with these loaders.

> References

- [Krizhevsky, Nair and Hinton: CIFAR dataset and binary layouts](https://www.cs.toronto.edu/~kriz/cifar.html).
