\documentclass[tikz,border=10pt]{standalone}
\usetikzlibrary{arrows.meta,positioning}
\begin{document}
\begin{tikzpicture}[>=Stealth,font=\sffamily\large,box/.style={draw,rounded corners,align=center,text width=4.5cm,minimum height=1.8cm,fill=blue!7,inner sep=6pt}]
\node[box] (n0) at (0.0,0) {Training rows only\\moments + vocabulary};
\node[box] (n1) at (5.2,0) {Fixed feature state\\$\mu,s$, known strings};
\node[box] (n2) at (10.4,0) {Any later rows\\values + indicators};
\draw[->,thick] (n0)--(n1);
\draw[->,thick] (n1)--(n2);
\end{tikzpicture}
\end{document}
