// result_end
\caption(CutMix labels follow clipped area; mixup labels follow the same interpolation)
\alttext(Image + target; (x,y) and (x_\pi,y_\pi) Then Blend or paste; measure actual area Then Same target weight; \lambda y+(1-\lambda)y_\pi.)

> Simple examples

Images with constant values .2 and .8 make every mixture visible. At lambda=.25, mixup gives .65 and target (.25,.75). A rectangle (-1,2,3,4) on a 4 by 4 image replaces only four pixels, so CutMix retains .75.

```{cpp, results="markdown", file="figures/data_augmentation_mixing.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
 namespace n=dm::nn;namespace a=n::augment;
 const auto x=n::concat({n::full({1,4,4,1},.2),n::full({1,4,4,1},.8)},0), y=n::tensor({{1,0},{0,1}});
 const auto mix=a::mixup(x,y,{1,0},.25),cut=a::cutmix(x,y,{1,0},{-1,2,3,4});
 dm::dstruct::DataFrame t;t.add_column("operation",std::vector<std::string>{"mixup","CutMix"});
 t.add_column("retained_weight",std::vector<double>{mix.weight,cut.weight});
 t.add_column("image_mean",std::vector<double>{n::mean(n::take_rows(mix.images,{0})).item(),n::mean(n::take_rows(cut.images,{0})).item()});
 t.add_column("target_class_0",std::vector<double>{mix.labels.at({0,0}),cut.labels.at({0,0})});
 auto p=dm::graphics::RPlot::create();std::vector<double> index(16);std::iota(index.begin(),index.end(),0);
 p.lines(index,n::take_rows(mix.images,{0}).to_vector<double>(),"mixup",{37,99,235})
  .lines(index,n::take_rows(cut.images,{0}).to_vector<double>(),"CutMix",{234,88,12})
  .title("Interpolation versus a clipped spatial paste").x_label("row-major pixel index").y_label("pixel value").y_limits(0,1);
 std::filesystem::create_directories("build");p.size(850,420).save_svg("build/data_augmentation_mixing.svg");
 if(std::abs(mix.images.at({0,0,0,0})-.65)>1e-6 || cut.weight!=.75)return 1;
 std::print("{}\n",t.to_md(6));
}
```
// result_begin: markdown
| operation | retained_weight | image_mean | target_class_0 |
| :--- | ---: | ---: | ---: |
| mixup | 0.25 | 0.650000 | 0.25 |
| CutMix | 0.75 | 0.350000 | 0.75 |

\image(figures/data_augmentation_mixing.svg)
// result_end
\caption(Mixup changes every pixel; CutMix changes a clipped rectangle and uses its area for the target.)
