> Simple examples

>> Eleven rows expose the short-batch arithmetic

Without shuffling, batches of four contain rows (0,1,2,3), (4,5,6,7), and
(8,9,10). If row i has fixed loss i+1, batch means are 2.5, 6.5 and 10. Their
sample-weighted mean is 66/11=6, whereas the unweighted mean of batch means is 19/3.
Dropping the last batch visits eight rows and gives mean 4.5 on that different subset.
This example uses fixed row losses so aggregation can be checked independently of an
optimizer. Dropping rows is explicit here; it changes what an epoch's metric covers.

```{cpp, results="markdown", file="figures/training_batches.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <fstream>
int main() {
  using namespace dm::nn;
  dm::dstruct::DataFrame   table;
  std::vector<std::string> policy;
  std::vector<double>      counts, means, naive;
  auto                     p    = dm::graphics::RPlot::create();
  int                      mode = 0;
  for (bool drop : {false, true}) {
    BatchOrder order(11, 4, 7, false, drop);
    order.begin_epoch();
    WeightedMean        weighted;
    std::vector<double> batch, sizes;
    double              sum_means = 0;
    for (auto rows = order.next(); !rows.empty(); rows = order.next()) {
      double mean = 0;
      for (auto row : rows)
        mean += row + 1;
      mean /= rows.size();
      weighted.add(mean, rows.size());
      sum_means += mean;
      batch.push_back(batch.size());
      sizes.push_back(rows.size());
    }
    const auto label = drop ? "drop short batch" : "keep all rows";
    policy.push_back(label);
    counts.push_back(weighted.count());
    means.push_back(weighted.value());
    naive.push_back(sum_means / batch.size());
    if (drop)
      p.points(batch, sizes, label, {220, 38, 38}, 4);
    else
      p.line(batch, sizes, label, {37, 99, 235})
          .points(batch, sizes, "kept batch sizes", {37, 99, 235}, 7);
    if (std::abs(weighted.value() - (drop ? 4.5 : 6)) > 1e-14)
      throw std::runtime_error("batch arithmetic mismatch");
  }
  table.add_column("policy", policy);
  table.add_column("observations", counts);
  table.add_column("sample_weighted_mean", means);
  table.add_column("unweighted_batch_mean", naive);
  p.title("Keeping the short batch covers all eleven rows")
      .x_label("zero-based batch index")
      .y_label("observations in batch")
      .y_limits(0, 6);
  std::filesystem::create_directories("build");
  p.size(950, 440).save_svg("build/training_batches.svg");
  std::print("{}\n", table.to_md(9));
}
```
// result_begin: markdown
| policy | observations | sample_weighted_mean | unweighted_batch_mean |
| :--- | ---: | ---: | ---: |
| keep all rows | 11 | 6.0 | 6.33333333 |
| drop short batch | 8 | 4.5 | 4.50000000 |

\image(figures/training_batches.svg)
// result_end
\caption(Short batches require sample weights; dropping them changes the covered observations.)
\alttext(A plot shows batch sizes four, four and three when all rows are kept, and only two size-four batches when the remainder is dropped. A table compares observation counts and weighted versus unweighted means.)

> An explicit minibatch fit

>> Online loss and fixed-weight evaluation use different models

The 103 observations use x0=sin(.7*i), x1=cos(.4*i) and
 y=1.5*x0-.7*x1+.2. Adam starts at zero with rate .03. Each of fifty seeded shuffled
epochs visits every row exactly once in six batches of sixteen plus one of seven.
The code checks coverage, update counts and final coefficients. It records the loss
before each update for online logging, then separately evaluates all rows at the final
epoch weights. The plot shows log10 losses, clamped below 1e-16 only for display.
The printed MSE is the raw value. A common reduction in both curves does not make
the online curve a measurement of the final model or a held-out performance estimate.

```{cpp, results="markdown", file="figures/training_fit.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <fstream>
int main() {
  using namespace dm::nn;
  set_num_threads(2);
  std::vector<float> xv(206), yv(103);
  for (int i = 0; i < 103; ++i) {
    float a = std::sin(i * .7f), c = std::cos(i * .4f);
    xv[2 * i]     = a;
    xv[2 * i + 1] = c;
    yv[i]         = 1.5f * a - .7f * c + .2f;
  }
  const auto x = from_vector(xv, {103, 2}), y = from_vector(yv, {103, 1});
  auto       w = zeros({2, 1}).requires_grad_(), b = zeros({1}).requires_grad_();
  auto       loss = [&](const Tensor& input, const Tensor& label) {
    return mean(square(bias_add(matmul(input, w), b) - label));
  };
  OptimizerConfig c;
  c.kind = OptimizerKind::Adam;
  Optimizer           opt({w, b}, .03, c);
  BatchOrder          order(103, 16, 42);
  std::vector<double> epochs, online, fixed, shown, online_table, fixed_table, updates;
  for (int epoch = 1; epoch <= 50; ++epoch) {
    order.begin_epoch();
    WeightedMean     meter;
    std::vector<int> visited(103, 0);
    int              batches = 0;
    for (auto rows = order.next(); !rows.empty(); rows = order.next()) {
      for (auto row : rows)
        if (++visited[row] != 1)
          throw std::runtime_error("duplicate row");
      const auto   objective = loss(take_rows(x, rows), take_rows(y, rows));
      const double before    = objective.item();
      opt.minimize(objective);
      meter.add(before, rows.size());
      ++batches;
    }
    if (meter.count() != 103 || batches != 7 ||
        std::any_of(visited.begin(), visited.end(), [](int n) { return n != 1; }))
      throw std::runtime_error("incomplete epoch");
    const double evaluation = loss(x, y).item();
    epochs.push_back(epoch);
    online.push_back(std::log10(std::max(1e-16, meter.value())));
    fixed.push_back(std::log10(std::max(1e-16, evaluation)));
    if (epoch == 1 || epoch % 10 == 0) {
      shown.push_back(epoch);
      online_table.push_back(meter.value());
      fixed_table.push_back(evaluation);
      updates.push_back(opt.iterations());
    }
  }
  const auto weights = w.to_vector<double>();
  if (loss(x, y).item() >= 1e-9 || std::abs(weights[0] - 1.5) > 1e-4 ||
      std::abs(weights[1] + .7) > 1e-4 || std::abs(b.item() - .2) > 1e-4 || opt.iterations() != 350)
    throw std::runtime_error("regression reference mismatch");
  dm::dstruct::DataFrame table;
  table.add_column("epoch", shown);
  table.add_column("online_mse", online_table);
  table.add_column("fixed_weight_mse", fixed_table);
  table.add_column("completed_updates", updates);
  auto p = dm::graphics::RPlot::create();
  p.line(epochs, online, "online batches", {37, 99, 235})
      .line(epochs, fixed, "fixed weights", {220, 38, 38})
      .title("The metric's parameter state matters")
      .x_label("completed epochs")
      .y_label("log10 MSE")
      .y_limits(-16, 2);
  std::filesystem::create_directories("build");
  p.size(950, 460).save_svg("build/training_fit.svg");
  std::print(
      "{}\n\nFinal weights: ({:.9f}, {:.9f}); bias: {:.9f}; raw fixed-weight MSE: {:.9e}; updates: "
      "{}.\n",
      table.to_md(12),
      weights[0],
      weights[1],
      b.item(),
      loss(x, y).item(),
      opt.iterations());
}
```
