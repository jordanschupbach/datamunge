> Checking reproducible ordering

>> Restore the current order and future RNG stream

The original sampler consumes the first four of eleven rows, then saves its text
state locally. A new sampler with a different seed restores that snapshot. We compare
the remaining seven rows and all rows in three future epochs, batch by batch. Every
emitted row agrees and the saved cursor is four. Appending invalid trailing text must
throw without changing the restored sampler. Exact sequences depend on the C++ shuffle
implementation; the check runs both samplers in the same toolchain. To resume the fit,
pair this sampler snapshot with the matching model/optimizer checkpoint from the
early-stopping/checkpoint report, rather than restoring only row order.

```{cpp, results="markdown", file="figures/training_resume.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <fstream>
int main() {
  using namespace dm::nn;
  BatchOrder original(11, 4, 7), restored(11, 4, 999);
  original.begin_epoch();
  const auto first = original.next();
  std::filesystem::create_directories("build");
  {
    std::ofstream out("build/training_sampler.txt");
    if (!out)
      throw std::runtime_error("snapshot open failed");
    out << original.save_state();
    if (!out)
      throw std::runtime_error("snapshot write failed");
  }
  std::ifstream     in("build/training_sampler.txt");
  const std::string state((std::istreambuf_iterator<char>(in)), std::istreambuf_iterator<char>());
  restored.restore_state(state);
  if (restored.cursor() != 4)
    throw std::runtime_error("wrong restored cursor");
  std::vector<double> position, rows, difference, phase, checked;
  for (int epoch = 0; epoch < 4; ++epoch) {
    if (epoch) {
      original.begin_epoch();
      restored.begin_epoch();
    }
    int count = 0;
    for (;;) {
      const auto a = original.next(), b = restored.next();
      if (a != b)
        throw std::runtime_error("restored batch differs");
      if (a.empty())
        break;
      for (std::size_t i = 0; i < a.size(); ++i) {
        position.push_back(position.size());
        rows.push_back(a[i]);
        difference.push_back(std::abs(double(a[i] - b[i])));
        ++count;
      }
    }
    phase.push_back(epoch);
    checked.push_back(count);
  }
  const auto before   = restored.save_state();
  bool       rejected = false;
  try {
    restored.restore_state(before + " bad");
  } catch (const std::invalid_argument&) {
    rejected = true;
  }
  if (!rejected || restored.save_state() != before || rows.size() != 40)
    throw std::runtime_error("state validation mismatch");
  dm::dstruct::DataFrame table;
  table.add_column("phase_0_is_current_remainder", phase);
  table.add_column("identical_emitted_rows", checked);
  auto order = dm::graphics::RPlot::create(), equal = dm::graphics::RPlot::create();
  order.points(position, rows, "row order", {37, 99, 235}, 4)
      .title("Remainder followed by three future epochs")
      .x_label("emitted position after snapshot")
      .y_label("dataset row index")
      .y_limits(-1, 13);
  equal.line(position, difference, "absolute difference", {22, 163, 74})
      .title("Every restored row matches exactly")
      .x_label("emitted position after snapshot")
      .y_label("original minus restored, absolute")
      .y_limits(-.2, 1);
  std::filesystem::create_directories("build");
  dm::graphics::RLayout::create(1, 2).add(order).add(equal).size(1100, 490).fit_panels().save_svg(
      "build/training_resume.svg");
  std::print(
      "{}\n\nSaved cursor: 4; matched emitted rows: {}; invalid state rejected without mutation.\n",
      table.to_md(0),
      rows.size());
}
```
