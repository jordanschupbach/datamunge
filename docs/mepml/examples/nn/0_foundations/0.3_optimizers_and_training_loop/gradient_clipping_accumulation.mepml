dvisvgm --no-fonts --bbox=10 --output=build/gradient_clipping_accumulation_concept.svg build/gradient_clipping_accumulation_concept.dvi > build/gradient_clipping_accumulation.render.log 2>&1
printf 'Rendered build/gradient_clipping_accumulation_concept.svg from local TikZ source.\n'
