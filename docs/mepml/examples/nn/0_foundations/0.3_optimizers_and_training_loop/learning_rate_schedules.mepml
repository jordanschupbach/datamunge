> Simple examples

>> All schedule families on one update clock

Use step/exponential factor .5 and interval ten; cosine duration forty; warmup ten;
a one-cycle rise of ten within a forty-update duration; and triangular half-period ten
with amplitude decay .5. Values after forty make the clamped tails visible. The table
samples endpoints, while the curves show every integer update. The families have different
integrated rates, so identical peak rates are not an equal optimization budget.

```{cpp, results="markdown", file="figures/schedule_families.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
  namespace sch                        = dm::nn::schedule;
  const std::vector<std::string> names = {
      "step", "exponential", "cosine", "warmup", "warmup cosine", "one cycle", "cyclical"};
  const std::vector<std::function<double(std::int64_t)>> functions = {
      [](auto t) { return sch::step_decay(.1, .5, 10, t); },
      [](auto t) { return sch::exponential(.1, .5, 10, t); },
      [](auto t) { return sch::cosine(.1, .01, 40, t); },
      [](auto t) { return sch::warmup(.1, 10, t); },
      [](auto t) { return sch::warmup_cosine(.1, .01, 10, 40, t); },
      [](auto t) { return sch::one_cycle(.01, .1, .001, 10, 40, t); },
      [](auto t) { return sch::cyclical(.01, .1, 10, t, .5); }};
  const std::vector<dm::graphics::RGB> colors = {
      {37, 99, 235}, {220, 38, 38}, {22, 163, 74}, {124, 58, 237}};
  auto decay = dm::graphics::RPlot::create(), rise = dm::graphics::RPlot::create();
  dm::dstruct::DataFrame   table;
  std::vector<std::string> rule;
  std::vector<double>      sampled_step, sampled_rate;
  for (std::size_t i = 0; i < functions.size(); ++i) {
    std::vector<double> t, rate;
    for (int j = 0; j <= 60; ++j) {
      t.push_back(j);
      rate.push_back(functions[i](j));
      if (j == 0 || j == 10 || j == 20 || j == 40 || j == 60) {
        rule.push_back(names[i]);
        sampled_step.push_back(j);
        sampled_rate.push_back(rate.back());
      }
    }
    (i < 3 ? decay : rise).lines(t, rate, names[i], colors[i < 3 ? i : i - 3]);
  }
  table.add_column("schedule", rule);
  table.add_column("completed_updates", sampled_step);
  table.add_column("next_rate", sampled_rate);
  decay.title("Decay and a clamped cosine tail")
      .x_label("completed optimizer updates")
      .y_label("next learning rate")
      .y_limits(0, .15);
  rise.title("Warmup, one cycle and repeated cycles")
      .x_label("completed optimizer updates")
      .y_label("next learning rate")
      .y_limits(0, .18);
  std::filesystem::create_directories("build");
  dm::graphics::RLayout::create(1, 2).add(decay).add(rise).size(1100, 490).fit_panels().save_svg(
      "build/schedule_families.svg");
  std::print("{}\n", table.to_md(6));
}
```
