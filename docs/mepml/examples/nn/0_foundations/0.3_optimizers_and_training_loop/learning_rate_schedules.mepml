> Checking the theory

>> Scheduled SGD matches a product formula

For f(w)=w²/2, SGD gives w_(t+1)=(1−eta_t)w_t. Therefore after T updates,
\(w_T=w_0\prod_{t=0}^{T-1}(1-\eta_t)\). The program independently multiplies
these factors and compares its result after every tensor-autograd update. Rates are
read from the completed-call counter and set before minimize(). This checks indexing,
not a claim that the illustrated schedules are optimally tuned.

```{cpp, results="markdown", file="figures/schedule_product.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
  const std::vector<std::string> names = {"constant", "warmup cosine", "exponential"};
  const std::vector<std::function<double(std::int64_t)>> schedules = {
      [](auto) { return .1; },
      [](auto t) { return dm::nn::schedule::warmup_cosine(.1, .01, 10, 40, t); },
      [](auto t) { return dm::nn::schedule::exponential(.1, .5, 10, t); }};
  const std::vector<dm::graphics::RGB> colors = {{37, 99, 235}, {220, 38, 38}, {22, 163, 74}};
  auto                                 p      = dm::graphics::RPlot::create();
  dm::dstruct::DataFrame               table;
  for (std::size_t k = 0; k < schedules.size(); ++k) {
    auto                w = dm::nn::from_vector(std::vector<double>{2}).requires_grad_();
    dm::nn::Optimizer   opt({w}, 0);
    double              expected = 2, worst = 0;
    std::vector<double> step, weight;
    for (int i = 0; i < 50; ++i) {
      const double rate = schedules[k](opt.iterations());
      expected *= 1 - rate;
      opt.set_learning_rate(rate);
      opt.minimize(dm::nn::sum(dm::nn::square(w)) * .5);
      worst = std::max(worst, std::abs(w.item<double>() - expected));
      step.push_back(opt.iterations());
      weight.push_back(w.item<double>());
    }
    if (worst > 1e-13)
      throw std::runtime_error("scheduled SGD differs from product");
    p.lines(step, weight, names[k], colors[k]);
    dm::dstruct::DataFrame row;
    row.add_column("schedule", std::vector<std::string>{names[k]});
    row.add_column("final_weight", std::vector<double>{w.item<double>()});
    row.add_column("product_reference", std::vector<double>{expected});
    row.add_column("max_error", std::vector<double>{worst});
    row.add_column("updates", std::vector<double>{double(opt.iterations())});
    table = k ? table.concat_rows(row) : row;
  }
  p.title("A schedule changes the contraction product")
      .x_label("completed updates after each step")
      .y_label("parameter w")
      .y_limits(0, 3);
  std::filesystem::create_directories("build");
  p.size(900, 440).save_svg("build/schedule_product.svg");
  std::print(
      "{}\n",
      table.to_md(
          dm::dstruct::DataFrame::MarkdownOptions{.digits = 9, .scientific = {"max_error"}}));
}
```
