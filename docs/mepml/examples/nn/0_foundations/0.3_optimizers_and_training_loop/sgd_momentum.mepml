\image(figures/sgd_stream.svg)
// result_end
\caption(The same prescribed gradients and rates produce different trajectories because the update rules retain and use state differently.)
\alttext(Three parameter trajectories appear against update number; the table exposes each gradient, rate, updated velocity and resulting parameter.)

> Checking the theory

>> Two curvatures give slow and stiff directions

Use f(x,y)=(x²+100y²)/2, initial (4,4), rate .01 and mu .9. The same settings
are shown for all three rules to make their geometry comparable; these are not separately
tuned optima. The rate is strictly stable in each stiff mode. The log-loss plot shows
transient behaviour as well as eventual contraction. Coordinates are retained at every
update, including the initial state, and the whole-objective loss is not a minibatch mean.

```{cpp, results="markdown", file="figures/sgd_quadratic.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
  auto                   path = dm::graphics::RPlot::create(), loss = dm::graphics::RPlot::create();
  dm::dstruct::DataFrame results;
  const std::vector<dm::graphics::RGB>     colors = {{37, 99, 235}, {220, 38, 38}, {22, 163, 74}};
  const std::vector<dm::nn::OptimizerKind> kinds  = {
      dm::nn::OptimizerKind::Sgd, dm::nn::OptimizerKind::Momentum, dm::nn::OptimizerKind::Nesterov};
  for (std::size_t k = 0; k < kinds.size(); ++k) {
    dm::nn::OptimizerConfig c;
    c.kind          = kinds[k];
    const auto t    = dm::nn::optimizer_quadratic_trace({1, 100}, {4, 4}, 300, .01, c);
    const auto x    = t.filter([](const auto& r) { return r.get_double("coordinate") == 0; }),
               y    = t.filter([](const auto& r) { return r.get_double("coordinate") == 1; });
    const auto name = dm::nn::optimizer_name(kinds[k]);
    path.lines(
        x.numeric_column("weight").values(), y.numeric_column("weight").values(), name, colors[k]);
    auto logloss = x.numeric_column("loss").values();
    for (auto& v : logloss)
      v = std::log10(std::max(v, 1e-30));
    loss.lines(x.numeric_column("step").values(), logloss, name, colors[k]);
    auto row = x.tail(1).select({"step", "weight", "loss"});
    row.add_column("rule", std::vector<std::string>{name});
    row.add_column(
        "slow_radius", std::vector<double>{dm::nn::optimizer_mode_radius(kinds[k], .01, .9)});
    row.add_column(
        "stiff_radius", std::vector<double>{dm::nn::optimizer_mode_radius(kinds[k], 1, .9)});
    results = k ? results.concat_rows(row) : row;
  }
  path.title("Two-coordinate quadratic trajectories")
      .x_label("soft coordinate x")
      .y_label("stiff coordinate y")
      .y_limits(-5, 7);
  loss.title("Transient and asymptotic loss")
      .x_label("update")
      .y_label("log10 objective")
      .y_limits(-30, 12);
  std::filesystem::create_directories("build");
  dm::graphics::RLayout::create(1, 2).add(path).add(loss).size(1100, 490).fit_panels().save_svg(
      "build/sgd_quadratic.svg");
  std::print(
      "{}\n",
      results.select({"rule", "step", "weight", "loss", "slow_radius", "stiff_radius"})
          .to_md(dm::dstruct::DataFrame::MarkdownOptions{.digits = 9, .scientific = {"loss"}}));
}
```
