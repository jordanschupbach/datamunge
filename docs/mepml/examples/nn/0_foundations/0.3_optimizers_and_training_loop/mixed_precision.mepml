>> Scaling crosses the rounded-gradient boundary

For L=q(w)*1e-8 at w=1, q has the explicitly rounded VJP described above.
Without scaling the incoming 1e-8 gradient becomes zero in binary16. A scale of
65536 moves it into range before rounding; division afterwards recovers approximately
1e-8. Recovery remains approximate because rounding still occurs. A bounded host
scale with a two-success interval grows 128 to 256 and backs off to 128 on overflow.

```{cpp, results="markdown", file="figures/mixed_scaling.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
  using namespace dm::nn;
  const auto             w = scalar(1).requires_grad_();
  dm::dstruct::DataFrame t;
  std::vector<double>    scales = {1, 128, 65536}, rounded, recovered;
  for (double scale : scales) {
    const auto          loss = quantize_precision(w, PrecisionEmulation::Float16) * 1e-8;
    const auto          g    = grad(loss * scale, {w});
    std::vector<Tensor> unscaled;
    if (!unscale_gradients(g, float(scale), &unscaled))
      throw std::runtime_error("unexpected overflow");
    rounded.push_back(g[0].item());
    recovered.push_back(unscaled[0].item());
  }
  if (recovered.front() != 0 || std::abs(recovered.back() - 1e-8) > 1e-11)
    throw std::runtime_error("scaling reference mismatch");
  t.add_column("scale", scales);
  t.add_column("rounded_scaled_gradient", rounded);
  t.add_column("unscaled_gradient", recovered);
  DynamicLossScale    policy(128, 2, 1, 256);
  std::vector<double> states = {policy.value()};
  policy.applied();
  states.push_back(policy.value());
  policy.applied();
  states.push_back(policy.value());
  policy.overflow();
  states.push_back(policy.value());
  auto                tiny = dm::graphics::RPlot::create(), host = dm::graphics::RPlot::create();
  std::vector<double> units = recovered;
  for (auto& v : units)
    v /= 1e-8;
  tiny.bars({0, 1, 2}, units, "unscaled", {37, 99, 235}, .5)
      .title("Loss scaling prevents this underflow")
      .x_label("scale index: 1, 128, 65536")
      .y_label("recovered gradient / 1e-8")
      .y_limits(0, 1.5);
  host.line({0, 1, 2, 3}, states, "loss scale", {220, 38, 38})
      .points({0, 1, 2, 3}, states, "events", {220, 38, 38}, 4)
      .title("Two successes grow; overflow halves")
      .x_label("initial, success, success, overflow")
      .y_label("scale")
      .y_limits(0, 350);
  std::filesystem::create_directories("build");
  dm::graphics::RLayout::create(1, 2).add(tiny).add(host).size(1100, 490).fit_panels().save_svg(
      "build/mixed_scaling.svg");
  std::print("{}\n\nHost scales: 128, 128, 256, 128.\n", t.to_md(12));
}
```
