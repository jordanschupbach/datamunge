> Checking the theory

Here the candidates are an intercept-only predictor and an affine fit to 17 deterministic development rows. The final 31-row test uses new locations and is evaluated only after selecting.

```{cpp, results="markdown", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

int main() {
  namespace n = dm::nn;
  namespace m = n::ml;
  const auto dtype = n::DType::Float64;
  const auto x = n::linspace(-1, 1, 17, dtype).reshape({17, 1}),
             y = 1 + 2 * x + .1 * n::sin(7 * x);
  const auto folds = m::KFold(17, 4, 19);
  std::vector<double> candidate, score;
  for (int degree : {0, 1}) {
    // Each callback creates fresh parameters and fresh optimizer state.
    const auto result = m::CrossValidate(folds, [&](const auto &tr, const auto &va) {
      const auto tx = n::take_rows(x, std::vector<int64_t>(tr.begin(), tr.end()));
      const auto ty = n::take_rows(y, std::vector<int64_t>(tr.begin(), tr.end()));
      const auto vx = n::take_rows(x, std::vector<int64_t>(va.begin(), va.end()));
      const auto vy = n::take_rows(y, std::vector<int64_t>(va.begin(), va.end()));
      const auto X = m::PolynomialFeatures(tx, degree);
      auto w = n::zeros({degree + 1, 1}, dtype).requires_grad_();
      n::OptimizerConfig config;
      config.kind = n::OptimizerKind::Sgd;
      n::Optimizer optimizer({w}, .3, config);
      for (int step = 0; step < 500; ++step) {
        const auto loss = .5 * n::mean(n::square(n::matmul(X, w) - ty));
        optimizer.minimize(loss);
      }
      n::NoGradGuard guard;
      return n::mean(n::square(n::matmul(m::PolynomialFeatures(vx, degree), w) - vy)).item();
    });
    candidate.push_back(degree);
    score.push_back(result.mean);
  }
  const int best = score[1] < score[0] ? 1 : 0;
  const auto X = m::PolynomialFeatures(x, best);
  auto w = n::zeros({best + 1, 1}, dtype).requires_grad_();
  n::OptimizerConfig config;
  config.kind = n::OptimizerKind::Sgd;
  n::Optimizer optimizer({w}, .3, config);
  for (int step = 0; step < 500; ++step) {
    optimizer.minimize(.5 * n::mean(n::square(n::matmul(X, w) - y)));
  }
  n::NoGradGuard guard;
  const auto q = n::linspace(-.95, .95, 31, dtype).reshape({31, 1});
  const double test = n::mean(n::square(n::matmul(m::PolynomialFeatures(q, best), w) -
                                        (1 + 2 * q + .1 * n::sin(7 * q))))
                          .item();
  std::vector<int> coverage(17);
  for (const auto &f : folds)
    for (auto row : f.validation)
      ++coverage[row];
  for (auto count : coverage)
    if (count != 1)
      return 1;
  dm::dstruct::DataFrame t;
  t.add_column("degree", candidate);
  t.add_column("CV_MSE", score);
  std::print("{}\n\nSelected degree {}; final separate-grid MSE {:.9f}.\n", t.to_md(8), best,
             test);
}
```
// result_begin: markdown
| degree | CV_MSE |
| ---: | ---: |
| 0 | 1.87531728 |
| 1 | 0.00553113 |


Selected degree 1; final separate-grid MSE 0.004447564.
// result_end


> Conclusion

Coverage and weighted aggregation agree with exact counts. Each callback creates a fresh fit;
final refitting is distinct from out-of-fold prediction. The final grid is a controlled synthetic
check, not a population guarantee, and no fitted global preprocessing may be shared across folds.

> References

- [Hastie, Tibshirani and Friedman: The Elements of Statistical Learning, chapter 7](https://hastie.su.domains/ElemStatLearn/).
