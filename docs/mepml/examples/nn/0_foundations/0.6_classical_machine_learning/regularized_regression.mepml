> Simple examples

A balanced two-level design has orthogonal intercept and slope. The target is 1+.2x; the intercept is never penalised.

```{cpp, results="markdown", file="figures/regularized_regression_threshold.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

int main() {
  namespace n = dm::nn;
  const auto dtype = n::DType::Float64;
  const auto x = n::tensor({-1, -1, 1, 1}, {4, 1}, dtype);
  const auto X = n::concat({n::ones_like(x), x}, 1), y = 1 + x * .2;
  const auto mask = n::tensor({0, 1}, {2, 1}, dtype);
  std::vector<double> setting, actual, expected, intercept;
  std::vector<std::string> method;
  double worst = 0;
  for (int j = 0; j < 3; ++j) {
    const double l1 = j == 0 ? 0 : .3, l2 = j == 1 ? 0 : .5, rate = .4;
    auto w = n::zeros({2, 1}, dtype).requires_grad_();
    n::OptimizerConfig config;
    config.kind = n::OptimizerKind::Sgd;
    n::Optimizer optimizer({w}, rate, config);
    for (int step = 0; step < 150; ++step) {
      const auto smooth =
          .5 * n::mean(n::square(n::matmul(X, w) - y)) + .5 * l2 * n::sum(mask * n::square(w));
      optimizer.minimize(smooth);
      // Proximal SGD: preserve the leaf retained by the optimizer.
      n::NoGradGuard guard;
      w.copy_(n::sign(w) * n::relu(n::abs(w) - rate * l1 * mask));
    }
    const double exact = std::max(.2 - l1, 0.) / (1 + l2);
    worst = std::max(worst, std::abs(w.at({1, 0}) - exact));
    if (std::abs(w.at({0, 0}) - 1) > 1e-10 || worst > 1e-10)
      return 1;
    setting.push_back(j);
    actual.push_back(w.at({1, 0}));
    expected.push_back(exact);
    intercept.push_back(w.at({0, 0}));
    method.push_back(j == 0 ? "ridge" : j == 1 ? "lasso" : "elastic net");
  }
  auto p = dm::graphics::RPlot::create();
  p.bars(setting, actual, "slope", {37, 99, 235}, .6)
      .title("SGD plus explicit L1 proximal projection")
      .x_label("ridge=0, lasso=1, elastic net=2")
      .y_label("coefficient")
      .y_limits(0, .2);
  std::filesystem::create_directories("build");
  p.size(850, 430).save_svg("build/regularized_regression_threshold.svg");
  dm::dstruct::DataFrame t;
  t.add_column("method", method);
  t.add_column("intercept", intercept);
  t.add_column("slope", actual);
  t.add_column("closed_form", expected);
  std::print("{}\n", t.to_md(8));
}
```
// result_begin: markdown
| method | intercept | slope | closed_form |
| :--- | ---: | ---: | ---: |
| ridge | 1 | 0.13333333 | 0.13333333 |
| lasso | 1 | 0.00000000 | 0.00000000 |
| elastic net | 1 | 0.00000000 | 0.00000000 |

