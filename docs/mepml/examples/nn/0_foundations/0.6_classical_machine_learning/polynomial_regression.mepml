> Checking the theory

One hundred replicas share 20 x locations and independent Gaussian noise of standard deviation .2. Degrees 1,3,12 are fixed in advance. The query grid lies inside the training interval.

```{cpp, results="markdown", file="figures/polynomial_regression_ensemble.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

int main() {
  namespace n = dm::nn;
  n::set_num_threads(2);
  n::Generator rng(17);
  const auto x = n::linspace(-1, 1, 20, n::DType::Float64).reshape({20, 1});
  const auto q = n::linspace(-1, 1, 101, n::DType::Float64).reshape({101, 1});
  const auto truth = n::sin(x * std::numbers::pi);
  const auto target = truth + n::normal({20, 100}, 0, .2, rng, n::DType::Float64);
  const auto f = n::sin(q * std::numbers::pi);
  dm::dstruct::DataFrame table;
  std::vector<double> degree, train, bias, variance, risk, identity, oracle_error;
  auto p = dm::graphics::RPlot::create();
  for (int d : {1, 3, 12}) {
    const auto X = n::ml::PolynomialFeatures(x, d), Q = n::ml::PolynomialFeatures(q, d);
    auto w = n::zeros({d + 1, 100}, n::DType::Float64).requires_grad_();
    n::OptimizerConfig config;
    config.kind = n::OptimizerKind::Sgd;
    n::Optimizer optimizer({w}, .3, config);
    for (int step = 0; step < 6000; ++step) {
      // Average over observations, sum over 100 independent fitted replicas.
      const auto loss = .5 * n::sum(n::mean(n::square(n::matmul(X, w) - target), {0}));
      optimizer.minimize(loss);
    }
    n::NoGradGuard guard;
    const auto pred = n::matmul(Q, w), average = n::mean(pred, {1}, true);
    const double b = n::mean(n::square(average - f)).item();
    const double v = n::mean(n::square(pred - average)).item();
    const double m = n::mean(n::square(pred - f)).item();
    degree.push_back(d);
    train.push_back(n::mean(n::square(n::matmul(X, w) - target)).item());
    bias.push_back(b);
    variance.push_back(v);
    risk.push_back(m);
    identity.push_back(std::abs(m - b - v));
    oracle_error.push_back(n::max(n::abs(w - n::ml::LeastSquaresQr(X, target))).item());
    if (identity.back() > 1e-10 || oracle_error.back() > 1e-6)
      return 1;
    p.lines(q.to_vector<double>(), average.to_vector<double>(), "degree " + std::to_string(d),
            d == 1   ? dm::graphics::RGB{37, 99, 235}
            : d == 3 ? dm::graphics::RGB{234, 88, 12}
                     : dm::graphics::RGB{22, 163, 74});
  }
  p.title("Mean tensor-SGD fit across 100 noisy replicas")
      .x_label("x")
      .y_label("ensemble mean");
  std::filesystem::create_directories("build");
  p.y_limits(-1.2, 1.65).size(850, 430).save_svg("build/polynomial_regression_ensemble.svg");
  table.add_column("degree", degree);
  table.add_column("train_MSE", train);
  table.add_column("bias_squared", bias);
  table.add_column("variance", variance);
  table.add_column("latent_MSE", risk);
  table.add_column("identity_error", identity);
  table.add_column("QR_check_error", oracle_error);
  std::print("{}\n", table.to_md(8));
}
```
