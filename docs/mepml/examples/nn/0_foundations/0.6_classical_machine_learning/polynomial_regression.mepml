> Simple examples

Since P2=(3x²-1)/2, x²=(1+2P2)/3. Five noise-free observations should recover Legendre coefficients (1/3,0,2/3).

```{cpp, results="markdown", file="figures/polynomial_regression_quadratic.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

int main() {
  namespace n = dm::nn;
  const auto x = n::linspace(-1, 1, 5, n::DType::Float64).reshape({5, 1});
  const auto design = n::ml::PolynomialFeatures(x, 2);
  const auto target = n::square(x);
  auto w = n::zeros({3, 1}, n::DType::Float64).requires_grad_();
  n::OptimizerConfig config;
  config.kind = n::OptimizerKind::Sgd;
  n::Optimizer optimizer({w}, .3, config);
  for (int step = 0; step < 1000; ++step) {
    const auto loss = .5 * n::mean(n::square(n::matmul(design, w) - target));
    optimizer.minimize(loss);
  }
  const auto exact = n::tensor({1. / 3, 0, 2. / 3}, {3, 1}, n::DType::Float64);
  if (n::max(n::abs(w - exact)).item() > 1e-10)
    return 1;
  auto p = dm::graphics::RPlot::create();
  p.lines(x.to_vector<double>(), n::matmul(design, w).to_vector<double>(), "tensor SGD",
          {234, 88, 12})
      .points(x.to_vector<double>(), target.to_vector<double>(), "exact squares",
              {37, 99, 235})
      .title("Optimise coefficients of fixed Legendre features")
      .x_label("x")
      .y_label("x squared");
  std::filesystem::create_directories("build");
  p.size(820, 420).save_svg("build/polynomial_regression_quadratic.svg");
  std::print("SGD Legendre coefficients: {}.\n", w.to_vector<double>());
}
```
// result_begin: markdown
SGD Legendre coefficients: [0.3333333333333335, -1.229872490653621e-21, 0.6666666666666662].
\image(figures/polynomial_regression_quadratic.svg)
// result_end
\caption(A quadratic response uses constant and second Legendre columns; its linear coefficient vanishes.)
