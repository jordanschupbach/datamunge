> Simple examples

The initial distribution is (.6,.4), transition rows (.8,.2),(.3,.7), and emission rows (.65,.3,.05),(.05,.25,.7). We enumerate every path for observations 0,1,2,1.

```{cpp, results="markdown", file="figures/hidden_markov_models_posteriors.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

int main() {
  namespace n = dm::nn;
  const auto dtype = n::DType::Float64;
  const auto pi = n::tensor({.6, .4}, {2}, dtype);
  const auto A = n::tensor({.8, .2, .3, .7}, {2, 2}, dtype);
  const auto B = n::tensor({.65, .3, .05, .05, .25, .7}, {2, 3}, dtype);
  const auto observations = n::from_vector(std::vector<int64_t>{0, 1, 2, 1}, {1, 4});
  auto evidence = n::gather(n::transpose(n::log(B)), observations).detach().requires_grad_();
  const auto ll = n::ml::hmm_log_likelihood(n::log(pi), n::log(A), evidence);
  // A derivative with respect to local log evidence is the state posterior.
  const auto posterior = n::grad(n::sum(ll), {evidence})[0];
  std::vector<int64_t> states;
  for (int code = 0; code < 16; ++code)
    for (int t = 0; t < 4; ++t)
      states.push_back((code >> (3 - t)) & 1);
  const auto paths = n::from_vector(states, {16, 4});
  auto log_mass = n::gather(n::log(pi), n::select(paths, 1, 0));
  for (int t = 0; t < 4; ++t) {
    const auto emission = n::select(n::log(B), 1, observations.at({0, t}));
    log_mass = log_mass + n::gather(emission, n::select(paths, 1, t));
    if (t) {
      const auto index = 2 * n::select(paths, 1, t - 1) + n::select(paths, 1, t);
      log_mass = log_mass + n::gather(n::reshape(n::log(A), {4}), index);
    }
  }
  const auto total = n::logsumexp(log_mass), best = n::max(log_mass);
  const auto weights = n::softmax(log_mass, 0);
  const auto enumerated =
      n::sum(n::one_hot(paths, 2, 1, 0, dtype) * n::reshape(weights, {16, 1, 1}), {0});
  const double error = n::max(n::abs(n::reshape(posterior, {4, 2}) - enumerated)).item();
  if (std::abs(total.item() - ll.item()) > 1e-12 || error > 1e-12)
    return 1;
  const auto best_path = n::gather(paths, n::argmax(log_mass));
  auto p = dm::graphics::RPlot::create();
  p.lines({0, 1, 2, 3}, n::select(n::reshape(posterior, {4, 2}), 1, 1).to_vector<double>(),
          "posterior state 1", {37, 99, 235})
      .title("Tensor HMM state posteriors")
      .x_label("time index")
      .y_label("probability")
      .y_limits(0, 1.1);
  std::filesystem::create_directories("build");
  p.size(850, 420).save_svg("build/hidden_markov_models_posteriors.svg");
  std::print("Sequence probability {:.12f}; best path probability {:.12f}; best path {}; "
             "posterior error {:.12f}.\n",
             n::exp(ll).item(), n::exp(best).item(), best_path.to_vector<int64_t>(), error);
}
```
// result_begin: markdown
Sequence probability 0.007732580000; best path probability 0.002293200000; best path [0, 0, 1, 1]; posterior error 0.000000000000.
\image(figures/hidden_markov_models_posteriors.svg)
// result_end
\caption(Posterior state probabilities incorporate both earlier and later observations.)
\alttext(Posterior state probabilities incorporate both earlier and later observations.)

> Checking the theory

```{cpp, results="markdown", file="figures/hidden_markov_models_adam.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

int main() {
  namespace n = dm::nn;
  const auto dtype = n::DType::Float64;
  const auto observations =
      n::from_vector(std::vector<int64_t>{0, 0, 0, 1, 2, 2, 2, 2, 1, 0, 0, 0, 0, 1, 0,
                                          1, 2, 2, 2, 2, 2, 1, 0, 0, 0, 0, 1, 2, 2, 2},
                     {5, 6});
  auto initial = n::log(n::tensor({.5, .5}, {2}, dtype)).detach().requires_grad_();
  auto transition =
      n::log(n::tensor({.6, .4, .4, .6}, {2, 2}, dtype)).detach().requires_grad_();
  auto emission =
      n::log(n::tensor({.55, .3, .15, .15, .3, .55}, {2, 3}, dtype)).detach().requires_grad_();
  auto likelihood = [&]() {
    const auto evidence = n::gather(n::transpose(n::log_softmax(emission, 1)), observations);
    return n::ml::hmm_log_likelihood(n::log_softmax(initial, 0), n::log_softmax(transition, 1),
                                     evidence);
  };
  n::OptimizerConfig config;
  config.kind = n::OptimizerKind::Adam;
  n::Optimizer optimizer({initial, transition, emission}, .03, config);
  const double start = n::sum(likelihood()).item();
  std::vector<double> step, nll;
  for (int i = 0; i < 600; ++i) {
    const auto loss = -n::mean(likelihood());
    step.push_back(i);
    nll.push_back(loss.item());
    optimizer.minimize(loss);
  }
  n::NoGradGuard guard;
  const double final = n::sum(likelihood()).item();
  const double row_error = n::max(n::abs(n::sum(n::softmax(transition, 1), {1}) - 1)).item();
  if (final <= start || row_error > 1e-12)
    return 1;
  auto p = dm::graphics::RPlot::create();
  p.lines(step, nll, "Adam sequence NLL", {37, 99, 235})
      .title("Adam through the HMM forward recursion")
      .x_label("Adam step")
      .y_label("mean sequence NLL");
  std::filesystem::create_directories("build");
  p.size(850, 420).save_svg("build/hidden_markov_models_adam.svg");
  std::print(
      "Initial/final total log likelihood {:.9f}, {:.9f}; transition row error {:.12f}.\n",
      start, final, row_error);
}
```
// result_begin: markdown
Initial/final total log likelihood -31.636255693, -27.181357299; transition row error 0.000000000000.
\image(figures/hidden_markov_models_adam.svg)
// result_end
\caption(Mean training sequence NLL across Adam updates; this is not a held-out score.)
\alttext(Mean training sequence NLL across Adam updates; this is not a held-out score.)


> Conclusion

The tensor forward recursion and its evidence gradients agree with all sixteen enumerated
paths. Direct Adam training improves the unlabelled sequence likelihood and keeps probability
rows normalised. It does not promise monotonic updates or identify unique hidden-state labels.

> References

- [Rabiner (1989), A tutorial on hidden Markov models and selected applications in speech recognition](https://doi.org/10.1109/5.18626).
