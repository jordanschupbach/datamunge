\documentclass[tikz,border=10pt]{standalone}
\usetikzlibrary{arrows.meta,positioning}
\begin{document}
\begin{tikzpicture}[>=Stealth,font=\sffamily\large,box/.style={draw,rounded corners,align=center,text width=4.0cm,minimum height=1.8cm,fill=blue!7,inner sep=6pt}]
\node[box] (n0) at (0.0,0) {Frozen training metric\\scale from training rows};
\node[box] (n1) at (5.2,0) {Nearest k rows\\stable distance ties};
\node[box] (n2) at (10.4,0) {Votes or target mean\\handle zero distance};
\draw[->,thick] (n0)--(n1);
\draw[->,thick] (n1)--(n2);
\end{tikzpicture}
\end{document}
