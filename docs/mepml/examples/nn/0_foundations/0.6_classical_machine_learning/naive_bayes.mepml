> Checking the theory

```{cpp, results="markdown", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

int main() {
  namespace n = dm::nn;
  const auto dtype = n::DType::Float64;
  const auto x = n::tensor({-2, 4, -1, 4, 1, 4, 2, 4}, {4, 2}, dtype);
  const auto labels = n::from_vector(std::vector<int64_t>{0, 0, 1, 1});
  auto means = n::zeros({2, 2}, dtype).requires_grad_();
  auto log_variance = n::zeros({2, 2}, dtype).requires_grad_();
  auto prior = n::zeros({2}, dtype).requires_grad_();
  n::OptimizerConfig config;
  config.kind = n::OptimizerKind::Adam;
  n::Optimizer optimizer({means, log_variance, prior}, .03, config);
  for (int step = 0; step < 2400; ++step) {
    if (step == 1200)
      optimizer.set_learning_rate(.003);
    if (step == 1800)
      optimizer.set_learning_rate(.0003);
    const auto mu = n::gather(means, labels), lv = n::gather(log_variance, labels);
    const auto conditional =
        .5 * n::sum(std::log(2 * std::numbers::pi) + lv + n::square(x - mu) / n::exp(lv), {1});
    const auto loss = n::mean(conditional - n::gather(n::log_softmax(prior, 0), labels));
    optimizer.minimize(loss);
    // Project the retained variance leaf onto the absolute variance constraint.
    n::NoGradGuard guard;
    log_variance.copy_(n::maximum(log_variance, n::scalar_like(std::log(.001), log_variance)));
  }
  n::NoGradGuard guard;
  const auto exact_mean = n::tensor({-1.5, 4, 1.5, 4}, {2, 2}, dtype);
  const auto exact_variance = n::tensor({.25, .001, .25, .001}, {2, 2}, dtype);
  const double error = n::max(n::abs(means - exact_mean)).item();
  const double variance_error = n::max(n::abs(n::exp(log_variance) - exact_variance)).item();
  if (error > 1e-5 || variance_error > 1e-5)
    return 1;
  std::print("Adam Gaussian means {}; variance entries {}; mean error {:.9f}; variance error "
             "{:.9f}.\n",
             means.to_vector<double>(), n::exp(log_variance).to_vector<double>(), error,
             variance_error);
}
```
// result_begin: markdown
Adam Gaussian means [-1.5, 4, 1.5, 4]; variance entries [0.25000000000000006, 0.0010000000000000002, 0.25000000000000006, 0.0010000000000000002]; mean error 0.000000000; variance error 0.000000000.
// result_end


> Conclusion

The visible tensor Adam fits recover the smoothed count solutions and constrained Gaussian
moments on the fixtures. Posterior normalisation does not prove conditional independence or
calibration; those remain model assumptions and evaluation questions.

> References

- [Stanford Introduction to Information Retrieval: Naive Bayes text classification](https://nlp.stanford.edu/IR-book/html/htmledition/naive-bayes-text-classification-1.html).
