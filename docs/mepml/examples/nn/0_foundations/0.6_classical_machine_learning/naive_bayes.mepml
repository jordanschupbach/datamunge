\alttext(Labelled tensor inputs; class-conditional likelihood. Then Learnable probability logits; include smoothing objective. Then Explicit tensor Adam; check closed-form moments.)

> Simple examples

Class-zero documents (2,0),(1,0) and class-one documents (0,1),(0,2) give smoothed multinomial rows (.8,.2),(.2,.8).

```{cpp, results="markdown", file="figures/naive_bayes_documents.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

int main() {
  namespace n = dm::nn;
  const auto dtype = n::DType::Float64;
  const auto counts = n::tensor({2, 0, 1, 0, 0, 1, 0, 2}, {4, 2}, dtype);
  const auto labels = n::from_vector(std::vector<int64_t>{0, 0, 1, 1});
  const auto query = n::tensor({1, 0, 0, 1, 0, 0}, {3, 2}, dtype);
  std::vector<double> multinomial, bernoulli;
  double worst = 0;
  for (bool binary : {false, true}) {
    const auto x = binary ? n::minimum(counts, n::ones_like(counts)) : counts;
    auto prior = n::zeros({2}, dtype).requires_grad_();
    auto logits = n::zeros({2, 2}, dtype).requires_grad_();
    n::OptimizerConfig config;
    config.kind = n::OptimizerKind::Adam;
    n::Optimizer optimizer({prior, logits}, .05, config);
    for (int step = 0; step < 800; ++step) {
      const auto log_prior = n::log_softmax(prior, 0);
      const auto selected = n::gather(logits, labels);
      n::Tensor likelihood, regularizer;
      if (binary) {
        likelihood = -n::sum(n::sigmoid_cross_entropy(selected, x, n::Reduction::None));
        // One presence and one absence pseudocount per class/feature.
        regularizer = n::sum(n::log_sigmoid(logits) + n::log_sigmoid(-logits));
      } else {
        likelihood = n::sum(x * n::log_softmax(selected, 1));
        // One pseudocount per class/word, reproducing additive smoothing.
        regularizer = n::sum(n::log_softmax(logits, 1));
      }
      const auto loss =
          -(n::sum(n::gather(log_prior, labels)) + likelihood + regularizer) / 4.;
      optimizer.minimize(loss);
    }
    n::NoGradGuard guard;
    const auto log_prior = n::log_softmax(prior, 0);
    const auto log_present = binary ? n::log_sigmoid(logits) : n::log_softmax(logits, 1);
    auto scores = n::matmul(query, log_present, false, true) + log_prior;
    if (binary)
      scores = scores + n::matmul(1 - query, n::log_sigmoid(-logits), false, true);
    const auto probabilities = n::select(n::softmax(scores, 1), 1, 0).to_vector<double>();
    if (binary)
      bernoulli = probabilities;
    else
      multinomial = probabilities;
    const auto expected = binary ? n::tensor({.75, .25, .25, .75}, {2, 2}, dtype)
                                 : n::tensor({.8, .2, .2, .8}, {2, 2}, dtype);
    const auto fitted = binary ? n::sigmoid(logits) : n::softmax(logits, 1);
    worst = std::max(worst, n::max(n::abs(fitted - expected)).item());
  }
  if (worst > 1e-8)
    return 1;
  auto p = dm::graphics::RPlot::create();
  p.lines({0, 1, 2}, multinomial, "multinomial Adam", {37, 99, 235})
      .lines({0, 1, 2}, bernoulli, "Bernoulli Adam", {234, 88, 12})
      .title("Adam fits smoothed feature likelihoods")
      .x_label("query: first word, second word, empty")
      .y_label("P(class 0)")
      .y_limits(0, 1.1);
  std::filesystem::create_directories("build");
  p.size(850, 420).save_svg("build/naive_bayes_documents.svg");
  dm::dstruct::DataFrame t;
  t.add_column("query", std::vector<std::string>{"word 0", "word 1", "empty"});
  t.add_column("multinomial_P0", multinomial);
  t.add_column("Bernoulli_P0", bernoulli);
  std::print("{}\n\nMaximum smoothed closed-form check error {:.12f}.\n", t.to_md(8), worst);
}
```
