> Checking the theory

```{cpp, results="markdown", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
  namespace n = dm::nn;
  const auto x = n::tensor({-2, -1, 1, 2}, {4, 1}, n::DType::Float64),
             y = n::tensor({-1, -1, 1, 1}, {4, 1}, n::DType::Float64);
  auto w = n::zeros({1, 1}, n::DType::Float64).requires_grad_(),
       b = n::scalar(0, n::DType::Float64).requires_grad_();
  n::OptimizerConfig c;
  c.kind = n::OptimizerKind::Adam;
  n::Optimizer opt({w, b}, .02, c);
  for (int i = 0; i < 400; ++i)
    opt.minimize(n::mean(n::relu(1 - y * (n::matmul(x, w) + b))) + .05 * n::sum(n::square(w)));
  const auto margin = y * (n::matmul(x, w) + b);
  if (n::min(margin).item() <= 0)
    return 1;
  n::Generator rng(19);
  const auto q = n::tensor({0, 0, .5, 0, 1, 0}, {3, 2}, n::DType::Float64);
  const auto B =
      n::normal({2, 2048}, 0, std::sqrt(1 / (2 * std::numbers::pi * std::numbers::pi)), rng,
                n::DType::Float64);
  const auto phi = n::gaussian_fourier_features(q, B) / std::sqrt(2048.);
  std::print("Fitted weight {:.6f}, bias {:.6f}, signed margins {}.\n", w.item(), b.item(),
             margin.to_vector<double>());
  const auto kernel = n::matmul(phi, phi, false, true);
  dm::dstruct::DataFrame t;
  t.add_column("distance", std::vector<double>{0, .5, 1});
  t.add_column("approx_kernel",
               std::vector<double>{kernel.at({0, 0}), kernel.at({0, 1}), kernel.at({0, 2})});
  t.add_column("exact_kernel", std::vector<double>{1, std::exp(-.25), std::exp(-1.)});
  std::print("\n{}\n", t.to_md(8));
}
```
// result_begin: markdown
Fitted weight 1.004081, bias 0.000000, signed margins [2.0081627777914988, 1.0040813888957494, 1.0040813888957494, 2.0081627777914988].

| distance | approx_kernel | exact_kernel |
| ---: | ---: | ---: |
| 0.0 | 1.00000000 | 1.00000000 |
| 0.5 | 0.78525832 | 0.77880078 |
| 1.0 | 0.37611267 | 0.36787944 |
// result_end


> Conclusion

The hinge examples distinguish errors from margin violations, and the trained linear fixture
separates its four observations. Fourier inner products approximate the specified Gaussian
kernel; a single finite draw does not establish a uniform approximation bound or generalization.

> References

- [Cortes and Vapnik (1995), Support-vector networks](https://doi.org/10.1007/BF00994018).
- [Rahimi and Recht (2007), Random Features for Large-Scale Kernel Machines](https://papers.nips.cc/paper/3182-random-features-for-large-scale-kernel-machines).
