> Simple examples

Logits (0,log 2,log 3) yield (1/6,1/3,1/2); the last class has NLL log 2.

```{cpp, results="markdown", file="figures/softmax_mnist_three.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
  namespace n = dm::nn;
  auto z =
      n::tensor({0, std::log(2.), std::log(3.)}, {1, 3}, n::DType::Float64).requires_grad_();
  const auto labels = n::from_vector(std::vector<int64_t>{2}),
             loss = n::sparse_softmax_cross_entropy(z, labels), p = n::softmax(z, 1),
             g = n::grad(loss, {z})[0];
  const double shift = n::max(n::abs(p - n::softmax(z + 1000, 1))).item();
  if (shift > 1e-12 || std::abs(loss.item() - std::log(2.)) > 1e-12)
    return 1;
  auto plot = dm::graphics::RPlot::create();
  plot.bars({0, 1, 2}, p.to_vector<double>(), "probability", {37, 99, 235}, .5)
      .title("Three logits determine a normalised class distribution")
      .x_label("class")
      .y_label("probability")
      .y_limits(0, .65);
  std::filesystem::create_directories("build");
  plot.size(850, 420).save_svg("build/softmax_mnist_three.svg");
  dm::dstruct::DataFrame t;
  t.add_column("class", std::vector<double>{0, 1, 2});
  t.add_column("probability", p.to_vector<double>());
  t.add_column("gradient", g.to_vector<double>());
  std::print("{}\n\nNLL {:.9f}; shift-invariance error {:.12f}.\n", t.to_md(8), loss.item(),
             shift);
}
```
// result_begin: markdown
| class | probability | gradient |
| ---: | ---: | ---: |
| 0 | 0.16666667 | 0.16666667 |
| 1 | 0.33333333 | 0.33333333 |
| 2 | 0.50000000 | -0.50000000 |


NLL 0.693147181; shift-invariance error 0.000000000000.
\image(figures/softmax_mnist_three.svg)
// result_end
\caption(The true class has derivative minus one half; the other two derivatives sum to one half.)
\alttext(The true class has derivative minus one half; the other two derivatives sum to one half.)

> Checking the theory

The common-shift check above probes a softmax symmetry at logits near 1000. The dataset block also checks every held-out probability row sums to one.

> A dataset example

Pixels divide by the known maximum 16. A seeded stratified four-fold split reserves fold zero; all 80 training epochs and Adam state updates are visible. The held-out data never select an epoch.

```{cpp, results="markdown", file="figures/softmax_mnist_inputs.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

int main() {
  namespace n = dm::nn;
  const auto data = dm::datasets::digits();
  std::vector<double> pixels;
  std::vector<int> seen(10);
  for (int digit = 0; digit < 10; ++digit) {
    for (size_t row = 0; row < data.nrows(); ++row) {
      if (int(data.get_column("digit").values()[row]) != digit)
        continue;
      for (int j = 0; j < 64; ++j)
        pixels.push_back(data.get_column("pixel_" + std::to_string(j)).values()[row] / 16.);
      break;
    }
  }
  const auto sheet = n::image_grid(n::from_vector(pixels, {10, 8, 8, 1}), 5, 2, 0.);
  std::vector<double> horizontal(sheet.size(1)), vertical(sheet.size(0));
  std::iota(horizontal.begin(), horizontal.end(), 0.);
  std::iota(vertical.begin(), vertical.end(), 0.);
  std::vector<std::vector<double>> intensity(horizontal.size(),
                                             std::vector<double>(vertical.size()));
  for (size_t x = 0; x < horizontal.size(); ++x)
    for (size_t y = 0; y < vertical.size(); ++y)
      intensity[x][y] = sheet.at({int64_t(vertical.size() - 1 - y), int64_t(x), 0});
  std::vector<dm::graphics::RGB> grayscale;
  for (int value = 0; value < 256; ++value) {
    grayscale.push_back({value, value, value});
  }
  auto p = dm::graphics::RPlot::create();
  p.image(horizontal, vertical, intensity, grayscale, 0, 1)
      .title("Bundled 8 by 8 digits: labels 0 to 9")
      .x_label("pixel column")
      .y_label("pixel row, inverted");
  std::filesystem::create_directories("build");
  p.size(850, 390).save_svg("build/softmax_mnist_inputs.svg");
  std::print("First dataset row of each class; labels 0..4 above 5..9.\n");
}
```
