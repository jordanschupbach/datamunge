\caption(Only validation reconstruction MSE is plotted for comparison; each variant's own full objective selects its checkpoint. Penalty components and fitting totals remain in the table.)
\alttext(Four three-epoch validation MSE curves compare matched plain, L1, KL and combined sigmoid networks.)

> Fresh deployment, activity and frozen-code controls

Fresh stores restore selected weights and evaluate all three pools. The saved components are
[total,MSE,L1,KL], computed on each complete pool, as in the source. Inference for an image
is independent of other batch rows; the KL objective is not. Exact repeat/standalone decoding,
single-versus-batch agreement and immutable weights are checked. Zero and cyclically shifted
codes retain each frozen decoder while removing or misaligning sample-specific content.
These additional controls are not refitted. A fitting-only pixel mean is estimated separately.

```{cpp, results="markdown", file="figures/sparse_activities.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
  namespace n = dm::nn;
  std::map<std::string, n::Tensor> data;
  for (const auto& [key, value] : n::load_npz("build/sparse_data.npz"))
    data.emplace(key, value);
  const auto test = data.at("test_images").reshape({200, 784});
  const auto mean = n::broadcast_to(
      n::cast(
          n::mean(
              n::cast(data.at("fit_images").reshape({1000, 784}), n::DType::Float64), {0}, true),
          n::DType::Float32),
      test.shape());
  n::save_npz("build/sparse_mean.npz", {{"mean", mean}});
  const std::vector<std::string>       names{"plain", "l1", "kl", "combined"};
  const std::vector<float>             alpha{0, .05f, 0, .05f}, beta{0, 0, .05f, .05f};
  const std::vector<dm::graphics::RGB> colors{
      {100, 116, 139}, {37, 99, 235}, {22, 163, 74}, {220, 38, 38}};
  auto                plot = dm::graphics::RPlot::create();
  std::vector<double> units(64), target(64, .05);
  std::iota(units.begin(), units.end(), 0.);
  std::print(
      "| variant | test MSE | mean activity | fraction <0.1 | zero-code MSE | shifted-code MSE "
      "|\n|---|---:|---:|---:|---:|---:|\n");
  for (int v = 0; v < 4; ++v) {
    const std::string prefix = "build/sparse_" + names[v];
    n::ParameterStore p(1601);
    p.load(prefix + "_best.npz", false);
    const auto      before = p.flatten();
    n::NoGradGuard  guard;
    n::NamedTensors saved;
    for (const auto& name : {"fit", "validation", "test"}) {
      const auto images = data.at(std::string(name) + "_images"),
                 input  = images.reshape({images.size(0), 784});
      const auto net    = n::models::SparseAutoencoder(p, input, alpha[v], beta[v]);
      saved.insert(
          saved.end(),
          {{std::string(name) + "_code", net.code},
           {std::string(name) + "_reconstruction", net.reconstruction},
           {std::string(name) + "_unit_mean", net.penalty.unit_mean},
           {std::string(name) + "_components",
            n::from_vector(
                std::vector<float>{
                    net.loss.item<float>(),
                    net.mse.item<float>(),
                    net.penalty.l1.item<float>(),
                    net.penalty.kl.item<float>()},
                {4})}});
    }
    n::save_npz(prefix + "_outputs.npz", saved);
    p.save(prefix + "_model_arrays.npz");
    const auto net     = n::models::SparseAutoencoder(p, test, alpha[v], beta[v]),
               repeat  = n::models::SparseAutoencoder(p, test, alpha[v], beta[v]);
    const auto decoded = n::dense(p, "decoder", net.code, 784, n::Activation::Sigmoid);
    const auto single = n::models::SparseAutoencoder(p, n::take_rows(test, {0}), alpha[v], beta[v]);
    if (n::max(n::abs(net.reconstruction - repeat.reconstruction)).item() != 0 ||
        n::max(n::abs(net.reconstruction - decoded)).item() != 0 ||
        n::max(n::abs(single.reconstruction - n::take_rows(net.reconstruction, {0}))).item() > 1e-6)
      return 1;
    const auto zero    = n::dense(p, "decoder", n::zeros({200, 64}), 784, n::Activation::Sigmoid);
    const auto shifted = n::dense(
        p,
        "decoder",
        n::concat({n::slice_axis(net.code, 0, 1, 200), n::slice_axis(net.code, 0, 0, 1)}, 0),
        784,
        n::Activation::Sigmoid);
    n::save_npz(
        prefix + "_controls.npz",
        {{"zero_reconstruction", zero}, {"shifted_reconstruction", shifted}});
    auto score = [&](const n::Tensor& y) {
      return n::mse(n::cast(y, n::DType::Float64), n::cast(test, n::DType::Float64)).item();
    };
    const double activity = n::mean(n::cast(net.code, n::DType::Float64)).item(),
                 low      = n::mean(n::cast(n::less(net.code, .1), n::DType::Float64)).item();
    std::print(
        "| {} | {:.9f} | {:.6f} | {:.6f} | {:.9f} | {:.9f} |\n",
        names[v],
        score(net.reconstruction),
        activity,
        low,
        score(zero),
        score(shifted));
    plot.lines(units, net.penalty.unit_mean.to_vector<double>(), names[v], colors[v], 1.5);
    if (before != p.flatten())
      return 1;
  }
  plot.lines(units, target, "target rho", {15, 23, 42}, 1.)
      .x_label("original code unit index")
      .y_label("held-out unit mean activity")
      .title("Penalties lower activity; the target mean remains unmet")
      .save_svg("build/sparse_activities.svg");
  std::print(
      "Fitting-mean MSE {:.9f}; all restore/repeat/decode/batch/immutable checks pass.\n",
      n::mse(n::cast(mean, n::DType::Float64), n::cast(test, n::DType::Float64)).item());
}
```
// result_begin: markdown
| variant | test MSE | mean activity | fraction <0.1 | zero-code MSE | shifted-code MSE |
|---|---:|---:|---:|---:|---:|
| plain | 0.067947765 | 0.975630 | 0.002109 | 0.222081206 | 0.068097564 |
| l1 | 0.064767495 | 0.351789 | 0.432891 | 0.216517574 | 0.068079176 |
| kl | 0.060774161 | 0.315958 | 0.156094 | 0.213551380 | 0.067903786 |
| combined | 0.064606958 | 0.246206 | 0.286641 | 0.210341197 | 0.070391737 |
Fitting-mean MSE 0.067798074; all restore/repeat/decode/batch/immutable checks pass.
\image(figures/sparse_activities.svg)
// result_end

\caption(Unit means retain original feature order; units are not sorted or aligned after fitting. The target 0.05 is a regularization preference, not an achieved equality constraint.)
\alttext(Four curves over sixty-four original unit indices show almost saturated plain codes and lower activity for the three penalized models, with target 0.05 below their typical means.)

The original test MSEs are 0.06795, 0.06477, 0.06077 and 0.06461 for plain, L1, KL and combined,
respectively. KL-only has the lowest observed reconstruction error, about 10.4% below the fitting
mean's 0.06780. L1 has the largest fraction below 0.1 (0.4329), whereas combined has the lowest
mean activity (0.2462). Those summaries rank different properties. Even the combined mean is
well above ρ=0.05. Shifting KL codes raises MSE to 0.06790, near the fitting-mean baseline,
so aligning its code with the image contributes to reconstruction. The plain model changes
only from 0.06795 to 0.06810 under the same shift. Zero codes degrade every model strongly.
No target-matching or universal superiority claim follows. This is one seed,
three epochs and a specific normalization of both penalties, without downstream labels.

> Unfiltered reconstruction panels

The first held-out occurrence of each digit 0–9 fixes each column. Rows are original, plain, L1,
KL, combined, fitting mean, absolute KL-model error, zero-code KL decoder and shifted-code KL
decoder. All use [0,1] grayscale, nearest-neighbour enlargement and no error amplification.
These are raw predictions with no copied pixels. Labels only identify the columns.

```{cpp, results="markdown", file="figures/sparse_reconstructions.png", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
  namespace n = dm::nn;
  std::map<std::string, n::Tensor> data;
  for (const auto& [key, value] : n::load_npz("build/sparse_data.npz"))
    data.emplace(key, value);
  const auto clean = data.at("test_images").reshape({200, 784}),
             mean  = n::load_npz("build/sparse_mean.npz")[0].second;
  std::vector<n::Tensor> values{clean};
  n::Tensor              kl_prediction;
  for (const auto& name : {"plain", "l1", "kl", "combined"}) {
    for (const auto& [key, value] :
         n::load_npz(std::string("build/sparse_") + name + "_outputs.npz"))
      if (key == "test_reconstruction") {
        values.push_back(value);
        if (std::string(name) == "kl")
          kl_prediction = value;
      }
  }
  values.push_back(mean);
  values.push_back(n::abs(kl_prediction - clean));
  for (const auto& [key, value] : n::load_npz("build/sparse_kl_controls.npz"))
    values.push_back(value);
  const auto labels = data.at("test_labels").to_vector<int>(),
             ids    = data.at("test_source_ids").to_vector<int>();
  std::vector<std::int64_t> rows;
  std::print("| digit | original MNIST source ID |\n|---:|---:|\n");
  for (int digit = 0; digit < 10; ++digit) {
    const auto found = std::find(labels.begin(), labels.end(), digit);
    if (found == labels.end())
      return 1;
    rows.push_back(found - labels.begin());
    std::print("| {} | {} |\n", digit, ids[rows.back()]);
  }
  std::vector<n::Tensor> panels;
  for (const auto& x : values)
    panels.push_back(n::take_rows(x, rows));
  if (panels.size() != 9)
    return 1;
  n::save_image_grid(
      n::concat(panels, 0).reshape({90, 28, 28, 1}),
      "build/sparse_reconstructions.png",
      10,
      0,
      1,
      2,
      .8,
      3);
}
```
