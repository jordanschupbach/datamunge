> Four matched fits, 384 explicit updates

Plain uses (α,β)=(0,0), L1 uses (0.05,0), KL uses (0,0.05), and combined uses (0.05,0.05).
All four start at seed 1601 with byte-identical parameters. Batch-order seed 1607 and batch size 32
give the same records and order, including eight in the last batch. Each model runs three
epochs and 96 Adam updates at learning rate 0.003, moments 0.9/0.999 and epsilon 1e-8.

Each variant selects its own checkpoint by its **own full regularized validation objective**
in Float32, preserving the source. These totals have different penalty coefficients, so they
are not directly comparable scores for selecting a variant. Test MSE and activity summaries
below are descriptive held-out comparisons of the four prescribed configurations, not a
hyperparameter search using test pixels. Fitting loss is pre-update, validation post-epoch.
Every fitting record is used once per epoch; the full loop and actual optimizer calls are below.

```{cpp, results="markdown", file="figures/sparse_learning.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
  namespace n = dm::nn;
  std::map<std::string, n::Tensor> data;
  for (const auto& [key, value] : n::load_npz("build/sparse_data.npz"))
    data.emplace(key, value);
  const auto fit                           = data.at("fit_images"),
             validation                    = data.at("validation_images").reshape({200, 784});
  const auto                           ids = data.at("fit_source_ids").to_vector<int>();
  std::vector<double>                  matched;
  const std::vector<std::string>       names{"plain", "l1", "kl", "combined"};
  const std::vector<float>             alpha{0, .05f, 0, .05f}, beta{0, 0, .05f, .05f};
  const std::vector<dm::graphics::RGB> colors{
      {100, 116, 139}, {37, 99, 235}, {22, 163, 74}, {220, 38, 38}};
  auto plot = dm::graphics::RPlot::create();
  std::print(
      "| variant | epoch | fitting total | validation total | validation MSE | L1 | KL "
      "|\n|---|---:|---:|---:|---:|---:|---:|\n");
  for (int v = 0; v < 4; ++v) {
    const std::string prefix = "build/sparse_" + names[v];
    n::ParameterStore p(1601);
    {
      n::NoGradGuard guard;
      n::models::SparseAutoencoder(p, n::zeros({1, 784}), alpha[v], beta[v]);
    }
    if (v == 0)
      matched = p.flatten();
    else if (p.flatten() != matched)
      return 1;
    p.save(prefix + "_initial.npz");
    n::OptimizerConfig config;
    config.kind = n::OptimizerKind::Adam;
    n::Optimizer  optimizer(p, .003, config);
    n::BatchOrder order(1000, 32, 1607);
    std::ofstream batches(prefix + "_batches.tsv");
    batches << "epoch\tstep\trow\tsource_id\n";
    double              best     = std::numeric_limits<double>::infinity();
    int                 selected = 0, updates = 0;
    std::vector<double> epochs, validation_mse;
    for (int epoch = 1; epoch <= 3; ++epoch) {
      order.begin_epoch();
      double total = 0;
      int    seen  = 0;
      for (;;) {
        const auto rows = order.next();
        if (rows.empty())
          break;
        const auto images = n::take_rows(fit, rows), input = images.reshape({images.size(0), 784});
        const auto net = n::models::SparseAutoencoder(p, input, alpha[v], beta[v]);
        if (updates == 0 || updates == 31) {
          n::GradOptions keep;
          keep.retain_graph     = true;
          const auto derivative = n::grad(net.penalty.total, {net.code}, keep)[0];
          n::save_npz(
              prefix + (updates == 0 ? "_first_probe.npz" : "_partial_probe.npz"),
              {{"images", images},
               {"code", net.code},
               {"unit_mean", net.penalty.unit_mean},
               {"clipped_mean", net.penalty.clipped_mean},
               {"penalty_gradient", derivative}});
        }
        if (updates == 0) {
          n::GradOptions keep;
          keep.retain_graph         = true;
          const auto      gradients = n::grad(net.loss, p.parameters(), keep);
          n::NamedTensors saved;
          for (std::size_t i = 0; i < gradients.size(); ++i) {
            const auto norm = n::sqrt(n::sum(n::square(gradients[i]))).item();
            if (!std::isfinite(norm) || norm <= 0)
              return 1;
            saved.emplace_back(p.names()[i], gradients[i]);
          }
          n::save_npz(prefix + "_first_gradients.npz", saved);
          n::save_npz(prefix + "_first_batch.npz", {{"images", images}});
        }
        const double value = net.loss.item();
        if (!std::isfinite(value) || value < 0)
          return 1;
        optimizer.minimize(net.loss);
        total += rows.size() * value;
        seen += int(rows.size());
        for (auto row : rows)
          batches << epoch << '\t' << updates << '\t' << row << '\t' << ids[row] << '\n';
        if (updates == 0)
          p.save(prefix + "_first_update.npz");
        ++updates;
      }
      n::NoGradGuard guard;
      const auto     net   = n::models::SparseAutoencoder(p, validation, alpha[v], beta[v]);
      const double   score = net.loss.item();
      if (seen != 1000 || !std::isfinite(score))
        return 1;
      p.save(prefix + "_epoch" + std::to_string(epoch) + ".npz");
      if (score < best) {
        best     = score;
        selected = epoch;
        p.save(prefix + "_best.npz");
      }
      epochs.push_back(epoch);
      validation_mse.push_back(net.mse.item());
      std::print(
          "| {} | {} | {:.8f} | {:.8f} | {:.8f} | {:.8f} | {:.8f} |\n",
          names[v],
          epoch,
          total / seen,
          score,
          net.mse.item(),
          net.penalty.l1.item(),
          net.penalty.kl.item());
    }
    if (updates != 96 || !batches)
      return 1;
    n::save_npz(
        prefix + "_selection.npz",
        {{"epoch", n::full({}, selected, n::DType::Int32)},
         {"validation_loss", n::full({}, best, n::DType::Float32)}});
    plot.lines(epochs, validation_mse, names[v] + " validation MSE", colors[v], 2.);
  }
  plot.x_label("epoch")
      .y_label("validation reconstruction MSE (not total objective)")
      .title("Four matched sigmoid models / 96 updates each")
      .save_svg("build/sparse_learning.svg");
}
```
