> Matched sparse and plain fits, with all updates visible

Both parameter stores start from seed 1931, with Glorot-uniform encoder/decoder weights and
zero biases. All four tensors agree initially; their initial functions need not agree because
only one applies a gate. Batch seed 1933 matches row order. Each model makes 96 Adam updates:
three epochs, batch 32, all 1,000 images once per epoch and a final batch of eight. Adam uses
learning rate 0.003, moments 0.9/0.999 and epsilon 1e-8. Every reconstruction target is the input
image. The plain control retains all 64 linear activities; the sparse model selects eight.

Each model selects its own checkpoint by validation reconstruction MSE accumulated in Float64
from Float32 predictions, as in the source. The test set does not influence selection. The code
saves initial outputs, all parameter snapshots, first gradients/batches, first-batch and final
eight-row gate probes, and selected checkpoints. Fitting losses are pre-update minibatch means;
validation evaluates post-epoch weights. No optimization is hidden in the core forward helper.

```{cpp, results="markdown", file="figures/k_sparse_learning.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
  namespace n = dm::nn;
  std::map<std::string, n::Tensor> data;
  for (const auto& [name, value] : n::load_npz("build/k_sparse_data.npz"))
    data.emplace(name, value);
  const auto fit                = data.at("fit_images"),
             validation         = data.at("validation_images").reshape({200, 784});
  const auto               test = data.at("test_images").reshape({200, 784});
  std::vector<double>      matched;
  std::vector<std::string> gradient_notes;
  auto                     plot = dm::graphics::RPlot::create();
  std::print("| model | epoch | fitting pre-update MSE | validation MSE |\n|---|---:|---:|---:|\n");
  for (bool plain : {false, true}) {
    const std::string name = plain ? "plain" : "competitive", prefix = "build/k_sparse_" + name;
    n::ParameterStore p(1931);
    {
      n::NoGradGuard guard;
      const auto     net = n::models::CompetitiveAutoencoder(p, n::zeros({1, 784}), false, plain);
    }
    if (plain) {
      if (p.flatten() != matched)
        return 1;
    } else
      matched = p.flatten();
    if (p.count() != 101200 || p.size() != 4)
      return 1;
    p.save(prefix + "_initial.npz");
    {
      n::NoGradGuard guard;
      const auto     initial = n::models::CompetitiveAutoencoder(p, test, false, plain);
      n::save_npz(
          prefix + "_initial_outputs.npz",
          {{"code", initial.code}, {"reconstruction", initial.reconstruction}});
    }
    n::OptimizerConfig config;
    config.kind = n::OptimizerKind::Adam;
    n::Optimizer        optimizer(p, .003, config);
    n::BatchOrder       batches(1000, 32, 1933);
    double              best     = std::numeric_limits<double>::infinity();
    int                 selected = 0, updates = 0;
    std::vector<double> epochs, valid;
    for (int epoch = 1; epoch <= 3; ++epoch) {
      batches.begin_epoch();
      double total = 0;
      int    seen  = 0;
      for (;;) {
        const auto rows = batches.next();
        if (rows.empty())
          break;
        const auto images = n::take_rows(fit, rows), input = images.reshape({images.size(0), 784});
        const auto net       = n::models::CompetitiveAutoencoder(p, input, false, plain);
        const auto objective = n::mse(net.training_reconstruction, input);
        if (n::max(n::abs(n::sum(net.mask, {1}) - (plain ? 64. : 8.))).item() != 0)
          return 1;
        if (updates == 0 || updates == 31) {
          n::NoGradGuard  guard;
          const auto      probe = n::models::CompetitiveAutoencoder(p, input, false, plain);
          n::NamedTensors arrays;
          if (updates == 31)
            arrays.emplace_back("images", images);
          arrays.insert(
              arrays.end(),
              {{"raw", probe.raw},
               {"mask", probe.mask},
               {"training_code", probe.training_code},
               {"reconstruction", probe.training_reconstruction}});
          n::save_npz(prefix + (updates == 0 ? "_first_probe.npz" : "_partial_probe.npz"), arrays);
        }
        if (updates == 0) {
          n::GradOptions keep;
          keep.retain_graph         = true;
          const auto      gradients = n::grad(objective, p.parameters(), keep);
          n::NamedTensors arrays;
          for (std::size_t i = 0; i < gradients.size(); ++i) {
            const double norm = n::sqrt(n::sum(n::square(gradients[i]))).item();
            if (!std::isfinite(norm) || norm <= 0)
              return 1;
            arrays.emplace_back(p.names()[i], gradients[i]);
            gradient_notes.push_back(
                std::format("| {} | {} | {:.8f} |\n", name, p.names()[i], norm));
          }
          n::save_npz(prefix + "_first_gradients.npz", arrays);
          n::save_npz(prefix + "_first_batch.npz", {{"images", images}});
        }
        const double value = objective.item();
        if (!std::isfinite(value) || value < 0)
          return 1;
        total += rows.size() * value;
        seen += int(rows.size());
        optimizer.minimize(objective);
        if (updates == 0)
          p.save(prefix + "_first_update.npz");
        ++updates;
      }
      n::NoGradGuard guard;
      const auto     prediction =
          n::models::CompetitiveAutoencoder(p, validation, false, plain).reconstruction;
      const double score =
          n::mse(n::cast(prediction, n::DType::Float64), n::cast(validation, n::DType::Float64))
              .item();
      if (seen != 1000 || !std::isfinite(score))
        return 1;
      p.save(prefix + "_epoch" + std::to_string(epoch) + ".npz");
      if (score < best) {
        best     = score;
        selected = epoch;
        p.save(prefix + "_best.npz");
      }
      epochs.push_back(epoch);
      valid.push_back(score);
      std::print("| {} | {} | {:.9f} | {:.9f} |\n", name, epoch, total / seen, score);
    }
    if (updates != 96)
      return 1;
    n::save_npz(
        prefix + "_selection.npz",
        {{"epoch", n::full({}, selected, n::DType::Int32)},
         {"validation_mse", n::full({}, best, n::DType::Float64)}});
    plot.lines(
        epochs,
        valid,
        name + " validation",
        plain ? dm::graphics::RGB{220, 38, 38} : dm::graphics::RGB{37, 99, 235},
        2.);
  }
  std::print("\n| model | parameter | first gradient L2 norm |\n|---|---|---:|\n");
  for (const auto& line : gradient_notes)
    std::print("{}", line);
  plot.x_label("epoch")
      .y_label("validation mean squared pixel error")
      .title("Matched initialization/order: sparse versus ungated linear encoder")
      .save_svg("build/k_sparse_learning.svg");
}
```
