\caption(The ungated control has lower reconstruction MSE in every measured epoch. Both use the same optimizer, original inputs and validation task.)
\alttext(Two decreasing validation curves over three epochs compare the eight-winner model and its ungated linear-encoder control.)

> Deployment and code controls on held-out images

Fresh stores restore the selected checkpoints. For each, the code checks all three pools,
exact repeat/standalone decode agreement, single-versus-batch inference and immutable parameters.
A zero-code decoder and a cyclic one-record shift of the codes retain the decoder weights but
remove or misalign sample-specific information. Neither control is refitted. The fitting pixel
mean is a separate constant baseline estimated without validation or test pixels. No labels enter
these decisions, and this reconstruction task has no classification confusion matrix.

```{cpp, results="markdown", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
  namespace n = dm::nn;
  std::map<std::string, n::Tensor> data;
  for (const auto& [name, value] : n::load_npz("build/k_sparse_data.npz"))
    data.emplace(name, value);
  const auto clean = data.at("test_images").reshape({200, 784});
  const auto mean  = n::broadcast_to(
      n::cast(
          n::mean(
              n::cast(data.at("fit_images").reshape({1000, 784}), n::DType::Float64), {0}, true),
          n::DType::Float32),
      clean.shape());
  n::save_npz("build/k_sparse_mean.npz", {{"mean", mean}});
  std::print(
      "| model | held-out MSE | zero-code MSE | shifted-code MSE | selected slots per row "
      "|\n|---|---:|---:|---:|---:|\n");
  for (bool plain : {false, true}) {
    const std::string name = plain ? "plain" : "competitive", prefix = "build/k_sparse_" + name;
    n::ParameterStore p(1931);
    p.load(prefix + "_best.npz", false);
    const auto      before = p.flatten();
    n::NoGradGuard  guard;
    n::NamedTensors outputs;
    for (const auto& split : {"fit", "validation", "test"}) {
      const auto images = data.at(std::string(split) + "_images");
      const auto net =
          n::models::CompetitiveAutoencoder(p, images.reshape({images.size(0), 784}), false, plain);
      outputs.emplace_back(std::string(split) + "_code", net.code);
      outputs.emplace_back(std::string(split) + "_reconstruction", net.reconstruction);
      outputs.emplace_back(std::string(split) + "_raw", net.raw);
      outputs.emplace_back(std::string(split) + "_mask", net.mask);
    }
    const auto net    = n::models::CompetitiveAutoencoder(p, clean, false, plain);
    const auto repeat = n::models::CompetitiveAutoencoder(p, clean, false, plain);
    const auto single =
        n::models::CompetitiveAutoencoder(p, n::take_rows(clean, {0}), false, plain);
    const auto decoded = n::dense(p, "decoder", net.code, 784, n::Activation::Sigmoid);
    if (n::max(n::abs(repeat.reconstruction - net.reconstruction)).item() != 0 ||
        n::max(n::abs(decoded - net.reconstruction)).item() != 0 ||
        n::max(n::abs(single.reconstruction - n::take_rows(net.reconstruction, {0}))).item() > 1e-6)
      return 1;
    const auto zero = n::dense(p, "decoder", n::zeros({200, 64}), 784, n::Activation::Sigmoid);
    const auto shifted_code =
        n::concat({n::slice_axis(net.code, 0, 1, 200), n::slice_axis(net.code, 0, 0, 1)}, 0);
    const auto shifted = n::dense(p, "decoder", shifted_code, 784, n::Activation::Sigmoid);
    outputs.emplace_back("zero_reconstruction", zero);
    outputs.emplace_back("shuffled_reconstruction", shifted);
    n::save_npz(prefix + "_outputs.npz", outputs);
    std::vector<std::int64_t> rows(32);
    std::iota(rows.begin(), rows.end(), 0);
    const auto images = n::take_rows(data.at("test_images"), rows);
    const auto probe =
        n::models::CompetitiveAutoencoder(p, images.reshape({32, 784}), false, plain);
    n::save_npz(
        prefix + "_selected_probe.npz",
        {{"images", images},
         {"raw", probe.raw},
         {"mask", probe.mask},
         {"training_code", probe.training_code},
         {"reconstruction", probe.training_reconstruction}});
    if (before != p.flatten() ||
        n::max(n::abs(n::sum(net.mask, {1}) - (plain ? 64. : 8.))).item() != 0)
      return 1;
    std::print(
        "| {} | {:.9f} | {:.9f} | {:.9f} | {} |\n",
        name,
        n::mse(n::cast(net.reconstruction, n::DType::Float64), n::cast(clean, n::DType::Float64))
            .item(),
        n::mse(n::cast(zero, n::DType::Float64), n::cast(clean, n::DType::Float64)).item(),
        n::mse(n::cast(shifted, n::DType::Float64), n::cast(clean, n::DType::Float64)).item(),
        plain ? 64 : 8);
  }
  std::print(
      "\nFitting-mean MSE {:.9f}. Fresh restore, exact encode/decode/repeat and immutable weights "
      "pass.\n",
      n::mse(n::cast(mean, n::DType::Float64), n::cast(clean, n::DType::Float64)).item());
}
```
// result_begin: markdown
| model | held-out MSE | zero-code MSE | shifted-code MSE | selected slots per row |
|---|---:|---:|---:|---:|
| competitive | 0.050034922 | 0.218057952 | 0.069472683 | 8 |
| plain | 0.041335177 | 0.222259377 | 0.069475490 | 64 |

Fitting-mean MSE 0.067798074. Fresh restore, exact encode/decode/repeat and immutable weights pass.
// result_end

\caption(Zero and shifted codes degrade both models' held-out reconstruction. Selected slot counts concern the mask, not necessarily nonzero activity counts.)

Both models select epoch 3. The sparse model's held-out MSE 0.05003 is about 26.2% below the
fitting mean's 0.06780, but about 21.0% above the plain control's 0.04134. Zero and shifted sparse
codes yield MSE 0.21806 and 0.06947, respectively. Alignment of a nonconstant code with its own
image matters, but sparsity gives no reconstruction advantage under this small budget.
These are single-seed results, not an estimate of run-to-run variability or a test of the
original paper's downstream classification results.

The gallery chooses the first held-out occurrence of each digit 0–9, without quality filtering.
Rows are original, sparse reconstruction, plain reconstruction, fitting mean, absolute sparse
error, zero-code decoder and shifted-code decoder. Every panel uses the same [0,1] grayscale;
errors are unamplified. Retaining fewer code coordinates does not guarantee recognisable digits.

```{cpp, results="markdown", file="figures/k_sparse_reconstructions.png", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
  namespace n = dm::nn;
  std::map<std::string, n::Tensor> data, sparse, plain;
  for (const auto& [key, value] : n::load_npz("build/k_sparse_data.npz"))
    data.emplace(key, value);
  for (const auto& [key, value] : n::load_npz("build/k_sparse_competitive_outputs.npz"))
    sparse.emplace(key, value);
  for (const auto& [key, value] : n::load_npz("build/k_sparse_plain_outputs.npz"))
    plain.emplace(key, value);
  const auto mean                 = n::load_npz("build/k_sparse_mean.npz")[0].second;
  const auto labels               = data.at("test_labels").to_vector<int>(),
             ids                  = data.at("test_source_ids").to_vector<int>();
  const auto                clean = data.at("test_images").reshape({200, 784});
  std::vector<std::int64_t> rows;
  for (int digit = 0; digit < 10; ++digit) {
    const auto found = std::find(labels.begin(), labels.end(), digit);
    if (found == labels.end())
      return 1;
    rows.push_back(found - labels.begin());
  }
  std::vector<n::Tensor> panels;
  for (const auto& values : std::vector<n::Tensor>{
           clean,
           sparse.at("test_reconstruction"),
           plain.at("test_reconstruction"),
           mean,
           n::abs(sparse.at("test_reconstruction") - clean),
           sparse.at("zero_reconstruction"),
           sparse.at("shuffled_reconstruction")})
    panels.push_back(n::take_rows(values, rows));
  n::save_image_grid(
      n::concat(panels, 0).reshape({70, 28, 28, 1}),
      "build/k_sparse_reconstructions.png",
      10,
      0,
      1,
      2,
      .8,
      3);
  std::print("| digit | original MNIST source ID |\n|---:|---:|\n");
  for (int digit = 0; digit < 10; ++digit)
    std::print("| {} | {} |\n", digit, ids[rows[digit]]);
}
