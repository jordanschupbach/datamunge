\caption(Training and validation objectives decrease. Their mask schedules and evaluation times differ, so the two curves are not identical estimands. Validation selects epoch three.)
\alttext(Three pre-update fitting losses and post-epoch fixed-mask validation losses decrease over the three epochs.)

> Decoder controls and information-path checks

A fresh store restores the selected weights, then evaluates all three pools. Standalone decoding
accepts only four codes and their selector, without images or targets. Repeated and standalone
predictions must agree exactly; a single record must agree with its batch prediction within
2e-6. The controls then (1) replace all hidden input pixels by 1−x, (2) cyclically shift entire
images while retaining each target's selector, (3) zero the codes, (4) use seed 1913 for a second
mask, and (5) reverse the four selector rows. Weights remain unchanged throughout.

Hidden-input independence follows directly: if \(S_b\Delta_b=0\), then
\(S_b(X_b+\Delta_b)=S_bX_b\), so codes and predictions are unchanged. The clean targets can
still change the measured loss. For a four-row permutation R, set S′=RS. Selected patches and
positions both become R times their originals. Shared tokenwise maps and unmasked self-attention
are permutation-equivariant, hence Z′=RZ and \(S'^\top D(Z')=S^\top D(Z)\). Restored predictions
are therefore invariant in exact arithmetic. The test allows Float32 roundoff; it does not
assume that changing which locations are visible leaves the prediction invariant.

```{cpp, results="markdown", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
  namespace n = dm::nn;
  std::map<std::string, n::Tensor> data;
  for (const auto& [name, value] : n::load_npz("build/masked_data.npz"))
    data.emplace(name, value);
  n::ParameterStore p(1877);
  p.load("build/masked_best.npz", false);
  const auto     before = p.flatten();
  n::NoGradGuard guard;
  const auto     images = data.at("test_images"),
             selection  = n::models::MaeSelection(data.at("test_source_ids"));
  const auto net        = n::models::MaskedAutoencoder(p, images, selection),
             repeat     = n::models::MaskedAutoencoder(p, images, selection);
  const auto decoded    = n::models::MaeDecode(p, net.code, selection);
  if (n::max(n::abs(net.prediction - repeat.prediction)).item() != 0 ||
      n::max(n::abs(net.prediction - decoded.prediction)).item() != 0)
    return 1;
  n::NamedTensors saved;
  for (const auto& name : {"fit", "validation", "test"}) {
    const auto s   = n::models::MaeSelection(data.at(std::string(name) + "_source_ids"));
    const auto out = n::models::MaskedAutoencoder(p, data.at(std::string(name) + "_images"), s);
    saved.emplace_back(std::string(name) + "_code", out.code);
    saved.emplace_back(std::string(name) + "_prediction", out.prediction);
    saved.emplace_back(std::string(name) + "_selection", s);
  }
  const auto hidden = n::broadcast_to(n::expand_dims(net.mask, 2), {200, 16, 49});
  const auto altered =
      n::models::MaeImage(net.patches * (1. - hidden) + (1. - net.patches) * hidden)
          .reshape(images.shape());
  const auto perturbed = n::models::MaskedAutoencoder(p, altered, selection);
  if (n::max(n::abs(perturbed.code - net.code)).item() != 0 ||
      n::max(n::abs(perturbed.prediction - net.prediction)).item() != 0)
    return 1;
  const auto shifted_images =
      n::concat({n::slice_axis(images, 0, 1, 200), n::slice_axis(images, 0, 0, 1)}, 0);
  const auto shuffled           = n::models::MaskedAutoencoder(p, shifted_images, selection);
  const auto zero               = n::models::MaeDecode(p, n::zeros({200, 4, 32}), selection);
  const auto second_selection   = n::models::MaeSelection(data.at("test_source_ids"), 0, 1913);
  const auto second             = n::models::MaskedAutoencoder(p, images, second_selection);
  const auto permuted_selection = n::concat(
      {n::slice_axis(selection, 1, 3, 4),
       n::slice_axis(selection, 1, 2, 3),
       n::slice_axis(selection, 1, 1, 2),
       n::slice_axis(selection, 1, 0, 1)},
      1);
  const auto permutation = n::models::MaskedAutoencoder(p, images, permuted_selection);
  const auto single =
      n::models::MaskedAutoencoder(p, n::take_rows(images, {0}), n::take_rows(selection, {0}));
  const double single_error =
                   n::max(n::abs(single.prediction - n::take_rows(net.prediction, {0}))).item(),
               permutation_error = n::max(n::abs(permutation.prediction - net.prediction)).item();
  if (single_error > 2e-6 || permutation_error > 2e-6 || before != p.flatten())
    return 1;
  saved.insert(
      saved.end(),
      {{"zero_prediction", zero.prediction},
       {"shuffled_prediction", shuffled.prediction},
       {"second_selection", second_selection},
       {"second_prediction", second.prediction},
       {"permuted_prediction", permutation.prediction}});
  n::save_npz("build/masked_outputs.npz", saved);
  p.save("build/masked_model_arrays.npz");
  const auto mean = n::broadcast_to(
      n::cast(
          n::mean(n::cast(data.at("fit_images"), n::DType::Float64), {0}, true), n::DType::Float32),
      images.shape());
  n::save_npz("build/masked_mean.npz", {{"mean", mean}});
  auto score = [&](const n::Tensor& prediction, const n::Tensor& mask) {
    return n::models::MaeLoss(
               n::cast(prediction, n::DType::Float64),
               n::cast(net.patches, n::DType::Float64),
               n::cast(mask, n::DType::Float64))
        .item();
  };
  std::print("| held-out reconstruction | hidden-pixel MSE |\n|---|---:|\n");
  for (const auto& [name, prediction] : n::NamedTensors{
           {"raw model", net.prediction},
           {"zero codes", zero.prediction},
           {"misaligned visible content", shuffled.prediction},
           {"fitting pixel mean", n::models::MaePatches(mean)}})
    std::print("| {} | {:.9f} |\n", name, score(prediction, net.mask));
  std::print(
      "| second mask (different task locations) | {:.9f} |\n\nSingle/batch max error {:.9g}; "
      "visible-order max error {:.9g}.\nHidden-input flips, standalone decode, repeat and "
      "immutable weights pass.\n",
      score(second.prediction, second.mask),
      single_error,
      permutation_error);
  const std::vector<std::int64_t> rows{0, 1, 2, 3, 4, 5, 6, 7};
  const auto                      probe_image = n::take_rows(images, rows),
             probe_selection                  = n::take_rows(selection, rows);
  const auto probe = n::models::MaskedAutoencoder(p, probe_image, probe_selection);
  n::save_npz(
      "build/masked_probe.npz",
      {{"images", probe_image},
       {"selection", probe_selection},
       {"patches", probe.patches},
       {"visible", probe.visible},
       {"mask", probe.mask},
       {"encoder_attention", probe.encoder_attention},
       {"decoder_attention", probe.decoder_attention}});
}
```
// result_begin: markdown
| held-out reconstruction | hidden-pixel MSE |
|---|---:|
| raw model | 0.079354655 |
| zero codes | 0.096402311 |
| misaligned visible content | 0.079606451 |
| fitting pixel mean | 0.067858952 |
| second mask (different task locations) | 0.078687050 |

Single/batch max error 0; visible-order max error 2.38418579e-07.
Hidden-input flips, standalone decode, repeat and immutable weights pass.
// result_end

The original raw held-out MSE is 0.07935, zero-code MSE 0.09640, misaligned-content MSE 0.07961,
and second-mask MSE 0.07869. Removing codes hurts, but shifting visible content barely changes
the score. Position structure and broadly shared digit statistics can therefore explain much
of this short run's output. The fitting-only pixel mean is scored on exactly the same hidden
locations and obtains 0.06786, lower than the model's 0.07935. Thus this run does not beat a
constant fitting-mean predictor. A second mask changes the evaluation locations, so its
score is a sensitivity diagnostic, not a paired improvement. No downstream classification,
semantic representation quality or storage bit rate is established.

> Reconstructions without display shortcuts

The first held-out occurrence of each digit 0–9 supplies an unfiltered column. Rows are clean
image, visible input with hidden pixels grey, **raw model prediction**, visible-copy composite,
fitting pixel mean, hidden-only absolute error and zero-code raw prediction. Every panel uses
[0,1] grayscale and nearest-neighbour enlargement; error is unamplified. The composite copies
known pixels explicitly and must not be confused with the raw prediction. Its full-image MSE
would also score the easy copied pixels, unlike the hidden-only objective reported above.

```{cpp, results="markdown", file="figures/masked_reconstructions.png", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
  namespace n = dm::nn;
  std::map<std::string, n::Tensor> data, out;
  for (const auto& [key, value] : n::load_npz("build/masked_data.npz"))
    data.emplace(key, value);
  for (const auto& [key, value] : n::load_npz("build/masked_outputs.npz"))
    out.emplace(key, value);
  const auto mean    = n::load_npz("build/masked_mean.npz")[0].second;
  const auto image   = data.at("test_images").reshape({200, 784});
  const auto raw     = n::models::MaeImage(out.at("test_prediction"));
  const auto mask    = 1. - n::sum(out.at("test_selection"), {1});
  const auto hidden  = n::models::MaeImage(n::broadcast_to(n::expand_dims(mask, 2), {200, 16, 49}));
  const auto visible = image * (1. - hidden) + .5 * hidden,
             composite = image * (1. - hidden) + raw * hidden;
  const auto error     = n::abs(raw - image) * hidden;
  const auto labels    = data.at("test_labels").to_vector<int>(),
             ids       = data.at("test_source_ids").to_vector<int>();
  std::vector<std::int64_t> rows;
  std::print("| digit | MNIST source ID |\n|---:|---:|\n");
  for (int digit = 0; digit < 10; ++digit) {
    const auto found = std::find(labels.begin(), labels.end(), digit);
    if (found == labels.end())
      return 1;
    rows.push_back(found - labels.begin());
    std::print("| {} | {} |\n", digit, ids[rows.back()]);
  }
  std::vector<n::Tensor> panels;
  for (const auto& values : std::vector<n::Tensor>{
           image,
           visible,
           raw,
           composite,
           mean.reshape({200, 784}),
           error,
           n::models::MaeImage(out.at("zero_prediction"))})
    panels.push_back(n::take_rows(values, rows));
  n::save_image_grid(
      n::concat(panels, 0).reshape({70, 28, 28, 1}),
      "build/masked_reconstructions.png",
      10,
      0,
      1,
      2,
      .8,
      3);
}
```
