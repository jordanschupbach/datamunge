> Two complete explicit fitting loops from the same initial function

Both models use seed1853 and start with exactly the same encoder and biases; the untied
matrix is explicitly set to the original encoder transpose. Equal seeds alone would not
match decoder biases and weights after different parameter creation. All initial code and
reconstruction values of the first eight fitting rows must agree bit for bit.

Each variant uses Adam(.003,β1=.9,β2=.999,ε=1e-8), three epochs, batch32, order seed1867
and96 updates including a final eight-image minibatch. Every step recomputes the live tied
transpose and checks all25,088 coordinates after the update. Completed epochs1–3 are
eligible; epoch zero is measured and saved as a control but is not a checkpoint candidate.
Both variants select independently on the same full validation pixel MSE, computed with
Float64 errors from Float32 predictions. Test pixels never select weights. The reported
fitting curve is the row-weighted mean of pre-update batch losses, not a post-epoch full fit.

```{cpp, results="markdown", file="figures/tied_learning.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
  namespace n = dm::nn;
  std::map<std::string, n::Tensor> data;
  for (const auto& [key, value] : n::load_npz("build/tied_data.npz"))
    data.emplace(key, value);
  const auto fit           = data.at("fit_images").reshape({1000, 784}),
             validation    = data.at("validation_images").reshape({200, 784});
  const auto        source = data.at("fit_source_ids").to_vector<int>();
  n::ParameterStore shared(1853), independent(1853);
  {
    n::NoGradGuard guard;
    n::models::TiedAutoencoder(shared, n::zeros({1, 784}));
    n::models::TiedAutoencoder(independent, n::zeros({1, 784}), 784, 32, false);
  }
  for (const auto& name : shared.names())
    independent.set(name, shared.at(name).detach().clone());
  independent.set("decoder/W", n::transpose(shared.at("encoder/W"), {1, 0}).contiguous());
  {
    n::NoGradGuard guard;
    const auto     input = n::take_rows(fit, {0, 1, 2, 3, 4, 5, 6, 7});
    const auto     a     = n::models::TiedAutoencoder(shared, input),
               b         = n::models::TiedAutoencoder(independent, input, 784, 32, false);
    if (!n::equal_bits(a.code, b.code) || !n::equal_bits(a.reconstruction, b.reconstruction))
      return 1;
    n::save_npz(
        "build/tied_initial_forward.npz",
        {{"images", input.reshape({8, 28, 28, 1})},
         {"tied_code", a.code},
         {"untied_code", b.code},
         {"tied_reconstruction", a.reconstruction},
         {"untied_reconstruction", b.reconstruction}});
  }
  auto score = [](const n::Tensor& a, const n::Tensor& b) {
    return n::mean(n::square(n::cast(a, n::DType::Float64) - n::cast(b, n::DType::Float64))).item();
  };
  auto plot = dm::graphics::RPlot::create();
  std::print(
      "| variant | epoch | pre-update fitting MSE | validation MSE |\n|---|---:|---:|---:|\n");
  for (int variant = 0; variant < 2; ++variant) {
    bool              tied   = variant == 0;
    auto&             p      = tied ? shared : independent;
    const std::string prefix = tied ? "build/tied_tied" : "build/tied_untied";
    if (p.count() != (tied ? 25904 : 50992) || p.size() != (tied ? 3u : 4u))
      return 1;
    p.save(prefix + "_initial.npz");
    n::OptimizerConfig config;
    config.kind    = n::OptimizerKind::Adam;
    config.beta1   = .9;
    config.beta2   = .999;
    config.epsilon = 1e-8;
    n::Optimizer  optimizer(p, .003, config);
    n::BatchOrder order(1000, 32, 1867);
    std::ofstream batches(prefix + "_batches.tsv");
    batches << "epoch\tstep\trow\tsource_id\n";
    std::vector<double> epochs, training, valid;
    double              best     = std::numeric_limits<double>::infinity();
    int                 selected = 0, updates = 0;
    {
      n::NoGradGuard guard;
      const auto     initial = n::models::TiedAutoencoder(p, validation, 784, 32, tied);
      n::save_npz(prefix + "_epoch0_validation.npz", {{"prediction", initial.reconstruction}});
      p.save(prefix + "_epoch0.npz");
    }
    for (int epoch = 1; epoch <= 3; ++epoch) {
      order.begin_epoch();
      double total = 0;
      int    seen  = 0;
      for (;;) {
        const auto rows = order.next();
        if (rows.empty())
          break;
        const auto x    = n::take_rows(fit, rows);
        const auto net  = n::models::TiedAutoencoder(p, x, 784, 32, tied);
        const auto loss = n::mean(n::square(net.reconstruction - x));
        if (updates == 0) {
          n::GradOptions keep;
          keep.retain_graph         = true;
          const auto      gradients = n::grad(loss, p.parameters(), keep);
          n::NamedTensors saved;
          for (std::size_t i = 0; i < gradients.size(); ++i) {
            const auto values = gradients[i].to_vector<float>();
            if (std::any_of(
                    values.begin(), values.end(), [](float v) { return !std::isfinite(v); }) ||
                n::sum(n::square(gradients[i])).item() <= 0)
              return 1;
            saved.emplace_back(p.names()[i], gradients[i]);
          }
          n::save_npz(prefix + "_first_gradients.npz", saved);
          n::save_npz(prefix + "_first_batch.npz", {{"images", x.reshape({x.size(0), 28, 28, 1})}});
        }
        const double value = loss.item();
        if (!std::isfinite(value) || value < 0)
          return 1;
        optimizer.minimize(loss);
        total += rows.size() * value;
        seen += int(rows.size());
        for (auto row : rows)
          batches << epoch << '\t' << updates << '\t' << row << '\t' << source[row] << '\n';
        if (tied) {
          n::NoGradGuard guard;
          const auto     actual = n::models::TiedAutoencoder(p, n::zeros({1, 784}));
          if (p.contains("decoder/W") || p.size() != 3 ||
              !n::equal_bits(actual.decoder_weight, n::transpose(p.at("encoder/W"), {1, 0})))
            return 1;
        }
        if (updates == 0)
          p.save(prefix + "_first_update.npz");
        ++updates;
      }
      n::NoGradGuard guard;
      const auto     out    = n::models::TiedAutoencoder(p, validation, 784, 32, tied);
      const double   metric = score(out.reconstruction, validation);
      if (seen != 1000 || !std::isfinite(metric))
        return 1;
      n::save_npz(
          prefix + "_epoch" + std::to_string(epoch) + "_validation.npz",
          {{"prediction", out.reconstruction}});
      p.save(prefix + "_epoch" + std::to_string(epoch) + ".npz");
      if (metric < best) {
        best     = metric;
        selected = epoch;
        p.save(prefix + "_best.npz");
      }
      epochs.push_back(epoch);
      training.push_back(total / seen);
      valid.push_back(metric);
      std::print(
          "| {} | {} | {:.9f} | {:.9f} |\n", tied ? "tied" : "untied", epoch, total / seen, metric);
    }
    if (updates != 96 || optimizer.iterations() != 96 || !batches)
      return 1;
    n::save_npz(
        prefix + "_selection.npz",
        {{"epoch", n::full({}, selected, n::DType::Int32)},
         {"validation_mse", n::full({}, best, n::DType::Float64)},
         {"fit_path", n::from_vector(training, {3})},
         {"validation_path", n::from_vector(valid, {3})}});
    plot.lines(
        epochs,
        valid,
        tied ? "tied validation" : "untied validation",
        tied ? dm::graphics::RGB{37, 99, 235} : dm::graphics::RGB{220, 38, 38},
        2);
    std::print(
        "Selected {} epoch{} from completed epochs only.\n\n", tied ? "tied" : "untied", selected);
  }
  plot.x_label("completed epoch")
      .y_label("validation pixel MSE")
      .title("Same initial function / different shared constraint")
      .save_svg("build/tied_learning.svg");
}
```
