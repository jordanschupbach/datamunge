\caption(The 32-value code is the decoder's sole data input. Weight sharing reduces independent coordinates, not the number of matrix multiplications.)
\alttext(A traced 784 to32 ReLU encoder and32 to784 sigmoid decoder contain three unique leaves and25904 trainable scalars.)

> Native data preparation and untouched partitions

The native loader prepares the original MNIST IDX assets and balanced disjoint pools of
1,000 fitting,200 validation and200 official-test images. Each class contributes100/20/20.
Inputs are Float32 [0,1] pixels with original28×28 geometry; flattening does not resize or
normalize again. Source IDs and provenance are saved. Labels only choose gallery columns.

```{cpp, results="markdown", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
  namespace n = dm::nn;
  std::filesystem::create_directories("build");
  const std::filesystem::path cache = dm::datasets::data_home();
  dm::datasets::prepare_example_data("mnist-assets", cache.string());
  const auto      pools = n::models::LoadSaliency(cache / "saliency");
  n::NamedTensors data;
  std::print("| pool | images | geometry |\n|---|---:|---|\n");
  for (int i = 0; i < 3; ++i) {
    const std::string name = i == 0 ? "fit" : i == 1 ? "validation" : "test";
    data.emplace_back(name + "_images", pools[i].images);
    data.emplace_back(name + "_source_ids", pools[i].source);
    if (i == 2)
      data.emplace_back("test_labels", pools[i].labels);
    std::print("| {} | {} | 28 ×28 ×1 |\n", name, pools[i].images.size(0));
  }
  n::save_npz("build/tied_data.npz", data);
  std::filesystem::copy_file(
      cache / "saliency" / "manifest.json",
      "build/tied_data_manifest.json",
      std::filesystem::copy_options::overwrite_existing);
}
