\caption(Both curves improve over the three completed epochs and select epoch3. This holds initialization, data, order and update budget fixed while changing the parameter constraint and capacity.)
\alttext(Tied and independent validation MSE decrease across three epochs; independent decoding is slightly lower at the end.)

> Fresh restore, standalone decoding and frozen controls

Only the selected matrix/matrices and biases are loaded into new stores. The standalone decoder
consumes code, not the source image or target. Repeat and encode/decode outputs must be bit
identical; single/batch inference agrees within1e-6 and all parameter bytes stay unchanged.
Zero codes remove encoder information; cyclic row shifts preserve the multiset of codes but
misalign each code with its own target. The constant pixel mean is fitted only on the1,000
training rows, accumulating in Float64 before narrowing once to Float32.

```{cpp, results="markdown", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
  namespace n = dm::nn;
  std::map<std::string, n::Tensor> data;
  for (const auto& [key, value] : n::load_npz("build/tied_data.npz"))
    data.emplace(key, value);
  const auto fit        = data.at("fit_images").reshape({1000, 784}),
             test       = data.at("test_images").reshape({200, 784});
  const auto pixel_mean = n::cast(n::mean(n::cast(fit, n::DType::Float64), {0}), n::DType::Float32);
  const auto mean       = n::tile(pixel_mean.reshape({1, 784}), {200, 1}).contiguous();
  n::NamedTensors gallery{
      {"test_images", test},
      {"test_labels", data.at("test_labels")},
      {"test_source_ids", data.at("test_source_ids")},
      {"mean_reconstruction", mean}};
  auto score = [](const n::Tensor& a, const n::Tensor& b) {
    return n::mean(n::square(n::cast(a, n::DType::Float64) - n::cast(b, n::DType::Float64))).item();
  };
  std::print(
      "| variant / control | test MSE |\n|---|---:|\n| fitting pixel mean | {:.9f} |\n",
      score(mean, test));
  for (bool tied : {true, false}) {
    const std::string name = tied ? "tied" : "untied", prefix = "build/tied_" + name;
    n::ParameterStore p(1853);
    {
      n::NoGradGuard guard;
      n::models::TiedAutoencoder(p, n::zeros({1, 784}), 784, 32, tied);
    }
    p.load(prefix + "_best.npz");
    n::NamedTensors before;
    for (const auto& key : p.names())
      before.emplace_back(key, p.at(key).detach().clone());
    n::NoGradGuard  guard;
    n::NamedTensors outputs;
    const auto      selection = n::load_npz(prefix + "_selection.npz");
    double          expected  = 0;
    for (const auto& [key, value] : selection)
      if (key == "validation_mse")
        expected = value.item();
    for (const auto& split : {"fit", "validation", "test"}) {
      const auto x   = data.at(std::string(split) + "_images").reshape({-1, 784});
      const auto out = n::models::TiedAutoencoder(p, x, 784, 32, tied);
      if (std::string(split) == "validation" &&
          std::abs(score(out.reconstruction, x) - expected) > 1e-12)
        return 1;
      outputs.emplace_back(std::string(split) + "_code", out.code);
      outputs.emplace_back(std::string(split) + "_reconstruction", out.reconstruction);
    }
    const auto actual   = n::models::TiedAutoencoder(p, test, 784, 32, tied);
    const auto repeated = n::models::TiedAutoencoder(p, test, 784, 32, tied);
    if (!n::equal_bits(actual.reconstruction, repeated.reconstruction) ||
        !n::equal_bits(
            actual.reconstruction, n::models::TiedAutoencoderDecode(p, actual.code, 784, 32, tied)))
      return 1;
    const auto one = n::models::TiedAutoencoder(p, n::take_rows(test, {0}), 784, 32, tied);
    if (n::max(n::abs(one.reconstruction - n::take_rows(actual.reconstruction, {0}))).item() > 1e-6)
      return 1;
    std::vector<std::int64_t> rows;
    for (int b = 0; b < 200; ++b)
      rows.push_back((b + 1) % 200);
    const auto zero = n::models::TiedAutoencoderDecode(p, n::zeros({200, 32}), 784, 32, tied);
    const auto shifted =
        n::models::TiedAutoencoderDecode(p, n::take_rows(actual.code, rows), 784, 32, tied);
    outputs.emplace_back("zero_reconstruction", zero);
    outputs.emplace_back("shuffled_reconstruction", shifted);
    for (const auto& [key, value] : before)
      if (!n::equal_bits(p.at(key), value))
        return 1;
    p.save(prefix + "_model_arrays.npz");
    n::save_npz(prefix + "_outputs.npz", outputs);
    n::save_npz(
        prefix + "_decoder_weight.npz", {{"decoder_weight", actual.decoder_weight.contiguous()}});
    gallery.emplace_back(name + "_reconstruction", actual.reconstruction);
    if (tied) {
      gallery.emplace_back("zero_reconstruction", zero);
      gallery.emplace_back("shuffled_reconstruction", shifted);
      gallery.emplace_back("absolute_error", n::abs(actual.reconstruction - test));
    }
    std::print(
        "| {} | {:.9f} |\n| {} zero code | {:.9f} |\n| {} shifted codes | {:.9f} |\n",
        name,
        score(actual.reconstruction, test),
        name,
        score(zero, test),
        name,
        score(shifted, test));
  }
  n::save_npz("build/tied_gallery.npz", gallery);
  std::print("Fresh restore, decode/repeat/batch parity and immutable weights pass.\n");
}
```
// result_begin: markdown
| variant / control | test MSE |
|---|---:|
| fitting pixel mean | 0.067798074 |
| tied | 0.049649292 |
| tied zero code | 0.210690986 |
| tied shifted codes | 0.075479784 |
| untied | 0.049003992 |
| untied zero code | 0.220889374 |
| untied shifted codes | 0.067573067 |
Fresh restore, decode/repeat/batch parity and immutable weights pass.
// result_end

The tied result beats the constant mean, but the independent decoder is slightly better under
this short run. Tied shifted-code MSE0.07548 is worse than the fitting mean, while zero-code
MSE0.21069 is much worse; input-specific codes matter for reconstruction. Neither control
establishes semantic disentanglement, recognition accuracy, denoising or generative sampling.
A32-Float32 code has1,024 raw bits before metadata, but no codec, quantization, rate-distortion
curve or stored-file comparison is implemented, so dimension reduction is the supported claim.

> Unfiltered held-out predictions

Columns are the first held-out example of each digit0–9, selected by labels without consulting
reconstruction error. Rows are input, tied, independent, fitting mean, absolute tied error,
tied zero-code and tied shifted-code. Fixed[0,1] grayscale and nearest-neighbour enlargement
are shared by every row, including errors; pixels are not copied into predictions.

```{cpp, results="markdown", file="figures/tied_reconstructions.png", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
  namespace n = dm::nn;
  std::map<std::string, n::Tensor> saved;
  for (const auto& [key, value] : n::load_npz("build/tied_gallery.npz"))
    saved.emplace(key, value);
  const auto labels = saved.at("test_labels").to_vector<int>(),
             ids    = saved.at("test_source_ids").to_vector<int>();
  std::vector<std::int64_t> rows;
  std::print("| digit | original MNIST source ID |\n|---:|---:|\n");
  for (int digit = 0; digit < 10; ++digit) {
    auto found = std::find(labels.begin(), labels.end(), digit);
    if (found == labels.end())
      return 1;
    rows.push_back(found - labels.begin());
    std::print("| {} | {} |\n", digit, ids[rows.back()]);
  }
  std::vector<n::Tensor> panels;
  for (const auto& key :
       {"test_images",
        "tied_reconstruction",
        "untied_reconstruction",
        "mean_reconstruction",
        "absolute_error",
        "zero_reconstruction",
        "shuffled_reconstruction"})
    panels.push_back(n::take_rows(saved.at(key), rows));
  n::save_image_grid(
      n::concat(panels, 0).reshape({70, 28, 28, 1}),
      "build/tied_reconstructions.png",
      10,
      0,
      1,
      2,
      .8,
      3);
}
