\alttext(Three fitting and validation losses decrease; validation reaches about 0.0761 at the third epoch.)

> Fresh restoration and code controls

A fresh store restores the selected checkpoint. Standalone decoding sees only z; exact repeat
and full-model/decode agreement are checked, along with single-versus-batch agreement within
1e-6 and immutable weights. Zero codes remove the encoder state; cyclically shifted codes
misalign it with the target. Reversed input rows deliberately disrupt ordered content while
output positions and the original scoring target stay unchanged. This is not an equivalent
reconstruction task or a training-time augmentation. The fitting-only pixel mean is a constant
baseline computed without validation/test pixels. All controls use frozen decoder weights.

```{cpp, results="markdown", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
  namespace n = dm::nn;
  std::map<std::string, n::Tensor> data;
  for (const auto& [name, value] : n::load_npz("build/recurrent_data.npz"))
    data.emplace(name, value);
  n::ParameterStore p(1871);
  p.load("build/recurrent_best.npz", false);
  const auto      before = p.flatten();
  n::NoGradGuard  guard;
  n::NamedTensors outputs;
  for (const auto& name : {"fit", "validation", "test"}) {
    const auto net = n::models::RecurrentAutoencoder(
        p, n::models::ImageRowSequence(data.at(std::string(name) + "_images")));
    outputs.emplace_back(std::string(name) + "_code", net.code);
    outputs.emplace_back(std::string(name) + "_reconstruction", net.reconstruction);
  }
  const auto test   = n::models::ImageRowSequence(data.at("test_images"));
  const auto net    = n::models::RecurrentAutoencoder(p, test),
             repeat = n::models::RecurrentAutoencoder(p, test);
  if (n::max(n::abs(repeat.reconstruction - net.reconstruction)).item() != 0 ||
      n::max(n::abs(n::models::RecurrentDecode(p, net.code).reconstruction - net.reconstruction))
              .item() != 0)
    return 1;
  const auto zero    = n::models::RecurrentDecode(p, n::zeros({200, 32}));
  const auto shifted = n::models::RecurrentDecode(
      p, n::concat({n::slice_axis(net.code, 0, 1, 200), n::slice_axis(net.code, 0, 0, 1)}, 0));
  std::vector<std::int64_t> rows(28);
  for (int t = 0; t < 28; ++t)
    rows[t] = 27 - t;
  const auto reversed = n::models::RecurrentAutoencoder(
      p, n::gather(test, n::from_vector(rows, {28}), 1).contiguous());
  outputs.insert(
      outputs.end(),
      {{"zero_reconstruction", zero.reconstruction},
       {"shuffled_reconstruction", shifted.reconstruction},
       {"reversed_code", reversed.code},
       {"reversed_reconstruction", reversed.reconstruction}});
  n::save_npz("build/recurrent_outputs.npz", outputs);
  p.save("build/recurrent_model_arrays.npz");
  const auto images = n::take_rows(data.at("test_images"), {0, 1, 2, 3, 4, 5, 6, 7});
  const auto probe  = n::models::RecurrentAutoencoder(p, n::models::ImageRowSequence(images));
  n::save_npz(
      "build/recurrent_states.npz",
      {{"images", images},
       {"encoder_states", probe.encoder_states},
       {"decoder_states", probe.decoder_states}});
  const auto   single = n::models::RecurrentAutoencoder(p, n::take_rows(test, {0}));
  const double single_error =
      n::max(n::abs(single.reconstruction - n::take_rows(net.reconstruction, {0}))).item();
  if (single_error > 1e-6 || before != p.flatten())
    return 1;
  const auto mean = n::broadcast_to(
      n::cast(
          n::mean(n::cast(data.at("fit_images"), n::DType::Float64), {0}, true), n::DType::Float32),
      data.at("test_images").shape());
  n::save_npz("build/recurrent_mean.npz", {{"mean", mean}});
  std::print("| reconstruction | held-out MSE against original order |\n|---|---:|\n");
  for (const auto& [name, prediction] : n::NamedTensors{
           {"model", net.reconstruction},
           {"zero code", zero.reconstruction},
           {"shifted code", shifted.reconstruction},
           {"reversed encoder rows", reversed.reconstruction},
           {"fitting pixel mean", mean.reshape({200, 28, 28})}})
    std::print(
        "| {} | {:.9f} |\n",
        name,
        n::mse(n::cast(prediction, n::DType::Float64), n::cast(test, n::DType::Float64)).item());
  std::print(
      "Single/batch max error {:.9g}; fresh restore, exact repeat/decode and immutable weights "
      "pass.\n",
      single_error);
}
```
// result_begin: markdown
| reconstruction | held-out MSE against original order |
|---|---:|
| model | 0.079884621 |
| zero code | 0.112504660 |
| shifted code | 0.079947607 |
| reversed encoder rows | 0.079941284 |
| fitting pixel mean | 0.067798074 |
Single/batch max error 0; fresh restore, exact repeat/decode and immutable weights pass.
// result_end

The model's original test MSE is0.07988; zero codes give 0.11250 and shifted codes 0.07995.
The fitting mean is about 0.06780, lower than the learned model. Thus this short run does not
beat a constant fitting-mean predictor, and little of its average error depends on correct code
alignment. A 32-value state can carry input information without retaining enough useful digit
identity for reconstruction. These are one-seed results, not evidence of convergence or a
classification/compression result. No classification confusion matrix applies to pixel MSE.

> How far does the gradient travel

The encoder-state and decoder-state archives retain every time step for the first eight held-out
records. This diagnostic differentiates reconstruction MSE with respect to those input rows,
**holding targets fixed**. Detaching the target is essential here: otherwise a second direct
target derivative would be added to the model-path derivative. The plotted RMS averages squared
input derivatives over the eight records and twenty-eight features for each row. Earlier rows
can have smaller sensitivities because their effect passes through more recurrent Jacobians;
the measurements describe these weights and records, not a universal monotonic law.
The vertical axis uses log10: a unit is a tenfold difference. Here first-row RMS is
2.77e-10 versus 9.11e-5 for the last, about 3.04e-6 as large.

```{cpp, results="markdown", file="figures/recurrent_gradients.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
  namespace n = dm::nn;
  n::ParameterStore p(1871);
  p.load("build/recurrent_best.npz", false);
  std::map<std::string, n::Tensor> saved;
  for (const auto& [name, value] : n::load_npz("build/recurrent_states.npz"))
    saved.emplace(name, value);
  const auto input      = n::models::ImageRowSequence(saved.at("images")).detach().requires_grad_();
  const auto net        = n::models::RecurrentAutoencoder(p, input);
  const auto objective  = n::mse(net.reconstruction, input.detach());
  const auto derivative = n::grad(objective, {input})[0];
  const auto rms  = n::sqrt(n::mean(n::square(n::cast(derivative, n::DType::Float64)), {0, 2}));
  const auto norm = rms.to_vector<double>();
  std::vector<double> steps(28);
  std::iota(steps.begin(), steps.end(), 1.);
  if (!std::all_of(norm.begin(), norm.end(), [](double v) { return std::isfinite(v) && v > 0; }))
    return 1;
  n::save_npz(
      "build/recurrent_input_gradients.npz",
      {{"images", saved.at("images")}, {"gradient", derivative}, {"row_rms", rms}});
  dm::graphics::RPlot::create()
      .lines(
          steps,
          (n::log(rms) / std::log(10.)).to_vector<double>(),
          "model-path input derivative",
          {37, 99, 235},
          2.)
      .x_label("input row (1 = first)")
      .y_label("log10 RMS derivative, fixed reconstruction targets")
      .title("Input sensitivity through the final-state bottleneck")
      .save_svg("build/recurrent_gradients.svg");
  std::print(
      "First-row RMS {:.9g}; last-row RMS {:.9g}. All 28 rows have finite nonzero model-path "
      "gradients.\n",
      norm.front(),
      norm.back());
}
```
// result_begin: markdown
First-row RMS 2.76718874e-10; last-row RMS 9.1098557e-05. All 28 rows have finite nonzero model-path gradients.
\image(figures/recurrent_gradients.svg)
// result_end

\caption(Input derivative magnitudes with fixed targets for eight held-out records. All steps remain differentiable; gradient size and useful retained information are distinct questions.)
\alttext(A curve shows the RMS reconstruction derivative for each of the twenty-eight input rows, computed through the encoder and decoder with targets held fixed.)

> Reconstructions in a fixed display scale

The first held-out occurrence of each digit 0–9 defines one column, without quality filtering.
Rows are clean image, reconstruction, fitting mean, absolute error, zero-code decoder,
shifted-code decoder and reversed-input reconstruction. Every row uses [0,1] grayscale,
nearest-neighbour enlargement and no error amplification. Decoder outputs are raw predictions;
there is no copied-pixel display composite. Reversing rows changes only encoder inputs in that
control, not the clean image in the first row or the target used in the table.

```{cpp, results="markdown", file="figures/recurrent_reconstructions.png", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
  namespace n = dm::nn;
  std::map<std::string, n::Tensor> data, out;
  for (const auto& [key, value] : n::load_npz("build/recurrent_data.npz"))
    data.emplace(key, value);
  for (const auto& [key, value] : n::load_npz("build/recurrent_outputs.npz"))
    out.emplace(key, value);
  const auto mean   = n::load_npz("build/recurrent_mean.npz")[0].second;
  const auto clean  = data.at("test_images").reshape({200, 28, 28});
  const auto labels = data.at("test_labels").to_vector<int>(),
             ids    = data.at("test_source_ids").to_vector<int>();
  std::vector<std::int64_t> rows;
  std::print("| digit | original MNIST source ID |\n|---:|---:|\n");
  for (int digit = 0; digit < 10; ++digit) {
    const auto found = std::find(labels.begin(), labels.end(), digit);
    if (found == labels.end())
      return 1;
    rows.push_back(found - labels.begin());
    std::print("| {} | {} |\n", digit, ids[rows.back()]);
  }
  std::vector<n::Tensor> panels;
  for (const auto& values : std::vector<n::Tensor>{
           clean,
           out.at("test_reconstruction"),
           mean.reshape({200, 28, 28}),
           n::abs(out.at("test_reconstruction") - clean),
           out.at("zero_reconstruction"),
           out.at("shuffled_reconstruction"),
           out.at("reversed_reconstruction")})
    panels.push_back(n::take_rows(values, rows));
  n::save_image_grid(
      n::concat(panels, 0).reshape({70, 28, 28, 1}),
      "build/recurrent_reconstructions.png",
      10,
      0,
      1,
      2,
      .8,
      3);
}
```
