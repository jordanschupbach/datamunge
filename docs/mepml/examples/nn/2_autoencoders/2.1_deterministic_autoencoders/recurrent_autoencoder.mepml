> Original genuine-MNIST pools

Native preparation loads the same balanced 1,000 fitting, 200 validation and 200 test records.
Fitting and validation have disjoint official training IDs; test records come from the official
test split. Float32 NHWC pixels lie in [0,1]. `ImageRowSequence` views rows without resizing
or reversing them. The source manifest and IDs are retained; labels affect gallery order only.

```{cpp, results="markdown", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
  namespace n = dm::nn;
  std::filesystem::create_directories("build");
  const std::filesystem::path cache = dm::datasets::data_home();
  dm::datasets::prepare_example_data("mnist-assets", cache.string());
  const auto      pools = n::models::LoadSaliency(cache / "saliency");
  n::NamedTensors data;
  std::print("| pool | images | steps | features |\n|---|---:|---:|---:|\n");
  for (int split = 0; split < 3; ++split) {
    const std::string name = split == 0 ? "fit" : split == 1 ? "validation" : "test";
    data.emplace_back(name + "_images", pools[split].images);
    data.emplace_back(name + "_source_ids", pools[split].source);
    if (split == 2)
      data.emplace_back("test_labels", pools[split].labels);
    std::print("| {} | {} | 28 | 28 |\n", name, pools[split].images.size(0));
  }
  n::save_npz("build/recurrent_data.npz", data);
  std::filesystem::copy_file(
      cache / "saliency" / "manifest.json",
      "build/recurrent_data_manifest.json",
      std::filesystem::copy_options::overwrite_existing);
}
```
