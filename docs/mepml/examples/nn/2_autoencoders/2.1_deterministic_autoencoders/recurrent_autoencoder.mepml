> Three epochs with explicit Adam updates

Seed 1871 initializes the eight leaves with the source's cell/projection initializers. Adam
uses learning rate 0.003, moments 0.9/0.999 and epsilon 1e-8. Batch seed 1873, batch size 32 and a
final batch of eight give 32 updates per epoch and 96 in total. Each record appears once per
epoch. Every encoder and decoder step participates in the gradient. Validation MSE accumulated
in Float64 from Float32 predictions selects the checkpoint; held-out pixels do not influence
selection. Training values are pre-update batch means, while validation uses post-epoch weights.
Initial weights/outputs, first gradients/batch/update, every epoch and selected weights are saved.

```{cpp, results="markdown", file="figures/recurrent_learning.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
  namespace n = dm::nn;
  std::map<std::string, n::Tensor> data;
  for (const auto& [name, value] : n::load_npz("build/recurrent_data.npz"))
    data.emplace(name, value);
  const auto fit        = n::models::ImageRowSequence(data.at("fit_images")),
             validation = n::models::ImageRowSequence(data.at("validation_images")),
             test       = n::models::ImageRowSequence(data.at("test_images"));
  n::ParameterStore p(1871);
  {
    n::NoGradGuard guard;
    n::models::RecurrentAutoencoder(p, n::zeros({1, 28, 28}));
    p.save("build/recurrent_initial.npz");
    const auto initial = n::models::RecurrentAutoencoder(p, test);
    n::save_npz(
        "build/recurrent_initial_outputs.npz",
        {{"code", initial.code}, {"reconstruction", initial.reconstruction}});
  }
  n::OptimizerConfig config;
  config.kind = n::OptimizerKind::Adam;
  n::Optimizer  optimizer(p, .003, config);
  n::BatchOrder batches(1000, 32, 1873);
  const auto    source = data.at("fit_source_ids").to_vector<int>();
  std::ofstream order("build/recurrent_batches.tsv");
  order << "epoch\tstep\trow\tsource_id\n";
  double              best     = std::numeric_limits<double>::infinity();
  int                 selected = 0, updates = 0;
  std::vector<double> epochs, train, valid;
  std::print("| epoch | fitting pre-update MSE | validation MSE |\n|---:|---:|---:|\n");
  for (int epoch = 1; epoch <= 3; ++epoch) {
    batches.begin_epoch();
    double total = 0;
    int    seen  = 0;
    for (;;) {
      const auto rows = batches.next();
      if (rows.empty())
        break;
      const auto sequence  = n::take_rows(fit, rows);
      const auto net       = n::models::RecurrentAutoencoder(p, sequence);
      const auto objective = n::mse(net.reconstruction, sequence);
      if (updates == 0) {
        n::GradOptions keep;
        keep.retain_graph         = true;
        const auto      gradients = n::grad(objective, p.parameters(), keep);
        n::NamedTensors saved;
        for (std::size_t i = 0; i < gradients.size(); ++i) {
          const double norm = n::sqrt(n::sum(n::square(gradients[i]))).item();
          if (!std::isfinite(norm) || norm <= 0)
            return 1;
          saved.emplace_back(p.names()[i], gradients[i]);
        }
        n::save_npz("build/recurrent_first_gradients.npz", saved);
        n::save_npz(
            "build/recurrent_first_batch.npz",
            {{"images", sequence.reshape({sequence.size(0), 28, 28, 1})}});
      }
      const double value = objective.item();
      if (!std::isfinite(value) || value < 0)
        return 1;
      optimizer.minimize(objective);
      total += rows.size() * value;
      seen += int(rows.size());
      for (auto row : rows)
        order << epoch << '\t' << updates << '\t' << row << '\t' << source[row] << '\n';
      if (updates == 0)
        p.save("build/recurrent_first_update.npz");
      ++updates;
    }
    n::NoGradGuard guard;
    const auto     net = n::models::RecurrentAutoencoder(p, validation);
    const double   score =
        n::mse(
            n::cast(net.reconstruction, n::DType::Float64), n::cast(validation, n::DType::Float64))
            .item();
    if (seen != 1000 || !std::isfinite(score))
      return 1;
    p.save("build/recurrent_epoch" + std::to_string(epoch) + ".npz");
    if (score < best) {
      best     = score;
      selected = epoch;
      p.save("build/recurrent_best.npz");
    }
    epochs.push_back(epoch);
    train.push_back(total / seen);
    valid.push_back(score);
    std::print("| {} | {:.9f} | {:.9f} |\n", epoch, total / seen, score);
  }
  if (updates != 96 || !order)
    return 1;
  n::save_npz(
      "build/recurrent_selection.npz",
      {{"epoch", n::full({}, selected, n::DType::Int32)},
       {"validation_mse", n::full({}, best, n::DType::Float64)}});
  dm::graphics::RPlot::create()
      .lines(epochs, train, "pre-update fit", {37, 99, 235}, 2.)
      .lines(epochs, valid, "validation", {220, 38, 38}, 2.)
      .x_label("epoch")
      .y_label("mean squared pixel error")
      .title("Recurrent autoencoder: three epochs / 96 Adam updates")
      .save_svg("build/recurrent_learning.svg");
  std::print(
      "Selected epoch {}; {} updates; all eight first parameter gradients finite and nonzero.\n",
      selected,
      updates);
}
```
