> Matched weights, explicit gated fitting and ungated selection

Both stores use seed1931, independent Glorot matrices and zero biases. Every initial parameter
byte agrees, and because deployment bypasses lifetime competition, the initial deployed codes
and reconstructions agree too. The training maps differ. Each variant uses three epochs,
96 Adam(.003,β1=.9,β2=.999,ε=1e-8) updates, batch32 and batch-order seed1933, with all1,000
rows once per epoch and a final batch of eight. The plain control retains the same ReLU
encoder, parameter count and decoder while bypassing training competition.

The training loss uses **training_reconstruction**; validation uses **reconstruction**, the
ungated deployment endpoint. Each variant selects independently among completed epochs1–3 by
full validation MSE, accumulating Float64 errors from Float32 outputs. Epoch zero is measured
and saved but is ineligible. Fitting losses are row-weighted pre-update minibatch means, not a
full-pool gated or deployed metric. Test pixels never select weights. The loop saves exact row
orders, all parameter snapshots, all validation outputs, first gradients/update and both the
first32-row and first eight-row partial-batch gate probes.

```{cpp, results="markdown", file="figures/wta_learning.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
  namespace n = dm::nn;
  std::map<std::string, n::Tensor> data;
  for (const auto& [name, value] : n::load_npz("build/wta_data.npz"))
    data.emplace(name, value);
  const auto fit                = data.at("fit_images"),
             validation         = data.at("validation_images").reshape({200, 784});
  const auto               test = data.at("test_images").reshape({200, 784});
  std::vector<double>      matched;
  std::vector<std::string> gradient_notes;
  auto                     plot = dm::graphics::RPlot::create();
  std::print("| model | epoch | fitting pre-update MSE | validation MSE |\n|---|---:|---:|---:|\n");
  for (bool plain : {false, true}) {
    const std::string name = plain ? "plain" : "competitive", prefix = "build/wta_" + name;
    n::ParameterStore p(1931);
    {
      n::NoGradGuard guard;
      const auto     net = n::models::CompetitiveAutoencoder(p, n::zeros({1, 784}), true, plain);
    }
    if (plain) {
      if (p.flatten() != matched)
        return 1;
    } else
      matched = p.flatten();
    if (p.count() != 101200 || p.size() != 4)
      return 1;
    p.save(prefix + "_initial.npz");
    {
      n::NoGradGuard guard;
      const auto     initial = n::models::CompetitiveAutoencoder(p, test, true, plain);
      n::save_npz(
          prefix + "_initial_outputs.npz",
          {{"code", initial.code}, {"reconstruction", initial.reconstruction}});
    }
    n::OptimizerConfig config;
    config.kind = n::OptimizerKind::Adam;
    n::Optimizer        optimizer(p, .003, config);
    n::BatchOrder       batches(1000, 32, 1933);
    double              best     = std::numeric_limits<double>::infinity();
    int                 selected = 0, updates = 0;
    std::vector<double> epochs, valid, training;
    const auto          source = data.at("fit_source_ids").to_vector<int>();
    std::ofstream       order(prefix + "_batches.tsv");
    order << "epoch\tstep\trow\tsource_id\n";
    {
      n::NoGradGuard guard;
      const auto     initial = n::models::CompetitiveAutoencoder(p, validation, true, plain);
      p.save(prefix + "_epoch0.npz");
      n::save_npz(prefix + "_epoch0_validation.npz", {{"prediction", initial.reconstruction}});
    }
    for (int epoch = 1; epoch <= 3; ++epoch) {
      batches.begin_epoch();
      double total = 0;
      int    seen  = 0;
      for (;;) {
        const auto rows = batches.next();
        if (rows.empty())
          break;
        const auto images = n::take_rows(fit, rows), input = images.reshape({images.size(0), 784});
        const auto net       = n::models::CompetitiveAutoencoder(p, input, true, plain);
        const auto objective = n::mse(net.training_reconstruction, input);
        if (n::max(
                n::abs(
                    n::sum(net.mask, {0}) -
                    (plain ? double(input.size(0)) : double((input.size(0) + 7) / 8))))
                .item() != 0)
          return 1;
        if (updates == 0 || updates == 31) {
          n::NoGradGuard guard;
          const auto     probe = n::models::CompetitiveAutoencoder(p, input, true, plain);
          if (updates == 31)
            p.save(prefix + "_partial_arrays.npz");
          n::NamedTensors arrays;
          if (updates == 31)
            arrays.emplace_back("images", images);
          arrays.insert(
              arrays.end(),
              {{"raw", probe.raw},
               {"mask", probe.mask},
               {"training_code", probe.training_code},
               {"reconstruction", probe.training_reconstruction}});
          n::save_npz(prefix + (updates == 0 ? "_first_probe.npz" : "_partial_probe.npz"), arrays);
        }
        if (updates == 0) {
          n::GradOptions keep;
          keep.retain_graph         = true;
          const auto      gradients = n::grad(objective, p.parameters(), keep);
          n::NamedTensors arrays;
          for (std::size_t i = 0; i < gradients.size(); ++i) {
            const double norm = n::sqrt(n::sum(n::square(gradients[i]))).item();
            if (!std::isfinite(norm) || norm <= 0)
              return 1;
            arrays.emplace_back(p.names()[i], gradients[i]);
            gradient_notes.push_back(
                std::format("| {} | {} | {:.8f} |\n", name, p.names()[i], norm));
          }
          n::save_npz(prefix + "_first_gradients.npz", arrays);
          n::save_npz(prefix + "_first_batch.npz", {{"images", images}});
        }
        const double value = objective.item();
        if (!std::isfinite(value) || value < 0)
          return 1;
        total += rows.size() * value;
        seen += int(rows.size());
        optimizer.minimize(objective);
        if (updates == 0)
          p.save(prefix + "_first_update.npz");
        for (auto row : rows)
          order << epoch << '\t' << updates << '\t' << row << '\t' << source[row] << '\n';
        ++updates;
      }
      n::NoGradGuard guard;
      const auto     prediction =
          n::models::CompetitiveAutoencoder(p, validation, true, plain).reconstruction;
      const double score =
          n::mse(n::cast(prediction, n::DType::Float64), n::cast(validation, n::DType::Float64))
              .item();
      if (seen != 1000 || !std::isfinite(score))
        return 1;
      p.save(prefix + "_epoch" + std::to_string(epoch) + ".npz");
      n::save_npz(
          prefix + "_epoch" + std::to_string(epoch) + "_validation.npz",
          {{"prediction", prediction}});
      if (score < best) {
        best     = score;
        selected = epoch;
        p.save(prefix + "_best.npz");
      }
      epochs.push_back(epoch);
      valid.push_back(score);
      training.push_back(total / seen);
      std::print("| {} | {} | {:.9f} | {:.9f} |\n", name, epoch, total / seen, score);
    }
    if (updates != 96 || optimizer.iterations() != 96 || !order)
      return 1;
    n::save_npz(
        prefix + "_selection.npz",
        {{"epoch", n::full({}, selected, n::DType::Int32)},
         {"validation_mse", n::full({}, best, n::DType::Float64)},
         {"fit_path", n::from_vector(training, {3})},
         {"validation_path", n::from_vector(valid, {3})}});
    plot.lines(
        epochs,
        valid,
        name + " validation",
        plain ? dm::graphics::RGB{220, 38, 38} : dm::graphics::RGB{37, 99, 235},
        2.);
  }
  std::print("\n| model | parameter | first gradient L2 norm |\n|---|---|---:|\n");
  for (const auto& line : gradient_notes)
    std::print("{}", line);
  plot.x_label("epoch")
      .y_label("validation mean squared pixel error")
      .title("Lifetime-gated training / full-code validation / matched plain ReLU")
      .save_svg("build/wta_learning.svg");
}
```
