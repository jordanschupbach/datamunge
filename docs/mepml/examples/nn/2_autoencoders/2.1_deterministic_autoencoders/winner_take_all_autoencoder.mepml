> Fresh deployment, training diagnostics and code controls

Fresh stores restore selected weights. Full-pool deployed predictions, exact repeat/standalone
decoding, single-versus-batch inference and immutable parameter bytes are checked. A separate
32-row held-out probe is explicitly a **training-mode diagnostic**, not a deployment code.
A code-row shift preserves the multiset of deployed codes while misaligning targets; zero codes
remove encoder information. Both frozen decoder controls are scored without refitting. The
fitting pixel mean uses only1,000 fitting images, accumulating Float64 then narrowing once.

```{cpp, results="markdown", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
  namespace n = dm::nn;
  std::map<std::string, n::Tensor> data;
  for (const auto& [name, value] : n::load_npz("build/wta_data.npz"))
    data.emplace(name, value);
  const auto clean = data.at("test_images").reshape({200, 784});
  const auto mean  = n::broadcast_to(
      n::cast(
          n::mean(
              n::cast(data.at("fit_images").reshape({1000, 784}), n::DType::Float64), {0}, true),
          n::DType::Float32),
      clean.shape());
  n::save_npz("build/wta_mean.npz", {{"mean", mean}});
  std::print(
      "| model | held-out MSE | zero-code MSE | shifted-code MSE | selected training-probe rows "
      "per feature | deployed nonzero fraction "
      "|\n|---|---:|---:|---:|---:|---:|\n");
  for (bool plain : {false, true}) {
    const std::string name = plain ? "plain" : "competitive", prefix = "build/wta_" + name;
    n::ParameterStore p(1931);
    p.load(prefix + "_best.npz", false);
    const auto      before = p.flatten();
    n::NoGradGuard  guard;
    n::NamedTensors outputs, diagnostics;
    for (const auto& split : {"fit", "validation", "test"}) {
      const auto images = data.at(std::string(split) + "_images");
      const auto net =
          n::models::CompetitiveAutoencoder(p, images.reshape({images.size(0), 784}), true, plain);
      outputs.emplace_back(std::string(split) + "_code", net.code);
      outputs.emplace_back(std::string(split) + "_reconstruction", net.reconstruction);
      diagnostics.emplace_back(std::string(split) + "_raw", net.raw);
      diagnostics.emplace_back(std::string(split) + "_mask", net.mask);
    }
    const auto net    = n::models::CompetitiveAutoencoder(p, clean, true, plain);
    const auto repeat = n::models::CompetitiveAutoencoder(p, clean, true, plain);
    const auto single = n::models::CompetitiveAutoencoder(p, n::take_rows(clean, {0}), true, plain);
    const auto decoded = n::dense(p, "decoder", net.code, 784, n::Activation::Sigmoid);
    if (n::max(n::abs(repeat.reconstruction - net.reconstruction)).item() != 0 ||
        n::max(n::abs(decoded - net.reconstruction)).item() != 0 ||
        n::max(n::abs(single.reconstruction - n::take_rows(net.reconstruction, {0}))).item() > 1e-6)
      return 1;
    const auto zero = n::dense(p, "decoder", n::zeros({200, 64}), 784, n::Activation::Sigmoid);
    const auto shifted_code =
        n::concat({n::slice_axis(net.code, 0, 1, 200), n::slice_axis(net.code, 0, 0, 1)}, 0);
    const auto shifted = n::dense(p, "decoder", shifted_code, 784, n::Activation::Sigmoid);
    outputs.emplace_back("zero_reconstruction", zero);
    outputs.emplace_back("shuffled_reconstruction", shifted);
    double selected_score = 0;
    for (const auto& [key, value] : n::load_npz(prefix + "_selection.npz"))
      if (key == "validation_mse")
        selected_score = value.item();
    const auto val    = outputs[3].second;
    const auto target = data.at("validation_images").reshape({200, 784});
    if (std::abs(
            n::mse(n::cast(val, n::DType::Float64), n::cast(target, n::DType::Float64)).item() -
            selected_score) > 1e-12)
      return 1;
    n::save_npz(prefix + "_outputs.npz", outputs);
    n::save_npz(prefix + "_deployment_diagnostics.npz", diagnostics);
    p.save(prefix + "_model_arrays.npz");
    std::vector<std::int64_t> rows(32);
    std::iota(rows.begin(), rows.end(), 0);
    const auto images = n::take_rows(data.at("test_images"), rows);
    const auto probe = n::models::CompetitiveAutoencoder(p, images.reshape({32, 784}), true, plain);
    n::save_npz(
        prefix + "_selected_probe.npz",
        {{"images", images},
         {"raw", probe.raw},
         {"mask", probe.mask},
         {"training_code", probe.training_code},
         {"reconstruction", probe.training_reconstruction}});
    if (before != p.flatten() ||
        n::max(n::abs(n::sum(probe.mask, {0}) - (plain ? 32. : 4.))).item() != 0)
      return 1;
    std::print(
        "| {} | {:.9f} | {:.9f} | {:.9f} | {} | {:.6f} |\n",
        name,
        n::mse(n::cast(net.reconstruction, n::DType::Float64), n::cast(clean, n::DType::Float64))
            .item(),
        n::mse(n::cast(zero, n::DType::Float64), n::cast(clean, n::DType::Float64)).item(),
        n::mse(n::cast(shifted, n::DType::Float64), n::cast(clean, n::DType::Float64)).item(),
        plain ? 32 : 4,
        n::count_nonzero(net.code).item() / net.code.numel());
  }
  std::print(
      "\nFitting-mean MSE {:.9f}. Fresh restore, exact encode/decode/repeat and immutable weights "
      "pass.\n",
      n::mse(n::cast(mean, n::DType::Float64), n::cast(clean, n::DType::Float64)).item());
}
