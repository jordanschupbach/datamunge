> The same observation, different batch companions

Let W_e be a3×2 matrix of0.2 and b_e=[0.1,0.1]. For the observation[1,1,1], both ReLU
activities are0.7. In a batch with seven all-zero companions, this row wins both features.
With seven[2,2,2] companions it loses both, since their activities are1.3. The training code
changes from[0.7,0.7] to[0,0], while deployment code and predictions stay unchanged. This is
not a row-wise training function. Changing minibatch composition changes the objective even
at fixed parameters; a full-pool gated loss is not the sum of the minibatch gated losses.

```{cpp, results="markdown", file="figures/wta_context.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
  namespace n            = dm::nn;
  const auto        type = n::DType::Float64;
  n::ParameterStore p(1931, type);
  const auto        sample = n::ones({1, 3}, type);
  n::models::CompetitiveAutoencoder(p, sample, true, false, 3, 2);
  p.set("encoder/W", n::full({3, 2}, .2, type));
  p.set("encoder/b", n::full({2}, .1, type));
  p.set("decoder/W", n::full({2, 3}, .2, type));
  p.set("decoder/b", n::zeros({3}, type));
  const auto low = n::models::CompetitiveAutoencoder(
      p, n::concat({sample, n::zeros({7, 3}, type)}, 0), true, false, 3, 2);
  const auto high = n::models::CompetitiveAutoencoder(
      p, n::concat({sample, n::full({7, 3}, 2, type)}, 0), true, false, 3, 2);
  const auto only = n::models::CompetitiveAutoencoder(p, sample, true, false, 3, 2);
  if (n::sum(n::take_rows(low.mask, {0})).item() != 2 ||
      n::sum(n::take_rows(high.mask, {0})).item() != 0 ||
      !n::equal_bits(n::take_rows(low.code, {0}), n::take_rows(high.code, {0})) ||
      !n::equal_bits(
          n::take_rows(low.reconstruction, {0}), n::take_rows(high.reconstruction, {0})) ||
      !n::equal_bits(only.reconstruction, n::take_rows(low.reconstruction, {0})) ||
      n::max(
          n::abs(
              n::take_rows(low.training_reconstruction, {0}) -
              n::take_rows(high.training_reconstruction, {0})))
              .item() <= 0)
    return 1;
  std::print(
      "| companion rows | training code for fixed row | deployment code | first training pixel | "
      "deployment pixel |\n|---|---|---|---:|---:|\n");
  for (const auto& [label, out] :
       std::vector<std::pair<std::string, n::models::CompetitiveAeOutput>>{
           {"seven zeros", low}, {"seven twos", high}})
    std::print(
        "| {} | {} | {} | {:.9f} | {:.9f} |\n",
        label,
        n::take_rows(out.training_code, {0}).values_str(),
        n::take_rows(out.code, {0}).values_str(),
        out.training_reconstruction.at({0, 0}),
        out.reconstruction.at({0, 0}));
  dm::graphics::Diagram d(56, 1100);
  d.node("x", {0, 0}, "Fixed observation [1,1,1]\nReLU code [0.7,0.7]")
      .node("low", {6, 2}, "Seven zero companions\nFixed row wins both features")
      .node("high", {6, -2}, "Seven two companions\nFixed row loses both features")
      .node("lt", {13, 2}, "Training code [0.7,0.7]\nTraining pixels ≈0.569546")
      .node("ht", {13, -2}, "Training code [0,0]\nTraining pixels 0.5")
      .node("deploy", {6, -5}, "Deployment ignores companions\nCode [0.7,0.7], pixels ≈0.569546")
      .edge("x", "low")
      .edge("x", "high")
      .edge("low", "lt")
      .edge("high", "ht")
      .edge("x", "deploy")
      .save_svg("build/wta_context.svg");
}
```
