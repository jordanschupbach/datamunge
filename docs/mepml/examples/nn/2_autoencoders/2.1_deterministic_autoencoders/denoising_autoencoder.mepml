| pool | images | pixels per image | examples per digit |
|---|---:|---:|---:|
| fit | 1000 | 784 | 100 |
| validation | 200 | 784 | 20 |
| test | 200 | 784 | 20 |
// result_end

\caption(All three genuine-MNIST pools are class-balanced. Labels never enter fitting or checkpoint selection.)

> Two matched fits, with every update visible

Both stores start from seed 1657, and their four initial tensors are checked for exact agreement.
Each model makes 96 Adam updates: three epochs, batch size 32, all 1,000 records once per epoch,
including a final batch of eight. Batch seed 1663 gives matched row order. Adam uses learning
rate 0.003, moments 0.9/0.999 and epsilon 1e-8. The denoiser receives fresh full-pool corruption
from seeds 1672, 1673 and 1674. The ordinary control always receives clean inputs. Every target
is the clean original, including for the denoiser.

Both select their own checkpoint using the same fixed noisy validation inputs and clean targets;
the ordinary model is therefore selected for this denoising task rather than for clean
reconstruction. Validation selection uses the source's Float32 tensor MSE; held-out reporting
later accumulates errors in Float64. Fitting losses below are measured before each update and
validation losses after each epoch. Gradient norms, first batches and all parameter snapshots
are saved. No optimizer loop is hidden in a model helper.

```{cpp, results="markdown", file="figures/denoising_learning.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
  namespace n = dm::nn;
  std::map<std::string, n::Tensor> data;
  for (const auto& [name, value] : n::load_npz("build/denoising_data.npz"))
    data.emplace(name, value);
  const auto               fit               = data.at("fit_images");
  const auto               validation        = data.at("validation_corrupted").reshape({200, 784});
  const auto               validation_target = data.at("validation_images").reshape({200, 784});
  std::vector<double>       matched_initial;
  auto                     plot = dm::graphics::RPlot::create();
  std::vector<std::string> gradient_notes;
  std::print(
      "| fit | epoch | fitting pre-update clean-target MSE | fixed noisy-validation MSE "
      "|\n|---|---:|---:|---:|\n");
  for (const std::string variant : {"denoising", "ordinary"}) {
    const std::string prefix = "build/denoising_" + variant;
    n::ParameterStore p(1657);
    {
      n::NoGradGuard guard;
      n::models::UndercompleteAutoencoder(p, n::zeros({1, 784}));
    }
    if (variant == "denoising")
      matched_initial = p.flatten();
    else if (matched_initial != p.flatten())
      return 1;
    p.save(prefix + "_initial.npz");
    n::OptimizerConfig config;
    config.kind = n::OptimizerKind::Adam;
    n::Optimizer        optimizer(p, .003, config);
    n::BatchOrder       batches(1000, 32, 1663);
    double              best     = std::numeric_limits<double>::infinity();
    int                 selected = 0, updates = 0;
    std::vector<double> epochs, valid;
    for (int epoch = 1; epoch <= 3; ++epoch) {
      n::Tensor corrupted;
      if (variant == "denoising") {
        const auto bank = n::models::GaussianNoise(fit.shape(), 1, std::uint32_t(1671 + epoch));
        corrupted       = n::models::CorruptForDenoising(fit, bank, .35f);
        n::save_npz(
            "build/denoising_train_epoch" + std::to_string(epoch) + ".npz",
            {{"standard_noise", bank}, {"corrupted", corrupted}});
      }
      batches.begin_epoch();
      double total = 0;
      int    seen  = 0;
      for (;;) {
        const auto rows = batches.next();
        if (rows.empty())
          break;
        const auto clean = n::take_rows(fit, rows);
        const auto input = variant == "ordinary" ? clean : n::take_rows(corrupted, rows);
        const auto net =
            n::models::UndercompleteAutoencoder(p, input.reshape({input.size(0), 784}));
        const auto objective = n::mse(net.reconstruction, clean.reshape({clean.size(0), 784}));
        if (updates == 0) {
          n::GradOptions keep;
          keep.retain_graph         = true;
          const auto      gradients = n::grad(objective, p.parameters(), keep);
          n::NamedTensors arrays;
          for (std::size_t i = 0; i < gradients.size(); ++i) {
            const double norm = n::sqrt(n::sum(n::square(gradients[i]))).item();
            if (!std::isfinite(norm) || norm <= 0)
              return 1;
            arrays.emplace_back(p.names()[i], gradients[i]);
            gradient_notes.push_back(
                std::format("| {} | {} | {:.8f} |\n", variant, p.names()[i], norm));
          }
          n::save_npz(prefix + "_first_gradients.npz", arrays);
          n::save_npz(prefix + "_first_batch.npz", {{"input", input}, {"clean_target", clean}});
        }
        const double value = objective.item();
        if (!std::isfinite(value) || value < 0)
          return 1;
        total += rows.size() * value;
        seen += int(rows.size());
        optimizer.minimize(objective);
        if (updates == 0)
          p.save(prefix + "_first_update.npz");
        ++updates;
      }
      n::NoGradGuard guard;
      const double   score =
          n::mse(
              n::models::UndercompleteAutoencoder(p, validation).reconstruction, validation_target)
              .item();
      if (seen != 1000 || !std::isfinite(score))
        return 1;
      p.save(prefix + "_epoch" + std::to_string(epoch) + ".npz");
      if (score < best) {
        best     = score;
        selected = epoch;
        p.save(prefix + "_best.npz");
      }
      epochs.push_back(epoch);
      valid.push_back(score);
      std::print("| {} | {} | {:.9f} | {:.9f} |\n", variant, epoch, total / seen, score);
    }
    if (updates != 96 || p.count() != 50992)
      return 1;
    n::save_npz(
        prefix + "_selection.npz",
        {{"epoch", n::full({}, selected, n::DType::Int32)},
         {"validation_mse", n::full({}, best, n::DType::Float64)}});
    plot.lines(
        epochs,
        valid,
        variant + " validation",
        variant == "denoising" ? dm::graphics::RGB{37, 99, 235} : dm::graphics::RGB{220, 38, 38},
        2.);
  }
  std::print("\n| fit | parameter | first gradient L2 norm |\n|---|---|---:|\n");
  for (const auto& line : gradient_notes)
    std::print("{}", line);
  plot.x_label("epoch")
      .y_label("fixed noisy-validation MSE to clean target")
      .title("Matched models: both selected for the same denoising task")
      .save_svg("build/denoising_learning.svg");
}
```
