4 learned tensors, 50992 learned scalars.
\image(figures/contractive_architecture.svg)
// result_end
\caption(The fitted reconstruction path has sigmoid activations on both dense layers. Independent weights distinguish it from a tied-weight autoencoder.)
\alttext(A left to right executed architecture from 784 input features through 32 sigmoid coordinates to 784 sigmoid reconstructions.)

> Three matched genuine-MNIST fits

The native dataset API prepares the same disjoint original-MNIST pools used by the
[undercomplete autoencoder](undercomplete_autoencoder.mepml): 1,000 fitting, 200 validation and
200 official test images, balanced across digit classes. `LoadSaliency` validates original row IDs,
byte ranges, class counts and distinct pixel records. All pixels are Float32 byte values divided by
255. No class labels enter the loss, gradients or checkpoint selection.

The three coefficients preserve the source's Float32 constants: 0, `double(0.01f)` and `double(0.1f)`.
All variants use seed 1753 for initialization, seed 1759 for batch order, Adam at learning rate 0.003,
minibatches of 32 with the final short batch retained, and three epochs. Each variant selects its
checkpoint by its own full validation objective MSE + lambda P. Those objective values have
different penalty weights, so they are not a common-MSE ranking. The penalty diagnostic remains
computed for the zero-weight control. These are short fits on small pools, not the paper's benchmark.

```{cpp, results="markdown", file="figures/contractive_learning.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
  namespace n = dm::nn;
  namespace m = n::models;
  std::filesystem::create_directories("build");
  const std::filesystem::path cache = dm::datasets::data_home();
  dm::datasets::prepare_example_data("mnist-assets", cache.string());
  const auto pools = m::LoadSaliency(cache / "saliency");
  const auto fit = pools[0].images.reshape({1000, 784});
  const auto validation = pools[1].images.reshape({200, 784});
  const auto test = pools[2].images.reshape({200, 784});
  const auto fit_mean = n::mean(fit, {0}, true);
  struct Variant { const char* name; double weight; dm::graphics::RGB color; };
  const std::vector<Variant> variants{{"plain", 0., {37, 99, 235}},
      {"contractive", double(.01f), {220, 38, 38}}, {"strong", double(.1f), {5, 150, 105}}};
  auto mse_plot = dm::graphics::RPlot::create();
  auto norm_plot = dm::graphics::RPlot::create();
  n::NamedTensors saved{{"fit_ids", pools[0].source}, {"validation_ids", pools[1].source},
      {"test_ids", pools[2].source}, {"test_labels", pools[2].labels}, {"test_input", test}, {"pixel_mean", fit_mean}};
  std::vector<std::string> summary;
  std::vector<std::string> jacobian_checks;
  std::print("| variant | epoch | fitting pre-update objective | validation objective | validation MSE | validation squared Jacobian norm |\n|---|---:|---:|---:|---:|---:|\n");
  for (const auto& variant : variants) {
    const auto prefix = std::string("build/contractive_") + variant.name;
    n::ParameterStore parameters(1753);
    {
      n::NoGradGuard guard;
      m::ContractiveAutoencoder(parameters, n::zeros({1, 784}), variant.weight);
      parameters.save(prefix + "_initial.npz");
      if (std::string(variant.name) != "plain") {
        const auto base = n::load_npz("build/contractive_plain_initial.npz");
        for (const auto& [name, value] : base)
          if (!n::equal_bits(value, parameters.at(name))) return 1;
      }
    }
    n::OptimizerConfig config;
    config.kind = n::OptimizerKind::Adam;
    n::Optimizer optimizer(parameters, .003, config);
    n::BatchOrder order(1000, 32, 1759);
    double best = std::numeric_limits<double>::infinity();
    int selected = 0, updates = 0;
    std::vector<double> epochs, mses, norms;
    for (int epoch = 1; epoch <= 3; ++epoch) {
      order.begin_epoch();
      std::size_t seen = 0;
      double sum = 0;
      for (;;) {
        const auto rows = order.next();
        if (rows.empty()) break;
        const auto input = n::take_rows(fit, rows);
        const auto output = m::ContractiveAutoencoder(parameters, input, variant.weight);
        if (updates == 0) {
          n::GradOptions keep;
          keep.retain_graph = true;
          const auto gradients = n::grad(output.loss, parameters.parameters(), keep);
          n::NamedTensors first{{"input", input}, {"weight", n::scalar(variant.weight, n::DType::Float64)}};
          for (std::size_t i = 0; i < gradients.size(); ++i) {
            const double norm = n::sqrt(n::sum(n::square(gradients[i]))).item();
            if (!std::isfinite(norm) || norm <= 0) return 1;
            first.emplace_back(parameters.names()[i], gradients[i]);
          }
          n::save_npz(prefix + "_first_gradients.npz", first);
        }
        const double value = output.loss.item();
        if (!std::isfinite(value) || value < 0) return 1;
        sum += value * rows.size();
        seen += rows.size();
        optimizer.minimize(output.loss);
        if (updates == 0) parameters.save(prefix + "_first_update.npz");
        ++updates;
      }
      n::NoGradGuard guard;
      const auto result = m::ContractiveAutoencoder(parameters, validation, variant.weight);
      const double objective = result.loss.item();
      if (seen != 1000 || !std::isfinite(objective)) return 1;
      if (objective < best) {
        best = objective;
        selected = epoch;
        parameters.save(prefix + "_best.npz");
      }
      epochs.push_back(epoch);
      mses.push_back(result.mse.item());
      norms.push_back(result.penalty.mean.item());
      std::print("| {} | {} | {:.9f} | {:.9f} | {:.9f} | {:.9f} |\n", variant.name, epoch, sum / seen,
                 objective, result.mse.item(), result.penalty.mean.item());
    }
    if (updates != 96) return 1;
    n::ParameterStore deployed(1753);
    { n::NoGradGuard guard; m::ContractiveAutoencoder(deployed, n::zeros({1, 784}), variant.weight); }
    deployed.load(prefix + "_best.npz");
    {
      n::NoGradGuard guard;
      const auto selected_validation = m::ContractiveAutoencoder(deployed, validation, variant.weight);
      if (std::abs(selected_validation.loss.item() - best) > 2e-7) return 1;
      const auto result = m::ContractiveAutoencoder(deployed, test, variant.weight);
      const auto saturation = n::cast(n::logical_or(n::less(result.code, .01), n::greater(result.code, .99)), n::DType::Float64);
      const auto code_mean = n::mean(result.code, {0}, true);
      const double code_std = n::mean(n::sqrt(n::mean(n::square(result.code - code_mean), {0}))).item();
      summary.push_back(std::format("| {} | {} | {:.9f} | {:.9f} | {:.6f} | {:.6f} |", variant.name, selected,
          result.mse.item(), result.penalty.mean.item(), n::mean(saturation).item(), code_std));
      saved.emplace_back(std::string(variant.name) + "_code", result.code);
      saved.emplace_back(std::string(variant.name) + "_reconstruction", result.reconstruction);
      saved.emplace_back(std::string(variant.name) + "_penalty", result.penalty.per_example);
      saved.emplace_back(std::string(variant.name) + "_weight", n::scalar(variant.weight, n::DType::Float64));
      saved.emplace_back(std::string(variant.name) + "_validation_mse", n::from_vector(mses, {3}));
      saved.emplace_back(std::string(variant.name) + "_validation_penalty", n::from_vector(norms, {3}));
    }
    const auto probe = n::take_rows(test, {0, 1, 2, 3, 4, 5, 6, 7}).detach().requires_grad_();
    const auto code = n::dense(deployed, "encoder", probe, 32, n::Activation::Sigmoid);
    n::GradOptions keep;
    keep.retain_graph = true;
    std::vector<n::Tensor> derivatives;
    for (int j = 0; j < 32; ++j)
      derivatives.push_back(n::grad(n::sum(n::slice_axis(code, 1, j, j + 1)), {probe}, keep)[0]);
    const auto jacobian = n::stack(derivatives, 1);
    const auto reference = n::sum(n::square(jacobian), {1, 2});
    const auto analytic = m::SigmoidEncoderContraction(code, deployed.at("encoder/W")).per_example;
    const double maximum_error = n::max(n::abs(reference - analytic)).item();
    if (maximum_error > 2e-5) return 1;
    saved.emplace_back(std::string(variant.name) + "_probe_jacobian", jacobian);
    saved.emplace_back(std::string(variant.name) + "_probe_input", probe.detach());
    jacobian_checks.push_back(std::format("{}: full 8-by-32-by-784 reverse-mode Jacobian norm maximum error {:.2e}.", variant.name, maximum_error));
    mse_plot.lines(epochs, mses, variant.name, variant.color, 2.);
    norm_plot.lines(epochs, norms, variant.name, variant.color, 2.);
  }
  for (const auto& check : jacobian_checks) std::print("\n{}\n", check);
  std::print("\n| selected variant | selected epoch | held-out MSE | held-out squared Jacobian norm | saturated fraction outside [0.01,0.99] | mean code-coordinate std |\n|---|---:|---:|---:|---:|---:|\n");
  for (const auto& row : summary) std::print("{}\n", row);
  std::print("\nHeld-out MSE of fitting-only pixel mean: {:.9f}.\n", n::mse(n::broadcast_to(fit_mean, test.shape()), test).item());
  n::save_npz("build/contractive_results.npz", saved);
  mse_plot.title("Validation reconstruction MSE").x_label("epoch").y_label("mean squared pixel error");
  norm_plot.title("Validation encoder sensitivity").x_label("epoch").y_label("mean squared Jacobian norm");
  auto figure = dm::graphics::RLayout::create(1, 2);
  figure.add(mse_plot).add(norm_plot).size(1150, 500).save_svg("build/contractive_learning.svg");
}
```
