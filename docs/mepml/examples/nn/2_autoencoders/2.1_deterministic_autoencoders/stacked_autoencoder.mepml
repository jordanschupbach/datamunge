> Four explicit fitting phases

Stage-one seed 1549 initializes 784–64–784. Stage two and both full stacks use seed 1553; full-stack
initial arrays agree before transfer. Adam uses learning rate 0.003, moments 0.9/0.999 and
epsilon 1e-8. Each phase has three epochs, batch 32, order seed 1559, 1,000 records per epoch and
96 updates including a final batch of eight. Greedy phases select among completed epochs 1–3.
Fine-tuning and scratch also admit epoch 0, so they may retain their starting model if validation
never improves. Validation MSE accumulates Float64 errors from Float32 predictions; test pixels
do not select weights. Fitting losses are pre-update, validation post-epoch.

The complete loop below creates every model and optimizer, caches detached first-stage codes,
performs the eight transfers, runs all 384 updates and restores each selected checkpoint.
Full weights, first gradients/batches/updates, epoch 0 and all completed epochs remain saved.
The learning plot compares pixel MSE only; stage-two latent MSE remains a separate table quantity.

```{cpp, results="markdown", file="figures/stacked_learning.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
  namespace n = dm::nn;
  std::map<std::string, n::Tensor> data;
  for (const auto& [key, value] : n::load_npz("build/stacked_data.npz"))
    data.emplace(key, value);
  const auto fit = data.at("fit_images"), validation = data.at("validation_images"),
             test                       = data.at("test_images");
  const auto                     source = data.at("fit_source_ids").to_vector<int>();
  const std::vector<std::string> names{"stage1", "stage2", "finetune", "scratch"};
  const std::vector<n::Shape>    widths{
         {784, 64, 784}, {64, 16, 64}, {784, 64, 16, 64, 784}, {784, 64, 16, 64, 784}};
  const std::vector<std::uint64_t>                seeds{1549, 1553, 1553, 1553};
  std::vector<std::unique_ptr<n::ParameterStore>> stores;
  std::vector<std::unique_ptr<n::Optimizer>>      optimizers;
  n::OptimizerConfig                              config;
  config.kind = n::OptimizerKind::Adam;
  for (int phase = 0; phase < 4; ++phase) {
    stores.push_back(std::make_unique<n::ParameterStore>(seeds[phase]));
    {
      n::NoGradGuard guard;
      n::models::SigmoidAutoencoder(
          *stores.back(), n::zeros({1, widths[phase].front()}), widths[phase]);
    }
    optimizers.push_back(std::make_unique<n::Optimizer>(*stores.back(), .003, config));
  }
  if (stores[0]->count() != 101200 || stores[1]->count() != 2128 || stores[2]->count() != 103328 ||
      stores[2]->flatten() != stores[3]->flatten())
    return 1;
  std::map<std::string, n::Tensor>     cached;
  n::NamedTensors                      frozen;
  std::vector<int>                     selected_epochs;
  auto                                 plot = dm::graphics::RPlot::create();
  const std::vector<dm::graphics::RGB> colors{
      {37, 99, 235}, {148, 163, 184}, {22, 163, 74}, {220, 38, 38}};
  std::print(
      "| phase | epoch | fitting MSE / pre-update mean | validation MSE | target space "
      "|\n|---|---:|---:|---:|---|\n");
  for (int phase = 0; phase < 4; ++phase) {
    auto&             p      = *stores[phase];
    const std::string prefix = "build/stacked_" + names[phase];
    if (phase == 2) {
      n::NamedTensors transfer;
      for (const auto& [target, name, store] :
           std::vector<std::tuple<std::string, std::string, int>>{
               {"layer0", "layer0", 0},
               {"layer3", "layer1", 0},
               {"layer1", "layer0", 1},
               {"layer2", "layer1", 1}})
        for (const auto& suffix : {"/W", "/b"})
          transfer.emplace_back(target + suffix, stores[store]->at(name + suffix));
      if (transfer.size() != p.size())
        return 1;
      for (const auto& name : p.names())
        if (std::count_if(transfer.begin(), transfer.end(), [&](const auto& item) {
              return item.first == name;
            }) != 1)
          return 1;
      for (const auto& [name, value] : transfer)
        if (!p.contains(name) || p.at(name).shape() != value.shape() || p.dtype() != value.dtype())
          return 1;
      for (const auto& [name, value] : transfer)
        p.set(name, value);
      for (const auto& [name, value] : transfer)
        if (!n::equal_bits(p.at(name), value))
          return 1;
      p.save("build/stacked_transferred.npz");
      n::NoGradGuard guard;
      const auto     pretrained = n::models::SigmoidAutoencoder(p, test, widths[phase]);
      const auto     second =
          n::models::SigmoidAutoencoder(*stores[1], cached.at("test_code"), widths[1]);
      const auto nested = n::models::SigmoidAutoencoderDecode(*stores[0], second.back(), widths[0]);
      if (!n::equal_bits(pretrained.back(), nested))
        return 1;
      n::save_npz(
          "build/stacked_pretrained.npz",
          {{"code", pretrained[1]},
           {"reconstruction", pretrained.back()},
           {"stage2_test_reconstruction", second.back()}});
    }
    const auto input             = phase == 1 ? cached.at("fit_code") : fit,
               target_validation = phase == 1 ? cached.at("validation_code") : validation;
    const auto score             = [&](const n::Tensor& prediction, const n::Tensor& target) {
      return n::mean(
                 n::square(
                     n::cast(prediction, n::DType::Float64) - n::cast(target, n::DType::Float64)))
          .item();
    };
    p.save(prefix + "_initial.npz");
    double initial_fit, epoch0;
    {
      n::NoGradGuard guard;
      initial_fit = score(n::models::SigmoidAutoencoder(p, input, widths[phase]).back(), input);
      const auto initial_validation =
          n::models::SigmoidAutoencoder(p, target_validation, widths[phase]);
      epoch0 = score(initial_validation.back(), target_validation);
      n::save_npz(prefix + "_epoch0_validation.npz", {{"prediction", initial_validation.back()}});
    }
    p.save(prefix + "_epoch0.npz");
    const bool include_zero = phase >= 2;
    double     best         = include_zero ? epoch0 : std::numeric_limits<double>::infinity();
    int        selected = 0, updates = 0;
    if (include_zero)
      p.save(prefix + "_best.npz");
    std::vector<double> epochs{0}, valid{epoch0};
    std::vector<double> training{initial_fit};
    std::print(
        "| {} | 0 | {:.9f} | {:.9f} | {} |\n",
        names[phase],
        initial_fit,
        epoch0,
        phase == 1 ? "64 frozen coordinates" : "784 pixels");
    n::BatchOrder order(1000, 32, 1559);
    std::ofstream batches(prefix + "_batches.tsv");
    batches << "epoch\tstep\trow\tsource_id\n";
    for (int epoch = 1; epoch <= 3; ++epoch) {
      order.begin_epoch();
      double total = 0;
      int    seen  = 0;
      for (;;) {
        const auto rows = order.next();
        if (rows.empty())
          break;
        const auto x      = n::take_rows(input, rows);
        const auto layers = n::models::SigmoidAutoencoder(p, x, widths[phase]);
        const auto loss   = n::mean(n::square(layers.back() - x));
        if (updates == 0) {
          n::GradOptions keep;
          keep.retain_graph         = true;
          const auto      gradients = n::grad(loss, p.parameters(), keep);
          n::NamedTensors saved;
          for (std::size_t i = 0; i < gradients.size(); ++i) {
            const double norm = n::sum(n::square(gradients[i])).item();
            if (!std::isfinite(norm) || norm <= 0)
              return 1;
            saved.emplace_back(p.names()[i], gradients[i]);
          }
          n::save_npz(prefix + "_first_gradients.npz", saved);
          n::save_npz(prefix + "_first_batch.npz", {{"images", x}});
        }
        const double value = loss.item();
        if (!std::isfinite(value) || value < 0)
          return 1;
        optimizers[phase]->minimize(loss);
        total += rows.size() * value;
        seen += int(rows.size());
        for (auto row : rows)
          batches << epoch << '\t' << updates << '\t' << row << '\t' << source[row] << '\n';
        if (updates == 0)
          p.save(prefix + "_first_update.npz");
        ++updates;
      }
      n::NoGradGuard guard;
      const auto     validation_output =
          n::models::SigmoidAutoencoder(p, target_validation, widths[phase]);
      const double metric = score(validation_output.back(), target_validation);
      n::save_npz(
          prefix + "_epoch" + std::to_string(epoch) + "_validation.npz",
          {{"prediction", validation_output.back()}});
      if (seen != 1000 || !std::isfinite(metric))
        return 1;
      p.save(prefix + "_epoch" + std::to_string(epoch) + ".npz");
      if (metric < best) {
        best     = metric;
        selected = epoch;
        p.save(prefix + "_best.npz");
      }
      epochs.push_back(epoch);
      valid.push_back(metric);
      training.push_back(total / seen);
      std::print(
          "| {} | {} | {:.9f} | {:.9f} | {} |\n",
          names[phase],
          epoch,
          total / seen,
          metric,
          phase == 1 ? "64 frozen coordinates" : "784 pixels");
    }
    if (updates != 96 || !batches)
      return 1;
    p.load(prefix + "_best.npz");
    p.save(prefix + "_model_arrays.npz");
    {
      n::NoGradGuard guard;
      const double   final_fit =
          score(n::models::SigmoidAutoencoder(p, input, widths[phase]).back(), input);
      if (!(final_fit < initial_fit || (include_zero && selected == 0)))
        return 1;
    }
    n::save_npz(
        prefix + "_selection.npz",
        {{"epoch", n::full({}, selected, n::DType::Int32)},
         {"validation_mse", n::full({}, best, n::DType::Float64)},
         {"epochs", n::from_vector(epochs, {4})},
         {"fit_path", n::from_vector(training, {4})},
         {"validation_path", n::from_vector(valid, {4})}});
    selected_epochs.push_back(selected);
    if (phase != 1)
      plot.lines(epochs, valid, names[phase] + " validation pixels", colors[phase], 2.);
    if (phase == 0) {
      for (const auto& name : p.names())
        frozen.emplace_back(name, p.at(name).detach().clone());
      n::NoGradGuard  guard;
      n::NamedTensors arrays;
      for (const auto& split : {"fit", "validation", "test"}) {
        const auto code =
            n::models::SigmoidAutoencoder(p, data.at(std::string(split) + "_images"), widths[0])[0];
        if (code.requires_grad())
          return 1;
        cached.emplace(std::string(split) + "_code", code);
        arrays.emplace_back(std::string(split) + "_code", code);
      }
      n::save_npz("build/stacked_cache.npz", arrays);
    }
    if (phase >= 1) {
      for (const auto& [name, value] : frozen)
        if (!n::equal_bits(stores[0]->at(name), value))
          return 1;
      n::NoGradGuard guard;
      if (!n::equal_bits(
              n::models::SigmoidAutoencoder(*stores[0], fit, widths[0])[0], cached.at("fit_code")))
        return 1;
    }
  }
  plot.x_label("epoch within phase")
      .y_label("validation pixel MSE")
      .title("Own-phase validation / epoch zero eligible for joint phases")
      .save_svg("build/stacked_learning.svg");
  std::print(
      "Selected epochs {}/{}/{}/{}. Frozen caches and all eight transfers pass.\n",
      selected_epochs[0],
      selected_epochs[1],
      selected_epochs[2],
      selected_epochs[3]);
}
```
