> Encode an actual file, measure all bytes, and preserve every original artifact

The complete application fits 32 ranges to fitting codes only, packs 200 held-out records,
writes and rereads the binary file, parses and repacks it, and compares a packet-only decode
with the original decoder. Three malformed controls cover bad magic, truncated payload and
an oversized count. Additional native unit tests exercise all fixed shape fields, nonfinite
parameters, reversed bounds, negative identities and trailing bytes. The format has no
checksum, so structurally valid altered bytes can remain undetected.

All 50,992 frozen values are checked for immutability. The native PNG writer saves every original
test image; rates use measured file sizes, including each PNG header. No old source comment
about a different PNG writer or an uncompressed baseline is used. Shared executable/runtime
bytes are excluded for both formats; source identities are included in TFLCODE1, whereas PNG
filenames and external container overhead are excluded. PNG is lossless and not quality matched
to this blurry lossy decoder. The complete file is larger than this observed PNG collection.

```{cpp, results="markdown", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <fstream>
#include <iterator>
namespace n = dm::nn;
namespace m = n::models;
void Require(bool condition, const std::string& message) {
  if (!condition)
    throw std::runtime_error(message);
}
double Mse(const n::Tensor& a, const n::Tensor& b) {
  return n::mean(n::square(m::DoubleSampleRows(a) - m::DoubleSampleRows(b))).item();
}
std::vector<std::uint8_t> ReadBytes(const std::filesystem::path& path) {
  std::ifstream in(path, std::ios::binary);
  Require(bool(in), "Read generated packet");
  return {(std::istreambuf_iterator<char>(in)), {}};
}
int main() {
  const std::filesystem::path cache = dm::datasets::data_home(), root = "build/codec";
  std::filesystem::create_directories(root / "original_png");
  dm::datasets::prepare_example_data("mnist-assets", cache.string());
  const auto        pools = m::LoadSaliency(cache / "saliency");
  n::ParameterStore p(1471);
  {
    n::NoGradGuard guard;
    m::UndercompleteAutoencoder(p, n::zeros({1, 784}));
  }
  p.load("build/codec_selected_encoder.npz");
  n::NamedTensors before;
  for (const auto& name : p.names())
    before.emplace_back(name, p.at(name).detach().clone());
  n::NoGradGuard guard;
  const auto     fit = m::UndercompleteAutoencoder(p, pools[0].images.reshape({1000, 784})),
             test    = m::UndercompleteAutoencoder(p, pools[2].images.reshape({200, 784}));
  // A small fixture is archived independently of the real fitting codes.
  std::vector<float> smallfit(64, .25f), probe(96, .25f);
  smallfit[0]        = 0;
  smallfit[32]       = 1;
  probe[0]           = -.2f;
  probe[32]          = .5f;
  probe[64]          = 1.2f;
  const auto fixture = n::from_vector(smallfit, {2, 32}), query = n::from_vector(probe, {3, 32});
  const auto fixture_q = m::FitCodecQuantizer(fixture);
  const auto fixture_s = m::QuantizeCodec(query, fixture_q);
  const auto fixture_d = m::DequantizeCodec(fixture_s, fixture_q);
  Require(
      fixture_s[0] == 0 && fixture_s[32] == 128 && fixture_s[64] == 255,
      "Half-up and clipping fixture");
  n::save_npz(
      (root / "quantizer_algebra.npz").string(),
      {{"fit", fixture},
       {"probe", query},
       {"minimum", n::from_vector(fixture_q.minimum, {32})},
       {"maximum", n::from_vector(fixture_q.maximum, {32})},
       {"symbols", m::SymbolTensor(fixture_s)},
       {"dequantized", fixture_d}});
  const auto           q       = m::FitCodecQuantizer(fit.code);
  const auto           symbols = m::QuantizeCodec(test.code, q);
  const m::CodecPacket packet{
      q, p.at("decoder/W"), p.at("decoder/b"), pools[2].source.to_vector<int>(), symbols};
  const auto bytes = m::PackCodec(packet);
  const auto file  = root / "test.tflcodec";
  {
    std::ofstream out(file, std::ios::binary);
    out.write(reinterpret_cast<const char*>(bytes.data()), std::streamsize(bytes.size()));
    Require(bool(out), "Write complete packet");
  }
  const auto reread = ReadBytes(file);
  Require(reread == bytes, "Actual file byte roundtrip");
  const auto parsed = m::UnpackCodec(reread);
  Require(m::PackCodec(parsed) == bytes, "Exact parse/repack");
  const auto dequantized = m::DequantizeCodec(parsed.symbols, parsed.quantizer),
             decoded = m::DecodeCodec(parsed), reference = m::UndercompleteDecoder(p, dequantized);
  const auto decode_error = n::max(n::abs(decoded - reference)).item();
  Require(decode_error < 2e-6, "Packet-only decoder parity");
  int rejected = 0;
  for (int kind = 0; kind < 3; ++kind) {
    auto broken = bytes;
    if (kind == 0)
      broken[0] = 'X';
    else if (kind == 1)
      broken.pop_back();
    else
      for (int j = 8; j < 12; ++j)
        broken[j] = 255;
    try {
      m::UnpackCodec(broken);
    } catch (const std::invalid_argument&) {
      ++rejected;
    }
  }
  Require(rejected == 3, "Original three malformed controls");
  int        clipped = 0, constant = 0;
  const auto code = test.code.to_vector<float>();
  for (int j = 0; j < 32; ++j) {
    constant += q.minimum[j] == q.maximum[j];
    for (int row = 0; row < 200; ++row)
      clipped += code[row * 32 + j] < q.minimum[j] || code[row * 32 + j] > q.maximum[j];
  }
  for (const auto& [name, value] : before)
    Require(n::equal_bits(value, p.at(name)), "Immutable frozen weights");
  n::save_npz(
      (root / "analysis.npz").string(),
      {{"fit_images", pools[0].images},
       {"fit_labels", pools[0].labels},
       {"fit_source_ids", pools[0].source},
       {"test_images", pools[2].images},
       {"test_labels", pools[2].labels},
       {"test_source_ids", pools[2].source},
       {"fit_code", fit.code},
       {"test_code", test.code},
       {"unquantized_reconstruction", test.reconstruction},
       {"minimum", n::from_vector(q.minimum, {32})},
       {"maximum", n::from_vector(q.maximum, {32})},
       {"symbols", m::SymbolTensor(symbols)},
       {"dequantized", dequantized},
       {"decoded_reconstruction", decoded}});
  n::save_npz((root / "model_arrays.npz").string(), before);
  std::filesystem::copy_file(
      cache / "saliency/manifest.json",
      root / "data_manifest.json",
      std::filesystem::copy_options::overwrite_existing);
  std::ofstream sizes(root / "png_sizes.tsv");
  sizes << "source_id\tbytes\n";
  std::size_t png_bytes = 0;
  const auto  source    = pools[2].source.to_vector<int>();
  for (int row = 0; row < 200; ++row) {
    const auto name = root / "original_png" / (std::to_string(source[row]) + ".png");
    n::save_png(n::take_rows(pools[2].images, {row}).reshape({28, 28, 1}), name.string());
    const auto length = std::filesystem::file_size(name);
    png_bytes += length;
    sizes << source[row] << '\t' << length << '\n';
  }
  const std::size_t payload = 200 * 32, model_bytes = 25872 * 4, range_bytes = 32 * 2 * 4,
                    id_bytes = 200 * 4, header_bytes = 28;
  Require(
      bytes.size() == payload + model_bytes + range_bytes + id_bytes + header_bytes,
      "Every byte accounted");
  const double mse         = Mse(decoded, pools[2].images),
               unquantized = Mse(test.reconstruction, pools[2].images),
               psnr        = 10 * std::log10(1 / mse);
  std::ofstream meta(root / "metrics.json");
  meta.precision(17);
  meta << "{\"additional_training_updates\":0,\"test_images\":200,\"latent_dimensions\":32,\"bits_"
          "per_symbol\":8,"
       << "\"constant_channels\":" << constant << ",\"clipped_test_code_entries\":" << clipped
       << ",\"payload_bytes\":" << payload << ",\"decoder_parameter_bytes\":" << model_bytes
       << ",\"quantizer_bytes\":" << range_bytes << ",\"source_identity_bytes\":" << id_bytes
       << ",\"header_bytes\":" << header_bytes << ",\"total_file_bytes\":" << bytes.size()
       << ",\"original_raw_u8_bytes\":156800,\"original_png_collection_bytes\":" << png_bytes
       << ",\"payload_bits_per_pixel\":" << double(payload * 8) / (200 * 784)
       << ",\"total_bits_per_pixel\":" << double(bytes.size() * 8) / (200 * 784)
       << ",\"png_bits_per_pixel\":" << double(png_bytes * 8) / (200 * 784)
       << ",\"unquantized_test_mse\":" << unquantized << ",\"decoded_test_mse\":" << mse
       << ",\"decoded_global_psnr_db\":" << psnr << ",\"fresh_decoder_max_error\":" << decode_error
       << ",\"malformed_controls_rejected\":3}\n";
  const auto error = n::abs(decoded - pools[2].images.reshape({200, 784}));
  for (int k = 0; k < 10; ++k) {
    const int              row = k * 199 / 9;
    std::vector<n::Tensor> tiles;
    for (const auto& panel : {pools[2].images, test.reconstruction, decoded, error})
      tiles.push_back(n::take_rows(panel, {row}).reshape({28, 28, 1}));
    n::save_image_grid(
        n::tile(n::stack(tiles, 0), {1, 1, 1, 3}),
        (root / ("case_" + std::to_string(k) + ".png")).string(),
        4,
        0,
        1,
        4,
        220. / 255.,
        3);
  }
  Require(bool(meta) && bool(sizes), "Complete numerical and measured-file records");
  std::print(
      "| byte category | measured bytes |\n|---|---:|\n| Header | {} |\n| Quantizer | {} |\n| "
      "Decoder | {} |\n| Identities | {} |\n| Symbols | {} |\n| Total file | {} |\n| Original PNG "
      "collection | {} |\n",
      header_bytes,
      range_bytes,
      model_bytes,
      id_bytes,
      payload,
      bytes.size(),
      png_bytes);
  std::print(
      "\nMSE: unquantized {:.12f}, packet decoded {:.12f}; global PSNR {:.9f} dB.\nConstant "
      "channels {}, clipped code entries {}. All 50992 model values unchanged; zero new updates.\n",
      unquantized,
      mse,
      psnr,
      constant,
      clipped);
}
```
