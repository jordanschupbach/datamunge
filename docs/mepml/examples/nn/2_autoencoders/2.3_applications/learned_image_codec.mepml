```{cpp, results="markdown", file="figures/codec_all_case_errors.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <map>
int main() {
  namespace n = dm::nn;
  std::map<std::string, n::Tensor> a;
  for (const auto& [k, v] : n::load_npz("build/codec/analysis.npz"))
    a.emplace(k, v);
  const auto          truth = n::models::DoubleSampleRows(a.at("test_images"));
  std::vector<double> rows, unq, decoded;
  for (int i = 0; i < 200; ++i) {
    rows.push_back(i);
    const auto original = n::take_rows(truth, {i});
    auto       mse      = [&](const std::string& key) {
      return n::mean(
                 n::square(n::models::DoubleSampleRows(n::take_rows(a.at(key), {i})) - original))
          .item();
    };
    unq.push_back(mse("unquantized_reconstruction"));
    decoded.push_back(mse("decoded_reconstruction"));
  }
  auto plot = dm::graphics::RPlot::create();
  plot.lines(rows, unq, "Unquantized", {37, 99, 235}, 1.5)
      .points(rows, decoded, "Packet decoded", {220, 38, 38}, 1.5)
      .y_limits(
          0,
          1.2 * std::max(
                    *std::max_element(unq.begin(), unq.end()),
                    *std::max_element(decoded.begin(), decoded.end())) +
              .001)
      .x_label("All fixed held-out rows, original order")
      .y_label("Per-image mean squared pixel error")
      .title("All cases remain visible; byte quantization changes little")
      .save_svg("build/codec_all_case_errors.svg");
}
```
