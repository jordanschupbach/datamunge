> Fit each projection once and keep every held-out result

The full code below restores the model and checks every one of its 50,992 values for bitwise
immutability. Pixel PCA retains 32 axes; code PCA retains two. Means, components, sample variances,
all three transformed pools and all inverse projections are saved. The two-coordinate code inverse
is cast to Float32 before entering the original frozen decoder. Pixel PCA reconstruction stays
Float64; raw and clipped pixel errors are reported separately.

Five Euclidean spaces retrieve ten fitting neighbors for each test query: pixels, full AE codes,
two code-PCA coordinates, 32 pixel-PCA coordinates and the first two pixel-PCA coordinates.
Distances widen to double before subtracting and accumulate squared differences in feature order.
Equal-distance fitting rows use smaller row indices. Query labels score the already-fixed lists.
The retained source IDs and full neighbor tables make that separation inspectable.

```{cpp, results="markdown", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <fstream>
#include <map>
namespace n = dm::nn;
namespace m = n::models;
void Require(bool condition, const std::string& message) {
  if (!condition)
    throw std::runtime_error(message);
}
double Mse(const n::Tensor& x, const n::Tensor& y, bool clipped = false) {
  const auto a = m::DoubleSampleRows(x), b = m::DoubleSampleRows(y);
  return n::mean(n::square((clipped ? n::clip(a, 0., 1.) : a) - b)).item();
}
int main() {
  const std::filesystem::path cache = dm::datasets::data_home(), root = "build/visualization";
  std::filesystem::create_directories(root);
  dm::datasets::prepare_example_data("mnist-assets", cache.string());
  const auto        pools = m::LoadSaliency(cache / "saliency");
  n::ParameterStore p(1471);
  {
    n::NoGradGuard guard;
    m::UndercompleteAutoencoder(p, n::zeros({1, 784}));
  }
  p.load("build/visualization_selected_encoder.npz");
  n::NamedTensors before;
  for (const auto& name : p.names())
    before.emplace_back(name, p.at(name).detach().clone());
  std::map<std::string, n::Tensor> arrays;
  for (int k = 0; k < 3; ++k) {
    const std::string split = k == 0 ? "fit" : k == 1 ? "validation" : "test";
    n::NoGradGuard    guard;
    const auto        out =
        m::UndercompleteAutoencoder(p, pools[k].images.reshape({pools[k].images.size(0), 784}));
    arrays.emplace(split + "_images", pools[k].images);
    arrays.emplace(split + "_labels", pools[k].labels);
    arrays.emplace(split + "_source_ids", pools[k].source);
    arrays.emplace(split + "_code", out.code.contiguous());
    arrays.emplace(split + "_ae_reconstruction", out.reconstruction.contiguous());
  }
  const m::SvdPca pixel_pca(pools[0].images, 32), code_pca(arrays.at("fit_code"), 2);
  for (const auto& name : {std::string("pixel_pca"), std::string("code_pca")}) {
    const auto& fit = name == "pixel_pca" ? pixel_pca : code_pca;
    arrays.emplace(name + "_mean", fit.mean());
    arrays.emplace(name + "_components", fit.components());
    arrays.emplace(name + "_variances", fit.variances());
    for (int k = 0; k < 3; ++k) {
      const std::string split = k == 0 ? "fit" : k == 1 ? "validation" : "test";
      const auto        input = name == "pixel_pca" ? pools[k].images : arrays.at(split + "_code");
      const auto        score = k == 0 ? fit.scores() : fit.Transform(input);
      arrays.emplace(name + "_" + split, score);
      arrays.emplace(name + "_" + split + "_reconstruction", fit.Reconstruct(score));
    }
  }
  n::Tensor ae2decoded;
  {
    n::NoGradGuard guard;
    ae2decoded = m::UndercompleteDecoder(
        p, n::cast(arrays.at("code_pca_test_reconstruction"), n::DType::Float32).contiguous());
  }
  arrays.emplace("ae_projected2_decoder_reconstruction", ae2decoded);
  const auto pixel_fit2  = n::slice(arrays.at("pixel_pca_fit"), {0, 0}, {1000, 2}).contiguous();
  const auto pixel_test2 = n::slice(arrays.at("pixel_pca_test"), {0, 0}, {200, 2}).contiguous();
  const auto pixel2      = pixel_pca.Reconstruct(pixel_test2);
  arrays.emplace("pixel_pca2_test_reconstruction", pixel2);
  const std::map<std::string, n::Tensor> lists{
      {"pixel", m::NearestFitRows(pools[0].images, pools[2].images, 10)},
      {"ae32", m::NearestFitRows(arrays.at("fit_code"), arrays.at("test_code"), 10)},
      {"ae2", m::NearestFitRows(arrays.at("code_pca_fit"), arrays.at("code_pca_test"), 10)},
      {"pca32", m::NearestFitRows(arrays.at("pixel_pca_fit"), arrays.at("pixel_pca_test"), 10)},
      {"pca2", m::NearestFitRows(pixel_fit2, pixel_test2, 10)}};
  for (const auto& [name, value] : lists)
    arrays.emplace(name + "_neighbors", value);
  const auto ae_mse      = Mse(arrays.at("test_ae_reconstruction"), pools[2].images),
             ae2_mse     = Mse(ae2decoded, pools[2].images);
  const auto pca_mse     = Mse(arrays.at("pixel_pca_test_reconstruction"), pools[2].images),
             pca_clipped = Mse(arrays.at("pixel_pca_test_reconstruction"), pools[2].images, true),
             pca2_mse    = Mse(pixel2, pools[2].images);
  // These bounds are fitted once. Every held-out point is retained at the boundary if needed.
  auto clipped_points = [](const n::Tensor& fit, const n::Tensor& test) {
    const auto low = n::min(fit, {0}, true), high = n::max(fit, {0}, true),
               padding = n::maximum((high - low) * .05, n::full({1, 2}, 1e-6, n::DType::Float64));
    return n::count_nonzero(
               n::any(
                   n::logical_or(n::less(test, low - padding), n::greater(test, high + padding)),
                   {1}))
        .item<std::int64_t>();
  };
  const auto ac = clipped_points(arrays.at("code_pca_fit"), arrays.at("code_pca_test")),
             pc = clipped_points(pixel_fit2, pixel_test2);
  for (const auto& [name, value] : before)
    Require(
        n::equal_bits(value, p.at(name)),
        "PCA retrieval and code-only decoding must leave every model value unchanged");
  n::save_npz((root / "analysis.npz").string(), n::NamedTensors(arrays.begin(), arrays.end()));
  p.save((root / "model_arrays.npz").string());
  std::filesystem::copy_file(
      cache / "saliency/manifest.json",
      root / "data_manifest.json",
      std::filesystem::copy_options::overwrite_existing);
  std::filesystem::copy_file(
      "build/visualization_encoder_metrics.json",
      root / "encoder_metrics.json",
      std::filesystem::copy_options::overwrite_existing);
  std::ofstream meta(root / "metrics.json");
  meta.precision(17);
  meta << "{\"additional_training_updates\":0,\"encoder_parameters\":50992,\"code_dimensions\":32,"
          "\"display_dimensions\":2,\"fit_records\":1000,\"validation_records\":200,\"test_"
          "records\":200,\"ae_test_mse\":"
       << ae_mse << ",\"ae_projected2_decoder_test_mse\":" << ae2_mse
       << ",\"pixel_pca32_test_mse\":" << pca_mse
       << ",\"pixel_pca32_clipped_test_mse\":" << pca_clipped
       << ",\"pixel_pca2_test_mse\":" << pca2_mse << ",\"ae_display_clipped_test_points\":" << ac
       << ",\"pixel_display_clipped_test_points\":" << pc;
  for (const auto& [name, value] : lists)
    meta << ",\"" << name << "_test_1nn_label_accuracy\":"
         << m::NeighborLabelAccuracy(value, pools[0].labels, pools[2].labels) << ",\"" << name
         << "_top10_pixel_neighbor_overlap\":" << m::NeighborOverlap(lists.at("pixel"), value);
  meta << "}\n";
  Require(bool(meta), "Complete projection metrics must be saved");
  std::print(
      "| representation / reconstruction | held-out pixel MSE |\n|---|---:|\n| Frozen AE, 32 codes "
      "| {:.9f} |\n| AE codes projected to 2, inverse-projected, decoded | {:.9f} |\n| Pixel PCA, "
      "32 axes, raw | {:.9f} |\n| Pixel PCA, 32 axes, clipped | {:.9f} |\n| Pixel PCA, 2 axes, raw "
      "| {:.9f} |\n",
      ae_mse,
      ae2_mse,
      pca_mse,
      pca_clipped,
      pca2_mse);
  std::print(
      "\n| neighbor space | posthoc 1NN digit accuracy | overlap with pixel top10 "
      "|\n|---|---:|---:|\n");
  for (const auto& [name, value] : lists)
    std::print(
        "| {} | {:.4f} | {:.4f} |\n",
        name,
        m::NeighborLabelAccuracy(value, pools[0].labels, pools[2].labels),
        m::NeighborOverlap(lists.at("pixel"), value));
  std::print(
      "\nZero new optimizer updates. All {} model values stay bit-exact. Clipped display points: "
      "code PCA {}, pixel PCA {}.\n",
      p.count(),
      ac,
      pc);
}
```
// result_begin: markdown
| representation / reconstruction | held-out pixel MSE |
|---|---:|
| Frozen AE, 32 codes | 0.050325811 |
| AE codes projected to 2, inverse-projected, decoded | 0.063672576 |
| Pixel PCA, 32 axes, raw | 0.017631299 |
| Pixel PCA, 32 axes, clipped | 0.015966440 |
| Pixel PCA, 2 axes, raw | 0.056757339 |

| neighbor space | posthoc 1NN digit accuracy | overlap with pixel top10 |
|---|---:|---:|
| ae2 | 0.3250 | 0.0840 |
| ae32 | 0.7800 | 0.4080 |
| pca2 | 0.3500 | 0.1100 |
| pca32 | 0.8800 | 0.7805 |
| pixel | 0.8900 | 1.0000 |

Zero new optimizer updates. All 50992 model values stay bit-exact. Clipped display points: code PCA 0, pixel PCA 0.
// result_end
> Two displays with fitting-only limits

Each panel shows all 1,000 fitting rows in gray and every one of the 200 held-out rows colored
by its digit label. Its own fitting min/max sets each axis, padded by 5% of fitting span with
a 1e-6 minimum. Held-out values outside those bounds would be retained at the boundary and
counted; both observed clipping counts are zero. The two panels use independent fitted limits,
so their absolute axis scales should be read separately. The encoder remains 32-dimensional.

```{cpp, results="markdown", file="figures/visualization_code_scatter.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
  namespace n = dm::nn;
  std::map<std::string, n::Tensor> a;
  for (const auto& [key, value] : n::load_npz("build/visualization/analysis.npz"))
    a.emplace(key, value);
  const auto fit  = n::slice(a.at("code_pca_fit"), {0, 0}, {1000, 2}).contiguous(),
             test = n::slice(a.at("code_pca_test"), {0, 0}, {200, 2}).contiguous();
  const auto low = n::min(fit, {0}, true), high = n::max(fit, {0}, true),
             pad   = n::maximum((high - low) * .05, n::full({1, 2}, 1e-6, n::DType::Float64));
  const auto lower = low - pad, upper = high + pad, display = n::clip(test, lower, upper);
  const auto labels = a.at("test_labels").to_vector<int>();
  const std::vector<dm::graphics::RGB> palette{
      {31, 119, 180},
      {255, 127, 14},
      {44, 160, 44},
      {214, 39, 40},
      {148, 103, 189},
      {140, 86, 75},
      {227, 119, 194},
      {127, 127, 127},
      {188, 189, 34},
      {23, 190, 207}};
  auto plot = dm::graphics::RPlot::create();
  plot.points(
      n::select(fit, 1, 0).to_vector<double>(),
      n::select(fit, 1, 1).to_vector<double>(),
      "1,000 fitting rows",
      {210, 210, 210},
      1.5);
  for (int digit = 0; digit < 10; ++digit) {
    std::vector<std::int64_t> rows;
    for (int row = 0; row < 200; ++row)
      if (labels[row] == digit)
        rows.push_back(row);
    const auto points = n::take_rows(display, rows);
    plot.points(
        n::select(points, 1, 0).to_vector<double>(),
        n::select(points, 1, 1).to_vector<double>(),
        "Test digit " + std::to_string(digit),
        palette[digit],
        3.);
  }
  const auto clipped =
      n::count_nonzero(n::any(n::logical_or(n::less(test, lower), n::greater(test, upper)), {1}))
          .item<std::int64_t>();
  std::print("All 200 held-out points retained; boundary-clipped points: {}.\n", clipped);
  plot.x_limits(lower.at({0, 0}), upper.at({0, 0}))
      .y_limits(lower.at({0, 1}), upper.at({0, 1}))
      .x_label("Fitted PC1")
      .y_label("Fitted PC2")
      .size(1200, 960)
      .title("Two-coordinate display of 32D frozen autoencoder codes")
      .save_svg("build/visualization_code_scatter.svg");
}
```
