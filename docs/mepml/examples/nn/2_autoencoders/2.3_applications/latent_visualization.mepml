```{cpp, results="markdown", file="figures/visualization_neighbor_gallery.png", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
  namespace n = dm::nn;
  std::map<std::string, n::Tensor> a;
  for (const auto& [key, value] : n::load_npz("build/visualization/analysis.npz"))
    a.emplace(key, value);
  const auto test_labels = a.at("test_labels").to_vector<int>(),
             fit_labels  = a.at("fit_labels").to_vector<int>(),
             ids         = a.at("test_source_ids").to_vector<int>();
  const std::vector<std::string> spaces{"pixel", "ae32", "ae2", "pca32", "pca2"};
  std::vector<n::Tensor>         panels;
  std::print(
      "| query truth / source ID | pixel | AE32 | code PCA2 | pixel PCA32 | pixel PCA2 "
      "|\n|---|---:|---:|---:|---:|---:|\n");
  for (int digit = 0; digit < 10; ++digit) {
    const auto row = std::find(test_labels.begin(), test_labels.end(), digit) - test_labels.begin();
    if (row == 200)
      return 1;
    panels.push_back(n::take_rows(a.at("test_images"), {row}));
    std::print("| {} / {} ", digit, ids[row]);
    for (const auto& name : spaces) {
      const auto neighbor = std::int64_t(a.at(name + "_neighbors").at({row, 0}));
      panels.push_back(n::take_rows(a.at("fit_images"), {neighbor}));
      std::print("| {} ", fit_labels[neighbor]);
    }
    std::print("|\n");
  }
  n::save_image_grid(
      n::concat(panels, 0), "build/visualization_neighbor_gallery.png", 6, 0, 1, 4, 220. / 255., 3);
}
