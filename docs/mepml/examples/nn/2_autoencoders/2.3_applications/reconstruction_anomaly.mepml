> Ten predetermined source rows, split into readable four-column galleries

The source rule is floor(k*199/9), k=0,...,9, retaining the original evenly spaced rows without
filtering by detector success. The first gallery shows original/reconstruction/white patch/
patch reconstruction; the second shows darkening/reconstruction/right shift/shift reconstruction.
All panels share fixed[0,1] grayscale, threefold nearest-pixel scaling and four-pixel gaps.
The source IDs and all AE scores are printed alongside the corresponding program.

```{cpp, results="markdown", file="figures/anomaly_cases_patch.png", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <map>
int main() {
  namespace n = dm::nn;
  std::map<std::string, n::Tensor> a;
  for (const auto& [k, v] : n::load_npz("build/anomaly/analysis.npz"))
    a.emplace(k, v);
  const auto             source = a.at("test_source_ids").to_vector<int>();
  std::vector<n::Tensor> tiles;
  std::print(
      "| row | source ID | nominal AE | patch AE | darkening AE | shift AE "
      "|\n|---:|---:|---:|---:|---:|---:|\n");
  for (int k = 0; k < 10; ++k) {
    const int row = k * 199 / 9;
    std::print(
        "| {} | {} | {:.9f} | {:.9f} | {:.9f} | {:.9f} |\n",
        row,
        source[row],
        a.at("test_ae_score").at({row}),
        a.at("patch_ae_score").at({row}),
        a.at("darkening_ae_score").at({row}),
        a.at("shift_ae_score").at({row}));
    for (const auto& key :
         {"test_images", "test_reconstruction", "patch_images", "patch_reconstruction"})
      tiles.push_back(n::take_rows(a.at(key), {row}).reshape({1, 28, 28, 1}));
  }
  n::save_image_grid(
      n::concat(tiles, 0), "build/anomaly_cases_patch.png", 4, 0, 1, 4, 220. / 255., 3);
}
