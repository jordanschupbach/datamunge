> Complete frozen application: every score, transformation and ranking

The fitting-mean baseline sums fitting pixels in sample-order double then rounds to Float32,
as in the original. Its mean ink reference averages these rounded nonnegative pixel means in
feature order; deviation from zero equals their mean because every entry is nonnegative.
The caller explicitly computes this reference before test scoring.

All200 held-out originals receive each fixed transformation: an8×8 white upper-left patch,
Float32 multiplication by.35, and a six-column right shift with zero fill. Every digit class
remains nominal; the binary evaluation labels identify these artificial transformations.
Darkening or translation may be legitimate domain variation. The600 transformed cases are
paired versions of200 sources, not600 independent new source examples. A blank image is
retained as a separate degenerate-input control and excluded from ranking pools.

Each rule uses only its200 nominal validation scores for the explicit95th-percentile
threshold. The table retains all nine combinations, including failures, and checks every
frozen model value for immutability. AP uses200 nominal/200 transformed cases for each type;
changing that prevalence changes AP. No threshold sweep on test outcomes is performed.

```{cpp, results="markdown", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <fstream>
#include <map>
namespace n = dm::nn;
namespace m = n::models;
void Require(bool condition, const std::string& message) {
  if (!condition)
    throw std::runtime_error(message);
}
int main() {
  const std::filesystem::path cache = dm::datasets::data_home(), root = "build/anomaly";
  std::filesystem::create_directories(root);
  dm::datasets::prepare_example_data("mnist-assets", cache.string());
  const auto        pools = m::LoadSaliency(cache / "saliency");
  n::ParameterStore p(1471);
  {
    n::NoGradGuard guard;
    m::UndercompleteAutoencoder(p, n::zeros({1, 784}));
  }
  p.load("build/anomaly_selected_encoder.npz");
  Require(p.count() == 50992, "Original frozen architecture");
  n::NamedTensors before;
  for (const auto& name : p.names())
    before.emplace_back(name, p.at(name).detach().clone());
  n::NoGradGuard guard;
  // Fitting pixels sum in sample order in Float64, then round once to Float32.
  const auto mean = n::cast(
      n::mean(n::cast(pools[0].images.reshape({1000, 784}), n::DType::Float64), {0}),
      n::DType::Float32);
  // All fitting pixel means are nonnegative: deviation from zero equals their mean.
  // InkScores keeps the original feature-order Double accumulation of these rounded means.
  const double                     fit_ink = m::InkScores(mean.reshape({1, 784}), 0).item();
  std::map<std::string, n::Tensor> arrays;
  for (int k = 0; k < 3; ++k) {
    const std::string split = k == 0 ? "fit" : k == 1 ? "validation" : "test";
    const auto        out =
        m::UndercompleteAutoencoder(p, pools[k].images.reshape({pools[k].images.size(0), 784}));
    arrays.emplace(split + "_images", pools[k].images);
    arrays.emplace(split + "_labels", pools[k].labels);
    arrays.emplace(split + "_source_ids", pools[k].source);
    arrays.emplace(split + "_reconstruction", out.reconstruction);
    arrays.emplace(
        split + "_ae_score", m::ReconstructionScores(pools[k].images, out.reconstruction));
    arrays.emplace(
        split + "_mean_score",
        m::ReconstructionScores(
            pools[k].images, n::broadcast_to(mean.reshape({1, 784}), out.reconstruction.shape())));
    arrays.emplace(split + "_ink_score", m::InkScores(pools[k].images, fit_ink));
  }
  arrays.emplace("fit_pixel_mean", mean);
  const std::vector<std::string> names{"patch", "darkening", "shift"};
  for (int kind = 0; kind < 3; ++kind) {
    const auto image = m::AnomalyCorruption(pools[2].images, kind);
    const auto out   = m::UndercompleteAutoencoder(p, image.reshape({200, 784}));
    arrays.emplace(names[kind] + "_images", image);
    arrays.emplace(names[kind] + "_reconstruction", out.reconstruction);
    arrays.emplace(names[kind] + "_ae_score", m::ReconstructionScores(image, out.reconstruction));
    arrays.emplace(
        names[kind] + "_mean_score",
        m::ReconstructionScores(
            image, n::broadcast_to(mean.reshape({1, 784}), out.reconstruction.shape())));
    arrays.emplace(names[kind] + "_ink_score", m::InkScores(image, fit_ink));
  }
  const auto blank        = n::zeros({1, 28, 28, 1}),
             blank_output = m::UndercompleteAutoencoder(p, blank.reshape({1, 784})).reconstruction;
  arrays.emplace("blank_image", blank);
  arrays.emplace("blank_reconstruction", blank_output);
  arrays.emplace("blank_ae_score", m::ReconstructionScores(blank, blank_output));
  for (const auto& [name, value] : before)
    Require(n::equal_bits(value, p.at(name)), "All50992 frozen model values immutable");
  n::save_npz((root / "analysis.npz").string(), n::NamedTensors(arrays.begin(), arrays.end()));
  n::save_npz((root / "model_arrays.npz").string(), before);
  std::filesystem::copy_file(
      cache / "saliency/manifest.json",
      root / "data_manifest.json",
      std::filesystem::copy_options::overwrite_existing);
  std::ofstream table(root / "rankings.tsv"), meta(root / "metrics.json");
  table.precision(17);
  meta.precision(17);
  table << "score\tcorruption\tvalidation_nominal_threshold\tvalidation_nominal_fpr\ttest_nominal_"
           "fpr\tcorruption_tpr\tauroc\taverage_precision\n";
  meta << "{\"additional_training_updates\":0,\"fit_records\":1000,\"validation_nominal_records\":"
          "200,\"test_nominal_records\":200,\"each_corruption_records\":200,\"quantile\":0.95,"
          "\"fit_mean_ink\":"
       << fit_ink << ",\"blank_ae_score\":" << arrays.at("blank_ae_score").item()
       << ",\"thresholds\":{";
  std::print(
      "| score | corruption | threshold | calibration FPR | test FPR | TPR | AUROC | AP "
      "|\n|---|---|---:|---:|---:|---:|---:|---:|\n");
  bool first = true;
  for (const std::string score : {"ae", "mean", "ink"}) {
    const auto   validation = arrays.at("validation_" + score + "_score");
    const double threshold  = m::NominalThreshold(validation);
    const double calibration_fpr =
        n::mean(n::cast(n::greater(validation, threshold), n::DType::Float64)).item();
    if (!first)
      meta << ',';
    first = false;
    meta << '"' << score << "\":" << threshold;
    for (const auto& name : names) {
      const auto r = m::RankAnomalies(
          arrays.at("test_" + score + "_score"),
          arrays.at(name + "_" + score + "_score"),
          threshold);
      table << score << '\t' << name << '\t' << threshold << '\t' << calibration_fpr << '\t'
            << r.normal_fpr << '\t' << r.anomaly_tpr << '\t' << r.auroc << '\t'
            << r.average_precision << '\n';
      std::print(
          "| {} | {} | {:.9f} | {:.3f} | {:.3f} | {:.3f} | {:.6f} | {:.6f} |\n",
          score,
          name,
          threshold,
          calibration_fpr,
          r.normal_fpr,
          r.anomaly_tpr,
          r.auroc,
          r.average_precision);
    }
  }
  meta << "}}\n";
  for (int k = 0; k < 10; ++k) {
    const int              row = k * 199 / 9;
    std::vector<n::Tensor> tiles;
    for (const auto& key :
         {"test_images",
          "test_reconstruction",
          "patch_images",
          "patch_reconstruction",
          "darkening_images",
          "darkening_reconstruction",
          "shift_images",
          "shift_reconstruction"})
      tiles.push_back(n::take_rows(arrays.at(key), {row}).reshape({28, 28, 1}));
    n::save_image_grid(
        n::tile(n::stack(tiles, 0), {1, 1, 1, 3}),
        (root / ("case_" + std::to_string(k) + ".png")).string(),
        8,
        0,
        1,
        4,
        220. / 255.,
        3);
  }
  Require(bool(table) && bool(meta), "Complete all nine ranking records");
  std::print(
      "\nAll600 paired corruptions retained. Zero new updates; all50992 model values immutable. "
      "Blank AE score {:.12f}, excluded from ranking pools.\n",
      arrays.at("blank_ae_score").item());
}
```
