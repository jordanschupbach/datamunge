  for (const auto& [k, v] : n::load_npz("build/anomaly/analysis.npz"))
    a.emplace(k, v);
  const double score     = a.at("blank_ae_score").item(),
               threshold = n::models::NominalThreshold(a.at("validation_ae_score"));
  std::print(
      "Blank AE score {:.12f}; threshold {:.12f}; strict flag {}. Excluded from all nine "
      "rankings.\n",
      score,
      threshold,
      score > threshold);
