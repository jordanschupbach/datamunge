> Score hidden patches with a hidden-only denominator

The next program recomputes four hidden losses through native patch mapping and MaeLoss.
It also checks full-composite MSE=0.75×hidden MSE for the masked composite. Because all visible
pixels are copied, the full-image score includes zero visible error; using it without the
hidden fraction would understate completion error.

```{cpp, results="markdown", file="figures/restoration_hidden_mse.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
  namespace n     = dm::nn;
  const auto a    = n::load_npz("build/restoration/analysis.npz");
  auto       find = [&](const std::string& name) {
    for (const auto& [key, value] : a)
      if (key == name)
        return value;
    throw std::runtime_error(name);
  };
  const auto hidden = n::cast(1. - n::sum(find("selection"), {1}), n::DType::Float64),
             target = n::models::MaePatches(n::cast(find("test_images"), n::DType::Float64));
  const std::vector<std::string> names{
      "mae_composite", "mean_composite", "denoising_composite", "observed"},
      labels{"MAE", "fit mean", "DAE mismatch", "zero fill"};
  std::vector<double> cost;
  std::print("| completion | hidden-only MSE |\n|---|---:|\n");
  for (int i = 0; i < 4; ++i) {
    const auto value =
        n::models::MaePatches(n::cast(find(names[i]).reshape({200, 28, 28, 1}), n::DType::Float64));
    cost.push_back(n::models::MaeLoss(value, target, hidden).item());
    std::print("| {} | {:.9f} |\n", labels[i], cost.back());
  }
  const double full = n::mean(
                          n::square(
                              n::cast(find("mae_composite"), n::DType::Float64) -
                              n::cast(find("test_images").reshape({200, 784}), n::DType::Float64)))
                          .item();
  if (std::abs(full - .75 * cost[0]) > 2e-13)
    return 1;
  auto chart = dm::graphics::RPlot::create();
  chart.bars({0, 1, 2, 3}, cost, "hidden MSE", dm::RGBA{37, 99, 235}, .65)
      .x_ticks({0, 1, 2, 3}, labels)
      .x_limits(-.7, 4.4)
      .title("Missing-patch restoration / all 200 held-out cases")
      .x_label("frozen completion rule")
      .y_label("mean squared error on 588 hidden pixels per case")
      .save_svg("build/restoration_hidden_mse.svg");
}
