\caption(Native MNIST inputs and source IDs prepare the masked fit without hidden-target leakage into its encoder.)

```{cpp, results="markdown", file="figures/restoration_masked_learning.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
  namespace n = dm::nn;
  std::map<std::string, n::Tensor> data;
  for (const auto& [name, value] : n::load_npz("build/masked_data.npz"))
    data.emplace(name, value);
  const auto fit = data.at("fit_images"), validation = data.at("validation_images"),
             test = data.at("test_images");
  n::ParameterStore p(1877);
  {
    n::NoGradGuard     guard;
    std::vector<float> first(64);
    for (int i = 0; i < 4; ++i)
      first[i * 16 + i] = 1;
    n::models::MaskedAutoencoder(p, n::zeros({1, 28, 28, 1}), n::from_vector(first, {1, 4, 16}));
    p.save("build/masked_initial.npz");
    const auto initial =
        n::models::MaskedAutoencoder(p, test, n::models::MaeSelection(data.at("test_source_ids")));
    n::save_npz(
        "build/masked_initial_outputs.npz",
        {{"code", initial.code}, {"prediction", initial.prediction}});
  }
  n::OptimizerConfig config;
  config.kind = n::OptimizerKind::Adam;
  n::Optimizer  optimizer(p, .003, config);
  n::BatchOrder order(1000, 32, 1889);
  const auto    validation_selection = n::models::MaeSelection(data.at("validation_source_ids"));
  double        best                 = std::numeric_limits<double>::infinity();
  int           selected = 0, updates = 0;
  std::ofstream batches("build/masked_batches.tsv");
  batches << "epoch\tstep\trow\tsource_id\n";
  const auto          source = data.at("fit_source_ids").to_vector<int>();
  std::vector<double> epochs, train, valid;
  std::print(
      "| epoch | fitting pre-update masked MSE | validation masked MSE |\n|---:|---:|---:|\n");
  for (int epoch = 1; epoch <= 3; ++epoch) {
    order.begin_epoch();
    const auto all_masks = n::models::MaeSelection(data.at("fit_source_ids"), epoch);
    n::save_npz(
        "build/masked_epoch" + std::to_string(epoch) + "_mask.npz", {{"selection", all_masks}});
    double total = 0;
    int    seen  = 0;
    for (;;) {
      const auto rows = order.next();
      if (rows.empty())
        break;
      const auto images = n::take_rows(fit, rows), selection = n::take_rows(all_masks, rows);
      const auto net  = n::models::MaskedAutoencoder(p, images, selection);
      const auto loss = n::models::MaeLoss(net.prediction, net.patches, net.mask);
      if (updates == 0) {
        n::GradOptions keep;
        keep.retain_graph         = true;
        const auto      gradients = n::grad(loss, p.parameters(), keep);
        n::NamedTensors saved;
        for (std::size_t i = 0; i < gradients.size(); ++i) {
          const auto norm = n::sqrt(n::sum(n::square(gradients[i]))).item();
          if (!std::isfinite(norm) || norm <= 0)
            return 1;
          saved.emplace_back(p.names()[i], gradients[i]);
        }
        n::save_npz("build/masked_first_gradients.npz", saved);
        n::save_npz("build/masked_first_batch.npz", {{"images", images}, {"selection", selection}});
      }
      const double value = loss.item();
      if (!std::isfinite(value) || value < 0)
        return 1;
      optimizer.minimize(loss);
      total += rows.size() * value;
      seen += int(rows.size());
      for (auto row : rows)
        batches << epoch << '\t' << updates << '\t' << row << '\t' << source[row] << '\n';
      if (updates == 0)
        p.save("build/masked_first_update.npz");
      ++updates;
    }
    n::NoGradGuard guard;
    const auto     net   = n::models::MaskedAutoencoder(p, validation, validation_selection);
    const double   score = n::models::MaeLoss(
                             n::cast(net.prediction, n::DType::Float64),
                             n::cast(net.patches, n::DType::Float64),
                             n::cast(net.mask, n::DType::Float64))
                             .item();
    if (seen != 1000 || !std::isfinite(score))
      return 1;
    p.save("build/masked_epoch" + std::to_string(epoch) + ".npz");
    if (score < best) {
      best     = score;
      selected = epoch;
      p.save("build/masked_best.npz");
    }
    epochs.push_back(epoch);
    train.push_back(total / seen);
    valid.push_back(score);
    std::print("| {} | {:.9f} | {:.9f} |\n", epoch, total / seen, score);
  }
  if (updates != 96 || !batches)
    return 1;
  n::save_npz(
      "build/masked_selection.npz",
      {{"epoch", n::full({}, selected, n::DType::Int32)},
       {"validation_mse", n::full({}, best, n::DType::Float64)},
       {"epochs", n::from_vector(epochs, {3})},
       {"fit_mse", n::from_vector(train, {3})},
       {"validation_path", n::from_vector(valid, {3})}});
  dm::graphics::RPlot::create()
      .lines(epochs, train, "fit: changing masks", {37, 99, 235}, 2.)
      .lines(epochs, valid, "validation: fixed masks", {220, 38, 38}, 2.)
      .x_label("epoch")
      .y_label("hidden-pixel MSE")
      .title("Visible-only MAE: three epochs / 96 Adam updates")
      .save_svg("build/restoration_masked_learning.svg");
  std::print(
      "Selected epoch {}; {} updates; every first parameter gradient finite and nonzero.\n",
      selected,
      updates);
}
```
// result_begin: markdown
| epoch | fitting pre-update masked MSE | validation masked MSE |
|---:|---:|---:|
| 1 | 0.149243645 | 0.100740956 |
| 2 | 0.097578129 | 0.089629951 |
| 3 | 0.085430081 | 0.076652002 |
Selected epoch 3; 96 updates; every first parameter gradient finite and nonzero.
\image(figures/restoration_masked_learning.svg)
// result_end

\caption(All 96 masked-model updates remain visible. Fixed validation masks, not test results, choose the saved weights.)

> Freeze the models, then change the corruption

The application restores all 4+4+35 leaves and checks all three stores for immutability.
A new independent Gaussian bank uses seed 4229 for all 200 test cases. The same standard draws
are reused at sigma 0,0.15,0.35 and 0.6, with Float32 sigma, Float64 addition, Float32 rounding
and clipping to [0,1]. Only 0.35 matches the denoiser's training amplitude; the other settings
are sensitivity controls. Raw noisy input, the matched ordinary network and a fitting-only
pixel mean remain comparison baselines. PSNR is 10log10(1/global MSE), with unit pixel range;
it is not an average of per-image PSNR values.

Inpainting uses a fresh source-keyed selector with seed 4243 and epoch 0: four visible patches
and twelve hidden, 588 hidden pixels per case. Inference receives observed pixels plus locations.
The application replaces every hidden value with 0, then 1, then the true clean values and checks
that the actual MAE code/prediction are bit-exact under all three inputs. Clean targets are
used only to score the completed output. The Gaussian denoiser applied to a masked image is
an explicit corruption mismatch baseline, not a fair architecture ranking.

```{cpp, results="markdown", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
namespace nn = dm::nn;
namespace ae {
void Require(bool ok, const std::string& why) {
  if (!ok)
    throw std::runtime_error(why);
}
void Near(double a, double b, double tol, const std::string& why) {
  Require(std::abs(a - b) <= tol, why);
}
nn::Tensor Find(const nn::NamedTensors& a, const std::string& name) {
  for (const auto& [key, value] : a)
    if (key == name)
      return value;
  throw std::runtime_error(name);
}
nn::NamedTensors Arrays(const nn::ParameterStore& p) {
  nn::NamedTensors a;
  for (const auto& name : p.names())
    a.emplace_back(name, p.at(name).detach().clone());
  return a;
}
auto Snapshot(const nn::ParameterStore& p) {
  return p.flatten();
}
double Mse(const nn::Tensor& a, const nn::Tensor& b) {
  return nn::mean(
             nn::square(
                 nn::cast(a.reshape({a.size(0), 784}), nn::DType::Float64) -
                 nn::cast(b.reshape({b.size(0), 784}), nn::DType::Float64)))
      .item();
}
nn::Tensor PixelMean(const nn::Tensor& x) {
  return nn::cast(
      nn::mean(nn::cast(x.reshape({x.size(0), 784}), nn::DType::Float64), {0}), nn::DType::Float32);
}
nn::Tensor Constant(const nn::Tensor& row, int n) {
  return nn::broadcast_to(row.reshape({1, 784}), {n, 784}).contiguous();
}

using nn::models::CorruptForDenoising;
using nn::models::GaussianNoise;
using nn::models::LoadSaliency;
using nn::models::MaeImage;
using nn::models::MaeSelection;
int MaePixel(int patch, int within) {
  return int(nn::models::MaePixel(patch, within));
}
bool MaeHidden(const std::vector<float>& selection, std::int64_t row, int patch) {
  float used = 0;
  for (int r = 0; r < 4; ++r)
    used += selection[(row * 4 + r) * 16 + patch];
  return used == 0;
}
void WarmDense(nn::ParameterStore& p) {
  nn::NoGradGuard guard;
  nn::models::UndercompleteAutoencoder(p, nn::zeros({1, 784}));
}
void WarmMasked(nn::ParameterStore& p) {
  nn::NoGradGuard    guard;
  std::vector<float> s(64);
  for (int k = 0; k < 4; ++k)
    s[k * 16 + k] = 1;
  nn::models::MaskedAutoencoder(p, nn::zeros({1, 28, 28, 1}), nn::from_vector(s, {1, 4, 16}));
}
std::vector<nn::Tensor> Predict(nn::ParameterStore& p, const nn::Tensor& images) {
  nn::NoGradGuard guard;
  const auto out = nn::models::UndercompleteAutoencoder(p, images.reshape({images.size(0), 784}));
  return {out.code, out.reconstruction};
}
std::vector<nn::Tensor>
RestoreVisible(nn::ParameterStore& p, const nn::Tensor& observed, const nn::Tensor& selector) {
  nn::NoGradGuard guard;
  const auto      e = nn::models::MaeEncode(p, observed, selector);
  const auto      d = nn::models::MaeDecode(p, e.code, selector);
  return {e.code.contiguous(), d.prediction.contiguous()};
}
nn::Tensor VisibleImage(const nn::Tensor& original, const nn::Tensor& selection, double fill = 0) {
  const auto hidden = 1. - nn::sum(selection, {1});
  return nn::models::MaeImage(
             nn::models::VisiblePatchValues(nn::models::MaePatches(original), hidden, fill))
      .reshape(original.shape());
}
nn::Tensor InpaintComposite(
    const nn::Tensor& observed,
    const nn::Tensor& prediction,
    const nn::Tensor& selection) {
  const auto n = observed.size(0);
  return nn::models::MaeImage(
      nn::models::CompositePatchValues(
          nn::models::MaePatches(observed.reshape({n, 28, 28, 1})),
          nn::models::MaePatches(prediction.reshape({n, 28, 28, 1})),
          1. - nn::sum(selection, {1})));
}
double HiddenRestorationMse(
    const nn::Tensor& prediction,
    const nn::Tensor& clean,
    const nn::Tensor& selection) {
  const auto n = clean.size(0);
  return nn::models::MaeLoss(
             nn::models::MaePatches(
                 nn::cast(prediction.reshape({n, 28, 28, 1}), nn::DType::Float64)),
             nn::models::MaePatches(nn::cast(clean.reshape({n, 28, 28, 1}), nn::DType::Float64)),
             nn::cast(1. - nn::sum(selection, {1}), nn::DType::Float64))
      .item();
}
} // namespace ae
namespace check {
using ae::Near;
using ae::Require;
} // namespace check
namespace {

namespace nn = datamunge::nn;

void Run(
    const std::filesystem::path& data,
    const std::filesystem::path& models,
    const std::filesystem::path& root) {
  auto pools = ae::LoadSaliency(data);
  std::filesystem::create_directories(root);
  nn::ParameterStore denoising(1657), ordinary(1657);
  ae::WarmDense(denoising);
  ae::WarmDense(ordinary);
  nn::ParameterStore masked(1877);
  ae::WarmMasked(masked);
  denoising.load((models / "denoising_denoising_best.npz").string());
  ordinary.load((models / "denoising_ordinary_best.npz").string());
  masked.load((models / "masked_best.npz").string());
  const auto db = ae::Snapshot(denoising), ob = ae::Snapshot(ordinary), mb = ae::Snapshot(masked);
  const auto clean = pools[2].images;
  std::map<std::string, nn::Tensor> arrays;
  for (int k = 0; k < 3; ++k) {
    const std::string split = k == 0 ? "fit" : k == 1 ? "validation" : "test";
    arrays.emplace(split + "_images", pools[k].images);
    arrays.emplace(split + "_labels", pools[k].labels);
    arrays.emplace(split + "_source_ids", pools[k].source);
  }
  const auto standard = ae::GaussianNoise(clean.shape(), 1, 4229);
  arrays.emplace("standard_noise", standard);
  const auto mean = ae::PixelMean(pools[0].images), mean_images = ae::Constant(mean, 200);
  arrays.emplace("fit_pixel_mean", mean);
  arrays.emplace("mean_images", mean_images);
  std::ofstream table(root / "denoising.tsv");
  table.precision(17);
  table << "condition\tsigma\tnoisy_input_mse\tdenoising_mse\tordinary_mse\tfit_mean_"
           "mse\tdenoising_global_psnr_db\n";
  const std::vector<std::string> conditions{"clean", "low", "trained_sigma", "high"};
  const float                    sigmas[] = {0, .15f, .35f, .6f};
  for (int k = 0; k < 4; ++k) {
    auto input = ae::CorruptForDenoising(clean, standard, sigmas[k]);
    auto d = ae::Predict(denoising, input), o = ae::Predict(ordinary, input);
    if (!k)
      check::Require(nn::equal_bits(input, clean), "sigma0exactcleanidentity");
    arrays.emplace(conditions[k] + "_input", input);
    arrays.emplace(conditions[k] + "_denoising", d[1]);
    arrays.emplace(conditions[k] + "_ordinary", o[1]);
    const double dm = ae::Mse(d[1], clean), raw = ae::Mse(input, clean), om = ae::Mse(o[1], clean);
    table << conditions[k] << '\t' << sigmas[k] << '\t' << raw << '\t' << dm << '\t' << om << '\t'
          << ae::Mse(mean_images, clean) << '\t' << 10 * std::log10(1 / dm) << '\n';
    std::cout << conditions[k] << ":inputMSE=" << raw << ",denoised=" << dm << ",ordinary=" << om
              << std::endl;
  }
  const auto selection   = ae::MaeSelection(pools[2].source, 0, 4243),
             observed    = ae::VisibleImage(clean, selection, 0),
             changed     = ae::VisibleImage(clean, selection, 1);
  const auto inferred    = ae::RestoreVisible(masked, observed, selection),
             probe       = ae::RestoreVisible(masked, changed, selection),
             clean_probe = ae::RestoreVisible(masked, clean, selection);
  check::Require(
      nn::equal_bits(inferred[0], probe[0]) && nn::equal_bits(inferred[1], probe[1]) &&
          nn::equal_bits(inferred[1], clean_probe[1]),
      "actual MAEgraph predictions BITEXACTindependent of ALLhiddenpixel values");
  const auto hidden_prediction = ae::MaeImage(inferred[1]),
             composite         = ae::InpaintComposite(observed, hidden_prediction, selection),
             mean_fill         = ae::InpaintComposite(observed, mean_images, selection);
  const auto d_masked          = ae::Predict(denoising, observed)[1],
             d_fill            = ae::InpaintComposite(observed, d_masked, selection);
  {
    const auto c = composite.to_vector<float>(), x = clean.contiguous().to_vector<float>(),
               s = selection.to_vector<float>();
    for (int b = 0; b < 200; ++b)
      for (int p = 0; p < 16; ++p)
        if (!ae::MaeHidden(s, b, p))
          for (int i = 0; i < 49; ++i) {
            const int index = b * 784 + ae::MaePixel(p, i);
            check::Near(c[index], x[index], 0, "observed pixels copied BITEXACT");
          }
  }
  for (const auto& [key, value] : std::map<std::string, nn::Tensor>{
           {"selection", selection},
           {"observed", observed},
           {"hidden_changed", changed},
           {"mae_code", inferred[0]},
           {"mae_patch_prediction", inferred[1]},
           {"mae_hidden_prediction", hidden_prediction},
           {"mae_composite", composite},
           {"mean_composite", mean_fill},
           {"denoising_masked_prediction", d_masked},
           {"denoising_composite", d_fill}})
    arrays.emplace(key, value);
  check::Require(
      db == ae::Snapshot(denoising) && ob == ae::Snapshot(ordinary) && mb == ae::Snapshot(masked),
      "all restoration calls leave THREE models immutable");
  nn::save_npz((root / "analysis.npz").string(), nn::NamedTensors(arrays.begin(), arrays.end()));
  nn::save_npz((root / "denoising_arrays.npz").string(), ae::Arrays(denoising));
  nn::save_npz((root / "ordinary_arrays.npz").string(), ae::Arrays(ordinary));
  nn::save_npz((root / "masked_arrays.npz").string(), ae::Arrays(masked));
  if (std::filesystem::exists(data / "manifest.json"))
    std::filesystem::copy_file(
        data / "manifest.json",
        root / "data_manifest.json",
        std::filesystem::copy_options::overwrite_existing);
  const double hidden_mse = ae::HiddenRestorationMse(composite, clean, selection),
               mean_mse   = ae::HiddenRestorationMse(mean_fill, clean, selection),
               d_mse      = ae::HiddenRestorationMse(d_fill, clean, selection),
               zero_mse   = ae::HiddenRestorationMse(observed, clean, selection);
  std::ofstream meta(root / "metrics.json");
  meta.precision(17);
  meta << "{\"additional_training_updates\":0,\"denoising_parameters\":" << denoising.count()
       << ",\"ordinary_parameters\":" << ordinary.count()
       << ",\"masked_parameters\":" << masked.count()
       << ",\"test_records\":200,\"visible_patches\":4,\"hidden_patches\":12,\"hidden_pixels_per_"
          "case\":588,\"mae_hidden_mse\":"
       << hidden_mse << ",\"fit_mean_hidden_mse\":" << mean_mse
       << ",\"denoising_hidden_mse\":" << d_mse << ",\"zero_hidden_mse\":" << zero_mse
       << ",\"mae_composite_full_mse\":" << ae::Mse(composite, clean)
       << ",\"hidden_values_prediction_max_effect\":0,\"observed_composite_max_error\":0}\n";
  check::Require(denoising.count() == 50992 && masked.count() == 13649, "50992/13649 inventories");
  check::Require(bool(meta) && bool(table), "complete frozen restoration evidence");
  std::print(
      "| application updates | hidden MAE MSE | hidden fit-mean MSE | hidden DAE mismatch MSE | "
      "hidden zero-fill MSE |\n|---:|---:|---:|---:|---:|\n| 0 | {:.9f} | {:.9f} | {:.9f} | {:.9f} "
      "|\n",
      hidden_mse,
      mean_mse,
      d_mse,
      zero_mse);
}
} // namespace
int main() {
  try {
    const auto cache = std::filesystem::path(dm::datasets::data_home());
    dm::datasets::prepare_example_data("mnist-assets", cache.string());
    Run(cache / "saliency", "build", "build/restoration");
    return 0;
  } catch (const std::exception& e) {
    std::cerr << e.what() << '\n';
    return 1;
  }
}
