> Noise sensitivity includes the clean-input failure

```{cpp, results="markdown", file="figures/restoration_noise.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
  std::ifstream input("build/restoration/denoising.tsv");
  std::string   header, name;
  std::getline(input, header);
  std::vector<double> sigma, raw, dae, ordinary, mean;
  double              s, r, d, o, m, psnr;
  std::print(
      "| condition | sigma | raw MSE | denoiser MSE | ordinary MSE | fit mean MSE | denoiser "
      "global PSNR dB |\n|---|---:|---:|---:|---:|---:|---:|\n");
  while (input >> name >> s >> r >> d >> o >> m >> psnr) {
    sigma.push_back(s);
    raw.push_back(r);
    dae.push_back(d);
    ordinary.push_back(o);
    mean.push_back(m);
    std::print(
        "| {} | {:.2f} | {:.9f} | {:.9f} | {:.9f} | {:.9f} | {:.6f} |\n",
        name,
        s,
        r,
        d,
        o,
        m,
        psnr);
  }
  if (sigma.size() != 4)
    return 1;
  auto chart = dm::graphics::RPlot::create();
  chart.lines(sigma, raw, "raw input", dm::RGBA{100, 116, 139}, 2)
      .points(sigma, raw, "", dm::RGBA{100, 116, 139}, 5)
      .lines(sigma, dae, "denoiser", dm::RGBA{37, 99, 235}, 2)
      .points(sigma, dae, "", dm::RGBA{37, 99, 235}, 5)
      .lines(sigma, ordinary, "ordinary", dm::RGBA{220, 38, 38}, 2)
      .points(sigma, ordinary, "", dm::RGBA{220, 38, 38}, 5)
      .lines(sigma, mean, "fit mean", dm::RGBA{147, 51, 234}, 2)
      .title("Frozen-model Gaussian restoration / same draws across amplitudes")
      .x_label("sigma before rounding and clipping")
      .y_label("global test pixel MSE")
      .x_limits(-.02, .86)
      .x_ticks({0, .15, .35, .6}, {"0", "0.15", "0.35", "0.6"})
      .save_svg("build/restoration_noise.svg");
}
