\alttext(Fitting pre-update and validation post-epoch reconstruction losses across the three prerequisite epochs.)

> Two frozen encoders, two matched supervised heads

For each encoder, fitting codes determine a separate frozen population center and scale.
The linear head uses seed 4703; batch order uses seed 4721. Each of three epochs visits all
1,000 fitting images exactly once in batches of 32, including the final batch of eight.
There are 96 head updates per branch, 192 in total. Head loss is mean categorical log-softmax
cross-entropy, with neither probability clipping nor encoder updates.

The diagnostic NLL in the history follows the original saved-probability convention:
mean(-log(max(1e-30,p_truth))). It can differ from the stable training loss at extreme logits.
The report evaluates this diagnostic with native Float64 tensor reductions; reduction roundoff
is recorded separately from exact parameter and prediction comparisons. All three post-epoch
validation-label NLL candidates are eligible; the lowest selects the head. Validation accuracy
and held-out scores do not select it. Model-only restore starts a fresh head, not an optimizer
resume. The programs below retain all first-batch endpoints, all 330 head derivatives, a
shifted-label derivative control and all 26 original numeric archives.

```{cpp, results="markdown", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <chrono>
#include <dm/dm.hpp>
#include <fstream>
namespace nn = dm::nn;
void Require(bool value, const std::string& message) {
  if (!value)
    throw std::runtime_error(message);
}
void Near(double value, double expected, double tolerance, const std::string& message) {
  Require(std::abs(value - expected) <= tolerance, message);
}
std::vector<double> Score(const nn::Tensor& p, const nn::Tensor& labels) {
  nn::NoGradGuard guard;
  const auto      logp = nn::log(nn::clip(nn::cast(p, nn::DType::Float64), 1e-30, 1));
  return {
      nn::mean(-nn::sum(nn::one_hot(labels, 10, 1, 0, nn::DType::Float64) * logp, {1}), {0}).item(),
      nn::accuracy(p, labels)};
}
double Run(
    const std::vector<nn::models::SaliencyData>& pools,
    const nn::NamedTensors&                      source,
    const std::filesystem::path&                 root,
    int                                          epochs,
    const std::filesystem::path&                 init) {
  std::filesystem::create_directories(root);
  auto find = [](const nn::NamedTensors& values, const std::string& key) {
    for (const auto& [name, value] : values)
      if (name == key)
        return value;
    throw std::invalid_argument("missing array " + key);
  };
  const auto w = find(source, "encoder/W"), b = find(source, "encoder/b");
  auto fit_code = nn::models::FrozenEncoderFeatures(pools[0].images.reshape({1000, 784}), w, b);
  const auto                          fitted = nn::models::FitTransferScaling(fit_code);
  auto                                center = fitted.center, scale = fitted.scale;
  nn::models::FrozenEncoderClassifier model(w, b, center, scale);
  nn::ParameterStore                  head(4703);
  {
    nn::NoGradGuard guard;
    model.Forward(head, nn::zeros({1, 784}));
  }
  nn::OptimizerConfig config;
  config.kind = nn::OptimizerKind::Adam;
  nn::Optimizer optimizer(head, .003, config);
  auto          predict = [&](const nn::Tensor& image) {
    nn::NoGradGuard guard;
    const auto      o = model.Forward(head, image.reshape({image.size(0), 784}));
    return std::vector<nn::Tensor>{
        o.code.contiguous(),
        o.features.contiguous(),
        o.logits.contiguous(),
        o.probability.contiguous()};
  };
  auto arrays = [&]() {
    nn::NamedTensors values{
        {"encoder/W", model.encoder_weight()}, {"encoder/b", model.encoder_bias()}};
    for (const auto& name : head.names())
      values.emplace_back("head/" + name, head.at(name).detach().clone());
    return values;
  };
  auto gradient = [&](const nn::Tensor& image, const nn::Tensor& labels) {
    return nn::grad(
        model.Forward(head, image.reshape({image.size(0), 784}), labels).loss, head.parameters());
  };
  if (head.count() != 330 || head.size() != 2)
    return -1;
  const auto frozen_w = model.encoder_weight(), frozen_b = model.encoder_bias();
  nn::save_npz((root / "initial_arrays.npz").string(), arrays());
  nn::NamedTensors data{{"feature_center", center}, {"feature_scale", scale}};
  for (int k = 0; k < 3; ++k) {
    const std::string split = k == 0 ? "fit" : k == 1 ? "validation" : "test";
    data.emplace_back(split + "_images", pools[k].images);
    data.emplace_back(split + "_labels", pools[k].labels);
    data.emplace_back(split + "_source_ids", pools[k].source);
  }
  nn::save_npz((root / "data.npz").string(), data);
  nn::BatchOrder order(1000, 32, 4721);
  std::ofstream  history(root / "history.tsv"), batches(root / "batches.tsv");
  history.precision(17);
  history << "epoch\tfit_nll\tfit_accuracy\tvalidation_nll\tvalidation_accuracy\n";
  batches << "epoch\tstep\trow\tsource_id\n";
  const auto fit_source = pools[0].source.to_vector<int>();
  const auto best_path  = (root / "best.npz").string();
  double     best       = std::numeric_limits<double>::infinity();
  int        selected = 0, steps = 0;
  const auto started = std::chrono::steady_clock::now();
  for (int epoch = 1; epoch <= epochs; ++epoch) {
    order.begin_epoch();
    int seen = 0;
    for (;;) {
      auto rows = order.next();
      if (rows.empty())
        break;
      auto x = nn::take_rows(pools[0].images, rows), y = nn::take_rows(pools[0].labels, rows);
      if (!steps) {
        nn::save_npz((root / "first_batch.npz").string(), {{"images", x}, {"labels", y}});
        auto f = predict(x);
        nn::save_npz(
            (root / "first_forward.npz").string(),
            {{"code", f[0]}, {"features", f[1]}, {"logits", f[2]}, {"probability", f[3]}});
        auto             grad = gradient(x, y);
        std::vector<int> shifted_labels;
        for (int v : y.to_vector<int>())
          shifted_labels.push_back((v + 1) % 10);
        auto             wrong = gradient(x, nn::from_vector(shifted_labels, y.shape()));
        nn::NamedTensors gradients, wrong_gradients;
        for (std::size_t i = 0; i < grad.size(); ++i) {
          gradients.emplace_back("head/" + head.names()[i], grad[i]);
          wrong_gradients.emplace_back("head/" + head.names()[i], wrong[i]);
        }
        nn::save_npz((root / "first_gradients.npz").string(), gradients);
        nn::save_npz((root / "wrong_label_gradients.npz").string(), wrong_gradients);
      }
      optimizer.minimize(model.Forward(head, x.reshape({x.size(0), 784}), y).loss);
      if (!steps)
        nn::save_npz((root / "first_update_arrays.npz").string(), arrays());
      for (auto row : rows)
        batches << epoch << '\t' << steps << '\t' << row << '\t' << fit_source[row] << '\n';
      ++steps;
      seen += int(rows.size());
    }
    Require(seen == 1000, "allfittingimages+labelsONCEperepoch");
    Require(
        nn::equal_bits(frozen_w, model.encoder_weight()) &&
            nn::equal_bits(frozen_b, model.encoder_bias()),
        "ENCODERweightsBITEXACTthroughALLheadupdates");
    auto fit = Score(predict(pools[0].images)[3], pools[0].labels),
         val = Score(predict(pools[1].images)[3], pools[1].labels);
    history << epoch << '\t' << fit[0] << '\t' << fit[1] << '\t' << val[0] << '\t' << val[1]
            << '\n';
    nn::save_npz((root / ("epoch" + std::to_string(epoch) + "_arrays.npz")).string(), arrays());
    if (val[0] < best) {
      best     = val[0];
      selected = epoch;
      nn::save_npz(best_path, arrays()); // validation LABEL NLL selects HEAD checkpoint
    }
    std::cout << root.filename() << ",epoch" << epoch << ":fitacc=" << fit[1]
              << ",validationNLL=" << val[0] << ",valacc=" << val[1] << std::endl;
  }
  const double seconds =
      std::chrono::duration<double>(std::chrono::steady_clock::now() - started).count();
  nn::models::FrozenEncoderClassifier deployed(w, b, center, scale);
  nn::ParameterStore                  restored(4703);
  {
    nn::NoGradGuard guard;
    deployed.Forward(restored, nn::zeros({1, 784}));
  }
  const auto checkpoint = nn::load_npz(best_path);
  for (const auto& name : restored.names())
    restored.set(name, find(checkpoint, "head/" + name));
  auto deployed_predict = [&](const nn::Tensor& image) {
    nn::NoGradGuard guard;
    const auto      o = deployed.Forward(restored, image.reshape({image.size(0), 784}));
    return std::vector<nn::Tensor>{
        o.code.contiguous(),
        o.features.contiguous(),
        o.logits.contiguous(),
        o.probability.contiguous()};
  };
  auto deployed_arrays = [&]() {
    nn::NamedTensors values{
        {"encoder/W", deployed.encoder_weight()}, {"encoder/b", deployed.encoder_bias()}};
    for (const auto& name : restored.names())
      values.emplace_back("head/" + name, restored.at(name).detach().clone());
    return values;
  };
  Near(
      Score(deployed_predict(pools[1].images)[3], pools[1].labels)[0],
      best,
      1e-10,
      "restoredvalidationNLL");
  auto             before = deployed_arrays();
  nn::NamedTensors output;
  for (int k = 0; k < 3; ++k) {
    const std::string split = k == 0 ? "fit" : k == 1 ? "validation" : "test";
    auto              f     = deployed_predict(pools[k].images);
    output.emplace_back(split + "_code", f[0]);
    output.emplace_back(split + "_features", f[1]);
    output.emplace_back(split + "_logits", f[2]);
    output.emplace_back(split + "_probability", f[3]);
  }
  auto repeat = deployed_predict(pools[2].images);
  Require(
      nn::equal_bits(repeat[3], find(output, "test_probability")),
      "image-onlyheadinferenceBITEXACTrepeat");
  auto         single = deployed_predict(nn::take_rows(pools[2].images, {0}));
  const double parity = nn::max(nn::abs(single[3] - nn::take_rows(repeat[3], {0}))).item();
  Require(parity < 2e-6, "classifierSingle/batchparity");
  auto after = deployed_arrays();
  for (std::size_t i = 0; i < before.size(); ++i)
    Require(
        nn::equal_bits(before[i].second, after[i].second),
        "allclassifierinferenceweightsimmutable");
  const auto          labels           = pools[2].labels.to_vector<int>();
  const auto          predicted_tensor = nn::cast(nn::argmax(repeat[3], 1), nn::DType::Int32);
  const auto          predicted        = predicted_tensor.to_vector<int>();
  nn::ConfusionMatrix confusion(10);
  confusion.add(pools[2].labels, predicted_tensor);
  output.emplace_back("test_predicted", predicted_tensor);
  output.emplace_back("test_confusion", nn::cast(confusion.to_tensor(), nn::DType::Int32));
  nn::save_npz((root / "outputs.npz").string(), output);
  nn::save_npz((root / "model_arrays.npz").string(), after);
  auto          score = Score(repeat[3], pools[2].labels);
  std::ofstream meta(root / "metrics.json");
  meta.precision(17);
  meta << "{\"frozen_encoder_parameters\":25120,\"trained_head_parameters\":330,\"epochs\":"
       << epochs << ",\"head_updates\":" << steps << ",\"selected_epoch\":" << selected
       << ",\"test_nll\":" << score[0] << ",\"test_accuracy\":" << score[1]
       << ",\"balanced_majority_accuracy\":0.1,\"single_batch_max_error\":" << parity
       << ",\"frozen_encoder_max_change\":0,\"training_seconds\":" << seconds << "}\n";
  std::ofstream examples(root / "examples.tsv");
  examples << "true_digit\tpredicted_digit\tsource_id\n";
  const auto ids = pools[2].source.to_vector<int>();
  for (int digit = 0; digit < 10; ++digit) {
    const auto row = std::find(labels.begin(), labels.end(), digit) - labels.begin();
    examples << digit << '\t' << predicted[row] << '\t' << ids[row] << '\n';
  }
  std::print(
      "| {} | {} | {} | {:.9f} | {:.3f} |\n",
      root.filename().string(),
      steps,
      selected,
      score[0],
      score[1]);
  return seconds;
}

int main() {
  const std::filesystem::path cache = dm::datasets::data_home();
  dm::datasets::prepare_example_data("mnist-assets", cache.string());
  const auto pools      = nn::models::LoadSaliency(cache / "saliency");
  const auto pretrained = nn::load_npz("build/pretraining_selected_encoder.npz"),
             random     = nn::load_npz("build/pretraining_initial_encoder.npz");
  std::print(
      "| encoder | head updates | selected epoch | held-out NLL | accuracy "
      "|\n|---|---:|---:|---:|---:|\n");
  Run(pools, pretrained, "build/pretraining/pretrained", 3, {});
  Run(pools, random, "build/pretraining/random", 3, {});
  std::filesystem::copy_file(
      cache / "saliency/manifest.json", "build/pretraining/data_manifest.json",
      std::filesystem::copy_options::overwrite_existing);
  const auto a = nn::load_npz("build/pretraining/pretrained/initial_arrays.npz"),
             b = nn::load_npz("build/pretraining/random/initial_arrays.npz");
  for (std::size_t j = 2; j < a.size(); ++j)
    Require(
        a[j].first == b[j].first && nn::equal_bits(a[j].second, b[j].second),
        "matched initial heads");
}
```
