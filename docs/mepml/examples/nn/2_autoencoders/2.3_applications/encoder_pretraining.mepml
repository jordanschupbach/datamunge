The pretrained branch selects epoch 3 and scores 0.62 accuracy / 1.286701 NLL on the 200 test
images. The random branch also selects epoch 3 and scores 0.44 / 1.628766. Balanced constant-class
accuracy is 0.10. The observed difference is 18 percentage points for this seed and budget;
there are no repeated seeds, uncertainty estimates or matched-total-compute claim.

> Every eligible checkpoint stays visible

```{cpp, results="markdown", file="figures/pretraining_nll.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <fstream>
int main() {
  std::filesystem::create_directories("build");
  auto plot   = dm::graphics::RPlot::create();
  int  branch = 0;
  for (const std::string name : {"pretrained", "random"}) {
    std::ifstream input("build/pretraining/" + name + "/history.tsv");
    std::string   line;
    std::getline(input, line);
    std::vector<double> epochs, fit, validation;
    double              e, fn, fa, vn, va;
    while (input >> e >> fn >> fa >> vn >> va) {
      epochs.push_back(e);
      fit.push_back(fn);
      validation.push_back(vn);
    }
    if (epochs.size() != 3)
      return 1;
    const dm::graphics::RGB color =
        branch++ == 0 ? dm::graphics::RGB{37, 99, 235} : dm::graphics::RGB{220, 38, 38};
    plot.lines(epochs, validation, name + " validation", color, 2.);
  }
  plot.x_label("Head epoch")
      .y_label("Mean saved-probability NLL")
      .title("All three validation candidates; NLL selects the head")
      .save_svg("build/pretraining_nll.svg");
}
```
