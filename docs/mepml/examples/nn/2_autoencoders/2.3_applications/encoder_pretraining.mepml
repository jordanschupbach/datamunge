```{cpp, results="markdown", file="figures/pretraining_examples.png", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
  namespace n = dm::nn;
  std::map<std::string, n::Tensor> data, a, b;
  for (const auto& [name, value] : n::load_npz("build/pretraining/pretrained/data.npz"))
    data.emplace(name, value);
  for (const auto& [name, value] : n::load_npz("build/pretraining/pretrained/outputs.npz"))
    a.emplace(name, value);
  for (const auto& [name, value] : n::load_npz("build/pretraining/random/outputs.npz"))
    b.emplace(name, value);
  const auto labels = data.at("test_labels").to_vector<int>(),
             ids    = data.at("test_source_ids").to_vector<int>();
  const auto p      = a.at("test_predicted").to_vector<int>(),
             r      = b.at("test_predicted").to_vector<int>();
  std::vector<std::int64_t> rows;
  std::print("| truth | source ID | pretrained | random |\n|---:|---:|---:|---:|\n");
  for (int c = 0; c < 10; ++c) {
    const auto i = std::find(labels.begin(), labels.end(), c) - labels.begin();
    if (i == 200)
      return 1;
    rows.push_back(i);
    std::print("| {} | {} | {} | {} |\n", c, ids[i], p[i], r[i]);
  }
  n::save_image_grid(
      n::take_rows(data.at("test_images"), rows),
      "build/pretraining_examples.png",
      10,
      0,
      1,
      2,
      0,
      3);
}
