> A population scale you can check by hand

Take fitting codes [[1,5],[2,5],[4,5]]. The first coordinate has mean 7/3 and population
variance 14/9; its scale is sqrt(14)/3. The second coordinate has mean 5 and zero variance,
so its scale is floored at 1e-6. The implementation accumulates both passes in row-order double
precision and casts to the code dtype once at the end. A held-out code never refits these values.
Frozen weights stop encoder derivatives, while derivatives through the image and head stay live.

```{cpp, results="markdown", file="figures/pretraining_scaling.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
  namespace n    = dm::nn;
  const auto t   = n::DType::Float64;
  const auto fit = n::models::FitTransferScaling(n::tensor({1., 5., 2., 5., 4., 5.}, {3, 2}, t));
  const auto standardized =
      (n::tensor({1., 5., 2., 5., 4., 5.}, {3, 2}, t) - fit.center) / fit.scale;
  std::print("| coordinate | mean | scale |\n|---:|---:|---:|\n");
  for (int j = 0; j < 2; ++j)
    std::print("| {} | {:.9f} | {:.9f} |\n", j, fit.center.at({j}), fit.scale.at({j}));
  auto x = n::full({1, 3}, .4, t).requires_grad_(), w = n::full({3, 2}, .5, t).requires_grad_(),
       b          = n::full({2}, .2, t).requires_grad_();
  auto       code = n::models::FrozenEncoderFeatures(x, w, b);
  const auto g    = n::grad(n::sum(code) + 0 * n::sum(w) + 0 * n::sum(b), {x, w, b});
  if (g[0].to_vector<double>() != std::vector<double>(3, 1) || n::sum(n::abs(g[1])).item() != 0 ||
      n::sum(n::abs(g[2])).item() != 0)
    return 1;
  auto plot = dm::graphics::RPlot::create();
  plot.points(
          {1, 2, 3},
          n::select(standardized, 1, 0).to_vector<double>(),
          "First coordinate",
          {37, 99, 235},
          4.)
      .points(
          {1, 2, 3},
          n::select(standardized, 1, 1).to_vector<double>(),
          "Constant coordinate",
          {220, 38, 38},
          4.)
      .x_label("Fitting row")
      .y_label("Standardized value")
      .title("Population scaling from fitting codes only")
      .save_svg("build/pretraining_scaling.svg");
  std::print("\nInput gradient [1,1,1]; supplied encoder weight and bias gradients are zero.\n");
}
```
