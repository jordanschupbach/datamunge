\alttext(A sigmoid probability curve and a straight endpoint-crossfade line over interpolation level zero to one.)

> A class-mean edit is supervised posthoc arithmetic

For fitting codes [-1,0],[1,0] in class 0 and [1,1],[3,1] in class 1, the class means
are [0,0] and [2,1]. Their difference is [2,1]. Editing source [-1,0] with scales
[-1,0,0.5,1,2] gives [-3,-1],[-1,0],[0,0.5],[1,1],[3,2]. The operation does not
learn a transformation or constrain an extrapolated code. Native centroids sum each coordinate
in row-order double precision, divide by its class count, then cast once to the code dtype.
The result is detached; every configured class must have fitting rows.

```{cpp, results="markdown", file="figures/latent_toy_direction.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
  namespace n          = dm::nn;
  const auto type      = n::DType::Float64;
  const auto fit       = n::tensor({-1., 0., 1., 0., 1., 1., 3., 1.}, {4, 2}, type),
             labels    = n::from_vector(std::vector<int>{0, 0, 1, 1});
  const auto means     = n::models::LatentClassMeans(fit, labels, 2);
  const auto direction = n::take_rows(means, {1}) - n::take_rows(means, {0});
  const auto edited    = n::models::LatentFlatten(
      n::models::LatentDirection(
          n::take_rows(fit, {0}), direction, n::tensor({-1., 0., .5, 1., 2.}, {5}, type)));
  std::print(
      "Direction [{:.0f},{:.0f}]; negative and extrapolated codes are retained.\n",
      direction.at({0, 0}),
      direction.at({0, 1}));
  auto plot = dm::graphics::RPlot::create();
  plot.points({-1, 1}, {0, 0}, "Fitting class 0", {37, 99, 235}, 4.)
      .points({1, 3}, {1, 1}, "Fitting class 1", {220, 38, 38}, 4.)
      .lines(
          n::select(edited, 1, 0).to_vector<double>(),
          n::select(edited, 1, 1).to_vector<double>(),
          "Chosen source + scale * direction",
          {22, 163, 74},
          2.)
      .points({0, 2}, {0, 1}, "Fitting class means", {15, 23, 42}, 5.)
      .x_label("Code coordinate 0")
      .y_label("Code coordinate 1")
      .title("Label-centroid direction: explicit construction, no fitting loop")
      .save_svg("build/latent_toy_direction.svg");
}
```
