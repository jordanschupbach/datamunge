  namespace n = dm::nn;
  std::map<std::string, n::Tensor> arrays;
  for (const auto& [key, value] : n::load_npz("build/latent/analysis.npz"))
    arrays.emplace(key, value);
  const auto values = arrays.at("interpolated_images"),
             images = n::tile(values.reshape({values.size(0), 28, 28, 1}), {1, 1, 1, 3});
  n::save_image_grid(images, "build/latent_latent_interpolations.png", 11, 0, 1, 4, 220. / 255., 3);
  std::filesystem::copy_file(
      "build/latent_latent_interpolations.png",
      "build/latent/latent_interpolations.png",
      std::filesystem::copy_options::overwrite_existing);
}
