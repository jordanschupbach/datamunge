> Reproduce the frozen model before the application

Native MNIST preparation provides 1,000 fitting, 200 validation and 200 held-out test images,
balanced across ten digits with disjoint original IDs. Test IDs come from the official test split.
The complete prerequisite below shows all three epochs / 96 Adam updates, with validation
reconstruction MSE selecting the checkpoint. Classification labels do not enter that fitting loss.
Its initial and selected arrays reproduce the original prerequisite parameters exactly. Nothing
is downloaded or trained by an external Python script, and no manually placed model is required.
The latent-path application that follows adds zero optimizer updates.

```{cpp, results="markdown", file="figures/latent_prerequisite.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
  namespace n = dm::nn;
  std::filesystem::create_directories("build");
  const std::filesystem::path cache = dm::datasets::data_home();
  dm::datasets::prepare_example_data("mnist-assets", cache.string());
  const auto        pools      = n::models::LoadSaliency(cache / "saliency");
  const auto        fit        = pools[0].images.reshape({1000, 784});
  const auto        validation = pools[1].images.reshape({200, 784});
  const auto        test       = pools[2].images.reshape({200, 784});
  n::ParameterStore p(1471);
  {
    n::NoGradGuard guard;
    n::models::UndercompleteAutoencoder(p, n::zeros({1, 784}));
  }
  p.save("build/latent_initial_encoder.npz");
  const auto initial_test = n::models::UndercompleteAutoencoder(p, test).reconstruction.detach();
  const auto pixel_mean   = n::mean(fit, {0}, true);
  n::OptimizerConfig config;
  config.kind = n::OptimizerKind::Adam;
  n::Optimizer  optimizer(p, .003, config);
  n::BatchOrder batches(1000, 32, 1483);
  const auto    probe           = n::take_rows(fit, {0, 1});
  const auto    first_gradients = n::grad(
      n::mse(n::models::UndercompleteAutoencoder(p, probe).reconstruction, probe), p.parameters());
  std::print("| parameter | initial gradient L2 norm |\n|---|---:|\n");
  for (std::size_t i = 0; i < first_gradients.size(); ++i) {
    const double norm = n::sqrt(n::sum(n::square(first_gradients[i]))).item();
    if (!std::isfinite(norm) || norm <= 0)
      return 1;
    std::print("| {} | {:.7f} |\n", p.names()[i], norm);
  }
  double              best     = std::numeric_limits<double>::infinity();
  int                 selected = 0;
  std::vector<double> epochs, training, valid;
  std::print("\n| epoch | fitting pre-update MSE | validation MSE |\n|---:|---:|---:|\n");
  for (int epoch = 1; epoch <= 3; ++epoch) {
    batches.begin_epoch();
    double      total = 0;
    std::size_t seen  = 0;
    for (;;) {
      const auto rows = batches.next();
      if (rows.empty())
        break;
      const auto   input     = n::take_rows(fit, rows);
      const auto   output    = n::models::UndercompleteAutoencoder(p, input);
      const auto   objective = n::mse(output.reconstruction, input);
      const double value     = objective.item();
      if (!std::isfinite(value))
        return 1;
      total += value * rows.size();
      seen += rows.size();
      optimizer.minimize(objective);
    }
    n::NoGradGuard guard;
    const double   score =
        n::mse(n::models::UndercompleteAutoencoder(p, validation).reconstruction, validation)
            .item();
    if (seen != 1000 || !std::isfinite(score))
      return 1;
    if (score < best) {
      best     = score;
      selected = epoch;
      p.save("build/latent_selected_encoder.npz");
    }
    epochs.push_back(epoch);
    training.push_back(total / seen);
    valid.push_back(score);
    std::print("| {} | {:.9f} | {:.9f} |\n", epoch, total / seen, score);
  }
  p.load("build/latent_selected_encoder.npz");
  n::NoGradGuard guard;
  const auto     output    = n::models::UndercompleteAutoencoder(p, test);
  const auto     zero_code = n::broadcast_to(n::sigmoid(p.at("decoder/b")), test.shape());
  std::vector<std::int64_t> shifted;
  for (int i = 0; i < 200; ++i)
    shifted.push_back((i + 1) % 200);
  const auto shuffled = n::sigmoid(
      n::matmul(n::take_rows(output.code, shifted), p.at("decoder/W")) + p.at("decoder/b"));
  const std::vector<std::pair<std::string, n::Tensor>> predictions{
      {"initial network", initial_test},
      {"black", n::zeros_like(test)},
      {"fitting pixel mean", n::broadcast_to(pixel_mean, test.shape())},
      {"selected autoencoder", output.reconstruction},
      {"zero code", zero_code},
      {"cyclically shuffled codes", shuffled}};
  std::print(
      "\nSelected epoch: {}. Validation MSE: {:.9f}.\n\n| held-out predictor | MSE over 200 images "
      "|\n|---|---:|\n",
      selected,
      best);
  for (const auto& [name, prediction] : predictions)
    std::print("| {} | {:.9f} |\n", name, n::mse(prediction, test).item());
  n::save_npz(
      "build/latent_prerequisite_results.npz",
      {{"test_input", test},
       {"test_reconstruction", output.reconstruction},
       {"test_code", output.code},
       {"test_labels", pools[2].labels},
       {"test_ids", pools[2].source},
       {"fit_ids", pools[0].source},
       {"validation_ids", pools[1].source},
       {"pixel_mean", pixel_mean},
       {"initial_test", initial_test},
       {"shuffled_test", shuffled}});
  auto plot = dm::graphics::RPlot::create();
  plot.lines(epochs, training, "Fitting, pre-update", {37, 99, 235}, 2.)
      .lines(epochs, valid, "Validation, post-epoch", {220, 38, 38}, 2.)
      .x_label("epoch")
      .y_label("mean squared pixel error")
      .title("Three epochs of Adam, learning rate 0.003")
      .save_svg("build/latent_prerequisite.svg");
}
```
