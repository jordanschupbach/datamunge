> Original statically thresholded MNIST

Native preparation acquires checked original MNIST and supplies balanced1,000 fitting,
200 validation and200 official test records. LoadSaliency validates byte/metadata geometry,
unique images, disjoint source IDs, digit range and100/20/20 observations per digit. Fitting
and validation IDs refer to original0–59,999; official test IDs are offset to60,000–69,999.
Manifest provenance retains the independent seeded row selection. Normalized Float32 pixels
are thresholded at0.5, equivalent to original uint8≥128. Both original and binary images are
saved. This is fixed thresholding, not the official binarized-MNIST benchmark or random
per-epoch binarization. Digits label the gallery only; they never enter this VAE or select it.

```{cpp, results="markdown", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
  namespace n = dm::nn;
  std::filesystem::create_directories("build/conv_vae");
  const std::filesystem::path cache = dm::datasets::data_home();
  dm::datasets::prepare_example_data("mnist-assets", cache.string());
  const auto      pools = n::models::LoadSaliency(cache / "saliency");
  n::NamedTensors saved;
  for (int k = 0; k < 3; ++k) {
    const std::string split = k == 0 ? "fit" : k == 1 ? "validation" : "test";
    saved.emplace_back(split + "_original_images", pools[k].images);
    saved.emplace_back(
        split + "_images", n::cast(n::greater_equal(pools[k].images, .5), n::DType::Float32));
    saved.emplace_back(split + "_source_ids", pools[k].source);
  }
  saved.emplace_back("test_labels", pools[2].labels);
  n::save_npz("build/conv_vae/data.npz", saved);
  std::filesystem::copy_file(
      cache / "saliency/manifest.json",
      "build/conv_vae/data_manifest.json",
      std::filesystem::copy_options::overwrite_existing);
  std::print(
      "| split | binary grayscale images | each digit "
      "|\n|---|---:|---:|\n|fit|1000|100|\n|validation|200|20|\n|official test|200|20|\n");
}
