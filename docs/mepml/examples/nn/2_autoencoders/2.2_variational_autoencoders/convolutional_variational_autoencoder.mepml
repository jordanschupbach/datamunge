      .node("e", {6, 0}, "Conv / mean pool twice\n7 ×7 ×4 → Gaussian heads")
      .node("z", {12, 0}, "Explicit two-coordinate sample\nz = mu + exp(l/2) * epsilon")
      .node("g", {18, 0}, "Sample-only decoder\nProject / repeat / conv twice")
      .node("eps", {12, -3}, "Supplied epsilon ~ N(0,I)\nNo RNG inside the model")
      .node("kl", {6, -4}, "Analytic Gaussian KL\nFixed N(0,I) prior")
