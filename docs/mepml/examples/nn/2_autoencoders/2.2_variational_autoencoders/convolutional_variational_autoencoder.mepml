> Ninety-six visible Adam updates and fixed four-draw validation

Seed2011 initializes the seven learned layers in their stated order. Adam uses learning
rate0.003, moments0.9/0.999 and epsilon1e-8. BatchOrder(1000,32,2017) visits each fitting
row once per epoch:31 full batches and a final batch of8,32 updates/epoch,96 over three.
One fresh Gaussian draw per fitting record uses seeds2028/2029/2030. Four fixed draws use
fit2063, validation2039 and test2053. MT19937/Box–Muller Float64 draws and their Float32
casts are archived; the forward samples from neither a global nor a hidden RNG.

Each batch explicitly constructs its forward, requests all14 parameter gradients and calls
the optimizer. Initial/first-gradient/first-update/all-epoch/selected arrays are saved. Only
completed epochs1–3 are candidates. Fixed four-draw validation NLL averages per-image summed
Bernoulli terms over draws and images; analytic KL is counted once per image. Float64 metric
accumulation iterates draw then image over Float32 per-row values, matching the original.
Validation NLL+KL selects all14 leaves together; epoch-zero test score is a control only.
An independent selected-state gradient review on two test images is saved **after** selection,
without updating anything; it is a diagnostic, not another training/selection phase.

```{cpp, results="markdown", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <chrono>
#include <dm/dm.hpp>
#include <fstream>
namespace nn = dm::nn;
struct NoiseBank {
  nn::Tensor standard, epsilon;
};
void Require(bool ok, const std::string& why) {
  if (!ok)
    throw std::runtime_error(why);
}
void Near(double a, double b, double tolerance, const std::string& why) {
  Require(std::abs(a - b) <= tolerance, why);
}
nn::Tensor Flatten(const nn::Tensor& t) {
  return nn::reshape(t, {t.size(0), 784});
}
nn::Tensor Find(const nn::NamedTensors& a, const std::string& key) {
  for (const auto& [k, v] : a)
    if (k == key)
      return v;
  throw std::runtime_error(key);
}
std::vector<float> Bytes(const nn::Tensor& t) {
  return t.contiguous().to_vector<float>();
}
auto Snapshot(const nn::ParameterStore& p) {
  return p.flatten();
}
nn::NamedTensors Arrays(const nn::ParameterStore& p) {
  nn::NamedTensors a;
  for (const auto& k : p.names())
    a.emplace_back(k, p.at(k).detach().clone());
  return a;
}
nn::NamedTensors CheckGradients(
    const nn::ParameterStore&      p,
    const std::vector<nn::Tensor>& gs,
    const std::string&,
    const std::string&) {
  nn::NamedTensors a;
  Require(gs.size() == p.size(), "all10 gradients");
  const auto names = p.names();
  for (std::size_t i = 0; i < gs.size(); ++i) {
    double norm = 0;
    for (double x : gs[i].to_vector<double>()) {
      Require(std::isfinite(x), "finite derivative");
      norm += x * x;
    }
    Require(norm > 0, "nonzero derivative in each tensor");
    a.emplace_back(names[i], gs[i]);
  }
  return a;
}
NoiseBank VaeNoise(std::int64_t n, std::int64_t samples, std::uint32_t seed) {
  const auto s = nn::models::GaussianNoise({n, 2}, samples, seed);
  return {s, nn::cast(s, nn::DType::Float32)};
}
nn::Tensor VaeNoiseAt(const NoiseBank& bank, int k) {
  return nn::select(bank.epsilon, 0, k).contiguous();
}

std::vector<nn::Tensor>
Evaluate(nn::ParameterStore& p, const nn::Tensor& images, const nn::Tensor& epsilon) {
  nn::NoGradGuard guard;
  const auto      o = nn::models::ConvolutionalVariationalAutoencoder(p, images, epsilon);
  return {o.mu, o.log_variance, o.z, o.probability, o.reconstruction_nll, o.kl, o.loss};
}
nn::Tensor Decode(nn::ParameterStore& p, const nn::Tensor& z) {
  nn::NoGradGuard guard;
  return nn::models::ConvolutionalVaeDecode(p, z).probability;
}
std::vector<nn::Tensor>
Stages(nn::ParameterStore& p, const nn::Tensor& images, const nn::Tensor& epsilon) {
  nn::NoGradGuard guard;
  const auto      o = nn::models::ConvolutionalVariationalAutoencoder(p, images, epsilon);
  return {o.conv1, o.pool1, o.conv2, o.pool2, o.decoder_base, o.decoder1, o.spatial_logits};
}
std::array<double, 3>
ConvolutionalVaeScore(nn::ParameterStore& p, const nn::Tensor& images, const NoiseBank& bank) {
  double     reconstruction = 0, kl = 0;
  const auto n = images.size(0), samples = bank.epsilon.size(0);
  for (int k = 0; k < samples; ++k) {
    const auto o   = Evaluate(p, images, VaeNoiseAt(bank, k));
    const auto nll = o[4].to_vector<float>(), kls = o[5].to_vector<float>();
    for (int b = 0; b < n; ++b) {
      reconstruction += nll[b];
      if (k == 0)
        kl += kls[b];
    }
  }
  reconstruction /= double(n * samples);
  kl /= double(n);
  return {reconstruction, kl, reconstruction + kl};
}
double MaxAbsDiff(const nn::Tensor& a, const nn::Tensor& b, int n) {
  const auto x = Bytes(a), y = Bytes(b);
  double     d = 0;
  for (int i = 0; i < n; ++i)
    d = std::max(d, std::abs(double(x[i]) - y[i]));
  return d;
}
double Mse(const nn::Tensor& a, const nn::Tensor& b) {
  return nn::mean(
             nn::square(
                 nn::cast(Flatten(a), nn::DType::Float64) -
                 nn::cast(Flatten(b), nn::DType::Float64)))
      .item();
}

struct Pool {
  nn::Tensor images, source;
};
int main() {
  const std::filesystem::path root   = "build/conv_vae";
  const int                   epochs = 3;
  const auto                  data   = nn::load_npz((root / "data.npz").string());
  std::vector<Pool>           pools;
  for (const std::string split : {"fit", "validation", "test"})
    pools.push_back({Find(data, split + "_images"), Find(data, split + "_source_ids")});
  auto val_noise = VaeNoise(200, 4, 2039), test_noise = VaeNoise(200, 4, 2053),
       fit_noise = VaeNoise(1000, 4, 2063);
  nn::save_npz(
      (root / "fixed_noise.npz").string(),
      {{"validation_standard", val_noise.standard},
       {"validation_epsilon", val_noise.epsilon},
       {"test_standard", test_noise.standard},
       {"test_epsilon", test_noise.epsilon},
       {"fit_standard", fit_noise.standard},
       {"fit_epsilon", fit_noise.epsilon}});
  nn::ParameterStore model(2011);
  {
    nn::NoGradGuard guard;
    nn::models::ConvolutionalVariationalAutoencoder(
        model, nn::zeros({1, 28, 28, 1}), nn::zeros({1, 2}));
  }
  nn::OptimizerConfig config;
  config.kind = nn::OptimizerKind::Adam;
  nn::Optimizer optimizer(model, .003, config);
  Require(model.size() == 14 && model.count() == 2117, "twohead diagonalGaussian parameter census");
  nn::save_npz((root / "initial_arrays.npz").string(), Arrays(model));
  auto           initial = ConvolutionalVaeScore(model, pools[2].images, test_noise);
  nn::BatchOrder order(1000, 32, 2017);
  std::ofstream  history(root / "history.tsv"), batches(root / "batches.tsv");
  history.precision(17);
  history << "epoch\tfit_preupdate_negative_elbo\tvalidation_reconstruction_nll\tvalidation_"
             "kl\tvalidation_"
             "negative_elbo\n";
  batches << "epoch\tstep\trow\tsource_id\n";
  const auto fit_source = pools[0].source.to_vector<int>();
  const auto best_path  = (root / "best.npz").string();
  double     best       = std::numeric_limits<double>::infinity();
  int        selected = 0, step = 0;
  const auto started = std::chrono::steady_clock::now();
  for (int epoch = 1; epoch <= epochs; ++epoch) {
    auto noise = VaeNoise(1000, 1, 2027 + epoch);
    nn::save_npz(
        (root / ("train_noise_epoch" + std::to_string(epoch) + ".npz")).string(),
        {{"standard", noise.standard}, {"epsilon", noise.epsilon}});
    auto epsilon = VaeNoiseAt(noise, 0);
    order.begin_epoch();
    double sum  = 0;
    int    seen = 0;
    for (;;) {
      auto rows = order.next();
      if (rows.empty())
        break;
      auto input = nn::take_rows(pools[0].images, rows), e = nn::take_rows(epsilon, rows);
      if (step == 0) {
        auto g = CheckGradients(
            model,
            nn::grad(
                nn::models::ConvolutionalVariationalAutoencoder(model, input, e).loss,
                model.parameters()),
            "all posterior/decoder negativeELBO derivatives finite",
            "ALL14posterior/decoder tensors receive gradients");
        nn::save_npz((root / "first_gradients.npz").string(), g);
        nn::save_npz((root / "first_batch.npz").string(), {{"images", input}, {"epsilon", e}});
      }
      const auto out = nn::models::ConvolutionalVariationalAutoencoder(model, input, e);
      sum += double(rows.size()) * out.loss.item<float>();
      const auto gradients = nn::grad(out.loss, model.parameters());
      optimizer.step(gradients);
      seen += int(rows.size());
      for (auto row : rows)
        batches << epoch << '\t' << step << '\t' << row << '\t' << fit_source[row] << '\n';
      if (step == 0)
        nn::save_npz((root / "first_update_arrays.npz").string(), Arrays(model));
      ++step;
    }
    Require(seen == 1000, "allfittingrecords once per epoch");
    auto score = ConvolutionalVaeScore(model, pools[1].images, val_noise);
    history << epoch << '\t' << sum / seen << '\t' << score[0] << '\t' << score[1] << '\t'
            << score[2] << '\n';
    nn::save_npz(
        (root / ("epoch" + std::to_string(epoch) + "_arrays.npz")).string(), Arrays(model));
    if (score[2] < best) {
      best     = score[2];
      selected = epoch;
      model.save(best_path); // fixed FOUR-sample validation negative ELBO selects epoch
    }
    std::cout << "VAE epoch" << epoch << ":validation NLL=" << score[0] << ",KL=" << score[1]
              << ",negativeELBO=" << score[2] << std::endl;
  }
  const double seconds =
      std::chrono::duration<double>(std::chrono::steady_clock::now() - started).count();
  nn::ParameterStore deployed(2011);
  {
    nn::NoGradGuard guard;
    nn::models::ConvolutionalVariationalAutoencoder(
        deployed, nn::zeros({1, 28, 28, 1}), nn::zeros({1, 2}));
  }
  deployed.load(best_path);
  const auto before = Snapshot(deployed);
  Near(
      ConvolutionalVaeScore(deployed, pools[1].images, val_noise)[2],
      best,
      1e-8,
      "fresh selected MC validation objective");
  nn::NamedTensors       output;
  std::vector<NoiseBank> banks{fit_noise, val_noise, test_noise};
  for (int split = 0; split < 3; ++split) {
    const std::string  name = split == 0 ? "fit" : split == 1 ? "validation" : "test";
    const std::int64_t n    = pools[split].images.size(0);
    auto               mean = Evaluate(deployed, pools[split].images, nn::zeros({n, 2}));
    Require(Bytes(mean[2]) == Bytes(mean[0]), "epsilon0 means z=mu EXACT");
    std::vector<nn::Tensor> sample_z, prediction, nll;
    for (int k = 0; k < 4; ++k) {
      auto draw = Evaluate(deployed, pools[split].images, VaeNoiseAt(banks[split], k));
      Require(
          Bytes(draw[0]) == Bytes(mean[0]) && Bytes(draw[1]) == Bytes(mean[1]),
          "epsilon changes samples not posterior parameters");
      sample_z.push_back(draw[2]);
      prediction.push_back(draw[3]);
      nll.push_back(draw[4]);
    }
    output.emplace_back(name + "_mu", mean[0]);
    output.emplace_back(name + "_log_variance", mean[1]);
    output.emplace_back(name + "_mean_reconstruction", mean[3]);
    output.emplace_back(name + "_kl", mean[5]);
    output.emplace_back(name + "_sample_z", nn::stack(sample_z, 0));
    output.emplace_back(name + "_sample_prediction", nn::stack(prediction, 0));
    output.emplace_back(name + "_sample_nll", nn::stack(nll, 0));
  }
  const std::vector<std::int64_t> eight{0, 1, 2, 3, 4, 5, 6, 7};
  auto                            probe_images = nn::take_rows(pools[2].images, eight),
       probe_epsilon                           = nn::take_rows(VaeNoiseAt(test_noise, 0), eight);
  auto                         stages          = Stages(deployed, probe_images, probe_epsilon);
  const std::vector<nn::Shape> shapes{
      {8, 28, 28, 8},
      {8, 14, 14, 8},
      {8, 14, 14, 4},
      {8, 7, 7, 4},
      {8, 7, 7, 4},
      {8, 14, 14, 8},
      {8, 28, 28, 1}};
  nn::NamedTensors stage_arrays{{"images", probe_images}, {"epsilon", probe_epsilon}};
  for (std::size_t i = 0; i < stages.size(); ++i) {
    Require(
        stages[i].shape() == shapes[i],
        "all seven actual convolution/pool/repeat decoder stage shapes");
    stage_arrays.emplace_back("stage" + std::to_string(i), stages[i]);
  }
  nn::save_npz((root / "stages.npz").string(), stage_arrays);
  nn::ParameterStore gradient_probe(2011);
  {
    nn::NoGradGuard guard;
    nn::models::ConvolutionalVariationalAutoencoder(
        gradient_probe, nn::zeros({1, 28, 28, 1}), nn::zeros({1, 2}));
  }
  gradient_probe.load(best_path); // independent selected-gradient review restore
  auto gradient_images   = nn::take_rows(pools[2].images, {0, 1}),
       gradient_epsilon  = nn::take_rows(VaeNoiseAt(test_noise, 0), {0, 1});
  auto selected_gradient = nn::grad(
      nn::models::ConvolutionalVariationalAutoencoder(
          gradient_probe, gradient_images, gradient_epsilon)
          .loss,
      gradient_probe.parameters());
  nn::NamedTensors gradient_arrays;
  for (std::size_t i = 0; i < selected_gradient.size(); ++i)
    gradient_arrays.emplace_back(gradient_probe.names()[i], selected_gradient[i]);
  nn::save_npz((root / "selected_gradients.npz").string(), gradient_arrays);
  nn::save_npz(
      (root / "selected_gradient_batch.npz").string(),
      {{"images", gradient_images}, {"epsilon", gradient_epsilon}});
  auto test   = Evaluate(deployed, pools[2].images, VaeNoiseAt(test_noise, 0)),
       repeat = Evaluate(deployed, pools[2].images, VaeNoiseAt(test_noise, 0));
  Require(
      Bytes(test[2]) == Bytes(repeat[2]) && Bytes(test[3]) == Bytes(repeat[3]) &&
          Bytes(Decode(deployed, test[2])) == Bytes(test[3]),
      "fixed epsilon repeatability and target-free exact sampled decode");
  auto other = Evaluate(deployed, pools[2].images, VaeNoiseAt(test_noise, 1));
  Require(
      Bytes(test[2]) != Bytes(other[2]) && Bytes(test[3]) != Bytes(other[3]),
      "second epsilon changes latent samples AND decoder probabilities");
  auto single = Evaluate(
      deployed, nn::take_rows(pools[2].images, {0}), nn::take_rows(VaeNoiseAt(test_noise, 0), {0}));
  const double parity = MaxAbsDiff(single[3], test[3], 784);
  Require(parity < 2e-6, "posterior single/batch parity");
  auto zero_latent = Decode(deployed, nn::zeros({200, 2}));
  output.emplace_back("zero_latent_prediction", zero_latent);
  auto               prior_noise = VaeNoise(20, 1, 2069);
  auto               prior_z = VaeNoiseAt(prior_noise, 0), prior = Decode(deployed, prior_z);
  std::vector<float> gz(162);
  for (int row = 0; row < 9; ++row)
    for (int col = 0; col < 9; ++col) {
      gz[(row * 9 + col) * 2]     = -2.f + .5f * col;
      gz[(row * 9 + col) * 2 + 1] = 2.f - .5f * row;
    }
  auto grid_z = nn::from_vector(gz, {81, 2});
  auto grid   = Decode(deployed, grid_z);
  nn::save_npz(
      (root / "prior.npz").string(),
      {{"standard", prior_noise.standard},
       {"z", prior_z},
       {"probability", prior},
       {"grid_z", grid_z},
       {"grid_probability", grid}});
  Require(
      before == Snapshot(deployed),
      "posterior evaluation/prior generation leaves ALL14parameters immutable");
  nn::save_npz((root / "outputs.npz").string(), output);
  nn::save_npz((root / "model_arrays.npz").string(), Arrays(deployed));
  auto         score    = ConvolutionalVaeScore(deployed, pools[2].images, test_noise);
  const auto   mean_rec = Find(output, "test_mean_reconstruction");
  const double mean_mse = Mse(mean_rec, pools[2].images);

  const auto fit  = nn::cast(Flatten(pools[0].images), nn::DType::Float64),
             mean = nn::tile(nn::cast(nn::mean(fit, {0}, true), nn::DType::Float32), {200, 1});
  std::print(
      "| quantity | heldout value |\n|---|---:|\n| selected epoch |{}|\n| NLL nats/image "
      "|{:.9f}|\n| KL nats/image |{:.9f}|\n| negative ELBO |{:.9f}|\n| decode(mu) pixel MSE "
      "|{:.9f}|\n| fitting pixel mean MSE |{:.9f}|\n",
      selected,
      score[0],
      score[1],
      score[2],
      mean_mse,
      Mse(mean, pools[2].images));
  Require(step == 96 && optimizer.iterations() == 96, "original96 updates");
  Require(bool(history) && bool(batches), "complete batch/history evidence");
}
```
