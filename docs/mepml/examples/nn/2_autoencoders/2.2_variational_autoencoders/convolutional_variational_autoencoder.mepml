```{cpp, results="markdown", file="figures/conv_vae_reconstructions.png", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
  namespace n = dm::nn;
  auto load   = [](const std::string& file) {
    std::map<std::string, n::Tensor> a;
    for (const auto& [k, v] : n::load_npz("build/conv_vae/" + file + ".npz"))
      a.emplace(k, v);
    return a;
  };
  auto                      d = load("data"), o = load("outputs");
  const auto                labels = d.at("test_labels").to_vector<int>();
  std::vector<std::int64_t> rows;
  for (int c = 0; c < 10; ++c) {
    const auto found = std::find(labels.begin(), labels.end(), c);
    if (found == labels.end())
      return 1;
    rows.push_back(found - labels.begin());
  }
  const auto binary = n::reshape(d.at("test_images"), {200, 784}),
             fit    = n::reshape(d.at("fit_images"), {1000, 784}),
             mean = o.at("test_mean_reconstruction"), draw = o.at("test_sample_prediction");
  const auto baseline = n::tile(
      n::cast(n::mean(n::cast(fit, n::DType::Float64), {0}, true), n::DType::Float32), {200, 1});
  std::vector<n::Tensor> panels;
  for (const auto& t :
       {binary,
        mean,
        n::select(draw, 0, 0),
        n::select(draw, 0, 1),
        baseline,
        n::abs(mean - binary),
        o.at("zero_latent_prediction")})
    panels.push_back(n::take_rows(t, rows));
  n::save_image_grid(
      n::reshape(n::concat(panels, 0), {70, 28, 28, 1}),
      "build/conv_vae_reconstructions.png",
      10,
      0,
      1,
      4,
      220. / 255,
      3);
}
