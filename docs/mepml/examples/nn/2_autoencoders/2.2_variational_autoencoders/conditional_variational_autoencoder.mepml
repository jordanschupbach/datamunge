The gallery takes the first heldout record of each supplied digit0–9, without quality filtering.
Rows: binary input, decode(mu), posterior draw0 probabilities, draw1 probabilities, fitting-only
class mean, absolute decode(mu) error and shifted-label decode of the **same mu**. Fixed[0,1]
gray, nearest scale3, gap4; errors are not amplified. Source IDs remain available with every
label in data.npz. Short training and only two latents blur or lose details.

```{cpp, results="markdown", file="figures/cvae_reconstructions.png", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
  namespace n = dm::nn;
  auto load   = [](const std::string& file) {
    std::map<std::string, n::Tensor> a;
    for (const auto& [k, v] : n::load_npz("build/cvae/" + file + ".npz"))
      a.emplace(k, v);
    return a;
  };
  auto                      d = load("data"), o = load("outputs"), c = load("class_mean");
  std::vector<std::int64_t> rows;
  const auto                labels = d.at("test_labels").to_vector<int>();
  for (int digit = 0; digit < 10; ++digit) {
    const auto found = std::find(labels.begin(), labels.end(), digit);
    if (found == labels.end())
      return 1;
    rows.push_back(found - labels.begin());
  }
  const auto binary = n::reshape(d.at("test_images"), {200, 784}),
             mean = o.at("test_mean_reconstruction"), samples = o.at("test_sample_prediction");
  std::vector<n::Tensor> panels;
  for (const auto& t :
       {binary,
        mean,
        n::select(samples, 0, 0),
        n::select(samples, 0, 1),
        c.at("test_class_mean"),
        n::abs(mean - binary),
        o.at("wrong_label_mean_prediction")})
    panels.push_back(n::take_rows(t, rows));
  n::save_image_grid(
      n::reshape(n::concat(panels, 0), {70, 28, 28, 1}),
      "build/cvae_reconstructions.png",
      10,
      0,
      1,
      4,
      220. / 255,
      3);
}
