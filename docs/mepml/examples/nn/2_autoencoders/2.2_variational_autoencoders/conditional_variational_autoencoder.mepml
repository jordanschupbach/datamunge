> A two-class calculation with fourteen learned scalars

Take one zero pixel, one latent coordinate, one ReLU hidden unit and two classes. Set encoder
weights to[0,1,2], posterior mean weight1 and log-variance weights/biases0. Then class0
produces mu1 and class1 mu2. With the same epsilon0.5, z is1.5/2.5. Decoder weights
[1,3,5] and output weight1 produce logits4.5/7.5. Both KLs are analytic:0.5/2.
Holding code fixed at1 instead gives logits4/6, exposing the decoder-only condition effect.
All unmentioned weights/biases are zero. This deliberately high-logit toy illustrates the
conditioning mechanism, not a useful fit to the zero target.

```{cpp, results="markdown", file="figures/cvae_hand.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
  namespace n         = dm::nn;
  const auto        t = n::DType::Float64;
  n::ParameterStore p(2111, t);
  const auto        x = n::zeros({2, 1}, t), labels = n::from_vector(std::vector<int>{0, 1}, {2}),
             epsilon = n::full({2, 1}, .5, t);
  n::models::ConditionalVariationalAutoencoder(p, x, labels, epsilon, 1, 2, 1, 1);
  for (const auto& name : p.names())
    p.set(name, n::zeros(p.at(name).shape(), t));
  p.set("encoder/W", n::tensor({0., 1., 2.}, {3, 1}, t));
  p.set("mu/W", n::ones({1, 1}, t));
  p.set("decoder/W", n::tensor({1., 3., 5.}, {3, 1}, t));
  p.set("output/W", n::ones({1, 1}, t));
  const auto o = n::models::ConditionalVariationalAutoencoder(p, x, labels, epsilon, 1, 2, 1, 1);
  const auto fixed = n::models::ConditionalVaeDecode(p, n::ones({2, 1}, t), labels, 1, 2, 1, 1);
  if (p.count() != 14 || o.mu.to_vector<double>() != std::vector<double>{1, 2} ||
      o.z.to_vector<double>() != std::vector<double>{1.5, 2.5} ||
      o.logits.to_vector<double>() != std::vector<double>{4.5, 7.5} ||
      o.kl.to_vector<double>() != std::vector<double>{.5, 2} ||
      fixed.to_vector<double>() != std::vector<double>{4, 6})
    return 1;
  auto plot = dm::graphics::RPlot::create();
  plot.lines({0, 1}, o.logits.to_vector<double>(), "both paths", {220, 38, 38}, 2)
      .lines({0, 1}, fixed.to_vector<double>(), "fixed z=1", {37, 99, 235}, 2)
      .x_label("supplied class")
      .y_label("decoder logit")
      .title("Class conditioning enters two distinct paths")
      .save_svg("build/cvae_hand.svg");
  std::print(
      "| supplied class | mu | log variance | z | KL | posterior-path logit | fixed-code logit "
      "|\n|---|---:|---:|---:|---:|---:|---:|\n|0|1|0|1.5|0.5|4.5|4|\n|1|2|0|2.5|2|7.5|6|\n");
}
