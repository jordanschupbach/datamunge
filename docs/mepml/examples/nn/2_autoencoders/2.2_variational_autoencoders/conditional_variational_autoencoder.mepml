> Executed default architecture and parameter census

The default posterior concatenates784 pixels and10 class entries before64ReLU units, then
separate two-coordinate linear mean/log-variance heads. The decoder concatenates2 sampled
coordinates and the same10 class entries before64ReLU units and784 linear logits. Ten leaves
hold102,932 scalars: encoder50,880; mean130; log variance130; decoder832; output50,960.

For tracing only, a787-entry shape probe packs784 pixels, one integer-valued class slot and
two epsilon slots; it splits and casts the class back to Int32. The public API takes these as
three separate arguments. Both condition concatenations are actual executed tensor endpoints;
the graph preserves all class and noise branches. Shared linear drawing scales use a two-pixel
visibility floor, six sheets and eight sampled neurons. Parameter counts are unique, even when
the shared encoder's dependencies appear beneath both heads.

```{cpp, results="markdown", file="figures/cvae_architecture.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
  namespace n = dm::nn;
  n::ParameterStore p(2111);
  n::Module         model(
      [&](const n::Tensor& packed) {
        auto x = n::slice_axis(packed, 1, 0, 784),
             labels = n::cast(n::reshape(n::slice_axis(packed, 1, 784, 785), {1}), n::DType::Int32),
             epsilon = n::slice_axis(packed, 1, 785, 787);
        n::model_stage("Image rows", packed, x);
        n::model_stage("Required supplied class", packed, labels);
        n::model_stage("Supplied Gaussian epsilon", packed, epsilon);
        const auto o = n::models::ConditionalVariationalAutoencoder(p, x, labels, epsilon);
        n::model_stage("One-hot condition", labels, o.condition);
        n::model_stage(
            "Encoder image + condition", std::vector<n::Tensor>{x, o.condition}, o.encoder_input);
        n::model_stage("Posterior mean", o.encoder_input, o.mu);
        n::model_stage("Posterior log variance", o.encoder_input, o.log_variance);
        n::model_stage(
            "Gaussian pathwise sample", std::vector<n::Tensor>{o.mu, o.log_variance, epsilon}, o.z);
        n::model_stage(
            "Decoder sample + condition",
            std::vector<n::Tensor>{o.z, o.condition},
            o.decoder_input);
        n::model_stage("Conditional Bernoulli logits", o.decoder_input, o.logits);
        n::model_stage(
            "Summed pixel NLL", std::vector<n::Tensor>{x, o.logits}, o.reconstruction_nll);
        n::model_stage("Summed Gaussian KL", std::vector<n::Tensor>{o.mu, o.log_variance}, o.kl);
        n::model_stage("Mean NLL + KL", std::vector<n::Tensor>{o.reconstruction_nll, o.kl}, o.loss);
        return o.loss;
      },
      "Conditional VAE / supplied class in both paths");
  n::ModelPlotOptions o;
  o.style                 = n::ModelPlotStyle::Graph;
  o.detail                = n::ModelPlotDetail::Blocks;
  o.max_neurons           = 8;
  o.sizing.spatial_scale  = n::ModelPlotScale::Linear;
  o.sizing.channel_scale  = n::ModelPlotScale::Linear;
  o.sizing.minimum_extent = 2;
  o.sizing.max_planes     = 6;
  const auto figure       = model.plot(n::zeros({1, 787}), o);
  if (p.count() != 102932 || p.size() != 10 || figure.parameter_count() != 102932)
    return 1;
  figure.save_svg("build/cvae_architecture.svg");
  std::print("{} leaves /{} unique learned scalars.\n", p.size(), p.count());
}
