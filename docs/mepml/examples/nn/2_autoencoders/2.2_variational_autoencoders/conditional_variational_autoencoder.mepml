> Ninety-six explicit Adam updates and fixed four-draw validation

Seed2111 initializes ordinary Glorot weights and zero biases. Adam uses learning rate0.003,
moments0.9/0.999 and epsilon1e-8. BatchOrder(1000,32,2113) visits all fitting rows each epoch:
31 full batches and a final batch of8,32 updates/epoch,96 over three epochs. Training uses
one fresh Gaussian noise vector per image per epoch, seeds2130/2131/2132. Fixed four-draw
banks use fit2141, validation2131 and test2137; the generator restarts for each named bank.
The training-epoch2/validation seed reuse is retained from the source, so those banks are not
independent streams. Each is explicit, archived and held fixed in its stated role; training
targets and validation targets remain disjoint. A draw stream is MT19937/Box–Muller Float64,
with its Float32 cast supplied to the model. Prior-only sampling later uses seed2143.

The loop shows every forward/gradient/optimizer step. Completed epochs1–3 are candidates;
epoch-zero test score is a control only. Four fixed validation draws average summed Bernoulli
NLL over samples and images; analytic KL is counted once per image. Float64 metric accumulation
iterates sample then image over Float32 per-row outputs, preserving the original criterion.
**Validation NLL+KL** selects all ten parameter tensors together. Test pixels and all gallery
controls play no role in checkpoint selection. This is a four-sample Monte Carlo ELBO estimate,
not an importance-weighted bound or exact conditional log likelihood.

```{cpp, results="markdown", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <chrono>
#include <dm/dm.hpp>
#include <fstream>
namespace nn = dm::nn;
struct NoiseBank {
  nn::Tensor standard, epsilon;
};
void Require(bool ok, const std::string& why) {
  if (!ok)
    throw std::runtime_error(why);
}
void Near(double a, double b, double tolerance, const std::string& why) {
  Require(std::abs(a - b) <= tolerance, why);
}
nn::Tensor Flatten(const nn::Tensor& t) {
  return nn::reshape(t, {t.size(0), 784});
}
nn::Tensor Find(const nn::NamedTensors& a, const std::string& key) {
  for (const auto& [k, v] : a)
    if (k == key)
      return v;
  throw std::runtime_error(key);
}
std::vector<float> Bytes(const nn::Tensor& t) {
  return t.contiguous().to_vector<float>();
}
auto Snapshot(const nn::ParameterStore& p) {
  return p.flatten();
}
nn::NamedTensors Arrays(const nn::ParameterStore& p) {
  nn::NamedTensors a;
  for (const auto& k : p.names())
    a.emplace_back(k, p.at(k).detach().clone());
  return a;
}
nn::NamedTensors CheckGradients(
    const nn::ParameterStore&      p,
    const std::vector<nn::Tensor>& gs,
    const std::string&,
    const std::string&) {
  nn::NamedTensors a;
  Require(gs.size() == p.size(), "all10 gradients");
  const auto names = p.names();
  for (std::size_t i = 0; i < gs.size(); ++i) {
    double norm = 0;
    for (double x : gs[i].to_vector<double>()) {
      Require(std::isfinite(x), "finite derivative");
      norm += x * x;
    }
    Require(norm > 0, "nonzero derivative in each tensor");
    a.emplace_back(names[i], gs[i]);
  }
  return a;
}
NoiseBank VaeNoise(std::int64_t n, std::int64_t samples, std::uint32_t seed) {
  const auto s = nn::models::GaussianNoise({n, 2}, samples, seed);
  return {s, nn::cast(s, nn::DType::Float32)};
}
nn::Tensor VaeNoiseAt(const NoiseBank& bank, int k) {
  return nn::select(bank.epsilon, 0, k).contiguous();
}
std::vector<nn::Tensor> Evaluate(
    nn::ParameterStore& p,
    const nn::Tensor&   images,
    const nn::Tensor&   classes,
    const nn::Tensor&   epsilon) {
  nn::NoGradGuard guard;
  const auto      o =
      nn::models::ConditionalVariationalAutoencoder(p, Flatten(images), classes, epsilon);
  return {o.mu, o.log_variance, o.z, o.probability, o.reconstruction_nll, o.kl, o.loss};
}
nn::Tensor Decode(nn::ParameterStore& p, const nn::Tensor& z, const nn::Tensor& classes) {
  nn::NoGradGuard guard;
  return nn::sigmoid(nn::models::ConditionalVaeDecode(p, z, classes));
}
std::vector<nn::Tensor> Probe(
    nn::ParameterStore& p,
    const nn::Tensor&   images,
    const nn::Tensor&   classes,
    const nn::Tensor&   epsilon) {
  nn::NoGradGuard guard;
  const auto      o =
      nn::models::ConditionalVariationalAutoencoder(p, Flatten(images), classes, epsilon);
  return {o.condition, o.encoder_input, o.decoder_input, o.z};
}
std::array<double, 3> ConditionalVaeScore(
    nn::ParameterStore& p,
    const nn::Tensor&   images,
    const nn::Tensor&   classes,
    const NoiseBank&    bank) {
  double     reconstruction = 0, kl = 0;
  const auto n = images.size(0), samples = bank.epsilon.size(0);
  for (int k = 0; k < samples; ++k) {
    const auto o   = Evaluate(p, images, classes, VaeNoiseAt(bank, k));
    const auto nll = o[4].to_vector<float>(), kls = o[5].to_vector<float>();
    for (int b = 0; b < n; ++b) {
      reconstruction += nll[b];
      if (k == 0)
        kl += kls[b];
    }
  }
  reconstruction /= double(n * samples);
  kl /= double(n);
  return {reconstruction, kl, reconstruction + kl};
}
double MaxAbsDiff(const nn::Tensor& a, const nn::Tensor& b, int n) {
  const auto x = Bytes(a), y = Bytes(b);
  double     d = 0;
  for (int i = 0; i < n; ++i)
    d = std::max(d, std::abs(double(x[i]) - y[i]));
  return d;
}
double Mse(const nn::Tensor& a, const nn::Tensor& b) {
  return nn::mean(
             nn::square(
                 nn::cast(Flatten(a), nn::DType::Float64) -
                 nn::cast(Flatten(b), nn::DType::Float64)))
      .item();
}

int main() {
  const std::filesystem::path           root   = "build/cvae";
  const int                             epochs = 3;
  const auto                            data   = nn::load_npz((root / "data.npz").string());
  std::vector<nn::models::SaliencyData> pools;
  for (const std::string split : {"fit", "validation", "test"})
    pools.push_back(
        {Find(data, split + "_images"),
         Find(data, split + "_labels"),
         Find(data, split + "_source_ids")});
  auto val_noise = VaeNoise(200, 4, 2131), test_noise = VaeNoise(200, 4, 2137),
       fit_noise = VaeNoise(1000, 4, 2141);
  nn::save_npz(
      (root / "fixed_noise.npz").string(),
      {{"validation_standard", val_noise.standard},
       {"validation_epsilon", val_noise.epsilon},
       {"test_standard", test_noise.standard},
       {"test_epsilon", test_noise.epsilon},
       {"fit_standard", fit_noise.standard},
       {"fit_epsilon", fit_noise.epsilon}});
  nn::ParameterStore model(2111);
  {
    nn::NoGradGuard guard;
    nn::models::ConditionalVariationalAutoencoder(
        model, nn::zeros({1, 784}), nn::zeros({1}, nn::DType::Int32), nn::zeros({1, 2}));
  }
  nn::OptimizerConfig config;
  config.kind = nn::OptimizerKind::Adam;
  nn::Optimizer optimizer(model, .003, config);
  Require(
      model.size() == 10 && model.count() == 102932, "twohead diagonalGaussian parameter census");
  nn::save_npz((root / "initial_arrays.npz").string(), Arrays(model));
  auto           initial = ConditionalVaeScore(model, pools[2].images, pools[2].labels, test_noise);
  nn::BatchOrder order(1000, 32, 2113);
  std::ofstream  history(root / "history.tsv"), batches(root / "batches.tsv");
  history.precision(17);
  history << "epoch\tfit_preupdate_negative_elbo\tvalidation_reconstruction_nll\tvalidation_"
             "kl\tvalidation_"
             "negative_elbo\n";
  batches << "epoch\tstep\trow\tsource_id\n";
  const auto fit_source = pools[0].source.to_vector<int>();
  const auto best_path  = (root / "best.npz").string();
  double     best       = std::numeric_limits<double>::infinity();
  int        selected = 0, step = 0;
  const auto started = std::chrono::steady_clock::now();
  for (int epoch = 1; epoch <= epochs; ++epoch) {
    auto noise = VaeNoise(1000, 1, 2129 + epoch);
    nn::save_npz(
        (root / ("train_noise_epoch" + std::to_string(epoch) + ".npz")).string(),
        {{"standard", noise.standard}, {"epsilon", noise.epsilon}});
    auto epsilon = VaeNoiseAt(noise, 0);
    order.begin_epoch();
    double sum  = 0;
    int    seen = 0;
    for (;;) {
      auto rows = order.next();
      if (rows.empty())
        break;
      auto input = nn::take_rows(pools[0].images, rows), e = nn::take_rows(epsilon, rows),
           classes = nn::take_rows(pools[0].labels, rows);
      if (step == 0) {
        auto g = CheckGradients(
            model,
            nn::grad(
                nn::models::ConditionalVariationalAutoencoder(model, Flatten(input), classes, e)
                    .loss,
                model.parameters()),
            "all posterior/decoder negativeELBO derivatives finite",
            "ALL10posterior/decoder tensors receive gradients");
        nn::save_npz((root / "first_gradients.npz").string(), g);
        nn::save_npz(
            (root / "first_batch.npz").string(),
            {{"images", input}, {"labels", classes}, {"epsilon", e}});
      }
      const auto out =
          nn::models::ConditionalVariationalAutoencoder(model, Flatten(input), classes, e);
      sum += double(rows.size()) * out.loss.item<float>();
      const auto gradients = nn::grad(out.loss, model.parameters());
      optimizer.step(gradients);
      seen += int(rows.size());
      for (auto row : rows)
        batches << epoch << '\t' << step << '\t' << row << '\t' << fit_source[row] << '\n';
      if (step == 0)
        nn::save_npz((root / "first_update_arrays.npz").string(), Arrays(model));
      ++step;
    }
    Require(seen == 1000, "allfittingrecords once per epoch");
    auto score = ConditionalVaeScore(model, pools[1].images, pools[1].labels, val_noise);
    history << epoch << '\t' << sum / seen << '\t' << score[0] << '\t' << score[1] << '\t'
            << score[2] << '\n';
    nn::save_npz(
        (root / ("epoch" + std::to_string(epoch) + "_arrays.npz")).string(), Arrays(model));
    if (score[2] < best) {
      best     = score[2];
      selected = epoch;
      model.save(best_path); // fixed FOUR-sample validation negative ELBO selects epoch
    }
    std::cout << "VAE epoch" << epoch << ":validation NLL=" << score[0] << ",KL=" << score[1]
              << ",negativeELBO=" << score[2] << std::endl;
  }
  const double seconds =
      std::chrono::duration<double>(std::chrono::steady_clock::now() - started).count();
  nn::ParameterStore deployed(2111);
  {
    nn::NoGradGuard guard;
    nn::models::ConditionalVariationalAutoencoder(
        deployed, nn::zeros({1, 784}), nn::zeros({1}, nn::DType::Int32), nn::zeros({1, 2}));
  }
  deployed.load(best_path);
  const auto before = Snapshot(deployed);
  Near(
      ConditionalVaeScore(deployed, pools[1].images, pools[1].labels, val_noise)[2],
      best,
      1e-8,
      "fresh selected MC validation objective");
  nn::NamedTensors       output;
  std::vector<NoiseBank> banks{fit_noise, val_noise, test_noise};
  for (int split = 0; split < 3; ++split) {
    const std::string  name = split == 0 ? "fit" : split == 1 ? "validation" : "test";
    const std::int64_t n    = pools[split].images.size(0);
    auto mean = Evaluate(deployed, pools[split].images, pools[split].labels, nn::zeros({n, 2}));
    Require(Bytes(mean[2]) == Bytes(mean[0]), "epsilon0 means z=mu EXACT");
    std::vector<nn::Tensor> sample_z, prediction, nll;
    for (int k = 0; k < 4; ++k) {
      auto draw =
          Evaluate(deployed, pools[split].images, pools[split].labels, VaeNoiseAt(banks[split], k));
      Require(
          Bytes(draw[0]) == Bytes(mean[0]) && Bytes(draw[1]) == Bytes(mean[1]),
          "epsilon changes samples not posterior parameters");
      sample_z.push_back(draw[2]);
      prediction.push_back(draw[3]);
      nll.push_back(draw[4]);
    }
    output.emplace_back(name + "_mu", mean[0]);
    output.emplace_back(name + "_log_variance", mean[1]);
    output.emplace_back(name + "_mean_reconstruction", mean[3]);
    output.emplace_back(name + "_kl", mean[5]);
    output.emplace_back(name + "_sample_z", nn::stack(sample_z, 0));
    output.emplace_back(name + "_sample_prediction", nn::stack(prediction, 0));
    output.emplace_back(name + "_sample_nll", nn::stack(nll, 0));
  }
  const auto& test_images = pools[2].images;
  const auto& test_labels = pools[2].labels;
  auto        test        = Evaluate(deployed, test_images, test_labels, VaeNoiseAt(test_noise, 0)),
       repeat             = Evaluate(deployed, test_images, test_labels, VaeNoiseAt(test_noise, 0));
  Require(
      Bytes(test[2]) == Bytes(repeat[2]) && Bytes(test[3]) == Bytes(repeat[3]) &&
          Bytes(Decode(deployed, test[2], test_labels)) == Bytes(test[3]),
      "fixed epsilon repeatability and target-free exact sampled decode");
  auto other = Evaluate(deployed, test_images, test_labels, VaeNoiseAt(test_noise, 1));
  Require(
      Bytes(test[2]) != Bytes(other[2]) && Bytes(test[3]) != Bytes(other[3]),
      "second epsilon changes latent samples AND decoder probabilities");
  auto first = nn::models::SaliencyRows(pools[2], {0});
  auto single =
      Evaluate(deployed, first.images, first.labels, nn::take_rows(VaeNoiseAt(test_noise, 0), {0}));
  const double parity = MaxAbsDiff(single[3], test[3], 784);
  Require(parity < 2e-6, "posterior single/batch parity");
  output.emplace_back("zero_latent_prediction", Decode(deployed, nn::zeros({200, 2}), test_labels));
  std::vector<int> shifted;
  for (int c : test_labels.to_vector<int>())
    shifted.push_back((c + 1) % 10);
  auto shifted_labels = nn::from_vector(shifted, {200});
  auto wrong_mean     = Decode(deployed, Find(output, "test_mu"), shifted_labels);
  auto wrong_sample   = Decode(deployed, test[2], shifted_labels);
  output.emplace_back("wrong_label_mean_prediction", wrong_mean);
  output.emplace_back("wrong_label_sample_prediction", wrong_sample);
  output.emplace_back("wrong_labels", shifted_labels);
  auto changed_posterior =
      Evaluate(deployed, test_images, shifted_labels, VaeNoiseAt(test_noise, 0));
  const double posterior_change = MaxAbsDiff(test[0], changed_posterior[0], 400);
  Require(
      posterior_change > 1e-5,
      "supplied class also affects posterior,not decoder-only conditioning");
  output.emplace_back("wrong_label_mu", changed_posterior[0]);
  output.emplace_back("wrong_label_log_variance", changed_posterior[1]);
  auto               prior_noise = VaeNoise(5, 1, 2143);
  auto               base_z      = VaeNoiseAt(prior_noise, 0);
  const auto         base        = base_z.to_vector<float>();
  std::vector<float> pz(100);
  std::vector<int>   pl(50);
  for (int c = 0; c < 10; ++c)
    for (int k = 0; k < 5; ++k) {
      pl[c * 5 + k] = c;
      for (int d = 0; d < 2; ++d)
        pz[(c * 5 + k) * 2 + d] = base[k * 2 + d];
    }
  auto       prior_z = nn::from_vector(pz, {50, 2}), prior_labels = nn::from_vector(pl, {50});
  auto       prior            = Decode(deployed, prior_z, prior_labels);
  const auto pv               = prior.to_vector<float>();
  double     condition_change = 0;
  for (int c = 1; c < 10; ++c)
    for (int k = 0; k < 5 * 784; ++k)
      condition_change = std::max(condition_change, std::abs(double(pv[c * 5 * 784 + k]) - pv[k]));
  Require(
      condition_change > 1e-5,
      "same prior z changes probabilities when ONLY supplied class changes");
  std::vector<float> gz(162);
  for (int row = 0; row < 9; ++row)
    for (int col = 0; col < 9; ++col) {
      gz[(row * 9 + col) * 2]     = -2.f + .5f * col;
      gz[(row * 9 + col) * 2 + 1] = 2.f - .5f * row;
    }
  auto grid_z      = nn::from_vector(gz, {81, 2}),
       grid_labels = nn::from_vector(std::vector<int>(81, 3), {81});
  auto grid        = Decode(deployed, grid_z, grid_labels);
  nn::save_npz(
      (root / "prior.npz").string(),
      {{"standard", prior_noise.standard},
       {"base_z", base_z},
       {"z", prior_z},
       {"labels", prior_labels},
       {"probability", prior},
       {"grid_z", grid_z},
       {"grid_labels", grid_labels},
       {"grid_probability", grid}});
  auto probe_rows    = nn::models::SaliencyRows(pools[2], {0, 1, 2, 3, 4, 5, 6, 7});
  auto probe_epsilon = nn::take_rows(VaeNoiseAt(test_noise, 0), {0, 1, 2, 3, 4, 5, 6, 7});
  auto probe         = Probe(deployed, probe_rows.images, probe_rows.labels, probe_epsilon);
  {
    const auto lab = probe_rows.labels.to_vector<int>();
    const auto img = probe_rows.images.contiguous().to_vector<float>();
    const auto oh = probe[0].to_vector<float>(), enc = probe[1].to_vector<float>(),
               dec = probe[2].to_vector<float>(), zz = probe[3].to_vector<float>();
    for (int b = 0; b < 8; ++b) {
      for (int c = 0; c < 10; ++c) {
        const float expected = lab[b] == c ? 1.f : 0.f;
        Near(oh[b * 10 + c], expected, 0, "actual onehot");
        Near(enc[b * 794 + 784 + c], expected, 0, "encoder receives exact same condition");
        Near(dec[b * 12 + 2 + c], expected, 0, "decoder receives exact same condition");
      }
      for (int i = 0; i < 784; ++i)
        Near(enc[b * 794 + i], img[b * 784 + i], 0, "encoder concat image prefix exact");
      for (int i = 0; i < 2; ++i)
        Near(dec[b * 12 + i], zz[b * 2 + i], 0, "decoder concat sampled z prefix exact");
    }
  }
  nn::save_npz(
      (root / "condition_probe.npz").string(),
      {{"images", probe_rows.images},
       {"labels", probe_rows.labels},
       {"epsilon", probe_epsilon},
       {"one_hot", probe[0]},
       {"encoder_input", probe[1]},
       {"decoder_input", probe[2]},
       {"z", probe[3]}});
  for (int invalid : {-1, 10}) {
    bool rejected = false;
    try {
      Decode(deployed, nn::zeros({1, 2}), nn::from_vector(std::vector<int>{invalid}, {1}));
    } catch (const std::exception&) {
      rejected = true;
    }
    Require(rejected, "invalid supplied class rejected before graph execution");
  }
  Require(
      before == Snapshot(deployed),
      "conditional posterior/prior/controls leave ALL10parameters immutable");
  nn::save_npz((root / "outputs.npz").string(), output);
  nn::save_npz((root / "model_arrays.npz").string(), Arrays(deployed));
  auto         score    = ConditionalVaeScore(deployed, test_images, test_labels, test_noise);
  const auto   mean_rec = Find(output, "test_mean_reconstruction");
  const double mean_mse = Mse(mean_rec, test_images);

  const auto fit         = nn::cast(Flatten(pools[0].images), nn::DType::Float64),
             hot         = nn::one_hot(pools[0].labels, 10, 1, 0, nn::DType::Float64);
  const auto class_means = nn::cast(nn::matmul(nn::transpose(hot), fit) / 100, nn::DType::Float32);
  const auto class_mean  = nn::take_rows(class_means, test_labels.to_vector<std::int64_t>());
  nn::save_npz((root / "class_mean.npz").string(), {{"test_class_mean", class_mean}});
  const auto global_mean =
      nn::tile(nn::cast(nn::mean(fit, {0}, true), nn::DType::Float32), {200, 1});
  std::print(
      "| quantity | heldout value |\n|---|---:|\n| selected epoch |{}|\n| NLL nats/image "
      "|{:.9f}|\n| KL nats/image |{:.9f}|\n| negative ELBO |{:.9f}|\n| decode(mu) pixel MSE "
      "|{:.9f}|\n| fitting global mean MSE |{:.9f}|\n| fitting class mean MSE |{:.9f}|\n| "
      "shifted-label same-mu MSE |{:.9f}|\n| posterior class-change max |{:.9f}|\n| fixed-prior "
      "class-change max |{:.9f}|\n",
      selected,
      score[0],
      score[1],
      score[2],
      mean_mse,
      Mse(global_mean, test_images),
      Mse(class_mean, test_images),
      Mse(wrong_mean, test_images),
      posterior_change,
      condition_change);
  Require(step == 96 && optimizer.iterations() == 96, "original96 updates");
  Require(bool(history) && bool(batches), "complete history/batch evidence");
}
```
