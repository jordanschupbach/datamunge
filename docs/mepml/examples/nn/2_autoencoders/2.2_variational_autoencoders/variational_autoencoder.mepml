> Held-out reconstructions and the posterior means

Each row below shows binary target, decode(mu), posterior draw 0, posterior draw 1, fitting-only
binary mean, absolute decode(mu) error and zero-code decode. The first test record for each
digit is displayed, regardless of quality. Decode(mu) is not the posterior predictive mean.
All decoder images are Bernoulli probabilities rather than sampled binary pixels; the shared
0–1 grayscale is fixed across columns. MSE improves modestly over the fitting-only mean, but
it is neither the fitted objective nor a perceptual-quality measurement.

```{cpp, results="markdown", file="figures/vanilla_vae_reconstructions.png", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
  namespace n     = dm::nn;
  const auto data = n::load_npz("build/vanilla_vae/data.npz"),
             out  = n::load_npz("build/vanilla_vae/outputs.npz");
  auto find       = [](const n::NamedTensors& a, const std::string& name) {
    for (const auto& [key, value] : a)
      if (key == name)
        return value;
    throw std::runtime_error(name);
  };
  const auto x     = find(data, "test_images").reshape({200, 784}),
             rec   = find(out, "test_mean_reconstruction"),
             draws = find(out, "test_sample_prediction");
  const auto mean  = n::cast(
      n::mean(n::cast(find(data, "fit_images").reshape({1000, 784}), n::DType::Float64), {0}),
      n::DType::Float32);
  const std::vector<n::Tensor> values{
      x,
      rec,
      n::select(draws, 0, 0),
      n::select(draws, 0, 1),
      n::broadcast_to(mean.reshape({1, 784}), {200, 784}),
      n::abs(rec - x),
      find(out, "zero_latent_prediction")};
  const auto labels = find(data, "test_labels").to_vector<int>(),
             ids    = find(data, "test_source_ids").to_vector<int>();
  std::vector<n::Tensor> gallery;
  std::print("| digit | official-test source ID |\n|---:|---:|\n");
  for (int digit = 0; digit < 10; ++digit) {
    const auto it = std::find(labels.begin(), labels.end(), digit);
    if (it == labels.end())
      return 1;
    const auto row = std::distance(labels.begin(), it);
    std::print("| {} | {} |\n", digit, ids[row]);
    for (const auto& v : values)
      gallery.push_back(n::take_rows(v, {row}));
  }
  n::save_image_grid(
      n::concat(gallery, 0).reshape({70, 28, 28, 1}),
      "build/vanilla_vae_reconstructions.png",
      7,
      0,
      1,
      4,
      220. / 255.,
      3);
}
