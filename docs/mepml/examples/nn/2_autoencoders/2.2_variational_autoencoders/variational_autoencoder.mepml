|---|---:|---|---:|
| fit | 1000 | 28x28x1 | 0.134615 |
| validation | 200 | 28x28x1 | 0.128540 |
| test | 200 | 28x28x1 | 0.136684 |
// result_end

\caption(The report prepares and loads data entirely through datamunge. Static binary targets are also saved alongside their original grayscale inputs.)

ParameterStore seed 1951 creates ten leaves and 101,652 scalars: 50,500 encoder and 51,152
decoder parameters. BatchOrder(1000,32,1957) gives 32 batches per epoch, including an eight-row
last batch. Three epochs make **96 Adam steps**, at rate 0.003 with moments 0.9/0.999 and
epsilon 1e-8. Fresh epoch noise uses seeds 1974–1976; fixed four-draw validation/test/fit
banks use 1987/1989/1991. Float64 MT19937/Box–Muller draws and their Float32 casts are saved.

Every completed epoch 1–3 is eligible. Selection minimizes fixed four-draw validation pixel
NLL plus analytic KL, with KL counted once. A fresh model restores the selected checkpoint;
this is model restore rather than optimizer-state resume. The adapters below package
checkpoints, metadata and outputs. The actual forward, loss, differentiation and Adam step
remain visible in the complete program.

```{cpp, results="markdown", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
namespace nn = dm::nn;
namespace ae {
using SaliencyData = nn::models::SaliencyData;
void Require(bool condition, const std::string& why) {
  if (!condition)
    throw std::runtime_error(why);
}
void Near(double a, double b, double tolerance, const std::string& why) {
  Require(std::abs(a - b) <= tolerance, why);
}
nn::Tensor Flatten(const nn::Tensor& x) {
  return x.reshape({x.size(0), 784});
}
std::vector<SaliencyData> LoadSaliency(const std::filesystem::path& root) {
  return nn::models::LoadSaliency(root);
}
SaliencyData Rows(const SaliencyData& data, const std::vector<std::int64_t>& rows) {
  return {
      nn::take_rows(data.images, rows),
      nn::take_rows(data.labels, rows),
      nn::take_rows(data.source, rows)};
}
void CopyManifests(const std::filesystem::path& data, const std::filesystem::path& root) {
  const auto options = std::filesystem::copy_options::overwrite_existing;
  if (std::filesystem::exists(data / "manifest.json"))
    std::filesystem::copy_file(data / "manifest.json", root / "data_manifest.json", options);
  const auto source = data.parent_path() / "autoencoder/source_manifest.json";
  if (std::filesystem::exists(source))
    std::filesystem::copy_file(source, root / "source_manifest.json", options);
}
nn::NamedTensors Arrays(const nn::ParameterStore& p) {
  nn::NamedTensors out;
  for (const auto& name : p.names())
    out.emplace_back(name, p.at(name).detach().clone());
  return out;
}
auto Snapshot(const nn::ParameterStore& p) {
  return p.flatten();
}
nn::Tensor Find(const nn::NamedTensors& data, const std::string& name) {
  for (const auto& [key, value] : data)
    if (key == name)
      return value;
  throw std::runtime_error(name);
}
double MaxAbsDiff(const nn::Tensor& a, const nn::Tensor& b, std::int64_t count) {
  return nn::max(nn::abs(nn::slice_axis(Flatten(a), 0, 0, 1) - nn::slice_axis(Flatten(b), 0, 0, 1)))
      .item();
}
double Mse(const nn::Tensor& a, const nn::Tensor& b) {
  return nn::mean(
             nn::square(
                 nn::cast(Flatten(a), nn::DType::Float64) -
                 nn::cast(Flatten(b), nn::DType::Float64)))
      .item();
}
nn::Tensor PixelMean(const nn::Tensor& image) {
  return nn::cast(nn::mean(nn::cast(Flatten(image), nn::DType::Float64), {0}), nn::DType::Float32);
}
nn::Tensor Constant(const nn::Tensor& row, std::int64_t n) {
  return nn::broadcast_to(row.reshape({1, 784}), {n, 784}).contiguous();
}
struct VaeNoiseBank {
  nn::Tensor standard, epsilon;
};
VaeNoiseBank VaeNoise(std::int64_t n, std::int64_t samples, std::uint32_t seed) {
  auto standard = nn::models::GaussianNoise({n, 2}, samples, seed);
  return {standard, nn::cast(standard, nn::DType::Float32).contiguous()};
}
nn::Tensor VaeNoiseAt(const VaeNoiseBank& bank, std::int64_t k) {
  return nn::select(bank.epsilon, 0, k).contiguous();
}
nn::models::GaussianVaeOutput
Forward(nn::ParameterStore& p, const nn::Tensor& image, const nn::Tensor& noise) {
  return nn::models::BetaVariationalAutoencoder(p, Flatten(image), noise, 1, 784, 2, 64);
}
void Warm(nn::ParameterStore& p) {
  nn::NoGradGuard guard;
  Forward(p, nn::zeros({1, 784}), nn::zeros({1, 2}));
}
std::vector<nn::Tensor>
Evaluate(nn::ParameterStore& p, const nn::Tensor& image, const nn::Tensor& noise) {
  nn::NoGradGuard         guard;
  const auto              out = Forward(p, image, noise);
  std::vector<nn::Tensor> fields{
      out.mu, out.log_variance, out.z, out.probability, out.reconstruction_nll, out.kl, out.loss};
  for (auto& value : fields) {
    value = value.contiguous();
    for (double v : value.to_vector<double>())
      Require(std::isfinite(v), "all posterior/decoder/objective values finite");
  }
  return fields;
}
nn::Tensor Decode(nn::ParameterStore& p, const nn::Tensor& code) {
  nn::NoGradGuard guard;
  return nn::sigmoid(nn::models::GaussianVaeDecode(p, code, 784, 2, 64));
}
std::vector<double>
VaeScore(nn::ParameterStore& p, const nn::Tensor& images, const VaeNoiseBank& bank) {
  double     nll = 0, kl = 0;
  const auto samples = bank.epsilon.size(0), n = images.size(0);
  for (std::int64_t k = 0; k < samples; ++k) {
    const auto fields = Evaluate(p, images, VaeNoiseAt(bank, k));
    nll += nn::sum(nn::cast(fields[4], nn::DType::Float64)).item();
    if (k == 0)
      kl = nn::sum(nn::cast(fields[5], nn::DType::Float64)).item();
  }
  nll /= double(n * samples);
  kl /= double(n);
  return {nll, kl, nll + kl};
}
nn::NamedTensors CheckGradients(
    const nn::ParameterStore&      p,
    const std::vector<nn::Tensor>& gradients,
    const std::string&             finite,
    const std::string&             nonzero) {
  Require(gradients.size() == p.size(), "all ten gradient leaves");
  nn::NamedTensors out;
  const auto       names = p.names();
  for (std::size_t k = 0; k < gradients.size(); ++k) {
    double norm = 0;
    for (double value : gradients[k].to_vector<double>()) {
      Require(std::isfinite(value), finite);
      norm += value * value;
    }
    Require(norm > 0, nonzero);
    out.emplace_back(names[k], gradients[k]);
  }
  return out;
}
} // namespace ae
namespace check {
using ae::Near;
using ae::Require;
} // namespace check
namespace {

namespace nn = datamunge::nn;

void Checks() {
  const std::vector<float> m{.2f, -.4f, .1f, .3f},
      l{0.f, float(std::log(4.)), float(std::log(.25)), .2f}, e{1.f, -.5f, 2.f, -1.f};
  auto mu      = nn::from_vector(m, {2, 2}).requires_grad_(),
       lv      = nn::from_vector(l, {2, 2}).requires_grad_(),
       eps     = nn::from_vector(e, {2, 2}).requires_grad_();
  auto z       = nn::models::GaussianReparameterize(mu, lv, eps),
       kl      = nn::models::DiagonalGaussianKl(mu, lv);
  auto loss    = nn::mean(0.5 * nn::sum(nn::square(z), {1}) + kl, {0});
  auto grad    = nn::grad(loss, {mu, lv, eps});
  auto extreme = nn::models::BernoulliPixelNll(
      nn::tensor({{100., -100., 100., -100.}}), nn::tensor({{1., 0., 0., 1.}}));
  auto       zero_kl = nn::models::DiagonalGaussianKl(nn::zeros({1, 2}), nn::zeros({1, 2}));
  const auto zs = z.to_vector<float>(), kls = kl.to_vector<float>(),
             g0 = grad[0].to_vector<float>(), g1 = grad[1].to_vector<float>(),
             g2 = grad[2].to_vector<float>();
  for (int b = 0; b < 2; ++b) {
    double k = 0;
    for (int j = 0; j < 2; ++j) {
      const int    i    = b * 2 + j;
      const double mean = m[i], logv = l[i], noise = e[i], sigma = std::exp(.5 * logv),
                   value = mean + sigma * noise;
      k += .5 * (mean * mean + std::exp(logv) - 1 - logv);
      check::Near(zs[i], value, 2e-7, "all4reparameterized values");
      check::Near(g0[i], (value + mean) / 2, 2e-7, "all4mu derivatives include pathwise PLUS KL");
      check::Near(
          g1[i],
          (.5 * value * sigma * noise + .5 * (std::exp(logv) - 1)) / 2,
          3e-7,
          "all4logvariance derivatives include pathwise PLUS KL");
      check::Near(g2[i], value * sigma / 2, 3e-7, "all4epsilon derivatives follow sigma");
    }
    check::Near(kls[b], k, 2e-7, "all2analytic Gaussian KLs");
  }
  check::Near(extreme.at({0}), 200, 1e-6, "stable BCE for logits+-100");
  check::Near(zero_kl.at({0}), 0, 0, "q=N(0,I)KL exactly0");
  std::cout << "known4pathwise values/2KL/ALL12mu-logvariance-epsilon "
               "derivatives/zeroKL/extremeBCE passed\n";
}

void Run(
    const std::filesystem::path& data,
    const std::filesystem::path& root,
    int                          epochs,
    const std::string&           init) {
  auto pools = ae::LoadSaliency(data);
  std::filesystem::create_directories(root);
  nn::NamedTensors saved_data;
  for (int split = 0; split < 3; ++split) {
    const std::string name = split == 0 ? "fit" : split == 1 ? "validation" : "test";
    saved_data.emplace_back(name + "_original_images", pools[split].images);
    pools[split].images =
        nn::cast(nn::greater_equal(pools[split].images, .5), nn::DType::Float32).contiguous();
    saved_data.emplace_back(name + "_images", pools[split].images);
    saved_data.emplace_back(name + "_source_ids", pools[split].source);
  }
  saved_data.emplace_back("test_labels", pools[2].labels);
  nn::save_npz((root / "data.npz").string(), saved_data);
  ae::CopyManifests(data, root);
  auto val_noise = ae::VaeNoise(200, 4, 1987), test_noise = ae::VaeNoise(200, 4, 1989),
       fit_noise = ae::VaeNoise(1000, 4, 1991);
  nn::save_npz(
      (root / "fixed_noise.npz").string(),
      {{"validation_standard", val_noise.standard},
       {"validation_epsilon", val_noise.epsilon},
       {"test_standard", test_noise.standard},
       {"test_epsilon", test_noise.epsilon},
       {"fit_standard", fit_noise.standard},
       {"fit_epsilon", fit_noise.epsilon}});
  nn::ParameterStore model(1951);
  ae::Warm(model);
  nn::OptimizerConfig config;
  config.kind = nn::OptimizerKind::Adam;
  nn::Optimizer optimizer(model, .003, config);
  if (!init.empty())
    model.load(init);
  check::Require(
      model.size() == 10 && model.count() == 101652, "twohead diagonalGaussian parameter census");
  nn::save_npz((root / "initial_arrays.npz").string(), ae::Arrays(model));
  auto           initial = ae::VaeScore(model, pools[2].images, test_noise);
  nn::BatchOrder order(1000, 32, 1957);
  std::ofstream  history(root / "history.tsv"), batches(root / "batches.tsv");
  history.precision(17);
  history << "epoch\tfit_preupdate_negative_elbo\tvalidation_reconstruction_nll\tvalidation_"
             "kl\tvalidation_"
             "negative_elbo\n";
  batches << "epoch\tstep\trow\tsource_id\n";
  const auto fit_source = pools[0].source.to_vector<int>();
  const auto best_path  = (root / "best.npz").string();
  double     best       = std::numeric_limits<double>::infinity();
  int        selected = 0, step = 0;
  const auto started = std::chrono::steady_clock::now();
  for (int epoch = 1; epoch <= epochs; ++epoch) {
    auto noise = ae::VaeNoise(1000, 1, 1973 + epoch); // fresh explicit epsilon every epoch
    nn::save_npz(
        (root / ("train_noise_epoch" + std::to_string(epoch) + ".npz")).string(),
        {{"standard", noise.standard}, {"epsilon", noise.epsilon}});
    auto epsilon = ae::VaeNoiseAt(noise, 0);
    order.begin_epoch();
    double sum  = 0;
    int    seen = 0;
    for (;;) {
      auto rows = order.next();
      if (rows.empty())
        break;
      auto input = nn::take_rows(pools[0].images, rows), e = nn::take_rows(epsilon, rows);
      if (step == 0) {
        auto g = ae::CheckGradients(
            model,
            nn::grad(ae::Forward(model, input, e).loss, model.parameters()),
            "all posterior/decoder negativeELBO derivatives finite",
            "ALL10posterior/decoder tensors receive gradients");
        nn::save_npz((root / "first_gradients.npz").string(), g);
        nn::save_npz((root / "first_batch.npz").string(), {{"images", input}, {"epsilon", e}});
      }
      // Explicit posterior/decoder forward, negative ELBO, all-ten-leaf reverse mode, Adam.
      const auto forward =
          nn::models::BetaVariationalAutoencoder(model, ae::Flatten(input), e, 1, 784, 2, 64);
      const double loss = forward.loss.item<float>();
      check::Require(std::isfinite(loss) && loss >= 0, "finite negative ELBO");
      sum += double(rows.size()) * loss;
      const auto gradients = nn::grad(forward.loss, model.parameters());
      optimizer.step(gradients);
      seen += int(rows.size());
      for (auto row : rows)
        batches << epoch << '\t' << step << '\t' << row << '\t' << fit_source[row] << '\n';
      if (step == 0)
        nn::save_npz((root / "first_update_arrays.npz").string(), ae::Arrays(model));
      ++step;
    }
    check::Require(seen == 1000, "allfittingrecords once per epoch");
    auto score = ae::VaeScore(model, pools[1].images, val_noise);
    history << epoch << '\t' << sum / seen << '\t' << score[0] << '\t' << score[1] << '\t'
            << score[2] << '\n';
    nn::save_npz(
        (root / ("epoch" + std::to_string(epoch) + "_arrays.npz")).string(), ae::Arrays(model));
    if (score[2] < best) {
      best     = score[2];
      selected = epoch;
      model.save(best_path); // fixed four-sample validation negative ELBO selects the epoch
    }
  }
  const double train_seconds =
      std::chrono::duration<double>(std::chrono::steady_clock::now() - started).count();
  nn::ParameterStore deployed(1951);
  ae::Warm(deployed);
  deployed.load(best_path); // fresh posterior/prior inference restore
  const auto before = ae::Snapshot(deployed);
  check::Near(
      ae::VaeScore(deployed, pools[1].images, val_noise)[2],
      best,
      1e-8,
      "fresh selected MC validation objective");
  nn::NamedTensors              output;
  std::vector<ae::VaeNoiseBank> banks{fit_noise, val_noise, test_noise};
  for (int split = 0; split < 3; ++split) {
    const std::string  name = split == 0 ? "fit" : split == 1 ? "validation" : "test";
    const std::int64_t n    = pools[split].images.size(0);
    auto               mean = ae::Evaluate(deployed, pools[split].images, nn::zeros({n, 2}));
    check::Require(nn::equal_bits(mean[2], mean[0]), "epsilon0 means z=mu EXACT");
    std::vector<nn::Tensor> sample_z, prediction, nll;
    for (int k = 0; k < 4; ++k) {
      auto draw = ae::Evaluate(deployed, pools[split].images, ae::VaeNoiseAt(banks[split], k));
      check::Require(
          nn::equal_bits(draw[0], mean[0]) && nn::equal_bits(draw[1], mean[1]),
          "epsilon changes samples not posterior parameters");
      sample_z.push_back(draw[2]);
      prediction.push_back(draw[3]);
      nll.push_back(draw[4]);
    }
    output.emplace_back(name + "_mu", mean[0]);
    output.emplace_back(name + "_log_variance", mean[1]);
    output.emplace_back(name + "_mean_reconstruction", mean[3]);
    output.emplace_back(name + "_kl", mean[5]);
    output.emplace_back(name + "_sample_z", nn::stack(sample_z, 0));
    output.emplace_back(name + "_sample_prediction", nn::stack(prediction, 0));
    output.emplace_back(name + "_sample_nll", nn::stack(nll, 0));
  }
  auto test   = ae::Evaluate(deployed, pools[2].images, ae::VaeNoiseAt(test_noise, 0)),
       repeat = ae::Evaluate(deployed, pools[2].images, ae::VaeNoiseAt(test_noise, 0));
  check::Require(
      nn::equal_bits(test[2], repeat[2]) && nn::equal_bits(test[3], repeat[3]) &&
          nn::equal_bits(ae::Decode(deployed, test[2]), test[3]),
      "fixed epsilon repeatability and target-free exact sampled decode");
  auto other = ae::Evaluate(deployed, pools[2].images, ae::VaeNoiseAt(test_noise, 1));
  check::Require(
      !nn::equal_bits(test[2], other[2]) && !nn::equal_bits(test[3], other[3]),
      "second epsilon changes latent samples AND decoder probabilities");
  auto single = ae::Evaluate(
      deployed, ae::Rows(pools[2], {0}).images, nn::take_rows(ae::VaeNoiseAt(test_noise, 0), {0}));
  const double parity = ae::MaxAbsDiff(single[3], test[3], 784);
  check::Require(parity < 2e-6, "posterior single/batch parity");
  auto zero_latent = ae::Decode(deployed, nn::zeros({200, 2}));
  output.emplace_back("zero_latent_prediction", zero_latent);
  auto prior_noise = ae::VaeNoise(20, 1, 1997);
  auto prior_z = ae::VaeNoiseAt(prior_noise, 0), prior = ae::Decode(deployed, prior_z);
  std::vector<float> grid_values;
  for (int row = 0; row < 9; ++row)
    for (int col = 0; col < 9; ++col) {
      grid_values.push_back(-2.f + .5f * col);
      grid_values.push_back(2.f - .5f * row);
    }
  auto grid_z = nn::from_vector(grid_values, {81, 2});
  auto grid   = ae::Decode(deployed, grid_z);
  nn::save_npz(
      (root / "prior.npz").string(),
      {{"standard", prior_noise.standard},
       {"z", prior_z},
       {"probability", prior},
       {"grid_z", grid_z},
       {"grid_probability", grid}});
  check::Require(
      before == ae::Snapshot(deployed),
      "posterior evaluation/prior generation leaves ALL10parameters immutable");
  nn::save_npz((root / "outputs.npz").string(), output);
  nn::save_npz((root / "model_arrays.npz").string(), ae::Arrays(deployed));
  auto          score    = ae::VaeScore(deployed, pools[2].images, test_noise);
  const auto    mean_rec = ae::Find(output, "test_mean_reconstruction");
  const double  mean_mse = ae::Mse(mean_rec, pools[2].images);
  std::ofstream meta(root / "metrics.json");
  meta.precision(17);
  meta << "{\"parameters\":101652,\"epochs\":" << epochs << ",\"updates\":" << step
       << ",\"selected_epoch\":" << selected
       << ",\"mc_samples\":4,\"initial_test_negative_elbo\":" << initial[2]
       << ",\"test_reconstruction_nll\":" << score[0] << ",\"test_kl\":" << score[1]
       << ",\"test_negative_elbo\":" << score[2] << ",\"mean_decode_test_mse\":" << mean_mse
       << ",\"single_batch_max_error\":" << parity << "}\n";
  auto fit_mean = ae::Constant(ae::PixelMean(pools[0].images), 200);

  check::Require(bool(meta) && bool(history) && bool(batches), "complete vanilla VAE evidence");
  std::print(
      "| selected epoch | test pixel NLL | KL | negative ELBO | decode(mu) MSE | fit-only binary "
      "mean MSE |\n|---:|---:|---:|---:|---:|---:|\n| {} | {:.9f} | {:.9f} | {:.9f} | {:.9f} | "
      "{:.9f} |\n",
      selected,
      score[0],
      score[1],
      score[2],
      mean_mse,
      ae::Mse(fit_mean, pools[2].images));
}
} // namespace
int main() {
  try {
    Checks();
    const std::filesystem::path cache = dm::datasets::data_home();
    dm::datasets::prepare_example_data("mnist-assets", cache.string());
    Run(cache / "saliency", "build/vanilla_vae", 3, "");
    return 0;
  } catch (const std::exception& e) {
    std::cerr << e.what() << '\n';
    return 1;
  }
}
```
