```{cpp, results="markdown", file="figures/vanilla_vae_latent.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
  namespace n = dm::nn;
  auto a      = n::load_npz("build/vanilla_vae/outputs.npz"),
       data   = n::load_npz("build/vanilla_vae/data.npz");
  auto find   = [](const n::NamedTensors& a, const std::string& name) {
    for (const auto& [key, value] : a)
      if (key == name)
        return value;
    throw std::runtime_error(name);
  };
  const auto                  mu     = find(a, "test_mu").to_vector<float>();
  const auto                  labels = find(data, "test_labels").to_vector<int>();
  const std::vector<dm::RGBA> colours{
      {37, 99, 235},
      {220, 38, 38},
      {22, 163, 74},
      {147, 51, 234},
      {234, 88, 12},
      {8, 145, 178},
      {190, 24, 93},
      {101, 163, 13},
      {120, 53, 15},
      {75, 85, 99}};
  auto   chart = dm::graphics::RPlot::create();
  double lo = 1e9, hi = -1e9;
  for (int digit = 0; digit < 10; ++digit) {
    std::vector<double> x, y;
    for (int row = 0; row < 200; ++row)
      if (labels[row] == digit) {
        x.push_back(mu[2 * row]);
        y.push_back(mu[2 * row + 1]);
        lo = std::min(lo, double(mu[2 * row]));
        hi = std::max(hi, double(mu[2 * row]));
      }
    chart.points(x, y, std::to_string(digit), colours[digit], 4);
  }
  chart.title("All held-out posterior means / labels only annotate")
      .x_label("mu coordinate 1")
      .y_label("mu coordinate 2")
      .x_limits(lo - .1 * (hi - lo), hi + .45 * (hi - lo))
      .save_svg("build/vanilla_vae_latent.svg");
}
