> Unfiltered reconstructions and target-free prior sampling

Ten evenly spaced heldout indices floor(k×41/9) are shown without quality filtering. Every
column has the original, K1 decode(mu), K5 decode(mu), and the fitting-only pixel mean.
All panels use the same grayscale range[0,1]. Decode(mu) is not E_q[decode(z)], and decoded
probabilities are not sampled binary pixels. The prior gallery uses the same 20 standard-normal
codes for both selected models, directly through GaussianVaeDecode without an image or encoder.

```{cpp, results="markdown", file="figures/iwae_reconstructions.png", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
  namespace n = dm::nn;
  auto data = n::load_npz("build/iwae/data.npz"), one = n::load_npz("build/iwae/k1/outputs.npz"),
       five = n::load_npz("build/iwae/k5/outputs.npz");
  auto find = [](const n::NamedTensors& a, const std::string& key) {
    for (auto& [name, t] : a)
      if (name == key)
        return t;
    throw std::runtime_error(key);
  };
  auto original = find(data, "test_images").reshape({42, 784}),
       a = find(one, "test_mean_prediction"), b = find(five, "test_mean_prediction"),
       mean = n::cast(
           n::mean(n::cast(find(data, "fit_images").reshape({210, 784}), n::DType::Float64), {0}),
           n::DType::Float32);
  std::vector<n::Tensor> panels;
  for (int row = 0; row < 4; ++row)
    for (int col = 0; col < 10; ++col) {
      int index = col * 41 / 9;
      panels.push_back(
          row == 0   ? n::select(original, 0, index)
          : row == 1 ? n::select(a, 0, index)
          : row == 2 ? n::select(b, 0, index)
                     : mean);
    }
  n::save_image_grid(
      n::stack(panels).reshape({40, 28, 28, 1}),
      "build/iwae_reconstructions.png",
      10,
      0,
      1,
      4,
      220. / 255,
      3);
}
