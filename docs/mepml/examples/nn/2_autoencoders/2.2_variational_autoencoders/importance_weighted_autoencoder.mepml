// result_end

Both models start from the same seed2237 arrays, BatchOrder(210,32,2243) and shared noise banks.
Training banks contain five draws per image, seeds2438/2439/2440; K1 takes their first draw and
K5 takes all five. Fixed evaluation banks use 20 draws (fit2411, validation2417, test2423), with
prior seed2429. The explicit MT19937/Box–Muller Float64 bank and its Float32 cast are saved.
Every epoch has six full batches and one final 18-image batch: 21 Adam updates per model,
learning rate0.003, moments0.9/0.999, epsilon1e-8 and independent optimizer state.

Completed epochs1–3 are eligible. **Both** checkpoints minimize the same fixed K20 validation
negative bound, never their differently sampled training objectives. Test pixels and factors
never select an epoch. ESS averages per-case diagnostics in Float64; the scalar bound retains
the source Float32 reduction. Inference uses supplied noise and leaves all weights unchanged.
The editable complete program below calls native forwards and contains the actual gradient,
Adam step, sample selection, validation and checkpoint restore.

```{cpp, results="markdown", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <chrono>
#include <dm/dm.hpp>
#include <fstream>
#include <numeric>
namespace nn = dm::nn;
void Require(bool condition, const std::string& why) {
  if (!condition)
    throw std::runtime_error(why);
}
void Near(double x, double y, double tolerance, const std::string& why) {
  Require(std::abs(x - y) <= tolerance, why);
}
struct BetaFactorData {
  nn::Tensor images, factors, source;
};
struct VaeNoiseBank {
  nn::Tensor standard, epsilon;
};
nn::Tensor Flatten(const nn::Tensor& t) {
  return nn::reshape(t, {t.size(0), 784});
}
nn::Tensor Find(const nn::NamedTensors& a, const std::string& key) {
  for (const auto& [k, v] : a)
    if (k == key)
      return v;
  throw std::runtime_error(key);
}
std::vector<float> Bytes(const nn::Tensor& t) {
  return t.contiguous().to_vector<float>();
}
nn::NamedTensors Arrays(const nn::ParameterStore& p) {
  nn::NamedTensors a;
  for (const auto& k : p.names())
    a.emplace_back(k, p.at(k).detach().clone());
  return a;
}
auto Snapshot(const nn::ParameterStore& p) {
  return p.flatten();
}
nn::NamedTensors CheckGradients(
    const nn::ParameterStore&      p,
    const std::vector<nn::Tensor>& gs,
    const std::string&,
    const std::string&) {
  nn::NamedTensors a;
  Require(gs.size() == p.size(), "all10 gradients");
  const auto names = p.names();
  for (std::size_t i = 0; i < gs.size(); ++i) {
    double norm = 0;
    for (double x : gs[i].to_vector<double>()) {
      Require(std::isfinite(x), "finite derivatives");
      norm += x * x;
    }
    Require(norm > 0, "nonzero derivative in each tensor");
    a.emplace_back(names[i], gs[i]);
  }
  return a;
}
VaeNoiseBank BetaVaeNoise(std::int64_t n, std::int64_t samples, std::uint32_t seed) {
  const auto standard = nn::models::GaussianNoise({n, 4}, samples, seed);
  return {standard, nn::cast(standard, nn::DType::Float32)};
}
nn::Tensor BetaVaeNoiseAt(const VaeNoiseBank& bank, int k) {
  return nn::select(bank.epsilon, 0, k).contiguous();
}

std::vector<nn::Tensor>
Evaluate(nn::ParameterStore& p, const nn::Tensor& images, const nn::Tensor& epsilon) {
  nn::NoGradGuard guard;
  auto            o = nn::models::ImportanceWeightedAutoencoder(p, Flatten(images), epsilon);
  std::vector<nn::Tensor> out{
      o.mu,
      o.log_variance,
      o.z,
      o.probability,
      o.nll,
      o.kl,
      o.loss,
      o.negative_bound,
      o.log_weights,
      o.normalized_weights,
      o.effective_samples};
  for (auto& t : out) {
    t = t.contiguous();
    for (float v : t.to_vector<float>())
      Require(std::isfinite(v), "all eleven IWAE fields finite");
  }
  return out;
}
nn::Tensor Decode(nn::ParameterStore& p, const nn::Tensor& z) {
  nn::NoGradGuard guard;
  return nn::sigmoid(nn::models::GaussianVaeDecode(p, z)).contiguous();
}
nn::Tensor IwaeNoiseRows(
    const VaeNoiseBank&              bank,
    const std::vector<std::int64_t>& rows,
    std::int64_t                     samples) {
  Require(samples > 0 && samples <= bank.epsilon.size(0), "available importance draws");
  return nn::gather(
             nn::slice_axis(bank.epsilon, 0, 0, samples),
             nn::from_vector(rows, {std::int64_t(rows.size())}),
             1)
      .contiguous();
}
std::vector<std::int64_t> IwaeRows(std::int64_t n) {
  std::vector<std::int64_t> rows(n);
  std::iota(rows.begin(), rows.end(), 0);
  return rows;
}
double MaxAbsDiff(const nn::Tensor& a, const nn::Tensor& b, int count) {
  auto   x = Bytes(a), y = Bytes(b);
  double difference = 0;
  for (int i = 0; i < count; ++i)
    difference = std::max(difference, std::abs(double(x[i]) - y[i]));
  return difference;
}
double Mse(const nn::Tensor& a, const nn::Tensor& b) {
  return nn::mean(
             nn::square(
                 nn::cast(Flatten(a), nn::DType::Float64) -
                 nn::cast(Flatten(b), nn::DType::Float64)))
      .item();
}
auto BetaFactorProbe(
    const std::filesystem::path& root,
    const nn::Tensor&            fit,
    const nn::Tensor&            test,
    const nn::Tensor&            factors,
    const nn::Tensor&            targets,
    const nn::Tensor&            lv) {
  auto a = nn::models::LatentFactorDiagnostics(fit, test, factors, targets, lv);
  nn::save_npz((root / "factor_probes.npz").string(), a);
  return std::vector<std::vector<double>>{
      Find(a, "single_r2").to_vector<double>(), Find(a, "ridge_r2").to_vector<double>()};
}
nn::Tensor Prefix(const nn::Tensor& t, std::int64_t n) {
  return nn::slice_axis(t, 0, 0, n).contiguous();
}

void Checks(const std::filesystem::path& root) {
  const std::vector<float> wv{1000, -1000, 1001, -1001, 999, -999};
  auto                     w        = nn::from_vector(wv, {3, 2}).requires_grad_();
  auto                     bound    = -nn::models::IwaeLogMeanExp(w);
  auto                     gradient = nn::grad(nn::mean(bound, {0}), {w})[0];
  auto                     repeated =
      nn::models::IwaeLogMeanExp(nn::tensor({{-700., -800.}, {-700., -800.}, {-700., -800.}}));
  auto       single = nn::models::IwaeLogMeanExp(nn::tensor({{-700., -800.}}));
  const auto bv = bound.to_vector<float>(), gv = gradient.to_vector<float>(),
             rv = repeated.to_vector<float>(), sv = single.to_vector<float>();
  for (int b = 0; b < 2; ++b) {
    double maximum = -std::numeric_limits<double>::infinity();
    for (int k = 0; k < 3; ++k)
      maximum = std::max(maximum, double(wv[k * 2 + b]));
    double sum = 0;
    for (int k = 0; k < 3; ++k)
      sum += std::exp(wv[k * 2 + b] - maximum);
    Near(bv[b], -maximum - std::log(sum / 3), 5e-5, "stable importance bound");
    for (int k = 0; k < 3; ++k)
      Near(
          gv[k * 2 + b],
          -.5 * std::exp(wv[k * 2 + b] - maximum) / sum,
          1e-7,
          "normalized importance gradient");
    Near(rv[b], sv[b], 0, "duplicated identical samples leave bound unchanged");
  }
  nn::save_npz(
      (root / "algebra.npz").string(),
      {{"log_weights", w.detach()},
       {"negative_bound", bound.detach()},
       {"gradient", gradient},
       {"duplicate", repeated},
       {"single", single}});
  std::cout << "IWAE stable extremes/K1/duplicate samples/all normalized partials passed"
            << std::endl;
}

std::vector<double>
Score(nn::ParameterStore& model, const nn::Tensor& images, const VaeNoiseBank& noise) {
  auto   out = Evaluate(model, images, noise.epsilon);
  double ess = 0;
  for (float v : out[10].to_vector<float>())
    ess += v;
  return {double(out[6].item<float>()), ess / double(images.size(0))};
}

double Train(
    int                                samples,
    int                                epochs,
    const std::vector<BetaFactorData>& data,
    const std::vector<VaeNoiseBank>&   training,
    const std::vector<VaeNoiseBank>&   noise,
    const VaeNoiseBank&                prior,
    const std::filesystem::path&       root,
    const nn::NamedTensors&            initial) {
  const auto path = root / ("k" + std::to_string(samples));
  std::filesystem::create_directories(path);
  nn::ParameterStore model(2237);
  for (const auto& [name, value] : initial)
    model.set(name, value.clone());
  nn::OptimizerConfig config;
  config.kind = nn::OptimizerKind::Adam;
  nn::Optimizer optimizer(model, .003, config);
  Require(model.count() == 51416 && model.size() == 10, "same compact VAE census");
  nn::save_npz((path / "initial_arrays.npz").string(), Arrays(model));
  nn::BatchOrder order(210, 32, 2243);
  std::ofstream  history(path / "history.tsv"), batches(path / "batches.tsv");
  history.precision(17);
  history << "epoch\ttrain_preupdate_negative_bound\tvalidation_k20_negative_bound\tvalidation_k20_"
             "ess\n";
  batches << "epoch\tstep\trow\tsource_id\n";
  const auto fit_source = data[0].source.to_vector<int>();
  const auto best_path  = (path / "best.npz").string();
  double     best       = std::numeric_limits<double>::infinity();
  int        selected = 0, step = 0;
  const auto started = std::chrono::steady_clock::now();
  for (int epoch = 1; epoch <= epochs; ++epoch) {
    order.begin_epoch();
    double sum  = 0;
    int    seen = 0;
    for (;;) {
      auto rows = order.next();
      if (rows.empty())
        break;
      auto images  = nn::take_rows(data[0].images, rows);
      auto epsilon = IwaeNoiseRows(training[epoch - 1], rows, samples);
      if (step == 0) {
        nn::save_npz(
            (path / "first_batch.npz").string(), {{"images", images}, {"epsilon", epsilon}});
        auto g = CheckGradients(
            model,
            nn::grad(
                nn::models::ImportanceWeightedAutoencoder(model, Flatten(images), epsilon).loss,
                model.parameters()),
            "all IWAE derivatives finite",
            "all ten tensors receive sampled-density IWAE gradients");
        nn::save_npz((path / "first_gradients.npz").string(), g);
        auto f = Evaluate(model, images, epsilon);
        nn::save_npz(
            (path / "first_forward.npz").string(),
            {{"log_weights", f[8]},
             {"normalized_weights", f[9]},
             {"negative_bound", f[7]},
             {"ess", f[10]}});
      }
      auto train = nn::models::ImportanceWeightedAutoencoder(model, Flatten(images), epsilon);
      sum += double(rows.size()) * train.loss.item<float>();
      optimizer.step(nn::grad(train.loss, model.parameters()));
      seen += int(rows.size());
      for (auto row : rows)
        batches << epoch << '\t' << step << '\t' << row << '\t' << fit_source[row] << '\n';
      if (step == 0)
        nn::save_npz((path / "first_update_arrays.npz").string(), Arrays(model));
      ++step;
    }
    Require(seen == 210, "all fitting images once per epoch");
    auto score = Score(model, data[1].images, noise[1]);
    history << epoch << '\t' << sum / seen << '\t' << score[0] << '\t' << score[1] << '\n';
    nn::save_npz(
        (path / ("epoch" + std::to_string(epoch) + "_arrays.npz")).string(), Arrays(model));
    if (score[0] < best) {
      best     = score[0];
      selected = epoch;
      model.save(best_path); // COMMON fixed K20 validation bound selection
    }
    std::cout << "trainK" << samples << " epoch" << epoch
              << " common validationK20negativebound=" << score[0] << ",ESS=" << score[1]
              << std::endl;
  }
  const double seconds =
      std::chrono::duration<double>(std::chrono::steady_clock::now() - started).count();
  nn::ParameterStore deployed(2237);
  {
    nn::NoGradGuard guard;
    nn::models::BetaVariationalAutoencoder(deployed, nn::zeros({1, 784}), nn::zeros({1, 4}));
  }
  deployed.load(best_path);
  Near(Score(deployed, data[1].images, noise[1])[0], best, 1e-8, "fresh common K20 selected score");
  const auto       before = Snapshot(deployed);
  nn::NamedTensors output;
  for (int split = 0; split < 3; ++split) {
    const std::int64_t n    = data[split].images.size(0);
    const std::string  name = split == 0 ? "fit" : split == 1 ? "validation" : "test";
    auto               mean = Evaluate(deployed, data[split].images, nn::zeros({1, n, 4})),
         draw               = Evaluate(deployed, data[split].images, noise[split].epsilon);
    Require(Bytes(mean[0]) == Bytes(mean[2]), "zero epsilon gives posterior mean");
    auto       mu = Prefix(draw[0], n), lv = Prefix(draw[1], n);
    const auto a = mu.to_vector<float>(), b = lv.to_vector<float>(),
               ma = mean[0].to_vector<float>(), mb = mean[1].to_vector<float>();
    for (std::int64_t i = 0; i < n * 4; ++i) {
      Near(a[i], ma[i], 4e-6, "mu independent of noise/K up to GEMM roundoff");
      Near(b[i], mb[i], 4e-6, "logvariance independent of noise/K up to GEMM roundoff");
    }
    output.emplace_back(name + "_mu", mu);
    output.emplace_back(name + "_log_variance", lv);
    output.emplace_back(name + "_mean_prediction", mean[3]);
    output.emplace_back(name + "_sample_z", draw[2]);
    output.emplace_back(name + "_sample_prediction", draw[3]);
    output.emplace_back(name + "_sample_nll", draw[4]);
    output.emplace_back(name + "_kl", Prefix(draw[5], n));
    output.emplace_back(name + "_log_weights", draw[8]);
    output.emplace_back(name + "_normalized_weights", draw[9]);
    output.emplace_back(name + "_negative_bound", draw[7]);
    output.emplace_back(name + "_ess", draw[10]);
  }
  auto first_noise = IwaeNoiseRows(noise[2], IwaeRows(42), 1);
  auto a           = Evaluate(deployed, data[2].images, first_noise),
       again       = Evaluate(deployed, data[2].images, first_noise);
  Require(
      Bytes(a[3]) == Bytes(again[3]) && Bytes(a[3]) == Bytes(Decode(deployed, a[2])),
      "repeat noise and target-free latent decode exact");
  auto single =
      Evaluate(deployed, nn::take_rows(data[2].images, {0}), IwaeNoiseRows(noise[2], {0}, 1));
  const double parity = MaxAbsDiff(single[3], a[3], 784);
  Require(parity < 2e-6, "single/batch decode parity");
  auto other = Evaluate(deployed, data[2].images, nn::zeros(first_noise.shape()));
  Require(
      Bytes(a[2]) != Bytes(other[2]) && Bytes(a[3]) != Bytes(other[3]),
      "noise changes samples and probabilities");
  auto prior_z    = BetaVaeNoiseAt(prior, 0);
  auto prediction = Decode(deployed, prior_z);
  nn::save_npz((path / "prior.npz").string(), {{"z", prior_z}, {"probability", prediction}});
  auto r2 = BetaFactorProbe(
      path,
      Find(output, "fit_mu"),
      Find(output, "test_mu"),
      data[0].factors,
      data[2].factors,
      Find(output, "fit_log_variance"));
  Require(before == Snapshot(deployed), "all inference and diagnostics immutable");
  nn::save_npz((path / "outputs.npz").string(), output);
  nn::save_npz((path / "model_arrays.npz").string(), Arrays(deployed));
  nn::NamedTensors    estimates;
  std::vector<double> scores;
  for (int k : {1, 5, 20}) {
    auto f = Evaluate(deployed, data[2].images, IwaeNoiseRows(noise[2], IwaeRows(42), k));
    scores.push_back(f[6].item<float>());
    estimates.emplace_back("negative_bound_k" + std::to_string(k), f[7]);
    estimates.emplace_back("ess_k" + std::to_string(k), f[10]);
  }
  nn::save_npz((path / "test_estimates.npz").string(), estimates);
  const double  mse = Mse(Find(output, "test_mean_prediction"), data[2].images);
  std::ofstream meta(path / "metrics.json");
  meta.precision(17);
  meta << "{\"training_samples\":" << samples
       << ",\"evaluation_samples\":20,\"parameters\":51416,\"epochs\":" << epochs
       << ",\"updates\":" << step << ",\"selected_epoch\":" << selected
       << ",\"test_negative_bound_k1\":" << scores[0] << ",\"test_negative_bound_k5\":" << scores[1]
       << ",\"test_negative_bound_k20\":" << scores[2] << ",\"mean_decode_test_mse\":" << mse
       << ",\"single_batch_max_error\":" << parity << ",\"training_seconds\":" << seconds << "}\n";
  Require(bool(meta) && bool(history) && bool(batches), "complete IWAE evidence");
  std::cout << "trainK" << samples << " selected" << selected
            << ",test negative bounds K1/5/20=" << scores[0] << '/' << scores[1] << '/' << scores[2]
            << ",decode(mu)MSE=" << mse << ",ridge R2 shape/size/x/y=" << r2[1][0] << '/'
            << r2[1][1] << '/' << r2[1][2] << '/' << r2[1][3] << std::endl;
  return seconds;
}

int main() {
  const std::filesystem::path root = "build/iwae";
  auto                        data = nn::load_npz((root / "data.npz").string());
  std::vector<BetaFactorData> pools;
  for (const std::string split : {"fit", "validation", "test"})
    pools.push_back(
        {Find(data, split + "_images"),
         Find(data, split + "_factors"),
         Find(data, split + "_source_ids")});
  Checks(root);
  std::vector<VaeNoiseBank> training,
      noise{BetaVaeNoise(210, 20, 2411), BetaVaeNoise(42, 20, 2417), BetaVaeNoise(42, 20, 2423)};
  auto             prior = BetaVaeNoise(20, 1, 2429);
  nn::NamedTensors banks{{"prior_standard", prior.standard}, {"prior_epsilon", prior.epsilon}};
  for (int i = 0; i < 3; ++i) {
    const std::string name = i == 0 ? "fit" : i == 1 ? "validation" : "test";
    banks.emplace_back(name + "_standard", noise[i].standard);
    banks.emplace_back(name + "_epsilon", noise[i].epsilon);
  }
  nn::save_npz((root / "fixed_noise.npz").string(), banks);
  for (int e = 1; e <= 3; ++e) {
    training.push_back(BetaVaeNoise(210, 5, 2437 + e));
    nn::save_npz(
        (root / ("train_noise_epoch" + std::to_string(e) + ".npz")).string(),
        {{"standard", training.back().standard}, {"epsilon", training.back().epsilon}});
  }
  nn::ParameterStore base(2237);
  {
    nn::NoGradGuard guard;
    nn::models::BetaVariationalAutoencoder(base, nn::zeros({1, 784}), nn::zeros({1, 4}));
  }
  auto initial = Arrays(base);
  Train(1, 3, pools, training, noise, prior, root, initial);
  Train(5, 3, pools, training, noise, prior, root, initial);
  std::print(
      "\n| training K | selected epoch | test K1 negative bound | test K5 | test K20 | decode(mu) "
      "MSE | fit-mean MSE |\n|---|---:|---:|---:|---:|---:|---:|\n");
  auto       mean     = nn::mean(nn::cast(Flatten(pools[0].images), nn::DType::Float64), {0});
  auto       control  = nn::broadcast_to(mean, {42, 784});
  const auto baseline = Mse(control, pools[2].images);
  for (int k : {1, 5}) {
    auto path  = root / ("k" + std::to_string(k));
    auto out   = nn::load_npz((path / "outputs.npz").string()),
         est   = nn::load_npz((path / "test_estimates.npz").string());
    std::ifstream history(path/"history.tsv");
    std::string header;std::getline(history,header);
    double epoch,train,validation,ess,best=std::numeric_limits<double>::infinity();int selected=0;
    while(history>>epoch>>train>>validation>>ess)if(validation<best){best=validation;selected=int(epoch);}
    Require(selected>0,"selected epoch is derived from actual validation history");
    std::print(
        "| {} | {} | {:.9f} | {:.9f} | {:.9f} | {:.9f} | {:.9f} |\n",
        k,selected,
        nn::mean(Find(est, "negative_bound_k1")).item(),
        nn::mean(Find(est, "negative_bound_k5")).item(),
        nn::mean(Find(est, "negative_bound_k20")).item(),
        Mse(Find(out, "test_mean_prediction"), pools[2].images),
        baseline);
  }
}
