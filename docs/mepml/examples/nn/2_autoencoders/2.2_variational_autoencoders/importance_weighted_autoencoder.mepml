> Common validation and heldout concentration

K5 has the better finite K20 test estimate after this short fit, but both decode(mu) controls
are worse than the fitting mean. This does not establish generalization gains on a benchmark,
useful disentanglement or a reconstruction improvement. Both selected epochs are 3 because
all three eligible common K20 validation scores decrease. The evaluation noise is fixed;
training K differs while evaluation K is held common. ESS remains close to one despite using
20 draws, exposing weight concentration. K1/K5/K20 estimates for each selected model use
nested prefixes of the same saved bank; no monotonic ordering is enforced.

```{cpp, results="markdown", file="figures/iwae_validation.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
  namespace n = dm::nn;
  std::vector<double> x, loss, ess;
  std::vector<int>    group;
  for (int k : {1, 5}) {
    std::ifstream f("build/iwae/k" + std::to_string(k) + "/history.tsv");
    std::string   line;
    std::getline(f, line);
    for (int e = 1; e <= 3; ++e) {
      double epoch, train, validation, value;
      f >> epoch >> train >> validation >> value;
      if (!f)
        return 1;
      x.push_back(epoch);
      loss.push_back(validation);
      ess.push_back(value);
      group.push_back(k);
    }
  }
  auto plot = dm::graphics::RPlot::create();
  plot.title("Common fixed K20 validation negative bound")
      .x_label("completed epoch")
      .y_label("negative bound / nats per image");
  for (int j = 0; j < 2; ++j) {
    auto start = j * 3;
    plot.lines(
        std::vector<double>(x.begin() + start, x.begin() + start + 3),
        std::vector<double>(loss.begin() + start, loss.begin() + start + 3),
        j ? "training K5" : "training K1",
        j ? dm::RGBA{220, 38, 38} : dm::RGBA{37, 99, 235},
        2);
  }
  plot.save_svg("build/iwae_validation.svg");
  std::print(
      "| training K | test evaluation K | mean ESS | negative bound |\n|---|---:|---:|---:|\n");
  for (int k : {1, 5}) {
    auto a    = n::load_npz("build/iwae/k" + std::to_string(k) + "/test_estimates.npz");
    auto find = [&](const std::string& key) {
      for (auto& [name, t] : a)
        if (name == key)
          return t;
      throw std::runtime_error(key);
    };
    for (int e : {1, 5, 20})
      std::print(
          "| {} | {} | {:.9f} | {:.9f} |\n",
          k,
          e,
          n::mean(n::cast(find("ess_k" + std::to_string(e)), n::DType::Float64)).item(),
          n::mean(find("negative_bound_k" + std::to_string(e))).item());
  }
}
