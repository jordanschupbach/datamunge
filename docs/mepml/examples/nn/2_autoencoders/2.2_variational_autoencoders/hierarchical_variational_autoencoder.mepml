```{cpp, results="markdown", file="figures/hierarchy_reconstructions.png", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
  namespace n = dm::nn;
  auto find   = [](const n::NamedTensors& a, const std::string& k) {
    for (const auto& [name, v] : a)
      if (name == k)
        return v;
    throw std::runtime_error(k);
  };
  const auto data = n::load_npz("build/hierarchy/hierarchical/data.npz"),
             out  = n::load_npz("build/hierarchy/hierarchical/outputs.npz");
  std::vector<std::int64_t> rows;
  for (int k = 0; k < 10; ++k)
    rows.push_back(k * 41 / 9);
  const auto mean = n::mean(n::reshape(find(data, "fit_images"), {210, 784}), {0}, true);
  std::vector<n::Tensor> panels;
  for (const auto& x : std::vector<n::Tensor>{
           find(data, "test_images"),
           find(out, "test_greedy_probability"),
           find(out, "test_draw0_probability"),
           n::broadcast_to(mean, {42, 784})})
    panels.push_back(n::reshape(n::take_rows(x, rows), {10, 28, 28, 1}));
  n::save_image_grid(
      n::concat(panels, 0), "build/hierarchy_reconstructions.png", 10, 0, 1, 4, 220. / 255, 3);
  std::print(
      "Heldout source IDs {}.\n", n::take_rows(find(data, "test_source_ids"), rows).values_str());
}
