Second coordinate 0.055719448; forward logdet .2, inverse -.2; sample logq-logp -0.218447672.
\image(figures/flow_vae_hand.svg)
// result_end

\caption(The unchanged horizontal coordinate and affine vertical transform make area expansion visible. Density divides by exp(.2), so its log correction has the opposite sign.)
\alttext(A blue square and vertically expanded/shifted red rectangle show the affine map with unchanged horizontal coordinates.)

> Sampled negative ELBO and complete inverse checks

For two couplings f0,f1 with fixed image context h(x), z2=f1(f0(z0;h);h), and

$$
\log q_2(z_2|x)=\log q_0(z_0|x)-\log|\det J_0|-\log|\det J_1|,\\
L=\frac1B\sum_b\left[\sum_j\{\operatorname{softplus}(a_{bj})-x_{bj}a_{bj}\}
+\log q_2(z_{2b}|x_b)-\log\mathcal N(z_{2b};0,I)\right].
$$
\alttext(The posterior log density subtracts both forward log determinants. The training loss averages image-wise summed Bernoulli NLL plus the sampled posterior-to-prior log ratio.)

The base diagonal log density is−0.5 sum[(z0−mu)²exp(−l)+l+log(2pi)]. Prior density
uses final z2, not z0. This objective uses a sampled log ratio instead of substituting the
analytic KL of the base Gaussian. Gradients pass through both changes of variables, both
conditioners, shared context, Gaussian heads and decoder. Each scale is bounded by.5;
two four-coordinate layers therefore have total logdet in[−2,2]. Float32 uses the original
float-rounded log(2pi); Float64 uses full precision. No scale clipping or extra regularizer
is added. With binary pixels NLL is Bernoulli negative log likelihood; soft targets would
give cross-entropy instead.

The next program saves full4×4 sample Jacobians from four reverse passes, compares their
log determinants with the analytic sum, inverts the second layer then the first, and checks
zero scale/shift identity. It retains all48 Jacobian entries and unit-flow arrays.

```{cpp, results="markdown", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <chrono>
#include <dm/dm.hpp>
#include <fstream>
#include <iostream>
namespace nn = dm::nn;
void Require(bool condition, const std::string& why) {
  if (!condition)
    throw std::runtime_error(why);
}
void Near(double x, double y, double tolerance, const std::string& why) {
  Require(std::abs(x - y) <= tolerance, why);
}
struct BetaFactorData {
  nn::Tensor images, factors, source;
};
struct VaeNoiseBank {
  nn::Tensor standard, epsilon;
};
nn::Tensor Flatten(const nn::Tensor& t) {
  return nn::reshape(t, {t.size(0), 784});
}
nn::Tensor Find(const nn::NamedTensors& a, const std::string& key) {
  for (const auto& [k, v] : a)
    if (k == key)
      return v;
  throw std::runtime_error(key);
}
std::vector<float> Bytes(const nn::Tensor& t) {
  return t.contiguous().to_vector<float>();
}
nn::NamedTensors Arrays(const nn::ParameterStore& p) {
  nn::NamedTensors a;
  for (const auto& k : p.names())
    a.emplace_back(k, p.at(k).detach().clone());
  return a;
}
auto Snapshot(const nn::ParameterStore& p) {
  return p.flatten();
}
nn::NamedTensors CheckGradients(
    const nn::ParameterStore&      p,
    const std::vector<nn::Tensor>& gs,
    const std::string&,
    const std::string&) {
  nn::NamedTensors a;
  Require(gs.size() == p.size(), "all10 gradients");
  const auto names = p.names();
  for (std::size_t i = 0; i < gs.size(); ++i) {
    double norm = 0;
    for (double x : gs[i].to_vector<double>()) {
      Require(std::isfinite(x), "finite derivatives");
      norm += x * x;
    }
    Require(norm > 0, "nonzero derivative in each tensor");
    a.emplace_back(names[i], gs[i]);
  }
  return a;
}
VaeNoiseBank BetaVaeNoise(std::int64_t n, std::int64_t samples, std::uint32_t seed) {
  const auto standard = nn::models::GaussianNoise({n, 4}, samples, seed);
  return {standard, nn::cast(standard, nn::DType::Float32)};
}
nn::Tensor BetaVaeNoiseAt(const VaeNoiseBank& bank, int k) {
  return nn::select(bank.epsilon, 0, k).contiguous();
}

nn::NamedTensors
Evaluate(nn::ParameterStore& p, const nn::Tensor& images, const nn::Tensor& epsilon) {
  nn::NoGradGuard guard;
  auto fields = nn::models::FlowVariationalAutoencoder(p, Flatten(images), epsilon).Named();
  for (auto& [name, t] : fields) {
    t = t.contiguous();
    for (double v : t.to_vector<double>())
      Require(std::isfinite(v), "finite flow endpoint");
  }
  return fields;
}
nn::Tensor Decode(nn::ParameterStore& p, const nn::Tensor& z) {
  nn::NoGradGuard guard;
  return nn::sigmoid(nn::models::GaussianVaeDecode(p, z)).contiguous();
}
std::vector<double>
FlowVaeScore(nn::ParameterStore& p, const nn::Tensor& images, const VaeNoiseBank& bank) {
  double     nll = 0, ratio = 0, det = 0;
  const auto n = images.size(0), samples = bank.epsilon.size(0);
  for (int k = 0; k < samples; ++k) {
    auto f = Evaluate(p, images, BetaVaeNoiseAt(bank, k));
    auto a = Find(f, "nll").to_vector<float>(), r = Find(f, "logratio").to_vector<float>(),
         d = Find(f, "logdet").to_vector<float>();
    for (int b = 0; b < n; ++b) {
      nll += a[b];
      ratio += r[b];
      det += d[b];
    }
  }
  const double count = double(n * samples);
  return {nll / count, ratio / count, det / count, (nll + ratio) / count};
}
double MaxAbsDiff(const nn::Tensor& a, const nn::Tensor& b, int n) {
  const auto x = Bytes(a), y = Bytes(b);
  double     d = 0;
  for (int i = 0; i < n; ++i)
    d = std::max(d, std::abs(double(x[i]) - y[i]));
  return d;
}
double Mse(const nn::Tensor& a, const nn::Tensor& b) {
  return nn::mean(
             nn::square(
                 nn::cast(Flatten(a), nn::DType::Float64) -
                 nn::cast(Flatten(b), nn::DType::Float64)))
      .item();
}

double Difference(const nn::Tensor& a, const nn::Tensor& b) {
  Require(a.shape() == b.shape(), "matching shapes");
  return MaxAbsDiff(a, b, int(a.numel()));
}
nn::Tensor PixelMean(const nn::Tensor& images) {
  const auto         v = Flatten(images).to_vector<float>();
  std::vector<float> mean(784);
  for (int j = 0; j < 784; ++j) {
    double total = 0;
    for (int b = 0; b < images.size(0); ++b)
      total += v[b * 784 + j];
    mean[j] = float(total / double(images.size(0)));
  }
  return nn::from_vector(mean, {784});
}
nn::Tensor Constant(const nn::Tensor& row, int count) {
  return nn::broadcast_to(nn::reshape(row, {1, 784}), {count, 784}).contiguous();
}
void Checks(const std::filesystem::path& root) {
  nn::ParameterStore       p(3049);
  const std::vector<float> zv{.2f, -.4f, .6f, -.8f, 1.1f, .3f, -.2f, .5f, -.7f, .9f, .4f, -.1f},
      cv{.1f, .2f, -.3f, .5f, .8f, -.6f};
  auto z = nn::from_vector(zv, {3, 4}).requires_grad_(), context = nn::from_vector(cv, {3, 2});
  auto a    = nn::models::ConditionalAffinePosteriorFlow(p, "flow0", z, context),
       b    = nn::models::ConditionalAffinePosteriorFlow(p, "flow1", a.value, context, true);
  auto inv1 = nn::models::ConditionalAffinePosteriorFlow(p, "flow1", b.value, context, true, true),
       inv0 =
           nn::models::ConditionalAffinePosteriorFlow(p, "flow0", inv1.value, context, false, true);
  auto ld  = a.log_determinant + b.log_determinant,
       ild = inv1.log_determinant + inv0.log_determinant;
  p.set("identity/heads/W", nn::zeros({16, 4}));
  p.set("identity/heads/b", nn::zeros({4}));
  auto identity = nn::models::ConditionalAffinePosteriorFlow(p, "identity", z, context);
  std::vector<float> jac(3 * 16);
  for (int j = 0; j < 4; ++j) {
    auto row =
        nn::grad(nn::sum(nn::select(b.value, 1, j)), {z}, nn::GradOptions{true, false, false})[0]
            .to_vector<float>();
    for (int batch = 0; batch < 3; ++batch)
      for (int k = 0; k < 4; ++k)
        jac[batch * 16 + j * 4 + k] = row[batch * 4 + k]; // full 4x4 incl. conditioners
  }
  const auto zd = z.detach();
  Require(Difference(inv0.value, zd) < 2e-6, "conditional flow inverse recovers all inputs");
  Require(Bytes(identity.value) == Bytes(zd), "zero scale/shift is BITEXACT identity");
  const auto lds = ld.to_vector<float>(), ilds = ild.to_vector<float>(),
             ids = identity.log_determinant.to_vector<float>();
  for (int batch = 0; batch < 3; ++batch) {
    const double det =
        nn::det(nn::cast(nn::select(nn::from_vector(jac, {3, 4, 4}), 0, batch), nn::DType::Float64))
            .item();
    Require(det > 0, "positive affine coupling determinant");
    Near(
        std::log(det),
        lds[batch],
        2e-6,
        "fullJacobian determinant equals summed triangular logscales");
    Near(lds[batch] + ilds[batch], 0, 2e-6, "inverse logdet cancels forward");
    Near(ids[batch], 0, 0, "identity logdet exactly0");
  }
  nn::save_npz(
      (root / "flow_algebra.npz").string(),
      {{"z", zd},
       {"context", context},
       {"mapped", b.value.detach()},
       {"logdet", ld.detach()},
       {"inverse", inv0.value.detach()},
       {"inverse_logdet", ild.detach()},
       {"identity", identity.value.detach()},
       {"identity_logdet", identity.log_determinant.detach()},
       {"jacobian", nn::from_vector(jac, {3, 4, 4})}});
  nn::save_npz((root / "unit_flow_arrays.npz").string(), Arrays(p));
  std::cout << "conditional flow fullJacobian/inverse/logdensity-sign/identity checks passed"
            << std::endl;
}

int main() {
  std::filesystem::create_directories("build/flow_vae");
  Checks("build/flow_vae");
}
```
// result_begin: markdown
conditional flow fullJacobian/inverse/logdensity-sign/identity checks passed
// result_end

> Native known-factor lattice and explicit randomness

Native beta-vae-assets preparation creates the294 unique binary28×28 circle/square images:
shape2×size3×x7×y7. A deterministic residue split gives210 fitting,42 validation and42
heldout records, with disjoint source IDs. The development oracle independently regenerates
all230,496 pixels and every factor/source assignment. Factors identify examples only; none
conditions the model or selects an epoch. This teaching lattice is not a paper benchmark.

```{cpp, results="markdown", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
  namespace n = dm::nn;
  std::filesystem::create_directories("build/flow_vae");
  const std::filesystem::path cache = dm::datasets::data_home();
  dm::datasets::prepare_example_data("beta-vae-assets", cache.string());
  auto                       data = n::load_npz((cache / "beta_vae/factors.npz").string());
  std::set<int>              ids;
  std::set<std::vector<int>> pixels;
  for (auto& [name, value] : data) {
    if (name.ends_with("_images")) {
      for (int i = 0; i < value.size(0); ++i)
        if (!pixels.insert(n::select(value, 0, i).to_vector<int>()).second)
          return 1;
      value = n::cast(value, n::DType::Float32);
    }
    if (name.ends_with("_source_ids"))
      for (int id : value.to_vector<int>())
        if (!ids.insert(id).second)
          return 1;
  }
  if (ids.size() != 294 || pixels.size() != 294)
    return 1;
  n::save_npz("build/flow_vae/data.npz", data);
  std::filesystem::copy_file(
      cache / "beta_vae/manifest.json",
      "build/flow_vae/data_manifest.json",
      std::filesystem::copy_options::overwrite_existing);
  std::print("294 unique binary images and IDs: fit210, validation42, test42.\n");
}
```
// result_begin: markdown
294 unique binary images and IDs: fit210, validation42, test42.
// result_end

All eighteen parameter tensors use ordinary Glorot-uniform weights and zero biases, seed3001.
The encoder/Gaussian heads/decoder hold51,416 scalars; each34→16ReLU→4 coupling conditioner
adds628, giving52,672. The creation order is encoder, mu, log variance, flow0, flow1, decoder,
output. Both inverse calls share the same coupling leaves and add no learned parameters.

BatchOrder(210,32,3007) gives seven updates/epoch, with a final18-row batch:21 over three
epochs. Adam uses.003,.9/.999 and1e-8. Fresh per-image training noise uses3042/3043/3044;
four fixed draws use fit3011, validation3019 and test3023. Prior codes use3037. GaussianNoise
uses local MT19937/Box–Muller Float64 values then Float32 casts; both versions are archived.
The model itself draws no noise. Validation averages summed NLL and sampled logq−logp over
all four draws and42 images, accumulating Float32 per-row values in Float64, draw then row.
Only completed epochs1–3 are candidates; test data never select a checkpoint.

The complete fitting/evaluation program keeps every forward, gradient and optimizer step visible.
After fresh-store restore it checks density signs, round trips, fixed-noise repeatability,
changed-noise sensitivity, code-only decode and single/batch parity. Every field for zero noise
and each of four draws is archived in all three pools. Inverse and prior inference leave all
model parameters unchanged.

```{cpp, results="markdown", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <chrono>
#include <dm/dm.hpp>
#include <fstream>
#include <iostream>
namespace nn = dm::nn;
void Require(bool condition, const std::string& why) {
  if (!condition)
    throw std::runtime_error(why);
}
void Near(double x, double y, double tolerance, const std::string& why) {
  Require(std::abs(x - y) <= tolerance, why);
}
struct BetaFactorData {
  nn::Tensor images, factors, source;
};
struct VaeNoiseBank {
  nn::Tensor standard, epsilon;
};
nn::Tensor Flatten(const nn::Tensor& t) {
  return nn::reshape(t, {t.size(0), 784});
}
nn::Tensor Find(const nn::NamedTensors& a, const std::string& key) {
  for (const auto& [k, v] : a)
    if (k == key)
      return v;
  throw std::runtime_error(key);
}
std::vector<float> Bytes(const nn::Tensor& t) {
  return t.contiguous().to_vector<float>();
}
nn::NamedTensors Arrays(const nn::ParameterStore& p) {
  nn::NamedTensors a;
  for (const auto& k : p.names())
    a.emplace_back(k, p.at(k).detach().clone());
  return a;
}
auto Snapshot(const nn::ParameterStore& p) {
  return p.flatten();
}
nn::NamedTensors CheckGradients(
    const nn::ParameterStore&      p,
    const std::vector<nn::Tensor>& gs,
    const std::string&,
    const std::string&) {
  nn::NamedTensors a;
  Require(gs.size() == p.size(), "all10 gradients");
  const auto names = p.names();
  for (std::size_t i = 0; i < gs.size(); ++i) {
    double norm = 0;
    for (double x : gs[i].to_vector<double>()) {
      Require(std::isfinite(x), "finite derivatives");
      norm += x * x;
    }
    Require(norm > 0, "nonzero derivative in each tensor");
    a.emplace_back(names[i], gs[i]);
  }
  return a;
}
VaeNoiseBank BetaVaeNoise(std::int64_t n, std::int64_t samples, std::uint32_t seed) {
  const auto standard = nn::models::GaussianNoise({n, 4}, samples, seed);
  return {standard, nn::cast(standard, nn::DType::Float32)};
}
nn::Tensor BetaVaeNoiseAt(const VaeNoiseBank& bank, int k) {
  return nn::select(bank.epsilon, 0, k).contiguous();
}

nn::NamedTensors
Evaluate(nn::ParameterStore& p, const nn::Tensor& images, const nn::Tensor& epsilon) {
  nn::NoGradGuard guard;
  auto fields = nn::models::FlowVariationalAutoencoder(p, Flatten(images), epsilon).Named();
  for (auto& [name, t] : fields) {
    t = t.contiguous();
    for (double v : t.to_vector<double>())
      Require(std::isfinite(v), "finite flow endpoint");
  }
  return fields;
}
nn::Tensor Decode(nn::ParameterStore& p, const nn::Tensor& z) {
  nn::NoGradGuard guard;
  return nn::sigmoid(nn::models::GaussianVaeDecode(p, z)).contiguous();
}
std::vector<double>
FlowVaeScore(nn::ParameterStore& p, const nn::Tensor& images, const VaeNoiseBank& bank) {
  double     nll = 0, ratio = 0, det = 0;
  const auto n = images.size(0), samples = bank.epsilon.size(0);
  for (int k = 0; k < samples; ++k) {
    auto f = Evaluate(p, images, BetaVaeNoiseAt(bank, k));
    auto a = Find(f, "nll").to_vector<float>(), r = Find(f, "logratio").to_vector<float>(),
         d = Find(f, "logdet").to_vector<float>();
    for (int b = 0; b < n; ++b) {
      nll += a[b];
      ratio += r[b];
      det += d[b];
    }
  }
  const double count = double(n * samples);
  return {nll / count, ratio / count, det / count, (nll + ratio) / count};
}
double MaxAbsDiff(const nn::Tensor& a, const nn::Tensor& b, int n) {
  const auto x = Bytes(a), y = Bytes(b);
  double     d = 0;
  for (int i = 0; i < n; ++i)
    d = std::max(d, std::abs(double(x[i]) - y[i]));
  return d;
}
double Mse(const nn::Tensor& a, const nn::Tensor& b) {
  return nn::mean(
             nn::square(
                 nn::cast(Flatten(a), nn::DType::Float64) -
                 nn::cast(Flatten(b), nn::DType::Float64)))
      .item();
}

double Difference(const nn::Tensor& a, const nn::Tensor& b) {
  Require(a.shape() == b.shape(), "matching shapes");
  return MaxAbsDiff(a, b, int(a.numel()));
}
nn::Tensor PixelMean(const nn::Tensor& images) {
  const auto         v = Flatten(images).to_vector<float>();
  std::vector<float> mean(784);
  for (int j = 0; j < 784; ++j) {
    double total = 0;
    for (int b = 0; b < images.size(0); ++b)
      total += v[b * 784 + j];
    mean[j] = float(total / double(images.size(0)));
  }
  return nn::from_vector(mean, {784});
}
nn::Tensor Constant(const nn::Tensor& row, int count) {
  return nn::broadcast_to(nn::reshape(row, {1, 784}), {count, 784}).contiguous();
}

int main() {
  const std::filesystem::path root   = "build/flow_vae";
  const int                   epochs = 3;
  const auto                  data   = nn::load_npz((root / "data.npz").string());
  std::vector<BetaFactorData> pools;
  for (const std::string split : {"fit", "validation", "test"})
    pools.push_back(
        {Find(data, split + "_images"),
         Find(data, split + "_factors"),
         Find(data, split + "_source_ids")});
  std::vector<VaeNoiseBank> noise{
      BetaVaeNoise(210, 4, 3011), BetaVaeNoise(42, 4, 3019), BetaVaeNoise(42, 4, 3023)},
      training;
  auto             prior_noise = BetaVaeNoise(20, 1, 3037);
  nn::NamedTensors fixed{
      {"prior_standard", prior_noise.standard}, {"prior_epsilon", prior_noise.epsilon}};
  for (int i = 0; i < 3; ++i) {
    const std::string name = i == 0 ? "fit" : i == 1 ? "validation" : "test";
    fixed.emplace_back(name + "_standard", noise[i].standard);
    fixed.emplace_back(name + "_epsilon", noise[i].epsilon);
  }
  nn::save_npz((root / "fixed_noise.npz").string(), fixed);
  for (int epoch = 1; epoch <= epochs; ++epoch) {
    training.push_back(BetaVaeNoise(210, 1, 3041 + epoch));
    nn::save_npz(
        (root / ("train_noise_epoch" + std::to_string(epoch) + ".npz")).string(),
        {{"standard", training.back().standard}, {"epsilon", training.back().epsilon}});
  }
  nn::ParameterStore model(3001);
  {
    nn::NoGradGuard guard;
    nn::models::FlowVariationalAutoencoder(model, nn::zeros({1, 784}), nn::zeros({1, 4}));
  }
  nn::OptimizerConfig config;
  config.kind = nn::OptimizerKind::Adam;
  nn::Optimizer optimizer(model, .003, config);
  Require(
      model.count() == 52672 && model.size() == 18,
      "two conditional affine posterior layers census");
  nn::save_npz((root / "initial_arrays.npz").string(), Arrays(model));
  nn::BatchOrder order(210, 32, 3007);
  std::ofstream  history(root / "history.tsv"), batches(root / "batches.tsv");
  history.precision(17);
  history << "epoch\ttrain_preupdate_negative_elbo\tvalidation_nll\tvalidation_logq_minus_"
             "logp\tvalidation_logdet\t"
             "validation_negative_elbo\n";
  batches << "epoch\tstep\trow\tsource_id\n";
  const auto fit_source = pools[0].source.to_vector<int>();
  const auto best_path  = (root / "best.npz").string();
  double     best       = std::numeric_limits<double>::infinity();
  int        selected = 0, step = 0;
  const auto started = std::chrono::steady_clock::now();
  for (int epoch = 1; epoch <= epochs; ++epoch) {
    order.begin_epoch();
    auto   epsilon = BetaVaeNoiseAt(training[epoch - 1], 0);
    double sum     = 0;
    int    seen    = 0;
    for (;;) {
      auto rows = order.next();
      if (rows.empty())
        break;
      auto images = nn::take_rows(pools[0].images, rows), e = nn::take_rows(epsilon, rows);
      if (step == 0) {
        nn::save_npz((root / "first_batch.npz").string(), {{"images", images}, {"epsilon", e}});
        auto g = CheckGradients(
            model,
            nn::grad(
                nn::models::FlowVariationalAutoencoder(model, Flatten(images), e).loss,
                model.parameters()),
            "all flow gradients finite",
            "all18posterior/conditioner/decoder tensors receive derivatives");
        nn::save_npz((root / "first_gradients.npz").string(), g);
        nn::save_npz((root / "first_forward.npz").string(), Evaluate(model, images, e));
      }
      const auto out = nn::models::FlowVariationalAutoencoder(model, Flatten(images), e);
      sum += double(rows.size()) * out.loss.item<float>();
      const auto gradients = nn::grad(out.loss, model.parameters());
      optimizer.step(gradients);
      seen += int(rows.size());
      for (auto row : rows)
        batches << epoch << '\t' << step << '\t' << row << '\t' << fit_source[row] << '\n';
      if (step == 0)
        nn::save_npz((root / "first_update_arrays.npz").string(), Arrays(model));
      ++step;
    }
    Require(seen == 210, "all fit images once per epoch");
    auto score = FlowVaeScore(model, pools[1].images, noise[1]);
    history << epoch << '\t' << sum / seen;
    for (double value : score)
      history << '\t' << value;
    history << '\n';
    nn::save_npz(
        (root / ("epoch" + std::to_string(epoch) + "_arrays.npz")).string(), Arrays(model));
    if (score[3] < best) {
      best     = score[3];
      selected = epoch;
      model.save(best_path); // four-draw validation Monte Carlo negative ELBO selection
    }
    std::cout << "epoch" << epoch << ":validation NLL=" << score[0] << ",logratio=" << score[1]
              << ",logdet=" << score[2] << ",negativeELBO=" << score[3] << std::endl;
  }
  const double seconds =
      std::chrono::duration<double>(std::chrono::steady_clock::now() - started).count();
  nn::ParameterStore deployed(3001);
  {
    nn::NoGradGuard guard;
    nn::models::FlowVariationalAutoencoder(deployed, nn::zeros({1, 784}), nn::zeros({1, 4}));
  }
  deployed.load(best_path);
  Near(
      FlowVaeScore(deployed, pools[1].images, noise[1])[3],
      best,
      1e-8,
      "fresh selected negativeELBO");
  const auto       before = Snapshot(deployed);
  nn::NamedTensors output;
  double           inverse_error = 0, inverse_logdet_error = 0,
         min_ratio = std::numeric_limits<double>::infinity();
  for (int split = 0; split < 3; ++split) {
    const std::int64_t n             = pools[split].images.size(0);
    const std::string  name          = split == 0 ? "fit" : split == 1 ? "validation" : "test";
    auto               deterministic = Evaluate(deployed, pools[split].images, nn::zeros({n, 4}));
    Require(
        Bytes(Find(deterministic, "z0")) == Bytes(Find(deterministic, "mu")),
        "zero base noise gives z0=mu,not flowed posterior mean");
    for (const auto& [key, value] : deterministic)
      output.emplace_back(name + "_zero_" + key, value);
    for (int k = 0; k < 4; ++k) {
      auto f = Evaluate(deployed, pools[split].images, BetaVaeNoiseAt(noise[split], k));
      Require(
          Bytes(Find(f, "context")) == Bytes(Find(deterministic, "context")) &&
              Bytes(Find(f, "mu")) == Bytes(Find(deterministic, "mu")),
          "base posterior/context independent of Gaussian draw");
      inverse_error    = std::max(inverse_error, Difference(Find(f, "z0"), Find(f, "inverse_z0")));
      const auto ld    = Find(f, "logdet").to_vector<float>(),
                 ild   = Find(f, "inverse_logdet").to_vector<float>(),
                 ratio = Find(f, "logratio").to_vector<float>(),
                 logq  = Find(f, "logq").to_vector<float>(),
                 logq0 = Find(f, "logq0").to_vector<float>();
      for (std::int64_t b = 0; b < n; ++b) {
        Require(std::abs(ld[b]) <= 2.00001, "two-layer bounded logdet within[-2,2]");
        inverse_logdet_error = std::max(inverse_logdet_error, std::abs(double(ld[b]) + ild[b]));
        min_ratio            = std::min(min_ratio, double(ratio[b]));
        Near(logq[b], double(logq0[b]) - ld[b], 2e-6, "change-of-variables MINUS forward logdet");
      }
      for (const auto& [key, value] : f)
        output.emplace_back(name + "_draw" + std::to_string(k) + "_" + key, value);
    }
  }
  Require(
      inverse_error < 3e-5 && inverse_logdet_error < 2e-5,
      "trained conditional flow roundtrip and inverse logdet cancellation");
  auto test         = Evaluate(deployed, pools[2].images, BetaVaeNoiseAt(noise[2], 0)),
       repeat       = Evaluate(deployed, pools[2].images, BetaVaeNoiseAt(noise[2], 0)),
       other        = Evaluate(deployed, pools[2].images, BetaVaeNoiseAt(noise[2], 1));
  const auto test_p = Find(test, "probability");
  Require(
      Bytes(test_p) == Bytes(Find(repeat, "probability")) &&
          Bytes(test_p) == Bytes(Decode(deployed, Find(test, "z"))),
      "fixednoise repeat and flowed-z-only decode BITEXACT");
  Require(
      Bytes(Find(test, "z")) != Bytes(Find(other, "z")) &&
          Bytes(test_p) != Bytes(Find(other, "probability")),
      "changed base noise changes flowed latent and image probabilities");
  auto single = Evaluate(
      deployed,
      nn::take_rows(pools[2].images, {0}),
      nn::take_rows(BetaVaeNoiseAt(noise[2], 0), {0}));
  const double parity = Difference(Find(single, "probability"), nn::take_rows(test_p, {0}));
  Require(parity < 2e-6, "flow VAE single/batch parity");
  auto prior_z = BetaVaeNoiseAt(prior_noise, 0);
  auto prior   = Decode(deployed, prior_z);
  nn::save_npz((root / "prior.npz").string(), {{"z", prior_z}, {"probability", prior}});
  Require(before == Snapshot(deployed), "all posterior/inverse/PRIOR decoding calls immutable");
  nn::save_npz((root / "outputs.npz").string(), output);
  nn::save_npz((root / "model_arrays.npz").string(), Arrays(deployed));
  auto          score  = FlowVaeScore(deployed, pools[2].images, noise[2]);
  auto          mean   = Constant(PixelMean(pools[0].images), 42);
  const auto    zero_p = Find(output, "test_zero_probability");
  const double  mse = Mse(zero_p, pools[2].images), mean_mse = Mse(mean, pools[2].images);
  std::ofstream meta(root / "metrics.json");
  meta.precision(17);
  meta << "{\"parameters\":52672,\"tensors\":18,\"flow_layers\":2,\"latent_dimensions\":4,"
          "\"epochs\":"
       << epochs << ",\"updates\":" << step << ",\"selected_epoch\":" << selected
       << ",\"mc_samples\":4,\"test_nll\":" << score[0]
       << ",\"test_mc_logq_minus_logp\":" << score[1]
       << ",\"test_mean_forward_logdet\":" << score[2] << ",\"test_negative_elbo\":" << score[3]
       << ",\"decode_f_mu_test_mse\":" << mse << ",\"fit_mean_test_mse\":" << mean_mse
       << ",\"maximum_inverse_error\":" << inverse_error
       << ",\"maximum_inverse_logdet_error\":" << inverse_logdet_error
       << ",\"minimum_case_logratio\":" << min_ratio << ",\"single_batch_max_error\":" << parity
       << ",\"training_seconds\":" << seconds << "}\n";

  std::print(
      "| selected epoch | test NLL | sampled logq-logp | mean logdet | negative ELBO | decode(fmu) "
      "MSE | fit mean MSE |\n|---:|---:|---:|---:|---:|---:|---:|\n| {} | {:.9f} | {:.9f} | {:.9f} "
      "| {:.9f} | {:.9f} | {:.9f} |\n",
      selected,
      score[0],
      score[1],
      score[2],
      score[3],
      mse,
      mean_mse);
}
```
