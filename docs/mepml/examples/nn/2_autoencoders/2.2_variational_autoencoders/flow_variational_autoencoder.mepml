Ten evenly spaced heldout rows floor(k×41/9), without quality filtering, appear below.
Rows are original, decode(f(mu)), draw0 posterior probabilities and fitting-only pixel mean.
All use fixed gray range[0,1] and nearest-neighbour enlargement. These probabilities are
neither sampled binary images nor likelihood estimates.

```{cpp, results="markdown", file="figures/flow_vae_reconstructions.png", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
  namespace n = dm::nn;
  auto find   = [](const n::NamedTensors& a, const std::string& k) {
    for (const auto& [name, v] : a)
      if (name == k)
        return v;
    throw std::runtime_error(k);
  };
  const auto data = n::load_npz("build/flow_vae/data.npz"),
             out  = n::load_npz("build/flow_vae/outputs.npz");
  std::vector<std::int64_t> rows;
  for (int k = 0; k < 10; ++k)
    rows.push_back(k * 41 / 9);
  auto mean = n::mean(n::reshape(find(data, "fit_images"), {210, 784}), {0}, true);
  std::vector<n::Tensor> panels;
  for (const auto& x : std::vector<n::Tensor>{
           find(data, "test_images"),
           find(out, "test_zero_probability"),
           find(out, "test_draw0_probability"),
           n::broadcast_to(mean, {42, 784})})
    panels.push_back(n::reshape(n::take_rows(x, rows), {10, 28, 28, 1}));
  n::save_image_grid(
      n::concat(panels, 0), "build/flow_vae_reconstructions.png", 10, 0, 1, 4, 220. / 255, 3);
  std::print(
      "Heldout source IDs {}.\n", n::take_rows(find(data, "test_source_ids"), rows).values_str());
}
