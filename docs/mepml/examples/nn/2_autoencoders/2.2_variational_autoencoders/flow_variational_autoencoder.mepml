      .node("h", {6, 0}, "ReLU encoder context\n32 coordinates", wide)
      .node("z0", {0, -4}, "Gaussian heads + epsilon\nz0 = mu + exp(l/2) epsilon", wide)
      .node("z1", {6, -4}, "Conditional coupling0\nKeep first half", wide)
      .node("z2", {12, -4}, "Conditional coupling1\nKeep second half", wide)
      .node("dec", {18, -4}, "Final-code-only decoder\nBernoulli probabilities", wide)
      .node("density", {12, 0}, "log q2 = log q0 - logdet\nlog p at final z2", wide)
      .node("prior", {18, 0}, "Generation: z2 ~ N(0,I)\nNo posterior flow", wide)
      .edge("x", "h")
      .edge("h", "z0")
