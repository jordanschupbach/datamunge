| 0.5 | 3 | 395.865090870 | 10.372269137 | 0.406245336 | 404.910552979 | 406.237358093 | 0.152413267 |
| 1.0 | 3 | 399.662248521 | 10.607052814 | 0.415610597 | 403.818367004 | 410.269317627 | 0.154711297 |
