// result_end

> Selected results and weak short-run behaviour

Both select epoch3. Own-objective values cannot rank alpha0.5 against alpha1 as comparable
ELBOs. Their separate diagnostic negative ELBOs are 406.237358/410.269318, and aggregate
MMD is 0.406245/0.415611 on the fixed test draws. MMD remains positive and substantial:
these short runs do not establish aggregate prior matching. Both mean-code reconstructions
are worse than the fitting-mean baseline, and the unfiltered galleries retain those failures.

```{cpp, results="markdown", file="figures/info_validation.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
  auto chart = dm::graphics::RPlot::create();
  for (const std::string model : {"info_vae", "mmd_vae"}) {
    std::ifstream f("build/info_vae/" + model + "/history.tsv");
    std::string   line;
    std::getline(f, line);
    std::vector<double> epoch, diagnostic;
    while (std::getline(f, line)) {
      std::istringstream row(line);
      double             e, nll, kl, mmd, objective, elbo;
      row >> e >> nll >> kl >> mmd >> objective >> elbo;
      if (!row)
        return 1;
      epoch.push_back(e);
      diagnostic.push_back(elbo);
    }
    chart.lines(
        epoch,
        diagnostic,
        model,
        model == "info_vae" ? dm::RGBA{37, 99, 235} : dm::RGBA{220, 38, 38},
        2);
  }
  chart.title("Shared diagnostic / not checkpoint selection")
      .x_label("completed epoch")
      .y_label("four-draw validation NLL + KL / nats")
      .save_svg("build/info_validation.svg");
}
