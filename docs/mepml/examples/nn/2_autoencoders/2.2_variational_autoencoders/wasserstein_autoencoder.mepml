> Keep every held-out gallery row and the constant baseline

Each row below is target, reconstruction, absolute error and fitting-only mean. Ten test
rows are evenly spaced in source order, without quality ranking; all panels use fixed 0–1
gray. Decoder values are not Bernoulli pixel draws. The fitting mean is computed only from
210 fitting images, and every test image receives the same baseline.

```{cpp, results="markdown", file="figures/wae_reconstructions.png", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
  namespace n     = dm::nn;
  const auto data = n::load_npz("build/wae/data.npz"), out = n::load_npz("build/wae/outputs.npz");
  auto       find = [](const n::NamedTensors& a, const std::string& name) {
    for (const auto& [key, value] : a)
      if (key == name)
        return value;
    throw std::runtime_error(name);
  };
  const auto x = find(data, "test_images").reshape({42, 784}), rec = find(out, "test_probability");
  const auto mean = n::cast(
      n::mean(n::cast(find(data, "fit_images").reshape({210, 784}), n::DType::Float64), {0}),
      n::DType::Float32);
  const std::vector<n::Tensor> columns{
      x, rec, n::abs(x - rec), n::broadcast_to(mean.reshape({1, 784}), {42, 784})};
  std::vector<n::Tensor> panels;
  const auto             ids = find(data, "test_source_ids").to_vector<int>();
  std::print("Displayed source IDs:");
  for (int k = 0; k < 10; ++k) {
    const int row = k * 41 / 9;
    std::print(" {}", ids[row]);
    for (const auto& c : columns)
      panels.push_back(n::take_rows(c, {row}));
  }
  std::print(".\n");
  n::save_image_grid(
      n::concat(panels, 0).reshape({40, 28, 28, 1}),
      "build/wae_reconstructions.png",
      4,
      0,
      1,
      4,
      220. / 255.,
      3);
}
