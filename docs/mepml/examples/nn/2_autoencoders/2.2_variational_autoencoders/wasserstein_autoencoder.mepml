> Twenty target-free prior decodes

This program rebuilds the exact seed 3749 Gaussian bank, checks its Float32 codes against the
saved prior archive, restores **only four decoder leaves**, and checks every output value.
It creates neither an encoder nor targets. All twenty probability images appear in draw
order, without rejection, resampling or quality selection.

```{cpp, results="markdown", file="figures/wae_priors.png", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
  namespace n = dm::nn;
  n::NoGradGuard guard;
  const auto     arrays = n::load_npz("build/wae/model_arrays.npz"),
             saved      = n::load_npz("build/wae/prior.npz");
  auto find             = [](const n::NamedTensors& a, const std::string& name) {
    for (const auto& [key, value] : a)
      if (key == name)
        return value;
    throw std::runtime_error(name);
  };
  const auto standard = n::models::GaussianNoise({20, 4}, 1, 3749),
             z        = n::select(n::cast(standard, n::DType::Float32), 0, 0).contiguous();
  if (!n::equal_bits(z, find(saved, "z")))
    return 1;
  n::ParameterStore decoder(3701);
  n::models::WaeDecode(decoder, z);
  for (const auto& name : decoder.names())
    decoder.set(name, find(arrays, name));
  if (decoder.size() != 4 || decoder.count() != 13408)
    return 1;
  const auto images = n::sigmoid(n::models::WaeDecode(decoder, z));
  if (!n::equal_bits(images, find(saved, "probability")))
    return 1;
  n::save_image_grid(
      images.reshape({20, 28, 28, 1}), "build/wae_priors.png", 5, 0, 1, 4, 220. / 255., 4);
}
```
