> Keep reconstruction failures and unused codes visible

Each row below is original, reconstruction probability, absolute error, fitting-only mean
and a nearest-expanded 7×7 ID grid. Ten test rows are evenly spaced in source order, not
ranked by quality. Fixed 0–1 grayscale applies to image/error columns; IDs use ID/15 only
for display. Their numerical brightness is not an ordering of semantics. Reconstructions
are Bernoulli probabilities, not sampled binary pixels. The poor MSE remains visible.

```{cpp, results="markdown", file="figures/vq_vae_reconstructions.png", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
  namespace n     = dm::nn;
  const auto data = n::load_npz("build/vq_vae/data.npz"),
             out  = n::load_npz("build/vq_vae/outputs.npz");
  auto find       = [](const n::NamedTensors& a, const std::string& name) {
    for (const auto& [key, value] : a)
      if (key == name)
        return value;
    throw std::runtime_error(name);
  };
  const auto x = find(data, "test_images").reshape({42, 784}), rec = find(out, "test_probability");
  const auto mean = n::cast(
      n::mean(n::cast(find(data, "fit_images").reshape({210, 784}), n::DType::Float64), {0}),
      n::DType::Float32);
  const auto expanded =
      n::upsample_nearest(
          n::cast(find(out, "test_index_grid").reshape({42, 7, 7, 1}), n::DType::Float32) / 15., 4)
          .reshape({42, 784});
  const std::vector<n::Tensor> columns{
      x, rec, n::abs(x - rec), n::broadcast_to(mean.reshape({1, 784}), {42, 784}), expanded};
  const auto             ids = find(data, "test_source_ids").to_vector<int>();
  std::vector<n::Tensor> panels;
  std::print("Displayed source IDs:");
  for (int k = 0; k < 10; ++k) {
    const int row = k * 41 / 9;
    std::print(" {}", ids[row]);
    for (const auto& c : columns)
      panels.push_back(n::take_rows(c, {row}));
  }
  std::print(".\n");
  n::save_image_grid(
      n::concat(panels, 0).reshape({50, 28, 28, 1}),
      "build/vq_vae_reconstructions.png",
      5,
      0,
      1,
      4,
      220. / 255.,
      3);
}
