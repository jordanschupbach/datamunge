// result_end

\caption(All inputs are prepared and read through datamunge. The complete program also checks each source ID, factor coordinate and pixel against the canonical KnownFactorLattice.)

Seed 2707 creates nine leaves and 805 scalars: encoder1 80, encoder2 292, dictionary64,
decoder1 296 and output73. BatchOrder(210,32,2711) gives seven batches per epoch, including
an 18-image final batch. Three epochs make **21 Adam steps**, rate 0.003, moments 0.9/0.999,
epsilon 1e-8. There is no stochastic posterior bank. The selected network is deterministic.

All completed epochs 1–3 are eligible. Validation reconstruction NLL selects the checkpoint;
it excludes dictionary and commitment penalties. A fresh model restores all nine leaves.
Only after selection does a smoothed raster prior fit the **fitting** ID grids. Model restore
is distinct from optimizer-state resume. The adapters below package data, checkpoints and
endpoint records; the actual forward, loss, reverse mode and update are visible in the loop.

```{cpp, results="markdown", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
namespace nn = dm::nn;
namespace ae {
void Require(bool ok, const std::string& why) {
  if (!ok)
    throw std::runtime_error(why);
}
void Near(double a, double b, double tol, const std::string& why) {
  Require(std::abs(a - b) <= tol, why);
}
nn::Tensor Find(const nn::NamedTensors& a, const std::string& name) {
  for (const auto& [key, value] : a)
    if (key == name)
      return value;
  throw std::runtime_error(name);
}
struct BetaFactorData {
  nn::Tensor images, factors, source;
};
std::vector<BetaFactorData> LoadBetaFactors(const std::filesystem::path& root) {
  const auto arrays = nn::load_npz((root / "factors.npz").string()),
             known  = nn::models::KnownFactorLattice();
  std::vector<BetaFactorData> result;
  std::set<int>               seen;
  for (const std::string split : {"fit", "validation", "test"}) {
    const int  n   = split == "fit" ? 210 : 42;
    const auto raw = Find(arrays, split + "_images"), f = Find(arrays, split + "_factors"),
               ids = Find(arrays, split + "_source_ids");
    Require(
        raw.shape() == nn::Shape{n, 28, 28, 1} && f.shape() == nn::Shape{n, 4} &&
            f.dtype() == nn::DType::Int32 && ids.shape() == nn::Shape{n} &&
            ids.dtype() == nn::DType::Int32,
        "complete lattice schema");
    const auto                canonical_ids = Find(known, split + "_source_ids").to_vector<int>();
    std::vector<std::int64_t> rows;
    for (int id : ids.to_vector<int>()) {
      auto where = std::find(canonical_ids.begin(), canonical_ids.end(), id);
      Require(
          where != canonical_ids.end() && seen.insert(id).second,
          "unique identity in correct split");
      rows.push_back(where - canonical_ids.begin());
    }
    const auto x = nn::take_rows(Find(known, split + "_images"), rows);
    Require(
        nn::equal_bits(nn::cast(raw, nn::DType::Float32), x) &&
            nn::equal_bits(f, nn::take_rows(Find(known, split + "_factors"), rows)),
        "all factor coordinates and binary pixels match the core lattice");
    result.push_back({x, f, ids});
  }
  Require(seen.size() == 294, "exhaustive lattice");
  return result;
}
void SaveFactorData(const std::filesystem::path& root, const std::vector<BetaFactorData>& pools) {
  nn::NamedTensors arrays;
  for (int k = 0; k < 3; ++k) {
    const std::string s = k == 0 ? "fit" : k == 1 ? "validation" : "test";
    arrays.emplace_back(s + "_images", pools[k].images);
    arrays.emplace_back(s + "_factors", pools[k].factors);
    arrays.emplace_back(s + "_source_ids", pools[k].source);
  }
  nn::save_npz((root / "data.npz").string(), arrays);
}
nn::NamedTensors Arrays(const nn::ParameterStore& p) {
  nn::NamedTensors a;
  for (const auto& name : p.names())
    a.emplace_back(name, p.at(name).detach().clone());
  return a;
}
auto Snapshot(const nn::ParameterStore& p) {
  return p.flatten();
}
double VqDifference(const nn::Tensor& a, const nn::Tensor& b) {
  Require(a.shape() == b.shape(), "matching shapes");
  return nn::max(nn::abs(a - b)).item();
}
double Mse(const nn::Tensor& a, const nn::Tensor& b) {
  return nn::mean(
             nn::square(
                 nn::cast(a.reshape({a.size(0), 784}), nn::DType::Float64) -
                 nn::cast(b.reshape({b.size(0), 784}), nn::DType::Float64)))
      .item();
}
nn::Tensor PixelMean(const nn::Tensor& x) {
  return nn::cast(
      nn::mean(nn::cast(x.reshape({x.size(0), 784}), nn::DType::Float64), {0}), nn::DType::Float32);
}
nn::Tensor Constant(const nn::Tensor& row, int n) {
  return nn::broadcast_to(row.reshape({1, 784}), {n, 784}).contiguous();
}
using nn::models::VectorQuantize;
void Warm(nn::ParameterStore& p) {
  nn::NoGradGuard guard;
  nn::models::VectorQuantizedAutoencoder(p, nn::zeros({1, 28, 28, 1}));
}
nn::NamedTensors Evaluate(nn::ParameterStore& p, const nn::Tensor& images) {
  nn::NoGradGuard  guard;
  const auto       o = nn::models::VectorQuantizedAutoencoder(p, images);
  nn::NamedTensors fields{
      {"encoded", o.encoded},
      {"indices", o.vq.indices},
      {"quantized", o.vq.quantized},
      {"straight_through", o.vq.straight_through},
      {"probability", o.probability},
      {"nll", o.nll},
      {"reconstruction_loss", o.reconstruction_loss},
      {"codebook_loss", o.vq.codebook_loss},
      {"commitment_loss", o.vq.commitment_loss},
      {"loss", o.loss}};
  for (auto& [name, value] : fields) {
    value = value.contiguous();
    for (double x : value.to_vector<double>())
      Require(std::isfinite(x), "all VQ endpoints finite");
  }
  return fields;
}
nn::Tensor Decode(nn::ParameterStore& p, const nn::Tensor& ids) {
  nn::NoGradGuard guard;
  return nn::sigmoid(nn::models::VqDecoder(p, nn::models::VqLookup(ids, p.at("codebook"))))
      .contiguous();
}
nn::NamedTensors CheckGradients(
    const nn::ParameterStore&      p,
    const std::vector<nn::Tensor>& g,
    const std::string&             finite,
    const std::string&             nonzero) {
  Require(g.size() == p.size(), "all nine derivative leaves");
  nn::NamedTensors out;
  const auto       names = p.names();
  for (std::size_t k = 0; k < g.size(); ++k) {
    double norm = 0;
    for (double x : g[k].to_vector<double>()) {
      Require(std::isfinite(x), finite);
      norm += x * x;
    }
    Require(norm > 0, nonzero);
    out.emplace_back(names[k], g[k]);
  }
  return out;
}
} // namespace ae
namespace check {
using ae::Near;
using ae::Require;
} // namespace check
namespace {

namespace nn = datamunge::nn;

void Checks(const std::filesystem::path& root) {
  const std::vector<float> zv{-.5f, 0.f, .9f, .2f}, bv{-1, 0, 0, 0, 1, 0};
  auto                     Z = nn::from_vector(zv, {2, 2}).requires_grad_(),
       B                     = nn::from_vector(bv, {3, 2}).requires_grad_();
  auto q                     = ae::VectorQuantize(Z, B, 3, 2);
  auto recon      = .5 * nn::sum(nn::square(q.straight_through), {0, 1}) + 0.0 * nn::sum(B, {0, 1});
  auto dictionary = q.codebook_loss + 0.0 * nn::sum(Z, {0, 1});
  auto commit     = .25 * q.commitment_loss + 0.0 * nn::sum(B, {0, 1});
  auto gr = nn::grad(recon, {Z, B}), gb = nn::grad(dictionary, {Z, B}),
       gc        = nn::grad(commit, {Z, B});
  const auto ids = q.indices.to_vector<int>();
  check::Require(ids[0] == 0 && ids[1] == 2, "nearest argmin tie chooses lower index");
  check::Require(
      nn::equal_bits(q.quantized.detach(), q.straight_through.detach()) &&
          nn::equal_bits(q.quantized.detach(), gr[0]),
      "ST forward exact quantized code and identity encoder reconstruction derivative");
  for (float v : gr[1].to_vector<float>())
    check::Near(v, 0, 0, "reconstruction does not update codebook");
  for (float v : gc[1].to_vector<float>())
    check::Near(v, 0, 0, "commitment does not update codebook");
  for (float v : gb[0].to_vector<float>())
    check::Near(v, 0, 0, "dictionary loss does not update encoder");
  nn::save_npz(
      (root / "quantizer_algebra.npz").string(),
      {{"encoded", Z.detach()},
       {"codebook", B.detach()},
       {"indices", q.indices},
       {"quantized", q.quantized.detach()},
       {"straight_through", q.straight_through.detach()},
       {"reconstruction_dencoded", gr[0]},
       {"reconstruction_dbook", gr[1]},
       {"dictionary_dencoded", gb[0]},
       {"dictionary_dbook", gb[1]},
       {"commitment_dencoded", gc[0]},
       {"commitment_dbook", gc[1]}});
  std::cout << "nearest tie/ST exact forward/reconstruction-codebook-commitment gradient "
               "separation passed"
            << std::endl;
}

float Scalar(const nn::NamedTensors& f, const std::string& key) {
  return ae::Find(f, key).item<float>();
}

void Run(
    const std::filesystem::path& data,
    const std::filesystem::path& root,
    int                          epochs,
    const std::string&           init) {
  auto pools = ae::LoadBetaFactors(data);
  std::filesystem::create_directories(root);
  Checks(root);
  ae::SaveFactorData(root, pools);
  nn::ParameterStore model(2707);
  ae::Warm(model);
  nn::OptimizerConfig config;
  config.kind = nn::OptimizerKind::Adam;
  nn::Optimizer optimizer(model, .003, config);
  if (!init.empty())
    model.load(init);
  check::Require(model.count() == 805 && model.size() == 9, "compact spatial VQ census");
  nn::save_npz((root / "initial_arrays.npz").string(), ae::Arrays(model));
  nn::BatchOrder order(210, 32, 2711);
  std::ofstream  history(root / "history.tsv"), batches(root / "batches.tsv");
  history.precision(17);
  history << "epoch\ttrain_preupdate_objective\tvalidation_nll\tvalidation_codebook_"
             "loss\tvalidation_commitment_loss\t"
             "validation_objective\n";
  batches << "epoch\tstep\trow\tsource_id\n";
  const auto fit_source = pools[0].source.to_vector<int>();
  const auto best_path  = (root / "best.npz").string();
  double     best       = std::numeric_limits<double>::infinity();
  int        selected = 0, step = 0;
  const auto started = std::chrono::steady_clock::now();
  for (int epoch = 1; epoch <= epochs; ++epoch) {
    order.begin_epoch();
    double sum  = 0;
    int    seen = 0;
    for (;;) {
      auto rows = order.next();
      if (rows.empty())
        break;
      auto images = nn::take_rows(pools[0].images, rows);
      if (step == 0) {
        nn::save_npz((root / "first_batch.npz").string(), {{"images", images}});
        auto g = ae::CheckGradients(
            model,
            nn::grad(
                nn::models::VectorQuantizedAutoencoder(model, images).loss, model.parameters()),
            "all VQ gradients finite",
            "all nine tensors receive VQ gradients");
        nn::save_npz((root / "first_gradients.npz").string(), g);
        nn::save_npz((root / "first_forward.npz").string(), ae::Evaluate(model, images));
      }
      const auto   forward   = nn::models::VectorQuantizedAutoencoder(model, images);
      const double preupdate = forward.loss.item<float>();
      check::Require(std::isfinite(preupdate) && preupdate >= 0, "finite VQ objective");
      sum += double(rows.size()) * preupdate;
      const auto gradients = nn::grad(forward.loss, model.parameters());
      optimizer.step(gradients);
      seen += int(rows.size());
      for (auto row : rows)
        batches << epoch << '\t' << step << '\t' << row << '\t' << fit_source[row] << '\n';
      if (step == 0)
        nn::save_npz((root / "first_update_arrays.npz").string(), ae::Arrays(model));
      ++step;
    }
    check::Require(seen == 210, "all fitting cases exactly once per epoch");
    auto         validation = ae::Evaluate(model, pools[1].images);
    const double nll        = Scalar(validation, "reconstruction_loss");
    history << epoch << '\t' << sum / seen << '\t' << nll << '\t'
            << Scalar(validation, "codebook_loss") << '\t' << Scalar(validation, "commitment_loss")
            << '\t' << Scalar(validation, "loss") << '\n';
    nn::save_npz(
        (root / ("epoch" + std::to_string(epoch) + "_arrays.npz")).string(), ae::Arrays(model));
    if (nll < best) {
      best     = nll;
      selected = epoch;
      model.save(best_path); // validation reconstruction NLL selects VQ checkpoint
    }
    std::cout << "epoch" << epoch << ":validation NLL=" << nll
              << ",dictionary=" << Scalar(validation, "codebook_loss")
              << ",commitment=" << Scalar(validation, "commitment_loss") << std::endl;
  }
  const double seconds =
      std::chrono::duration<double>(std::chrono::steady_clock::now() - started).count();
  nn::ParameterStore deployed(2707);
  ae::Warm(deployed);
  deployed.load(best_path); // fresh VQ model-only restore
  check::Near(
      Scalar(ae::Evaluate(deployed, pools[1].images), "reconstruction_loss"),
      best,
      1e-8,
      "restored selected NLL");
  const auto          before = ae::Snapshot(deployed);
  nn::NamedTensors    output;
  std::vector<double> perplexity;
  for (int split = 0; split < 3; ++split) {
    const std::string name = split == 0 ? "fit" : split == 1 ? "validation" : "test";
    auto              f    = ae::Evaluate(deployed, pools[split].images);
    check::Require(
        nn::equal_bits(ae::Find(f, "straight_through"), ae::Find(f, "quantized")),
        "ST forward bitexact learned code vectors");
    auto ids = ae::Find(f, "indices").reshape({pools[split].images.size(0), 49}).contiguous();
    check::Require(
        nn::equal_bits(ae::Find(f, "probability"), ae::Decode(deployed, ids)),
        "code-index-only decode exactly matches image encoding");
    auto usage = nn::models::VqUsage(ids);
    perplexity.push_back(usage.perplexity);
    output.emplace_back(name + "_code_counts", usage.counts);
    output.emplace_back(name + "_index_grid", ids);
    for (const auto& [key, value] : f)
      output.emplace_back(name + "_" + key, value);
  }
  const auto test_probability = ae::Find(output, "test_probability");
  auto       repeated         = ae::Evaluate(deployed, pools[2].images);
  check::Require(
      nn::equal_bits(ae::Find(repeated, "probability"), test_probability),
      "deterministic repeat bitexact");
  auto         single = ae::Evaluate(deployed, nn::take_rows(pools[2].images, {0}));
  const double parity =
      ae::VqDifference(ae::Find(single, "probability"), nn::take_rows(test_probability, {0}));
  check::Require(parity < 2e-6, "VQ single/batch parity");
  auto zero = nn::zeros({1, 49}, nn::DType::Int32), one = nn::full({1, 49}, 1.0, nn::DType::Int32);
  const double symbol_effect =
      ae::VqDifference(ae::Decode(deployed, zero), ae::Decode(deployed, one));
  check::Require(symbol_effect > 1e-5, "decoder responds to discrete symbol changes");
  for (int bad : {-1, 16}) {
    bool rejected = false;
    try {
      ae::Decode(deployed, nn::full({1, 49}, double(bad), nn::DType::Int32));
    } catch (const std::exception&) {
      rejected = true;
    }
    check::Require(
        rejected, "invalid negative or too-large symbols rejected before graph execution");
  }
  nn::models::VqMarkovPrior prior(ae::Find(output, "fit_index_grid"));
  const auto                uniforms          = nn::models::MidpointUniformNoise({20, 49}, 2729);
  const auto                sampled           = prior.Sample(uniforms);
  auto                      prior_probability = ae::Decode(deployed, sampled);
  const double              prior_fit_nll     = prior.Nll(ae::Find(output, "fit_index_grid")),
               prior_test_nll                 = prior.Nll(ae::Find(output, "test_index_grid"));
  nn::save_npz(
      (root / "prior.npz").string(),
      {{"counts", prior.counts()},
       {"probabilities", prior.probabilities()},
       {"sample_ids", sampled},
       {"uniform", uniforms},
       {"probability", prior_probability}});

  check::Require(
      before == ae::Snapshot(deployed),
      "prior fitting,decoding and diagnostics leave VQ parameters immutable");
  nn::save_npz((root / "model_arrays.npz").string(), ae::Arrays(deployed));
  nn::save_npz((root / "outputs.npz").string(), output);
  const double mse        = ae::Mse(test_probability, pools[2].images);
  auto         mean       = ae::Constant(ae::PixelMean(pools[0].images), 42);
  const double mean_mse   = ae::Mse(mean, pools[2].images);
  const auto   fit_counts = ae::Find(output, "fit_code_counts").to_vector<int>();
  int          used       = 0;
  for (int k = 0; k < 16; ++k)
    used += fit_counts[k] > 0;
  const double  test_nll = Scalar(output, "test_reconstruction_loss");
  std::ofstream meta(root / "metrics.json");
  meta.precision(17);
  meta << "{\"parameters\":805,\"tensors\":9,\"epochs\":" << epochs << ",\"updates\":" << step
       << ",\"selected_epoch\":" << selected
       << ",\"vocabulary\":16,\"embedding_dimensions\":4,\"tokens_per_image\":49,\"commitment_"
          "beta\":0.25,\"test_nll\":"
       << test_nll << ",\"test_codebook_loss\":" << Scalar(output, "test_codebook_loss")
       << ",\"test_commitment_loss\":" << Scalar(output, "test_commitment_loss")
       << ",\"test_objective\":" << Scalar(output, "test_loss") << ",\"test_mse\":" << mse
       << ",\"fit_mean_test_mse\":" << mean_mse << ",\"fit_used_codes\":" << used
       << ",\"fit_code_perplexity\":" << perplexity[0]
       << ",\"test_code_perplexity\":" << perplexity[2]
       << ",\"prior_fit_nll_nats_per_grid\":" << prior_fit_nll
       << ",\"prior_test_nll_nats_per_grid\":" << prior_test_nll
       << ",\"single_batch_max_error\":" << parity
       << ",\"symbol_change_max_effect\":" << symbol_effect << ",\"training_seconds\":" << seconds
       << "}\n";
  check::Require(bool(meta) && bool(history) && bool(batches), "complete VQ evidence");
  std::print(
      "| selected epoch | test NLL | test objective | test MSE | fit-only mean MSE | used codes | "
      "fit code perplexity | prior test nats/grid |\n|---:|---:|---:|---:|---:|---:|---:|---:|\n| "
      "{} | {:.9f} | {:.9f} | {:.9f} | {:.9f} | {} | {:.9f} | {:.9f} |\n",
      selected,
      test_nll,
      Scalar(output, "test_loss"),
      mse,
      mean_mse,
      used,
      perplexity[0],
      prior_test_nll);
}

} // namespace

int main() {
  try {
    const std::filesystem::path cache = dm::datasets::data_home();
    dm::datasets::prepare_example_data("beta-vae-assets", cache.string());
    Run(cache / "beta_vae", "build/vq_vae", 3, "");
    return 0;
  } catch (const std::exception& e) {
    std::cerr << e.what() << '\n';
    return 1;
  }
}
```
