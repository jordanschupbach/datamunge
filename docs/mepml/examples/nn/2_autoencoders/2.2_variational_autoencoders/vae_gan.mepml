\alttext(Ten rows compare original binary shapes with two weak, nearly grey reconstructions and the smoother fitting-only mean reference.)

The following program restores **only G** from group 1 and decodes the saved twenty independent
prior codes. Neither E, D nor target images are needed. Its output must match the saved prior
probabilities bit for bit before plotting; all twenty cases are displayed.

```{cpp, results="markdown", file="figures/vae_gan_priors.png", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
  namespace n = dm::nn;
  n::NoGradGuard guard;
  const auto     arrays = n::load_npz("build/vae_gan/model_arrays.npz"),
             prior      = n::load_npz("build/vae_gan/prior.npz");
  auto find             = [](const n::NamedTensors& a, const std::string& name) {
    for (const auto& [key, value] : a)
      if (key == name)
        return value;
    throw std::runtime_error(name);
  };
  n::ParameterStore generator(3307);
  n::models::VaeGanDecode(generator, n::zeros({1, 4}));
  for (const auto& name : generator.names())
    generator.set(name, find(arrays, "1/" + name));
  const auto probability = n::models::VaeGanDecode(generator, find(prior, "z"));
  if (!n::equal_bits(probability, find(prior, "probability")))
    return 1;
  n::save_image_grid(
      probability.reshape({20, 28, 28, 1}), "build/vae_gan_priors.png", 5, 0, 1, 4, 220. / 255., 4);
}
