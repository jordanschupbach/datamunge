```{cpp, results="markdown", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
  namespace n = dm::nn;
  auto before = n::load_npz("build/vae_gan/initial_arrays.npz");
  auto find   = [](const n::NamedTensors& a, const std::string& name) {
    for (const auto& [key, value] : a)
      if (key == name)
        return value;
    throw std::runtime_error(name);
  };
  std::print(
      "| phase | E squared update | G squared update | D squared update | gradient shift from "
      "initial |\n|---|---:|---:|---:|---:|\n");
  for (int group : {2, 0, 1}) {
    const auto after =
        n::load_npz("build/vae_gan/first_after_group" + std::to_string(group) + ".npz");
    std::vector<double> change(3);
    for (const auto& [key, value] : before) {
      const auto delta =
          n::cast(value, n::DType::Float64) - n::cast(find(after, key), n::DType::Float64);
      change[key[0] - '0'] += n::sum(n::square(delta)).item();
    }
    for (int k = 0; k < 3; ++k)
      if ((change[k] > 0) != (k == group))
        return 1;
    const auto initial = n::load_npz(
                   "build/vae_gan/initial_gradients_group" + std::to_string(group) + ".npz"),
               actual = n::load_npz(
                   "build/vae_gan/first_actual_gradients_group" + std::to_string(group) + ".npz");
    double shift = 0;
    for (const auto& [key, value] : initial)
      shift += n::sum(
                   n::square(
                       n::cast(value, n::DType::Float64) -
                       n::cast(find(actual, key), n::DType::Float64)))
                   .item();
    if (group == 2 ? shift != 0 : shift <= 0)
      return 1;
    std::print(
        "| {} | {:.9f} | {:.9f} | {:.9f} | {:.12f} |\n",
        group == 2   ? "D first"
        : group == 0 ? "E after D"
                     : "G after D/E",
        change[0],
        change[1],
        change[2],
        shift);
    before = after;
  }
}
