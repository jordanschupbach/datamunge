```{cpp, results="markdown", file="figures/tc_reconstructions.png", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
  namespace n = dm::nn;
  auto find   = [](const n::NamedTensors& a, const std::string& k) {
    for (const auto& [name, value] : a)
      if (name == k)
        return value;
    throw std::runtime_error(k);
  };
  const auto data = n::load_npz("build/tc_vae/data.npz"),
             a    = n::load_npz("build/tc_vae/factor_vae/outputs.npz"),
             b    = n::load_npz("build/tc_vae/beta_tcvae/outputs.npz");
  std::vector<std::int64_t> rows;
  for (int k = 0; k < 10; ++k)
    rows.push_back(k * 41 / 9);
  const auto fit = n::reshape(find(data, "fit_images"), {210, 784}), mean = n::mean(fit, {0}, true);
  std::vector<n::Tensor> panels;
  for (const auto& image : std::vector<n::Tensor>{
           find(data, "test_images"),
           find(a, "test_mean_prediction"),
           find(b, "test_mean_prediction"),
           n::ones({42, 1}) * mean,
           n::select(find(a, "test_sample_prediction"), 0, 0),
           n::select(find(b, "test_sample_prediction"), 0, 0)})
    panels.push_back(n::reshape(n::take_rows(image, rows), {10, 28, 28, 1}));
  n::save_image_grid(
      n::concat(panels, 0), "build/tc_reconstructions.png", 10, 0, 1, 4, 220. / 255, 3);
  const auto target = n::reshape(find(data, "test_images"), {42, 784});
  std::print(
      "Fitting-only mean MSE {:.9f}; ten source IDs {}.\n",
      n::mean(n::square(n::cast(target, n::DType::Float64) - n::cast(mean, n::DType::Float64)))
          .item(),
      n::take_rows(find(data, "test_source_ids"), rows).values_str());
}
