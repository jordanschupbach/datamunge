The selected test MSE0.148934076 is over three times the fitting mean0.048548290. NLL falls
under the short budget while reconstructions remain poor. D loss1.48421 and E adversarial
loss0.65721 neither prove prior matching nor useful samples. This deterministic code has no
per-example posterior variance; probabilities below are decoder means, not binary image draws.

> Held-out cases without quality selection

Ten evenly spaced held-out rows use index floor(41k/9),k=0..9. Columns retain their source IDs
and factor indices. Rows are original, reconstruction, fitting mean and absolute reconstruction
error. Every panel uses fixed[0,1] grayscale, nearest-neighbour enlargement and unamplified errors.

```{cpp, results="markdown", file="figures/aae_reconstructions.png", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
  namespace n = dm::nn;
  std::map<std::string, n::Tensor> data, out;
  for (const auto& [key, value] : n::load_npz("build/aae_data.npz"))
    data.emplace(key, value);
  for (const auto& [key, value] : n::load_npz("build/aae_outputs.npz"))
    out.emplace(key, value);
  const auto mean       = n::load_npz("build/aae_mean.npz")[0].second,
             images     = data.at("test_images").reshape({42, 784}),
             prediction = out.at("test_probability");
  std::vector<std::int64_t> rows;
  for (int k = 0; k < 10; ++k)
    rows.push_back(k * 41 / 9);
  const auto source  = data.at("test_source_ids").to_vector<int>(),
             factors = data.at("test_factors").to_vector<int>();
  std::print("| held-out row | lattice source ID | shape,size,x,y |\n|---:|---:|---|\n");
  for (auto row : rows)
    std::print(
        "| {} | {} | {},{},{},{} |\n",
        row,
        source[row],
        factors[4 * row],
        factors[4 * row + 1],
        factors[4 * row + 2],
        factors[4 * row + 3]);
  std::vector<n::Tensor> panels;
  for (const auto& values :
       std::vector<n::Tensor>{images, prediction, mean, n::abs(prediction - images)})
    panels.push_back(n::take_rows(values, rows));
  n::save_image_grid(
      n::concat(panels, 0).reshape({40, 28, 28, 1}),
      "build/aae_reconstructions.png",
      10,
      0,
      1,
      4,
      220. / 255,
      3);
}
