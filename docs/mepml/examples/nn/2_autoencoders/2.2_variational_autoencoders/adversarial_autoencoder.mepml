> Twenty-one minibatches, three phases and four optimizer states

Groups E/G/D use seeds3501/3511/3527 and independent Glorot weights/zero biases. Each epoch
visits all210 fitting images using batch32, final batch18 and order seed3581:seven minibatches,
three epochs,21 steps per optimizer and84 optimizer updates total. Four Adam states all use
learning rate.003,β1=.9,β2=.999,ε=1e-8; the two encoder optimizers share leaves but not moments.
Fixed prior banks use seeds3541/3547/3553 for fit/validation/test and3571 for20 generations.
Training prior banks are freshly generated with seeds3594/3595/3596. They use the canonical
explicit MT19937/Box–Muller Float64 stream, narrowed to Float32 for model inputs.

For each batch, reconstruction gradients for E and G are computed together from one forward
snapshot before either update. D then uses a newly computed forward pass and only D is updated.
E adversarial then recomputes after D's update and only E is updated, using its separate state.
The first-batch initial versus actual phase gradients and all phase snapshots are saved. Each
completed epoch saves all three groups; full validation **reconstruction NLL** selects the
checkpoint, not D/adversarial loss or test pixels. Epoch zero is saved as a control and is ineligible.

```{cpp, results="markdown", file="figures/aae_learning.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
  namespace n = dm::nn;
  std::map<std::string, n::Tensor> data;
  for (const auto& [key, value] : n::load_npz("build/aae_data.npz"))
    data.emplace(key, value);
  n::NamedTensors        bank;
  std::vector<n::Tensor> priors;
  for (int k = 0; k < 4; ++k) {
    const std::string split    = k == 0   ? "fit"
                                 : k == 1 ? "validation"
                                 : k == 2 ? "test"
                                          : "generation";
    int               count    = k == 0 ? 210 : k == 3 ? 20 : 42;
    unsigned          seed     = k == 3 ? 3571 : 3541 + k * 6;
    const auto        standard = n::models::GaussianNoise({count, 4}, 1, seed),
               epsilon         = n::cast(standard, n::DType::Float32);
    bank.emplace_back(split + "_standard", standard);
    bank.emplace_back(split + "_epsilon", epsilon);
    priors.push_back(n::select(epsilon, 0, 0).contiguous());
  }
  n::save_npz("build/aae_fixed_noise.npz", bank);
  n::ParameterStore               e(3501), g(3511), d(3527);
  std::vector<n::ParameterStore*> stores{&e, &g, &d}, groups{&e, &g, &d, &e};
  {
    n::NoGradGuard guard;
    n::models::AdversarialAutoencoder(e, g, d, n::zeros({1, 784}), n::zeros({1, 4}));
  }
  auto arrays = [&]() {
    n::NamedTensors out;
    for (int k = 0; k < 3; ++k)
      for (const auto& name : stores[k]->names())
        out.emplace_back(std::to_string(k) + "/" + name, stores[k]->at(name).detach().clone());
    return out;
  };
  auto fields = [](const n::models::AaeOutput& o) {
    return n::NamedTensors{
        {"code", o.code},
        {"logits", o.logits},
        {"probability", o.probability},
        {"prior_logit", o.prior_logit},
        {"encoded_logit", o.encoded_logit},
        {"nll", o.nll},
        {"reconstruction_loss", o.reconstruction_loss},
        {"discriminator_loss", o.discriminator_loss},
        {"adversarial_loss", o.adversarial_loss}};
  };
  auto named = [](int group, const std::vector<n::Tensor>& gradients, n::ParameterStore& p) {
    n::NamedTensors out;
    for (std::size_t i = 0; i < gradients.size(); ++i)
      out.emplace_back(std::to_string(group == 3 ? 0 : group) + "/" + p.names()[i], gradients[i]);
    return out;
  };
  n::OptimizerConfig config;
  config.kind    = n::OptimizerKind::Adam;
  config.beta1   = .9;
  config.beta2   = .999;
  config.epsilon = 1e-8;
  std::vector<std::unique_ptr<n::Optimizer>> optimizers;
  for (auto* group : groups)
    optimizers.push_back(std::make_unique<n::Optimizer>(*group, .003, config));
  n::save_npz("build/aae_initial_arrays.npz", arrays());
  n::BatchOrder order(210, 32, 3581);
  const auto    fit     = data.at("fit_images"),
             validation = data.at("validation_images").reshape({42, 784});
  const auto    source  = data.at("fit_source_ids").to_vector<int>();
  std::ofstream batches("build/aae_batches.tsv");
  batches << "epoch\tstep\trow\tsource_id\n";
  std::vector<double> epochs, nll_path, d_path, adv_path;
  double              best     = std::numeric_limits<double>::infinity();
  int                 selected = 0, steps = 0;
  std::print(
      "| epoch | validation summed-pixel NLL | D loss | E adversarial loss | eligible "
      "|\n|---:|---:|---:|---:|---|\n");
  {
    n::NoGradGuard guard;
    const auto     o = n::models::AdversarialAutoencoder(e, g, d, validation, priors[1]);
    n::save_npz("build/aae_epoch0_validation.npz", fields(o));
    epochs.push_back(0);
    nll_path.push_back(o.reconstruction_loss.item());
    d_path.push_back(o.discriminator_loss.item());
    adv_path.push_back(o.adversarial_loss.item());
    std::print(
        "| 0 | {:.9f} | {:.9f} | {:.9f} | no |\n", nll_path.back(), d_path.back(), adv_path.back());
  }
  for (int epoch = 1; epoch <= 3; ++epoch) {
    const auto standard = n::models::GaussianNoise({210, 4}, 1, 3593 + epoch),
               epsilon  = n::cast(standard, n::DType::Float32);
    const auto prior    = n::select(epsilon, 0, 0).contiguous();
    n::save_npz(
        "build/aae_train_noise_epoch" + std::to_string(epoch) + ".npz",
        {{"standard", standard}, {"epsilon", epsilon}});
    order.begin_epoch();
    int seen = 0;
    for (;;) {
      const auto rows = order.next();
      if (rows.empty())
        break;
      const auto images = n::take_rows(fit, rows), x = images.reshape({images.size(0), 784}),
                 p = n::take_rows(prior, rows);
      if (steps == 0) {
        n::save_npz("build/aae_first_batch.npz", {{"images", images}, {"prior", p}});
        {
          n::NoGradGuard guard;
          n::save_npz(
              "build/aae_first_forward.npz",
              fields(n::models::AdversarialAutoencoder(e, g, d, x, p)));
        }
        for (int k = 0; k < 4; ++k) {
          const auto o         = n::models::AdversarialAutoencoder(e, g, d, x, p);
          const auto loss      = k < 2    ? o.reconstruction_loss
                                 : k == 2 ? o.discriminator_loss
                                          : o.adversarial_loss;
          const auto gradients = n::grad(loss, groups[k]->parameters());
          n::save_npz(
              "build/aae_initial_gradients_group" + std::to_string(k) + ".npz",
              named(k, gradients, *groups[k]));
        }
      }
      for (int phase = 0; phase < 3; ++phase) {
        const auto before = steps == 0 ? arrays() : n::NamedTensors{};
        const auto o      = n::models::AdversarialAutoencoder(e, g, d, x, p);
        if (phase == 0) {
          auto       variables = e.parameters();
          const auto gv        = g.parameters();
          variables.insert(variables.end(), gv.begin(), gv.end());
          const auto                   gradients = n::grad(o.reconstruction_loss, variables);
          const std::vector<n::Tensor> ge(gradients.begin(), gradients.begin() + e.size()),
              gg(gradients.begin() + e.size(), gradients.end());
          if (steps == 0) {
            n::save_npz("build/aae_first_actual_gradients_group0.npz", named(0, ge, e));
            n::save_npz("build/aae_first_actual_gradients_group1.npz", named(1, gg, g));
          }
          optimizers[0]->step(ge);
          optimizers[1]->step(gg); // both gradients already computed
        } else {
          const int  k         = phase == 1 ? 2 : 3;
          const auto loss      = phase == 1 ? o.discriminator_loss : o.adversarial_loss;
          const auto gradients = n::grad(loss, groups[k]->parameters());
          if (steps == 0)
            n::save_npz(
                "build/aae_first_actual_gradients_group" + std::to_string(k) + ".npz",
                named(k, gradients, *groups[k]));
          optimizers[k]->step(gradients);
        }
        if (steps == 0) {
          const auto after   = arrays();
          bool       changed = false;
          for (const auto& [key, value] : before) {
            const bool intended = phase == 0   ? key[0] != '2'
                                  : phase == 1 ? key[0] == '2'
                                               : key[0] == '0';
            const auto found    = std::find_if(
                after.begin(), after.end(), [&](const auto& entry) { return entry.first == key; });
            if (found == after.end())
              return 1;
            if (intended)
              changed |= !n::equal_bits(value, found->second);
            else if (!n::equal_bits(value, found->second))
              return 1;
          }
          if (!changed)
            return 1;
          n::save_npz("build/aae_first_after_phase" + std::to_string(phase) + ".npz", after);
        }
      }
      for (auto row : rows)
        batches << epoch << '\t' << steps << '\t' << row << '\t' << source[row] << '\n';
      ++steps;
      seen += int(rows.size());
    }
    if (seen != 210)
      return 1;
    n::NoGradGuard guard;
    const auto     o     = n::models::AdversarialAutoencoder(e, g, d, validation, priors[1]);
    const double   score = o.reconstruction_loss.item();
    n::save_npz("build/aae_epoch" + std::to_string(epoch) + "_arrays.npz", arrays());
    n::save_npz("build/aae_epoch" + std::to_string(epoch) + "_validation.npz", fields(o));
    if (score < best) {
      best     = score;
      selected = epoch;
      n::save_npz("build/aae_best.npz", arrays());
    }
    epochs.push_back(epoch);
    nll_path.push_back(score);
    d_path.push_back(o.discriminator_loss.item());
    adv_path.push_back(o.adversarial_loss.item());
    std::print(
        "| {} | {:.9f} | {:.9f} | {:.9f} | yes |\n", epoch, score, d_path.back(), adv_path.back());
  }
  if (steps != 21 || !batches)
    return 1;
  for (const auto& optimizer : optimizers)
    if (optimizer->iterations() != 21)
      return 1;
  n::save_npz(
      "build/aae_selection.npz",
      {{"epoch", n::full({}, selected, n::DType::Int32)},
       {"nll", n::from_vector(nll_path, {4})},
       {"D", n::from_vector(d_path, {4})},
       {"E_adv", n::from_vector(adv_path, {4})}});
  auto plot = dm::graphics::RPlot::create();
  plot.lines(epochs, nll_path, "validation reconstruction NLL", {37, 99, 235}, 2)
      .x_label("completed epoch / zero control ineligible")
      .y_label("NLL summed over784 pixels")
      .title("Selected by reconstruction only / all groups saved together")
      .save_svg("build/aae_learning.svg");
  std::print("Selected epoch{};21 steps per optimizer,84 updates total.\n", selected);
}
```
