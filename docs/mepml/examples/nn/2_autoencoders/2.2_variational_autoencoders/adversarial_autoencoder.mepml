> Fresh restoration and prior-independent reconstruction

All12 selected arrays are loaded into new stores after checking names, counts, shapes and dtype.
Repeated predictions and code-only decoding agree bit for bit; single/batch differences must
remain below2e-6. Changing only the supplied prior must leave codes and probabilities unchanged
while changing prior discriminator logits. Frozen inference cannot change any stored parameter.
The fitting mean is estimated only from the210 fitting images and used as a constant MSE control.

```{cpp, results="markdown", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
  namespace n = dm::nn;
  std::map<std::string, n::Tensor> data, noise;
  for (const auto& [key, value] : n::load_npz("build/aae_data.npz"))
    data.emplace(key, value);
  for (const auto& [key, value] : n::load_npz("build/aae_fixed_noise.npz"))
    noise.emplace(key, value);
  n::ParameterStore e(3501), g(3511), d(3527);
  {
    n::NoGradGuard guard;
    n::models::AdversarialAutoencoder(e, g, d, n::zeros({1, 784}), n::zeros({1, 4}));
  }
  std::vector<n::ParameterStore*> stores{&e, &g, &d};
  const auto                      selected = n::load_npz("build/aae_best.npz");
  if (selected.size() != 12)
    return 1;
  for (int k = 0; k < 3; ++k)
    for (const auto& name : stores[k]->names()) {
      const auto key   = std::to_string(k) + "/" + name;
      const auto found = std::find_if(
          selected.begin(), selected.end(), [&](const auto& item) { return item.first == key; });
      if (found == selected.end() || found->second.shape() != stores[k]->at(name).shape() ||
          found->second.dtype() != n::DType::Float32)
        return 1;
      stores[k]->set(name, found->second);
    }
  const auto     before_e = e.flatten(), before_g = g.flatten(), before_d = d.flatten();
  n::NoGradGuard guard;
  auto           fields = [](const n::models::AaeOutput& o) {
    return n::NamedTensors{
                  {"code", o.code},
                  {"logits", o.logits},
                  {"probability", o.probability},
                  {"prior_logit", o.prior_logit},
                  {"encoded_logit", o.encoded_logit},
                  {"nll", o.nll},
                  {"reconstruction_loss", o.reconstruction_loss},
                  {"discriminator_loss", o.discriminator_loss},
                  {"adversarial_loss", o.adversarial_loss}};
  };
  n::NamedTensors outputs;
  for (const auto& split : {"fit", "validation", "test"}) {
    const auto x   = data.at(std::string(split) + "_images").reshape({-1, 784});
    const auto p   = n::select(noise.at(std::string(split) + "_epsilon"), 0, 0).contiguous();
    const auto out = n::models::AdversarialAutoencoder(e, g, d, x, p);
    for (const auto& [name, value] : fields(out))
      outputs.emplace_back(std::string(split) + "_" + name, value);
  }
  const auto test   = data.at("test_images").reshape({42, 784}),
             prior  = n::select(noise.at("test_epsilon"), 0, 0).contiguous();
  const auto out    = n::models::AdversarialAutoencoder(e, g, d, test, prior),
             repeat = n::models::AdversarialAutoencoder(e, g, d, test, prior);
  const auto other_prior =
      n::cast(n::select(n::models::GaussianNoise({42, 4}, 1, 3613), 0, 0), n::DType::Float32);
  const auto other = n::models::AdversarialAutoencoder(e, g, d, test, other_prior);
  if (!n::equal_bits(out.probability, repeat.probability) ||
      !n::equal_bits(out.probability, n::sigmoid(n::models::AaeDecode(g, out.code))) ||
      !n::equal_bits(out.code, other.code) || !n::equal_bits(out.probability, other.probability) ||
      n::equal_bits(out.prior_logit, other.prior_logit))
    return 1;
  const auto single =
      n::models::AdversarialAutoencoder(e, g, d, n::take_rows(test, {0}), n::take_rows(prior, {0}));
  if (n::max(n::abs(single.probability - n::take_rows(out.probability, {0}))).item() > 2e-6)
    return 1;
  const auto z          = n::select(noise.at("generation_epsilon"), 0, 0).contiguous(),
             generation = n::sigmoid(n::models::AaeDecode(g, z));
  n::save_npz("build/aae_prior.npz", {{"z", z}, {"probability", generation}});
  n::save_npz("build/aae_outputs.npz", outputs);
  n::NamedTensors model;
  for (int k = 0; k < 3; ++k)
    for (const auto& name : stores[k]->names())
      model.emplace_back(std::to_string(k) + "/" + name, stores[k]->at(name).detach().clone());
  n::save_npz("build/aae_model_arrays.npz", model);
  if (before_e != e.flatten() || before_g != g.flatten() || before_d != d.flatten())
    return 1;
  const auto mean = n::broadcast_to(
      n::cast(
          n::mean(n::cast(data.at("fit_images").reshape({210, 784}), n::DType::Float64), {0}, true),
          n::DType::Float32),
      test.shape());
  n::save_npz("build/aae_mean.npz", {{"mean", mean}});
  auto score = [](const n::Tensor& p, const n::Tensor& x) {
    return n::mean(n::square(n::cast(p, n::DType::Float64) - n::cast(x, n::DType::Float64))).item();
  };
  std::print(
      "| test measure | value |\n|---|---:|\n| summed-pixel Bernoulli NLL | {:.9f} |\n| "
      "reconstruction pixel MSE | {:.9f} |\n| fitting-mean pixel MSE | {:.9f} |\n| discriminator "
      "loss | {:.9f} |\n| encoder adversarial loss | {:.9f} |\n",
      out.reconstruction_loss.item(),
      score(out.probability, test),
      score(mean, test),
      out.discriminator_loss.item(),
      out.adversarial_loss.item());
  std::print(
      "Fresh all-group restore / prior-independent reconstruction / code-only decoding / repeat / "
      "batch / immutable checks pass.\n");
}
```
