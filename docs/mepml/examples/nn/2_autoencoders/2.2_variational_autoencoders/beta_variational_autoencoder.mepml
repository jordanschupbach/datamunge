      .node("q", {6, 0}, "Encoder + Gaussian heads\nmu and log variance: four each")
      .node("e", {0, -4}, "Explicit epsilon ~ N(0,I)\nFixed banks / fresh training banks")
      .node("z", {6, -4}, "Pathwise sample\nz = mu + exp(l/2) * epsilon")
      .node("g", {12, -4}, "Bernoulli decoder\n4 →32 ReLU →784 logits")
      .node("kl", {12, 0}, "Analytic KL to N(0,I)\nSummed over four coordinates")
      .node(
          "loss",
