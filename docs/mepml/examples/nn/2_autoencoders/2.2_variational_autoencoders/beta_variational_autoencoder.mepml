```{cpp, results="markdown", file="figures/beta_reconstructions.png", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
  namespace n = dm::nn;
  auto load   = [](const std::string& file) {
    std::map<std::string, n::Tensor> a;
    for (const auto& [k, v] : n::load_npz("build/beta_vae/" + file))
      a.emplace(k, v);
    return a;
  };
  auto data = load("data.npz"), one = load("beta1/outputs.npz"), four = load("beta4/outputs.npz");
  auto x = n::reshape(data.at("test_images"), {42, 784}), p1 = one.at("test_mean_prediction"),
       p4   = four.at("test_mean_prediction");
  auto fit  = n::reshape(data.at("fit_images"), {210, 784});
  auto mean = n::tile(
      n::cast(n::mean(n::cast(fit, n::DType::Float64), {0}, true), n::DType::Float32), {42, 1});
  auto                      draw = n::select(four.at("test_sample_prediction"), 0, 0);
  std::vector<std::int64_t> rows;
  for (int k = 0; k < 10; ++k)
    rows.push_back(k * 41 / 9);
  std::vector<n::Tensor> panels;
  for (const auto& t : {x, p1, p4, mean, n::abs(p1 - x), n::abs(p4 - x), draw})
    panels.push_back(n::take_rows(t, rows));
  n::save_image_grid(
      n::reshape(n::concat(panels, 0), {70, 28, 28, 1}),
      "build/beta_reconstructions.png",
      10,
      0,
      1,
      4,
      220. / 255,
      3);
  auto mse = [&](const n::Tensor& p) {
    return n::mean(n::square(n::cast(p, n::DType::Float64) - n::cast(x, n::DType::Float64))).item();
  };
  std::print(
      "| predictor | test pixel MSE |\n|---|---:|\n| beta1 decode(mu) |{:.9f}|\n| beta4 decode(mu) "
      "|{:.9f}|\n| fit mean |{:.9f}|\n",
      mse(p1),
      mse(p4),
      mse(mean));
}
