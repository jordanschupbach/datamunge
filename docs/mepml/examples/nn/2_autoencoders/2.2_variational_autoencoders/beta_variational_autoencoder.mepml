> Executed architecture and parameter census

The shape probe packs784 image entries and four epsilon entries into a single788-entry input,
then explicitly splits them into independent branches. This packing is for Module tracing only;
the public model takes image and epsilon separately. The Gaussian sample stage names both
posterior heads and epsilon. Ten leaves hold51,416 scalars: encoder25,120; mu132;
log-variance132; decoder160; output25,872. All parameter gradients remain visible.

```{cpp, results="markdown", file="figures/beta_architecture.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
  namespace n = dm::nn;
  n::ParameterStore p(2237);
  n::Module         model(
      [&](const n::Tensor& packed) {
        auto x = n::slice_axis(packed, 1, 0, 784), e = n::slice_axis(packed, 1, 784, 788);
        n::model_stage("Image rows", packed, x);
        n::model_stage("Supplied epsilon", packed, e);
        auto o = n::models::BetaVariationalAutoencoder(p, x, e, 4);
        n::model_stage("Posterior mean", x, o.mu);
        n::model_stage("Posterior log variance", x, o.log_variance);
        n::model_stage(
            "Gaussian pathwise sample", std::vector<n::Tensor>{o.mu, o.log_variance, e}, o.z);
        n::model_stage("Bernoulli decoder logits", o.z, o.logits);
        n::model_stage(
            "Summed Bernoulli NLL", std::vector<n::Tensor>{x, o.logits}, o.reconstruction_nll);
        n::model_stage("Summed Gaussian KL", std::vector<n::Tensor>{o.mu, o.log_variance}, o.kl);
        n::model_stage(
            "Mean NLL + 4 KL", std::vector<n::Tensor>{o.reconstruction_nll, o.kl}, o.loss);
        return o.loss;
      },
      "Beta4 VAE / explicit noise");
  n::ModelPlotOptions o;
  o.style                 = n::ModelPlotStyle::Graph;
  o.detail                = n::ModelPlotDetail::Blocks;
  o.max_neurons           = 8;
  o.sizing.spatial_scale  = n::ModelPlotScale::Linear;
  o.sizing.channel_scale  = n::ModelPlotScale::Linear;
  o.sizing.minimum_extent = 2;
  o.sizing.max_planes     = 6;
  auto figure             = model.plot(n::zeros({1, 788}), o);
  if (p.size() != 10 || p.count() != 51416 || figure.parameter_count() != 51416)
    return 1;
  figure.save_svg("build/beta_architecture.svg");
  std::print("10 leaves / {} scalars; explicit image and epsilon branches.\n", p.count());
}
