> An exhaustive known-factor lattice

The local procedural fixture exhausts2 shapes(circle/square)×3 sizes×7 x positions×7 y
positions=294 unique binary28×28 images. Radius=size+2, center=(3x+5,3y+5); circles use
inclusive Euclidean radius, squares inclusive Chebyshev radius. Source ID is
(((shape×3+size)×7+x)×7+y). Residue(x+2y+size+3shape) mod7 assigns test0,
validation1 and fit2–6:210/42/42 disjoint combinations, each factor marginal balanced.
The native preparation API preserves the source's data exactly. This is a tiny teaching lattice,
not MNIST/dSprites, an IID split or a disentanglement benchmark. Factors never enter the VAE
or checkpoint selection. Preparation is offline and records provenance in the shared data cache.

```{cpp, results="markdown", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
  namespace n = dm::nn;
  std::filesystem::create_directories("build/beta_vae");
  const std::filesystem::path cache = dm::datasets::data_home();
  dm::datasets::prepare_example_data("beta-vae-assets", cache.string());
  auto                       arrays = n::load_npz((cache / "beta_vae/factors.npz").string());
  std::set<int>              ids;
  std::set<std::vector<int>> images;
  for (auto& [name, value] : arrays) {
    if (name.ends_with("_images")) {
      for (int b = 0; b < value.size(0); ++b) {
        auto row = n::select(value, 0, b).to_vector<int>();
        if (!images.insert(row).second)
          return 1;
      }
      value = n::cast(value, n::DType::Float32);
    }
    if (name.ends_with("_source_ids"))
      for (int id : value.to_vector<int>())
        if (!ids.insert(id).second)
          return 1;
  }
  if (ids.size() != 294 || images.size() != 294)
    return 1;
  n::save_npz("build/beta_vae/data.npz", arrays);
  std::filesystem::copy_file(
      cache / "beta_vae/manifest.json",
      "build/beta_vae/data_manifest.json",
      std::filesystem::copy_options::overwrite_existing);
  std::print(
      "| split | images | features |\n|---|---:|---:|\n| fit |210|784|\n| validation |42|784|\n| "
      "test |42|784|\n");
}
