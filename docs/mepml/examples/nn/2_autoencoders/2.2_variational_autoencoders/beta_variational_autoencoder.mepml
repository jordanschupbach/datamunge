> Hand values and pathwise derivatives

For mu=[.2,−.4], l=[0,log4] and epsilon=[1,−.5], z=[1.2,−1.4].
KL=0.5(.04+.16+4−1−log4)≈0.90685. At mu=0,l=0 the KL is exactly zero.
To isolate the pathwise derivatives, use the small surrogate
J=mean_b(0.5∑_d z_bd²+4K_b), rather than a learned decoder. Then
∂J/∂mu=(z+4mu)/B, ∂J/∂l=(0.5z sigma epsilon+2(exp(l)−1))/B and
∂J/∂epsilon=z sigma/B, with sigma=exp(l/2). The executed check covers both rows,
all four sample values, two KLs and all twelve derivatives. The Bernoulli term at logits
[100,−100,100,−100] with targets[1,0,0,1] is200 without probability clipping.

```{cpp, results="markdown", file="figures/beta_pathwise.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
void Near(double a, double b, double tolerance, const std::string& label) {
  if (std::abs(a - b) > tolerance)
    throw std::runtime_error(label);
}
int main() {
  namespace nn                  = dm::nn;
  const double             beta = 4;
  const std::vector<float> m{.2f, -.4f, .1f, .3f},
      l{0.f, float(std::log(4.)), float(std::log(.25)), .2f}, e{1.f, -.5f, 2.f, -1.f};
  auto mu      = nn::from_vector(m, {2, 2}).requires_grad_(),
       lv      = nn::from_vector(l, {2, 2}).requires_grad_(),
       eps     = nn::from_vector(e, {2, 2}).requires_grad_();
  auto z       = nn::models::GaussianReparameterize(mu, lv, eps),
       kl      = nn::models::DiagonalGaussianKl(mu, lv);
  auto loss    = nn::mean(0.5 * nn::sum(nn::square(z), {1}) + beta * kl, {0});
  auto grad    = nn::grad(loss, {mu, lv, eps});
  auto extreme = nn::models::BernoulliPixelNll(
      nn::tensor({{100., -100., 100., -100.}}), nn::tensor({{1., 0., 0., 1.}}));
  auto       zero_kl = nn::models::DiagonalGaussianKl(nn::zeros({1, 2}), nn::zeros({1, 2}));
  const auto zs = z.to_vector<float>(), kls = kl.to_vector<float>(),
             g0 = grad[0].to_vector<float>(), g1 = grad[1].to_vector<float>(),
             g2 = grad[2].to_vector<float>();
  for (int b = 0; b < 2; ++b) {
    double k = 0;
    for (int j = 0; j < 2; ++j) {
      const int    i    = b * 2 + j;
      const double mean = m[i], logv = l[i], noise = e[i], sigma = std::exp(.5 * logv),
                   value = mean + sigma * noise;
      k += .5 * (mean * mean + std::exp(logv) - 1 - logv);
      Near(zs[i], value, 2e-7, "all4reparameterized values");
      Near(g0[i], (value + beta * mean) / 2, 2e-7, "all4mu derivatives include pathwise PLUS KL");
      Near(
          g1[i],
          (.5 * value * sigma * noise + .5 * beta * (std::exp(logv) - 1)) / 2,
          3e-7,
          "all4logvariance derivatives include pathwise PLUS KL");
      Near(g2[i], value * sigma / 2, 3e-7, "all4epsilon derivatives follow sigma");
    }
    Near(kls[b], k, 2e-7, "all2analytic Gaussian KLs");
  }
  Near(extreme.at({0}), 200, 1e-6, "stable BCE for logits+-100");
  Near(zero_kl.at({0}), 0, 0, "q=N(0,I)KL exactly0");

  std::vector<double> sample(zs.begin(), zs.end()), index{0, 1, 2, 3};
  auto                chart = dm::graphics::RPlot::create();
  chart.points(index, sample, "explicit sample", {37, 99, 235}, 6)
      .title("Explicit Gaussian pathwise sample")
      .x_label("coordinate")
      .y_label("z");
  chart.save_svg("build/beta_pathwise.svg");
  std::print("All4 samples,2 KLs,12 derivatives,zero KL and extreme Bernoulli NLL passed.\n");
}
