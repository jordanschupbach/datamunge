> Paired fitting with common validation selection

Both models start from the same seed2237 parameter arrays, not merely similarly distributed
weights. Training uses one fresh epsilon per fitting image per epoch, seeds2252/2253/2254;
validation and test retain four fixed draws (fit2273, validation2267, test2269). The same banks
are shared across betas. The core GaussianNoise stream uses explicit MT19937/Box–Muller
Float64 draws, narrowed to Float32; both versions are saved. Prior codes use seed2281.

Three epochs of BatchOrder(210,32,2243) give seven updates per epoch, including a final
18-image batch:21 updates/model. Adam uses learning rate.003, moments.9/.999 and epsilon1e-8,
with separate optimizer state per model. Each batch rebuilds its forward graph, explicitly
computes gradients and updates the ten leaves. The full first gradient and parameter snapshots
are saved. One weighted loss is used for training. Checkpoint selection instead uses the same
four-draw **unweighted** validation NLL+KL for both models. Comparing their weighted losses
would compare different criteria. Completed epochs1–3 are eligible; epoch zero is not.
Monte Carlo NLL is accumulated sample then image in Float64 from Float32 per-image values;
KL is analytic and counted once per image. Test pixels/factors never select an epoch.

```{cpp, results="markdown", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <chrono>
#include <dm/dm.hpp>
#include <fstream>
namespace nn = dm::nn;
void Require(bool condition, const std::string& why) {
  if (!condition)
    throw std::runtime_error(why);
}
void Near(double x, double y, double tolerance, const std::string& why) {
  Require(std::abs(x - y) <= tolerance, why);
}
struct BetaFactorData {
  nn::Tensor images, factors, source;
};
struct VaeNoiseBank {
  nn::Tensor standard, epsilon;
};
nn::Tensor Flatten(const nn::Tensor& t) {
  return nn::reshape(t, {t.size(0), 784});
}
nn::Tensor Find(const nn::NamedTensors& a, const std::string& key) {
  for (const auto& [k, v] : a)
    if (k == key)
      return v;
  throw std::runtime_error(key);
}
std::vector<float> Bytes(const nn::Tensor& t) {
  return t.contiguous().to_vector<float>();
}
nn::NamedTensors Arrays(const nn::ParameterStore& p) {
  nn::NamedTensors a;
  for (const auto& k : p.names())
    a.emplace_back(k, p.at(k).detach().clone());
  return a;
}
auto Snapshot(const nn::ParameterStore& p) {
  return p.flatten();
}
nn::NamedTensors CheckGradients(
    const nn::ParameterStore&      p,
    const std::vector<nn::Tensor>& gs,
    const std::string&,
    const std::string&) {
  nn::NamedTensors a;
  Require(gs.size() == p.size(), "all10 gradients");
  const auto names = p.names();
  for (std::size_t i = 0; i < gs.size(); ++i) {
    double norm = 0;
    for (double x : gs[i].to_vector<double>()) {
      Require(std::isfinite(x), "finite derivatives");
      norm += x * x;
    }
    Require(norm > 0, "nonzero derivative in each tensor");
    a.emplace_back(names[i], gs[i]);
  }
  return a;
}
VaeNoiseBank BetaVaeNoise(std::int64_t n, std::int64_t samples, std::uint32_t seed) {
  const auto standard = nn::models::GaussianNoise({n, 4}, samples, seed);
  return {standard, nn::cast(standard, nn::DType::Float32)};
}
nn::Tensor BetaVaeNoiseAt(const VaeNoiseBank& bank, int k) {
  return nn::select(bank.epsilon, 0, k).contiguous();
}
std::vector<nn::Tensor>
Evaluate(nn::ParameterStore& p, float beta, const nn::Tensor& images, const nn::Tensor& epsilon) {
  nn::NoGradGuard guard;
  const auto      o = nn::models::BetaVariationalAutoencoder(p, Flatten(images), epsilon, beta);
  return {o.mu, o.log_variance, o.z, o.probability, o.reconstruction_nll, o.kl, o.loss};
}
nn::Tensor Decode(nn::ParameterStore& p, const nn::Tensor& z) {
  nn::NoGradGuard guard;
  return nn::sigmoid(nn::models::GaussianVaeDecode(p, z));
}
std::array<double, 4> BetaVaeScore(
    nn::ParameterStore& p,
    const nn::Tensor&   images,
    const VaeNoiseBank& bank,
    float               beta) {
  double     reconstruction = 0, kl = 0;
  const auto n = images.size(0), samples = bank.epsilon.size(0);
  for (int k = 0; k < samples; ++k) {
    const auto o   = Evaluate(p, beta, images, BetaVaeNoiseAt(bank, k));
    const auto nll = o[4].to_vector<float>(), kls = o[5].to_vector<float>();
    for (int b = 0; b < n; ++b) {
      reconstruction += nll[b];
      if (k == 0)
        kl += kls[b];
    }
  }
  reconstruction /= double(n * samples);
  kl /= double(n);
  return {reconstruction, kl, reconstruction + kl, reconstruction + beta * kl};
}
double MaxAbsDiff(const nn::Tensor& a, const nn::Tensor& b, int n) {
  const auto x = Bytes(a), y = Bytes(b);
  double     d = 0;
  for (int i = 0; i < n; ++i)
    d = std::max(d, std::abs(double(x[i]) - y[i]));
  return d;
}
double Mse(const nn::Tensor& a, const nn::Tensor& b) {
  return nn::mean(
             nn::square(
                 nn::cast(Flatten(a), nn::DType::Float64) -
                 nn::cast(Flatten(b), nn::DType::Float64)))
      .item();
}
double Train(
    float                              beta,
    const std::vector<BetaFactorData>& pools,
    const std::vector<VaeNoiseBank>&   train_noise,
    const std::vector<VaeNoiseBank>&   eval_noise,
    const VaeNoiseBank&                prior_noise,
    int                                epochs,
    const std::filesystem::path&       root,
    const nn::NamedTensors&            initial) {
  const auto directory = root / (beta == 1 ? "beta1" : "beta4");
  std::filesystem::create_directories(directory);
  nn::ParameterStore model(2237);
  for (const auto& [name, value] : initial)
    model.set(name, value.clone());
  nn::OptimizerConfig config;
  config.kind = nn::OptimizerKind::Adam;
  nn::Optimizer optimizer(model, .003, config);
  Require(model.size() == 10 && model.count() == 51416, "compact four-dimensional betaVAE census");
  nn::save_npz((directory / "initial_arrays.npz").string(), Arrays(model));
  auto           initial_score = BetaVaeScore(model, pools[2].images, eval_noise[2], beta);
  nn::BatchOrder order(210, 32, 2243);
  std::ofstream  history(directory / "history.tsv"), batches(directory / "batches.tsv");
  history.precision(17);
  history << "epoch\tfit_preupdate_weighted_objective\tvalidation_nll\tvalidation_kl\tvalidation_"
             "negative_elbo\t"
             "validation_weighted_objective\n";
  batches << "epoch\tstep\trow\tsource_id\n";
  const auto fit_source = pools[0].source.to_vector<int>();
  const auto best_path  = (directory / "best.npz").string();
  double     best       = std::numeric_limits<double>::infinity();
  int        selected = 0, step = 0;
  const auto started = std::chrono::steady_clock::now();
  for (int epoch = 1; epoch <= epochs; ++epoch) {
    auto epsilon = BetaVaeNoiseAt(train_noise[epoch - 1], 0);
    order.begin_epoch();
    double sum  = 0;
    int    seen = 0;
    for (;;) {
      auto rows = order.next();
      if (rows.empty())
        break;
      auto input = nn::take_rows(pools[0].images, rows), e = nn::take_rows(epsilon, rows);
      if (step == 0) {
        auto g = CheckGradients(
            model,
            nn::grad(
                nn::models::BetaVariationalAutoencoder(model, Flatten(input), e, beta).loss,
                model.parameters()),
            "all beta-weighted derivatives finite",
            "all10posterior/decoder tensors receive gradients");
        nn::save_npz((directory / "first_gradients.npz").string(), g);
        nn::save_npz((directory / "first_batch.npz").string(), {{"images", input}, {"epsilon", e}});
      }
      const auto out = nn::models::BetaVariationalAutoencoder(model, Flatten(input), e, beta);
      sum += double(rows.size()) * out.loss.item<float>();
      const auto gradients = nn::grad(out.loss, model.parameters());
      optimizer.step(gradients);
      seen += int(rows.size());
      for (auto row : rows)
        batches << epoch << '\t' << step << '\t' << row << '\t' << fit_source[row] << '\n';
      if (step == 0)
        nn::save_npz((directory / "first_update_arrays.npz").string(), Arrays(model));
      ++step;
    }
    Require(seen == 210, "all210fitting images once per epoch");
    auto score = BetaVaeScore(model, pools[1].images, eval_noise[1], beta);
    history << epoch << '\t' << sum / seen << '\t' << score[0] << '\t' << score[1] << '\t'
            << score[2] << '\t' << score[3] << '\n';
    nn::save_npz(
        (directory / ("epoch" + std::to_string(epoch) + "_arrays.npz")).string(), Arrays(model));
    if (score[2] < best) {
      best     = score[2];
      selected = epoch;
      model.save(best_path); // COMMON unweighted 4-sample validation negative ELBO selects
    }
    std::cout << "beta" << beta << " epoch" << epoch << ":NLL=" << score[0] << ",KL=" << score[1]
              << ",commonnegativeELBO=" << score[2] << ",weightedobjective=" << score[3]
              << std::endl;
  }
  const double seconds =
      std::chrono::duration<double>(std::chrono::steady_clock::now() - started).count();
  nn::ParameterStore deployed(2237);
  {
    nn::NoGradGuard guard;
    nn::models::BetaVariationalAutoencoder(deployed, nn::zeros({1, 784}), nn::zeros({1, 4}), beta);
  }
  deployed.load(best_path); // fresh betaVAE inference restore
  const auto before = Snapshot(deployed);
  Near(
      BetaVaeScore(deployed, pools[1].images, eval_noise[1], beta)[2],
      best,
      1e-8,
      "fresh common selected validation score");
  nn::NamedTensors output;
  for (int split = 0; split < 3; ++split) {
    const std::string  name = split == 0 ? "fit" : split == 1 ? "validation" : "test";
    const std::int64_t n    = pools[split].images.size(0);
    auto               mean = Evaluate(deployed, beta, pools[split].images, nn::zeros({n, 4}));
    Require(Bytes(mean[2]) == Bytes(mean[0]), "epsilon0 yields EXACT posterior mean");
    std::vector<nn::Tensor> zs, prob, nll;
    for (int k = 0; k < 4; ++k) {
      auto draw =
          Evaluate(deployed, beta, pools[split].images, BetaVaeNoiseAt(eval_noise[split], k));
      Require(
          Bytes(draw[0]) == Bytes(mean[0]) && Bytes(draw[1]) == Bytes(mean[1]),
          "noise changes samples,not posterior parameters");
      zs.push_back(draw[2]);
      prob.push_back(draw[3]);
      nll.push_back(draw[4]);
    }
    output.emplace_back(name + "_mu", mean[0]);
    output.emplace_back(name + "_log_variance", mean[1]);
    output.emplace_back(name + "_mean_prediction", mean[3]);
    output.emplace_back(name + "_kl", mean[5]);
    output.emplace_back(name + "_sample_z", nn::stack(zs, 0));
    output.emplace_back(name + "_sample_prediction", nn::stack(prob, 0));
    output.emplace_back(name + "_sample_nll", nn::stack(nll, 0));
  }
  auto test   = Evaluate(deployed, beta, pools[2].images, BetaVaeNoiseAt(eval_noise[2], 0)),
       repeat = Evaluate(deployed, beta, pools[2].images, BetaVaeNoiseAt(eval_noise[2], 0));
  Require(
      Bytes(test[2]) == Bytes(repeat[2]) && Bytes(test[3]) == Bytes(repeat[3]) &&
          Bytes(Decode(deployed, test[2])) == Bytes(test[3]),
      "fixednoise repeat and exact targetfree sampled decode");
  auto other = Evaluate(deployed, beta, pools[2].images, BetaVaeNoiseAt(eval_noise[2], 1));
  Require(
      Bytes(test[2]) != Bytes(other[2]) && Bytes(test[3]) != Bytes(other[3]),
      "changed epsilon changes sample AND probability");
  auto single = Evaluate(
      deployed,
      beta,
      nn::take_rows(pools[2].images, {0}),
      nn::take_rows(BetaVaeNoiseAt(eval_noise[2], 0), {0}));
  const double parity = MaxAbsDiff(single[3], test[3], 784);
  Require(parity < 2e-6, "betaVAE single/batch parity");
  output.emplace_back("zero_prediction", Decode(deployed, nn::zeros({42, 4})));
  auto               prior_z = BetaVaeNoiseAt(prior_noise, 0), prior = Decode(deployed, prior_z);
  const auto         fit_mu = Find(output, "fit_mu").to_vector<float>();
  std::vector<float> center(4), traversal(36 * 4);
  for (int d = 0; d < 4; ++d) {
    double sum = 0;
    for (int b = 0; b < 210; ++b)
      sum += fit_mu[b * 4 + d];
    center[d] = float(sum / 210);
  }
  for (int d = 0; d < 4; ++d)
    for (int k = 0; k < 9; ++k)
      for (int j = 0; j < 4; ++j)
        traversal[(d * 9 + k) * 4 + j] = center[j] + (j == d ? -2.f + .5f * k : 0);
  auto traversal_z = nn::from_vector(traversal, {36, 4}),
       traversal_p = Decode(deployed, traversal_z);
  nn::save_npz(
      (directory / "prior.npz").string(),
      {{"z", prior_z},
       {"probability", prior},
       {"traversal_center", nn::from_vector(center, {4})},
       {"traversal_z", traversal_z},
       {"traversal_probability", traversal_p}});
  auto diagnostics = nn::models::LatentFactorDiagnostics(
      Find(output, "fit_mu"),
      Find(output, "test_mu"),
      pools[0].factors,
      pools[2].factors,
      Find(output, "fit_log_variance"));
  nn::save_npz((directory / "factor_probes.npz").string(), diagnostics);
  Require(
      before == Snapshot(deployed),
      "prior/traversal/factor diagnostics leave all10model tensors immutable");
  nn::save_npz((directory / "outputs.npz").string(), output);
  nn::save_npz((directory / "model_arrays.npz").string(), Arrays(deployed));
  auto         score = BetaVaeScore(deployed, pools[2].images, eval_noise[2], beta);
  const double mse   = Mse(Find(output, "test_mean_prediction"), pools[2].images);
  std::print(
      "| beta{} | {} | {:.9f} | {:.9f} | {:.9f} | {:.9f} | {:.9f} |\n",
      beta,
      selected,
      score[0],
      score[1],
      score[2],
      score[3],
      mse);
  return seconds;
}

int main() {
  const std::filesystem::path root   = "build/beta_vae";
  const int                   epochs = 3;
  const auto                  data   = nn::load_npz((root / "data.npz").string());
  std::vector<BetaFactorData> pools;
  for (const std::string split : {"fit", "validation", "test"})
    pools.push_back(
        {Find(data, split + "_images"),
         Find(data, split + "_factors"),
         Find(data, split + "_source_ids")});
  std::print(
      "| model | selected epoch | test NLL | test KL | common NLL+KL | weighted NLL+beta KL | "
      "decode(mu) MSE |\n|---|---:|---:|---:|---:|---:|---:|\n");
  std::vector<VaeNoiseBank> train_noise,
      eval_noise{BetaVaeNoise(210, 4, 2273), BetaVaeNoise(42, 4, 2267), BetaVaeNoise(42, 4, 2269)};
  auto             prior_noise = BetaVaeNoise(20, 1, 2281);
  nn::NamedTensors noise_arrays{
      {"prior_standard", prior_noise.standard}, {"prior_epsilon", prior_noise.epsilon}};
  for (int split = 0; split < 3; ++split) {
    const std::string name = split == 0 ? "fit" : split == 1 ? "validation" : "test";
    noise_arrays.emplace_back(name + "_standard", eval_noise[split].standard);
    noise_arrays.emplace_back(name + "_epsilon", eval_noise[split].epsilon);
  }
  nn::save_npz((root / "fixed_noise.npz").string(), noise_arrays);
  for (int epoch = 1; epoch <= epochs; ++epoch) {
    train_noise.push_back(BetaVaeNoise(210, 1, 2251 + epoch));
    nn::save_npz(
        (root / ("train_noise_epoch" + std::to_string(epoch) + ".npz")).string(),
        {{"standard", train_noise.back().standard}, {"epsilon", train_noise.back().epsilon}});
  }
  nn::ParameterStore first(2237), second(2237);
  {
    nn::NoGradGuard guard;
    nn::models::BetaVariationalAutoencoder(first, nn::zeros({1, 784}), nn::zeros({1, 4}), 1);
  }
  auto initial = Arrays(first);
  for (const auto& [name, value] : initial)
    second.set(name, value.clone());
  const std::vector<std::int64_t> eight{0, 1, 2, 3, 4, 5, 6, 7};
  auto                            images = nn::take_rows(pools[0].images, eight),
       epsilon                           = nn::take_rows(BetaVaeNoiseAt(eval_noise[0], 0), eight);
  auto a = Evaluate(first, 1, images, epsilon), b = Evaluate(second, 4, images, epsilon);
  for (int i = 0; i < 6; ++i)
    Require(
        Bytes(a[i]) == Bytes(b[i]),
        "initial posterior/sample/probabilities/NLL/KL BITEXACT across betas");
  double mean_kl = 0;
  for (float v : a[5].to_vector<float>())
    mean_kl += v;
  mean_kl /= double(a[5].numel());
  Near(
      b[6].item<float>() - a[6].item<float>(),
      3 * mean_kl,
      2e-4,
      "beta changes weighted objective by EXACT3KL up to scalar reduction roundoff");
  nn::save_npz(
      (root / "initial_forward.npz").string(),
      {{"images", images},
       {"epsilon", epsilon},
       {"mu", a[0]},
       {"log_variance", a[1]},
       {"z", a[2]},
       {"probability", a[3]},
       {"nll", a[4]},
       {"kl", a[5]}});
  double seconds = Train(1, pools, train_noise, eval_noise, prior_noise, epochs, root, initial);
  seconds += Train(4, pools, train_noise, eval_noise, prior_noise, epochs, root, initial);
}
```
