> Held-out reconstructions and empirical code usage

Each row below is original, reconstruction probability, absolute error, fitting-only mean,
expanded 7×7 coarse ID grid and expanded 14×14 fine ID grid. Ten held-out rows are evenly
spaced in source order without quality ranking. Image/error grayscale stays fixed at 0–1;
IDs are divided by fifteen only for display. Code-ID brightness is not semantic ordering.
Decoder outputs are probabilities, not sampled binary pixels.

```{cpp, results="markdown", file="figures/vq2_vae_reconstructions.png", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
  namespace n     = dm::nn;
  const auto data = n::load_npz("build/vq2_vae/data.npz"),
             out  = n::load_npz("build/vq2_vae/outputs.npz");
  auto find       = [](const n::NamedTensors& a, const std::string& name) {
    for (const auto& [key, value] : a)
      if (key == name)
        return value;
    throw std::runtime_error(name);
  };
  const auto x = find(data, "test_images").reshape({42, 784}), rec = find(out, "test_probability");
  const auto mean = n::cast(
      n::mean(n::cast(find(data, "fit_images").reshape({210, 784}), n::DType::Float64), {0}),
      n::DType::Float32);
  const auto top = n::upsample_nearest(
                       n::cast(
                           find(out, "test_top_index_grid").reshape({42, 7, 7, 1}),
                           n::DType::Float32) /
                           15.,
                       4)
                       .reshape({42, 784}),
             bottom = n::upsample_nearest(
                          n::cast(
                              find(out, "test_bottom_index_grid").reshape({42, 14, 14, 1}),
                              n::DType::Float32) /
                              15.,
                          2)
                          .reshape({42, 784});
  const std::vector<n::Tensor> columns{
      x, rec, n::abs(x - rec), n::broadcast_to(mean.reshape({1, 784}), {42, 784}), top, bottom};
  std::vector<n::Tensor> panels;
  const auto             ids = find(data, "test_source_ids").to_vector<int>();
  std::print("Displayed source IDs:");
  for (int k = 0; k < 10; ++k) {
    const int row = k * 41 / 9;
    std::print(" {}", ids[row]);
    for (const auto& c : columns)
      panels.push_back(n::take_rows(c, {row}));
  }
  std::print(".\n");
  n::save_image_grid(
      n::concat(panels, 0).reshape({60, 28, 28, 1}),
      "build/vq2_vae_reconstructions.png",
      6,
      0,
      1,
      4,
      220. / 255.,
      3);
}
