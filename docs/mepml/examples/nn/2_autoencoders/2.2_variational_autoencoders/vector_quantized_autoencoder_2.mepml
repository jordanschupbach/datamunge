```{cpp, results="markdown", file="figures/vq2_vae_usage.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
  namespace n     = dm::nn;
  const auto a    = n::load_npz("build/vq2_vae/outputs.npz");
  auto       find = [&](const std::string& name) {
    for (const auto& [key, value] : a)
      if (key == name)
        return value;
    throw std::runtime_error(name);
  };
  const std::vector<std::string> names{
      "fit_top_code_counts",
      "test_top_code_counts",
      "fit_bottom_code_counts",
      "test_bottom_code_counts"},
      labels{"top fit", "top test", "fine fit", "fine test"};
  const std::vector<dm::RGBA> colours{{37, 99, 235}, {220, 38, 38}, {22, 163, 74}, {147, 51, 234}};
  auto                        chart = dm::graphics::RPlot::create();
  for (int series = 0; series < 4; ++series) {
    const auto          counts = find(names[series]).to_vector<int>();
    std::vector<double> x, y;
    const double        total = (series % 2 == 0 ? 210. : 42.) * (series < 2 ? 49. : 196.);
    for (int k = 0; k < 16; ++k) {
      x.push_back(k - .27 + .18 * series);
      y.push_back(counts[k] / total);
    }
    chart.bars(x, y, labels[series], colours[series], .16);
