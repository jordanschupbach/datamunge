All fifteen archives/1,932,136 array values and complete TSV histories match the frozen
original exactly. Only two summary MSE reductions use tensor Float64 accumulation instead
of host summation, with roundoff below 3e-14; all other non-timing JSON values remain exact.
The first-batch hierarchy probe verifies a nonzero fine-encoding derivative to the coarse
encoder and exactly zero reconstruction derivatives to both dictionaries.

> Keep validation and training observations distinct

Blue records the image-weighted pre-update training objective along each epoch's parameter
path. Red uses the completed epoch's parameters and reconstruction NLL alone. Their gap
therefore is not a direct overfitting estimate or a comparison of identical losses.

```{cpp, results="markdown", file="figures/vq2_vae_validation.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
  std::ifstream input("build/vq2_vae/history.tsv");
  std::string   header;
  std::getline(input, header);
  std::vector<double> e, train, val;
  double              epoch, t, n, dt, db, ct, cb, l;
  while (input >> epoch >> t >> n >> dt >> db >> ct >> cb >> l) {
    e.push_back(epoch);
    train.push_back(t);
    val.push_back(n);
  }
  if (e.size() != 3)
    return 1;
  auto chart = dm::graphics::RPlot::create();
  chart.lines(e, train, "train (pre)", dm::RGBA{37, 99, 235}, 2)
      .points(e, train, "", dm::RGBA{37, 99, 235}, 5)
      .lines(e, val, "val NLL (end)", dm::RGBA{220, 38, 38}, 2)
      .points(e, val, "", dm::RGBA{220, 38, 38}, 5)
      .title("Two-scale fitting / reconstruction NLL selects epoch")
      .x_label("completed epoch / all three eligible")
      .y_label("nats plus latent penalties where included")
      .x_ticks({1, 2, 3}, {"1", "2", "3"})
      .save_svg("build/vq2_vae_validation.svg");
}
