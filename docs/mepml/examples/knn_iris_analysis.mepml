| x | y | LOO k = 1 | LOO k = 3 |
| ---: | ---: | ---: | ---: |
| 1 | 2 | 4 | 4.667 |
| 2 | 4 | 2 | 4.000 |
| 3 | 3 | 4 | 4.333 |
| 4 | 7 | 3 | 4.333 |
| 5 | 6 | 7 | 6.333 |
| 6 | 9 | 6 | 5.333 |


Leave-one-out RMSE for k = 1, ..., 5: [2.415, 2.131, 2.219, 2.259, 2.891]

\image(figures/knn_line.svg)
// result_end

\caption(Left: the six points and the \(k=1\) (blue) and \(k=3\) (red) fits, both step functions. Right: the leave-one-out RMSE for \(k=1,\dots,5\). Table: the leave-one-out predictions.)
\alttext(Left: six black points at x from 1 to 6 with y 2, 4, 3, 7, 6, 9. A blue step function for k equals 1 takes each point's y value between the midpoints. A red step function for k equals 3 is smoother, rising from 3 to about 7.3. Right: leave-one-out RMSE against k from 1 to 5: 2.42, 2.13, 2.22, 2.26 and 2.89, lowest at k equals 2.)

The \(k=1\) column is the hand calculation \((4,2,4,3,7,6)\), and its RMSE is \(\sqrt{35/6}=2.415\). The
\(k=1\) fit is the data's own staircase. The \(k=3\) fit flattens at both ends, because a point near
an end has all its neighbours on one side: at \(x\le2.5\) the three neighbours are \(x=1,2,3\), and the
fit is their mean 3 although \(y\) is rising. This boundary bias is a general weakness of
local averaging. On these six points the leave-one-out RMSE is lowest at \(k=2\).

> Checking the theory

>> Approaching the Cover–Hart limit

Two classes with equal priors, \(X\mid Y=0\sim N((0,0),I)\) and \(X\mid Y=1\sim N((2,0),I)\). Then
\(\eta(x)=1/(1+e^{-(2x_1-2)})\) depends on \(x_1\) only, the Bayes rule is \(x_1>1\), and
\(R^*=\Phi(-1)=0.1587\). The asymptotic risks \(R_k=E[r_k(\eta(X))]\) are one-dimensional integrals over the
mixture density of \(x_1\), evaluated with `knn_asymptotic_risk` on a fine grid. Training sets of
\(n=50\) to 6400 points are drawn (5 replicates each) and classified on 4000 fresh test points with
\(k=1\), 5 and 25, from one fit per training set: `kneighbors` returns the 25 nearest training rows
of every test point, and the votes of the first \(k\) give each rule. The leave-one-out accuracy
of each training set is recorded alongside.

```{cpp, results="markdown", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

using DF = dm::dstruct::DataFrame;

DF draw(dm::random::Xoshiro256StarStar& rng, std::size_t n) {
  std::vector<double> a, b;
  std::vector<std::string> c;
  for (std::size_t i = 0; i < n; ++i) {
    const bool one = rng.uniform(0.0, 1.0) < 0.5;
    a.push_back(rng.normal(one ? 2.0 : 0.0, 1.0)), b.push_back(rng.normal(0.0, 1.0)), c.push_back(one ? "1" : "0");
  }
  DF d;
  d.add_column("x1", a);
  d.add_column("x2", b);
  d.add_column("y", c);
  return d;
}

int main() {
  // Asymptotic risks: integrate r_k(eta(x1)) against the mixture density of x1.
  auto phi = [](double z) { return std::exp(-0.5 * z * z) / std::sqrt(2.0 * std::numbers::pi); };
  auto asymptotic = [&](std::size_t k) {
    double s = 0.0;
    const double h = 0.001;
    for (double x = -9.0; x <= 11.0; x += h)
      s += dm::stats::knn_asymptotic_risk(1.0 / (1.0 + std::exp(-(2.0 * x - 2.0))), k) * 0.5 * (phi(x) + phi(x - 2.0)) * h;
    return s;
  };
  const double bayes = dm::random::normal_cdf(-1.0);
  const std::vector<std::size_t> ks{1, 5, 25};
  std::print("Bayes risk {:.4f}; Cover-Hart bound 2R*(1-R*) = {:.4f}; asymptotic R_1 = {:.4f}, R_5 = {:.4f}, R_25 = {:.4f}\n\n",
             bayes, 2 * bayes * (1 - bayes), asymptotic(1), asymptotic(5), asymptotic(25));

  dm::random::Xoshiro256StarStar rng(21);
  const DF test = draw(rng, 4000);
  const auto& truth = test.get_column<std::string>("y").values();
  DF table;
  std::vector<double> ns, err[3], loo[3];
  for (const std::size_t n : {50u, 100u, 400u, 1600u, 6400u}) {
    double e[3] = {0, 0, 0}, l[3] = {0, 0, 0};
    const int reps = 5;
    for (int r = 0; r < reps; ++r) {
      const DF train = draw(rng, n);
      const dm::stats::KNNClassifier knn(train, "y ~ x1 + x2", {.k = 25, .standardize = false});
      const auto labels = train.get_column<std::string>("y").values();
      const auto nb = knn.kneighbors(test);
      for (std::size_t t = 0; t < truth.size(); ++t) {
        int ones = 0;
        for (std::size_t j = 0; j < 25; ++j) {
          ones += labels[nb.index[t][j]] == "1";
          for (int m = 0; m < 3; ++m)
            if (j + 1 == ks[m]) e[m] += ((2 * ones > int(ks[m])) != (truth[t] == "1")) / double(truth.size() * reps);
        }
      }
      const auto path = knn.loo_accuracy_path(25);
      for (int m = 0; m < 3; ++m) l[m] += (1.0 - path[ks[m] - 1]) / reps;
    }
    ns.push_back(double(n));
    for (int m = 0; m < 3; ++m) err[m].push_back(e[m]), loo[m].push_back(l[m]);
  }
  table.add_column("n", ns);
  for (int m = 0; m < 3; ++m) {
    table.add_column(std::format("test k={}", ks[m]), err[m]);
    table.add_column(std::format("LOO k={}", ks[m]), loo[m]);
  }
  DF::MarkdownOptions md;
  md.digits = 4;
  md.column_digits = {{"n", 0}};
  std::print("{}\n", table.to_md(md));
}
```
// result_begin: markdown
Bayes risk 0.1587; Cover-Hart bound 2R*(1-R*) = 0.2670; asymptotic R_1 = 0.2248, R_5 = 0.1802, R_25 = 0.1634

| n | test k=1 | LOO k=1 | test k=5 | LOO k=5 | test k=25 | LOO k=25 |
| ---: | ---: | ---: | ---: | ---: | ---: | ---: |
| 50 | 0.2375 | 0.2400 | 0.1817 | 0.2000 | 0.1868 | 0.1800 |
| 100 | 0.2304 | 0.2100 | 0.1923 | 0.1820 | 0.1670 | 0.1600 |
| 400 | 0.2339 | 0.2170 | 0.1918 | 0.1745 | 0.1709 | 0.1630 |
| 1600 | 0.2213 | 0.2225 | 0.1806 | 0.1772 | 0.1667 | 0.1589 |
| 6400 | 0.2273 | 0.2300 | 0.1875 | 0.1877 | 0.1689 | 0.1682 |
// result_end

The asymptotic risks lie between the Bayes risk 0.159 and the Cover–Hart bound 0.267:
\(R_1=0.225\), \(R_5=0.180\), \(R_{25}=0.163\). The simulated test errors settle near them. The
test set's own sampling error is about 0.006, so the 1-NN and 5-NN errors (0.227 and 0.188 at
\(n=6400\)) are within about one standard error of their limits. The 25-NN error stays about
0.005 above its limit, because at these sample sizes 25 neighbours still reach some way from the
query, where \(\eta\) differs. For this smooth problem the 1-NN error is already at its limit at
\(n=50\). More data does not make 1-NN better; only a larger \(k\) moves the error towards the Bayes
risk. The leave-one-out error of each training set tracks the test error. Its largest
deviations, up to 0.02, are at \(n\le400\), where a training set of a few hundred points is itself
noisy.

>> Irrelevant predictors and the concentration of distances

The same two-class problem with \(p_0=0,2,8,32,128\) extra predictors of pure \(N(0,1)\) noise,
\(n=400\) training points and \(k=15\), all standardised. For each \(p_0\) the test error on 2000
points is averaged over 5 training sets. The relative contrast \((d_{\max}-d_{\min})/d_{\min}\) of the
distances from a test point to the training points measures how distinct the nearest neighbour
is.

```{cpp, results="markdown", file="figures/knn_theory.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

using DF = dm::dstruct::DataFrame;

DF draw(dm::random::Xoshiro256StarStar& rng, std::size_t n, std::size_t noise) {
  std::vector<std::vector<double>> cols(2 + noise);
  std::vector<std::string> c;
  for (std::size_t i = 0; i < n; ++i) {
    const bool one = rng.uniform(0.0, 1.0) < 0.5;
    cols[0].push_back(rng.normal(one ? 2.0 : 0.0, 1.0));
    for (std::size_t j = 1; j < cols.size(); ++j) cols[j].push_back(rng.normal(0.0, 1.0));
    c.push_back(one ? "1" : "0");
  }
  DF d;
  for (std::size_t j = 0; j < cols.size(); ++j) d.add_column(std::format("x{}", j + 1), cols[j]);
  d.add_column("y", c);
  return d;
}

int main() {
  std::filesystem::create_directories("build");
  dm::random::Xoshiro256StarStar rng(22);
  std::vector<double> noise_dims, errors, contrast;
  for (const std::size_t p0 : {0u, 2u, 8u, 32u, 128u}) {
    double e = 0.0, rc = 0.0;
    const int reps = 5;
    for (int r = 0; r < reps; ++r) {
      const DF train = draw(rng, 400, p0), test = draw(rng, 2000, p0);
      const dm::stats::KNNClassifier knn(train, "y ~ .", {.k = 15});
      const auto pred = knn.predict(test);
      const auto& truth = test.get_column<std::string>("y").values();
      for (std::size_t t = 0; t < truth.size(); ++t) e += (pred[t] != truth[t]) / (2000.0 * reps);
      // Relative contrast from 200 test points, using all 400 training distances.
      dm::stats::KNNClassifierOptions all{.k = 400};
      const dm::stats::KNNClassifier everyone(train, "y ~ .", all);
      const auto nb = everyone.kneighbors(test.head(200));
      for (const auto& d : nb.distance) rc += (d.back() - d.front()) / d.front() / (200.0 * reps);
    }
    noise_dims.push_back(double(p0)), errors.push_back(e), contrast.push_back(rc);
  }
  DF table;
  table.add_column("noise predictors", noise_dims);
  table.add_column("test error (k = 15)", errors);
  table.add_column("(d_max - d_min) / d_min", contrast);
  DF::MarkdownOptions md;
  md.digits = 3;
  md.column_digits = {{"noise predictors", 0}};
  std::print("{}\n\n", table.to_md(md));

  // Regression bias and variance on a fixed design: x_i = i / 100, f(x) = sin(2 pi x), sigma = 0.3.
  const std::size_t n = 100;
  const double sigma = 0.3;
  auto f = [](double x) { return std::sin(2.0 * std::numbers::pi * x); };
  std::vector<double> x(n);
  for (std::size_t i = 0; i < n; ++i) x[i] = (i + 1.0) / n;
  std::vector<double> x0;
  for (int j = 0; j < 40; ++j) x0.push_back(0.1 + 0.8 * (j + 0.37) / 40.0);
  DF grid;
  grid.add_column("x", x0);
  const std::vector<std::size_t> ks{1, 2, 3, 5, 8, 12, 18, 27, 40};
  const int reps = 400;
  std::vector<double> sim_mse(ks.size()), bias2(ks.size()), variance(ks.size());
  std::vector<std::vector<double>> example_fit(3);
  for (std::size_t m = 0; m < ks.size(); ++m) {
    // Theory: the neighbour sets depend on x only.
    DF design;
    design.add_column("x", x);
    design.add_column("y", std::vector<double>(n, 0.0));
    const auto nb = dm::stats::KNNRegressor(design, "y ~ x", {.k = ks[m]}).kneighbors(grid);
    for (std::size_t j = 0; j < x0.size(); ++j) {
      double mean_f = 0.0;
      for (const auto i : nb.index[j]) mean_f += f(x[i]) / ks[m];
      bias2[m] += std::pow(mean_f - f(x0[j]), 2) / x0.size();
    }
    variance[m] = sigma * sigma / ks[m];
  }
  for (int r = 0; r < reps; ++r) {
    std::vector<double> y(n);
    for (std::size_t i = 0; i < n; ++i) y[i] = f(x[i]) + rng.normal(0.0, sigma);
    DF data;
    data.add_column("x", x);
    data.add_column("y", y);
    for (std::size_t m = 0; m < ks.size(); ++m) {
      const auto pred = dm::stats::KNNRegressor(data, "y ~ x", {.k = ks[m]}).predict(grid);
      for (std::size_t j = 0; j < x0.size(); ++j) sim_mse[m] += std::pow(pred[j] - f(x0[j]), 2) / (x0.size() * reps);
    }
  }
  std::vector<double> theory;
  for (std::size_t m = 0; m < ks.size(); ++m) theory.push_back(bias2[m] + variance[m]);
  DF reg;
  reg.add_column("k", std::vector<double>(ks.begin(), ks.end()));
  reg.add_column("bias^2", bias2);
  reg.add_column("sigma^2 / k", variance);
  reg.add_column("theory MSE", theory);
  reg.add_column("simulated MSE", sim_mse);
  md.column_digits = {{"k", 0}};
  md.digits = 4;
  std::print("{}\n", reg.to_md(md));

  auto dims = dm::graphics::RPlot::create();
  std::vector<double> lp;
  for (const double p0 : noise_dims) lp.push_back(std::log2(p0 + 1.0));
  dims.lines(lp, errors, dm::RGB{37, 99, 235}, 2.0).points(lp, errors, dm::RGB{37, 99, 235}, 7.0);
  dims.lines({-0.2, 7.3}, {dm::random::normal_cdf(-1.0), dm::random::normal_cdf(-1.0)}, dm::RGB{148, 163, 184}, 1.5);
  dims.text(5.8, 0.135, "Bayes risk", dm::RGB{100, 116, 139}, 13.0);
  dims.x_limits(-0.2, 7.3).y_limits(0.0, 0.5).title("Test error with noise predictors")
      .x_label("log2(1 + noise predictors)").y_label("test error");

  auto bv = dm::graphics::RPlot::create();
  std::vector<double> lk;
  for (const auto k : ks) lk.push_back(std::log2(double(k)));
  bv.lines(lk, theory, "theory MSE", dm::RGB{17, 24, 39}, 2.0)
      .lines(lk, bias2, "bias^2", dm::RGB{220, 38, 38}, 1.5)
      .lines(lk, variance, "variance", dm::RGB{37, 99, 235}, 1.5);
  bv.points(lk, sim_mse, "simulated MSE", dm::RGB{22, 163, 74}, 7.0);
  bv.x_limits(-0.2, 5.5).y_limits(0.0, 0.12).title("Regression MSE against k")
      .x_label("log2 k").y_label("mean squared error");

  auto fig = dm::graphics::RLayout::create(1, 2);
  fig.add(dims).add(bv).size(1100, 460).fit_panels();
  fig.save_svg("build/knn_theory.svg");
}
```
