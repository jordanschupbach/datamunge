m = 2: mean vote for class 1 0.7500, sigma^2 = 0.1875, rho = 0.1868, limit rho sigma^2 = 0.0350

| m | B | variance, simulated | rho sigma^2 + (1 - rho) sigma^2 / B |
| ---: | ---: | ---: | ---: |
| 1 | 1 | 0.1852 | 0.1864 |
| 1 | 2 | 0.0994 | 0.1073 |
| 1 | 3 | 0.0769 | 0.0810 |
| 1 | 5 | 0.0553 | 0.0599 |
| 1 | 10 | 0.0428 | 0.0441 |
| 1 | 20 | 0.0342 | 0.0362 |
| 1 | 50 | 0.0298 | 0.0314 |
| 1 | 100 | 0.0291 | 0.0298 |
| 2 | 1 | 0.1867 | 0.1875 |
| 2 | 2 | 0.1071 | 0.1112 |
| 2 | 3 | 0.0851 | 0.0858 |
| 2 | 5 | 0.0675 | 0.0655 |
| 2 | 10 | 0.0522 | 0.0503 |
| 2 | 20 | 0.0424 | 0.0426 |
| 2 | 50 | 0.0391 | 0.0381 |
| 2 | 100 | 0.0377 | 0.0365 |


\image(figures/rf_variance.svg)
// result_end

\caption(Variance over 1000 training sets of the vote share for class 1 at \((0.5,0.5)\) of the first \(B\) trees (dots), and the law \(\rho\sigma^2+(1-\rho)\sigma^2/B\) with \(\sigma^2\) and \(\rho\) estimated from single trees and pairs of trees (lines), for \(m=1\) (blue) and bagging, \(m=2\) (red). The axis for \(B\) is logarithmic.)
\alttext(Variance against number of trees on a logarithmic axis from 1 to 100. Both sets of dots start near 0.19 at one tree and fall quickly, levelling off by 50 trees. The red dots and line for m equals 2 level off at about 0.037, the blue ones for m equals 1 slightly lower at about 0.029. The dots lie on or just below their lines.)

One tree's vote is a 0/1 variable with mean 0.75, so its variance is \(\sigma^2=0.75\cdot0.25\approx0.19\). (A deep tree votes for class
1 at \(x_0\) only 75% of the time, against a true probability of 0.85, because its small leaf at \(x_0\)
often holds a flipped label or a point from beyond the nearby boundary.) Two trees of the same
forest are correlated, with \(\rho=0.187\) for bagging and 0.152 for the random forest. The variance of
the vote share follows \(\rho\sigma^2+(1-\rho)\sigma^2/B\) at every \(B\). The largest gap is 8% (at \(B=5\) for \(m=1\)); the
sampling error of a variance estimated from 1000 training sets is about 4.5%. Most of the gain comes
from the first 20 trees, and then the variance levels off at \(\rho\sigma^2\): 0.035 for bagging and 0.028 for the
random forest. A random predictor per split lowers that floor by a fifth, but even 100 trees leave
a standard deviation of 0.17 in the vote at \(x_0\) across training sets: the variance that remains
comes from the data, which every tree shares.

>> Out-of-bag error against test error

For 200 training sets of 200 points on the noisy disc, a forest of 200 trees, its out-of-bag error
after each tree (`oob_accuracy_path()`) and the error of its first \(t\) trees on 5000 fresh points.
If the out-of-bag vote of \(t\) trees behaves like a forest of \(q_nt\approx0.37t\) trees, its curve should
follow the test error curve evaluated at \(0.37t\).

```{cpp, results="markdown", file="figures/rf_oob_path.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

int main() {
  std::filesystem::create_directories("build");
  const int reps = 200, B = 200, n_test = 5000;
  const auto test = dm::datasets::circle(n_test, 2, 0.15, 7);
  std::vector<std::vector<double>> x(n_test);
  std::vector<std::size_t> truth(n_test);
  for (int i = 0; i < n_test; ++i) x[i] = {test.double_at("x1", i), test.double_at("x2", i)}, truth[i] = test.string_at("class", i) == "2";
  std::vector<double> oob_path(B, 0.0), test_path(B, 0.0), oob_final, test_final;
  for (int r = 0; r < reps; ++r) {
    const auto train = dm::datasets::circle(200, 2, 0.15, 5000 + r);
    const dm::stats::RandomForestClassifier forest(train, "class ~ x1 + x2", {.n_trees = B, .seed = std::uint64_t(r + 1)});
    const auto path = forest.oob_accuracy_path();
    std::vector<std::array<int, 2>> count(n_test, {0, 0});
    std::vector<std::vector<std::size_t>> votes(n_test);
    for (int i = 0; i < n_test; ++i) votes[i] = forest.tree_votes(x[i]);
    for (int t = 0; t < B; ++t) {
      int wrong = 0;
      for (int i = 0; i < n_test; ++i) {
        ++count[i][votes[i][t]];
        wrong += std::size_t(count[i][1] > count[i][0]) != truth[i];  // ties go to the first class, "1"
      }
      test_path[t] += double(wrong) / n_test / reps;
      oob_path[t] += (1.0 - path[t]) / reps;
      if (t == B - 1) test_final.push_back(double(wrong) / n_test), oob_final.push_back(1.0 - path[t]);
    }
  }
  auto test_at = [&](double t) {  // test error curve at a fractional number of trees
    const double c = std::clamp(t, 1.0, double(B)) - 1.0;
    const std::size_t k = std::size_t(c);
    return k + 1 < test_path.size() ? test_path[k] + (c - k) * (test_path[k + 1] - test_path[k]) : test_path.back();
  };
  const double q = std::exp(-1.0);
  std::vector<double> ts, a, b;
  std::vector<std::optional<double>> c;  // 0.37 t is below one tree for t < 3
  for (const int t : {1, 2, 3, 5, 10, 20, 50, 100, 200})
    ts.push_back(t), a.push_back(oob_path[t - 1]), b.push_back(test_path[t - 1]), c.push_back(t * q >= 1.0 ? std::optional(test_at(t * q)) : std::nullopt);
  dm::dstruct::DataFrame table;
  table.add_column("trees t", ts);
  table.add_column("out-of-bag error", a);
  table.add_column("test error, t trees", b);
  table.add_column("test error, 0.37 t trees", c);
  dm::dstruct::DataFrame::MarkdownOptions md;
  md.digits = 4;
  md.column_digits = {{"trees t", 0}};
  std::print("{}\n\n", table.to_md(md));
  double mo = 0, mt = 0, md_ = 0, sd = 0, so = 0, st = 0;
  for (int r = 0; r < reps; ++r) mo += oob_final[r] / reps, mt += test_final[r] / reps;
  for (int r = 0; r < reps; ++r) {
    const double diff = oob_final[r] - test_final[r] - (mo - mt);
    sd += diff * diff / (reps - 1), so += std::pow(oob_final[r] - mo, 2) / (reps - 1), st += std::pow(test_final[r] - mt, 2) / (reps - 1);
  }
  md_ = mo - mt;
  std::print("With 200 trees: mean out-of-bag error {:.4f}, mean test error {:.4f}, difference {:.4f} (standard error {:.4f}); "
             "standard deviation over training sets {:.4f} (out of bag) and {:.4f} (test).\n\n",
             mo, mt, md_, std::sqrt(sd / reps), std::sqrt(so), std::sqrt(st));

  std::vector<double> lt, po, pt, ps;
  for (int t = 1; t <= B; ++t) {
    lt.push_back(std::log10(t)), po.push_back(oob_path[t - 1]), pt.push_back(test_path[t - 1]);
    ps.push_back(t * q >= 1.0 ? test_at(t * q) : test_path[0]);
  }
  auto p = dm::graphics::RPlot::create();
  p.lines(lt, pt, "test, t trees", dm::RGB{17, 24, 39}, 2.0)
      .lines(lt, ps, "test, 0.37 t trees", dm::RGB{220, 38, 38}, 1.5)
      .lines(lt, po, "out of bag, t trees", dm::RGB{37, 99, 235}, 2.0)
      .lines({0.0, std::log10(200.0)}, {0.15, 0.15}, "Bayes error", dm::RGB{148, 163, 184}, 1.5);
  p.x_ticks({0.0, std::log10(2.0), std::log10(5.0), 1.0, std::log10(20.0), std::log10(50.0), 2.0, std::log10(200.0)},
            {"1", "2", "5", "10", "20", "50", "100", "200"})
      .x_limits(0.0, std::log10(200.0)).y_limits(0.1, 0.42).title("Error against number of trees")
      .x_label("trees t").y_label("error, mean of 200 training sets");
  p.size(800, 500);
  p.save_svg("build/rf_oob_path.svg");
}
```
