```{cpp, file="figures/zobrist_pixels.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
  auto pixels = dm::datasets::digits();
  pixels.remove_column("digit");
  const auto boards = dm::algorithms::zobrist_boards(pixels.head(2), 17);
  std::vector<double> cells(64);
  std::iota(cells.begin(), cells.end(), 0);
  std::filesystem::create_directories("build");
  dm::graphics::RPlot::create()
      .line(cells, std::vector<double>(boards[0].begin(), boards[0].end()), "first image: 0", dm::RGB{37, 99, 235}, 2)
      .line(cells, std::vector<double>(boards[1].begin(), boards[1].end()), "second image: 1", dm::RGB{220, 38, 38}, 2)
      .title("The two configurations before hashing")
      .x_label("row-major pixel index").y_label("grey-level category")
      .y_limits(0, 16).size(900, 460).save_svg("build/zobrist_pixels.svg");
}
