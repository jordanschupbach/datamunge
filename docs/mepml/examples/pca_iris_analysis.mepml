// result_end
\caption(Exact axes, eigenvalues and perpendicular residuals give an independently checkable reconstruction identity.)
\alttext(Four original points connect to their diagonal projections. A second panel compares measured SSE at zero, one and two axes with the exact values forty, eight and zero. Tables give the spectrum and measured error.)

>> A metric change can reverse the meaning of a smaller error

Multiplying only y by 100 changes raw covariance PCA but leaves the standardized
correlation matrix and its .8/.2 variance shares unchanged. This is a unit transformation,
not new evidence about which variable matters. For a separate query, fit the same
four-point pattern with y multiplied by ten and scaling enabled. Choose the query's
standardized coordinates as (1,0). The leading standardized axis is the diagonal:
its residual is (.5,-.5), half the preprocessed squared error of the zero-axis fit.
But y's scale is ten times larger, so original-unit squared error grows from s_x^2
to (s_x^2+s_y^2)/4=25.25*s_x^2. The plot divides each RMS by its own zero-axis RMS.

```{cpp, results="markdown", file="figures/pca_iris_metric.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
  using namespace dm::stats;
  dm::dstruct::DataFrame d;
  d.add_column("x", std::vector<double>{-3, -1, 1, 3});
  d.add_column("y", std::vector<double>{-1, -3, 3, 1});
  const auto changed = d.mutate_with("y", [](const auto& r) { return 100 * r.get_double("y"); });
  std::vector<double> first = {
      PCA(d, {"x", "y"}, PCAOptions{true, false}).explained_variance_ratio()[0],
      PCA(changed, {"x", "y"}, PCAOptions{true, false}).explained_variance_ratio()[0],
      PCA(d, {"x", "y"}).explained_variance_ratio()[0],
      PCA(changed, {"x", "y"}).explained_variance_ratio()[0]};
  const auto stretched = d.mutate_with("y", [](const auto& r) { return 10 * r.get_double("y"); });
  const PCA  fit(stretched, {"x", "y"});
  dm::dstruct::DataFrame q;
  q.add_column("x", std::vector<double>{fit.scales()[0]});
  q.add_column("y", std::vector<double>{0});
  const auto curve  = fit.reconstruction_curve(q);
  auto       pre    = curve.numeric_column("preprocessed_rmse").values(),
       raw          = curve.numeric_column("original_rmse").values();
  const double pre0 = pre[0], raw0 = raw[0];
  for (auto& v : pre)
    v /= pre0;
  for (auto& v : raw)
    v /= raw0;
  auto shares = dm::graphics::RPlot::create(), errors = dm::graphics::RPlot::create();
  shares.bars({0, 1, 2, 3}, first, "PC1 share", {37, 99, 235}, .5)
      .title("Feature units affect covariance PCA")
      .x_label("0 raw, 1 new units, 2 scaled, 3 scaled new units")
      .y_label("first-component energy share")
      .y_limits(0, 1.4);
  errors.line({0, 1, 2}, pre, "preprocessed", {37, 99, 235})
      .line({0, 1, 2}, raw, "original units", {220, 38, 38})
      .title("Query errors use different metrics")
      .x_label("retained components")
      .y_label("RMS divided by its zero-axis RMS")
      .y_limits(0, 7);
  dm::dstruct::DataFrame table;
  table.add_column(
      "fit", std::vector<std::string>{"raw", "raw, y times 100", "scaled", "scaled, y times 100"});
  table.add_column("pc1_share", first);
  std::filesystem::create_directories("build");
  dm::graphics::RLayout::create(1, 2).add(shares).add(errors).size(1100, 490).fit_panels().save_svg(
      "build/pca_iris_metric.svg");
  std::print("{}\n\nQuery reconstruction errors:\n\n{}\n", table.to_md(9), curve.to_md(9));
}
```
