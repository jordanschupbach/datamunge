\alttext(PC1/PC2 scores coloured by species sit beside the four-component scree plot. Tables report the four training means and sample scales, spectral shares and principal-axis coefficients.)

>> Measure reconstruction and compare raw versus scaled fits

The standardized training fit's discarded eigenvalues predict the measured
preprocessed error at every retained prefix. k=0 is the mean-only reconstruction,
and k=4 leaves only floating-point residuals. A raw covariance fit uses the same
centred observations but minimizes error in centimetres rather than feature-standardized
units. All four Iris features share those units, so their pooled original-unit RMS
is interpretable in centimetres. The raw fit cannot have worse training raw-unit error
than a scaled fit at the same k, apart from numerical tolerance. Its larger leading
variance share reflects a different objective, not a more informative representation.

```{cpp, results="markdown", file="figures/pca_iris_reconstruction.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
  using namespace dm::stats;
  const auto                     d = dm::datasets::iris();
  const std::vector<std::string> f = {"Sepal.Length", "Sepal.Width", "Petal.Length", "Petal.Width"};
  const PCA                      scaled(d, f), raw(d, f, PCAOptions{true, false});
  const auto a = scaled.reconstruction_curve(d), b = raw.reconstruction_curve(d),
             spectrum = scaled.spectrum();
  std::vector<double> tail, expected;
  long double         total = 0;
  for (double v : scaled.explained_variance())
    total += v;
  tail.push_back(double((scaled.observations() - 1) * total));
  for (std::size_t i = 0; i < 4; ++i)
    tail.push_back(spectrum.double_at("tail_sse", i));
  for (std::size_t k = 0; k <= 4; ++k) {
    if (std::abs(tail[k] - a.double_at("preprocessed_sse", k)) > 1e-8)
      throw std::runtime_error("tail identity mismatch");
    expected.push_back(std::sqrt(tail[k] / (d.nrows() * f.size())));
  }
  auto       identity = dm::graphics::RPlot::create(), comparison = dm::graphics::RPlot::create();
  const auto k = a.numeric_column("components").values();
  identity.line(k, a.numeric_column("preprocessed_rmse").values(), "measured", {37, 99, 235})
      .points(k, expected, "eigenvalue tail", {220, 38, 38}, 5)
      .title("Measured RMS matches the spectral tail")
      .x_label("retained components")
      .y_label("standardized RMS per entry")
      .y_limits(0, 1.4);
  comparison.line(k, a.numeric_column("original_rmse").values(), "scaled fit", {37, 99, 235})
      .line(k, b.numeric_column("original_rmse").values(), "raw fit", {220, 38, 38})
      .title("A raw fit optimizes error in centimetres")
      .x_label("retained components")
      .y_label("original-unit RMS (cm)")
      .y_limits(0, 1.4);
  auto table = a;
  table.add_column("training_eigenvalue_tail_sse", tail);
  table.add_column("raw_fit_original_rmse", b.numeric_column("original_rmse").values());
  std::filesystem::create_directories("build");
  dm::graphics::RLayout::create(1, 2)
      .add(identity)
      .add(comparison)
      .size(1100, 490)
      .fit_panels()
      .save_svg("build/pca_iris_reconstruction.svg");
  std::print(
      "{}\n\nFirst two components retain {:.6f}% (scaled) and {:.6f}% (raw) of their respective "
      "total energies.\nFull-basis standardized residual SSE: {:.9e}.\n",
      table.to_md(10),
      100 * scaled.cumulative_explained_variance_ratio()[1],
      100 * raw.cumulative_explained_variance_ratio()[1],
      a.double_at("preprocessed_sse", 4));
}
```
