```{cpp, results="markdown", file="figures/class_means.png", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <datamunge/nn/cifar10_study.hpp>
#include <datamunge/nn/classification_analysis.hpp>
#include <map>
int main() {
  namespace n = dm::nn;
  namespace s = n::study;
  n::set_num_threads(8);
  std::filesystem::create_directories("build");
  const auto             data = s::restore_cifar10_study("artifacts/preprocessing.npz");
  const auto             y    = data.fit.labels.to_vector<int64_t>();
  std::vector<n::Tensor> means;
  for (int c = 0; c < 10; ++c) {
    std::vector<int64_t> ids;
    for (int64_t i = 0; i < static_cast<int64_t>(y.size()); ++i)
