```{cpp, results="markdown", file="figures/risk_coverage.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <datamunge/nn/cifar10_study.hpp>
#include <datamunge/nn/classification_analysis.hpp>
#include <map>
int main() {
  namespace n = dm::nn;
  std::map<std::string, n::Tensor> a;
  for (const auto& [k, v] : n::load_npz("artifacts/evaluation.npz"))
    a[k] = v;
  const auto d = n::study::classification_diagnostics(
      a.at("test_logits"), a.at("test_labels"), a.at("temperature").item());
  const auto confidence           = n::max(d.probabilities, {1}).to_vector<double>(),
             truth                = a.at("test_labels").to_vector<double>();
  const auto           prediction = n::argmax(d.probabilities, 1).to_vector<int64_t>();
  std::vector<int64_t> ids(10000);
  std::iota(ids.begin(), ids.end(), 0);
  std::stable_sort(
      ids.begin(), ids.end(), [&](auto i, auto j) { return confidence[i] > confidence[j]; });
  std::vector<double> coverage, risk;
  int                 mistakes = 0;
  std::print(
      "| Retained fraction | Error rate among retained | Threshold confidence "
      "|\n|---|---:|---:|\n");
  for (int k = 1; k <= 10000; ++k) {
    mistakes += prediction[ids[k - 1]] != truth[ids[k - 1]];
    if (k % 100 == 0) {
      coverage.push_back(k / 10000.);
      risk.push_back(mistakes / double(k));
    }
    if (k == 2000 || k == 5000 || k == 8000 || k == 9000 || k == 10000)
      std::print(
          "| {:.2f} | {:.4f} | {:.4f} |\n",
          k / 10000.,
          mistakes / double(k),
          confidence[ids[k - 1]]);
  }
  std::filesystem::create_directories("build");
  auto p = dm::graphics::RPlot::create();
  p.line(coverage, risk, "")
      .x_label("Coverage: fraction retained")
      .y_label("Selective error rate")
      .title("Confidence-based abstention: descriptive test curve")
      .size(850, 480)
      .save_svg("build/risk_coverage.svg");
}
```
