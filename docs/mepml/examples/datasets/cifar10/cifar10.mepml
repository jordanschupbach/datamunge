```{cpp, results="markdown", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <datamunge/nn/cifar10_study.hpp>
#include <datamunge/nn/classification_analysis.hpp>
#include <map>
int main() {
  namespace n = dm::nn;
  std::map<std::string, n::Tensor> a;
  for (const auto& [k, v] : n::load_npz("artifacts/explanations.npz"))
    a[k] = v;
  const auto ids = a.at("ids").to_vector<int64_t>();
  std::print(
      "| Row | Test ID | Target | Logit difference | IG128 residual | IG256 residual | IG512 "
      "residual | IG-ranked deletion drop | Random deletion drop "
      "|\n|---|---:|---|---:|---:|---:|---:|---:|---:|\n");
  for (int64_t i = 0; i < static_cast<int64_t>(ids.size()); ++i)
    std::print(
        "| {} | {} | {} | {:.4f} | {:.4f} | {:.4f} | {:.4f} | {:.4f} | {:.4f} |\n",
        i + 1,
        ids[i],
        n::study::cifar10_classes[a.at("targets").at({i})],
        a.at("score_difference").at({i}),
        a.at("completeness128").at({i}),
        a.at("completeness256").at({i}),
        a.at("completeness512").at({i}),
        a.at("ig_top25_drop").at({i}),
        a.at("random25_drop").at({i}));
  const auto cam     = a.at("cam_normalized").reshape({static_cast<int64_t>(ids.size()), 16}),
             control = a.at("cam_random_head").reshape(cam.shape());
  const auto cosine  = n::sum(cam * control, {1}) /
                      n::maximum(
                          n::sqrt(n::sum(n::square(cam), {1}) * n::sum(n::square(control), {1})),
                          n::scalar_like(1e-12, cam));
  const double change = n::mean(n::abs(a.at("ig512") - a.at("ig_black512"))).item();
  std::print(
      "\nMean absolute pixel-channel attribution change, fitting-mean versus black baseline: "
      "{:.6f}. Mean cosine similarity of normalised trained-head and random-head Grad-CAM: {:.4f} "
      "(zero maps use zero).\n",
      change,
      n::mean(cosine).item());
}
