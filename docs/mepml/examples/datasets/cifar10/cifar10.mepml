```{cpp, results="markdown", file="figures/training_examples.png", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <datamunge/nn/cifar10_study.hpp>
#include <datamunge/nn/classification_analysis.hpp>
#include <map>
int main() {
  namespace n = dm::nn;
  namespace s = n::study;
  n::set_num_threads(8);
  std::filesystem::create_directories("build");
  const auto           data = s::restore_cifar10_study("artifacts/preprocessing.npz");
  std::vector<int64_t> rows;
  const auto           y = data.fit.labels.to_vector<int64_t>();
  for (int c = 0; c < 10; ++c)
    for (int j = 0; j < 5; ++j) {
      int seen = 0;
      for (int64_t i = 0; i < static_cast<int64_t>(y.size()); ++i)
        if (y[i] == c && seen++ == j) {
          rows.push_back(i);
          break;
        }
    }
  n::save_image_grid(
      n::take_rows(data.fit.images, rows), "build/training_examples.png", 5, 0, 1, 2, 1, 4);
  std::print("Five fitting images per class; rows follow original class IDs 0 through 9.\n");
}
