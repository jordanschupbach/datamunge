```{cpp, results="markdown", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <datamunge/nn/cifar10_study.hpp>
#include <datamunge/nn/classification_analysis.hpp>
#include <map>
int main() {
  namespace n = dm::nn;
  std::map<std::string, n::Tensor> a;
  for (const auto& [k, v] : n::load_npz("artifacts/evaluation.npz"))
    a[k] = v;
  const auto c = n::ConfusionMatrix::from_counts(a.at("confusion"));
  std::print("| True class | Support | Precision | Recall | F1 |\n|---|---:|---:|---:|---:|\n");
  for (int i = 0; i < 10; ++i) {
    const auto m = c.per_class(i);
    std::print(
        "| {} | {} | {:.4f} | {:.4f} | {:.4f} |\n",
        n::study::cifar10_classes[i],
        m.support,
        m.precision,
        m.recall,
        m.f1);
  }
  std::vector<std::tuple<uint64_t, int, int>> errors;
  for (int i = 0; i < 10; ++i)
    for (int j = 0; j < 10; ++j)
      if (i != j)
        errors.emplace_back(c.cells()[i][j], i, j);
  std::sort(errors.begin(), errors.end(), std::greater<>());
  std::print("\n| True → predicted | Errors | Fraction of true class |\n|---|---:|---:|\n");
  for (int k = 0; k < 8; ++k) {
    const auto [count, i, j] = errors[k];
    std::print(
        "| {} → {} | {} | {:.2f}% |\n",
        n::study::cifar10_classes[i],
        n::study::cifar10_classes[j],
        count,
        count / 10.);
  }
}
