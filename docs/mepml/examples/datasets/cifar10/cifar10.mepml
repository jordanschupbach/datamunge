> Training implementation and convergence evidence

The following complete program contains the actual fitting loop. Normal report builds read the retained training record. Set `DATAMUNGE_CIFAR10_RETRAIN=1` to execute both pilots and the complete convergence schedule again; this replaces model and training artifacts. Initialisation seed is 17, split seed 20261030, batch-order seed 2026, and each augmentation epoch uses seed `151 + epoch`. Archived row IDs avoid dependence on a platform's shuffle implementation.

Measured runtime is for native Float32 CPU training on an AMD Ryzen 9 9955HX with eight datamunge threads and single-thread OpenBLAS. The NVIDIA driver was unavailable for this run. Wall time includes fitting, per-epoch validation and checkpoint writes for both pilots and the continuation; it excludes final evaluation and explanation computation.

```{cpp, results="markdown", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <chrono>
#include <datamunge/nn/cifar10_study.hpp>
#include <fstream>
#include <iomanip>
#include <iostream>
#include <sstream>

int main() {
  namespace n = dm::nn;
  namespace s = n::study;
  if (!std::getenv("DATAMUNGE_CIFAR10_RETRAIN") ||
      std::string(std::getenv("DATAMUNGE_CIFAR10_RETRAIN")) != "1") {
    std::ifstream saved("artifacts/fit_summary.tsv");
    if (!saved)
      throw std::runtime_error("run with DATAMUNGE_CIFAR10_RETRAIN=1 to train first");
    std::string header;
    std::getline(saved, header);
    double rate, nll, dt, dv, seconds;
    int    epochs, selected, converged;
    saved >> rate >> epochs >> selected >> nll >> dt >> dv >> converged >> seconds;
    if (!saved || converged != 1)
      throw std::runtime_error("a completed converged training run is required");
    std::print(
        "| Quantity | Measured value |\n|---|---:|\n"
        "| Selected peak learning rate | {:.5f} |\n| Completed epochs | {} |\n"
        "| Lowest raw-NLL checkpoint epoch | {} |\n| Smallest raw validation NLL | {:.6f} |\n"
        "| Final five-epoch training change | {:.6f} |\n"
        "| Final five-epoch validation change | {:.6f} |\n"
        "| Total training time, minutes (including both pilots) | {:.2f} |\n",
        rate,
        epochs,
        selected,
        nll,
        dt,
        dv,
        seconds / 60);
    return 0;
  }
  n::set_num_threads(8);
  std::filesystem::create_directories("artifacts");
  std::filesystem::create_directories("build");
  std::filesystem::remove("artifacts/fit_summary.tsv");
  std::filesystem::remove("artifacts/training_summary.tsv");
  const auto data = s::prepare_cifar10();
  n::save_npz(
      "artifacts/preprocessing.npz",
      {{"mean", data.mean},
       {"sd", data.sd},
       {"fit_ids", n::from_vector(data.fit_ids, {45000})},
       {"validation_ids", n::from_vector(data.validation_ids, {5000})}});
  const auto        config = s::cifar10_resnet_config();
  n::ParameterStore parameters(17), state(17);
  {
    n::NoGradGuard guard;
    n::models::ResNet(parameters, state, n::zeros({1, 32, 32, 3}), config, false);
  }
  n::OptimizerConfig optimizer_config;
  optimizer_config.kind = n::OptimizerKind::Adam;
  n::Optimizer  optimizer(parameters, .001, optimizer_config);
  n::BatchOrder order(45000, 64, 2026);
  auto          fresh_parameters = parameters.clone(), fresh_state = state.clone();
  std::ofstream tuning("artifacts/tuning.tsv"), history;
  tuning << "peak_lr\tepoch\ttrain_aug_nll\tvalidation_nll\tvalidation_accuracy\tseconds\n";
  const auto          start = std::chrono::steady_clock::now();
  double              best = 1e9, peak = 0, chosen_peak = 0, selected_score = 1e9;
  int                 selected_epoch = 0;
  std::vector<double> train_values, validation_values;

  // The explicit minibatch loop is shared by the pilot and continuation stages.
  auto epoch_step = [&](int epoch, double rate, bool pilot) {
    const auto   tick = std::chrono::steady_clock::now();
    n::Generator augmentation(151 + epoch); // Epoch-local stream permits exact continuation.
    order.begin_epoch();
    n::WeightedMean train;
    for (auto rows = order.next(); !rows.empty(); rows = order.next()) {
      const auto images = s::augment_cifar10(n::take_rows(data.fit.images, rows), augmentation);
      const auto input  = s::standardize_cifar10(images, data.mean, data.sd);
      const auto logits = n::models::ResNet(parameters, state, input, config, true).logits;
      const auto loss =
          n::sparse_softmax_cross_entropy(logits, n::take_rows(data.fit.labels, rows));
      auto objective = loss;
      for (const auto& weight : parameters.parameters())
        if (weight.dim() >= 2)
          objective = objective + .00005 * n::sum(n::square(weight));
      // Each pilot warms up for one epoch. The continuation uses an epoch-wise cosine.
      const double lr = pilot && epoch == 1
                            ? rate * (optimizer.iterations() + 1.) / order.batches_per_epoch()
                            : rate;
      optimizer.set_learning_rate(lr);
      optimizer.minimize(objective);
      train.add(loss.item(), rows.size());
    }
    const auto logits =
        s::cifar10_logits(parameters, state, data.validation.images, data.mean, data.sd);
    const double val      = n::sparse_softmax_cross_entropy(logits, data.validation.labels).item();
    const double accuracy = n::accuracy(logits, data.validation.labels);
    const double seconds =
        std::chrono::duration<double>(std::chrono::steady_clock::now() - tick).count();
    if (!std::isfinite(val))
      throw std::runtime_error("nonfinite validation loss");
    train_values.push_back(train.value());
    validation_values.push_back(val);
    auto& out = pilot ? tuning : history;
    out << std::setprecision(12) << peak << '\t' << epoch << '\t' << train.value() << '\t' << val
        << '\t' << accuracy << '\t' << seconds << '\n';
    out.flush();
    if (val < best) {
      best           = val;
      selected_epoch = epoch;
      parameters.save("artifacts/nll_parameters.npz");
      state.save("artifacts/nll_bn.npz");
    }
    std::cout << "lr=" << rate << " epoch=" << epoch << " train=" << train.value() << " val=" << val
              << " acc=" << accuracy << " seconds=" << seconds << std::endl;
  };

  // Two comparable full-fitting-set pilots; official test data remain unopened.
  for (const double candidate : {.001, .003}) {
    peak           = candidate;
    best           = 1e9;
    selected_epoch = 0;
    parameters.copy_from(fresh_parameters);
    state.copy_from(fresh_state);
    optimizer = n::Optimizer(parameters, peak, optimizer_config);
    order     = n::BatchOrder(45000, 64, 2026);
    train_values.clear();
    validation_values.clear();
    for (int epoch = 1; epoch <= 6; ++epoch)
      epoch_step(epoch, peak, true);
    if (best < selected_score) {
      selected_score = best;
      chosen_peak    = peak;
      n::save_training_checkpoint("build/continuation.npz", parameters, &optimizer, &order);
      state.save("build/continuation_bn.npz");
      std::filesystem::copy_file(
          "artifacts/nll_parameters.npz",
          "build/pilot_best_parameters.npz",
          std::filesystem::copy_options::overwrite_existing);
      std::filesystem::copy_file(
          "artifacts/nll_bn.npz",
          "build/pilot_best_bn.npz",
          std::filesystem::copy_options::overwrite_existing);
      n::save_npz(
          "build/pilot_history.npz",
          {{"train", n::from_vector(train_values, {6})},
           {"validation", n::from_vector(validation_values, {6})},
           {"best_epoch", n::scalar(selected_epoch, n::DType::Int64)}});
    }
  }
  peak = chosen_peak;
  best = selected_score;
  n::load_training_checkpoint("build/continuation.npz", parameters, &optimizer, &order);
  state.load("build/continuation_bn.npz");
  std::filesystem::copy_file(
      "build/pilot_best_parameters.npz",
      "artifacts/nll_parameters.npz",
      std::filesystem::copy_options::overwrite_existing);
  std::filesystem::copy_file(
      "build/pilot_best_bn.npz",
      "artifacts/nll_bn.npz",
      std::filesystem::copy_options::overwrite_existing);
  for (const auto& [key, value] : n::load_npz("build/pilot_history.npz")) {
    if (key == "train")
      train_values = value.to_vector<double>();
    if (key == "validation")
      validation_values = value.to_vector<double>();
    if (key == "best_epoch")
      selected_epoch = value.item<int>();
  }
  history.open("artifacts/history.tsv");
  history << "peak_lr\tepoch\ttrain_aug_nll\tvalidation_nll\tvalidation_accuracy\tseconds\n";
  // Preserve the chosen pilot's actual measurements rather than rerunning it.
  tuning.close();
  std::ifstream pilot("artifacts/tuning.tsv");
  std::string   line;
  std::getline(pilot, line);
  while (std::getline(pilot, line)) {
    std::istringstream row(line);
    double             candidate;
    row >> candidate;
    if (candidate == peak)
      history << line << '\n';
  }
  int completed = 6;
  for (int epoch = 7; epoch <= 80; ++epoch) {
    const double lr = n::schedule::cosine(peak, .00001, 73, epoch - 7);
    epoch_step(epoch, lr, false);
    completed = epoch;
  }
  // A nonzero-rate plateau check prevents declaring convergence just because LR reached zero.
  bool   converged    = false;
  double train_change = 0, val_change = 0;
  for (int extension = 0; extension < 4 && !converged; ++extension) {
    for (int i = 0; i < 10; ++i) {
      ++completed;
      epoch_step(completed, .00001, false);
    }
    auto window = [](const std::vector<double>& x, int offset) {
      return std::accumulate(x.end() - offset - 5, x.end() - offset, 0.) / 5.;
    };
    train_change = std::abs(window(train_values, 0) - window(train_values, 5));
    val_change   = std::abs(window(validation_values, 0) - window(validation_values, 5));
    converged    = train_change < .005 && val_change < .005;
  }
  parameters.save("artifacts/converged_parameters.npz");
  state.save("artifacts/converged_bn.npz");
  const double seconds =
      std::chrono::duration<double>(std::chrono::steady_clock::now() - start).count();
  std::ofstream summary("artifacts/fit_summary.tsv");
  summary << "peak_lr\tcompleted_epochs\tselected_epoch\tvalidation_nll\tplateau_train_"
             "change\tplateau_validation_change\tconverged\tseconds\n"
          << std::setprecision(12) << peak << '\t' << completed << '\t' << selected_epoch << '\t'
          << best << '\t' << train_change << '\t' << val_change << '\t' << converged << '\t'
          << seconds << '\n';
  if (!converged)
    throw std::runtime_error(
        "plateau criterion not reached; extend training before finalising report");
  std::cout << "Converged; retained raw-NLL minimum at epoch " << selected_epoch << " validation NLL " << best
            << std::endl;
}
```
