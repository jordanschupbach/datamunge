> Frozen evaluation and probability calibration

For logits \(z\), a positive scalar temperature produces probabilities \(p_c(T)=\operatorname{softmax}(z/T)_c\). It preserves each image's top-one decision but can change confidence ordering between images. The temperature minimises validation NLL over the explicit bounded interval [0.05,10] with 64 golden-section iterations in log temperature; T=1 is retained if the objective does not improve. The model and its BN moments remain fixed. This follows [Guo et al., *On Calibration of Modern Neural Networks*|https://arxiv.org/abs/1706.04599].

Accuracy and macro F1 describe decisions. NLL and multiclass Brier score describe probabilities; Brier is the mean sum of squared probability errors over all ten classes, without division by ten. Expected calibration error (ECE) uses 15 equal-width top-confidence bins, the final bin including confidence one:

$$\operatorname{ECE}=\sum_{b=1}^{15}\frac{|B_b|}{n}\left|\operatorname{accuracy}(B_b)-\operatorname{confidence}(B_b)\right|.$$
\alttext(ECE averages the absolute difference between mean confidence and observed accuracy in each bin, weighted by the bin's sample count.)

Empty bins contribute zero. ECE is bin-dependent and can hide within-bin error; it is reported alongside proper probability scores. A Wilson 95% interval describes binomial sampling uncertainty conditional on this fitted classifier. It uses a pooled-binomial approximation despite the balanced class design, and does not include training-seed variation, selection uncertainty or dependence due to similar images. A uniform ten-class forecast has NLL ln(10), Brier 0.9 and expected random-choice accuracy 0.1; a deterministic tied argmax also scores 0.1 on this balanced test set.

```{cpp, results="markdown", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <datamunge/nn/cifar10_study.hpp>
#include <datamunge/nn/classification_analysis.hpp>
#include <fstream>
#include <iomanip>
#include <iostream>

int main() {
  namespace n = dm::nn;
  namespace s = n::study;
  n::set_num_threads(8);
  const auto run = n::read_csv("artifacts/training_summary.tsv", nullptr, true, '\t');
  if (run.shape() != n::Shape{1, 8} || run.at({0, 6}) != 1)
    throw std::runtime_error("complete converged training before test computations");
  const auto        data = s::restore_cifar10_study("artifacts/preprocessing.npz");
  n::ParameterStore p(17), state(17);
  {
    n::NoGradGuard guard;
    n::models::ResNet(p, state, n::zeros({1, 32, 32, 3}), s::cifar10_resnet_config(), false);
  }
  p.load("artifacts/best_parameters.npz");
  state.load("artifacts/best_bn.npz");
  const auto   validation = s::cifar10_logits(p, state, data.validation.images, data.mean, data.sd);
  const double temperature = s::fit_temperature(validation, data.validation.labels);
  const auto   fit         = s::cifar10_logits(p, state, data.fit.images, data.mean, data.sd);
  // The selected model, moments and temperature are frozen before the test file is loaded.
  const auto test = n::load_cifar10(data.directory, "test");
  if (test.labels.numel() != 10000)
    throw std::runtime_error("full official test set required");
  const auto         logits     = s::cifar10_logits(p, state, test.images, data.mean, data.sd);
  const auto         raw        = s::classification_diagnostics(logits, test.labels);
  const auto         calibrated = s::classification_diagnostics(logits, test.labels, temperature);
  n::ConfusionMatrix confusion(10);
  confusion.add(test.labels, n::argmax(logits, 1));
  for (int cls = 0; cls < 10; ++cls)
    if (confusion.per_class(cls).support != 1000)
      throw std::runtime_error("test class support must be 1000");
  const auto                prediction = n::argmax(logits, 1).to_vector<std::int64_t>();
  const auto                truth      = test.labels.to_vector<std::int64_t>();
  const auto                confidence = n::max(calibrated.probabilities, {1}).to_vector<double>();
  std::vector<std::int64_t> correct, errors, uncertain(10000);
  for (int cls = 0; cls < 10; ++cls)
    for (int i = 0; i < 10000; ++i)
      if (truth[i] == cls && prediction[i] == cls) {
        correct.push_back(i);
        break;
      }
  for (int i = 0; i < 10000; ++i)
    if (truth[i] != prediction[i])
      errors.push_back(i);
  std::stable_sort(
      errors.begin(), errors.end(), [&](auto a, auto b) { return confidence[a] > confidence[b]; });
  std::iota(uncertain.begin(), uncertain.end(), 0);
  std::stable_sort(uncertain.begin(), uncertain.end(), [&](auto a, auto b) {
    return confidence[a] < confidence[b];
  });
  errors.resize(std::min<std::size_t>(10, errors.size()));
  uncertain.resize(10);
  std::vector<std::int64_t> explain;
  for (int i = 0; i < 4; ++i)
    explain.push_back(correct.at(i));
  for (int i = 0; i < std::min<int>(4, errors.size()); ++i)
    explain.push_back(errors[i]);
  n::save_npz(
      "artifacts/evaluation.npz",
      {{"test_logits", logits},
       {"test_labels", test.labels},
       {"validation_logits", validation},
       {"validation_labels", data.validation.labels},
       {"temperature", n::scalar(temperature, n::DType::Float64)},
       {"confusion", confusion.to_tensor()},
       {"correct_ids", n::from_vector(correct, {static_cast<int64_t>(correct.size())})},
       {"error_ids", n::from_vector(errors, {static_cast<int64_t>(errors.size())})},
       {"uncertain_ids", n::from_vector(uncertain, {10})},
       {"explain_ids", n::from_vector(explain, {static_cast<int64_t>(explain.size())})}});
  std::ofstream summary("artifacts/scores.tsv");
  summary << "split\ttemperature\taccuracy\tnll\tbrier\tece15\n" << std::setprecision(12);
  auto score = [&](const char* split, const n::Tensor& z, const n::Tensor& y, double t) {
    const auto d = s::classification_diagnostics(z, y, t);
    summary << split << '\t' << t << '\t' << d.accuracy << '\t' << d.nll << '\t' << d.brier << '\t'
            << d.ece << '\n';
  };
  score("fit", fit, data.fit.labels, 1);
  score("validation_raw", validation, data.validation.labels, 1);
  score("validation_calibrated", validation, data.validation.labels, temperature);
  score("test_raw", logits, test.labels, 1);
  score("test_calibrated", logits, test.labels, temperature);
  std::ofstream cases("artifacts/prediction_examples.tsv");
  cases << "selection\ttest_id\ttrue\tpredicted\tconfidence\n" << std::setprecision(10);
  for (const auto& [selection, ids] :
       std::vector<std::pair<std::string, std::vector<std::int64_t>>>{
           {"first_correct_per_class", correct},
           {"most_confident_errors", errors},
           {"least_confident", uncertain}})
    for (const auto id : ids)
      cases << selection << '\t' << id << '\t' << s::cifar10_classes[truth[id]] << '\t'
            << s::cifar10_classes[prediction[id]] << '\t' << confidence[id] << '\n';
  const auto interval =
      dm::stats::proportion_test_one_sample(std::llround(10000 * raw.accuracy), 10000);
  std::cout << std::setprecision(9) << "Test accuracy " << raw.accuracy << " (Wilson 95% "
            << interval.conf_int_lower << ", " << interval.conf_int_upper << "); macro F1 "
            << confusion.macro().f1 << "; T=" << temperature << "; raw/calibrated NLL " << raw.nll
            << "/" << calibrated.nll << std::endl;
}
```
// result_begin: markdown
Test accuracy 0.9021 (Wilson 95% 0.896120057, 0.907771131); macro F1 0.902090094; T=2.2788574; raw/calibrated NLL 0.444357093/0.302001757
// result_end


>> Exact image overlap and sensitivity

A post-fit data-quality audit compares the decoded pixels within and between all three partitions. It uses hashes to find candidates and verifies every candidate with a full byte comparison. Counts below are unordered pairs; a group of three identical images contributes three pairs. Unique later images matching fitting data are counted separately. This audit leaves all labels and partitions unchanged. It detects exact copies, not visually similar or transformed near duplicates.

```{cpp, results="markdown", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <datamunge/nn/cifar10_study.hpp>
#include <datamunge/nn/classification_analysis.hpp>
#include <datamunge/nn/image_overlap.hpp>
#include <fstream>
#include <map>
int main() {
  namespace n  = dm::nn;
  namespace st = n::study;
  n::set_num_threads(8);
  const auto                     data  = st::restore_cifar10_study("artifacts/preprocessing.npz");
  const auto                     test  = n::load_cifar10(data.directory, "test");
  const auto                     audit = st::audit_image_overlap({data.fit, data.validation, test});
  const std::vector<std::string> names{"Fitting", "Validation", "Official test"};
  std::ofstream                  record("artifacts/overlap.tsv");
  record << "partition1\tpartition2\texact_matching_pairs\n";
  std::print("| Partition pair | Exact matching image pairs |\n|---|---:|\n");
  for (int i = 0; i < 3; ++i)
    for (int j = i; j < 3; ++j) {
      std::print("| {} / {} | {} |\n", names[i], names[j], audit.pairs[i][j]);
      record << names[i] << '\t' << names[j] << '\t' << audit.pairs[i][j] << '\n';
    }
  std::print(
      "\n{} validation images and {} test images exactly match fitting pixels. "
      "Across all partitions, {} matching-image pairs carry conflicting labels.\n",
      audit.rows_matching_first[1].size(),
      audit.rows_matching_first[2].size(),
      audit.conflicting_label_pairs);
  std::vector<bool> shared(10000, false);
  for (const auto id : audit.rows_matching_first[2])
    shared[id] = true;
  std::vector<int64_t> clean;
  for (int i = 0; i < 10000; ++i)
    if (!shared[i])
      clean.push_back(i);
  std::map<std::string, n::Tensor> a;
  for (const auto& [k, v] : n::load_npz("artifacts/evaluation.npz"))
    a[k] = v;
  if (!clean.empty()) {
    const auto d = st::classification_diagnostics(
        n::take_rows(a.at("test_logits"), clean),
        n::take_rows(a.at("test_labels"), clean),
        a.at("temperature").item());
    std::print(
        "After excluding test images with exact fitting matches: N={}, accuracy {:.4f}, calibrated "
        "NLL {:.5f}. "
        "This is a post-fit sensitivity analysis; official benchmark scores retain all images.\n",
        clean.size(),
        d.accuracy,
        d.nll);
  }
}
```
