>> Validation-only checkpoint choice

The raw-NLL minimum and the converged endpoint are retained as two candidates. Classification accuracy on the same validation partition selects between them; exact accuracy ties use calibrated validation NLL. Each candidate fits its own temperature using validation labels only. This addresses the observed divergence between improving classification accuracy and worsening uncalibrated confidence. It adds selection reuse of the validation set, which is why only the subsequent official-test scores are treated as held-out evaluation. No test classification score has been computed before this decision.

```{cpp, results="markdown", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <datamunge/nn/cifar10_study.hpp>
#include <datamunge/nn/classification_analysis.hpp>
#include <fstream>
#include <iomanip>
int main() {
  namespace n  = dm::nn;
  namespace st = n::study;
  n::set_num_threads(8);
  const auto fit = n::read_csv("artifacts/fit_summary.tsv", nullptr, true, '\t');
  if (fit.shape() != n::Shape{1, 8} || fit.at({0, 6}) != 1)
    throw std::runtime_error("checkpoint selection requires completed converged fitting");
  const auto        data = st::restore_cifar10_study("artifacts/preprocessing.npz");
  n::ParameterStore p(17), state(17);
  {
    n::NoGradGuard guard;
    n::models::ResNet(p, state, n::zeros({1, 32, 32, 3}), st::cifar10_resnet_config(), false);
  }
  std::ofstream candidates("artifacts/checkpoint_selection.tsv");
  candidates << "candidate\tepoch\tvalidation_accuracy\traw_nll\tcalibrated_nll\ttemperature\n"
             << std::setprecision(12);
  std::print(
      "| Candidate | Epoch | Validation accuracy | Raw NLL | Calibrated NLL | Temperature "
      "|\n|---|---:|---:|---:|---:|---:|\n");
  double      best_accuracy = -1, best_calibrated = 1e9, selected_nll = 0;
  int         selected_epoch = 0;
  std::string chosen;
  for (const auto& candidate : std::vector<std::string>{"nll", "converged"}) {
    p.load("artifacts/" + candidate + "_parameters.npz");
    state.load("artifacts/" + candidate + "_bn.npz");
    const auto   z   = st::cifar10_logits(p, state, data.validation.images, data.mean, data.sd);
    const double t   = st::fit_temperature(z, data.validation.labels);
    const auto   raw = st::classification_diagnostics(z, data.validation.labels);
    const auto   calibrated = st::classification_diagnostics(z, data.validation.labels, t);
    const int    epoch      = static_cast<int>(fit.at({0, candidate == "nll" ? 2 : 1}));
    candidates << candidate << '\t' << epoch << '\t' << raw.accuracy << '\t' << raw.nll << '\t'
               << calibrated.nll << '\t' << t << '\n';
    std::print(
        "| {} | {} | {:.4f} | {:.5f} | {:.5f} | {:.4f} |\n",
        candidate,
        epoch,
        raw.accuracy,
        raw.nll,
        calibrated.nll,
        t);
    if (raw.accuracy > best_accuracy ||
        (raw.accuracy == best_accuracy && calibrated.nll < best_calibrated)) {
      best_accuracy   = raw.accuracy;
      best_calibrated = calibrated.nll;
      selected_nll    = raw.nll;
      selected_epoch  = epoch;
      chosen          = candidate;
      p.save("artifacts/best_parameters.npz");
      state.save("artifacts/best_bn.npz");
    }
  }
  std::ofstream summary("artifacts/training_summary.tsv");
  summary << "peak_lr\tcompleted_epochs\tselected_epoch\tvalidation_nll\tplateau_train_"
             "change\tplateau_validation_change\tconverged\tseconds\n"
          << std::setprecision(12);
  summary << fit.at({0, 0}) << '\t' << fit.at({0, 1}) << '\t' << selected_epoch << '\t'
          << selected_nll << '\t' << fit.at({0, 4}) << '\t' << fit.at({0, 5}) << '\t' << 1 << '\t'
          << fit.at({0, 7}) << '\n';
  std::print(
      "\nSelected {} at epoch {}, using validation accuracy first and calibrated validation NLL "
      "only as a tie-breaker. No official test scores enter this decision.\n",
      chosen,
      selected_epoch);
}
