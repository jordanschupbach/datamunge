```{cpp, results="markdown", file="figures/reliability.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <datamunge/nn/cifar10_study.hpp>
#include <datamunge/nn/classification_analysis.hpp>
#include <map>
#include <fstream>
#include <iomanip>
int main() {
  namespace n = dm::nn;
  std::map<std::string, n::Tensor> a;
  for (const auto& [k, v] : n::load_npz("artifacts/evaluation.npz"))
    a[k] = v;
  std::filesystem::create_directories("build");
  std::ofstream bins("artifacts/reliability_bins.tsv");
  bins << "temperature\tbin\tlow\thigh\tcount\tmean_confidence\taccuracy\n" << std::setprecision(12);
  auto layout = dm::graphics::RLayout::create(1, 2);
  for (double t : {1., a.at("temperature").item()}) {
    const auto d =
        n::study::classification_diagnostics(a.at("test_logits"), a.at("test_labels"), t);
    for (int b = 0; b < 15; ++b)
      bins << t << '\t' << b << '\t' << b / 15. << '\t' << (b + 1) / 15. << '\t'
           << d.bin_count[b] << '\t' << d.bin_confidence[b] << '\t' << d.bin_accuracy[b] << '\n';
    std::vector<double> x, y;
    for (int b = 0; b < 15; ++b)
      if (d.bin_count[b]) {
        x.push_back(d.bin_confidence[b]);
        y.push_back(d.bin_accuracy[b]);
      }
    auto p = dm::graphics::RPlot::create();
    p.line({0, 1}, {0, 1}, "", {148, 163, 184})
        .points(x, y, "", {37, 99, 235}, 5)
        .x_limits(0, 1)
        .y_limits(0, 1)
        .x_label("Mean top-class confidence")
        .y_label("Observed accuracy")
        .title(t == 1 ? "Raw probabilities" : std::format("Validation-fitted T={:.3f}", t));
    layout.add(p);
  }
  layout.size(1100, 490).fit_panels().save_svg("build/reliability.svg");
  std::print("15 equal-width confidence bins; empty bins omitted from the plot.\n");
}
