| g6 | 32 | -0.7824 | -0.8881 | 0.8810 | 0.8810 |
// result_end

The ratio of each BLUP to its group's mean residual equals the reliability
\(n_g\hat\tau^2/(n_g\hat\tau^2+\hat\sigma^2)\) to every printed digit. The single observation in group g1 keeps 19%
of its deviation, the 32 observations in g6 keep 88%. Here \(\sigma^2\) is four times \(\tau^2\), so a group
needs about \(\hat\sigma^2/\hat\tau^2=4.3\) observations before its own mean gets more weight than the population.

> Checking the theory

>> Bias of ML and REML, and estimates on the boundary

Three hundred data sets from the balanced one-way model with \(G=8\) groups of \(m=5\),
\(\tau=\sigma=1\), are each fitted by REML and by ML. Without the constraint \(\tau^2\ge0\), the REML estimator
would be unbiased and the ML estimator would have mean
\(\big(\tfrac{G-1}{G}(\sigma^2+m\tau^2)-\sigma^2\big)/m=0.85\). The exact probabilities of a zero estimate come from
the \(F\) distribution as above.

```{cpp, results="markdown", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

using DF = dm::dstruct::DataFrame;

// One-way ANOVA F = MSB / MSW for G consecutive groups of m values.
double f_statistic(const std::vector<double>& y, int G, int m) {
  std::vector<double> means(G, 0.0);
  for (int k = 0; k < G; ++k)
    for (int i = 0; i < m; ++i) means[k] += y[k * m + i] / m;
  const double grand = dm::mean(means);
  double ssb = 0.0, ssw = 0.0;
  for (int k = 0; k < G; ++k) {
    ssb += m * (means[k] - grand) * (means[k] - grand);
    for (int i = 0; i < m; ++i) ssw += (y[k * m + i] - means[k]) * (y[k * m + i] - means[k]);
  }
  return (ssb / (G - 1)) / (ssw / (G * (m - 1)));
}

int main() {
  dm::random::Xoshiro256StarStar rng(7);
  const int G = 8, m = 5, reps = 300;
  double tau2[2] = {0, 0}, sigma2[2] = {0, 0}, theta_mean[2] = {0, 0};
  int zeros[2] = {0, 0}, below[2] = {0, 0};
  for (int r = 0; r < reps; ++r) {
    std::vector<double> g, y;
    for (int k = 0; k < G; ++k) {
      const double b = rng.normal(0.0, 1.0);
      for (int i = 0; i < m; ++i) g.push_back(k), y.push_back(b + rng.normal(0.0, 1.0));
    }
    DF data;
    data.add_column("g", g);
    data.add_column("y", y);
    const double F = f_statistic(y, G, m);
    below[0] += F <= 1.0, below[1] += F <= G / (G - 1.0);
    for (int method = 0; method < 2; ++method) {
      const dm::stats::LMM fit(data, "y ~ 1 + (1 | g)", {.reml = method == 0});
      const double t2 = fit.random_effect_covariance()(0, 0);
      tau2[method] += t2 / reps, sigma2[method] += fit.residual_variance() / reps;
      theta_mean[method] += fit.theta()[0] / reps;
      zeros[method] += t2 < 1e-8;
    }
  }
  const double ratio = 1.0 + m * 1.0 / 1.0;
  DF table;
  table.add_column("method", std::vector<std::string>{"REML", "ML"});
  table.add_column("mean tau^2 hat", std::vector<double>{tau2[0], tau2[1]});
  table.add_column("unconstrained theory", std::vector<double>{1.0, ((G - 1.0) / G * ratio - 1.0) / m});
  table.add_column("mean sigma^2 hat", std::vector<double>{sigma2[0], sigma2[1]});
  table.add_column("zero estimates", std::vector<double>{double(zeros[0]), double(zeros[1])});
  table.add_column("F below cut-off", std::vector<double>{double(below[0]), double(below[1])});
  table.add_column("expected, exact", std::vector<double>{reps * dm::random::f_cdf(1.0 / ratio, G - 1, G * (m - 1)),
                                                          reps * dm::random::f_cdf(G / (G - 1.0) / ratio, G - 1, G * (m - 1))});
  DF::MarkdownOptions md;
  md.digits = 3;
  md.column_digits = {{"zero estimates", 0}, {"F below cut-off", 0}, {"expected, exact", 1}};
  std::print("{}\n", table.to_md(md));
}
```
// result_begin: markdown
| method | mean tau^2 hat | unconstrained theory | mean sigma^2 hat | zero estimates | F below cut-off | expected, exact |
| :--- | ---: | ---: | ---: | ---: | ---: | ---: |
| REML | 1.035 | 1.00 | 1.007 | 6 | 6 | 3.0 |
| ML | 0.881 | 0.85 | 1.007 | 9 | 9 | 4.4 |
// result_end

ML underestimates \(\tau^2\) as predicted: the mean of 0.881 is close to the unconstrained value 0.85,
pushed up a little by the estimates truncated at zero. REML's mean of 1.035 is close to the true
1; truncation at zero lifts it slightly above. Both estimate \(\sigma^2\) without bias, because
\(\hat\sigma^2=\text{MSW}\) for both. The estimates that are exactly zero are the data sets whose \(F\) statistic
is below the cut-off (1 for REML, \(8/7\) for ML), one for one, so the optimiser finds the boundary
whenever it should. There happen to be twice as many as expected (6 against 3.0, 9 against
4.4). The probability of 6 or more when 3 are expected is about 8%.

>> Standard errors: mixed model against OLS

Data with \(G=12\) groups of \(m=6\), \(\tau=2\), \(\sigma=1\) (so \(\rho=0.8\)), and two covariates with true slopes 0.5:
\(w\) is constant within each group (a school's funding), \(x\) varies within groups (a pupil's prior
score). Over 1000 data sets, the table compares the spread of the estimates with the average
reported standard error, and the coverage of nominal 95% intervals. The design-effect argument
predicts that OLS's standard error for \(w\) is too small by a factor \(\sqrt{1+(m-1)\rho}=\sqrt5=2.24\).

```{cpp, results="markdown", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

using DF = dm::dstruct::DataFrame;

int main() {
  dm::random::Xoshiro256StarStar rng(12);
  const int reps = 1000;
  // est[model][coef] collects the estimates, se[model][coef] the reported standard errors.
  std::vector<double> est[2][2], se[2][2];
  int covered[2][2] = {{0, 0}, {0, 0}};
  for (int r = 0; r < reps; ++r) {
    std::vector<double> g, w, x, y;
    for (int k = 0; k < 12; ++k) {
      const double b = rng.normal(0.0, 2.0), wk = rng.normal(0.0, 1.0);
      for (int i = 0; i < 6; ++i) {
        const double xi = rng.normal(0.0, 1.0);
        g.push_back(k), w.push_back(wk), x.push_back(xi), y.push_back(1.0 + 0.5 * wk + 0.5 * xi + b + rng.normal(0.0, 1.0));
      }
    }
    DF data;
    data.add_column("g", g);
    data.add_column("w", w);
    data.add_column("x", x);
    data.add_column("y", y);
    const dm::stats::LMM mixed(data, "y ~ w + x + (1 | g)");
    const dm::stats::LM ols(data, "y ~ w + x");
    const auto ci = ols.confidence_intervals();
    for (int c = 0; c < 2; ++c) {
      est[0][c].push_back(mixed.coefficients()[c + 1]), se[0][c].push_back(mixed.standard_errors()[c + 1]);
      est[1][c].push_back(ols.coefficients()[c + 1]), se[1][c].push_back(ols.standard_errors()[c + 1]);
      covered[0][c] += std::abs(mixed.coefficients()[c + 1] - 0.5) < 1.959964 * mixed.standard_errors()[c + 1];
      covered[1][c] += ci[c + 1].lower < 0.5 && 0.5 < ci[c + 1].upper;
    }
  }
  std::vector<std::string> model, coef;
  std::vector<double> mean_est, sd_est, mean_se, coverage;
  for (int mdl = 0; mdl < 2; ++mdl)
    for (int c = 0; c < 2; ++c) {
      model.push_back(mdl == 0 ? "LMM" : "OLS"), coef.push_back(c == 0 ? "w (between)" : "x (within)");
      mean_est.push_back(dm::mean(est[mdl][c])), sd_est.push_back(dm::sd(est[mdl][c]));
      mean_se.push_back(dm::mean(se[mdl][c])), coverage.push_back(covered[mdl][c] / double(reps));
    }
  DF table;
  table.add_column("model", model);
  table.add_column("coefficient", coef);
  table.add_column("mean estimate", mean_est);
  table.add_column("SD of estimates", sd_est);
  table.add_column("mean reported SE", mean_se);
  table.add_column("95% coverage", coverage);
  DF::MarkdownOptions md;
  md.digits = 3;
  std::print("{}\n", table.to_md(md));
}
```
// result_begin: markdown
| model | coefficient | mean estimate | SD of estimates | mean reported SE | 95% coverage |
| :--- | :--- | ---: | ---: | ---: | ---: |
| LMM | w (between) | 0.515 | 0.667 | 0.642 | 0.914 |
| LMM | x (within) | 0.503 | 0.129 | 0.129 | 0.955 |
| OLS | w (between) | 0.517 | 0.668 | 0.274 | 0.588 |
| OLS | x (within) | 0.514 | 0.244 | 0.250 | 0.955 |
// result_end

Both methods estimate both slopes without bias, but they differ in how well they know it.

For \(w\), the group-level covariate, the two estimators have the same spread (0.667 and 0.668):
with \(w\) constant within groups, each estimator effectively regresses group means on \(w\). But
OLS reports a standard error of 0.274, 0.41 of the actual spread, close to the \(1/\sqrt5=0.45\) the
design effect predicts, and its intervals cover 0.5 only 59% of the time. The mixed model's
standard error is nearly right (0.642), and its coverage, 0.914, is close to the 0.922 that a
normal interval achieves when the true reference distribution is \(t\) with \(G-2=10\) degrees of
freedom: with 12 groups there is little information about \(\tau^2\), which Wald intervals ignore.

For \(x\), which varies within groups, the mixed model is nearly twice as precise as OLS (0.129
against 0.244): it compares observations within the same group, where the group effect cancels,
while OLS treats the group effects (variance 4) as noise. Both report their own spread
correctly, and both cover at 95.5%.

In a separate check, the 400 data sets of an earlier run of this simulation were also fitted
with R's `nlme::lme`. The slopes, standard errors and \(\theta\) agreed to \(10^{-9}\), \(10^{-9}\) and \(5\times10^{-7}\)
on every one.

>> BLUPs against group means, and the likelihood-ratio test on the boundary

Two more checks, both shown in the figure below.

*Prediction error.* Twenty-four groups, three each of sizes 1, 2, 3, 5, 8, 13, 20 and 30, with
\(\tau=1\), \(\sigma=2\), are simulated 300 times. For each group the true effect \(b_g\) is compared with
the BLUP and with the no-pooling estimate \(\bar y_g-\hat\beta_0\). With known variances and \(\beta_0\), the mean
squared errors would be \(\sigma^2/n\) for the group mean and \(\tau^2\sigma^2/(n\tau^2+\sigma^2)\) for the BLUP, always smaller.

*Testing \(\tau^2=0\).* The likelihood-ratio statistic \(\Lambda=d_{\mathrm{ML}}(0)-d_{\mathrm{ML}}(\hat\theta)\) is zero whenever
\(\hat\tau^2_{\mathrm{ML}}=0\). Because \(\tau^2=0\) is on the boundary of the parameter space, \(\Lambda\) does not have the
usual \(\chi^2_1\) null distribution. Asymptotically it is the 50:50 mixture of a point mass at 0 and
\(\chi^2_1\) (Self and Liang, 1987), but in finite samples the point mass is larger (Crainiceanu and
Ruppert, 2004): for a balanced design it is exactly \(P(\hat\tau^2_{\mathrm{ML}}=0)=F_{G-1,G(m-1)}(G/(G-1))\). One
thousand null data sets with \(G=10\), \(m=5\) are fitted by ML with a smaller search
(population 15, 30 generations), which is ample for one parameter.

```{cpp, results="markdown", file="figures/lmm_theory.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

using DF = dm::dstruct::DataFrame;

// One-way ANOVA F = MSB / MSW for G consecutive groups of m values.
double f_statistic(const std::vector<double>& y, int G, int m) {
  std::vector<double> means(G, 0.0);
  for (int k = 0; k < G; ++k)
    for (int i = 0; i < m; ++i) means[k] += y[k * m + i] / m;
  const double grand = dm::mean(means);
  double ssb = 0.0, ssw = 0.0;
  for (int k = 0; k < G; ++k) {
    ssb += m * (means[k] - grand) * (means[k] - grand);
    for (int i = 0; i < m; ++i) ssw += (y[k * m + i] - means[k]) * (y[k * m + i] - means[k]);
  }
  return (ssb / (G - 1)) / (ssw / (G * (m - 1)));
}

int main() {
  std::filesystem::create_directories("build");
  dm::random::Xoshiro256StarStar rng(13);
  // Prediction error of BLUPs and group means.
  const std::vector<int> sizes{1, 2, 3, 5, 8, 13, 20, 30};
  const std::size_t S = sizes.size(), groups = 3 * S;
  const int reps = 300;
  std::vector<double> mse_blup(S), mse_mean(S);
  double mse_beta0 = 0.0;
  for (int r = 0; r < reps; ++r) {
    std::vector<double> g, y, truth, sum(groups);
    for (std::size_t k = 0; k < groups; ++k) {
      truth.push_back(rng.normal(0.0, 1.0));
      for (int i = 0; i < sizes[k % S]; ++i) {
        g.push_back(k), y.push_back(5.0 + truth[k] + rng.normal(0.0, 2.0));
        sum[k] += y.back();
      }
    }
    DF data;
    data.add_column("g", g);
    data.add_column("y", y);
    const dm::stats::LMM fit(data, "y ~ 1 + (1 | g)", {.de_population_size = 15, .de_max_generations = 30});
    const double b0 = fit.coefficients()[0];
    mse_beta0 += (b0 - 5.0) * (b0 - 5.0) / reps;
    for (std::size_t k = 0; k < groups; ++k) {  // groups are labelled in order of appearance, so label k is group k
      mse_blup[k % S] += std::pow(fit.random_effects()[k][0] - truth[k], 2) / (3 * reps);
      mse_mean[k % S] += std::pow(sum[k] / sizes[k % S] - b0 - truth[k], 2) / (3 * reps);
    }
  }
  std::vector<double> log_n, th_mean, th_blup, grid, grid_mean, grid_blup;
  for (std::size_t j = 0; j < S; ++j) {
    log_n.push_back(std::log2(sizes[j]));
    th_mean.push_back(4.0 / sizes[j]), th_blup.push_back(4.0 / (sizes[j] + 4.0));
  }
  for (int i = 0; i <= 100; ++i) {
    const double ln = std::log2(30.0) * i / 100.0, n = std::exp2(ln);
    grid.push_back(ln), grid_mean.push_back(4.0 / n), grid_blup.push_back(4.0 / (n + 4.0));
  }
  DF table;
  table.add_column("n", std::vector<double>(sizes.begin(), sizes.end()));
  table.add_column("MSE group mean", mse_mean);
  table.add_column("sigma^2/n", th_mean);
  table.add_column("MSE BLUP", mse_blup);
  table.add_column("tau^2 sigma^2/(n tau^2 + sigma^2)", th_blup);
  DF::MarkdownOptions md;
  md.digits = 3;
  md.column_digits = {{"n", 0}};
  std::print("{}\n\nMSE of beta0 hat: {:.3f}\n\n", table.to_md(md), mse_beta0);

  auto pred = dm::graphics::RPlot::create();
  pred.lines(grid, grid_mean, "group mean", dm::RGB{37, 99, 235}, 1.5)
      .lines(grid, grid_blup, "BLUP", dm::RGB{220, 38, 38}, 1.5)
      .lines({-0.2, 5.1}, {1.0, 1.0}, "grand mean", dm::RGB{148, 163, 184}, 1.5);
  pred.points(log_n, mse_mean, dm::RGB{37, 99, 235}, 6.0).points(log_n, mse_blup, dm::RGB{220, 38, 38}, 6.0);
  pred.x_limits(-0.2, 5.1).y_limits(0.0, 4.4).title("Mean squared error of b_g")
      .x_label("log2 group size").y_label("MSE");

  // Likelihood-ratio test of tau^2 = 0 under the null.
  const int G = 10, m = 5, null_reps = 1000;
  std::vector<double> lrt;
  int below_cutoff = 0;
  for (int r = 0; r < null_reps; ++r) {
    std::vector<double> g, y;
    for (int k = 0; k < G; ++k)
      for (int i = 0; i < m; ++i) g.push_back(k), y.push_back(rng.normal(0.0, 1.0));
    below_cutoff += f_statistic(y, G, m) <= G / (G - 1.0);
    DF data;
    data.add_column("g", g);
    data.add_column("y", y);
    const dm::stats::LMM fit(data, "y ~ 1 + (1 | g)",
                             {.reml = false, .de_population_size = 15, .de_max_generations = 30});
    lrt.push_back(std::max(0.0, fit.deviance_at({0.0}) - fit.deviance()));
  }
  const double p0 = dm::random::f_cdf(G / (G - 1.0), G - 1, G * (m - 1));
  auto share = [&](double c) { return std::count_if(lrt.begin(), lrt.end(), [&](double v) { return v > c; }) / double(null_reps); };
  DF tests;
  tests.add_column("quantity", std::vector<std::string>{"P(LRT = 0)", "P(LRT > 2.71)", "P(LRT > 3.84)"});
  tests.add_column("simulated", std::vector<double>{1.0 - share(1e-8), share(2.706), share(3.841)});
  tests.add_column("chi^2_1", std::vector<double>{0.0, 0.10, 0.05});
  tests.add_column("50:50 mixture", std::vector<double>{0.5, 0.05, 0.025});
  tests.add_column("exact point mass + chi^2_1",
                   std::vector<double>{p0, (1 - p0) * 0.10, (1 - p0) * 0.05});
  std::print("{}\n\nData sets with F <= G/(G-1): {:.3f}\n", tests.to_md(md), below_cutoff / double(null_reps));

  // Tail probabilities P(LRT > x): the simulated ones at each positive statistic, and three references.
  std::ranges::sort(lrt);
  std::vector<double> sx, sy, cx, c_half, c_exact, c_chi;
  for (int i = 0; i < null_reps; ++i)
    if (lrt[i] > 1e-8 && lrt[i] <= 6.0) sx.push_back(lrt[i]), sy.push_back((null_reps - i - 1.0) / null_reps);
  for (int i = 1; i <= 200; ++i) {
    const double x = 6.0 * i / 200.0, tail = 1.0 - dm::random::chi_squared_cdf(x, 1.0);
    cx.push_back(x), c_chi.push_back(tail), c_half.push_back(0.5 * tail), c_exact.push_back((1 - p0) * tail);
  }
  auto surv = dm::graphics::RPlot::create();
  surv.lines(cx, c_chi, "chi^2_1", dm::RGB{148, 163, 184}, 1.5)
      .lines(cx, c_half, "50:50 mixture", dm::RGB{37, 99, 235}, 1.5)
      .lines(cx, c_exact, "exact point mass", dm::RGB{22, 163, 74}, 1.5);
  surv.points(sx, sy, "simulated", dm::RGB{17, 24, 39}, 2.5);
  surv.x_limits(0.0, 6.0).y_limits(0.0, 1.0).title("LRT for tau^2 = 0, no group effect")
      .x_label("x").y_label("P(LRT > x)");

  auto fig = dm::graphics::RLayout::create(1, 2);
  fig.add(pred).add(surv).size(1100, 480).fit_panels();
  fig.save_svg("build/lmm_theory.svg");
}
```
// result_begin: markdown
| n | MSE group mean | sigma^2/n | MSE BLUP | tau^2 sigma^2/(n tau^2 + sigma^2) |
| ---: | ---: | ---: | ---: | ---: |
| 1 | 3.997 | 4.000 | 0.830 | 0.800 |
| 2 | 1.895 | 2.000 | 0.691 | 0.667 |
| 3 | 1.322 | 1.333 | 0.625 | 0.571 |
| 5 | 0.828 | 0.800 | 0.509 | 0.444 |
| 8 | 0.569 | 0.500 | 0.387 | 0.333 |
| 13 | 0.309 | 0.308 | 0.280 | 0.235 |
| 20 | 0.250 | 0.200 | 0.233 | 0.167 |
| 30 | 0.182 | 0.133 | 0.172 | 0.118 |


MSE of beta0 hat: 0.066

| quantity | simulated | chi^2_1 | 50:50 mixture | exact point mass + chi^2_1 |
| :--- | ---: | ---: | ---: | ---: |
| P(LRT = 0) | 0.654 | 0.00 | 0.500 | 0.623 |
| P(LRT > 2.71) | 0.021 | 0.10 | 0.050 | 0.038 |
| P(LRT > 3.84) | 0.006 | 0.05 | 0.025 | 0.019 |


Data sets with F <= G/(G-1): 0.653
\image(figures/lmm_theory.svg)
// result_end

\caption(Left: simulated mean squared error of the no-pooling estimate \(\bar y_g-\hat\beta_0\) (blue points) and the BLUP (red points) against group size, with the known-parameter values \(\sigma^2/n\) and \(\tau^2\sigma^2/(n\tau^2+\sigma^2)\) (lines) and the complete-pooling error \(\tau^2=1\) (grey). Right: the empirical distribution function of the likelihood-ratio statistic under \(\tau^2=0\) (black points) against \(\chi^2_1\) (grey), the asymptotic 50:50 mixture (blue) and the mixture with the exact finite-sample point mass (green). Tables: the same numbers, and the tail probabilities at the usual critical values.)
\alttext(Left: mean squared error against log2 group size from 0 to 5. Blue points follow the falling curve sigma squared over n, from 4 at size 1 to about 0.18 at size 30. Red points start at 0.83 and fall to 0.17, slightly above the red theory curve, and always below the blue points and below the grey line at 1. Right: the probability that the LRT exceeds x, for x from 0 to 6. The grey chi-squared curve starts near 0.9, the blue 50:50 mixture curve near 0.43 and the green exact-point-mass curve near 0.33. The black simulated points start at 0.35, lie below the green curve throughout, and reach about 0.02 at x equals 2.7.)

*Prediction error.* The BLUP's error is below the group mean's at every size, and much below for
small groups: 0.83 against 4.0 for a single observation, where the group mean is four times
worse than ignoring the data and predicting zero (the grand mean, error \(\tau^2=1\)). As groups grow
the two converge, because the shrinkage factor tends to 1. Both errors are a little above the
known-parameter curves, mainly because \(\hat\beta_0\) is estimated (its own mean squared error is
0.066, which enters both).

*Testing \(\tau^2=0\).* With no group effect, 65.4% of the statistics are exactly zero, against 50% for
the asymptotic mixture and 62.3% from the exact \(F\) probability; the 65.3% of data sets with \(F\)
below the cut-off agree with the fits to within one data set. The positive part is also
smaller than \(\chi^2_1\): at the usual 5% critical value 3.84, only 0.6% of the statistics exceed it,
against 2.5% for the 50:50 mixture and 1.9% for the exact point mass with a \(\chi^2_1\) tail. So the
naive \(\chi^2_1\) test has a size of about 0.6% instead of 5%, and even the mixture, the usual
recommendation, is conservative with ten groups. Crainiceanu and Ruppert (2004) give the exact
finite-sample null distribution; a parametric bootstrap from the null fit is the general
alternative.

> Children's orthodontic growth

The `orthodont` data set (Potthoff and Roy, 1964; Pinheiro and Bates, 2000) has the distance in
millimetres from the pituitary to the pterygomaxillary fissure, measured on 27 children
(16 boys, 11 girls) at ages 8, 10, 12 and 14. Each child has their own growth curve: the
question is how the average curve differs between boys and girls, and how much children vary
around it. Age is centred at 11, so that the intercept is the distance at the middle of the
study rather than at birth.

```{cpp, results="markdown", file="figures/lmm_orthodont.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

using DF = dm::dstruct::DataFrame;

int main() {
  std::filesystem::create_directories("build");
  auto data = dm::datasets::load("orthodont");
  std::vector<double> age11;
  for (const double a : data.get_column<double>("age").values()) age11.push_back(a - 11.0);
  data.add_column("age11", age11);

  const dm::stats::LMM slopes(data, "distance ~ age11 * sex + (1 + age11 | subject)");
  const dm::stats::LMM intercepts(data, "distance ~ age11 * sex + (1 | subject)");
  const dm::stats::LMM raw_age(data, "distance ~ age * sex + (1 + age | subject)");
  const dm::stats::LM ols(data, "distance ~ age11 * sex");

  DF::MarkdownOptions md;
  md.digits = 4;
  auto coefs = slopes.coefficient_frame();
  coefs.add_column("OLS estimate", ols.coefficients());
  coefs.add_column("OLS std_error", ols.standard_errors());
  std::print("{}\n\n", coefs.to_md(md));

  DF var;
  var.add_column("model", std::vector<std::string>{"intercept + slope", "intercept only", "intercept + slope, raw age"});
  auto sd = [](const dm::stats::LMM& f, std::size_t k) { return k < f.random_effect_std_devs().size() ? f.random_effect_std_devs()[k] : 0.0; };
  var.add_column("sd intercept", std::vector<double>{sd(slopes, 0), sd(intercepts, 0), sd(raw_age, 0)});
  var.add_column("sd slope", std::vector<double>{sd(slopes, 1), sd(intercepts, 1), sd(raw_age, 1)});
  var.add_column("correlation", std::vector<double>{slopes.random_effect_correlation(0, 1), 0.0,
                                                     raw_age.random_effect_correlation(0, 1)});
  var.add_column("sigma", std::vector<double>{slopes.residual_std_dev(), intercepts.residual_std_dev(), raw_age.residual_std_dev()});
  var.add_column("REML logLik", std::vector<double>{slopes.log_likelihood(), intercepts.log_likelihood(), raw_age.log_likelihood()});
  std::print("{}\n\n", var.to_md(md));

  const double lrt = 2.0 * (slopes.log_likelihood() - intercepts.log_likelihood());
  std::print("REML LRT for the random slope: {:.3f}; p = {:.3f} (50:50 mixture of chi^2_1 and chi^2_2), {:.3f} (chi^2_2)\n\n", lrt,
             0.5 * (1 - dm::random::chi_squared_cdf(lrt, 1)) + 0.5 * (1 - dm::random::chi_squared_cdf(lrt, 2)),
             1 - dm::random::chi_squared_cdf(lrt, 2));
  std::print("{}\n\n", slopes.random_effects_frame().head(4).to_md(md));

  // One panel per sex: each child's data and BLUP line, and the population line.
  
  const auto sex = data.get_column<std::string>("sex").values();
  const auto age = data.get_column<double>("age").values();
  const auto dist = data.get_column<double>("distance").values();
  const auto& b = slopes.coefficients();
  auto fig = dm::graphics::RLayout::create(1, 2);
  for (const std::string s : {"Female", "Male"}) {
    const double male = s == "Male" ? 1.0 : 0.0;
    auto panel = dm::graphics::RPlot::create();
    std::vector<double> px, py;
    for (std::size_t i = 0; i < age.size(); ++i)
      if (sex[i] == s) px.push_back(age[i]), py.push_back(dist[i]);
    panel.points(px, py, dm::RGB{100, 116, 139}, 4.0);
    for (std::size_t g = 0; g < slopes.num_groups(); ++g) {
      const auto& label = slopes.group_labels()[g];
      if ((label[0] == 'M') != (male == 1.0)) continue;
      const double a = b[0] + b[2] * male + slopes.random_effects()[g][0];
      const double c = b[1] + b[3] * male + slopes.random_effects()[g][1];
      panel.segments({8.0}, {a - 3.0 * c}, {14.0}, {a + 3.0 * c}, dm::RGB{148, 163, 184}, 1.2);
    }
    const double a = b[0] + b[2] * male, c = b[1] + b[3] * male;
    panel.segments({8.0}, {a - 3.0 * c}, {14.0}, {a + 3.0 * c}, male == 1.0 ? dm::RGB{37, 99, 235} : dm::RGB{220, 38, 38}, 3.0);
    panel.x_limits(7.5, 14.5).y_limits(15.0, 32.5).title(s == "Male" ? "Boys (16)" : "Girls (11)")
        .x_label("age (years)").y_label("distance (mm)");
    fig.add(panel);
  }
  fig.size(1100, 480).fit_panels();
  fig.save_svg("build/lmm_orthodont.svg");
}
```
