| HP patches | 42 | 0.03583 |
\image(figures/spline_comparison.svg)
// result_end
\caption(Standard B-spline, P-spline, HB and HP fits to the same observations.)
\alttext(Four fitted cubic spline curves compared with the known smooth signal and noisy observations.)

\image(figures/spline_refinement.svg)
\caption(HB and HP refinement cells with fitted knot spans in global coordinates.)
\alttext(Two matching three-level interval diagrams: a global root patch, an unfitted half-domain cell, and a dense local patch on x from 0.5 to 0.75.)

)

\tab(Python,

```{python, results="markdown", nix-shell="git+file:../../../../..#python", cmd="env -u PYTHONPATH ../../../../../build/venv/pydatamunge-run/bin/python {file}", file="figures/spline_comparison_python.svg"}
import math
import shutil
from pathlib import Path
from pydatamunge import datamunge as dm

def signal(t):
    return math.sin(2 * math.pi * t) + 0.8 * math.exp(-2500 * (t - 0.65)**2)

x = [i / 240 for i in range(241)]
y = [signal(t) + 0.12 * math.sin(173*t) + 0.07 * math.cos(297*t) for t in x]
points = [[t] for t in x]
selected = [i for i, t in enumerate(x) if 0.5 <= t <= 0.75]
local_points = [points[i] for i in selected]
local_y = [y[i] for i in selected]
# Same global cubic spline space; only the P-spline is penalized.
bs = dm.BSplineRegression(x, y, 40, 3)
ps = dm.PSplineRegression(x, y, 40, 0.5, 3, 2)
coarse = dm.BSplineBasis.open_uniform(3, 10)
fine = dm.BSplineBasis.open_uniform(3, 32)
hb = dm.HierarchicalBSpline([0.0], [1.0])
hp = dm.HierarchicalBSpline([0.0], [1.0])
hb.fit_cell(0, [coarse], points, y)
hp.fit_cell_penalized(0, [coarse], points, y, [0.5], 2)
# Refine [0,1] -> [0.5,1] -> [0.5,0.75].
hb_patch = hb.refine(hb.refine(0, 1), 0)
hp_patch = hp.refine(hp.refine(0, 1), 0)
# Supply raw values; each local solver subtracts the ancestor contribution.
hb.fit_cell(hb_patch, [fine], local_points, local_y)
hp.fit_cell_penalized(hp_patch, [fine], local_points, local_y, [0.5], 2)
grid = [i / 1000 for i in range(1001)]
truth = [signal(t) for t in grid]
b_fit = list(bs.predict(grid))
p_fit = list(ps.predict(grid))
hb_fit = [hb.evaluate([t]) for t in grid]
hp_fit = [hp.evaluate([t]) for t in grid]
def rmse(fitted):
    return math.sqrt(sum((a-b)**2 for a, b in zip(fitted, truth)) / len(grid))

print("| Fit | Coefficients | Signal RMSE |\n| --- | ---: | ---: |")
for name, count, fitted in [("B-spline", 40, b_fit), ("P-spline", 40, p_fit), ("HB patches", 42, hb_fit), ("HP patches", 42, hp_fit)]:
    print(f"| {name} | {count} | {rmse(fitted):.5f} |")
plot = dm.RPlot.create()
plot.points(x, y, "Observations", dm.RGB("#8899aa88"))
for fitted, label, color, width in [(truth, "Signal", "#334155", 2.0),
    (b_fit, "B-spline", "#15803d", 2.0), (p_fit, "P-spline", "#b83280", 2.5), (hb_fit, "HB patches", "#d97706", 2.5),
    (hp_fit, "HP patches", "#2563eb", 3.0)]:
    plot.lines(grid, fitted, label, dm.RGB(color), width)
plot.set_title("Global and hierarchical spline fits")
plot.set_subtitle("Cubic splines; local correction on [0.5, 0.75]; lambda = 0.5")
plot.set_xlab("x")
plot.set_ylab("y")
plot.size(1100, 650)
Path("build/figs").mkdir(parents=True, exist_ok=True)
meshes = dm.RLayout.create(2, 1)
for model, title, color in [(hb, "HB refinement mesh (unpenalized patches)", "#d97706"),
                             (hp, "HP refinement mesh (penalized patches)", "#2563eb")]:
    mesh = dm.RPlot.create()
    mesh.set_title(title)
    mesh.set_subtitle("Bars = cells; ticks = distinct fitted knots; all degrees = 3")
    mesh.set_xlab("Global x")
    mesh.set_ylab("Refinement depth")
    mesh.xlim(0, 1)
    mesh.ylim(-2.45, .45)
    mesh.y_ticks([0, -1, -2], ["0", "1", "2"])
    mesh.show_grid(False)
    mesh.margins(85, 35, 65, 50)
    mesh.size(1100, 310)
    for cell in range(model.cell_count()):
        lo, hi = model.cell_min(cell)[0], model.cell_max(cell)[0]
        level = -model.depth(cell)
        fitted = model.has_spline(cell)
        mesh.segments([lo], [level], [hi], [level], dm.RGB(color if fitted else "#94a3b8"), 5)
        if fitted:
            patch = model.spline(cell)
            basis = patch.bases()[0]
            knots = sorted(set(basis.knots()))
            knots = [lo + (hi - lo) * t for t in knots]
            mesh.segments(knots, [level-.12]*len(knots), knots,
                          [level+.12]*len(knots), dm.RGB(color), 1.5)
            mesh.text((lo+hi)/2, level-.28,
                      f"{basis.basis_size()} coefficients, {len(knots)-1} spans", dm.RGB("#334155"), 12)
        else:
            mesh.text((lo+hi)/2, level-.28, "Routing cell: no fitted patch", dm.RGB("#64748b"), 12)
    meshes.add(mesh)
meshes.size(1100, 620)
meshes.save("build/figs/spline_refinement_python.svg")
Path("figures").mkdir(exist_ok=True)
shutil.copyfile("build/figs/spline_refinement_python.svg", "figures/spline_refinement_python.svg")
plot.save_svg("build/figs/spline_comparison_python.svg")
```
