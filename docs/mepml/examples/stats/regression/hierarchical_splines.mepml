\tab(R,

```{r, results="markdown", nix-shell="git+file:../../../../..#r", cmd="env R_LIBS_USER=../../../../../build/r/library Rscript {file}", file="figures/spline_comparison_r.svg"}
suppressPackageStartupMessages(library(datamunger))
signal <- function(t) sin(2*pi*t) + 0.8*exp(-2500*(t - 0.65)^2)
x <- (0:240)/240
y <- signal(x) + 0.12*sin(173*x) + 0.07*cos(297*x)
points <- lapply(x, function(t) c(t))
selected <- which(x >= 0.5 & x <= 0.75)
local_points <- points[selected]
local_y <- y[selected]
bs <- BSplineRegression(x, y, 40L, 3L)
ps <- PSplineRegression(x, y, 40L, 0.5, 3L, 2L)
# A native vector holds one basis per coordinate axis.
coarse <- BSplineBasisVector()
invisible(coarse$push_back(BSplineBasis_open_uniform(3L, 10L)))
fine <- BSplineBasisVector()
invisible(fine$push_back(BSplineBasis_open_uniform(3L, 32L)))
hb <- HierarchicalBSpline(c(0), c(1))
hp <- HierarchicalBSpline(c(0), c(1))
invisible(hb$fit_cell(0L, coarse, points, y))
invisible(hp$fit_cell_penalized(0L, coarse, points, y, c(0.5), 2L))
# Refine [0,1] -> [0.5,1] -> [0.5,0.75].
hb_patch <- hb$refine(hb$refine(0L, 1L), 0L)
hp_patch <- hp$refine(hp$refine(0L, 1L), 0L)
# Pass raw data; the C++ solver subtracts the ancestor contribution.
invisible(hb$fit_cell(hb_patch, fine, local_points, local_y))
invisible(hp$fit_cell_penalized(hp_patch, fine, local_points, local_y, c(0.5), 2L))
grid <- (0:1000)/1000
truth <- signal(grid)
b_fit <- as.numeric(bs$predict(grid))
p_fit <- as.numeric(ps$predict(grid))
hb_fit <- vapply(grid, function(t) hb$evaluate(c(t)), numeric(1))
hp_fit <- vapply(grid, function(t) hp$evaluate(c(t)), numeric(1))
rmse <- function(fitted) sqrt(mean((fitted - truth)^2))
cat("| Fit | Coefficients | Signal RMSE |\n| --- | ---: | ---: |\n")
cat(sprintf("| B-spline | 40 | %.5f |\n", rmse(b_fit)))
cat(sprintf("| P-spline | 40 | %.5f |\n", rmse(p_fit)))
cat(sprintf("| HB patches | 42 | %.5f |\n", rmse(hb_fit)))
cat(sprintf("| HP patches | 42 | %.5f |\n", rmse(hp_fit)))
plot <- RPlot_create()
invisible(plot$points(x, y, "Observations", RGB("#8899aa88")))
invisible(plot$lines(grid, truth, "Signal", RGB("#334155"), 2))
invisible(plot$lines(grid, b_fit, "B-spline", RGB("#15803d"), 2))
invisible(plot$lines(grid, p_fit, "P-spline", RGB("#b83280"), 2.5))
invisible(plot$lines(grid, hb_fit, "HB patches", RGB("#d97706"), 2.5))
invisible(plot$lines(grid, hp_fit, "HP patches", RGB("#2563eb"), 3))
invisible(plot$set_title("Global and hierarchical spline fits"))
invisible(plot$set_subtitle("Cubic splines; local correction on [0.5, 0.75]; lambda = 0.5"))
invisible(plot$set_xlab("x"))
invisible(plot$set_ylab("y"))
invisible(plot$size(1100L, 650L))
dir.create("build/figs", recursive=TRUE, showWarnings=FALSE)
meshes <- RLayout_create(2L, 1L)
models <- list(hb, hp)
titles <- c("HB refinement mesh (unpenalized patches)", "HP refinement mesh (penalized patches)")
colors <- c("#d97706", "#2563eb")
for (i in seq_along(models)) {
  model <- models[[i]]
  mesh <- RPlot_create()
  invisible(mesh$set_title(titles[i]))
  invisible(mesh$set_subtitle("Bars = cells; ticks = distinct fitted knots; all degrees = 3"))
  invisible(mesh$set_xlab("Global x"))
  invisible(mesh$set_ylab("Refinement depth"))
  invisible(mesh$xlim(0, 1))
  invisible(mesh$ylim(-2.45, .45))
  invisible(mesh$y_ticks(c(0, -1, -2), c("0", "1", "2")))
  invisible(mesh$show_grid(FALSE))
  invisible(mesh$margins(85, 35, 65, 50))
  invisible(mesh$size(1100L, 310L))
  for (cell in seq_len(model$cell_count()) - 1L) {
    lo <- as.numeric(model$cell_min(cell))[1]
    hi <- as.numeric(model$cell_max(cell))[1]
    level <- -model$depth(cell)
    fitted <- model$has_spline(cell)
    invisible(mesh$segments(c(lo), c(level), c(hi), c(level),
      RGB(if (fitted) colors[i] else "#94a3b8"), 5))
    if (fitted) {
      patch <- model$spline(cell)
      bases <- patch$bases()
      basis <- bases$front()
      knots <- lo + (hi-lo)*sort(unique(as.numeric(basis$knots())))
      invisible(mesh$segments(knots, rep(level-.12, length(knots)), knots,
        rep(level+.12, length(knots)), RGB(colors[i]), 1.5))
      invisible(mesh$text((lo+hi)/2, level-.28,
        sprintf("%d coefficients, %d spans", basis$basis_size(), length(knots)-1L), RGB("#334155"), 12))
    } else {
      invisible(mesh$text((lo+hi)/2, level-.28, "Routing cell: no fitted patch", RGB("#64748b"), 12))
    }
  }
  invisible(meshes$add(mesh))
}
invisible(meshes$size(1100L, 620L))
invisible(meshes$save("build/figs/spline_refinement_r.svg"))
dir.create("figures", showWarnings=FALSE)
stopifnot(file.copy("build/figs/spline_refinement_r.svg", "figures/spline_refinement_r.svg", overwrite=TRUE))
invisible(plot$save_svg("build/figs/spline_comparison_r.svg"))
```
