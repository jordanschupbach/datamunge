| \(\theta_A\) | 6.21 | 5.59 | 6.08 | 5.39 | -1.57 | 15.95 | 2907 | 1.001 | 0.100 | 0.925 |
| \(\theta_B\) | 4.94 | 4.67 | 4.85 | 4.67 | -2.61 | 12.48 | 2448 | 1.002 | 0.094 | 0.864 |
| \(\theta_C\) | 3.93 | 5.26 | 3.85 | 5.30 | -4.85 | 11.81 | 2088 | 1.002 | 0.116 | 0.932 |
| \(\theta_D\) | 4.76 | 4.78 | 4.70 | 4.66 | -2.67 | 12.30 | 2604 | 1.001 | 0.091 | 0.881 |
| \(\theta_E\) | 3.62 | 4.66 | 3.52 | 4.64 | -4.55 | 10.48 | 2073 | 1.003 | 0.102 | 0.844 |
| \(\theta_F\) | 4.04 | 4.83 | 3.99 | 4.85 | -4.04 | 11.45 | 2295 | 1.001 | 0.101 | 0.881 |
| \(\theta_G\) | 6.30 | 5.08 | 6.14 | 5.06 | -1.04 | 15.19 | 2885 | 1.002 | 0.094 | 0.864 |
