//? Title: Seasonal ARIMA: The Airline Model
//? Subtitle: Box-Jenkins identification, estimation and forecasting of monthly airline passengers with datamunge's stats::ARIMA, checked against R and against a held-out year
//? Exports: both
//? Lang: en-GB

\abstract(
Box and Jenkins built their seasonal ARIMA methodology around one series:
monthly international airline passengers from 1949 to 1960, now
`dm::datasets::air_passengers()`. We follow their three steps on it. For
*identification*, logs stop the seasonal swings from growing with the
level, and two differences make the series stationary. The sample autocorrelations then
spike at lags 1 and 12, which points to the "airline model"
\((1-B)(1-B^{12})\log y_t=(1+\theta B)(1+\Theta B^{12})\varepsilon_t\). We
derive that model's theoretical autocorrelations. For *estimation*,
conditional least squares gives \(\hat\theta=-0.377\) and
\(\hat\Theta=-0.572\), identical to R's `arima(method = "CSS")` to six
digits. The Ljung-Box test finds no structure left in the residuals
(\(p=0.31\)). For *forecasting*, \(\psi\)-weights give the forecast
standard errors, which grow from 3.7% to 8.6% over a year. Refitted on
1949–1958, the model forecasts 1959–1960 with a mean absolute percentage
error of 8.4%, and all 24 months fall inside its 95% intervals. Holt-Winters
exponential smoothing does slightly better here, at 6.7%.
)

\toc

> The data: twelve years of air travel

`air_passengers` holds the monthly totals of international airline
passengers, in thousands, from January 1949 to December 1960. It is R's
`AirPassengers`, also known as Box and Jenkins' series G.

```{cpp, results="markdown", file="figures/arima_series.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>

namespace agg = dm::agg;

int main() {
  std::filesystem::create_directories("build");
  const auto air = dm::datasets::air_passengers()
                   | dm::mutate("log_passengers", [](const auto& r) { return std::log(r.get_double("passengers")); });
  std::print("{}\n\n", air
      | dm::group_by("year")
      | dm::summarise(agg::mean("passengers", "mean"), agg::min("passengers", "min"), agg::max("passengers", "max"),
                      agg::min("log_passengers", "log min"), agg::max("log_passengers", "log max"))
      | dm::mutate("range / mean", [](const auto& r) { return (r.get_double("max") - r.get_double("min")) / r.get_double("mean"); })
      | dm::mutate("log range", [](const auto& r) { return r.get_double("log max") - r.get_double("log min"); })
      | dm::select({"year", "mean", "min", "max", "range / mean", "log range"})
      | dm::to_md(3));

  std::vector<double> t, y, ly;
  for (std::size_t i = 0; i < air.nrows(); ++i) {
    t.push_back(air.double_at("year", i) + (air.double_at("month", i) - 1) / 12.0);
    y.push_back(air.double_at("passengers", i));
    ly.push_back(air.double_at("log_passengers", i));
  }
  auto layout = dm::graphics::RLayout::create(1, 2);
  layout.add(dm::graphics::RPlot::create().lines(t, y, "", dm::RGB{37, 99, 235}, 1.5)
                 .title("Passengers (thousands)").x_label("year").y_label("passengers"));
  layout.add(dm::graphics::RPlot::create().lines(t, ly, "", dm::RGB{37, 99, 235}, 1.5)
                 .title("log passengers").x_label("year").y_label("log passengers"));
  layout.size(1200, 440).save_svg("build/arima_series.svg");
}
```
