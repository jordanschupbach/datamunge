| pooled | 0.871754 | 0.827036 | 0.905508 | 1.038667e-47 |
| setosa | 0.267176 | -0.012070 | 0.507762 | 6.069778e-02 |
| versicolor | 0.754049 | 0.602068 | 0.853300 | 2.586190e-10 |
| virginica | 0.864225 | 0.771454 | 0.921017 | 6.297786e-16 |


