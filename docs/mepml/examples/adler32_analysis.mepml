| "abc" | 3 | 295 | 589 | 0x024D0127 | 589 | 0x352441C2 |
| "Wikipedia" | 9 | 920 | 4582 | 0x11E60398 | 4582 | 0xADAAC02E |
| "ABCD" | 4 | 267 | 664 | 0x0298010B | 664 | 0xDB1720A5 |
| "ABDC" | 4 | 267 | 665 | 0x0299010B | 665 | 0x0A3223C1 |
