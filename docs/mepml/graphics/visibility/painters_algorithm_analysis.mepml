> Controls and boundary cases

```{cpp, results="markdown", file="figures/painters_algorithm_controls.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <datamunge/plot/diagram.hpp>
#include <datamunge/plot/plot.hpp>
#include <filesystem>
#include <print>
#include <iostream>
#include <sstream>
#include <algorithm>
#include <cmath>
#include <numeric>
#include <vector>
#include <string>
#include <datamunge/algorithms/painters_algorithm.hpp>
int main() {
    std::filesystem::create_directories("build");
    std::vector<dm::algorithms::DepthRect> r{{-2, 0, 1, 0, 1, 4},
                                             {1, 0, 3, 0, 1, 0},
                                             {3, 0, 2, 0, 0, 7}};
    auto t = dm::algorithms::painter_trace(r, 3, 1);
    std::print("Equal depths and background erasure: `{}`; actual writes {}.\n",
               t.raster[0], t.writes.size());
    auto p =
        dm::graphics::RPlot::barplot(std::vector<double>(t.raster[0].begin(),
                                                         t.raster[0].end()),
                                     {"0", "1", "2"}, "final color id");
    p.title("Stable equal-depth overlap and explicit background erasure").x_label("pixel column").y_label("color id");
    p.save_svg("build/painters_algorithm_controls.svg");
}
```
