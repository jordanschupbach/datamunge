> The original fixture, retained

This complete program retains the original inputs, seed and substantive
experiment. Any added display prefix is explicitly separate from the original
random call schedule.

```{cpp, results="markdown", file="figures/painters_algorithm_original.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <datamunge/plot/diagram.hpp>
#include <datamunge/plot/plot.hpp>
#include <filesystem>
#include <print>
#include <iostream>
#include <sstream>
#include <algorithm>
#include <cmath>
#include <numeric>
#include <vector>
#include <string>
#include <datamunge/algorithms/painters_algorithm.hpp>
#include <filesystem>
#include <datamunge/algorithms/painters_algorithm.hpp>
#include <datamunge/plot/plot.hpp>

#include <iostream>
#include <sstream>
#include <vector>

using namespace datamunge::algorithms;
using namespace datamunge::graphics;

int main() {
    std::ostringstream original_output;
    auto *original_cout = std::cout.rdbuf(original_output.rdbuf());

    std::filesystem::create_directories("build");
    std::vector<DepthRect> rects = {{0, 0, 7, 7, 10.0, 1},  // far  (color 1) full background
                                    {1, 1, 5, 5, 5.0, 2},  // mid  (color 2)
                                    {3, 3, 6, 6, 1.0, 3}};  // near (color 3)

    std::vector<double> depths = {10.0, 5.0, 1.0};
    auto order = painter_order(depths);
    std::cout << "=== Draw order (farthest first) ===\n  ";
    for (int i : order)
        std::cout << "obj" << i << "(depth " << depths[i] << ") ";
    std::cout << "\n";

    auto raster = painter_render(rects, 8, 8);
    std::cout << "\n=== 8x8 raster (color id per pixel) ===\n";
    for (const auto &row : raster) {
        std::cout << "  ";
        for (int v : row)
            std::cout << v << " ";
        std::cout << "\n";
    }

    // Draw the three rectangles as filled polygons in back-to-front order.
    RPlot p = RPlot::create();
    RGB cols[4] = {{255, 255, 255}, {220, 38, 38}, {16, 122, 87}, {37, 99, 235}};
    for (int idx : order) {
        const DepthRect &r = rects[idx];
        p.polygon({(double) r.x0, (double) r.x1 + 1, (double) r.x1 + 1,
                   (double) r.x0},
                  {(double) r.y0, (double) r.y0, (double) r.y1 + 1,
                   (double) r.y1 + 1}, cols[r.color], 1.0);
    }
    p.title("Original constant-depth rectangles: actual stable draw order").x_label("pixel column boundary").y_label("row boundary (upward display)");
    p.save_svg("build/painters_algorithm_original.svg");
    std::cout << "\nwrote build/painters_algorithm_original.svg\n";
    std::cout.rdbuf(original_cout);
    std::print("| Original computed output |\n| --- |\n");
    std::istringstream lines(original_output.str());
    std::string line;
    while (std::getline(lines, line)) {
        while (!line.empty() && line.back() == ' ') line.pop_back();
        if (!line.empty()) std::print("| `{}` |\n", line);
    }

    return 0;
}
```
