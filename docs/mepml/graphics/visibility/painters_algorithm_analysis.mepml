> Producing work and finite observations

```{cpp, results="markdown", file="figures/painters_algorithm_work.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <datamunge/plot/diagram.hpp>
#include <datamunge/plot/plot.hpp>
#include <filesystem>
#include <print>
#include <iostream>
#include <sstream>
#include <algorithm>
#include <cmath>
#include <numeric>
#include <vector>
#include <string>
#include <datamunge/algorithms/painters_algorithm.hpp>
int main() {
    std::filesystem::create_directories("build");
    std::vector<dm::algorithms::DepthRect> r{{0, 0, 7, 7, 10, 1},
                                             {1, 1, 5, 5, 5, 2},
                                             {3, 3, 6, 6, 1, 3}};
    auto t = dm::algorithms::painter_trace(r, 8, 8);
    std::vector<double> v(r.size(), 0);
    for (auto &w : t.writes)
        ++v[w.object];
    std::print("| original object | actual pixel assignments |\n| ---: | ---: |\n");
    for (std::size_t i = 0; i < v.size(); ++i)
        std::print("| {} | {} |\n", i, v[i]);
    auto p =
        dm::graphics::RPlot::barplot(v, {"far full", "mid", "near"},
                                     "actual writes");
    p.title("Painter work counts assignments, including overwritten pixels").y_label("actual pixel assignments");
    p.save_svg("build/painters_algorithm_work.svg");
}
```
