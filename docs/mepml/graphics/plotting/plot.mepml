\tab(OCaml,
Run in the toplevel, loading the binding with findlib:

```{ocaml, nix-shell="git+file:../../../..#report-ocaml", file="figures/plot_ocaml.svg"}
#use "topfind";;
#require "datamunge";;
open Datamunge

let doppler x = Array.map (fun xi -> sin (20. /. (xi +. 0.25))) x
let rgb ?(alpha = 1.0) r g b = RGB.create_int_int_int_float ~opacity:alpha r g b

let () =
  set_seed 42;
  let x = runif 0. 1. 1000 in
  let eps = rnorm 0. 1. 1000 in
  let y = Array.map2 ( +. ) (doppler x) eps in
  let xseq = seql 0. 1. 1000 in
  let yseq = doppler xseq in
  let bsr = BSplineRegression.create x y 100 in
  let yfit = BSplineRegression.predict bsr xseq in
  if not (Sys.file_exists "build") then Sys.mkdir "build" 0o755;
  let plot = RPlot.create () in
  (* Each setter returns the plot: ignore it (or chain through it). *)
  ignore (RPlot.title plot "Doppler data");
  ignore (RPlot.points ~label:"Samples" ~color:(rgb ~alpha:0.6 237 199 135) ~marker_size:4.0 plot x y);
  ignore (RPlot.lines ~label:"True Mean" ~color:(rgb 200 10 44) ~stroke_width:3.0 plot xseq yseq);
  ignore (RPlot.lines ~label:"Estimated Mean" ~color:(rgb 44 10 200) ~stroke_width:3.0 plot xseq yfit);
  ignore (RPlot.xlab plot "X");
  ignore (RPlot.ylab plot "doppler(X)");
  RPlot.save plot "build/plot_ocaml.svg"
```
