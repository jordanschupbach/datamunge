\tab(Java,
The binding is generated by Rosetta; the report shell puts the nix-built
`datamunge.jar` on `CLASSPATH` and names its JNI library in
`DATAMUNGE_JAVA_LIBRARY`. Run as a single-file program; vectors are `double[]`:

```{java, nix-shell="git+file:../../../..#report-java", cmd="java {file}", file="figures/plot_java.svg"}
import datamunge.BSplineRegression;
import datamunge.Datamunge;
import datamunge.RGB;
import datamunge.RPlot;
import java.util.Arrays;

public class DopplerPlot {
  static double[] doppler(double[] x) {
    return Arrays.stream(x).map(v -> Math.sin(20 / (v + 0.25))).toArray();
  }

  public static void main(String[] args) {
    Datamunge.setSeed(42);
    double[] x = Datamunge.runif(0, 1, 1000);
    double[] noise = Datamunge.rnorm(0, 1, 1000);
    double[] f = doppler(x);
    double[] y = new double[x.length];
    for (int i = 0; i < y.length; i++) y[i] = f[i] + noise[i];
    double[] xseq = Datamunge.seql(0, 1, 1000);
    double[] yseq = doppler(xseq);
    double[] yfit = new BSplineRegression(x, y, 100).predict(xseq);

    new java.io.File("build").mkdirs();
    RPlot.create().title("Doppler data")
        .points(x, y, "Samples", new RGB("#edc78799"))
        .lines(xseq, yseq, "True Mean", new RGB("#c80a2c"), 3.0)
        .lines(xseq, yfit, "Estimated Mean", new RGB("#2c0ac8"), 3.0)
        .xLabel("X").yLabel("doppler(X)").size(1000, 600)
        .save("build/plot_java.svg");
  }
}
```
