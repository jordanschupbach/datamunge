\tab(Octave,
The binding is generated by Rosetta; the report shell puts the nix-built package
`+datamunge` and its oct-file on the load path. Vectors are row vectors, and
methods chain:

```{octave, nix-shell="git+file:../../../..#report-octave", file="figures/plot_octave.svg"}
doppler = @(x) sin (20 ./ (x + 0.25));
datamunge.set_seed (42);
x = datamunge.runif (0, 1, 1000);
y = doppler (x) + datamunge.rnorm (0, 1, 1000);
xseq = datamunge.seql (0, 1, 1000);
yseq = doppler (xseq);
yfit = datamunge.BSplineRegression (x, y, 100).predict (xseq);
[~] = mkdir ("build");
datamunge.RPlot.create () ...
  .title ("Doppler data") ...
  .points (x, y, "Samples", datamunge.RGB ("#edc78799")) ...
  .lines (xseq, yseq, "True Mean", datamunge.RGB ("#c80a2c"), 3.0) ...
  .lines (xseq, yfit, "Estimated Mean", datamunge.RGB ("#2c0ac8"), 3.0) ...
  .x_label ("X").y_label ("doppler(X)") ...
  .size_ (1000, 600) ...
  .save ("build/plot_octave.svg");
