\tab(Go,
The binding is generated by Rosetta; the report shell's workspace (`GOWORK`)
holds the nix-built module `datamunge` and `CGO_LDFLAGS` points cgo at its
`libdatamunge_go`. Calls return `(T, error)` and vectors are `[]float64`:

```{go, nix-shell="git+file:../../../..#report-go", file="figures/plot_go.svg"}
package main

import (
	"datamunge"
	"math"
	"os"
)

// doppler(x) element-wise.
func doppler(x []float64) []float64 {
	y := make([]float64, len(x))
	for i, v := range x {
		y[i] = math.Sin(20 / (v + 0.25))
	}
	return y
}

func main() {
	m := datamunge.Must[[]float64]
	check := func(_ any, err error) {
		if err != nil {
			panic(err)
		}
	}
	check(nil, datamunge.SetSeed(42))
	x := m(datamunge.Runif(0, 1, 1000))
	noise := m(datamunge.Rnorm(0, 1, 1000))
	y := doppler(x)
	for i := range y {
		y[i] += noise[i] // y = doppler(x) + noise
	}
	xseq := m(datamunge.Seql(0, 1, 1000))
	yseq := doppler(xseq)
	fit := datamunge.Must(datamunge.NewBSplineRegression(x, y, 100))
	yfit := m(fit.Predict(xseq))

	color := func(hex string) *datamunge.RGB { return datamunge.Must(datamunge.NewRGBColor(hex)) }
	os.MkdirAll("build", 0o755)
	// Builder methods return the plot itself (and an error), so they are called in turn.
	plot := datamunge.Must(datamunge.RPlotCreate())
	check(plot.Title("Doppler data"))
	check(plot.PointsWithColor(x, y, "Samples", color("#edc78799")))
	check(plot.LinesWithStrokeWidth(xseq, yseq, "True Mean", color("#c80a2c"), 3.0))
	check(plot.LinesWithStrokeWidth(xseq, yfit, "Estimated Mean", color("#2c0ac8"), 3.0))
	check(plot.XLabel("X"))
	check(plot.YLabel("doppler(X)"))
	check(plot.Size(1000, 600))
	check(nil, plot.Save("build/plot_go.svg"))
}
```
