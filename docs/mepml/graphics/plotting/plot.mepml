\tab(Tcl,
The binding is generated by Rosetta; the report shell puts the nix-built package
directory `datamunge/` on `TCLLIBPATH`. Classes are TclOO classes in
`::datamunge` (`namespace path` makes them visible unqualified), and vectors are
Tcl lists:

```{tcl, nix-shell="git+file:../../../..#report-tcl", file="figures/plot_tcl.svg"}
package require datamunge
namespace path ::datamunge

proc doppler {x} {lmap xi $x {expr {sin(20 / ($xi + 0.25))}}}

set_seed 42
set x [runif 0 1 1000]
set y [lmap fx [doppler $x] e [rnorm 0 1 1000] {expr {$fx + $e}}]
set xseq [seql 0 1 1000]
set yseq [doppler $xseq]
set yfit [[BSplineRegression new $x $y 100] predict $xseq]
file mkdir build
set plot [RPlot create_]
$plot title "Doppler data"
$plot points $x $y "Samples" [RGB new "#edc78799"]
$plot lines $xseq $yseq "True Mean" [RGB new "#c80a2c"] 3.0
$plot lines $xseq $yfit "Estimated Mean" [RGB new "#2c0ac8"] 3.0
$plot x_label "X"
$plot y_label "doppler(X)"
$plot size 1000 600
$plot save "build/plot_tcl.svg"
```
