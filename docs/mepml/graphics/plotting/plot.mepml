\tab(Guile,
The binding is generated by Rosetta; the report shell puts the nix-built module
`(datamunge)` and its extension on `GUILE_LOAD_PATH`. Classes are GOOPS classes
and methods generics, and vectors are lists:

```{scheme, nix-shell="git+file:../../../..#report-guile", file="figures/plot_guile.svg"}
(use-modules (oop goops) (datamunge))

(define (doppler x) (map (lambda (xi) (sin (/ 20 (+ xi 0.25)))) x))

(set-seed! 42)
(define x (runif 0.0 1.0 1000))
(define y (map + (doppler x) (rnorm 0.0 1.0 1000)))
(define xseq (seql 0.0 1.0 1000))
(define yseq (doppler xseq))
(define yfit (predict (make <b-spline-regression> x y 100) xseq))
(unless (file-exists? "build") (mkdir "build"))
(define plot (r-plot-create))
(title plot "Doppler data")
(points plot x y "Samples" (make <rgb> "#edc78799"))
(lines plot xseq yseq "True Mean" (make <rgb> "#c80a2c") 3.0)
(lines plot xseq yfit "Estimated Mean" (make <rgb> "#2c0ac8") 3.0)
(x-label plot "X")
(y-label plot "doppler(X)")
(size plot 1000 600)
(save plot "build/plot_guile.svg")
```
