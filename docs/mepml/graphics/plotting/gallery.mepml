// \image(figures/plot_gallery_survival.svg)
// result_end

> Radial profiles, regional values and networks

Radar charts compare normalized quantities on radial spokes. Choropleths
reuse the continuous palette across supplied projected regions. The three
example shapes are synthetic, and their labels show the values driving the
colors. Arc diagrams place ordered nodes on a line and draw their edges above
it.

```{cpp, file="figures/plot_gallery_geometry.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <datamunge/plot/plot.hpp>
#include <filesystem>

int main() {
    using datamunge::graphics::RLayout;
    using datamunge::graphics::RPlot;
    auto gallery = RLayout::create(1, 3).size(1200, 410);
    gallery.add(RPlot().radar({.9, .55, .7, .4, .8}, {"Range", "Speed", "Lift", "Cost", "Life"})
                    .title("Radar profile"))
           .add(RPlot().choropleth({{0, 1, 1, 0}, {1, 2, 2.15, 1}, {0, 1, 2.15, 1.85, .25}},
                                    {{0, 0, 1, 1.15}, {0, 0, 1.15, 1}, {1.15, 1, 1.15, 2.1, 2}},
                                    {12, 28, 43})
                    .text(.5, .5, "12", {255, 255, 255}).text(1.54, .5, "28", {255, 255, 255})
                    .text(1.1, 1.55, "43").hide_axes().title("Regional values"))
           .add(RPlot().arc_diagram({0, 1, 2, 3, 4}, {0, 0, 1, 2}, {1, 4, 3, 4})
                    .x_tick_labels({"A", "B", "C", "D", "E"}).show_grid(false)
                    .x_label("Node").y_label("").title("Network arcs"));
    std::filesystem::create_directories("build");
    gallery.fit_panels().save_svg("build/plot_gallery_geometry.svg");
}
```
