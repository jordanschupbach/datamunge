> Real seeded denominator evidence

For10403=101*103, seed1 and bound20, allow at most20 random curves and retain
every actual evaluated denominator. Identity and additive-inverse shortcuts are
counted as point additions but are not invented denominator records. Each
captured curve stores its original point/coefficient/discriminant GCD and actual
exit point/factor. All records come from the shared producing execution; the
plot reads actual denominator GCDs in chronological order. A complete trace is
returned or a quota exception is thrown, never a silently incomplete prefix.

```{cpp, results="markdown", file="figures/ecm_denominators.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
    std::filesystem::create_directories("build");
    auto t = dm::algorithms::lenstra_ecm_trace(10403, 1, {20, 20});
    std::print("| actual curve | actual initial x | actual initial y | actual a | actual b | actual " "discriminant gcd | actual factor on curve |\n| ---: | ---: | ---: | ---: | ---: | ---: | " "---: |\n");
    for (auto &c : t.curves)
        std::print("| {} | {} | {} | {} | {} | {} | {} |\n", c.index,
                   c.initial.x, c.initial.y, c.a, c.b, c.discriminant_gcd,
                   c.factor);
    std::print("\n| actual denominator index | actual curve | actual denominator | actual gcd | actual " "inversion | actual proper factor |\n| ---: | ---: | ---: | ---: | --- | ---: |\n");
    std::vector<double> x, y;
    for (std::size_t i = 0; i < t.denominators.size(); ++i) {
        auto &e = t.denominators[i];
        x.push_back(i);
        y.push_back(std::log2(double(e.gcd)));
        if (i < 5 || e.factor)
            std::print("| {} | {} | {} | {} | {} | {} |\n", i, e.curve,
                       e.denominator, e.gcd, e.inverted, e.factor);
    }
    std::print("\nActual result {}; proper factor {}; actual additions {}; actual denominator gcds {}; " "actual inversions {}; actual captured entries {}.\n",
               t.analysis.factor, t.analysis.proper, t.analysis.work.additions,
               t.analysis.work.denominator_gcds, t.analysis.work.inversions,
               t.captured_entries);
    auto p = dm::graphics::RPlot::create();
    p.points(x, y, "actual denominator gcd", {37, 99, 235}, 4).y_limits(-.5, 16).title("Real evaluated denominator GCDs in producer order").x_label("actual evaluated denominator index").y_label("log2(actual gcd)").save_svg("build/ecm_denominators.svg");
}
```
