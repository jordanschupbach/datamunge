> Decimal domain, zero widths and complete admission

Unsigned ASCII digits are accepted, with leading zeros normalized at the root.
Empty input retains the legacy zero convention. Signs, whitespace and nondecimal
bytes now reject. Recursive slices preserve their producing widths, including
padded zeros, so their actual leaf costs can exceed a magnitude-only estimate.
Products are normalized decimal strings. A zero root has one stored digit and
executes a real schoolbook leaf rather than a fabricated zero-work result.

```{cpp, results="markdown", file="figures/karatsuba_controls.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <datamunge/algorithms/karatsuba.hpp>
#include <datamunge/plot/diagram.hpp>
#include <filesystem>
#include <print>
#include <stdexcept>
#include <limits>
#include <cmath>
int main() {
    std::filesystem::create_directories("build");
    std::print("| left input | right input | actual product | calls | leaves | digit products |\n| --- | " "--- | --- | ---: | ---: | ---: |\n");
    for (const auto &inputs : std::vector<std::pair<std::string, std::string>>{
         {"", "123"}, {"0", "999"}, {"00012", "0034"}, {"999", "999"}
     }) {
        const auto t =
            dm::algorithms::karatsuba_trace(inputs.first, inputs.second);
        std::print("| {} | {} | {} | {} | {} | {} |\n",
                   inputs.first.empty() ? "empty" : inputs.first, inputs.second,
                   t.product, t.work.recursive_calls, t.work.schoolbook_leaves,
                   t.work.digit_products);
    }
    bool invalid = false, capped = false;
    try {
        (void) dm::algorithms::karatsuba_multiply("-12", "34");
    } catch (const std::invalid_argument &) {
        invalid = true;
    }
    try {
        (void) dm::algorithms::karatsuba_trace(std::string(33, '9'),
                                               std::string(33, '9'), {0, 1, 0});
    } catch (const std::length_error &) {
        capped = true;
    }
    if (!invalid || !capped)
        throw std::runtime_error("domain and actual-call quota");
    std::print("\nA sign rejects; a one-call ceiling cannot admit the actual33-digit recursive children.\n");
    std::vector<double> x, y;
    for (std::size_t n : {16, 31, 32, 33, 64, 65, 128, 256}) {
        const auto t =
            dm::algorithms::karatsuba_trace(std::string(n, '9'),
                                            std::string(n, '9'));
        x.push_back(n);
        y.push_back(t.work.recursive_calls);
    }
    auto p = dm::graphics::RPlot::create();
    p.line(x, y, "", {37, 99, 235}, 2).points(x, y, "", {37, 99, 235}, 4).title(
        "Actual invocation counts across the crossover").x_label(
        "digits per operand").y_label("actual recursive calls").save_svg(
        "build/karatsuba_controls.svg");
}
```
