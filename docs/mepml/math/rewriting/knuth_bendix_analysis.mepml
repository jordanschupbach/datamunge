> The original S3 presentation and original word

Keep equations aa=e, bbb=e and abab=e, where e is the empty word. They present the permutation group S3: a is a transposition, b is a three-cycle, and ab is a transposition. The output below lists the actual completed rules and all actual reductions of the original word bbababbaab. A successful completion supplies the canonical-word argument; a finite enumeration alone does not prove group order or general confluence.

```{cpp, results="markdown", file="figures/knuth_bendix_original.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <datamunge/algorithms/knuth_bendix.hpp>
#include <datamunge/plot/plot.hpp>
#include <filesystem>
#include <print>
int main() {
  std::filesystem::create_directories("build");
  const auto c = dm::algorithms::knuth_bendix({{"aa", ""}, {"bbb", ""}, {"abab", ""}});
  std::print("| actual rule identity | lhs | rhs, e means empty |\n| ---: | --- | --- |\n");
  for (std::size_t i = 0; i < c.rules.size(); ++i)
    std::print(
        "| {} | {} | {} |\n", i, c.rules[i].lhs, c.rules[i].rhs.empty() ? "e" : c.rules[i].rhs);
  std::print("\nComplete critical-pair scan {}; actual rules {}.\n", c.complete, c.rules.size());
  const auto          t = dm::algorithms::kb_rewrite_trace("bbababbaab", c.rules);
  std::vector<double> x{0}, y{double(t.start.size())};
  std::print(
      "\n| actual rewrite | rule identity | byte position | actual word after, e means empty | "
      "length |\n| ---: | ---: | ---: | --- | ---: |\n");
  for (std::size_t i = 0; i < t.steps.size(); ++i) {
    const auto& e = t.steps[i];
    std::print(
        "| {} | {} | {} | {} | {} |\n",
        i + 1,
        e.rule_index,
        e.position,
        e.after.empty() ? "e" : e.after,
        e.after.size());
    x.push_back(i + 1);
    y.push_back(e.after.size());
  }
  auto p = dm::graphics::RPlot::create();
  p.line(x, y, "length", {37, 99, 235}, 2)
      .points(x, y, "", {37, 99, 235}, 4)
      .y_limits(-.5, 12)
      .title("Original word: actual native reduction lengths")
      .x_label("actual rewrite ordinal")
      .y_label("actual word length")
      .save_svg("build/knuth_bendix_original.svg");
}
```
