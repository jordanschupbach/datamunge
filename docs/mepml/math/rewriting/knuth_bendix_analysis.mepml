> Check the six representatives with a separate model

The report enumerates every word through length10 and compares its native normal form with an independently evaluated permutation on three symbols. Multiplication composes a=(01) and b=(012); this model does not call the rewriting algorithm. Matching permutation actions provide a sound independent check for these finite words. A complete-rule critical-pair certificate and the presentation’s group structure supply the broader uniqueness argument; the census alone cannot do so.

```{cpp, results="markdown", file="figures/knuth_bendix_census.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <datamunge/algorithms/knuth_bendix.hpp>
#include <datamunge/plot/plot.hpp>
#include <filesystem>
#include <array>
#include <map>
#include <set>
#include <print>
#include <stdexcept>
int main() {
  std::filesystem::create_directories("build");
  const auto c      = dm::algorithms::knuth_bendix({{"aa", ""}, {"bbb", ""}, {"abab", ""}});
  auto       action = [](const std::string& w) {
    std::array<int, 3> p{0, 1, 2};
    for (char ch : w) {
      const std::array<int, 3> g =
          ch == 'a' ? std::array<int, 3>{1, 0, 2} : std::array<int, 3>{1, 2, 0};
      auto old = p;
      for (int i = 0; i < 3; ++i)
        p[i] = old[g[i]];
    }
    return p;
  };
  std::map<std::array<int, 3>, std::string> canonical;
  std::set<std::string>                     forms;
  std::vector<double>                       x, y;
  std::size_t                               checked = 0;
  std::print(
      "| maximum word length | cumulative actual words | distinct native forms | distinct "
      "permutation actions | mismatches |\n| ---: | ---: | ---: | ---: | ---: |\n");
  for (int n = 0; n <= 10; ++n) {
    for (int bits = 0; bits < (1 << n); ++bits) {
      std::string w;
      for (int i = 0; i < n; ++i)
        w += ((bits >> i) & 1) ? 'b' : 'a';
      const auto f = dm::algorithms::kb_normal_form(w, c.rules);
      const auto p = action(w);
      if (action(f) != p || (canonical.contains(p) && canonical[p] != f))
        throw std::runtime_error("independent permutation mismatch");
      canonical[p] = f;
      forms.insert(f);
      ++checked;
    }
    std::print("| {} | {} | {} | {} | 0 |\n", n, checked, forms.size(), canonical.size());
    x.push_back(n);
    y.push_back(forms.size());
  }
  auto p = dm::graphics::RPlot::create();
  p.line(x, y, "forms", {37, 99, 235}, 2)
      .points(x, y, "", {37, 99, 235}, 4)
      .line({0, 10}, {6, 6}, "six actions", {220, 38, 38}, 2)
      .y_limits(-.5, 8)
      .title("Finite native normal-form census versus S3 actions")
      .x_label("maximum enumerated word length")
      .y_label("distinct native forms")
      .save_svg("build/knuth_bendix_census.svg");
}
```
