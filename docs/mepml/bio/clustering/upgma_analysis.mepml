#include <datamunge/algorithms/upgma.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    auto r =
        a::upgma({{0, 17, 21, 31, 23}, {17, 0, 30, 34, 21}, {21, 30, 0, 28, 39},
                  {31, 34, 28, 0, 43}, {23, 21, 39, 43, 0}});
    std::print("| node | left | right | sizes | height |\n|---:|---:|---:|---|---:|\n");
    for (auto m : r.merges)
        std::print("|{}|{}|{}|{},{}|{}|\n", m.id, m.left, m.right, m.left_size,
                   m.right_size, m.height);
    auto p = a::upgma_plot(r, 5, {"A", "B", "C", "D", "E"});
    p.save_svg("build/upgma_original.svg");
}
