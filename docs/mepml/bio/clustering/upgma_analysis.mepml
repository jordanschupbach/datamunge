> Sensitivity and selected work

```{cpp, results="markdown", file="figures/upgma_work.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <filesystem>
#include <print>
#include <algorithm>
#include <cmath>
#include <limits>
#include <numeric>
#include <numbers>
#include <random>
#include <string>
#include <vector>
#include <map>
#include <set>
#include <array>
#include <tuple>
#include <bit>
#include <datamunge/random/quality.hpp>
#include <datamunge/algorithms/upgma.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    std::vector<double> x, y;
    std::print("| leaves | actual pair checks | actual distance updates |\n|---:|---:|---:|\n");
    for (int n : {2, 4, 8, 16, 32, 64}) {
        std::vector<std::vector<double>> d(n, std::vector<double>(n));
        for (int i = 0; i < n; ++i)
            for (int j = 0; j < n; ++j)
                d[i][j] = std::abs(i - j);
        auto r = a::upgma(d);
        std::print("|{}|{}|{}|\n", n, r.pair_checks, r.distance_updates);
        x.push_back(n);
        y.push_back(r.pair_checks);
    }
    auto p = g::RPlot::create();
    p.line(x, y, "actual", {37, 99, 235}, 2);
    p.points(x, y, "", {37, 99, 235}, 5);
    p.title("Actual exhaustive closest-pair scan grows cubically").x_label(
        "leaves").y_label("actual pair inspections");
    p.save_svg("build/upgma_work.svg");
}
```
// result_begin: markdown
| leaves | actual pair checks | actual distance updates |
|---:|---:|---:|
|2|1|0|
|4|10|3|
|8|84|21|
|16|680|105|
|32|5456|465|
|64|43680|1953|
