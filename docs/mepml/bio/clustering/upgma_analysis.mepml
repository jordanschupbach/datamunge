> Checking the theory and controls

```{cpp, results="markdown", file="figures/upgma_controls.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <filesystem>
#include <print>
#include <algorithm>
#include <cmath>
#include <limits>
#include <numeric>
#include <numbers>
#include <random>
#include <string>
#include <vector>
#include <map>
#include <set>
#include <array>
#include <tuple>
#include <bit>
#include <datamunge/random/quality.hpp>
#include <datamunge/algorithms/upgma.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    std::vector<double> x, y;
    std::print("| scale | actual root height |\n|---:|---:|\n");
    for (double scale : {0., .5, 1., 2., 4.}) {
        auto r =
            a::upgma({{0, 2 * scale, 6 * scale}, {2 * scale, 0, 4 * scale},
                      {6 * scale, 4 * scale, 0}});
        std::print("|{}|{}|\n", scale, r.merges.back().height);
        x.push_back(scale);
        y.push_back(r.merges.back().height);
    }
    auto p = g::RPlot::create();
    p.line(x, y, "actual", {37, 99, 235}, 2);
    p.points(x, y, "", {37, 99, 235}, 5);
    p.title("Scaling all distances scales actual merge heights").x_label(
        "distance scale").y_label("actual root height");
    p.save_svg("build/upgma_controls.svg");
}
```
// result_begin: markdown
| scale | actual root height |
|---:|---:|
|0|0|
|0.5|1.25|
|1|2.5|
|2|5|
|4|10|
\image(figures/upgma_controls.svg)
// result_end
