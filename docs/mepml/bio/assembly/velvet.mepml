> Sensitivity and selected work

```{cpp, results="markdown", file="figures/velvet_work.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    std::vector<double> x, y;
    std::print("| identical AA observations | edges | consumed | actual sequence bytes " "|\n|---:|---:|---:|---:|\n");
    for (int n : {1, 2, 4, 8, 16, 32, 64, 128}) {
        auto r = a::velvet_work(std::vector<std::string>(n, "AA"), 2);
        std::print("|{}|{}|{}|{}|\n", n, r.edges.size(), r.consumed,
                   r.sequence.size());
        x.push_back(n);
        y.push_back(r.sequence.size());
    }
    auto p = g::RPlot::create();
    p.line(x, y, "actual", {37, 99, 235}, 2);
    p.points(x, y, "", {37, 99, 235}, 5);
    p.title("Multiplicity is retained: n loop edges spell n+1 bytes").x_label(
        "observed loop edges").y_label("actual spelled bytes");
    p.save_svg("build/velvet_work.svg");
}
```
