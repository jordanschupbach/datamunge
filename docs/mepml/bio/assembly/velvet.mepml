> The retained original experiment

```{cpp, results="markdown", file="figures/velvet_original.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    std::string original = "ATCAGCTGACGTAC";
    std::vector<double> x, y;
    std::print("| k | observed edges | actual consumed | complete | actual sequence | matches original " "|\n|---:|---:|---:|---|---|---|\n");
    for (int k = 3; k <= 7; ++k) {
        std::vector<std::string> reads;
        for (std::size_t i = 0; i + k <= original.size(); ++i)
            reads.push_back(original.substr(i, k));
        auto r = a::velvet_work(reads, k);
        std::print("|{}|{}|{}|{}|{}|{}|\n", k, r.edges.size(), r.consumed,
                   r.eulerian, r.sequence, r.sequence == original);
        x.push_back(k);
        y.push_back(r.edges.size());
    }
    auto p = g::RPlot::create();
    p.line(x, y, "actual", {37, 99, 235}, 2);
    p.points(x, y, "", {37, 99, 235}, 5);
    p.title("Original14-base sequence: actual k-mer multiedges").x_label(
        "k bytes").y_label("actual graph edges");
    p.save_svg("build/velvet_original.svg");
}
```
// result_begin: markdown
| k | observed edges | actual consumed | complete | actual sequence | matches original |
|---:|---:|---:|---|---|---|
|3|12|12|true|ATCAGCTGACGTAC|true|
|4|11|11|true|ATCAGCTGACGTAC|true|
|5|10|10|true|ATCAGCTGACGTAC|true|
|6|9|9|true|ATCAGCTGACGTAC|true|
|7|8|8|true|ATCAGCTGACGTAC|true|
\image(figures/velvet_original.svg)
