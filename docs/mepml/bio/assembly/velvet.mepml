> Checking the theory and controls

```{cpp, results="markdown", file="figures/velvet_controls.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    std::vector<double> x, y;
    std::print("| reads | complete | consumed | sequence |\n|---|---|---:|---|\n");
    int i = 0;
    for (auto reads : std::vector<std::vector<std::string>>{
         {}, {"AT", "TC"}, {"AA", "AA"}, {"AT", "GC"}, {"AT", "AG"},
         {"TTACGGCA", "GGCATTAC"}
     }) {
        auto r = a::velvet_work(reads, 2);
        std::print("|`{}`|{}|{}|{}|\n", reads, r.eulerian, r.consumed,
                   r.sequence.empty() ? "(empty)" : r.sequence);
        x.push_back(i++);
        y.push_back(r.eulerian);
    }
    auto p = g::RPlot::create();
    p.line(x, y, "actual", {37, 99, 235}, 2);
    p.points(x, y, "", {37, 99, 235}, 5);
    p.title("Empty, duplicate, disconnected and degree-invalid controls").x_label("control index").y_label("actual complete-walk status");
    p.save_svg("build/velvet_controls.svg");
}
```
// result_begin: markdown
| reads | complete | consumed | sequence |
|---|---|---:|---|
|`[]`|true|0|(empty)|
|`["AT", "TC"]`|true|2|ATC|
|`["AA", "AA"]`|true|2|AAA|
|`["AT", "GC"]`|false|0|(empty)|
|`["AT", "AG"]`|false|0|(empty)|
|`["TTACGGCA", "GGCATTAC"]`|false|0|(empty)|
\image(figures/velvet_controls.svg)
