> The retained original experiment

```{cpp, results="markdown", file="figures/tea_original.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <filesystem>
#include <print>
#include <algorithm>
#include <cmath>
#include <limits>
#include <numeric>
#include <numbers>
#include <random>
#include <string>
#include <vector>
#include <map>
#include <set>
#include <array>
#include <tuple>
#include <bit>
#include <datamunge/random/quality.hpp>
#include <datamunge/algorithms/tea.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    const std::array<std::uint32_t, 4> key{0x01234567u, 0x89abcdefu,
                                           0xfedcba98u, 0x76543210u};
    const std::array<std::uint32_t, 2> pt{0xdeadbeefu, 0x01234567u};
    auto r = a::tea_encrypt_run(pt, key);
    auto back = a::tea_decrypt(r.value, key);
    std::print("Original plaintext {:08x} {:08x}; cipher {:08x} {:08x}; exact round trip {}.\n\n| flipped " "original plaintext bit | actual ciphertext changed bits |\n| ---: | ---: |\n",
               pt[0], pt[1], r.value[0], r.value[1], back == pt);
    std::vector<double> x, y;
    for (int bit = 0; bit < 64; ++bit) {
        auto flipped = pt;
        flipped[bit / 32] ^= std::uint32_t{1} << (bit % 32);
        auto c = a::tea_encrypt(flipped, key);
        auto count =
            std::popcount(c[0] ^ r.value[0]) + std::popcount(c[1] ^ r.value[1]);
        x.push_back(bit);
        y.push_back(count);
        std::print("| {} | {} |\n", bit, count);
    }
    std::print("Actual64-flip mean {}; reference for ideal random64-bit outputs32.\n",
               std::accumulate(y.begin(), y.end(), 0.) / y.size());
    auto plot = g::RPlot::create();
    plot.lines(x, y, "actual native values", {37, 99, 235}).points(
        x, y, {37, 99, 235}, 4).title("Original key/plaintext: actual64 single-bit sensitivity controls").x_label("flipped plaintext bit").y_label("actual changed ciphertext bits");
    plot.save_svg("build/tea_original.svg");
}
```
