> Actual selected work and sensitivity

```{cpp, results="markdown", file="figures/tea_work.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <filesystem>
#include <print>
#include <algorithm>
#include <cmath>
#include <limits>
#include <numeric>
#include <numbers>
#include <random>
#include <string>
#include <vector>
#include <map>
#include <set>
#include <array>
#include <tuple>
#include <bit>
#include <datamunge/random/quality.hpp>
#include <datamunge/algorithms/tea.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    auto r = a::tea_encrypt_trace({0, 0}, {0, 0, 0, 0});
    std::vector<double> x, y;
    std::print("| actual completed cycle | schedule word | actual left word | actual right word |\n| ---: | " "---: | ---: | ---: |\n");
    for (const auto &s : r.steps) {
        x.push_back(s.cycle);
        y.push_back(std::popcount(s.after[0]) + std::popcount(s.after[1]));
        std::print("| {} | {} | {} | {} |\n", s.cycle, s.sum, s.after[0],
                   s.after[1]);
    }
    auto plot = g::RPlot::create();
    plot.lines(x, y, "actual native values", {37, 99, 235}).points(
        x, y, {37, 99, 235}, 4).title("Actual zero-block cycle states; fixed32-cycle execution").x_label("completed cycle").y_label("set bits in actual two-word state");
    plot.save_svg("build/tea_work.svg");
}
```
