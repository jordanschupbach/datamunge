> Explicit controls

```{cpp, results="markdown", file="figures/tea_controls.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <filesystem>
#include <print>
#include <algorithm>
#include <cmath>
#include <limits>
#include <numeric>
#include <numbers>
#include <random>
#include <string>
#include <vector>
#include <map>
#include <set>
#include <array>
#include <tuple>
#include <bit>
#include <datamunge/random/quality.hpp>
#include <datamunge/algorithms/tea.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");
    std::vector<std::array<std::uint32_t, 2>> blocks{{0, 0}, {1, 0}, {0, 1},
                                                     {0xffffffffu, 0xffffffffu}};
    std::vector<double> x, y;
    std::print("| actual input | actual cipher | inverse restores input | cycles |\n| --- | --- | --- | " "---: |\n");
    for (std::size_t i = 0; i < blocks.size(); ++i) {
        auto r = a::tea_encrypt_run(blocks[i], {0, 0, 0, 0});
        auto inverse = a::tea_decrypt_trace(r.value, {0, 0, 0, 0});
        x.push_back(i);
        y.push_back(inverse.value == blocks[i] ? 1 : 0);
        std::print("| `{}` | `{}` | {} | {} |\n", blocks[i], r.value,
                   inverse.value == blocks[i], r.cycles);
    }
    auto plot = g::RPlot::create();
    plot.lines(x, y, "actual native values", {37, 99, 235}).points(
        x, y, {37, 99, 235}, 4).title("Actual fixed-width inverse controls").x_label("control index").y_label("exact inverse success0/1");
    plot.save_svg("build/tea_controls.svg");
}
```
