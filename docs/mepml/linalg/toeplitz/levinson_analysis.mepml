> Original8-by-8 symmetric Toeplitz system

Retain row(4,2,1,0.5,0.25,0.1,0.05,0.02) and all-ones right-hand side.
Materialize its constant diagonals with the native helper, solve once with
complete native trace and independently compare the final solution with the
library’s separate partial-pivoted Gaussian elimination. That second method is a
reference comparison, not a rigorous error certificate. The full residual and
normwise backward-error ratio are observed in widened arithmetic against the
actual stored row/rhs.

The figure’s constant-color diagonals show the actual original matrix entries,
not a claimed covariance or conditioning result. Values are printed in the
solution table; every prefix diagnostic below uses its captured real solution,
never a fresh Levinson solve for that prefix.

```{cpp, results="markdown", file="figures/levinson_original.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
#include <datamunge/algorithms/linear_solvers.hpp>
#include <datamunge/plot/plot.hpp>
#include <filesystem>
#include <print>
int main() {
    std::filesystem::create_directories("build");
    std::vector<double> r{4, 2, 1, .5, .25, .1, .05, .02}, b(8, 1);
    auto t = dm::algorithms::levinson_trace(r, b);
    auto matrix = dm::algorithms::symmetric_toeplitz_matrix(r);
    auto g = dm::algorithms::gaussian_elimination(matrix, b);
    auto d = dm::algorithms::levinson_residual(r, b, t.analysis.solution);
    std::print("| original index | actual Levinson solution | independent pivoted dense solution |\n| ---: " "| ---: | ---: |\n");
    for (std::size_t i = 0; i < 8; ++i)
        std::print("| {} | {:.12f} | {:.12f} |\n", i, t.analysis.solution[i],
                   g.x[i]);
    std::print("\nActual widened residual infinity norm {:.12g}; actual normwise backward-error ratio " "{:.12g}.\n\n| actual completed prefix | actual forward basis first entry | actual solution " "first entry |\n| ---: | ---: | ---: |\n",
               d.infinity_norm, d.backward_error);
    for (auto &s : t.states)
        std::print("| {} | {:.12f} | {:.12f} |\n", s.order, s.forward[0],
                   s.solution[0]);
    auto p = dm::graphics::RPlot::create();
    std::vector<dm::graphics::RGB> colors{{37, 99, 235}, {220, 38, 38},
                                          {22, 163, 74}, {202, 138, 4},
                                          {147, 51, 234}, {8, 145, 178},
                                          {219, 39, 119}, {100, 116, 139}};
    for (std::size_t k = 0; k < 8; ++k) {
        std::vector<double> x, y;
        for (std::size_t i = 0; i < 8; ++i)
            for (std::size_t j = 0; j < 8; ++j)
                if ((i > j ? i - j : j - i) == k) {
                    x.push_back(j);
        y.push_back(-double(i));
                }
                p.points(x, y, std::format("offset{}", k), colors[k], 18);
    }
    for (std::size_t i = 0; i < 8; ++i)
        for (std::size_t j = 0; j < 8; ++j)
            p.text(j, -double(i), std::format("{}", matrix[i][j]),
                   {255, 255, 255}, 11);
    p.size(950, 850).x_limits(-1, 10).y_limits(-8, 1).title(
        "Original actual Toeplitz entries and constant diagonals").x_label(
        "column index").y_label("negative row index").save_svg(
        "build/levinson_original.svg");
}
```
