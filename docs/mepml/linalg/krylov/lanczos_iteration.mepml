> Original30-by30 matrix and requested steps

Retain the exact original upper-triangle32-bit LCG fixture: state2024,
update1103515245*s+12345 modulo2^32, value=((s>>16)%1000)/500−1, then mirror to
enforce symmetry. The start is thirty ones and requested step counts
are4,6,8,10,12,15,18,22. Each is a separate complete native run. A native dense
Jacobi eigensystem of the original matrix supplies an approximate reference,
replacing the old “true spectrum” wording; independent NumPy checks are required
during batch verification.

The small native T eigensystem uses the actual retained alpha and first m−1 beta
values. The helper forms each full Ritz vector from the actual basis and
explicitly evaluates A*y−theta*y with widened diagnostics. This includes
observed reorthogonalization/rounding defects that
terminal_beta*last_coefficient alone would omit. Eigenvalues are descending in
this native helper. Positive actual reference errors are plotted as log10
values; exact displayed zeros are left in the table and omitted from the
logarithmic curve, never replaced by an invented floor.

```{cpp, results="markdown", file="figures/lanczos_original.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
    std::filesystem::create_directories("build");
    const auto A = dm::algorithms::lanczos_demo_matrix();
    dm::linalg::DenseMatrix<double> M(30, 30, 0);
    for (int i = 0; i < 30; ++i)
        for (int j = 0; j < 30; ++j)
            M(i, j) = A[i][j];
    const auto reference = dm::linalg::jacobi_eigen(M, 1e-13, 100);
    std::print("Native dense reference minimum {:.12f}; maximum {:.12f}.\n\n",
               reference.eigenvalues.back(), reference.eigenvalues.front());
    std::print("| original requested steps | actual basis vectors | minimum Ritz reference error | maximum " "Ritz reference error | minimum-mode explicit residual over vector norm | maximum-mode " "explicit residual over vector norm | basis Gram maximum error | projection maximum error " "|\n| ---: | ---: | ---: | ---: | ---: | ---: | ---: | ---: |\n");
    std::vector<double> xlo, ylo, xhi, yhi;
    for (int m : {4, 6, 8, 10, 12, 15, 18, 22}) {
        const auto t =
            dm::algorithms::lanczos_trace(A, std::vector<double>(30, 1), m);
        const auto r = dm::algorithms::lanczos_ritz_analysis(A, t.result);
        const double lo =
            std::abs(r.values.back() - reference.eigenvalues.back()), hi =
            std::abs(r.values.front() - reference.eigenvalues.front());
        std::print("| {} | {} | {:.12e} | {:.12e} | {:.12e} | {:.12e} | {:.12e} | {:.12e} |\n",
                   m, t.result.alpha.size(), lo, hi,
                   r.residual_norms.back() / r.vector_norms.back(),
                   r.residual_norms.front() / r.vector_norms.front(),
                   r.orthogonality_error, r.projection_error);
        if (lo > 0) {
            xlo.push_back(m);
            ylo.push_back(std::log10(lo));
        }
        if (hi > 0) {
            xhi.push_back(m);
            yhi.push_back(std::log10(hi));
        }
    }
    auto p = dm::graphics::RPlot::create();
    p.line(xlo, ylo, "minimum", {220, 38, 38}, 2).points(xlo, ylo, "",
                                                         {220, 38, 38}, 4).line(
        xhi, yhi, "maximum", {37, 99, 235}, 2).points(xhi, yhi, "",
                                                      {37, 99, 235}, 4).title(
        "Original matrix: actual Ritz reference errors").x_label(
        "original requested step ceiling").y_label("log10(actual positive reference error)").save_svg("build/lanczos_original.svg");
}
```
