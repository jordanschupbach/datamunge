> Explicit controls

```{cpp, results="markdown", file="figures/q_learning_controls.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");

    std::vector<std::string> labels{"zero episodes", "zero-step resets",
                                    "one-step truncation", "terminal corridor"};
    std::vector<double> counts;
    std::print("\n| actual run policy | actual reset calls | actual transitions | actual terminal episodes " "|\n| --- | ---: | ---: | ---: |\n");
    for (int i = 0; i < 4; ++i) {
        a::RLParameters p;
        p.episodes = i == 0 ? 0 : 3;
        p.max_steps = i == 1 ? 0 : i == 2 ? 1 : 4;
        p.epsilon = 0;
        auto r = a::q_learning_run(a::tabular_corridor(2), p);
        auto terminals =
            std::count(r.terminated.begin(), r.terminated.end(), true);
        counts.push_back(r.transitions);
        std::print("| {} | {} | {} | {} |\n", labels[i], r.reset_calls,
                   r.transitions, terminals);
    }
    auto bad = a::tabular_corridor(2);
    bad.step = [](std::size_t, std::size_t) {
        return a::StepResult{2, 0, true};
    };
    bool invalid = false;
    try {
        a::q_learning_run(bad, a::RLParameters{.episodes = 1,.max_steps = 1});
    } catch (const std::invalid_argument &) {
        invalid = true;
    }
    std::print("Even terminal callback state ids are validated: {}.\n", invalid);
    auto p = g::RPlot::barplot(counts, labels, "actual callback transitions");
    p.title("Native learning controls: no data, capped episodes and genuine termination").y_label("actual transitions");
    p.save_svg("build/q_learning_controls.svg");
}
```
// result_begin: markdown
| actual run policy | actual reset calls | actual transitions | actual terminal episodes |
| --- | ---: | ---: | ---: |
| zero episodes | 0 | 0 | 0 |
| zero-step resets | 3 | 0 | 0 |
| one-step truncation | 3 | 3 | 1 |
| terminal corridor | 3 | 5 | 3 |
Even terminal callback state ids are validated: true.
\image(figures/q_learning_controls.svg)
// result_end
\caption(Actual outcomes on controlled native inputs; errors, truncation and unresolved outcomes retain their stated meanings.)
