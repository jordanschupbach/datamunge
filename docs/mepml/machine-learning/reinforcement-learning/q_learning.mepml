> The retained original experiment

```{cpp, results="markdown", file="figures/q_learning_original.svg", flags="-std=c++23 -O2 $(pkg-config --cflags --libs datamunge) -Wl,-rpath,$(pkg-config --variable=libdir datamunge)"}
#include <dm/dm.hpp>
int main() {
    namespace a = dm::algorithms;
    namespace g = dm::graphics;
    std::filesystem::create_directories("build");

    auto env = a::tabular_grid(4);
    a::RLParameters params;
    params.learning_rate = .5;
    params.discount = .95;
    params.epsilon = .1;
    params.episodes = 500;
    params.seed = 42;
    auto t = a::q_learning_trace(env, params);
    auto &result = t.run.result;
    auto means = a::trailing_return_mean(result.episode_returns, 20);
    auto rollout = a::tabular_policy_rollout(env, result.greedy_policy, 100);
    double first =
        std::accumulate(result.episode_returns.begin(),
                        result.episode_returns.begin() + 50, 0.) / 50, last =
        std::accumulate(result.episode_returns.end() - 50,
                        result.episode_returns.end(), 0.) / 50;
    std::print("Original grid actual mean return: first50 {}, last50 {}. Separate actual greedy rollout: {} " "transitions, terminal {}, undiscounted return {}.\n",
               first, last, rollout.actions.size(), rollout.terminal,
               rollout.total_reward);
    std::print("Actual start Q row {}, policy action {}, observed greedy path {}.\n",
               result.q[0], result.greedy_policy[0], rollout.states);
    std::vector<double> x;
    std::print("\n| actual episode | actual return | actual 20-episode trailing mean | actual transitions | " "terminal |\n| ---: | ---: | ---: | ---: | --- |\n");
    for (std::size_t i = 0; i < means.size(); ++i) {
        x.push_back(i + 1);
        std::print("| {} | {} | {} | {} | {} |\n", i + 1,
                   result.episode_returns[i], means[i], t.run.episode_steps[i],
                   bool(t.run.terminated[i]));
    }
    auto p = g::RPlot::create();
    p.lines(x, means, "actual training returns, trailing 20 mean", {37, 99, 235}).abline_h(-6, {22, 163, 74}).title("Original 4x4 grid: actual finite training returns and shortest-path reference").x_label("actual training episode").y_label("undiscounted training return");
    p.save_svg("build/q_learning_original.svg");
}
```
